# the shared reader of line records
#
# a line-record source, such as riscv-opcodes' extension files or XED's
# datafiles, is read as its lines with comments stripped and blank lines
# dropped, each keeping its file and line number, and split into tokens on
# whitespace. what a record means, and how a file pulls in another, is the
# set's own reading, so a malformed record is refused naming its file and
# line through `refuse`.

use std.types.bool.bool;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use gen.source;

# one line of a record source, its comment stripped and its ends trimmed
# ---
# file:   the tree path of its file
# number: its line number, from 1
# text:   its text, never empty
pub rec Line {
    file:   str;
    number: u32;
    text:   View;
}

fun space(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\r';
}

# the lines of `f` holding a record, a comment starting at `comment`
# ---
# a:       allocator for the lines
# f:       the file of a source's tree
# comment: the byte that starts a comment running to the end of its line
# ret:     the lines in file order, or the refusal of their storage
pub fun read(a: *A.Allocator, f: *source.File, comment: u8) res[vector.Vector[Line], diag.Refusal] {
    var lines:  vector.Vector[Line] = vector.init[Line](a);
    var at:     usize               = 0;
    var number: u32                 = 0;
    for (at < f.len) {
        number = number + 1;
        var end: usize = at;
        for (end < f.len && f.data[end] != '\n') {
            end = end + 1;
        }
        var stop: usize = at;
        for (stop < end && f.data[stop] != comment) {
            stop = stop + 1;
        }
        var start: usize = at;
        for (start < stop && space(f.data[start])) {
            start = start + 1;
        }
        for (stop > start && space(f.data[stop - 1])) {
            stop = stop - 1;
        }
        if (stop > start) {
            val pushed: res[usize, A.Error] = vector.push[Line](?lines, Line{file: f.path, number: number, text: view(?f.data[start], stop - start)});
            if (sel pushed.err) { ret res[vector.Vector[Line], diag.Refusal].err{diag.refusal(f.path, number, diag.MEMORY, nil)}; }
        }
        at = end + 1;
    }
    ret res[vector.Vector[Line], diag.Refusal].ok{lines};
}

# the whitespace-separated tokens of `l`, in order
pub fun tokens(a: *A.Allocator, l: *Line) res[vector.Vector[View], diag.Refusal] {
    var out: vector.Vector[View] = vector.init[View](a);
    var at:  usize               = 0;
    for (at < l.text.len) {
        if (space(l.text.data[at])) {
            at = at + 1;
            cnt;
        }
        var end: usize = at;
        for (end < l.text.len && !space(l.text.data[end])) {
            end = end + 1;
        }
        val pushed: res[usize, A.Error] = vector.push[View](?out, view(?l.text.data[at], end - at));
        if (sel pushed.err) { ret res[vector.Vector[View], diag.Refusal].err{diag.refusal(l.file, l.number, diag.MEMORY, nil)}; }
        at = end;
    }
    ret res[vector.Vector[View], diag.Refusal].ok{out};
}

# the refusal of the record on `l`
pub fun refuse(l: *Line, message: str, subject: str) diag.Refusal {
    ret diag.refusal(l.file, l.number, message, subject);
}
