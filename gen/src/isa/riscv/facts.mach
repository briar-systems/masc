# the riscv facts the generator computes from, built in memory from gen/data
#
# the generator reads nothing of masc's riscv modules: what it needs of the set
# it builds here from the data trees it is handed, and it never reads a table it
# writes. the extension catalog and its state axes come from the riscv-extensions
# source, as gen_extension states them, and the operand fields, the dispatch
# keys, the register file, what the mapping adds to riscv-opcodes, the
# effects, the vector constraints, the dialect and the compressions from the
# topics of the riscv overlay.

use std.types.error.err;
use std.types.result.res;

use A: std.allocator;

use masc.core.extension;
use masc.core.state;

use gen.catalog;
use gen.diag;
use gen.isa.riscv.compressions;
use gen.isa.riscv.constraints;
use gen.isa.riscv.dialect;
use gen.isa.riscv.effects;
use gen.isa.riscv.fields;
use riscv_overlay: gen.isa.riscv.overlay;
use gen.isa.riscv.registers;
use gen.keys;
use gen.overlay;
use gen.source;

# what the generator knows of the set
# ---
# catalog:      the extension catalog, its names resolved and its selections closed as masc's
# axes:         the state axes, their values numbered on from the catalog's rows
# fields:       the operand layouts, choices and positions
# keys:         the decode dispatch keys, in preference order
# registers:    the register file, its requirements over the catalog
# overlay:      what the mapping adds to riscv-opcodes, its fields resolved in `fields`
# effects:      the effects of the rows
# constraints:  the register constraints and element widths of the vector rows
# dialect:      how the vendor tools spell the rows
# compressions: the compressions of the vendor tools
pub rec Facts {
    catalog:      extension.Catalog;
    axes:         state.Axes;
    fields:       fields.Fields;
    keys:         keys.Keys;
    registers:    registers.Registers;
    overlay:      riscv_overlay.Overlay;
    effects:      effects.Effects;
    constraints:  constraints.Constraints;
    dialect:      dialect.Dialect;
    compressions: compressions.Compressions;
}

# the facts the trees state, built into `out`
# ---
# extensions: the riscv-extensions source's tree
# over:       the riscv overlay's tree
pub fun build(a: *A.Allocator, extensions: *source.Tree, over: *source.Tree, out: *Facts) err[diag.Refusal] {
    var built: catalog.Built;
    val made:  err[diag.Refusal] = catalog.built(a, extensions, ?built);
    if (sel made.err) { ret made; }
    out.catalog = built.catalog;
    out.axes    = built.axes;
    val topic: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, fields.TOPIC);
    if (sel topic.err) { ret err[diag.Refusal].err{topic.err}; }
    val fielded: err[diag.Refusal] = fields.read(a, ?topic.ok, ?out.fields);
    if (sel fielded.err) { ret fielded; }
    val keyed: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, keys.TOPIC);
    if (sel keyed.err) { ret err[diag.Refusal].err{keyed.err}; }
    val keyed_read: err[diag.Refusal] = keys.read(a, ?keyed.ok, ?out.keys);
    if (sel keyed_read.err) { ret keyed_read; }
    val filed: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, registers.TOPIC);
    if (sel filed.err) { ret err[diag.Refusal].err{filed.err}; }
    val filed_read: err[diag.Refusal] = registers.read(a, ?filed.ok, ?out.catalog, ?out.axes, ?out.registers);
    if (sel filed_read.err) { ret filed_read; }
    val laid: err[diag.Refusal] = riscv_overlay.read(a, over, ?out.fields, ?out.overlay);
    if (sel laid.err) { ret laid; }
    val effected: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, effects.TOPIC);
    if (sel effected.err) { ret err[diag.Refusal].err{effected.err}; }
    val effected_read: err[diag.Refusal] = effects.read(a, ?effected.ok, ?out.effects);
    if (sel effected_read.err) { ret effected_read; }
    val kept: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, constraints.TOPIC);
    if (sel kept.err) { ret err[diag.Refusal].err{kept.err}; }
    val kept_read: err[diag.Refusal] = constraints.read(a, ?kept.ok, ?out.constraints);
    if (sel kept_read.err) { ret kept_read; }
    val spoken: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, dialect.TOPIC);
    if (sel spoken.err) { ret err[diag.Refusal].err{spoken.err}; }
    val spoken_read: err[diag.Refusal] = dialect.read(a, ?spoken.ok, ?out.dialect);
    if (sel spoken_read.err) { ret spoken_read; }
    val packed: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, compressions.TOPIC);
    if (sel packed.err) { ret err[diag.Refusal].err{packed.err}; }
    ret compressions.read(a, ?packed.ok, ?out.compressions);
}
