# the riscv facts the generator computes from, built in memory from gen/data
#
# the generator reads nothing of masc's riscv modules: what it needs of the set
# it builds here from the data trees it is handed, and it never reads a table it
# writes. the extension catalog and its state axes come from the riscv-extensions
# source, as gen_extension states them, and the operand fields, the dispatch
# keys, the register file, what the mapping adds to riscv-opcodes, the
# effects, the vector constraints, the dialect and the compressions from the
# topics of the riscv overlay.

use std.types.error.err;
use std.types.result.res;

use A: std.allocator;

use masc.core.extension;
use masc.core.state;

use gen.catalog;
use gen.diag;
use gen.isa.riscv.compressions;
use gen.isa.riscv.constraints;
use gen.isa.riscv.dialect;
use gen.isa.riscv.effects;
use gen.isa.riscv.fields;
use riscv_overlay: gen.isa.riscv.overlay;
use gen.isa.riscv.registers;
use gen.keys;
use gen.overlay;
use gen.source;

# what the generator knows of the set
# ---
# catalog:      the extension catalog, its names resolved and its selections closed as masc's
# axes:         the state axes, their values numbered on from the catalog's rows
# fields:       the operand layouts, choices and positions
# keys:         the decode dispatch keys, in preference order
# registers:    the register file, its requirements over the catalog
# overlay:      what the mapping adds to riscv-opcodes, its fields resolved in `fields`
# effects:      the effects of the rows
# constraints:  the register constraints and element widths of the vector rows
# dialect:      how the vendor tools spell the rows
# compressions: the compressions of the vendor tools
pub rec Facts {
    catalog:      extension.Catalog;
    axes:         state.Axes;
    fields:       fields.Fields;
    keys:         keys.Keys;
    registers:    registers.Registers;
    overlay:      riscv_overlay.Overlay;
    effects:      effects.Effects;
    constraints:  constraints.Constraints;
    dialect:      dialect.Dialect;
    compressions: compressions.Compressions;
}

# the facts the trees state, built into `out`
# ---
# extensions: the riscv-extensions source's tree
# over:       the riscv overlay's tree
pub fun build(a: *A.Allocator, extensions: *source.Tree, over: *source.Tree, out: *Facts) err[diag.Refusal] {
    var built:    catalog.Built;
    val err_made: err[diag.Refusal] = catalog.built(a, extensions, ?built);
    if (sel err_made.err) { ret err_made; }
    out.catalog = built.catalog;
    out.axes    = built.axes;
    val res_topic: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, fields.TOPIC);
    if (sel res_topic.err) { ret err[diag.Refusal].err{res_topic.err}; }
    val err_fielded: err[diag.Refusal] = fields.read(a, ?res_topic.ok, ?out.fields);
    if (sel err_fielded.err) { ret err_fielded; }
    val res_keyed: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, keys.TOPIC);
    if (sel res_keyed.err) { ret err[diag.Refusal].err{res_keyed.err}; }
    val err_keyed_read: err[diag.Refusal] = keys.read(a, ?res_keyed.ok, ?out.keys);
    if (sel err_keyed_read.err) { ret err_keyed_read; }
    val res_filed: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, registers.TOPIC);
    if (sel res_filed.err) { ret err[diag.Refusal].err{res_filed.err}; }
    val err_filed_read: err[diag.Refusal] = registers.read(a, ?res_filed.ok, ?out.catalog, ?out.axes, ?out.registers);
    if (sel err_filed_read.err) { ret err_filed_read; }
    val err_laid: err[diag.Refusal] = riscv_overlay.read(a, over, ?out.fields, ?out.overlay);
    if (sel err_laid.err) { ret err_laid; }
    val res_effected: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, effects.TOPIC);
    if (sel res_effected.err) { ret err[diag.Refusal].err{res_effected.err}; }
    val err_effected_read: err[diag.Refusal] = effects.read(a, ?res_effected.ok, ?out.effects);
    if (sel err_effected_read.err) { ret err_effected_read; }
    val res_kept: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, constraints.TOPIC);
    if (sel res_kept.err) { ret err[diag.Refusal].err{res_kept.err}; }
    val err_kept_read: err[diag.Refusal] = constraints.read(a, ?res_kept.ok, ?out.constraints);
    if (sel err_kept_read.err) { ret err_kept_read; }
    val res_spoken: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, dialect.TOPIC);
    if (sel res_spoken.err) { ret err[diag.Refusal].err{res_spoken.err}; }
    val err_spoken_read: err[diag.Refusal] = dialect.read(a, ?res_spoken.ok, ?out.dialect);
    if (sel err_spoken_read.err) { ret err_spoken_read; }
    val res_packed: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, compressions.TOPIC);
    if (sel res_packed.err) { ret err[diag.Refusal].err{res_packed.err}; }
    ret compressions.read(a, ?res_packed.ok, ?out.compressions);
}
