# the riscv facts the generator computes from, built in memory from gen/data
#
# the generator reads nothing of masc's riscv modules: what it needs of the set
# it builds here from the data trees it is handed, and it never reads a table it
# writes. the extension catalog and its state axes come from the riscv-extensions
# source, as gen_extension states them, and the operand fields and the dispatch
# keys from the topics of the riscv overlay.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;

use A: std.allocator;
use std.allocator.arena;
use std.allocator.page;
use std.collections.vector;

use masc.core.extension;
use masc.core.state;

use gen.catalog;
use gen.diag;
use gen.isa.riscv.fields;
use gen.isa.riscv.keys;
use gen.overlay;
use gen.source;

# what the generator knows of the set
# ---
# catalog: the extension catalog, its names resolved and its selections closed as masc's
# axes:    the state axes, their values numbered on from the catalog's rows
# fields:  the operand layouts, choices and positions
# keys:    the decode dispatch keys, in preference order
pub rec Facts {
    catalog: extension.Catalog;
    axes:    state.Axes;
    fields:  fields.Fields;
    keys:    keys.Keys;
}

# the facts the trees state, built into `out`
# ---
# extensions: the riscv-extensions source's tree
# over:       the riscv overlay's tree
pub fun build(a: *A.Allocator, extensions: *source.Tree, over: *source.Tree, out: *Facts) err[diag.Refusal] {
    var built: catalog.Built;
    val made:  err[diag.Refusal] = catalog.built(a, extensions, ?built);
    if (sel made.err) { ret made; }
    out.catalog = built.catalog;
    out.axes    = built.axes;
    val topic: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, fields.TOPIC);
    if (sel topic.err) { ret err[diag.Refusal].err{topic.err}; }
    val fielded: err[diag.Refusal] = fields.read(a, ?topic.ok, ?out.fields);
    if (sel fielded.err) { ret fielded; }
    val keyed: res[overlay.Topic, diag.Refusal] = overlay.read(a, over, keys.TOPIC);
    if (sel keyed.err) { ret err[diag.Refusal].err{keyed.err}; }
    ret keys.read(a, ?keyed.ok, ?out.keys);
}

#[testing]
#[embed("../../../data/riscv/extensions/extensions.txt")]
val T_EXTENSIONS: [_]u8;

#[testing]
#[embed("../../../data/riscv/fields.txt")]
val T_FIELDS: [_]u8;

#[testing]
#[embed("../../../data/riscv/keys.txt")]
val T_KEYS: [_]u8;

# the facts of the committed data, for the tests of the generator's modules
#[testing]
pub fun fixture(a: *A.Allocator, out: *Facts) err[diag.Refusal] {
    var extensions: source.Tree = source.Tree{files: vector.init[source.File](a)};
    var over:       source.Tree = source.Tree{files: vector.init[source.File](a)};
    vector.push[source.File](?extensions.files, source.File{path: catalog.FILE, data: ?T_EXTENSIONS[0], len: $length_of(T_EXTENSIONS)});
    vector.push[source.File](?over.files, source.File{path: "fields.txt", data: ?T_FIELDS[0], len: $length_of(T_FIELDS)});
    vector.push[source.File](?over.files, source.File{path: "keys.txt", data: ?T_KEYS[0], len: $length_of(T_KEYS)});
    ret build(a, ?extensions, ?over, out);
}

# an arena over pages for a test that builds the facts of the committed data, more allocations than the testing
# allocator tracks
#[testing]
pub rec Scratch {
    back:  A.Allocator;
    arena: arena.Arena;
    a:     A.Allocator;
}

#[testing]
pub fun scratch(s: *Scratch) bool {
    val paged: err[A.Error] = page.make(?s.back);
    if (sel paged.err) { ret false; }
    val made: err[A.Error] = arena.init(?s.arena, ?s.back, 1 << 24);
    if (sel made.err) { ret false; }
    val bound: err[A.Error] = arena.make(?s.a, ?s.arena);
    ret sel bound.ok;
}

#[testing]
pub fun release(s: *Scratch) {
    arena.dnit(?s.arena);
}
