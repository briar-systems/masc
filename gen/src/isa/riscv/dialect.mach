# the reviewed facts of the vendor assembly dialect
#
# riscv-opcodes states encodings, and says nothing of how an assembler spells
# them: which operand comes first, which are glued to the mnemonic, and which
# alternative spellings the vendor tools read and print. those facts are
# written here and read in one place, the syntax emitter. a respelling is
# the same instruction under another mnemonic, and riscv-opcodes lists its
# arguments in bit order, so each respelling states its written order here,
# from the riscv-asm-manual (riscv-asm.md, "Pseudoinstructions")
# for the base set and from llvm's RISCVInstrInfo*.td InstAliases for the
# extensions. the generator refuses a respelling that is not in this table,
# or whose arguments differ from the record's, so a new extension file is
# reviewed here before it is spelled.
#
# argument names are riscv-opcodes' own. a name in an order stands for the
# operand whose bits it covers.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use gen.isa.riscv.overlay;

# how a respelling is written
# ---
# name:  the respelling's mnemonic, a trailing `*` matching any run
# args:  the arguments its record leaves free, in the record's order, with a binding such as `rs2=rs1` as written
# order: the free arguments in written order, and no others
# zero:  free arguments that the written form fixes to zero
# print: whether the printer prefers it to the base's own spelling
# text:  its template when it is not the operands in order, with `$` for its mnemonic and `<argument>` for an operand
# skip:  why it makes no alias, empty when it makes one
pub rec Respell {
    name:  str;
    args:  str;
    order: str;
    zero:  str;
    print: bool;
    text:  str;
    skip:  str;
}

pub val RESPELLS_COUNT: u32 = 84;

pub val RESPELLS: [RESPELLS_COUNT]Respell = [RESPELLS_COUNT]Respell{
    Respell{name: "beqz", args: "bimm12hi rs1 bimm12lo", order: "rs1 bimm12hi", zero: "", print: true, text: "", skip: ""},
    Respell{name: "bgez", args: "bimm12hi rs1 bimm12lo", order: "rs1 bimm12hi", zero: "", print: true, text: "", skip: ""},
    Respell{name: "bgt", args: "bimm12hi rs2 rs1 bimm12lo", order: "rs2 rs1 bimm12hi", zero: "", print: false, text: "", skip: ""},
    Respell{name: "bgtu", args: "bimm12hi rs2 rs1 bimm12lo", order: "rs2 rs1 bimm12hi", zero: "", print: false, text: "", skip: ""},
