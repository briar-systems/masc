# how the vendor tools spell the riscv rows, read from the dialect topic
#
# riscv-opcodes states encodings, and says nothing of how an assembler spells
# them: which operand comes first, which are glued to the mnemonic, and which
# alternative spellings the vendor tools read and print. gen/data/riscv/dialect.txt
# states those facts, and the syntax emitter reads them here. a respelling is
# the same instruction under another mnemonic, and riscv-opcodes lists its
# arguments in bit order, so each respelling states its written order. the
# generator refuses a respelling no line states, or whose arguments differ
# from the record's, so a new extension file is reviewed there before it is
# spelled. argument names are riscv-opcodes' own, a name in an order standing
# for the operand whose bits it covers.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use gen.diag;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "dialect";

# how a respelling is written
# ---
# name:  the respelling's mnemonic, a trailing `*` matching any run
# args:  the arguments its record leaves free, in the record's order, with a binding such as `rs2=rs1` as written
# order: the free arguments in written order, and no others
# zero:  free arguments that the written form fixes to zero
# print: whether the printer prefers it to the base's own spelling
# text:  its template when it is not the operands in order, with `$` for its mnemonic and `<argument>` for an operand
# skip:  why it makes no alias, empty when it makes one
pub rec Respell {
    name:  str;
    args:  str;
    order: str;
    zero:  str;
    print: bool;
    text:  str;
    skip:  str;
}

# a value of an enumerant the vendor tools leave unwritten, which every row whose operand takes the choice has an
# alias for, written without the operand, that the printer prefers
# ---
# choice: the choice, an operand of which takes it whole, by its name in the fields topic
# value:  the value left unwritten, by its name in the fields topic
pub rec Default {
    choice: str;
    value:  str;
}

# a value a respelling never takes though the operand it reads as admits it, so the reader refuses it and the printer spells it by the base
# ---
# name:  the respelling's mnemonic, a trailing `*` matching any run
# arg:   its argument, as its order writes it
# value: the value excluded, a register's number or an immediate's value
# cite:  the manual section that reserves it
pub rec Exclusion {
    name:  str;
    arg:   str;
    value: i64;
    cite:  str;
}

# an operand written with a format its hook reads, by an argument of its group
# ---
# arg:    the argument
# format: the format handed to the syntax's immediate hook
pub rec Format {
    arg:    str;
    format: str;
}

# a row written by a template of the dialect's own, with `<argument>` for an operand
# ---
# mnemonic: the row
# text:     its template
pub rec Template {
    mnemonic: str;
    text:     str;
}

# every fact of the dialect topic
# ---
# respells:   the respellings, in the printer's preference
# defaults:   the enumerant values left unwritten
# exclusions: the values respellings never take
# formats:    the operands written with a format of the syntax's hook
# templates:  the rows whose spelling is not their operands in rank order
# reversed:   the rows that write their multiplicand before their multiplier, as patterns
# carries:    the rows that read the mask register as an operand of their own, as patterns
pub rec Dialect {
    respells:   vector.Vector[Respell];
    defaults:   vector.Vector[Default];
    exclusions: vector.Vector[Exclusion];
    formats:    vector.Vector[Format];
    templates:  vector.Vector[Template];
    reversed:   vector.Vector[str];
    carries:    vector.Vector[str];
}

val RESPELL_NAMES: [6]str = [6]str{"args", "order", "zero", "print", "text", "skip"};

fun memory(l: *topic.Line) err[diag.Refusal] {
    ret topic.reject(l, diag.MEMORY, nil);
}

fun respell_line(l: *topic.Line, out: *Dialect) err[diag.Refusal] {
    val words: err[diag.Refusal] = topic.known(l, ?RESPELL_NAMES[0], 6);
    if (sel words.err) { ret words; }
    var r:     Respell           = Respell{name: l.key.data[1], args: nil, order: nil, zero: topic.optional(l, "zero", ""), print: true, text: topic.optional(l, "text", ""), skip: topic.optional(l, "skip", "")};
    val args:  err[diag.Refusal] = topic.needed(l, "args", ?r.args);
    val order: err[diag.Refusal] = topic.needed(l, "order", ?r.order);
    if (sel args.err)  { ret args; }
    if (sel order.err) { ret order; }
    val print: res[bool, diag.Refusal] = topic.yes(l, "print", true);
    if (sel print.err) { ret err[diag.Refusal].err{print.err}; }
    r.print = print.ok;
    val pushed: res[usize, A.Error] = vector.push[Respell](?out.respells, r);
    if (sel pushed.err) { ret memory(l); }
    ret err[diag.Refusal].ok{};
}

# the one word of line `l`'s fact, refused when it states more or fewer
fun one(l: *topic.Line, out: *str) err[diag.Refusal] {
    val w: opt[str] = topic.only(l);
    if (sel w.none) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
    @out = w.some;
    ret err[diag.Refusal].ok{};
}

# the pattern of line `l` pushed onto `out` when its fact is the one word `word`
fun listed(l: *topic.Line, word: str, out: *vector.Vector[str]) err[diag.Refusal] {
    var w:   str               = nil;
    val got: err[diag.Refusal] = one(l, ?w);
    if (sel got.err)          { ret got; }
    if (!str_equals(w, word)) { ret topic.reject(l, topic.BAD_FACT, w); }
    val pushed: res[usize, A.Error] = vector.push[str](out, l.key.data[1]);
    if (sel pushed.err) { ret memory(l); }
    ret err[diag.Refusal].ok{};
}

fun dialect_line(l: *topic.Line, out: *Dialect) err[diag.Refusal] {
    if (topic.is(l, "respell", 2)) { ret respell_line(l, out); }
    if (topic.is(l, "default", 2)) {
        var d:   Default           = Default{choice: l.key.data[1], value: nil};
        val got: err[diag.Refusal] = one(l, ?d.value);
        if (sel got.err) { ret got; }
        val pushed: res[usize, A.Error] = vector.push[Default](?out.defaults, d);
        if (sel pushed.err) { ret memory(l); }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "exclude", 3)) {
        var w:   str               = nil;
        val got: err[diag.Refusal] = one(l, ?w);
        if (sel got.err) { ret got; }
        val n: res[i64, diag.Refusal] = topic.number(l.fact, w);
        if (sel n.err) { ret err[diag.Refusal].err{n.err}; }
        val pushed: res[usize, A.Error] = vector.push[Exclusion](?out.exclusions, Exclusion{name: l.key.data[1], arg: l.key.data[2], value: n.ok, cite: l.fact.cites});
        if (sel pushed.err) { ret memory(l); }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "format", 2)) {
        var f:   Format            = Format{arg: l.key.data[1], format: nil};
        val got: err[diag.Refusal] = one(l, ?f.format);
        if (sel got.err) { ret got; }
        val pushed: res[usize, A.Error] = vector.push[Format](?out.formats, f);
        if (sel pushed.err) { ret memory(l); }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "template", 2)) {
        var t:   Template          = Template{mnemonic: l.key.data[1], text: nil};
        val got: err[diag.Refusal] = one(l, ?t.text);
        if (sel got.err) { ret got; }
        val pushed: res[usize, A.Error] = vector.push[Template](?out.templates, t);
        if (sel pushed.err) { ret memory(l); }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "order", 2)) { ret listed(l, "reversed", ?out.reversed); }
    if (topic.is(l, "carry", 2)) { ret listed(l, "v0", ?out.carries); }
    ret topic.reject(l, topic.BAD_FACT, l.fact.key);
}

# the dialect topic `t` read into `out`
pub fun read(a: *A.Allocator, t: *topic.Topic, out: *Dialect) err[diag.Refusal] {
    @out = Dialect{respells: vector.init[Respell](a), defaults: vector.init[Default](a), exclusions: vector.init[Exclusion](a), formats: vector.init[Format](a), templates: vector.init[Template](a), reversed: vector.init[str](a), carries: vector.init[str](a)};
    val checked: err[diag.Refusal] = topic.check(t, nil, topic.unstated);
    if (sel checked.err) { ret checked; }
    var i: usize = 0;
    for (i < t.facts.len) {
        var l:     topic.Line;
        val lined: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel lined.err) { ret lined; }
        val done: err[diag.Refusal] = dialect_line(?l, out);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

#[testing]
#[embed("../../../data/riscv/dialect.txt")]
val T_DIALECT: [_]u8;

#[testing]
fun t_read(a: *A.Allocator, text: *u8, len: usize, out: *Dialect) err[diag.Refusal] {
    var f: source.File                    = source.File{path: "dialect.txt", data: text, len: len};
    val t: res[topic.Topic, diag.Refusal] = topic.facts(a, ?f);
    if (sel t.err) { ret err[diag.Refusal].err{t.err}; }
    ret read(a, ?t.ok, out);
}

test read__the_respellings_keep_their_order_and_their_written_forms {
    var tt: testing.Testing;
    testing.make(?tt);
    var d:   Dialect;
    val got: err[diag.Refusal] = t_read(testing.allocator_of(?tt), ?T_DIALECT[0], $length_of(T_DIALECT), ?d);
    if (sel got.err)                                                                                                          { ret 1; }
    if (d.respells.len != 84 || d.templates.len != 27 || d.reversed.len != 21 || d.carries.len != 4 || d.exclusions.len != 0) { ret 2; }
    val bgt: *Respell = ?d.respells.data[2];
    if (!str_equals(bgt.name, "bgt") || !str_equals(bgt.order, "rs2 rs1 bimm12hi") || bgt.print) { ret 3; }
    val tso: *Respell = ?d.respells.data[20];
    if (!str_equals(tso.zero, "rs1 rd") || str_len(tso.skip) == 0 || str_len(tso.order) != 0)                               { ret 4; }
    if (!str_equals(d.templates.data[0].text, "jalr <rd>, <imm12>(<rs1>)") || !str_equals(d.defaults.data[0].value, "dyn")) { ret 5; }
    val odd: str               = "order vmacc.* | forward | c | -\n";
    val bad: err[diag.Refusal] = t_read(testing.allocator_of(?tt), odd, str_len(odd), ?d);
    if (!(sel bad.err && bad.err.message == topic.BAD_FACT)) { ret 6; }
    ret 0;
}
