# a value of an enumerant the vendor tools leave unwritten, which every row whose operand takes the choice has an
# alias for, written without the operand, that the printer prefers
# ---
# choice: the choice, an operand of which takes it whole, by its name in the fields topic
# value:  the value left unwritten, by its name in the fields topic
pub rec Default {
    choice: str;
    value:  str;
}

# a rounding mode left unwritten is dyn: llvm-mc and the gnu assembler read the
# instruction without one as dyn, and llvm-objdump writes `, dyn` only with
# its aliases off, so the row's own form writes it and the alias leaves it out.
# the conversions that are always exact take another choice, whose unwritten
# member is rne, as llvm's legacy form of them is
pub val DEFAULTS_COUNT: u32 = 1;

pub val DEFAULTS: [DEFAULTS_COUNT]Default = [DEFAULTS_COUNT]Default{
    Default{choice: "rm", value: "dyn"},
};

# a value a respelling never takes though the operand it reads as admits it, so the reader refuses it and the printer spells it by the base
# ---
# name:  the respelling's mnemonic, a trailing `*` matching any run
# arg:   its argument, as its order writes it
# value: the value excluded, a register's number or an immediate's value
# cite:  the manual section that reserves it
pub rec Exclusion {
    name:  str;
    arg:   str;
    value: i64;
    cite:  str;
}

# exclusions as a pointer to static rows and a count
pub rec Exclusions {
    at:  *Exclusion;
    len: u32;
}

pub val NO_EXCLUSIONS: Exclusions = Exclusions{at: nil, len: 0};

# the generator refuses a respelling whose record's argument excludes a value
# its base operand admits unless a row here states it, and a row that no
# respelling takes. no respelling's manual section reserves a value its base
# admits: the table respells its base whole, or fixes the operands a
# reservation would touch
pub val EXCLUSIONS: Exclusions = NO_EXCLUSIONS;

# the pseudo ops the vendor tools read and riscv-opcodes does not state, in riscv-opcodes' own syntax, and the file of their base
# ---
# each respells a base the file already admits, with the arguments and fixed
# bits the manual's table of pseudoinstructions gives it. fence with no
# operands is `iorw, iorw`, and fgt and fge are flt and fle with their
# sources swapped
pub val PSEUDOS_COUNT: u32 = 18;

pub val PSEUDOS: [PSEUDOS_COUNT]overlay.Extra = [PSEUDOS_COUNT]overlay.Extra{
    overlay.Extra{file: "rv_i", text: "$pseudo_op rv_i::xori not rd rs1 31..20=0xfff 14..12=4 6..2=0x04 1..0=3"},
    overlay.Extra{file: "rv64_i", text: "$pseudo_op rv64_i::subw negw rd rs2 31..25=32 19..15=0 14..12=0 6..2=0x0E 1..0=3"},
    overlay.Extra{file: "rv_i", text: "$pseudo_op rv_i::addi li rd imm12 19..15=0 14..12=0 6..2=0x04 1..0=3"},
    overlay.Extra{file: "rv_i", text: "$pseudo_op rv_i::fence fence 31..28=0 27..24=15 23..20=15 19..15=0 14..12=0 11..7=0 6..2=0x03 1..0=3"},
    overlay.Extra{file: "rv_s", text: "$pseudo_op rv_s::sfence.vma sfence.vma 11..7=0 19..15=0 24..20=0 31..25=0x09 14..12=0 6..2=0x1C 1..0=3"},
    overlay.Extra{file: "rv_f", text: "$pseudo_op rv_f::flt.s fgt.s rd rs1 rs2 31..27=0x14 14..12=1 26..25=0 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_f", text: "$pseudo_op rv_f::fle.s fge.s rd rs1 rs2 31..27=0x14 14..12=0 26..25=0 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_d", text: "$pseudo_op rv_d::flt.d fgt.d rd rs1 rs2 31..27=0x14 14..12=1 26..25=1 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_d", text: "$pseudo_op rv_d::fle.d fge.d rd rs1 rs2 31..27=0x14 14..12=0 26..25=1 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_zfh", text: "$pseudo_op rv_zfh::flt.h fgt.h rd rs1 rs2 31..27=0x14 14..12=1 26..25=2 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_zfh", text: "$pseudo_op rv_zfh::fle.h fge.h rd rs1 rs2 31..27=0x14 14..12=0 26..25=2 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_q", text: "$pseudo_op rv_q::flt.q fgt.q rd rs1 rs2 31..27=0x14 14..12=1 26..25=3 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_q", text: "$pseudo_op rv_q::fle.q fge.q rd rs1 rs2 31..27=0x14 14..12=0 26..25=3 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_f", text: "$pseudo_op rv_zicsr::csrrw fscsr rs1 11..7=0 31..20=0x003 14..12=1 6..2=0x1C 1..0=3"},
    overlay.Extra{file: "rv_f", text: "$pseudo_op rv_zicsr::csrrw fsflags rs1 11..7=0 31..20=0x001 14..12=1 6..2=0x1C 1..0=3"},
    overlay.Extra{file: "rv_f", text: "$pseudo_op rv_zicsr::csrrwi fsflagsi zimm5 11..7=0 31..20=0x001 14..12=5 6..2=0x1C 1..0=3"},
    overlay.Extra{file: "rv_f", text: "$pseudo_op rv_zicsr::csrrw fsrm rs1 11..7=0 31..20=0x002 14..12=1 6..2=0x1C 1..0=3"},
    overlay.Extra{file: "rv_f", text: "$pseudo_op rv_zicsr::csrrwi fsrmi zimm5 11..7=0 31..20=0x002 14..12=5 6..2=0x1C 1..0=3"},
};

# an operand written with a format its hook reads, by an argument of its group
# ---
# arg:    the argument
# format: the format handed to the syntax's immediate hook
pub rec Format {
    arg:    str;
    format: str;
}

# vsetvli's zimm11 and vsetivli's zimm10 are a vtype, written as its fields (`e32, m2, ta, ma`), and c.lui's
# immediate is written as the twenty bits lui loads, 1 to 31 or 0xfffe0 to 0xfffff, as llvm-mc and the gnu
# assembler read it
pub val FORMATS_COUNT: u32 = 3;

pub val FORMATS: [FORMATS_COUNT]Format = [FORMATS_COUNT]Format{
    Format{arg: "zimm10", format: "vtype"},
    Format{arg: "zimm11", format: "vtype"},
    Format{arg: "c_nzimm18hi", format: "lui"},
};

# a row written by a template of the dialect's own, with `<argument>` for an operand
# ---
# mnemonic: the row
# text:     its template
pub rec Template {
    mnemonic: str;
    text:     str;
}

# the rows whose spelling is not their operands in rank order
# ---
# jalr takes its offset beside its base, as a load does (riscv-asm.md,
# "Pseudoinstructions"), but is no memory access. the cache block operations
# take their address in parentheses, the prefetch hints their offset beside
# their base though they access nothing (cmo.adoc), and fcvtmod.w.d its fixed rounding mode
# (zfa, riscv-isa-manual). vsetivli writes its avl before its vector type.
# the ordering of zalasr's loads and stores is a suffix of the instruction
# without its ordering, `lb.aq` and `lb.aqrl` being one instruction in two
# spellings (llvm 23.1.1, checked against llvm-mc). the may-be-operations
# riscv-opcodes states as one record over their number, `mop.r.N`, write the
# number glued to the mnemonic, `mop.r.5` (src/unpriv/zimop.adoc and
# zcmop.adoc), c.nop's hint code points are written `c.nop imm`, as llvm
# writes them, and zicfiss's instructions in the may-be-operation space, which
# riscv-opcodes names by the register they fix, `sspush.x1`, write it,
# `sspush ra` (src/unpriv/cfi.adoc)
pub val TEMPLATES_COUNT: u32 = 27;

pub val TEMPLATES: [TEMPLATES_COUNT]Template = [TEMPLATES_COUNT]Template{
    Template{mnemonic: "jalr", text: "jalr <rd>, <imm12>(<rs1>)"},
    Template{mnemonic: "cbo.clean", text: "cbo.clean (<rs1>)"},
    Template{mnemonic: "cbo.flush", text: "cbo.flush (<rs1>)"},
    Template{mnemonic: "cbo.inval", text: "cbo.inval (<rs1>)"},
    Template{mnemonic: "prefetch.i", text: "prefetch.i <imm12hi>(<rs1>)"},
    Template{mnemonic: "prefetch.r", text: "prefetch.r <imm12hi>(<rs1>)"},
    Template{mnemonic: "prefetch.w", text: "prefetch.w <imm12hi>(<rs1>)"},
    Template{mnemonic: "fcvtmod.w.d", text: "fcvtmod.w.d <rd>, <rs1>, rtz"},
    Template{mnemonic: "vsetivli", text: "vsetivli <rd>, <zimm5>, <zimm10>"},
    Template{mnemonic: "lb.aq", text: "lb<rl> <rd>, (<rs1>)"},
    Template{mnemonic: "lh.aq", text: "lh<rl> <rd>, (<rs1>)"},
    Template{mnemonic: "lw.aq", text: "lw<rl> <rd>, (<rs1>)"},
    Template{mnemonic: "ld.aq", text: "ld<rl> <rd>, (<rs1>)"},
    Template{mnemonic: "sb.rl", text: "sb<aq> <rs2>, (<rs1>)"},
    Template{mnemonic: "sh.rl", text: "sh<aq> <rs2>, (<rs1>)"},
    Template{mnemonic: "sw.rl", text: "sw<aq> <rs2>, (<rs1>)"},
    Template{mnemonic: "sd.rl", text: "sd<aq> <rs2>, (<rs1>)"},
    Template{mnemonic: "mop.r.N", text: "mop.r.<mop_r_t_30> <rd>, <rs1>"},
    Template{mnemonic: "mop.rr.N", text: "mop.rr.<mop_rr_t_30> <rd>, <rs1>, <rs2>"},
    Template{mnemonic: "c.mop.N", text: "c.mop.<c_mop_t>"},
    Template{mnemonic: "c.nop.hint", text: "c.nop <c_nzimm6hi>"},
    Template{mnemonic: "sspush.x1", text: "sspush ra"},
    Template{mnemonic: "sspush.x5", text: "sspush t0"},
    Template{mnemonic: "sspopchk.x1", text: "sspopchk ra"},
    Template{mnemonic: "sspopchk.x5", text: "sspopchk t0"},
    Template{mnemonic: "c.sspush.x1", text: "c.sspush ra"},
    Template{mnemonic: "c.sspopchk.x5", text: "c.sspopchk t0"},
};

# the multiply adds, which write their multiplicand before their multiplier (riscv-v-spec, "Vector Single-Width Integer Multiply-Add Instructions") while rank puts vs2 first
pub val REVERSED_COUNT: u32 = 21;

pub val REVERSED: [REVERSED_COUNT]str = [REVERSED_COUNT]str{
    "vfmacc.*",
    "vfmadd.*",
    "vfmsac.*",
    "vfmsub.*",
    "vfnmacc.*",
    "vfnmadd.*",
    "vfnmsac.*",
    "vfnmsub.*",
    "vfwmacc.*",
    "vfwmaccbf16.*",
    "vfwmsac.*",
    "vfwnmacc.*",
    "vfwnmsac.*",
    "vmacc.*",
    "vmadd.*",
    "vnmsac.*",
    "vnmsub.*",
    "vwmacc.*",
    "vwmaccsu.*",
    "vwmaccu.*",
    "vwmaccus.*",
};

# the rows that read the mask register as an operand of their own, written `v0` after the others (riscv-v-spec, "Vector Integer Add-with-Carry")
pub val CARRIES_COUNT: u32 = 4;

pub val CARRIES: [CARRIES_COUNT]str = [CARRIES_COUNT]str{"*.vim", "*.vvm", "*.vxm", "*.vfm"};
