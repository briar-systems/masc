# the reviewed facts the riscv generator adds to riscv-opcodes
#
# riscv-opcodes states encodings. what it does not state, or states otherwise
# than the manual, is a topic of the riscv overlay, gen/data/riscv, each line
# citing where it is read from, and each read here into the records the
# mapping reads: the extension each file and each split file's instructions
# belong to (files), what each argument is as an operand and where it stands
# (operands), the register class of an argument (classes), the csrs whose
# width riscv-opcodes states otherwise (csrs), the records it names wrongly,
# lacks or holds a field of at zero (records), the extensions that restate
# the f instructions on the x registers (restates) and the hint spaces
# (hints). names of extensions, fields and registers are the catalog's, the
# fields topic's and the register file's own spellings, resolved and refused
# when unknown, so no id is restated here. a fact that overrides riscv-opcodes
# is held to what riscv-opcodes states by `against`, once the source is read.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.core.layout;

use gen.diag;
use gen.isa.riscv.fields;
use opcodes: gen.isa.riscv.read;
use topic:   gen.overlay;
use gen.source;

pub val FILES:    str = "files";
pub val OPERANDS: str = "operands";
pub val CLASSES:  str = "classes";
pub val CSRS:     str = "csrs";
pub val RECORDS:  str = "records";
pub val RESTATES: str = "restates";
pub val HINTS:    str = "hints";

pub val NO_FIELD: str = "overlay line names a field the fields topic does not state";
pub val UNSORTED: str = "overlay lines are not in the order their topic keeps";

# an extension file and the extensions its instructions require, as the
# catalog spells them: alternatives split by `|`, the extensions of one
# alternative by spaces, and empty for none. a file read for no rows names
# why in `skip`
pub rec File {
    name:     str;
    requires: str;
    skip:     str;
}

# the requirement of the instructions of `file` that `mnemonic` matches,
# where a split file holds several extensions. a trailing `*` matches any
# mnemonic with that prefix, and the first row that matches is taken
pub rec Member {
    file:     str;
    mnemonic: str;
    requires: str;
}

# what an argument group is in masc's riscv field module
# ---
# REGISTER:  a position
# IMMEDIATE: a layout, as an immediate or a relative target
# CHOICE:    an enumerant
# CSR:       the csr layout, as an id of the csr space
# ADJUST:    zcmp's stack adjustment, which the stack kind encodes whole
# SREG:      a zcmp s register, which the sregs kind encodes whole
pub def Use: u8;

pub val REGISTER:  Use = 0;
pub val IMMEDIATE: Use = 1;
pub val CHOICE:    Use = 2;
pub val CSR:       Use = 3;
pub val ADJUST:    Use = 4;
pub val SREG:      Use = 5;

val USE_NAMES: [6]str = [6]str{"register", "immediate", "choice", "csr", "adjust", "sreg"};

# the arguments that form one operand, split by spaces, and what they are
# ---
# position: a register's position, for REGISTER and SREG
# layout:   an immediate's layout, for IMMEDIATE and CSR
# choice:   an enumerant's choice, for CHOICE
pub rec Group {
    args:     str;
    use:      Use;
    position: *layout.Position;
    layout:   *layout.Layout;
    choice:   *layout.Choice;
}

# where an argument's operand stands among a row's operands, lowest first
pub rec Rank {
    arg:  str;
    rank: u8;
}

# the register class an argument names, by its kind in the register file
# ---
# INTEGER: the x registers
# FLOAT:   the f registers
# VECTOR:  the v registers
pub def Class: u8;

pub val INTEGER: Class = 0;
pub val FLOAT:   Class = 1;
pub val VECTOR:  Class = 2;

# a float file's rows whose arguments name x registers, `args` split by spaces
pub rec Integer {
    mnemonic: str;
    args:     str;
}

# a vector file's rows whose scalar rd and rs1 are f registers, or for `float` false the rows a float pattern
# matches whose scalars are x registers all the same
pub rec Scalar {
    mnemonic: str;
    float:    bool;
}

# a layout a row takes for one of its argument groups in place of the group's own
pub rec Override {
    mnemonic: str;
    args:     str;
    layout:   *layout.Layout;
}

# a choice a row takes for one of its argument groups in place of the group's own
pub rec ChoiceOverride {
    mnemonic: str;
    args:     str;
    choice:   *layout.Choice;
}

# a csr of riscv-opcodes whose width it states wrongly, or that names no csr of the manual
# ---
# name: the csr, as riscv-opcodes names it
# rv32: whether it exists only at rv32, where riscv-opcodes states the other
# skip: why it is left unnamed, nil when it is kept
pub rec Csr {
    name: str;
    rv32: bool;
    skip: str;
}

# a record riscv-opcodes names wrongly, by its file, its name and its major opcode, and the name it has
pub rec Rename {
    file:  str;
    name:  str;
    major: u64;
    to:    str;
}

# a register argument that must name an aligned register group, under `width` or every width when it is empty
pub rec Align {
    mnemonic: str;
    arg:      str;
    position: *layout.Position;
    width:    str;
}

# an extension that restates a file's instructions on the x registers in place of the f registers
# ---
# file:     the file restated
# requires: what its restated rows require, as File spells it
# suffix:   what a restated row's key adds to its record's key, after a dot
pub rec Restate {
    file:     str;
    requires: str;
    suffix:   str;
}

# a floating-point format: its letter in a mnemonic and its bits
pub rec Format {
    letter: u8;
    bits:   u32;
}

# the position a restated register argument takes when its format is wider than the row's x registers
pub rec Pair {
    arg:      str;
    position: *layout.Position;
}

# a record riscv-opcodes does not state, or a pseudo op, in its own syntax, the file it belongs to and the line that
# states it
pub rec Extra {
    file: str;
    text: str;
    line: u32;
    path: str;
}

# arguments of a record that its instruction holds at zero, the record as `file::name` and its arguments split by spaces
pub rec Zeroed {
    record: str;
    args:   str;
}

# a hint space of a base instruction, its base as `file::name` and its terms split by spaces
pub rec Hint {
    base:  str;
    space: str;
}

# every fact of the riscv overlay, as the mapping reads it
# ---
# immediate_rank: the rank of an immediate's operand, which ranks does not name
# choice_rank:    the rank of a modifier's operand, which ranks does not name
# csr_topic:      the csrs topic, held to riscv-opcodes once the source is read
# record_topic:   the records topic, held to riscv-opcodes once the source is read
pub rec Overlay {
    files:                  vector.Vector[File];
    members:                vector.Vector[Member];
    groups:                 vector.Vector[Group];
    ranks:                  vector.Vector[Rank];
    immediate_rank:         u8;
    choice_rank:            u8;
    overrides:              vector.Vector[Override];
    choice_overrides:       vector.Vector[ChoiceOverride];
    aligns:                 vector.Vector[Align];
    float_files:            vector.Vector[str];
    compressed_float_files: vector.Vector[str];
    compressed_float_args:  vector.Vector[str];
    vector_files:           vector.Vector[str];
    integers:               vector.Vector[Integer];
    scalars:                vector.Vector[Scalar];
    csrs:                   vector.Vector[Csr];
    renames:                vector.Vector[Rename];
    extras:                 vector.Vector[Extra];
    pseudos:                vector.Vector[Extra];
    zeroed:                 vector.Vector[Zeroed];
    extra_args:             vector.Vector[opcodes.Arg];
    restates:               vector.Vector[Restate];
    transfers:              vector.Vector[str];
    formats:                vector.Vector[Format];
    pairs:                  vector.Vector[Pair];
    hints:                  vector.Vector[Hint];
    csr_topic:              topic.Topic;
    record_topic:           topic.Topic;
}

# whether `name` matches `pattern`, whose one `*` matches any run of characters
pub fun matches(pattern: str, name: str) bool {
    val plen: usize = str_len(pattern);
    val nlen: usize = str_len(name);
    var star: usize = 0;
    for (star < plen && pattern[star] != '*') {
        star = star + 1;
    }
    if (star == plen) {
        if (plen != nlen) { ret false; }
        var i: usize = 0;
        for (i < plen) {
            if (pattern[i] != name[i]) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    val tail: usize = plen - star - 1;
    if (nlen < star + tail) { ret false; }
    var k: usize = 0;
    for (k < star) {
        if (pattern[k] != name[k]) { ret false; }
        k = k + 1;
    }
    k = 0;
    for (k < tail) {
        if (pattern[star + 1 + k] != name[nlen - tail + k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

fun memory(f: *topic.Fact) diag.Refusal {
    ret topic.refuse(f, diag.MEMORY, nil);
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun files_line(a: *A.Allocator, o: *Overlay, l: *topic.Line) err[diag.Refusal] {
    if (topic.is(l, "file", 2)) {
        var f:    File     = File{name: l.key.data[1], requires: "", skip: nil};
        val skip: opt[str] = topic.value(?l.ws, "skip");
        if (sel skip.some) { f.skip = skip.some; }
        or {
            val got: err[diag.Refusal] = topic.needed(l, "requires", ?f.requires);
            if (sel got.err) { ret got; }
        }
        val n: usize = o.files.len;
        if (n > 0 && str_compare(o.files.data[n - 1].name, f.name) >= 0) { ret topic.reject(l, UNSORTED, f.name); }
        if (!pushed(vector.push[File](?o.files, f)))                     { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "member", 3)) {
        var m:   Member            = Member{file: l.key.data[1], mnemonic: l.key.data[2], requires: nil};
        val got: err[diag.Refusal] = topic.needed(l, "requires", ?m.requires);
        if (sel got.err)                                 { ret got; }
        if (!pushed(vector.push[Member](?o.members, m))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    ret topic.reject(l, topic.BAD_FACT, l.fact.key);
}

# the field `kind=` names in the fact, of the fields topic
fun layout_of(fs: *fields.Fields, l: *topic.Line, out: **layout.Layout) err[diag.Refusal] {
    val v: opt[str] = topic.value(?l.ws, "layout");
    if (sel v.none) { ret err[diag.Refusal].ok{}; }
    val x: *fields.Layout = fields.layout_named(fs, v.some);
    if (x == nil) { ret topic.reject(l, NO_FIELD, v.some); }
    @out = x.at;
    ret err[diag.Refusal].ok{};
}

fun choice_of(fs: *fields.Fields, l: *topic.Line, out: **layout.Choice) err[diag.Refusal] {
    val v: opt[str] = topic.value(?l.ws, "choice");
    if (sel v.none) { ret err[diag.Refusal].ok{}; }
    val x: *layout.Choice = fields.choice_named(fs, v.some);
    if (x == nil) { ret topic.reject(l, NO_FIELD, v.some); }
    @out = x;
    ret err[diag.Refusal].ok{};
}

fun position_of(fs: *fields.Fields, l: *topic.Line, out: **layout.Position) err[diag.Refusal] {
    val v: opt[str] = topic.value(?l.ws, "position");
    if (sel v.none) { ret err[diag.Refusal].ok{}; }
    val x: *layout.Position = fields.position_named(fs, v.some);
    if (x == nil) { ret topic.reject(l, NO_FIELD, v.some); }
    @out = x;
    ret err[diag.Refusal].ok{};
}

fun rank_value(l: *topic.Line) res[u8, diag.Refusal] {
    val w: opt[str] = topic.only(l);
    if (sel w.none) { ret res[u8, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
    val n: res[i64, diag.Refusal] = topic.number(l.fact, w.some);
    if (sel n.err)              { ret res[u8, diag.Refusal].err{n.err}; }
    if (n.ok < 0 || n.ok > 255) { ret res[u8, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_NUMBER, w.some)}; }
    ret res[u8, diag.Refusal].ok{n.ok::u8};
}

fun operands_line(a: *A.Allocator, o: *Overlay, fs: *fields.Fields, l: *topic.Line) err[diag.Refusal] {
    if (l.key.len >= 2 && str_equals(l.key.data[0], "group")) {
        val args: opt[str] = topic.joined(a, ?l.key, 1);
        if (sel args.none) { ret err[diag.Refusal].err{memory(l.fact)}; }
        var use: str               = nil;
        val got: err[diag.Refusal] = topic.needed(l, "use", ?use);
        if (sel got.err) { ret got; }
        var u: u32 = 0;
        for (u < 6 && !str_equals(USE_NAMES[u], use)) {
            u = u + 1;
        }
        if (u == 6) { ret topic.reject(l, topic.UNKNOWN_WORD, use); }
        var g: Group             = Group{args: args.some, use: u::Use, position: nil, layout: nil, choice: nil};
        val p: err[diag.Refusal] = position_of(fs, l, ?g.position);
        val y: err[diag.Refusal] = layout_of(fs, l, ?g.layout);
        val c: err[diag.Refusal] = choice_of(fs, l, ?g.choice);
        if (sel p.err)                                 { ret p; }
        if (sel y.err)                                 { ret y; }
        if (sel c.err)                                 { ret c; }
        if (!pushed(vector.push[Group](?o.groups, g))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "rank", 2)) {
        val r: res[u8, diag.Refusal] = rank_value(l);
        if (sel r.err)                                                                  { ret err[diag.Refusal].err{r.err}; }
        if (str_equals(l.key.data[1], "immediate"))                                     { o.immediate_rank = r.ok; }
        or (str_equals(l.key.data[1], "choice"))                                        { o.choice_rank = r.ok; }
        or (!pushed(vector.push[Rank](?o.ranks, Rank{arg: l.key.data[1], rank: r.ok}))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "override", 3)) {
        val choice: opt[str] = topic.value(?l.ws, "choice");
        if (sel choice.some) {
            var x: ChoiceOverride    = ChoiceOverride{mnemonic: l.key.data[1], args: l.key.data[2], choice: nil};
            val c: err[diag.Refusal] = choice_of(fs, l, ?x.choice);
            if (sel c.err)                                                    { ret c; }
            if (!pushed(vector.push[ChoiceOverride](?o.choice_overrides, x))) { ret err[diag.Refusal].err{memory(l.fact)}; }
            ret err[diag.Refusal].ok{};
        }
        var x: Override          = Override{mnemonic: l.key.data[1], args: l.key.data[2], layout: nil};
        val y: err[diag.Refusal] = layout_of(fs, l, ?x.layout);
        if (sel y.err)                                       { ret y; }
        if (x.layout == nil)                                 { ret topic.reject(l, topic.MISSING, "layout"); }
        if (!pushed(vector.push[Override](?o.overrides, x))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "align", 3)) {
        var x: Align             = Align{mnemonic: l.key.data[1], arg: l.key.data[2], position: nil, width: ""};
        val p: err[diag.Refusal] = position_of(fs, l, ?x.position);
        if (sel p.err)         { ret p; }
        if (x.position == nil) { ret topic.reject(l, topic.MISSING, "position"); }
        val width: opt[str] = topic.value(?l.ws, "width");
        if (sel width.some)                            { x.width = width.some; }
        if (!pushed(vector.push[Align](?o.aligns, x))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    ret topic.reject(l, topic.BAD_FACT, l.fact.key);
}

fun classes_line(a: *A.Allocator, o: *Overlay, l: *topic.Line) err[diag.Refusal] {
    val what: opt[str] = topic.joined(a, ?l.ws, 0);
    if (sel what.none) { ret err[diag.Refusal].err{memory(l.fact)}; }
    if (topic.is(l, "file", 2)) {
        var into: *vector.Vector[str] = nil;
        if (str_equals(what.some, "float"))                 { into = ?o.float_files; }
        or (str_equals(what.some, "compressed float"))      { into = ?o.compressed_float_files; }
        or (str_equals(what.some, "vector"))                { into = ?o.vector_files; }
        or                                                  { ret topic.reject(l, topic.UNKNOWN_WORD, what.some); }
        if (!pushed(vector.push[str](into, l.key.data[1]))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "arg", 2)) {
        if (!str_equals(what.some, "compressed float"))                         { ret topic.reject(l, topic.UNKNOWN_WORD, what.some); }
        if (!pushed(vector.push[str](?o.compressed_float_args, l.key.data[1]))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "integer", 2)) {
        var args: str = what.some;
        if (str_equals(args, "none"))                                                                 { args = ""; }
        if (!pushed(vector.push[Integer](?o.integers, Integer{mnemonic: l.key.data[1], args: args}))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "scalar", 2)) {
        var float: bool = true;
        if (str_equals(what.some, "integer"))                                                        { float = false; }
        or (!str_equals(what.some, "float"))                                                         { ret topic.reject(l, topic.UNKNOWN_WORD, what.some); }
        if (!pushed(vector.push[Scalar](?o.scalars, Scalar{mnemonic: l.key.data[1], float: float}))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    ret topic.reject(l, topic.BAD_FACT, l.fact.key);
}

fun csrs_line(o: *Overlay, l: *topic.Line) err[diag.Refusal] {
    if (!topic.is(l, "csr", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
    var x:    Csr      = Csr{name: l.key.data[1], rv32: false, skip: nil};
    val skip: opt[str] = topic.value(?l.ws, "skip");
    if (sel skip.some)                           { x.skip = skip.some; }
    or (str_equals(l.fact.fact, "rv32"))         { x.rv32 = true; }
    or (!str_equals(l.fact.fact, "every width")) { ret topic.reject(l, topic.UNKNOWN_WORD, l.fact.fact); }
    if (!pushed(vector.push[Csr](?o.csrs, x)))   { ret err[diag.Refusal].err{memory(l.fact)}; }
    ret err[diag.Refusal].ok{};
}

# `text` split at its `::` into `file` and `name`, refused when it has none
fun qualified(a: *A.Allocator, l: *topic.Line, text: str, file: *str, name: *str) err[diag.Refusal] {
    val len: usize = str_len(text);
    var at:  usize = 0;
    for (at + 1 < len && !(text[at] == ':' && text[at + 1] == ':')) {
        at = at + 1;
    }
    if (at + 1 >= len) { ret topic.reject(l, topic.BAD_FACT, text); }
    val got: res[*u8, A.Error] = A.allocate[u8](a, at + 1);
    if (sel got.err) { ret err[diag.Refusal].err{memory(l.fact)}; }
    var i: usize = 0;
    for (i < at) {
        got.ok[i] = text[i];
        i         = i + 1;
    }
    got.ok[at] = 0;
    @file      = got.ok;
    @name      = ?text[at + 2];
    ret err[diag.Refusal].ok{};
}

fun records_line(a: *A.Allocator, o: *Overlay, l: *topic.Line) err[diag.Refusal] {
    if (topic.is(l, "rename", 3)) {
        var x: Rename            = Rename{file: nil, name: nil, major: 0, to: nil};
        val q: err[diag.Refusal] = qualified(a, l, l.key.data[1], ?x.file, ?x.name);
        if (sel q.err) { ret q; }
        val major: res[i64, diag.Refusal] = topic.number(l.fact, l.key.data[2]);
        if (sel major.err) { ret err[diag.Refusal].err{major.err}; }
        val to: opt[str] = topic.only(l);
        if (sel to.none) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
        x.major = major.ok::u64;
        x.to    = to.some;
        if (!pushed(vector.push[Rename](?o.renames, x))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "extra", 3)) {
        val rest: opt[str] = topic.only(l);
        if (sel rest.none) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
        val text: res[str, StrError] = str_join(a, l.key.data[2], " ", rest.some);
        if (sel text.err)                                                                                                                        { ret err[diag.Refusal].err{memory(l.fact)}; }
        if (!pushed(vector.push[Extra](?o.extras, Extra{file: l.key.data[1], text: text.ok, line: l.fact.line.number, path: l.fact.line.file}))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "pseudo", 3)) {
        var of:      str               = nil;
        var fs:      str               = nil;
        val based:   err[diag.Refusal] = topic.needed(l, "of", ?of);
        val fielded: err[diag.Refusal] = topic.needed(l, "fields", ?fs);
        if (sel based.err)   { ret based; }
        if (sel fielded.err) { ret fielded; }
        val text: res[str, StrError] = str_join(a, "$pseudo_op ", of, " ", l.key.data[2], " ", fs);
        if (sel text.err)                                                                                                                         { ret err[diag.Refusal].err{memory(l.fact)}; }
        if (!pushed(vector.push[Extra](?o.pseudos, Extra{file: l.key.data[1], text: text.ok, line: l.fact.line.number, path: l.fact.line.file}))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "zeroed", 2)) {
        val args: opt[str] = topic.only(l);
        if (sel args.none)                                                                           { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
        if (!pushed(vector.push[Zeroed](?o.zeroed, Zeroed{record: l.key.data[1], args: args.some}))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "arg", 2)) {
        var hi: str               = nil;
        var lo: str               = nil;
        val h:  err[diag.Refusal] = topic.needed(l, "hi", ?hi);
        val w:  err[diag.Refusal] = topic.needed(l, "lo", ?lo);
        if (sel h.err) { ret h; }
        if (sel w.err) { ret w; }
        val hn: res[i64, diag.Refusal] = topic.number(l.fact, hi);
        val ln: res[i64, diag.Refusal] = topic.number(l.fact, lo);
        if (sel hn.err)                                                                                                       { ret err[diag.Refusal].err{hn.err}; }
        if (sel ln.err)                                                                                                       { ret err[diag.Refusal].err{ln.err}; }
        if (ln.ok < 0 || hn.ok < ln.ok || hn.ok > 31)                                                                         { ret topic.reject(l, topic.BAD_NUMBER, l.fact.fact); }
        if (!pushed(vector.push[opcodes.Arg](?o.extra_args, opcodes.Arg{name: l.key.data[1], hi: hn.ok::u8, lo: ln.ok::u8}))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    ret topic.reject(l, topic.BAD_FACT, l.fact.key);
}

fun restates_line(o: *Overlay, fs: *fields.Fields, l: *topic.Line) err[diag.Refusal] {
    if (topic.is(l, "restate", 3)) {
        var x:   Restate           = Restate{file: l.key.data[1], requires: nil, suffix: l.key.data[2]};
        val got: err[diag.Refusal] = topic.needed(l, "requires", ?x.requires);
        if (sel got.err) { ret got; }
        val n: usize = o.restates.len;
        if (n > 0 && str_compare(o.restates.data[n - 1].file, x.file) > 0) { ret topic.reject(l, UNSORTED, x.file); }
        if (!pushed(vector.push[Restate](?o.restates, x)))                 { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "transfer", 2)) {
        if (!str_equals(l.fact.fact, "unrestated"))                 { ret topic.reject(l, topic.UNKNOWN_WORD, l.fact.fact); }
        if (!pushed(vector.push[str](?o.transfers, l.key.data[1]))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "format", 2)) {
        val bits: res[u8, diag.Refusal] = rank_value(l);
        if (sel bits.err)                                                                                   { ret err[diag.Refusal].err{bits.err}; }
        if (str_len(l.key.data[1]) != 1)                                                                    { ret topic.reject(l, topic.BAD_FACT, l.key.data[1]); }
        if (!pushed(vector.push[Format](?o.formats, Format{letter: l.key.data[1][0], bits: bits.ok::u32}))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    if (topic.is(l, "pair", 2)) {
        var x: Pair              = Pair{arg: l.key.data[1], position: nil};
        val p: err[diag.Refusal] = position_of(fs, l, ?x.position);
        if (sel p.err)                               { ret p; }
        if (x.position == nil)                       { ret topic.reject(l, topic.MISSING, "position"); }
        if (!pushed(vector.push[Pair](?o.pairs, x))) { ret err[diag.Refusal].err{memory(l.fact)}; }
        ret err[diag.Refusal].ok{};
    }
    ret topic.reject(l, topic.BAD_FACT, l.fact.key);
}

fun hints_line(o: *Overlay, l: *topic.Line) err[diag.Refusal] {
    if (!topic.is(l, "hint", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
    val space: opt[str] = topic.only(l);
    if (sel space.none) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
    var terms: str = space.some;
    if (str_equals(terms, "every"))                                                    { terms = ""; }
    if (!pushed(vector.push[Hint](?o.hints, Hint{base: l.key.data[1], space: terms}))) { ret err[diag.Refusal].err{memory(l.fact)}; }
    ret err[diag.Refusal].ok{};
}

# topic `name` of `tree` read line by line into `o`, its facts checked as facts of masc's own when `own`
fun topic_of(a: *A.Allocator, tree: *source.Tree, name: str, o: *Overlay, fs: *fields.Fields, own: bool, out: *topic.Topic) err[diag.Refusal] {
    val t: res[topic.Topic, diag.Refusal] = topic.read(a, tree, name);
    if (sel t.err) { ret err[diag.Refusal].err{t.err}; }
    if (own) {
        val checked: err[diag.Refusal] = topic.check(?t.ok, nil, topic.unstated);
        if (sel checked.err) { ret checked; }
    }
    var i: usize = 0;
    for (i < t.ok.facts.len) {
        var l:     topic.Line;
        val lined: err[diag.Refusal] = topic.line(a, ?t.ok.facts.data[i], ?l);
        if (sel lined.err)  { ret lined; }
        if (l.key.len == 0) { ret topic.reject(?l, topic.BAD_FACT, l.fact.key); }
        var done: err[diag.Refusal] = err[diag.Refusal].ok{};
        if (str_equals(name, FILES))    { done = files_line(a, o, ?l); }
        or (str_equals(name, OPERANDS)) { done = operands_line(a, o, fs, ?l); }
        or (str_equals(name, CLASSES))  { done = classes_line(a, o, ?l); }
        or (str_equals(name, CSRS))     { done = csrs_line(o, ?l); }
        or (str_equals(name, RECORDS))  { done = records_line(a, o, ?l); }
        or (str_equals(name, RESTATES)) { done = restates_line(o, fs, ?l); }
        or (str_equals(name, HINTS))    { done = hints_line(o, ?l); }
        if (sel done.err)               { ret done; }
        i = i + 1;
    }
    if (out != nil) { @out = t.ok; }
    ret err[diag.Refusal].ok{};
}

# the overlay's topics of `tree` read into `out`, their fields resolved in `fs`
pub fun read(a: *A.Allocator, tree: *source.Tree, fs: *fields.Fields, out: *Overlay) err[diag.Refusal] {
    @out = Overlay{
        files:                  vector.init[File](a),
        members:                vector.init[Member](a),
        groups:                 vector.init[Group](a),
        ranks:                  vector.init[Rank](a),
        immediate_rank:         0,
        choice_rank:            0,
        overrides:              vector.init[Override](a),
        choice_overrides:       vector.init[ChoiceOverride](a),
        aligns:                 vector.init[Align](a),
        float_files:            vector.init[str](a),
        compressed_float_files: vector.init[str](a),
        compressed_float_args:  vector.init[str](a),
        vector_files:           vector.init[str](a),
        integers:               vector.init[Integer](a),
        scalars:                vector.init[Scalar](a),
        csrs:                   vector.init[Csr](a),
        renames:                vector.init[Rename](a),
        extras:                 vector.init[Extra](a),
        pseudos:                vector.init[Extra](a),
        zeroed:                 vector.init[Zeroed](a),
        extra_args:             vector.init[opcodes.Arg](a),
        restates:               vector.init[Restate](a),
        transfers:              vector.init[str](a),
        formats:                vector.init[Format](a),
        pairs:                  vector.init[Pair](a),
        hints:                  vector.init[Hint](a),
        csr_topic:              topic.Topic{path: nil, facts: vector.init[topic.Fact](a)},
        record_topic:           topic.Topic{path: nil, facts: vector.init[topic.Fact](a)},
    };
    val files: err[diag.Refusal] = topic_of(a, tree, FILES, out, fs, true, nil);
    if (sel files.err) { ret files; }
    val operands: err[diag.Refusal] = topic_of(a, tree, OPERANDS, out, fs, true, nil);
    if (sel operands.err) { ret operands; }
    val classes: err[diag.Refusal] = topic_of(a, tree, CLASSES, out, fs, true, nil);
    if (sel classes.err) { ret classes; }
    val csrs: err[diag.Refusal] = topic_of(a, tree, CSRS, out, fs, false, ?out.csr_topic);
    if (sel csrs.err) { ret csrs; }
    val records: err[diag.Refusal] = topic_of(a, tree, RECORDS, out, fs, false, ?out.record_topic);
    if (sel records.err) { ret records; }
    val restates: err[diag.Refusal] = topic_of(a, tree, RESTATES, out, fs, true, nil);
    if (sel restates.err) { ret restates; }
    ret topic_of(a, tree, HINTS, out, fs, true, nil);
}

# what riscv-opcodes states of csr fact `f`: the width its tables list the csr at, none when they list no such csr
fun csr_stated(ctx: ptr, f: *topic.Fact) opt[str] {
    val s:    *opcodes.Source = ctx::*opcodes.Source;
    val name: str             = ?f.key[4];
    var i:    usize           = 0;
    for (i < s.csrs.len) {
        if (str_equals(s.csrs.data[i].name, name)) {
            if (s.csrs.data[i].rv32) { ret opt[str].some{"rv32"}; }
            ret opt[str].some{"every width"};
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

# a record of `s` in `file` named `name`, and with major opcode `major` unless it is the all ones of none
fun record_of(s: *opcodes.Source, file: str, name: str, major: u64) *opcodes.Record {
    var i: usize = 0;
    for (i < s.records.len) {
        val r: *opcodes.Record = ?s.records.data[i];
        if (str_equals(r.file, file) && str_equals(r.name, name) && (major == 0xFFFF_FFFF || (r.match & 0x7F) == major)) { ret r; }
        i = i + 1;
    }
    ret nil;
}

# the word `n` of `text`, split by spaces, nil past its last
fun word(a: *A.Allocator, text: str, n: u32) str {
    var at:  usize = 0;
    var k:   u32   = 0;
    val len: usize = str_len(text);
    for (at < len) {
        var end: usize = at;
        for (end < len && text[end] != ' ') {
            end = end + 1;
        }
        if (k == n) {
            val got: res[*u8, A.Error] = A.allocate[u8](a, end - at + 1);
            if (sel got.err) { ret nil; }
            var i: usize = 0;
            for (i < end - at) {
                got.ok[i] = text[at + i];
                i         = i + 1;
            }
            got.ok[end - at] = 0;
            ret got.ok;
        }
        k  = k + 1;
        at = end + 1;
    }
    ret nil;
}

# the context of the records topic's check: the source and an allocator for its words
rec Held {
    alloc:  *A.Allocator;
    source: *opcodes.Source;
}

# whether a record of `s` in `file` is named `name` and has the arguments of the fields `fields`, those of its words
# that fix no bits
fun spelled(a: *A.Allocator, s: *opcodes.Source, file: str, name: str, fields: str) bool {
    var i: usize = 0;
    for (i < s.records.len) {
        val r: *opcodes.Record = ?s.records.data[i];
        if (str_equals(r.file, file) && str_equals(r.name, name)) {
            var same: bool  = true;
            var n:    usize = 0;
            var k:    u32   = 0;
            var w:    str   = word(a, fields, k);
            for (w != nil && same) {
                var fixes: bool  = false;
                var c:     usize = 0;
                for (w[c] != 0) {
                    if (w[c] == '=') { fixes = true; }
                    c = c + 1;
                }
                if (!fixes) {
                    if (n >= r.args.len || !str_equals(r.args.data[n], w)) { same = false; }
                    n = n + 1;
                }
                k = k + 1;
                w = word(a, fields, k);
            }
            if (same && n == r.args.len) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# what riscv-opcodes states of record fact `f`: a renamed record's name, what an extra record is when it states one, a
# zeroed record's arguments as arguments, an extra argument's name, and a pseudo op it holds a record of, none where it
# states nothing
fun record_stated(ctx: ptr, f: *topic.Fact) opt[str] {
    val h:    *Held           = ctx::*Held;
    val s:    *opcodes.Source = h.source;
    val kind: str             = word(h.alloc, f.key, 0);
    val one:  str             = word(h.alloc, f.key, 1);
    val two:  str             = word(h.alloc, f.key, 2);
    if (kind == nil || one == nil) { ret opt[str].none{}; }
    if (str_equals(kind, "arg")) {
        var i: usize = 0;
        for (i < s.args.len) {
            if (str_equals(s.args.data[i].name, one)) { ret opt[str].some{one}; }
            i = i + 1;
        }
        ret opt[str].none{};
    }
    if (str_equals(kind, "pseudo")) {
        if (two == nil) { ret opt[str].none{}; }
        var l:     topic.Line;
        val lined: err[diag.Refusal] = topic.line(h.alloc, f, ?l);
        if (sel lined.err) { ret opt[str].none{}; }
        val fs: opt[str] = topic.value(?l.ws, "fields");
        if (sel fs.none)                            { ret opt[str].none{}; }
        if (spelled(h.alloc, s, one, two, fs.some)) { ret opt[str].some{f.fact}; }
        ret opt[str].none{};
    }
    if (str_equals(kind, "extra")) {
        if (two == nil) { ret opt[str].none{}; }
        val r: *opcodes.Record = record_of(s, one, two, 0xFFFF_FFFF);
        if (r == nil)                 { ret opt[str].none{}; }
        if (r.kind == opcodes.PSEUDO) { ret opt[str].some{"pseudo"}; }
        if (r.kind == opcodes.IMPORT) { ret opt[str].some{"import"}; }
        ret opt[str].some{"standard"};
    }
    var file: str   = nil;
    var name: str   = nil;
    val len:  usize = str_len(one);
    var at:   usize = 0;
    for (at + 1 < len && !(one[at] == ':' && one[at + 1] == ':')) {
        at = at + 1;
    }
    if (at + 1 >= len) { ret opt[str].none{}; }
    val got: res[*u8, A.Error] = A.allocate[u8](h.alloc, at + 1);
    if (sel got.err) { ret opt[str].none{}; }
    var i: usize = 0;
    for (i < at) {
        got.ok[i] = one[i];
        i         = i + 1;
    }
    got.ok[at] = 0;
    file       = got.ok;
    name       = ?one[at + 2];
    if (str_equals(kind, "rename")) {
        if (two == nil) { ret opt[str].none{}; }
        var major: u64   = 0;
        var k:     usize = 2;
        for (two[k] != 0) {
            var d: u64 = 0;
            if (two[k] >= '0' && two[k] <= '9') { d = (two[k] - '0')::u64; }
            or                                  { d = (two[k] - 'a' + 10)::u64; }
            major = major * 16 + d;
            k     = k + 1;
        }
        if (record_of(s, file, name, major) == nil) { ret opt[str].none{}; }
        ret opt[str].some{name};
    }
    if (str_equals(kind, "zeroed")) {
        val r: *opcodes.Record = record_of(s, file, name, 0xFFFF_FFFF);
        if (r == nil) { ret opt[str].none{}; }
        ret opt[str].some{"arguments"};
    }
    ret opt[str].none{};
}

# the facts of the csrs and records topics held to riscv-opcodes as `s` reads it: each a fact riscv-opcodes does not
# state, or the override of exactly what it states
pub fun against(a: *A.Allocator, o: *Overlay, s: *opcodes.Source) err[diag.Refusal] {
    val csrs: err[diag.Refusal] = topic.check(?o.csr_topic, s::ptr, csr_stated);
    if (sel csrs.err) { ret csrs; }
    var h: Held = Held{alloc: a, source: s};
    ret topic.check(?o.record_topic, (?h)::ptr, record_stated);
}

#[testing]
fun t_held(a: *A.Allocator, text: str, s: *opcodes.Source) err[diag.Refusal] {
    var f: source.File                    = source.File{path: "csrs.txt", data: text, len: str_len(text)};
    val t: res[topic.Topic, diag.Refusal] = topic.facts(a, ?f);
    if (sel t.err) { ret err[diag.Refusal].err{t.err}; }
    var o: Overlay = Overlay{csr_topic: t.ok, record_topic: topic.Topic{path: nil, facts: vector.init[topic.Fact](a)}};
    ret against(a, ?o, s);
}

test against__a_csr_fact_overrides_exactly_the_width_riscv_opcodes_lists {
    var tt: testing.Testing;
    testing.make(?tt);
    val a: *A.Allocator   = testing.allocator_of(?tt);
    var s: opcodes.Source = opcodes.Source{args: vector.init[opcodes.Arg](a), records: vector.init[opcodes.Record](a), csrs: vector.init[opcodes.Csr](a)};
    vector.push[opcodes.Csr](?s.csrs, opcodes.Csr{name: "pmpcfg1", number: 0x3A1, rv32: false});
    val kept: err[diag.Refusal] = t_held(a, "csr pmpcfg1 | rv32 | c | every width\n", ?s);
    if (sel kept.err) { ret 1; }
    val stale: err[diag.Refusal] = t_held(a, "csr pmpcfg1 | rv32 | c | rv32\n", ?s);
    if (!(sel stale.err))                 { ret 2; }
    if (stale.err.message != topic.STALE) { ret 2; }
    val unnamed: err[diag.Refusal] = t_held(a, "csr pmpcfg1 | rv32 | c | -\n", ?s);
    if (!(sel unnamed.err))                       { ret 3; }
    if (unnamed.err.message != topic.CONTRADICTS) { ret 3; }
    val absent: err[diag.Refusal] = t_held(a, "csr utvt | rv32 | c | every width\n", ?s);
    if (!(sel absent.err))                   { ret 4; }
    if (absent.err.message != topic.NOTHING) { ret 4; }
    ret 0;
}

test against__a_pseudo_op_riscv_opcodes_spells_with_its_arguments_is_a_restatement {
    var tt: testing.Testing;
    testing.make(?tt);
    val a: *A.Allocator   = testing.allocator_of(?tt);
    var s: opcodes.Source = opcodes.Source{args: vector.init[opcodes.Arg](a), records: vector.init[opcodes.Record](a), csrs: vector.init[opcodes.Csr](a)};
    var r: opcodes.Record = opcodes.Record{kind: opcodes.PSEUDO, file: "rv_f", name: "fscsr", args: vector.init[str](a)};
    vector.push[str](?r.args, "rd");
    vector.push[str](?r.args, "rs1");
    vector.push[opcodes.Record](?s.records, r);
    var f: source.File = source.File{path: "records.txt", data: "pseudo rv_f fscsr | of=rv_zicsr::csrrw fields=\"rs1 11..7=0\" | c | -\n", len: 0};
    f.len = str_len(f.data);
    val t: res[topic.Topic, diag.Refusal] = topic.facts(a, ?f);
    if (sel t.err) { ret 1; }
    var o:    Overlay           = Overlay{csr_topic: topic.Topic{path: nil, facts: vector.init[topic.Fact](a)}, record_topic: t.ok};
    val kept: err[diag.Refusal] = against(a, ?o, ?s);
    if (sel kept.err) { ret 2; }
    var g: source.File = source.File{path: "records.txt", data: "pseudo rv_f fscsr | of=rv_zicsr::csrrw fields=\"rd rs1 31..20=0x003\" | c | -\n", len: 0};
    g.len = str_len(g.data);
    val u: res[topic.Topic, diag.Refusal] = topic.facts(a, ?g);
    if (sel u.err) { ret 3; }
    o.record_topic = u.ok;
    val again: err[diag.Refusal] = against(a, ?o, ?s);
    if (!(sel again.err && again.err.message == topic.RESTATES)) { ret 4; }
    ret 0;
}
