# an extension that restates a file's instructions on the x registers in
# place of the f registers: each standard record of the file but the
# transfers TRANSFERS names is a row of its own besides the file's, under
# `requires`, its f register arguments x registers of the same number
# ---
# file:     the file restated
# requires: what its restated rows require, as File spells it
# suffix:   what a restated row's key adds to its record's key, after a dot
pub rec Restate {
    file:     str;
    requires: str;
    suffix:   str;
}

# from the manual at 36fdac54a526, src/unpriv/zfinx.adoc: zfinx adds the
# instructions of f, zdinx those of d and zhinx those of zfh, each but its
# transfers (norm:Zfinx_F_instrs, norm:Zdinx_D_instrs and norm:Zhinx_Zfh_instrs),
# accessing the x register of the number an f register would have had
# (norm:Zfinx_x_regs and its zdinx and zhinx twins). zhinxmin holds fcvt.s.h and
# fcvt.h.s, and fcvt.d.h and fcvt.h.d when zdinx is present too
# (norm:Zhinxmin_instrs). the compressed files are not restated, their every
# instruction being a transfer. at rv32 a double operand is an aligned pair of x
# registers (norm:Zdinx_x_reg_pair), so the zdinx rows of the files of every
# width are stated at each width, a pair being an operand wider than the width's
# registers. every restated row conflicts with its f row, since zfinx conflicts
# with f (src/unpriv/zf.adoc, norm:Zfinx_Zdinx_incompatible_F_D) and the
# restating extensions imply zfinx as d and zfh imply f. sorted by file
pub val RESTATES_COUNT: u32 = 10;

pub val RESTATES: [RESTATES_COUNT]Restate = [RESTATES_COUNT]Restate{
    Restate{file: "rv64_d", requires: "rv64 zdinx", suffix: "zdinx"},
    Restate{file: "rv64_f", requires: "rv64 zfinx", suffix: "zfinx"},
    Restate{file: "rv64_zfh", requires: "rv64 zhinx", suffix: "zhinx"},
    Restate{file: "rv_d", requires: "rv32 zdinx", suffix: "zdinx.rv32"},
    Restate{file: "rv_d", requires: "rv64 zdinx", suffix: "zdinx.rv64"},
    Restate{file: "rv_d_zfhmin", requires: "rv32 zdinx zhinxmin", suffix: "zdinx.rv32"},
    Restate{file: "rv_d_zfhmin", requires: "rv64 zdinx zhinxmin", suffix: "zdinx.rv64"},
    Restate{file: "rv_f", requires: "zfinx", suffix: "zfinx"},
    Restate{file: "rv_zfh", requires: "zhinx", suffix: "zhinx"},
    Restate{file: "rv_zfhmin", requires: "zhinxmin", suffix: "zhinxmin"},
};

# the transfers no restatement holds, src/unpriv/zfinx.adoc: f's loads, stores
# and moves between the files (norm:Zfinx_F_instrs), d's (norm:Zdinx_D_instrs)
# and zfh's, whose loads, stores and moves zfhmin states (norm:Zhinx_Zfh_instrs)
pub val TRANSFERS_COUNT: u32 = 12;

pub val TRANSFERS: [TRANSFERS_COUNT]str = [TRANSFERS_COUNT]str{
    "flw",
    "fsw",
    "fmv.w.x",
    "fmv.x.w",
    "fld",
    "fsd",
    "fmv.d.x",
    "fmv.x.d",
    "flh",
    "fsh",
    "fmv.h.x",
    "fmv.x.h",
};

# a floating-point format: its letter in a mnemonic and its bits, from the
# manual's format field encoding (src/unpriv/f-st-ext.adoc, tab:fpfmt). an
# operand's format is its mnemonic's last letter, but for a conversion between
# formats, `fcvt.<rd>.<rs1>`, which names its destination's first
# (src/unpriv/d-st-ext.adoc, norm:fcvt-s-d_fcvt-d-s_op)
pub rec Format {
    letter: u8;
    bits:   u32;
}

pub val FORMATS_COUNT: u32 = 4;

pub val FORMATS: [FORMATS_COUNT]Format = [FORMATS_COUNT]Format{
    Format{letter: 's', bits: 32},
    Format{letter: 'd', bits: 64},
    Format{letter: 'h', bits: 16},
    Format{letter: 'q', bits: 128},
};

# the position a restated register argument takes when its format is wider than the row's x registers, an aligned
# pair of them (src/unpriv/zfinx.adoc, norm:Zdinx_x_reg_pair, "register numbers must be even")
pub rec Pair {
    arg:      str;
    position: *layout.Position;
}

pub val PAIRS_COUNT: u32 = 4;

pub val PAIRS: [PAIRS_COUNT]Pair = [PAIRS_COUNT]Pair{
    Pair{arg: "rd", position: ?riscv_field.RD_E},
    Pair{arg: "rs1", position: ?riscv_field.RS1_E},
    Pair{arg: "rs2", position: ?riscv_field.RS2_E},
    Pair{arg: "rs3", position: ?riscv_field.RS3_E},
};

# a record riscv-opcodes does not state, in its own syntax, and the file it belongs to
pub rec Extra {
    file: str;
    text: str;
}

# rv_zcmt states one cm.jalt record over the whole index, though an index below
# 32 is cm.jt, a jump through the table rather than a call (src/unpriv/zcmt.adoc).
# fence.tso is fence with fm 1000 and its sets rw, which ZEROED fixes at zero in
# fence's own record, so it is a record of its own (src/unpriv/rv32.adoc,
# "fence.tso"), and so are c.nop's hint code points, its nonzero immediates,
# which ZEROED leaves out of c.nop (src/unpriv/zca.adoc, "Zca HINT
# instructions"), keyed apart from c.nop and spelled `c.nop imm`
pub val EXTRAS_COUNT: u32 = 3;

pub val EXTRAS: [EXTRAS_COUNT]Extra = [EXTRAS_COUNT]Extra{
    Extra{file: "rv_zcmt", text: "cm.jt c_index_jt 1..0=2 15..13=5 12..10=0 9..7=0"},
    Extra{file: "rv_i", text: "fence.tso 31..28=8 27..24=3 23..20=3 19..15=0 14..12=0 11..7=0 6..2=0x03 1..0=3"},
    Extra{file: "rv_c", text: "c.nop.hint c_nzimm6hi c_nzimm6lo 1..0=1 15..13=0 11..7=0"},
};

# arguments of a record that its instruction holds at zero: the manual reserves
# their other values, which standard software zeroes, or gives them to another
# row. they are fixed bits of the row, so masc writes zero and reads no
# instruction of the record from encodings that set them
# ---
# record: the standard record, as `file::name`
# args:   its arguments fixed at zero, split by spaces
pub rec Zeroed {
    record: str;
    args:   str;
}

# fence's rd and rs1, and its fm, whose one other value standard software uses
# is fence.tso's (src/unpriv/rv32.adoc, "The unused fields in the FENCE
# instructions, rs1 and rd, are reserved ... standard software shall zero these
# fields. Likewise, many fm and predecessor/successor set settings are also
# reserved"); fence.i's funct12, rs1 and rd (src/unpriv/zifencei.adoc, "standard
# software shall zero these fields"); and c.nop's immediate, whose nonzero values
# are hints (src/unpriv/zca.adoc), the extra record c.nop.hint
pub val ZEROED_COUNT: u32 = 3;

pub val ZEROED: [ZEROED_COUNT]Zeroed = [ZEROED_COUNT]Zeroed{
    Zeroed{record: "rv_i::fence", args: "fm rd rs1"},
    Zeroed{record: "rv_zifencei::fence.i", args: "imm12 rs1 rd"},
    Zeroed{record: "rv_c::c.nop", args: "c_nzimm6hi c_nzimm6lo"},
};

# the argument the extra records name that arg_lut.csv does not: cm.jt's index, bits 6 to 2
pub val EXTRA_ARGS_COUNT: u32 = 1;

pub val EXTRA_ARGS: [EXTRA_ARGS_COUNT]read.Arg = [EXTRA_ARGS_COUNT]read.Arg{
    read.Arg{name: "c_index_jt", hi: 6, lo: 2},
};

# a hint space: encodings of a base instruction the manual reserves for
# hints, as terms over its bits in riscv-opcodes' own syntax. a term
# `hi..lo=v` or `bit=v` holds when the bits are `v`, `=a..b` when they lie
# from `a` to `b`, and `!=` negates either. an encoding is in the space when
# every term holds, so a constraint of the manual that reads "either x or y"
# is two spaces. a pseudo op whose fixed bits lie in a space of its base
# names a hint, and is a row of its own
# ---
# base:  the base instruction, as `file::name` the way a pseudo op names it
# space: its terms, split by spaces
pub rec Hint {
    base:  str;
    space: str;
}

# the hint spaces, row by row, from the manual at 36fdac54a526: "RV32I HINT
# instructions" (src/unpriv/rv32.adoc), "RV64I HINT instructions"
# (src/unpriv/rv64.adoc) for the rows rv64 adds, and "Zca HINT instructions"
# (src/unpriv/zca.adoc). the named hints in them are ntl.* (zihintntl.adoc),
# c.ntl.* (zihintntl.adoc), pause (zihintpause.adoc), the prefetches in ori's
# space (cmo.adoc) and lpad in auipc's (cfi.adoc). the semihosting markers
# of slli and srai have no mnemonic and stay the base's. every encoding of the
# may-be-operations is one a later extension may redefine (src/unpriv/zimop.adoc
# and zcmop.adoc), so each is a space of no terms, and zicfiss's instructions
# in them, sspush, sspopchk, ssrdp, c.sspush and c.sspopchk (src/unpriv/cfi.adoc),
# are rows the way a named hint is. a pseudo op its base's own extension admits,
# as mop.r.5 of mop.r.N, is the base respelled and no hint
pub val HINTS_COUNT: u32 = 60;

pub val HINTS: [HINTS_COUNT]Hint = [HINTS_COUNT]Hint{
    Hint{base: "rv_i::lui", space: "11..7=0"},
    Hint{base: "rv_i::auipc", space: "11..7=0"},
    Hint{base: "rv_i::addi", space: "11..7=0 19..15!=0"},
    Hint{base: "rv_i::addi", space: "11..7=0 31..20!=0"},
    Hint{base: "rv_i::andi", space: "11..7=0"},
    Hint{base: "rv_i::ori", space: "11..7=0"},
