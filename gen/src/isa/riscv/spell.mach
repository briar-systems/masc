# the risc-v syntax tables: each row's template, the respelling aliases, and the index by mnemonic
#
# a row is written as its mnemonic and its operands in assembler order. the
# order follows the row's operand rank, with the exceptions the dialect
# states and the address operand of a memory access folded with its offset
# as `offset(base)`. a respelling is an alias over its base row, its sources
# read from the bits its pseudo op record fixes. both are emitted as the
# tables `masc.isa.riscv.gen_syntax` holds, and the index is built from them,
# so a spelling is stated once and the parser and the printer read it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.sort;
use std.collections.vector;

use masc.core.field;
use masc.core.operand;
use masc.core.register;
use masc_requirement: masc.core.requirement;
use masc.core.syntax;

use masc.core.layout;
use riscv_extension: masc.isa.riscv.extension;

use gen.diag;
use gen.emit;
use gen.isa.riscv.dialect;
use gen.isa.riscv.mapping;
use gen.isa.riscv.overlay;
use gen.isa.riscv.read;
use gen.set;

pub val NO_DIALECT:    str = "respelling not in the dialect, or its arguments differ from its record's";
pub val BAD_ORDER:     str = "respelling's order names an argument its record does not leave free, twice, or leaves one out";
pub val UNMAPPED:      str = "respelling's record fixes or frees only part of an operand the spelling cannot state";
pub val NO_REGISTER:   str = "fixed register not in the register file";
pub val EXCLUDED:      str = "respelling fixes a value its base row excludes";
pub val NO_FORM:       str = "row has operands the dialect does not place";
pub val BAD_TEMPLATE:  str = "dialect template names an argument the spelling does not have";
pub val ALONE:         str = "trailing modifier with no operand before it";
pub val SUFFIXED:      str = "row has more suffix operands than the dialect places";
pub val BAD_EXCLUSION: str = "dialect exclusion names no respelling's argument, or an operand that is neither a register nor an immediate";
pub val UNSTATED:      str = "respelling's record excludes a value its base operand admits that the dialect does not state";
pub val CONFLICT:      str = "respelling's record fixes a bit its base row fixes to the other value";

# what an operand is in a template
# ---
# BODY: written in its place among the operands
# ADDR: the address register of the row's memory access
# FORM: the offset of that address
# DOT:  glued to the mnemonic after a dot, as an atomic's ordering
# TAIL: glued after the last operand, as the rounding mode and the vector mask
pub def Role: u8;

pub val BODY: Role = 0;
pub val ADDR: Role = 1;
pub val FORM: Role = 2;
pub val DOT:  Role = 3;
pub val TAIL: Role = 4;

# where a template's hole takes its operand from
# ---
# hole: the hole's number in the template
# op:   the operand of the base row it stands for
pub rec Item {
    hole: u8;
    op:   u8;
}

# a source of an alias before it is emitted
# ---
# kind:  which source it is
# n:     the alias operand, or the register row
# mask:  for a masked operand, the bits fixed
# value: the fixed value
pub rec Src {
    kind:  u8;
    n:     u32;
    mask:  u64;
    value: i64;
}

pub val FROM_OPERAND:  u8 = 0;
pub val FROM_MASKED:   u8 = 1;
pub val FROM_REGISTER: u8 = 2;
pub val FROM_VALUE:    u8 = 3;
pub val FROM_CHOICE:   u8 = 4;
pub val FROM_ID:       u8 = 5;

# a value an alias operand excludes before it is emitted
# ---
# operand:  the alias operand
# register: whether the value is a register's number rather than an immediate's value
# value:    the value
pub rec Excl {
    operand:  u8;
    register: bool;
    value:    i64;
}

# an alias before it is emitted
# ---
# row:      its base row's index
# template: its spelling
# count:    how many operands it has
# sources:  one per operand of the base row
# excluded: the values its operands exclude, in ascending order of operand
# fixed:    how many base operands it fixes
# print:    whether the printer prefers it
# own:      what its own file requires
# order:    its place in the dialect, which ranks aliases that fix as many operands
# prefer:   its preference, assigned once every alias of its base is known
pub rec Pending {
    row:      u32;
    template: str;
    count:    u8;
    sources:  vector.Vector[Src];
    excluded: vector.Vector[Excl];
    fixed:    u32;
    print:    bool;
    own:      *mapping.Requirement;
    order:    u32;
    prefer:   u8;
}

# the generator's state
rec Spell {
    alloc:   *A.Allocator;
    source:  *read.Source;
    catalog: *mapping.Catalog;
    file:    *register.File;
}

fun refuse(r: *read.Record, message: str, subject: str) err[diag.Refusal] {
    ret err[diag.Refusal].err{diag.refusal(r.path, r.line, message, subject)};
}

fun memory() diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, nil);
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun ones(len: u64) u64 {
    if (len >= 64) { ret ~0::u64; }
    ret (1::u64 << len) - 1;
}

# the length of the space separated token of `text` at `at`
fun token_len(text: str, at: usize) usize {
    var end: usize = at;
    for (text[end] != 0 && text[end] != ' ') {
        end = end + 1;
    }
    ret end - at;
}

# the start of the token after the one at `at`, past the end when there is none
fun next_token(text: str, at: usize) usize {
    val end: usize = at + token_len(text, at);
    if (text[end] == ' ') { ret end + 1; }
    ret end;
}

fun same_token(text: str, at: usize, name: str) bool {
    val len: usize = token_len(text, at);
    if (str_len(name) != len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (text[at + i] != name[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the space separated `text` holds `name`
fun has_token(text: str, name: str) bool {
    var at: usize = 0;
    for (text[at] != 0) {
        if (same_token(text, at, name)) { ret true; }
        at = next_token(text, at);
    }
    ret false;
}

# the number of tokens in `text`
fun count_tokens(text: str) u32 {
    var n:  u32   = 0;
    var at: usize = 0;
    for (text[at] != 0) {
        n  = n + 1;
        at = next_token(text, at);
    }
    ret n;
}

# the bits of the argument `name` (a binding `a=b` names its left side) in `s`, none when unknown
fun arg_bits(s: *Spell, text: str, at: usize) opt[u64] {
    var len: usize = token_len(text, at);
    var i:   usize = 0;
    for (i < len) {
        if (text[at + i] == '=') {
            len = i;
            brk;
        }
        i = i + 1;
    }
    val copy: res[str, StrError] = str_copy_slice(s.alloc, text, at, len);
    if (sel copy.err) { ret opt[u64].none{}; }
    val found: opt[*read.Arg] = read.arg(?s.source.args, copy.ok);
    if (sel found.none) { ret opt[u64].none{}; }
    ret opt[u64].some{ones((found.some.hi - found.some.lo + 1)::u64) << found.some.lo::u64};
}

# the bits of every argument of `text`
fun bits_of(s: *Spell, text: str) u64 {
    var bits: u64   = 0;
    var at:   usize = 0;
    for (text[at] != 0) {
        val b: opt[u64] = arg_bits(s, text, at);
        if (sel b.some) { bits = bits | b.some; }
        at = next_token(text, at);
    }
    ret bits;
}

# the text being built
rec Text {
    bytes:   vector.Vector[u8];
    refused: bool;
}

fun put(t: *Text, text: str) {
    var i: usize = 0;
    for (text[i] != 0) {
        if (!pushed(vector.push[u8](?t.bytes, text[i]))) { t.refused = true; }
        i = i + 1;
    }
}

fun put_byte(t: *Text, c: u8) {
    if (!pushed(vector.push[u8](?t.bytes, c))) { t.refused = true; }
}

# hole `n` of a template, with `format` for the operand's hook when it has one
fun hole(t: *Text, n: u8, format: str) {
    put_byte(t, '<');
    if (n >= 10) { put_byte(t, '0' + n / 10); }
    put_byte(t, '0' + n % 10);
    if (format != nil) {
        put_byte(t, ':');
        put(t, format);
    }
    put_byte(t, '>');
}

fun text_of(s: *Spell) Text {
    ret Text{bytes: vector.init[u8](s.alloc), refused: false};
}

# the text built, ending in a nul
fun finish(t: *Text) str {
    put_byte(t, 0);
    ret t.bytes.data;
}

# the format the dialect gives an operand's hook, nil for none
fun format_of(o: *mapping.Operand) str {
    var i: u32 = 0;
    for (i < dialect.FORMATS_COUNT) {
        if (has_token(o.group, dialect.FORMATS[i].arg)) { ret dialect.FORMATS[i].format; }
        i = i + 1;
    }
    ret nil;
}

# what operand `op` of `row` is in a template
fun role_of(row: *mapping.Row, op: u8) Role {
    val o: *mapping.Operand = ?row.operands.data[op];
    if (has_token(o.group, "aqrl") || has_token(o.group, "aq") || has_token(o.group, "rl")) { ret DOT; }
    if (has_token(o.group, "rm") || has_token(o.group, "vm"))                               { ret TAIL; }
    if (row.effect.accesses.len > 0) {
        val a: *mapping.Access = ?row.effect.accesses.data[0];
        if (a.address == op)                                                 { ret ADDR; }
        if (((a.forming >> op::u32) & 1) != 0 && o.use == overlay.IMMEDIATE) { ret FORM; }
    }
    ret BODY;
}

# whether `row` is a vector instruction, whose address follows its destination
fun vector_row(row: *mapping.Row) bool {
    var i: usize = 0;
    for (i < row.operands.len) {
        val a: str = row.operands.data[i].arg;
        if (a[0] == 'v' && (a[1] == 'd' || a[1] == 's')) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `name` matches any of the dialect's multiply-add patterns
fun reversed(name: str) bool {
    var i: u32 = 0;
    for (i < dialect.REVERSED_COUNT) {
        if (overlay.matches(dialect.REVERSED[i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `name` reads the mask register `v0` as an operand of its own
fun carries(name: str) bool {
    var i: u32 = 0;
    for (i < dialect.CARRIES_COUNT) {
        if (overlay.matches(dialect.CARRIES[i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the template of `name` over `row`, its operands in `items` in the order the row gives them or the alias states them
# ---
# keep: whether the items are in the written order, as an alias states it, so only the address and its offset are joined
fun compose(s: *Spell, row: *mapping.Row, name: str, items: *Item, count: u32, keep: bool) res[str, diag.Refusal] {
    var t:     Text = text_of(s);
    var rest:  [32]Item;
    var tail:  [8]Item;
    var dot:   [8]Item;
    var nr:    u32  = 0;
    var nt:    u32  = 0;
    var nd:    u32  = 0;
    var addr:  Item;
    var form:  Item;
    var has_a: bool = false;
    var has_f: bool = false;
    var group: u32  = 0xFFFF;
    var i:     u32  = 0;
    for (i < count) {
        val it: Item = items[i];
        var r:  Role = role_of(row, it.op);
        if (r == FORM && !(row.effect.accesses.len > 0)) { r = BODY; }
        if (r == DOT) {
            if (nd >= 8) { ret res[str, diag.Refusal].err{diag.refusal(row.record.path, row.record.line, SUFFIXED, row.mnemonic)}; }
            dot[nd] = it;
            nd      = nd + 1;
        }
        or (r == TAIL) {
            if (nt >= 8) { ret res[str, diag.Refusal].err{diag.refusal(row.record.path, row.record.line, SUFFIXED, row.mnemonic)}; }
            tail[nt] = it;
            nt       = nt + 1;
        }
        or (r == ADDR || r == FORM) {
            if (r == ADDR) {
                addr  = it;
                has_a = true;
            }
            or {
                form  = it;
                has_f = true;
            }
            if (group == 0xFFFF) { group = nr; }
        }
        or {
            if (nr >= 32) { ret res[str, diag.Refusal].err{diag.refusal(row.record.path, row.record.line, NO_FORM, row.mnemonic)}; }
            rest[nr] = it;
            nr       = nr + 1;
        }
        i = i + 1;
    }
    if (has_f && !has_a) { ret res[str, diag.Refusal].err{diag.refusal(row.record.path, row.record.line, NO_FORM, row.mnemonic)}; }
    # the address and its offset are written as one group, where the dialect puts it
    if (has_a && !keep) {
        group = nr;
        if (vector_row(row)) {
            group = 0;
            for (group < nr && row.operands.data[rest[group].op].rank == 0) {
                group = group + 1;
            }
        }
    }
    if (!keep && reversed(row.mnemonic) && nr >= 3) {
        val swap: Item = rest[1];
        rest[1] = rest[2];
        rest[2] = swap;
    }
    put(?t, name);
    i = 0;
    for (i < nd) {
        hole(?t, dot[i].hole, format_of(?row.operands.data[dot[i].op]));
        i = i + 1;
    }
    var wrote: bool = false;
    i = 0;
    for (i <= nr) {
        if (has_a && group == i) {
            if (wrote) { put(?t, ", "); }
            or         { put(?t, " "); }
            wrote = true;
            if (has_f) { hole(?t, form.hole, format_of(?row.operands.data[form.op])); }
            put(?t, "(");
            hole(?t, addr.hole, format_of(?row.operands.data[addr.op]));
            put(?t, ")");
        }
        if (i < nr) {
            if (wrote) { put(?t, ", "); }
            or         { put(?t, " "); }
            wrote = true;
            hole(?t, rest[i].hole, format_of(?row.operands.data[rest[i].op]));
        }
        i = i + 1;
    }
    if (!keep && carries(row.mnemonic) && nt == 0 && wrote) { put(?t, ", v0"); }
    i = 0;
    for (i < nt) {
        if (!wrote) { ret res[str, diag.Refusal].err{diag.refusal(row.record.path, row.record.line, ALONE, row.mnemonic)}; }
        hole(?t, tail[i].hole, format_of(?row.operands.data[tail[i].op]));
        i = i + 1;
    }
    if (t.refused) { ret res[str, diag.Refusal].err{memory()}; }
    ret res[str, diag.Refusal].ok{finish(?t)};
}

# the operand of `row` formed from argument `arg`, field.NO_OPERAND when none
fun operand_named(row: *mapping.Row, arg: str) u8 {
    var i: usize = 0;
    for (i < row.operands.len) {
        if (has_token(row.operands.data[i].group, arg)) { ret i::u8; }
        i = i + 1;
    }
    ret field.NO_OPERAND;
}

# the dialect's own template for row `row`, nil when it states none
fun row_text(row: *mapping.Row) str {
    var i: u32 = 0;
    for (i < dialect.TEMPLATES_COUNT) {
        if (str_equals(dialect.TEMPLATES[i].mnemonic, row.mnemonic)) { ret dialect.TEMPLATES[i].text; }
        i = i + 1;
    }
    ret nil;
}

# `text`, the dialect's template, with each `<argument>` turned into the hole of the operand `resolve` finds for it
fun explicit(s: *Spell, row: *mapping.Row, name: str, text: str, order: str) res[str, diag.Refusal] {
    var t:  Text  = text_of(s);
    var at: usize = 0;
    for (text[at] != 0) {
        if (text[at] == '$') {
            put(?t, name);
            at = at + 1;
            cnt;
        }
        if (text[at] != '<') {
            put_byte(?t, text[at]);
            at = at + 1;
            cnt;
        }
        var end: usize = at + 1;
        for (text[end] != '>' && text[end] != 0) {
            end = end + 1;
        }
        val arg: res[str, StrError] = str_copy_slice(s.alloc, text, at + 1, end - at - 1);
        if (sel arg.err) { ret res[str, diag.Refusal].err{memory()}; }
        if (order == nil) {
            val op: u8 = operand_named(row, arg.ok);
            if (op == field.NO_OPERAND) { ret res[str, diag.Refusal].err{diag.refusal(row.record.path, row.record.line, BAD_TEMPLATE, arg.ok)}; }
            hole(?t, op, format_of(?row.operands.data[op]));
        }
        or {
            val k: i64 = order_index(order, arg.ok, 0, str_len(arg.ok));
            if (k < 0) { ret res[str, diag.Refusal].err{diag.refusal(row.record.path, row.record.line, BAD_TEMPLATE, arg.ok)}; }
            hole(?t, k::u8, nil);
        }
        at = end + 1;
    }
    if (t.refused) { ret res[str, diag.Refusal].err{memory()}; }
    ret res[str, diag.Refusal].ok{finish(?t)};
}

# the template of row `row`, a marked row's its base's with the marker after every other operand
fun form_of(s: *Spell, row: *mapping.Row) res[str, diag.Refusal] {
    var count: u32 = row.operands.len::u32;
    if (row.mark != nil) { count = count - 1; }
    var base: res[str, diag.Refusal] = res[str, diag.Refusal].ok{nil};
    val own:  str                    = row_text(row);
    if (own != nil) { base = explicit(s, row, row.mnemonic, own, nil); }
    or {
        var items: [32]Item;
        var i:     u32 = 0;
        for (i < count) {
            items[i] = Item{hole: i::u8, op: i::u8};
            i        = i + 1;
        }
        base = compose(s, row, row.mnemonic, ?items[0], count, false);
    }
    if (row.mark == nil) { ret base; }
    if (sel base.err)    { ret base; }
    var t: Text = text_of(s);
    put(?t, base.ok);
    put(?t, ", ");
    hole(?t, count::u8, nil);
    if (t.refused) { ret res[str, diag.Refusal].err{memory()}; }
    ret res[str, diag.Refusal].ok{finish(?t)};
}

# the respelling the dialect states for `p`, nil when it states none
fun dialect_of(p: *mapping.Respelling, args: str) *dialect.Respell {
    var i: u32 = 0;
    for (i < dialect.RESPELLS_COUNT) {
        val d: *dialect.Respell = ?dialect.RESPELLS[i];
        if (overlay.matches(d.name, p.name) && str_equals(d.args, args)) { ret d; }
        i = i + 1;
    }
    ret nil;
}

# the free arguments of `r` as the dialect writes them: its tokens in order
fun record_args(s: *Spell, r: *read.Record) res[str, diag.Refusal] {
    var t: Text  = text_of(s);
    var i: usize = 0;
    for (i < r.args.len) {
        if (i > 0) { put_byte(?t, ' '); }
        put(?t, r.args.data[i]);
        i = i + 1;
    }
    if (t.refused) { ret res[str, diag.Refusal].err{memory()}; }
    ret res[str, diag.Refusal].ok{finish(?t)};
}

# the number an operand's bits hold in `word`, over the pieces of its layout restricted to `bits`
fun number_of(pieces: layout.Pieces, word: u64, bits: u64) u64 {
    var n: u64 = 0;
    var i: u32 = 0;
    for (i < pieces.len) {
        val p:    layout.Piece = pieces.at[i];
        val here: u64          = ones(p.len::u64) << p.at::u64;
        n = n | (((word & bits & here) >> p.at::u64) << p.lo::u64);
        i = i + 1;
    }
    ret n;
}

# the bits of the word that the pieces of an operand cover
fun piece_bits(pieces: layout.Pieces) u64 {
    var bits: u64 = 0;
    var i:    u32 = 0;
    for (i < pieces.len) {
        bits = bits | (ones(pieces.at[i].len::u64) << pieces.at[i].at::u64);
        i    = i + 1;
    }
    ret bits;
}

# the pieces of operand `o`, where its value lies
fun pieces_of(o: *mapping.Operand) layout.Pieces {
    if (o.use == overlay.IMMEDIATE || o.use == overlay.CSR) { ret o.layout.pieces; }
    if (o.use == overlay.CHOICE)                            { ret o.choice.pieces; }
    ret layout.NO_PIECES;
}

# the register row of class `class` and number `number`
fun register_row(s: *Spell, class: u16, number: u32) opt[u32] {
    if (number > 0xFFFF) { ret opt[u32].none{}; }
    ret register.index_of(s.file, register.make(class, number::u16));
}

# whether the position `p` excludes register number `n`
fun excludes_number(p: *layout.Position, n: u32) bool {
    var i: u32 = 0;
    for (i < p.excluded.len) {
        if (p.excluded.at[i] == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the value operand `o` holds in `word` as a source, the bits of the word `bits` considered
fun fixed_source(s: *Spell, r: *read.Record, o: *mapping.Operand, word: u64) res[Src, diag.Refusal] {
    if (o.use == overlay.REGISTER) {
        val p:  *layout.Position = o.position;
        val n:  u32              = p.first + ((word >> p.at::u64) & ones(p.len::u64))::u32;
        val at: opt[u32]         = register_row(s, o.class, n);
        if (sel at.none)           { ret res[Src, diag.Refusal].err{diag.refusal(r.path, r.line, NO_REGISTER, o.arg)}; }
        if (excludes_number(p, n)) { ret res[Src, diag.Refusal].err{diag.refusal(r.path, r.line, EXCLUDED, o.arg)}; }
        ret res[Src, diag.Refusal].ok{Src{kind: FROM_REGISTER, n: at.some, mask: 0, value: 0}};
    }
    if (o.use == mapping.IMPLICIT) {
        val at: opt[u32] = mapping.register_row(s.file, o.arg);
        if (sel at.none) { ret res[Src, diag.Refusal].err{diag.refusal(r.path, r.line, NO_REGISTER, o.arg)}; }
        ret res[Src, diag.Refusal].ok{Src{kind: FROM_REGISTER, n: at.some, mask: 0, value: 0}};
    }
    val pieces: layout.Pieces = pieces_of(o);
    if (pieces.len == 0) { ret res[Src, diag.Refusal].err{diag.refusal(r.path, r.line, UNMAPPED, o.arg)}; }
    var n: u64 = number_of(pieces, word, piece_bits(pieces));
    if (o.use == overlay.CHOICE) { ret res[Src, diag.Refusal].ok{Src{kind: FROM_CHOICE, n: 0, mask: 0, value: n:~i64}}; }
    if (o.use == overlay.CSR)    { ret res[Src, diag.Refusal].ok{Src{kind: FROM_ID, n: 0, mask: 0, value: n:~i64}}; }
    val imm: *operand.Immediate = ?o.layout.value;
    var v:   i64                = n:~i64;
    if (imm.signed && imm.bits < 64 && ((n >> (imm.bits - 1)::u64) & 1) != 0) { v = (n | ~ones(imm.bits::u64)):~i64; }
    if (operand.excludes_value(imm, v + imm.bias))                            { ret res[Src, diag.Refusal].err{diag.refusal(r.path, r.line, EXCLUDED, o.arg)}; }
    ret res[Src, diag.Refusal].ok{Src{kind: FROM_VALUE, n: 0, mask: 0, value: v + imm.bias}};
}

# the index of the token of `order` that is `arg`, -1 when it is not there
fun order_index(order: str, arg: str, at: usize, len: usize) i64 {
    var k:   i64   = 0;
    var pos: usize = 0;
    for (order[pos] != 0) {
        if (token_len(order, pos) == len) {
            var same: bool  = true;
            var i:    usize = 0;
            for (i < len) {
                if (order[pos + i] != arg[at + i]) { same = false; }
                i = i + 1;
            }
            if (same) { ret k; }
        }
        k   = k + 1;
        pos = next_token(order, pos);
    }
    ret -1;
}

# the bits of the arguments of `args` that are bindings such as `rs2=rs1`, the argument bound
fun tied_bits(s: *Spell, args: str) u64 {
    var bits: u64   = 0;
    var at:   usize = 0;
    for (args[at] != 0) {
        val len: usize = token_len(args, at);
        var eq:  usize = 0;
        for (eq < len && args[at + eq] != '=') {
            eq = eq + 1;
        }
        if (eq < len) {
            val b: opt[u64] = arg_bits(s, args, at);
            if (sel b.some) { bits = bits | b.some; }
        }
        at = next_token(args, at);
    }
    ret bits;
}

# the place in `order` of the written argument whose bits overlap `bits`, -1 when none does and -2 when several do
# ---
# hit: the bits of that argument
fun written_at(s: *Spell, order: str, bits: u64, hit: *u64) i64 {
    var found: i64   = -1;
    var many:  bool  = false;
    var idx:   i64   = 0;
    var pos:   usize = 0;
    for (order[pos] != 0) {
        val b: opt[u64] = arg_bits(s, order, pos);
        if (sel b.some) {
            if ((b.some & bits) != 0) {
                if (found >= 0) { many = true; }
                found = idx;
                @hit  = b.some;
            }
        }
        idx = idx + 1;
        pos = next_token(order, pos);
    }
    if (many) { ret -2; }
    ret found;
}

# the place in `order` of the argument a binding such as `rs2=rs1` in `args` ties the bits `bits` to, -1 when none
fun tie_of(s: *Spell, args: str, order: str, bits: u64) i64 {
    var at: usize = 0;
    for (args[at] != 0) {
        val len: usize = token_len(args, at);
        var eq:  usize = 0;
        for (eq < len && args[at + eq] != '=') {
            eq = eq + 1;
        }
        if (eq < len) {
            val b: opt[u64] = arg_bits(s, args, at);
            if (sel b.some && (b.some & bits) != 0) { ret order_index(order, args, at + eq + 1, len - eq - 1); }
        }
        at = next_token(args, at);
    }
    ret -1;
}

# the source of operand `o`, which the pseudo op record `r` respells as `d`
# ---
# fixed: set when the respelling fixes the operand rather than reading it
fun source_of(s: *Spell, r: *read.Record, args: str, d: *dialect.Respell, o: *mapping.Operand, fixed: *bool) res[Src, diag.Refusal] {
    @fixed = false;
    if (o.use == mapping.IMPLICIT) {
        @fixed = true;
        ret fixed_source(s, r, o, 0);
    }
    val b:  u64 = bits_of(s, o.group);
    var hb: u64 = 0;
    val at: i64 = written_at(s, d.order, b, ?hb);
    if (at == -2) { ret res[Src, diag.Refusal].err{diag.refusal(r.path, r.line, UNMAPPED, o.arg)}; }
    if (at >= 0) {
        # the rest of the operand is free in the record, or fixed by it
        val free: u64 = bits_of(s, args) & ~tied_bits(s, args);
        val rest: u64 = b & ~hb & ~free;
        if (rest == 0)               { ret res[Src, diag.Refusal].ok{Src{kind: FROM_OPERAND, n: at::u32, mask: 0, value: 0}}; }
        if ((rest & r.mask) != rest) { ret res[Src, diag.Refusal].err{diag.refusal(r.path, r.line, UNMAPPED, o.arg)}; }
        val pieces: layout.Pieces = pieces_of(o);
        @fixed = true;
        ret res[Src, diag.Refusal].ok{Src{kind: FROM_MASKED, n: at::u32, mask: number_of(pieces, ~0::u64, rest), value: number_of(pieces, r.match, rest):~i64}};
    }
    val tie: i64 = tie_of(s, args, d.order, b);
    if (tie >= 0) { ret res[Src, diag.Refusal].ok{Src{kind: FROM_OPERAND, n: tie::u32, mask: 0, value: 0}}; }
    @fixed = true;
    val zeroed: u64 = bits_of(s, d.zero);
    if (b != 0 && (b & zeroed) == b) { ret fixed_source(s, r, o, 0); }
    if ((b & r.mask) != b)           { ret res[Src, diag.Refusal].err{diag.refusal(r.path, r.line, UNMAPPED, o.arg)}; }
    ret fixed_source(s, r, o, r.match);
}

# the first overlay group holding argument `arg`, nil when none does
fun group_of(arg: str) *overlay.Group {
    var i: u32 = 0;
    for (i < overlay.GROUPS_COUNT) {
        if (has_token(overlay.GROUPS[i].args, arg)) { ret ?overlay.GROUPS[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether `excluded` holds a value of `operand` equal to `value`
fun stated(excluded: *vector.Vector[Excl], operand: u8, value: i64) bool {
    var i: usize = 0;
    for (i < excluded.len) {
        if (excluded.data[i].operand == operand && excluded.data[i].value == value) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the values the record's argument `arg` excludes beyond those of `o`, the operand it reads as, each stated in `excluded` for alias operand `k`
fun implied(r: *read.Record, name: str, arg: str, o: *mapping.Operand, k: u8, excluded: *vector.Vector[Excl]) err[diag.Refusal] {
    val g: *overlay.Group = group_of(arg);
    if (g == nil) { ret err[diag.Refusal].ok{}; }
    var i: u32 = 0;
    if ((o.use == overlay.REGISTER || o.use == overlay.SREG) && g.position != nil && o.position != nil) {
        for (i < g.position.excluded.len) {
            val n: u32 = g.position.excluded.at[i];
            if (!excludes_number(o.position, n) && !stated(excluded, k, n::i64)) { ret refuse(r, UNSTATED, name); }
            i = i + 1;
        }
    }
    if (o.use == overlay.IMMEDIATE && g.layout != nil && o.layout != nil) {
        for (i < g.layout.value.excluded.len) {
            val v: i64 = g.layout.value.excluded.at[i];
            if (!operand.excludes_value(?o.layout.value, v) && !stated(excluded, k, v)) { ret refuse(r, UNSTATED, name); }
            i = i + 1;
        }
    }
    ret err[diag.Refusal].ok{};
}

# the values the dialect excludes from the operands of respelling `p`, alias operand `k` written as the `k`th argument of `d.order` and reading as base operand `items[k].op`
# ---
# used: set for each dialect exclusion taken
fun excluded_of(s: *Spell, p: *mapping.Respelling, d: *dialect.Respell, items: *Item, count: u32, used: *bool, out: *vector.Vector[Excl]) err[diag.Refusal] {
    val r:  *read.Record = p.record;
    var k:  u32          = 0;
    var at: usize        = 0;
    for (k < count) {
        val len: usize              = token_len(d.order, at);
        val arg: res[str, StrError] = str_copy_slice(s.alloc, d.order, at, len);
        if (sel arg.err) { ret err[diag.Refusal].err{memory()}; }
        val o: *mapping.Operand = ?p.row.operands.data[items[k].op];
        var i: u32              = 0;
        for (i < dialect.EXCLUSIONS.len) {
            val x: *dialect.Exclusion = ?dialect.EXCLUSIONS.at[i];
            if (overlay.matches(x.name, p.name) && str_equals(x.arg, arg.ok)) {
                val held: bool = o.use == overlay.REGISTER || o.use == overlay.SREG;
                if (!held && o.use != overlay.IMMEDIATE)                                                   { ret refuse(r, BAD_EXCLUSION, p.name); }
                if (!pushed(vector.push[Excl](out, Excl{operand: k::u8, register: held, value: x.value}))) { ret err[diag.Refusal].err{memory()}; }
                used[i] = true;
            }
            i = i + 1;
        }
        val checked: err[diag.Refusal] = implied(r, p.name, arg.ok, o, k::u8, out);
        if (sel checked.err) { ret checked; }
        k  = k + 1;
        at = next_token(d.order, at);
    }
    ret err[diag.Refusal].ok{};
}

# the alias that respells base row `p.row` as pseudo op record `p.record`, written in the dialect's order
# ---
# used: set for each dialect exclusion it takes
fun alias_of(s: *Spell, p: *mapping.Respelling, used: *bool, out: *vector.Vector[Pending]) err[diag.Refusal] {
    val r:    *read.Record           = p.record;
    val row:  *mapping.Row           = p.row;
    val args: res[str, diag.Refusal] = record_args(s, r);
    if (sel args.err) { ret err[diag.Refusal].err{args.err}; }
    val d: *dialect.Respell = dialect_of(p, args.ok);
    if (d == nil)                                         { ret refuse(r, NO_DIALECT, p.name); }
    if (str_len(d.skip) > 0)                              { ret err[diag.Refusal].ok{}; }
    if (((r.match ^ row.match) & r.mask & row.mask) != 0) { ret refuse(r, CONFLICT, p.name); }
    var sources: vector.Vector[Src] = vector.init[Src](s.alloc);
    var fixed:   u32                = 0;
    var j:       u32                = 0;
    for (j < row.operands.len) {
        var is_fixed: bool                   = false;
        val got:      res[Src, diag.Refusal] = source_of(s, r, args.ok, d, ?row.operands.data[j], ?is_fixed);
        if (sel got.err)                                 { ret err[diag.Refusal].err{got.err}; }
        if (is_fixed)                                    { fixed = fixed + 1; }
        if (!pushed(vector.push[Src](?sources, got.ok))) { ret err[diag.Refusal].err{memory()}; }
        j = j + 1;
    }
    # every free argument is written, zeroed, or in an operand a written one covers
    val free:    u64 = bits_of(s, args.ok) & ~tied_bits(s, args.ok);
    var covered: u64 = bits_of(s, d.zero) | row.mask;
    j = 0;
    for (j < row.operands.len) {
        val src: Src = sources.data[j];
        if (src.kind == FROM_OPERAND || src.kind == FROM_MASKED) { covered = covered | bits_of(s, row.operands.data[j].group); }
        j = j + 1;
    }
    if ((free & ~covered) != 0)                          { ret refuse(r, BAD_ORDER, p.name); }
    if ((bits_of(s, d.order) & bits_of(s, d.zero)) != 0) { ret refuse(r, BAD_ORDER, p.name); }
    # the items, one per written argument, standing for the first operand each source gives it
    val count: u32 = count_tokens(d.order);
    var items: [32]Item;
    var k:     u32 = 0;
    for (k < count) {
        var op: u8  = field.NO_OPERAND;
        var q:  u32 = 0;
        for (q < sources.len::u32 && op == field.NO_OPERAND) {
            val src: Src = sources.data[q];
            if ((src.kind == FROM_OPERAND || src.kind == FROM_MASKED) && src.n == k) { op = q::u8; }
            q = q + 1;
        }
        if (op == field.NO_OPERAND) { ret refuse(r, BAD_ORDER, p.name); }
        items[k] = Item{hole: k::u8, op: op};
        k        = k + 1;
    }
    var excluded: vector.Vector[Excl] = vector.init[Excl](s.alloc);
    val ex:       err[diag.Refusal]   = excluded_of(s, p, d, ?items[0], count, used, ?excluded);
    if (sel ex.err) { ret ex; }
    var template: str = nil;
    if (str_len(d.text) > 0) {
        val e: res[str, diag.Refusal] = explicit(s, row, p.name, d.text, d.order);
        if (sel e.err) { ret err[diag.Refusal].err{e.err}; }
        template = e.ok;
    }
    or {
        val c: res[str, diag.Refusal] = compose(s, row, p.name, ?items[0], count, true);
        if (sel c.err) { ret err[diag.Refusal].err{c.err}; }
        template = c.ok;
    }
    val pending: Pending = Pending{row: row.index, template: template, count: count::u8, sources: sources, excluded: excluded, fixed: fixed, print: d.print, own: p.own, order: ((d:~u64 - (?dialect.RESPELLS[0]):~u64) / $size_of(dialect.Respell)::u64)::u32, prefer: 0};
    if (!pushed(vector.push[Pending](out, pending))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# the alias of `row` for each operand that takes a choice the dialect leaves unwritten at a value, written as the row's
# own form without that operand, its value fixed, which the printer prefers
# ---
# none: the requirement of no extension, as the alias needs none beyond its row's
fun defaults_of(s: *Spell, row: *mapping.Row, none: *mapping.Requirement, out: *vector.Vector[Pending]) err[diag.Refusal] {
    var d: u32 = 0;
    for (d < dialect.DEFAULTS_COUNT) {
        val dflt: *dialect.Default = ?dialect.DEFAULTS[d];
        var k:    usize            = 0;
        for (k < row.operands.len) {
            val o: *mapping.Operand = ?row.operands.data[k];
            if (o.use == overlay.CHOICE && o.choice == dflt.choice) {
                if (row_text(row) != nil) { ret err[diag.Refusal].err{diag.refusal(row.record.path, row.record.line, NO_FORM, row.mnemonic)}; }
                var items:   [32]Item;
                var sources: vector.Vector[Src] = vector.init[Src](s.alloc);
                var n:       u32                = 0;
                var j:       usize              = 0;
                for (j < row.operands.len) {
                    var src: Src = Src{kind: FROM_CHOICE, n: 0, mask: 0, value: dflt.value::i64};
                    if (j != k) {
                        items[n] = Item{hole: n::u8, op: j::u8};
                        src      = Src{kind: FROM_OPERAND, n: n, mask: 0, value: 0};
                        n        = n + 1;
                    }
                    if (!pushed(vector.push[Src](?sources, src))) { ret err[diag.Refusal].err{memory()}; }
                    j = j + 1;
                }
                val c: res[str, diag.Refusal] = compose(s, row, row.mnemonic, ?items[0], n, false);
                if (sel c.err) { ret err[diag.Refusal].err{c.err}; }
                val pending: Pending = Pending{row: row.index, template: c.ok, count: n::u8, sources: sources, excluded: vector.init[Excl](s.alloc), fixed: 1, print: true, own: none, order: dialect.RESPELLS_COUNT + d, prefer: 0};
                if (!pushed(vector.push[Pending](out, pending))) { ret err[diag.Refusal].err{memory()}; }
            }
            k = k + 1;
        }
        d = d + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun by_base(x: *Pending, y: *Pending) i64 {
    if (x.row != y.row) { ret x.row::i64 - y.row::i64; }
    ret x.order::i64 - y.order::i64;
}

# whether alias `x` is preferred to `y`: it fixes more of the base's operands, or as many and comes later in the dialect
fun above(x: *Pending, y: *Pending) bool {
    if (x.fixed != y.fixed) { ret x.fixed > y.fixed; }
    ret x.order > y.order;
}

# the printed aliases of one base ranked by `above`, those it ranks alike by their place, as the mop and ntl families whose members exclude each other
fun prefer(aliases: *vector.Vector[Pending]) {
    var i: usize = 0;
    for (i < aliases.len) {
        if (aliases.data[i].print) {
            var rank: u8    = 1;
            var j:    usize = 0;
            for (j < aliases.len) {
                if (aliases.data[j].row == aliases.data[i].row && aliases.data[j].print && (above(?aliases.data[i], ?aliases.data[j]) || (!above(?aliases.data[j], ?aliases.data[i]) && i > j))) { rank = rank + 1; }
                j = j + 1;
            }
            aliases.data[i].prefer = rank;
        }
        i = i + 1;
    }
}

fun text_value(t: str) emit.Value {
    ret emit.Value.text{t};
}

fun number(n: i64) emit.Value {
    ret emit.Value.number{n};
}

fun source_value(f: *emit.File, x: Src) emit.Value {
    if (x.kind == FROM_OPERAND) { ret emit.Value.variant{emit.variant(f, "syntax.Source.operand", number(x.n::i64))}; }
    if (x.kind == FROM_MASKED) {
        val m: *emit.Record = emit.record(f, "syntax.Mask");
        emit.member(f, m, "operand", number(x.n::i64));
        emit.member(f, m, "mask", emit.Value.hex{x.mask});
        emit.member(f, m, "value", emit.Value.hex{x.value:~u64});
        ret emit.Value.variant{emit.variant(f, "syntax.Source.masked", emit.Value.record{m})};
    }
    if (x.kind == FROM_REGISTER) { ret emit.Value.variant{emit.variant(f, "syntax.Source.register", number(x.n::i64))}; }
    var of: str = "operand.Value.immediate";
    if (x.kind == FROM_CHOICE) { of = "operand.Value.enumerant"; }
    if (x.kind == FROM_ID)     { of = "operand.Value.id"; }
    val v: emit.Value = emit.Value.variant{emit.variant(f, of, number(x.value))};
    ret emit.Value.variant{emit.variant(f, "syntax.Source.value", v)};
}

# a candidate before the index is built
rec Cand {
    key:   str;
    row:   u32;
    alias: u32;
}

fun by_candidate(x: *Cand, y: *Cand) i64 {
    val c: i64 = str_compare(x.key, y.key);
    if (c != 0)         { ret c; }
    if (x.row != y.row) { ret x.row::i64 - y.row::i64; }
    ret x.alias::i64 - y.alias::i64;
}

fun key_of(s: *Spell, template: str) res[str, diag.Refusal] {
    val m: View               = syntax.mnemonic(template);
    val k: res[str, StrError] = str_copy_slice(s.alloc, template, 0, m.len);
    if (sel k.err) { ret res[str, diag.Refusal].err{memory()}; }
    ret res[str, diag.Refusal].ok{k.ok};
}

# the requirement `req` as a record over runs of the pools, the shared constant when it names no alternative
fun requirement(a: *A.Allocator, f: *emit.File, ids: *emit.Pool, alts: *emit.Pool, req: *mapping.Requirement) emit.Value {
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](a);
    var i:     usize                     = 0;
    for (i < req.alternatives.len) {
        val alt:   *mapping.Alternative      = req.alternatives.data[i];
        var names: vector.Vector[emit.Value] = vector.init[emit.Value](a);
        var k:     usize                     = 0;
        for (k < alt.ids.len) {
            val n: str = mapping.atom_name(f.alloc, alt.ids.data[k]);
            vector.push[emit.Value](?names, emit.Value.name{emit.concat(f, "riscv_extension.", emit.ident(f, n))});
            k = k + 1;
        }
        val first: u32          = emit.pooled(f, ids, names.data, names.len::u32);
        val made:  *emit.Record = emit.record(f, "requirement.Alternative");
        emit.member(f, made, "all", run(f, "requirement.Ids", "REQUIRE_IDS", first, names.len::u32));
        emit.member(f, made, "none", emit.Value.name{"requirement.NO_IDS"});
        vector.push[emit.Value](?items, emit.Value.record{made});
        i = i + 1;
    }
    var at: u32 = 0;
    if (items.len > 0)  { at = emit.pooled(f, alts, items.data, items.len::u32); }
    if (items.len == 0) { ret emit.Value.name{"requirement.NO_ALTERNATIVES"}; }
    ret run(f, "requirement.Requirement", "REQUIRE_ALTERNATIVES", at, items.len::u32);
}

# the exclusions of `excluded` as a record over runs of the pools, the shared constant when there are none
fun exclusions(a: *A.Allocator, f: *emit.File, exclus: *emit.Pool, numbers: *emit.Pool, ints: *emit.Pool, excluded: *vector.Vector[Excl]) emit.Value {
    if (excluded.len == 0) { ret emit.Value.name{"syntax.NO_EXCLUSIONS"}; }
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](a);
    var i:     usize                     = 0;
    for (i < excluded.len) {
        val first: Excl                      = excluded.data[i];
        var vals:  vector.Vector[emit.Value] = vector.init[emit.Value](a);
        var j:     usize                     = i;
        for (j < excluded.len && excluded.data[j].operand == first.operand) {
            vector.push[emit.Value](?vals, number(excluded.data[j].value));
            j = j + 1;
        }
        var excl: emit.Value = emit.Value.name{"nil"};
        if (first.register) {
            val at: u32 = emit.pooled(f, numbers, vals.data, vals.len::u32);
            excl = emit.Value.variant{emit.variant(f, "syntax.Excluded.register", run(f, "operand.Numbers", "EXCLUDED_NUMBERS", at, vals.len::u32))};
        }
        or {
            val at: u32 = emit.pooled(f, ints, vals.data, vals.len::u32);
            excl = emit.Value.variant{emit.variant(f, "syntax.Excluded.immediate", run(f, "operand.Integers", "EXCLUDED_INTEGERS", at, vals.len::u32))};
        }
        val x: *emit.Record = emit.record(f, "syntax.Exclusion");
        emit.member(f, x, "operand", number(first.operand::i64));
        emit.member(f, x, "excluded", excl);
        vector.push[emit.Value](?items, emit.Value.record{x});
        i = j;
    }
    ret run(f, "syntax.Exclusions", "ALIAS_EXCLUSIONS", emit.pooled(f, exclus, items.data, items.len::u32), items.len::u32);
}

# a pointer and count record over run `at` of `count` items of the array declared `array`, which the caller keeps non-empty
fun run(f: *emit.File, of: str, array: str, at: u32, count: u32) emit.Value {
    val r: *emit.Record = emit.record(f, of);
    emit.member(f, r, "at", emit.element(f, array, at));
    emit.member(f, r, "len", number(count::i64));
    ret emit.Value.record{r};
}

# the syntax tables of the catalog, written into `f`
pub fun generate(a: *A.Allocator, f: *emit.File, source: *read.Source, catalog: *mapping.Catalog, file: *register.File) err[diag.Refusal] {
    var s: Spell = Spell{alloc: a, source: source, catalog: catalog, file: file};
    emit.uses(f, "masc.core.operand");
    emit.uses(f, "masc.core.syntax");
    emit.uses(f, "masc.core.extension");
    emit.uses(f, "masc.core.requirement");
    emit.uses(f, "riscv_extension: masc.isa.riscv.extension");
    emit.uses(f, "std.types.string.str");
    val forms: *emit.Array         = emit.array(f, "str");
    var texts: vector.Vector[str]  = vector.init[str](a);
    var cands: vector.Vector[Cand] = vector.init[Cand](a);
    var i:     usize               = 0;
    for (i < catalog.rows.len) {
        val row:  *mapping.Row           = catalog.rows.data[i];
        val form: res[str, diag.Refusal] = form_of(?s, row);
        if (sel form.err) { ret err[diag.Refusal].err{form.err}; }
        emit.item(f, forms, text_value(form.ok));
        if (!pushed(vector.push[str](?texts, form.ok))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    var pending: vector.Vector[Pending] = vector.init[Pending](a);
    var used:    vector.Vector[bool]    = vector.init[bool](a);
    var u:       u32                    = 0;
    for (u < dialect.EXCLUSIONS.len) {
        if (!pushed(vector.push[bool](?used, false))) { ret err[diag.Refusal].err{memory()}; }
        u = u + 1;
    }
    i = 0;
    for (i < catalog.respellings.len) {
        val done: err[diag.Refusal] = alias_of(?s, ?catalog.respellings.data[i], used.data, ?pending);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    val none: res[*mapping.Requirement, A.Error] = A.allocate[mapping.Requirement](a, 1);
    if (sel none.err) { ret err[diag.Refusal].err{memory()}; }
    none.ok.alternatives = vector.init[*mapping.Alternative](a);
    i                    = 0;
    for (i < catalog.rows.len) {
        val done: err[diag.Refusal] = defaults_of(?s, catalog.rows.data[i], none.ok, ?pending);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    u = 0;
    for (u < dialect.EXCLUSIONS.len) {
        if (!used.data[u]) { ret err[diag.Refusal].err{diag.refusal(nil, 0, BAD_EXCLUSION, dialect.EXCLUSIONS.at[u].name)}; }
        u = u + 1;
    }
    sort.sort_by[Pending](pending.data, pending.len, by_base);
    prefer(?pending);
    var sources: emit.Pool   = emit.pool(f, "syntax.Source");
    var exclus:  emit.Pool   = emit.pool(f, "syntax.Exclusion");
    var numbers: emit.Pool   = emit.pool(f, "u32");
    var ints:    emit.Pool   = emit.pool(f, "i64");
    var rids:    emit.Pool   = emit.pool(f, "requirement.Id");
    var ralts:   emit.Pool   = emit.pool(f, "requirement.Alternative");
    val aliases: *emit.Array = emit.array(f, "syntax.Alias");
    i = 0;
    for (i < pending.len) {
        val p:    *Pending                  = ?pending.data[i];
        var vals: vector.Vector[emit.Value] = vector.init[emit.Value](a);
        var k:    usize                     = 0;
        for (k < p.sources.len) {
            vector.push[emit.Value](?vals, source_value(f, p.sources.data[k]));
            k = k + 1;
        }
        val at: u32          = emit.pooled(f, ?sources, vals.data, vals.len::u32);
        val sr: *emit.Record = emit.record(f, "syntax.Sources");
        emit.member(f, sr, "at", emit.element(f, "SOURCES", at));
        emit.member(f, sr, "len", number(vals.len::i64));
        val r: *emit.Record = emit.record(f, "syntax.Alias");
        emit.member(f, r, "row", number(p.row::i64));
        emit.member(f, r, "template", text_value(p.template));
        emit.member(f, r, "count", number(p.count::i64));
        emit.member(f, r, "sources", emit.Value.record{sr});
        emit.member(f, r, "derive", emit.Value.name{"nil"});
        emit.member(f, r, "exclusions", exclusions(a, f, ?exclus, ?numbers, ?ints, ?p.excluded));
        emit.member(f, r, "requires", requirement(a, f, ?rids, ?ralts, p.own));
        emit.member(f, r, "preference", number(p.prefer::i64));
        emit.item(f, aliases, emit.Value.record{r});
        i = i + 1;
    }
    i = 0;
    for (i < catalog.rows.len) {
        val key: res[str, diag.Refusal] = key_of(?s, texts.data[i]);
        if (sel key.err) { ret err[diag.Refusal].err{key.err}; }
        vector.push[Cand](?cands, Cand{key: key.ok, row: i::u32, alias: 0});
        i = i + 1;
    }
    i = 0;
    for (i < pending.len) {
        val key: res[str, diag.Refusal] = key_of(?s, pending.data[i].template);
        if (sel key.err) { ret err[diag.Refusal].err{key.err}; }
        vector.push[Cand](?cands, Cand{key: key.ok, row: pending.data[i].row, alias: i::u32 + 1});
        i = i + 1;
    }
    sort.sort_by[Cand](cands.data, cands.len, by_candidate);
    val entries: *emit.Array = emit.array(f, "syntax.Entry");
    val ordered: *emit.Array = emit.array(f, "syntax.Candidate");
    i = 0;
    for (i < cands.len) {
        var j: usize = i;
        for (j < cands.len && str_equals(cands.data[j].key, cands.data[i].key)) {
            val c: *emit.Record = emit.record(f, "syntax.Candidate");
            emit.member(f, c, "row", number(cands.data[j].row::i64));
            emit.member(f, c, "alias", number(cands.data[j].alias::i64));
            emit.item(f, ordered, emit.Value.record{c});
            j = j + 1;
        }
        val e: *emit.Record = emit.record(f, "syntax.Entry");
        emit.member(f, e, "key", text_value(cands.data[i].key));
        emit.member(f, e, "first", number(i::i64));
        emit.member(f, e, "len", number((j - i)::i64));
        emit.item(f, entries, emit.Value.record{e});
        i = j;
    }
    emit.declare(f, "FORM_TEXT", nil, emit.Value.array{forms});
    emit.declare(f, "SOURCES", nil, emit.Value.array{sources.array});
    if (emit.length(exclus.array) > 0)  { emit.declare(f, "ALIAS_EXCLUSIONS", nil, emit.Value.array{exclus.array}); }
    if (emit.length(numbers.array) > 0) { emit.declare(f, "EXCLUDED_NUMBERS", nil, emit.Value.array{numbers.array}); }
    if (emit.length(ints.array) > 0)    { emit.declare(f, "EXCLUDED_INTEGERS", nil, emit.Value.array{ints.array}); }
    emit.declare(f, "REQUIRE_IDS", nil, emit.Value.array{rids.array});
    emit.declare(f, "REQUIRE_ALTERNATIVES", nil, emit.Value.array{ralts.array});
    emit.declare(f, "ALIAS_ROWS", nil, emit.Value.array{aliases});
    emit.declare(f, "ENTRIES", nil, emit.Value.array{entries});
    emit.declare(f, "CANDIDATES", nil, emit.Value.array{ordered});
    emit.declare(f, "FORM_COUNT", "u32", number(catalog.rows.len::i64));
    emit.declare(f, "ALIAS_COUNT", "u32", number(pending.len::i64));
    emit.declare(f, "ENTRY_COUNT", "u32", number(emit.length(entries)::i64));
    emit.declare(f, "CANDIDATE_COUNT", "u32", number(emit.length(ordered)::i64));
    ret err[diag.Refusal].ok{};
}
