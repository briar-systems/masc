# the constant-time lists of the riscv rows, read from the ct topic
#
# each line of gen/data/riscv/ct.txt is `independent <mnemonic> |
# when=<requirement> keeps=<inputs>`: every row of the mnemonic depends on no
# input under the requirement but those it keeps, which the riscv generator
# writes as the row's conditional class. an input kept is an argument of the
# row, naming its operand, or a register of the file no operand names. riscv-opcodes states no timing, so the topic overrides nothing, and
# every row no line names keeps the dependent class.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use gen.diag;
use topic: gen.overlay;

pub val TOPIC: str = "ct";

pub val TWICE:  str = "ct list names a mnemonic twice";
pub val NO_ROW: str = "ct list names a mnemonic no row has";

# one listed mnemonic
# ---
# mnemonic: the rows it names
# when:     the requirement under which they depend on no input but those kept, as the files topic spells one
# keeps:    the inputs they still depend on under it, arguments and registers split by spaces, empty for none
# fact:     its line, for refusals
pub rec Entry {
    mnemonic: str;
    when:     str;
    keeps:    str;
    fact:     *topic.Fact;
}

# the listed mnemonics, in file order, and each mnemonic's entry
pub rec Lists {
    entries: vector.Vector[Entry];
    by:      map.Map[str, u32];
}

val NAMES: [2]str = [2]str{"when", "keeps"};

# the ct topic `t` read into `out`, a mnemonic listed twice refused
pub fun read(a: *A.Allocator, t: *topic.Topic, out: *Lists) err[diag.Refusal] {
    out.entries = vector.init[Entry](a);
    out.by      = map.init[str, u32](a);
    val checked: err[diag.Refusal] = topic.check(t, nil, topic.unstated);
    if (sel checked.err) { ret checked; }
    var i: usize = 0;
    for (i < t.facts.len) {
        var l:     topic.Line;
        val lined: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel lined.err)                   { ret lined; }
        if (!topic.is(?l, "independent", 2)) { ret topic.reject(?l, topic.BAD_FACT, l.fact.key); }
        val words: err[diag.Refusal] = topic.known(?l, ?NAMES[0], 2);
        if (sel words.err) { ret words; }
        var e:    Entry             = Entry{mnemonic: l.key.data[1], when: nil, keeps: topic.optional(?l, "keeps", ""), fact: ?t.facts.data[i]};
        val when: err[diag.Refusal] = topic.needed(?l, "when", ?e.when);
        if (sel when.err) { ret when; }
        val prior: opt[*u32] = map.get[str, u32](?out.by, ?e.mnemonic);
        if (sel prior.some) { ret topic.reject(?l, TWICE, e.mnemonic); }
        val inserted: res[bool, A.Error] = map.insert[str, u32](?out.by, e.mnemonic, out.entries.len::u32);
        if (sel inserted.err) { ret topic.reject(?l, diag.MEMORY, nil); }
        val pushed: res[usize, A.Error] = vector.push[Entry](?out.entries, e);
        if (sel pushed.err) { ret topic.reject(?l, diag.MEMORY, nil); }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the entry listing `mnemonic`, none when no line does
pub fun listed(l: *Lists, mnemonic: str) opt[*Entry] {
    val at: opt[*u32] = map.get[str, u32](?l.by, ?mnemonic);
    if (sel at.none) { ret opt[*Entry].none{}; }
    ret opt[*Entry].some{?l.entries.data[@at.some]};
}

# every listed mnemonic held to the rows: refused naming the first that `named` says no row has
# ---
# ctx:   what `named` reads
# named: whether some row has the mnemonic
pub fun cover(l: *Lists, ctx: ptr, named: fun(ptr, str) bool) err[diag.Refusal] {
    var i: usize = 0;
    for (i < l.entries.len) {
        val e: *Entry = ?l.entries.data[i];
        if (!named(ctx, e.mnemonic)) { ret err[diag.Refusal].err{topic.refuse(e.fact, NO_ROW, e.mnemonic)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}
