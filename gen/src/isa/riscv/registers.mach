# the riscv register file, read from the registers topic and written as gen_register
#
# the topic gen/data/riscv/registers.txt states the quantities the file scales
# by and their bounds, the slots they bind, the classes, the registers, their
# aliases and their debug numbers, each line citing where it is read from. the
# generator builds the file in memory as the core record masc holds, maps rows
# against it, and writes it with its handles as gen_register. a run `a0..a7` names the registers or aliases whose
# names count on from the first's number, and a run of registers numbers and
# banks them on from the first.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.map;
use std.collections.sort;
use std.collections.vector;
use std.format;

use masc.core.extension;
use masc.core.index;
use masc.core.quantity;
use masc.core.register;
use masc.core.requirement;
use masc.core.state;

use gen.diag;
use gen.emit;
use gen.handles;
use gen.overlay;
use gen.set;
use gen.storage;

pub val TOPIC: str = "registers";

pub val BAD_FACT:       str = "registers line is not quantity, bound, binding, class, register, tuple, measure, alias, column or number";
pub val BAD_SCALED:     str = "scaled amount is not fixed:per:scale";
pub val BAD_RUN:        str = "run is not two names of one prefix counting up";
pub val UNKNOWN:        str = "registers line names a quantity, class, register or column the topic does not state before it";
pub val UNKNOWN_ATOM:   str = "requirement names no extension or state value of the catalog";
pub val NAMED_TWICE:    str = "register or alias name given twice";
pub val UNORDERED:      str = "registers are not in ascending order of class and number";
pub val NUMBERED_TWICE: str = "register numbered twice in one column";
pub val MISSING:        str = "registers line lacks a word its kind needs";
pub val UNEVEN:         str = "alias run and register run differ in length";
pub val BAD_TUPLE:      str = "tuple names no class, an arity below two, an order other than significance, address or apart, or a first register no class holds";
pub val TUPLE_REQUIRES: str = "tuple's members differ in what they require";

# a register's number in one column, as the topic states it
rec Numbering {
    column: u32;
    row:    u32;
    number: u32;
}

# the topic's records as they are read, before the file is laid out
rec Reading {
    alloc:      *A.Allocator;
    catalog:    *extension.Catalog;
    axes:       *state.Axes;
    quantities: vector.Vector[quantity.Quantity];
    bounds:     vector.Vector[vector.Vector[quantity.Bound]];
    gauges:     vector.Vector[vector.Vector[quantity.Gauge]];
    bindings:   vector.Vector[quantity.Binding];
    classes:    vector.Vector[register.Class];
    registers:  vector.Vector[register.Register];
    aliases:    vector.Vector[register.Alias];
    formats:    vector.Vector[register.Format];
    columns:    vector.Vector[str];
    numbering:  vector.Vector[Numbering];
}

# the file and what its requirements are over
# ---
# file:    the register file, as masc's register module states it
# catalog: the catalog its requirements name
# axes:    the state axes of the catalog
pub rec Registers {
    file:    register.File;
    catalog: *extension.Catalog;
    axes:    *state.Axes;
}

fun memory(f: *overlay.Fact) diag.Refusal {
    ret overlay.refuse(f, diag.MEMORY, nil);
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun number_of(f: *overlay.Fact, text: str) res[u32, diag.Refusal] {
    val res_number: res[i64, diag.Refusal] = overlay.number(f, text);
    if (sel res_number.err)                               { ret res[u32, diag.Refusal].err{res_number.err}; }
    if (res_number.ok < 0 || res_number.ok > 0xFFFF_FFFF) { ret res[u32, diag.Refusal].err{overlay.refuse(f, overlay.BAD_NUMBER, text)}; }
    ret res[u32, diag.Refusal].ok{res_number.ok::u32};
}

# the named value `name` of `ws` as a number, `otherwise` when no word names it and it is not `needed`
fun named_number(f: *overlay.Fact, ws: *vector.Vector[str], name: str, otherwise: u32, needed: bool) res[u32, diag.Refusal] {
    val opt_value: opt[str] = overlay.value(ws, name);
    if (sel opt_value.none) {
        if (needed) { ret res[u32, diag.Refusal].err{overlay.refuse(f, MISSING, name)}; }
        ret res[u32, diag.Refusal].ok{otherwise};
    }
    ret number_of(f, opt_value.some);
}

# the scaled amount `text` spells as fixed:per:scale
fun scaled(f: *overlay.Fact, text: str) res[quantity.Scaled, diag.Refusal] {
    var parts: [3]u32;
    var at:    usize = 0;
    var k:     u32   = 0;
    for (k < 3) {
        var n:   u32  = 0;
        var any: bool = false;
        for (text[at] >= '0' && text[at] <= '9') {
            n   = n * 10 + (text[at] - '0')::u32;
            any = true;
            at  = at + 1;
        }
        if (!any) { ret res[quantity.Scaled, diag.Refusal].err{overlay.refuse(f, BAD_SCALED, text)}; }
        parts[k] = n;
        if (k < 2) {
            if (text[at] != ':') { ret res[quantity.Scaled, diag.Refusal].err{overlay.refuse(f, BAD_SCALED, text)}; }
            at = at + 1;
        }
        k = k + 1;
    }
    if (text[at] != 0 || parts[2] > 255) { ret res[quantity.Scaled, diag.Refusal].err{overlay.refuse(f, BAD_SCALED, text)}; }
    ret res[quantity.Scaled, diag.Refusal].ok{quantity.Scaled{fixed: parts[0], per: parts[1], scale: parts[2]::u8}};
}

fun named_scaled(f: *overlay.Fact, ws: *vector.Vector[str], name: str, otherwise: quantity.Scaled) res[quantity.Scaled, diag.Refusal] {
    val opt_value: opt[str] = overlay.value(ws, name);
    if (sel opt_value.none) { ret res[quantity.Scaled, diag.Refusal].ok{otherwise}; }
    ret scaled(f, opt_value.some);
}

# where the decimal digits that end `name` start, its length when none do
fun digits_at(name: str) usize {
    var at: usize = str_len(name);
    for (at > 0 && name[at - 1] >= '0' && name[at - 1] <= '9') {
        at = at - 1;
    }
    ret at;
}

fun decimal(text: str, at: usize) u32 {
    var n: u32   = 0;
    var i: usize = at;
    for (text[i] != 0) {
        n = n * 10 + (text[i] - '0')::u32;
        i = i + 1;
    }
    ret n;
}

# the names `text` spells, one name or the run `first..last`, into `out`
fun run(a: *A.Allocator, f: *overlay.Fact, text: str, out: *vector.Vector[str]) err[diag.Refusal] {
    val len: usize = str_len(text);
    var dot: usize = 0;
    for (dot + 1 < len && !(text[dot] == '.' && text[dot + 1] == '.')) {
        dot = dot + 1;
    }
    if (dot + 1 >= len) {
        if (!pushed(vector.push[str](out, text))) { ret err[diag.Refusal].err{memory(f)}; }
        ret err[diag.Refusal].ok{};
    }
    val res_head: res[*u8, A.Error] = A.allocate[u8](a, dot + 1);
    if (sel res_head.err) { ret err[diag.Refusal].err{memory(f)}; }
    var i: usize = 0;
    for (i < dot) {
        res_head.ok[i] = text[i];
        i              = i + 1;
    }
    res_head.ok[dot] = 0;
    val first: str   = res_head.ok;
    val last:  str   = ?text[dot + 2];
    val fa:    usize = digits_at(first);
    val la:    usize = digits_at(last);
    var same:  bool  = fa == la && fa < str_len(first) && la < str_len(last);
    i = 0;
    for (same && i < fa) {
        if (first[i] != last[i]) { same = false; }
        i = i + 1;
    }
    if (!same) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_RUN, text)}; }
    val lo: u32 = decimal(first, fa);
    val hi: u32 = decimal(last, la);
    if (hi <= lo) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_RUN, text)}; }
    var n: u32 = lo;
    for (n <= hi) {
        var digits: [16]u8;
        val dl:     usize = format.put_u64(?digits[0], n::u64);
        digits[dl] = 0;
        val res_allocate: res[*u8, A.Error] = A.allocate[u8](a, fa + dl + 1);
        if (sel res_allocate.err) { ret err[diag.Refusal].err{memory(f)}; }
        var k: usize = 0;
        for (k < fa) {
            res_allocate.ok[k] = first[k];
            k                  = k + 1;
        }
        k = 0;
        for (k < dl) {
            res_allocate.ok[fa + k] = digits[k];
            k                       = k + 1;
        }
        res_allocate.ok[fa + dl] = 0;
        if (!pushed(vector.push[str](out, res_allocate.ok))) { ret err[diag.Refusal].err{memory(f)}; }
        n = n + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the requirement `text` spells: alternatives split by `|`, atoms by spaces, an atom after `!` one it must not hold
fun requires(r: *Reading, f: *overlay.Fact, text: str) res[requirement.Requirement, diag.Refusal] {
    var alts: vector.Vector[requirement.Alternative] = vector.init[requirement.Alternative](r.alloc);
    val len:  usize                                  = str_len(text);
    var at:   usize                                  = 0;
    for (at <= len) {
        var end: usize = at;
        for (end < len && text[end] != '|') {
            end = end + 1;
        }
        var all:  vector.Vector[requirement.Id] = vector.init[requirement.Id](r.alloc);
        var none: vector.Vector[requirement.Id] = vector.init[requirement.Id](r.alloc);
        var i:    usize                         = at;
        for (i < end) {
            if (text[i] == ' ') {
                i = i + 1;
                cnt;
            }
            var out: *vector.Vector[requirement.Id] = ?all;
            if (text[i] == '!') {
                out = ?none;
                i   = i + 1;
            }
            var stop: usize = i;
            for (stop < end && text[stop] != ' ') {
                stop = stop + 1;
            }
            val opt_lookup: opt[requirement.Id] = state.lookup(r.catalog, r.axes, text, i, stop - i);
            if (sel opt_lookup.none)                                        { ret res[requirement.Requirement, diag.Refusal].err{overlay.refuse(f, UNKNOWN_ATOM, text)}; }
            if (!pushed(vector.push[requirement.Id](out, opt_lookup.some))) { ret res[requirement.Requirement, diag.Refusal].err{memory(f)}; }
            i = stop;
        }
        var alt: requirement.Alternative = requirement.Alternative{all: requirement.NO_IDS, none: requirement.NO_IDS};
        if (all.len > 0)                                               { alt.all = requirement.Ids{at: all.data, len: all.len::u32}; }
        if (none.len > 0)                                              { alt.none = requirement.Ids{at: none.data, len: none.len::u32}; }
        if (!pushed(vector.push[requirement.Alternative](?alts, alt))) { ret res[requirement.Requirement, diag.Refusal].err{memory(f)}; }
        at = end + 1;
    }
    ret res[requirement.Requirement, diag.Refusal].ok{requirement.Requirement{at: alts.data, len: alts.len::u32}};
}

fun named_requires(r: *Reading, f: *overlay.Fact, ws: *vector.Vector[str], name: str) res[requirement.Requirement, diag.Refusal] {
    val opt_value: opt[str] = overlay.value(ws, name);
    if (sel opt_value.none) { ret res[requirement.Requirement, diag.Refusal].ok{requirement.NO_ALTERNATIVES}; }
    ret requires(r, f, opt_value.some);
}

fun quantity_named(r: *Reading, name: str) opt[u32] {
    var i: usize = 0;
    for (i < r.quantities.len) {
        if (str_equals(r.quantities.data[i].name, name)) { ret opt[u32].some{i::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

fun class_named(r: *Reading, name: str) opt[u32] {
    var i: usize = 0;
    for (i < r.classes.len) {
        if (str_equals(r.classes.data[i].name, name)) { ret opt[u32].some{i::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

fun register_named(r: *Reading, name: str) opt[u32] {
    var i: usize = 0;
    for (i < r.registers.len) {
        if (str_equals(r.registers.data[i].name, name)) { ret opt[u32].some{i::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

fun column_named(r: *Reading, name: str) opt[u32] {
    var i: usize = 0;
    for (i < r.columns.len) {
        if (str_equals(r.columns.data[i], name)) { ret opt[u32].some{i::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

fun quantity_line(r: *Reading, f: *overlay.Fact, key: *vector.Vector[str], ws: *vector.Vector[str]) err[diag.Refusal] {
    if (key.len != 2) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    val res_unit:  res[u32, diag.Refusal] = named_number(f, ws, "unit", 0, true);
    val res_least: res[u32, diag.Refusal] = named_number(f, ws, "least", 0, true);
    val res_most:  res[u32, diag.Refusal] = named_number(f, ws, "most", 0, true);
    if (sel res_unit.err)  { ret err[diag.Refusal].err{res_unit.err}; }
    if (sel res_least.err) { ret err[diag.Refusal].err{res_least.err}; }
    if (sel res_most.err)  { ret err[diag.Refusal].err{res_most.err}; }
    val q: quantity.Quantity = quantity.Quantity{name: key.data[1], unit: res_unit.ok, domain: quantity.Domain.powers{quantity.Range{least: res_least.ok, most: res_most.ok}}, bounds: quantity.NO_BOUNDS, gauges: quantity.NO_GAUGES};
    if (!pushed(vector.push[quantity.Quantity](?r.quantities, q)))                                            { ret err[diag.Refusal].err{memory(f)}; }
    if (!pushed(vector.push[vector.Vector[quantity.Bound]](?r.bounds, vector.init[quantity.Bound](r.alloc)))) { ret err[diag.Refusal].err{memory(f)}; }
    if (!pushed(vector.push[vector.Vector[quantity.Gauge]](?r.gauges, vector.init[quantity.Gauge](r.alloc)))) { ret err[diag.Refusal].err{memory(f)}; }
    ret err[diag.Refusal].ok{};
}

fun bound_line(r: *Reading, f: *overlay.Fact, key: *vector.Vector[str], ws: *vector.Vector[str]) err[diag.Refusal] {
    if (key.len != 2) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    val opt_quantity_named: opt[u32] = quantity_named(r, key.data[1]);
    if (sel opt_quantity_named.none) { ret err[diag.Refusal].err{overlay.refuse(f, UNKNOWN, key.data[1])}; }
    val opt_when: opt[str] = overlay.value(ws, "when");
    if (sel opt_when.none) { ret err[diag.Refusal].err{overlay.refuse(f, MISSING, "when")}; }
    val res_req: res[requirement.Requirement, diag.Refusal] = requires(r, f, opt_when.some);
    if (sel res_req.err) { ret err[diag.Refusal].err{res_req.err}; }
    val res_least: res[u32, diag.Refusal] = named_number(f, ws, "least", 0, true);
    val res_most:  res[u32, diag.Refusal] = named_number(f, ws, "most", 0, true);
    if (sel res_least.err)                                                                                                                                       { ret err[diag.Refusal].err{res_least.err}; }
    if (sel res_most.err)                                                                                                                                        { ret err[diag.Refusal].err{res_most.err}; }
    if (!pushed(vector.push[quantity.Bound](?r.bounds.data[opt_quantity_named.some], quantity.Bound{when: res_req.ok, least: res_least.ok, most: res_most.ok}))) { ret err[diag.Refusal].err{memory(f)}; }
    ret err[diag.Refusal].ok{};
}

fun binding_line(r: *Reading, f: *overlay.Fact, key: *vector.Vector[str], ws: *vector.Vector[str]) err[diag.Refusal] {
    if (key.len != 2) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    val res_slot: res[u32, diag.Refusal] = number_of(f, key.data[1]);
    if (sel res_slot.err) { ret err[diag.Refusal].err{res_slot.err}; }
    val opt_name: opt[str] = overlay.value(ws, "quantity");
    if (sel opt_name.none) { ret err[diag.Refusal].err{overlay.refuse(f, MISSING, "quantity")}; }
    val opt_quantity_named: opt[u32] = quantity_named(r, opt_name.some);
    if (sel opt_quantity_named.none) { ret err[diag.Refusal].err{overlay.refuse(f, UNKNOWN, opt_name.some)}; }
    val res_when: res[requirement.Requirement, diag.Refusal] = named_requires(r, f, ws, "when");
    if (sel res_when.err)                                                                                                                                       { ret err[diag.Refusal].err{res_when.err}; }
    if (!pushed(vector.push[quantity.Binding](?r.bindings, quantity.Binding{slot: res_slot.ok::u8, when: res_when.ok, quantity: opt_quantity_named.some::u8}))) { ret err[diag.Refusal].err{memory(f)}; }
    ret err[diag.Refusal].ok{};
}

val KIND_NAMES: [7]str = [7]str{"general", "float", "vector", "predicate", "flags", "tile", "system"};

fun class_line(r: *Reading, f: *overlay.Fact, key: *vector.Vector[str], ws: *vector.Vector[str]) err[diag.Refusal] {
    if (key.len != 2) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    val opt_kind: opt[str] = overlay.value(ws, "kind");
    if (sel opt_kind.none) { ret err[diag.Refusal].err{overlay.refuse(f, MISSING, "kind")}; }
    var k: u32 = 0;
    for (k < 7 && !str_equals(KIND_NAMES[k], opt_kind.some)) {
        k = k + 1;
    }
    if (k == 7) { ret err[diag.Refusal].err{overlay.refuse(f, overlay.UNKNOWN_WORD, opt_kind.some)}; }
    val none:      quantity.Scaled                    = quantity.Scaled{fixed: 0, per: 0, scale: 0};
    val res_width: res[quantity.Scaled, diag.Refusal] = named_scaled(f, ws, "width", none);
    val res_count: res[quantity.Scaled, diag.Refusal] = named_scaled(f, ws, "count", none);
    if (sel res_width.err)                                                                                                                                     { ret err[diag.Refusal].err{res_width.err}; }
    if (sel res_count.err)                                                                                                                                     { ret err[diag.Refusal].err{res_count.err}; }
    if (!pushed(vector.push[register.Class](?r.classes, register.Class{name: key.data[1], kind: k::register.Kind, width: res_width.ok, count: res_count.ok}))) { ret err[diag.Refusal].err{memory(f)}; }
    ret err[diag.Refusal].ok{};
}

# the flags `text` names, split by commas
fun flags_of(f: *overlay.Fact, text: str) res[register.Flags, diag.Refusal] {
    var flags: register.Flags = 0;
    var at:    usize          = 0;
    val len:   usize          = str_len(text);
    for (at < len) {
        var end: usize = at;
        for (end < len && text[end] != ',') {
            end = end + 1;
        }
        var word: [16]u8;
        var k:    usize = 0;
        for (k < end - at && k < 15) {
            word[k] = text[at + k];
            k       = k + 1;
        }
        word[k] = 0;
        val w: str = ?word[0];
        if (str_equals(w, "zero"))      { flags = flags | register.ZERO; }
        or (str_equals(w, "link"))      { flags = flags | register.LINK; }
        or (str_equals(w, "stack"))     { flags = flags | register.STACK; }
        or (str_equals(w, "accrued"))   { flags = flags | register.ACCRUED; }
        or (str_equals(w, "length"))    { flags = flags | register.LENGTH; }
        or (str_equals(w, "pc"))        { flags = flags | register.PC; }
        or (str_equals(w, "unspelled")) { flags = flags | register.UNSPELLED; }
        or                              { ret res[register.Flags, diag.Refusal].err{overlay.refuse(f, overlay.UNKNOWN_WORD, text)}; }
        at = end + 1;
    }
    ret res[register.Flags, diag.Refusal].ok{flags};
}

fun register_line(r: *Reading, f: *overlay.Fact, key: *vector.Vector[str], ws: *vector.Vector[str]) err[diag.Refusal] {
    if (key.len != 2) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    var names:      vector.Vector[str] = vector.init[str](r.alloc);
    val err_listed: err[diag.Refusal]  = run(r.alloc, f, key.data[1], ?names);
    if (sel err_listed.err) { ret err_listed; }
    val opt_cname: opt[str] = overlay.value(ws, "class");
    if (sel opt_cname.none) { ret err[diag.Refusal].err{overlay.refuse(f, MISSING, "class")}; }
    val opt_class: opt[u32] = class_named(r, opt_cname.some);
    if (sel opt_class.none) { ret err[diag.Refusal].err{overlay.refuse(f, UNKNOWN, opt_cname.some)}; }
    val res_number: res[u32, diag.Refusal] = named_number(f, ws, "number", 0, true);
    val res_bank:   res[u32, diag.Refusal] = named_number(f, ws, "bank", 0, true);
    if (sel res_number.err) { ret err[diag.Refusal].err{res_number.err}; }
    if (sel res_bank.err)   { ret err[diag.Refusal].err{res_bank.err}; }
    val zero:       quantity.Scaled                    = quantity.Scaled{fixed: 0, per: 0, scale: 0};
    val one:        quantity.Scaled                    = quantity.Scaled{fixed: 1, per: 0, scale: 0};
    val res_offset: res[quantity.Scaled, diag.Refusal] = named_scaled(f, ws, "offset", zero);
    val res_stride: res[quantity.Scaled, diag.Refusal] = named_scaled(f, ws, "stride", zero);
    val res_count:  res[quantity.Scaled, diag.Refusal] = named_scaled(f, ws, "count", one);
    if (sel res_offset.err) { ret err[diag.Refusal].err{res_offset.err}; }
    if (sel res_stride.err) { ret err[diag.Refusal].err{res_stride.err}; }
    if (sel res_count.err)  { ret err[diag.Refusal].err{res_count.err}; }
    var flags:     register.Flags = 0;
    val opt_named: opt[str]       = overlay.value(ws, "flags");
    if (sel opt_named.some) {
        val res_flags_of: res[register.Flags, diag.Refusal] = flags_of(f, opt_named.some);
        if (sel res_flags_of.err) { ret err[diag.Refusal].err{res_flags_of.err}; }
        flags = res_flags_of.ok;
    }
    val res_req: res[requirement.Requirement, diag.Refusal] = named_requires(r, f, ws, "requires");
    if (sel res_req.err) { ret err[diag.Refusal].err{res_req.err}; }
    var i: usize = 0;
    for (i < names.len) {
        val row: register.Register = register.Register{name: names.data[i], class: opt_class.some::u16, number: (res_number.ok + i::u32)::u16, bank: (res_bank.ok + i::u32)::u16, offset: res_offset.ok, stride: res_stride.ok, count: res_count.ok, places: register.ONE_PLACE, flags: flags, requires: res_req.ok, extend: register.KEEP, reach: register.Reach.bank{}};
        if (!pushed(vector.push[register.Register](?r.registers, row))) { ret err[diag.Refusal].err{memory(f)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

val ORDER_NAMES: [3]str            = [3]str{"significance", "address", "apart"};
val ORDERS:      [3]register.Order = [3]register.Order{register.SIGNIFICANCE, register.ADDRESS, register.APART};

# the row of the register numbered `n` in the first of `of`'s classes that holds one, none where none does
fun numbered_row(r: *Reading, of: *vector.Vector[u32], n: u32) opt[u32] {
    var c: usize = 0;
    for (c < of.len) {
        var i: usize = 0;
        for (i < r.registers.len) {
            val x: *register.Register = ?r.registers.data[i];
            if (x.class::u32 == of.data[c] && x.number::u32 == n) { ret opt[u32].some{i::u32}; }
            i = i + 1;
        }
        c = c + 1;
    }
    ret opt[u32].none{};
}

# a tuple class and its rows: tuple n of `arity` registers for each n from `first` to `last` by `step`, member k the
# register numbered n + k in the first of the classes `of` names holding one, and every member the first where the
# first reads zero, as risc-v amocas's pair of x0 (src/unpriv/zacas.adoc). each is named by its members joined by `:`
# under `named=members`, or by its class and first member, `vg2.v4`, under `named=first`, as classes of one alignment
# hold tuples of the same members, spelled by its first member, existing where its members do, and of the kind, width
# and count of its first member's class taken `arity` times in width. a tuple line follows every register line, so its
# rows are the file's last
fun tuple_line(r: *Reading, f: *overlay.Fact, key: *vector.Vector[str], ws: *vector.Vector[str]) err[diag.Refusal] {
    if (key.len != 2) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    val opt_names: opt[str] = overlay.value(ws, "of");
    if (sel opt_names.none) { ret err[diag.Refusal].err{overlay.refuse(f, MISSING, "of")}; }
    var of:  vector.Vector[u32] = vector.init[u32](r.alloc);
    var at:  usize              = 0;
    val len: usize              = str_len(opt_names.some);
    for (at < len) {
        var end: usize = at;
        for (end < len && opt_names.some[end] != ',') {
            end = end + 1;
        }
        val res_str_copy_slice: res[str, StrError] = str_copy_slice(r.alloc, opt_names.some, at, end - at);
        if (sel res_str_copy_slice.err) { ret err[diag.Refusal].err{memory(f)}; }
        val opt_class_named: opt[u32] = class_named(r, res_str_copy_slice.ok);
        if (sel opt_class_named.none)                             { ret err[diag.Refusal].err{overlay.refuse(f, UNKNOWN, res_str_copy_slice.ok)}; }
        if (!pushed(vector.push[u32](?of, opt_class_named.some))) { ret err[diag.Refusal].err{memory(f)}; }
        at = end + 1;
    }
    val res_arity: res[u32, diag.Refusal] = named_number(f, ws, "arity", 0, true);
    val res_step:  res[u32, diag.Refusal] = named_number(f, ws, "step", 0, true);
    val res_first: res[u32, diag.Refusal] = named_number(f, ws, "first", 0, true);
    val res_last:  res[u32, diag.Refusal] = named_number(f, ws, "last", 0, true);
    if (sel res_arity.err) { ret err[diag.Refusal].err{res_arity.err}; }
    if (sel res_step.err)  { ret err[diag.Refusal].err{res_step.err}; }
    if (sel res_first.err) { ret err[diag.Refusal].err{res_first.err}; }
    if (sel res_last.err)  { ret err[diag.Refusal].err{res_last.err}; }
    val opt_order: opt[str] = overlay.value(ws, "order");
    if (sel opt_order.none) { ret err[diag.Refusal].err{overlay.refuse(f, MISSING, "order")}; }
    var o: u32 = 0;
    for (o < 3 && !str_equals(ORDER_NAMES[o], opt_order.some)) {
        o = o + 1;
    }
    val opt_named: opt[str] = overlay.value(ws, "named");
    if (sel opt_named.none) { ret err[diag.Refusal].err{overlay.refuse(f, MISSING, "named")}; }
    val by_first: bool = str_equals(opt_named.some, "first");
    if (!by_first && !str_equals(opt_named.some, "members"))                                                                                         { ret err[diag.Refusal].err{overlay.refuse(f, BAD_TUPLE, key.data[1])}; }
    if (o == 3 || res_arity.ok < 2 || res_arity.ok > 255 || res_step.ok == 0 || res_step.ok > 255 || res_first.ok % res_step.ok != 0 || of.len == 0) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_TUPLE, key.data[1])}; }
    val base:  *register.Class = ?r.classes.data[of.data[0]];
    val width: quantity.Scaled = quantity.Scaled{fixed: base.width.fixed * res_arity.ok, per: base.width.per * res_arity.ok, scale: base.width.scale};
    val class: u16             = r.classes.len::u16;
    if (!pushed(vector.push[register.Class](?r.classes, register.Class{name: key.data[1], kind: base.kind, width: width, count: base.count, arity: res_arity.ok::u8, order: ORDERS[o], fixed: false, step: res_step.ok::u8}))) { ret err[diag.Refusal].err{memory(f)}; }
    var n: u32 = res_first.ok;
    for (n <= res_last.ok) {
        val res_held: res[*u32, A.Error] = A.allocate[u32](r.alloc, res_arity.ok::usize);
        if (sel res_held.err) { ret err[diag.Refusal].err{memory(f)}; }
        val opt_lead: opt[u32] = numbered_row(r, ?of, n);
        if (sel opt_lead.none) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_TUPLE, key.data[1])}; }
        val head: *register.Register = ?r.registers.data[opt_lead.some];
        val zero: register.Flags     = head.flags & register.ZERO;
        var name: str                = head.name;
        if (by_first) {
            val res_joined: res[str, StrError] = str_join(r.alloc, key.data[1], ".", head.name);
            if (sel res_joined.err) { ret err[diag.Refusal].err{memory(f)}; }
            name = res_joined.ok;
        }
        var k: u32 = 0;
        for (k < res_arity.ok) {
            var opt_lead: opt[u32] = opt_lead;
            if (zero == 0)                                                                                                                            { opt_lead = numbered_row(r, ?of, n + k); }
            if (sel opt_lead.none)                                                                                                                    { ret err[diag.Refusal].err{overlay.refuse(f, BAD_TUPLE, key.data[1])}; }
            if (r.registers.data[opt_lead.some].requires.at != head.requires.at || r.registers.data[opt_lead.some].requires.len != head.requires.len) { ret err[diag.Refusal].err{overlay.refuse(f, TUPLE_REQUIRES, key.data[1])}; }
            res_held.ok[k] = opt_lead.some;
            if (k > 0 && !by_first) {
                val res_joined: res[str, StrError] = str_join(r.alloc, name, ":", r.registers.data[opt_lead.some].name);
                if (sel res_joined.err) { ret err[diag.Refusal].err{memory(f)}; }
                name = res_joined.ok;
            }
            k = k + 1;
        }
        val none: quantity.Scaled   = quantity.Scaled{fixed: 0, per: 0, scale: 0};
        val row:  register.Register = register.Register{name: name, class: class, number: n::u16, bank: head.bank, offset: none, stride: none, count: none, places: register.ONE_PLACE, flags: register.UNSPELLED | zero, requires: head.requires, extend: register.UNSTATED, reach: register.Reach.bank{}, members: register.Rows{at: res_held.ok, len: res_arity.ok}};
        if (!pushed(vector.push[register.Register](?r.registers, row))) { ret err[diag.Refusal].err{memory(f)}; }
        n = n + res_step.ok;
    }
    ret err[diag.Refusal].ok{};
}

# the register a quantity is measured by and the bits of the quantity one count of its value stands for, while the
# requirement `when` names holds, under every state when it names none
fun measure_line(r: *Reading, f: *overlay.Fact, key: *vector.Vector[str], ws: *vector.Vector[str]) err[diag.Refusal] {
    if (key.len != 2) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    val opt_quantity_named: opt[u32] = quantity_named(r, key.data[1]);
    if (sel opt_quantity_named.none) { ret err[diag.Refusal].err{overlay.refuse(f, UNKNOWN, key.data[1])}; }
    val opt_value: opt[str] = overlay.value(ws, "register");
    if (sel opt_value.none) { ret err[diag.Refusal].err{overlay.refuse(f, MISSING, "register")}; }
    val opt_row: opt[u32] = register_named(r, opt_value.some);
    if (sel opt_row.none) { ret err[diag.Refusal].err{overlay.refuse(f, UNKNOWN, opt_value.some)}; }
    val res_count: res[u32, diag.Refusal] = named_number(f, ws, "count", 0, true);
    if (sel res_count.err) { ret err[diag.Refusal].err{res_count.err}; }
    var g:        quantity.Gauge = quantity.Gauge{row: opt_row.some, count: res_count.ok, when: requirement.NO_ALTERNATIVES};
    val opt_when: opt[str]       = overlay.value(ws, "when");
    if (sel opt_when.some) {
        val res_req: res[requirement.Requirement, diag.Refusal] = requires(r, f, opt_when.some);
        if (sel res_req.err) { ret err[diag.Refusal].err{res_req.err}; }
        g.when = res_req.ok;
    }
    if (!pushed(vector.push[quantity.Gauge](?r.gauges.data[opt_quantity_named.some], g))) { ret err[diag.Refusal].err{memory(f)}; }
    ret err[diag.Refusal].ok{};
}

fun alias_line(r: *Reading, f: *overlay.Fact, key: *vector.Vector[str]) err[diag.Refusal] {
    if (key.len != 2) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    var names:         vector.Vector[str] = vector.init[str](r.alloc);
    var of:            vector.Vector[str] = vector.init[str](r.alloc);
    val err_alloc_run: err[diag.Refusal]  = run(r.alloc, f, key.data[1], ?names);
    if (sel err_alloc_run.err) { ret err_alloc_run; }
    val err_alloc_run_fact: err[diag.Refusal] = run(r.alloc, f, f.fact, ?of);
    if (sel err_alloc_run_fact.err) { ret err_alloc_run_fact; }
    if (names.len != of.len)        { ret err[diag.Refusal].err{overlay.refuse(f, UNEVEN, f.key)}; }
    var i: usize = 0;
    for (i < names.len) {
        val opt_row: opt[u32] = register_named(r, of.data[i]);
        if (sel opt_row.none)                                                                                              { ret err[diag.Refusal].err{overlay.refuse(f, UNKNOWN, of.data[i])}; }
        if (!pushed(vector.push[register.Alias](?r.aliases, register.Alias{name: names.data[i], register: opt_row.some}))) { ret err[diag.Refusal].err{memory(f)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun column_line(r: *Reading, f: *overlay.Fact, key: *vector.Vector[str], ws: *vector.Vector[str]) err[diag.Refusal] {
    if (key.len != 2) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    val opt_format: opt[str] = overlay.value(ws, "format");
    if (sel opt_format.none) { ret err[diag.Refusal].err{overlay.refuse(f, MISSING, "format")}; }
    var fmt: register.Format = register.DWARF;
    if (str_equals(opt_format.some, "codeview"))                { fmt = register.CODEVIEW; }
    or (!str_equals(opt_format.some, "dwarf"))                  { ret err[diag.Refusal].err{overlay.refuse(f, overlay.UNKNOWN_WORD, opt_format.some)}; }
    if (!pushed(vector.push[str](?r.columns, key.data[1])))     { ret err[diag.Refusal].err{memory(f)}; }
    if (!pushed(vector.push[register.Format](?r.formats, fmt))) { ret err[diag.Refusal].err{memory(f)}; }
    ret err[diag.Refusal].ok{};
}

fun number_line(r: *Reading, f: *overlay.Fact, key: *vector.Vector[str]) err[diag.Refusal] {
    if (key.len != 3) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    val opt_column: opt[u32] = column_named(r, key.data[1]);
    if (sel opt_column.none) { ret err[diag.Refusal].err{overlay.refuse(f, UNKNOWN, key.data[1])}; }
    var names:      vector.Vector[str] = vector.init[str](r.alloc);
    val err_listed: err[diag.Refusal]  = run(r.alloc, f, key.data[2], ?names);
    if (sel err_listed.err) { ret err_listed; }
    val res_first: res[u32, diag.Refusal] = number_of(f, f.fact);
    if (sel res_first.err) { ret err[diag.Refusal].err{res_first.err}; }
    var i: usize = 0;
    for (i < names.len) {
        val opt_row: opt[u32] = register_named(r, names.data[i]);
        if (sel opt_row.none)                                                                                                                    { ret err[diag.Refusal].err{overlay.refuse(f, UNKNOWN, names.data[i])}; }
        if (!pushed(vector.push[Numbering](?r.numbering, Numbering{column: opt_column.some, row: opt_row.some, number: res_first.ok + i::u32}))) { ret err[diag.Refusal].err{memory(f)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun by_key(a: *index.Entry, b: *index.Entry) i64 {
    ret str_compare(a.key, b.key);
}

fun by_number(a: *index.Number, b: *index.Number) i64 {
    if (a.key < b.key) { ret -1; }
    if (a.key > b.key) { ret 1; }
    ret 0;
}

fun refused(message: str, subject: str) err[diag.Refusal] {
    ret err[diag.Refusal].err{diag.refusal(nil, 0, message, subject)};
}

# the file the reading lays out: bounds placed under their quantities, the names and debug numbers indexed
fun lay_out(r: *Reading, out: *register.File) err[diag.Refusal] {
    var q: usize = 0;
    for (q < r.quantities.len) {
        val b: *vector.Vector[quantity.Bound] = ?r.bounds.data[q];
        if (b.len > 0) { r.quantities.data[q].bounds = quantity.Bounds{at: b.data, len: b.len::u32}; }
        val g: *vector.Vector[quantity.Gauge] = ?r.gauges.data[q];
        if (g.len > 0) { r.quantities.data[q].gauges = quantity.Gauges{at: g.data, len: g.len::u32}; }
        q = q + 1;
    }
    var slots: u32   = 0;
    var i:     usize = 0;
    for (i < r.bindings.len) {
        if (r.bindings.data[i].slot::u32 + 1 > slots) { slots = r.bindings.data[i].slot::u32 + 1; }
        i = i + 1;
    }
    i = 1;
    for (i < r.registers.len) {
        if (register.id_of(?r.registers.data[i]) <= register.id_of(?r.registers.data[i - 1])) { ret refused(UNORDERED, r.registers.data[i].name); }
        i = i + 1;
    }
    val nc:          usize                      = r.classes.len;
    val res_classes: res[*index.Entry, A.Error] = A.allocate[index.Entry](r.alloc, nc);
    if (sel res_classes.err) { ret refused(diag.MEMORY, nil); }
    i = 0;
    for (i < nc) {
        res_classes.ok[i] = index.Entry{key: r.classes.data[i].name, row: i::u32};
        i                 = i + 1;
    }
    sort.sort_by[index.Entry](res_classes.ok, nc, by_key);
    # a row no syntax spells, as a tuple spelled by its members, is not in the name index
    val rows:      usize = r.registers.len;
    var unspelled: usize = 0;
    i = 0;
    for (i < rows) {
        if ((r.registers.data[i].flags & register.UNSPELLED) != 0) { unspelled = unspelled + 1; }
        i = i + 1;
    }
    val total:     usize                      = rows - unspelled + r.aliases.len;
    val res_names: res[*index.Entry, A.Error] = A.allocate[index.Entry](r.alloc, total);
    if (sel res_names.err) { ret refused(diag.MEMORY, nil); }
    var put: usize = 0;
    i = 0;
    for (i < rows) {
        if ((r.registers.data[i].flags & register.UNSPELLED) == 0) {
            res_names.ok[put] = index.Entry{key: r.registers.data[i].name, row: i::u32};
            put               = put + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < r.aliases.len) {
        res_names.ok[put + i] = index.Entry{key: r.aliases.data[i].name, row: (rows + i)::u32};
        i                     = i + 1;
    }
    sort.sort_by[index.Entry](res_names.ok, total, by_key);
    i = 1;
    for (i < total) {
        if (str_equals(res_names.ok[i].key, res_names.ok[i - 1].key)) { ret refused(NAMED_TWICE, res_names.ok[i].key); }
        i = i + 1;
    }
    val nk:          usize                          = r.columns.len;
    val res_columns: res[*register.Column, A.Error] = A.allocate[register.Column](r.alloc, nk);
    if (sel res_columns.err) { ret refused(diag.MEMORY, nil); }
    var k: usize = 0;
    for (k < nk) {
        val res_numbers: res[*u32, A.Error] = A.allocate[u32](r.alloc, rows);
        if (sel res_numbers.err) { ret refused(diag.MEMORY, nil); }
        i = 0;
        for (i < rows) {
            res_numbers.ok[i] = register.UNNUMBERED;
            i                 = i + 1;
        }
        var numbered: vector.Vector[index.Number] = vector.init[index.Number](r.alloc);
        i = 0;
        for (i < r.numbering.len) {
            val n: *Numbering = ?r.numbering.data[i];
            if (n.column::usize == k) {
                if (res_numbers.ok[n.row] != register.UNNUMBERED) { ret refused(NUMBERED_TWICE, r.registers.data[n.row].name); }
                res_numbers.ok[n.row] = n.number;
                if (!pushed(vector.push[index.Number](?numbered, index.Number{key: n.number::u64, row: n.row}))) { ret refused(diag.MEMORY, nil); }
            }
            i = i + 1;
        }
        sort.sort_by[index.Number](numbered.data, numbered.len, by_number);
        res_columns.ok[k] = register.Column{format: r.formats.data[k], flavour: requirement.NO_ALTERNATIVES, numbers: res_numbers.ok, len: rows::u32, numbered: index.Numbers{at: numbered.data, len: numbered.len::u32}};
        k                 = k + 1;
    }
    @out = register.File{
        quantities:     quantity.Quantities{at: r.quantities.data, len: r.quantities.len::u32},
        bindings:       quantity.Bindings{at: r.bindings.data, len: r.bindings.len::u32},
        slot_count:     slots,
        classes:        r.classes.data,
        class_count:    nc::u32,
        class_names:    index.Index{at: res_classes.ok, len: nc::u32},
        registers:      r.registers.data,
        register_count: rows::u32,
        aliases:        r.aliases.data,
        alias_count:    r.aliases.len::u32,
        names:          index.Index{at: res_names.ok, len: total::u32},
        columns:        res_columns.ok,
        column_count:   nk::u32,
    };
    ret storage.index_rows(r.alloc, out);
}

# the registers topic `t` read and laid out into `out`, its requirements over `catalog` and `axes`
pub fun read(a: *A.Allocator, t: *overlay.Topic, catalog: *extension.Catalog, axes: *state.Axes, out: *Registers) err[diag.Refusal] {
    var r: Reading = Reading{
        alloc:      a,
        catalog:    catalog,
        axes:       axes,
        quantities: vector.init[quantity.Quantity](a),
        bounds:     vector.init[vector.Vector[quantity.Bound]](a),
        gauges:     vector.init[vector.Vector[quantity.Gauge]](a),
        bindings:   vector.init[quantity.Binding](a),
        classes:    vector.init[register.Class](a),
        registers:  vector.init[register.Register](a),
        aliases:    vector.init[register.Alias](a),
        formats:    vector.init[register.Format](a),
        columns:    vector.init[str](a),
        numbering:  vector.init[Numbering](a),
    };
    val err_checked: err[diag.Refusal] = overlay.check(t, nil, overlay.unstated);
    if (sel err_checked.err) { ret err_checked; }
    var i: usize = 0;
    for (i < t.facts.len) {
        val f:         *overlay.Fact                         = ?t.facts.data[i];
        val res_key:   res[vector.Vector[str], diag.Refusal] = overlay.words(a, f, f.key);
        val res_words: res[vector.Vector[str], diag.Refusal] = overlay.words(a, f, f.fact);
        if (sel res_key.err)     { ret err[diag.Refusal].err{res_key.err}; }
        if (sel res_words.err)   { ret err[diag.Refusal].err{res_words.err}; }
        if (res_key.ok.len == 0) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
        val kind:     str               = res_key.ok.data[0];
        var err_done: err[diag.Refusal] = err[diag.Refusal].ok{};
        if (str_equals(kind, "quantity")) { err_done = quantity_line(?r, f, ?res_key.ok, ?res_words.ok); }
        or (str_equals(kind, "bound"))    { err_done = bound_line(?r, f, ?res_key.ok, ?res_words.ok); }
        or (str_equals(kind, "binding"))  { err_done = binding_line(?r, f, ?res_key.ok, ?res_words.ok); }
        or (str_equals(kind, "class"))    { err_done = class_line(?r, f, ?res_key.ok, ?res_words.ok); }
        or (str_equals(kind, "register")) { err_done = register_line(?r, f, ?res_key.ok, ?res_words.ok); }
        or (str_equals(kind, "tuple"))    { err_done = tuple_line(?r, f, ?res_key.ok, ?res_words.ok); }
        or (str_equals(kind, "measure"))  { err_done = measure_line(?r, f, ?res_key.ok, ?res_words.ok); }
        or (str_equals(kind, "alias"))    { err_done = alias_line(?r, f, ?res_key.ok); }
        or (str_equals(kind, "column"))   { err_done = column_line(?r, f, ?res_key.ok, ?res_words.ok); }
        or (str_equals(kind, "number"))   { err_done = number_line(?r, f, ?res_key.ok); }
        or                                { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
        if (sel err_done.err)             { ret err_done; }
        i = i + 1;
    }
    out.catalog = catalog;
    out.axes    = axes;
    ret lay_out(?r, ?out.file);
}

# the name the tables give atom `id`: an extension's name, or a state value's axis and value joined by `_`, as
# `xlen_64`, which the emitters write as the identifier of the catalog's constant for it
pub fun atom_name(a: *A.Allocator, catalog: *extension.Catalog, axes: *state.Axes, id: requirement.Id) str {
    if (id < catalog.count) { ret catalog.extensions[id].name; }
    val opt_place: opt[state.Placed] = state.place(catalog, axes, id);
    if (sel opt_place.none) { ret "?"; }
    val axis:       *state.Axis        = ?axes.at[opt_place.some.axis];
    val res_joined: res[str, StrError] = str_join(a, axis.name, "_", axis.values.at[opt_place.some.value].name);
    if (sel res_joined.err) { ret "?"; }
    ret res_joined.ok;
}

# what the tables write a register file with: its pools of ids and alternatives
rec Writer {
    f:    *emit.File;
    regs: *Registers;
    ids:  emit.Pool;
    alts: emit.Pool;
}

fun number(n: i64) emit.Value {
    ret emit.Value.number{n};
}

fun name(s: str) emit.Value {
    ret emit.Value.name{s};
}

fun span(f: *emit.File, of: str, array: str, at: u32, count: u32) emit.Value {
    val r: *emit.Record = emit.record(f, of);
    emit.member(f, r, "at", emit.element(f, array, at));
    emit.member(f, r, "len", number(count::i64));
    ret emit.Value.record{r};
}

fun ids_value(w: *Writer, ids: requirement.Ids) emit.Value {
    if (ids.len == 0) { ret name("requirement.NO_IDS"); }
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](w.f.alloc);
    var i:     u32                       = 0;
    for (i < ids.len) {
        val n: str = atom_name(w.f.alloc, w.regs.catalog, w.regs.axes, ids.at[i]);
        vector.push[emit.Value](?items, name(emit.concat(w.f, "gen_extension.", emit.ident(w.f, n))));
        i = i + 1;
    }
    ret span(w.f, "requirement.Ids", "IDS", emit.pooled(w.f, ?w.ids, items.data, ids.len), ids.len);
}

fun requirement_value(w: *Writer, req: requirement.Requirement) emit.Value {
    if (req.len == 0) { ret name("requirement.NO_ALTERNATIVES"); }
    emit.uses(w.f, "riscv_extension: masc.isa.riscv.extension");
    emit.uses(w.f, "masc.isa.riscv.gen_extension");
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](w.f.alloc);
    var i:     u32                       = 0;
    for (i < req.len) {
        val r: *emit.Record = emit.record(w.f, "requirement.Alternative");
        emit.member(w.f, r, "all", ids_value(w, req.at[i].all));
        emit.member(w.f, r, "none", ids_value(w, req.at[i].none));
        vector.push[emit.Value](?items, emit.Value.record{r});
        i = i + 1;
    }
    ret span(w.f, "requirement.Requirement", "ALTERNATIVES", emit.pooled(w.f, ?w.alts, items.data, req.len), req.len);
}

fun scaled_value(f: *emit.File, s: quantity.Scaled) emit.Value {
    val r: *emit.Record = emit.record(f, "quantity.Scaled");
    emit.member(f, r, "fixed", number(s.fixed::i64));
    emit.member(f, r, "per", number(s.per::i64));
    emit.member(f, r, "scale", number(s.scale::i64));
    ret emit.Value.record{r};
}

val ORDER_PATHS: [3]str = [3]str{"register.SIGNIFICANCE", "register.ADDRESS", "register.APART"};

val KIND_PATHS: [7]str = [7]str{"register.GENERAL", "register.FLOAT", "register.VECTOR", "register.PREDICATE", "register.FLAGS", "register.TILE", "register.SYSTEM"};

val FLAG_BITS:  [7]register.Flags = [7]register.Flags{register.STACK, register.ZERO, register.PC, register.ACCRUED, register.LENGTH, register.UNSPELLED, register.LINK};
val FLAG_PATHS: [7]str            = [7]str{"register.STACK", "register.ZERO", "register.PC", "register.ACCRUED", "register.LENGTH", "register.UNSPELLED", "register.LINK"};

fun flags_value(f: *emit.File, flags: register.Flags) emit.Value {
    var text: str = nil;
    var i:    u32 = 0;
    for (i < 7) {
        if ((flags & FLAG_BITS[i]) != 0) {
            if (text == nil) { text = FLAG_PATHS[i]; }
            or               { text = emit.concat(f, emit.concat(f, text, " | "), FLAG_PATHS[i]); }
        }
        i = i + 1;
    }
    if (text == nil) { ret number(0); }
    ret name(text);
}

fun declare(f: *emit.File, taken: *map.Map[str, str], id: str, of: str, v: emit.Value) err[diag.Refusal] {
    ret handles.declare_handle(f, taken, id, id, of, v);
}

# the register file written as gen_register: its handles, its class, quantity and csr names, and the file itself
pub fun generate(c: *set.Context, regs: *Registers) err[diag.Refusal] {
    val res_opened: res[*emit.File, diag.Refusal] = set.table(c, "register");
    if (sel res_opened.err) { ret err[diag.Refusal].err{res_opened.err}; }
    val f:    *emit.File     = res_opened.ok;
    val file: *register.File = ?regs.file;
    var w:    Writer         = Writer{f: f, regs: regs, ids: emit.pool(f, "requirement.Id"), alts: emit.pool(f, "requirement.Alternative")};
    emit.uses(f, "masc.core.index");
    emit.uses(f, "masc.core.quantity");
    emit.uses(f, "masc.core.requirement");
    var taken:       map.Map[str, str] = map.init[str, str](c.alloc);
    val err_handled: err[diag.Refusal] = handles.generate(c.alloc, f, file, ?taken);
    if (sel err_handled.err) { ret err_handled; }
    val bounds: *emit.Array = emit.array(f, "quantity.Bound");
    val gauges: *emit.Array = emit.array(f, "quantity.Gauge");
    val qs:     *emit.Array = emit.array(f, "quantity.Quantity");
    var i:      u32         = 0;
    for (i < file.quantities.len) {
        val q:   *quantity.Quantity = ?file.quantities.at[i];
        val r:   *emit.Record       = emit.record(f, "quantity.Quantity");
        val dom: *emit.Record       = emit.record(f, "quantity.Range");
        emit.member(f, r, "name", emit.Value.text{q.name});
        emit.member(f, r, "unit", number(q.unit::i64));
        if (sel q.domain.powers) {
            emit.member(f, dom, "least", number(q.domain.powers.least::i64));
            emit.member(f, dom, "most", number(q.domain.powers.most::i64));
        }
        emit.member(f, r, "domain", emit.Value.variant{emit.variant(f, "quantity.Domain.powers", emit.Value.record{dom})});
        if (q.bounds.len == 0) { emit.member(f, r, "bounds", name("quantity.NO_BOUNDS")); }
        or {
            val first: u32 = emit.length(bounds);
            var k:     u32 = 0;
            for (k < q.bounds.len) {
                val b: *emit.Record = emit.record(f, "quantity.Bound");
                emit.member(f, b, "when", requirement_value(?w, q.bounds.at[k].when));
                emit.member(f, b, "least", number(q.bounds.at[k].least::i64));
                emit.member(f, b, "most", number(q.bounds.at[k].most::i64));
                emit.item(f, bounds, emit.Value.record{b});
                k = k + 1;
            }
            emit.member(f, r, "bounds", span(f, "quantity.Bounds", "BOUNDS", first, q.bounds.len));
        }
        if (q.gauges.len == 0) { emit.member(f, r, "gauges", name("quantity.NO_GAUGES")); }
        or {
            val first: u32 = emit.length(gauges);
            var k:     u32 = 0;
            for (k < q.gauges.len) {
                val g: *emit.Record = emit.record(f, "quantity.Gauge");
                emit.member(f, g, "row", number(q.gauges.at[k].row::i64));
                emit.member(f, g, "count", number(q.gauges.at[k].count::i64));
                emit.member(f, g, "when", requirement_value(?w, q.gauges.at[k].when));
                emit.item(f, gauges, emit.Value.record{g});
                k = k + 1;
            }
            emit.member(f, r, "gauges", span(f, "quantity.Gauges", "GAUGES", first, q.gauges.len));
        }
        emit.item(f, qs, emit.Value.record{r});
        val err_named: err[diag.Refusal] = declare(f, ?taken, emit.ident(f, q.name), "u8", number(i::i64));
        if (sel err_named.err) { ret err_named; }
        i = i + 1;
    }
    emit.declare_array(f, "BOUNDS", bounds);
    emit.declare_array(f, "GAUGES", gauges);
    emit.declare_array(f, "QUANTITIES", qs);
    val binds: *emit.Array = emit.array(f, "quantity.Binding");
    i = 0;
    for (i < file.bindings.len) {
        val b: *quantity.Binding = ?file.bindings.at[i];
        val r: *emit.Record      = emit.record(f, "quantity.Binding");
        emit.member(f, r, "slot", number(b.slot::i64));
        emit.member(f, r, "when", requirement_value(?w, b.when));
        emit.member(f, r, "quantity", number(b.quantity::i64));
        emit.item(f, binds, emit.Value.record{r});
        i = i + 1;
    }
    emit.declare_array(f, "BINDINGS", binds);
    val classes: *emit.Array = emit.array(f, "register.Class");
    val general: *emit.Array = emit.array(f, "u16");
    i = 0;
    for (i < file.class_count) {
        val cl: *register.Class = ?file.classes[i];
        val r:  *emit.Record    = emit.record(f, "register.Class");
        emit.member(f, r, "name", emit.Value.text{cl.name});
        emit.member(f, r, "kind", name(KIND_PATHS[cl.kind]));
        emit.member(f, r, "width", scaled_value(f, cl.width));
        emit.member(f, r, "count", scaled_value(f, cl.count));
        if (cl.arity != 0) {
            emit.member(f, r, "arity", number(cl.arity::i64));
            emit.member(f, r, "order", name(ORDER_PATHS[cl.order - 1]));
            emit.member(f, r, "step", number(cl.step::i64));
        }
        emit.item(f, classes, emit.Value.record{r});
        val err_pointed: err[diag.Refusal] = declare(f, ?taken, emit.ident(f, cl.name), "*register.Class", emit.element(f, "CLASSES", i));
        if (sel err_pointed.err)                          { ret err_pointed; }
        if (cl.kind == register.GENERAL && cl.arity == 0) { emit.item(f, general, name(emit.concat(f, emit.ident(f, cl.name), "_CLASS"))); }
        i = i + 1;
    }
    emit.declare_array(f, "CLASSES", classes);
    emit.declare_array(f, "GENERAL", general);
    val class_names: *emit.Array = emit.array(f, "index.Entry");
    i = 0;
    for (i < file.class_names.len) {
        val r: *emit.Record = emit.record(f, "index.Entry");
        emit.member(f, r, "key", emit.Value.text{file.class_names.at[i].key});
        emit.member(f, r, "row", number(file.class_names.at[i].row::i64));
        emit.item(f, class_names, emit.Value.record{r});
        i = i + 1;
    }
    emit.declare_array(f, "CLASS_NAMES", class_names);
    val rows:    *emit.Array = emit.array(f, "register.Register");
    var members: emit.Pool   = emit.pool(f, "u32");
    i = 0;
    for (i < file.register_count) {
        val x: *register.Register = ?file.registers[i];
        val r: *emit.Record       = emit.record(f, "register.Register");
        emit.member(f, r, "name", emit.Value.text{x.name});
        emit.member(f, r, "class", number(x.class::i64));
        if (file.classes[x.class].kind == register.SYSTEM) {
            val n: str = emit.concat(f, emit.ident(f, x.name), "_NUMBER");
            emit.member(f, r, "number", name(n));
            val err_numbered: err[diag.Refusal] = declare(f, ?taken, n, "u16", emit.Value.hex{x.number::u64});
            if (sel err_numbered.err) { ret err_numbered; }
        }
        or { emit.member(f, r, "number", number(x.number::i64)); }
        emit.member(f, r, "bank", number(x.bank::i64));
        emit.member(f, r, "offset", scaled_value(f, x.offset));
        emit.member(f, r, "stride", scaled_value(f, x.stride));
        emit.member(f, r, "count", scaled_value(f, x.count));
        emit.member(f, r, "places", name("register.ONE_PLACE"));
        emit.member(f, r, "flags", flags_value(f, x.flags));
        emit.member(f, r, "requires", requirement_value(?w, x.requires));
        if (register.tuple(x)) {
            emit.member(f, r, "extend", name("register.UNSTATED"));
            emit.member(f, r, "reach", emit.Value.variant{emit.bare(f, "register.Reach.bank")});
            var held: [16]emit.Value;
            var k:    u32 = 0;
            for (k < x.members.len && k < 16) {
                held[k] = number(x.members.at[k]::i64);
                k       = k + 1;
            }
            emit.member(f, r, "members", span(f, "register.Rows", "MEMBERS", emit.pooled(f, ?members, ?held[0], k), k));
        }
        or {
            emit.member(f, r, "extend", name("register.KEEP"));
            emit.member(f, r, "reach", emit.Value.variant{emit.bare(f, "register.Reach.bank")});
        }
        emit.item(f, rows, emit.Value.record{r});
        i = i + 1;
    }
    emit.declare_array(f, "REGISTERS", rows);
    if (emit.length(members.array) > 0) { emit.declare_array(f, "MEMBERS", members.array); }
    val aliases: *emit.Array = emit.array(f, "register.Alias");
    i = 0;
    for (i < file.alias_count) {
        val r: *emit.Record = emit.record(f, "register.Alias");
        emit.member(f, r, "name", emit.Value.text{file.aliases[i].name});
        emit.member(f, r, "register", number(file.aliases[i].register::i64));
        emit.item(f, aliases, emit.Value.record{r});
        i = i + 1;
    }
    emit.declare_array(f, "ALIASES", aliases);
    val names: *emit.Array = emit.array(f, "index.Entry");
    i = 0;
    for (i < file.names.len) {
        val r: *emit.Record = emit.record(f, "index.Entry");
        emit.member(f, r, "key", emit.Value.text{file.names.at[i].key});
        emit.member(f, r, "row", number(file.names.at[i].row::i64));
        emit.item(f, names, emit.Value.record{r});
        i = i + 1;
    }
    emit.declare_array(f, "NAMES", names);
    val columns: *emit.Array = emit.array(f, "register.Column");
    var k:       u32         = 0;
    for (k < file.column_count) {
        val col:    *register.Column = ?file.columns[k];
        var prefix: str              = "DWARF";
        if (col.format == register.CODEVIEW) { prefix = "CODEVIEW"; }
        val numbers:  *emit.Array = emit.array(f, "u32");
        val numbered: *emit.Array = emit.array(f, "index.Number");
        i = 0;
        for (i < col.len) {
            emit.item(f, numbers, emit.Value.hex{col.numbers[i]::u64});
            i = i + 1;
        }
        i = 0;
        for (i < col.numbered.len) {
            val r: *emit.Record = emit.record(f, "index.Number");
            emit.member(f, r, "key", emit.Value.hex{col.numbered.at[i].key});
            emit.member(f, r, "row", number(col.numbered.at[i].row::i64));
            emit.item(f, numbered, emit.Value.record{r});
            i = i + 1;
        }
        val numbers_name:  str          = emit.concat(f, prefix, "_NUMBERS");
        val numbered_name: str          = emit.concat(f, prefix, "_NUMBERED");
        val r:             *emit.Record = emit.record(f, "register.Column");
        emit.member(f, r, "format", name(emit.concat(f, "register.", prefix)));
        emit.member(f, r, "flavour", requirement_value(?w, col.flavour));
        emit.member(f, r, "numbers", emit.declare_array(f, numbers_name, numbers));
        emit.member(f, r, "len", number(col.len::i64));
        emit.member(f, r, "numbered", span(f, "index.Numbers", numbered_name, 0, col.numbered.len));
        emit.declare_array(f, numbered_name, numbered);
        emit.item(f, columns, emit.Value.record{r});
        k = k + 1;
    }
    emit.declare_array(f, "COLUMNS", columns);
    val words: u32         = (file.register_count + 63) / 64;
    val every: *emit.Array = emit.array(f, "u64");
    var word:  u32         = 0;
    for (word < words) {
        var bits: u64 = 0xFFFF_FFFF_FFFF_FFFF;
        val left: u32 = file.register_count - word * 64;
        if (left < 64) { bits = (1::u64 << left::u64) - 1; }
        emit.item(f, every, emit.Value.hex{bits});
        word = word + 1;
    }
    val err_every_named: err[diag.Refusal] = declare(f, ?taken, "EVERY", nil, emit.Value.array{every});
    if (sel err_every_named.err) { ret err_every_named; }
    val r: *emit.Record = emit.record(f, "register.File");
    emit.member(f, r, "quantities", span(f, "quantity.Quantities", "QUANTITIES", 0, file.quantities.len));
    emit.member(f, r, "bindings", span(f, "quantity.Bindings", "BINDINGS", 0, file.bindings.len));
    emit.member(f, r, "slot_count", number(file.slot_count::i64));
    emit.member(f, r, "classes", emit.element(f, "CLASSES", 0));
    emit.member(f, r, "class_count", number(file.class_count::i64));
    emit.member(f, r, "class_names", span(f, "index.Index", "CLASS_NAMES", 0, file.class_names.len));
    emit.member(f, r, "registers", emit.element(f, "REGISTERS", 0));
    emit.member(f, r, "register_count", number(file.register_count::i64));
    emit.member(f, r, "aliases", emit.element(f, "ALIASES", 0));
    emit.member(f, r, "alias_count", number(file.alias_count::i64));
    emit.member(f, r, "names", span(f, "index.Index", "NAMES", 0, file.names.len));
    emit.member(f, r, "columns", emit.element(f, "COLUMNS", 0));
    emit.member(f, r, "column_count", number(file.column_count::i64));
    val err_stored: err[diag.Refusal] = storage.generate(f, file, ?taken, r);
    if (sel err_stored.err) { ret err_stored; }
    val err_filed: err[diag.Refusal] = declare(f, ?taken, "FILE", "register.File", emit.Value.record{r});
    if (sel err_filed.err) { ret err_filed; }
    emit.declare_array(f, "IDS", w.ids.array);
    emit.declare_array(f, "ALTERNATIVES", w.alts.array);
    ret err[diag.Refusal].ok{};
}
