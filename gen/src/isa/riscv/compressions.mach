# the compressions of the vendor tools, read from the compressions topic
#
# each line of gen/data/riscv/compressions.txt is a compression, `compress
# <base> <packed> | from=<operands> when=<conditions>`, the instruction
# shortened, the compressed instruction, where each operand of the compressed
# instruction takes its value from and what the base's values must hold, in
# the order the vendor tools prefer. the compress generator resolves each
# against the rows and writes gen_compress.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use gen.diag;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "compressions";

# one compression
# ---
# base:   the instruction shortened
# packed: the compressed instruction
# from:   where each operand of the compressed instruction takes its value from
# when:   what the instruction's values must hold
pub rec Entry {
    base:   str;
    packed: str;
    from:   str;
    when:   str;
}

# the compressions, in the order their bases' forms are tried
pub rec Compressions {
    entries: vector.Vector[Entry];
}

val NAMES: [2]str = [2]str{"from", "when"};

# the compressions topic `t` read into `out`
pub fun read(a: *A.Allocator, t: *topic.Topic, out: *Compressions) err[diag.Refusal] {
    out.entries = vector.init[Entry](a);
    val checked: err[diag.Refusal] = topic.check(t, nil, topic.unstated);
    if (sel checked.err) { ret checked; }
    var i: usize = 0;
    for (i < t.facts.len) {
        var l:     topic.Line;
        val lined: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel lined.err)                { ret lined; }
        if (!topic.is(?l, "compress", 3)) { ret topic.reject(?l, topic.BAD_FACT, l.fact.key); }
        val words: err[diag.Refusal] = topic.known(?l, ?NAMES[0], 2);
        if (sel words.err) { ret words; }
        var e:    Entry             = Entry{base: l.key.data[1], packed: l.key.data[2], from: nil, when: nil};
        val from: err[diag.Refusal] = topic.needed(?l, "from", ?e.from);
        val when: err[diag.Refusal] = topic.needed(?l, "when", ?e.when);
        if (sel from.err) { ret from; }
        if (sel when.err) { ret when; }
        val pushed: res[usize, A.Error] = vector.push[Entry](?out.entries, e);
        if (sel pushed.err) { ret topic.reject(?l, diag.MEMORY, nil); }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

#[testing]
fun t_read(a: *A.Allocator, text: str, out: *Compressions) err[diag.Refusal] {
    var f: source.File                    = source.File{path: "compressions.txt", data: text, len: str_len(text)};
    val t: res[topic.Topic, diag.Refusal] = topic.facts(a, ?f);
    if (sel t.err) { ret err[diag.Refusal].err{t.err}; }
    ret read(a, ?t.ok, out);
}

test read__a_compression_is_its_base_its_form_and_its_operands_and_an_unknown_word_is_refused {
    var tt: testing.Testing;
    testing.make(?tt);
    var c:   Compressions;
    val got: err[diag.Refusal] = t_read(testing.allocator_of(?tt), "compress addi c.nop | from=\"\" when=\"rd=x0 rs1=x0 imm12=#0\" | c | -\n", ?c);
    if (sel got.err)                                                { ret 1; }
    if (c.entries.len != 1 || str_len(c.entries.data[0].from) != 0) { ret 2; }
    if (str_len(c.entries.data[0].when) != 21)                      { ret 3; }
    val odd: err[diag.Refusal] = t_read(testing.allocator_of(?tt), "compress addi c.li | from=rd unless=rs1 | c | -\n", ?c);
    if (!(sel odd.err && odd.err.message == topic.UNKNOWN_WORD)) { ret 4; }
    ret 0;
}
