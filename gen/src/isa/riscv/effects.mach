# the effects of the riscv rows, read from the effects topic
#
# riscv-opcodes states no effect. a row's registers by role come from its
# arguments, and what they do not state is in gen/data/riscv/effects.txt: the
# roles that differ from an argument's default, the stack pointer the
# compressed stack forms name but hold in their fixed bits, the registers no
# operand names, memory accesses and their width, control transfer, stack
# change, value relations, latency, memory order, the default fixup kind of each relocatable operand, the
# marked rows, the rows split by width, the relaxations and the code fill.
# every kind is matched by mnemonic, a trailing `*` matching a prefix, and the
# first line that matches is taken. register names are the register file's own.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;

use masc.core.effect;
use masc.core.operand;

use gen.control;
use gen.diag;
use gen_order: gen.order;
use topic:     gen.overlay;
use gen.relation;

pub val TOPIC: str = "effects";

pub val BAD_ROLE:      str = "effects line states a role that is none of read, write and read-write";
pub val BAD_TRANSFER:  str = "effects line states a transfer, target or latency its kind does not read";
pub val BAD_TERM:      str = "effects line states a term that is no `<arg> in <registers>`, `<arg> = <n>` or `<arg> is <value>`";
pub val UNSTATED:      str = "effects topic lacks its undisturbed, stack pointer, far or fill line";
pub val UNCONDITIONED: str = "under line states neither a state nor a term";

# the role of the operand an argument names, every other argument being read
pub rec Role {
    arg:  str;
    role: operand.Role;
}

# a row's role for one argument in place of the default
pub rec Recast {
    mnemonic: str;
    arg:      str;
    role:     operand.Role;
}

# the role an argument has in place of its row's under a vector configuration state and an argument's value, a role
# rule (`effect.RoleRule`)
# ---
# mnemonic: the rows it states, a pattern with an optional `*`
# arg:      the argument whose role it narrows
# role:     its role then, within the row's
# state:    the bits of the vector configuration state, vtype's encoding, that must all be set, 0 for none
# term:     the test an argument must meet, its arg empty for none
#
# every line with a term that matches a row having its argument and its term's argument is taken, each a rule of its
# own, so the lines of one argument test values no instruction holds together. a row that takes none takes the first
# line with no term that matches it and has its argument, the rule for a row without the tested argument. a row whose
# role for the argument a recast line states takes none, its role the recast's whatever the state
pub rec Under {
    mnemonic: str;
    arg:      str;
    role:     operand.Role;
    state:    u64;
    term:     Term;
}

# the stack pointer a compressed stack form spells but holds in its fixed bits, as an operand fixed to x2
# ---
# at:   where it stands among the row's operands, LAST for after every other
# role: how the row uses it
pub rec Implicit {
    mnemonic: str;
    at:       u8;
    role:     operand.Role;
}

# the place of an implicit operand after every other
pub val LAST: u8 = 0xFF;

# registers a row reads and writes that no operand names, by the register file's names split by spaces
pub rec Uses {
    mnemonic: str;
    read:     str;
    written:  str;
}

# the registers a list operand's value names, by the register file's names split by spaces
pub rec Saved {
    value:     u32;
    registers: str;
}

# a row whose list operand reads or writes the registers its value names
# ---
# mnemonic: the row
# arg:      its list argument, an enumerant each of whose members a saved line states
# role:     whether it reads the registers, as cm.push saves them, or writes them, as the pops restore them
pub rec Listed {
    mnemonic: str;
    arg:      str;
    role:     operand.Role;
}

# the control and status state a row reads and writes that no operand names, by the register file's names split by spaces
# ---
# mnemonic: the rows it states, a pattern with an optional `*`
# arg:      an argument the row must have, empty when none is needed
# read:     the state it reads
# written:  the state it writes
#
# a table is a domain of state, and its first row that matches a mnemonic and has its argument is the one taken, so a
# row for an exception comes before the row for the rule it excepts. every domain applies, so a row can take a state
# from each. state that accrues (fflags, vxsat) is both read and written, since an instruction adds to what is there
# and a write that left it undefined would let a pass drop the sets before it
pub rec State {
    mnemonic: str;
    arg:      str;
    read:     str;
    written:  str;
}

# how an access's element width is stated
# ---
# FIXED:  `bits` bits
# SUFFIX: the width the mnemonic's last part names: b 8, h 16, w 32, d 64, q 128
# XLEN:   one register of the integer file, as zcmp saves, its count no operand states
# BLOCK:  a cache block, whose size the platform states and no operand gives
pub def Element: u8;

pub val FIXED:  Element = 0;
pub val SUFFIX: Element = 1;
pub val XLEN:   Element = 2;
pub val BLOCK:  Element = 3;

# a scalar memory access: its role and its width. its address is the row's
# address register (rs1, rs1_p, or the stack pointer), offset by the row's
# immediate when it has one, and for zcmp the stack pointer, which no operand names
pub rec Memory {
    mnemonic: str;
    role:     operand.Role;
    element:  Element;
    bits:     u32;
}

# a control transfer: what it does, where to, whether it may fall through, the argument holding its target, and the
# test a conditional one is taken by, comparing the registers of `left` and `right`, or of `left` and zero where
# `right` is empty
pub rec Control {
    mnemonic:    str;
    transfer:    effect.Transfer;
    target:      effect.Target;
    conditional: bool;
    arg:         str;
    test:        effect.Comparison;
    left:        str;
    right:       str;
}

# a test of an argument's value
# ---
# registers: its register is one of these, by the register file's names split by spaces
# enumerant: its enumerant is exactly this value
# value:     its enumerant is the value the fields topic names this
pub tag Test: u8 {
    registers: str;
    enumerant: u32;
    value:     str;
}

# a test of one argument
# ---
# arg:  the argument, empty when the term is not used
# test: what its value must meet
pub rec Term {
    arg:  str;
    test: Test;
}

# a control transfer a row has instead of its own when its registers meet both terms
pub rec Rule {
    mnemonic:    str;
    transfer:    effect.Transfer;
    target:      effect.Target;
    conditional: bool;
    first:       Term;
    second:      Term;
}

# registers a row reads and writes as well as its own when an argument meets the term
# ---
# mnemonic: the rows it states, a pattern with an optional `*`
# term:     the test the row's argument must meet, a row without the argument taking none of it
# read:     the further registers it reads then, by the register file's names split by spaces
# written:  the further registers it writes then
#
# at most one row may match a mnemonic and have its argument, and a row two match is refused naming both, so each fact
# has one owner. a row holds that one rule, whose sets are the row's own with these added and which stands in for them
# whenever the term holds
pub rec RegisterRule {
    mnemonic: str;
    term:     Term;
    read:     str;
    written:  str;
}

# a change to the stack pointer by the value of an argument's operand, as zcmp's adjustment
pub rec Stack {
    mnemonic: str;
    arg:      str;
}

# a relation of the value a row writes to the values it reads, by the row's arguments
pub rec Offset {
    mnemonic: str;
    stated:   relation.Stated;
}

# an order fact of the rows a mnemonic pattern names, every fact a row matches joining its order (gen.order)
pub rec Order {
    mnemonic: str;
    stated:   gen_order.Stated;
}

# a register no operand names that every row of a mnemonic leaves holding a number whatever it reads, as every vector
# instruction leaves vstart zero once it completes
# ---
# mnemonic: the rows, `*` matching any run of characters
# register: the register's name in the file
# value:    the number
pub rec Reset {
    mnemonic: str;
    register: str;
    value:    i64;
}

# a latency class, the last line naming every row no other names
pub rec Latency {
    mnemonic: str;
    latency:  effect.Latency;
}

# a marked row: a copy of a base row with a marker operand after its own, the
# symbol of the relocation that lets the linker relax the sequence it ends, and
# the register the sequence names fixed, from riscv-elf-psabi-doc 48969b7,
# riscv-elf.adoc, "Thread Local Storage": the local exec add through tp, and
# the descriptor call through t0, both of which llvm-mc requires
# ---
# mnemonic:  the base row's mnemonic, which names one row
# specifier: the marked row's key after its base's key and a dot
# fixup:     the marker's fixup kind, by its path in the riscv fixup module
# arg:       the argument of the operand the sequence fixes
# register:  the register it is fixed to, by the register file's name
pub rec Mark {
    mnemonic:  str;
    specifier: str;
    fixup:     str;
    arg:       str;
    register:  str;
}

# the fixup kind a symbol takes by default in a row's relocatable operand, by
# its path in the riscv fixup module: %lo's i and s forms, %hi, %pcrel_hi,
# the branch and jump offsets and their compressed forms
pub rec Fixup {
    mnemonic: str;
    kind:     str;
}

# the rows riscv-opcodes states once but whose encoding differs by width, so
# each is a row at rv32 and a row at rv64: zcmp's, whose stack adjustment's
# base differs, with whether the adjustment is written negative, and
# amocas.d, whose registers are even pairs at rv32
pub rec Split {
    mnemonic: str;
    negative: bool;
}

# the inverse of a conditional branch, each operand the branch's own
# ---
# from: the branch
# to:   its inverse
pub rec Invert {
    from: str;
    to:   str;
}

# the longer form of a row whose target is out of range
# ---
# from:     the row relaxed
# to:       the row of the form's first step, nil for the inverted branch, the row's inverse
# inverted: whether the first step is the inverted branch, skipping a jal to the target
# link:     for a form of one step, the register its jal or branch takes in place of the operand
#           the row relaxed holds implicitly, by the register file's name
pub rec Relax {
    from:     str;
    to:       str;
    inverted: bool;
    link:     str;
}

# every fact of the effects topic
# ---
# undisturbed:   the role every other vector row's destination has
# unders:        the roles arguments have in place of their rows' under a state and an argument's value
# stack_pointer: the register an implicit operand is fixed to
# configs:       the vector configuration, a domain of state
# floats:        the floating-point state, a domain of state
# fixeds:        the vector fixed-point state, a domain of state
# inverts:       the inverse of each conditional branch
# far:           the jump of an inverted branch's form
# far_link:      the register it links to
# fills:         the no-ops the code fill writes, longest first
pub rec Effects {
    roles:          vector.Vector[Role];
    recasts:        vector.Vector[Recast];
    undisturbed:    Recast;
    unders:         vector.Vector[Under];
    implicits:      vector.Vector[Implicit];
    stack_pointer:  str;
    uses:           vector.Vector[Uses];
    saved:          vector.Vector[Saved];
    listed:         vector.Vector[Listed];
    configs:        vector.Vector[State];
    floats:         vector.Vector[State];
    fixeds:         vector.Vector[State];
    register_rules: vector.Vector[RegisterRule];
    memories:       vector.Vector[Memory];
    controls:       vector.Vector[Control];
    rules:          vector.Vector[Rule];
    stacks:         vector.Vector[Stack];
    offsets:        vector.Vector[Offset];
    resets:         vector.Vector[Reset];
    latencies:      vector.Vector[Latency];
    orders:         vector.Vector[Order];
    ordered:        vector.Vector[str];
    marks:          vector.Vector[Mark];
    fixups:         vector.Vector[Fixup];
    splits:         vector.Vector[Split];
    relaxes:        vector.Vector[Relax];
    inverts:        vector.Vector[Invert];
    far:            str;
    far_link:       str;
    fills:          vector.Vector[str];
}

val IMPLICIT_NAMES: [2]str = [2]str{"at", "role"};
val USES_NAMES:     [2]str = [2]str{"read", "written"};
val UNDER_NAMES:    [3]str = [3]str{"role", "state", "when"};
val STATE_NAMES:    [3]str = [3]str{"arg", "read", "written"};
val REGISTER_NAMES: [3]str = [3]str{"when", "read", "written"};
val MEMORY_NAMES:   [3]str = [3]str{"role", "element", "bits"};
val CONTROL_NAMES:  [8]str = [8]str{"transfer", "returns", "target", "conditional", "arg", "test", "left", "right"};
val TESTS:          [6]str = [6]str{"eq", "ne", "lt", "ge", "ltu", "geu"};
val RULE_NAMES:     [6]str = [6]str{"transfer", "returns", "target", "conditional", "first", "second"};
val MARK_NAMES:     [4]str = [4]str{"specifier", "fixup", "arg", "register"};
val SPLIT_NAMES:    [1]str = [1]str{"negative"};
val RELAX_NAMES:    [3]str = [3]str{"to", "inverted", "link"};
val FAR_NAMES:      [2]str = [2]str{"row", "link"};
val INVERT_NAMES:   [1]str = [1]str{"to"};
val ORDER_NAMES:    [4]str = [4]str{"before", "after", "field", "bits"};
val RESET_NAMES:    [2]str = [2]str{"register", "value"};

fun memory(l: *topic.Line) err[diag.Refusal] {
    ret topic.reject(l, diag.MEMORY, nil);
}

# the role `w` names
fun role_of(l: *topic.Line, w: str, out: *operand.Role) err[diag.Refusal] {
    if (str_equals(w, "read"))       { @out = operand.READ; }
    or (str_equals(w, "write"))      { @out = operand.WRITE; }
    or (str_equals(w, "read-write")) { @out = operand.READ_WRITE; }
    or                               { ret topic.reject(l, BAD_ROLE, w); }
    ret err[diag.Refusal].ok{};
}

# the role the one word of line `l`'s fact names
fun only_role(l: *topic.Line, out: *operand.Role) err[diag.Refusal] {
    val opt_only: opt[str] = topic.only(l);
    if (sel opt_only.none) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
    ret role_of(l, opt_only.some, out);
}

# the role the named value `role` of line `l` names
fun named_role(l: *topic.Line, out: *operand.Role) err[diag.Refusal] {
    var w:          str               = nil;
    val err_needed: err[diag.Refusal] = topic.needed(l, "role", ?w);
    if (sel err_needed.err) { ret err_needed; }
    ret role_of(l, w, out);
}

fun transfer_of(l: *topic.Line, out: *effect.Transfer) err[diag.Refusal] {
    var w:          str               = nil;
    val err_needed: err[diag.Refusal] = topic.needed(l, "transfer", ?w);
    if (sel err_needed.err)      { ret err_needed; }
    if (str_equals(w, "trap"))   { ret control.trap(l, out); }
    if (str_equals(w, "jump"))   { @out = effect.JUMP; }
    or (str_equals(w, "call"))   { @out = effect.CALL; }
    or (str_equals(w, "return")) { @out = effect.RETURN; }
    or (str_equals(w, "none"))   { @out = effect.NONE; }
    or                           { ret topic.reject(l, BAD_TRANSFER, w); }
    ret control.untrapped(l);
}

fun target_of(l: *topic.Line, out: *effect.Target) err[diag.Refusal] {
    var w:          str               = nil;
    val err_needed: err[diag.Refusal] = topic.needed(l, "target", ?w);
    if (sel err_needed.err)          { ret err_needed; }
    if (str_equals(w, "direct"))     { @out = effect.DIRECT; }
    or (str_equals(w, "indirect"))   { @out = effect.INDIRECT; }
    or (str_equals(w, "untargeted")) { @out = effect.UNTARGETED; }
    or                               { ret topic.reject(l, BAD_TRANSFER, w); }
    ret err[diag.Refusal].ok{};
}

# the term `text` spells: `<arg> in <registers>`, `<arg> = <n>` or `<arg> is <value>`
fun term_of(a: *A.Allocator, l: *topic.Line, text: str, out: *Term) err[diag.Refusal] {
    val res_words: res[vector.Vector[str], diag.Refusal] = topic.words(a, l.fact, text);
    if (sel res_words.err)    { ret err[diag.Refusal].err{res_words.err}; }
    if (res_words.ok.len < 3) { ret topic.reject(l, BAD_TERM, text); }
    val op: str = res_words.ok.data[1];
    if (str_equals(op, "in")) {
        val opt_regs: opt[str] = topic.joined(a, ?res_words.ok, 2);
        if (sel opt_regs.none) { ret memory(l); }
        @out = Term{arg: res_words.ok.data[0], test: Test.registers{opt_regs.some}};
        ret err[diag.Refusal].ok{};
    }
    if (res_words.ok.len != 3) { ret topic.reject(l, BAD_TERM, text); }
    if (str_equals(op, "is")) {
        @out = Term{arg: res_words.ok.data[0], test: Test.value{res_words.ok.data[2]}};
        ret err[diag.Refusal].ok{};
    }
    if (str_equals(op, "=")) {
        val res_number: res[i64, diag.Refusal] = topic.number(l.fact, res_words.ok.data[2]);
        if (sel res_number.err)                               { ret err[diag.Refusal].err{res_number.err}; }
        if (res_number.ok < 0 || res_number.ok > 0xFFFF_FFFF) { ret topic.reject(l, topic.BAD_NUMBER, res_words.ok.data[2]); }
        @out = Term{arg: res_words.ok.data[0], test: Test.enumerant{res_number.ok::u32}};
        ret err[diag.Refusal].ok{};
    }
    ret topic.reject(l, BAD_TERM, text);
}

# the path in the riscv fixup module of the fixup `name` names
fun fixup_path(a: *A.Allocator, l: *topic.Line, name: str, out: *str) err[diag.Refusal] {
    val len:          usize               = str_len(name);
    val res_allocate: res[*char, A.Error] = A.allocate[char](a, len + 1);
    if (sel res_allocate.err) { ret memory(l); }
    var i: usize = 0;
    for (i < len) {
        var c: u8 = name[i];
        if (c >= 'a' && c <= 'z') { c = c - 'a' + 'A'; }
        res_allocate.ok[i] = c;
        i                  = i + 1;
    }
    res_allocate.ok[len] = 0;
    val res_path: res[str, StrError] = str_join(a, "riscv_fixup.", res_allocate.ok);
    if (sel res_path.err) { ret memory(l); }
    @out = res_path.ok;
    ret err[diag.Refusal].ok{};
}

fun state_line(l: *topic.Line, out: *vector.Vector[State]) err[diag.Refusal] {
    val err_words: err[diag.Refusal] = topic.known(l, ?STATE_NAMES[0], 3);
    if (sel err_words.err) { ret err_words; }
    var st:       State             = State{mnemonic: l.key.data[1], arg: topic.optional(l, "arg", ""), read: nil, written: nil};
    val err_read: err[diag.Refusal] = topic.needed(l, "read", ?st.read);
    val err_wrot: err[diag.Refusal] = topic.needed(l, "written", ?st.written);
    if (sel err_read.err) { ret err_read; }
    if (sel err_wrot.err) { ret err_wrot; }
    val res_pushed: res[usize, A.Error] = vector.push[State](out, st);
    if (sel res_pushed.err) { ret memory(l); }
    ret err[diag.Refusal].ok{};
}

# the under line `l` read into `out`
fun under_line(a: *A.Allocator, l: *topic.Line, out: *Effects) err[diag.Refusal] {
    val err_words: err[diag.Refusal] = topic.known(l, ?UNDER_NAMES[0], 3);
    if (sel err_words.err) { ret err_words; }
    var u:              Under             = Under{mnemonic: l.key.data[1], arg: l.key.data[2], role: operand.NONE, state: 0, term: Term{arg: "", test: Test.registers{""}}};
    val err_named_role: err[diag.Refusal] = named_role(l, ?u.role);
    if (sel err_named_role.err) { ret err_named_role; }
    val opt_state: opt[str] = topic.value(?l.ws, "state");
    if (sel opt_state.some) {
        val res_number: res[i64, diag.Refusal] = topic.number(l.fact, opt_state.some);
        if (sel res_number.err) { ret err[diag.Refusal].err{res_number.err}; }
        if (res_number.ok <= 0) { ret topic.reject(l, topic.BAD_NUMBER, opt_state.some); }
        u.state = res_number.ok::u64;
    }
    val opt_when: opt[str] = topic.value(?l.ws, "when");
    if (sel opt_when.some) {
        val err_termed: err[diag.Refusal] = term_of(a, l, opt_when.some, ?u.term);
        if (sel err_termed.err) { ret err_termed; }
    }
    if (u.state == 0 && str_len(u.term.arg) == 0)    { ret topic.reject(l, UNCONDITIONED, l.fact.key); }
    if (!pushed(vector.push[Under](?out.unders, u))) { ret memory(l); }
    ret err[diag.Refusal].ok{};
}

fun roles_line(a: *A.Allocator, l: *topic.Line, out: *Effects, seen: *u8) res[bool, diag.Refusal] {
    if (topic.is(l, "role", 2)) {
        var r:             Role              = Role{arg: l.key.data[1], role: operand.NONE};
        val err_only_role: err[diag.Refusal] = only_role(l, ?r.role);
        if (sel err_only_role.err)                     { ret res[bool, diag.Refusal].err{err_only_role.err}; }
        if (!pushed(vector.push[Role](?out.roles, r))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "recast", 3) || topic.is(l, "undisturbed", 3)) {
        var r:             Recast            = Recast{mnemonic: l.key.data[1], arg: l.key.data[2], role: operand.NONE};
        val err_only_role: err[diag.Refusal] = only_role(l, ?r.role);
        if (sel err_only_role.err) { ret res[bool, diag.Refusal].err{err_only_role.err}; }
        if (str_equals(l.key.data[0], "undisturbed")) {
            if ((@seen & 1) != 0) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.key)}; }
            out.undisturbed = r;
            @seen           = @seen | 1;
            ret res[bool, diag.Refusal].ok{true};
        }
        if (!pushed(vector.push[Recast](?out.recasts, r))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "under", 3)) { ret flagged(under_line(a, l, out)); }
    if (topic.is(l, "implicit", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?IMPLICIT_NAMES[0], 2);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var x:              Implicit          = Implicit{mnemonic: l.key.data[1], at: 0, role: operand.NONE};
        var at:             str               = nil;
        val err_needed:     err[diag.Refusal] = topic.needed(l, "at", ?at);
        val err_named_role: err[diag.Refusal] = named_role(l, ?x.role);
        if (sel err_needed.err)     { ret res[bool, diag.Refusal].err{err_needed.err}; }
        if (sel err_named_role.err) { ret res[bool, diag.Refusal].err{err_named_role.err}; }
        if (str_equals(at, "last")) { x.at = LAST; }
        or {
            val res_number: res[i64, diag.Refusal] = topic.number(l.fact, at);
            if (sel res_number.err)                         { ret res[bool, diag.Refusal].err{res_number.err}; }
            if (res_number.ok < 0 || res_number.ok >= 0xFF) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_NUMBER, at)}; }
            x.at = res_number.ok::u8;
        }
        if (!pushed(vector.push[Implicit](?out.implicits, x))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "stack", 2) && str_equals(l.key.data[1], "pointer")) {
        val opt_only: opt[str] = topic.only(l);
        if (sel opt_only.none) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        if ((@seen & 2) != 0)  { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.key)}; }
        out.stack_pointer = opt_only.some;
        @seen             = @seen | 2;
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "uses", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?USES_NAMES[0], 2);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var u:        Uses              = Uses{mnemonic: l.key.data[1], read: nil, written: nil};
        val err_read: err[diag.Refusal] = topic.needed(l, "read", ?u.read);
        val err_wrot: err[diag.Refusal] = topic.needed(l, "written", ?u.written);
        if (sel err_read.err)                         { ret res[bool, diag.Refusal].err{err_read.err}; }
        if (sel err_wrot.err)                         { ret res[bool, diag.Refusal].err{err_wrot.err}; }
        if (!pushed(vector.push[Uses](?out.uses, u))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "saved", 2)) {
        val res_number: res[i64, diag.Refusal] = topic.number(l.fact, l.key.data[1]);
        if (sel res_number.err) { ret res[bool, diag.Refusal].err{res_number.err}; }
        val opt_regs: opt[str] = topic.only(l);
        if (sel opt_regs.none)                                                                                   { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        if (res_number.ok < 0 || res_number.ok > 0xFFFF_FFFF)                                                    { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_NUMBER, l.key.data[1])}; }
        if (!pushed(vector.push[Saved](?out.saved, Saved{value: res_number.ok::u32, registers: opt_regs.some}))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "listed", 3)) {
        var x:             Listed            = Listed{mnemonic: l.key.data[1], arg: l.key.data[2], role: operand.NONE};
        val err_only_role: err[diag.Refusal] = only_role(l, ?x.role);
        if (sel err_only_role.err)                        { ret res[bool, diag.Refusal].err{err_only_role.err}; }
        if (!pushed(vector.push[Listed](?out.listed, x))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    ret res[bool, diag.Refusal].ok{false};
}

fun access_line(a: *A.Allocator, l: *topic.Line, out: *Effects) res[bool, diag.Refusal] {
    if (topic.is(l, "config", 2)) { ret flagged(state_line(l, ?out.configs)); }
    if (topic.is(l, "float", 2))  { ret flagged(state_line(l, ?out.floats)); }
    if (topic.is(l, "fixed", 2))  { ret flagged(state_line(l, ?out.fixeds)); }
    if (topic.is(l, "register", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?REGISTER_NAMES[0], 3);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var r:          RegisterRule      = RegisterRule{mnemonic: l.key.data[1], term: Term{arg: "", test: Test.registers{""}}, read: nil, written: nil};
        var when:       str               = nil;
        val err_needed: err[diag.Refusal] = topic.needed(l, "when", ?when);
        val err_read:   err[diag.Refusal] = topic.needed(l, "read", ?r.read);
        val err_wrot:   err[diag.Refusal] = topic.needed(l, "written", ?r.written);
        if (sel err_needed.err) { ret res[bool, diag.Refusal].err{err_needed.err}; }
        if (sel err_read.err)   { ret res[bool, diag.Refusal].err{err_read.err}; }
        if (sel err_wrot.err)   { ret res[bool, diag.Refusal].err{err_wrot.err}; }
        val err_termed: err[diag.Refusal] = term_of(a, l, when, ?r.term);
        if (sel err_termed.err)                                         { ret res[bool, diag.Refusal].err{err_termed.err}; }
        if (!pushed(vector.push[RegisterRule](?out.register_rules, r))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "memory", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?MEMORY_NAMES[0], 3);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var m:              Memory            = Memory{mnemonic: l.key.data[1], role: operand.NONE, element: FIXED, bits: 0};
        var el:             str               = nil;
        val err_named_role: err[diag.Refusal] = named_role(l, ?m.role);
        val err_needed:     err[diag.Refusal] = topic.needed(l, "element", ?el);
        if (sel err_named_role.err)   { ret res[bool, diag.Refusal].err{err_named_role.err}; }
        if (sel err_needed.err)       { ret res[bool, diag.Refusal].err{err_needed.err}; }
        if (str_equals(el, "fixed"))  { m.element = FIXED; }
        or (str_equals(el, "suffix")) { m.element = SUFFIX; }
        or (str_equals(el, "xlen"))   { m.element = XLEN; }
        or (str_equals(el, "block"))  { m.element = BLOCK; }
        or                            { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, el)}; }
        val opt_bits: opt[str] = topic.value(?l.ws, "bits");
        var sized:    bool     = false;
        if (sel opt_bits.some)             { sized = true; }
        if (sized != (m.element == FIXED)) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        if (sel opt_bits.some) {
            val res_number: res[i64, diag.Refusal] = topic.number(l.fact, opt_bits.some);
            if (sel res_number.err)                        { ret res[bool, diag.Refusal].err{res_number.err}; }
            if (res_number.ok < 0 || res_number.ok > 1024) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_NUMBER, opt_bits.some)}; }
            m.bits = res_number.ok::u32;
        }
        if (!pushed(vector.push[Memory](?out.memories, m))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    ret res[bool, diag.Refusal].ok{false};
}

fun control_line(a: *A.Allocator, l: *topic.Line, out: *Effects) res[bool, diag.Refusal] {
    if (topic.is(l, "control", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?CONTROL_NAMES[0], 8);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var c:               Control           = Control{mnemonic: l.key.data[1], transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, arg: topic.optional(l, "arg", ""), test: effect.NO_TEST, left: topic.optional(l, "left", ""), right: topic.optional(l, "right", "")};
        val err_transfer_of: err[diag.Refusal] = transfer_of(l, ?c.transfer);
        val err_target_of:   err[diag.Refusal] = target_of(l, ?c.target);
        if (sel err_transfer_of.err) { ret res[bool, diag.Refusal].err{err_transfer_of.err}; }
        if (sel err_target_of.err)   { ret res[bool, diag.Refusal].err{err_target_of.err}; }
        val res_cond: res[bool, diag.Refusal] = topic.yes(l, "conditional", false);
        if (sel res_cond.err) { ret res[bool, diag.Refusal].err{res_cond.err}; }
        c.conditional = res_cond.ok;
        val opt_test: opt[str] = topic.value(?l.ws, "test");
        if (sel opt_test.some) {
            var k: usize = 0;
            for (k < 6 && c.test == effect.NO_TEST) {
                if (str_equals(opt_test.some, TESTS[k])) { c.test = (k + 1)::effect.Comparison; }
                k = k + 1;
            }
            if (c.test == effect.NO_TEST) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, opt_test.some)}; }
        }
        # a test needs a conditional transfer and its first register, and names registers only beside one
        val tested: bool = c.test != effect.NO_TEST;
        if (tested != (str_len(c.left) > 0) || (tested && !c.conditional) || (str_len(c.right) > 0 && !tested)) {
            ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)};
        }
        if (!pushed(vector.push[Control](?out.controls, c))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "rule", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?RULE_NAMES[0], 6);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var r:               Rule              = Rule{mnemonic: l.key.data[1], transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, first: Term{arg: "", test: Test.registers{""}}, second: Term{arg: "", test: Test.registers{""}}};
        val err_transfer_of: err[diag.Refusal] = transfer_of(l, ?r.transfer);
        val err_target_of:   err[diag.Refusal] = target_of(l, ?r.target);
        if (sel err_transfer_of.err) { ret res[bool, diag.Refusal].err{err_transfer_of.err}; }
        if (sel err_target_of.err)   { ret res[bool, diag.Refusal].err{err_target_of.err}; }
        val res_cond: res[bool, diag.Refusal] = topic.yes(l, "conditional", false);
        if (sel res_cond.err) { ret res[bool, diag.Refusal].err{res_cond.err}; }
        r.conditional = res_cond.ok;
        var first:      str               = nil;
        val err_needed: err[diag.Refusal] = topic.needed(l, "first", ?first);
        if (sel err_needed.err) { ret res[bool, diag.Refusal].err{err_needed.err}; }
        val err_term_of: err[diag.Refusal] = term_of(a, l, first, ?r.first);
        if (sel err_term_of.err) { ret res[bool, diag.Refusal].err{err_term_of.err}; }
        val opt_second: opt[str] = topic.value(?l.ws, "second");
        if (sel opt_second.some) {
            val err_term_of: err[diag.Refusal] = term_of(a, l, opt_second.some, ?r.second);
            if (sel err_term_of.err) { ret res[bool, diag.Refusal].err{err_term_of.err}; }
        }
        if (!pushed(vector.push[Rule](?out.rules, r))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "adjust", 2)) {
        val opt_arg: opt[str] = topic.only(l);
        if (sel opt_arg.none)                                                                            { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        if (!pushed(vector.push[Stack](?out.stacks, Stack{mnemonic: l.key.data[1], arg: opt_arg.some}))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "offset", 2)) {
        var x:        Offset            = Offset{mnemonic: l.key.data[1], stated: relation.Stated{to: nil, from: nil, base: nil, formed: nil, by: nil, shift: nil, step: 0, negated: false, constant: 0}};
        val err_read: err[diag.Refusal] = relation.read(l, 0, ?x.stated);
        if (sel err_read.err)                              { ret res[bool, diag.Refusal].err{err_read.err}; }
        if (!pushed(vector.push[Offset](?out.offsets, x))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "resets", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?RESET_NAMES[0], 2);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var x:          Reset             = Reset{mnemonic: l.key.data[1], register: nil, value: 0};
        var value:      str               = nil;
        val err_needed: err[diag.Refusal] = topic.needed(l, "register", ?x.register);
        if (sel err_needed.err) { ret res[bool, diag.Refusal].err{err_needed.err}; }
        val err_valued: err[diag.Refusal] = topic.needed(l, "value", ?value);
        if (sel err_valued.err) { ret res[bool, diag.Refusal].err{err_valued.err}; }
        val res_number: res[i64, diag.Refusal] = topic.number(l.fact, value);
        if (sel res_number.err) { ret res[bool, diag.Refusal].err{res_number.err}; }
        x.value = res_number.ok;
        if (!pushed(vector.push[Reset](?out.resets, x))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "order", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?ORDER_NAMES[0], 4);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var o:        Order             = Order{mnemonic: l.key.data[1], stated: gen_order.Stated{before: effect.NO_KINDS, after: effect.NO_KINDS, field: nil, mask: 0, value: 0, width: 0}};
        val err_read: err[diag.Refusal] = gen_order.read(l, ?o.stated);
        if (sel err_read.err)                            { ret res[bool, diag.Refusal].err{err_read.err}; }
        if (!pushed(vector.push[Order](?out.orders, o))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "ordered", 2)) {
        val err_req: err[diag.Refusal] = gen_order.required(l);
        if (sel err_req.err)                                        { ret res[bool, diag.Refusal].err{err_req.err}; }
        if (!pushed(vector.push[str](?out.ordered, l.key.data[1]))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "latency", 2)) {
        val opt_only: opt[str] = topic.only(l);
        if (sel opt_only.none) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        var x: Latency = Latency{mnemonic: l.key.data[1], latency: effect.ONE};
        if (str_equals(opt_only.some, "one"))                 { x.latency = effect.ONE; }
        or (str_equals(opt_only.some, "few"))                 { x.latency = effect.FEW; }
        or (str_equals(opt_only.some, "many"))                { x.latency = effect.MANY; }
        or (str_equals(opt_only.some, "serial"))              { x.latency = effect.SERIAL; }
        or                                                    { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, BAD_TRANSFER, opt_only.some)}; }
        if (!pushed(vector.push[Latency](?out.latencies, x))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    ret res[bool, diag.Refusal].ok{false};
}

fun row_line(a: *A.Allocator, l: *topic.Line, out: *Effects, seen: *u8) res[bool, diag.Refusal] {
    if (topic.is(l, "mark", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?MARK_NAMES[0], 4);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var m:                   Mark              = Mark{mnemonic: l.key.data[1], specifier: nil, fixup: nil, arg: nil, register: nil};
        var fixup:               str               = nil;
        val err_needed:          err[diag.Refusal] = topic.needed(l, "specifier", ?m.specifier);
        val err_needed_fixup:    err[diag.Refusal] = topic.needed(l, "fixup", ?fixup);
        val err_needed_arg:      err[diag.Refusal] = topic.needed(l, "arg", ?m.arg);
        val err_needed_register: err[diag.Refusal] = topic.needed(l, "register", ?m.register);
        if (sel err_needed.err)          { ret res[bool, diag.Refusal].err{err_needed.err}; }
        if (sel err_needed_fixup.err)    { ret res[bool, diag.Refusal].err{err_needed_fixup.err}; }
        if (sel err_needed_arg.err)      { ret res[bool, diag.Refusal].err{err_needed_arg.err}; }
        if (sel err_needed_register.err) { ret res[bool, diag.Refusal].err{err_needed_register.err}; }
        val err_path: err[diag.Refusal] = fixup_path(a, l, fixup, ?m.fixup);
        if (sel err_path.err)                          { ret res[bool, diag.Refusal].err{err_path.err}; }
        if (!pushed(vector.push[Mark](?out.marks, m))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "fixup", 2)) {
        val opt_only: opt[str] = topic.only(l);
        if (sel opt_only.none) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        var x:        Fixup             = Fixup{mnemonic: l.key.data[1], kind: nil};
        val err_path: err[diag.Refusal] = fixup_path(a, l, opt_only.some, ?x.kind);
        if (sel err_path.err)                            { ret res[bool, diag.Refusal].err{err_path.err}; }
        if (!pushed(vector.push[Fixup](?out.fixups, x))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "split", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?SPLIT_NAMES[0], 1);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var stated:     str               = nil;
        val err_needed: err[diag.Refusal] = topic.needed(l, "negative", ?stated);
        if (sel err_needed.err) { ret res[bool, diag.Refusal].err{err_needed.err}; }
        val res_negative: res[bool, diag.Refusal] = topic.yes(l, "negative", false);
        if (sel res_negative.err)                                                                                { ret res[bool, diag.Refusal].err{res_negative.err}; }
        if (!pushed(vector.push[Split](?out.splits, Split{mnemonic: l.key.data[1], negative: res_negative.ok}))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "relax", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?RELAX_NAMES[0], 3);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var r:            Relax                   = Relax{from: l.key.data[1], to: nil, inverted: false, link: topic.optional(l, "link", "")};
        val res_inverted: res[bool, diag.Refusal] = topic.yes(l, "inverted", false);
        if (sel res_inverted.err) { ret res[bool, diag.Refusal].err{res_inverted.err}; }
        r.inverted = res_inverted.ok;
        # an inverted branch's first step is the row's inverse, which an invert line states
        val opt_stated: opt[str] = topic.value(?l.ws, "to");
        if (r.inverted) {
            if (sel opt_stated.some) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        }
        or {
            val err_needed: err[diag.Refusal] = topic.needed(l, "to", ?r.to);
            if (sel err_needed.err) { ret res[bool, diag.Refusal].err{err_needed.err}; }
        }
        if (!pushed(vector.push[Relax](?out.relaxes, r))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "invert", 2)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?INVERT_NAMES[0], 1);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        var v:          Invert            = Invert{from: l.key.data[1], to: nil};
        val err_needed: err[diag.Refusal] = topic.needed(l, "to", ?v.to);
        if (sel err_needed.err) { ret res[bool, diag.Refusal].err{err_needed.err}; }
        var k: usize = 0;
        for (k < out.inverts.len) {
            if (str_equals(out.inverts.data[k].from, v.from)) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.key)}; }
            k = k + 1;
        }
        if (!pushed(vector.push[Invert](?out.inverts, v))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "far", 1)) {
        val err_words: err[diag.Refusal] = topic.known(l, ?FAR_NAMES[0], 2);
        if (sel err_words.err) { ret res[bool, diag.Refusal].err{err_words.err}; }
        if ((@seen & 4) != 0)  { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.key)}; }
        val err_needed:      err[diag.Refusal] = topic.needed(l, "row", ?out.far);
        val err_needed_link: err[diag.Refusal] = topic.needed(l, "link", ?out.far_link);
        if (sel err_needed.err)      { ret res[bool, diag.Refusal].err{err_needed.err}; }
        if (sel err_needed_link.err) { ret res[bool, diag.Refusal].err{err_needed_link.err}; }
        @seen = @seen | 4;
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "fill", 1)) {
        val opt_only: opt[str] = topic.only(l);
        if (sel opt_only.none) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        if ((@seen & 8) != 0)  { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.key)}; }
        val res_rows: res[vector.Vector[str], diag.Refusal] = topic.words(a, l.fact, opt_only.some);
        if (sel res_rows.err)     { ret res[bool, diag.Refusal].err{res_rows.err}; }
        if (res_rows.ok.len == 0) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        out.fills = res_rows.ok;
        @seen     = @seen | 8;
        ret res[bool, diag.Refusal].ok{true};
    }
    ret res[bool, diag.Refusal].ok{false};
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# a kind read by `done`, as a read line
fun flagged(done: err[diag.Refusal]) res[bool, diag.Refusal] {
    if (sel done.err) { ret res[bool, diag.Refusal].err{done.err}; }
    ret res[bool, diag.Refusal].ok{true};
}

# the effects topic `t` read into `out`
pub fun read(a: *A.Allocator, t: *topic.Topic, out: *Effects) err[diag.Refusal] {
    @out = Effects{
        roles:          vector.init[Role](a),
        recasts:        vector.init[Recast](a),
        unders:         vector.init[Under](a),
        implicits:      vector.init[Implicit](a),
        uses:           vector.init[Uses](a),
        saved:          vector.init[Saved](a),
        listed:         vector.init[Listed](a),
        configs:        vector.init[State](a),
        floats:         vector.init[State](a),
        fixeds:         vector.init[State](a),
        register_rules: vector.init[RegisterRule](a),
        memories:       vector.init[Memory](a),
        controls:       vector.init[Control](a),
        rules:          vector.init[Rule](a),
        stacks:         vector.init[Stack](a),
        offsets:        vector.init[Offset](a),
        resets:         vector.init[Reset](a),
        latencies:      vector.init[Latency](a),
        orders:         vector.init[Order](a),
        ordered:        vector.init[str](a),
        marks:          vector.init[Mark](a),
        fixups:         vector.init[Fixup](a),
        splits:         vector.init[Split](a),
        relaxes:        vector.init[Relax](a),
        inverts:        vector.init[Invert](a),
        fills:          vector.init[str](a),
    };
    val err_checked: err[diag.Refusal] = topic.check(t, nil, topic.unstated);
    if (sel err_checked.err) { ret err_checked; }
    var seen: u8    = 0;
    var i:    usize = 0;
    for (i < t.facts.len) {
        var l:         topic.Line;
        val err_lined: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel err_lined.err) { ret err_lined; }
        if (l.key.len == 0)    { ret topic.reject(?l, topic.BAD_FACT, l.fact.key); }
        val res_roled: res[bool, diag.Refusal] = roles_line(a, ?l, out, ?seen);
        if (sel res_roled.err) { ret err[diag.Refusal].err{res_roled.err}; }
        var taken: bool = res_roled.ok;
        if (!taken) {
            val res_accessed: res[bool, diag.Refusal] = access_line(a, ?l, out);
            if (sel res_accessed.err) { ret err[diag.Refusal].err{res_accessed.err}; }
            taken = res_accessed.ok;
        }
        if (!taken) {
            val res_controlled: res[bool, diag.Refusal] = control_line(a, ?l, out);
            if (sel res_controlled.err) { ret err[diag.Refusal].err{res_controlled.err}; }
            taken = res_controlled.ok;
        }
        if (!taken) {
            val res_rowed: res[bool, diag.Refusal] = row_line(a, ?l, out, ?seen);
            if (sel res_rowed.err) { ret err[diag.Refusal].err{res_rowed.err}; }
            taken = res_rowed.ok;
        }
        if (!taken) { ret topic.reject(?l, topic.BAD_FACT, l.fact.key); }
        i = i + 1;
    }
    if (seen != 15) { ret err[diag.Refusal].err{diag.refusal(t.path, 0, UNSTATED, nil)}; }
    ret err[diag.Refusal].ok{};
}
