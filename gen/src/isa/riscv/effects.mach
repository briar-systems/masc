# the effects of the riscv rows, read from the effects topic
#
# riscv-opcodes states no effect. a row's registers by role come from its
# arguments, and what they do not state is in gen/data/riscv/effects.txt: the
# roles that differ from an argument's default, the stack pointer the
# compressed stack forms name but hold in their fixed bits, the registers no
# operand names, memory accesses and their width, control transfer, stack
# change, latency, the default fixup kind of each relocatable operand, the
# marked rows, the rows split by width, the relaxations and the code fill.
# every kind is matched by mnemonic, a trailing `*` matching a prefix, and the
# first line that matches is taken. register names are the register file's own.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.arena;
use std.allocator.page;
use std.collections.vector;

use masc.core.effect;
use masc.core.operand;

use gen.diag;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "effects";

pub val BAD_ROLE:     str = "effects line states a role that is none of read, write and read-write";
pub val BAD_TRANSFER: str = "effects line states a transfer, target or latency its kind does not read";
pub val BAD_TERM:     str = "effects line states a term that is no `<arg> in <registers>`, `<arg> = <n>` or `<arg> is <value>`";
pub val UNSTATED:     str = "effects topic lacks its undisturbed, stack pointer, far or fill line";

# the role of the operand an argument names, every other argument being read
pub rec Role {
    arg:  str;
    role: operand.Role;
}

# a row's role for one argument in place of the default
pub rec Recast {
    mnemonic: str;
    arg:      str;
    role:     operand.Role;
}

# the stack pointer a compressed stack form spells but holds in its fixed bits, as an operand fixed to x2
# ---
# at:   where it stands among the row's operands, LAST for after every other
# role: how the row uses it
pub rec Implicit {
    mnemonic: str;
    at:       u8;
    role:     operand.Role;
}

# the place of an implicit operand after every other
pub val LAST: u8 = 0xFF;

# registers a row reads and writes that no operand names, by the register file's names split by spaces
pub rec Uses {
    mnemonic: str;
    read:     str;
    written:  str;
}

# the registers a list operand's value names, by the register file's names split by spaces
pub rec Saved {
    value:     u32;
    registers: str;
}

# a row whose list operand reads or writes the registers its value names
# ---
# mnemonic: the row
# arg:      its list argument, an enumerant each of whose members a saved line states
# role:     whether it reads the registers, as cm.push saves them, or writes them, as the pops restore them
pub rec Listed {
    mnemonic: str;
    arg:      str;
    role:     operand.Role;
}

# the control and status state a row reads and writes that no operand names, by the register file's names split by spaces
# ---
# mnemonic: the rows it states, a pattern with an optional `*`
# arg:      an argument the row must have, empty when none is needed
# read:     the state it reads
# written:  the state it writes
#
# a table is a domain of state, and its first row that matches a mnemonic and has its argument is the one taken, so a
# row for an exception comes before the row for the rule it excepts. every domain applies, so a row can take a state
# from each. state that accrues (fflags, vxsat) is both read and written, since an instruction adds to what is there
# and a write that left it undefined would let a pass drop the sets before it
pub rec State {
    mnemonic: str;
    arg:      str;
    read:     str;
    written:  str;
}

# how an access's element width is stated
# ---
# FIXED:  `bits` bits
# SUFFIX: the width the mnemonic's last part names: b 8, h 16, w 32, d 64, q 128
# XLEN:   one register of the integer file, as zcmp saves, its count no operand states
# BLOCK:  a cache block, whose size the platform states and no operand gives
pub def Element: u8;

pub val FIXED:  Element = 0;
pub val SUFFIX: Element = 1;
pub val XLEN:   Element = 2;
pub val BLOCK:  Element = 3;

# a scalar memory access: its role and its width. its address is the row's
# address register (rs1, rs1_p, or the stack pointer), offset by the row's
# immediate when it has one, and for zcmp the stack pointer, which no operand names
pub rec Memory {
    mnemonic: str;
    role:     operand.Role;
    element:  Element;
    bits:     u32;
}

# a control transfer: what it does, where to, whether it may fall through, and the argument holding its target
pub rec Control {
    mnemonic:    str;
    transfer:    effect.Transfer;
    target:      effect.Target;
    conditional: bool;
    arg:         str;
}

# a test of an argument's value
# ---
# registers: its register is one of these, by the register file's names split by spaces
# enumerant: its enumerant is exactly this value
# value:     its enumerant is the value the fields topic names this
pub tag Test: u8 {
    registers: str;
    enumerant: u32;
    value:     str;
}

# a test of one argument
# ---
# arg:  the argument, empty when the term is not used
# test: what its value must meet
pub rec Term {
    arg:  str;
    test: Test;
}

# a control transfer a row has instead of its own when its registers meet both terms
pub rec Rule {
    mnemonic:    str;
    transfer:    effect.Transfer;
    target:      effect.Target;
    conditional: bool;
    first:       Term;
    second:      Term;
}

# registers a row reads and writes as well as its own when an argument meets the term
# ---
# mnemonic: the rows it states, a pattern with an optional `*`
# term:     the test the row's argument must meet, a row without the argument taking none of it
# read:     the further registers it reads then, by the register file's names split by spaces
# written:  the further registers it writes then
#
# at most one row may match a mnemonic and have its argument, and a row two match is refused naming both, so each fact
# has one owner. a row holds that one rule, whose sets are the row's own with these added and which stands in for them
# whenever the term holds
pub rec RegisterRule {
    mnemonic: str;
    term:     Term;
    read:     str;
    written:  str;
}

# a change to the stack pointer by the value of an argument's operand, as zcmp's adjustment
pub rec Stack {
    mnemonic: str;
    arg:      str;
}

# a latency class, the last line naming every row no other names
pub rec Latency {
    mnemonic: str;
    latency:  effect.Latency;
}

# a marked row: a copy of a base row with a marker operand after its own, the
# symbol of the relocation that lets the linker relax the sequence it ends, and
# the register the sequence names fixed, from riscv-elf-psabi-doc 48969b7,
# riscv-elf.adoc, "Thread Local Storage": the local exec add through tp, and
# the descriptor call through t0, both of which llvm-mc requires
# ---
# mnemonic:  the base row's mnemonic, which names one row
# specifier: the marked row's key after its base's key and a dot
# fixup:     the marker's fixup kind, by its path in the riscv fixup module
# arg:       the argument of the operand the sequence fixes
# register:  the register it is fixed to, by the register file's name
pub rec Mark {
    mnemonic:  str;
    specifier: str;
    fixup:     str;
    arg:       str;
    register:  str;
}

# the fixup kind a symbol takes by default in a row's relocatable operand, by
# its path in the riscv fixup module: %lo's i and s forms, %hi, %pcrel_hi,
# the branch and jump offsets and their compressed forms
pub rec Fixup {
    mnemonic: str;
    kind:     str;
}

# the rows riscv-opcodes states once but whose encoding differs by width, so
# each is a row at rv32 and a row at rv64: zcmp's, whose stack adjustment's
# base differs, with whether the adjustment is written negative, and
# amocas.d, whose registers are even pairs at rv32
pub rec Split {
    mnemonic: str;
    negative: bool;
}

# the longer form of a row whose target is out of range
# ---
# from:     the row relaxed
# to:       the row of the form's first step
# inverted: whether the first step is the inverted branch, skipping a jal to the target
# link:     for a form of one step, the register its jal or branch takes in place of the operand
#           the row relaxed holds implicitly, by the register file's name
pub rec Relax {
    from:     str;
    to:       str;
    inverted: bool;
    link:     str;
}

# every fact of the effects topic
# ---
# undisturbed:   the role every other vector row's destination has
# stack_pointer: the register an implicit operand is fixed to
# configs:       the vector configuration, a domain of state
# floats:        the floating-point state, a domain of state
# fixeds:        the vector fixed-point state, a domain of state
# far:           the jump of an inverted branch's form
# far_link:      the register it links to
# fills:         the no-ops the code fill writes, longest first
pub rec Effects {
    roles:          vector.Vector[Role];
    recasts:        vector.Vector[Recast];
    undisturbed:    Recast;
    implicits:      vector.Vector[Implicit];
    stack_pointer:  str;
    uses:           vector.Vector[Uses];
    saved:          vector.Vector[Saved];
    listed:         vector.Vector[Listed];
    configs:        vector.Vector[State];
    floats:         vector.Vector[State];
    fixeds:         vector.Vector[State];
    register_rules: vector.Vector[RegisterRule];
    memories:       vector.Vector[Memory];
    controls:       vector.Vector[Control];
    rules:          vector.Vector[Rule];
    stacks:         vector.Vector[Stack];
    latencies:      vector.Vector[Latency];
    marks:          vector.Vector[Mark];
    fixups:         vector.Vector[Fixup];
    splits:         vector.Vector[Split];
    relaxes:        vector.Vector[Relax];
    far:            str;
    far_link:       str;
    fills:          vector.Vector[str];
}

val IMPLICIT_NAMES: [2]str = [2]str{"at", "role"};
val USES_NAMES:     [2]str = [2]str{"read", "written"};
val STATE_NAMES:    [3]str = [3]str{"arg", "read", "written"};
val REGISTER_NAMES: [3]str = [3]str{"when", "read", "written"};
val MEMORY_NAMES:   [3]str = [3]str{"role", "element", "bits"};
val CONTROL_NAMES:  [4]str = [4]str{"transfer", "target", "conditional", "arg"};
val RULE_NAMES:     [5]str = [5]str{"transfer", "target", "conditional", "first", "second"};
val MARK_NAMES:     [4]str = [4]str{"specifier", "fixup", "arg", "register"};
val SPLIT_NAMES:    [1]str = [1]str{"negative"};
val RELAX_NAMES:    [3]str = [3]str{"to", "inverted", "link"};
val FAR_NAMES:      [2]str = [2]str{"row", "link"};

fun memory(l: *topic.Line) err[diag.Refusal] {
    ret topic.reject(l, diag.MEMORY, nil);
}

# the role `w` names
fun role_of(l: *topic.Line, w: str, out: *operand.Role) err[diag.Refusal] {
    if (str_equals(w, "read"))       { @out = operand.READ; }
    or (str_equals(w, "write"))      { @out = operand.WRITE; }
    or (str_equals(w, "read-write")) { @out = operand.READ_WRITE; }
    or                               { ret topic.reject(l, BAD_ROLE, w); }
    ret err[diag.Refusal].ok{};
}

# the role the one word of line `l`'s fact names
fun only_role(l: *topic.Line, out: *operand.Role) err[diag.Refusal] {
    val w: opt[str] = topic.only(l);
    if (sel w.none) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
    ret role_of(l, w.some, out);
}

# the role the named value `role` of line `l` names
fun named_role(l: *topic.Line, out: *operand.Role) err[diag.Refusal] {
    var w:   str               = nil;
    val got: err[diag.Refusal] = topic.needed(l, "role", ?w);
    if (sel got.err) { ret got; }
    ret role_of(l, w, out);
}

fun transfer_of(l: *topic.Line, out: *effect.Transfer) err[diag.Refusal] {
    var w:   str               = nil;
    val got: err[diag.Refusal] = topic.needed(l, "transfer", ?w);
    if (sel got.err)             { ret got; }
    if (str_equals(w, "jump"))   { @out = effect.JUMP; }
    or (str_equals(w, "call"))   { @out = effect.CALL; }
    or (str_equals(w, "return")) { @out = effect.RETURN; }
    or (str_equals(w, "trap"))   { @out = effect.TRAP; }
    or (str_equals(w, "none"))   { @out = effect.NONE; }
    or                           { ret topic.reject(l, BAD_TRANSFER, w); }
    ret err[diag.Refusal].ok{};
}

fun target_of(l: *topic.Line, out: *effect.Target) err[diag.Refusal] {
    var w:   str               = nil;
    val got: err[diag.Refusal] = topic.needed(l, "target", ?w);
    if (sel got.err)                 { ret got; }
    if (str_equals(w, "direct"))     { @out = effect.DIRECT; }
    or (str_equals(w, "indirect"))   { @out = effect.INDIRECT; }
    or (str_equals(w, "untargeted")) { @out = effect.UNTARGETED; }
    or                               { ret topic.reject(l, BAD_TRANSFER, w); }
    ret err[diag.Refusal].ok{};
}

# the term `text` spells: `<arg> in <registers>`, `<arg> = <n>` or `<arg> is <value>`
fun term_of(a: *A.Allocator, l: *topic.Line, text: str, out: *Term) err[diag.Refusal] {
    val ws: res[vector.Vector[str], diag.Refusal] = topic.words(a, l.fact, text);
    if (sel ws.err)    { ret err[diag.Refusal].err{ws.err}; }
    if (ws.ok.len < 3) { ret topic.reject(l, BAD_TERM, text); }
    val op: str = ws.ok.data[1];
    if (str_equals(op, "in")) {
        val regs: opt[str] = topic.joined(a, ?ws.ok, 2);
        if (sel regs.none) { ret memory(l); }
        @out = Term{arg: ws.ok.data[0], test: Test.registers{regs.some}};
        ret err[diag.Refusal].ok{};
    }
    if (ws.ok.len != 3) { ret topic.reject(l, BAD_TERM, text); }
    if (str_equals(op, "is")) {
        @out = Term{arg: ws.ok.data[0], test: Test.value{ws.ok.data[2]}};
        ret err[diag.Refusal].ok{};
    }
    if (str_equals(op, "=")) {
        val n: res[i64, diag.Refusal] = topic.number(l.fact, ws.ok.data[2]);
        if (sel n.err)                      { ret err[diag.Refusal].err{n.err}; }
        if (n.ok < 0 || n.ok > 0xFFFF_FFFF) { ret topic.reject(l, topic.BAD_NUMBER, ws.ok.data[2]); }
        @out = Term{arg: ws.ok.data[0], test: Test.enumerant{n.ok::u32}};
        ret err[diag.Refusal].ok{};
    }
    ret topic.reject(l, BAD_TERM, text);
}

# the path in the riscv fixup module of the fixup `name` names
fun fixup_path(a: *A.Allocator, l: *topic.Line, name: str, out: *str) err[diag.Refusal] {
    val len: usize               = str_len(name);
    val got: res[*char, A.Error] = A.allocate[char](a, len + 1);
    if (sel got.err) { ret memory(l); }
    var i: usize = 0;
    for (i < len) {
        var c: u8 = name[i];
        if (c >= 'a' && c <= 'z') { c = c - 'a' + 'A'; }
        got.ok[i] = c;
        i         = i + 1;
    }
    got.ok[len] = 0;
    val path: res[str, StrError] = str_join(a, "riscv_fixup.", got.ok);
    if (sel path.err) { ret memory(l); }
    @out = path.ok;
    ret err[diag.Refusal].ok{};
}

fun state_line(l: *topic.Line, out: *vector.Vector[State]) err[diag.Refusal] {
    val words: err[diag.Refusal] = topic.known(l, ?STATE_NAMES[0], 3);
    if (sel words.err) { ret words; }
    var st:   State             = State{mnemonic: l.key.data[1], arg: topic.optional(l, "arg", ""), read: nil, written: nil};
    val read: err[diag.Refusal] = topic.needed(l, "read", ?st.read);
    val wrot: err[diag.Refusal] = topic.needed(l, "written", ?st.written);
    if (sel read.err) { ret read; }
    if (sel wrot.err) { ret wrot; }
    val pushed: res[usize, A.Error] = vector.push[State](out, st);
    if (sel pushed.err) { ret memory(l); }
    ret err[diag.Refusal].ok{};
}

fun roles_line(l: *topic.Line, out: *Effects, seen: *u8) res[bool, diag.Refusal] {
    if (topic.is(l, "role", 2)) {
        var r:   Role              = Role{arg: l.key.data[1], role: operand.NONE};
        val got: err[diag.Refusal] = only_role(l, ?r.role);
        if (sel got.err)                               { ret res[bool, diag.Refusal].err{got.err}; }
        if (!pushed(vector.push[Role](?out.roles, r))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "recast", 3) || topic.is(l, "undisturbed", 3)) {
        var r:   Recast            = Recast{mnemonic: l.key.data[1], arg: l.key.data[2], role: operand.NONE};
        val got: err[diag.Refusal] = only_role(l, ?r.role);
        if (sel got.err) { ret res[bool, diag.Refusal].err{got.err}; }
        if (str_equals(l.key.data[0], "undisturbed")) {
            if ((@seen & 1) != 0) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.key)}; }
            out.undisturbed = r;
            @seen           = @seen | 1;
            ret res[bool, diag.Refusal].ok{true};
        }
        if (!pushed(vector.push[Recast](?out.recasts, r))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "implicit", 2)) {
        val words: err[diag.Refusal] = topic.known(l, ?IMPLICIT_NAMES[0], 2);
        if (sel words.err) { ret res[bool, diag.Refusal].err{words.err}; }
        var x:  Implicit          = Implicit{mnemonic: l.key.data[1], at: 0, role: operand.NONE};
        var at: str               = nil;
        val ag: err[diag.Refusal] = topic.needed(l, "at", ?at);
        val rg: err[diag.Refusal] = named_role(l, ?x.role);
        if (sel ag.err)             { ret res[bool, diag.Refusal].err{ag.err}; }
        if (sel rg.err)             { ret res[bool, diag.Refusal].err{rg.err}; }
        if (str_equals(at, "last")) { x.at = LAST; }
        or {
            val n: res[i64, diag.Refusal] = topic.number(l.fact, at);
            if (sel n.err)                { ret res[bool, diag.Refusal].err{n.err}; }
            if (n.ok < 0 || n.ok >= 0xFF) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_NUMBER, at)}; }
            x.at = n.ok::u8;
        }
        if (!pushed(vector.push[Implicit](?out.implicits, x))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "stack", 2) && str_equals(l.key.data[1], "pointer")) {
        val w: opt[str] = topic.only(l);
        if (sel w.none)       { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        if ((@seen & 2) != 0) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.key)}; }
        out.stack_pointer = w.some;
        @seen             = @seen | 2;
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "uses", 2)) {
        val words: err[diag.Refusal] = topic.known(l, ?USES_NAMES[0], 2);
        if (sel words.err) { ret res[bool, diag.Refusal].err{words.err}; }
        var u:    Uses              = Uses{mnemonic: l.key.data[1], read: nil, written: nil};
        val read: err[diag.Refusal] = topic.needed(l, "read", ?u.read);
        val wrot: err[diag.Refusal] = topic.needed(l, "written", ?u.written);
        if (sel read.err)                             { ret res[bool, diag.Refusal].err{read.err}; }
        if (sel wrot.err)                             { ret res[bool, diag.Refusal].err{wrot.err}; }
        if (!pushed(vector.push[Uses](?out.uses, u))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "saved", 2)) {
        val n: res[i64, diag.Refusal] = topic.number(l.fact, l.key.data[1]);
        if (sel n.err) { ret res[bool, diag.Refusal].err{n.err}; }
        val regs: opt[str] = topic.only(l);
        if (sel regs.none)                                                                          { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        if (n.ok < 0 || n.ok > 0xFFFF_FFFF)                                                         { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_NUMBER, l.key.data[1])}; }
        if (!pushed(vector.push[Saved](?out.saved, Saved{value: n.ok::u32, registers: regs.some}))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "listed", 3)) {
        var x:   Listed            = Listed{mnemonic: l.key.data[1], arg: l.key.data[2], role: operand.NONE};
        val got: err[diag.Refusal] = only_role(l, ?x.role);
        if (sel got.err)                                  { ret res[bool, diag.Refusal].err{got.err}; }
        if (!pushed(vector.push[Listed](?out.listed, x))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    ret res[bool, diag.Refusal].ok{false};
}

fun access_line(a: *A.Allocator, l: *topic.Line, out: *Effects) res[bool, diag.Refusal] {
    if (topic.is(l, "config", 2)) { ret flagged(state_line(l, ?out.configs)); }
    if (topic.is(l, "float", 2))  { ret flagged(state_line(l, ?out.floats)); }
    if (topic.is(l, "fixed", 2))  { ret flagged(state_line(l, ?out.fixeds)); }
    if (topic.is(l, "register", 2)) {
        val words: err[diag.Refusal] = topic.known(l, ?REGISTER_NAMES[0], 3);
        if (sel words.err) { ret res[bool, diag.Refusal].err{words.err}; }
        var r:    RegisterRule      = RegisterRule{mnemonic: l.key.data[1], term: Term{arg: "", test: Test.registers{""}}, read: nil, written: nil};
        var when: str               = nil;
        val wh:   err[diag.Refusal] = topic.needed(l, "when", ?when);
        val read: err[diag.Refusal] = topic.needed(l, "read", ?r.read);
        val wrot: err[diag.Refusal] = topic.needed(l, "written", ?r.written);
        if (sel wh.err)   { ret res[bool, diag.Refusal].err{wh.err}; }
        if (sel read.err) { ret res[bool, diag.Refusal].err{read.err}; }
        if (sel wrot.err) { ret res[bool, diag.Refusal].err{wrot.err}; }
        val termed: err[diag.Refusal] = term_of(a, l, when, ?r.term);
        if (sel termed.err)                                             { ret res[bool, diag.Refusal].err{termed.err}; }
        if (!pushed(vector.push[RegisterRule](?out.register_rules, r))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "memory", 2)) {
        val words: err[diag.Refusal] = topic.known(l, ?MEMORY_NAMES[0], 3);
        if (sel words.err) { ret res[bool, diag.Refusal].err{words.err}; }
        var m:  Memory            = Memory{mnemonic: l.key.data[1], role: operand.NONE, element: FIXED, bits: 0};
        var el: str               = nil;
        val rg: err[diag.Refusal] = named_role(l, ?m.role);
        val eg: err[diag.Refusal] = topic.needed(l, "element", ?el);
        if (sel rg.err)               { ret res[bool, diag.Refusal].err{rg.err}; }
        if (sel eg.err)               { ret res[bool, diag.Refusal].err{eg.err}; }
        if (str_equals(el, "fixed"))  { m.element = FIXED; }
        or (str_equals(el, "suffix")) { m.element = SUFFIX; }
        or (str_equals(el, "xlen"))   { m.element = XLEN; }
        or (str_equals(el, "block"))  { m.element = BLOCK; }
        or                            { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, el)}; }
        val bits:  opt[str] = topic.value(?l.ws, "bits");
        var sized: bool     = false;
        if (sel bits.some)                 { sized = true; }
        if (sized != (m.element == FIXED)) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        if (sel bits.some) {
            val n: res[i64, diag.Refusal] = topic.number(l.fact, bits.some);
            if (sel n.err)               { ret res[bool, diag.Refusal].err{n.err}; }
            if (n.ok < 0 || n.ok > 1024) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_NUMBER, bits.some)}; }
            m.bits = n.ok::u32;
        }
        if (!pushed(vector.push[Memory](?out.memories, m))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    ret res[bool, diag.Refusal].ok{false};
}

fun control_line(a: *A.Allocator, l: *topic.Line, out: *Effects) res[bool, diag.Refusal] {
    if (topic.is(l, "control", 2)) {
        val words: err[diag.Refusal] = topic.known(l, ?CONTROL_NAMES[0], 4);
        if (sel words.err) { ret res[bool, diag.Refusal].err{words.err}; }
        var c:  Control           = Control{mnemonic: l.key.data[1], transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, arg: topic.optional(l, "arg", "")};
        val tr: err[diag.Refusal] = transfer_of(l, ?c.transfer);
        val tg: err[diag.Refusal] = target_of(l, ?c.target);
        if (sel tr.err) { ret res[bool, diag.Refusal].err{tr.err}; }
        if (sel tg.err) { ret res[bool, diag.Refusal].err{tg.err}; }
        val cond: res[bool, diag.Refusal] = topic.yes(l, "conditional", false);
        if (sel cond.err) { ret res[bool, diag.Refusal].err{cond.err}; }
        c.conditional = cond.ok;
        if (!pushed(vector.push[Control](?out.controls, c))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "rule", 2)) {
        val words: err[diag.Refusal] = topic.known(l, ?RULE_NAMES[0], 5);
        if (sel words.err) { ret res[bool, diag.Refusal].err{words.err}; }
        var r:  Rule              = Rule{mnemonic: l.key.data[1], transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, first: Term{arg: "", test: Test.registers{""}}, second: Term{arg: "", test: Test.registers{""}}};
        val tr: err[diag.Refusal] = transfer_of(l, ?r.transfer);
        val tg: err[diag.Refusal] = target_of(l, ?r.target);
        if (sel tr.err) { ret res[bool, diag.Refusal].err{tr.err}; }
        if (sel tg.err) { ret res[bool, diag.Refusal].err{tg.err}; }
        val cond: res[bool, diag.Refusal] = topic.yes(l, "conditional", false);
        if (sel cond.err) { ret res[bool, diag.Refusal].err{cond.err}; }
        r.conditional = cond.ok;
        var first: str               = nil;
        val fg:    err[diag.Refusal] = topic.needed(l, "first", ?first);
        if (sel fg.err) { ret res[bool, diag.Refusal].err{fg.err}; }
        val ft: err[diag.Refusal] = term_of(a, l, first, ?r.first);
        if (sel ft.err) { ret res[bool, diag.Refusal].err{ft.err}; }
        val second: opt[str] = topic.value(?l.ws, "second");
        if (sel second.some) {
            val st: err[diag.Refusal] = term_of(a, l, second.some, ?r.second);
            if (sel st.err) { ret res[bool, diag.Refusal].err{st.err}; }
        }
        if (!pushed(vector.push[Rule](?out.rules, r))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "adjust", 2)) {
        val arg: opt[str] = topic.only(l);
        if (sel arg.none)                                                                            { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        if (!pushed(vector.push[Stack](?out.stacks, Stack{mnemonic: l.key.data[1], arg: arg.some}))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "latency", 2)) {
        val w: opt[str] = topic.only(l);
        if (sel w.none) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        var x: Latency = Latency{mnemonic: l.key.data[1], latency: effect.ONE};
        if (str_equals(w.some, "one"))                        { x.latency = effect.ONE; }
        or (str_equals(w.some, "few"))                        { x.latency = effect.FEW; }
        or (str_equals(w.some, "many"))                       { x.latency = effect.MANY; }
        or (str_equals(w.some, "serial"))                     { x.latency = effect.SERIAL; }
        or                                                    { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, BAD_TRANSFER, w.some)}; }
        if (!pushed(vector.push[Latency](?out.latencies, x))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    ret res[bool, diag.Refusal].ok{false};
}

fun row_line(a: *A.Allocator, l: *topic.Line, out: *Effects, seen: *u8) res[bool, diag.Refusal] {
    if (topic.is(l, "mark", 2)) {
        val words: err[diag.Refusal] = topic.known(l, ?MARK_NAMES[0], 4);
        if (sel words.err) { ret res[bool, diag.Refusal].err{words.err}; }
        var m:     Mark              = Mark{mnemonic: l.key.data[1], specifier: nil, fixup: nil, arg: nil, register: nil};
        var fixup: str               = nil;
        val sg:    err[diag.Refusal] = topic.needed(l, "specifier", ?m.specifier);
        val fg:    err[diag.Refusal] = topic.needed(l, "fixup", ?fixup);
        val ag:    err[diag.Refusal] = topic.needed(l, "arg", ?m.arg);
        val rg:    err[diag.Refusal] = topic.needed(l, "register", ?m.register);
        if (sel sg.err) { ret res[bool, diag.Refusal].err{sg.err}; }
        if (sel fg.err) { ret res[bool, diag.Refusal].err{fg.err}; }
        if (sel ag.err) { ret res[bool, diag.Refusal].err{ag.err}; }
        if (sel rg.err) { ret res[bool, diag.Refusal].err{rg.err}; }
        val path: err[diag.Refusal] = fixup_path(a, l, fixup, ?m.fixup);
        if (sel path.err)                              { ret res[bool, diag.Refusal].err{path.err}; }
        if (!pushed(vector.push[Mark](?out.marks, m))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "fixup", 2)) {
        val w: opt[str] = topic.only(l);
        if (sel w.none) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        var x:    Fixup             = Fixup{mnemonic: l.key.data[1], kind: nil};
        val path: err[diag.Refusal] = fixup_path(a, l, w.some, ?x.kind);
        if (sel path.err)                                { ret res[bool, diag.Refusal].err{path.err}; }
        if (!pushed(vector.push[Fixup](?out.fixups, x))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "split", 2)) {
        val words: err[diag.Refusal] = topic.known(l, ?SPLIT_NAMES[0], 1);
        if (sel words.err) { ret res[bool, diag.Refusal].err{words.err}; }
        var stated: str               = nil;
        val ng:     err[diag.Refusal] = topic.needed(l, "negative", ?stated);
        if (sel ng.err) { ret res[bool, diag.Refusal].err{ng.err}; }
        val negative: res[bool, diag.Refusal] = topic.yes(l, "negative", false);
        if (sel negative.err)                                                                                { ret res[bool, diag.Refusal].err{negative.err}; }
        if (!pushed(vector.push[Split](?out.splits, Split{mnemonic: l.key.data[1], negative: negative.ok}))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "relax", 2)) {
        val words: err[diag.Refusal] = topic.known(l, ?RELAX_NAMES[0], 3);
        if (sel words.err) { ret res[bool, diag.Refusal].err{words.err}; }
        var r:  Relax             = Relax{from: l.key.data[1], to: nil, inverted: false, link: topic.optional(l, "link", "")};
        val tg: err[diag.Refusal] = topic.needed(l, "to", ?r.to);
        if (sel tg.err) { ret res[bool, diag.Refusal].err{tg.err}; }
        val inverted: res[bool, diag.Refusal] = topic.yes(l, "inverted", false);
        if (sel inverted.err) { ret res[bool, diag.Refusal].err{inverted.err}; }
        r.inverted = inverted.ok;
        if (!pushed(vector.push[Relax](?out.relaxes, r))) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "far", 1)) {
        val words: err[diag.Refusal] = topic.known(l, ?FAR_NAMES[0], 2);
        if (sel words.err)    { ret res[bool, diag.Refusal].err{words.err}; }
        if ((@seen & 4) != 0) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.key)}; }
        val rg: err[diag.Refusal] = topic.needed(l, "row", ?out.far);
        val lg: err[diag.Refusal] = topic.needed(l, "link", ?out.far_link);
        if (sel rg.err) { ret res[bool, diag.Refusal].err{rg.err}; }
        if (sel lg.err) { ret res[bool, diag.Refusal].err{lg.err}; }
        @seen = @seen | 4;
        ret res[bool, diag.Refusal].ok{true};
    }
    if (topic.is(l, "fill", 1)) {
        val w: opt[str] = topic.only(l);
        if (sel w.none)       { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        if ((@seen & 8) != 0) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.key)}; }
        val rows: res[vector.Vector[str], diag.Refusal] = topic.words(a, l.fact, w.some);
        if (sel rows.err)     { ret res[bool, diag.Refusal].err{rows.err}; }
        if (rows.ok.len == 0) { ret res[bool, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.fact)}; }
        out.fills = rows.ok;
        @seen     = @seen | 8;
        ret res[bool, diag.Refusal].ok{true};
    }
    ret res[bool, diag.Refusal].ok{false};
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# a kind read by `done`, as a read line
fun flagged(done: err[diag.Refusal]) res[bool, diag.Refusal] {
    if (sel done.err) { ret res[bool, diag.Refusal].err{done.err}; }
    ret res[bool, diag.Refusal].ok{true};
}

# the effects topic `t` read into `out`
pub fun read(a: *A.Allocator, t: *topic.Topic, out: *Effects) err[diag.Refusal] {
    @out = Effects{
        roles:          vector.init[Role](a),
        recasts:        vector.init[Recast](a),
        implicits:      vector.init[Implicit](a),
        uses:           vector.init[Uses](a),
        saved:          vector.init[Saved](a),
        listed:         vector.init[Listed](a),
        configs:        vector.init[State](a),
        floats:         vector.init[State](a),
        fixeds:         vector.init[State](a),
        register_rules: vector.init[RegisterRule](a),
        memories:       vector.init[Memory](a),
        controls:       vector.init[Control](a),
        rules:          vector.init[Rule](a),
        stacks:         vector.init[Stack](a),
        latencies:      vector.init[Latency](a),
        marks:          vector.init[Mark](a),
        fixups:         vector.init[Fixup](a),
        splits:         vector.init[Split](a),
        relaxes:        vector.init[Relax](a),
        fills:          vector.init[str](a),
    };
    val checked: err[diag.Refusal] = topic.check(t, nil, topic.unstated);
    if (sel checked.err) { ret checked; }
    var seen: u8    = 0;
    var i:    usize = 0;
    for (i < t.facts.len) {
        var l:     topic.Line;
        val lined: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel lined.err)  { ret lined; }
        if (l.key.len == 0) { ret topic.reject(?l, topic.BAD_FACT, l.fact.key); }
        val roled: res[bool, diag.Refusal] = roles_line(?l, out, ?seen);
        if (sel roled.err) { ret err[diag.Refusal].err{roled.err}; }
        var taken: bool = roled.ok;
        if (!taken) {
            val accessed: res[bool, diag.Refusal] = access_line(a, ?l, out);
            if (sel accessed.err) { ret err[diag.Refusal].err{accessed.err}; }
            taken = accessed.ok;
        }
        if (!taken) {
            val controlled: res[bool, diag.Refusal] = control_line(a, ?l, out);
            if (sel controlled.err) { ret err[diag.Refusal].err{controlled.err}; }
            taken = controlled.ok;
        }
        if (!taken) {
            val rowed: res[bool, diag.Refusal] = row_line(a, ?l, out, ?seen);
            if (sel rowed.err) { ret err[diag.Refusal].err{rowed.err}; }
            taken = rowed.ok;
        }
        if (!taken) { ret topic.reject(?l, topic.BAD_FACT, l.fact.key); }
        i = i + 1;
    }
    if (seen != 15) { ret err[diag.Refusal].err{diag.refusal(t.path, 0, UNSTATED, nil)}; }
    ret err[diag.Refusal].ok{};
}

#[testing]
#[embed("../../../data/riscv/effects.txt")]
val T_EFFECTS: [_]u8;

#[testing]
fun t_read(a: *A.Allocator, text: *u8, len: usize, out: *Effects) err[diag.Refusal] {
    var f: source.File                    = source.File{path: "effects.txt", data: text, len: len};
    val t: res[topic.Topic, diag.Refusal] = topic.facts(a, ?f);
    if (sel t.err) { ret err[diag.Refusal].err{t.err}; }
    ret read(a, ?t.ok, out);
}

test read__the_effects_keep_their_order_and_read_their_terms_and_fixups {
    # the committed topic takes more allocations than the testing allocator tracks
    var back:  A.Allocator;
    var heap:  arena.Arena;
    var a:     A.Allocator;
    val paged: err[A.Error] = page.make(?back);
    if (sel paged.err) { ret 10; }
    val made: err[A.Error] = arena.init(?heap, ?back, 1 << 22);
    if (sel made.err) { ret 10; }
    fin { arena.dnit(?heap); }
    val bound: err[A.Error] = arena.make(?a, ?heap);
    if (sel bound.err) { ret 10; }
    var e:   Effects;
    val got: err[diag.Refusal] = t_read(?a, ?T_EFFECTS[0], $length_of(T_EFFECTS), ?e);
    if (sel got.err)                                                                              { ret 1; }
    if (e.recasts.len != 40 || e.memories.len != 72 || e.latencies.len != 44 || e.fills.len != 2) { ret 2; }
    if (!str_equals(e.stack_pointer, "x2") || e.undisturbed.role != operand.READ_WRITE)           { ret 3; }
    if (e.implicits.data[2].at != LAST || e.implicits.data[1].at != 1)                            { ret 4; }
    val ret_rule: *Rule = ?e.rules.data[3];
    if (!str_equals(ret_rule.second.arg, "rs1") || ret_rule.transfer != effect.RETURN) { ret 5; }
    if (!sel ret_rule.second.test.registers)                                           { ret 6; }
    if (!str_equals(ret_rule.second.test.registers, "x1 x5"))                          { ret 6; }
    val dynamic: *RegisterRule = ?e.register_rules.data[0];
    if (!sel dynamic.term.test.value)                                                                                                     { ret 7; }
    if (!str_equals(dynamic.term.test.value, "dyn"))                                                                                      { ret 7; }
    if (!str_equals(e.marks.data[1].fixup, "riscv_fixup.TLSDESC_PCREL_CALL") || !str_equals(e.fixups.data[0].kind, "riscv_fixup.LO12_I")) { ret 8; }
    val odd: str               = "rule jal | transfer=call target=direct first=\"rd of x1\" | c | -\nfar | row=jal link=x0 | c | -\n";
    val bad: err[diag.Refusal] = t_read(?a, odd, str_len(odd), ?e);
    if (!(sel bad.err && bad.err.message == BAD_TERM)) { ret 9; }
    ret 0;
}
