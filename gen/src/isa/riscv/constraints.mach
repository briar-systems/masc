# the register constraints and element widths of the vector rows, read from the constraints topic
#
# riscv-opcodes states no constraint between operands and no element width.
# gen/data/riscv/constraints.txt states the forms the manual reserves because
# their operands share registers, the element widths and register groups of
# the vector operands whose rules read them, the mask argument and register,
# and the fields of the vector loads' and stores' encoding the widths are read
# from. every mnemonic is matched as `overlay.matches` reads a pattern,
# arguments are riscv-opcodes' own names, and registers the register file's.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.core.operand;

use gen.diag;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "constraints";

pub val BAD_WIDTH: str = "constraints line states a width that is no number of bits and no power of two of sew";
pub val NO_SPAN:   str = "constraints line states a span that is none of scaled, packed, scalar and whole";
pub val UNSTATED:  str = "constraints topic lacks the masking line or an encoding line";

# a row's argument kept apart from others
# ---
# mnemonic: the rows it applies to
# arg:      the argument kept apart
# against:  the arguments it is kept from, split by spaces, empty when `register` names what it is kept from
# register: the register it is kept from, empty when `against` names arguments
# masked:   whether it holds only while the row's mask argument is v0.t
pub rec Keep {
    mnemonic: str;
    arg:      str;
    against:  str;
    register: str;
    masked:   bool;
}

# how a vector argument's groups cover registers
# ---
# SCALED: EMUL = (EEW/SEW)*LMUL
# PACKED: a mask, one bit per element in one register
# SCALAR: a group of elements from element 0, whatever LMUL
# WHOLE:  2^registers registers whatever the state
pub def Span: u8;

pub val SCALED: Span = 0;
pub val PACKED: Span = 1;
pub val SCALAR: Span = 2;
pub val WHOLE:  Span = 3;

# the element width and register groups of a row's vector argument where they are not SEW and LMUL's
# ---
# mnemonic:  the rows it applies to
# arg:       the argument
# width:     its element width, operand.Element.state or operand.Element.fixed
# span:      how its groups cover registers
# registers: the exponent of the registers a WHOLE group covers, and the elements a SCALAR group holds
pub rec Element {
    mnemonic:  str;
    arg:       str;
    width:     operand.Element;
    span:      Span;
    registers: u8;
}

# a segment load's or store's data operand, which covers one group per field
pub rec Segment {
    mnemonic: str;
    arg:      str;
}

# every fact of the constraints topic
# ---
# mask_arg:      the argument that masks a row by the mask register while it is v0.t
# mask_register: the mask register
# mask_readers:  the rows that read the mask register as a mask whatever their encoding
# load_fp:       the major opcode of the vector loads
# store_fp:      the major opcode of the vector stores
# width_lo:      the low bit of a vector load's or store's width, its EEW
# mop_lo:        the low bit of its addressing mode
# indexed_mop:   the bit of the addressing mode set for an indexed row
# lumop_lo:      the low bit of its unit-stride variant
# whole_lumop:   the variant of a whole register row
# mask_lumop:    the variant of a mask row
pub rec Constraints {
    keeps:         vector.Vector[Keep];
    elements:      vector.Vector[Element];
    mask_arg:      str;
    mask_register: str;
    mask_readers:  vector.Vector[str];
    load_fp:       u64;
    store_fp:      u64;
    width_lo:      u64;
    mop_lo:        u64;
    indexed_mop:   u64;
    lumop_lo:      u64;
    whole_lumop:   u64;
    mask_lumop:    u64;
    segments:      vector.Vector[Segment];
}

val KEEP_NAMES:    [3]str = [3]str{"against", "register", "masked"};
val ELEMENT_NAMES: [4]str = [4]str{"eew", "span", "elements", "registers"};
val MASKING_NAMES: [2]str = [2]str{"arg", "register"};
val OPCODE_NAMES:  [2]str = [2]str{"load", "store"};
val WIDTH_NAMES:   [1]str = [1]str{"lo"};
val MOP_NAMES:     [2]str = [2]str{"lo", "indexed"};
val LUMOP_NAMES:   [3]str = [3]str{"lo", "whole", "mask"};

fun memory(l: *topic.Line) err[diag.Refusal] {
    ret topic.reject(l, diag.MEMORY, nil);
}

# the named value `name` of line `l` as a number
fun numbered(l: *topic.Line, name: str, out: *u64) err[diag.Refusal] {
    var text: str               = nil;
    val got:  err[diag.Refusal] = topic.needed(l, name, ?text);
    if (sel got.err) { ret got; }
    val n: res[i64, diag.Refusal] = topic.number(l.fact, text);
    if (sel n.err) { ret err[diag.Refusal].err{n.err}; }
    if (n.ok < 0)  { ret topic.reject(l, topic.BAD_NUMBER, text); }
    @out = n.ok::u64;
    ret err[diag.Refusal].ok{};
}

# the exponent of `n` when it is a power of two
fun log2(n: i64) opt[u8] {
    if (n <= 0) { ret opt[u8].none{}; }
    var e: u8  = 0;
    var v: i64 = n;
    for (v > 1) {
        if (v % 2 != 0) { ret opt[u8].none{}; }
        v = v / 2;
        e = e + 1;
    }
    ret opt[u8].some{e};
}

# the element width `text` spells: a number of bits, or `sew`, `sew*n` or `sew/n` for a power of two n
fun width(l: *topic.Line, text: str) res[operand.Element, diag.Refusal] {
    val len: usize = str_len(text);
    if (len < 3 || text[0] != 's' || text[1] != 'e' || text[2] != 'w') {
        val n: res[i64, diag.Refusal] = topic.number(l.fact, text);
        if (sel n.err)                 { ret res[operand.Element, diag.Refusal].err{n.err}; }
        if (n.ok < 1 || n.ok > 0xFFFF) { ret res[operand.Element, diag.Refusal].err{topic.refuse(l.fact, BAD_WIDTH, text)}; }
        ret res[operand.Element, diag.Refusal].ok{operand.Element.fixed{n.ok::u16}};
    }
    if (len == 3)                                      { ret res[operand.Element, diag.Refusal].ok{operand.Element.state{0}}; }
    if (len < 5 || (text[3] != '*' && text[3] != '/')) { ret res[operand.Element, diag.Refusal].err{topic.refuse(l.fact, BAD_WIDTH, text)}; }
    val n: res[i64, diag.Refusal] = topic.number(l.fact, ?text[4]);
    if (sel n.err) { ret res[operand.Element, diag.Refusal].err{n.err}; }
    val e: opt[u8] = log2(n.ok);
    if (sel e.none)     { ret res[operand.Element, diag.Refusal].err{topic.refuse(l.fact, BAD_WIDTH, text)}; }
    if (e.some == 0)    { ret res[operand.Element, diag.Refusal].err{topic.refuse(l.fact, BAD_WIDTH, text)}; }
    if (text[3] == '*') { ret res[operand.Element, diag.Refusal].ok{operand.Element.state{e.some::i8}}; }
    ret res[operand.Element, diag.Refusal].ok{operand.Element.state{0 - e.some::i8}};
}

fun keep_line(a: *A.Allocator, l: *topic.Line, out: *Constraints) err[diag.Refusal] {
    val words: err[diag.Refusal] = topic.known(l, ?KEEP_NAMES[0], 3);
    if (sel words.err) { ret words; }
    var k:      Keep                    = Keep{mnemonic: l.key.data[1], arg: l.key.data[2], against: topic.optional(l, "against", ""), register: topic.optional(l, "register", ""), masked: false};
    val masked: res[bool, diag.Refusal] = topic.yes(l, "masked", false);
    if (sel masked.err) { ret err[diag.Refusal].err{masked.err}; }
    k.masked = masked.ok;
    if ((str_len(k.against) == 0) == (str_len(k.register) == 0)) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
    val pushed: res[usize, A.Error] = vector.push[Keep](?out.keeps, k);
    if (sel pushed.err) { ret memory(l); }
    ret err[diag.Refusal].ok{};
}

fun element_line(a: *A.Allocator, l: *topic.Line, out: *Constraints) err[diag.Refusal] {
    val words: err[diag.Refusal] = topic.known(l, ?ELEMENT_NAMES[0], 4);
    if (sel words.err) { ret words; }
    var eew:   str               = nil;
    var spans: str               = nil;
    val e:     err[diag.Refusal] = topic.needed(l, "eew", ?eew);
    val s:     err[diag.Refusal] = topic.needed(l, "span", ?spans);
    if (sel e.err) { ret e; }
    if (sel s.err) { ret s; }
    val w: res[operand.Element, diag.Refusal] = width(l, eew);
    if (sel w.err) { ret err[diag.Refusal].err{w.err}; }
    var x: Element = Element{mnemonic: l.key.data[1], arg: l.key.data[2], width: w.ok, span: SCALED, registers: 0};
    if (str_equals(spans, "scaled")) { x.span = SCALED; }
    or (str_equals(spans, "packed")) { x.span = PACKED; }
    or (str_equals(spans, "scalar")) { x.span = SCALAR; }
    or (str_equals(spans, "whole"))  { x.span = WHOLE; }
    or                               { ret topic.reject(l, NO_SPAN, spans); }
    val elements:  opt[str] = topic.value(?l.ws, "elements");
    val registers: opt[str] = topic.value(?l.ws, "registers");
    var counted:   bool     = false;
    var grouped:   bool     = false;
    if (sel elements.some)                                             { counted = true; }
    if (sel registers.some)                                            { grouped = true; }
    if (counted != (x.span == SCALAR) || grouped != (x.span == WHOLE)) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
    if (sel elements.some) {
        val n: res[i64, diag.Refusal] = topic.number(l.fact, elements.some);
        if (sel n.err)              { ret err[diag.Refusal].err{n.err}; }
        if (n.ok < 1 || n.ok > 255) { ret topic.reject(l, topic.BAD_NUMBER, elements.some); }
        x.registers = n.ok::u8;
    }
    if (sel registers.some) {
        val n: res[i64, diag.Refusal] = topic.number(l.fact, registers.some);
        if (sel n.err) { ret err[diag.Refusal].err{n.err}; }
        val exp: opt[u8] = log2(n.ok);
        if (sel exp.none) { ret topic.reject(l, topic.BAD_NUMBER, registers.some); }
        x.registers = exp.some;
    }
    val pushed: res[usize, A.Error] = vector.push[Element](?out.elements, x);
    if (sel pushed.err) { ret memory(l); }
    ret err[diag.Refusal].ok{};
}

# the encoding line `l`, `seen` gaining its bit
fun encoding_line(l: *topic.Line, out: *Constraints, seen: *u8) err[diag.Refusal] {
    val field: str = l.key.data[1];
    if (str_equals(field, "opcode")) {
        val words: err[diag.Refusal] = topic.known(l, ?OPCODE_NAMES[0], 2);
        if (sel words.err) { ret words; }
        val load: err[diag.Refusal] = numbered(l, "load", ?out.load_fp);
        if (sel load.err) { ret load; }
        @seen = @seen | 2;
        ret numbered(l, "store", ?out.store_fp);
    }
    if (str_equals(field, "width")) {
        val words: err[diag.Refusal] = topic.known(l, ?WIDTH_NAMES[0], 1);
        if (sel words.err) { ret words; }
        @seen = @seen | 4;
        ret numbered(l, "lo", ?out.width_lo);
    }
    if (str_equals(field, "mop")) {
        val words: err[diag.Refusal] = topic.known(l, ?MOP_NAMES[0], 2);
        if (sel words.err) { ret words; }
        val lo: err[diag.Refusal] = numbered(l, "lo", ?out.mop_lo);
        if (sel lo.err) { ret lo; }
        @seen = @seen | 8;
        ret numbered(l, "indexed", ?out.indexed_mop);
    }
    if (str_equals(field, "lumop")) {
        val words: err[diag.Refusal] = topic.known(l, ?LUMOP_NAMES[0], 3);
        if (sel words.err) { ret words; }
        val lo: err[diag.Refusal] = numbered(l, "lo", ?out.lumop_lo);
        if (sel lo.err) { ret lo; }
        val whole: err[diag.Refusal] = numbered(l, "whole", ?out.whole_lumop);
        if (sel whole.err) { ret whole; }
        @seen = @seen | 16;
        ret numbered(l, "mask", ?out.mask_lumop);
    }
    ret topic.reject(l, topic.BAD_FACT, l.fact.key);
}

# the constraints topic `t` read into `out`
pub fun read(a: *A.Allocator, t: *topic.Topic, out: *Constraints) err[diag.Refusal] {
    @out = Constraints{keeps: vector.init[Keep](a), elements: vector.init[Element](a), mask_arg: nil, mask_register: nil, mask_readers: vector.init[str](a), segments: vector.init[Segment](a)};
    val checked: err[diag.Refusal] = topic.check(t, nil, topic.unstated);
    if (sel checked.err) { ret checked; }
    var seen: u8    = 0;
    var i:    usize = 0;
    for (i < t.facts.len) {
        var l:     topic.Line;
        val lined: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel lined.err) { ret lined; }
        var done: err[diag.Refusal] = err[diag.Refusal].ok{};
        if (topic.is(?l, "keep", 3))     { done = keep_line(a, ?l, out); }
        or (topic.is(?l, "element", 3))  { done = element_line(a, ?l, out); }
        or (topic.is(?l, "encoding", 2)) { done = encoding_line(?l, out, ?seen); }
        or (topic.is(?l, "masking", 1)) {
            val words: err[diag.Refusal] = topic.known(?l, ?MASKING_NAMES[0], 2);
            if (sel words.err) { ret words; }
            val arg: err[diag.Refusal] = topic.needed(?l, "arg", ?out.mask_arg);
            if (sel arg.err) { ret arg; }
            done = topic.needed(?l, "register", ?out.mask_register);
            seen = seen | 1;
        }
        or (topic.is(?l, "mask-reader", 2)) {
            val reg: opt[str] = topic.only(?l);
            if (sel reg.none)                                                         { ret topic.reject(?l, topic.BAD_FACT, l.fact.fact); }
            if (out.mask_register == nil || !str_equals(reg.some, out.mask_register)) { ret topic.reject(?l, topic.BAD_FACT, reg.some); }
            val pushed: res[usize, A.Error] = vector.push[str](?out.mask_readers, l.key.data[1]);
            if (sel pushed.err) { ret memory(?l); }
        }
        or (topic.is(?l, "segment", 2)) {
            val arg: opt[str] = topic.only(?l);
            if (sel arg.none) { ret topic.reject(?l, topic.BAD_FACT, l.fact.fact); }
            val pushed: res[usize, A.Error] = vector.push[Segment](?out.segments, Segment{mnemonic: l.key.data[1], arg: arg.some});
            if (sel pushed.err) { ret memory(?l); }
        }
        or                { ret topic.reject(?l, topic.BAD_FACT, l.fact.key); }
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    if (seen != 31) { ret err[diag.Refusal].err{diag.refusal(t.path, 0, UNSTATED, nil)}; }
    ret err[diag.Refusal].ok{};
}

#[testing]
#[embed("../../../data/riscv/constraints.txt")]
val T_CONSTRAINTS: [_]u8;

#[testing]
fun t_read(a: *A.Allocator, text: *u8, len: usize, out: *Constraints) err[diag.Refusal] {
    var f: source.File                    = source.File{path: "constraints.txt", data: text, len: len};
    val t: res[topic.Topic, diag.Refusal] = topic.facts(a, ?f);
    if (sel t.err) { ret err[diag.Refusal].err{t.err}; }
    ret read(a, ?t.ok, out);
}

test read__the_widths_and_spans_are_read_as_the_manual_states_them {
    var tt: testing.Testing;
    testing.make(?tt);
    var c:   Constraints;
    val got: err[diag.Refusal] = t_read(testing.allocator_of(?tt), ?T_CONSTRAINTS[0], $length_of(T_CONSTRAINTS), ?c);
    if (sel got.err)                                              { ret 1; }
    if (c.keeps.len != 32 || c.elements.len != 80)                { ret 2; }
    if (c.width_lo != 12 || c.mask_lumop != 11 || c.load_fp != 7) { ret 3; }
    var i:      usize = 0;
    var halves: u32   = 0;
    var wholes: u32   = 0;
    for (i < c.elements.len) {
        val e: *Element = ?c.elements.data[i];
        if (sel e.width.state) {
            if (e.width.state == -1) { halves = halves + 1; }
        }
        if (e.span == WHOLE && e.registers == 3) { wholes = wholes + 1; }
        i = i + 1;
    }
    if (halves != 2 || wholes != 2) { ret 4; }
    val odd: str               = "element v* vd | eew=sew/3 span=scaled | c | -\n";
    val bad: err[diag.Refusal] = t_read(testing.allocator_of(?tt), odd, str_len(odd), ?c);
    if (!(sel bad.err && bad.err.message == BAD_WIDTH)) { ret 5; }
    ret 0;
}
