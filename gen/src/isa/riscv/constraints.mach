# the reviewed register constraints and element widths the riscv generator adds to riscv-opcodes
#
# riscv-opcodes states no constraint between operands and no element width.
# the forms the manual reserves because their operands share registers are
# here, and the element widths and register groups of the vector operands
# whose rules read them, every table matched by mnemonic as
# `overlay.matches` reads a pattern. facts are from the riscv-isa-manual at
# 36fdac54a526: src/unpriv/vector-common.adoc for the vector extension and
# src/unpriv/zvk.adoc for the vector crypto extensions. arguments are
# riscv-opcodes' own names, and registers the register file's.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use masc.core.constraint;
use masc.core.operand;

# a row's argument kept apart from others
# ---
# mnemonic: the rows it applies to
# arg:      the argument kept apart
# against:  the arguments it is kept from, split by spaces, empty when `register` names what it is kept from
# register: the register it is kept from, empty when `against` names arguments
# masked:   whether it holds only while the row's MASK_ARG is v0.t
pub rec Keep {
    mnemonic: str;
    arg:      str;
    against:  str;
    register: str;
    masked:   bool;
}

# the constraints each instruction states beyond the rules over element widths, every one a reserved encoding when
# broken, and each keeping its argument apart whole
# - "Vector Indexed Segment Loads and Stores": an indexed segment load's destination groups cannot overlap vs2
# - "Vector Integer Add-with-Carry / Subtract-with-Borrow Instructions": vadc's and vsbc's destination is not v0, and
#   "Vector Integer Merge Instructions" and "Vector Floating-Point Merge Instruction" encode vmerge and vfmerge as
#   masked instructions whose destination is no mask, so "Vector Masking" keeps theirs from v0 as well
# - "vmsbf.m", "vmsif.m", "vmsof.m" and "Vector Iota Instruction": the destination cannot overlap the source, and when
#   masked cannot overlap v0. the derived mask rule frees a mask destination, so the first three state their own
# - "Vector Slide-up Instructions" and "Vector Slide-1-up": the destination cannot overlap the source
# - "Vector Register Gather Instructions": the destination cannot overlap any source group
# - "Vector Compress Instruction": the destination cannot overlap the source group or the mask source vs1
# - zvk.adoc, "Instruction Constraints": the .vs rounds' vd cannot overlap their vs2 element group, the sha-2 rounds'
#   and message schedule's vd cannot overlap vs1 or vs2, and sm3's vd cannot overlap vs2
pub val KEEPS_COUNT: u32 = 32;

pub val KEEPS: [KEEPS_COUNT]Keep = [KEEPS_COUNT]Keep{
    Keep{mnemonic: "vluxseg*", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vloxseg*", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vadc.v*m", arg: "vd", against: "", register: "v0", masked: false},
    Keep{mnemonic: "vsbc.v*m", arg: "vd", against: "", register: "v0", masked: false},
    Keep{mnemonic: "vmerge.v*m", arg: "vd", against: "", register: "v0", masked: false},
    Keep{mnemonic: "vfmerge.vfm", arg: "vd", against: "", register: "v0", masked: false},
    Keep{mnemonic: "vmsbf.m", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vmsif.m", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vmsof.m", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "viota.m", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vmsbf.m", arg: "vd", against: "", register: "v0", masked: true},
    Keep{mnemonic: "vmsif.m", arg: "vd", against: "", register: "v0", masked: true},
    Keep{mnemonic: "vmsof.m", arg: "vd", against: "", register: "v0", masked: true},
    Keep{mnemonic: "vslideup.v*", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vslide1up.vx", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vfslide1up.vf", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vrgather.vv", arg: "vd", against: "vs2 vs1", register: "", masked: false},
    Keep{mnemonic: "vrgatherei16.vv", arg: "vd", against: "vs2 vs1", register: "", masked: false},
    Keep{mnemonic: "vrgather.vx", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vrgather.vi", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vcompress.vm", arg: "vd", against: "vs2 vs1", register: "", masked: false},
    Keep{mnemonic: "vaesdf.vs", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vaesdm.vs", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vaesef.vs", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vaesem.vs", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vaesz.vs", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vsm4r.vs", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vsha2ch.vv", arg: "vd", against: "vs1 vs2", register: "", masked: false},
    Keep{mnemonic: "vsha2cl.vv", arg: "vd", against: "vs1 vs2", register: "", masked: false},
    Keep{mnemonic: "vsha2ms.vv", arg: "vd", against: "vs1 vs2", register: "", masked: false},
    Keep{mnemonic: "vsm3me.vv", arg: "vd", against: "vs2", register: "", masked: false},
    Keep{mnemonic: "vsm3c.vi", arg: "vd", against: "vs2", register: "", masked: false},
};

# how a vector argument's groups cover registers, in the overlay's terms
# ---
# SCALED: EMUL = (EEW/SEW)*LMUL, "Vector Operands" (eew_emul)
# PACKED: a mask, one bit per element in one register, "Mask Register Layout" (vreg_mask_lmul_indp)
# SCALAR: a group of elements from element 0, whatever LMUL, as a reduction's scalar ("Vector Reduction Operations",
#         vreduction_scalar_disregard_lmul), a scalar move's (vmv-x-s_vmv-s-x_ignorelmul), each one element, or a .vs
#         crypto round's scalar element group of four (zvk.adoc, veccrypto_vsins_vs2). it covers ceil(EEW/VLEN) or
#         ceil(EGW/VLEN) registers ("Vector Operands", vreg_scalar_emul, and zvk.adoc, "Instruction Constraints"), at
#         the least VLEN the selection admits
# WHOLE:  2^registers registers whatever the state, as vmv<nr>r.v's ("Whole Vector Register Move")
pub def Span: u8;

pub val SCALED: Span = 0;
pub val PACKED: Span = 1;
pub val SCALAR: Span = 2;
pub val WHOLE:  Span = 3;

# the element width and register groups of a row's vector argument where they are not SEW and LMUL's. at most one
# entry matches an argument of a row
# ---
# mnemonic:  the rows it applies to
# arg:       the argument
# width:     its element width, operand.Element.state or operand.Element.fixed
# span:      how its groups cover registers
# registers: the exponent of the registers a WHOLE group covers, and the elements a SCALAR group holds
pub rec Element {
    mnemonic:  str;
    arg:       str;
    width:     operand.Element;
    span:      Span;
    registers: u8;
}

# the vector arguments of other widths, from "Vector Operands" (eew_emul: EEW=SEW and EMUL=LMUL by default)
# - masks, of width 1 ("Vector Operands", vreg_mask_overlap): the compares' destinations ("Vector Integer Compare
#   Instructions", "Vector Floating-Point Compare Instructions"), vmadc's and vmsbc's carry and borrow outs, every
#   operand of the mask logicals ("Vector Mask-Register Logical Instructions"), vcpop.m's and vfirst.m's source,
#   vmsbf.m's, vmsif.m's and vmsof.m's operands, viota.m's source and vcompress.vm's mask vs1
# - widening destinations and the double-width sources of the .w forms, at 2*SEW ("Widening Vector Arithmetic
#   Instructions", "Widening Floating-Point/Integer Type-Convert Instructions")
# - narrowing sources, at 2*SEW ("Narrowing Vector Arithmetic Instructions", "Narrowing Floating-Point/Integer
#   Type-Convert Instructions")
# - integer extension sources, at SEW/2, SEW/4 and SEW/8 ("Vector Integer Extension")
# - the scalar operands of the reductions, at SEW and at 2*SEW for the widening ones ("Vector Reduction Operations"),
#   of the scalar moves ("Integer Scalar Move Instructions", "Floating-Point Scalar Move Instructions") and the .vs
#   crypto rounds' scalar element groups (zvk.adoc)
# - vmv<nr>r.v's groups of NREG registers ("Whole Vector Register Move")
# - vrgatherei16.vv's indices, at 16 ("Vector Register Gather Instructions")
pub val ELEMENTS_COUNT: u32 = 80;

pub val ELEMENTS: [ELEMENTS_COUNT]Element = [ELEMENTS_COUNT]Element{
    Element{mnemonic: "vmseq.*", arg: "vd", width: operand.Element.fixed{1}, span: PACKED, registers: 0},
    Element{mnemonic: "vmsne.*", arg: "vd", width: operand.Element.fixed{1}, span: PACKED, registers: 0},
    Element{mnemonic: "vmsltu.*", arg: "vd", width: operand.Element.fixed{1}, span: PACKED, registers: 0},
