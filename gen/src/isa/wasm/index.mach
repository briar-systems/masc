# the reader of the specification's index of instructions, the table the wasm rows are walked against
#
# the WebAssembly specification generates its appendix's index of instructions from index-instructions.py, one
# `Instruction(version, name, opcode, ...)` call per opcode: the release that added it, its name in the
# specification's notation or None for an opcode it reserves, and its binary opcode as `\hex{..}` bytes joined by
# `~`, a prefix byte followed by its index's u32 in the bytes of its shortest encoding, a reserved run of opcodes
# its first and `\dots`. the reader takes each call's opcode and whether it names an instruction.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use gen.lines;
use gen.source;

pub val FILE: str = "index-instructions.py";

pub val NO_FILE:    str = "source holds no index-instructions.py";
pub val BAD_ENTRY:  str = "index entry holds no opcode of `\\hex{..}` bytes";
pub val LONG_INDEX: str = "index entry's u32 runs past five bytes";

val LEAD: str = "Instruction(";

# one entry of the index
# ---
# prefix: its prefix byte, 0 for a one-byte opcode
# code:   its opcode, or its index under its prefix
# named:  whether it names an instruction, false for an opcode the specification reserves
# line:   where it is
pub rec Entry {
    prefix: u32;
    code:   u32;
    named:  bool;
    line:   lines.Line;
}

# whether `b` is a prefix byte of the index, whose index follows it
pub fun prefixed(b: u32) bool {
    ret b == 0xFB || b == 0xFC || b == 0xFD || b == 0xFE;
}

fun starts(v: View, at: usize, s: str) bool {
    var i: usize = 0;
    for (s[i] != 0) {
        if (at + i >= v.len || v.data[at + i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun hex(c: u8) opt[u32] {
    if (c >= '0' && c <= '9') { ret opt[u32].some{(c - '0')::u32}; }
    if (c >= 'A' && c <= 'F') { ret opt[u32].some{(c - 'A')::u32 + 10}; }
    if (c >= 'a' && c <= 'f') { ret opt[u32].some{(c - 'a')::u32 + 10}; }
    ret opt[u32].none{};
}

# the entry on line `l`, its opcode the first raw string after its name
fun entry(l: *lines.Line) res[Entry, diag.Refusal] {
    val v:  View  = l.text;
    var at: usize = 0;
    for (at < v.len && v.data[at] != ',') { at = at + 1; }
    at = at + 1;
    for (at < v.len && v.data[at] == ' ') { at = at + 1; }
    var e: Entry = Entry{prefix: 0, code: 0, named: true, line: @l};
    if (starts(v, at, "None")) {
        e.named = false;
        at      = at + 4;
    }
    or {
        if (!starts(v, at, "r'")) { ret res[Entry, diag.Refusal].err{lines.refuse(l, BAD_ENTRY, nil)}; }
        at = at + 2;
        for (at < v.len && v.data[at] != '\'') { at = at + 1; }
        at = at + 1;
    }
    for (at < v.len && (v.data[at] == ',' || v.data[at] == ' ')) { at = at + 1; }
    if (!starts(v, at, "r'")) { ret res[Entry, diag.Refusal].err{lines.refuse(l, BAD_ENTRY, nil)}; }
    at = at + 2;
    var bytes: [6]u32;
    var n:     usize = 0;
    for (at < v.len && v.data[at] != '\'') {
        if (v.data[at] == '~') {
            at = at + 1;
            cnt;
        }
        # a reserved run, `\dots` after its first opcode, names nothing past it
        if (!e.named && starts(v, at, " \\dots")) {
            at = at + 6;
            cnt;
        }
        if (!starts(v, at, "\\hex{") || at + 7 >= v.len || v.data[at + 7] != '}') { ret res[Entry, diag.Refusal].err{lines.refuse(l, BAD_ENTRY, nil)}; }
        val hi: opt[u32] = hex(v.data[at + 5]);
        val lo: opt[u32] = hex(v.data[at + 6]);
        if (sel hi.none) { ret res[Entry, diag.Refusal].err{lines.refuse(l, BAD_ENTRY, nil)}; }
        if (sel lo.none) { ret res[Entry, diag.Refusal].err{lines.refuse(l, BAD_ENTRY, nil)}; }
        if (n == 6)      { ret res[Entry, diag.Refusal].err{lines.refuse(l, LONG_INDEX, nil)}; }
        bytes[n] = hi.some * 16 + lo.some;
        n        = n + 1;
        at       = at + 8;
    }
    if (n == 0) { ret res[Entry, diag.Refusal].err{lines.refuse(l, BAD_ENTRY, nil)}; }
    if (n == 1) {
        e.code = bytes[0];
        ret res[Entry, diag.Refusal].ok{e};
    }
    e.prefix = bytes[0];
    var code:  u64   = 0;
    var shift: u32   = 0;
    var k:     usize = 1;
    for (k < n) {
        code  = code | ((bytes[k] & 0x7F)::u64 << shift::u64);
        shift = shift + 7;
        k     = k + 1;
    }
    if (code > 0xFFFF_FFFF) { ret res[Entry, diag.Refusal].err{lines.refuse(l, LONG_INDEX, nil)}; }
    e.code = code::u32;
    ret res[Entry, diag.Refusal].ok{e};
}

# every entry of the index of `tree`, in its order
pub fun read(a: *A.Allocator, tree: *source.Tree, out: *vector.Vector[Entry]) err[diag.Refusal] {
    val file: opt[*source.File] = source.find(tree, FILE);
    if (sel file.none) { ret err[diag.Refusal].err{diag.refusal(nil, 0, NO_FILE, nil)}; }
    ret parse(a, file.some, out);
}

fun parse(a: *A.Allocator, file: *source.File, out: *vector.Vector[Entry]) err[diag.Refusal] {
    val got: res[vector.Vector[lines.Line], diag.Refusal] = lines.read(a, file, '#');
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    @out = vector.init[Entry](a);
    var i: usize = 0;
    for (i < got.ok.len) {
        val l: *lines.Line = ?got.ok.data[i];
        if (starts(l.text, 0, LEAD)) {
            val e: res[Entry, diag.Refusal] = entry(l);
            if (sel e.err) { ret err[diag.Refusal].err{e.err}; }
            val pushed: res[usize, A.Error] = vector.push[Entry](out, e.ok);
            if (sel pushed.err) { ret err[diag.Refusal].err{lines.refuse(l, diag.MEMORY, nil)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}
