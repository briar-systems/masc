# the facts masc states beside opcode.def, read from the topics of gen/data/wasm
#
# immediates names what follows each instruction's opcode, signatures the stack signature of each instruction whose
# type columns do not state it, control each control transfer, structure the instructions that end a block's arm or
# the block, omissions the instructions of opcode.def and of the specification's index that are not rows, and
# features the feature each opcode range requires. each topic is held to opcode.def: a fact naming an instruction it
# lacks, or a signature that restates its columns or overrides other than what they state, is refused naming its
# line.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use masc.core.field;

use gen.diag;
use wasm_opcodes: gen.isa.wasm.opcodes;
use topic:        gen.overlay;
use gen.source;

pub val NO_INSTRUCTION: str = "fact names an instruction opcode.def does not state";
pub val BAD_IMMEDIATE:  str = "immediate is none the topic names";
pub val BAD_ORDER:      str = "order names other than each immediate once";
pub val BAD_TYPE:       str = "stack type is no type name, `<n>`, `$n`, `results` or `...`";
pub val BAD_TRANSFER:   str = "transfer is not jump, call, return or trap";
pub val BAD_TARGET:     str = "target is not none, direct, indirect or depth";
pub val BAD_STRUCTURE:  str = "structure is not else or close";
pub val BAD_RANGE:      str = "opcode is not `0x..`, a prefix and an index, or a range of either";
pub val STATED_TWICE:   str = "fact stated twice";
pub val BAD_PAIR:       str = "paired names other than two optional indices";
pub val BAD_CODE:       str = "type's code is no byte";

# what an immediate is
pub def Kind: u8;

pub val BLOCKTYPE: Kind = 0;
pub val CATCHES:   Kind = 1;
pub val LABELIDX:  Kind = 2;
pub val LABELS:    Kind = 3;
pub val TYPEIDX:   Kind = 4;
pub val TYPEUSE:   Kind = 5;
pub val FUNCIDX:   Kind = 6;
pub val TABLEIDX:  Kind = 7;
pub val MEMIDX:    Kind = 8;
pub val GLOBALIDX: Kind = 9;
pub val LOCALIDX:  Kind = 10;
pub val TAGIDX:    Kind = 11;
pub val DATAIDX:   Kind = 12;
pub val ELEMIDX:   Kind = 13;
pub val VALTYPES:  Kind = 14;
pub val HEAPTYPE:  Kind = 15;
pub val I32:       Kind = 16;
pub val I64:       Kind = 17;
pub val F32:       Kind = 18;
pub val F64:       Kind = 19;
pub val V128:      Kind = 20;
pub val LANE:      Kind = 21;
pub val LANES:     Kind = 22;
pub val ZERO:      Kind = 23;

# the topic's word for each kind, by its value
val KIND_NAMES: [24]str = [24]str{"blocktype", "catches", "labelidx", "labels", "typeidx", "typeuse", "funcidx", "tableidx", "memidx", "globalidx", "localidx", "tagidx", "dataidx", "elemidx", "valtypes", "heaptype", "i32", "i64", "f32", "f64", "v128", "lane", "lanes", "zero"};

# one immediate
# ---
# kind:     what it is
# optional: whether the text may leave it out, an index that then reads as 0
pub rec Immediate {
    kind:     Kind;
    optional: bool;
}

# what follows an instruction's opcode
# ---
# immediates: its immediates, in binary order
# order:      the immediates in the order the text spells them, by their binary position, empty for binary order
# paired:     whether its two optional indices are one pair the text gives both of or neither
pub rec Immediates {
    immediates: vector.Vector[Immediate];
    order:      vector.Vector[u8];
    paired:     bool;
}

# a stack type of a signature, as masc.core.effect's TypeRef reads it
# ---
# FIXED:       the type named `name`
# VARIABLE:    type variable `n`
# OPERAND:     the types operand `n` states
# RESULTS:     the function's results
# POLYMORPHIC: any sequence of types
pub def Ref: u8;

pub val FIXED:       Ref = 0;
pub val VARIABLE:    Ref = 1;
pub val OPERAND:     Ref = 2;
pub val RESULTS:     Ref = 3;
pub val POLYMORPHIC: Ref = 4;

# one stack type
pub rec Type {
    ref:  Ref;
    n:    u8;
    name: str;
}

# a stated signature, its types deepest first
pub rec Signature {
    pops:   vector.Vector[Type];
    pushes: vector.Vector[Type];
}

# a control transfer of a row
# ---
# transfer:    its transfer, as the constant the rows spell
# target:      its target, as the constant the rows spell
# operand:     the operand holding its target, field.NO_OPERAND for none
# conditional: whether it may fall through instead
pub rec Control {
    transfer:    str;
    target:      str;
    operand:     u8;
    conditional: bool;
}

# what a structured instruction does to the block the stream holds open
pub def Structure: u8;

pub val NONE:  Structure = 0;
pub val OPEN:  Structure = 1;
pub val ELSE:  Structure = 2;
pub val CLOSE: Structure = 3;

# opcodes from `lo` to `hi` under prefix `prefix`, 0 for one-byte opcodes
pub rec Range {
    prefix: u32;
    lo:     u32;
    hi:     u32;
}

# the features an opcode range requires, every one of them
pub rec Feature {
    range:    Range;
    features: vector.Vector[str];
    line:     topic.Line;
}

# what the topics state
# ---
# immediates: what follows each instruction's opcode, by its name
# signatures: each stated signature, by its name
# controls:   each control transfer, by its name
# structures: each instruction that ends an arm or a block, by its name
# omitted:    each instruction of opcode.def that is no row, by its name
# unrowed:    the opcodes the index names that no row is
# unindexed:  the prefixes whose rows the index does not name
# features:   the features of each opcode range, in their order
# types:      the value types by name, in their order
# heaps:      the abstract heap types by name, in their order
pub rec Facts {
    immediates: map.Map[str, Immediates];
    signatures: map.Map[str, Signature];
    controls:   map.Map[str, Control];
    structures: map.Map[str, Structure];
    omitted:    map.Map[str, bool];
    unrowed:    vector.Vector[Range];
    unindexed:  vector.Vector[u32];
    features:   vector.Vector[Feature];
    types:      vector.Vector[Named];
    heaps:      vector.Vector[Named];
}

# a type's text name, the byte its binary spells it by and the features it requires, every one of them, none for
# wasm 1.0's
pub rec Named {
    name:     str;
    code:     u32;
    features: vector.Vector[str];
    line:     topic.Line;
}

fun memory() diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, nil);
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# the topic `name` of `tree` held to opcode.def by `stated`, its facts read as lines into `out`
fun lines_of(a: *A.Allocator, tree: *source.Tree, name: str, ops: *wasm_opcodes.Opcodes, stated: topic.Stated, out: *vector.Vector[topic.Line]) err[diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, name);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, ops::ptr, stated);
    if (sel checked.err) { ret checked; }
    @out = vector.init[topic.Line](a);
    var i: usize = 0;
    for (i < t.facts.len) {
        var l:    topic.Line;
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err)                             { ret read; }
        if (!pushed(vector.push[topic.Line](out, l))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the instruction line `l` names by the second word of its key, refused when opcode.def has none
fun instruction(l: *topic.Line, kind: str, ops: *wasm_opcodes.Opcodes) res[*wasm_opcodes.Opcode, diag.Refusal] {
    if (!topic.is(l, kind, 2)) { ret res[*wasm_opcodes.Opcode, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.key)}; }
    val o: opt[*wasm_opcodes.Opcode] = wasm_opcodes.named(ops, l.key.data[1]);
    if (sel o.none) { ret res[*wasm_opcodes.Opcode, diag.Refusal].err{topic.refuse(l.fact, NO_INSTRUCTION, l.key.data[1])}; }
    ret res[*wasm_opcodes.Opcode, diag.Refusal].ok{o.some};
}

# the type columns of the instruction a signature names, what opcode.def states of its signature
fun columns_stated(ctx: ptr, f: *topic.Fact) opt[str] {
    val ops: *wasm_opcodes.Opcodes = ctx::*wasm_opcodes.Opcodes;
    var at:  usize                 = 0;
    for (f.key[at] != 0 && f.key[at] != ' ') { at = at + 1; }
    if (f.key[at] == 0) { ret opt[str].none{}; }
    val o: opt[*wasm_opcodes.Opcode] = wasm_opcodes.named(ops, ?f.key[at + 1]);
    if (sel o.none) { ret opt[str].none{}; }
    ret opt[str].some{wasm_opcodes.columns(ops.alloc, o.some)};
}

fun kind_named(word: str) opt[Kind] {
    var k: u32 = 0;
    for (k < 24) {
        if (str_equals(word, KIND_NAMES[k])) { ret opt[Kind].some{k::Kind}; }
        k = k + 1;
    }
    ret opt[Kind].none{};
}

# the immediate `word` names, a trailing `?` making it optional
fun immediate_of(a: *A.Allocator, l: *topic.Line, word: str) res[Immediate, diag.Refusal] {
    var len: usize = 0;
    for (word[len] != 0) { len = len + 1; }
    var im: Immediate = Immediate{kind: 0, optional: false};
    var w:  str       = word;
    if (len > 1 && word[len - 1] == '?') {
        im.optional = true;
        val cut: res[*u8, A.Error] = A.allocate[u8](a, len);
        if (sel cut.err) { ret res[Immediate, diag.Refusal].err{memory()}; }
        var i: usize = 0;
        for (i < len - 1) {
            cut.ok[i] = word[i];
            i         = i + 1;
        }
        cut.ok[len - 1] = 0;
        w               = cut.ok;
    }
    val k: opt[Kind] = kind_named(w);
    if (sel k.none) { ret res[Immediate, diag.Refusal].err{topic.refuse(l.fact, BAD_IMMEDIATE, word)}; }
    im.kind = k.some;
    ret res[Immediate, diag.Refusal].ok{im};
}

# the text order `text` states over `count` immediates, each once
fun order_of(l: *topic.Line, text: str, count: usize, out: *vector.Vector[u8]) err[diag.Refusal] {
    var seen: [16]bool;
    var k:    usize = 0;
    for (k < 16) {
        seen[k] = false;
        k       = k + 1;
    }
    var at: usize = 0;
    for {
        var n:      usize = 0;
        var digits: usize = 0;
        for (text[at] >= '0' && text[at] <= '9') {
            n      = n * 10 + (text[at] - '0')::usize;
            at     = at + 1;
            digits = digits + 1;
        }
        if (digits == 0 || n >= count || n >= 16 || seen[n]) { ret topic.reject(l, BAD_ORDER, text); }
        seen[n] = true;
        vector.push[u8](out, n::u8);
        if (text[at] == 0)   { brk; }
        if (text[at] != ',') { ret topic.reject(l, BAD_ORDER, text); }
        at = at + 1;
    }
    if (out.len != count) { ret topic.reject(l, BAD_ORDER, text); }
    ret err[diag.Refusal].ok{};
}

fun immediates(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line];
    val read: err[diag.Refusal] = lines_of(a, tree, "immediates", ops, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line                             = ?ls.data[i];
        val o: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "imm", ops);
        if (sel o.err) { ret err[diag.Refusal].err{o.err}; }
        var x:     Immediates = Immediates{immediates: vector.init[Immediate](a), order: vector.init[u8](a), paired: false};
        var order: str        = nil;
        var k:     usize      = 0;
        for (k < l.ws.len) {
            val w: str = l.ws.data[k];
            if (w[0] == 'o' && w[1] == 'r' && w[2] == 'd' && w[3] == 'e' && w[4] == 'r' && w[5] == '=') { order = ?w[6]; }
            or (str_equals(w, "paired=yes"))                                                            { x.paired = true; }
            or {
                val im: res[Immediate, diag.Refusal] = immediate_of(a, l, w);
                if (sel im.err) { ret err[diag.Refusal].err{im.err}; }
                vector.push[Immediate](?x.immediates, im.ok);
            }
            k = k + 1;
        }
        if (order != nil) {
            val held: err[diag.Refusal] = order_of(l, order, x.immediates.len, ?x.order);
            if (sel held.err) { ret held; }
        }
        if (x.paired && !(x.immediates.len == 2 && x.immediates.data[0].optional && x.immediates.data[1].optional)) { ret topic.reject(l, BAD_PAIR, o.ok.name); }
        var key:   str              = o.ok.name;
        val prior: opt[*Immediates] = map.get[str, Immediates](?out.immediates, ?key);
        if (sel prior.some) { ret topic.reject(l, STATED_TWICE, o.ok.name); }
        val put: res[bool, A.Error] = map.insert[str, Immediates](?out.immediates, o.ok.name, x);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the stack types `text` spells, split on spaces
fun types_of(a: *A.Allocator, l: *topic.Line, text: str, out: *vector.Vector[Type]) err[diag.Refusal] {
    @out = vector.init[Type](a);
    var at: usize = 0;
    for {
        for (text[at] == ' ') { at = at + 1; }
        if (text[at] == 0) { brk; }
        var end: usize = at;
        for (text[end] != 0 && text[end] != ' ') { end = end + 1; }
        val len: usize = end - at;
        var t:   Type  = Type{ref: FIXED, n: 0, name: nil};
        if (len == 3 && text[at] == '.' && text[at + 1] == '.' && text[at + 2] == '.')                        { t.ref = POLYMORPHIC; }
        or (len == 7 && text[at] == 'r' && text[at + 1] == 'e' && text[at + 2] == 's' && text[at + 6] == 's') { t.ref = RESULTS; }
        or ((text[at] == '<' && text[end - 1] == '>' && len > 2) || (text[at] == '$' && len > 1)) {
            t.ref = VARIABLE;
            var from: usize = at + 1;
            var to:   usize = end;
            if (text[at] == '<') {
                t.ref = OPERAND;
                to    = end - 1;
            }
            var n: u32   = 0;
            var k: usize = from;
            for (k < to) {
                if (text[k] < '0' || text[k] > '9' || n > 15) { ret topic.reject(l, BAD_TYPE, text); }
                n = n * 10 + (text[k] - '0')::u32;
                k = k + 1;
            }
            if (n > 15) { ret topic.reject(l, BAD_TYPE, text); }
            t.n = n::u8;
        }
        or {
            val name: res[*u8, A.Error] = A.allocate[u8](a, len + 1);
            if (sel name.err) { ret err[diag.Refusal].err{memory()}; }
            var k: usize = 0;
            for (k < len) {
                name.ok[k] = text[at + k];
                k          = k + 1;
            }
            name.ok[len] = 0;
            t.name       = name.ok;
        }
        vector.push[Type](out, t);
        at = end;
    }
    ret err[diag.Refusal].ok{};
}

fun signatures(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line];
    val read: err[diag.Refusal] = lines_of(a, tree, "signatures", ops, columns_stated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line                             = ?ls.data[i];
        val o: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "sig", ops);
        if (sel o.err) { ret err[diag.Refusal].err{o.err}; }
        var pops:   str               = nil;
        var pushes: str               = nil;
        val p1:     err[diag.Refusal] = topic.needed(l, "pops", ?pops);
        if (sel p1.err) { ret p1; }
        val p2: err[diag.Refusal] = topic.needed(l, "pushes", ?pushes);
        if (sel p2.err) { ret p2; }
        var s:  Signature;
        val t1: err[diag.Refusal] = types_of(a, l, pops, ?s.pops);
        if (sel t1.err) { ret t1; }
        val t2: err[diag.Refusal] = types_of(a, l, pushes, ?s.pushes);
        if (sel t2.err) { ret t2; }
        var key:   str             = o.ok.name;
        val prior: opt[*Signature] = map.get[str, Signature](?out.signatures, ?key);
        if (sel prior.some) { ret topic.reject(l, STATED_TWICE, o.ok.name); }
        val put: res[bool, A.Error] = map.insert[str, Signature](?out.signatures, o.ok.name, s);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun transfer_of(word: str) str {
    if (str_equals(word, "jump"))   { ret "effect.JUMP"; }
    if (str_equals(word, "call"))   { ret "effect.CALL"; }
    if (str_equals(word, "return")) { ret "effect.RETURN"; }
    if (str_equals(word, "trap"))   { ret "effect.TRAP"; }
    ret nil;
}

fun target_of(word: str) str {
    if (str_equals(word, "none"))     { ret "effect.UNTARGETED"; }
    if (str_equals(word, "direct"))   { ret "effect.DIRECT"; }
    if (str_equals(word, "indirect")) { ret "effect.INDIRECT"; }
    if (str_equals(word, "depth"))    { ret "effect.DEPTH"; }
    ret nil;
}

fun controls(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line];
    val read: err[diag.Refusal] = lines_of(a, tree, "control", ops, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line                             = ?ls.data[i];
        val o: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "control", ops);
        if (sel o.err) { ret err[diag.Refusal].err{o.err}; }
        var transfer: str               = nil;
        var target:   str               = nil;
        val t1:       err[diag.Refusal] = topic.needed(l, "transfer", ?transfer);
        if (sel t1.err) { ret t1; }
        val t2: err[diag.Refusal] = topic.needed(l, "target", ?target);
        if (sel t2.err) { ret t2; }
        var c: Control = Control{transfer: transfer_of(transfer), target: target_of(target), operand: field.NO_OPERAND, conditional: false};
        if (c.transfer == nil) { ret topic.reject(l, BAD_TRANSFER, transfer); }
        if (c.target == nil)   { ret topic.reject(l, BAD_TARGET, target); }
        val arg: str = topic.optional(l, "arg", nil);
        if (arg != nil) {
            val n: res[i64, diag.Refusal] = topic.number(l.fact, arg);
            if (sel n.err)             { ret err[diag.Refusal].err{n.err}; }
            if (n.ok < 0 || n.ok > 15) { ret topic.reject(l, topic.BAD_NUMBER, arg); }
            c.operand = n.ok::u8;
        }
        val cond: res[bool, diag.Refusal] = topic.yes(l, "conditional", false);
        if (sel cond.err) { ret err[diag.Refusal].err{cond.err}; }
        c.conditional = cond.ok;
        var key:   str           = o.ok.name;
        val prior: opt[*Control] = map.get[str, Control](?out.controls, ?key);
        if (sel prior.some) { ret topic.reject(l, STATED_TWICE, o.ok.name); }
        val put: res[bool, A.Error] = map.insert[str, Control](?out.controls, o.ok.name, c);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun structures(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line];
    val read: err[diag.Refusal] = lines_of(a, tree, "structure", ops, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line                             = ?ls.data[i];
        val o: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "structure", ops);
        if (sel o.err) { ret err[diag.Refusal].err{o.err}; }
        val word: opt[str]  = topic.only(l);
        var s:    Structure = NONE;
        if (sel word.some && str_equals(word.some, "else"))  { s = ELSE; }
        if (sel word.some && str_equals(word.some, "close")) { s = CLOSE; }
        if (s == NONE)                                       { ret topic.reject(l, BAD_STRUCTURE, l.fact.fact); }
        var key:   str             = o.ok.name;
        val prior: opt[*Structure] = map.get[str, Structure](?out.structures, ?key);
        if (sel prior.some) { ret topic.reject(l, STATED_TWICE, o.ok.name); }
        val put: res[bool, A.Error] = map.insert[str, Structure](?out.structures, o.ok.name, s);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the number `word` spells as a byte or an index, refused past u32
fun code_of(l: *topic.Line, word: str) res[u32, diag.Refusal] {
    val n: res[i64, diag.Refusal] = topic.number(l.fact, word);
    if (sel n.err)                      { ret res[u32, diag.Refusal].err{n.err}; }
    if (n.ok < 0 || n.ok > 0xFFFF_FFFF) { ret res[u32, diag.Refusal].err{topic.refuse(l.fact, BAD_RANGE, word)}; }
    ret res[u32, diag.Refusal].ok{n.ok::u32};
}

# the range words `from` on of the key of `l` state: `0x..`, `lo-hi`, or a prefix before either
fun range_of(a: *A.Allocator, l: *topic.Line) res[Range, diag.Refusal] {
    var r:    Range = Range{prefix: 0, lo: 0, hi: 0};
    var span: str   = nil;
    if (l.key.len == 2) { span = l.key.data[1]; }
    or (l.key.len == 3) {
        val p: res[u32, diag.Refusal] = code_of(l, l.key.data[1]);
        if (sel p.err) { ret res[Range, diag.Refusal].err{p.err}; }
        r.prefix = p.ok;
        span     = l.key.data[2];
    }
    or { ret res[Range, diag.Refusal].err{topic.refuse(l.fact, BAD_RANGE, l.fact.key)}; }
    var dash: usize = 0;
    for (span[dash] != 0 && span[dash] != '-') { dash = dash + 1; }
    if (span[dash] == 0) {
        val one: res[u32, diag.Refusal] = code_of(l, span);
        if (sel one.err) { ret res[Range, diag.Refusal].err{one.err}; }
        r.lo = one.ok;
        r.hi = one.ok;
        ret res[Range, diag.Refusal].ok{r};
    }
    val head: res[*u8, A.Error] = A.allocate[u8](a, dash + 1);
    if (sel head.err) { ret res[Range, diag.Refusal].err{memory()}; }
    var k: usize = 0;
    for (k < dash) {
        head.ok[k] = span[k];
        k          = k + 1;
    }
    head.ok[dash] = 0;
    val lo: res[u32, diag.Refusal] = code_of(l, head.ok);
    val hi: res[u32, diag.Refusal] = code_of(l, ?span[dash + 1]);
    if (sel lo.err)    { ret res[Range, diag.Refusal].err{lo.err}; }
    if (sel hi.err)    { ret res[Range, diag.Refusal].err{hi.err}; }
    if (hi.ok < lo.ok) { ret res[Range, diag.Refusal].err{topic.refuse(l.fact, BAD_RANGE, span)}; }
    r.lo = lo.ok;
    r.hi = hi.ok;
    ret res[Range, diag.Refusal].ok{r};
}

fun omissions(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line];
    val read: err[diag.Refusal] = lines_of(a, tree, "omissions", ops, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (l.key.len > 0 && str_equals(l.key.data[0], "omit")) {
            val o: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "omit", ops);
            if (sel o.err) { ret err[diag.Refusal].err{o.err}; }
            var key:   str        = o.ok.name;
            val prior: opt[*bool] = map.get[str, bool](?out.omitted, ?key);
            if (sel prior.some) { ret topic.reject(l, STATED_TWICE, o.ok.name); }
            val put: res[bool, A.Error] = map.insert[str, bool](?out.omitted, o.ok.name, true);
            if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        }
        or (l.key.len > 0 && str_equals(l.key.data[0], "unrowed")) {
            val r: res[Range, diag.Refusal] = range_of(a, l);
            if (sel r.err) { ret err[diag.Refusal].err{r.err}; }
            vector.push[Range](?out.unrowed, r.ok);
        }
        or (topic.is(l, "unindexed", 2)) {
            val p: res[u32, diag.Refusal] = code_of(l, l.key.data[1]);
            if (sel p.err) { ret err[diag.Refusal].err{p.err}; }
            vector.push[u32](?out.unindexed, p.ok);
        }
        or { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun features(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line];
    val read: err[diag.Refusal] = lines_of(a, tree, "features", ops, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (l.key.len == 0 || !str_equals(l.key.data[0], "feature")) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val r: res[Range, diag.Refusal] = range_of(a, l);
        if (sel r.err) { ret err[diag.Refusal].err{r.err}; }
        vector.push[Feature](?out.features, Feature{range: r.ok, features: l.ws, line: @l});
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# every topic of the data tree `tree`, held to opcode.def `ops`
pub fun read(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    @out = Facts{
        immediates: map.init[str, Immediates](a),
        signatures: map.init[str, Signature](a),
        controls:   map.init[str, Control](a),
        structures: map.init[str, Structure](a),
        omitted:    map.init[str, bool](a),
        unrowed:    vector.init[Range](a),
        unindexed:  vector.init[u32](a),
        features:   vector.init[Feature](a),
        types:      vector.init[Named](a),
        heaps:      vector.init[Named](a),
    };
    val im: err[diag.Refusal] = immediates(a, tree, ops, out);
    if (sel im.err) { ret im; }
    val sg: err[diag.Refusal] = signatures(a, tree, ops, out);
    if (sel sg.err) { ret sg; }
    val ct: err[diag.Refusal] = controls(a, tree, ops, out);
    if (sel ct.err) { ret ct; }
    val st: err[diag.Refusal] = structures(a, tree, ops, out);
    if (sel st.err) { ret st; }
    val om: err[diag.Refusal] = omissions(a, tree, ops, out);
    if (sel om.err) { ret om; }
    val ft: err[diag.Refusal] = features(a, tree, ops, out);
    if (sel ft.err) { ret ft; }
    ret types(a, tree, ops, out);
}

# whether `name` is held by `list`
fun held(list: *vector.Vector[Named], name: str) bool {
    var i: usize = 0;
    for (i < list.len) {
        if (str_equals(list.data[i].name, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun types(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line];
    val read: err[diag.Refusal] = lines_of(a, tree, "types", ops, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l:    *topic.Line           = ?ls.data[i];
        var into: *vector.Vector[Named] = ?out.types;
        if (topic.is(l, "heap", 2))  { into = ?out.heaps; }
        or (!topic.is(l, "type", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        if (l.ws.len == 0)           { ret topic.reject(l, BAD_CODE, l.fact.fact); }
        val word: str                    = l.ws.data[0];
        val code: res[i64, diag.Refusal] = topic.number(l.fact, word);
        if (sel code.err)                  { ret err[diag.Refusal].err{code.err}; }
        if (code.ok < 0 || code.ok > 0xFF) { ret topic.reject(l, BAD_CODE, word); }
        if (held(into, l.key.data[1]))     { ret topic.reject(l, STATED_TWICE, l.key.data[1]); }
        var features: vector.Vector[str] = vector.init[str](a);
        var k:        usize              = 1;
        for (k < l.ws.len) {
            vector.push[str](?features, l.ws.data[k]);
            k = k + 1;
        }
        vector.push[Named](into, Named{name: l.key.data[1], code: code.ok::u32, features: features, line: @l});
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the code of the value type named `name`, none for a name no line states
pub fun type_code(x: *Facts, name: str) opt[u32] {
    var i: usize = 0;
    for (i < x.types.len) {
        if (str_equals(x.types.data[i].name, name)) { ret opt[u32].some{x.types.data[i].code}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# whether opcode `code` under prefix `prefix` lies in `r`
pub fun within(r: *Range, prefix: u32, code: u32) bool {
    ret r.prefix == prefix && code >= r.lo && code <= r.hi;
}
