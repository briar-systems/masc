# the facts masc states beside opcode.def, read from the topics of gen/data/wasm
#
# immediates names what follows each instruction's opcode, signatures the stack signature of each instruction whose
# type columns do not state it, control each control transfer, structure the instructions that end a block's arm or
# the block and the blocks a loop or catches label, access the memory, table and segment accesses and the index space
# entries each instruction makes, omissions the instructions of opcode.def and of the specification's index that are
# not rows, and features the feature each opcode range requires. each topic is held to opcode.def: a fact naming an
# instruction it lacks, or a signature that restates its columns or overrides other than what they state, is refused
# naming its line.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use masc.core.effect;
use masc.core.field;

use gen.control;
use gen.diag;
use wasm_opcodes: gen.isa.wasm.opcodes;
use gen_order:    gen.order;
use topic:        gen.overlay;
use gen.source;

pub val NO_INSTRUCTION: str = "fact names an instruction opcode.def does not state";
pub val BAD_IMMEDIATE:  str = "immediate is none the topic names";
pub val BAD_ORDER:      str = "order names other than each immediate once";
pub val BAD_TYPE:       str = "stack type is no type name, `<n>`, `<n>-`, `$n`, `results` or `...`";
pub val BAD_TRANSFER:   str = "transfer is not jump, call, return or trap";
pub val BAD_TARGET:     str = "target is not none, direct, indirect, depth, structured, caught or function";
pub val BAD_STRUCTURE:  str = "structure is not else, close, loop or catch";
pub val BAD_ROLE:       str = "access or entry names no role of read, write or both, or one twice";
pub val BAD_RANGE:      str = "opcode is not `0x..`, a prefix and an index, or a range of either";
pub val STATED_TWICE:   str = "fact stated twice";
pub val BAD_PAIR:       str = "paired names other than two optional indices";
pub val BAD_CODE:       str = "type's code is no byte";

# what an immediate is
pub def Kind: u8;

pub val BLOCKTYPE: Kind = 0;
pub val CATCHES:   Kind = 1;
pub val LABELIDX:  Kind = 2;
pub val LABELS:    Kind = 3;
pub val TYPEIDX:   Kind = 4;
pub val TYPEUSE:   Kind = 5;
pub val FUNCIDX:   Kind = 6;
pub val TABLEIDX:  Kind = 7;
pub val MEMIDX:    Kind = 8;
pub val GLOBALIDX: Kind = 9;
pub val LOCALIDX:  Kind = 10;
pub val TAGIDX:    Kind = 11;
pub val DATAIDX:   Kind = 12;
pub val ELEMIDX:   Kind = 13;
pub val VALTYPES:  Kind = 14;
pub val HEAPTYPE:  Kind = 15;
pub val I32:       Kind = 16;
pub val I64:       Kind = 17;
pub val F32:       Kind = 18;
pub val F64:       Kind = 19;
pub val V128:      Kind = 20;
pub val LANE:      Kind = 21;
pub val LANES:     Kind = 22;
pub val ZERO:      Kind = 23;

# the topic's word for each kind, by its value
val KIND_NAMES: [24]str = [24]str{"blocktype", "catches", "labelidx", "labels", "typeidx", "typeuse", "funcidx", "tableidx", "memidx", "globalidx", "localidx", "tagidx", "dataidx", "elemidx", "valtypes", "heaptype", "i32", "i64", "f32", "f64", "v128", "lane", "lanes", "zero"};

# one immediate
# ---
# kind:     what it is
# optional: whether the text may leave it out, an index that then reads as 0
pub rec Immediate {
    kind:     Kind;
    optional: bool;
}

# what follows an instruction's opcode
# ---
# immediates: its immediates, in binary order
# order:      the immediates in the order the text spells them, by their binary position, empty for binary order
# paired:     whether its two optional indices are one pair the text gives both of or neither
pub rec Immediates {
    immediates: vector.Vector[Immediate];
    order:      vector.Vector[u8];
    paired:     bool;
}

# a stack type of a signature, as masc.core.effect's TypeRef reads it
# ---
# FIXED:       the type named `name`
# VARIABLE:    type variable `n`
# OPERAND:     the types operand `n` states
# LESS:        the types operand `n` states but the last
# RESULTS:     the function's results
# POLYMORPHIC: any sequence of types
pub def Ref: u8;

pub val FIXED:       Ref = 0;
pub val VARIABLE:    Ref = 1;
pub val OPERAND:     Ref = 2;
pub val RESULTS:     Ref = 3;
pub val POLYMORPHIC: Ref = 4;
pub val LESS:        Ref = 5;

# one stack type
pub rec Type {
    ref:  Ref;
    n:    u8;
    name: str;
}

# a stated signature, its types deepest first
pub rec Signature {
    pops:   vector.Vector[Type];
    pushes: vector.Vector[Type];
}

# a control transfer of a row
# ---
# transfer:    its transfer, as the constant the rows spell
# target:      its target, as the constant the rows spell
# operand:     the operand holding its target, field.NO_OPERAND for none
# conditional: whether it may fall through instead
# condition:   the popped value deciding whether it is taken, by its depth from the top plus one, 0 for none
# chooses:     the popped value choosing its target, by its depth from the top plus one, 0 for none
pub rec Control {
    transfer:    str;
    target:      str;
    operand:     u8;
    conditional: bool;
    condition:   u8;
    chooses:     u8;
}

# what a structured instruction does to the block the stream holds open: nothing, open a block labelled at its end,
# end its first arm, close it, open a block labelled at its start, or open a block labelled at its end whose catches
# take control to labels
pub def Structure: u8;

pub val NONE:  Structure = 0;
pub val OPEN:  Structure = 1;
pub val ELSE:  Structure = 2;
pub val CLOSE: Structure = 3;
pub val LOOP:  Structure = 4;
pub val CATCH: Structure = 5;

# an access an instruction makes beyond its operands
# ---
# role:  read, write or both, as the constant the rows spell
# pop:   the popped value that is its address, by its depth from the top
# count: the popped value that is its count of elements, by its depth from the top, NO_POP for one element
# bits:  the bits of one element, 0 for an element whose width the set does not state, as a table's reference
pub rec Access {
    role:  str;
    pop:   u8;
    count: u8;
    bits:  u32;
}

pub val NO_POP: u8 = 0xFF;

# the accesses of the memory instructions of a range of opcodes, each its memarg's address and width
pub rec Memarg {
    range: Range;
    role:  str;
    line:  topic.Line;
}

# an index space entry an instruction reads or writes through its operand
# ---
# operand: the operand naming it
# role:    read, write or both, as the constant the rows spell
pub rec Entry {
    operand: u8;
    role:    str;
}

# opcodes from `lo` to `hi` under prefix `prefix`, 0 for one-byte opcodes
pub rec Range {
    prefix: u32;
    lo:     u32;
    hi:     u32;
}

# the order fact of the instructions of a range of opcodes (gen.order)
pub rec Order {
    range:  Range;
    stated: gen_order.Stated;
    line:   topic.Line;
}

# the features an opcode range requires, every one of them
pub rec Feature {
    range:    Range;
    features: vector.Vector[str];
    line:     topic.Line;
}

# what the topics state
# ---
# immediates: what follows each instruction's opcode, by its name
# signatures: each stated signature, by its name
# controls:   each control transfer, by its name
# structures: each instruction that ends an arm or a block, by its name
# accesses:   the accesses each instruction with no memarg makes, by its name
# memargs:    the accesses of each range of memory instructions, in their order
# orders:     the order facts of each range of instructions, in their order
# ordered:    the ranges of instructions that must state an order
# entries:    the index space entries each instruction reads and writes, by its name
# omitted:    each instruction of opcode.def that is no row, by its name
# unrowed:    the opcodes the index names that no row is
# unindexed:  the prefixes whose rows the index does not name
# features:   the features of each opcode range, in their order
# types:      the value types by name, in their order
# heaps:      the abstract heap types by name, in their order
pub rec Facts {
    immediates: map.Map[str, Immediates];
    signatures: map.Map[str, Signature];
    controls:   map.Map[str, Control];
    structures: map.Map[str, Structure];
    accesses:   map.Map[str, vector.Vector[Access]];
    memargs:    vector.Vector[Memarg];
    orders:     vector.Vector[Order];
    ordered:    vector.Vector[Memarg];
    entries:    map.Map[str, vector.Vector[Entry]];
    omitted:    map.Map[str, bool];
    unrowed:    vector.Vector[Range];
    unindexed:  vector.Vector[u32];
    features:   vector.Vector[Feature];
    types:      vector.Vector[Named];
    heaps:      vector.Vector[Named];
}

# a type's text name, the byte its binary spells it by and the features it requires, every one of them, none for
# wasm 1.0's
pub rec Named {
    name:     str;
    code:     u32;
    features: vector.Vector[str];
    line:     topic.Line;
}

fun memory() diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, nil);
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# the topic `name` of `tree` held to opcode.def by `stated`, its facts read as lines into `out`
fun lines_of(a: *A.Allocator, tree: *source.Tree, name: str, ops: *wasm_opcodes.Opcodes, stated: topic.Stated, out: *vector.Vector[topic.Line]) err[diag.Refusal] {
    val res_read: res[topic.Topic, diag.Refusal] = topic.read(a, tree, name);
    if (sel res_read.err) { ret err[diag.Refusal].err{res_read.err}; }
    var t:           topic.Topic       = res_read.ok;
    val err_checked: err[diag.Refusal] = topic.check(?t, ops::ptr, stated);
    if (sel err_checked.err) { ret err_checked; }
    @out = vector.init[topic.Line](a);
    var i: usize = 0;
    for (i < t.facts.len) {
        var l:        topic.Line;
        val err_read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel err_read.err)                         { ret err_read; }
        if (!pushed(vector.push[topic.Line](out, l))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the instruction line `l` names by the second word of its key, refused when opcode.def has none
fun instruction(l: *topic.Line, kind: str, ops: *wasm_opcodes.Opcodes) res[*wasm_opcodes.Opcode, diag.Refusal] {
    if (!topic.is(l, kind, 2)) { ret res[*wasm_opcodes.Opcode, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_FACT, l.fact.key)}; }
    val opt_named: opt[*wasm_opcodes.Opcode] = wasm_opcodes.named(ops, l.key.data[1]);
    if (sel opt_named.none) { ret res[*wasm_opcodes.Opcode, diag.Refusal].err{topic.refuse(l.fact, NO_INSTRUCTION, l.key.data[1])}; }
    ret res[*wasm_opcodes.Opcode, diag.Refusal].ok{opt_named.some};
}

# the type columns of the instruction a signature names, what opcode.def states of its signature
fun columns_stated(ctx: ptr, f: *topic.Fact) opt[str] {
    val ops: *wasm_opcodes.Opcodes = ctx::*wasm_opcodes.Opcodes;
    var at:  usize                 = 0;
    for (f.key[at] != 0 && f.key[at] != ' ') { at = at + 1; }
    if (f.key[at] == 0) { ret opt[str].none{}; }
    val opt_named: opt[*wasm_opcodes.Opcode] = wasm_opcodes.named(ops, ?f.key[at + 1]);
    if (sel opt_named.none) { ret opt[str].none{}; }
    ret opt[str].some{wasm_opcodes.columns(ops.alloc, opt_named.some)};
}

fun kind_named(word: str) opt[Kind] {
    var k: u32 = 0;
    for (k < 24) {
        if (str_equals(word, KIND_NAMES[k])) { ret opt[Kind].some{k::Kind}; }
        k = k + 1;
    }
    ret opt[Kind].none{};
}

# the immediate `word` names, a trailing `?` making it optional
fun immediate_of(a: *A.Allocator, l: *topic.Line, word: str) res[Immediate, diag.Refusal] {
    var len: usize = 0;
    for (word[len] != 0) { len = len + 1; }
    var im: Immediate = Immediate{kind: 0, optional: false};
    var w:  str       = word;
    if (len > 1 && word[len - 1] == '?') {
        im.optional = true;
        val res_cut: res[*u8, A.Error] = A.allocate[u8](a, len);
        if (sel res_cut.err) { ret res[Immediate, diag.Refusal].err{memory()}; }
        var i: usize = 0;
        for (i < len - 1) {
            res_cut.ok[i] = word[i];
            i             = i + 1;
        }
        res_cut.ok[len - 1] = 0;
        w                   = res_cut.ok;
    }
    val opt_kind_named: opt[Kind] = kind_named(w);
    if (sel opt_kind_named.none) { ret res[Immediate, diag.Refusal].err{topic.refuse(l.fact, BAD_IMMEDIATE, word)}; }
    im.kind = opt_kind_named.some;
    ret res[Immediate, diag.Refusal].ok{im};
}

# the text order `text` states over `count` immediates, each once
fun order_of(l: *topic.Line, text: str, count: usize, out: *vector.Vector[u8]) err[diag.Refusal] {
    var seen: [16]bool;
    var k:    usize = 0;
    for (k < 16) {
        seen[k] = false;
        k       = k + 1;
    }
    var at: usize = 0;
    for {
        var n:      usize = 0;
        var digits: usize = 0;
        for (text[at] >= '0' && text[at] <= '9') {
            n      = n * 10 + (text[at] - '0')::usize;
            at     = at + 1;
            digits = digits + 1;
        }
        if (digits == 0 || n >= count || n >= 16 || seen[n]) { ret topic.reject(l, BAD_ORDER, text); }
        seen[n] = true;
        vector.push[u8](out, n::u8);
        if (text[at] == 0)   { brk; }
        if (text[at] != ',') { ret topic.reject(l, BAD_ORDER, text); }
        at = at + 1;
    }
    if (out.len != count) { ret topic.reject(l, BAD_ORDER, text); }
    ret err[diag.Refusal].ok{};
}

fun immediates(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line];
    val err_read: err[diag.Refusal] = lines_of(a, tree, "immediates", ops, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l:               *topic.Line                             = ?ls.data[i];
        val res_instruction: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "imm", ops);
        if (sel res_instruction.err) { ret err[diag.Refusal].err{res_instruction.err}; }
        var x:     Immediates = Immediates{immediates: vector.init[Immediate](a), order: vector.init[u8](a), paired: false};
        var order: str        = nil;
        var k:     usize      = 0;
        for (k < l.ws.len) {
            val w: str = l.ws.data[k];
            if (w[0] == 'o' && w[1] == 'r' && w[2] == 'd' && w[3] == 'e' && w[4] == 'r' && w[5] == '=') { order = ?w[6]; }
            or (str_equals(w, "paired=yes"))                                                            { x.paired = true; }
            or {
                val res_immediate_of: res[Immediate, diag.Refusal] = immediate_of(a, l, w);
                if (sel res_immediate_of.err) { ret err[diag.Refusal].err{res_immediate_of.err}; }
                vector.push[Immediate](?x.immediates, res_immediate_of.ok);
            }
            k = k + 1;
        }
        if (order != nil) {
            val err_held: err[diag.Refusal] = order_of(l, order, x.immediates.len, ?x.order);
            if (sel err_held.err) { ret err_held; }
        }
        if (x.paired && !(x.immediates.len == 2 && x.immediates.data[0].optional && x.immediates.data[1].optional)) { ret topic.reject(l, BAD_PAIR, res_instruction.ok.name); }
        var key:       str              = res_instruction.ok.name;
        val opt_prior: opt[*Immediates] = map.get[str, Immediates](?out.immediates, ?key);
        if (sel opt_prior.some) { ret topic.reject(l, STATED_TWICE, res_instruction.ok.name); }
        val res_put: res[bool, A.Error] = map.insert[str, Immediates](?out.immediates, res_instruction.ok.name, x);
        if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the stack types `text` spells, split on spaces
fun types_of(a: *A.Allocator, l: *topic.Line, text: str, out: *vector.Vector[Type]) err[diag.Refusal] {
    @out = vector.init[Type](a);
    var at: usize = 0;
    for {
        for (text[at] == ' ') { at = at + 1; }
        if (text[at] == 0) { brk; }
        var end: usize = at;
        for (text[end] != 0 && text[end] != ' ') { end = end + 1; }
        val len: usize = end - at;
        var t:   Type  = Type{ref: FIXED, n: 0, name: nil};
        if (len == 3 && text[at] == '.' && text[at + 1] == '.' && text[at + 2] == '.')                        { t.ref = POLYMORPHIC; }
        or (len == 7 && text[at] == 'r' && text[at + 1] == 'e' && text[at + 2] == 's' && text[at + 6] == 's') { t.ref = RESULTS; }
        or ((text[at] == '<' && text[end - 1] == '>' && len > 2) || (text[at] == '<' && text[end - 1] == '-' && text[end - 2] == '>' && len > 3) || (text[at] == '$' && len > 1)) {
            t.ref = VARIABLE;
            var from: usize = at + 1;
            var to:   usize = end;
            if (text[at] == '<') {
                t.ref = OPERAND;
                to    = end - 1;
                if (text[end - 1] == '-') {
                    t.ref = LESS;
                    to    = end - 2;
                }
            }
            var n: u32   = 0;
            var k: usize = from;
            for (k < to) {
                if (text[k] < '0' || text[k] > '9' || n > 15) { ret topic.reject(l, BAD_TYPE, text); }
                n = n * 10 + (text[k] - '0')::u32;
                k = k + 1;
            }
            if (n > 15) { ret topic.reject(l, BAD_TYPE, text); }
            t.n = n::u8;
        }
        or {
            val res_name: res[*u8, A.Error] = A.allocate[u8](a, len + 1);
            if (sel res_name.err) { ret err[diag.Refusal].err{memory()}; }
            var k: usize = 0;
            for (k < len) {
                res_name.ok[k] = text[at + k];
                k              = k + 1;
            }
            res_name.ok[len] = 0;
            t.name           = res_name.ok;
        }
        vector.push[Type](out, t);
        at = end;
    }
    ret err[diag.Refusal].ok{};
}

fun signatures(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line];
    val err_read: err[diag.Refusal] = lines_of(a, tree, "signatures", ops, columns_stated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l:               *topic.Line                             = ?ls.data[i];
        val res_instruction: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "sig", ops);
        if (sel res_instruction.err) { ret err[diag.Refusal].err{res_instruction.err}; }
        var pops:           str               = nil;
        var pushes:         str               = nil;
        val err_pops_found: err[diag.Refusal] = topic.needed(l, "pops", ?pops);
        if (sel err_pops_found.err) { ret err_pops_found; }
        val err_pushes_found: err[diag.Refusal] = topic.needed(l, "pushes", ?pushes);
        if (sel err_pushes_found.err) { ret err_pushes_found; }
        var s:                  Signature;
        val err_pop_types_read: err[diag.Refusal] = types_of(a, l, pops, ?s.pops);
        if (sel err_pop_types_read.err) { ret err_pop_types_read; }
        val err_push_types_read: err[diag.Refusal] = types_of(a, l, pushes, ?s.pushes);
        if (sel err_push_types_read.err) { ret err_push_types_read; }
        var key:       str             = res_instruction.ok.name;
        val opt_prior: opt[*Signature] = map.get[str, Signature](?out.signatures, ?key);
        if (sel opt_prior.some) { ret topic.reject(l, STATED_TWICE, res_instruction.ok.name); }
        val res_put: res[bool, A.Error] = map.insert[str, Signature](?out.signatures, res_instruction.ok.name, s);
        if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun transfer_of(word: str) str {
    if (str_equals(word, "jump"))   { ret "effect.JUMP"; }
    if (str_equals(word, "call"))   { ret "effect.CALL"; }
    if (str_equals(word, "return")) { ret "effect.RETURN"; }
    if (str_equals(word, "trap"))   { ret "effect.TRAP"; }
    ret nil;
}

fun target_of(word: str) str {
    if (str_equals(word, "none"))       { ret "effect.UNTARGETED"; }
    if (str_equals(word, "direct"))     { ret "effect.DIRECT"; }
    if (str_equals(word, "indirect"))   { ret "effect.INDIRECT"; }
    if (str_equals(word, "depth"))      { ret "effect.DEPTH"; }
    if (str_equals(word, "structured")) { ret "effect.STRUCTURED"; }
    if (str_equals(word, "caught"))     { ret "effect.CAUGHT"; }
    if (str_equals(word, "function"))   { ret "effect.FUNCTION"; }
    ret nil;
}

# the depth plus one the named value `name` of `l` gives, 0 when it gives none, refused past 15
fun depth_of(l: *topic.Line, name: str) res[u8, diag.Refusal] {
    val word: str = topic.optional(l, name, nil);
    if (word == nil) { ret res[u8, diag.Refusal].ok{0}; }
    val res_number: res[i64, diag.Refusal] = topic.number(l.fact, word);
    if (sel res_number.err)                      { ret res[u8, diag.Refusal].err{res_number.err}; }
    if (res_number.ok < 0 || res_number.ok > 15) { ret res[u8, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_NUMBER, word)}; }
    ret res[u8, diag.Refusal].ok{(res_number.ok + 1)::u8};
}

fun controls(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line];
    val err_read: err[diag.Refusal] = lines_of(a, tree, "control", ops, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l:               *topic.Line                             = ?ls.data[i];
        val res_instruction: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "control", ops);
        if (sel res_instruction.err) { ret err[diag.Refusal].err{res_instruction.err}; }
        var transfer:           str               = nil;
        var target:             str               = nil;
        val err_transfer_found: err[diag.Refusal] = topic.needed(l, "transfer", ?transfer);
        if (sel err_transfer_found.err) { ret err_transfer_found; }
        val err_target_found: err[diag.Refusal] = topic.needed(l, "target", ?target);
        if (sel err_target_found.err) { ret err_target_found; }
        val known:     [7]str            = [7]str{"transfer", "returns", "target", "arg", "conditional", "condition", "chooses"};
        val err_words: err[diag.Refusal] = topic.known(l, ?known[0], 7);
        if (sel err_words.err) { ret err_words; }
        var c: Control = Control{transfer: transfer_of(transfer), target: target_of(target), operand: field.NO_OPERAND, conditional: false, condition: 0, chooses: 0};
        if (c.transfer == nil) { ret topic.reject(l, BAD_TRANSFER, transfer); }
        val err_kind: err[diag.Refusal] = control.classified(l, transfer, ?c.transfer);
        if (sel err_kind.err) { ret err_kind; }
        if (c.target == nil)  { ret topic.reject(l, BAD_TARGET, target); }
        val arg: str = topic.optional(l, "arg", nil);
        if (arg != nil) {
            val res_number: res[i64, diag.Refusal] = topic.number(l.fact, arg);
            if (sel res_number.err)                      { ret err[diag.Refusal].err{res_number.err}; }
            if (res_number.ok < 0 || res_number.ok > 15) { ret topic.reject(l, topic.BAD_NUMBER, arg); }
            c.operand = res_number.ok::u8;
        }
        val res_cond: res[bool, diag.Refusal] = topic.yes(l, "conditional", false);
        if (sel res_cond.err) { ret err[diag.Refusal].err{res_cond.err}; }
        c.conditional = res_cond.ok;
        val res_decides: res[u8, diag.Refusal] = depth_of(l, "condition");
        if (sel res_decides.err) { ret err[diag.Refusal].err{res_decides.err}; }
        val res_chooses: res[u8, diag.Refusal] = depth_of(l, "chooses");
        if (sel res_chooses.err) { ret err[diag.Refusal].err{res_chooses.err}; }
        c.condition = res_decides.ok;
        c.chooses   = res_chooses.ok;
        var key:       str           = res_instruction.ok.name;
        val opt_prior: opt[*Control] = map.get[str, Control](?out.controls, ?key);
        if (sel opt_prior.some) { ret topic.reject(l, STATED_TWICE, res_instruction.ok.name); }
        val res_put: res[bool, A.Error] = map.insert[str, Control](?out.controls, res_instruction.ok.name, c);
        if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun structures(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line];
    val err_read: err[diag.Refusal] = lines_of(a, tree, "structure", ops, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l:               *topic.Line                             = ?ls.data[i];
        val res_instruction: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "structure", ops);
        if (sel res_instruction.err) { ret err[diag.Refusal].err{res_instruction.err}; }
        val opt_word: opt[str]  = topic.only(l);
        var s:        Structure = NONE;
        if (sel opt_word.some && str_equals(opt_word.some, "else"))  { s = ELSE; }
        if (sel opt_word.some && str_equals(opt_word.some, "close")) { s = CLOSE; }
        if (sel opt_word.some && str_equals(opt_word.some, "loop"))  { s = LOOP; }
        if (sel opt_word.some && str_equals(opt_word.some, "catch")) { s = CATCH; }
        if (s == NONE)                                               { ret topic.reject(l, BAD_STRUCTURE, l.fact.fact); }
        var key:       str             = res_instruction.ok.name;
        val opt_prior: opt[*Structure] = map.get[str, Structure](?out.structures, ?key);
        if (sel opt_prior.some) { ret topic.reject(l, STATED_TWICE, res_instruction.ok.name); }
        val res_put: res[bool, A.Error] = map.insert[str, Structure](?out.structures, res_instruction.ok.name, s);
        if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the number `word` spells as a byte or an index, refused past u32
fun code_of(l: *topic.Line, word: str) res[u32, diag.Refusal] {
    val res_number: res[i64, diag.Refusal] = topic.number(l.fact, word);
    if (sel res_number.err)                               { ret res[u32, diag.Refusal].err{res_number.err}; }
    if (res_number.ok < 0 || res_number.ok > 0xFFFF_FFFF) { ret res[u32, diag.Refusal].err{topic.refuse(l.fact, BAD_RANGE, word)}; }
    ret res[u32, diag.Refusal].ok{res_number.ok::u32};
}

# the range words `from` on of the key of `l` state: `0x..`, `lo-hi`, or a prefix before either
fun range_of(a: *A.Allocator, l: *topic.Line) res[Range, diag.Refusal] {
    var r:    Range = Range{prefix: 0, lo: 0, hi: 0};
    var span: str   = nil;
    if (l.key.len == 2) { span = l.key.data[1]; }
    or (l.key.len == 3) {
        val res_code_of: res[u32, diag.Refusal] = code_of(l, l.key.data[1]);
        if (sel res_code_of.err) { ret res[Range, diag.Refusal].err{res_code_of.err}; }
        r.prefix = res_code_of.ok;
        span     = l.key.data[2];
    }
    or { ret res[Range, diag.Refusal].err{topic.refuse(l.fact, BAD_RANGE, l.fact.key)}; }
    var dash: usize = 0;
    for (span[dash] != 0 && span[dash] != '-') { dash = dash + 1; }
    if (span[dash] == 0) {
        val res_one: res[u32, diag.Refusal] = code_of(l, span);
        if (sel res_one.err) { ret res[Range, diag.Refusal].err{res_one.err}; }
        r.lo = res_one.ok;
        r.hi = res_one.ok;
        ret res[Range, diag.Refusal].ok{r};
    }
    val res_head: res[*u8, A.Error] = A.allocate[u8](a, dash + 1);
    if (sel res_head.err) { ret res[Range, diag.Refusal].err{memory()}; }
    var k: usize = 0;
    for (k < dash) {
        res_head.ok[k] = span[k];
        k              = k + 1;
    }
    res_head.ok[dash] = 0;
    val res_code_of:      res[u32, diag.Refusal] = code_of(l, res_head.ok);
    val res_code_of_span: res[u32, diag.Refusal] = code_of(l, ?span[dash + 1]);
    if (sel res_code_of.err)                  { ret res[Range, diag.Refusal].err{res_code_of.err}; }
    if (sel res_code_of_span.err)             { ret res[Range, diag.Refusal].err{res_code_of_span.err}; }
    if (res_code_of_span.ok < res_code_of.ok) { ret res[Range, diag.Refusal].err{topic.refuse(l.fact, BAD_RANGE, span)}; }
    r.lo = res_code_of.ok;
    r.hi = res_code_of_span.ok;
    ret res[Range, diag.Refusal].ok{r};
}

fun omissions(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line];
    val err_read: err[diag.Refusal] = lines_of(a, tree, "omissions", ops, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (l.key.len > 0 && str_equals(l.key.data[0], "omit")) {
            val res_instruction: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "omit", ops);
            if (sel res_instruction.err) { ret err[diag.Refusal].err{res_instruction.err}; }
            var key:       str        = res_instruction.ok.name;
            val opt_prior: opt[*bool] = map.get[str, bool](?out.omitted, ?key);
            if (sel opt_prior.some) { ret topic.reject(l, STATED_TWICE, res_instruction.ok.name); }
            val res_put: res[bool, A.Error] = map.insert[str, bool](?out.omitted, res_instruction.ok.name, true);
            if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
        }
        or (l.key.len > 0 && str_equals(l.key.data[0], "unrowed")) {
            val res_range_of: res[Range, diag.Refusal] = range_of(a, l);
            if (sel res_range_of.err) { ret err[diag.Refusal].err{res_range_of.err}; }
            vector.push[Range](?out.unrowed, res_range_of.ok);
        }
        or (topic.is(l, "unindexed", 2)) {
            val res_code_of: res[u32, diag.Refusal] = code_of(l, l.key.data[1]);
            if (sel res_code_of.err) { ret err[diag.Refusal].err{res_code_of.err}; }
            vector.push[u32](?out.unindexed, res_code_of.ok);
        }
        or { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the role constant `word` names, nil for none
fun role_of(word: str) str {
    if (str_equals(word, "read"))  { ret "operand.READ"; }
    if (str_equals(word, "write")) { ret "operand.WRITE"; }
    if (str_equals(word, "both"))  { ret "operand.READ_WRITE"; }
    ret nil;
}

val ROLE_WORDS: [3]str = [3]str{"read", "write", "both"};

# the number `word` spells, refused past 15 or below 0
fun small(l: *topic.Line, word: str) res[u8, diag.Refusal] {
    val res_number: res[i64, diag.Refusal] = topic.number(l.fact, word);
    if (sel res_number.err)                      { ret res[u8, diag.Refusal].err{res_number.err}; }
    if (res_number.ok < 0 || res_number.ok > 15) { ret res[u8, diag.Refusal].err{topic.refuse(l.fact, topic.BAD_NUMBER, word)}; }
    ret res[u8, diag.Refusal].ok{res_number.ok::u8};
}

# the accesses of instruction `o`'s line `l`: one per role it names at the popped value of that depth, each of the
# count and element bits it states
fun named_accesses(a: *A.Allocator, l: *topic.Line, o: *wasm_opcodes.Opcode, out: *Facts) err[diag.Refusal] {
    val known:     [5]str            = [5]str{"read", "write", "both", "count", "bits"};
    val err_words: err[diag.Refusal] = topic.known(l, ?known[0], 5);
    if (sel err_words.err) { ret err_words; }
    var count: u8  = NO_POP;
    val given: str = topic.optional(l, "count", nil);
    if (given != nil) {
        val res_small: res[u8, diag.Refusal] = small(l, given);
        if (sel res_small.err) { ret err[diag.Refusal].err{res_small.err}; }
        count = res_small.ok;
    }
    var bits_word:  str               = nil;
    val err_needed: err[diag.Refusal] = topic.needed(l, "bits", ?bits_word);
    if (sel err_needed.err) { ret err_needed; }
    val res_bits: res[i64, diag.Refusal] = topic.number(l.fact, bits_word);
    if (sel res_bits.err)                     { ret err[diag.Refusal].err{res_bits.err}; }
    if (res_bits.ok < 0 || res_bits.ok > 128) { ret topic.reject(l, topic.BAD_NUMBER, bits_word); }
    var list: vector.Vector[Access] = vector.init[Access](a);
    var k:    usize                 = 0;
    for (k < 3) {
        val at: str = topic.optional(l, ROLE_WORDS[k], nil);
        if (at != nil) {
            val res_small: res[u8, diag.Refusal] = small(l, at);
            if (sel res_small.err)                                                                                                                  { ret err[diag.Refusal].err{res_small.err}; }
            if (!pushed(vector.push[Access](?list, Access{role: role_of(ROLE_WORDS[k]), pop: res_small.ok, count: count, bits: res_bits.ok::u32}))) { ret err[diag.Refusal].err{memory()}; }
        }
        k = k + 1;
    }
    if (list.len == 0) { ret topic.reject(l, BAD_ROLE, o.name); }
    var key:       str                         = o.name;
    val opt_prior: opt[*vector.Vector[Access]] = map.get[str, vector.Vector[Access]](?out.accesses, ?key);
    if (sel opt_prior.some) { ret topic.reject(l, STATED_TWICE, o.name); }
    val res_put: res[bool, A.Error] = map.insert[str, vector.Vector[Access]](?out.accesses, o.name, list);
    if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# the entries of instruction `o`'s line `l`: one per role it names, through the operand of that number
fun named_entries(a: *A.Allocator, l: *topic.Line, o: *wasm_opcodes.Opcode, out: *Facts) err[diag.Refusal] {
    val err_words: err[diag.Refusal] = topic.known(l, ?ROLE_WORDS[0], 3);
    if (sel err_words.err) { ret err_words; }
    var list: vector.Vector[Entry] = vector.init[Entry](a);
    var k:    usize                = 0;
    for (k < 3) {
        val at: str = topic.optional(l, ROLE_WORDS[k], nil);
        if (at != nil) {
            val res_small: res[u8, diag.Refusal] = small(l, at);
            if (sel res_small.err)                                                                              { ret err[diag.Refusal].err{res_small.err}; }
            if (!pushed(vector.push[Entry](?list, Entry{operand: res_small.ok, role: role_of(ROLE_WORDS[k])}))) { ret err[diag.Refusal].err{memory()}; }
        }
        k = k + 1;
    }
    if (list.len == 0) { ret topic.reject(l, BAD_ROLE, o.name); }
    var key:       str                        = o.name;
    val opt_prior: opt[*vector.Vector[Entry]] = map.get[str, vector.Vector[Entry]](?out.entries, ?key);
    if (sel opt_prior.some) { ret topic.reject(l, STATED_TWICE, o.name); }
    val res_put: res[bool, A.Error] = map.insert[str, vector.Vector[Entry]](?out.entries, o.name, list);
    if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# the words an order line reads, wasm's orders read from no field
val ORDER_NAMES: [2]str = [2]str{"before", "after"};

fun accesses(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line];
    val err_read: err[diag.Refusal] = lines_of(a, tree, "access", ops, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (l.key.len > 0 && str_equals(l.key.data[0], "memarg")) {
            val res_range_of: res[Range, diag.Refusal] = range_of(a, l);
            if (sel res_range_of.err) { ret err[diag.Refusal].err{res_range_of.err}; }
            val opt_word: opt[str] = topic.only(l);
            var role:     str      = nil;
            if (sel opt_word.some)                                                                                { role = role_of(opt_word.some); }
            if (role == nil)                                                                                      { ret topic.reject(l, BAD_ROLE, l.fact.fact); }
            if (!pushed(vector.push[Memarg](?out.memargs, Memarg{range: res_range_of.ok, role: role, line: @l}))) { ret err[diag.Refusal].err{memory()}; }
        }
        or (l.key.len > 0 && str_equals(l.key.data[0], "order")) {
            val res_range_of: res[Range, diag.Refusal] = range_of(a, l);
            if (sel res_range_of.err) { ret err[diag.Refusal].err{res_range_of.err}; }
            val err_words: err[diag.Refusal] = topic.known(l, ?ORDER_NAMES[0], 2);
            if (sel err_words.err) { ret err_words; }
            var o:        Order             = Order{range: res_range_of.ok, stated: gen_order.Stated{before: effect.NO_KINDS, after: effect.NO_KINDS, field: nil, mask: 0, value: 0, width: 0}, line: @l};
            val err_read: err[diag.Refusal] = gen_order.read(l, ?o.stated);
            if (sel err_read.err)                            { ret err_read; }
            if (!pushed(vector.push[Order](?out.orders, o))) { ret err[diag.Refusal].err{memory()}; }
        }
        or (l.key.len > 0 && str_equals(l.key.data[0], "ordered")) {
            val res_range_of: res[Range, diag.Refusal] = range_of(a, l);
            if (sel res_range_of.err) { ret err[diag.Refusal].err{res_range_of.err}; }
            val err_req: err[diag.Refusal] = gen_order.required(l);
            if (sel err_req.err)                                                                                          { ret err_req; }
            if (!pushed(vector.push[Memarg](?out.ordered, Memarg{range: res_range_of.ok, role: l.ws.data[0], line: @l}))) { ret err[diag.Refusal].err{memory()}; }
        }
        or (topic.is(l, "access", 2)) {
            val res_instruction: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "access", ops);
            if (sel res_instruction.err) { ret err[diag.Refusal].err{res_instruction.err}; }
            val err_held: err[diag.Refusal] = named_accesses(a, l, res_instruction.ok, out);
            if (sel err_held.err) { ret err_held; }
        }
        or (topic.is(l, "entry", 2)) {
            val res_instruction: res[*wasm_opcodes.Opcode, diag.Refusal] = instruction(l, "entry", ops);
            if (sel res_instruction.err) { ret err[diag.Refusal].err{res_instruction.err}; }
            val err_held: err[diag.Refusal] = named_entries(a, l, res_instruction.ok, out);
            if (sel err_held.err) { ret err_held; }
        }
        or { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun features(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line];
    val err_read: err[diag.Refusal] = lines_of(a, tree, "features", ops, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (l.key.len == 0 || !str_equals(l.key.data[0], "feature")) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val res_range_of: res[Range, diag.Refusal] = range_of(a, l);
        if (sel res_range_of.err) { ret err[diag.Refusal].err{res_range_of.err}; }
        vector.push[Feature](?out.features, Feature{range: res_range_of.ok, features: l.ws, line: @l});
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# every topic of the data tree `tree`, held to opcode.def `ops`
pub fun read(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    @out = Facts{
        immediates: map.init[str, Immediates](a),
        signatures: map.init[str, Signature](a),
        controls:   map.init[str, Control](a),
        structures: map.init[str, Structure](a),
        accesses:   map.init[str, vector.Vector[Access]](a),
        memargs:    vector.init[Memarg](a),
        orders:     vector.init[Order](a),
        ordered:    vector.init[Memarg](a),
        entries:    map.init[str, vector.Vector[Entry]](a),
        omitted:    map.init[str, bool](a),
        unrowed:    vector.init[Range](a),
        unindexed:  vector.init[u32](a),
        features:   vector.init[Feature](a),
        types:      vector.init[Named](a),
        heaps:      vector.init[Named](a),
    };
    val err_immediates: err[diag.Refusal] = immediates(a, tree, ops, out);
    if (sel err_immediates.err) { ret err_immediates; }
    val err_signatures: err[diag.Refusal] = signatures(a, tree, ops, out);
    if (sel err_signatures.err) { ret err_signatures; }
    val err_controls: err[diag.Refusal] = controls(a, tree, ops, out);
    if (sel err_controls.err) { ret err_controls; }
    val err_structures: err[diag.Refusal] = structures(a, tree, ops, out);
    if (sel err_structures.err) { ret err_structures; }
    val err_accesses: err[diag.Refusal] = accesses(a, tree, ops, out);
    if (sel err_accesses.err) { ret err_accesses; }
    val err_omissions: err[diag.Refusal] = omissions(a, tree, ops, out);
    if (sel err_omissions.err) { ret err_omissions; }
    val err_features: err[diag.Refusal] = features(a, tree, ops, out);
    if (sel err_features.err) { ret err_features; }
    ret types(a, tree, ops, out);
}

# whether `name` is held by `list`
fun held(list: *vector.Vector[Named], name: str) bool {
    var i: usize = 0;
    for (i < list.len) {
        if (str_equals(list.data[i].name, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun types(a: *A.Allocator, tree: *source.Tree, ops: *wasm_opcodes.Opcodes, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line];
    val err_read: err[diag.Refusal] = lines_of(a, tree, "types", ops, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l:    *topic.Line           = ?ls.data[i];
        var into: *vector.Vector[Named] = ?out.types;
        if (topic.is(l, "heap", 2))  { into = ?out.heaps; }
        or (!topic.is(l, "type", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        if (l.ws.len == 0)           { ret topic.reject(l, BAD_CODE, l.fact.fact); }
        val word:     str                    = l.ws.data[0];
        val res_code: res[i64, diag.Refusal] = topic.number(l.fact, word);
        if (sel res_code.err)                      { ret err[diag.Refusal].err{res_code.err}; }
        if (res_code.ok < 0 || res_code.ok > 0xFF) { ret topic.reject(l, BAD_CODE, word); }
        if (held(into, l.key.data[1]))             { ret topic.reject(l, STATED_TWICE, l.key.data[1]); }
        var features: vector.Vector[str] = vector.init[str](a);
        var k:        usize              = 1;
        for (k < l.ws.len) {
            vector.push[str](?features, l.ws.data[k]);
            k = k + 1;
        }
        vector.push[Named](into, Named{name: l.key.data[1], code: res_code.ok::u32, features: features, line: @l});
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the code of the value type named `name`, none for a name no line states
pub fun type_code(x: *Facts, name: str) opt[u32] {
    var i: usize = 0;
    for (i < x.types.len) {
        if (str_equals(x.types.data[i].name, name)) { ret opt[u32].some{x.types.data[i].code}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# whether opcode `code` under prefix `prefix` lies in `r`
pub fun within(r: *Range, prefix: u32, code: u32) bool {
    ret r.prefix == prefix && code >= r.lo && code <= r.hi;
}
