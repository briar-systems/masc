# the reader of wabt's opcode.def, the wasm instruction source
#
# every instruction is one `WABT_OPCODE(tr, tr2, t1, t2, t3, m, prefix, code, Name, "text", "decomp")` line:
# its result types, its parameter types, the bytes of memory it accesses, its prefix byte or 0, its opcode or its
# index under the prefix, wabt's identifier for it and its text mnemonic. a type is `___` for none, `Any` for one
# the instruction's operands decide, or one of I32, I64, F32, F64 and V128. the file's other lines are its licence,
# its comments and its preprocessor guards, which hold no instruction.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.view.View;

use A: std.allocator;
use std.allocator.testing;
use std.collections.map;
use std.collections.vector;

use gen.diag;
use gen.lines;
use gen.source;

pub val FILE: str = "opcode.def";

pub val NO_FILE:     str = "source holds no opcode.def";
pub val BAD_LINE:    str = "opcode line does not hold eleven fields";
pub val BAD_TYPE:    str = "opcode line names a type that is not ___, Any, I32, I64, F32, F64 or V128";
pub val BAD_NUMBER:  str = "opcode line holds a size, prefix or code that is no number";
pub val BAD_TEXT:    str = "opcode line's text is not a quoted mnemonic";
pub val NAMED_TWICE: str = "two opcode lines share a name";
pub val CODED_TWICE: str = "two opcode lines share a prefix and code";

# the line every instruction is
val LEAD: str = "WABT_OPCODE(";

# the number of type columns, tr to t3
pub val TYPES: usize = 5;

# one instruction of opcode.def
# ---
# types:  tr, tr2, t1, t2 and t3 as the file spells them
# memory: the bytes of memory it accesses, 0 for none
# prefix: its prefix byte, 0 for none
# code:   its opcode, or its index under its prefix
# name:   wabt's identifier for it
# text:   its mnemonic
# line:   where it is
pub rec Opcode {
    types:  [5]str;
    memory: u32;
    prefix: u32;
    code:   u32;
    name:   str;
    text:   str;
    line:   lines.Line;
}

# the instructions of opcode.def
# ---
# alloc: what it is read into
# all:   every instruction, in file order
# named: each instruction's position by its name
pub rec Opcodes {
    alloc: *A.Allocator;
    all:   vector.Vector[Opcode];
    named: map.Map[str, u32];
}

fun memory(l: *lines.Line) diag.Refusal {
    ret lines.refuse(l, diag.MEMORY, nil);
}

fun space(c: u8) bool {
    ret c == ' ' || c == '\t';
}

# bytes `from` to `to` of `v` trimmed and copied
fun field(a: *A.Allocator, v: View, from: usize, to: usize) str {
    var lo: usize = from;
    var hi: usize = to;
    for (lo < hi && space(v.data[lo])) { lo = lo + 1; }
    for (hi > lo && space(v.data[hi - 1])) { hi = hi - 1; }
    ret copied(a, ?v.data[lo], hi - lo);
}

# `len` bytes at `data` copied with a nul after them, nil when the storage is refused
fun copied(a: *A.Allocator, data: *u8, len: usize) str {
    val got: res[*u8, A.Error] = A.allocate[u8](a, len + 1);
    if (sel got.err) { ret nil; }
    var i: usize = 0;
    for (i < len) {
        got.ok[i] = data[i];
        i         = i + 1;
    }
    got.ok[len] = 0;
    ret got.ok;
}

fun typed(t: str) bool {
    ret str_equals(t, "___") || str_equals(t, "Any") || str_equals(t, "I32") || str_equals(t, "I64") || str_equals(t, "F32") || str_equals(t, "F64") || str_equals(t, "V128");
}

# the number `s` spells, decimal or hexadecimal after `0x`
fun number(s: str) opt[u32] {
    var at:   usize = 0;
    var base: u64   = 10;
    if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
        base = 16;
        at   = 2;
    }
    if (s[at] == 0) { ret opt[u32].none{}; }
    var n: u64 = 0;
    for (s[at] != 0) {
        val c: u8  = s[at];
        var d: u64 = 99;
        if (c >= '0' && c <= '9')               { d = (c - '0')::u64; }
        or (base == 16 && c >= 'a' && c <= 'f') { d = (c - 'a')::u64 + 10; }
        or (base == 16 && c >= 'A' && c <= 'F') { d = (c - 'A')::u64 + 10; }
        if (d >= base)                          { ret opt[u32].none{}; }
        n = n * base + d;
        if (n > 0xFFFF_FFFF) { ret opt[u32].none{}; }
        at = at + 1;
    }
    ret opt[u32].some{n::u32};
}

# the text between the quotes of `s`, nil when it is not quoted or empty
fun unquoted(a: *A.Allocator, s: str) str {
    var len: usize = 0;
    for (s[len] != 0) { len = len + 1; }
    if (len < 3 || s[0] != '"' || s[len - 1] != '"') { ret nil; }
    ret copied(a, ?s[1], len - 2);
}

# the instruction on line `l`, which starts with LEAD
fun opcode(a: *A.Allocator, l: *lines.Line) res[Opcode, diag.Refusal] {
    val v:     View  = l.text;
    var close: usize = v.len;
    for (close > 0 && v.data[close - 1] != ')') { close = close - 1; }
    if (close == 0) { ret res[Opcode, diag.Refusal].err{lines.refuse(l, BAD_LINE, nil)}; }
    var parts: [11]str;
    var n:     usize = 0;
    var from:  usize = 12;
    var i:     usize = from;
    for (i < close - 1) {
        if (v.data[i] == ',') {
            if (n == 10) { ret res[Opcode, diag.Refusal].err{lines.refuse(l, BAD_LINE, nil)}; }
            parts[n] = field(a, v, from, i);
            n        = n + 1;
            from     = i + 1;
        }
        i = i + 1;
    }
    if (n != 10) { ret res[Opcode, diag.Refusal].err{lines.refuse(l, BAD_LINE, nil)}; }
    parts[10] = field(a, v, from, close - 1);
    var k: usize = 0;
    for (k < 11) {
        if (parts[k] == nil) { ret res[Opcode, diag.Refusal].err{memory(l)}; }
        k = k + 1;
    }
    var o: Opcode = Opcode{memory: 0, prefix: 0, code: 0, name: parts[8], text: nil, line: @l};
    k = 0;
    for (k < TYPES) {
        if (!typed(parts[k])) { ret res[Opcode, diag.Refusal].err{lines.refuse(l, BAD_TYPE, parts[k])}; }
        o.types[k] = parts[k];
        k          = k + 1;
    }
    val m:    opt[u32] = number(parts[5]);
    val pre:  opt[u32] = number(parts[6]);
    val code: opt[u32] = number(parts[7]);
    if (sel m.none)    { ret res[Opcode, diag.Refusal].err{lines.refuse(l, BAD_NUMBER, parts[8])}; }
    if (sel pre.none)  { ret res[Opcode, diag.Refusal].err{lines.refuse(l, BAD_NUMBER, parts[8])}; }
    if (sel code.none) { ret res[Opcode, diag.Refusal].err{lines.refuse(l, BAD_NUMBER, parts[8])}; }
    o.memory = m.some;
    o.prefix = pre.some;
    o.code   = code.some;
    o.text   = unquoted(a, parts[9]);
    if (o.text == nil) { ret res[Opcode, diag.Refusal].err{lines.refuse(l, BAD_TEXT, parts[8])}; }
    ret res[Opcode, diag.Refusal].ok{o};
}

fun starts(v: View, s: str) bool {
    var i: usize = 0;
    for (s[i] != 0) {
        if (i >= v.len || v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the key a prefix and code are known by
fun coded(o: *Opcode) u64 {
    ret (o.prefix::u64 << 32) | o.code::u64;
}

# every instruction of the opcode.def of `tree`, each name and each prefix and code once
pub fun read(a: *A.Allocator, tree: *source.Tree, out: *Opcodes) err[diag.Refusal] {
    val file: opt[*source.File] = source.find(tree, FILE);
    if (sel file.none) { ret err[diag.Refusal].err{diag.refusal(nil, 0, NO_FILE, nil)}; }
    ret parse(a, file.some, out);
}

fun parse(a: *A.Allocator, file: *source.File, out: *Opcodes) err[diag.Refusal] {
    val got: res[vector.Vector[lines.Line], diag.Refusal] = lines.read(a, file, '#');
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    @out = Opcodes{alloc: a, all: vector.init[Opcode](a), named: map.init[str, u32](a)};
    var codes: map.Map[u64, u32] = map.init[u64, u32](a);
    var i:     usize             = 0;
    for (i < got.ok.len) {
        val l: *lines.Line = ?got.ok.data[i];
        if (starts(l.text, LEAD)) {
            val o: res[Opcode, diag.Refusal] = opcode(a, l);
            if (sel o.err) { ret err[diag.Refusal].err{o.err}; }
            var key:   str       = o.ok.name;
            val prior: opt[*u32] = map.get[str, u32](?out.named, ?key);
            if (sel prior.some) { ret err[diag.Refusal].err{lines.refuse(l, NAMED_TWICE, o.ok.name)}; }
            var code: u64       = coded(?o.ok);
            val dup:  opt[*u32] = map.get[u64, u32](?codes, ?code);
            if (sel dup.some) { ret err[diag.Refusal].err{lines.refuse(l, CODED_TWICE, o.ok.name)}; }
            val at:     u32                 = out.all.len::u32;
            val pushed: res[usize, A.Error] = vector.push[Opcode](?out.all, o.ok);
            val named:  res[bool, A.Error]  = map.insert[str, u32](?out.named, o.ok.name, at);
            val held:   res[bool, A.Error]  = map.insert[u64, u32](?codes, code, at);
            if (sel pushed.err || sel named.err || sel held.err) { ret err[diag.Refusal].err{memory(l)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the instruction named `name`, none when opcode.def has none
pub fun named(o: *Opcodes, name: str) opt[*Opcode] {
    var key: str       = name;
    val at:  opt[*u32] = map.get[str, u32](?o.named, ?key);
    if (sel at.none) { ret opt[*Opcode].none{}; }
    ret opt[*Opcode].some{?o.all.data[@at.some]};
}

# its type columns as the file spells them, joined by single spaces, as an overlay names what it overrides
pub fun columns(a: *A.Allocator, o: *Opcode) str {
    var out: str   = o.types[0];
    var k:   usize = 1;
    for (k < TYPES) {
        val got: res[str, StrError] = str_join(a, out, " ", o.types[k]);
        if (sel got.err) { ret nil; }
        out = got.ok;
        k   = k + 1;
    }
    ret out;
}

#[testing]
val T_DEF: str = "/* licence */\n#ifndef WABT_OPCODE\n#endif\nWABT_OPCODE(I32, ___,  I32,  I32,  ___,  0,  0,    0x6a, I32Add, \"i32.add\", \"+\")\nWABT_OPCODE(V128, ___, I32,  ___,  ___,  16, 0xfd, 0x00, V128Load, \"v128.load\", \"\")\n";

# a line reads as its columns, its numbers and its names, and a prefixed instruction keeps its prefix apart from its code
test read__an_opcode_line_reads_as_its_columns {
    var t: testing.Testing;
    testing.make(?t);
    val a:   *A.Allocator = testing.allocator_of(?t);
    var len: usize        = 0;
    for (T_DEF[len] != 0) { len = len + 1; }
    var f:    source.File       = source.File{path: FILE, data: T_DEF, len: len};
    var o:    Opcodes;
    val done: err[diag.Refusal] = parse(a, ?f, ?o);
    if (sel done.err)   { ret 1; }
    if (o.all.len != 2) { ret 2; }
    val add: opt[*Opcode] = named(?o, "I32Add");
    if (sel add.none)                                                                                      { ret 3; }
    if (add.some.code != 0x6a || add.some.prefix != 0 || add.some.memory != 0)                             { ret 4; }
    if (!str_equals(add.some.text, "i32.add") || !str_equals(columns(a, add.some), "I32 ___ I32 I32 ___")) { ret 5; }
    val load: opt[*Opcode] = named(?o, "V128Load");
    if (sel load.none)                                                             { ret 6; }
    if (load.some.prefix != 0xfd || load.some.code != 0 || load.some.memory != 16) { ret 7; }
    ret 0;
}
