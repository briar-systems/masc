# the facts masc states beside the spir-v grammars, read from the topics of gen/data/spirv
#
# effects names each control transfer, literals the id operand whose type gives a literal its width, imports the
# name and import code of each extended instruction set by the grammar file it is read from, operations the
# operations OpSpecConstantOp takes, omissions the grammar's members masc's operand model does not hold, and mentions
# the members an operand names without the capabilities the grammar gives them. each
# topic is held to the grammar it speaks beside: a fact restating it, or naming an instruction, operand or member it
# lacks, is refused naming its line.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use masc.core.field;

use gen.diag;
use spirv_grammar: gen.isa.spirv.grammar;
use topic:         gen.overlay;
use gen.source;

pub val NO_INSTRUCTION: str = "fact names an instruction the grammar does not state";
pub val NO_OPERAND:     str = "fact names an operand its instruction does not have";
pub val NO_MEMBER:      str = "fact names an enumerant its kind does not have";
pub val BAD_TRANSFER:   str = "transfer is not jump, call, return, trap or merge";
pub val BAD_TARGET:     str = "target is not direct or none";
pub val STATED_TWICE:   str = "fact stated twice";
pub val NO_FILE:        str = "import names a grammar file the source does not hold";
pub val NOT_A_LITERAL:  str = "width names an operand that holds no literal";

# a control transfer of a row
# ---
# transfer:    its transfer, as the constant the rows spell
# target:      its target, as the constant the rows spell
# operand:     the operand holding its target, field.NO_OPERAND for none
# conditional: whether it may take another target than its operand's
pub rec Control {
    transfer:    str;
    target:      str;
    operand:     u8;
    conditional: bool;
}

# an extended instruction set
# ---
# file:     the grammar file it is read from
# name:     the name OpExtInstImport imports it by
# code:     its code in the set's import space
# requires: the extension that brings it, nil for none
# grammar:  its grammar
pub rec Import {
    file:     str;
    name:     str;
    code:     u32;
    requires: str;
    grammar:  spirv_grammar.Grammar;
}

# an operation OpSpecConstantOp takes
# ---
# name: its opname
# when: the capability a module declares to use it, nil for every module
pub rec Operation {
    name: str;
    when: str;
}

# what the topics state
# ---
# controls:   each control transfer by its opname
# widths:     each literal's width operand, by `<opname> <operand>`
# imports:    the extended instruction sets, in their order
# operations: the operations OpSpecConstantOp takes, in their order
# omitted:    each omitted member, by `<kind> <enumerant>`
# mentioned:  each member an operand names under its availability alone, by `<kind> <enumerant>`
pub rec Facts {
    controls:   map.Map[str, Control];
    widths:     map.Map[str, u8];
    imports:    vector.Vector[Import];
    operations: vector.Vector[Operation];
    omitted:    map.Map[str, bool];
    mentioned:  map.Map[str, bool];
}

fun memory() diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, nil);
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun instruction(g: *spirv_grammar.Grammar, name: str) *spirv_grammar.Instruction {
    ret spirv_grammar.instruction(g, name);
}

# the key `<a> <b>` a map of the facts is keyed by
pub fun pair(a: *A.Allocator, x: str, y: str) str {
    val got: res[str, StrError] = str_join(a, x, " ", y);
    if (sel got.err) { ret nil; }
    ret got.ok;
}

# the topic `name` of `tree` read and held to the grammar by `stated`, which reads `ctx`, its facts read as lines into
# `out`
fun lines_of(a: *A.Allocator, tree: *source.Tree, name: str, ctx: ptr, stated: topic.Stated, out: *vector.Vector[topic.Line]) err[diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, name);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, ctx, stated);
    if (sel checked.err) { ret checked; }
    var i: usize = 0;
    for (i < t.facts.len) {
        var l:    topic.Line        = topic.Line{fact: nil};
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err)                             { ret read; }
        if (!pushed(vector.push[topic.Line](out, l))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the transfer constant `word` names, nil for none
fun transfer_of(word: str) str {
    if (str_equals(word, "jump"))   { ret "effect.JUMP"; }
    if (str_equals(word, "call"))   { ret "effect.CALL"; }
    if (str_equals(word, "return")) { ret "effect.RETURN"; }
    if (str_equals(word, "trap"))   { ret "effect.TRAP"; }
    if (str_equals(word, "merge"))  { ret "effect.MERGE"; }
    ret nil;
}

fun target_of(word: str) str {
    if (str_equals(word, "direct")) { ret "effect.DIRECT"; }
    if (str_equals(word, "none"))   { ret "effect.UNTARGETED"; }
    ret nil;
}

# the operand number `word` names of `ins`, refused when it has none of that index
fun operand_of(l: *topic.Line, ins: *spirv_grammar.Instruction, word: str) res[u8, diag.Refusal] {
    val n: res[i64, diag.Refusal] = topic.number(l.fact, word);
    if (sel n.err)                                   { ret res[u8, diag.Refusal].err{n.err}; }
    if (n.ok < 0 || n.ok::usize >= ins.operands.len) { ret res[u8, diag.Refusal].err{topic.refuse(l.fact, NO_OPERAND, word)}; }
    ret res[u8, diag.Refusal].ok{n.ok::u8};
}

fun controls(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "effects", g::ptr, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "control", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val name: str                        = l.key.data[1];
        val ins:  *spirv_grammar.Instruction = instruction(g, name);
        if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, name); }
        var transfer: str               = nil;
        var target:   str               = nil;
        val t1:       err[diag.Refusal] = topic.needed(l, "transfer", ?transfer);
        if (sel t1.err) { ret t1; }
        val t2: err[diag.Refusal] = topic.needed(l, "target", ?target);
        if (sel t2.err) { ret t2; }
        var c: Control = Control{transfer: transfer_of(transfer), target: target_of(target), operand: field.NO_OPERAND, conditional: false};
        if (c.transfer == nil) { ret topic.reject(l, BAD_TRANSFER, transfer); }
        if (c.target == nil)   { ret topic.reject(l, BAD_TARGET, target); }
        val arg: str = topic.optional(l, "arg", nil);
        if (arg != nil) {
            val at: res[u8, diag.Refusal] = operand_of(l, ins, arg);
            if (sel at.err) { ret err[diag.Refusal].err{at.err}; }
            c.operand = at.ok;
        }
        val cond: res[bool, diag.Refusal] = topic.yes(l, "conditional", false);
        if (sel cond.err) { ret err[diag.Refusal].err{cond.err}; }
        c.conditional = cond.ok;
        var key:   str           = name;
        val known: opt[*Control] = map.get[str, Control](?out.controls, ?key);
        if (sel known.some) { ret topic.reject(l, STATED_TWICE, name); }
        val put: res[bool, A.Error] = map.insert[str, Control](?out.controls, name, c);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# what the grammar states of the literal a width fact names: the kind of the operand, a pair's literal member's, and
# none for a literal whose width the grammar leaves to its context
fun literal_stated(ctx: ptr, f: *topic.Fact) opt[str] {
    val g:  *spirv_grammar.Grammar = ctx::*spirv_grammar.Grammar;
    var at: usize                  = 0;
    for (f.key[at] != 0 && f.key[at] != ' ') { at = at + 1; }
    at = at + 1;
    var end: usize = at;
    for (f.key[end] != 0 && f.key[end] != ' ') { end = end + 1; }
    var name: [128]u8;
    var k:    usize = 0;
    for (at + k < end && k < 127) {
        name[k] = f.key[at + k];
        k       = k + 1;
    }
    name[k] = 0;
    val ins: *spirv_grammar.Instruction = instruction(g, ?name[0]);
    if (ins == nil || f.key[end] == 0) { ret opt[str].none{}; }
    var n: usize = 0;
    var i: usize = end + 1;
    for (f.key[i] >= '0' && f.key[i] <= '9') {
        n = n * 10 + (f.key[i] - '0')::usize;
        i = i + 1;
    }
    if (n >= ins.operands.len) { ret opt[str].none{}; }
    val kind: str                      = ins.operands.data[n].kind;
    val held: opt[*spirv_grammar.Kind] = spirv_grammar.kind(g, kind);
    if (sel held.none)                                     { ret opt[str].none{}; }
    if (str_equals(held.some.category, "Composite"))       { ret opt[str].some{held.some.bases.data[0]}; }
    if (str_equals(kind, "LiteralContextDependentNumber")) { ret opt[str].none{}; }
    ret opt[str].some{kind};
}

fun widths(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "literals", g::ptr, literal_stated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "width", 3)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val ins: *spirv_grammar.Instruction = instruction(g, l.key.data[1]);
        if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[1]); }
        val at: res[u8, diag.Refusal] = operand_of(l, ins, l.key.data[2]);
        if (sel at.err) { ret err[diag.Refusal].err{at.err}; }
        var of: str               = nil;
        val o:  err[diag.Refusal] = topic.needed(l, "of", ?of);
        if (sel o.err) { ret o; }
        val by: res[u8, diag.Refusal] = operand_of(l, ins, of);
        if (sel by.err) { ret err[diag.Refusal].err{by.err}; }
        val kind: str = ins.operands.data[by.ok].kind;
        if (!str_equals(kind, "IdResultType") && !str_equals(kind, "IdRef")) { ret topic.reject(l, NO_OPERAND, of); }
        val literal: str = ins.operands.data[at.ok].kind;
        if (!str_equals(literal, "LiteralContextDependentNumber") && !str_equals(literal, "PairLiteralIntegerIdRef")) { ret topic.reject(l, NOT_A_LITERAL, l.key.data[2]); }
        val key: str = pair(a, l.key.data[1], l.key.data[2]);
        if (key == nil) { ret err[diag.Refusal].err{memory()}; }
        var probe: str      = key;
        val known: opt[*u8] = map.get[str, u8](?out.widths, ?probe);
        if (sel known.some) { ret topic.reject(l, STATED_TWICE, key); }
        val put: res[bool, A.Error] = map.insert[str, u8](?out.widths, key, by.ok);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun imports(a: *A.Allocator, tree: *source.Tree, grammars: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "imports", g::ptr, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "import", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        var x:  Import            = Import{file: l.key.data[1], name: nil, code: 0, requires: nil};
        val n1: err[diag.Refusal] = topic.needed(l, "name", ?x.name);
        if (sel n1.err) { ret n1; }
        var code: str               = nil;
        val n2:   err[diag.Refusal] = topic.needed(l, "code", ?code);
        if (sel n2.err) { ret n2; }
        val c: res[i64, diag.Refusal] = topic.number(l.fact, code);
        if (sel c.err)                  { ret err[diag.Refusal].err{c.err}; }
        if (c.ok <= 0 || c.ok > 0xFFFF) { ret topic.reject(l, topic.BAD_NUMBER, code); }
        x.code     = c.ok::u32;
        x.requires = topic.optional(l, "requires", nil);
        var j: usize = 0;
        for (j < out.imports.len) {
            if (out.imports.data[j].code == x.code || str_equals(out.imports.data[j].name, x.name)) { ret topic.reject(l, STATED_TWICE, x.name); }
            j = j + 1;
        }
        val file: opt[*source.File] = source.find(grammars, x.file);
        if (sel file.none) { ret topic.reject(l, NO_FILE, x.file); }
        val parsed: err[diag.Refusal] = spirv_grammar.read(a, file.some, false, ?x.grammar);
        if (sel parsed.err)                                { ret parsed; }
        if (!pushed(vector.push[Import](?out.imports, x))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun operations(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "operations", g::ptr, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "operation", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val name: str = l.key.data[1];
        if (instruction(g, name) == nil) { ret topic.reject(l, NO_INSTRUCTION, name); }
        var x:   Operation = Operation{name: name, when: nil};
        val any: opt[str]  = topic.only(l);
        if (!(sel any.some && str_equals(any.some, "any"))) {
            val w: err[diag.Refusal] = topic.needed(l, "when", ?x.when);
            if (sel w.err) { ret w; }
        }
        var j: usize = 0;
        for (j < out.operations.len) {
            if (str_equals(out.operations.data[j].name, name)) { ret topic.reject(l, STATED_TWICE, name); }
            j = j + 1;
        }
        if (!pushed(vector.push[Operation](?out.operations, x))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the member `<kind> <enumerant>` names of `g`, none when its kind or the kind's member is not stated
fun member_of(g: *spirv_grammar.Grammar, kind: str, name: str) opt[*spirv_grammar.Enumerant] {
    val k: opt[*spirv_grammar.Kind] = spirv_grammar.kind(g, kind);
    if (sel k.none) { ret opt[*spirv_grammar.Enumerant].none{}; }
    var j: usize = 0;
    for (j < k.some.enumerants.len) {
        if (str_equals(k.some.enumerants.data[j].name, name)) { ret opt[*spirv_grammar.Enumerant].some{?k.some.enumerants.data[j]}; }
        j = j + 1;
    }
    ret opt[*spirv_grammar.Enumerant].none{};
}

fun omissions(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "omissions", g::ptr, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "omit", 3)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val e: opt[*spirv_grammar.Enumerant] = member_of(g, l.key.data[1], l.key.data[2]);
        if (sel e.none) { ret topic.reject(l, NO_MEMBER, l.fact.key); }
        val key: str = pair(a, l.key.data[1], l.key.data[2]);
        if (key == nil) { ret err[diag.Refusal].err{memory()}; }
        val put: res[bool, A.Error] = map.insert[str, bool](?out.omitted, key, true);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# what a mention fact's statement reads: the grammar, and the allocator its statement is spelled with
rec Mentioned {
    alloc:   *A.Allocator;
    grammar: *spirv_grammar.Grammar;
}

# what the grammar states of the member a mention fact names: `capabilities=` its capabilities joined by commas, or
# `none` for a member it gives none
fun capabilities_stated(ctx: ptr, f: *topic.Fact) opt[str] {
    val m:  *Mentioned                            = ctx::*Mentioned;
    val ws: res[vector.Vector[str], diag.Refusal] = topic.words(m.alloc, f, f.key);
    if (sel ws.err)     { ret opt[str].none{}; }
    if (ws.ok.len != 3) { ret opt[str].none{}; }
    val e: opt[*spirv_grammar.Enumerant] = member_of(m.grammar, ws.ok.data[1], ws.ok.data[2]);
    if (sel e.none) { ret opt[str].none{}; }
    val caps: *vector.Vector[str] = ?e.some.gate.capabilities;
    var text: str                 = "none";
    var i:    usize               = 0;
    for (i < caps.len) {
        var r: res[str, StrError] = res[str, StrError].ok{caps.data[i]};
        if (i > 0)     { r = str_join(m.alloc, text, ",", caps.data[i]); }
        if (sel r.err) { ret opt[str].none{}; }
        text = r.ok;
        i    = i + 1;
    }
    val spelled: res[str, StrError] = str_join(m.alloc, "capabilities=", text);
    if (sel spelled.err) { ret opt[str].none{}; }
    ret opt[str].some{spelled.ok};
}

fun mentions(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ctx:  Mentioned                 = Mentioned{alloc: a, grammar: g};
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "mentions", (?ctx)::ptr, capabilities_stated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "mention", 3)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val e: opt[*spirv_grammar.Enumerant] = member_of(g, l.key.data[1], l.key.data[2]);
        if (sel e.none) { ret topic.reject(l, NO_MEMBER, l.fact.key); }
        val only: opt[str] = topic.only(l);
        if (!(sel only.some && str_equals(only.some, "capabilities=none"))) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
        val key: str = pair(a, l.key.data[1], l.key.data[2]);
        if (key == nil) { ret err[diag.Refusal].err{memory()}; }
        var probe: str        = key;
        val known: opt[*bool] = map.get[str, bool](?out.mentioned, ?probe);
        if (sel known.some) { ret topic.reject(l, STATED_TWICE, key); }
        val put: res[bool, A.Error] = map.insert[str, bool](?out.mentioned, key, true);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the facts of the data tree `tree`, held to the core grammar `g`, each import's grammar read from `grammars`
pub fun read(a: *A.Allocator, tree: *source.Tree, grammars: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    @out = Facts{controls: map.init[str, Control](a), widths: map.init[str, u8](a), imports: vector.init[Import](a), operations: vector.init[Operation](a), omitted: map.init[str, bool](a), mentioned: map.init[str, bool](a)};
    val c: err[diag.Refusal] = controls(a, tree, g, out);
    if (sel c.err) { ret c; }
    val w: err[diag.Refusal] = widths(a, tree, g, out);
    if (sel w.err) { ret w; }
    val i: err[diag.Refusal] = imports(a, tree, grammars, g, out);
    if (sel i.err) { ret i; }
    val o: err[diag.Refusal] = operations(a, tree, g, out);
    if (sel o.err) { ret o; }
    val m: err[diag.Refusal] = omissions(a, tree, g, out);
    if (sel m.err) { ret m; }
    ret mentions(a, tree, g, out);
}
