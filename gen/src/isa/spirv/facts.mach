# the facts masc states beside the spir-v grammars, read from the topics of gen/data/spirv
#
# effects names each control transfer, literals the id operand whose type gives a literal its width, imports the
# name and import code of each extended instruction set by the grammar file it is read from, operations the
# operations OpSpecConstantOp takes, omissions the grammar's members masc's operand model does not hold, mentions
# the members an operand names without the capabilities the grammar gives them, accesses the memory each pointer or
# image operand reads or writes and how barriers and atomics order the accesses around them, since the grammars name
# every pointer and image an IdRef, and handles the handle kind each image-family id names, read off its name. each
# topic is held to the grammar it speaks beside: a fact restating it, or naming an instruction, operand or member it
# lacks, is refused naming its line.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use masc.core.field;
use masc.core.operand;

use gen.control;
use gen.diag;
use spirv_grammar: gen.isa.spirv.grammar;
use topic:         gen.overlay;
use gen.source;

pub val NO_INSTRUCTION: str = "fact names an instruction the grammar does not state";
pub val NO_OPERAND:     str = "fact names an operand its instruction does not have";
pub val NO_MEMBER:      str = "fact names an enumerant its kind does not have";
pub val BAD_TRANSFER:   str = "transfer is not jump, call, return, trap or merge";
pub val BAD_TARGET:     str = "target is not direct or none";
pub val STATED_TWICE:   str = "fact stated twice";
pub val NO_FILE:        str = "import names a grammar file the source does not hold";
pub val NOT_A_LITERAL:  str = "width names an operand that holds no literal";
pub val NO_SET:         str = "access names a set that is neither core nor an import";
pub val NOT_AN_ID:      str = "access names an operand that is no single id";
pub val NO_ROLE:        str = "access states neither read, write, both nor none";
pub val BAD_ELEMENT:    str = "element is not pointee, unstated or a width in bits";
pub val BAD_COUNT:      str = "count is not type, unstated or an id operand, or does not fit the element";
pub val BAD_KINDS:      str = "kinds are not letters of r, w, i and o";
pub val NOT_AN_ORDER:   str = "order names an operand of another kind than its semantics or scope";
pub val UNSTATED:       str = "instruction of a memory, image, atomic or barrier class, or with a memory semantics operand, states no access";
pub val UNORDERED:      str = "memory semantics operand no order line names";
pub val BAD_HANDLE:     str = "handle kind is not image, sampler, sampled, image-pointer or none";
pub val UNNAMED:        str = "image-family operand the grammar names that no handle line covers";

# the set name an accesses line gives the core grammar
pub val CORE: str = "core";

# the count of an access that is the components of its result type, or that no operand decides
pub val COUNT_TYPE:     u8 = 0xFE;
pub val COUNT_UNSTATED: u8 = 0xFD;

# a control transfer of a row
# ---
# transfer:    its transfer, as the constant the rows spell
# target:      its target, as the constant the rows spell
# operand:     the operand holding its target, field.NO_OPERAND for none
# conditional: whether it may take another target than its operand's
pub rec Control {
    transfer:    str;
    target:      str;
    operand:     u8;
    conditional: bool;
}

# an extended instruction set
# ---
# file:     the grammar file it is read from
# name:     the name OpExtInstImport imports it by
# code:     its code in the set's import space
# requires: the extension that brings it, nil for none
# grammar:  its grammar
pub rec Import {
    file:     str;
    name:     str;
    code:     u32;
    requires: str;
    grammar:  spirv_grammar.Grammar;
}

# an operation OpSpecConstantOp takes
# ---
# name: its opname
# when: the capability a module declares to use it, nil for every module
pub rec Operation {
    name: str;
    when: str;
}

# an access of an instruction of the core grammar or an extended set, its operands numbered as the grammar numbers the
# instruction's own
# ---
# set:         CORE, or the name of its extended set
# instruction: its opname
# operand:     the operand holding the pointer or image it accesses through, field.NO_OPERAND for an access no operand
#              addresses, as an attachment read
# role:        operand.READ, operand.WRITE, operand.READ_WRITE, or operand.NONE for an operand it accesses nothing
#              through, as an access chain's base, which it only addresses
# bits:        each element's bits, 0 for the pointee's or for an element the types do not fix
# pointee:     whether each element is the pointee of the pointer
# count:       the operand whose type's components count the elements, COUNT_TYPE for the result type's,
#              COUNT_UNSTATED for a count no operand decides, field.NO_OPERAND for one
# size:        the operand whose value decides the count, as OpCopyMemorySized's Size, field.NO_OPERAND for none
# forming:     the further operands that form the address, as an offset in elements or an image coordinate
# governor:    the operand whose value decides whether it accesses, as a predicate, field.NO_OPERAND for none
pub rec Access {
    set:         str;
    instruction: str;
    operand:     u8;
    role:        operand.Role;
    bits:        u32;
    pointee:     bool;
    count:       u8;
    size:        u8;
    forming:     operand.Positions;
    governor:    u8;
}

# how an instruction orders the accesses around it, its operands numbered as the grammar numbers the instruction's own,
# each field.NO_OPERAND for none
# ---
# set:         CORE, or the name of its extended set
# instruction: its opname
# before:      the kinds of access before it it may order, as effect.Kinds
# after:       the kinds of access after it it may order
# semantics:   the memory semantics operand deciding the ordering
# failure:     the memory semantics operand deciding it when its access writes nothing
# scope:       the memory scope operand
# execution:   the execution scope operand of a barrier that waits
pub rec Order {
    set:         str;
    instruction: str;
    before:      u8;
    after:       u8;
    semantics:   u8;
    failure:     u8;
    scope:       u8;
    execution:   u8;
}

# what the topics state
# ---
# controls:   each control transfer by its opname
# widths:     each literal's width operand, by `<opname> <operand>`
# imports:    the extended instruction sets, in their order
# operations: the operations OpSpecConstantOp takes, in their order
# omitted:    each omitted member, by `<kind> <enumerant>`
# mentioned:  each member an operand names under its availability alone, by `<kind> <enumerant>`
# accesses:   each access of an instruction, and each operand it accesses nothing through
# orders:     each instruction that orders the accesses around it
# names:      the handle kind of the id operands the grammar gives each name, by the name
# handles:    the handle kind of an operand the specification gives another than its name's, by `<opname> <operand>`
# results:    the handle kind of each result that is a handle, by its instruction's opname
pub rec Facts {
    controls:   map.Map[str, Control];
    widths:     map.Map[str, u8];
    imports:    vector.Vector[Import];
    operations: vector.Vector[Operation];
    omitted:    map.Map[str, bool];
    mentioned:  map.Map[str, bool];
    accesses:   vector.Vector[Access];
    orders:     vector.Vector[Order];
    names:      map.Map[str, u8];
    handles:    map.Map[str, u8];
    results:    map.Map[str, u8];
}

fun memory() diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, nil);
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun instruction(g: *spirv_grammar.Grammar, name: str) *spirv_grammar.Instruction {
    ret spirv_grammar.instruction(g, name);
}

# the key `<a> <b>` a map of the facts is keyed by
pub fun pair(a: *A.Allocator, x: str, y: str) str {
    val got: res[str, StrError] = str_join(a, x, " ", y);
    if (sel got.err) { ret nil; }
    ret got.ok;
}

# the topic `name` of `tree` read and held to the grammar by `stated`, which reads `ctx`, its facts read as lines into
# `out`
fun lines_of(a: *A.Allocator, tree: *source.Tree, name: str, ctx: ptr, stated: topic.Stated, out: *vector.Vector[topic.Line]) err[diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, name);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, ctx, stated);
    if (sel checked.err) { ret checked; }
    var i: usize = 0;
    for (i < t.facts.len) {
        var l:    topic.Line        = topic.Line{fact: nil};
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err)                             { ret read; }
        if (!pushed(vector.push[topic.Line](out, l))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the transfer constant `word` names, nil for none
fun transfer_of(word: str) str {
    if (str_equals(word, "jump"))   { ret "effect.JUMP"; }
    if (str_equals(word, "call"))   { ret "effect.CALL"; }
    if (str_equals(word, "return")) { ret "effect.RETURN"; }
    if (str_equals(word, "trap"))   { ret "effect.TRAP"; }
    if (str_equals(word, "merge"))  { ret "effect.MERGE"; }
    ret nil;
}

fun target_of(word: str) str {
    if (str_equals(word, "direct")) { ret "effect.DIRECT"; }
    if (str_equals(word, "none"))   { ret "effect.UNTARGETED"; }
    ret nil;
}

# the operand number `word` names of `ins`, refused when it has none of that index
fun operand_of(l: *topic.Line, ins: *spirv_grammar.Instruction, word: str) res[u8, diag.Refusal] {
    val n: res[i64, diag.Refusal] = topic.number(l.fact, word);
    if (sel n.err)                                   { ret res[u8, diag.Refusal].err{n.err}; }
    if (n.ok < 0 || n.ok::usize >= ins.operands.len) { ret res[u8, diag.Refusal].err{topic.refuse(l.fact, NO_OPERAND, word)}; }
    ret res[u8, diag.Refusal].ok{n.ok::u8};
}

fun controls(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "effects", g::ptr, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "control", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val name: str                        = l.key.data[1];
        val ins:  *spirv_grammar.Instruction = instruction(g, name);
        if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, name); }
        var transfer: str               = nil;
        var target:   str               = nil;
        val t1:       err[diag.Refusal] = topic.needed(l, "transfer", ?transfer);
        if (sel t1.err) { ret t1; }
        val t2: err[diag.Refusal] = topic.needed(l, "target", ?target);
        if (sel t2.err) { ret t2; }
        var c: Control = Control{transfer: transfer_of(transfer), target: target_of(target), operand: field.NO_OPERAND, conditional: false};
        if (c.transfer == nil) { ret topic.reject(l, BAD_TRANSFER, transfer); }
        val kind: err[diag.Refusal] = control.classified(l, transfer, ?c.transfer);
        if (sel kind.err)    { ret kind; }
        if (c.target == nil) { ret topic.reject(l, BAD_TARGET, target); }
        val arg: str = topic.optional(l, "arg", nil);
        if (arg != nil) {
            val at: res[u8, diag.Refusal] = operand_of(l, ins, arg);
            if (sel at.err) { ret err[diag.Refusal].err{at.err}; }
            c.operand = at.ok;
        }
        val cond: res[bool, diag.Refusal] = topic.yes(l, "conditional", false);
        if (sel cond.err) { ret err[diag.Refusal].err{cond.err}; }
        c.conditional = cond.ok;
        var key:   str           = name;
        val known: opt[*Control] = map.get[str, Control](?out.controls, ?key);
        if (sel known.some) { ret topic.reject(l, STATED_TWICE, name); }
        val put: res[bool, A.Error] = map.insert[str, Control](?out.controls, name, c);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# what the grammar states of the literal a width fact names: the kind of the operand, a pair's literal member's, and
# none for a literal whose width the grammar leaves to its context
fun literal_stated(ctx: ptr, f: *topic.Fact) opt[str] {
    val g:  *spirv_grammar.Grammar = ctx::*spirv_grammar.Grammar;
    var at: usize                  = 0;
    for (f.key[at] != 0 && f.key[at] != ' ') { at = at + 1; }
    at = at + 1;
    var end: usize = at;
    for (f.key[end] != 0 && f.key[end] != ' ') { end = end + 1; }
    var name: [128]u8;
    var k:    usize = 0;
    for (at + k < end && k < 127) {
        name[k] = f.key[at + k];
        k       = k + 1;
    }
    name[k] = 0;
    val ins: *spirv_grammar.Instruction = instruction(g, ?name[0]);
    if (ins == nil || f.key[end] == 0) { ret opt[str].none{}; }
    var n: usize = 0;
    var i: usize = end + 1;
    for (f.key[i] >= '0' && f.key[i] <= '9') {
        n = n * 10 + (f.key[i] - '0')::usize;
        i = i + 1;
    }
    if (n >= ins.operands.len) { ret opt[str].none{}; }
    val kind: str                      = ins.operands.data[n].kind;
    val held: opt[*spirv_grammar.Kind] = spirv_grammar.kind(g, kind);
    if (sel held.none)                                     { ret opt[str].none{}; }
    if (str_equals(held.some.category, "Composite"))       { ret opt[str].some{held.some.bases.data[0]}; }
    if (str_equals(kind, "LiteralContextDependentNumber")) { ret opt[str].none{}; }
    ret opt[str].some{kind};
}

fun widths(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "literals", g::ptr, literal_stated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "width", 3)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val ins: *spirv_grammar.Instruction = instruction(g, l.key.data[1]);
        if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[1]); }
        val at: res[u8, diag.Refusal] = operand_of(l, ins, l.key.data[2]);
        if (sel at.err) { ret err[diag.Refusal].err{at.err}; }
        var of: str               = nil;
        val o:  err[diag.Refusal] = topic.needed(l, "of", ?of);
        if (sel o.err) { ret o; }
        val by: res[u8, diag.Refusal] = operand_of(l, ins, of);
        if (sel by.err) { ret err[diag.Refusal].err{by.err}; }
        val kind: str = ins.operands.data[by.ok].kind;
        if (!str_equals(kind, "IdResultType") && !str_equals(kind, "IdRef")) { ret topic.reject(l, NO_OPERAND, of); }
        val literal: str = ins.operands.data[at.ok].kind;
        if (!str_equals(literal, "LiteralContextDependentNumber") && !str_equals(literal, "PairLiteralIntegerIdRef")) { ret topic.reject(l, NOT_A_LITERAL, l.key.data[2]); }
        val key: str = pair(a, l.key.data[1], l.key.data[2]);
        if (key == nil) { ret err[diag.Refusal].err{memory()}; }
        var probe: str      = key;
        val known: opt[*u8] = map.get[str, u8](?out.widths, ?probe);
        if (sel known.some) { ret topic.reject(l, STATED_TWICE, key); }
        val put: res[bool, A.Error] = map.insert[str, u8](?out.widths, key, by.ok);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun imports(a: *A.Allocator, tree: *source.Tree, grammars: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "imports", g::ptr, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "import", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        var x:  Import            = Import{file: l.key.data[1], name: nil, code: 0, requires: nil};
        val n1: err[diag.Refusal] = topic.needed(l, "name", ?x.name);
        if (sel n1.err) { ret n1; }
        var code: str               = nil;
        val n2:   err[diag.Refusal] = topic.needed(l, "code", ?code);
        if (sel n2.err) { ret n2; }
        val c: res[i64, diag.Refusal] = topic.number(l.fact, code);
        if (sel c.err)                  { ret err[diag.Refusal].err{c.err}; }
        if (c.ok <= 0 || c.ok > 0xFFFF) { ret topic.reject(l, topic.BAD_NUMBER, code); }
        x.code     = c.ok::u32;
        x.requires = topic.optional(l, "requires", nil);
        var j: usize = 0;
        for (j < out.imports.len) {
            if (out.imports.data[j].code == x.code || str_equals(out.imports.data[j].name, x.name)) { ret topic.reject(l, STATED_TWICE, x.name); }
            j = j + 1;
        }
        val file: opt[*source.File] = source.find(grammars, x.file);
        if (sel file.none) { ret topic.reject(l, NO_FILE, x.file); }
        val parsed: err[diag.Refusal] = spirv_grammar.read(a, file.some, false, ?x.grammar);
        if (sel parsed.err)                                { ret parsed; }
        if (!pushed(vector.push[Import](?out.imports, x))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun operations(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "operations", g::ptr, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "operation", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val name: str = l.key.data[1];
        if (instruction(g, name) == nil) { ret topic.reject(l, NO_INSTRUCTION, name); }
        var x:   Operation = Operation{name: name, when: nil};
        val any: opt[str]  = topic.only(l);
        if (!(sel any.some && str_equals(any.some, "any"))) {
            val w: err[diag.Refusal] = topic.needed(l, "when", ?x.when);
            if (sel w.err) { ret w; }
        }
        var j: usize = 0;
        for (j < out.operations.len) {
            if (str_equals(out.operations.data[j].name, name)) { ret topic.reject(l, STATED_TWICE, name); }
            j = j + 1;
        }
        if (!pushed(vector.push[Operation](?out.operations, x))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the member `<kind> <enumerant>` names of `g`, none when its kind or the kind's member is not stated
fun member_of(g: *spirv_grammar.Grammar, kind: str, name: str) opt[*spirv_grammar.Enumerant] {
    val k: opt[*spirv_grammar.Kind] = spirv_grammar.kind(g, kind);
    if (sel k.none) { ret opt[*spirv_grammar.Enumerant].none{}; }
    var j: usize = 0;
    for (j < k.some.enumerants.len) {
        if (str_equals(k.some.enumerants.data[j].name, name)) { ret opt[*spirv_grammar.Enumerant].some{?k.some.enumerants.data[j]}; }
        j = j + 1;
    }
    ret opt[*spirv_grammar.Enumerant].none{};
}

fun omissions(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "omissions", g::ptr, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "omit", 3)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val e: opt[*spirv_grammar.Enumerant] = member_of(g, l.key.data[1], l.key.data[2]);
        if (sel e.none) { ret topic.reject(l, NO_MEMBER, l.fact.key); }
        val key: str = pair(a, l.key.data[1], l.key.data[2]);
        if (key == nil) { ret err[diag.Refusal].err{memory()}; }
        val put: res[bool, A.Error] = map.insert[str, bool](?out.omitted, key, true);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# what a mention fact's statement reads: the grammar, and the allocator its statement is spelled with
rec Mentioned {
    alloc:   *A.Allocator;
    grammar: *spirv_grammar.Grammar;
}

# what the grammar states of the member a mention fact names: `capabilities=` its capabilities joined by commas, or
# `none` for a member it gives none
fun capabilities_stated(ctx: ptr, f: *topic.Fact) opt[str] {
    val m:  *Mentioned                            = ctx::*Mentioned;
    val ws: res[vector.Vector[str], diag.Refusal] = topic.words(m.alloc, f, f.key);
    if (sel ws.err)     { ret opt[str].none{}; }
    if (ws.ok.len != 3) { ret opt[str].none{}; }
    val e: opt[*spirv_grammar.Enumerant] = member_of(m.grammar, ws.ok.data[1], ws.ok.data[2]);
    if (sel e.none) { ret opt[str].none{}; }
    val caps: *vector.Vector[str] = ?e.some.gate.capabilities;
    var text: str                 = "none";
    var i:    usize               = 0;
    for (i < caps.len) {
        var r: res[str, StrError] = res[str, StrError].ok{caps.data[i]};
        if (i > 0)     { r = str_join(m.alloc, text, ",", caps.data[i]); }
        if (sel r.err) { ret opt[str].none{}; }
        text = r.ok;
        i    = i + 1;
    }
    val spelled: res[str, StrError] = str_join(m.alloc, "capabilities=", text);
    if (sel spelled.err) { ret opt[str].none{}; }
    ret opt[str].some{spelled.ok};
}

fun mentions(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ctx:  Mentioned                 = Mentioned{alloc: a, grammar: g};
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "mentions", (?ctx)::ptr, capabilities_stated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "mention", 3)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val e: opt[*spirv_grammar.Enumerant] = member_of(g, l.key.data[1], l.key.data[2]);
        if (sel e.none) { ret topic.reject(l, NO_MEMBER, l.fact.key); }
        val only: opt[str] = topic.only(l);
        if (!(sel only.some && str_equals(only.some, "capabilities=none"))) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
        val key: str = pair(a, l.key.data[1], l.key.data[2]);
        if (key == nil) { ret err[diag.Refusal].err{memory()}; }
        var probe: str        = key;
        val known: opt[*bool] = map.get[str, bool](?out.mentioned, ?probe);
        if (sel known.some) { ret topic.reject(l, STATED_TWICE, key); }
        val put: res[bool, A.Error] = map.insert[str, bool](?out.mentioned, key, true);
        if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the grammar the set `name` of an accesses line names: the core grammar for CORE, or an import's, nil for none
fun set_grammar(g: *spirv_grammar.Grammar, out: *Facts, name: str) *spirv_grammar.Grammar {
    if (str_equals(name, CORE)) { ret g; }
    var j: usize = 0;
    for (j < out.imports.len) {
        if (str_equals(out.imports.data[j].name, name)) { ret ?out.imports.data[j].grammar; }
        j = j + 1;
    }
    ret nil;
}

# the operand `word` names of `ins`, refused unless it is of kind `kind` and, when `single`, takes one value
fun operand_kind(l: *topic.Line, ins: *spirv_grammar.Instruction, word: str, kind: str, single: bool, message: str) res[u8, diag.Refusal] {
    val at: res[u8, diag.Refusal] = operand_of(l, ins, word);
    if (sel at.err) { ret at; }
    val ref: *spirv_grammar.Ref = ?ins.operands.data[at.ok];
    if (!str_equals(ref.kind, kind) || (single && ref.quantity != operand.ONE)) { ret res[u8, diag.Refusal].err{topic.refuse(l.fact, message, word)}; }
    ret at;
}

# the id operand the named value `name` of line `l` names, field.NO_OPERAND when the line gives none
fun id_named(l: *topic.Line, ins: *spirv_grammar.Instruction, name: str, kind: str, message: str, out: *u8) err[diag.Refusal] {
    @out = field.NO_OPERAND;
    val word: str = topic.optional(l, name, nil);
    if (word == nil) { ret err[diag.Refusal].ok{}; }
    val at: res[u8, diag.Refusal] = operand_kind(l, ins, word, kind, true, message);
    if (sel at.err) { ret err[diag.Refusal].err{at.err}; }
    @out = at.ok;
    ret err[diag.Refusal].ok{};
}

# whether word `w` is a named value of `names`
fun named_any(w: str, names: *str, count: usize) bool {
    var k: usize = 0;
    for (k < count) {
        val n:    str   = names[k];
        val len:  usize = str_len(n);
        var same: bool  = str_len(w) > len && w[len] == '=';
        var c:    usize = 0;
        for (same && c < len) {
            if (w[c] != n[c]) { same = false; }
            c = c + 1;
        }
        if (same) { ret true; }
        k = k + 1;
    }
    ret false;
}

# line `l` refused when a word of its fact past the first `from` is no named value of `names`
fun words_known(l: *topic.Line, from: usize, names: *str, count: usize) err[diag.Refusal] {
    var j: usize = from;
    for (j < l.ws.len) {
        if (!named_any(l.ws.data[j], names, count)) { ret topic.reject(l, topic.UNKNOWN_WORD, l.ws.data[j]); }
        j = j + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the operands a comma-separated list of operand numbers names of `ins`, as positions
fun positions(a: *A.Allocator, l: *topic.Line, ins: *spirv_grammar.Instruction, list: str, out: *operand.Positions) err[diag.Refusal] {
    @out = operand.NO_POSITIONS;
    if (list == nil) { ret err[diag.Refusal].ok{}; }
    var at: usize = 0;
    for {
        var end: usize = at;
        for (list[end] != 0 && list[end] != ',') { end = end + 1; }
        val word: res[str, StrError] = str_copy_slice(a, list, at, end - at);
        if (sel word.err) { ret err[diag.Refusal].err{memory()}; }
        val n: res[u8, diag.Refusal] = operand_of(l, ins, word.ok);
        if (sel n.err) { ret err[diag.Refusal].err{n.err}; }
        @out = @out | ((1::u32) << n.ok::u32);
        if (list[end] == 0) { brk; }
        at = end + 1;
    }
    ret err[diag.Refusal].ok{};
}

val ACCESS_WORDS: [5]str = [5]str{"element", "count", "size", "forming", "governor"};

fun access_line(a: *A.Allocator, l: *topic.Line, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    val name: str                    = l.key.data[1];
    val set:  *spirv_grammar.Grammar = set_grammar(g, out, name);
    if (set == nil) { ret topic.reject(l, NO_SET, name); }
    val ins: *spirv_grammar.Instruction = instruction(set, l.key.data[2]);
    if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[2]); }
    var x: Access = Access{set: name, instruction: ins.name, operand: field.NO_OPERAND, role: operand.NONE, bits: 0, pointee: false, count: field.NO_OPERAND, size: field.NO_OPERAND, forming: operand.NO_POSITIONS, governor: field.NO_OPERAND};
    if (!str_equals(l.key.data[3], "-")) {
        val at: res[u8, diag.Refusal] = operand_kind(l, ins, l.key.data[3], "IdRef", true, NOT_AN_ID);
        if (sel at.err) { ret err[diag.Refusal].err{at.err}; }
        x.operand = at.ok;
    }
    if (l.ws.len == 0) { ret topic.reject(l, NO_ROLE, l.fact.key); }
    val role: str = l.ws.data[0];
    if (str_equals(role, "read"))  { x.role = operand.READ; }
    or (str_equals(role, "write")) { x.role = operand.WRITE; }
    or (str_equals(role, "both"))  { x.role = operand.READ_WRITE; }
    or (!str_equals(role, "none")) { ret topic.reject(l, NO_ROLE, role); }
    or (l.ws.len != 1)             { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
    val known: err[diag.Refusal] = words_known(l, 1, ?ACCESS_WORDS[0], 5);
    if (sel known.err) { ret known; }
    if (x.role != operand.NONE) {
        var element: str               = nil;
        val e:       err[diag.Refusal] = topic.needed(l, "element", ?element);
        if (sel e.err) { ret e; }
        val unstated: bool = str_equals(element, "unstated");
        x.pointee = str_equals(element, "pointee");
        if (x.pointee && x.operand == field.NO_OPERAND) { ret topic.reject(l, BAD_ELEMENT, element); }
        if (!x.pointee && !unstated) {
            val bits: res[i64, diag.Refusal] = topic.number(l.fact, element);
            if (sel bits.err)                   { ret err[diag.Refusal].err{bits.err}; }
            if (bits.ok <= 0 || bits.ok > 1024) { ret topic.reject(l, BAD_ELEMENT, element); }
            x.bits = bits.ok::u32;
        }
        val count: str = topic.optional(l, "count", nil);
        if (count != nil) {
            if (str_equals(count, "type"))     { x.count = COUNT_TYPE; }
            or (str_equals(count, "unstated")) { x.count = COUNT_UNSTATED; }
            or {
                val c: res[u8, diag.Refusal] = operand_kind(l, ins, count, "IdRef", true, BAD_COUNT);
                if (sel c.err) { ret err[diag.Refusal].err{c.err}; }
                x.count = c.ok;
            }
        }
        val sized: err[diag.Refusal] = id_named(l, ins, "size", "IdRef", BAD_COUNT, ?x.size);
        if (sel sized.err)                                                              { ret sized; }
        if (unstated && x.count != COUNT_UNSTATED)                                      { ret topic.reject(l, BAD_COUNT, element); }
        if (x.size != field.NO_OPERAND && (x.bits == 0 || x.count != field.NO_OPERAND)) { ret topic.reject(l, BAD_COUNT, l.fact.fact); }
        if (x.pointee && x.count == COUNT_UNSTATED)                                     { ret topic.reject(l, BAD_COUNT, l.fact.fact); }
        val formed: err[diag.Refusal] = positions(a, l, ins, topic.optional(l, "forming", nil), ?x.forming);
        if (sel formed.err) { ret formed; }
        val governed: err[diag.Refusal] = id_named(l, ins, "governor", "IdRef", NOT_AN_ID, ?x.governor);
        if (sel governed.err) { ret governed; }
    }
    var j: usize = 0;
    for (j < out.accesses.len) {
        val q: *Access = ?out.accesses.data[j];
        if (str_equals(q.set, x.set) && str_equals(q.instruction, x.instruction) && q.operand == x.operand) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
        j = j + 1;
    }
    if (!pushed(vector.push[Access](?out.accesses, x))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# the kinds of access word `w` spells as letters of r, w, i and o, none for a word that spells none or another letter
fun kinds_of(w: str) opt[u8] {
    var k: u8    = 0;
    var i: usize = 0;
    for (w[i] != 0) {
        if (w[i] == 'r') { k = k | 1; }
        or (w[i] == 'w') { k = k | 2; }
        or (w[i] == 'i') { k = k | 4; }
        or (w[i] == 'o') { k = k | 8; }
        or               { ret opt[u8].none{}; }
        i = i + 1;
    }
    if (k == 0) { ret opt[u8].none{}; }
    ret opt[u8].some{k};
}

val ORDER_WORDS: [6]str = [6]str{"before", "after", "semantics", "failure", "scope", "execution"};

fun order_line(l: *topic.Line, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    val name: str                    = l.key.data[1];
    val set:  *spirv_grammar.Grammar = set_grammar(g, out, name);
    if (set == nil) { ret topic.reject(l, NO_SET, name); }
    val ins: *spirv_grammar.Instruction = instruction(set, l.key.data[2]);
    if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[2]); }
    val known: err[diag.Refusal] = words_known(l, 0, ?ORDER_WORDS[0], 6);
    if (sel known.err) { ret known; }
    var x:      Order             = Order{set: name, instruction: ins.name, before: 0, after: 0, semantics: field.NO_OPERAND, failure: field.NO_OPERAND, scope: field.NO_OPERAND, execution: field.NO_OPERAND};
    var before: str               = nil;
    var after:  str               = nil;
    val b:      err[diag.Refusal] = topic.needed(l, "before", ?before);
    if (sel b.err) { ret b; }
    val f: err[diag.Refusal] = topic.needed(l, "after", ?after);
    if (sel f.err) { ret f; }
    val bk: opt[u8] = kinds_of(before);
    val ak: opt[u8] = kinds_of(after);
    if (sel bk.none) { ret topic.reject(l, BAD_KINDS, before); }
    if (sel ak.none) { ret topic.reject(l, BAD_KINDS, after); }
    x.before = bk.some;
    x.after  = ak.some;
    val s1: err[diag.Refusal] = id_named(l, ins, "semantics", "IdMemorySemantics", NOT_AN_ORDER, ?x.semantics);
    if (sel s1.err) { ret s1; }
    val s2: err[diag.Refusal] = id_named(l, ins, "failure", "IdMemorySemantics", NOT_AN_ORDER, ?x.failure);
    if (sel s2.err) { ret s2; }
    val s3: err[diag.Refusal] = id_named(l, ins, "scope", "IdScope", NOT_AN_ORDER, ?x.scope);
    if (sel s3.err) { ret s3; }
    val s4: err[diag.Refusal] = id_named(l, ins, "execution", "IdScope", NOT_AN_ORDER, ?x.execution);
    if (sel s4.err) { ret s4; }
    var j: usize = 0;
    for (j < out.orders.len) {
        val q: *Order = ?out.orders.data[j];
        if (str_equals(q.set, x.set) && str_equals(q.instruction, x.instruction)) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
        j = j + 1;
    }
    if (!pushed(vector.push[Order](?out.orders, x))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# whether core instruction `ins` must state its accesses: one the grammar files as memory, image, atomic or barrier,
# or one taking a memory semantics operand
fun accessing(ins: *spirv_grammar.Instruction) bool {
    val c: str = ins.class;
    if (c != nil && (str_equals(c, "Memory") || str_equals(c, "Image") || str_equals(c, "Atomic") || str_equals(c, "Barrier"))) { ret true; }
    var k: usize = 0;
    for (k < ins.operands.len) {
        if (str_equals(ins.operands.data[k].kind, "IdMemorySemantics")) { ret true; }
        k = k + 1;
    }
    ret false;
}

# every core instruction that must state its accesses held to stating one, and each of its memory semantics operands to
# an order naming it
fun covered(g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var i: usize = 0;
    for (i < g.instructions.len) {
        val ins: *spirv_grammar.Instruction = ?g.instructions.data[i];
        if (accessing(ins)) {
            var stated: bool   = false;
            var order:  *Order = nil;
            var j:      usize  = 0;
            for (j < out.accesses.len) {
                if (str_equals(out.accesses.data[j].set, CORE) && str_equals(out.accesses.data[j].instruction, ins.name)) { stated = true; }
                j = j + 1;
            }
            j = 0;
            for (j < out.orders.len) {
                if (str_equals(out.orders.data[j].set, CORE) && str_equals(out.orders.data[j].instruction, ins.name)) { order = ?out.orders.data[j]; }
                j = j + 1;
            }
            if (!stated && order == nil) { ret err[diag.Refusal].err{diag.refusal(nil, 0, UNSTATED, ins.name)}; }
            var k: usize = 0;
            for (k < ins.operands.len) {
                if (str_equals(ins.operands.data[k].kind, "IdMemorySemantics") && (order == nil || (order.semantics::usize != k && order.failure::usize != k))) { ret err[diag.Refusal].err{diag.refusal(nil, 0, UNORDERED, ins.name)}; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun accesses(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "accesses", g::ptr, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (topic.is(l, "access", 4)) {
            val x: err[diag.Refusal] = access_line(a, l, g, out);
            if (sel x.err) { ret x; }
        }
        or (topic.is(l, "order", 3)) {
            val o: err[diag.Refusal] = order_line(l, g, out);
            if (sel o.err) { ret o; }
        }
        or { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        i = i + 1;
    }
    ret covered(g, out);
}

# the handle kind word `w` names, as `spirv_kind` numbers them, none for no kind's word
fun handle_of(w: str) opt[u8] {
    if (str_equals(w, "none"))          { ret opt[u8].some{0}; }
    if (str_equals(w, "image"))         { ret opt[u8].some{1}; }
    if (str_equals(w, "sampler"))       { ret opt[u8].some{2}; }
    if (str_equals(w, "sampled"))       { ret opt[u8].some{3}; }
    if (str_equals(w, "image-pointer")) { ret opt[u8].some{4}; }
    ret opt[u8].none{};
}

# whether `text` holds `word`, ignoring case
fun holds(text: str, word: str) bool {
    if (text == nil) { ret false; }
    val n: usize = str_len(word);
    var i: usize = 0;
    for (text[i] != 0) {
        var k: usize = 0;
        for (k < n && text[i + k] != 0) {
            var c: u8 = text[i + k];
            if (c >= 'A' && c <= 'Z') { c = c + 32; }
            if (c != word[k])         { brk; }
            k = k + 1;
        }
        if (k == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the grammar's name `name` of an id operand names one of the image family
fun image_family(name: str) bool {
    ret holds(name, "image") || holds(name, "sampler") || holds(name, "texture");
}

fun put_kind(m: *map.Map[str, u8], l: *topic.Line, key: str, kind: u8) err[diag.Refusal] {
    var probe: str      = key;
    val known: opt[*u8] = map.get[str, u8](m, ?probe);
    if (sel known.some) { ret topic.reject(l, STATED_TWICE, key); }
    val put: res[bool, A.Error] = map.insert[str, u8](m, key, kind);
    if (sel put.err) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# every image-family id operand of the instructions of `g` held to a handle line naming its name or it
fun named_handles(a: *A.Allocator, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var i: usize = 0;
    for (i < g.instructions.len) {
        val ins: *spirv_grammar.Instruction = ?g.instructions.data[i];
        var k:   usize                      = 0;
        for (k < ins.operands.len) {
            val ref: *spirv_grammar.Ref = ?ins.operands.data[k];
            if (str_equals(ref.kind, "IdRef") && image_family(ref.name)) {
                var name:   str      = ref.name;
                val named:  opt[*u8] = map.get[str, u8](?out.names, ?name);
                var digits: [4]u8;
                digits[0] = '0' + (k / 10 % 10)::u8;
                digits[1] = '0' + (k % 10)::u8;
                digits[2] = 0;
                var at: usize = 0;
                if (k < 10) { at = 1; }
                var key:  str      = pair(a, ins.name, ?digits[at]);
                val over: opt[*u8] = map.get[str, u8](?out.handles, ?key);
                if (sel named.none && sel over.none) { ret err[diag.Refusal].err{diag.refusal(nil, 0, UNNAMED, key)}; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun handles(a: *A.Allocator, tree: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:   vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val read: err[diag.Refusal]         = lines_of(a, tree, "handles", g::ptr, topic.unstated, ?ls);
    if (sel read.err) { ret read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l:    *topic.Line = ?ls.data[i];
        val only: opt[str]    = topic.only(l);
        if (sel only.none) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
        val kind: opt[u8] = handle_of(only.some);
        if (sel kind.none) { ret topic.reject(l, BAD_HANDLE, only.some); }
        if (topic.is(l, "name", 2)) {
            val p: err[diag.Refusal] = put_kind(?out.names, l, l.key.data[1], kind.some);
            if (sel p.err) { ret p; }
        }
        or (topic.is(l, "operand", 3)) {
            val ins: *spirv_grammar.Instruction = instruction(g, l.key.data[1]);
            if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[1]); }
            val at: res[u8, diag.Refusal] = operand_kind(l, ins, l.key.data[2], "IdRef", false, NOT_AN_ID);
            if (sel at.err) { ret err[diag.Refusal].err{at.err}; }
            val key: str = pair(a, ins.name, l.key.data[2]);
            if (key == nil) { ret err[diag.Refusal].err{memory()}; }
            val p: err[diag.Refusal] = put_kind(?out.handles, l, key, kind.some);
            if (sel p.err) { ret p; }
        }
        or (topic.is(l, "result", 2)) {
            val ins: *spirv_grammar.Instruction = instruction(g, l.key.data[1]);
            if (ins == nil || ins.operands.len < 2 || !str_equals(ins.operands.data[1].kind, "IdResult")) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[1]); }
            val p: err[diag.Refusal] = put_kind(?out.results, l, ins.name, kind.some);
            if (sel p.err) { ret p; }
        }
        or { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        i = i + 1;
    }
    val core: err[diag.Refusal] = named_handles(a, g, out);
    if (sel core.err) { ret core; }
    var j: usize = 0;
    for (j < out.imports.len) {
        val set: err[diag.Refusal] = named_handles(a, ?out.imports.data[j].grammar, out);
        if (sel set.err) { ret set; }
        j = j + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the facts of the data tree `tree`, held to the core grammar `g`, each import's grammar read from `grammars`
pub fun read(a: *A.Allocator, tree: *source.Tree, grammars: *source.Tree, g: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    @out = Facts{controls: map.init[str, Control](a), widths: map.init[str, u8](a), imports: vector.init[Import](a), operations: vector.init[Operation](a), omitted: map.init[str, bool](a), mentioned: map.init[str, bool](a), accesses: vector.init[Access](a), orders: vector.init[Order](a), names: map.init[str, u8](a), handles: map.init[str, u8](a), results: map.init[str, u8](a)};
    val c: err[diag.Refusal] = controls(a, tree, g, out);
    if (sel c.err) { ret c; }
    val w: err[diag.Refusal] = widths(a, tree, g, out);
    if (sel w.err) { ret w; }
    val i: err[diag.Refusal] = imports(a, tree, grammars, g, out);
    if (sel i.err) { ret i; }
    val o: err[diag.Refusal] = operations(a, tree, g, out);
    if (sel o.err) { ret o; }
    val m: err[diag.Refusal] = omissions(a, tree, g, out);
    if (sel m.err) { ret m; }
    val n: err[diag.Refusal] = mentions(a, tree, g, out);
    if (sel n.err) { ret n; }
    val x: err[diag.Refusal] = accesses(a, tree, g, out);
    if (sel x.err) { ret x; }
    ret handles(a, tree, g, out);
}
