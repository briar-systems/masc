# the facts masc states beside mink's spir-v grammar, read from the topics of gen/data/spirv
#
# effects names each control transfer, imports the import code of each extended instruction set by the name
# OpExtInstImport imports it by, versions the spir-v version each extension needs that the grammar leaves unstated,
# operations the operations OpSpecConstantOp takes, omissions the grammar's members masc's operand model does not hold,
# brings the extensions that bring a member the grammar names none for, mentions the members an operand names without
# the capabilities the grammar gives
# them, accesses the memory each pointer or image operand reads or writes and how barriers and atomics order the
# accesses around them, since the grammar names every pointer and image an IdRef, handles the handle kind each
# image-family id names, read off its name, and typings the types each instruction's result and value operands are held
# to and the types a typed instruction's data may be. each topic is held to the grammar it speaks beside: a fact restating it,
# or naming an instruction, operand or member it lacks, is refused naming its line.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use mink.base.fail.Fail;
use mink.base.store.Bytes;
use spirv_grammar: mink.format.spirv.grammar;

use masc.core.field;
use masc.core.operand;

use gen.control;
use gen.diag;
use spirv_index: gen.isa.spirv.index;
use topic:       gen.overlay;
use gen.source;

pub val NO_INSTRUCTION:   str = "fact names an instruction the grammar does not state";
pub val NO_OPERAND:       str = "fact names an operand its instruction does not have";
pub val NO_MEMBER:        str = "fact names an enumerant its kind does not have";
pub val BAD_TRANSFER:     str = "transfer is not jump, call, return, trap or merge";
pub val BAD_TARGET:       str = "target is not direct or none";
pub val STATED_TWICE:     str = "fact stated twice";
pub val NO_IMPORT:        str = "import names an extended instruction set the grammar does not state";
pub val NO_SET:           str = "access names a set that is neither core nor an import";
pub val NOT_AN_ID:        str = "access names an operand that is no single id";
pub val NO_ROLE:          str = "access states neither read, write, both nor none";
pub val BAD_ELEMENT:      str = "element is not pointee, unstated or a width in bits";
pub val BAD_COUNT:        str = "count is not type, unstated or an id operand, or does not fit the element";
pub val BAD_KINDS:        str = "kinds are not letters of r, w, i and o";
pub val NOT_AN_ORDER:     str = "order names an operand of another kind than its semantics or scope";
pub val UNSTATED:         str = "core instruction of a class no quiet line names states no access or order";
pub val QUIET_STATED:     str = "core instruction of a class a quiet line names states an access or order";
pub val NO_CLASS:         str = "quiet names a class no core instruction is filed under";
pub val UNORDERED:        str = "memory semantics operand no order line names";
pub val BAD_HANDLE:       str = "handle kind is not image, sampler, sampled, image-pointer or none";
pub val UNNAMED:          str = "image-family operand the grammar names that no handle line covers";
pub val NOT_A_VALUE:      str = "typing names an operand that is no single or optional value id, or the result of an instruction with none";
pub val BAD_VALUE:        str = "form's value is not zero or power";
pub val VALUE_UNCONSTANT: str = "form names a value or dims of a constant it does not ask";
pub val BAD_CLASS:        str = "class is not any, float, integer, signed, unsigned, number or truth";
pub val BAD_SHAPE:        str = "shape is not scalar or vector";
pub val TWO_RELATIONS:    str = "form relates its slot to two others";
pub val UNTIL_UNCONSTANT: str = "form names a version that lifts a constant it does not ask, or asks its result be a constant";
pub val BAD_TYPED:        str = "typed type is not int or float with a width and lanes, followed by `=` and its alternatives";
pub val NO_CAPABILITY:    str = "typed type or image line names a capability the grammar does not state";
pub val NOT_OPTIONAL:     str = "present names an operand that is no optional value id";
pub val NOT_ENUMERANT:    str = "present names a value its enumerant operand's kind does not have";
pub val NOT_A_MASK:       str = "image names a mask operand that is no Image Operands";
pub val NO_BIT:           str = "image names a bit, Dim or format the grammar does not state";
pub val BAD_PROPERTY:     str = "image property is not yes or no";
pub val BAD_AVAILABLE:    str = "available names environments other than none";
pub val BAD_POINTER:      str = "form's pointer is not yes, physical or compared";
pub val NOT_LITERALS:     str = "form's within names no slot, or a form of literals asks a class, shape, width, value or relation other than count";

# the set name an accesses line gives the core grammar
pub val CORE: str = "core";

# the slot of a typing that is the instruction's result
pub val RESULT: u8 = 0xFF;

# the count of an access that is the components of its result type, or that no operand decides
pub val COUNT_TYPE:     u8 = 0xFE;
pub val COUNT_UNSTATED: u8 = 0xFD;

# a control transfer of a row
# ---
# transfer:    its transfer, as the constant the rows spell
# target:      its target, as the constant the rows spell
# operand:     the operand holding its target, field.NO_OPERAND for none
# conditional: whether it may take another target than its operand's
pub rec Control {
    transfer:    str;
    target:      str;
    operand:     u8;
    conditional: bool;
}

# an extended instruction set
# ---
# name:         the name OpExtInstImport imports it by
# code:         its code in the set's import space
# requires:     the extension that brings it, nil for none
# core:         the minor version of SPIR-V 1 whose core holds it without the extension, -1 for none
# instructions: its instructions, as the grammar states them
pub rec Import {
    name:         str;
    code:         u32;
    requires:     str;
    core:         i64;
    instructions: spirv_index.Instructions;
}

# the spir-v version an extension needs before a module may declare it
# ---
# extension: its name
# minor:     the minor version of SPIR-V 1 it needs
pub rec Version {
    extension: str;
    minor:     i64;
}

# a member the grammar names no extension for that extensions bring
# ---
# kind:       its operand kind
# member:     its enumerant
# extensions: the extensions that bring it, which stand for the grammar's
pub rec Brought {
    kind:       str;
    member:     str;
    extensions: vector.Vector[str];
}

# an operation OpSpecConstantOp takes
# ---
# name: its opname
# when: the capability a module declares to use it, nil for every module
pub rec Operation {
    name: str;
    when: str;
}

# an access of an instruction of the core grammar or an extended set, its operands numbered as the grammar numbers the
# instruction's own
# ---
# set:         CORE, or the name of its extended set
# instruction: its opname
# operand:     the operand holding the pointer or image it accesses through, field.NO_OPERAND for an access no operand
#              addresses, as an attachment read
# role:        operand.READ, operand.WRITE, operand.READ_WRITE, or operand.NONE for an operand it accesses nothing
#              through, as an access chain's base, which it only addresses
# bits:        each element's bits, 0 for the pointee's or for an element the types do not fix
# pointee:     whether each element is the pointee of the pointer
# count:       the operand whose type's components count the elements, COUNT_TYPE for the result type's,
#              COUNT_UNSTATED for a count no operand decides, field.NO_OPERAND for one
# size:        the operand whose value decides the count, as OpCopyMemorySized's Size, field.NO_OPERAND for none
# forming:     the further operands that form the address, as an offset in elements or an image coordinate
# governor:    the operand whose value decides whether it accesses, as a predicate, field.NO_OPERAND for none
pub rec Access {
    set:         str;
    instruction: str;
    operand:     u8;
    role:        operand.Role;
    bits:        u32;
    pointee:     bool;
    count:       u8;
    size:        u8;
    forming:     operand.Positions;
    governor:    u8;
}

# how an instruction orders the accesses around it, its operands numbered as the grammar numbers the instruction's own,
# each field.NO_OPERAND for none
# ---
# set:         CORE, or the name of its extended set
# instruction: its opname
# before:      the kinds of access before it it may order, as effect.Kinds
# after:       the kinds of access after it it may order
# semantics:   the memory semantics operand deciding the ordering
# failure:     the memory semantics operand deciding it when its access writes nothing
# scope:       the memory scope operand
# execution:   the execution scope operand of a barrier that waits
pub rec Order {
    set:         str;
    instruction: str;
    before:      u8;
    after:       u8;
    semantics:   u8;
    failure:     u8;
    scope:       u8;
    execution:   u8;
}

# what one slot of an instruction's typing must be, its slots numbered as the grammar numbers the instruction's own
# operands, RESULT for its result, with the meanings of masc.isa.spirv.typing
# ---
# set:         CORE, or the name of its extended set
# instruction: its opname
# slot:        the slot it holds
# pointer:     whether it is a pointer the instruction reads and writes nothing through, as typing.Pointed
# class:       the number its type is a scalar or vector of, as typing.Class
# shape:       whether it is a scalar, a vector or either, as typing.Shape
# lanes:       its component count, 0 for any
# bits:        its component's width, 0 for any
# widest:      its component's widest width, 0 for any
# relation:    how it relates to slot `to`, as typing.Relation
# to:          the slot it relates to
# constant:    whether it must be the id of a constant instruction
# until:       the version from which it need not be, as the catalog names it, nil where every version holds it
# value:       what the constant's value must be, as typing.Value
# dims:        the Dims of the row's image under which the constant and its value are asked, bit n for the Dim of value
#              n, 0 for any
# within:      the slots each of its values indexes a component of, taken in order as one run, bit n for slot n, 0 for
#              none
pub rec Form {
    set:         str;
    instruction: str;
    slot:        u8;
    pointer:     u8;
    class:       u8;
    shape:       u8;
    lanes:       u8;
    bits:        u8;
    widest:      u8;
    relation:    u8;
    to:          u8;
    constant:    bool;
    until:       str;
    value:       u8;
    dims:        u32;
    within:      u32;
}

# one type a typed instruction's data may be or point to
# ---
# float: whether it is a float, else an integer
# bits:  its component's width, 0 for any
# lanes: its component count, 1 for a scalar, 0 for a vector of any count
# ways:  the alternatives of what it needs, each the capabilities it names, none for nothing
pub rec Kind {
    float: bool;
    bits:  u8;
    lanes: u8;
    ways:  vector.Vector[vector.Vector[str]];
}

# an optional operand an instruction takes exactly when an enumerant operand holds one value, its operands numbered as
# the grammar numbers them
# ---
# set:         CORE, or the name of its extended set
# instruction: its opname
# operand:     the optional operand
# when:        the enumerant operand
# value:       the value that brings it
# constant:    whether it must be a constant
pub rec Present {
    set:         str;
    instruction: str;
    operand:     u8;
    when:        u8;
    value:       u32;
    constant:    bool;
}

# what an image instruction holds its image and Image Operands to, its operands numbered as the grammar numbers them,
# with the meanings of masc.isa.spirv.typing.Imaged
pub rec Image {
    set:          str;
    instruction:  str;
    image:        u8;
    mask:         u8;
    admits:       u32;
    one:          u32;
    exclusive:    u32;
    paired:       u32;
    pairing:      u32;
    sampled:      u32;
    uncubed:      u32;
    constants:    u32;
    dims:         u32;
    depth:        bool;
    multisampled: u8;
    arrayed:      u8;
    levels:       u8;
    unformatted:  str;
    formats:      u64;
}

# the number an image format's texels are read as, with the meanings of masc.isa.spirv.typing.Format
# ---
# name:  the format, as the grammar names it
# value: its value
# class: the number class of its components, as typing.Class
# bits:  their width
# lanes: how many components it stores
pub rec Format {
    name:  str;
    value: u32;
    class: u8;
    bits:  u8;
    lanes: u8;
}

# an instruction of a set's grammar no environment admits, with the meaning of masc.isa.spirv.typing.Typing's withdrawn
# ---
# set:         CORE, or the name of its extended set
# instruction: its opname
# why:         the line's citation, which a refusal quotes
pub rec Withdrawn {
    set:         str;
    instruction: str;
    why:         str;
}

# the execution models an instruction executes in, with the meanings of masc.isa.spirv.typing.Executes
pub rec Stage {
    set:         str;
    instruction: str;
    models:      u32;
    names:       str;
}

# the types a typed instruction's data operand may be or point to, its operand numbered as the grammar numbers them
pub rec Typed {
    set:         str;
    instruction: str;
    operand:     u8;
    kinds:       vector.Vector[Kind];
}

# what the topics state
# ---
# controls:   each control transfer by its opname
# imports:    the extended instruction sets, in their order
# versions:   the version each extension the topic names needs, in their order
# operations: the operations OpSpecConstantOp takes, in their order
# omitted:    each omitted member, by `<kind> <enumerant>`
# mentioned:  each member an operand names under its availability alone, by `<kind> <enumerant>`
# brought:    each member the grammar names no extension for that extensions bring
# accesses:   each access of an instruction, and each operand it accesses nothing through
# orders:     each instruction that orders the accesses around it
# quiet:      each class of the core grammar whose instructions access nothing and order nothing, by its name
# names:      the handle kind of the id operands the grammar gives each name, by the name
# handles:    the handle kind of an operand the specification gives another than its name's, by `<opname> <operand>`
# results:    the handle kind of each result that is a handle, by its instruction's opname
# forms:      each slot's form, in their order
# typed:      each typed instruction's types, in their order
# present:    each optional operand an enumerant value brings, in their order
# images:     each image instruction's rules, in their order
pub rec Facts {
    controls:   map.Map[str, Control];
    imports:    vector.Vector[Import];
    versions:   vector.Vector[Version];
    operations: vector.Vector[Operation];
    omitted:    map.Map[str, bool];
    mentioned:  map.Map[str, bool];
    brought:    vector.Vector[Brought];
    accesses:   vector.Vector[Access];
    orders:     vector.Vector[Order];
    quiet:      map.Map[str, bool];
    names:      map.Map[str, u8];
    handles:    map.Map[str, u8];
    results:    map.Map[str, u8];
    forms:      vector.Vector[Form];
    typed:      vector.Vector[Typed];
    present:    vector.Vector[Present];
    images:     vector.Vector[Image];
    stages:     vector.Vector[Stage];
    withdrawn:  vector.Vector[Withdrawn];
    formats:    vector.Vector[Format];
}

fun memory() diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, nil);
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# the key `<a> <b>` a map of the facts is keyed by
pub fun pair(a: *A.Allocator, x: str, y: str) str {
    val res_str_join: res[str, StrError] = str_join(a, x, " ", y);
    if (sel res_str_join.err) { ret nil; }
    ret res_str_join.ok;
}

# the topic `name` of `tree` read and held to the grammar by `stated`, which reads `ctx`, its facts read as lines into
# `out`
fun lines_of(a: *A.Allocator, tree: *source.Tree, name: str, ctx: ptr, stated: topic.Stated, out: *vector.Vector[topic.Line]) err[diag.Refusal] {
    val res_read: res[topic.Topic, diag.Refusal] = topic.read(a, tree, name);
    if (sel res_read.err) { ret err[diag.Refusal].err{res_read.err}; }
    var t:           topic.Topic       = res_read.ok;
    val err_checked: err[diag.Refusal] = topic.check(?t, ctx, stated);
    if (sel err_checked.err) { ret err_checked; }
    var i: usize = 0;
    for (i < t.facts.len) {
        var l:        topic.Line        = topic.Line{fact: nil};
        val err_read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel err_read.err)                         { ret err_read; }
        if (!pushed(vector.push[topic.Line](out, l))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the transfer constant `word` names, nil for none
fun transfer_of(word: str) str {
    if (str_equals(word, "jump"))   { ret "effect.JUMP"; }
    if (str_equals(word, "call"))   { ret "effect.CALL"; }
    if (str_equals(word, "return")) { ret "effect.RETURN"; }
    if (str_equals(word, "trap"))   { ret "effect.TRAP"; }
    if (str_equals(word, "merge"))  { ret "effect.MERGE"; }
    ret nil;
}

fun target_of(word: str) str {
    if (str_equals(word, "direct")) { ret "effect.DIRECT"; }
    if (str_equals(word, "none"))   { ret "effect.UNTARGETED"; }
    ret nil;
}

# the operand number `word` names of `ins`, refused when it has none of that index
fun operand_of(l: *topic.Line, ins: *spirv_index.Instruction, word: str) res[u8, diag.Refusal] {
    val res_number: res[i64, diag.Refusal] = topic.number(l.fact, word);
    if (sel res_number.err)                                     { ret res[u8, diag.Refusal].err{res_number.err}; }
    if (res_number.ok < 0 || res_number.ok::usize >= ins.count) { ret res[u8, diag.Refusal].err{topic.refuse(l.fact, NO_OPERAND, word)}; }
    ret res[u8, diag.Refusal].ok{res_number.ok::u8};
}

fun controls(a: *A.Allocator, tree: *source.Tree, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val err_read: err[diag.Refusal]         = lines_of(a, tree, "effects", g::ptr, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "control", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val name: str                      = l.key.data[1];
        val ins:  *spirv_index.Instruction = spirv_index.find(g, name);
        if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, name); }
        var transfer:           str               = nil;
        var target:             str               = nil;
        val err_transfer_found: err[diag.Refusal] = topic.needed(l, "transfer", ?transfer);
        if (sel err_transfer_found.err) { ret err_transfer_found; }
        val err_target_found: err[diag.Refusal] = topic.needed(l, "target", ?target);
        if (sel err_target_found.err) { ret err_target_found; }
        var c: Control = Control{transfer: transfer_of(transfer), target: target_of(target), operand: field.NO_OPERAND, conditional: false};
        if (c.transfer == nil) { ret topic.reject(l, BAD_TRANSFER, transfer); }
        val err_kind: err[diag.Refusal] = control.classified(l, transfer, ?c.transfer);
        if (sel err_kind.err) { ret err_kind; }
        if (c.target == nil)  { ret topic.reject(l, BAD_TARGET, target); }
        val arg: str = topic.optional(l, "arg", nil);
        if (arg != nil) {
            val res_operand_of: res[u8, diag.Refusal] = operand_of(l, ins, arg);
            if (sel res_operand_of.err) { ret err[diag.Refusal].err{res_operand_of.err}; }
            c.operand = res_operand_of.ok;
        }
        val res_cond: res[bool, diag.Refusal] = topic.yes(l, "conditional", false);
        if (sel res_cond.err) { ret err[diag.Refusal].err{res_cond.err}; }
        c.conditional = res_cond.ok;
        var key:       str           = name;
        val opt_known: opt[*Control] = map.get[str, Control](?out.controls, ?key);
        if (sel opt_known.some) { ret topic.reject(l, STATED_TWICE, name); }
        val res_put: res[bool, A.Error] = map.insert[str, Control](?out.controls, name, c);
        if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun imports(a: *A.Allocator, tree: *source.Tree, gr: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val err_read: err[diag.Refusal]         = lines_of(a, tree, "imports", gr::ptr, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "import", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        var x:              Import            = Import{name: l.key.data[1], code: 0, requires: nil, core: -1};
        var code:           str               = nil;
        val err_code_found: err[diag.Refusal] = topic.needed(l, "code", ?code);
        if (sel err_code_found.err) { ret err_code_found; }
        val res_number: res[i64, diag.Refusal] = topic.number(l.fact, code);
        if (sel res_number.err)                           { ret err[diag.Refusal].err{res_number.err}; }
        if (res_number.ok <= 0 || res_number.ok > 0xFFFF) { ret topic.reject(l, topic.BAD_NUMBER, code); }
        x.code     = res_number.ok::u32;
        x.requires = topic.optional(l, "requires", nil);
        val core: str = topic.optional(l, "core", nil);
        if (core != nil) {
            if (x.requires == nil || str_len(core) < 3 || core[0] != '1' || core[1] != '.') { ret topic.reject(l, topic.BAD_FACT, core); }
            val res_minor: res[i64, diag.Refusal] = topic.number(l.fact, ?core[2]);
            if (sel res_minor.err) { ret err[diag.Refusal].err{res_minor.err}; }
            x.core = res_minor.ok;
        }
        var j: usize = 0;
        for (j < out.imports.len) {
            if (out.imports.data[j].code == x.code || str_equals(out.imports.data[j].name, x.name)) { ret topic.reject(l, STATED_TWICE, x.name); }
            j = j + 1;
        }
        val res_set: res[*spirv_grammar.Set, Fail] = spirv_grammar.set(gr, Bytes{data: x.name::*u8, len: str_len(x.name)});
        if (sel res_set.err) { ret topic.reject(l, NO_IMPORT, x.name); }
        val res_listed: res[spirv_index.Instructions, diag.Refusal] = spirv_index.set(a, res_set.ok);
        if (sel res_listed.err) { ret err[diag.Refusal].err{res_listed.err}; }
        x.instructions = res_listed.ok;
        if (!pushed(vector.push[Import](?out.imports, x))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun versions(a: *A.Allocator, tree: *source.Tree, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val err_read: err[diag.Refusal]         = lines_of(a, tree, "versions", nil, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "version", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        var core:           str               = nil;
        val err_core_found: err[diag.Refusal] = topic.needed(l, "core", ?core);
        if (sel err_core_found.err)                                { ret err_core_found; }
        if (str_len(core) < 3 || core[0] != '1' || core[1] != '.') { ret topic.reject(l, topic.BAD_FACT, core); }
        val res_minor: res[i64, diag.Refusal] = topic.number(l.fact, ?core[2]);
        if (sel res_minor.err) { ret err[diag.Refusal].err{res_minor.err}; }
        var j: usize = 0;
        for (j < out.versions.len) {
            if (str_equals(out.versions.data[j].extension, l.key.data[1])) { ret topic.reject(l, STATED_TWICE, l.key.data[1]); }
            j = j + 1;
        }
        if (!pushed(vector.push[Version](?out.versions, Version{extension: l.key.data[1], minor: res_minor.ok}))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun operations(a: *A.Allocator, tree: *source.Tree, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val err_read: err[diag.Refusal]         = lines_of(a, tree, "operations", g::ptr, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "operation", 2)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val name: str = l.key.data[1];
        if (spirv_index.find(g, name) == nil) { ret topic.reject(l, NO_INSTRUCTION, name); }
        var x:       Operation = Operation{name: name, when: nil};
        val opt_any: opt[str]  = topic.only(l);
        if (!(sel opt_any.some && str_equals(opt_any.some, "any"))) {
            val err_needed: err[diag.Refusal] = topic.needed(l, "when", ?x.when);
            if (sel err_needed.err) { ret err_needed; }
        }
        var j: usize = 0;
        for (j < out.operations.len) {
            if (str_equals(out.operations.data[j].name, name)) { ret topic.reject(l, STATED_TWICE, name); }
            j = j + 1;
        }
        if (!pushed(vector.push[Operation](?out.operations, x))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the member `<kind> <enumerant>` names of `g`, none when its kind or the kind's member is not stated
fun member_of(gr: *spirv_grammar.Grammar, kind: str, name: str) opt[*spirv_grammar.Enumerant] {
    val res_kind: res[*spirv_grammar.Kind, Fail] = spirv_grammar.kind(gr, kind);
    if (sel res_kind.err) { ret opt[*spirv_grammar.Enumerant].none{}; }
    val e: *spirv_grammar.Enum = spirv_index.enumerants(res_kind.ok);
    if (e == nil) { ret opt[*spirv_grammar.Enumerant].none{}; }
    var j: usize = 0;
    for (j < e.count) {
        if (str_equals(e.enumerants[j].name, name)) { ret opt[*spirv_grammar.Enumerant].some{?e.enumerants[j]}; }
        j = j + 1;
    }
    ret opt[*spirv_grammar.Enumerant].none{};
}

fun omissions(a: *A.Allocator, tree: *source.Tree, gr: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val err_read: err[diag.Refusal]         = lines_of(a, tree, "omissions", gr::ptr, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "omit", 3)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val opt_member_of: opt[*spirv_grammar.Enumerant] = member_of(gr, l.key.data[1], l.key.data[2]);
        if (sel opt_member_of.none) { ret topic.reject(l, NO_MEMBER, l.fact.key); }
        val key: str = pair(a, l.key.data[1], l.key.data[2]);
        if (key == nil) { ret err[diag.Refusal].err{memory()}; }
        val res_put: res[bool, A.Error] = map.insert[str, bool](?out.omitted, key, true);
        if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# what a mention fact's statement reads: the grammar, and the allocator its statement is spelled with
rec Mentioned {
    alloc:   *A.Allocator;
    grammar: *spirv_grammar.Grammar;
}

# what the grammar states of the member a mention fact names: `capabilities=` its capabilities joined by commas, or
# `none` for a member it gives none
fun capabilities_stated(ctx: ptr, f: *topic.Fact) opt[str] {
    val m:         *Mentioned                            = ctx::*Mentioned;
    val res_words: res[vector.Vector[str], diag.Refusal] = topic.words(m.alloc, f, f.key);
    if (sel res_words.err)     { ret opt[str].none{}; }
    if (res_words.ok.len != 3) { ret opt[str].none{}; }
    val opt_member_of: opt[*spirv_grammar.Enumerant] = member_of(m.grammar, res_words.ok.data[1], res_words.ok.data[2]);
    if (sel opt_member_of.none) { ret opt[str].none{}; }
    val av:   *spirv_grammar.Availability = ?opt_member_of.some.availability;
    var text: str                         = "none";
    var i:    usize                       = 0;
    for (i < av.capability_count) {
        var res_str_join: res[str, StrError] = res[str, StrError].ok{av.capabilities[i]};
        if (i > 0)                { res_str_join = str_join(m.alloc, text, ",", av.capabilities[i]); }
        if (sel res_str_join.err) { ret opt[str].none{}; }
        text = res_str_join.ok;
        i    = i + 1;
    }
    val res_spelled: res[str, StrError] = str_join(m.alloc, "capabilities=", text);
    if (sel res_spelled.err) { ret opt[str].none{}; }
    ret opt[str].some{res_spelled.ok};
}

# what the grammar states of the member a bring fact names: `extensions=` its extensions joined by commas, or `none`
fun extensions_stated(ctx: ptr, f: *topic.Fact) opt[str] {
    val m:         *Mentioned                            = ctx::*Mentioned;
    val res_words: res[vector.Vector[str], diag.Refusal] = topic.words(m.alloc, f, f.key);
    if (sel res_words.err)     { ret opt[str].none{}; }
    if (res_words.ok.len != 3) { ret opt[str].none{}; }
    val opt_member_of: opt[*spirv_grammar.Enumerant] = member_of(m.grammar, res_words.ok.data[1], res_words.ok.data[2]);
    if (sel opt_member_of.none) { ret opt[str].none{}; }
    val av:   *spirv_grammar.Availability = ?opt_member_of.some.availability;
    var text: str                         = "none";
    var i:    usize                       = 0;
    for (i < av.extension_count) {
        var res_str_join: res[str, StrError] = res[str, StrError].ok{av.extensions[i]};
        if (i > 0)                { res_str_join = str_join(m.alloc, text, ",", av.extensions[i]); }
        if (sel res_str_join.err) { ret opt[str].none{}; }
        text = res_str_join.ok;
        i    = i + 1;
    }
    val res_spelled: res[str, StrError] = str_join(m.alloc, "extensions=", text);
    if (sel res_spelled.err) { ret opt[str].none{}; }
    ret opt[str].some{res_spelled.ok};
}

fun brings(a: *A.Allocator, tree: *source.Tree, gr: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ctx:      Mentioned                 = Mentioned{alloc: a, grammar: gr};
    var ls:       vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val err_read: err[diag.Refusal]         = lines_of(a, tree, "brings", (?ctx)::ptr, extensions_stated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "bring", 3)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val opt_member_of: opt[*spirv_grammar.Enumerant] = member_of(gr, l.key.data[1], l.key.data[2]);
        if (sel opt_member_of.none) { ret topic.reject(l, NO_MEMBER, l.fact.key); }
        var names:           str               = nil;
        val err_names_found: err[diag.Refusal] = topic.needed(l, "extensions", ?names);
        if (sel err_names_found.err) { ret err_names_found; }
        var j: usize = 0;
        for (j < out.brought.len) {
            if (str_equals(out.brought.data[j].kind, l.key.data[1]) && str_equals(out.brought.data[j].member, l.key.data[2])) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
            j = j + 1;
        }
        var b:    Brought = Brought{kind: l.key.data[1], member: l.key.data[2], extensions: vector.init[str](a)};
        var from: usize   = 0;
        var at:   usize   = 0;
        val n:    usize   = str_len(names);
        for (at <= n) {
            if (at == n || names[at] == ',') {
                if (at == from) { ret topic.reject(l, topic.BAD_FACT, names); }
                val res_name: res[str, StrError] = str_copy_slice(a, names, from, at - from);
                if (sel res_name.err)                                      { ret err[diag.Refusal].err{memory()}; }
                if (!pushed(vector.push[str](?b.extensions, res_name.ok))) { ret err[diag.Refusal].err{memory()}; }
                from = at + 1;
            }
            at = at + 1;
        }
        if (!pushed(vector.push[Brought](?out.brought, b))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun mentions(a: *A.Allocator, tree: *source.Tree, gr: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    var ctx:      Mentioned                 = Mentioned{alloc: a, grammar: gr};
    var ls:       vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val err_read: err[diag.Refusal]         = lines_of(a, tree, "mentions", (?ctx)::ptr, capabilities_stated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (!topic.is(l, "mention", 3)) { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        val opt_member_of: opt[*spirv_grammar.Enumerant] = member_of(gr, l.key.data[1], l.key.data[2]);
        if (sel opt_member_of.none) { ret topic.reject(l, NO_MEMBER, l.fact.key); }
        val opt_only: opt[str] = topic.only(l);
        if (!(sel opt_only.some && str_equals(opt_only.some, "capabilities=none"))) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
        val key: str = pair(a, l.key.data[1], l.key.data[2]);
        if (key == nil) { ret err[diag.Refusal].err{memory()}; }
        var probe:     str        = key;
        val opt_known: opt[*bool] = map.get[str, bool](?out.mentioned, ?probe);
        if (sel opt_known.some) { ret topic.reject(l, STATED_TWICE, key); }
        val res_put: res[bool, A.Error] = map.insert[str, bool](?out.mentioned, key, true);
        if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the instructions of the set `name` of an accesses line names: the core grammar's for CORE, or an import's, nil for
# none
fun set_instructions(g: *spirv_index.Instructions, out: *Facts, name: str) *spirv_index.Instructions {
    if (str_equals(name, CORE)) { ret g; }
    var j: usize = 0;
    for (j < out.imports.len) {
        if (str_equals(out.imports.data[j].name, name)) { ret ?out.imports.data[j].instructions; }
        j = j + 1;
    }
    ret nil;
}

# the operand `word` names of `ins`, refused unless it is of kind `kind` and, when `single`, takes one value
fun operand_kind(l: *topic.Line, ins: *spirv_index.Instruction, word: str, kind: str, single: bool, message: str) res[u8, diag.Refusal] {
    val res_operand_of: res[u8, diag.Refusal] = operand_of(l, ins, word);
    if (sel res_operand_of.err) { ret res_operand_of; }
    val ref: *spirv_grammar.Operand = ?ins.operands[res_operand_of.ok];
    if (!str_equals(ref.kind.name, kind) || (single && spirv_index.quantity(ref) != operand.ONE)) { ret res[u8, diag.Refusal].err{topic.refuse(l.fact, message, word)}; }
    ret res_operand_of;
}

# the id operand the named value `name` of line `l` names, field.NO_OPERAND when the line gives none
fun id_named(l: *topic.Line, ins: *spirv_index.Instruction, name: str, kind: str, message: str, out: *u8) err[diag.Refusal] {
    @out = field.NO_OPERAND;
    val word: str = topic.optional(l, name, nil);
    if (word == nil) { ret err[diag.Refusal].ok{}; }
    val res_operand_kind: res[u8, diag.Refusal] = operand_kind(l, ins, word, kind, true, message);
    if (sel res_operand_kind.err) { ret err[diag.Refusal].err{res_operand_kind.err}; }
    @out = res_operand_kind.ok;
    ret err[diag.Refusal].ok{};
}

# whether word `w` is a named value of `names`
fun named_any(w: str, names: *str, count: usize) bool {
    var k: usize = 0;
    for (k < count) {
        val n:    str   = names[k];
        val len:  usize = str_len(n);
        var same: bool  = str_len(w) > len && w[len] == '=';
        var c:    usize = 0;
        for (same && c < len) {
            if (w[c] != n[c]) { same = false; }
            c = c + 1;
        }
        if (same) { ret true; }
        k = k + 1;
    }
    ret false;
}

# line `l` refused when a word of its fact past the first `from` is no named value of `names`
fun words_known(l: *topic.Line, from: usize, names: *str, count: usize) err[diag.Refusal] {
    var j: usize = from;
    for (j < l.ws.len) {
        if (!named_any(l.ws.data[j], names, count)) { ret topic.reject(l, topic.UNKNOWN_WORD, l.ws.data[j]); }
        j = j + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the operands a comma-separated list of operand numbers names of `ins`, as positions
fun positions(a: *A.Allocator, l: *topic.Line, ins: *spirv_index.Instruction, list: str, out: *operand.Positions) err[diag.Refusal] {
    @out = operand.NO_POSITIONS;
    if (list == nil) { ret err[diag.Refusal].ok{}; }
    var at: usize = 0;
    for {
        var end: usize = at;
        for (list[end] != 0 && list[end] != ',') { end = end + 1; }
        val res_word: res[str, StrError] = str_copy_slice(a, list, at, end - at);
        if (sel res_word.err) { ret err[diag.Refusal].err{memory()}; }
        val res_operand_of: res[u8, diag.Refusal] = operand_of(l, ins, res_word.ok);
        if (sel res_operand_of.err) { ret err[diag.Refusal].err{res_operand_of.err}; }
        @out = @out | ((1::u32) << res_operand_of.ok::u32);
        if (list[end] == 0) { brk; }
        at = end + 1;
    }
    ret err[diag.Refusal].ok{};
}

val ACCESS_WORDS: [5]str = [5]str{"element", "count", "size", "forming", "governor"};

fun access_line(a: *A.Allocator, l: *topic.Line, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    val name: str                       = l.key.data[1];
    val set:  *spirv_index.Instructions = set_instructions(g, out, name);
    if (set == nil) { ret topic.reject(l, NO_SET, name); }
    val ins: *spirv_index.Instruction = spirv_index.find(set, l.key.data[2]);
    if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[2]); }
    var x: Access = Access{set: name, instruction: ins.name, operand: field.NO_OPERAND, role: operand.NONE, bits: 0, pointee: false, count: field.NO_OPERAND, size: field.NO_OPERAND, forming: operand.NO_POSITIONS, governor: field.NO_OPERAND};
    if (!str_equals(l.key.data[3], "-")) {
        val res_operand_kind: res[u8, diag.Refusal] = operand_kind(l, ins, l.key.data[3], "IdRef", true, NOT_AN_ID);
        if (sel res_operand_kind.err) { ret err[diag.Refusal].err{res_operand_kind.err}; }
        x.operand = res_operand_kind.ok;
    }
    if (l.ws.len == 0) { ret topic.reject(l, NO_ROLE, l.fact.key); }
    val role: str = l.ws.data[0];
    if (str_equals(role, "read"))  { x.role = operand.READ; }
    or (str_equals(role, "write")) { x.role = operand.WRITE; }
    or (str_equals(role, "both"))  { x.role = operand.READ_WRITE; }
    or (!str_equals(role, "none")) { ret topic.reject(l, NO_ROLE, role); }
    or (l.ws.len != 1)             { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
    val err_known: err[diag.Refusal] = words_known(l, 1, ?ACCESS_WORDS[0], 5);
    if (sel err_known.err) { ret err_known; }
    if (x.role != operand.NONE) {
        var element:    str               = nil;
        val err_needed: err[diag.Refusal] = topic.needed(l, "element", ?element);
        if (sel err_needed.err) { ret err_needed; }
        val unstated: bool = str_equals(element, "unstated");
        x.pointee = str_equals(element, "pointee");
        if (x.pointee && x.operand == field.NO_OPERAND) { ret topic.reject(l, BAD_ELEMENT, element); }
        if (!x.pointee && !unstated) {
            val res_bits: res[i64, diag.Refusal] = topic.number(l.fact, element);
            if (sel res_bits.err)                       { ret err[diag.Refusal].err{res_bits.err}; }
            if (res_bits.ok <= 0 || res_bits.ok > 1024) { ret topic.reject(l, BAD_ELEMENT, element); }
            x.bits = res_bits.ok::u32;
        }
        val count: str = topic.optional(l, "count", nil);
        if (count != nil) {
            if (str_equals(count, "type"))     { x.count = COUNT_TYPE; }
            or (str_equals(count, "unstated")) { x.count = COUNT_UNSTATED; }
            or {
                val res_operand_kind: res[u8, diag.Refusal] = operand_kind(l, ins, count, "IdRef", true, BAD_COUNT);
                if (sel res_operand_kind.err) { ret err[diag.Refusal].err{res_operand_kind.err}; }
                x.count = res_operand_kind.ok;
            }
        }
        val err_sized: err[diag.Refusal] = id_named(l, ins, "size", "IdRef", BAD_COUNT, ?x.size);
        if (sel err_sized.err)                                                          { ret err_sized; }
        if (unstated && x.count != COUNT_UNSTATED)                                      { ret topic.reject(l, BAD_COUNT, element); }
        if (x.size != field.NO_OPERAND && (x.bits == 0 || x.count != field.NO_OPERAND)) { ret topic.reject(l, BAD_COUNT, l.fact.fact); }
        if (x.pointee && x.count == COUNT_UNSTATED)                                     { ret topic.reject(l, BAD_COUNT, l.fact.fact); }
        val err_formed: err[diag.Refusal] = positions(a, l, ins, topic.optional(l, "forming", nil), ?x.forming);
        if (sel err_formed.err) { ret err_formed; }
        val err_governed: err[diag.Refusal] = id_named(l, ins, "governor", "IdRef", NOT_AN_ID, ?x.governor);
        if (sel err_governed.err) { ret err_governed; }
    }
    var j: usize = 0;
    for (j < out.accesses.len) {
        val q: *Access = ?out.accesses.data[j];
        if (str_equals(q.set, x.set) && str_equals(q.instruction, x.instruction) && q.operand == x.operand) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
        j = j + 1;
    }
    if (!pushed(vector.push[Access](?out.accesses, x))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# the kinds of access word `w` spells as letters of r, w, i and o, none for a word that spells none or another letter
fun kinds_of(w: str) opt[u8] {
    var k: u8    = 0;
    var i: usize = 0;
    for (w[i] != 0) {
        if (w[i] == 'r') { k = k | 1; }
        or (w[i] == 'w') { k = k | 2; }
        or (w[i] == 'i') { k = k | 4; }
        or (w[i] == 'o') { k = k | 8; }
        or               { ret opt[u8].none{}; }
        i = i + 1;
    }
    if (k == 0) { ret opt[u8].none{}; }
    ret opt[u8].some{k};
}

val ORDER_WORDS: [6]str = [6]str{"before", "after", "semantics", "failure", "scope", "execution"};

fun order_line(l: *topic.Line, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    val name: str                       = l.key.data[1];
    val set:  *spirv_index.Instructions = set_instructions(g, out, name);
    if (set == nil) { ret topic.reject(l, NO_SET, name); }
    val ins: *spirv_index.Instruction = spirv_index.find(set, l.key.data[2]);
    if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[2]); }
    val err_known: err[diag.Refusal] = words_known(l, 0, ?ORDER_WORDS[0], 6);
    if (sel err_known.err) { ret err_known; }
    var x:          Order             = Order{set: name, instruction: ins.name, before: 0, after: 0, semantics: field.NO_OPERAND, failure: field.NO_OPERAND, scope: field.NO_OPERAND, execution: field.NO_OPERAND};
    var before:     str               = nil;
    var after:      str               = nil;
    val err_needed: err[diag.Refusal] = topic.needed(l, "before", ?before);
    if (sel err_needed.err) { ret err_needed; }
    val err_needed_after: err[diag.Refusal] = topic.needed(l, "after", ?after);
    if (sel err_needed_after.err) { ret err_needed_after; }
    val opt_kinds_of:       opt[u8] = kinds_of(before);
    val opt_kinds_of_after: opt[u8] = kinds_of(after);
    if (sel opt_kinds_of.none)       { ret topic.reject(l, BAD_KINDS, before); }
    if (sel opt_kinds_of_after.none) { ret topic.reject(l, BAD_KINDS, after); }
    x.before = opt_kinds_of.some;
    x.after  = opt_kinds_of_after.some;
    val err_semantics_named: err[diag.Refusal] = id_named(l, ins, "semantics", "IdMemorySemantics", NOT_AN_ORDER, ?x.semantics);
    if (sel err_semantics_named.err) { ret err_semantics_named; }
    val err_failure_named: err[diag.Refusal] = id_named(l, ins, "failure", "IdMemorySemantics", NOT_AN_ORDER, ?x.failure);
    if (sel err_failure_named.err) { ret err_failure_named; }
    val err_scope_named: err[diag.Refusal] = id_named(l, ins, "scope", "IdScope", NOT_AN_ORDER, ?x.scope);
    if (sel err_scope_named.err) { ret err_scope_named; }
    val err_execution_named: err[diag.Refusal] = id_named(l, ins, "execution", "IdScope", NOT_AN_ORDER, ?x.execution);
    if (sel err_execution_named.err) { ret err_execution_named; }
    var j: usize = 0;
    for (j < out.orders.len) {
        val q: *Order = ?out.orders.data[j];
        if (str_equals(q.set, x.set) && str_equals(q.instruction, x.instruction)) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
        j = j + 1;
    }
    if (!pushed(vector.push[Order](?out.orders, x))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# line `l` naming a class of the core grammar `g` quiet, its instructions accessing nothing and ordering nothing
fun quiet_line(l: *topic.Line, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    val class: str   = l.key.data[1];
    var filed: bool  = false;
    var i:     usize = 0;
    for (i < g.all.len) {
        val c: str = g.all.data[i].class;
        if (c != nil && str_equals(c, class)) { filed = true; }
        i = i + 1;
    }
    if (!filed) { ret topic.reject(l, NO_CLASS, class); }
    val opt_only: opt[str] = topic.only(l);
    if (!(sel opt_only.some && str_equals(opt_only.some, "none"))) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
    var probe:     str        = class;
    val opt_known: opt[*bool] = map.get[str, bool](?out.quiet, ?probe);
    if (sel opt_known.some) { ret topic.reject(l, STATED_TWICE, class); }
    val res_put: res[bool, A.Error] = map.insert[str, bool](?out.quiet, class, true);
    if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# whether core instruction `ins` is filed under a class a quiet line names
fun quiet(ins: *spirv_index.Instruction, out: *Facts) bool {
    if (ins.class == nil) { ret false; }
    var probe:     str        = ins.class;
    val opt_known: opt[*bool] = map.get[str, bool](?out.quiet, ?probe);
    ret sel opt_known.some;
}

# every core instruction of a class no quiet line names held to stating an access or an order, every one of a quiet
# class to stating neither, and each memory semantics operand to an order naming it, so a core row that states no
# access accesses nothing
fun covered(g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    var i: usize = 0;
    for (i < g.all.len) {
        val ins:    *spirv_index.Instruction = ?g.all.data[i];
        var stated: bool                     = false;
        var order:  *Order                   = nil;
        var j:      usize                    = 0;
        for (j < out.accesses.len) {
            if (str_equals(out.accesses.data[j].set, CORE) && str_equals(out.accesses.data[j].instruction, ins.name)) { stated = true; }
            j = j + 1;
        }
        j = 0;
        for (j < out.orders.len) {
            if (str_equals(out.orders.data[j].set, CORE) && str_equals(out.orders.data[j].instruction, ins.name)) { order = ?out.orders.data[j]; }
            j = j + 1;
        }
        val silent: bool = !stated && order == nil;
        if (quiet(ins, out) && !silent) { ret err[diag.Refusal].err{diag.refusal(nil, 0, QUIET_STATED, ins.name)}; }
        if (!quiet(ins, out) && silent) { ret err[diag.Refusal].err{diag.refusal(nil, 0, UNSTATED, ins.name)}; }
        var k: usize = 0;
        for (k < ins.count) {
            if (str_equals(ins.operands[k].kind.name, "IdMemorySemantics") && (order == nil || (order.semantics::usize != k && order.failure::usize != k))) { ret err[diag.Refusal].err{diag.refusal(nil, 0, UNORDERED, ins.name)}; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun accesses(a: *A.Allocator, tree: *source.Tree, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val err_read: err[diag.Refusal]         = lines_of(a, tree, "accesses", g::ptr, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (topic.is(l, "access", 4)) {
            val err_access_line: err[diag.Refusal] = access_line(a, l, g, out);
            if (sel err_access_line.err) { ret err_access_line; }
        }
        or (topic.is(l, "order", 3)) {
            val err_order_line: err[diag.Refusal] = order_line(l, g, out);
            if (sel err_order_line.err) { ret err_order_line; }
        }
        or (topic.is(l, "quiet", 2)) {
            val err_quiet_line: err[diag.Refusal] = quiet_line(l, g, out);
            if (sel err_quiet_line.err) { ret err_quiet_line; }
        }
        or { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        i = i + 1;
    }
    ret covered(g, out);
}

# the handle kind word `w` names, as `spirv_kind` numbers them, none for no kind's word
fun handle_of(w: str) opt[u8] {
    if (str_equals(w, "none"))          { ret opt[u8].some{0}; }
    if (str_equals(w, "image"))         { ret opt[u8].some{1}; }
    if (str_equals(w, "sampler"))       { ret opt[u8].some{2}; }
    if (str_equals(w, "sampled"))       { ret opt[u8].some{3}; }
    if (str_equals(w, "image-pointer")) { ret opt[u8].some{4}; }
    ret opt[u8].none{};
}

# whether `text` holds `word`, ignoring case
fun holds(text: str, word: str) bool {
    if (text == nil) { ret false; }
    val n: usize = str_len(word);
    var i: usize = 0;
    for (text[i] != 0) {
        var k: usize = 0;
        for (k < n && text[i + k] != 0) {
            var c: u8 = text[i + k];
            if (c >= 'A' && c <= 'Z') { c = c + 32; }
            if (c != word[k])         { brk; }
            k = k + 1;
        }
        if (k == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the grammar's name `name` of an id operand names one of the image family
fun image_family(name: str) bool {
    ret holds(name, "image") || holds(name, "sampler") || holds(name, "texture");
}

fun put_kind(m: *map.Map[str, u8], l: *topic.Line, key: str, kind: u8) err[diag.Refusal] {
    var probe:     str      = key;
    val opt_known: opt[*u8] = map.get[str, u8](m, ?probe);
    if (sel opt_known.some) { ret topic.reject(l, STATED_TWICE, key); }
    val res_put: res[bool, A.Error] = map.insert[str, u8](m, key, kind);
    if (sel res_put.err) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# every image-family id operand of the instructions of `g` held to a handle line naming its name or it
fun named_handles(a: *A.Allocator, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    var i: usize = 0;
    for (i < g.all.len) {
        val ins: *spirv_index.Instruction = ?g.all.data[i];
        var k:   usize                    = 0;
        for (k < ins.count) {
            val ref: *spirv_grammar.Operand = ?ins.operands[k];
            if (str_equals(ref.kind.name, "IdRef") && image_family(ref.name)) {
                var name:      str      = ref.name;
                val opt_named: opt[*u8] = map.get[str, u8](?out.names, ?name);
                var digits:    [4]u8;
                digits[0] = '0' + (k / 10 % 10)::u8;
                digits[1] = '0' + (k % 10)::u8;
                digits[2] = 0;
                var at: usize = 0;
                if (k < 10) { at = 1; }
                var key:      str      = pair(a, ins.name, ?digits[at]);
                val opt_over: opt[*u8] = map.get[str, u8](?out.handles, ?key);
                if (sel opt_named.none && sel opt_over.none) { ret err[diag.Refusal].err{diag.refusal(nil, 0, UNNAMED, key)}; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun handles(a: *A.Allocator, tree: *source.Tree, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val err_read: err[diag.Refusal]         = lines_of(a, tree, "handles", g::ptr, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l:        *topic.Line = ?ls.data[i];
        val opt_only: opt[str]    = topic.only(l);
        if (sel opt_only.none) { ret topic.reject(l, topic.BAD_FACT, l.fact.fact); }
        val opt_kind: opt[u8] = handle_of(opt_only.some);
        if (sel opt_kind.none) { ret topic.reject(l, BAD_HANDLE, opt_only.some); }
        if (topic.is(l, "name", 2)) {
            val err_put_kind: err[diag.Refusal] = put_kind(?out.names, l, l.key.data[1], opt_kind.some);
            if (sel err_put_kind.err) { ret err_put_kind; }
        }
        or (topic.is(l, "operand", 3)) {
            val ins: *spirv_index.Instruction = spirv_index.find(g, l.key.data[1]);
            if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[1]); }
            val res_operand_kind: res[u8, diag.Refusal] = operand_kind(l, ins, l.key.data[2], "IdRef", false, NOT_AN_ID);
            if (sel res_operand_kind.err) { ret err[diag.Refusal].err{res_operand_kind.err}; }
            val key: str = pair(a, ins.name, l.key.data[2]);
            if (key == nil) { ret err[diag.Refusal].err{memory()}; }
            val err_put_kind: err[diag.Refusal] = put_kind(?out.handles, l, key, opt_kind.some);
            if (sel err_put_kind.err) { ret err_put_kind; }
        }
        or (topic.is(l, "result", 2)) {
            val ins: *spirv_index.Instruction = spirv_index.find(g, l.key.data[1]);
            if (ins == nil || ins.count < 2 || !str_equals(ins.operands[1].kind.name, "IdResult")) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[1]); }
            val err_put_kind: err[diag.Refusal] = put_kind(?out.results, l, ins.name, opt_kind.some);
            if (sel err_put_kind.err) { ret err_put_kind; }
        }
        or { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        i = i + 1;
    }
    val err_core: err[diag.Refusal] = named_handles(a, g, out);
    if (sel err_core.err) { ret err_core; }
    var j: usize = 0;
    for (j < out.imports.len) {
        val err_set: err[diag.Refusal] = named_handles(a, ?out.imports.data[j].instructions, out);
        if (sel err_set.err) { ret err_set; }
        j = j + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the class word `w` names, as typing.Class numbers them
fun class_of(w: str) opt[u8] {
    if (str_equals(w, "any"))      { ret opt[u8].some{0}; }
    if (str_equals(w, "float"))    { ret opt[u8].some{1}; }
    if (str_equals(w, "integer"))  { ret opt[u8].some{2}; }
    if (str_equals(w, "signed"))   { ret opt[u8].some{3}; }
    if (str_equals(w, "unsigned")) { ret opt[u8].some{4}; }
    if (str_equals(w, "number"))   { ret opt[u8].some{5}; }
    if (str_equals(w, "truth"))    { ret opt[u8].some{6}; }
    ret opt[u8].none{};
}

# the relations a form names, as typing.Relation numbers them from SAME
val RELATIONS: [12]str = [12]str{"same", "component", "lanes-of", "texel", "format", "composed", "pair", "element", "count", "chain", "like", "wide"};

val FORM_WORDS: [23]str = [23]str{"pointer", "class", "shape", "lanes", "bits", "widest", "same", "component", "lanes-of", "texel", "format", "composed", "pair", "element", "count", "chain", "like", "wide", "constant", "until", "value", "dims", "within"};

# the relation a form of a variadic literal operand may name, as typing.Relation numbers it
val COUNT: u8 = 9;

# whether operand `slot` of `ins` is a variadic literal, as OpVectorShuffle's Components, whose values a form holds
# by their count and the components they index
fun literals(ins: *spirv_index.Instruction, slot: u8) bool {
    if (slot == RESULT || slot::usize >= ins.count) { ret false; }
    val ref: *spirv_grammar.Operand = ?ins.operands[slot];
    ret str_equals(ref.kind.name, "LiteralInteger") && spirv_index.quantity(ref) == operand.VARIADIC;
}

# the slot a form's own word names: a slot `slot_of` admits, or a variadic literal operand
fun own_slot(l: *topic.Line, set: str, ins: *spirv_index.Instruction, word: str) res[u8, diag.Refusal] {
    if (!str_equals(word, "result")) {
        val res_operand_of: res[u8, diag.Refusal] = operand_of(l, ins, word);
        if (sel res_operand_of.err)           { ret res_operand_of; }
        if (literals(ins, res_operand_of.ok)) { ret res_operand_of; }
    }
    ret slot_of(l, set, ins, word);
}

# the slots a comma-separated list of slot words names, bit n for slot n
fun slots_of(a: *A.Allocator, l: *topic.Line, set: str, ins: *spirv_index.Instruction, list: str, out: *u32) err[diag.Refusal] {
    @out = 0;
    if (list == nil) { ret err[diag.Refusal].ok{}; }
    var at: usize = 0;
    for {
        var end: usize = at;
        for (list[end] != 0 && list[end] != ',') { end = end + 1; }
        val res_word: res[str, StrError] = str_copy_slice(a, list, at, end - at);
        if (sel res_word.err) { ret err[diag.Refusal].err{memory()}; }
        val res_slot: res[u8, diag.Refusal] = slot_of(l, set, ins, res_word.ok);
        if (sel res_slot.err)                           { ret err[diag.Refusal].err{res_slot.err}; }
        if (res_slot.ok == RESULT || res_slot.ok >= 32) { ret topic.reject(l, NOT_LITERALS, res_word.ok); }
        @out = @out | ((1::u32) << res_slot.ok::u32);
        if (list[end] == 0) { brk; }
        at = end + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the slot `word` names of `ins` of set `set`: `result` for its result, which every extended instruction has, else an
# operand that is one value id or an optional one, as a subgroup operation's ClusterSize, a scope or memory semantics
# id among them
fun slot_of(l: *topic.Line, set: str, ins: *spirv_index.Instruction, word: str) res[u8, diag.Refusal] {
    if (str_equals(word, "result")) {
        if (!str_equals(set, CORE)) { ret res[u8, diag.Refusal].ok{RESULT}; }
        var k: usize = 0;
        for (k < ins.count) {
            if (sel ins.operands[k].kind.shape.result_type) { ret res[u8, diag.Refusal].ok{RESULT}; }
            k = k + 1;
        }
        ret res[u8, diag.Refusal].err{topic.refuse(l.fact, NOT_A_VALUE, word)};
    }
    val res_operand_of: res[u8, diag.Refusal] = operand_of(l, ins, word);
    if (sel res_operand_of.err) { ret res_operand_of; }
    val ref:    *spirv_grammar.Operand = ?ins.operands[res_operand_of.ok];
    val valued: bool                   = str_equals(ref.kind.name, "IdRef") || str_equals(ref.kind.name, "IdScope") || str_equals(ref.kind.name, "IdMemorySemantics");
    if (!valued || spirv_index.quantity(ref) == operand.VARIADIC) { ret res[u8, diag.Refusal].err{topic.refuse(l.fact, NOT_A_VALUE, word)}; }
    ret res_operand_of;
}

# a number word of line `l` no wider than a byte
fun small(l: *topic.Line, word: str, out: *u8) err[diag.Refusal] {
    if (word == nil) { ret err[diag.Refusal].ok{}; }
    val res_number: res[i64, diag.Refusal] = topic.number(l.fact, word);
    if (sel res_number.err)                       { ret err[diag.Refusal].err{res_number.err}; }
    if (res_number.ok <= 0 || res_number.ok > 64) { ret topic.reject(l, topic.BAD_NUMBER, word); }
    @out = res_number.ok::u8;
    ret err[diag.Refusal].ok{};
}

fun form_line(a: *A.Allocator, l: *topic.Line, gr: *spirv_grammar.Grammar, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    val set: *spirv_index.Instructions = set_instructions(g, out, l.key.data[1]);
    if (set == nil) { ret topic.reject(l, NO_SET, l.key.data[1]); }
    val ins: *spirv_index.Instruction = spirv_index.find(set, l.key.data[2]);
    if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[2]); }
    val err_known: err[diag.Refusal] = topic.known(l, ?FORM_WORDS[0], 23);
    if (sel err_known.err) { ret err_known; }
    val res_slot: res[u8, diag.Refusal] = own_slot(l, l.key.data[1], ins, l.key.data[3]);
    if (sel res_slot.err) { ret err[diag.Refusal].err{res_slot.err}; }
    var x:       Form = Form{set: l.key.data[1], instruction: ins.name, slot: res_slot.ok, pointer: 0, class: 0, shape: 0, lanes: 0, bits: 0, widest: 0, relation: 0, to: RESULT, constant: false, until: nil, value: 0, dims: 0, within: 0};
    val pointer: str  = topic.optional(l, "pointer", nil);
    if (pointer != nil) {
        if (str_equals(pointer, "yes"))      { x.pointer = 1; }
        or (str_equals(pointer, "physical")) { x.pointer = 2; }
        or (str_equals(pointer, "compared")) { x.pointer = 3; }
        or                                   { ret topic.reject(l, BAD_POINTER, pointer); }
    }
    var class:           str               = nil;
    val err_class_found: err[diag.Refusal] = topic.needed(l, "class", ?class);
    if (sel err_class_found.err) { ret err_class_found; }
    val opt_class: opt[u8] = class_of(class);
    if (sel opt_class.none) { ret topic.reject(l, BAD_CLASS, class); }
    x.class = opt_class.some;
    val shape: str = topic.optional(l, "shape", nil);
    if (shape != nil) {
        if (str_equals(shape, "scalar")) { x.shape = 1; }
        or (str_equals(shape, "vector")) { x.shape = 2; }
        or                               { ret topic.reject(l, BAD_SHAPE, shape); }
    }
    val err_lanes: err[diag.Refusal] = small(l, topic.optional(l, "lanes", nil), ?x.lanes);
    if (sel err_lanes.err) { ret err_lanes; }
    val err_bits: err[diag.Refusal] = small(l, topic.optional(l, "bits", nil), ?x.bits);
    if (sel err_bits.err) { ret err_bits; }
    val err_widest: err[diag.Refusal] = small(l, topic.optional(l, "widest", nil), ?x.widest);
    if (sel err_widest.err) { ret err_widest; }
    var r: usize = 0;
    for (r < 12) {
        val word: str = topic.optional(l, RELATIONS[r], nil);
        if (word != nil) {
            if (x.relation != 0) { ret topic.reject(l, TWO_RELATIONS, word); }
            val res_to: res[u8, diag.Refusal] = slot_of(l, l.key.data[1], ins, word);
            if (sel res_to.err) { ret err[diag.Refusal].err{res_to.err}; }
            x.relation = (r + 1)::u8;
            x.to       = res_to.ok;
        }
        r = r + 1;
    }
    val res_constant: res[bool, diag.Refusal] = topic.yes(l, "constant", false);
    if (sel res_constant.err) { ret err[diag.Refusal].err{res_constant.err}; }
    x.constant = res_constant.ok;
    x.until    = topic.optional(l, "until", nil);
    if (x.until != nil && !x.constant)  { ret topic.reject(l, UNTIL_UNCONSTANT, x.until); }
    if (x.constant && x.slot == RESULT) { ret topic.reject(l, UNTIL_UNCONSTANT, l.key.data[3]); }
    val value: str = topic.optional(l, "value", nil);
    if (value != nil) {
        if (str_equals(value, "zero"))  { x.value = 1; }
        or (str_equals(value, "power")) { x.value = 2; }
        or                              { ret topic.reject(l, BAD_VALUE, value); }
        if (!x.constant)                { ret topic.reject(l, VALUE_UNCONSTANT, value); }
    }
    val dims: str = topic.optional(l, "dims", nil);
    if (dims != nil && !x.constant) { ret topic.reject(l, VALUE_UNCONSTANT, dims); }
    val err_dims: err[diag.Refusal] = members_of(a, l, gr, "Dim", dims, true, ?x.dims);
    if (sel err_dims.err) { ret err_dims; }
    val err_within: err[diag.Refusal] = slots_of(a, l, l.key.data[1], ins, topic.optional(l, "within", nil), ?x.within);
    if (sel err_within.err) { ret err_within; }
    if (literals(ins, x.slot)) {
        val unsigned: bool = x.class == 2 || x.class == 4;
        val counted:  bool = x.relation == 0 || x.relation == COUNT;
        if (x.pointer != 0 || !unsigned || x.shape != 0 || x.lanes != 0 || x.bits != 0 || x.widest != 0 || !counted || x.constant) { ret topic.reject(l, NOT_LITERALS, l.key.data[3]); }
    }
    or (x.within != 0 || x.relation == COUNT) { ret topic.reject(l, NOT_LITERALS, l.key.data[3]); }
    var k: usize = 0;
    for (k < out.forms.len) {
        val y: *Form = ?out.forms.data[k];
        if (y.slot == x.slot && str_equals(y.set, x.set) && str_equals(y.instruction, x.instruction)) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
        k = k + 1;
    }
    if (!pushed(vector.push[Form](?out.forms, x))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# whether the grammar's capabilities hold `name`
fun capability_known(gr: *spirv_grammar.Grammar, name: str) bool {
    val res_kind: res[*spirv_grammar.Kind, Fail] = spirv_grammar.kind(gr, "Capability");
    if (sel res_kind.err) { ret false; }
    val e: *spirv_grammar.Enum = spirv_index.enumerants(res_kind.ok);
    if (e == nil) { ret false; }
    var i: usize = 0;
    for (i < e.count) {
        if (str_equals(e.enumerants[i].name, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the digits of `w` from `at` as a number, read while it is below 1000 so a long run cannot wrap, `at` moved past them
fun digits(w: str, at: *usize) u32 {
    var n: u32 = 0;
    for (w[@at] >= '0' && w[@at] <= '9' && n < 1000) {
        n   = n * 10 + (w[@at] - '0')::u32;
        @at = @at + 1;
    }
    ret n;
}

# the alternatives `text` spells, `,` between alternatives and `+` between the capabilities one names together
fun ways_of(a: *A.Allocator, l: *topic.Line, gr: *spirv_grammar.Grammar, text: str, out: *vector.Vector[vector.Vector[str]]) err[diag.Refusal] {
    var way:   vector.Vector[str] = vector.init[str](a);
    var start: usize              = 0;
    var at:    usize              = 0;
    for {
        val c: u8 = text[at];
        if (c == ',' || c == '+' || c == 0) {
            if (at == start) { ret topic.reject(l, BAD_TYPED, text); }
            val res_name: res[str, StrError] = str_copy_slice(a, text, start, at - start);
            if (sel res_name.err)                             { ret err[diag.Refusal].err{memory()}; }
            if (!capability_known(gr, res_name.ok))           { ret topic.reject(l, NO_CAPABILITY, res_name.ok); }
            if (!pushed(vector.push[str](?way, res_name.ok))) { ret err[diag.Refusal].err{memory()}; }
            start = at + 1;
        }
        if (c == ',' || c == 0) {
            if (!pushed(vector.push[vector.Vector[str]](out, way))) { ret err[diag.Refusal].err{memory()}; }
            way = vector.init[str](a);
        }
        if (c == 0) { brk; }
        at = at + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun typed_line(a: *A.Allocator, l: *topic.Line, gr: *spirv_grammar.Grammar, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    val set: *spirv_index.Instructions = set_instructions(g, out, l.key.data[1]);
    if (set == nil) { ret topic.reject(l, NO_SET, l.key.data[1]); }
    val ins: *spirv_index.Instruction = spirv_index.find(set, l.key.data[2]);
    if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[2]); }
    val res_operand: res[u8, diag.Refusal] = operand_kind(l, ins, l.key.data[3], "IdRef", true, NOT_AN_ID);
    if (sel res_operand.err) { ret err[diag.Refusal].err{res_operand.err}; }
    var x: Typed = Typed{set: l.key.data[1], instruction: ins.name, operand: res_operand.ok, kinds: vector.init[Kind](a)};
    var j: usize = 0;
    for (j < l.ws.len) {
        val w:    str   = l.ws.data[j];
        var kind: Kind  = Kind{float: false, bits: 0, lanes: 1, ways: vector.init[vector.Vector[str]](a)};
        var at:   usize = 0;
        if (w[0] == 'i' && w[1] == 'n' && w[2] == 't') { at = 3; }
        or (w[0] == 'f' && w[1] == 'l' && w[2] == 'o' && w[3] == 'a' && w[4] == 't') {
            kind.float = true;
            at         = 5;
        }
        or { ret topic.reject(l, BAD_TYPED, w); }
        val bits: u32 = digits(w, ?at);
        if (bits > 64) { ret topic.reject(l, BAD_TYPED, w); }
        kind.bits = bits::u8;
        if (w[at] == 'x') {
            at = at + 1;
            val lanes: u32 = digits(w, ?at);
            if (lanes == 1 || lanes > 16) { ret topic.reject(l, BAD_TYPED, w); }
            kind.lanes = lanes::u8;
        }
        # a scalar of any width says nothing a form does not
        if (kind.bits == 0 && kind.lanes == 1) { ret topic.reject(l, BAD_TYPED, w); }
        if (w[at] == '=') {
            val err_ways: err[diag.Refusal] = ways_of(a, l, gr, ?w[at + 1], ?kind.ways);
            if (sel err_ways.err) { ret err_ways; }
        }
        or (w[at] != 0)                                 { ret topic.reject(l, BAD_TYPED, w); }
        if (!pushed(vector.push[Kind](?x.kinds, kind))) { ret err[diag.Refusal].err{memory()}; }
        j = j + 1;
    }
    if (x.kinds.len == 0) { ret topic.reject(l, BAD_TYPED, l.fact.fact); }
    var k: usize = 0;
    for (k < out.typed.len) {
        if (str_equals(out.typed.data[k].set, x.set) && str_equals(out.typed.data[k].instruction, x.instruction)) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
        k = k + 1;
    }
    if (!pushed(vector.push[Typed](?out.typed, x))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

val PRESENT_WORDS: [3]str = [3]str{"when", "is", "constant"};

fun present_line(l: *topic.Line, gr: *spirv_grammar.Grammar, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    val set: *spirv_index.Instructions = set_instructions(g, out, l.key.data[1]);
    if (set == nil) { ret topic.reject(l, NO_SET, l.key.data[1]); }
    val ins: *spirv_index.Instruction = spirv_index.find(set, l.key.data[2]);
    if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[2]); }
    val err_known: err[diag.Refusal] = topic.known(l, ?PRESENT_WORDS[0], 3);
    if (sel err_known.err) { ret err_known; }
    val res_operand: res[u8, diag.Refusal] = operand_of(l, ins, l.key.data[3]);
    if (sel res_operand.err) { ret err[diag.Refusal].err{res_operand.err}; }
    val ref: *spirv_grammar.Operand = ?ins.operands[res_operand.ok];
    if (!str_equals(ref.kind.name, "IdRef") || spirv_index.quantity(ref) != operand.OPTIONAL) { ret topic.reject(l, NOT_OPTIONAL, l.key.data[3]); }
    var when:           str               = nil;
    var value:          str               = nil;
    val err_when_found: err[diag.Refusal] = topic.needed(l, "when", ?when);
    if (sel err_when_found.err) { ret err_when_found; }
    val err_is_found: err[diag.Refusal] = topic.needed(l, "is", ?value);
    if (sel err_is_found.err) { ret err_is_found; }
    val res_when: res[u8, diag.Refusal] = operand_of(l, ins, when);
    if (sel res_when.err) { ret err[diag.Refusal].err{res_when.err}; }
    val e: *spirv_grammar.Enum = spirv_index.enumerants(ins.operands[res_when.ok].kind);
    if (e == nil) { ret topic.reject(l, NOT_ENUMERANT, when); }
    var x:     Present = Present{set: l.key.data[1], instruction: ins.name, operand: res_operand.ok, when: res_when.ok, value: 0, constant: false};
    var found: bool    = false;
    var i:     usize   = 0;
    for (i < e.count && !found) {
        if (str_equals(e.enumerants[i].name, value)) {
            x.value = e.enumerants[i].value;
            found   = true;
        }
        i = i + 1;
    }
    if (!found) { ret topic.reject(l, NOT_ENUMERANT, value); }
    val res_constant: res[bool, diag.Refusal] = topic.yes(l, "constant", false);
    if (sel res_constant.err) { ret err[diag.Refusal].err{res_constant.err}; }
    x.constant = res_constant.ok;
    var k: usize = 0;
    for (k < out.present.len) {
        if (str_equals(out.present.data[k].set, x.set) && str_equals(out.present.data[k].instruction, x.instruction)) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
        k = k + 1;
    }
    if (!pushed(vector.push[Present](?out.present, x))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

val IMAGE_WORDS: [17]str = [17]str{"image", "mask", "admits", "one-of", "exclusive", "paired", "pairing", "sampled", "uncubed", "constants", "dims", "depth", "multisampled", "arrayed", "levels", "unformatted", "formats"};

# the bits of the members a comma-separated list names of the enumeration of kind `kind`, for a value enumeration the
# bit of each member's value
fun members_of(a: *A.Allocator, l: *topic.Line, gr: *spirv_grammar.Grammar, kind: str, list: str, value_bits: bool, out: *u32) err[diag.Refusal] {
    @out = 0;
    if (list == nil) { ret err[diag.Refusal].ok{}; }
    val res_kind: res[*spirv_grammar.Kind, Fail] = spirv_grammar.kind(gr, kind);
    if (sel res_kind.err) { ret topic.reject(l, NO_BIT, kind); }
    val e: *spirv_grammar.Enum = spirv_index.enumerants(res_kind.ok);
    if (e == nil) { ret topic.reject(l, NO_BIT, kind); }
    var at: usize = 0;
    for {
        var end: usize = at;
        for (list[end] != 0 && list[end] != ',') { end = end + 1; }
        val res_word: res[str, StrError] = str_copy_slice(a, list, at, end - at);
        if (sel res_word.err) { ret err[diag.Refusal].err{memory()}; }
        var found: bool  = false;
        var i:     usize = 0;
        for (i < e.count && !found) {
            if (str_equals(e.enumerants[i].name, res_word.ok)) {
                val v: u32 = e.enumerants[i].value;
                if (value_bits) {
                    if (v >= 32) { ret topic.reject(l, NO_BIT, res_word.ok); }
                    @out = @out | ((1::u32) << v);
                }
                or { @out = @out | v; }
                found = true;
            }
            i = i + 1;
        }
        if (!found)         { ret topic.reject(l, NO_BIT, res_word.ok); }
        if (list[end] == 0) { brk; }
        at = end + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the bits of the Image Formats a comma-separated list names, bit n for the format of value n
fun formats_of(a: *A.Allocator, l: *topic.Line, gr: *spirv_grammar.Grammar, list: str, out: *u64) err[diag.Refusal] {
    @out = 0;
    if (list == nil) { ret err[diag.Refusal].ok{}; }
    val res_kind: res[*spirv_grammar.Kind, Fail] = spirv_grammar.kind(gr, "ImageFormat");
    if (sel res_kind.err) { ret topic.reject(l, NO_BIT, "ImageFormat"); }
    val e: *spirv_grammar.Enum = spirv_index.enumerants(res_kind.ok);
    if (e == nil) { ret topic.reject(l, NO_BIT, "ImageFormat"); }
    var at: usize = 0;
    for {
        var end: usize = at;
        for (list[end] != 0 && list[end] != ',') { end = end + 1; }
        val res_word: res[str, StrError] = str_copy_slice(a, list, at, end - at);
        if (sel res_word.err) { ret err[diag.Refusal].err{memory()}; }
        var found: bool  = false;
        var i:     usize = 0;
        for (i < e.count && !found) {
            if (str_equals(e.enumerants[i].name, res_word.ok)) {
                if (e.enumerants[i].value >= 64) { ret topic.reject(l, NO_BIT, res_word.ok); }
                @out  = @out | ((1::u64) << e.enumerants[i].value::u64);
                found = true;
            }
            i = i + 1;
        }
        if (!found)         { ret topic.reject(l, NO_BIT, res_word.ok); }
        if (list[end] == 0) { brk; }
        at = end + 1;
    }
    ret err[diag.Refusal].ok{};
}

# a yes or no property of an image line, EITHER_WAY when the line names none
fun property(l: *topic.Line, name: str, out: *u8) err[diag.Refusal] {
    @out = 0;
    val word: str = topic.optional(l, name, nil);
    if (word == nil)             { ret err[diag.Refusal].ok{}; }
    if (str_equals(word, "yes")) { @out = 1; }
    or (str_equals(word, "no"))  { @out = 2; }
    or                           { ret topic.reject(l, BAD_PROPERTY, word); }
    ret err[diag.Refusal].ok{};
}

val STAGE_WORDS: [1]str = [1]str{"models"};

val FORMAT_WORDS: [3]str = [3]str{"class", "bits", "lanes"};

# a format line: the number class, width and component count of an image format's texels
fun format_line(l: *topic.Line, gr: *spirv_grammar.Grammar, out: *Facts) err[diag.Refusal] {
    val err_known: err[diag.Refusal] = topic.known(l, ?FORMAT_WORDS[0], 3);
    if (sel err_known.err) { ret err_known; }
    val res_kind: res[*spirv_grammar.Kind, Fail] = spirv_grammar.kind(gr, "ImageFormat");
    if (sel res_kind.err) { ret topic.reject(l, NO_BIT, "ImageFormat"); }
    val e: *spirv_grammar.Enum = spirv_index.enumerants(res_kind.ok);
    if (e == nil) { ret topic.reject(l, NO_BIT, "ImageFormat"); }
    var x:     Format = Format{name: l.key.data[1], value: 0, class: 0, bits: 0, lanes: 0};
    var found: bool   = false;
    var i:     usize  = 0;
    for (i < e.count && !found) {
        if (str_equals(e.enumerants[i].name, x.name)) {
            x.value = e.enumerants[i].value;
            found   = true;
        }
        i = i + 1;
    }
    if (!found) { ret topic.reject(l, NO_BIT, x.name); }
    var class:           str               = nil;
    val err_class_found: err[diag.Refusal] = topic.needed(l, "class", ?class);
    if (sel err_class_found.err) { ret err_class_found; }
    val opt_class: opt[u8] = class_of(class);
    if (sel opt_class.none)                                                { ret topic.reject(l, BAD_CLASS, class); }
    if (opt_class.some != 1 && opt_class.some != 3 && opt_class.some != 4) { ret topic.reject(l, BAD_CLASS, class); }
    x.class = opt_class.some;
    var bits:           str               = nil;
    val err_bits_found: err[diag.Refusal] = topic.needed(l, "bits", ?bits);
    if (sel err_bits_found.err) { ret err_bits_found; }
    val err_bits: err[diag.Refusal] = small(l, bits, ?x.bits);
    if (sel err_bits.err) { ret err_bits; }
    var lanes:           str               = nil;
    val err_lanes_found: err[diag.Refusal] = topic.needed(l, "lanes", ?lanes);
    if (sel err_lanes_found.err) { ret err_lanes_found; }
    val err_lanes: err[diag.Refusal] = small(l, lanes, ?x.lanes);
    if (sel err_lanes.err) { ret err_lanes; }
    var k: usize = 0;
    for (k < out.formats.len) {
        if (out.formats.data[k].value == x.value) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
        k = k + 1;
    }
    if (!pushed(vector.push[Format](?out.formats, x))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

val AVAILABLE_WORDS: [1]str = [1]str{"in"};

# an available line: the environments an instruction of a set's grammar is in, `in=none` for one no environment admits
fun available_line(l: *topic.Line, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    val set: *spirv_index.Instructions = set_instructions(g, out, l.key.data[1]);
    if (set == nil) { ret topic.reject(l, NO_SET, l.key.data[1]); }
    val ins: *spirv_index.Instruction = spirv_index.find(set, l.key.data[2]);
    if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[2]); }
    val err_known: err[diag.Refusal] = topic.known(l, ?AVAILABLE_WORDS[0], 1);
    if (sel err_known.err) { ret err_known; }
    var within:       str               = nil;
    val err_in_found: err[diag.Refusal] = topic.needed(l, "in", ?within);
    if (sel err_in_found.err)        { ret err_in_found; }
    if (!str_equals(within, "none")) { ret topic.reject(l, BAD_AVAILABLE, within); }
    var k: usize = 0;
    for (k < out.withdrawn.len) {
        if (str_equals(out.withdrawn.data[k].set, l.key.data[1]) && str_equals(out.withdrawn.data[k].instruction, ins.name)) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
        k = k + 1;
    }
    if (!pushed(vector.push[Withdrawn](?out.withdrawn, Withdrawn{set: l.key.data[1], instruction: ins.name, why: l.fact.cites}))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

# the models a list names joined as a refusal quotes them, `Fragment` or `Fragment, GLCompute`
fun quoted(a: *A.Allocator, list: str) res[str, diag.Refusal] {
    var n:     usize = 0;
    var comma: usize = 0;
    for (list[n] != 0) {
        if (list[n] == ',') { comma = comma + 1; }
        n = n + 1;
    }
    val res_made: res[*u8, A.Error] = A.allocate[u8](a, n + comma + 1);
    if (sel res_made.err) { ret res[str, diag.Refusal].err{memory()}; }
    val out: *u8   = res_made.ok;
    var j:   usize = 0;
    var i:   usize = 0;
    for (i < n) {
        out[j] = list[i];
        j      = j + 1;
        if (list[i] == ',') {
            out[j] = ' ';
            j      = j + 1;
        }
        i = i + 1;
    }
    out[j] = 0;
    ret res[str, diag.Refusal].ok{out};
}

fun stage_line(a: *A.Allocator, l: *topic.Line, gr: *spirv_grammar.Grammar, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    val set: *spirv_index.Instructions = set_instructions(g, out, l.key.data[1]);
    if (set == nil) { ret topic.reject(l, NO_SET, l.key.data[1]); }
    val ins: *spirv_index.Instruction = spirv_index.find(set, l.key.data[2]);
    if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[2]); }
    val err_known: err[diag.Refusal] = topic.known(l, ?STAGE_WORDS[0], 1);
    if (sel err_known.err) { ret err_known; }
    var list:             str               = nil;
    val err_models_found: err[diag.Refusal] = topic.needed(l, "models", ?list);
    if (sel err_models_found.err) { ret err_models_found; }
    var x:          Stage             = Stage{set: l.key.data[1], instruction: ins.name, models: 0, names: nil};
    val err_models: err[diag.Refusal] = members_of(a, l, gr, "ExecutionModel", list, true, ?x.models);
    if (sel err_models.err) { ret err_models; }
    val res_names: res[str, diag.Refusal] = quoted(a, list);
    if (sel res_names.err) { ret err[diag.Refusal].err{res_names.err}; }
    x.names = res_names.ok;
    var k: usize = 0;
    for (k < out.stages.len) {
        if (str_equals(out.stages.data[k].set, x.set) && str_equals(out.stages.data[k].instruction, x.instruction)) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
        k = k + 1;
    }
    if (!pushed(vector.push[Stage](?out.stages, x))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

fun image_line(a: *A.Allocator, l: *topic.Line, gr: *spirv_grammar.Grammar, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    val set: *spirv_index.Instructions = set_instructions(g, out, l.key.data[1]);
    if (set == nil) { ret topic.reject(l, NO_SET, l.key.data[1]); }
    val ins: *spirv_index.Instruction = spirv_index.find(set, l.key.data[2]);
    if (ins == nil) { ret topic.reject(l, NO_INSTRUCTION, l.key.data[2]); }
    val err_known: err[diag.Refusal] = topic.known(l, ?IMAGE_WORDS[0], 17);
    if (sel err_known.err) { ret err_known; }
    var x:               Image             = Image{set: l.key.data[1], instruction: ins.name, image: 0, mask: RESULT, admits: 0, one: 0, exclusive: 0, paired: 0, pairing: 0, sampled: 0, uncubed: 0, constants: 0, dims: 0, depth: false, multisampled: 0, arrayed: 0, levels: 0, unformatted: nil, formats: 0};
    var image:           str               = nil;
    val err_image_found: err[diag.Refusal] = topic.needed(l, "image", ?image);
    if (sel err_image_found.err) { ret err_image_found; }
    val res_image: res[u8, diag.Refusal] = operand_kind(l, ins, image, "IdRef", true, NOT_AN_ID);
    if (sel res_image.err) { ret err[diag.Refusal].err{res_image.err}; }
    x.image = res_image.ok;
    val mask: str = topic.optional(l, "mask", nil);
    if (mask != nil) {
        val res_mask: res[u8, diag.Refusal] = operand_kind(l, ins, mask, "ImageOperands", false, NOT_A_MASK);
        if (sel res_mask.err) { ret err[diag.Refusal].err{res_mask.err}; }
        x.mask = res_mask.ok;
    }
    val err_admits: err[diag.Refusal] = members_of(a, l, gr, "ImageOperands", topic.optional(l, "admits", nil), false, ?x.admits);
    if (sel err_admits.err) { ret err_admits; }
    val err_one: err[diag.Refusal] = members_of(a, l, gr, "ImageOperands", topic.optional(l, "one-of", nil), false, ?x.one);
    if (sel err_one.err) { ret err_one; }
    val err_paired: err[diag.Refusal] = members_of(a, l, gr, "ImageOperands", topic.optional(l, "paired", nil), false, ?x.paired);
    if (sel err_paired.err) { ret err_paired; }
    val err_pairing: err[diag.Refusal] = members_of(a, l, gr, "ImageOperands", topic.optional(l, "pairing", nil), false, ?x.pairing);
    if (sel err_pairing.err) { ret err_pairing; }
    val err_exclusive: err[diag.Refusal] = members_of(a, l, gr, "ImageOperands", topic.optional(l, "exclusive", nil), false, ?x.exclusive);
    if (sel err_exclusive.err) { ret err_exclusive; }
    val err_sampled: err[diag.Refusal] = members_of(a, l, gr, "ImageOperands", topic.optional(l, "sampled", nil), false, ?x.sampled);
    if (sel err_sampled.err) { ret err_sampled; }
    val err_uncubed: err[diag.Refusal] = members_of(a, l, gr, "ImageOperands", topic.optional(l, "uncubed", nil), false, ?x.uncubed);
    if (sel err_uncubed.err) { ret err_uncubed; }
    val err_constants: err[diag.Refusal] = members_of(a, l, gr, "ImageOperands", topic.optional(l, "constants", nil), false, ?x.constants);
    if (sel err_constants.err) { ret err_constants; }
    val err_dims: err[diag.Refusal] = members_of(a, l, gr, "Dim", topic.optional(l, "dims", nil), true, ?x.dims);
    if (sel err_dims.err) { ret err_dims; }
    val res_depth: res[bool, diag.Refusal] = topic.yes(l, "depth", false);
    if (sel res_depth.err) { ret err[diag.Refusal].err{res_depth.err}; }
    x.depth = res_depth.ok;
    val err_ms: err[diag.Refusal] = property(l, "multisampled", ?x.multisampled);
    if (sel err_ms.err) { ret err_ms; }
    val err_arrayed: err[diag.Refusal] = property(l, "arrayed", ?x.arrayed);
    if (sel err_arrayed.err) { ret err_arrayed; }
    val err_levels: err[diag.Refusal] = property(l, "levels", ?x.levels);
    if (sel err_levels.err) { ret err_levels; }
    x.unformatted = topic.optional(l, "unformatted", nil);
    if (x.unformatted != nil && !capability_known(gr, x.unformatted)) { ret topic.reject(l, NO_CAPABILITY, x.unformatted); }
    val err_formats: err[diag.Refusal] = formats_of(a, l, gr, topic.optional(l, "formats", nil), ?x.formats);
    if (sel err_formats.err) { ret err_formats; }
    var k: usize = 0;
    for (k < out.images.len) {
        if (str_equals(out.images.data[k].set, x.set) && str_equals(out.images.data[k].instruction, x.instruction)) { ret topic.reject(l, STATED_TWICE, l.fact.key); }
        k = k + 1;
    }
    if (!pushed(vector.push[Image](?out.images, x))) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].ok{};
}

fun typings(a: *A.Allocator, tree: *source.Tree, gr: *spirv_grammar.Grammar, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    var ls:       vector.Vector[topic.Line] = vector.init[topic.Line](a);
    val err_read: err[diag.Refusal]         = lines_of(a, tree, "typings", g::ptr, topic.unstated, ?ls);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < ls.len) {
        val l: *topic.Line = ?ls.data[i];
        if (topic.is(l, "form", 4)) {
            val err_form_line: err[diag.Refusal] = form_line(a, l, gr, g, out);
            if (sel err_form_line.err) { ret err_form_line; }
        }
        or (topic.is(l, "typed", 4)) {
            val err_typed_line: err[diag.Refusal] = typed_line(a, l, gr, g, out);
            if (sel err_typed_line.err) { ret err_typed_line; }
        }
        or (topic.is(l, "stage", 3)) {
            val err_stage_line: err[diag.Refusal] = stage_line(a, l, gr, g, out);
            if (sel err_stage_line.err) { ret err_stage_line; }
        }
        or (topic.is(l, "image", 3)) {
            val err_image_line: err[diag.Refusal] = image_line(a, l, gr, g, out);
            if (sel err_image_line.err) { ret err_image_line; }
        }
        or (topic.is(l, "format", 2)) {
            val err_format_line: err[diag.Refusal] = format_line(l, gr, out);
            if (sel err_format_line.err) { ret err_format_line; }
        }
        or (topic.is(l, "available", 3)) {
            val err_available_line: err[diag.Refusal] = available_line(l, g, out);
            if (sel err_available_line.err) { ret err_available_line; }
        }
        or (topic.is(l, "present", 4)) {
            val err_present_line: err[diag.Refusal] = present_line(l, gr, g, out);
            if (sel err_present_line.err) { ret err_present_line; }
        }
        or { ret topic.reject(l, topic.BAD_FACT, l.fact.key); }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the facts of the data tree `tree`, held to mink's grammar `gr`, whose core instructions are `g`
pub fun read(a: *A.Allocator, tree: *source.Tree, gr: *spirv_grammar.Grammar, g: *spirv_index.Instructions, out: *Facts) err[diag.Refusal] {
    @out = Facts{controls: map.init[str, Control](a), imports: vector.init[Import](a), versions: vector.init[Version](a), operations: vector.init[Operation](a), omitted: map.init[str, bool](a), mentioned: map.init[str, bool](a), brought: vector.init[Brought](a), accesses: vector.init[Access](a), orders: vector.init[Order](a), quiet: map.init[str, bool](a), names: map.init[str, u8](a), handles: map.init[str, u8](a), results: map.init[str, u8](a), forms: vector.init[Form](a), typed: vector.init[Typed](a), present: vector.init[Present](a), images: vector.init[Image](a), stages: vector.init[Stage](a), withdrawn: vector.init[Withdrawn](a), formats: vector.init[Format](a)};
    val err_controls: err[diag.Refusal] = controls(a, tree, g, out);
    if (sel err_controls.err) { ret err_controls; }
    val err_imports: err[diag.Refusal] = imports(a, tree, gr, out);
    if (sel err_imports.err) { ret err_imports; }
    val err_versions: err[diag.Refusal] = versions(a, tree, out);
    if (sel err_versions.err) { ret err_versions; }
    val err_operations: err[diag.Refusal] = operations(a, tree, g, out);
    if (sel err_operations.err) { ret err_operations; }
    val err_omissions: err[diag.Refusal] = omissions(a, tree, gr, out);
    if (sel err_omissions.err) { ret err_omissions; }
    val err_mentions: err[diag.Refusal] = mentions(a, tree, gr, out);
    if (sel err_mentions.err) { ret err_mentions; }
    val err_brings: err[diag.Refusal] = brings(a, tree, gr, out);
    if (sel err_brings.err) { ret err_brings; }
    val err_accesses: err[diag.Refusal] = accesses(a, tree, g, out);
    if (sel err_accesses.err) { ret err_accesses; }
    val err_handles: err[diag.Refusal] = handles(a, tree, g, out);
    if (sel err_handles.err) { ret err_handles; }
    ret typings(a, tree, gr, g, out);
}
