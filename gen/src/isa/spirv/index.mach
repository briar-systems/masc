# mink's spir-v grammar as the spir-v generator reads it
#
# the grammar is mink's (`mink.format.spirv.grammar`, its rows in `mink.format.spirv.tables`), the one generated
# statement of it. it numbers the core instructions by opcode and an extended set's by number, each in a record of its
# own, and gen's facts and rows name an instruction by its opname, so this lays the core opcodes and each extended
# set's instructions out in one form, in their order, with an index by name. a kind's category is read off its shape.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use spirv_grammar: mink.format.spirv.grammar;

use masc.core.operand;

use gen.diag;

pub val TWICE: str = "instruction stated twice";

# one instruction of the core grammar or of an extended set
# ---
# name:         its opname
# opcode:       its opcode, or its number in its extended set
# operands:     its operands in order
# count:        how many
# availability: what makes it available
# class:        the class the grammar files it under, as `Memory` or `Atomic`, nil for none and for an extended set's
pub rec Instruction {
    name:         str;
    opcode:       u32;
    operands:     *spirv_grammar.Operand;
    count:        usize;
    availability: *spirv_grammar.Availability;
    class:        str;
}

# the instructions of the core grammar or of an extended set, in the grammar's order, and each one's index by its name
pub rec Instructions {
    all:     vector.Vector[Instruction];
    by_name: map.Map[str, u32];
}

fun fresh(a: *A.Allocator) Instructions {
    ret Instructions{all: vector.init[Instruction](a), by_name: map.init[str, u32](a)};
}

fun added(x: *Instructions, ins: Instruction) res[bool, diag.Refusal] {
    var key:   str       = ins.name;
    val known: opt[*u32] = map.get[str, u32](?x.by_name, ?key);
    if (sel known.some) { ret res[bool, diag.Refusal].err{diag.refusal(nil, 0, TWICE, ins.name)}; }
    val put: res[bool, A.Error] = map.insert[str, u32](?x.by_name, ins.name, x.all.len::u32);
    if (sel put.err) { ret res[bool, diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, nil)}; }
    val pushed: res[usize, A.Error] = vector.push[Instruction](?x.all, ins);
    if (sel pushed.err) { ret res[bool, diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, nil)}; }
    ret res[bool, diag.Refusal].ok{true};
}

# the core instructions of `g`, ascending by opcode
pub fun core(a: *A.Allocator, g: *spirv_grammar.Grammar) res[Instructions, diag.Refusal] {
    var x: Instructions = fresh(a);
    var i: usize        = 0;
    for (i < g.count) {
        val op:  *spirv_grammar.Op       = ?g.ops[i];
        val got: res[bool, diag.Refusal] = added(?x, Instruction{name: op.name, opcode: op.code, operands: op.operands, count: op.count, availability: ?op.availability, class: op.class});
        if (sel got.err) { ret res[Instructions, diag.Refusal].err{got.err}; }
        i = i + 1;
    }
    ret res[Instructions, diag.Refusal].ok{x};
}

# the instructions of the extended set `s`, ascending by number
pub fun set(a: *A.Allocator, s: *spirv_grammar.Set) res[Instructions, diag.Refusal] {
    var x: Instructions = fresh(a);
    var i: usize        = 0;
    for (i < s.count) {
        val ins: *spirv_grammar.Instruction = ?s.instructions[i];
        val got: res[bool, diag.Refusal]    = added(?x, Instruction{name: ins.name, opcode: ins.number, operands: ins.operands, count: ins.count, availability: ?ins.availability, class: nil});
        if (sel got.err) { ret res[Instructions, diag.Refusal].err{got.err}; }
        i = i + 1;
    }
    ret res[Instructions, diag.Refusal].ok{x};
}

# the instruction of `x` named `name`, nil when it holds none
pub fun find(x: *Instructions, name: str) *Instruction {
    var key:   str       = name;
    val known: opt[*u32] = map.get[str, u32](?x.by_name, ?key);
    if (sel known.none) { ret nil; }
    ret ?x.all.data[@known.some];
}

# whether a kind's words are an id: a result type, a result or an id used
pub fun is_id(k: *spirv_grammar.Kind) bool {
    ret sel k.shape.result_type || sel k.shape.result || sel k.shape.id;
}

# the enumerants of a value or bit enumeration, nil for a kind that is neither
pub fun enumerants(k: *spirv_grammar.Kind) *spirv_grammar.Enum {
    if (sel k.shape.value) { ret k.shape.value; }
    if (sel k.shape.bits)  { ret k.shape.bits; }
    ret nil;
}

# whether a kind is a literal: neither an id, an enumeration nor a pair
pub fun is_literal(k: *spirv_grammar.Kind) bool {
    ret !is_id(k) && enumerants(k) == nil && !(sel k.shape.pair);
}

# how many values an operand takes, in masc's operand model
pub fun quantity(o: *spirv_grammar.Operand) operand.Quantity {
    if (sel o.quantifier.optional) { ret operand.OPTIONAL; }
    if (sel o.quantifier.many)     { ret operand.VARIADIC; }
    ret operand.ONE;
}

# the operand of instruction `ins` that a context-dependent literal at `at` takes its width from, by the literal's
# shape: a number the result type's, and a selector, or a pair's selector member, the first operand's. none for an
# operand whose width no other operand gives
pub fun width_of(ins: *Instruction, at: usize) opt[u8] {
    var k: *spirv_grammar.Kind = ins.operands[at].kind;
    if (sel k.shape.pair)      { k = k.shape.pair.first; }
    if (sel k.shape.selector)  { ret opt[u8].some{0}; }
    if (!(sel k.shape.number)) { ret opt[u8].none{}; }
    var i: usize = 0;
    for (i < ins.count) {
        if (sel ins.operands[i].kind.shape.result_type) { ret opt[u8].some{i::u8}; }
        i = i + 1;
    }
    ret opt[u8].none{};
}
