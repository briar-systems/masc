# the sections of an XED pattern or instruction file
#
# such a file is a run of sections, each opened by a header `NAME()::`, or `type NAME()::` for a
# lookup nonterminal that returns a value, and holding every line up to the next header outside
# a `{` record. a section whose name holds INSTRUCTIONS holds instruction records, any other a
# nonterminal's rules (pysrc/generator.py read_input). XED reads every file of a kind as one, so
# the lines of a file before its first header continue the last section of the file before it,
# as amd/xed-amd-sse4a.txt continues the INSTRUCTIONS of xed-amd-svm.txt, and in the first file
# they are refused

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.view.View;
use std.types.view.view_eq_str;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use gen.isa.x86.xed.pattern;
use gen.isa.x86.xed.text;
use gen.lines;
use gen.source;

# one section
# ---
# name:         the nonterminal it opens
# type:         the type a lookup nonterminal returns, nil for any other
# instructions: whether it holds instruction records
# header:       its header line
# lines:        its lines after the header
pub rec Section {
    name:         str;
    type:         str;
    instructions: bool;
    header:       lines.Line;
    lines:        vector.Vector[lines.Line];
}

pub val NO_HEADER:  str = "line before any nonterminal header";
pub val BAD_HEADER: str = "nonterminal header is not `NAME()::` or `type NAME()::`";

fun header(a: *A.Allocator, l: *lines.Line, at: usize) res[Section, diag.Refusal] {
    val bad: res[Section, diag.Refusal] = res[Section, diag.Refusal].err{lines.refuse(l, BAD_HEADER, nil)};
    if (text.trim(text.part(l.text, at + 2, l.text.len - at - 2)).len != 0) { ret bad; }
    var head: lines.Line                             = lines.Line{file: l.file, number: l.number, text: text.part(l.text, 0, at)};
    val toks: res[vector.Vector[View], diag.Refusal] = lines.tokens(a, ?head);
    if (sel toks.err)                       { ret res[Section, diag.Refusal].err{toks.err}; }
    if (toks.ok.len < 1 || toks.ok.len > 2) { ret bad; }
    var s:    Section                = Section{name: nil, type: nil, instructions: false, header: @l, lines: vector.init[lines.Line](a)};
    val last: res[str, diag.Refusal] = text.owned(a, l, toks.ok.data[toks.ok.len - 1]);
    if (sel last.err) { ret res[Section, diag.Refusal].err{last.err}; }
    val name: opt[str] = pattern.call(a, last.ok);
    if (sel name.none) { ret bad; }
    s.name         = name.some;
    s.instructions = str_contains(s.name, "INSTRUCTIONS");
    if (toks.ok.len == 2) {
        val type: res[str, diag.Refusal] = text.owned(a, l, toks.ok.data[0]);
        if (sel type.err) { ret res[Section, diag.Refusal].err{type.err}; }
        s.type = type.ok;
    }
    ret res[Section, diag.Refusal].ok{s};
}

fun opener(l: *lines.Line) opt[usize] {
    var i: usize = 0;
    for (i + 1 < l.text.len) {
        if (l.text.data[i] == ':' && l.text.data[i + 1] == ':') { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# the sections of `f`, its slash repeats expanded
# ---
# a:      allocator for the sections
# f:      the file
# before: the last section of the file of its kind before it, nil for the first
pub fun read(a: *A.Allocator, f: *source.File, before: *Section) res[vector.Vector[Section], diag.Refusal] {
    val got: res[vector.Vector[lines.Line], diag.Refusal] = text.read(a, f, true);
    if (sel got.err) { ret res[vector.Vector[Section], diag.Refusal].err{got.err}; }
    var out:    vector.Vector[Section] = vector.init[Section](a);
    var record: bool                   = false;
    var i:      usize                  = 0;
    for (i < got.ok.len) {
        val l:  *lines.Line = ?got.ok.data[i];
        var at: usize       = 0;
        val op: opt[usize]  = opener(l);
        if (sel op.some) { at = op.some; }
        if (sel op.some && !record) {
            val s: res[Section, diag.Refusal] = header(a, l, at);
            if (sel s.err)                                      { ret res[vector.Vector[Section], diag.Refusal].err{s.err}; }
            if (!text.pushed(vector.push[Section](?out, s.ok))) { ret res[vector.Vector[Section], diag.Refusal].err{text.memory(l)}; }
        }
        or {
            if (out.len == 0 && before == nil) { ret res[vector.Vector[Section], diag.Refusal].err{lines.refuse(l, NO_HEADER, nil)}; }
            if (out.len == 0) {
                val carried: Section = Section{name: before.name, type: before.type, instructions: before.instructions, header: before.header, lines: vector.init[lines.Line](a)};
                if (!text.pushed(vector.push[Section](?out, carried))) { ret res[vector.Vector[Section], diag.Refusal].err{text.memory(l)}; }
            }
            if (view_eq_str(l.text, "{"))                                                { record = true; }
            if (view_eq_str(l.text, "}"))                                                { record = false; }
            if (!text.pushed(vector.push[lines.Line](?out.data[out.len - 1].lines, @l))) { ret res[vector.Vector[Section], diag.Refusal].err{text.memory(l)}; }
        }
        i = i + 1;
    }
    ret res[vector.Vector[Section], diag.Refusal].ok{out};
}
