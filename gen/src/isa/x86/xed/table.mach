# the flat tables of XED's datafiles: state macros, operand fields, registers, widths and element types
#
# each is a file of one record a line, read from every file the layers list for its kind:
#   state          `name token...`: a pattern token standing for the tokens after it
#   fields         `NAME SCALAR ctype bits visibility print scope DO|DS EO|EI`: an operand storage
#                  field. DS marks a field the decoder skips, whose tests a decode pattern drops
#   registers      `name class width [enclosing [ordinal [h|- [display]]]]`: a register, its width
#                  `32/64` when it differs outside 64-bit mode and `NA` for a pseudo-register, and the
#                  widest register enclosing it, `a/b` when that differs outside 64-bit mode
#   widths         `code type bytes` or `code type bytes16 bytes32 bytes64`: an operand width code, a
#                  size given in bytes or as `Nbits`
#   extra-widths   `nt|reg|imm_const name code`: the width code of an operand that writes none
#   element-types  `name base bits`: an element type an operand may name
# a register stated twice keeps the wider statement, and then the one whose enclosing register is
# wider (pysrc/refine_regs.py refine_regs_input). a width or element type stated again replaces
# the earlier, as XED's tables do, and a state macro or field stated twice is refused

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_index_char;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use gen.diag;
use gen.isa.x86.xed.layer;
use gen.isa.x86.xed.text;
use gen.lines;

# one state macro
pub rec Macro {
    name:   str;
    tokens: vector.Vector[str];
    line:   lines.Line;
}

# one operand storage field
# ---
# ctype: the C type XED stores it as
# bits:  how many bits it holds
# skip:  whether the decoder skips it (DS), so a decode pattern's test of it is dropped
pub rec Field {
    name:  str;
    ctype: str;
    bits:  u32;
    skip:  bool;
    line:  lines.Line;
}

# one register
# ---
# class:       its class, as XED spells it, such as `gpr` or `xmm`
# width:       its width in bits, 0 for a pseudo-register
# width64:     its width in 64-bit mode
# enclosing:   the widest register enclosing it in 64-bit mode
# enclosing32: the widest register enclosing it outside 64-bit mode
# ordinal:     its number in its class
# high:        whether it is a high byte register, ah to dh
# display:     the name XED prints for it
pub rec Register {
    name:        str;
    class:       str;
    width:       u32;
    width64:     u32;
    enclosing:   str;
    enclosing32: str;
    ordinal:     u32;
    high:        bool;
    display:     str;
    line:        lines.Line;
}

# one operand width code
# ---
# element: the element type it assumes
# bits:    its width in bits at an effective operand size of 8, 16, 32 and 64
pub rec Width {
    name:    str;
    element: str;
    bits:    [4]u32;
    line:    lines.Line;
}

# one element type
pub rec Type {
    name: str;
    base: str;
    bits: u32;
    line: lines.Line;
}

# the width code an operand of a nonterminal, a register or a constant takes when it writes none
pub rec Extra {
    name: str;
    code: str;
}

pub rec Tables {
    macros:    vector.Vector[Macro];
    fields:    vector.Vector[Field];
    registers: vector.Vector[Register];
    widths:    vector.Vector[Width];
    types:     vector.Vector[Type];
    nts:       vector.Vector[Extra];
    regs:      vector.Vector[Extra];
    consts:    vector.Vector[Extra];
    index:     map.Map[str, u32];
}

pub val FIELDS:       str = "record has the wrong number of fields";
pub val NUMBER:       str = "field is not a number";
pub val MACRO_TWICE:  str = "state macro stated twice";
pub val FIELD_TWICE:  str = "operand field stated twice";
pub val BAD_SKIP:     str = "decoder column is not DO, DI or DS";
pub val BAD_HIGH:     str = "high byte column is neither h nor -";
pub val BAD_EXTRA:    str = "extra width is not of an nt, a reg or an imm_const";
pub val BAD_ENCLOSER: str = "enclosing register is not a register";

# the index key of `name` in table `t`, a byte that tells the tables apart
fun key(a: *A.Allocator, t: u8, name: str) opt[str] {
    val n:            usize             = str_len(name);
    val res_allocate: res[*u8, A.Error] = A.allocate[u8](a, n + 2);
    if (sel res_allocate.err) { ret opt[str].none{}; }
    res_allocate.ok[0] = t;
    var i: usize = 0;
    for (i <= n) {
        res_allocate.ok[i + 1] = name[i];
        i                      = i + 1;
    }
    ret opt[str].some{res_allocate.ok};
}

pub val MACROS:    u8 = 'm';
pub val FIELD:     u8 = 'f';
pub val REGISTERS: u8 = 'r';
pub val WIDTHS:    u8 = 'w';
pub val TYPES:     u8 = 't';
pub val NTS:       u8 = 'n';
pub val REGS:      u8 = 'g';
pub val CONSTS:    u8 = 'c';

# where `name` is in table `t`
pub fun at(a: *A.Allocator, x: *Tables, t: u8, name: str) opt[u32] {
    val opt_key: opt[str] = key(a, t, name);
    if (sel opt_key.none) { ret opt[u32].none{}; }
    val opt_index_entry: opt[*u32] = map.get[str, u32](?x.index, ?opt_key.some);
    if (sel opt_index_entry.none) { ret opt[u32].none{}; }
    ret opt[u32].some{@opt_index_entry.some};
}

fun put(a: *A.Allocator, x: *Tables, l: *lines.Line, t: u8, name: str, i: usize) err[diag.Refusal] {
    val opt_key: opt[str] = key(a, t, name);
    if (sel opt_key.none) { ret err[diag.Refusal].err{text.memory(l)}; }
    val res_index_inserted: res[bool, A.Error] = map.insert[str, u32](?x.index, opt_key.some, i::u32);
    if (sel res_index_inserted.err) { ret err[diag.Refusal].err{text.memory(l)}; }
    ret err[diag.Refusal].ok{};
}

# the macro `name`
pub fun macro(a: *A.Allocator, x: *Tables, name: str) opt[*Macro] {
    val opt_macros_at: opt[u32] = at(a, x, MACROS, name);
    if (sel opt_macros_at.none) { ret opt[*Macro].none{}; }
    ret opt[*Macro].some{?x.macros.data[opt_macros_at.some]};
}

# the field `name`
pub fun field(a: *A.Allocator, x: *Tables, name: str) opt[*Field] {
    val opt_field_at: opt[u32] = at(a, x, FIELD, name);
    if (sel opt_field_at.none) { ret opt[*Field].none{}; }
    ret opt[*Field].some{?x.fields.data[opt_field_at.some]};
}

# the register `name`, spelled without XED's `XED_REG_` prefix
pub fun register(a: *A.Allocator, x: *Tables, name: str) opt[*Register] {
    val opt_registers_at: opt[u32] = at(a, x, REGISTERS, name);
    if (sel opt_registers_at.none) { ret opt[*Register].none{}; }
    ret opt[*Register].some{?x.registers.data[opt_registers_at.some]};
}

# the width code `name`
pub fun width(a: *A.Allocator, x: *Tables, name: str) opt[*Width] {
    val opt_widths_at: opt[u32] = at(a, x, WIDTHS, name);
    if (sel opt_widths_at.none) { ret opt[*Width].none{}; }
    ret opt[*Width].some{?x.widths.data[opt_widths_at.some]};
}

# the element type `name`
pub fun element(a: *A.Allocator, x: *Tables, name: str) opt[*Type] {
    val opt_types_at: opt[u32] = at(a, x, TYPES, name);
    if (sel opt_types_at.none) { ret opt[*Type].none{}; }
    ret opt[*Type].some{?x.types.data[opt_types_at.some]};
}

# the width code an operand of the table `t`, one of NTS, REGS and CONSTS, named `name` takes when it writes none
pub fun extra(a: *A.Allocator, x: *Tables, t: u8, name: str) opt[str] {
    val opt_name_at: opt[u32] = at(a, x, t, name);
    if (sel opt_name_at.none) { ret opt[str].none{}; }
    if (t == NTS)             { ret opt[str].some{x.nts.data[opt_name_at.some].code}; }
    if (t == REGS)            { ret opt[str].some{x.regs.data[opt_name_at.some].code}; }
    ret opt[str].some{x.consts.data[opt_name_at.some].code};
}

# the whitespace-separated words of `l`, owned
pub fun words(a: *A.Allocator, l: *lines.Line) res[vector.Vector[str], diag.Refusal] {
    val res_tokens: res[vector.Vector[View], diag.Refusal] = lines.tokens(a, l);
    if (sel res_tokens.err) { ret res[vector.Vector[str], diag.Refusal].err{res_tokens.err}; }
    var out: vector.Vector[str] = vector.init[str](a);
    var i:   usize              = 0;
    for (i < res_tokens.ok.len) {
        val res_owned: res[str, diag.Refusal] = text.owned(a, l, res_tokens.ok.data[i]);
        if (sel res_owned.err)                                  { ret res[vector.Vector[str], diag.Refusal].err{res_owned.err}; }
        if (!text.pushed(vector.push[str](?out, res_owned.ok))) { ret res[vector.Vector[str], diag.Refusal].err{text.memory(l)}; }
        i = i + 1;
    }
    ret res[vector.Vector[str], diag.Refusal].ok{out};
}

fun decimal(l: *lines.Line, s: str) res[u32, diag.Refusal] {
    val opt_number: opt[u64] = text.number(view(s, str_len(s)));
    if (sel opt_number.none)          { ret res[u32, diag.Refusal].err{lines.refuse(l, NUMBER, s)}; }
    if (opt_number.some > 0xFFFFFFFF) { ret res[u32, diag.Refusal].err{lines.refuse(l, NUMBER, s)}; }
    ret res[u32, diag.Refusal].ok{opt_number.some::u32};
}

# the lines of every file of `kind`
fun records(a: *A.Allocator, files: *vector.Vector[layer.Listed], kind: str, slashes: bool) res[vector.Vector[lines.Line], diag.Refusal] {
    val res_listed: res[vector.Vector[*layer.Listed], diag.Refusal] = layer.of(a, files, kind);
    if (sel res_listed.err) { ret res[vector.Vector[lines.Line], diag.Refusal].err{res_listed.err}; }
    var out: vector.Vector[lines.Line] = vector.init[lines.Line](a);
    var i:   usize                     = 0;
    for (i < res_listed.ok.len) {
        val res_read: res[vector.Vector[lines.Line], diag.Refusal] = text.read(a, res_listed.ok.data[i].file, slashes);
        if (sel res_read.err) { ret res[vector.Vector[lines.Line], diag.Refusal].err{res_read.err}; }
        var k: usize = 0;
        for (k < res_read.ok.len) {
            if (!text.pushed(vector.push[lines.Line](?out, res_read.ok.data[k]))) { ret res[vector.Vector[lines.Line], diag.Refusal].err{text.memory(?res_read.ok.data[k])}; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret res[vector.Vector[lines.Line], diag.Refusal].ok{out};
}

fun read_macros(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val res_records: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "state", true);
    if (sel res_records.err) { ret err[diag.Refusal].err{res_records.err}; }
    var i: usize = 0;
    for (i < res_records.ok.len) {
        val l:         *lines.Line                           = ?res_records.ok.data[i];
        val res_words: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel res_words.err)    { ret err[diag.Refusal].err{res_words.err}; }
        if (res_words.ok.len < 2) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        val name:     str         = res_words.ok.data[0];
        val opt_seen: opt[*Macro] = macro(a, x, name);
        if (sel opt_seen.some) { ret err[diag.Refusal].err{lines.refuse(l, MACRO_TWICE, name)}; }
        var m: Macro = Macro{name: name, tokens: vector.init[str](a), line: @l};
        var k: usize = 1;
        for (k < res_words.ok.len) {
            if (!text.pushed(vector.push[str](?m.tokens, res_words.ok.data[k]))) { ret err[diag.Refusal].err{text.memory(l)}; }
            k = k + 1;
        }
        val err_placed: err[diag.Refusal] = put(a, x, l, MACROS, name, x.macros.len);
        if (sel err_placed.err)                             { ret err_placed; }
        if (!text.pushed(vector.push[Macro](?x.macros, m))) { ret err[diag.Refusal].err{text.memory(l)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun read_fields(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val res_records: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "fields", false);
    if (sel res_records.err) { ret err[diag.Refusal].err{res_records.err}; }
    var i: usize = 0;
    for (i < res_records.ok.len) {
        val l:         *lines.Line                           = ?res_records.ok.data[i];
        val res_words: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel res_words.err)     { ret err[diag.Refusal].err{res_words.err}; }
        if (res_words.ok.len != 9) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        val name:     str         = res_words.ok.data[0];
        val opt_seen: opt[*Field] = field(a, x, name);
        if (sel opt_seen.some) { ret err[diag.Refusal].err{lines.refuse(l, FIELD_TWICE, name)}; }
        val res_bits: res[u32, diag.Refusal] = decimal(l, res_words.ok.data[3]);
        if (sel res_bits.err) { ret err[diag.Refusal].err{res_bits.err}; }
        val skip: str = res_words.ok.data[7];
        if (!str_equals(skip, "DO") && !str_equals(skip, "DI") && !str_equals(skip, "DS")) { ret err[diag.Refusal].err{lines.refuse(l, BAD_SKIP, skip)}; }
        val err_placed: err[diag.Refusal] = put(a, x, l, FIELD, name, x.fields.len);
        if (sel err_placed.err)                                                                                                                                     { ret err_placed; }
        if (!text.pushed(vector.push[Field](?x.fields, Field{name: name, ctype: res_words.ok.data[2], bits: res_bits.ok, skip: str_equals(skip, "DS"), line: @l}))) { ret err[diag.Refusal].err{text.memory(l)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the two halves of `s` around its `/`, or `s` twice
fun halves(a: *A.Allocator, l: *lines.Line, s: str, left: *str, right: *str) err[diag.Refusal] {
    val opt_cut: opt[usize] = str_index_char(s, '/');
    if (sel opt_cut.none) {
        @left  = s;
        @right = s;
        ret err[diag.Refusal].ok{};
    }
    val res_one: res[str, StrError] = str_copy_slice(a, s, 0, opt_cut.some);
    if (sel res_one.err) { ret err[diag.Refusal].err{text.memory(l)}; }
    @left  = res_one.ok;
    @right = ?s[opt_cut.some + 1];
    ret err[diag.Refusal].ok{};
}

fun register_width(l: *lines.Line, s: str) res[u32, diag.Refusal] {
    if (str_equals(s, "NA")) { ret res[u32, diag.Refusal].ok{0}; }
    ret decimal(l, s);
}

fun read_registers(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val res_records: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "registers", false);
    if (sel res_records.err) { ret err[diag.Refusal].err{res_records.err}; }
    var all: vector.Vector[Register] = vector.init[Register](a);
    var i:   usize                   = 0;
    for (i < res_records.ok.len) {
        val l:         *lines.Line                           = ?res_records.ok.data[i];
        val res_words: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel res_words.err)                            { ret err[diag.Refusal].err{res_words.err}; }
        if (res_words.ok.len < 3 || res_words.ok.len > 7) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        var r:         Register          = Register{name: res_words.ok.data[0], class: res_words.ok.data[1], width: 0, width64: 0, enclosing: res_words.ok.data[0], enclosing32: res_words.ok.data[0], ordinal: 0, high: false, display: res_words.ok.data[0], line: @l};
        var narrow:    str               = nil;
        var wide:      str               = nil;
        val err_split: err[diag.Refusal] = halves(a, l, res_words.ok.data[2], ?narrow, ?wide);
        if (sel err_split.err) { ret err_split; }
        val res_register_width: res[u32, diag.Refusal] = register_width(l, narrow);
        if (sel res_register_width.err) { ret err[diag.Refusal].err{res_register_width.err}; }
        val res_register_width_wide: res[u32, diag.Refusal] = register_width(l, wide);
        if (sel res_register_width_wide.err) { ret err[diag.Refusal].err{res_register_width_wide.err}; }
        r.width   = res_register_width.ok;
        r.width64 = res_register_width_wide.ok;
        if (res_words.ok.len >= 4) {
            val err_halves: err[diag.Refusal] = halves(a, l, res_words.ok.data[3], ?r.enclosing, ?r.enclosing32);
            if (sel err_halves.err) { ret err_halves; }
        }
        if (res_words.ok.len >= 5) {
            val res_decimal: res[u32, diag.Refusal] = decimal(l, res_words.ok.data[4]);
            if (sel res_decimal.err) { ret err[diag.Refusal].err{res_decimal.err}; }
            r.ordinal = res_decimal.ok;
        }
        if (res_words.ok.len >= 6) {
            val h: str = res_words.ok.data[5];
            if (!str_equals(h, "h") && !str_equals(h, "-")) { ret err[diag.Refusal].err{lines.refuse(l, BAD_HIGH, h)}; }
            r.high = str_equals(h, "h");
        }
        if (res_words.ok.len == 7)                        { r.display = res_words.ok.data[6]; }
        if (!text.pushed(vector.push[Register](?all, r))) { ret err[diag.Refusal].err{text.memory(l)}; }
        i = i + 1;
    }
    # the widest width each name is stated at, which decides between two statements of one register
    var widest: map.Map[str, u32] = map.init[str, u32](a);
    i = 0;
    for (i < all.len) {
        val r:        *Register = ?all.data[i];
        val opt_seen: opt[*u32] = map.get[str, u32](?widest, ?r.name);
        if (sel opt_seen.some) {
            if (@opt_seen.some < r.width) { @opt_seen.some = r.width; }
        }
        or {
            val res_put: res[bool, A.Error] = map.insert[str, u32](?widest, r.name, r.width);
            if (sel res_put.err) { ret err[diag.Refusal].err{text.memory(?r.line)}; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < all.len) {
        val r:       *Register = ?all.data[i];
        val opt_was: opt[u32]  = at(a, x, REGISTERS, r.name);
        if (sel opt_was.some) {
            val old: *Register = ?x.registers.data[opt_was.some];
            if (old.width < r.width) { @old = @r; }
            or {
                val opt_before: opt[*u32] = map.get[str, u32](?widest, ?old.enclosing);
                val opt_after:  opt[*u32] = map.get[str, u32](?widest, ?r.enclosing);
                if (sel opt_before.none)                { ret err[diag.Refusal].err{lines.refuse(?old.line, BAD_ENCLOSER, old.enclosing)}; }
                if (sel opt_after.none)                 { ret err[diag.Refusal].err{lines.refuse(?r.line, BAD_ENCLOSER, r.enclosing)}; }
                if (@opt_before.some < @opt_after.some) { @old = @r; }
            }
        }
        or {
            val err_placed: err[diag.Refusal] = put(a, x, ?r.line, REGISTERS, r.name, x.registers.len);
            if (sel err_placed.err)                                    { ret err_placed; }
            if (!text.pushed(vector.push[Register](?x.registers, @r))) { ret err[diag.Refusal].err{text.memory(?r.line)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# a width given in bytes, or in bits as `Nbits`
fun size(a: *A.Allocator, l: *lines.Line, s: str) res[u32, diag.Refusal] {
    val n: usize = str_len(s);
    if (n > 4 && str_equals(?s[n - 4], "bits")) {
        val res_digits: res[str, StrError] = str_copy_slice(a, s, 0, n - 4);
        if (sel res_digits.err) { ret res[u32, diag.Refusal].err{text.memory(l)}; }
        ret decimal(l, res_digits.ok);
    }
    val res_bytes: res[u32, diag.Refusal] = decimal(l, s);
    if (sel res_bytes.err) { ret res_bytes; }
    ret res[u32, diag.Refusal].ok{res_bytes.ok * 8};
}

fun read_widths(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val res_records: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "widths", false);
    if (sel res_records.err) { ret err[diag.Refusal].err{res_records.err}; }
    var i: usize = 0;
    for (i < res_records.ok.len) {
        val l:         *lines.Line                           = ?res_records.ok.data[i];
        val res_words: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel res_words.err)                              { ret err[diag.Refusal].err{res_words.err}; }
        if (res_words.ok.len != 3 && res_words.ok.len != 5) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        var d: Width = Width{name: res_words.ok.data[0], element: res_words.ok.data[1], bits: [4]u32{0, 0, 0, 0}, line: @l};
        if (res_words.ok.len == 3) {
            val res_all: res[u32, diag.Refusal] = size(a, l, res_words.ok.data[2]);
            if (sel res_all.err) { ret err[diag.Refusal].err{res_all.err}; }
            d.bits = [4]u32{res_all.ok, res_all.ok, res_all.ok, res_all.ok};
        }
        or {
            var k: u32 = 0;
            for (k < 3) {
                val res_each: res[u32, diag.Refusal] = size(a, l, res_words.ok.data[2 + k]);
                if (sel res_each.err) { ret err[diag.Refusal].err{res_each.err}; }
                d.bits[k + 1] = res_each.ok;
                k             = k + 1;
            }
        }
        val opt_was: opt[u32] = at(a, x, WIDTHS, d.name);
        if (sel opt_was.some) { x.widths.data[opt_was.some] = d; }
        or {
            val err_placed: err[diag.Refusal] = put(a, x, l, WIDTHS, d.name, x.widths.len);
            if (sel err_placed.err)                             { ret err_placed; }
            if (!text.pushed(vector.push[Width](?x.widths, d))) { ret err[diag.Refusal].err{text.memory(l)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun read_types(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val res_records: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "element-types", false);
    if (sel res_records.err) { ret err[diag.Refusal].err{res_records.err}; }
    var i: usize = 0;
    for (i < res_records.ok.len) {
        val l:         *lines.Line                           = ?res_records.ok.data[i];
        val res_words: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel res_words.err)     { ret err[diag.Refusal].err{res_words.err}; }
        if (res_words.ok.len != 3) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        val res_bits: res[u32, diag.Refusal] = decimal(l, res_words.ok.data[2]);
        if (sel res_bits.err) { ret err[diag.Refusal].err{res_bits.err}; }
        val t:       Type     = Type{name: res_words.ok.data[0], base: res_words.ok.data[1], bits: res_bits.ok, line: @l};
        val opt_was: opt[u32] = at(a, x, TYPES, t.name);
        if (sel opt_was.some) { x.types.data[opt_was.some] = t; }
        or {
            val err_placed: err[diag.Refusal] = put(a, x, l, TYPES, t.name, x.types.len);
            if (sel err_placed.err)                           { ret err_placed; }
            if (!text.pushed(vector.push[Type](?x.types, t))) { ret err[diag.Refusal].err{text.memory(l)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun read_extras(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val res_records: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "extra-widths", false);
    if (sel res_records.err) { ret err[diag.Refusal].err{res_records.err}; }
    var i: usize = 0;
    for (i < res_records.ok.len) {
        val l:         *lines.Line                           = ?res_records.ok.data[i];
        val res_words: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel res_words.err)     { ret err[diag.Refusal].err{res_words.err}; }
        if (res_words.ok.len != 3) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        var t:  u8                    = 0;
        var to: *vector.Vector[Extra] = nil;
        if (str_equals(res_words.ok.data[0], "nt")) {
            t  = NTS;
            to = ?x.nts;
        }
        or (str_equals(res_words.ok.data[0], "reg")) {
            t  = REGS;
            to = ?x.regs;
        }
        or (str_equals(res_words.ok.data[0], "imm_const")) {
            t  = CONSTS;
            to = ?x.consts;
        }
        or { ret err[diag.Refusal].err{lines.refuse(l, BAD_EXTRA, res_words.ok.data[0])}; }
        val e:       Extra    = Extra{name: res_words.ok.data[1], code: res_words.ok.data[2]};
        val opt_was: opt[u32] = at(a, x, t, e.name);
        if (sel opt_was.some) { to.data[opt_was.some] = e; }
        or {
            val err_placed: err[diag.Refusal] = put(a, x, l, t, e.name, to.len);
            if (sel err_placed.err)                      { ret err_placed; }
            if (!text.pushed(vector.push[Extra](to, e))) { ret err[diag.Refusal].err{text.memory(l)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# every flat table the layers list
pub fun read(a: *A.Allocator, files: *vector.Vector[layer.Listed]) res[Tables, diag.Refusal] {
    var x: Tables = Tables{
        macros:    vector.init[Macro](a),
        fields:    vector.init[Field](a),
        registers: vector.init[Register](a),
        widths:    vector.init[Width](a),
        types:     vector.init[Type](a),
        nts:       vector.init[Extra](a),
        regs:      vector.init[Extra](a),
        consts:    vector.init[Extra](a),
        index:     map.init[str, u32](a),
    };
    val err_read_macros: err[diag.Refusal] = read_macros(a, ?x, files);
    if (sel err_read_macros.err) { ret res[Tables, diag.Refusal].err{err_read_macros.err}; }
    val err_read_fields: err[diag.Refusal] = read_fields(a, ?x, files);
    if (sel err_read_fields.err) { ret res[Tables, diag.Refusal].err{err_read_fields.err}; }
    val err_read_registers: err[diag.Refusal] = read_registers(a, ?x, files);
    if (sel err_read_registers.err) { ret res[Tables, diag.Refusal].err{err_read_registers.err}; }
    val err_read_widths: err[diag.Refusal] = read_widths(a, ?x, files);
    if (sel err_read_widths.err) { ret res[Tables, diag.Refusal].err{err_read_widths.err}; }
    val err_read_types: err[diag.Refusal] = read_types(a, ?x, files);
    if (sel err_read_types.err) { ret res[Tables, diag.Refusal].err{err_read_types.err}; }
    val err_read_extras: err[diag.Refusal] = read_extras(a, ?x, files);
    if (sel err_read_extras.err) { ret res[Tables, diag.Refusal].err{err_read_extras.err}; }
    ret res[Tables, diag.Refusal].ok{x};
}
