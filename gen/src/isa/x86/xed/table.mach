# the flat tables of XED's datafiles: state macros, operand fields, registers, widths and element types
#
# each is a file of one record a line, read from every file the layers list for its kind:
#   state          `name token...`: a pattern token standing for the tokens after it
#   fields         `NAME SCALAR ctype bits visibility print scope DO|DS EO|EI`: an operand storage
#                  field. DS marks a field the decoder skips, whose tests a decode pattern drops
#   registers      `name class width [enclosing [ordinal [h|- [display]]]]`: a register, its width
#                  `32/64` when it differs outside 64-bit mode and `NA` for a pseudo-register, and the
#                  widest register enclosing it, `a/b` when that differs outside 64-bit mode
#   widths         `code type bytes` or `code type bytes16 bytes32 bytes64`: an operand width code, a
#                  size given in bytes or as `Nbits`
#   extra-widths   `nt|reg|imm_const name code`: the width code of an operand that writes none
#   element-types  `name base bits`: an element type an operand may name
# a register stated twice keeps the wider statement, and then the one whose enclosing register is
# wider (pysrc/refine_regs.py refine_regs_input). a width or element type stated again replaces
# the earlier, as XED's tables do, and a state macro or field stated twice is refused

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_index_char;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use gen.diag;
use gen.isa.x86.xed.layer;
use gen.isa.x86.xed.text;
use gen.lines;
use gen.source;

# one state macro
pub rec Macro {
    name:   str;
    tokens: vector.Vector[str];
    line:   lines.Line;
}

# one operand storage field
# ---
# ctype: the C type XED stores it as
# bits:  how many bits it holds
# skip:  whether the decoder skips it (DS), so a decode pattern's test of it is dropped
pub rec Field {
    name:  str;
    ctype: str;
    bits:  u32;
    skip:  bool;
    line:  lines.Line;
}

# one register
# ---
# class:       its class, as XED spells it, such as `gpr` or `xmm`
# width:       its width in bits, 0 for a pseudo-register
# width64:     its width in 64-bit mode
# enclosing:   the widest register enclosing it in 64-bit mode
# enclosing32: the widest register enclosing it outside 64-bit mode
# ordinal:     its number in its class
# high:        whether it is a high byte register, ah to dh
# display:     the name XED prints for it
pub rec Register {
    name:        str;
    class:       str;
    width:       u32;
    width64:     u32;
    enclosing:   str;
    enclosing32: str;
    ordinal:     u32;
    high:        bool;
    display:     str;
    line:        lines.Line;
}

# one operand width code
# ---
# element: the element type it assumes
# bits:    its width in bits at an effective operand size of 8, 16, 32 and 64
pub rec Width {
    name:    str;
    element: str;
    bits:    [4]u32;
    line:    lines.Line;
}

# one element type
pub rec Type {
    name: str;
    base: str;
    bits: u32;
    line: lines.Line;
}

# the width code an operand of a nonterminal, a register or a constant takes when it writes none
pub rec Extra {
    name: str;
    code: str;
}

pub rec Tables {
    macros:    vector.Vector[Macro];
    fields:    vector.Vector[Field];
    registers: vector.Vector[Register];
    widths:    vector.Vector[Width];
    types:     vector.Vector[Type];
    nts:       vector.Vector[Extra];
    regs:      vector.Vector[Extra];
    consts:    vector.Vector[Extra];
    index:     map.Map[str, u32];
}

pub val FIELDS:       str = "record has the wrong number of fields";
pub val NUMBER:       str = "field is not a number";
pub val MACRO_TWICE:  str = "state macro stated twice";
pub val FIELD_TWICE:  str = "operand field stated twice";
pub val BAD_SKIP:     str = "decoder column is not DO, DI or DS";
pub val BAD_HIGH:     str = "high byte column is neither h nor -";
pub val BAD_EXTRA:    str = "extra width is not of an nt, a reg or an imm_const";
pub val BAD_ENCLOSER: str = "enclosing register is not a register";

# the index key of `name` in table `t`, a byte that tells the tables apart
fun key(a: *A.Allocator, t: u8, name: str) opt[str] {
    val n:   usize             = str_len(name);
    val got: res[*u8, A.Error] = A.allocate[u8](a, n + 2);
    if (sel got.err) { ret opt[str].none{}; }
    got.ok[0] = t;
    var i: usize = 0;
    for (i <= n) {
        got.ok[i + 1] = name[i];
        i             = i + 1;
    }
    ret opt[str].some{got.ok};
}

pub val MACROS:    u8 = 'm';
pub val FIELD:     u8 = 'f';
pub val REGISTERS: u8 = 'r';
pub val WIDTHS:    u8 = 'w';
pub val TYPES:     u8 = 't';
pub val NTS:       u8 = 'n';
pub val REGS:      u8 = 'g';
pub val CONSTS:    u8 = 'c';

# where `name` is in table `t`
pub fun at(a: *A.Allocator, x: *Tables, t: u8, name: str) opt[u32] {
    val k: opt[str] = key(a, t, name);
    if (sel k.none) { ret opt[u32].none{}; }
    val got: opt[*u32] = map.get[str, u32](?x.index, ?k.some);
    if (sel got.none) { ret opt[u32].none{}; }
    ret opt[u32].some{@got.some};
}

fun put(a: *A.Allocator, x: *Tables, l: *lines.Line, t: u8, name: str, i: usize) err[diag.Refusal] {
    val k: opt[str] = key(a, t, name);
    if (sel k.none) { ret err[diag.Refusal].err{text.memory(l)}; }
    val r: res[bool, A.Error] = map.insert[str, u32](?x.index, k.some, i::u32);
    if (sel r.err) { ret err[diag.Refusal].err{text.memory(l)}; }
    ret err[diag.Refusal].ok{};
}

# the macro `name`
pub fun macro(a: *A.Allocator, x: *Tables, name: str) opt[*Macro] {
    val i: opt[u32] = at(a, x, MACROS, name);
    if (sel i.none) { ret opt[*Macro].none{}; }
    ret opt[*Macro].some{?x.macros.data[i.some]};
}

# the field `name`
pub fun field(a: *A.Allocator, x: *Tables, name: str) opt[*Field] {
    val i: opt[u32] = at(a, x, FIELD, name);
    if (sel i.none) { ret opt[*Field].none{}; }
    ret opt[*Field].some{?x.fields.data[i.some]};
}

# the register `name`, spelled without XED's `XED_REG_` prefix
pub fun register(a: *A.Allocator, x: *Tables, name: str) opt[*Register] {
    val i: opt[u32] = at(a, x, REGISTERS, name);
    if (sel i.none) { ret opt[*Register].none{}; }
    ret opt[*Register].some{?x.registers.data[i.some]};
}

# the width code `name`
pub fun width(a: *A.Allocator, x: *Tables, name: str) opt[*Width] {
    val i: opt[u32] = at(a, x, WIDTHS, name);
    if (sel i.none) { ret opt[*Width].none{}; }
    ret opt[*Width].some{?x.widths.data[i.some]};
}

# the element type `name`
pub fun element(a: *A.Allocator, x: *Tables, name: str) opt[*Type] {
    val i: opt[u32] = at(a, x, TYPES, name);
    if (sel i.none) { ret opt[*Type].none{}; }
    ret opt[*Type].some{?x.types.data[i.some]};
}

# the width code an operand of the table `t`, one of NTS, REGS and CONSTS, named `name` takes when it writes none
pub fun extra(a: *A.Allocator, x: *Tables, t: u8, name: str) opt[str] {
    val i: opt[u32] = at(a, x, t, name);
    if (sel i.none) { ret opt[str].none{}; }
    if (t == NTS)   { ret opt[str].some{x.nts.data[i.some].code}; }
    if (t == REGS)  { ret opt[str].some{x.regs.data[i.some].code}; }
    ret opt[str].some{x.consts.data[i.some].code};
}

# the whitespace-separated words of `l`, owned
pub fun words(a: *A.Allocator, l: *lines.Line) res[vector.Vector[str], diag.Refusal] {
    val got: res[vector.Vector[View], diag.Refusal] = lines.tokens(a, l);
    if (sel got.err) { ret res[vector.Vector[str], diag.Refusal].err{got.err}; }
    var out: vector.Vector[str] = vector.init[str](a);
    var i:   usize              = 0;
    for (i < got.ok.len) {
        val w: res[str, diag.Refusal] = text.owned(a, l, got.ok.data[i]);
        if (sel w.err)                                  { ret res[vector.Vector[str], diag.Refusal].err{w.err}; }
        if (!text.pushed(vector.push[str](?out, w.ok))) { ret res[vector.Vector[str], diag.Refusal].err{text.memory(l)}; }
        i = i + 1;
    }
    ret res[vector.Vector[str], diag.Refusal].ok{out};
}

fun decimal(l: *lines.Line, s: str) res[u32, diag.Refusal] {
    val n: opt[u64] = text.number(view(s, str_len(s)));
    if (sel n.none)          { ret res[u32, diag.Refusal].err{lines.refuse(l, NUMBER, s)}; }
    if (n.some > 0xFFFFFFFF) { ret res[u32, diag.Refusal].err{lines.refuse(l, NUMBER, s)}; }
    ret res[u32, diag.Refusal].ok{n.some::u32};
}

# the lines of every file of `kind`
fun records(a: *A.Allocator, files: *vector.Vector[layer.Listed], kind: str, slashes: bool) res[vector.Vector[lines.Line], diag.Refusal] {
    val listed: res[vector.Vector[*layer.Listed], diag.Refusal] = layer.of(a, files, kind);
    if (sel listed.err) { ret res[vector.Vector[lines.Line], diag.Refusal].err{listed.err}; }
    var out: vector.Vector[lines.Line] = vector.init[lines.Line](a);
    var i:   usize                     = 0;
    for (i < listed.ok.len) {
        val got: res[vector.Vector[lines.Line], diag.Refusal] = text.read(a, listed.ok.data[i].file, slashes);
        if (sel got.err) { ret res[vector.Vector[lines.Line], diag.Refusal].err{got.err}; }
        var k: usize = 0;
        for (k < got.ok.len) {
            if (!text.pushed(vector.push[lines.Line](?out, got.ok.data[k]))) { ret res[vector.Vector[lines.Line], diag.Refusal].err{text.memory(?got.ok.data[k])}; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret res[vector.Vector[lines.Line], diag.Refusal].ok{out};
}

fun read_macros(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val got: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "state", true);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var i: usize = 0;
    for (i < got.ok.len) {
        val l: *lines.Line                           = ?got.ok.data[i];
        val w: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel w.err)    { ret err[diag.Refusal].err{w.err}; }
        if (w.ok.len < 2) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        val name: str         = w.ok.data[0];
        val seen: opt[*Macro] = macro(a, x, name);
        if (sel seen.some) { ret err[diag.Refusal].err{lines.refuse(l, MACRO_TWICE, name)}; }
        var m: Macro = Macro{name: name, tokens: vector.init[str](a), line: @l};
        var k: usize = 1;
        for (k < w.ok.len) {
            if (!text.pushed(vector.push[str](?m.tokens, w.ok.data[k]))) { ret err[diag.Refusal].err{text.memory(l)}; }
            k = k + 1;
        }
        val placed: err[diag.Refusal] = put(a, x, l, MACROS, name, x.macros.len);
        if (sel placed.err)                                 { ret placed; }
        if (!text.pushed(vector.push[Macro](?x.macros, m))) { ret err[diag.Refusal].err{text.memory(l)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun read_fields(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val got: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "fields", false);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var i: usize = 0;
    for (i < got.ok.len) {
        val l: *lines.Line                           = ?got.ok.data[i];
        val w: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel w.err)     { ret err[diag.Refusal].err{w.err}; }
        if (w.ok.len != 9) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        val name: str         = w.ok.data[0];
        val seen: opt[*Field] = field(a, x, name);
        if (sel seen.some) { ret err[diag.Refusal].err{lines.refuse(l, FIELD_TWICE, name)}; }
        val bits: res[u32, diag.Refusal] = decimal(l, w.ok.data[3]);
        if (sel bits.err) { ret err[diag.Refusal].err{bits.err}; }
        val skip: str = w.ok.data[7];
        if (!str_equals(skip, "DO") && !str_equals(skip, "DI") && !str_equals(skip, "DS")) { ret err[diag.Refusal].err{lines.refuse(l, BAD_SKIP, skip)}; }
        val placed: err[diag.Refusal] = put(a, x, l, FIELD, name, x.fields.len);
        if (sel placed.err)                                                                                                                             { ret placed; }
        if (!text.pushed(vector.push[Field](?x.fields, Field{name: name, ctype: w.ok.data[2], bits: bits.ok, skip: str_equals(skip, "DS"), line: @l}))) { ret err[diag.Refusal].err{text.memory(l)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the two halves of `s` around its `/`, or `s` twice
fun halves(a: *A.Allocator, l: *lines.Line, s: str, left: *str, right: *str) err[diag.Refusal] {
    val cut: opt[usize] = str_index_char(s, '/');
    if (sel cut.none) {
        @left  = s;
        @right = s;
        ret err[diag.Refusal].ok{};
    }
    val one: res[str, StrError] = str_copy_slice(a, s, 0, cut.some);
    if (sel one.err) { ret err[diag.Refusal].err{text.memory(l)}; }
    @left  = one.ok;
    @right = ?s[cut.some + 1];
    ret err[diag.Refusal].ok{};
}

fun register_width(l: *lines.Line, s: str) res[u32, diag.Refusal] {
    if (str_equals(s, "NA")) { ret res[u32, diag.Refusal].ok{0}; }
    ret decimal(l, s);
}

fun read_registers(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val got: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "registers", false);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var all: vector.Vector[Register] = vector.init[Register](a);
    var i:   usize                   = 0;
    for (i < got.ok.len) {
        val l: *lines.Line                           = ?got.ok.data[i];
        val w: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel w.err)                    { ret err[diag.Refusal].err{w.err}; }
        if (w.ok.len < 3 || w.ok.len > 7) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        var r:      Register          = Register{name: w.ok.data[0], class: w.ok.data[1], width: 0, width64: 0, enclosing: w.ok.data[0], enclosing32: w.ok.data[0], ordinal: 0, high: false, display: w.ok.data[0], line: @l};
        var narrow: str               = nil;
        var wide:   str               = nil;
        val split:  err[diag.Refusal] = halves(a, l, w.ok.data[2], ?narrow, ?wide);
        if (sel split.err) { ret split; }
        val n: res[u32, diag.Refusal] = register_width(l, narrow);
        if (sel n.err) { ret err[diag.Refusal].err{n.err}; }
        val m: res[u32, diag.Refusal] = register_width(l, wide);
        if (sel m.err) { ret err[diag.Refusal].err{m.err}; }
        r.width   = n.ok;
        r.width64 = m.ok;
        if (w.ok.len >= 4) {
            val e: err[diag.Refusal] = halves(a, l, w.ok.data[3], ?r.enclosing, ?r.enclosing32);
            if (sel e.err) { ret e; }
        }
        if (w.ok.len >= 5) {
            val o: res[u32, diag.Refusal] = decimal(l, w.ok.data[4]);
            if (sel o.err) { ret err[diag.Refusal].err{o.err}; }
            r.ordinal = o.ok;
        }
        if (w.ok.len >= 6) {
            val h: str = w.ok.data[5];
            if (!str_equals(h, "h") && !str_equals(h, "-")) { ret err[diag.Refusal].err{lines.refuse(l, BAD_HIGH, h)}; }
            r.high = str_equals(h, "h");
        }
        if (w.ok.len == 7)                                { r.display = w.ok.data[6]; }
        if (!text.pushed(vector.push[Register](?all, r))) { ret err[diag.Refusal].err{text.memory(l)}; }
        i = i + 1;
    }
    # the widest width each name is stated at, which decides between two statements of one register
    var widest: map.Map[str, u32] = map.init[str, u32](a);
    i = 0;
    for (i < all.len) {
        val r:    *Register = ?all.data[i];
        val seen: opt[*u32] = map.get[str, u32](?widest, ?r.name);
        if (sel seen.some) {
            if (@seen.some < r.width) { @seen.some = r.width; }
        }
        or {
            val put: res[bool, A.Error] = map.insert[str, u32](?widest, r.name, r.width);
            if (sel put.err) { ret err[diag.Refusal].err{text.memory(?r.line)}; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < all.len) {
        val r:   *Register = ?all.data[i];
        val was: opt[u32]  = at(a, x, REGISTERS, r.name);
        if (sel was.some) {
            val old: *Register = ?x.registers.data[was.some];
            if (old.width < r.width) { @old = @r; }
            or {
                val before: opt[*u32] = map.get[str, u32](?widest, ?old.enclosing);
                val after:  opt[*u32] = map.get[str, u32](?widest, ?r.enclosing);
                if (sel before.none)            { ret err[diag.Refusal].err{lines.refuse(?old.line, BAD_ENCLOSER, old.enclosing)}; }
                if (sel after.none)             { ret err[diag.Refusal].err{lines.refuse(?r.line, BAD_ENCLOSER, r.enclosing)}; }
                if (@before.some < @after.some) { @old = @r; }
            }
        }
        or {
            val placed: err[diag.Refusal] = put(a, x, ?r.line, REGISTERS, r.name, x.registers.len);
            if (sel placed.err)                                        { ret placed; }
            if (!text.pushed(vector.push[Register](?x.registers, @r))) { ret err[diag.Refusal].err{text.memory(?r.line)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# a width given in bytes, or in bits as `Nbits`
fun size(a: *A.Allocator, l: *lines.Line, s: str) res[u32, diag.Refusal] {
    val n: usize = str_len(s);
    if (n > 4 && str_equals(?s[n - 4], "bits")) {
        val digits: res[str, StrError] = str_copy_slice(a, s, 0, n - 4);
        if (sel digits.err) { ret res[u32, diag.Refusal].err{text.memory(l)}; }
        ret decimal(l, digits.ok);
    }
    val bytes: res[u32, diag.Refusal] = decimal(l, s);
    if (sel bytes.err) { ret bytes; }
    ret res[u32, diag.Refusal].ok{bytes.ok * 8};
}

fun read_widths(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val got: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "widths", false);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var i: usize = 0;
    for (i < got.ok.len) {
        val l: *lines.Line                           = ?got.ok.data[i];
        val w: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel w.err)                      { ret err[diag.Refusal].err{w.err}; }
        if (w.ok.len != 3 && w.ok.len != 5) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        var d: Width = Width{name: w.ok.data[0], element: w.ok.data[1], bits: [4]u32{0, 0, 0, 0}, line: @l};
        if (w.ok.len == 3) {
            val all: res[u32, diag.Refusal] = size(a, l, w.ok.data[2]);
            if (sel all.err) { ret err[diag.Refusal].err{all.err}; }
            d.bits = [4]u32{all.ok, all.ok, all.ok, all.ok};
        }
        or {
            var k: u32 = 0;
            for (k < 3) {
                val each: res[u32, diag.Refusal] = size(a, l, w.ok.data[2 + k]);
                if (sel each.err) { ret err[diag.Refusal].err{each.err}; }
                d.bits[k + 1] = each.ok;
                k             = k + 1;
            }
        }
        val was: opt[u32] = at(a, x, WIDTHS, d.name);
        if (sel was.some) { x.widths.data[was.some] = d; }
        or {
            val placed: err[diag.Refusal] = put(a, x, l, WIDTHS, d.name, x.widths.len);
            if (sel placed.err)                                 { ret placed; }
            if (!text.pushed(vector.push[Width](?x.widths, d))) { ret err[diag.Refusal].err{text.memory(l)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun read_types(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val got: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "element-types", false);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var i: usize = 0;
    for (i < got.ok.len) {
        val l: *lines.Line                           = ?got.ok.data[i];
        val w: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel w.err)     { ret err[diag.Refusal].err{w.err}; }
        if (w.ok.len != 3) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        val bits: res[u32, diag.Refusal] = decimal(l, w.ok.data[2]);
        if (sel bits.err) { ret err[diag.Refusal].err{bits.err}; }
        val t:   Type     = Type{name: w.ok.data[0], base: w.ok.data[1], bits: bits.ok, line: @l};
        val was: opt[u32] = at(a, x, TYPES, t.name);
        if (sel was.some) { x.types.data[was.some] = t; }
        or {
            val placed: err[diag.Refusal] = put(a, x, l, TYPES, t.name, x.types.len);
            if (sel placed.err)                               { ret placed; }
            if (!text.pushed(vector.push[Type](?x.types, t))) { ret err[diag.Refusal].err{text.memory(l)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun read_extras(a: *A.Allocator, x: *Tables, files: *vector.Vector[layer.Listed]) err[diag.Refusal] {
    val got: res[vector.Vector[lines.Line], diag.Refusal] = records(a, files, "extra-widths", false);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var i: usize = 0;
    for (i < got.ok.len) {
        val l: *lines.Line                           = ?got.ok.data[i];
        val w: res[vector.Vector[str], diag.Refusal] = words(a, l);
        if (sel w.err)     { ret err[diag.Refusal].err{w.err}; }
        if (w.ok.len != 3) { ret err[diag.Refusal].err{lines.refuse(l, FIELDS, nil)}; }
        var t:  u8                    = 0;
        var to: *vector.Vector[Extra] = nil;
        if (str_equals(w.ok.data[0], "nt")) {
            t  = NTS;
            to = ?x.nts;
        }
        or (str_equals(w.ok.data[0], "reg")) {
            t  = REGS;
            to = ?x.regs;
        }
        or (str_equals(w.ok.data[0], "imm_const")) {
            t  = CONSTS;
            to = ?x.consts;
        }
        or { ret err[diag.Refusal].err{lines.refuse(l, BAD_EXTRA, w.ok.data[0])}; }
        val e:   Extra    = Extra{name: w.ok.data[1], code: w.ok.data[2]};
        val was: opt[u32] = at(a, x, t, e.name);
        if (sel was.some) { to.data[was.some] = e; }
        or {
            val placed: err[diag.Refusal] = put(a, x, l, t, e.name, to.len);
            if (sel placed.err)                          { ret placed; }
            if (!text.pushed(vector.push[Extra](to, e))) { ret err[diag.Refusal].err{text.memory(l)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# every flat table the layers list
pub fun read(a: *A.Allocator, files: *vector.Vector[layer.Listed]) res[Tables, diag.Refusal] {
    var x: Tables = Tables{
        macros:    vector.init[Macro](a),
        fields:    vector.init[Field](a),
        registers: vector.init[Register](a),
        widths:    vector.init[Width](a),
        types:     vector.init[Type](a),
        nts:       vector.init[Extra](a),
        regs:      vector.init[Extra](a),
        consts:    vector.init[Extra](a),
        index:     map.init[str, u32](a),
    };
    val m: err[diag.Refusal] = read_macros(a, ?x, files);
    if (sel m.err) { ret res[Tables, diag.Refusal].err{m.err}; }
    val f: err[diag.Refusal] = read_fields(a, ?x, files);
    if (sel f.err) { ret res[Tables, diag.Refusal].err{f.err}; }
    val r: err[diag.Refusal] = read_registers(a, ?x, files);
    if (sel r.err) { ret res[Tables, diag.Refusal].err{r.err}; }
    val w: err[diag.Refusal] = read_widths(a, ?x, files);
    if (sel w.err) { ret res[Tables, diag.Refusal].err{w.err}; }
    val t: err[diag.Refusal] = read_types(a, ?x, files);
    if (sel t.err) { ret res[Tables, diag.Refusal].err{t.err}; }
    val e: err[diag.Refusal] = read_extras(a, ?x, files);
    if (sel e.err) { ret res[Tables, diag.Refusal].err{e.err}; }
    ret res[Tables, diag.Refusal].ok{x};
}

# a datafile of a fixture copy
#[testing]
pub fun t_file(path: str, data: str) source.File {
    ret source.File{path: path, data: data, len: str_len(data)};
}

#[testing]
val T_FIELDS: str = "MODE SCALAR xed_bits_t 2 SUPPRESSED NOPRINT PUBLIC DI EI\nREXR SCALAR xed_bits_t 1 SUPPRESSED NOPRINT INTERNAL DO EO\nMOD SCALAR xed_bits_t 2 SUPPRESSED NOPRINT INTERNAL DO EO\nREG SCALAR xed_bits_t 3 SUPPRESSED NOPRINT INTERNAL DO EO\nRM SCALAR xed_bits_t 3 SUPPRESSED NOPRINT INTERNAL DO EO\nOUTREG SCALAR xed_reg_enum_t 16 SUPPRESSED NOPRINT INTERNAL DO EO\nREG0 SCALAR xed_reg_enum_t 16 EXPLICIT PRINT PUBLIC DO EI\n";

#[testing]
val T_REGISTERS: str = "XMM0 xmm 128 XMM0 0\nXMM1 xmm 128 XMM1 1\nXMM8 xmm 128 XMM8 8\nXMM9 xmm 128 XMM9 9\n";

#[testing]
val T_WIDTHS: str = "ps f32 16\ndq i32 16\n";

# the flat tables of a fixture copy: a few fields, the registers xmm0, xmm1, xmm8 and xmm9, and the widths ps and dq
#[testing]
pub fun t_tables(a: *A.Allocator) Tables {
    var files: vector.Vector[layer.Listed] = vector.init[layer.Listed](a);
    val kinds: [3]str                      = [3]str{"fields", "registers", "widths"};
    val paths: [3]str                      = [3]str{"datafiles/fields.txt", "datafiles/regs.txt", "datafiles/widths.txt"};
    val data:  [3]str                      = [3]str{T_FIELDS, T_REGISTERS, T_WIDTHS};
    val got:   res[*source.File, A.Error]  = A.allocate[source.File](a, 3);
    if (sel got.err) { ret Tables{}; }
    var i: u32 = 0;
    for (i < 3) {
        got.ok[i] = t_file(paths[i], data[i]);
        vector.push[layer.Listed](?files, layer.Listed{kind: kinds[i], file: ?got.ok[i], priority: 1});
        i = i + 1;
    }
    val read: res[Tables, diag.Refusal] = read(a, ?files);
    if (sel read.err) { ret Tables{}; }
    ret read.ok;
}
