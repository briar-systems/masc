# the text of XED's datafiles: logical lines, tokens and numbers
#
# XED reads a datafile as its lines with a `#` comment stripped and the ends trimmed, blank lines
# dropped, a line ending in `\` joined to the next, and in its pattern files every `x/N` written
# as the letter x N times (pysrc/genutil.py process_continuations, pysrc/slash_expand.py). a
# logical line keeps the file and number of its first line, so a malformed record is refused
# where it starts

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;
use std.types.view.view_eq_str;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use gen.lines;
use gen.source;

pub val SLASH: str = "slash repeat count above 99";

fun space(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\r';
}

fun lower(c: u8) bool {
    ret c >= 'a' && c <= 'z';
}

fun digit(c: u8) bool {
    ret c >= '0' && c <= '9';
}

# whether a push was given its storage
pub fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# the refusal of `l` for want of memory
pub fun memory(l: *lines.Line) diag.Refusal {
    ret lines.refuse(l, diag.MEMORY, nil);
}

# `v` as an owned string. a view is not terminated, so its bytes are copied by its length alone
pub fun owned(a: *A.Allocator, l: *lines.Line, v: View) res[str, diag.Refusal] {
    val got: res[*u8, A.Error] = A.allocate[u8](a, v.len + 1);
    if (sel got.err) { ret res[str, diag.Refusal].err{memory(l)}; }
    var i: usize = 0;
    for (i < v.len) {
        got.ok[i] = v.data[i];
        i         = i + 1;
    }
    got.ok[v.len] = 0;
    ret res[str, diag.Refusal].ok{got.ok};
}

# `v` with its ends trimmed
pub fun trim(v: View) View {
    var start: usize = 0;
    var stop:  usize = v.len;
    for (start < stop && space(v.data[start])) {
        start = start + 1;
    }
    for (stop > start && space(v.data[stop - 1])) {
        stop = stop - 1;
    }
    ret view(?v.data[start], stop - start);
}

# the part of `v` from `at` for `len` bytes
pub fun part(v: View, at: usize, len: usize) View {
    ret view(?v.data[at], len);
}

# whether `v` starts with `prefix`
pub fun starts(v: View, prefix: str) bool {
    val n: usize = str_len(prefix);
    if (v.len < n) { ret false; }
    ret view_eq_str(part(v, 0, n), prefix);
}

# whether `v` ends with `suffix`
pub fun ends(v: View, suffix: str) bool {
    val n: usize = str_len(suffix);
    if (v.len < n) { ret false; }
    ret view_eq_str(part(v, v.len - n, n), suffix);
}

# where `c` first is in `v`
pub fun find(v: View, c: u8) opt[usize] {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == c) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# the value of `v` written as XED writes a number: decimal, `0x` hex, or `0b` binary with underscores
pub fun number(v: View) opt[u64] {
    if (v.len == 0) { ret opt[u64].none{}; }
    var n:    u64   = 0;
    var i:    usize = 0;
    var base: u64   = 10;
    if (v.len > 2 && v.data[0] == '0' && (v.data[1] == 'x' || v.data[1] == 'X')) {
        base = 16;
        i    = 2;
    }
    or (v.len > 2 && v.data[0] == '0' && v.data[1] == 'b') {
        base = 2;
        i    = 2;
    }
    var any: bool = false;
    for (i < v.len) {
        val c: u8  = v.data[i];
        var d: u64 = 99;
        if (digit(c))                         { d = (c - '0')::u64; }
        or (c >= 'a' && c <= 'f')             { d = (c - 'a')::u64 + 10; }
        or (c >= 'A' && c <= 'F')             { d = (c - 'A')::u64 + 10; }
        or (c == '_' && base == 2)            { d = 98; }
        if (d == 99 || (d < 98 && d >= base)) { ret opt[u64].none{}; }
        if (d < 98) {
            if (n > (~0::u64 - d) / base) { ret opt[u64].none{}; }
            n   = n * base + d;
            any = true;
        }
        i = i + 1;
    }
    if (!any) { ret opt[u64].none{}; }
    ret opt[u64].some{n};
}

# the logical lines of `f`
# ---
# a:       allocator for the lines and any text joined or expanded
# f:       a datafile of the copy
# slashes: whether `x/N` is expanded, as XED does in its pattern and state files
# ret:     the lines in file order, or the refusal of one
pub fun read(a: *A.Allocator, f: *source.File, slashes: bool) res[vector.Vector[lines.Line], diag.Refusal] {
    var out:     vector.Vector[lines.Line] = vector.init[lines.Line](a);
    var joined:  vector.Vector[u8]         = vector.init[u8](a);
    var pending: bool                      = false;
    var first:   u32                       = 0;
    var at:      usize                     = 0;
    var number:  u32                       = 0;
    for (at < f.len) {
        number = number + 1;
        var end: usize = at;
        for (end < f.len && f.data[end] != '\n') {
            end = end + 1;
        }
        var stop: usize = at;
        for (stop < end && f.data[stop] != '#') {
            stop = stop + 1;
        }
        var start: usize = at;
        # a joined line keeps the leading space of the line it continues into
        if (!pending) {
            for (start < stop && space(f.data[start])) {
                start = start + 1;
            }
        }
        for (stop > start && space(f.data[stop - 1])) {
            stop = stop - 1;
        }
        at = end + 1;
        if (!pending && stop == start) { cnt; }
        if (!pending) {
            first = number;
            vector.clear[u8](?joined);
        }
        var cont: bool = stop > start && f.data[stop - 1] == '\\';
        if (cont) { stop = stop - 1; }
        var k: usize = start;
        for (k < stop) {
            if (!pushed(vector.push[u8](?joined, f.data[k]))) { ret res[vector.Vector[lines.Line], diag.Refusal].err{diag.refusal(f.path, number, diag.MEMORY, nil)}; }
            k = k + 1;
        }
        pending = cont && at < f.len;
        if (pending) { cnt; }
        var l:    lines.Line              = lines.Line{file: f.path, number: first, text: view(joined.data, joined.len)};
        val made: res[View, diag.Refusal] = finish(a, ?l, slashes);
        if (sel made.err) { ret res[vector.Vector[lines.Line], diag.Refusal].err{made.err}; }
        l.text = made.ok;
        if (l.text.len == 0)                           { cnt; }
        if (!pushed(vector.push[lines.Line](?out, l))) { ret res[vector.Vector[lines.Line], diag.Refusal].err{memory(?l)}; }
    }
    ret res[vector.Vector[lines.Line], diag.Refusal].ok{out};
}

# the text of `l` trimmed, owned, and its slash repeats expanded when `slashes`
fun finish(a: *A.Allocator, l: *lines.Line, slashes: bool) res[View, diag.Refusal] {
    val text: View              = trim(l.text);
    var out:  vector.Vector[u8] = vector.init[u8](a);
    var i:    usize             = 0;
    for (i < text.len) {
        val c: u8 = text.data[i];
        if (slashes && lower(c) && i + 2 < text.len && text.data[i + 1] == '/' && digit(text.data[i + 2])) {
            var j: usize = i + 2;
            var n: u32   = 0;
            for (j < text.len && digit(text.data[j])) {
                if (n <= 99) { n = n * 10 + (text.data[j] - '0')::u32; }
                j = j + 1;
            }
            if (n > 99) { ret res[View, diag.Refusal].err{lines.refuse(l, SLASH, nil)}; }
            var r: u32 = 0;
            for (r < n) {
                if (!pushed(vector.push[u8](?out, c))) { ret res[View, diag.Refusal].err{memory(l)}; }
                r = r + 1;
            }
            i = j;
            cnt;
        }
        if (!pushed(vector.push[u8](?out, c))) { ret res[View, diag.Refusal].err{memory(l)}; }
        i = i + 1;
    }
    ret res[View, diag.Refusal].ok{view(out.data, out.len)};
}
