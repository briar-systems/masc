# the nonterminals of XED: the `NAME()::` decode trees
#
# a nonterminal is a list of rules, each `conditions | bindings`: a pattern, and the fields its
# match binds, each binding an operand in XED's syntax with a state macro standing for its
# bindings. a lookup nonterminal binds OUTREG, to a register or to another nonterminal whose
# rules yield it, so XMM_R() binds OUTREG=XMM_R_64() in 64-bit mode and XMM_R_64() binds the
# register by REXR and REG. a nonterminal opened again in a later file gains the later rules
# (pysrc/generator.py read_input). resolving a nonterminal follows those chains to the rules that
# end them, each with the conditions met on its way

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.testing;
use std.collections.map;
use std.collections.vector;

use gen.diag;
use gen.isa.x86.xed.operand;
use gen.isa.x86.xed.pattern;
use gen.isa.x86.xed.section;
use gen.isa.x86.xed.table;
use gen.isa.x86.xed.text;
use gen.lines;
use gen.source;

# one rule
# ---
# pattern:  the conditions it matches
# bindings: what its match binds
pub rec Rule {
    pattern:  pattern.Pattern;
    bindings: vector.Vector[operand.Operand];
    line:     lines.Line;
}

# one nonterminal
# ---
# type:         the type it returns as a lookup nonterminal, nil for any other
# instructions: whether its rules are instruction records, which the model holds apart
# rules:        its rules in the order read
pub rec Nonterminal {
    name:         str;
    type:         str;
    instructions: bool;
    rules:        vector.Vector[Rule];
    line:         lines.Line;
}

pub rec Nonterminals {
    all:   vector.Vector[Nonterminal];
    index: map.Map[str, u32];
}

# one end of a resolved nonterminal
# ---
# conditions: every piece of every rule on the way, in order
# register:   the register it yields, without `XED_REG_`, nil when its rule binds none
# rule:       the rule it ends at
pub rec Outcome {
    conditions: vector.Vector[pattern.Piece];
    register:   str;
    rule:       *Rule;
}

pub val NO_BAR:  str = "nonterminal rule is not conditions, a bar and bindings";
pub val UNKNOWN: str = "names no nonterminal";
pub val CYCLE:   str = "nonterminal chain returns to a nonterminal on it";

pub fun init(a: *A.Allocator) Nonterminals {
    ret Nonterminals{all: vector.init[Nonterminal](a), index: map.init[str, u32](a)};
}

# the nonterminal `name`
pub fun find(n: *Nonterminals, name: str) opt[*Nonterminal] {
    val got: opt[*u32] = map.get[str, u32](?n.index, ?name);
    if (sel got.none) { ret opt[*Nonterminal].none{}; }
    ret opt[*Nonterminal].some{?n.all.data[@got.some]};
}

# the bindings of the words `w`, each state macro standing for its bindings
pub fun bindings(a: *A.Allocator, x: *table.Tables, l: *lines.Line, w: *vector.Vector[str]) res[vector.Vector[operand.Operand], diag.Refusal] {
    var out: vector.Vector[operand.Operand] = vector.init[operand.Operand](a);
    var i:   usize                          = 0;
    for (i < w.len) {
        var each:  vector.Vector[str] = vector.init[str](a);
        val macro: opt[*table.Macro]  = table.macro(a, x, w.data[i]);
        if (sel macro.some)                                   { each = macro.some.tokens; }
        or (!text.pushed(vector.push[str](?each, w.data[i]))) { ret res[vector.Vector[operand.Operand], diag.Refusal].err{text.memory(l)}; }
        var k: usize = 0;
        for (k < each.len) {
            val op: res[operand.Operand, diag.Refusal] = operand.parse(a, x, l, each.data[k]);
            if (sel op.err)                                              { ret res[vector.Vector[operand.Operand], diag.Refusal].err{op.err}; }
            if (!text.pushed(vector.push[operand.Operand](?out, op.ok))) { ret res[vector.Vector[operand.Operand], diag.Refusal].err{text.memory(l)}; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret res[vector.Vector[operand.Operand], diag.Refusal].ok{out};
}

# the rule on `l`
pub fun rule(a: *A.Allocator, x: *table.Tables, l: *lines.Line) res[Rule, diag.Refusal] {
    val bar: opt[usize] = text.find(l.text, '|');
    if (sel bar.none) { ret res[Rule, diag.Refusal].err{lines.refuse(l, NO_BAR, nil)}; }
    var left:  lines.Line = lines.Line{file: l.file, number: l.number, text: text.part(l.text, 0, bar.some)};
    var right: lines.Line = lines.Line{file: l.file, number: l.number, text: text.part(l.text, bar.some + 1, l.text.len - bar.some - 1)};
    val again: opt[usize] = text.find(right.text, '|');
    if (sel again.some) { ret res[Rule, diag.Refusal].err{lines.refuse(l, NO_BAR, nil)}; }
    val cw: res[vector.Vector[str], diag.Refusal] = table.words(a, ?left);
    if (sel cw.err) { ret res[Rule, diag.Refusal].err{cw.err}; }
    val bw: res[vector.Vector[str], diag.Refusal] = table.words(a, ?right);
    if (sel bw.err) { ret res[Rule, diag.Refusal].err{bw.err}; }
    val p: res[pattern.Pattern, diag.Refusal] = pattern.parse(a, x, l, ?cw.ok);
    if (sel p.err) { ret res[Rule, diag.Refusal].err{p.err}; }
    val b: res[vector.Vector[operand.Operand], diag.Refusal] = bindings(a, x, l, ?bw.ok);
    if (sel b.err) { ret res[Rule, diag.Refusal].err{b.err}; }
    ret res[Rule, diag.Refusal].ok{Rule{pattern: p.ok, bindings: b.ok, line: @l}};
}

# the nonterminal the section `s` opens, made when it is the first to
pub fun open(a: *A.Allocator, n: *Nonterminals, s: *section.Section) res[*Nonterminal, diag.Refusal] {
    val was: opt[*Nonterminal] = find(n, s.name);
    if (sel was.some)                                                                                                                                                       { ret res[*Nonterminal, diag.Refusal].ok{was.some}; }
    if (!text.pushed(vector.push[Nonterminal](?n.all, Nonterminal{name: s.name, type: s.type, instructions: s.instructions, rules: vector.init[Rule](a), line: s.header}))) { ret res[*Nonterminal, diag.Refusal].err{text.memory(?s.header)}; }
    val put: res[bool, A.Error] = map.insert[str, u32](?n.index, s.name, (n.all.len - 1)::u32);
    if (sel put.err) { ret res[*Nonterminal, diag.Refusal].err{text.memory(?s.header)}; }
    ret res[*Nonterminal, diag.Refusal].ok{?n.all.data[n.all.len - 1]};
}

# the rules of the section `s` added to its nonterminal
pub fun read(a: *A.Allocator, x: *table.Tables, n: *Nonterminals, s: *section.Section) err[diag.Refusal] {
    val opened: res[*Nonterminal, diag.Refusal] = open(a, n, s);
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val nt: *Nonterminal = opened.ok;
    var i:  usize        = 0;
    for (i < s.lines.len) {
        val r: res[Rule, diag.Refusal] = rule(a, x, ?s.lines.data[i]);
        if (sel r.err)                                        { ret err[diag.Refusal].err{r.err}; }
        if (!text.pushed(vector.push[Rule](?nt.rules, r.ok))) { ret err[diag.Refusal].err{text.memory(?s.lines.data[i])}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the binding of OUTREG in `r`
fun outreg(r: *Rule) opt[*operand.Operand] {
    var i: usize = 0;
    for (i < r.bindings.len) {
        if (str_equals(r.bindings.data[i].name, "OUTREG")) { ret opt[*operand.Operand].some{?r.bindings.data[i]}; }
        i = i + 1;
    }
    ret opt[*operand.Operand].none{};
}

rec Walk {
    alloc: *A.Allocator;
    all:   *Nonterminals;
    stack: vector.Vector[*Nonterminal];
    out:   *vector.Vector[Outcome];
}

fun walk(w: *Walk, nt: *Nonterminal, before: *vector.Vector[pattern.Piece]) err[diag.Refusal] {
    if (!text.pushed(vector.push[*Nonterminal](?w.stack, nt))) { ret err[diag.Refusal].err{text.memory(?nt.line)}; }
    var i: usize = 0;
    for (i < nt.rules.len) {
        val r:    *Rule                        = ?nt.rules.data[i];
        var here: vector.Vector[pattern.Piece] = vector.init[pattern.Piece](w.alloc);
        var k:    usize                        = 0;
        for (k < before.len + r.pattern.pieces.len) {
            var p: pattern.Piece;
            if (k < before.len)                                     { p = before.data[k]; }
            or                                                      { p = r.pattern.pieces.data[k - before.len]; }
            if (!text.pushed(vector.push[pattern.Piece](?here, p))) { ret err[diag.Refusal].err{text.memory(?r.line)}; }
            k = k + 1;
        }
        val out: opt[*operand.Operand] = outreg(r);
        var to:  *operand.Operand      = nil;
        if (sel out.some) { to = out.some; }
        if (to != nil && to.form == operand.NONTERMINAL) {
            val next: opt[*Nonterminal] = find(w.all, to.value);
            if (sel next.none) { ret err[diag.Refusal].err{lines.refuse(?r.line, UNKNOWN, to.value)}; }
            var s: usize = 0;
            for (s < w.stack.len) {
                if (w.stack.data[s] == next.some) { ret err[diag.Refusal].err{lines.refuse(?r.line, CYCLE, next.some.name)}; }
                s = s + 1;
            }
            val inner: err[diag.Refusal] = walk(w, next.some, ?here);
            if (sel inner.err) { ret inner; }
        }
        or {
            var reg: str = nil;
            if (to != nil && to.form == operand.REGISTER)                                                     { reg = to.value; }
            if (!text.pushed(vector.push[Outcome](w.out, Outcome{conditions: here, register: reg, rule: r}))) { ret err[diag.Refusal].err{text.memory(?r.line)}; }
        }
        i = i + 1;
    }
    w.stack.len = w.stack.len - 1;
    ret err[diag.Refusal].ok{};
}

# the ends of the nonterminal `name`, its OUTREG chains followed through
# ---
# a:    allocator for the outcomes
# n:    every nonterminal
# name: the nonterminal resolved
# ret:  every rule a chain from it ends at, in rule order, or the refusal of a chain naming no
#       nonterminal or returning to one on it
pub fun resolve(a: *A.Allocator, n: *Nonterminals, name: str) res[vector.Vector[Outcome], diag.Refusal] {
    var out: vector.Vector[Outcome] = vector.init[Outcome](a);
    val nt:  opt[*Nonterminal]      = find(n, name);
    if (sel nt.none) { ret res[vector.Vector[Outcome], diag.Refusal].err{diag.refusal(nil, 0, UNKNOWN, name)}; }
    var w:    Walk                         = Walk{alloc: a, all: n, stack: vector.init[*Nonterminal](a), out: ?out};
    var none: vector.Vector[pattern.Piece] = vector.init[pattern.Piece](a);
    val done: err[diag.Refusal]            = walk(?w, nt.some, ?none);
    if (sel done.err) { ret res[vector.Vector[Outcome], diag.Refusal].err{done.err}; }
    ret res[vector.Vector[Outcome], diag.Refusal].ok{out};
}

#[testing]
val T_CHAIN: str = "xed_reg_enum_t XMM_R()::\nMODE=2 | OUTREG=XMM_R_64()\nMODE!=2 | OUTREG=XMM_R_32()\n\nxed_reg_enum_t XMM_R_32()::\nREG=0x0 | OUTREG=XED_REG_XMM0\nREG=0x1 | OUTREG=XED_REG_XMM1\n\nxed_reg_enum_t XMM_R_64()::\nREXR=0 REG=0x0 | OUTREG=XED_REG_XMM0\nREXR=1 REG=0x0 | OUTREG=XED_REG_XMM8\nREXR=1 REG=0x1 | OUTREG=XED_REG_XMM9\n\nxed_reg_enum_t LOOP()::\notherwise | OUTREG=LOOP()\n";

test resolve__a_nonterminal_resolves_through_its_chain {
    var t: testing.Testing;
    testing.make(?t);
    val a:   *A.Allocator                                      = testing.allocator_of(?t);
    var x:   table.Tables                                      = table.t_tables(a);
    var f:   source.File                                       = table.t_file("datafiles/xmm.txt", T_CHAIN);
    val got: res[vector.Vector[section.Section], diag.Refusal] = section.read(a, ?f, nil);
    if (sel got.err) { ret 1; }
    var n: Nonterminals = init(a);
    var i: usize        = 0;
    for (i < got.ok.len) {
        val done: err[diag.Refusal] = read(a, ?x, ?n, ?got.ok.data[i]);
        if (sel done.err) { ret 2; }
        i = i + 1;
    }
    val ends: res[vector.Vector[Outcome], diag.Refusal] = resolve(a, ?n, "XMM_R");
    if (sel ends.err)     { ret 3; }
    if (ends.ok.len != 5) { ret 4; }
    val want: [5]str = [5]str{"XMM0", "XMM8", "XMM9", "XMM0", "XMM1"};
    val held: [5]u32 = [5]u32{3, 3, 3, 2, 2};
    i = 0;
    for (i < 5) {
        val o: *Outcome = ?ends.ok.data[i];
        if (!str_equals(o.register, want[i]) || o.conditions.len != held[i]::usize)            { ret 5; }
        if (!str_equals(o.conditions.data[0].name, "MODE") || o.conditions.data[0].value != 2) { ret 6; }
        i = i + 1;
    }
    # the rules of XMM_R_64 follow MODE=2 of XMM_R, those of XMM_R_32 its negation
    if (!ends.ok.data[0].conditions.data[0].equal || ends.ok.data[3].conditions.data[0].equal)                         { ret 7; }
    if (!str_equals(ends.ok.data[1].conditions.data[1].name, "REXR") || ends.ok.data[1].conditions.data[1].value != 1) { ret 8; }
    val loop: res[vector.Vector[Outcome], diag.Refusal] = resolve(a, ?n, "LOOP");
    if (!(sel loop.err && loop.err.message == CYCLE)) { ret 9; }
    ret 0;
}
