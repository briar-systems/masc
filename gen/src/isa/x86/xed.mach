# the XED reader: the generator-side model of Intel's XED datafiles
#
# XED (github.com/intelxed/xed) states the x86 instruction set as datafiles: instruction records
# with their decode patterns and operands, the nonterminals those patterns match, and the
# registers, operand widths and cpuid bits they name. the reader reads every datafile the
# layers of the copy under vendor/xed list into one model and refuses a malformed record with
# its file and line. it emits nothing: the x86 generators build their tables from the model,
# and the model holds what every mode needs, so a 64-bit table and a 32-bit one come from it
# alike
#
# the model holds, each read where its module says:
#   files         the datafiles the layers list, by kind (gen.isa.x86.xed.layer)
#   tables        the state macros, operand fields, registers, widths and element types
#                 (gen.isa.x86.xed.table)
#   cpuid         each ISA set's cpuid bits (gen.isa.x86.xed.cpuid)
#   nonterminals  the decode nonterminals, from the dec-spine and dec-patterns files and the
#                 plain sections of the instruction files (gen.isa.x86.xed.nonterminal)
#   instructions  the decode instruction records, one a pattern (gen.isa.x86.xed.instruction)
# every nonterminal a pattern, an operand or a binding names is one the model holds. the encode
# patterns, the encoder's own nonterminals, are not read: an encoding is the inverse of the
# decode patterns, which state every bit

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use gen.diag;
use gen.lines;
use gen.source;

fwd gen.isa.x86.xed.cpuid;
fwd gen.isa.x86.xed.instruction;
fwd gen.isa.x86.xed.layer;
fwd gen.isa.x86.xed.nonterminal;
fwd gen.isa.x86.xed.operand;
fwd gen.isa.x86.xed.pattern;
fwd gen.isa.x86.xed.section;
fwd gen.isa.x86.xed.table;
fwd gen.isa.x86.xed.text;

# the model of a copy of XED's datafiles
pub rec Xed {
    files:        vector.Vector[layer.Listed];
    tables:       table.Tables;
    cpuid:        cpuid.Cpuid;
    nonterminals: nonterminal.Nonterminals;
    instructions: vector.Vector[instruction.Instruction];
}

pub val NO_NONTERMINAL: str = "names no nonterminal the decode patterns state";

fun named(x: *Xed, l: *lines.Line, name: str) err[diag.Refusal] {
    val nt: opt[*nonterminal.Nonterminal] = nonterminal.find(?x.nonterminals, name);
    if (sel nt.none) { ret err[diag.Refusal].err{lines.refuse(l, NO_NONTERMINAL, name)}; }
    ret err[diag.Refusal].ok{};
}

fun calls(x: *Xed, l: *lines.Line, p: *pattern.Pattern) err[diag.Refusal] {
    var i: usize = 0;
    for (i < p.pieces.len) {
        if (p.pieces.data[i].kind == pattern.CALL) {
            val got: err[diag.Refusal] = named(x, l, p.pieces.data[i].name);
            if (sel got.err) { ret got; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun operands(x: *Xed, l: *lines.Line, ops: *vector.Vector[operand.Operand]) err[diag.Refusal] {
    var i: usize = 0;
    for (i < ops.len) {
        if (ops.data[i].form == operand.NONTERMINAL) {
            val got: err[diag.Refusal] = named(x, l, ops.data[i].value);
            if (sel got.err) { ret got; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# every nonterminal the model names is one it holds
fun closed(x: *Xed) err[diag.Refusal] {
    var i: usize = 0;
    for (i < x.nonterminals.all.len) {
        val nt: *nonterminal.Nonterminal = ?x.nonterminals.all.data[i];
        var k:  usize                    = 0;
        for (k < nt.rules.len) {
            val r: *nonterminal.Rule = ?nt.rules.data[k];
            val c: err[diag.Refusal] = calls(x, ?r.line, ?r.pattern);
            if (sel c.err) { ret c; }
            val b: err[diag.Refusal] = operands(x, ?r.line, ?r.bindings);
            if (sel b.err) { ret b; }
            k = k + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < x.instructions.len) {
        val n: *instruction.Instruction = ?x.instructions.data[i];
        val c: err[diag.Refusal]        = calls(x, ?n.line, ?n.pattern);
        if (sel c.err) { ret c; }
        val o: err[diag.Refusal] = operands(x, ?n.line, ?n.operands);
        if (sel o.err) { ret o; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the sections of every file of `kind` read into the model
fun sections(a: *A.Allocator, x: *Xed, kind: str, d: *instruction.Drops) err[diag.Refusal] {
    val listed: res[vector.Vector[*layer.Listed], diag.Refusal] = layer.of(a, ?x.files, kind);
    if (sel listed.err) { ret err[diag.Refusal].err{listed.err}; }
    var last: section.Section;
    var any:  bool  = false;
    var i:    usize = 0;
    for (i < listed.ok.len) {
        var before: *section.Section = nil;
        if (any) { before = ?last; }
        val got: res[vector.Vector[section.Section], diag.Refusal] = section.read(a, listed.ok.data[i].file, before);
        if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
        if (got.ok.len > 0) {
            last = got.ok.data[got.ok.len - 1];
            any  = true;
        }
        var k: usize = 0;
        for (k < got.ok.len) {
            val s: *section.Section = ?got.ok.data[k];
            if (s.instructions) {
                val opened: res[*nonterminal.Nonterminal, diag.Refusal] = nonterminal.open(a, ?x.nonterminals, s);
                if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
                val read: err[diag.Refusal] = instruction.read(a, ?x.tables, s, d, ?x.instructions);
                if (sel read.err) { ret read; }
            }
            or {
                val read: err[diag.Refusal] = nonterminal.read(a, ?x.tables, ?x.nonterminals, s);
                if (sel read.err) { ret read; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the model of the copy `t`
# ---
# a:   allocator for the model, which outlives every reader of it
# t:   the copy's tree, checked against its record
# ret: the model, or the refusal of a malformed record naming its file and line
pub fun read(a: *A.Allocator, t: *source.Tree) res[Xed, diag.Refusal] {
    val files: res[vector.Vector[layer.Listed], diag.Refusal] = layer.read(a, t);
    if (sel files.err) { ret res[Xed, diag.Refusal].err{files.err}; }
    var x:      Xed                             = Xed{files: files.ok, tables: table.Tables{}, cpuid: cpuid.Cpuid{}, nonterminals: nonterminal.init(a), instructions: vector.init[instruction.Instruction](a)};
    val tables: res[table.Tables, diag.Refusal] = table.read(a, ?x.files);
    if (sel tables.err) { ret res[Xed, diag.Refusal].err{tables.err}; }
    x.tables = tables.ok;
    val bits: res[cpuid.Cpuid, diag.Refusal] = cpuid.read(a, ?x.files);
    if (sel bits.err) { ret res[Xed, diag.Refusal].err{bits.err}; }
    x.cpuid = bits.ok;
    var d:     instruction.Drops = instruction.drops(a);
    val spine: err[diag.Refusal] = sections(a, ?x, "dec-spine", ?d);
    if (sel spine.err) { ret res[Xed, diag.Refusal].err{spine.err}; }
    val patterns: err[diag.Refusal] = sections(a, ?x, "dec-patterns", ?d);
    if (sel patterns.err) { ret res[Xed, diag.Refusal].err{patterns.err}; }
    val records: err[diag.Refusal] = sections(a, ?x, "dec-instructions", ?d);
    if (sel records.err) { ret res[Xed, diag.Refusal].err{records.err}; }
    val settled: err[diag.Refusal] = instruction.settle(a, ?x.instructions, ?d);
    if (sel settled.err) { ret res[Xed, diag.Refusal].err{settled.err}; }
    val whole: err[diag.Refusal] = closed(?x);
    if (sel whole.err) { ret res[Xed, diag.Refusal].err{whole.err}; }
    ret res[Xed, diag.Refusal].ok{x};
}
