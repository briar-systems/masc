# an XED instruction's decode pattern evaluated under each configuration of the prefixes that size an operation
#
# XED states each encoding space as a table of its own: the legacy space (INSTRUCTIONS), vex (AVX_INSTRUCTIONS), evex
# (EVEX_INSTRUCTIONS) and xop (XOP_INSTRUCTIONS), its VEXVALID 0, 1, 2 and 3. a configuration is the code width and the
# prefix bits XED's patterns test to tell operand sizes, address sizes and forms apart: 66, rex.w or vex's and evex's
# w, a rex2 prefix, 67 and evex.b. under each, the pattern is read as XED's decoder reads it (pysrc/generator.py, the
# decode spine): OSZ_NONTERM and ASZ_NONTERM give the effective operand and address sizes, and each piece in turn fixes
# bits of the opcode, captures ModRM's fields, tests a field or calls a nonterminal.
#
# a field is known when the configuration gives it, when a binding sets it, or when a test of the pattern fixes it. a
# test of a known field admits the configuration or not. a test of a field no configuration gives is a fact of the
# form, the map, vex.pp, the vector length, an opcode extension in ModRM.rm, the repeat prefix a row needs or refuses,
# and the facts a row's kinds hold, which the rows read (gen.isa.x86.rows) and refuse when they have no reading of. an
# equal test also makes its field known, so the nonterminals the pattern calls after it read it. a nonterminal is
# evaluated by its rules: the first whose known tests hold, else its `otherwise`, its tests of unknown fields facts as
# the pattern's are, its captures taken and its bindings applied. a rule whose bindings name ERROR admits nothing, and
# a rule chosen on an unknown field while a later one could hold is refused, as the evaluation cannot choose between
# them. a field the decoder skips (DS) is never tested, as XED drops those tests. the result is a `Form`: the opcode,
# ModRM's facts, the operands with their registers, widths and the bits each consumes, and the registers and stack
# accesses no operand names.
#
# a register operand's nonterminal is resolved through its OUTREG chains (gen.isa.x86.xed.nonterminal.resolve), every
# end whose tests on the known fields hold yielding a register, and the fields its tests read place it: ModRM.rm,
# ModRM.reg, the opcode's low bits, vvvv, the opmask, imm8's high nibble, or nowhere, a register the state alone fixes,
# as OrAX's eax. every register is named by the row of masc's x86 register file of its name, or of the name the
# registers topic of the overlay gives an XED register of no row (gen/data/x86/xed-registers.txt).
#
# whatever the evaluation does not know is refused naming it, a field a nonterminal tests that nothing gives, a binding
# it does not read, a piece of a kind it has no reading of, so a new XED revision cannot be read past it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_starts_with;
use std.types.string.str_to_lower;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use masc.core.field;
use masc.core.operand;

use gen.diag;
use gen.isa.x86.xed;
use gen.lines;
use gen.overlay;

pub val UNTRACKED:   str = "nonterminal tests a field nothing gives the x86 row generator";
pub val AMBIGUOUS:   str = "nonterminal rule chosen on a field nothing gives while a later rule could hold";
pub val UNREAD:      str = "nonterminal binds a field the x86 row generator does not read";
pub val UNKNOWN:     str = "pattern piece is of no kind the x86 row generator reads";
pub val NO_NAMED:    str = "XED register names no register of masc's x86 register file";
pub val PLACES:      str = "register nonterminal reads more than one of the fields that place a register";
pub val OPERAND:     str = "XED operand is of no kind the x86 row generator reads";
pub val UNTAKEN:     str = "operand consumes no immediate, displacement or address its pattern takes";
pub val NO_YIELD:    str = "register nonterminal yields no register under the configuration";
pub val TWO_CLASSES: str = "register nonterminal yields registers of classes no x86 operand holds together";
pub val ESCAPE:      str = "opcode bytes are no escape the legacy maps have";
pub val NO_WIDTH:    str = "operand states no width code, or one with no width at the effective operand size";
pub val NO_TABLE:    str = "instruction table is no encoding space the x86 row generator reads";
pub val NO_MAP:      str = "vex, evex or xop pattern states no map";
pub val NOT_XED:     str = "registers line names no register XED states";
pub val OWN_ROW:     str = "registers line names an XED register with a row of its own name";
pub val NO_ROW:      str = "registers line names no row of masc's x86 register file";
pub val BAD_ALIAS:   str = "registers line is not `<XED register> | <row>`";
pub val BAD_KNOB:    str = "knobs line is not `<XED field> | <value>`";
pub val NO_KNOB:     str = "knobs line names no field XED states";

# the overlay topic naming the XED registers of no row of their own name
pub val REGISTERS_TOPIC: str = "xed-registers";

# the overlay topic giving the value masc's decoder reads each of XED's decoder knobs at
pub val KNOBS_TOPIC: str = "knobs";

# the encoding spaces, numbered as XED's VEXVALID numbers them
pub def Space: u8;

pub val LEGACY: Space = 0;
pub val VEX:    Space = 1;
pub val EVEX:   Space = 2;
pub val XOP:    Space = 3;

# the instruction tables of XED, the space each holds in order
pub val TABLE_COUNT: u32 = 4;

pub val TABLES: [TABLE_COUNT]str = [TABLE_COUNT]str{"INSTRUCTIONS", "AVX_INSTRUCTIONS", "EVEX_INSTRUCTIONS", "XOP_INSTRUCTIONS"};

# the space of XED's instruction table `table`, none for a table of no space
pub fun space_of(table: str) opt[Space] {
    var i: u32 = 0;
    for (i < TABLE_COUNT) {
        if (str_equals(TABLES[i], table)) { ret opt[Space].some{i::u8}; }
        i = i + 1;
    }
    ret opt[Space].none{};
}

# the nonterminals whose rules test prefixes that make no row of their own: the branch hints and notrack, which 2e and
# 3e are on a branch, and the segment a memory operand takes, which its segment part states
pub val INERT_COUNT: u32 = 4;

pub val INERT: [INERT_COUNT]str = [INERT_COUNT]str{"BRANCH_HINT", "CET_NO_TRACK", "REMOVE_SEGMENT", "OVERRIDE_SEG0"};

# the addressing nonterminal the ModRM kind encodes, and the vector-indexed ones, each with the class its index is of
pub val MODRM: str = "MODRM";

pub val VSIB_COUNT: u32 = 5;

pub val VSIB: [VSIB_COUNT]str = [VSIB_COUNT]str{"VMODRM_XMM", "VMODRM_YMM", "UISA_VMODRM_XMM", "UISA_VMODRM_YMM", "UISA_VMODRM_ZMM"};

pub val VSIB_CLASS: [VSIB_COUNT]str = [VSIB_COUNT]str{"XMM0", "YMM0", "XMM0", "YMM0", "ZMM0"};

# the spine's nonterminals that set the effective operand and address sizes before an instruction's pattern is read
pub val OSZ: str = "OSZ_NONTERM";
pub val ASZ: str = "ASZ_NONTERM";

# the fields whose value a nonterminal reads as an operand's, not a choice of form: evex's l'l under embedded rounding,
# and vvvv where apx's conditional instructions hold their default flags in it. each is known as 0 to the evaluation,
# its value the operand's
pub val FREE_COUNT: u32 = 4;

pub val FREE: [FREE_COUNT]str = [FREE_COUNT]str{"LLRC", "VEXDEST3", "VEXDEST210", "VEXDEST4"};

# a configuration of the prefixes that size an operation
# ---
# space: the encoding space
# mode:  the code width as XED's MODE holds it: 0 for 16, 1 for 32 and 2 for 64 bits
# osz:   1 when 66 is there, in the legacy space, or evex map 4's pp is 01, which is 66 there (APX_MAP)
# rexw:  rex.w or rex2.w in 64-bit code, or vex's, evex's or xop's w at any width
# rex2:  1 when a rex2 prefix is there, 64-bit code and the legacy space alone
# asz:   1 when 67 is there
# bcrc:  evex.b, the evex space alone
pub rec Config {
    space: Space;
    mode:  u8;
    osz:   u8;
    rexw:  u8;
    rex2:  u8;
    asz:   u8;
    bcrc:  u8;
}

# the code width in bits of XED mode `mode`
pub fun width_of(mode: u8) u8 {
    if (mode == 2) { ret 64; }
    if (mode == 1) { ret 32; }
    ret 16;
}

# every configuration of space `space` at mode `mode`, in a fixed order
pub fun configs(a: *A.Allocator, space: Space, mode: u8) vector.Vector[Config] {
    var out:   vector.Vector[Config] = vector.init[Config](a);
    var oszs:  u8                    = 1;
    var rexws: u8                    = 1;
    var rex2s: u8                    = 1;
    var bcrcs: u8                    = 1;
    if (space == LEGACY || space == EVEX) { oszs = 2; }
    if (space != LEGACY || mode == 2)     { rexws = 2; }
    if (space == LEGACY && mode == 2)     { rex2s = 2; }
    if (space == EVEX)                    { bcrcs = 2; }
    var osz: u8 = 0;
    for (osz < oszs) {
        var w: u8 = 0;
        for (w < rexws) {
            var r: u8 = 0;
            for (r < rex2s) {
                var asz: u8 = 0;
                for (asz < 2) {
                    var b: u8 = 0;
                    for (b < bcrcs) {
                        vector.push[Config](?out, Config{space: space, mode: mode, osz: osz, rexw: w, rex2: r, asz: asz, bcrc: b});
                        b = b + 1;
                    }
                    asz = asz + 1;
                }
                r = r + 1;
            }
            w = w + 1;
        }
        osz = osz + 1;
    }
    ret out;
}

# a test of a field no configuration gives, which the form states
# ---
# name:  the field
# value: the value tested
# equal: whether the test is `=` rather than `!=`
pub rec Fact {
    name:  str;
    value: u64;
    equal: bool;
}

# what the evaluation knows: each known field's value, and the facts
rec State {
    known: map.Map[str, u64];
    facts: *vector.Vector[Fact];
}

fun known(s: *State, name: str) opt[u64] {
    var key: str       = name;
    val got: opt[*u64] = map.get[str, u64](?s.known, ?key);
    if (sel got.none) { ret opt[u64].none{}; }
    ret opt[u64].some{@got.some};
}

fun know(s: *State, name: str, v: u64) bool {
    val put: res[bool, A.Error] = map.insert[str, u64](?s.known, name, v);
    ret sel put.ok;
}

# what consumes bits of the stream past ModRM
# ---
# IMMEDIATE: an immediate, UIMM0
# SECOND:    a second immediate, UIMM1, as enter's
# BRANCH:    a branch displacement, DISP under a BRDISP_WIDTH binding
# ADDRESS:   an absolute address, DISP under a DISP_WIDTH binding
pub def Use: u8;

pub val IMMEDIATE: Use = 0;
pub val SECOND:    Use = 1;
pub val BRANCH:    Use = 2;
pub val ADDRESS:   Use = 3;

# bits of the stream a nonterminal consumes
# ---
# use:    what they are
# bits:   how many
# signed: whether XED reads them sign-extended (IMM0SIGNED)
# scaled: whether their width is the effective operand size's, a rule of the nonterminal testing EOSZ
# high:   for an immediate whose high nibble names a register (vex's /is4), the bits below it, else 0
pub rec Taken {
    use:    Use;
    bits:   u8;
    signed: bool;
    scaled: bool;
    high:   u8;
}

# where a register operand is encoded
# ---
# RM:    ModRM.rm, with rex.b and rex2.b4, or evex's b and x
# REG:   ModRM.reg, with rex.r and rex2.r4, or evex's r and r'
# LOW:   the opcode byte's low three bits, with rex.b and rex2.b4
# FIXED: nowhere: the state alone fixes it, as al of an implicit operand or OrAX's eax
# VVVV:  vex's, evex's or xop's vvvv, with evex's v'
# MASK:  evex.aaa
# IS4:   imm8's high nibble, vex's and xop's fourth register
pub def Place: u8;

pub val RM:    Place = 0;
pub val REG:   Place = 1;
pub val LOW:   Place = 2;
pub val FIXED: Place = 3;
pub val VVVV:  Place = 4;
pub val MASK:  Place = 5;
pub val IS4:   Place = 6;

# a row of masc's x86 register file as the generator names it
# ---
# name:      the row's name
# class:     its class's name
# order:     its class's place among the classes, the row index of the class's first row
# number:    its number in its class
# row:       its index in the file's rows
# unspelled: whether the register families leave it unspelled, as ace's bsr0, which only an instruction implies
# members:   a tuple's member rows, in its class's order, none for any other row
# fixed:     whether it is a tuple of a fixed class, one an instruction names without an operand, as rdx:rax
pub rec Named {
    name:      str;
    class:     str;
    order:     u32;
    number:    u32;
    row:       u32;
    unspelled: bool;
    members:   vector.Vector[u32];
    fixed:     bool;
}

# what an operand is
# ---
# REGISTER: a register
# MEMORY:   memory ModRM addresses, by a general index or a vector one
# AGEN:     an address ModRM forms, with no access
# MOFFS:    an a0 to a3 move's absolute address
# IMM:      an immediate
# RELATIVE: a branch target
# STRING:   a string instruction's memory, at one register of the address size
# ZEROING:  evex's `{z}`, beside the opmask
# ROUNDING: evex's embedded rounding, or its suppression of exceptions alone
# POINTER:  a far branch's offset, beside the selector immediate
# DFV:      apx's default flags of ccmp and ctest, `{dfv=...}`, which vvvv's low four bits hold (XED DEFAULT_FLAGS)
pub def What: u8;

pub val REGISTER: What = 0;
pub val MEMORY:   What = 1;
pub val AGEN:     What = 2;
pub val MOFFS:    What = 3;
pub val IMM:      What = 4;
pub val RELATIVE: What = 5;
pub val STRING:   What = 6;
pub val ZEROING:  What = 7;
pub val ROUNDING: What = 8;
pub val POINTER:  What = 9;
pub val DFV:      What = 10;

# one operand of a form, in XED's order
# ---
# what:      what it is
# role:      how the instruction uses it
# width:     the bits it names: a register's width, a memory access's, 0 for an immediate or a target
# place:     where a register is encoded
# classes:   the classes its registers are of, in the file's order, one or two (gpr8 and gpr8h). for STRING, its
#            base's classes over the address sizes
# count:     how many classes it holds
# numbers:   bit n for each register number its nonterminal yields, of a group of registers (XED MULTIDESTn and
#            MULTISOURCEn) the first of each group. for STRING, its base's number
# fixed:     the row of the register a FIXED operand is, and a STRING operand's segment when no prefix overrides it
# taken:     the bits an immediate, a target or an address consumes
# index:     the class of a vector-indexed memory operand's index, nil for a general one
# broadcast: whether a memory operand admits evex's broadcast (XED TXT=BCASTSTR)
# sae:       whether a ROUNDING operand suppresses exceptions alone (XED TXT=SAESTR), not a rounding control
# overrides: whether a STRING operand's segment takes an override
# unsigned:  whether an IMM operand's element type is unsigned (XED's UINT), its own or its width code's, as `IMM0:r:b`
#            is u8 and `IMM0:r:b:i8` i8
# address:   whether a RELATIVE operand names an address the instruction may reach rather than its branch's target, as
#            xbegin's abort handler, which the targets topic states
pub rec Operand {
    what:      What;
    role:      operand.Role;
    width:     u16;
    place:     Place;
    classes:   [2]*Named;
    count:     u8;
    numbers:   u64;
    fixed:     *Named;
    taken:     Taken;
    index:     *Named;
    broadcast: bool;
    sae:       bool;
    overrides: bool;
    unsigned:  bool;
    address:   bool;
}

# what an implied names
# ---
# HELD:   a register
# STACK:  the stack, STACKPUSH or STACKPOP
# ACCESS: memory no operand names, at a fixed register or at the register an operand holds, as leave's load at rbp
#         and movdir64b's store at its register operand
pub def Implies: u8;

pub val HELD:   Implies = 0;
pub val STACK:  Implies = 1;
pub val ACCESS: Implies = 2;

# a register, the stack or memory no operand names that the instruction reads or writes
# ---
# what:     which of them
# register: the register, or the fixed register an access is at, nil for the stack and for an access an operand's
#           register holds the address of
# role:     how the instruction uses it
# width:    for the stack, the bits it pushes or pops, and for an access the bits it covers
# push:     for the stack, whether it pushes
# operand:  for an access, the operand whose register holds the address, field.NO_OPERAND when a fixed register does
# governor: for an access, the operand whose value decides which bytes it writes, field.NO_OPERAND when none
pub rec Implied {
    what:     Implies;
    register: *Named;
    role:     operand.Role;
    width:    u16;
    push:     bool;
    operand:  u8;
    governor: u8;
}

# a pattern evaluated under one configuration
# ---
# config:   the configuration
# admitted: whether the pattern holds under it
# eosz:     the effective operand size: 1 for 16, 2 for 32 and 3 for 64 bits
# easz:     the effective address size, numbered as eosz
# map:      the opcode map: 0 for one byte, 1 for 0f, 2 for 0f 38, 3 for 0f 3a, vex's, evex's and xop's from their MAP,
#           and 15 for 3dnow's 0f 0f
# opcode:   the opcode byte, its low three bits clear when they hold a register, or 3dnow's suffix byte
# low:      whether the opcode's low three bits hold a register
# modrm:    whether a ModRM byte follows
# direct:   whether ModRM.mod is 3
# digit:    the opcode extension in ModRM.reg, NO_DIGIT for none
# memory:   whether the pattern calls MODRM() or a vector-indexed form of it, the addressing form of a memory operand
# vsib:     the index class of a vector-indexed form, nil for none
# element:  the bits of the element an evex memory access is of (ELEMENT_SIZE), 0 for none
# nelem:    how many elements an evex memory access is (NELEM), 0 for none
# vl:       the vector length XED knows the form at (VL), NO_VL for none
# facts:    the tests of fields no configuration gives, in pattern order
# operands: its operands
# implied:  the registers no operand names
# constant: whether it takes an immediate no bits encode, as d1's 1 (XED ONE())
pub rec Form {
    config:   Config;
    admitted: bool;
    eosz:     u8;
    easz:     u8;
    map:      u8;
    opcode:   u8;
    low:      bool;
    modrm:    bool;
    direct:   bool;
    digit:    u8;
    memory:   bool;
    vsib:     *Named;
    element:  u32;
    nelem:    u32;
    vl:       u8;
    facts:    vector.Vector[Fact];
    operands: vector.Vector[Operand];
    implied:  vector.Vector[Implied];
    constant: bool;
}

pub val NO_DIGIT: u8 = 0xFF;
pub val NO_VL:    u8 = 0xFF;

# 3dnow's map, its escape 0f 0f and its opcode the suffix byte after ModRM (AMD APM 24594 Vol 3 Appendix A.3)
pub val NOW_MAP: u8 = 15;

# the evex map whose pp of 01 is 66 (Intel APX 355828-009US 3.1.4)
pub val APX_MAP: u8 = 4;

# the fact of `f` on field `name`, nil when it states none
pub fun fact(f: *Form, name: str) *Fact {
    var i: usize = 0;
    for (i < f.facts.len) {
        if (str_equals(f.facts.data[i].name, name)) { ret ?f.facts.data[i]; }
        i = i + 1;
    }
    ret nil;
}

# what the evaluation reads: the model, the register file by name, the XED registers the overlay names, the decoder
# knobs at the values the overlay gives them, and the resolved register nonterminals
pub rec Reader {
    alloc:    *A.Allocator;
    xed:      *xed.Xed;
    named:    map.Map[str, *Named];
    aliases:  map.Map[str, str];
    knobs:    vector.Vector[Knob];
    resolved: map.Map[str, vector.Vector[xed.nonterminal.Outcome]];
}

# a decoder knob of XED's and the value masc reads it at
pub rec Knob {
    name:  str;
    value: u64;
}

# a reader over `x` and the register file's rows `rows`
pub fun reader(a: *A.Allocator, x: *xed.Xed, rows: *vector.Vector[Named]) Reader {
    var r: Reader = Reader{alloc: a, xed: x, named: map.init[str, *Named](a), aliases: map.init[str, str](a), knobs: vector.init[Knob](a), resolved: map.init[str, vector.Vector[xed.nonterminal.Outcome]](a)};
    var i: usize  = 0;
    for (i < rows.len) {
        map.insert[str, *Named](?r.named, rows.data[i].name, ?rows.data[i]);
        i = i + 1;
    }
    ret r;
}

# XED register `xed_name` named as masc's register `masc_name`, for a register of XED's with no row of its own name
pub fun alias(r: *Reader, xed_name: str, masc_name: str) bool {
    val put: res[bool, A.Error] = map.insert[str, str](?r.aliases, xed_name, masc_name);
    ret sel put.ok;
}

# the names topic `t` gives XED's registers in `r`, each line `<XED register> | <row>`: a register XED states with no row
# of its own name, named as a row the file has
pub fun aliases(r: *Reader, t: *overlay.Topic) err[diag.Refusal] {
    val checked: err[diag.Refusal] = overlay.check(t, nil, overlay.unstated);
    if (sel checked.err) { ret checked; }
    var i: usize = 0;
    for (i < t.facts.len) {
        val f:    *overlay.Fact     = ?t.facts.data[i];
        var l:    overlay.Line;
        val read: err[diag.Refusal] = overlay.line(r.alloc, f, ?l);
        if (sel read.err)                    { ret read; }
        if (l.key.len != 1 || l.ws.len != 1) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_ALIAS, f.key)}; }
        val xed_name: str                      = l.key.data[0];
        val stated:   opt[*xed.table.Register] = xed.table.register(r.alloc, ?r.xed.tables, xed_name);
        if (sel stated.none) { ret err[diag.Refusal].err{overlay.refuse(f, NOT_XED, xed_name)}; }
        val own: opt[*Named] = named(r, xed_name);
        if (sel own.some) { ret err[diag.Refusal].err{overlay.refuse(f, OWN_ROW, xed_name)}; }
        val low: res[str, StrError] = str_to_lower(r.alloc, l.ws.data[0]);
        if (sel low.err) { ret err[diag.Refusal].err{memory(xed_name)}; }
        val row: opt[**Named] = map.get[str, *Named](?r.named, ?low.ok);
        if (sel row.none)                { ret err[diag.Refusal].err{overlay.refuse(f, NO_ROW, l.ws.data[0])}; }
        if (!alias(r, xed_name, low.ok)) { ret err[diag.Refusal].err{memory(xed_name)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the knobs topic `t` read into `r`, each line `<XED field> | <value>`: a field of XED's that no prefix or byte gives,
# known to every evaluation at the value it states
pub fun knobs(r: *Reader, t: *overlay.Topic) err[diag.Refusal] {
    val checked: err[diag.Refusal] = overlay.check(t, nil, overlay.unstated);
    if (sel checked.err) { ret checked; }
    var i: usize = 0;
    for (i < t.facts.len) {
        val f:    *overlay.Fact     = ?t.facts.data[i];
        var l:    overlay.Line;
        val read: err[diag.Refusal] = overlay.line(r.alloc, f, ?l);
        if (sel read.err)                    { ret read; }
        if (l.key.len != 1 || l.ws.len != 1) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_KNOB, f.key)}; }
        val name:  str                   = l.key.data[0];
        val field: opt[*xed.table.Field] = xed.table.field(r.alloc, ?r.xed.tables, name);
        if (sel field.none) { ret err[diag.Refusal].err{overlay.refuse(f, NO_KNOB, name)}; }
        val v: res[i64, diag.Refusal] = overlay.number(f, l.ws.data[0]);
        if (sel v.err)                                                                { ret err[diag.Refusal].err{v.err}; }
        if (v.ok < 0)                                                                 { ret err[diag.Refusal].err{overlay.refuse(f, BAD_KNOB, l.ws.data[0])}; }
        if (!pushed(vector.push[Knob](?r.knobs, Knob{name: name, value: v.ok::u64}))) { ret err[diag.Refusal].err{memory(name)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun memory(subject: str) diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, subject);
}

fun refuse(l: *lines.Line, message: str, subject: str) err[diag.Refusal] {
    ret err[diag.Refusal].err{lines.refuse(l, message, subject)};
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# the row of masc's register file XED's register `xed_name` is, by the overlay's alias of it or its name in lower case
pub fun named(r: *Reader, xed_name: str) opt[*Named] {
    var key:   str       = xed_name;
    val alias: opt[*str] = map.get[str, str](?r.aliases, ?key);
    var name:  str       = xed_name;
    if (sel alias.some) { name = @alias.some; }
    val low: res[str, StrError] = str_to_lower(r.alloc, name);
    if (sel low.err) { ret opt[*Named].none{}; }
    val got: opt[**Named] = map.get[str, *Named](?r.named, ?low.ok);
    if (sel got.none) { ret opt[*Named].none{}; }
    ret opt[*Named].some{@got.some};
}

# whether test `p` holds of `v`
fun holds(p: *xed.pattern.Piece, v: u64) bool {
    if (p.equal) { ret v == p.value; }
    ret v != p.value;
}

# whether the decoder skips field `name` (DS), whose tests XED drops
fun skipped(r: *Reader, name: str) bool {
    val f: opt[*xed.table.Field] = xed.table.field(r.alloc, ?r.xed.tables, name);
    ret sel f.some && f.some.skip;
}

fun free(name: str) bool {
    var i: u32 = 0;
    for (i < FREE_COUNT) {
        if (str_equals(FREE[i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether every test of `pieces` on a known field holds, a test of another field read as any value
fun known_hold(r: *Reader, pieces: *vector.Vector[xed.pattern.Piece], s: *State) bool {
    var i: usize = 0;
    for (i < pieces.len) {
        val p: *xed.pattern.Piece = ?pieces.data[i];
        if (p.kind == xed.pattern.TEST && !skipped(r, p.name)) {
            val v: opt[u64] = known(s, p.name);
            if (sel v.some && !holds(p, v.some)) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

# whether `pieces` test a field no one knows, other than one whose value is an operand's
fun tests_unknown(r: *Reader, pieces: *vector.Vector[xed.pattern.Piece], s: *State) bool {
    var i: usize = 0;
    for (i < pieces.len) {
        val p: *xed.pattern.Piece = ?pieces.data[i];
        if (p.kind == xed.pattern.TEST && !skipped(r, p.name) && !free(p.name)) {
            val v: opt[u64] = known(s, p.name);
            if (sel v.none) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# the tests of `pieces` on fields no one knows, stated as facts, an equal one making its field known
fun state_facts(r: *Reader, pieces: *vector.Vector[xed.pattern.Piece], s: *State, name: str) err[diag.Refusal] {
    var i: usize = 0;
    for (i < pieces.len) {
        val p: *xed.pattern.Piece = ?pieces.data[i];
        if (p.kind == xed.pattern.TEST && !skipped(r, p.name)) {
            val v: opt[u64] = known(s, p.name);
            if (sel v.none) {
                if (!pushed(vector.push[Fact](s.facts, Fact{name: p.name, value: p.value, equal: p.equal}))) { ret err[diag.Refusal].err{memory(name)}; }
                if (p.equal && !know(s, p.name, p.value))                                                    { ret err[diag.Refusal].err{memory(name)}; }
            }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# whether rule `rule` reports a decode error, XED's `error` binding ERROR
fun erring(rule: *xed.nonterminal.Rule) bool {
    var b: usize = 0;
    for (b < rule.bindings.len) {
        if (str_equals(rule.bindings.data[b].name, "ERROR")) { ret true; }
        b = b + 1;
    }
    ret false;
}

# whether rules `x` and `y` do one thing: neither takes bits or calls a nonterminal, and they bind the same fields to
# the same values, so a choice between them on a field nothing gives is no choice
fun alike(x: *xed.nonterminal.Rule, y: *xed.nonterminal.Rule) bool {
    if (x.bindings.len != y.bindings.len) { ret false; }
    var k: usize = 0;
    for (k < x.pattern.pieces.len) {
        val kind: xed.pattern.Kind = x.pattern.pieces.data[k].kind;
        if (kind == xed.pattern.CAPTURE || kind == xed.pattern.CALL) { ret false; }
        k = k + 1;
    }
    k = 0;
    for (k < y.pattern.pieces.len) {
        val kind: xed.pattern.Kind = y.pattern.pieces.data[k].kind;
        if (kind == xed.pattern.CAPTURE || kind == xed.pattern.CALL) { ret false; }
        k = k + 1;
    }
    var b: usize = 0;
    for (b < x.bindings.len) {
        val p: *xed.operand.Operand = ?x.bindings.data[b];
        val q: *xed.operand.Operand = ?y.bindings.data[b];
        if (!str_equals(p.name, q.name) || p.form != q.form || p.numeric != q.numeric || p.number != q.number || !str_equals(p.value, q.value)) { ret false; }
        b = b + 1;
    }
    ret true;
}

fun otherwise(rule: *xed.nonterminal.Rule) bool {
    val ps: *vector.Vector[xed.pattern.Piece] = ?rule.pattern.pieces;
    var k:  usize                             = 0;
    for (k < ps.len) {
        if (ps.data[k].kind == xed.pattern.OTHERWISE) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether a rule of `nt` tests the effective operand size
fun scaled(nt: *xed.nonterminal.Nonterminal) bool {
    var i: usize = 0;
    for (i < nt.rules.len) {
        val ps: *vector.Vector[xed.pattern.Piece] = ?nt.rules.data[i].pattern.pieces;
        var k:  usize                             = 0;
        for (k < ps.len) {
            if (ps.data[k].kind == xed.pattern.TEST && str_equals(ps.data[k].name, "EOSZ")) { ret true; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret false;
}

# what an evaluation of a nonterminal leaves besides the state: the bits it takes, the field a letters binding names
# from a capture, and whether it binds an immediate no bits hold
rec Effects {
    taken:    vector.Vector[Taken];
    is4:      bool;
    constant: bool;
}

# the nonterminal `name` evaluated under `s`: its first rule whose known tests hold, else its `otherwise`, its tests of
# unknown fields stated as facts, its captures taken and its bindings applied, a nested call evaluated in place
# ---
# ret: whether a rule holds and admits the configuration, or the refusal of what it cannot read
fun evaluate(r: *Reader, name: str, s: *State, fx: *Effects, l: *lines.Line) res[bool, diag.Refusal] {
    val found: opt[*xed.nonterminal.Nonterminal] = xed.nonterminal.find(?r.xed.nonterminals, name);
    if (sel found.none) { ret res[bool, diag.Refusal].err{lines.refuse(l, xed.NO_NONTERMINAL, name)}; }
    val nt:     *xed.nonterminal.Nonterminal = found.some;
    var chosen: *xed.nonterminal.Rule        = nil;
    var other:  *xed.nonterminal.Rule        = nil;
    var at:     usize                        = 0;
    var i:      usize                        = 0;
    for (i < nt.rules.len) {
        val rule: *xed.nonterminal.Rule = ?nt.rules.data[i];
        if (otherwise(rule)) { other = rule; }
        or (chosen == nil && known_hold(r, ?rule.pattern.pieces, s)) {
            chosen = rule;
            at     = i;
        }
        i = i + 1;
    }
    if (chosen != nil && tests_unknown(r, ?chosen.pattern.pieces, s)) {
        # a later rule that could hold too and does otherwise makes the choice the evaluation's, which it refuses to
        # make. when every rule that could hold does one thing, the field is no choice and states nothing
        var choice: bool  = false;
        var k:      usize = at + 1;
        for (k < nt.rules.len) {
            val later: *xed.nonterminal.Rule = ?nt.rules.data[k];
            if (!erring(later) && (otherwise(later) || known_hold(r, ?later.pattern.pieces, s))) {
                if (!alike(chosen, later)) { ret res[bool, diag.Refusal].err{lines.refuse(?chosen.line, AMBIGUOUS, name)}; }
                choice = true;
            }
            k = k + 1;
        }
        if (!choice) {
            val stated: err[diag.Refusal] = state_facts(r, ?chosen.pattern.pieces, s, name);
            if (sel stated.err) { ret res[bool, diag.Refusal].err{stated.err}; }
        }
    }
    if (chosen == nil)                   { chosen = other; }
    if (chosen == nil || erring(chosen)) { ret res[bool, diag.Refusal].ok{false}; }
    var taking: bool                              = false;
    var take:   Taken                             = Taken{use: IMMEDIATE, bits: 0, signed: false, scaled: false, high: 0};
    val ps:     *vector.Vector[xed.pattern.Piece] = ?chosen.pattern.pieces;
    var k:      usize                             = 0;
    for (k < ps.len) {
        val p: *xed.pattern.Piece = ?ps.data[k];
        if (p.kind == xed.pattern.CAPTURE) {
            if (str_equals(p.name, "UIMM0")) { take = Taken{use: IMMEDIATE, bits: p.len, signed: false, scaled: scaled(nt), high: 0}; }
            or (str_equals(p.name, "UIMM1")) { take = Taken{use: SECOND, bits: p.len, signed: false, scaled: false, high: 0}; }
            or (str_equals(p.name, "DISP"))  { take = Taken{use: BRANCH, bits: p.len, signed: true, scaled: scaled(nt), high: 0}; }
            or                               { ret res[bool, diag.Refusal].err{lines.refuse(?chosen.line, UNKNOWN, p.name)}; }
            taking = true;
        }
        or (p.kind == xed.pattern.CALL) {
            val inner: res[bool, diag.Refusal] = evaluate(r, p.name, s, fx, ?chosen.line);
            if (sel inner.err) { ret inner; }
            if (!inner.ok)     { ret inner; }
        }
        or (p.kind == xed.pattern.BITS) { ret res[bool, diag.Refusal].err{lines.refuse(?chosen.line, UNKNOWN, nt.name)}; }
        k = k + 1;
    }
    var b: usize = 0;
    for (b < chosen.bindings.len) {
        val op: *xed.operand.Operand = ?chosen.bindings.data[b];
        if (op.form == xed.operand.LETTERS && str_equals(op.name, "ESRC")) {
            # vex's /is4: the capture's high nibble names a register and its low one is an immediate
            fx.is4    = true;
            take.high = 4;
        }
        or (op.form != xed.operand.CONSTANT || !op.numeric) { ret res[bool, diag.Refusal].err{lines.refuse(?chosen.line, UNREAD, op.name)}; }
        or {
            if (!know(s, op.name, op.number))            { ret res[bool, diag.Refusal].err{memory(name)}; }
            if (str_equals(op.name, "IMM0SIGNED"))       { take.signed = op.number != 0; }
            or (str_equals(op.name, "DISP_WIDTH"))       { take.use = ADDRESS; }
            or (str_equals(op.name, "BRDISP_WIDTH"))     { take.use = BRANCH; }
            or (str_equals(op.name, "UIMM0") && !taking) { fx.constant = true; }
        }
        b = b + 1;
    }
    if (taking) {
        if (!pushed(vector.push[Taken](?fx.taken, take))) { ret res[bool, diag.Refusal].err{memory(name)}; }
    }
    ret res[bool, diag.Refusal].ok{true};
}

fun inert(name: str) bool {
    var i: u32 = 0;
    for (i < INERT_COUNT) {
        if (str_equals(INERT[i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun vsib_of(name: str) i32 {
    var i: u32 = 0;
    for (i < VSIB_COUNT) {
        if (str_equals(VSIB[i], name)) { ret i::i32; }
        i = i + 1;
    }
    ret -1;
}

# the resolved ends of register nonterminal `name`, resolved once
fun outcomes(r: *Reader, name: str) res[*vector.Vector[xed.nonterminal.Outcome], diag.Refusal] {
    val have: opt[*vector.Vector[xed.nonterminal.Outcome]] = map.get[str, vector.Vector[xed.nonterminal.Outcome]](?r.resolved, ?name);
    if (sel have.some) { ret res[*vector.Vector[xed.nonterminal.Outcome], diag.Refusal].ok{have.some}; }
    val got: res[vector.Vector[xed.nonterminal.Outcome], diag.Refusal] = xed.nonterminal.resolve(r.alloc, ?r.xed.nonterminals, name);
    if (sel got.err) { ret res[*vector.Vector[xed.nonterminal.Outcome], diag.Refusal].err{got.err}; }
    val put: res[bool, A.Error] = map.insert[str, vector.Vector[xed.nonterminal.Outcome]](?r.resolved, name, got.ok);
    if (sel put.err) { ret res[*vector.Vector[xed.nonterminal.Outcome], diag.Refusal].err{memory(name)}; }
    val again: opt[*vector.Vector[xed.nonterminal.Outcome]] = map.get[str, vector.Vector[xed.nonterminal.Outcome]](?r.resolved, ?name);
    if (sel again.none) { ret res[*vector.Vector[xed.nonterminal.Outcome], diag.Refusal].err{memory(name)}; }
    ret res[*vector.Vector[xed.nonterminal.Outcome], diag.Refusal].ok{again.some};
}

# the place the field `name` encodes a register at, FIXED for a field that places none
fun field_place(name: str) Place {
    # rex.b and rex.r and their apx and evex kin extend the field they sit beside, so only the field names the place
    if (str_equals(name, "RM"))                                                                         { ret RM; }
    if (str_equals(name, "REG"))                                                                        { ret REG; }
    if (str_equals(name, "SRM"))                                                                        { ret LOW; }
    if (str_equals(name, "VEXDEST210") || str_equals(name, "VEXDEST3") || str_equals(name, "VEXDEST4")) { ret VVVV; }
    if (str_equals(name, "MASK"))                                                                       { ret MASK; }
    if (str_equals(name, "ESRC"))                                                                       { ret IS4; }
    ret FIXED;
}

# the place the fields an outcome tests encode a register at, FIXED when it tests none
fun place_of(pieces: *vector.Vector[xed.pattern.Piece], out: *Place, seen: *bool, l: *lines.Line) err[diag.Refusal] {
    var i: usize = 0;
    for (i < pieces.len) {
        val p: *xed.pattern.Piece = ?pieces.data[i];
        if (p.kind == xed.pattern.TEST) {
            val at: Place = field_place(p.name);
            if (at != FIXED) {
                if (@seen && @out != FIXED && @out != at) { ret refuse(l, PLACES, p.name); }
                @out  = at;
                @seen = true;
            }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun yields(o: *xed.nonterminal.Outcome) bool {
    ret o.register != nil && !str_equals(o.register, "ERROR") && !str_equals(o.register, "INVALID");
}

# operand `op` holding the registers nonterminal `name` yields under `s`, a register no field encodes when it reads none
fun register_nt(r: *Reader, name: str, s: *State, op: *Operand, l: *lines.Line) err[diag.Refusal] {
    val got: res[*vector.Vector[xed.nonterminal.Outcome], diag.Refusal] = outcomes(r, name);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    val ends:  *vector.Vector[xed.nonterminal.Outcome] = got.ok;
    var place: Place                                   = FIXED;
    var seen:  bool                                    = false;
    var count: u32                                     = 0;
    var last:  *Named                                  = nil;
    var i:     usize                                   = 0;
    for (i < ends.len) {
        val o: *xed.nonterminal.Outcome = ?ends.data[i];
        if (known_hold(r, ?o.conditions, s) && yields(o)) {
            val placed: err[diag.Refusal] = place_of(?o.conditions, ?place, ?seen, ?o.rule.line);
            if (sel placed.err) { ret placed; }
            val n: opt[*Named] = named_or_enclosing(r, o.register);
            if (sel n.none) { ret refuse(?o.rule.line, NO_NAMED, o.register); }
            val added: err[diag.Refusal] = add_register(op, n.some, l);
            if (sel added.err) { ret added; }
            count = count + 1;
            last  = n.some;
        }
        i = i + 1;
    }
    if (count == 0) { ret refuse(l, NO_YIELD, name); }
    op.place = place;
    if (place == FIXED) {
        if (count != 1) { ret refuse(l, NO_YIELD, name); }
        op.fixed = last;
    }
    ret err[diag.Refusal].ok{};
}

# register row `n` added to operand `op`'s classes and numbers
fun add_register(op: *Operand, n: *Named, l: *lines.Line) err[diag.Refusal] {
    var k:  u8  = 0;
    var at: i32 = -1;
    for (k < op.count) {
        if (str_equals(op.classes[k].class, n.class)) { at = k::i32; }
        k = k + 1;
    }
    if (at < 0) {
        if (op.count == 2) { ret refuse(l, TWO_CLASSES, n.class); }
        op.classes[op.count] = n;
        op.count             = op.count + 1;
        # the classes in the file's order
        if (op.count == 2 && op.classes[1].order < op.classes[0].order) {
            val first: *Named = op.classes[0];
            op.classes[0] = op.classes[1];
            op.classes[1] = first;
        }
    }
    if (n.number < 64) { op.numbers = op.numbers | (1::u64 << n.number::u64); }
    ret err[diag.Refusal].ok{};
}

# register operand `from` of the same form under another configuration joined into `into`: the registers either
# yields, as a rex2 prefix reaches r16 to r31 and loses ah to bh, and a string operand's base over the address sizes,
# which one row holds and the kind encodes
pub fun join(into: *Operand, from: *Operand, l: *lines.Line) err[diag.Refusal] {
    # a class's row names the class, and its number is none of the registers the operand yields
    val numbers: u64 = into.numbers | from.numbers;
    var k:       u8  = 0;
    for (k < from.count) {
        val added: err[diag.Refusal] = add_register(into, from.classes[k], l);
        if (sel added.err) { ret added; }
        k = k + 1;
    }
    into.numbers = numbers;
    ret err[diag.Refusal].ok{};
}

# the role of XED action `action`: a conditional write keeps the old value where it does not write, so it reads it too
fun role_of(action: str) operand.Role {
    if (str_equals(action, "r") || str_equals(action, "cr")) { ret operand.READ; }
    if (str_equals(action, "w"))                             { ret operand.WRITE; }
    ret operand.READ_WRITE;
}

# the width code whose columns are the effective address sizes'
val ADDRESS_WIDTH: str = "asz";

# the bits operand `op` of `ins` names at effective operand size `eosz`, from its width code or the one its nonterminal,
# register or constant takes
# a width code of no bits names an access whose size the instruction's state gives, as an amx tile's rows, which is 0,
# and one of element type `var` the elements an evex access is, NELEM times ELEMENT_SIZE (`f.nelem` and `f.element`)
fun width_bits(r: *Reader, ins: *xed.instruction.Instruction, op: *xed.operand.Operand, f: *Form) res[u16, diag.Refusal] {
    val code: opt[str] = xed.operand.width(r.alloc, ?r.xed.tables, op);
    if (sel code.none) { ret res[u16, diag.Refusal].err{lines.refuse(?ins.line, NO_WIDTH, op.name)}; }
    val w: opt[*xed.table.Width] = xed.table.width(r.alloc, ?r.xed.tables, code.some);
    if (sel w.none) { ret res[u16, diag.Refusal].err{lines.refuse(?ins.line, NO_WIDTH, code.some)}; }
    # a width code's columns are the effective operand sizes', but asz's, which varies with the effective address
    # width (datafiles/xed-operand-width.txt), so A_GPR_R's register is as wide as the address whatever 66 states
    var k: u8 = f.eosz;
    if (str_equals(code.some, ADDRESS_WIDTH)) { k = f.easz; }
    if (k > 3)                                { k = 3; }
    var bits: u32 = w.some.bits[k];
    if (bits == 0 && str_equals(w.some.element, "var")) {
        bits = f.nelem * f.element;
        if (bits == 0) { ret res[u16, diag.Refusal].err{lines.refuse(?ins.line, NO_WIDTH, code.some)}; }
    }
    or (bits == 0 && w.some.bits[0] == 0 && w.some.bits[1] == 0 && w.some.bits[2] == 0 && w.some.bits[3] == 0) { ret res[u16, diag.Refusal].ok{0}; }
    if (bits == 0 || bits > 0xFFFF)                                                                            { ret res[u16, diag.Refusal].err{lines.refuse(?ins.line, NO_WIDTH, code.some)}; }
    ret res[u16, diag.Refusal].ok{bits::u16};
}

# the width of the registers nonterminal `name` yields under `s`, for an operand with no width code, which XED takes
# from the register it decodes (datafiles/xed-regs.txt, its width columns), refused unless they all agree
fun yielded_width(r: *Reader, name: str, s: *State, l: *lines.Line) res[u16, diag.Refusal] {
    val got: res[*vector.Vector[xed.nonterminal.Outcome], diag.Refusal] = outcomes(r, name);
    if (sel got.err) { ret res[u16, diag.Refusal].err{got.err}; }
    var mode: u64      = 0;
    val m:    opt[u64] = known(s, "MODE");
    if (sel m.some) { mode = m.some; }
    var bits: u32   = 0;
    var i:    usize = 0;
    for (i < got.ok.len) {
        val o: *xed.nonterminal.Outcome = ?got.ok.data[i];
        if (known_hold(r, ?o.conditions, s) && yields(o)) {
            val reg: opt[*xed.table.Register] = xed.table.register(r.alloc, ?r.xed.tables, o.register);
            if (sel reg.none) { ret res[u16, diag.Refusal].err{lines.refuse(l, NO_WIDTH, o.register)}; }
            var w: u32 = reg.some.width;
            if (mode == 2)                          { w = reg.some.width64; }
            if (w == 0 || (bits != 0 && w != bits)) { ret res[u16, diag.Refusal].err{lines.refuse(l, NO_WIDTH, name)}; }
            bits = w;
        }
        i = i + 1;
    }
    if (bits == 0 || bits > 0xFFFF) { ret res[u16, diag.Refusal].err{lines.refuse(l, NO_WIDTH, name)}; }
    ret res[u16, diag.Refusal].ok{bits::u16};
}

# the first bits of `fx` of use `use` not yet consumed, marked consumed
fun take(fx: *Effects, used: *u8, use: Use) opt[Taken] {
    var i: usize = 0;
    for (i < fx.taken.len) {
        if (fx.taken.data[i].use == use && ((@used >> i::u8) & 1) == 0) {
            @used = @used | (1::u8 << i::u8);
            ret opt[Taken].some{fx.taken.data[i]};
        }
        i = i + 1;
    }
    ret opt[Taken].none{};
}

val GPR32: [8]str = [8]str{"eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi"};

# the register `n` is in code of form `f`'s width: a 64-bit general register XED names in every mode, as pvalidate's
# rax and encls's rbx, is the 32-bit one outside 64-bit code, where the register is no wider (AMD APM 24594 3.38
# PVALIDATE's rAX, Intel SDM 325462-093US ENCLS's EBX to EDX outside 64-bit mode)
fun at_width(r: *Reader, n: *Named, f: *Form) *Named {
    if (width_of(f.config.mode) == 64 || !str_equals(n.class, "gpr64") || n.number >= 8) { ret n; }
    var key: str          = GPR32[n.number];
    val got: opt[**Named] = map.get[str, *Named](?r.named, ?key);
    if (sel got.none) { ret n; }
    ret @got.some;
}

# the row of the register XED names `xed_name`, or of the widest register enclosing it, as rip encloses eip
fun named_or_enclosing(r: *Reader, xed_name: str) opt[*Named] {
    val own: opt[*Named] = named(r, xed_name);
    if (sel own.some) { ret own; }
    val reg: opt[*xed.table.Register] = xed.table.register(r.alloc, ?r.xed.tables, xed_name);
    if (sel reg.some) {
        if (reg.some.enclosing != nil) { ret named(r, reg.some.enclosing); }
    }
    ret opt[*Named].none{};
}

# the numbers that begin a group of `n` registers, the multiples of n, as vp2intersectd's pair of opmasks, which its
# even register names, as llvm-objdump 23.1.1 writes `k6` of an encoding of 6 or 7 (llvm-project
# 7ddb67460b168b17ebb263dc99bf956b56d7e517 llvm/lib/Target/X86/X86RegisterInfo.td VK16PAIR, Intel SDM 325462-093US
# Vol 2C VP2INTERSECTD)
fun grouped(n: u32) u64 {
    var bits: u64 = 0;
    var k:    u64 = 0;
    for (k < 64) {
        bits = bits | (1::u64 << k);
        k    = k + n::u64;
    }
    ret bits;
}

fun has_conversion(op: *xed.operand.Operand, txt: str) bool {
    var i: usize = 0;
    for (i < op.conversions.len) {
        if (str_equals(op.conversions.data[i], txt)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `ins` states attribute `name`
pub fun attributed(ins: *xed.instruction.Instruction, name: str) bool {
    var i: usize = 0;
    for (i < ins.attributes.len) {
        if (str_equals(ins.attributes.data[i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `ins` is a string instruction, whose suppressed memory operands and the registers beside them llvm-objdump
# 23.1.1 writes, as `stosb byte ptr es:[rdi], al`
fun stringed(ins: *xed.instruction.Instruction) bool {
    ret str_equals(ins.category, "STRINGOP") || str_equals(ins.category, "IOSTRINGOP");
}

# whether suppressed operand `op` of `ins` is one the row writes as an operand: a string instruction's memory, and the
# fixed register beside it, never its count
fun shown(ins: *xed.instruction.Instruction, op: *xed.operand.Operand) bool {
    if (!stringed(ins))                  { ret false; }
    if (str_starts_with(op.name, "MEM")) { ret true; }
    ret str_starts_with(op.name, "REG") && op.form == xed.operand.REGISTER;
}

# the string memory operand `o` of `ins`, MEM0 or MEM1 as `which` says, at its base's register under `s`
fun string_operand(r: *Reader, ins: *xed.instruction.Instruction, which: u8, s: *State, o: *Operand) err[diag.Refusal] {
    val base: *xed.operand.Operand = base_of(ins, which);
    if (base == nil || base.form != xed.operand.NONTERMINAL) { ret refuse(?ins.line, OPERAND, ins.iclass); }
    var b:   Operand;
    val got: err[diag.Refusal] = register_nt(r, base.value, s, ?b, ?ins.line);
    if (sel got.err)      { ret got; }
    if (b.place != FIXED) { ret refuse(?ins.line, OPERAND, base.value); }
    o.what    = STRING;
    o.place   = FIXED;
    o.classes = b.classes;
    o.count   = b.count;
    o.numbers = b.numbers;
    o.fixed   = nil;
    val seg: *xed.operand.Operand = seg_of(ins, which);
    if (seg != nil && seg.form == xed.operand.NONTERMINAL) {
        # FINAL_ESEG is es whatever prefix is there, FINAL_DSEG ds unless one overrides it
        o.overrides = !str_starts_with(seg.value, "FINAL_ESEG");
        if (o.overrides) { o.fixed = name_row(r, "DS"); }
        or               { o.fixed = name_row(r, "ES"); }
    }
    ret err[diag.Refusal].ok{};
}

fun name_row(r: *Reader, name: str) *Named {
    val got: opt[*Named] = named(r, name);
    if (sel got.some) { ret got.some; }
    ret nil;
}

fun base_of(ins: *xed.instruction.Instruction, which: u8) *xed.operand.Operand {
    var i: usize = 0;
    for (i < ins.operands.len) {
        val op: *xed.operand.Operand = ?ins.operands.data[i];
        if ((which == 0 && str_equals(op.name, "BASE0")) || (which == 1 && str_equals(op.name, "BASE1"))) { ret op; }
        i = i + 1;
    }
    ret nil;
}

fun seg_of(ins: *xed.instruction.Instruction, which: u8) *xed.operand.Operand {
    var i: usize = 0;
    for (i < ins.operands.len) {
        val op: *xed.operand.Operand = ?ins.operands.data[i];
        if ((which == 0 && str_equals(op.name, "SEG0")) || (which == 1 && str_equals(op.name, "SEG1"))) { ret op; }
        i = i + 1;
    }
    ret nil;
}

# the register `register` no operand names, used as `role` says
fun held(register: *Named, role: operand.Role) Implied {
    ret Implied{what: HELD, register: register, role: role, width: 0, push: false, operand: field.NO_OPERAND, governor: field.NO_OPERAND};
}

# the stack, pushed of `width` bits when `push` and popped otherwise
fun stack(role: operand.Role, width: u16, push: bool) Implied {
    ret Implied{what: STACK, register: nil, role: role, width: width, push: push, operand: field.NO_OPERAND, governor: field.NO_OPERAND};
}

# whether `ins` forms an address with an index register no operand names, as xlat's rbx plus al
fun indexed(ins: *xed.instruction.Instruction) bool {
    var i: usize = 0;
    for (i < ins.operands.len) {
        if (str_equals(ins.operands.data[i].name, "INDEX")) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the access of suppressed memory operand `op` of `ins` under `s`, into `f`, `at` holding the operand each of XED's
# is in `f`. the access is at its base's fixed register, which the instruction reads and an advancing one writes, as
# leave's load at rbp and xstore's store at rdi, or at the register an operand holds when that operand names the
# base, as movdir64b's store. a masking row's access is governed by its last register operand, the byte mask (Intel
# SDM 325462-093US Vol 2B MASKMOVDQU, MASKMOVQ). an address an index register forms too, as xlat's, is one no access
# states, so the row states none
fun access(r: *Reader, ins: *xed.instruction.Instruction, op: *xed.operand.Operand, s: *State, f: *Form, at: *vector.Vector[u8]) err[diag.Refusal] {
    if (indexed(ins)) { ret err[diag.Refusal].ok{}; }
    val base: *xed.operand.Operand = base_of(ins, (op.name[3] - '0')::u8);
    if (base == nil || base.form != xed.operand.NONTERMINAL) { ret refuse(?ins.line, OPERAND, op.name); }
    val w: res[u16, diag.Refusal] = width_bits(r, ins, op, f);
    if (sel w.err) { ret err[diag.Refusal].err{w.err}; }
    var m:   Implied           = Implied{what: ACCESS, register: nil, role: role_of(op.action), width: w.ok, push: false, operand: field.NO_OPERAND, governor: field.NO_OPERAND};
    var b:   Operand           = blank();
    val got: err[diag.Refusal] = register_nt(r, base.value, s, ?b, ?ins.line);
    if (sel got.err) { ret got; }
    if (b.place == FIXED) {
        val n:   opt[*Named] = named_or_enclosing(r, b.fixed.name);
        var row: *Named      = b.fixed;
        if (sel n.some) { row = at_width(r, n.some, f); }
        # an access of the stack segment no operand names is at the stack's address size, the width's own whatever an
        # override, as leave's load at rbp (Intel SDM 325462-093US Vol 1 6.2.3, Vol 2A LEAVE), which XED's ArBP states
        # at the override's
        val seg: *xed.operand.Operand = seg_of(ins, (op.name[3] - '0')::u8);
        if (seg != nil && str_starts_with(seg.value, "FINAL_SSEG")) {
            val sized: res[*Named, diag.Refusal] = address_register(r, f.config.mode, 0, row.number);
            if (sel sized.err) { ret err[diag.Refusal].err{sized.err}; }
            row = sized.ok;
        }
        m.register = row;
        if (!pushed(vector.push[Implied](?f.implied, held(row, role_of(base.action))))) { ret err[diag.Refusal].err{memory(op.name)}; }
    }
    or {
        var i: usize = 0;
        for (i < ins.operands.len && m.operand == field.NO_OPERAND) {
            val o: *xed.operand.Operand = ?ins.operands.data[i];
            if (o != base && o.form == xed.operand.NONTERMINAL && str_equals(o.value, base.value)) { m.operand = at.data[i]; }
            i = i + 1;
        }
        if (m.operand == field.NO_OPERAND) { ret refuse(?ins.line, OPERAND, base.value); }
    }
    if (attributed(ins, "MASKOP")) {
        var k: usize = 0;
        for (k < f.operands.len) {
            if (f.operands.data[k].what == REGISTER) { m.governor = k::u8; }
            k = k + 1;
        }
    }
    if (!pushed(vector.push[Implied](?f.implied, m))) { ret err[diag.Refusal].err{memory(op.name)}; }
    ret err[diag.Refusal].ok{};
}

# a register or the stack no operand names, from operand `op` of `ins` under `s`, into `f`
fun implied(r: *Reader, ins: *xed.instruction.Instruction, op: *xed.operand.Operand, s: *State, f: *Form) err[diag.Refusal] {
    # the segment, base, index and scale of a memory operand are its own parts
    if (str_starts_with(op.name, "SEG") || str_starts_with(op.name, "BASE") || str_equals(op.name, "INDEX") || str_equals(op.name, "SCALE")) { ret err[diag.Refusal].ok{}; }
    val role: operand.Role = role_of(op.action);
    if (op.form == xed.operand.REGISTER) {
        if (str_equals(op.value, "STACKPUSH") || str_equals(op.value, "STACKPOP")) {
            val w: res[u16, diag.Refusal] = width_bits(r, ins, op, f);
            if (sel w.err)                                                                                       { ret err[diag.Refusal].err{w.err}; }
            if (!pushed(vector.push[Implied](?f.implied, stack(role, w.ok, str_equals(op.value, "STACKPUSH"))))) { ret err[diag.Refusal].err{memory(op.name)}; }
            ret err[diag.Refusal].ok{};
        }
        val n: opt[*Named] = named_or_enclosing(r, op.value);
        if (sel n.none)                                                                    { ret refuse(?ins.line, NO_NAMED, op.value); }
        if (!pushed(vector.push[Implied](?f.implied, held(at_width(r, n.some, f), role)))) { ret err[diag.Refusal].err{memory(op.name)}; }
        ret err[diag.Refusal].ok{};
    }
    if (op.form == xed.operand.NONTERMINAL) {
        var o:   Operand;
        val got: err[diag.Refusal] = register_nt(r, op.value, s, ?o, ?ins.line);
        if (sel got.err)      { ret got; }
        if (o.place != FIXED) { ret refuse(?ins.line, OPERAND, op.name); }
        val n:   opt[*Named] = named_or_enclosing(r, o.fixed.name);
        var row: *Named      = o.fixed;
        if (sel n.some)                                                 { row = at_width(r, n.some, f); }
        if (!pushed(vector.push[Implied](?f.implied, held(row, role)))) { ret err[diag.Refusal].err{memory(op.name)}; }
        ret err[diag.Refusal].ok{};
    }
    # a flag XED states of the operation, as vbroadcastss's broadcast, which no operand is
    if (op.form == xed.operand.FLAG) { ret err[diag.Refusal].ok{}; }
    ret refuse(?ins.line, OPERAND, op.name);
}

# whether the element type of `op`, its own or its width code's, is unsigned (xed-operand-types.txt UINT)
fun unsigned_type(r: *Reader, op: *xed.operand.Operand) bool {
    var name: str = op.element;
    if (name == nil) {
        val code: opt[str] = xed.operand.width(r.alloc, ?r.xed.tables, op);
        if (sel code.none) { ret false; }
        val w: opt[*xed.table.Width] = xed.table.width(r.alloc, ?r.xed.tables, code.some);
        if (sel w.none) { ret false; }
        name = w.some.element;
    }
    val t: opt[*xed.table.Type] = xed.table.element(r.alloc, ?r.xed.tables, name);
    if (sel t.none) { ret false; }
    ret str_equals(t.some.base, "UINT");
}

fun blank() Operand {
    var o: Operand;
    o.what      = REGISTER;
    o.role      = operand.READ;
    o.width     = 0;
    o.place     = FIXED;
    o.count     = 0;
    o.numbers   = 0;
    o.fixed     = nil;
    o.taken     = Taken{use: IMMEDIATE, bits: 0, signed: false, scaled: false, high: 0};
    o.index     = nil;
    o.broadcast = false;
    o.sae       = false;
    o.overrides = false;
    o.unsigned  = false;
    o.address   = false;
    ret o;
}

fun push_operand(f: *Form, o: Operand, name: str) err[diag.Refusal] {
    if (!pushed(vector.push[Operand](?f.operands, o))) { ret err[diag.Refusal].err{memory(name)}; }
    ret err[diag.Refusal].ok{};
}

# the operands of `ins` under `s` into `f`, the bits its nonterminals took in `fx`
fun operands_of(r: *Reader, ins: *xed.instruction.Instruction, s: *State, fx: *Effects, f: *Form) err[diag.Refusal] {
    var used:   u8      = 0;
    var rounds: bool    = false;
    var rc:     Operand = blank();
    # the default flags are the first operand, as llvm-objdump 23.1.1 writes `ccmpb {dfv=of} al, bl`
    if (attributed(ins, "DEFAULT_FLAGS")) {
        var d: Operand = blank();
        d.what  = DFV;
        d.place = VVVV;
        val pd: err[diag.Refusal] = push_operand(f, d, ins.iclass);
        if (sel pd.err) { ret pd; }
    }
    var at:    vector.Vector[u8]    = vector.init[u8](r.alloc);
    var later: vector.Vector[usize] = vector.init[usize](r.alloc);
    var i:     usize                = 0;
    for (i < ins.operands.len) {
        if (!pushed(vector.push[u8](?at, field.NO_OPERAND))) { ret err[diag.Refusal].err{memory(ins.iclass)}; }
        i = i + 1;
    }
    i = 0;
    for (i < ins.operands.len) {
        val op:         *xed.operand.Operand = ?ins.operands.data[i];
        val suppressed: bool                 = str_equals(op.visibility, "SUPP") || str_equals(op.visibility, "ECOND");
        # an access no operand names follows every operand, which its address and mask may be
        if (suppressed && !shown(ins, op) && str_starts_with(op.name, "MEM")) {
            if (!pushed(vector.push[usize](?later, i))) { ret err[diag.Refusal].err{memory(op.name)}; }
            i = i + 1;
            cnt;
        }
        if (suppressed && !shown(ins, op)) {
            val done: err[diag.Refusal] = implied(r, ins, op, s, f);
            if (sel done.err) { ret done; }
            i = i + 1;
            cnt;
        }
        var o: Operand = blank();
        o.role = role_of(op.action);
        if (op.form == xed.operand.BARE && str_starts_with(op.name, "MEM") && suppressed) {
            val got: err[diag.Refusal] = string_operand(r, ins, (op.name[3] - '0')::u8, s, ?o);
            if (sel got.err) { ret got; }
            val w: res[u16, diag.Refusal] = width_bits(r, ins, op, f);
            if (sel w.err) { ret err[diag.Refusal].err{w.err}; }
            o.width = w.ok;
        }
        or (op.form == xed.operand.BARE && str_starts_with(op.name, "MEM")) {
            val w: res[u16, diag.Refusal] = width_bits(r, ins, op, f);
            if (sel w.err) { ret err[diag.Refusal].err{w.err}; }
            o.width     = w.ok;
            o.broadcast = has_conversion(op, "BCASTSTR");
            val address: opt[Taken] = take(fx, ?used, ADDRESS);
            if (sel address.some) {
                o.what  = MOFFS;
                o.taken = address.some;
            }
            or (f.memory) {
                o.what  = MEMORY;
                o.index = f.vsib;
            }
            or { ret refuse(?ins.line, UNTAKEN, op.name); }
        }
        or (op.form == xed.operand.BARE && str_equals(op.name, "AGEN")) {
            if (!f.memory) { ret refuse(?ins.line, UNTAKEN, op.name); }
            o.what = AGEN;
        }
        or (op.form == xed.operand.BARE && (str_equals(op.name, "IMM0") || str_equals(op.name, "IMM1"))) {
            var use: Use = IMMEDIATE;
            if (str_equals(op.name, "IMM1")) { use = SECOND; }
            val got: opt[Taken] = take(fx, ?used, use);
            if (sel got.none) {
                # an immediate no bits hold, as d1's 1, which llvm-objdump 23.1.1 writes as `shl eax` with no operand
                if (fx.constant && use == IMMEDIATE) {
                    f.constant = true;
                    i          = i + 1;
                    cnt;
                }
                ret refuse(?ins.line, UNTAKEN, op.name);
            }
            o.what     = IMM;
            o.taken    = got.some;
            o.unsigned = unsigned_type(r, op);
            # /is4's immediate is the nibble below its register
            if (got.some.high != 0) { o.taken.bits = got.some.high; }
        }
        or (op.form == xed.operand.BARE && str_equals(op.name, "RELBR")) {
            val got: opt[Taken] = take(fx, ?used, BRANCH);
            if (sel got.none) { ret refuse(?ins.line, UNTAKEN, op.name); }
            o.what  = RELATIVE;
            o.taken = got.some;
        }
        or (op.form == xed.operand.BARE && (str_equals(op.name, "PTR") || str_equals(op.name, "ABSBR"))) {
            val got: opt[Taken] = take(fx, ?used, BRANCH);
            if (sel got.none) { ret refuse(?ins.line, UNTAKEN, op.name); }
            o.what         = POINTER;
            o.taken        = got.some;
            o.taken.signed = false;
        }
        or (op.form == xed.operand.NONTERMINAL) {
            o.what = REGISTER;
            val got: err[diag.Refusal] = register_nt(r, op.value, s, ?o, ?ins.line);
            if (sel got.err)  { ret got; }
            if (op.group > 1) { o.numbers = o.numbers & grouped(op.group); }
            val code: opt[str]               = xed.operand.width(r.alloc, ?r.xed.tables, op);
            var w:    res[u16, diag.Refusal] = yielded_width(r, op.value, s, ?ins.line);
            if (sel code.some) { w = width_bits(r, ins, op, f); }
            if (sel w.err)     { ret err[diag.Refusal].err{w.err}; }
            o.width = w.ok;
        }
        or (op.form == xed.operand.REGISTER) {
            o.what = REGISTER;
            val n: opt[*Named] = named(r, op.value);
            if (sel n.none) { ret refuse(?ins.line, NO_NAMED, op.value); }
            val reg:   *Named            = at_width(r, n.some, f);
            val added: err[diag.Refusal] = add_register(?o, reg, ?ins.line);
            if (sel added.err) { ret added; }
            o.fixed = reg;
            val w: res[u16, diag.Refusal] = width_bits(r, ins, op, f);
            if (sel w.err) { ret err[diag.Refusal].err{w.err}; }
            o.width = w.ok;
        }
        or (op.form == xed.operand.FLAG) {
            i = i + 1;
            cnt;
        }
        or { ret refuse(?ins.line, OPERAND, op.name); }
        # a rounding operand is the instruction's last, after every source, as llvm-objdump 23.1.1 writes `{rn-sae}`
        if (has_conversion(op, "ROUNDC") || has_conversion(op, "SAESTR")) {
            rounds  = true;
            rc.what = ROUNDING;
            rc.sae  = has_conversion(op, "SAESTR");
        }
        at.data[i] = f.operands.len::u8;
        val pushed_o: err[diag.Refusal] = push_operand(f, o, op.name);
        if (sel pushed_o.err) { ret pushed_o; }
        # evex's `{z}` follows the opmask it applies under
        if (o.what == REGISTER && o.place == MASK && has_conversion(op, "ZEROSTR")) {
            var z: Operand = blank();
            z.what = ZEROING;
            val pz: err[diag.Refusal] = push_operand(f, z, op.name);
            if (sel pz.err) { ret pz; }
        }
        i = i + 1;
    }
    if (rounds) {
        val pr: err[diag.Refusal] = push_operand(f, rc, ins.iclass);
        if (sel pr.err) { ret pr; }
    }
    i = 0;
    for (i < later.len) {
        val done: err[diag.Refusal] = access(r, ins, ?ins.operands.data[later.data[i]], s, f, ?at);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the map and opcode of the fixed bytes `bytes` of a legacy pattern, and 3dnow's suffix byte `suffix` when `suffixed`,
# refused when they are no escape the legacy maps have
fun legacy_opcode(ins: *xed.instruction.Instruction, bytes: *u8, count: u32, suffixed: bool, suffix: u8, f: *Form) err[diag.Refusal] {
    if (suffixed) {
        if (count != 2 || bytes[0] != 0x0F || bytes[1] != 0x0F) { ret refuse(?ins.line, ESCAPE, ins.iclass); }
        f.map    = NOW_MAP;
        f.opcode = suffix;
        ret err[diag.Refusal].ok{};
    }
    if (count == 1 && bytes[0] != 0x0F) {
        f.map    = 0;
        f.opcode = bytes[0];
        ret err[diag.Refusal].ok{};
    }
    if (count == 2 && bytes[0] == 0x0F && bytes[1] != 0x38 && bytes[1] != 0x3A && bytes[1] != 0x0F) {
        f.map    = 1;
        f.opcode = bytes[1];
        ret err[diag.Refusal].ok{};
    }
    if (count == 3 && bytes[0] == 0x0F && bytes[1] == 0x38) {
        f.map    = 2;
        f.opcode = bytes[2];
        ret err[diag.Refusal].ok{};
    }
    if (count == 3 && bytes[0] == 0x0F && bytes[1] == 0x3A) {
        f.map    = 3;
        f.opcode = bytes[2];
        ret err[diag.Refusal].ok{};
    }
    ret refuse(?ins.line, ESCAPE, ins.iclass);
}

# the map and opcode of a vex, evex or xop pattern: its one opcode byte, and the map its MAP test states
fun vex_opcode(ins: *xed.instruction.Instruction, bytes: *u8, count: u32, s: *State, f: *Form) err[diag.Refusal] {
    if (count != 1) { ret refuse(?ins.line, ESCAPE, ins.iclass); }
    val m: opt[u64] = known(s, "MAP");
    if (sel m.none)  { ret refuse(?ins.line, NO_MAP, ins.iclass); }
    if (m.some > 31) { ret refuse(?ins.line, NO_MAP, ins.iclass); }
    f.map    = m.some::u8;
    f.opcode = bytes[0];
    ret err[diag.Refusal].ok{};
}

fun known_or(s: *State, name: str, otherwise: u64) u64 {
    val v: opt[u64] = known(s, name);
    if (sel v.some) { ret v.some; }
    ret otherwise;
}

# instruction `ins` of space `c.space` evaluated under configuration `c`
# ---
# ret: its form, admitted when its pattern holds under `c`, or the refusal of what the evaluation cannot read
pub fun form(r: *Reader, ins: *xed.instruction.Instruction, c: Config) res[Form, diag.Refusal] {
    var f:  Form  = Form{config: c, admitted: false, eosz: 0, easz: 0, map: 0, opcode: 0, low: false, modrm: false, direct: false, digit: NO_DIGIT, memory: false, vsib: nil, element: 0, nelem: 0, vl: NO_VL, facts: vector.init[Fact](r.alloc), operands: vector.init[Operand](r.alloc), implied: vector.init[Implied](r.alloc), constant: false};
    var s:  State = State{known: map.init[str, u64](r.alloc), facts: ?f.facts};
    var ok: bool  = know(?s, "MODE", c.mode::u64) && know(?s, "OSZ", c.osz::u64) && know(?s, "REXW", c.rexw::u64) && know(?s, "REX2", c.rex2::u64) && know(?s, "ASZ", c.asz::u64) && know(?s, "VEXVALID", c.space::u64);
    # a vex, evex or xop prefix leaves no room for rex, and evex.b is the configuration's
    if (c.space != LEGACY) { ok = ok && know(?s, "REX", 0) && know(?s, "BCRC", c.bcrc::u64); }
    var k: usize = 0;
    for (k < r.knobs.len) {
        ok = ok && know(?s, r.knobs.data[k].name, r.knobs.data[k].value);
        k  = k + 1;
    }
    if (!ok) { ret res[Form, diag.Refusal].err{memory(ins.iclass)}; }
    var fx:    Effects                 = Effects{taken: vector.init[Taken](r.alloc), is4: false, constant: false};
    var spine: Effects                 = Effects{taken: vector.init[Taken](r.alloc), is4: false, constant: false};
    val sized: res[bool, diag.Refusal] = evaluate(r, OSZ, ?s, ?spine, ?ins.line);
    if (sel sized.err) { ret res[Form, diag.Refusal].err{sized.err}; }
    val addressed: res[bool, diag.Refusal] = evaluate(r, ASZ, ?s, ?spine, ?ins.line);
    if (sel addressed.err)          { ret res[Form, diag.Refusal].err{addressed.err}; }
    if (!sized.ok || !addressed.ok) { ret res[Form, diag.Refusal].ok{f}; }
    var bytes:    [4]u8;
    var count:    u32                               = 0;
    var acc:      u64                               = 0;
    var held:     u32                               = 0;
    var suffixed: bool                              = false;
    var suffix:   u8                                = 0;
    val ps:       *vector.Vector[xed.pattern.Piece] = ?ins.pattern.pieces;
    var i:        usize                             = 0;
    for (i < ps.len) {
        val p:     *xed.pattern.Piece = ?ps.data[i];
        val whole: bool               = p.kind == xed.pattern.CAPTURE && str_equals(p.name, "SRM") && p.fixed == (1::u64 << p.len::u64) - 1;
        if (p.kind == xed.pattern.BITS && f.modrm) {
            # 3dnow's opcode is the byte after ModRM and its displacement
            if (p.len != 8 || suffixed) { ret res[Form, diag.Refusal].err{lines.refuse(?ins.line, ESCAPE, ins.iclass)}; }
            suffixed = true;
            suffix   = p.value::u8;
        }
        or (p.kind == xed.pattern.BITS || (p.kind == xed.pattern.CAPTURE && str_equals(p.name, "SRM"))) {
            if (p.kind == xed.pattern.CAPTURE && !whole) {
                if (p.fixed != 0) { ret res[Form, diag.Refusal].err{lines.refuse(?ins.line, UNKNOWN, p.name)}; }
                f.low = true;
            }
            acc  = (acc << p.len::u64) | (p.value & p.fixed);
            held = held + p.len::u32;
            for (held >= 8) {
                if (count == 4) { ret res[Form, diag.Refusal].err{lines.refuse(?ins.line, ESCAPE, ins.iclass)}; }
                bytes[count] = (acc >> (held - 8)::u64)::u8;
                count        = count + 1;
                held         = held - 8;
            }
        }
        or (p.kind == xed.pattern.CAPTURE) {
            if (str_equals(p.name, "MOD")) {
                f.modrm = true;
                if (p.fixed != 0) { f.direct = p.value == 3; }
            }
            or (str_equals(p.name, "REG")) {
                f.modrm = true;
                if (p.fixed == 7) { f.digit = p.value::u8; }
                or (p.fixed != 0) { ret res[Form, diag.Refusal].err{lines.refuse(?ins.line, UNKNOWN, p.name)}; }
            }
            or (str_equals(p.name, "RM")) {
                f.modrm = true;
                # an rm XED fixes is an opcode extension, or the sib byte a memory form needs, a fact as a test is
                if (p.fixed == 7) {
                    var one: vector.Vector[xed.pattern.Piece] = vector.init[xed.pattern.Piece](r.alloc);
                    var t:   xed.pattern.Piece                = @p;
                    t.kind  = xed.pattern.TEST;
                    t.equal = true;
                    if (!pushed(vector.push[xed.pattern.Piece](?one, t))) { ret res[Form, diag.Refusal].err{memory(ins.iclass)}; }
                    val known_rm: opt[u64] = known(?s, "RM");
                    if (sel known_rm.none) {
                        val stated: err[diag.Refusal] = state_facts(r, ?one, ?s, ins.iclass);
                        if (sel stated.err) { ret res[Form, diag.Refusal].err{stated.err}; }
                    }
                }
                or (p.fixed != 0) { ret res[Form, diag.Refusal].err{lines.refuse(?ins.line, UNKNOWN, p.name)}; }
            }
            or { ret res[Form, diag.Refusal].err{lines.refuse(?ins.line, UNKNOWN, p.name)}; }
        }
        or (p.kind == xed.pattern.TEST) {
            if (skipped(r, p.name))                        {}
            or (str_equals(p.name, "MOD") && p.value == 3) { f.direct = p.equal; }
            or {
                val v: opt[u64] = known(?s, p.name);
                if (sel v.some) {
                    if (!holds(p, v.some)) { ret res[Form, diag.Refusal].ok{f}; }
                }
                or {
                    var one: vector.Vector[xed.pattern.Piece] = vector.init[xed.pattern.Piece](r.alloc);
                    if (!pushed(vector.push[xed.pattern.Piece](?one, @p))) { ret res[Form, diag.Refusal].err{memory(ins.iclass)}; }
                    val stated: err[diag.Refusal] = state_facts(r, ?one, ?s, ins.iclass);
                    if (sel stated.err) { ret res[Form, diag.Refusal].err{stated.err}; }
                }
            }
        }
        or (p.kind == xed.pattern.CALL) {
            val v: i32 = vsib_of(p.name);
            if (str_equals(p.name, MODRM)) { f.memory = true; }
            or (v >= 0) {
                f.memory = true;
                f.vsib   = name_row(r, VSIB_CLASS[v::u32]);
                if (f.vsib == nil) { ret res[Form, diag.Refusal].err{lines.refuse(?ins.line, NO_NAMED, VSIB_CLASS[v::u32])}; }
            }
            or (!inert(p.name)) {
                val got: res[bool, diag.Refusal] = evaluate(r, p.name, ?s, ?fx, ?ins.line);
                if (sel got.err) { ret res[Form, diag.Refusal].err{got.err}; }
                if (!got.ok)     { ret res[Form, diag.Refusal].ok{f}; }
            }
        }
        or { ret res[Form, diag.Refusal].err{lines.refuse(?ins.line, UNKNOWN, ins.iclass)}; }
        i = i + 1;
    }
    if (held != 0) { ret res[Form, diag.Refusal].err{lines.refuse(?ins.line, ESCAPE, ins.iclass)}; }
    var coded: err[diag.Refusal] = err[diag.Refusal].ok{};
    if (c.space == LEGACY) { coded = legacy_opcode(ins, ?bytes[0], count, suffixed, suffix, ?f); }
    or                     { coded = vex_opcode(ins, ?bytes[0], count, ?s, ?f); }
    if (sel coded.err)     { ret res[Form, diag.Refusal].err{coded.err}; }
    # a rex2 prefix reaches maps 0 and 1 alone (Intel APX 355828-009US 3.1.2.1), so a legacy form of 0f 38 or 0f 3a is
    # none under it, as crc32 reaches no r16
    if (c.space == LEGACY && c.rex2 != 0 && (f.map == 2 || f.map == 3)) { ret res[Form, diag.Refusal].ok{f}; }
    f.eosz     = known_or(?s, "EOSZ", 0)::u8;
    f.easz     = known_or(?s, "EASZ", 0)::u8;
    f.element  = known_or(?s, "ELEMENT_SIZE", 0)::u32;
    f.nelem    = known_or(?s, "NELEM", 0)::u32;
    f.vl       = known_or(?s, "VL", NO_VL::u64)::u8;
    f.constant = fx.constant;
    # the evex decoder reads map 4's pp of 01 as 66, and no other map's (Intel APX 355828-009US 3.1.4)
    if (c.space == EVEX) {
        val pp: *Fact = fact(?f, "VEX_PREFIX");
        if ((c.osz != 0) != (f.map == APX_MAP && pp != nil && pp.equal && pp.value == 1)) { ret res[Form, diag.Refusal].ok{f}; }
        # apx's nd is evex.b (Intel APX 355828-009US 3.1.2.3), which XED's EVAPX() rebinds the configuration's BCRC over
        val nd: *Fact = fact(?f, "ND");
        if (nd != nil && nd.equal && (nd.value == 1) != (c.bcrc != 0)) { ret res[Form, diag.Refusal].ok{f}; }
    }
    val ops: err[diag.Refusal] = operands_of(r, ins, ?s, ?fx, ?f);
    if (sel ops.err) { ret res[Form, diag.Refusal].err{ops.err}; }
    # a ModRM.reg the pattern captures and no operand reads, as setcc's and the reserved nops', is written 0, as the
    # SDM's /0 and llvm-mc 23.1.1 write it, and read only so, as no form bit restates another value. so is a ModRM.rm
    # of a register form no operand reads, as sfence's, which reading() reads as its opcode extension
    if (f.modrm && f.digit == NO_DIGIT) {
        var regged: bool  = false;
        var k:      usize = 0;
        for (k < f.operands.len) {
            if (f.operands.data[k].what == REGISTER && f.operands.data[k].place == REG) { regged = true; }
            k = k + 1;
        }
        if (!regged) { f.digit = 0; }
    }
    if (f.modrm && f.direct && fact(?f, "RM") == nil) {
        var rmed: bool  = false;
        var k:    usize = 0;
        for (k < f.operands.len) {
            if (f.operands.data[k].what == REGISTER && f.operands.data[k].place == RM) { rmed = true; }
            k = k + 1;
        }
        if (!rmed && !pushed(vector.push[Fact](?f.facts, Fact{name: "RM", value: 0, equal: true}))) { ret res[Form, diag.Refusal].err{memory(ins.iclass)}; }
    }
    # evex.b of a register form XED gives no rounding text, as avx10.2's bf16 conversions', is its suppression of
    # exceptions alone, `{sae}`, its last operand
    if (c.space == EVEX && c.bcrc != 0 && f.direct && fact(?f, "ND") == nil) {
        var rounded: bool  = false;
        var k:       usize = 0;
        for (k < f.operands.len) {
            if (f.operands.data[k].what == ROUNDING) { rounded = true; }
            k = k + 1;
        }
        if (!rounded) {
            var sae: Operand = blank();
            sae.what = ROUNDING;
            sae.sae  = true;
            val ps: err[diag.Refusal] = push_operand(?f, sae, ins.iclass);
            if (sel ps.err) { ret res[Form, diag.Refusal].err{ps.err}; }
        }
    }
    # a broadcast is evex.b on a memory form, so a memory operand that admits none admits no b, but where the pattern
    # tests apx's nd, evex.b is nd's (Intel APX 355828-009US 3.1.2.3), as cmovb's new data destination from memory
    if (c.bcrc != 0 && !f.direct && fact(?f, "ND") == nil) {
        var k: usize = 0;
        for (k < f.operands.len) {
            if (f.operands.data[k].what == MEMORY && !f.operands.data[k].broadcast) { ret res[Form, diag.Refusal].ok{f}; }
            k = k + 1;
        }
    }
    f.admitted = true;
    ret res[Form, diag.Refusal].ok{f};
}

pub val NO_ADDRESS: str = "ASZ_NONTERM gives the code width no address size, or no general register of it";

# the general register class of the address size code of mode `mode` takes with an address-size override (`asz` 1) or
# without, as XED's ASZ_NONTERM gives it: the class of the first general register XED states of that width
pub fun address_class(r: *Reader, mode: u8, asz: u8) res[*Named, diag.Refusal] {
    ret address_register(r, mode, asz, 0);
}

# the general register numbered `number` of the address size code of mode `mode` takes with an address-size override
# (`asz` 1) or without, as XED's ASZ_NONTERM gives it
pub fun address_register(r: *Reader, mode: u8, asz: u8, number: u32) res[*Named, diag.Refusal] {
    var facts: vector.Vector[Fact] = vector.init[Fact](r.alloc);
    var s:     State               = State{known: map.init[str, u64](r.alloc), facts: ?facts};
    if (!know(?s, "MODE", mode::u64) || !know(?s, "ASZ", asz::u64)) { ret res[*Named, diag.Refusal].err{memory(ASZ)}; }
    var fx:  Effects                 = Effects{taken: vector.init[Taken](r.alloc), is4: false, constant: false};
    var l:   lines.Line;
    val got: res[bool, diag.Refusal] = evaluate(r, ASZ, ?s, ?fx, ?l);
    if (sel got.err) { ret res[*Named, diag.Refusal].err{got.err}; }
    val easz: u64 = known_or(?s, "EASZ", 0);
    if (!got.ok || easz < 1 || easz > 3) { ret res[*Named, diag.Refusal].err{diag.refusal(nil, 0, NO_ADDRESS, ASZ)}; }
    val bits: u32                                = 8::u32 << easz::u32;
    val regs: *vector.Vector[xed.table.Register] = ?r.xed.tables.registers;
    var i:    usize                              = 0;
    for (i < regs.len) {
        val x: *xed.table.Register = ?regs.data[i];
        if (str_equals(x.class, "gpr") && x.width == bits && x.ordinal == number && !x.high) {
            val n: opt[*Named] = named(r, x.name);
            if (sel n.some) { ret res[*Named, diag.Refusal].ok{n.some}; }
        }
        i = i + 1;
    }
    ret res[*Named, diag.Refusal].err{diag.refusal(nil, 0, NO_ADDRESS, ASZ)};
}

# whether `f` needs f0, its pattern testing LOCK=1
pub fun locked(f: *Form) bool {
    val l: *Fact = fact(f, "LOCK");
    ret l != nil && l.equal && l.value == 1;
}
