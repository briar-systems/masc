# the CPUID bits Linux names, read from its x86 headers under vendor/linux-cpuid
#
# arch/x86/include/asm/cpufeature.h numbers the capability words in `enum cpuid_leafs`, each
# `CPUID_<leaf>[_<subleaf>]_<register>` for a word Linux reads from a CPUID leaf, as
# CPUID_8000_0001_EDX or CPUID_7_1_EAX, and CPUID_LNX_<n> for a word of its own, which names no
# leaf. a leaf of two parts, 8000_0001, is one number, a word naming no subleaf reads subleaf 0.
# arch/x86/include/asm/cpufeatures.h places each feature `#define X86_FEATURE_<name> ( <word>*32+<bit>)`.
# the reader holds the features of the leaf words, each at its leaf, subleaf, register and bit

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view.View;
use std.types.view.view;
use std.types.view.view_eq_str;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use gen.isa.x86.xed.text;
use gen.lines;
use gen.source;

pub val WORDS:    str = "arch/x86/include/asm/cpufeature.h";
pub val FEATURES: str = "arch/x86/include/asm/cpufeatures.h";

pub val NO_FILE:  str = "copy holds no x86 cpufeature header";
pub val NO_ENUM:  str = "cpufeature.h holds no enum cpuid_leafs";
pub val BAD_WORD: str = "capability word is not CPUID_<leaf>[_<subleaf>]_<register> or CPUID_LNX_<n>";
pub val BAD_BIT:  str = "feature is not placed as ( <word>*32+<bit>)";

# one CPUID bit Linux names
# ---
# name:    its X86_FEATURE_ name, as the header spells it
# leaf:    the CPUID leaf
# subleaf: the subleaf
# reg:     the register, lower case
# bit:     the bit
pub rec Feature {
    name:    str;
    leaf:    u64;
    subleaf: u64;
    reg:     str;
    bit:     u64;
}

# a capability word: whether it is read from a leaf, and where
rec Word {
    cpuid:   bool;
    leaf:    u64;
    subleaf: u64;
    reg:     str;
}

fun hex(v: View) opt[u64] {
    if (v.len == 0) { ret opt[u64].none{}; }
    var n: u64   = 0;
    var i: usize = 0;
    for (i < v.len) {
        val c: u8  = v.data[i];
        var d: u64 = 16;
        if (c >= '0' && c <= '9') { d = (c - '0')::u64; }
        or (c >= 'A' && c <= 'F') { d = (c - 'A')::u64 + 10; }
        or (c >= 'a' && c <= 'f') { d = (c - 'a')::u64 + 10; }
        if (d == 16)              { ret opt[u64].none{}; }
        n = n * 16 + d;
        i = i + 1;
    }
    ret opt[u64].some{n};
}

# the parts of `v` split on `_`
fun parts(a: *A.Allocator, v: View) vector.Vector[View] {
    var out:  vector.Vector[View] = vector.init[View](a);
    var from: usize               = 0;
    var i:    usize               = 0;
    for (i <= v.len) {
        if (i == v.len || v.data[i] == '_') {
            vector.push[View](?out, text.part(v, from, i - from));
            from = i + 1;
        }
        i = i + 1;
    }
    ret out;
}

# the word an enumerator `CPUID_...` names
fun word(a: *A.Allocator, l: *lines.Line, v: View) res[Word, diag.Refusal] {
    val bad: res[Word, diag.Refusal] = res[Word, diag.Refusal].err{lines.refuse(l, BAD_WORD, nil)};
    var p:   vector.Vector[View]     = parts(a, v);
    if (p.len < 3 || !view_eq_str(p.data[0], "CPUID")) { ret bad; }
    if (view_eq_str(p.data[1], "LNX"))                 { ret res[Word, diag.Refusal].ok{Word{cpuid: false, leaf: 0, subleaf: 0, reg: nil}}; }
    val reg: res[str, diag.Refusal] = text.owned(a, l, p.data[p.len - 1]);
    if (sel reg.err)                                                                                                         { ret res[Word, diag.Refusal].err{reg.err}; }
    if (!(str_equals(reg.ok, "EAX") || str_equals(reg.ok, "EBX") || str_equals(reg.ok, "ECX") || str_equals(reg.ok, "EDX"))) { ret bad; }
    var at: usize    = 2;
    val hi: opt[u64] = hex(p.data[1]);
    if (sel hi.none) { ret bad; }
    var leaf: u64 = hi.some;
    # a leaf of two four digit parts, as 8000_0001, is one number
    if (p.data[1].len == 4 && p.len > 3 && p.data[2].len == 4) {
        val lo: opt[u64] = hex(p.data[2]);
        if (sel lo.none) { ret bad; }
        leaf = leaf * 0x10000 + lo.some;
        at   = 3;
    }
    var subleaf: u64 = 0;
    if (at + 1 < p.len) {
        val s: opt[u64] = hex(p.data[at]);
        if (sel s.none) { ret bad; }
        subleaf = s.some;
        at      = at + 1;
    }
    if (at + 1 != p.len) { ret bad; }
    var lower: [4]u8                  = [4]u8{reg.ok[0] + 32, reg.ok[1] + 32, reg.ok[2] + 32, 0};
    val owned: res[str, diag.Refusal] = text.owned(a, l, view(?lower[0], 3));
    if (sel owned.err) { ret res[Word, diag.Refusal].err{owned.err}; }
    ret res[Word, diag.Refusal].ok{Word{cpuid: true, leaf: leaf, subleaf: subleaf, reg: owned.ok}};
}

# the lines of `f`, trimmed, blank ones dropped. a C header's `#` is no comment, so XED's reading does not apply
fun header(a: *A.Allocator, f: *source.File) res[vector.Vector[lines.Line], diag.Refusal] {
    var out:    vector.Vector[lines.Line] = vector.init[lines.Line](a);
    var at:     usize                     = 0;
    var number: u32                       = 0;
    for (at < f.len) {
        number = number + 1;
        var end: usize = at;
        for (end < f.len && f.data[end] != '\n') {
            end = end + 1;
        }
        val l: lines.Line = lines.Line{file: f.path, number: number, text: text.trim(view(?f.data[at], end - at))};
        at = end + 1;
        if (l.text.len == 0)                                { cnt; }
        if (!text.pushed(vector.push[lines.Line](?out, l))) { ret res[vector.Vector[lines.Line], diag.Refusal].err{diag.refusal(f.path, number, diag.MEMORY, nil)}; }
    }
    ret res[vector.Vector[lines.Line], diag.Refusal].ok{out};
}

fun file(t: *source.Tree, path: str) res[*source.File, diag.Refusal] {
    val f: opt[*source.File] = source.find(t, path);
    if (sel f.none) { ret res[*source.File, diag.Refusal].err{diag.refusal(path, 0, NO_FILE, nil)}; }
    ret res[*source.File, diag.Refusal].ok{f.some};
}

# the words of `enum cpuid_leafs`, in order
fun words(a: *A.Allocator, t: *source.Tree) res[vector.Vector[Word], diag.Refusal] {
    val f: res[*source.File, diag.Refusal] = file(t, WORDS);
    if (sel f.err) { ret res[vector.Vector[Word], diag.Refusal].err{f.err}; }
    val got: res[vector.Vector[lines.Line], diag.Refusal] = header(a, f.ok);
    if (sel got.err) { ret res[vector.Vector[Word], diag.Refusal].err{got.err}; }
    var out:  vector.Vector[Word] = vector.init[Word](a);
    var open: bool                = false;
    var seen: bool                = false;
    var i:    usize               = 0;
    for (i < got.ok.len) {
        val l: *lines.Line = ?got.ok.data[i];
        if (view_eq_str(l.text, "enum cpuid_leafs")) {
            open = true;
            seen = true;
            i    = i + 1;
            cnt;
        }
        if (open && view_eq_str(l.text, "};")) { open = false; }
        if (open && !view_eq_str(l.text, "{")) {
            var name: View       = l.text;
            val stop: opt[usize] = text.find(name, ',');
            if (sel stop.some) { name = text.part(name, 0, stop.some); }
            val eq: opt[usize] = text.find(name, '=');
            if (sel eq.some) { name = text.part(name, 0, eq.some); }
            name = text.trim(name);
            if (!view_eq_str(name, "NR_CPUID_WORDS")) {
                val w: res[Word, diag.Refusal] = word(a, l, name);
                if (sel w.err)                                   { ret res[vector.Vector[Word], diag.Refusal].err{w.err}; }
                if (!text.pushed(vector.push[Word](?out, w.ok))) { ret res[vector.Vector[Word], diag.Refusal].err{text.memory(l)}; }
            }
        }
        i = i + 1;
    }
    if (!seen) { ret res[vector.Vector[Word], diag.Refusal].err{diag.refusal(WORDS, 0, NO_ENUM, nil)}; }
    ret res[vector.Vector[Word], diag.Refusal].ok{out};
}

# the number of `v` past its leading spaces, decimal
fun decimal(v: View) opt[u64] {
    ret text.number(text.trim(v));
}

# every feature of a leaf word the copy `t` places
pub fun read(a: *A.Allocator, t: *source.Tree) res[vector.Vector[Feature], diag.Refusal] {
    val ws: res[vector.Vector[Word], diag.Refusal] = words(a, t);
    if (sel ws.err) { ret res[vector.Vector[Feature], diag.Refusal].err{ws.err}; }
    val f: res[*source.File, diag.Refusal] = file(t, FEATURES);
    if (sel f.err) { ret res[vector.Vector[Feature], diag.Refusal].err{f.err}; }
    val got: res[vector.Vector[lines.Line], diag.Refusal] = header(a, f.ok);
    if (sel got.err) { ret res[vector.Vector[Feature], diag.Refusal].err{got.err}; }
    var out: vector.Vector[Feature] = vector.init[Feature](a);
    var i:   usize                  = 0;
    for (i < got.ok.len) {
        val l: *lines.Line = ?got.ok.data[i];
        if (text.starts(l.text, "#define X86_FEATURE_")) {
            val head:  View       = text.part(l.text, 8, l.text.len - 8);
            val open:  opt[usize] = text.find(head, '(');
            val close: opt[usize] = text.find(head, ')');
            if (sel open.none)  { ret res[vector.Vector[Feature], diag.Refusal].err{lines.refuse(l, BAD_BIT, nil)}; }
            if (sel close.none) { ret res[vector.Vector[Feature], diag.Refusal].err{lines.refuse(l, BAD_BIT, nil)}; }
            val o: usize = open.some;
            val c: usize = close.some;
            if (c < o) { ret res[vector.Vector[Feature], diag.Refusal].err{lines.refuse(l, BAD_BIT, nil)}; }
            val inside: View       = text.part(head, o + 1, c - o - 1);
            val star:   opt[usize] = text.find(inside, '*');
            val plus:   opt[usize] = text.find(inside, '+');
            if (sel star.none) { ret res[vector.Vector[Feature], diag.Refusal].err{lines.refuse(l, BAD_BIT, nil)}; }
            if (sel plus.none) { ret res[vector.Vector[Feature], diag.Refusal].err{lines.refuse(l, BAD_BIT, nil)}; }
            val s: usize = star.some;
            val p: usize = plus.some;
            if (p < s || !view_eq_str(text.trim(text.part(inside, s + 1, p - s - 1)), "32")) { ret res[vector.Vector[Feature], diag.Refusal].err{lines.refuse(l, BAD_BIT, nil)}; }
            val wn: opt[u64] = decimal(text.part(inside, 0, s));
            val bn: opt[u64] = decimal(text.part(inside, p + 1, inside.len - p - 1));
            if (sel wn.none) { ret res[vector.Vector[Feature], diag.Refusal].err{lines.refuse(l, BAD_BIT, nil)}; }
            if (sel bn.none) { ret res[vector.Vector[Feature], diag.Refusal].err{lines.refuse(l, BAD_BIT, nil)}; }
            val w: u64 = wn.some;
            val b: u64 = bn.some;
            if (b >= 32) { ret res[vector.Vector[Feature], diag.Refusal].err{lines.refuse(l, BAD_BIT, nil)}; }
            if (w < ws.ok.len::u64 && ws.ok.data[w].cpuid) {
                val name: res[str, diag.Refusal] = text.owned(a, l, text.trim(text.part(head, 0, o)));
                if (sel name.err) { ret res[vector.Vector[Feature], diag.Refusal].err{name.err}; }
                val at:   *Word   = ?ws.ok.data[w];
                val made: Feature = Feature{name: name.ok, leaf: at.leaf, subleaf: at.subleaf, reg: at.reg, bit: b};
                if (!text.pushed(vector.push[Feature](?out, made))) { ret res[vector.Vector[Feature], diag.Refusal].err{text.memory(l)}; }
            }
        }
        i = i + 1;
    }
    ret res[vector.Vector[Feature], diag.Refusal].ok{out};
}

# the feature named `name`, none when no leaf word places it
pub fun find(all: *vector.Vector[Feature], name: str) opt[*Feature] {
    var i: usize = 0;
    for (i < all.len) {
        if (str_equals(all.data[i].name, name)) { ret opt[*Feature].some{?all.data[i]}; }
        i = i + 1;
    }
    ret opt[*Feature].none{};
}
