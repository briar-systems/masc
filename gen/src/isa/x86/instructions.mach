# the xed generator: the x86 instruction tables generated from the XED copy
#
# it reads the XED copy into the model and works out what every ISA set XED names requires, in
# its cpuid files or as the ISA_SET of an instruction: any one of its cpuid groups, each a
# conjunction of the atoms its cpuid names stand for, kept as XED states them, nothing dropped for
# another implying it, and nothing for a set whose every line is `n/a`. it then builds the rows
# from the model and writes the x86 tables (`masc.isa.x86.gen_row` and those beside it), each row
# requiring its ISA set's requirement.
#
# what XED does not state is masc's, in two cited topics of gen/data/x86:
#   cpuid-names  the atom a cpuid name stands for where it is not the name of a row of the
#                catalog, as ospku is pku and intel64 width=64
#   isa-sets     the requirement of a set XED gives no cpuid group: `none`, or `requires=<atom>`,
#                with the CPUID bit enumerating it as `leaf= subleaf= reg= bit=`, and `llvm=<bit_ name>`
#                where clang's cpuid.h under vendor/llvm-cpuid names it, which holds the bit to it
# a cpuid name that names no atom, a set XED gives no group and no fact answers, and a fact on a
# name or set XED does not have, are refused, so a new XED revision cannot be read past them. a
# fact the copy states otherwise is held to it by the overlay's own check
#
# atoms are named by the catalog's own records

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_starts_with;
use std.types.string.str_to_upper;

use A: std.allocator;
use std.collections.map;
use std.collections.sort;
use std.collections.vector;

use gen.catalog;
use gen.diag;
use gen.isa.x86;
use gen.isa.x86.forms;
use gen.isa.x86.keys;
use gen.isa.x86.llvm;
use gen.isa.x86.rows;
use gen.isa.x86.tables;
use gen.isa.x86.xed;
use gen.overlay;
use gen.set;
use xed_cpuid: gen.isa.x86.xed.cpuid;

pub val NAMES_TOPIC: str = "cpuid-names";
pub val SETS_TOPIC:  str = "isa-sets";

pub val NO_INPUTS:  str = "xed generator reads the x86 catalog, the x86 overlay, clang's cpuid.h and the x86 register families beside XED";
pub val NO_ATOM:    str = "cpuid name or fact names no row or state value of the x86 catalog";
pub val UNANSWERED: str = "ISA set has no cpuid group and no fact";
pub val NOT_NAMED:  str = "fact is on a cpuid name or ISA set XED does not have";
pub val BAD_FACT:   str = "fact is not `none` or `requires=<atom>`, with `leaf= subleaf= reg= bit=` stating a CPUID bit whole and an optional `llvm=`";
pub val NO_FEATURE: str = "fact names a constant clang's cpuid.h does not place under a heading";
pub val MISPLACED:  str = "fact states a CPUID bit other than where clang's cpuid.h places the constant it names";

# what the generator reads, and what the stated callbacks look in
rec Reading {
    alloc:    *A.Allocator;
    xed:      *xed.Xed;
    atoms:    map.Map[str, u32];
    names:    map.Map[str, u32];
    sets:     map.Map[str, u32];
    features: vector.Vector[llvm.Feature];
}

# one set's requirement, each alternative the atoms it holds
rec Need {
    name:         str;
    alternatives: vector.Vector[vector.Vector[str]];
}

fun memory(subject: str) diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, subject);
}

fun atom(r: *Reading, name: str) bool {
    ret map.contains[str, u32](?r.atoms, ?name);
}

# what XED states a cpuid name stands for: the row of its own name, when the catalog has one
fun name_stated(ctx: ptr, f: *overlay.Fact) opt[str] {
    val r: *Reading = ctx::*Reading;
    if (atom(r, f.key)) { ret opt[str].some{f.key}; }
    ret opt[str].none{};
}

# a set's cpuid groups as XED states them, the names of a group joined by `&` and the groups by `;`, `none` for `n/a`
fun spelled(a: *A.Allocator, s: *xed_cpuid.Set) opt[str] {
    if (s.groups.len == 0) { ret opt[str].some{"none"}; }
    var out: str   = "";
    var g:   usize = 0;
    for (g < s.groups.len) {
        if (g > 0) {
            val j: res[str, StrError] = str_join(a, out, ";");
            if (sel j.err) { ret opt[str].none{}; }
            out = j.ok;
        }
        var k: usize = 0;
        for (k < s.groups.data[g].bits.len) {
            if (k > 0) {
                val j: res[str, StrError] = str_join(a, out, "&");
                if (sel j.err) { ret opt[str].none{}; }
                out = j.ok;
            }
            val j: res[str, StrError] = str_join(a, out, s.groups.data[g].bits.data[k]);
            if (sel j.err) { ret opt[str].none{}; }
            out = j.ok;
            k   = k + 1;
        }
        g = g + 1;
    }
    ret opt[str].some{out};
}

# what XED states a set requires: its groups, or none for `n/a`, nothing for a set no cpuid file names
fun set_stated(ctx: ptr, f: *overlay.Fact) opt[str] {
    val r: *Reading            = ctx::*Reading;
    val s: opt[*xed_cpuid.Set] = xed_cpuid.find(?r.xed.cpuid, f.key);
    if (sel s.none) { ret opt[str].none{}; }
    ret spelled(r.alloc, s.some);
}

fun upper(a: *A.Allocator, s: str) res[str, diag.Refusal] {
    val u: res[str, StrError] = str_to_upper(a, s);
    if (sel u.err) { ret res[str, diag.Refusal].err{memory(s)}; }
    ret res[str, diag.Refusal].ok{u.ok};
}

fun note(m: *map.Map[str, u32], name: str) err[diag.Refusal] {
    if (map.contains[str, u32](m, ?name)) { ret err[diag.Refusal].ok{}; }
    val put: res[bool, A.Error] = map.insert[str, u32](m, name, 0);
    if (sel put.err) { ret err[diag.Refusal].err{memory(name)}; }
    ret err[diag.Refusal].ok{};
}

# every ISA set the model names, in upper case, sorted and once each
fun names(r: *Reading) res[vector.Vector[str], diag.Refusal] {
    val x:   *xed.Xed           = r.xed;
    var out: vector.Vector[str] = vector.init[str](r.alloc);
    var i:   usize              = 0;
    for (i < x.cpuid.sets.len + x.instructions.len) {
        var name: str = nil;
        if (i < x.cpuid.sets.len) { name = x.cpuid.sets.data[i].name; }
        or {
            val u: res[str, diag.Refusal] = upper(r.alloc, x.instructions.data[i - x.cpuid.sets.len].isa_set);
            if (sel u.err) { ret res[vector.Vector[str], diag.Refusal].err{u.err}; }
            name = u.ok;
        }
        if (!map.contains[str, u32](?r.sets, ?name)) {
            val noted: err[diag.Refusal] = note(?r.sets, name);
            if (sel noted.err) { ret res[vector.Vector[str], diag.Refusal].err{noted.err}; }
            val pushed: res[usize, A.Error] = vector.push[str](?out, name);
            if (sel pushed.err) { ret res[vector.Vector[str], diag.Refusal].err{memory(name)}; }
        }
        i = i + 1;
    }
    sort.sort_by[str](out.data, out.len, str_order);
    ret res[vector.Vector[str], diag.Refusal].ok{out};
}

fun str_order(x: *str, y: *str) i64 {
    ret str_compare(@x, @y);
}

# the fact of `topic` on `key`, nil when it has none
fun fact(t: *overlay.Topic, key: str) *overlay.Fact {
    var i: usize = 0;
    for (i < t.facts.len) {
        if (str_equals(t.facts.data[i].key, key)) { ret ?t.facts.data[i]; }
        i = i + 1;
    }
    ret nil;
}

# every fact of `t` is on a key `known` holds
fun named(t: *overlay.Topic, known: *map.Map[str, u32]) err[diag.Refusal] {
    var i: usize = 0;
    for (i < t.facts.len) {
        val f: *overlay.Fact = ?t.facts.data[i];
        if (!map.contains[str, u32](known, ?f.key)) { ret err[diag.Refusal].err{overlay.refuse(f, NOT_NAMED, f.key)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the atom cpuid name `name` stands for
fun stands(r: *Reading, t: *overlay.Topic, name: str) opt[str] {
    val f: *overlay.Fact = fact(t, name);
    if (f != nil)      { ret opt[str].some{f.fact}; }
    if (atom(r, name)) { ret opt[str].some{name}; }
    ret opt[str].none{};
}

fun holds(x: *vector.Vector[str], s: str) bool {
    var i: usize = 0;
    for (i < x.len) {
        if (str_equals(x.data[i], s)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun same(x: *vector.Vector[str], y: *vector.Vector[str]) bool {
    if (x.len != y.len) { ret false; }
    var i: usize = 0;
    for (i < x.len) {
        if (!holds(y, x.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the CPUID bit fact `f` states, when it states one: a bit is stated whole, leaf, subleaf, register and bit, and
# held to the constant `llvm=` names in clang's cpuid.h. a bit with no `llvm=` is held to its cite alone
fun placement(r: *Reading, f: *overlay.Fact, ws: *vector.Vector[str]) err[diag.Refusal] {
    val named:  opt[str] = overlay.value(ws, "llvm");
    val fields: [4]str   = [4]str{"leaf", "subleaf", "reg", "bit"};
    var given:  u32      = 0;
    var k:      u32      = 0;
    for (k < 4) {
        val v: opt[str] = overlay.value(ws, fields[k]);
        if (sel v.some) { given = given + 1; }
        k = k + 1;
    }
    if (given == 0) {
        if (sel named.some) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
        ret err[diag.Refusal].ok{};
    }
    if (given != 4) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    val reg: opt[str] = overlay.value(ws, "reg");
    if (sel reg.none)                                                                                                                { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    if (!(str_equals(reg.some, "eax") || str_equals(reg.some, "ebx") || str_equals(reg.some, "ecx") || str_equals(reg.some, "edx"))) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, reg.some)}; }
    var got:  [3]u64 = [3]u64{0, 0, 0};
    val nums: [3]str = [3]str{"leaf", "subleaf", "bit"};
    k = 0;
    for (k < 3) {
        val v: opt[str] = overlay.value(ws, nums[k]);
        if (sel v.none) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
        val n: res[i64, diag.Refusal] = overlay.number(f, v.some);
        if (sel n.err) { ret err[diag.Refusal].err{n.err}; }
        if (n.ok < 0)  { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, v.some)}; }
        got[k] = n.ok::u64;
        k      = k + 1;
    }
    if (sel named.none) { ret err[diag.Refusal].ok{}; }
    val found: opt[*llvm.Feature] = llvm.find(?r.features, named.some);
    if (sel found.none) { ret err[diag.Refusal].err{overlay.refuse(f, NO_FEATURE, named.some)}; }
    val at: *llvm.Feature = found.some;
    if (!str_equals(reg.some, at.reg) || got[0] != at.leaf || got[1] != at.subleaf || got[2] != at.bit) { ret err[diag.Refusal].err{overlay.refuse(f, MISPLACED, named.some)}; }
    ret err[diag.Refusal].ok{};
}

# the requirement fact `f` states: no alternative for `none`, one of its atom for `requires=`
fun answer(r: *Reading, f: *overlay.Fact, n: *Need) err[diag.Refusal] {
    val got: res[vector.Vector[str], diag.Refusal] = overlay.words(r.alloc, f, f.fact);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var ws: vector.Vector[str] = got.ok;
    if (ws.len == 1 && str_equals(ws.data[0], "none")) { ret err[diag.Refusal].ok{}; }
    val req: opt[str] = overlay.value(?ws, "requires");
    if (sel req.none)       { ret err[diag.Refusal].err{overlay.refuse(f, BAD_FACT, f.key)}; }
    if (!atom(r, req.some)) { ret err[diag.Refusal].err{overlay.refuse(f, NO_ATOM, req.some)}; }
    val keys: [6]str = [6]str{"requires=", "llvm=", "leaf=", "subleaf=", "reg=", "bit="};
    var i:    usize  = 0;
    for (i < ws.len) {
        var known: bool = false;
        var k:     u32  = 0;
        for (k < 6) {
            if (str_starts_with(ws.data[i], keys[k])) { known = true; }
            k = k + 1;
        }
        if (!known) { ret err[diag.Refusal].err{overlay.refuse(f, overlay.UNKNOWN_WORD, ws.data[i])}; }
        i = i + 1;
    }
    val placed: err[diag.Refusal] = placement(r, f, ?ws);
    if (sel placed.err) { ret placed; }
    var ids: vector.Vector[str]  = vector.init[str](r.alloc);
    val one: res[usize, A.Error] = vector.push[str](?ids, req.some);
    if (sel one.err) { ret err[diag.Refusal].err{memory(f.key)}; }
    val alt: res[usize, A.Error] = vector.push[vector.Vector[str]](?n.alternatives, ids);
    if (sel alt.err) { ret err[diag.Refusal].err{memory(f.key)}; }
    ret err[diag.Refusal].ok{};
}

# the requirement of `name`, from its fact, or else its cpuid groups as XED states them
fun need(r: *Reading, names_topic: *overlay.Topic, sets_topic: *overlay.Topic, name: str) res[Need, diag.Refusal] {
    var n: Need          = Need{name: name, alternatives: vector.init[vector.Vector[str]](r.alloc)};
    val f: *overlay.Fact = fact(sets_topic, name);
    if (f != nil) {
        val answered: err[diag.Refusal] = answer(r, f, ?n);
        if (sel answered.err) { ret res[Need, diag.Refusal].err{answered.err}; }
        ret res[Need, diag.Refusal].ok{n};
    }
    val found: opt[*xed_cpuid.Set] = xed_cpuid.find(?r.xed.cpuid, name);
    if (sel found.none) { ret res[Need, diag.Refusal].err{diag.refusal(nil, 0, UNANSWERED, name)}; }
    val s: *xed_cpuid.Set = found.some;
    var g: usize          = 0;
    for (g < s.groups.len) {
        val group: *xed_cpuid.Group   = ?s.groups.data[g];
        var ids:   vector.Vector[str] = vector.init[str](r.alloc);
        var k:     usize              = 0;
        for (k < group.bits.len) {
            val bit: str      = group.bits.data[k];
            val to:  opt[str] = stands(r, names_topic, bit);
            if (sel to.none) { ret res[Need, diag.Refusal].err{diag.refusal(group.line.file, group.line.number, NO_ATOM, bit)}; }
            # an enable bit stands for the row of its feature, so a group may name one atom twice
            if (!holds(?ids, to.some)) {
                val pushed: res[usize, A.Error] = vector.push[str](?ids, to.some);
                if (sel pushed.err) { ret res[Need, diag.Refusal].err{memory(name)}; }
            }
            k = k + 1;
        }
        var twice: bool  = false;
        var j:     usize = 0;
        for (j < n.alternatives.len) {
            if (same(?ids, ?n.alternatives.data[j])) { twice = true; }
            j = j + 1;
        }
        if (!twice) {
            val pushed: res[usize, A.Error] = vector.push[vector.Vector[str]](?n.alternatives, ids);
            if (sel pushed.err) { ret res[Need, diag.Refusal].err{memory(name)}; }
        }
        g = g + 1;
    }
    ret res[Need, diag.Refusal].ok{n};
}

# the xed generator: the XED copy read into the model, the requirement of each ISA set worked out over the catalog's
# atoms and the overlay's facts, the overlay's CPUID bits held to clang's cpuid.h, and the instruction tables written,
# its inputs in that order
pub fun generate(c: *set.Context) err[diag.Refusal] {
    if (c.inputs.len != 4) { ret err[diag.Refusal].err{diag.refusal(nil, 0, NO_INPUTS, nil)}; }
    val bits: res[vector.Vector[llvm.Feature], diag.Refusal] = llvm.read(c.alloc, c.inputs.data[2]);
    if (sel bits.err) { ret err[diag.Refusal].err{bits.err}; }
    val read: res[xed.Xed, diag.Refusal] = xed.read(c.alloc, c.tree);
    if (sel read.err) { ret err[diag.Refusal].err{read.err}; }
    var x:      xed.Xed            = read.ok;
    var atoms:  vector.Vector[str] = vector.init[str](c.alloc);
    val listed: err[diag.Refusal]  = catalog.atom_names(c.alloc, c.inputs.data[0], ?atoms);
    if (sel listed.err) { ret listed; }
    var r: Reading = Reading{alloc: c.alloc, xed: ?x, atoms: map.init[str, u32](c.alloc), names: map.init[str, u32](c.alloc), sets: map.init[str, u32](c.alloc), features: bits.ok};
    var i: usize   = 0;
    for (i < atoms.len) {
        val noted: err[diag.Refusal] = note(?r.atoms, atoms.data[i]);
        if (sel noted.err) { ret noted; }
        i = i + 1;
    }
    i = 0;
    for (i < x.cpuid.bits.len) {
        val noted: err[diag.Refusal] = note(?r.names, x.cpuid.bits.data[i].name);
        if (sel noted.err) { ret noted; }
        i = i + 1;
    }
    val all: res[vector.Vector[str], diag.Refusal] = names(?r);
    if (sel all.err) { ret err[diag.Refusal].err{all.err}; }
    val nt: res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], NAMES_TOPIC);
    if (sel nt.err) { ret err[diag.Refusal].err{nt.err}; }
    var names_topic: overlay.Topic                    = nt.ok;
    val st:          res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], SETS_TOPIC);
    if (sel st.err) { ret err[diag.Refusal].err{st.err}; }
    var sets_topic: overlay.Topic     = st.ok;
    val n1:         err[diag.Refusal] = named(?names_topic, ?r.names);
    if (sel n1.err) { ret n1; }
    val n2: err[diag.Refusal] = named(?sets_topic, ?r.sets);
    if (sel n2.err) { ret n2; }
    val c1: err[diag.Refusal] = overlay.check(?names_topic, ?r, name_stated);
    if (sel c1.err) { ret c1; }
    val c2: err[diag.Refusal] = overlay.check(?sets_topic, ?r, set_stated);
    if (sel c2.err) { ret c2; }
    i = 0;
    for (i < names_topic.facts.len) {
        val f: *overlay.Fact = ?names_topic.facts.data[i];
        if (!atom(?r, f.fact)) { ret err[diag.Refusal].err{overlay.refuse(f, NO_ATOM, f.fact)}; }
        i = i + 1;
    }
    var needs: vector.Vector[Need] = vector.init[Need](c.alloc);
    i = 0;
    for (i < all.ok.len) {
        val n: res[Need, diag.Refusal] = need(?r, ?names_topic, ?sets_topic, all.ok.data[i]);
        if (sel n.err) { ret err[diag.Refusal].err{n.err}; }
        val pushed: res[usize, A.Error] = vector.push[Need](?needs, n.ok);
        if (sel pushed.err) { ret err[diag.Refusal].err{memory(all.ok.data[i])}; }
        i = i + 1;
    }
    ret instructions(c, ?x, ?r, ?needs);
}

# the rows of the slice and their tables, over the register file the x86 register families state, each row requiring
# its ISA set's requirement
fun instructions(c: *set.Context, x: *xed.Xed, r: *Reading, needs: *vector.Vector[Need]) err[diag.Refusal] {
    val got: res[vector.Vector[x86.Named], diag.Refusal] = x86.named_rows(c.alloc, c.inputs.data[3], c.inputs.data[0]);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var named: vector.Vector[forms.Named] = vector.init[forms.Named](c.alloc);
    var first: map.Map[str, u32]          = map.init[str, u32](c.alloc);
    var i:     usize                      = 0;
    for (i < got.ok.len) {
        val n:     *x86.Named = ?got.ok.data[i];
        var order: u32        = i::u32;
        val known: opt[*u32]  = map.get[str, u32](?first, ?n.class);
        if (sel known.some) { order = @known.some; }
        or {
            val put_in: res[bool, A.Error] = map.insert[str, u32](?first, n.class, i::u32);
            if (sel put_in.err) { ret err[diag.Refusal].err{memory(n.name)}; }
        }
        val pushed: res[usize, A.Error] = vector.push[forms.Named](?named, forms.Named{name: n.name, class: n.class, order: order, number: n.number, row: i::u32, unspelled: n.unspelled, members: n.members, fixed: n.fixed});
        if (sel pushed.err) { ret err[diag.Refusal].err{memory(n.name)}; }
        i = i + 1;
    }
    var reader: forms.Reader                     = forms.reader(c.alloc, x, ?named);
    val rt:     res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], forms.REGISTERS_TOPIC);
    if (sel rt.err) { ret err[diag.Refusal].err{rt.err}; }
    var registers_topic: overlay.Topic     = rt.ok;
    val aliased:         err[diag.Refusal] = forms.aliases(?reader, ?registers_topic);
    if (sel aliased.err) { ret aliased; }
    val kn: res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], forms.KNOBS_TOPIC);
    if (sel kn.err) { ret err[diag.Refusal].err{kn.err}; }
    var knobs_topic: overlay.Topic     = kn.ok;
    val knobbed:     err[diag.Refusal] = forms.knobs(?reader, ?knobs_topic);
    if (sel knobbed.err) { ret knobbed; }
    val mt: res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], rows.MNEMONICS_TOPIC);
    if (sel mt.err) { ret err[diag.Refusal].err{mt.err}; }
    var spelled_topic: overlay.Topic                    = mt.ok;
    val ot:            res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], rows.OPERANDS_TOPIC);
    if (sel ot.err) { ret err[diag.Refusal].err{ot.err}; }
    var operands_topic: overlay.Topic                    = ot.ok;
    val it:             res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], rows.IMMEDIATES_TOPIC);
    if (sel it.err) { ret err[diag.Refusal].err{it.err}; }
    var immediates_topic: overlay.Topic                    = it.ok;
    val dt:               res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], rows.DECODED_TOPIC);
    if (sel dt.err) { ret err[diag.Refusal].err{dt.err}; }
    var decoded_topic: overlay.Topic                    = dt.ok;
    val st:            res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], rows.DISTINCT_TOPIC);
    if (sel st.err) { ret err[diag.Refusal].err{st.err}; }
    var distinct_topic: overlay.Topic                    = st.ok;
    val tt:             res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], rows.TARGETS_TOPIC);
    if (sel tt.err) { ret err[diag.Refusal].err{tt.err}; }
    var targets_topic: overlay.Topic                    = tt.ok;
    val yt:            res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], rows.YIELDS_TOPIC);
    if (sel yt.err) { ret err[diag.Refusal].err{yt.err}; }
    var yields_topic: overlay.Topic                    = yt.ok;
    val ct:           res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], rows.CT_TOPIC);
    if (sel ct.err) { ret err[diag.Refusal].err{ct.err}; }
    var ct_topic: overlay.Topic                    = ct.ok;
    val et:       res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], rows.EFFECTS_TOPIC);
    if (sel et.err) { ret err[diag.Refusal].err{et.err}; }
    var effects_topic: overlay.Topic            = et.ok;
    var built:         vector.Vector[*rows.Row] = vector.init[*rows.Row](c.alloc);
    val respelled:     rows.Topics              = rows.Topics{mnemonics: ?spelled_topic, operands: ?operands_topic, immediates: ?immediates_topic, decoded: ?decoded_topic, distinct: ?distinct_topic, targets: ?targets_topic, yields: ?yields_topic, ct: ?ct_topic, effects: ?effects_topic};
    val made:          err[diag.Refusal]        = rows.build(c.alloc, ?reader, respelled, ?built);
    if (sel made.err) { ret made; }
    val kt: res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], keys.TOPIC);
    if (sel kt.err) { ret err[diag.Refusal].err{kt.err}; }
    var keys_topic: overlay.Topic     = kt.ok;
    var ks:         keys.Keys;
    val keyed:      err[diag.Refusal] = keys.read(c.alloc, ?keys_topic, ?ks);
    if (sel keyed.err) { ret keyed; }
    val vt: res[overlay.Topic, diag.Refusal] = overlay.read(c.alloc, c.inputs.data[1], tables.INVERSES_TOPIC);
    if (sel vt.err) { ret err[diag.Refusal].err{vt.err}; }
    var inverses_topic: overlay.Topic = vt.ok;
    var in:             tables.Input  = tables.Input{rows: ?built, needs: map.init[str, *vector.Vector[vector.Vector[str]]](c.alloc), named: ?named, reader: ?reader, atoms: r.atoms, counts: map.init[str, u32](c.alloc), keys: ?ks, inverses: ?inverses_topic};
    i = 0;
    for (i < needs.len) {
        val put_in: res[bool, A.Error] = map.insert[str, *vector.Vector[vector.Vector[str]]](?in.needs, needs.data[i].name, ?needs.data[i].alternatives);
        if (sel put_in.err) { ret err[diag.Refusal].err{memory(needs.data[i].name)}; }
        i = i + 1;
    }
    ret tables.generate(c, ?in);
}
