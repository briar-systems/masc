# the CPUID bits clang names, read from its cpuid.h under vendor/llvm-cpuid
#
# cpuid.h groups its feature constants under headings `/* Features in %<reg> for leaf <n> */`, a
# heading of a subleaf other than 0 adding ` sub-leaf <m>`, the leaf written in C as decimal or
# `0x` hex. each constant below a heading is `#define bit_<name> <mask>`, the mask of one bit of
# that register, or the name of a constant above it, as bit_LZCNT is bit_ABM. the reader holds
# every constant at the leaf, subleaf and register of its heading and the bit of its mask

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view.View;
use std.types.view.view;
use std.types.view.view_eq_str;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use gen.isa.x86.xed.text;
use gen.lines;
use gen.source;

pub val HEADER: str = "cpuid.h";

pub val NO_FILE:     str = "copy holds no cpuid.h";
pub val BAD_HEADING: str = "heading is not `/* Features in %<reg> for leaf <n> [sub-leaf <m>] */`";
pub val NO_HEADING:  str = "feature constant lies under no heading";
pub val BAD_MASK:    str = "feature constant is not one bit's mask or the name of a constant above it";

# one CPUID bit clang names
# ---
# name:    its bit_ name, as the header spells it
# leaf:    the CPUID leaf
# subleaf: the subleaf
# reg:     the register, lower case
# bit:     the bit
pub rec Feature {
    name:    str;
    leaf:    u64;
    subleaf: u64;
    reg:     str;
    bit:     u64;
}

# the heading the constants below it lie under
rec Heading {
    seen:    bool;
    leaf:    u64;
    subleaf: u64;
    reg:     str;
}

# the lines of `f`, trimmed, blank ones dropped. C's comments are what the reader reads, so none is stripped
fun header(a: *A.Allocator, f: *source.File) res[vector.Vector[lines.Line], diag.Refusal] {
    var out:    vector.Vector[lines.Line] = vector.init[lines.Line](a);
    var at:     usize                     = 0;
    var number: u32                       = 0;
    for (at < f.len) {
        number = number + 1;
        var end: usize = at;
        for (end < f.len && f.data[end] != '\n') {
            end = end + 1;
        }
        val l: lines.Line = lines.Line{file: f.path, number: number, text: text.trim(view(?f.data[at], end - at))};
        at = end + 1;
        if (l.text.len == 0)                                { cnt; }
        if (!text.pushed(vector.push[lines.Line](?out, l))) { ret res[vector.Vector[lines.Line], diag.Refusal].err{diag.refusal(f.path, number, diag.MEMORY, nil)}; }
    }
    ret res[vector.Vector[lines.Line], diag.Refusal].ok{out};
}

# the heading on `l`, its tokens `t`
fun heading(a: *A.Allocator, l: *lines.Line, t: *vector.Vector[View]) res[Heading, diag.Refusal] {
    val bad: res[Heading, diag.Refusal] = res[Heading, diag.Refusal].err{lines.refuse(l, BAD_HEADING, nil)};
    if (t.len != 8 && t.len != 10)                                         { ret bad; }
    if (!view_eq_str(t.data[4], "for") || !view_eq_str(t.data[5], "leaf")) { ret bad; }
    if (!view_eq_str(t.data[t.len - 1], "*/"))                             { ret bad; }
    if (t.len == 10 && !view_eq_str(t.data[7], "sub-leaf"))                { ret bad; }
    val r: View = t.data[3];
    if (r.len != 4 || r.data[0] != '%' || r.data[1] != 'e' || r.data[3] != 'x')          { ret bad; }
    if (!(r.data[2] == 'a' || r.data[2] == 'b' || r.data[2] == 'c' || r.data[2] == 'd')) { ret bad; }
    val leaf: opt[u64] = text.number(t.data[6]);
    if (sel leaf.none) { ret bad; }
    var subleaf: u64 = 0;
    if (t.len == 10) {
        val s: opt[u64] = text.number(t.data[8]);
        if (sel s.none) { ret bad; }
        subleaf = s.some;
    }
    val reg: res[str, diag.Refusal] = text.owned(a, l, text.part(r, 1, 3));
    if (sel reg.err) { ret res[Heading, diag.Refusal].err{reg.err}; }
    ret res[Heading, diag.Refusal].ok{Heading{seen: true, leaf: leaf.some, subleaf: subleaf, reg: reg.ok}};
}

# the bit a one-bit mask sets
fun single(mask: u64) opt[u64] {
    if (mask == 0 || mask > 0xFFFFFFFF || (mask & (mask - 1)) != 0) { ret opt[u64].none{}; }
    var b: u64 = 0;
    for ((mask >> b) != 1) {
        b = b + 1;
    }
    ret opt[u64].some{b};
}

# the feature `#define` line `l` places under `h`, its tokens `t`, a named mask read from those above it in `out`
fun constant(a: *A.Allocator, l: *lines.Line, t: *vector.Vector[View], h: *Heading, out: *vector.Vector[Feature]) res[Feature, diag.Refusal] {
    if (!h.seen) { ret res[Feature, diag.Refusal].err{lines.refuse(l, NO_HEADING, nil)}; }
    val bad: res[Feature, diag.Refusal] = res[Feature, diag.Refusal].err{lines.refuse(l, BAD_MASK, nil)};
    if (t.len < 3)                                  { ret bad; }
    if (t.len > 3 && !text.starts(t.data[3], "/*")) { ret bad; }
    val name: res[str, diag.Refusal] = text.owned(a, l, t.data[1]);
    if (sel name.err) { ret res[Feature, diag.Refusal].err{name.err}; }
    if (text.starts(t.data[2], "bit_")) {
        val target: res[str, diag.Refusal] = text.owned(a, l, t.data[2]);
        if (sel target.err) { ret res[Feature, diag.Refusal].err{target.err}; }
        val found: opt[*Feature] = find(out, target.ok);
        if (sel found.none) { ret bad; }
        val at: *Feature = found.some;
        ret res[Feature, diag.Refusal].ok{Feature{name: name.ok, leaf: at.leaf, subleaf: at.subleaf, reg: at.reg, bit: at.bit}};
    }
    val mask: opt[u64] = text.number(t.data[2]);
    if (sel mask.none) { ret bad; }
    val bit: opt[u64] = single(mask.some);
    if (sel bit.none) { ret bad; }
    ret res[Feature, diag.Refusal].ok{Feature{name: name.ok, leaf: h.leaf, subleaf: h.subleaf, reg: h.reg, bit: bit.some}};
}

# every feature constant the copy `t` places
pub fun read(a: *A.Allocator, t: *source.Tree) res[vector.Vector[Feature], diag.Refusal] {
    val f: opt[*source.File] = source.find(t, HEADER);
    if (sel f.none) { ret res[vector.Vector[Feature], diag.Refusal].err{diag.refusal(HEADER, 0, NO_FILE, nil)}; }
    val got: res[vector.Vector[lines.Line], diag.Refusal] = header(a, f.some);
    if (sel got.err) { ret res[vector.Vector[Feature], diag.Refusal].err{got.err}; }
    var out: vector.Vector[Feature] = vector.init[Feature](a);
    var h:   Heading                = Heading{seen: false, leaf: 0, subleaf: 0, reg: nil};
    var i:   usize                  = 0;
    for (i < got.ok.len) {
        val l:      *lines.Line = ?got.ok.data[i];
        val opened: bool        = text.starts(l.text, "/* Features in ");
        val placed: bool        = text.starts(l.text, "#define bit_");
        i = i + 1;
        if (!opened && !placed) { cnt; }
        val toks: res[vector.Vector[View], diag.Refusal] = lines.tokens(a, l);
        if (sel toks.err) { ret res[vector.Vector[Feature], diag.Refusal].err{toks.err}; }
        var t: vector.Vector[View] = toks.ok;
        if (opened) {
            val next: res[Heading, diag.Refusal] = heading(a, l, ?t);
            if (sel next.err) { ret res[vector.Vector[Feature], diag.Refusal].err{next.err}; }
            h = next.ok;
            cnt;
        }
        val made: res[Feature, diag.Refusal] = constant(a, l, ?t, ?h, ?out);
        if (sel made.err)                                      { ret res[vector.Vector[Feature], diag.Refusal].err{made.err}; }
        if (!text.pushed(vector.push[Feature](?out, made.ok))) { ret res[vector.Vector[Feature], diag.Refusal].err{text.memory(l)}; }
    }
    ret res[vector.Vector[Feature], diag.Refusal].ok{out};
}

# the feature named `name`, none when no heading places it
pub fun find(all: *vector.Vector[Feature], name: str) opt[*Feature] {
    var i: usize = 0;
    for (i < all.len) {
        if (str_equals(all.data[i].name, name)) { ret opt[*Feature].some{?all.data[i]}; }
        i = i + 1;
    }
    ret opt[*Feature].none{};
}
