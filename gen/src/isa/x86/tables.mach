# the x86 rows written as masc's tables: gen_row, gen_row_index, gen_operand, gen_encoding, gen_effect, gen_dispatch,
# gen_key, gen_relax and gen_syntax. the rows and their requirements are gen_row's, and the pools they point into are modules of
# their own, the operands with their classes, the fields with their opcode records, and the effects, so no one object
# holds the whole catalog and mach builds each apart (mach#4763, mach#4764)
#
# a row's fields all point at its opcode record (masc.isa.x86.opcode.Opcode): the head kind's prefixes, rex or rex2
# and opcode, ModRM's or an a0 to a3 move's address, and a unit per immediate or target. a register operand takes the
# whole of its classes but the numbers its nonterminal never yields, as mov's segment register excludes cs, and an
# operand no field encodes, as add's al, is its register's whole class held to the register by the effect's fixed
# operands. a memory operand's base and index are the classes of the address sizes its width reaches, its own first,
# as XED's ASZ_NONTERM gives them, the index never number 4, which SIB reads as none (Intel SDM 325462-093US Vol 2A
# Table 2-3), and its displacement 32 bits whose readings the ModRM kind holds to the address size. a row requires its
# ISA set's requirement at its width.
#
# the effect states what XED's flags and suppressed operands do: the flags tested, modified, set, cleared or left
# undefined, the stack pointer and the push or pop of the stack, the instruction pointer of a branch, and the
# transfer of its category. the dispatch is the row's configurations as cubes over the keys, an opcode holding a
# register in its low bits a cube per register, and the syntax spells each row as llvm-objdump 23.1.1's Intel syntax
# does: its mnemonic and its operands comma separated, in XED's order but where the operands topic states another,
# evex's opmask and `{z}` decorating the operand before them. a jump with an 8-bit target relaxes to its instruction's
# wider target.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use std.collections.map;
use std.collections.sort;
use std.collections.vector;

use masc.core.operand;
use x86_opcode: masc.isa.x86.opcode;

use gen.diag;
use gen.dispatch;
use gen.emit;
use gen.isa.x86.forms;
use gen.isa.x86.keys;
use gen.isa.x86.rows;
use gen.isa.x86.xed;
use gen.lines;
use gen.set;

pub val NO_ATOM:      str = "row requires an atom the x86 catalog does not name";
pub val NO_SPELL:     str = "XED flag action is not one the effect reads";
pub val NO_STACK:     str = "the code width's stack pointer is no row of masc's x86 register file";
pub val NO_FLAG:      str = "XED flag names no flag row of masc's x86 register file";
pub val NO_STRING:    str = "string memory operand states no one base class or no segment";
pub val TWO_LONGER:   str = "two rows of a jump's instruction have its longer target at one width";
pub val NO_PREDICATE: str = "comparison row has no predicate immediate or its mnemonic does not start with its stem";

# what the emission reads
# ---
# rows:  the rows, in order
# needs: each ISA set's requirement, by its name
# named: the register file's rows
# atoms: the atoms the catalog names
pub rec Input {
    rows:   *vector.Vector[*rows.Row];
    needs:  map.Map[str, *vector.Vector[vector.Vector[str]]];
    named:  *vector.Vector[forms.Named];
    reader: *forms.Reader;
    atoms:  map.Map[str, u32];
    counts: map.Map[str, u32];
    keys:   *keys.Keys;
}

# the pools of the row table
rec Pools {
    f:       *emit.File;
    classes: emit.Pool;
    numbers: emit.Pool;
    ids:     emit.Pool;
    alts:    emit.Pool;
    ops:     emit.Pool;
    slices:  emit.Pool;
    words:   emit.Pool;
    access:  emit.Pool;
    fixed:   emit.Pool;
    effects: emit.Pool;
    opcodes: *emit.Array;
    fields:  emit.Pool;
    table:   *emit.Array;
}

fun memory(subject: str) diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, subject);
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun number(n: i64) emit.Value {
    ret emit.Value.number{n};
}

fun name(s: str) emit.Value {
    ret emit.Value.name{s};
}

fun rec_value(r: *emit.Record) emit.Value {
    ret emit.Value.record{r};
}

fun variant(f: *emit.File, of: str, v: emit.Value) emit.Value {
    ret emit.Value.variant{emit.variant(f, of, v)};
}

fun bare(f: *emit.File, of: str) emit.Value {
    ret emit.Value.variant{emit.bare(f, of)};
}

fun span(f: *emit.File, of: str, array: str, at: u32, count: u32) emit.Value {
    val r: *emit.Record = emit.record(f, of);
    emit.member(f, r, "at", emit.element(f, array, at));
    emit.member(f, r, "len", number(count::i64));
    ret rec_value(r);
}

fun span_or(f: *emit.File, of: str, empty: str, array: str, at: u32, count: u32) emit.Value {
    if (count == 0) { ret name(empty); }
    ret span(f, of, array, at, count);
}

fun index(op: u8) emit.Value {
    if (op == 0xFF) { ret name("field.NO_OPERAND"); }
    ret number(op::i64);
}

fun role(r: operand.Role) emit.Value {
    if (r == operand.READ)       { ret name("operand.READ"); }
    if (r == operand.WRITE)      { ret name("operand.WRITE"); }
    if (r == operand.READ_WRITE) { ret name("operand.READ_WRITE"); }
    ret name("operand.NONE");
}

# the class constant of class `class`, as gen_register.GPR8_CLASS
fun class_name(f: *emit.File, class: str) emit.Value {
    ret name(emit.concat(f, "gen_register.", emit.concat(f, emit.ident(f, class), "_CLASS")));
}

# a run of the classes named `cs` in CLASSES, at most 3
fun classes_of(p: *Pools, cs: *str, count: u8) emit.Value {
    var items: [3]emit.Value;
    var k:     u8 = 0;
    for (k < count) {
        items[k] = class_name(p.f, cs[k]);
        k        = k + 1;
    }
    ret span(p.f, "operand.Classes", "CLASSES", emit.pooled(p.f, ?p.classes, ?items[0], count::u32), count::u32);
}

# a run of numbers in NUMBERS, or NO_NUMBERS
fun numbers_of(p: *Pools, a: *A.Allocator, ns: *vector.Vector[u32]) emit.Value {
    if (ns.len == 0) { ret name("operand.NO_NUMBERS"); }
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](a);
    var i:     usize                     = 0;
    for (i < ns.len) {
        vector.push[emit.Value](?items, number(ns.data[i]::i64));
        i = i + 1;
    }
    ret span(p.f, "operand.Numbers", "NUMBERS", emit.pooled(p.f, ?p.numbers, items.data, items.len::u32), items.len::u32);
}

# how many registers class `class` holds, its highest number and one
fun class_count(in: *Input, class: str) u32 {
    val got: opt[*u32] = map.get[str, u32](?in.counts, ?class);
    if (sel got.none) { ret 0; }
    ret @got.some;
}

# a register operand over the classes named `cs`, the `admitted` numbers from 0, 0 for every one, excluding `excluded`
fun register_value(p: *Pools, cs: *str, count: u8, admitted: u32, excluded: emit.Value) emit.Value {
    val f: *emit.File   = p.f;
    val r: *emit.Record = emit.record(f, "operand.Register");
    emit.member(f, r, "classes", classes_of(p, cs, count));
    emit.member(f, r, "first", number(0));
    emit.member(f, r, "count", number(admitted::i64));
    emit.member(f, r, "excluded", excluded);
    emit.member(f, r, "fields", number(1));
    emit.member(f, r, "element", bare(f, "operand.Element.none"));
    emit.member(f, r, "span", variant(f, "operand.Span.fixed", number(0)));
    ret rec_value(r);
}

fun no_register(f: *emit.File) emit.Value {
    val none: *emit.Record = emit.record(f, "operand.Classes");
    emit.member(f, none, "at", name("nil"));
    emit.member(f, none, "len", number(0));
    val r: *emit.Record = emit.record(f, "operand.Register");
    emit.member(f, r, "classes", rec_value(none));
    emit.member(f, r, "first", number(0));
    emit.member(f, r, "count", number(0));
    emit.member(f, r, "excluded", name("operand.NO_NUMBERS"));
    emit.member(f, r, "fields", number(1));
    emit.member(f, r, "element", bare(f, "operand.Element.none"));
    emit.member(f, r, "span", variant(f, "operand.Span.fixed", number(0)));
    ret rec_value(r);
}

fun immediate(f: *emit.File, bits: u8, sign: str, extends: u8, fixup: str) emit.Value {
    val r: *emit.Record = emit.record(f, "operand.Immediate");
    emit.member(f, r, "bits", number(bits::i64));
    emit.member(f, r, "sign", name(sign));
    emit.member(f, r, "extends", number(extends::i64));
    emit.member(f, r, "scale", number(0));
    emit.member(f, r, "bias", number(0));
    emit.member(f, r, "fixup", name(fixup));
    emit.member(f, r, "format", name("operand.INTEGER"));
    emit.member(f, r, "excluded", name("operand.NO_INTEGERS"));
    ret rec_value(r);
}

# the absolute fixup kind of a field of `bits` bits, ABS32S where 64-bit code sign-extends it
fun absolute(bits: u8, extended: bool) str {
    if (bits == 8)  { ret "x86_fixup.ABS8"; }
    if (bits == 16) { ret "x86_fixup.ABS16"; }
    if (bits == 64) { ret "x86_fixup.ABS64"; }
    if (extended)   { ret "x86_fixup.ABS32S"; }
    ret "x86_fixup.ABS32";
}

fun relative(bits: u8) str {
    if (bits == 8)  { ret "x86_fixup.PC8"; }
    if (bits == 16) { ret "x86_fixup.PC16"; }
    ret "x86_fixup.PC32";
}

# the immediate of operand `o` of `r`: a sign-extended immediate narrower than the operation admits either reading at
# the operation's width and decodes signed, one that reads unsigned (`rows.reads_unsigned`) either reading at its own
# and decodes unsigned, and any other immediate of a width of its own, as add's imm8 of `IMM0:r:b:i8`, either reading
# at its width, decoding signed, as llvm-objdump 23.1.1 prints them
fun immediate_of(f: *emit.File, r: *rows.Row, o: *forms.Operand) emit.Value {
    val bits: u8 = o.taken.bits;
    val op:   u8 = rows.operation_bits(r);
    # vpermil2ps's 4 bits beside is4's register are a selector no relocation reaches
    if (bits < 8)                    { ret immediate(f, bits, "operand.UNSIGNED", 0, "operand.NO_FIXUP"); }
    if (o.taken.signed && bits < op) { ret immediate(f, bits, "operand.SIGNED", op, absolute(bits, op == 64)); }
    if (rows.reads_unsigned(r, o))   { ret immediate(f, bits, "operand.EITHER", 0, absolute(bits, false)); }
    ret immediate(f, bits, "operand.SIGNED", bits, absolute(bits, false));
}

# the general register classes of the address sizes the modes of `modes` reach, the first mode's own first, then its
# override's, then the others, as XED's ASZ_NONTERM gives them, into `out`
# ---
# ret: how many there are, at most 3
fun address_classes(in: *Input, modes: u8, out: *str) res[u8, diag.Refusal] {
    var count: u8 = 0;
    var mode:  u8 = rows.first_mode(modes);
    var left:  u8 = modes;
    for (left != 0) {
        if (((left >> mode) & 1) != 0) {
            var asz: u8 = 0;
            for (asz < 2) {
                val got: res[*forms.Named, diag.Refusal] = forms.address_class(in.reader, mode, asz);
                if (sel got.err) { ret res[u8, diag.Refusal].err{got.err}; }
                var seen: bool = false;
                var k:    u8   = 0;
                for (k < count) {
                    if (str_equals(out[k], got.ok.class)) { seen = true; }
                    k = k + 1;
                }
                if (!seen) {
                    out[count] = got.ok.class;
                    count      = count + 1;
                }
                asz = asz + 1;
            }
            left = left & ~(1::u8 << mode);
        }
        mode = (mode + 1) % 3;
    }
    ret res[u8, diag.Refusal].ok{count};
}

# the general register class of address size `address`, as masc.isa.x86.opcode.Address numbers it: the class code of
# the width of that address size forms without an override
fun sized_class(in: *Input, address: u8) res[str, diag.Refusal] {
    val got: res[*forms.Named, diag.Refusal] = forms.address_class(in.reader, address - 1, 0);
    if (sel got.err) { ret res[str, diag.Refusal].err{got.err}; }
    ret res[str, diag.Refusal].ok{got.ok.class};
}

# the base classes of a memory operand of `r`: the class of the row's address size where it states one, else the
# classes of every address size its modes reach
fun base_classes(in: *Input, r: *rows.Row, out: *str) res[u8, diag.Refusal] {
    if (r.address != x86_opcode.NO_ADDRESS) {
        val got: res[str, diag.Refusal] = sized_class(in, r.address);
        if (sel got.err) { ret res[u8, diag.Refusal].err{got.err}; }
        out[0] = got.ok;
        ret res[u8, diag.Refusal].ok{1};
    }
    ret address_classes(in, r.modes, out);
}

# whether `r` is one in 64-bit code
fun wide(r: *rows.Row) bool {
    ret (r.modes & 4) != 0;
}

# the segment registers' class
fun segment_class(in: *Input) res[str, diag.Refusal] {
    val segs: opt[*forms.Named] = forms.named(in.reader, "ES");
    if (sel segs.none) { ret res[str, diag.Refusal].err{diag.refusal(nil, 0, forms.NO_NAMED, "ES")}; }
    ret res[str, diag.Refusal].ok{segs.some.class};
}

# a register operand of class `class` admitting number `n` alone
fun one_register(p: *Pools, class: str, n: u32) emit.Value {
    var cs: [1]str       = [1]str{class};
    val f:  *emit.File   = p.f;
    val r:  *emit.Record = emit.record(f, "operand.Register");
    emit.member(f, r, "classes", classes_of(p, ?cs[0], 1));
    emit.member(f, r, "first", number(n::i64));
    emit.member(f, r, "count", number(1));
    emit.member(f, r, "excluded", name("operand.NO_NUMBERS"));
    emit.member(f, r, "fields", number(1));
    emit.member(f, r, "element", bare(f, "operand.Element.none"));
    emit.member(f, r, "span", variant(f, "operand.Span.fixed", number(0)));
    ret rec_value(r);
}

# the number of the one register bit set in `numbers` holds
fun only(numbers: u64) u32 {
    var n: u32 = 0;
    for (n < 64 && ((numbers >> n::u64) & 1) == 0) { n = n + 1; }
    ret n;
}

# the broadcasts of a memory operand of `r` that admits one: bit n where 2^n of its element fill the vector length
fun broadcasts_of(r: *rows.Row, o: *forms.Operand) u8 {
    if (!o.broadcast || r.form.element == 0 || r.reading.length > x86_opcode.L512) { ret 0; }
    val n: u8 = 4 + r.reading.length - log2(r.form.element / 8);
    if (n >= 8) { ret 0; }
    ret 1::u8 << n;
}

# the power of two `v` is, 0 for 0 or 1
fun log2(v: u32) u8 {
    var n: u8  = 0;
    var x: u32 = v;
    for (x > 1) {
        x = x >> 1;
        n = n + 1;
    }
    ret n;
}

# the memory operand of `r`: ModRM's addressing, by a general index or a vector one, an address with no segment where
# `agen`, an a0 to a3 move's absolute address, or a string instruction's memory at its one register of the row's
# address size, in es where no prefix overrides it
fun memory_shape(p: *Pools, in: *Input, a: *A.Allocator, r: *rows.Row, o: *forms.Operand) res[emit.Value, diag.Refusal] {
    val f:   *emit.File             = p.f;
    val m:   *emit.Record           = emit.record(f, "operand.Memory");
    val seg: res[str, diag.Refusal] = segment_class(in);
    if (sel seg.err) { ret res[emit.Value, diag.Refusal].err{seg.err}; }
    var segs: [1]str = [1]str{seg.ok};
    if (o.what == forms.MOFFS) {
        emit.member(f, m, "base", no_register(f));
        emit.member(f, m, "index", no_register(f));
        emit.member(f, m, "segment", register_value(p, ?segs[0], 1, 0, name("operand.NO_NUMBERS")));
        emit.member(f, m, "scales", number(0));
        var bits: u8 = 32;
        if (wide(r)) { bits = 64; }
        emit.member(f, m, "disp", immediate(f, bits, "operand.EITHER", 0, absolute(o.taken.bits, false)));
        emit.member(f, m, "forms", name("operand.ABSOLUTE"));
        emit.member(f, m, "anchor", name("operand.UNSTATED"));
        ret res[emit.Value, diag.Refusal].ok{variant(f, "operand.Shape.memory", rec_value(m))};
    }
    if (o.what == forms.STRING) {
        if (o.fixed == nil || o.count != 1) { ret res[emit.Value, diag.Refusal].err{lines.refuse(?r.ins.line, NO_STRING, r.ins.iclass)}; }
        emit.member(f, m, "base", one_register(p, o.classes[0].class, only(o.numbers)));
        emit.member(f, m, "index", no_register(f));
        if (o.overrides) { emit.member(f, m, "segment", register_value(p, ?segs[0], 1, 0, name("operand.NO_NUMBERS"))); }
        or               { emit.member(f, m, "segment", one_register(p, seg.ok, o.fixed.number)); }
        emit.member(f, m, "scales", number(0));
        emit.member(f, m, "disp", immediate(f, 0, "operand.SIGNED", 0, "operand.NO_FIXUP"));
        emit.member(f, m, "forms", name("operand.ABSOLUTE"));
        emit.member(f, m, "anchor", name("operand.UNSTATED"));
        ret res[emit.Value, diag.Refusal].ok{variant(f, "operand.Shape.memory", rec_value(m))};
    }
    var cs:  [3]str;
    val got: res[u8, diag.Refusal] = base_classes(in, r, ?cs[0]);
    if (sel got.err) { ret res[emit.Value, diag.Refusal].err{got.err}; }
    emit.member(f, m, "base", register_value(p, ?cs[0], got.ok, 0, name("operand.NO_NUMBERS")));
    if (o.index != nil) {
        # a vector index reaches 32 registers through evex.v', 16 through vex.x
        var vs:    [1]str = [1]str{o.index.class};
        var reach: u32    = 0;
        if (r.space != forms.EVEX) { reach = 16; }
        emit.member(f, m, "index", register_value(p, ?vs[0], 1, reach, name("operand.NO_NUMBERS")));
    }
    or {
        # SIB's index 4 reads as none (Intel SDM 325462-093US Vol 2A Table 2-3)
        var four: vector.Vector[u32] = vector.init[u32](a);
        vector.push[u32](?four, 4);
        emit.member(f, m, "index", register_value(p, ?cs[0], got.ok, 0, numbers_of(p, a, ?four)));
    }
    if (o.what == forms.AGEN) { emit.member(f, m, "segment", no_register(f)); }
    or                        { emit.member(f, m, "segment", register_value(p, ?segs[0], 1, 0, name("operand.NO_NUMBERS"))); }
    emit.member(f, m, "scales", emit.Value.hex{0xF});
    # a symbolic displacement admits a symbol at the 32-bit absolute kind every width's address may take, and the
    # ModRM kind gives it the kind of the address it encodes at, pc-relative for rip, sign-extended under 64-bit
    # addressing, 16-bit under 16-bit addressing (masc.isa.x86.field disp_fixup)
    emit.member(f, m, "disp", immediate(f, 32, "operand.SIGNED", 32, "x86_fixup.ABS32"));
    if (wide(r)) {
        emit.member(f, m, "forms", name("operand.ABSOLUTE | operand.PCREL"));
        emit.member(f, m, "anchor", name("operand.END"));
    }
    or {
        emit.member(f, m, "forms", name("operand.ABSOLUTE"));
        emit.member(f, m, "anchor", name("operand.UNSTATED"));
    }
    val b: u8 = broadcasts_of(r, o);
    if (b != 0) { emit.member(f, m, "broadcasts", emit.Value.hex{b::u64}); }
    ret res[emit.Value, diag.Refusal].ok{variant(f, "operand.Shape.memory", rec_value(m))};
}

# the enumerant shape of gen_operand's enumeration `id`: its members `<id>_MEMBERS` and names `<id>_NAMES`
fun enumeration(f: *emit.File, id: str, count: u32, mask: bool) emit.Value {
    val r: *emit.Record = emit.record(f, "operand.Enumeration");
    emit.member(f, r, "members", emit.element(f, emit.concat(f, id, "_MEMBERS"), 0));
    emit.member(f, r, "count", number(count::i64));
    if (mask) { emit.member(f, r, "mask", name("true")); }
    or        { emit.member(f, r, "mask", name("false")); }
    emit.member(f, r, "names", span(f, "index.Index", emit.concat(f, id, "_NAMES"), 0, count));
    ret variant(f, "operand.Shape.enumerant", rec_value(r));
}

# the shape of operand `o` of `r`
fun shape(p: *Pools, in: *Input, a: *A.Allocator, r: *rows.Row, o: *forms.Operand) res[emit.Value, diag.Refusal] {
    val f: *emit.File = p.f;
    if (o.what == forms.REGISTER) {
        if (o.place == forms.FIXED) {
            var cs: [1]str = [1]str{o.fixed.class};
            ret res[emit.Value, diag.Refusal].ok{variant(f, "operand.Shape.register", register_value(p, ?cs[0], 1, 0, name("operand.NO_NUMBERS")))};
        }
        var most: u32 = 0;
        var k:    u8  = 0;
        for (k < o.count) {
            val n: u32 = class_count(in, o.classes[k].class);
            if (n > most) { most = n; }
            k = k + 1;
        }
        # the numbers end at the highest the row reaches, as vex's 16 of the 32 vector registers, and those below it
        # it does not reach are excluded
        var top: u32 = 0;
        var n:   u32 = 0;
        for (n < most && n < 64) {
            if (((o.numbers >> n::u64) & 1) != 0) { top = n + 1; }
            n = n + 1;
        }
        var admitted: u32 = 0;
        if (top < most) { admitted = top; }
        var excluded: vector.Vector[u32] = vector.init[u32](a);
        n = 0;
        for (n < top) {
            # an opmask's k0 is its absence, no masking
            val absent: bool = o.place == forms.MASK && n == 0;
            if (absent || ((o.numbers >> n::u64) & 1) == 0) { vector.push[u32](?excluded, n); }
            n = n + 1;
        }
        var cs: [2]str = [2]str{o.classes[0].class, nil};
        if (o.count == 2) { cs[1] = o.classes[1].class; }
        ret res[emit.Value, diag.Refusal].ok{variant(f, "operand.Shape.register", register_value(p, ?cs[0], o.count, admitted, numbers_of(p, a, ?excluded)))};
    }
    if (o.what == forms.MEMORY || o.what == forms.AGEN || o.what == forms.MOFFS || o.what == forms.STRING) { ret memory_shape(p, in, a, r, o); }
    if (o.what == forms.IMM)                                                                               { ret res[emit.Value, diag.Refusal].ok{variant(f, "operand.Shape.immediate", immediate_of(f, r, o))}; }
    if (o.what == forms.POINTER)                                                                           { ret res[emit.Value, diag.Refusal].ok{variant(f, "operand.Shape.immediate", immediate(f, o.taken.bits, "operand.EITHER", 0, absolute(o.taken.bits, false)))}; }
    if (o.what == forms.ZEROING)                                                                           { ret res[emit.Value, diag.Refusal].ok{enumeration(f, "ZEROING", 1, false)}; }
    if (o.what == forms.DFV)                                                                               { ret res[emit.Value, diag.Refusal].ok{enumeration(f, "DFV", 5, true)}; }
    if (o.what == forms.ROUNDING) {
        if (o.sae) { ret res[emit.Value, diag.Refusal].ok{enumeration(f, "SAE", 1, false)}; }
        ret res[emit.Value, diag.Refusal].ok{enumeration(f, "ROUNDING", 4, false)};
    }
    val rel: *emit.Record = emit.record(f, "operand.Relative");
    emit.member(f, rel, "offset", immediate(f, o.taken.bits, "operand.SIGNED", 0, relative(o.taken.bits)));
    emit.member(f, rel, "anchor", name("operand.END"));
    ret res[emit.Value, diag.Refusal].ok{variant(f, "operand.Shape.relative", rec_value(rel))};
}

# how many of an operand's values `o` of `r` takes: an opmask k1 to k7 that an absent one leaves unmasked, and `{z}`,
# are optional
fun quantity_of(o: *forms.Operand) str {
    if (optional(o)) { ret "operand.OPTIONAL"; }
    ret "operand.ONE";
}

fun optional(o: *forms.Operand) bool {
    ret (o.what == forms.REGISTER && o.place == forms.MASK && (o.numbers & 1) != 0) || o.what == forms.ZEROING;
}

# a set of register rows as words in WORDS, or NO_WORDS when it holds none
fun set_value(p: *Pools, a: *A.Allocator, in: *Input, rs: *vector.Vector[u32]) emit.Value {
    if (rs.len == 0) { ret name("effect.NO_WORDS"); }
    val count: usize              = (in.named.len + 63) / 64;
    var words: vector.Vector[u64] = vector.init[u64](a);
    var k:     usize              = 0;
    for (k < count) {
        vector.push[u64](?words, 0);
        k = k + 1;
    }
    var top: usize = 0;
    var i:   usize = 0;
    for (i < rs.len) {
        val r: u32 = rs.data[i];
        words.data[r / 64] = words.data[r / 64] | (1::u64 << (r % 64)::u64);
        if (r::usize / 64 + 1 > top) { top = r::usize / 64 + 1; }
        i = i + 1;
    }
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](a);
    k = 0;
    for (k < top) {
        vector.push[emit.Value](?items, emit.Value.hex{words.data[k]});
        k = k + 1;
    }
    val r: *emit.Record = emit.record(p.f, "effect.Set");
    emit.member(p.f, r, "words", emit.element(p.f, "WORDS", emit.pooled(p.f, ?p.words, items.data, top::u32)));
    emit.member(p.f, r, "len", number(top::i64));
    ret rec_value(r);
}

fun touched(p: *Pools, a: *A.Allocator, in: *Input, read: *vector.Vector[u32], written: *vector.Vector[u32]) emit.Value {
    if (read.len == 0 && written.len == 0) { ret name("effect.NO_TOUCHED"); }
    val r: *emit.Record = emit.record(p.f, "effect.Touched");
    emit.member(p.f, r, "read", set_value(p, a, in, read));
    emit.member(p.f, r, "written", set_value(p, a, in, written));
    ret rec_value(r);
}

fun add_row(v: *vector.Vector[u32], row: u32) {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == row) { ret; }
        i = i + 1;
    }
    vector.push[u32](v, row);
}

# the stack pointer of code of mode `mode`: sp, esp or rsp, the general register of the width's own address size,
# number 4
fun stack_pointer(in: *Input, mode: u8) res[*forms.Named, diag.Refusal] {
    val cls: res[*forms.Named, diag.Refusal] = forms.address_class(in.reader, mode, 0);
    if (sel cls.err) { ret cls; }
    var i: usize = 0;
    for (i < in.named.len) {
        val n: *forms.Named = ?in.named.data[i];
        if (str_equals(n.class, cls.ok.class) && n.number == 4) { ret res[*forms.Named, diag.Refusal].ok{n}; }
        i = i + 1;
    }
    ret res[*forms.Named, diag.Refusal].err{diag.refusal(nil, 0, NO_STACK, cls.ok.class)};
}

# the row of XED's flag `flag`: an rflags flag by its name, or the x87 condition code fcN, which is fsw's cN (XED
# datafiles/xed-flags.txt, Intel SDM 325462-093US Vol. 1 8.1.3)
fun flag_row(f: *emit.File, in: *Input, flag: str) opt[*forms.Named] {
    if (str_len(flag) == 3 && flag[0] == 'f' && flag[1] == 'c') { ret forms.named(in.reader, emit.concat(f, "fsw.c", ?flag[2])); }
    ret forms.named(in.reader, emit.concat(f, "RFLAGS.", flag));
}

# the flag rows XED's flags of `ins` read, write and leave undefined, and the ones some operand values keep: a list
# under MAY, and one of the counts no immediate of 1 gives, IMMx, which a count of 0 is, a shift by which affects no
# flag (Intel SDM 325462-093US Vol. 2B SAL/SAR/SHL/SHR, RCL/RCR/ROL/ROR). the lists of one instruction under IMM0, IMM1,
# IMMx, REP and NOREP are the effects of some operand values each, so a flag one writes and another leaves undefined is
# in both. pop and ah write a flag from the stack and from ah
fun flags_of(p: *Pools, a: *A.Allocator, in: *Input, ins: *xed.instruction.Instruction) res[emit.Value, diag.Refusal] {
    var read:      vector.Vector[u32] = vector.init[u32](a);
    var written:   vector.Vector[u32] = vector.init[u32](a);
    var undefined: vector.Vector[u32] = vector.init[u32](a);
    var kept:      vector.Vector[u32] = vector.init[u32](a);
    var i:         usize              = 0;
    for (i < ins.flags.len) {
        val list: *xed.instruction.Flags = ?ins.flags.data[i];
        val q:    str                    = list.qualifier;
        if (q != nil && !str_equals(q, "IMM0") && !str_equals(q, "IMM1") && !str_equals(q, "IMMx") && !str_equals(q, "REP") && !str_equals(q, "NOREP")) { ret res[emit.Value, diag.Refusal].err{diag.refusal(ins.line.file, ins.line.number, NO_SPELL, q)}; }
        val may: bool  = str_equals(list.semantics, "MAY") || (q != nil && str_equals(q, "IMMx"));
        var k:   usize = 0;
        for (k < list.actions.len) {
            val act: *xed.instruction.FlagAction = ?list.actions.data[k];
            val n:   opt[*forms.Named]           = flag_row(p.f, in, act.flag);
            if (sel n.none) { ret res[emit.Value, diag.Refusal].err{diag.refusal(ins.line.file, ins.line.number, NO_FLAG, act.flag)}; }
            val row: u32 = n.some.row;
            val how: str = act.action;
            if (str_equals(how, "tst"))                                                                                                    { add_row(?read, row); }
            or (str_equals(how, "mod") || str_equals(how, "0") || str_equals(how, "1") || str_equals(how, "pop") || str_equals(how, "ah")) { add_row(?written, row); }
            or (str_equals(how, "u"))                                                                                                      { add_row(?undefined, row); }
            or                                                                                                                             { ret res[emit.Value, diag.Refusal].err{diag.refusal(ins.line.file, ins.line.number, NO_SPELL, how)}; }
            if (may && !str_equals(how, "tst"))                                                                                            { add_row(?kept, row); }
            k = k + 1;
        }
        i = i + 1;
    }
    val r: *emit.Record = emit.record(p.f, "effect.Flags");
    emit.member(p.f, r, "read", set_value(p, a, in, ?read));
    emit.member(p.f, r, "written", set_value(p, a, in, ?written));
    emit.member(p.f, r, "undefined", set_value(p, a, in, ?undefined));
    emit.member(p.f, r, "kept", set_value(p, a, in, ?kept));
    ret res[emit.Value, diag.Refusal].ok{rec_value(r)};
}

# the operand of `r` of kind `what`, field.NO_OPERAND for none
fun operand_of(r: *rows.Row, what: forms.What) u8 {
    var i: usize = 0;
    for (i < r.form.operands.len) {
        if (r.form.operands.data[i].what == what) { ret i::u8; }
        i = i + 1;
    }
    ret 0xFF;
}

# the operand of `r` placed at `place`, field.NO_OPERAND for none
fun placed(r: *rows.Row, place: forms.Place) u8 {
    var i: usize = 0;
    for (i < r.form.operands.len) {
        val o: *forms.Operand = ?r.form.operands.data[i];
        if (o.what == forms.REGISTER && o.place == place) { ret i::u8; }
        i = i + 1;
    }
    ret 0xFF;
}

# the transfer of `r` by its category: a conditional branch jumps or falls through, a call and an unconditional branch go
# to the target an operand holds, relative, a far pointer or in a register or memory, or to none an operand holds, and
# a return to the address its caller left
fun control_of(p: *Pools, r: *rows.Row) emit.Value {
    val f:        *emit.File   = p.f;
    val c:        *emit.Record = emit.record(f, "effect.Control");
    val cat:      str          = r.ins.category;
    var transfer: str          = "effect.NONE";
    var target:   str          = "effect.UNTARGETED";
    var cond:     bool         = false;
    var op:       u8           = 0xFF;
    if (str_equals(cat, "COND_BR") || str_equals(cat, "UNCOND_BR") || str_equals(cat, "CALL")) {
        transfer = "effect.JUMP";
        if (str_equals(cat, "CALL")) { transfer = "effect.CALL"; }
        cond = str_equals(cat, "COND_BR");
        op   = operand_of(r, forms.RELATIVE);
        if (op == 0xFF) { op = operand_of(r, forms.POINTER); }
        if (op != 0xFF) { target = "effect.DIRECT"; }
        # a register or memory operand holds the target of an indirect one, and a branch of neither goes where the
        # processor keeps, as xend's to its transaction's fallback
        or (r.form.operands.len > 0 && (r.form.operands.data[0].what == forms.REGISTER || r.form.operands.data[0].what == forms.MEMORY)) {
            target = "effect.INDIRECT";
            op     = 0;
        }
    }
    or (str_equals(cat, "RET")) { transfer = "effect.RETURN"; }
    emit.member(f, c, "transfer", name(transfer));
    emit.member(f, c, "target", name(target));
    if (cond) { emit.member(f, c, "conditional", name("true")); }
    or        { emit.member(f, c, "conditional", name("false")); }
    emit.member(f, c, "operand", index(op));
    emit.member(f, c, "rules", name("effect.NO_RULES"));
    ret rec_value(c);
}

# the index in EFFECTS of `r`'s effect
fun effect_of(p: *Pools, a: *A.Allocator, in: *Input, r: *rows.Row) res[u32, diag.Refusal] {
    val f:       *emit.File                = p.f;
    var read:    vector.Vector[u32]        = vector.init[u32](a);
    var written: vector.Vector[u32]        = vector.init[u32](a);
    var access:  vector.Vector[emit.Value] = vector.init[emit.Value](a);
    var delta:   i32                       = 0;
    var stacked: bool                      = false;
    var i:       usize                     = 0;
    for (i < r.form.implied.len) {
        val m:   *forms.Implied = ?r.form.implied.data[i];
        var row: *forms.Named   = m.register;
        if (row == nil) {
            val sp: res[*forms.Named, diag.Refusal] = stack_pointer(in, rows.first_mode(r.modes));
            if (sel sp.err) { ret res[u32, diag.Refusal].err{sp.err}; }
            row     = sp.ok;
            stacked = true;
            val bytes: i32 = (m.width / 8)::i32;
            if (m.push) { delta = delta - bytes; }
            or          { delta = delta + bytes; }
            val w: *emit.Record = emit.record(f, "effect.Width");
            val q: *emit.Record = emit.record(f, "quantity.Scaled");
            emit.member(f, q, "fixed", number(m.width::i64));
            emit.member(f, q, "per", number(0));
            emit.member(f, q, "scale", number(0));
            emit.member(f, w, "element", rec_value(q));
            emit.member(f, w, "count", bare(f, "effect.Count.one"));
            val x: *emit.Record = emit.record(f, "effect.Access");
            if (m.push) { emit.member(f, x, "role", name("operand.WRITE")); }
            or          { emit.member(f, x, "role", name("operand.READ")); }
            emit.member(f, x, "operand", name("field.NO_OPERAND"));
            emit.member(f, x, "base", number(row.row::i64));
            emit.member(f, x, "forming", emit.Value.hex{0});
            emit.member(f, x, "width", rec_value(w));
            emit.member(f, x, "governor", name("field.NO_OPERAND"));
            vector.push[emit.Value](?access, rec_value(x));
            add_row(?read, row.row);
            add_row(?written, row.row);
        }
        or {
            if ((m.role & operand.READ) != 0)  { add_row(?read, row.row); }
            if ((m.role & operand.WRITE) != 0) { add_row(?written, row.row); }
        }
        i = i + 1;
    }
    val implicit: *emit.Record = emit.record(f, "effect.Ruled");
    val own:      emit.Value   = touched(p, a, in, ?read, ?written);
    emit.member(f, implicit, "otherwise", own);
    emit.member(f, implicit, "rules", name("effect.NO_REGISTER_RULES"));
    emit.member(f, implicit, "may", own);
    emit.member(f, implicit, "must", own);
    val flags: res[emit.Value, diag.Refusal] = flags_of(p, a, in, r.ins);
    if (sel flags.err) { ret res[u32, diag.Refusal].err{flags.err}; }
    var mem: emit.Value = name("effect.NO_ACCESSES");
    if (access.len > 0) { mem = span(f, "effect.Accesses", "ACCESSES", emit.pooled(f, ?p.access, access.data, access.len::u32), access.len::u32); }
    var stack: emit.Value = bare(f, "effect.Stack.none");
    if (stacked) {
        val d: *emit.Record = emit.record(f, "effect.Delta");
        emit.member(f, d, "bytes", number(delta::i64));
        # a return releases its immediate's bytes more (Intel SDM 325462-093US Vol 2A RET)
        if (str_equals(r.ins.category, "RET")) { emit.member(f, d, "operand", index(operand_of(r, forms.IMM))); }
        or                                     { emit.member(f, d, "operand", name("field.NO_OPERAND")); }
        stack = variant(f, "effect.Stack.delta", rec_value(d));
    }
    var fixeds: vector.Vector[emit.Value] = vector.init[emit.Value](a);
    i = 0;
    for (i < r.form.operands.len) {
        val o: *forms.Operand = ?r.form.operands.data[i];
        if (o.what == forms.REGISTER && o.place == forms.FIXED) {
            val x: *emit.Record = emit.record(f, "effect.Fixed");
            emit.member(f, x, "operand", number(i::i64));
            emit.member(f, x, "register", number(o.fixed.row::i64));
            vector.push[emit.Value](?fixeds, rec_value(x));
        }
        i = i + 1;
    }
    var fixed: emit.Value = name("effect.NO_FIXEDS");
    if (fixeds.len > 0) { fixed = span(f, "effect.Fixeds", "FIXED", emit.pooled(f, ?p.fixed, fixeds.data, fixeds.len::u32), fixeds.len::u32); }
    val e: *emit.Record = emit.record(f, "effect.Effect");
    emit.member(f, e, "implicit", variant(f, "effect.Registers.ruled", rec_value(implicit)));
    emit.member(f, e, "flags", flags.ok);
    emit.member(f, e, "memory", mem);
    emit.member(f, e, "control", control_of(p, r));
    emit.member(f, e, "stack", stack);
    emit.member(f, e, "latency", name("effect.ONE"));
    emit.member(f, e, "fixed", fixed);
    var one: [1]emit.Value = [1]emit.Value{rec_value(e)};
    ret res[u32, diag.Refusal].ok{emit.pooled(f, ?p.effects, ?one[0], 1)};
}

# the flags of `r` as masc.isa.x86.opcode names them
fun flag_names(f: *emit.File, flags: u16) emit.Value {
    if (flags == 0) { ret number(0); }
    val names: [14]str = [14]str{"x86_opcode.DEFAULT_64", "x86_opcode.IMMUNE_66", "x86_opcode.NO_REX2", "x86_opcode.REFINED_W", "x86_opcode.LOAD", "x86_opcode.STORE", "x86_opcode.LOCKED", "x86_opcode.W1", "x86_opcode.WIG", "x86_opcode.ND", "x86_opcode.NF", "x86_opcode.MANDATORY", "x86_opcode.SIBMEM", "x86_opcode.REX2"};
    val bits:  [14]u16 = [14]u16{x86_opcode.DEFAULT_64, x86_opcode.IMMUNE_66, x86_opcode.NO_REX2, x86_opcode.REFINED_W, x86_opcode.LOAD, x86_opcode.STORE, x86_opcode.LOCKED, x86_opcode.W1, x86_opcode.WIG, x86_opcode.ND, x86_opcode.NF, x86_opcode.MANDATORY, x86_opcode.SIBMEM, x86_opcode.REX2};
    var out:   str     = nil;
    var k:     u32     = 0;
    for (k < 14) {
        if ((flags & bits[k]) != 0) {
            if (out == nil) { out = names[k]; }
            or              { out = emit.concat(f, out, emit.concat(f, " | ", names[k])); }
        }
        k = k + 1;
    }
    ret name(out);
}

fun size_name(size: u8) str {
    if (size == x86_opcode.O16) { ret "x86_opcode.O16"; }
    if (size == x86_opcode.O32) { ret "x86_opcode.O32"; }
    if (size == x86_opcode.O64) { ret "x86_opcode.O64"; }
    ret "x86_opcode.NO_SIZE";
}

fun address_name(address: u8) str {
    if (address == x86_opcode.A16) { ret "x86_opcode.A16"; }
    if (address == x86_opcode.A32) { ret "x86_opcode.A32"; }
    if (address == x86_opcode.A64) { ret "x86_opcode.A64"; }
    ret "x86_opcode.NO_ADDRESS";
}

fun space_name(space: u8) str {
    if (space == forms.VEX)  { ret "x86_opcode.VEX"; }
    if (space == forms.EVEX) { ret "x86_opcode.EVEX"; }
    if (space == forms.XOP)  { ret "x86_opcode.XOP"; }
    ret "x86_opcode.LEGACY";
}

fun simd_name(simd: u8) str {
    if (simd == x86_opcode.P66) { ret "x86_opcode.P66"; }
    if (simd == x86_opcode.PF3) { ret "x86_opcode.PF3"; }
    if (simd == x86_opcode.PF2) { ret "x86_opcode.PF2"; }
    ret "x86_opcode.NO_SIMD";
}

fun length_name(length: u8) str {
    if (length == x86_opcode.L128) { ret "x86_opcode.L128"; }
    if (length == x86_opcode.L256) { ret "x86_opcode.L256"; }
    if (length == x86_opcode.L512) { ret "x86_opcode.L512"; }
    ret "x86_opcode.LIG";
}

fun digit_value(digit: u8) emit.Value {
    if (digit == forms.NO_DIGIT) { ret name("x86_opcode.NO_DIGIT"); }
    ret number(digit::i64);
}

# the memory operand of `r` the segment and address-size prefixes apply to: ModRM's, an a0 to a3 move's address, or the
# string memory a segment override applies to, else its first, field.NO_OPERAND for none
fun memory_of(r: *rows.Row) u8 {
    var first: u8    = 0xFF;
    var i:     usize = 0;
    for (i < r.form.operands.len) {
        val o: *forms.Operand = ?r.form.operands.data[i];
        if (o.what == forms.MEMORY || o.what == forms.AGEN || o.what == forms.MOFFS) { ret i::u8; }
        if (o.what == forms.STRING) {
            if (o.overrides)   { ret i::u8; }
            if (first == 0xFF) { first = i::u8; }
        }
        i = i + 1;
    }
    ret first;
}

# the power of two the evex disp8 of `r` is scaled by: its memory access's bytes, NELEM elements of ELEMENT_SIZE bits
# (Intel SDM 325462-093US Vol 2A 2.7.5, XED's NELEM and ELEMENT_SIZE), 0 outside the evex space or for an access of no
# elements, as apx's promoted legacy rows
fun disp8_of(r: *rows.Row) u8 {
    if (r.space != forms.EVEX || !r.form.memory || r.form.element == 0 || r.form.nelem == 0) { ret 0; }
    ret log2(r.form.nelem * r.form.element / 8);
}

# the power of two of the bytes of the element a broadcast of `r` repeats, 0 for a row of no broadcast
fun element_of(r: *rows.Row) u8 {
    var i: usize = 0;
    for (i < r.form.operands.len) {
        if (r.form.operands.data[i].what == forms.MEMORY && r.form.operands.data[i].broadcast) { ret log2(r.form.element / 8); }
        i = i + 1;
    }
    ret 0;
}

# the opcode record of `r` in OPCODES
fun opcode_record(p: *Pools, r: *rows.Row) {
    val f: *emit.File   = p.f;
    val o: *emit.Record = emit.record(f, "x86_opcode.Opcode");
    emit.member(f, o, "space", name(space_name(r.space)));
    emit.member(f, o, "map", number(r.form.map::i64));
    emit.member(f, o, "byte", emit.Value.hex{r.form.opcode::u64});
    emit.member(f, o, "simd", name(simd_name(r.reading.simd)));
    emit.member(f, o, "size", name(size_name(r.size)));
    emit.member(f, o, "address", name(address_name(r.address)));
    emit.member(f, o, "flags", flag_names(f, r.flags));
    # an operand in ModRM.reg or rm is the register its digit's fixed bits leave it, which its numbers hold
    val reg: u8 = placed(r, forms.REG);
    emit.member(f, o, "reg", index(reg));
    if (reg != 0xFF)                        { emit.member(f, o, "digit", name("x86_opcode.NO_DIGIT")); }
    or                                      { emit.member(f, o, "digit", digit_value(r.form.digit)); }
    if (placed(r, forms.RM) != 0xFF)        { emit.member(f, o, "rmdigit", name("x86_opcode.NO_DIGIT")); }
    or                                      { emit.member(f, o, "rmdigit", digit_value(r.reading.rmdigit)); }
    if (r.reading.scc == x86_opcode.NO_SCC) { emit.member(f, o, "scc", name("x86_opcode.NO_SCC")); }
    or                                      { emit.member(f, o, "scc", number(r.reading.scc::i64)); }
    var rm:  u8 = placed(r, forms.RM);
    val mem: u8 = memory_of(r);
    if (mem != 0xFF && r.form.modrm && !r.form.direct) { rm = mem; }
    emit.member(f, o, "rm", index(rm));
    emit.member(f, o, "opreg", index(placed(r, forms.LOW)));
    emit.member(f, o, "memory", index(mem));
    var vvvv: u8 = placed(r, forms.VVVV);
    if (vvvv == 0xFF) { vvvv = operand_of(r, forms.DFV); }
    emit.member(f, o, "vvvv", index(vvvv));
    emit.member(f, o, "mask", index(placed(r, forms.MASK)));
    emit.member(f, o, "zeroing", index(operand_of(r, forms.ZEROING)));
    emit.member(f, o, "rounding", index(operand_of(r, forms.ROUNDING)));
    emit.member(f, o, "length", name(length_name(r.reading.length)));
    emit.member(f, o, "disp8", number(disp8_of(r)::i64));
    emit.member(f, o, "element", number(element_of(r)::i64));
    emit.member(f, o, "twin", number(r.twin::i64));
    emit.item(f, p.opcodes, rec_value(o));
}

fun field_value(p: *Pools, kind: str, width: u8, slices: emit.Value, op: u8, at: u32) emit.Value {
    ret fixed_value(p, kind, width, slices, op, 0, 0, at);
}

# a field of `kind` whose unit holds `fixed` under `mask`
fun fixed_value(p: *Pools, kind: str, width: u8, slices: emit.Value, op: u8, fixed: u64, mask: u64, at: u32) emit.Value {
    val f: *emit.File   = p.f;
    val x: *emit.Record = emit.record(f, "field.Field");
    emit.member(f, x, "kind", name(kind));
    emit.member(f, x, "width", number(width::i64));
    emit.member(f, x, "fixed", emit.Value.hex{fixed});
    emit.member(f, x, "mask", emit.Value.hex{mask});
    emit.member(f, x, "slices", slices);
    emit.member(f, x, "operand", index(op));
    emit.member(f, x, "param", emit.Value.hex{0});
    emit.member(f, x, "data", emit.element(f, "OPCODES", at));
    ret rec_value(x);
}

fun slice(f: *emit.File, op: usize, lo: u8, len: u8, at: u8) emit.Value {
    val s: *emit.Record = emit.record(f, "field.Slice");
    emit.member(f, s, "operand", number(op::i64));
    emit.member(f, s, "part", name("field.NUMBER"));
    emit.member(f, s, "lo", number(lo::i64));
    emit.member(f, s, "len", number(len::i64));
    emit.member(f, s, "at", number(at::i64));
    emit.member(f, s, "invert", name("false"));
    ret rec_value(s);
}

fun slices(p: *Pools, items: *emit.Value, count: u32) emit.Value {
    ret span(p.f, "field.Slices", "SLICES", emit.pooled(p.f, ?p.slices, items, count), count);
}

# the order an operand's bits follow ModRM in: a displacement or address first, then the immediate, then a second
# immediate, as enter's (Intel SDM 325462-093US Vol 2A 2.1), or 3 for an operand of no bits of its own
fun unit_order(o: *forms.Operand) u8 {
    if (o.what == forms.RELATIVE || o.what == forms.POINTER) { ret 0; }
    if (o.what != forms.IMM)                                 { ret 3; }
    if (o.taken.use == forms.SECOND)                         { ret 2; }
    ret 1;
}

# the fields of `r`, the opcode record at `at`: its head, its ModRM or address, a string kind per string memory
# operand, 3dnow's suffix, and a unit per immediate, target or pointer in the order they follow, vex's /is4 register one
# unit with the immediate nibble below it
fun fields_of(p: *Pools, a: *A.Allocator, r: *rows.Row, at: u32) emit.Value {
    val f:   *emit.File                = p.f;
    var all: vector.Vector[emit.Value] = vector.init[emit.Value](a);
    vector.push[emit.Value](?all, field_value(p, "x86_field.HEAD_KIND", 0, name("field.NO_SLICES"), 0xFF, at));
    if (r.form.modrm) { vector.push[emit.Value](?all, field_value(p, "x86_field.MODRM_KIND", 0, name("field.NO_SLICES"), 0xFF, at)); }
    var i: usize = 0;
    for (i < r.form.operands.len) {
        val o: *forms.Operand = ?r.form.operands.data[i];
        if (o.what == forms.MOFFS)  { vector.push[emit.Value](?all, field_value(p, "x86_field.MOFFS_KIND", 0, name("field.NO_SLICES"), i::u8, at)); }
        if (o.what == forms.STRING) { vector.push[emit.Value](?all, field_value(p, "x86_field.STRING_KIND", 0, name("field.NO_SLICES"), i::u8, at)); }
        i = i + 1;
    }
    if (r.form.map == forms.NOW_MAP) {
        vector.push[emit.Value](?all, fixed_value(p, "x86_field.UNIT_KIND", 8, name("field.NO_SLICES"), 0xFF, r.form.opcode::u64, 0xFF, at));
    }
    val is4:   u8 = placed(r, forms.IS4);
    var order: u8 = 0;
    for (order < 3) {
        i = 0;
        for (i < r.form.operands.len) {
            val o: *forms.Operand = ?r.form.operands.data[i];
            if (unit_order(o) == order && !(is4 != 0xFF && o.what == forms.IMM && o.taken.bits == 4)) {
                var one: [1]emit.Value = [1]emit.Value{slice(f, i, 0, o.taken.bits, 0)};
                vector.push[emit.Value](?all, field_value(p, "x86_field.UNIT_KIND", o.taken.bits, slices(p, ?one[0], 1), 0xFF, at));
            }
            i = i + 1;
        }
        # /is4's register is imm8's high nibble, after every other immediate's bits, as no row has another
        if (order == 1 && is4 != 0xFF) {
            var two: [2]emit.Value;
            var n:   u32 = 1;
            two[0] = slice(f, is4::usize, 0, 4, 4);
            i      = 0;
            for (i < r.form.operands.len) {
                val o: *forms.Operand = ?r.form.operands.data[i];
                if (o.what == forms.IMM && o.taken.bits == 4) {
                    two[1] = slice(f, i, 0, 4, 0);
                    n      = 2;
                }
                i = i + 1;
            }
            vector.push[emit.Value](?all, field_value(p, "x86_field.UNIT_KIND", 8, slices(p, ?two[0], n), 0xFF, at));
        }
        order = order + 1;
    }
    ret span(f, "field.Fields", "gen_encoding.FIELDS", emit.pooled(f, ?p.fields, all.data, all.len::u32), all.len::u32);
}

# the requirement of `r`: each alternative of its ISA set's, or the one of none, at each width it is one at
fun requirement_of(p: *Pools, a: *A.Allocator, in: *Input, r: *rows.Row) res[emit.Value, diag.Refusal] {
    val f:     *emit.File                               = p.f;
    val found: opt[**vector.Vector[vector.Vector[str]]] = map.get[str, *vector.Vector[vector.Vector[str]]](?in.needs, ?r.set);
    if (sel found.none) { ret res[emit.Value, diag.Refusal].err{diag.refusal(r.ins.line.file, r.ins.line.number, rows.NO_SET, r.set)}; }
    val alts:   *vector.Vector[vector.Vector[str]] = @found.some;
    val widths: [3]str                             = [3]str{"width=16", "width=32", "width=64"};
    var run:    vector.Vector[emit.Value]          = vector.init[emit.Value](a);
    var count:  usize                              = alts.len;
    if (count == 0) { count = 1; }
    var mode: u8 = 0;
    for (mode < 3) {
        if (((r.modes >> mode) & 1) != 0) {
            var width: str = widths[mode];
            if (!map.contains[str, u32](?in.atoms, ?width)) { ret res[emit.Value, diag.Refusal].err{diag.refusal(nil, 0, NO_ATOM, width)}; }
            var k: usize = 0;
            for (k < count) {
                var each: vector.Vector[emit.Value] = vector.init[emit.Value](a);
                if (alts.len > 0) {
                    val alt: *vector.Vector[str] = ?alts.data[k];
                    var j:   usize               = 0;
                    for (j < alt.len) {
                        if (!map.contains[str, u32](?in.atoms, ?alt.data[j])) { ret res[emit.Value, diag.Refusal].err{diag.refusal(nil, 0, NO_ATOM, alt.data[j])}; }
                        vector.push[emit.Value](?each, name(emit.concat(f, "x86_extension.id.", emit.ident(f, alt.data[j]))));
                        j = j + 1;
                    }
                }
                vector.push[emit.Value](?each, name(emit.concat(f, "x86_extension.id.", emit.ident(f, width))));
                val first: u32          = emit.pooled(f, ?p.ids, each.data, each.len::u32);
                val alt:   *emit.Record = emit.record(f, "requirement.Alternative");
                emit.member(f, alt, "all", span(f, "requirement.Ids", "IDS", first, each.len::u32));
                emit.member(f, alt, "none", name("requirement.NO_IDS"));
                vector.push[emit.Value](?run, rec_value(alt));
                k = k + 1;
            }
        }
        mode = mode + 1;
    }
    val at: u32 = emit.pooled(f, ?p.alts, run.data, run.len::u32);
    ret res[emit.Value, diag.Refusal].ok{span(f, "requirement.Requirement", "gen_requirement.ALTERNATIVES", at, run.len::u32)};
}

# an enumeration of gen_operand named `id`, its members' names and values in `names` and `values`, its names index
# keyed in order
fun declare_enumeration(fo: *emit.File, id: str, names: *str, values: *u32, count: u32) {
    val members: *emit.Array = emit.array(fo, "operand.Enumerant");
    val keyed:   *emit.Array = emit.keyed(fo, "index.Entry");
    var i:       u32         = 0;
    for (i < count) {
        val m: *emit.Record = emit.record(fo, "operand.Enumerant");
        emit.member(fo, m, "name", emit.Value.text{names[i]});
        emit.member(fo, m, "value", number(values[i]::i64));
        emit.member(fo, m, "requires", name("requirement.NO_ALTERNATIVES"));
        emit.member(fo, m, "params", name("operand.NO_GROUP"));
        emit.item(fo, members, rec_value(m));
        val entry: *emit.Record = emit.record(fo, "index.Entry");
        emit.member(fo, entry, "key", emit.Value.text{names[i]});
        emit.member(fo, entry, "row", number(i::i64));
        emit.entry(fo, keyed, names[i], rec_value(entry));
        i = i + 1;
    }
    emit.seal(fo, keyed);
    emit.declare_array(fo, emit.concat(fo, id, "_MEMBERS"), members);
    emit.declare_array(fo, emit.concat(fo, id, "_NAMES"), keyed);
}

# the enumerations the evex and apx operands take: `{z}`, the rounding controls, `{sae}` and the default flags of
# ccmp and ctest, which vvvv's low four bits hold as of, sf, zf and cf (Intel APX 355828-009US 6, CCMPSCC), written in
# that order joined by commas and empty for none, as llvm-objdump 23.1.1 prints `{dfv=of,cf}` and `{dfv=}`
fun enumerations(fo: *emit.File) {
    var z:  [1]str = [1]str{"z"};
    var zv: [1]u32 = [1]u32{x86_opcode.ZEROING};
    declare_enumeration(fo, "ZEROING", ?z[0], ?zv[0], 1);
    var rc:  [4]str = [4]str{"rn-sae", "rd-sae", "ru-sae", "rz-sae"};
    var rcv: [4]u32 = [4]u32{x86_opcode.RN_SAE, x86_opcode.RD_SAE, x86_opcode.RU_SAE, x86_opcode.RZ_SAE};
    declare_enumeration(fo, "ROUNDING", ?rc[0], ?rcv[0], 4);
    var sae:  [1]str = [1]str{"sae"};
    var saev: [1]u32 = [1]u32{x86_opcode.SAE};
    declare_enumeration(fo, "SAE", ?sae[0], ?saev[0], 1);
    var dfv:  [5]str = [5]str{"", "of", "sf", "zf", "cf"};
    var dfvv: [5]u32 = [5]u32{0, 8, 4, 2, 1};
    declare_enumeration(fo, "DFV", ?dfv[0], ?dfvv[0], 5);
}

# the row table: every row's operands, fields, opcode record, requirement and effect, the rows by key and the codec,
# the pools in modules of their own
fun row_table(c: *set.Context, a: *A.Allocator, in: *Input) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "row");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f:          *emit.File                    = opened.ok;
    var p:          Pools                         = Pools{f: f, classes: emit.pool(f, "u16"), numbers: emit.pool(f, "u32"), ids: emit.pool(f, "requirement.Id"), alts: emit.pool(f, "requirement.Alternative"), ops: emit.pool(f, "operand.Operand"), slices: emit.pool(f, "field.Slice"), words: emit.pool(f, "u64"), access: emit.pool(f, "effect.Access"), fixed: emit.pool(f, "effect.Fixed"), effects: emit.pool(f, "effect.Effect"), opcodes: emit.array(f, "x86_opcode.Opcode"), fields: emit.pool(f, "field.Field"), table: emit.array(f, "row.Row")};
    val ops_opened: res[*emit.File, diag.Refusal] = set.table(c, "operand");
    if (sel ops_opened.err) { ret err[diag.Refusal].err{ops_opened.err}; }
    val fo:         *emit.File                    = ops_opened.ok;
    val enc_opened: res[*emit.File, diag.Refusal] = set.table(c, "encoding");
    if (sel enc_opened.err) { ret err[diag.Refusal].err{enc_opened.err}; }
    val fe:        *emit.File                    = enc_opened.ok;
    val fx_opened: res[*emit.File, diag.Refusal] = set.table(c, "effect");
    if (sel fx_opened.err) { ret err[diag.Refusal].err{fx_opened.err}; }
    val fx:        *emit.File                    = fx_opened.ok;
    val fr_opened: res[*emit.File, diag.Refusal] = set.table(c, "requirement");
    if (sel fr_opened.err) { ret err[diag.Refusal].err{fr_opened.err}; }
    val fr: *emit.File = fr_opened.ok;
    emit.uses(fo, "std.types.bool.false");
    emit.uses(fo, "std.types.bool.true");
    emit.uses(fo, "masc.core.index");
    emit.uses(fo, "masc.core.operand");
    emit.uses(fo, "masc.core.requirement");
    emit.uses(fo, "x86_fixup: masc.isa.x86.fixup");
    emit.uses(fo, "masc.isa.x86.gen_register");
    emit.uses(fe, "std.types.bool.false");
    emit.uses(fe, "masc.core.field");
    emit.uses(fe, "x86_field: masc.isa.x86.field");
    emit.uses(fe, "x86_opcode: masc.isa.x86.opcode");
    emit.uses(fx, "std.types.bool.false");
    emit.uses(fx, "std.types.bool.true");
    emit.uses(fx, "masc.core.effect");
    emit.uses(fx, "masc.core.field");
    emit.uses(fx, "masc.core.operand");
    emit.uses(fx, "masc.core.quantity");
    emit.uses(fr, "masc.core.requirement");
    emit.uses(fr, "x86_extension: masc.isa.x86.extension");
    emit.uses(f, "masc.core.ct");
    emit.uses(f, "masc.core.constraint");
    emit.uses(f, "masc.core.dispatch");
    emit.uses(f, "masc.core.field");
    emit.uses(f, "masc.core.index");
    emit.uses(f, "masc.core.requirement");
    emit.uses(f, "masc.core.row");
    emit.uses(f, "x86_field: masc.isa.x86.field");
    emit.uses(f, "x86_form: masc.isa.x86.form");
    emit.uses(f, "masc.isa.x86.gen_dispatch");
    emit.uses(f, "masc.isa.x86.gen_effect");
    emit.uses(f, "masc.isa.x86.gen_encoding");
    emit.uses(f, "masc.isa.x86.gen_operand");
    emit.uses(f, "masc.isa.x86.gen_register");
    emit.uses(f, "masc.isa.x86.gen_requirement");
    enumerations(fo);
    val keyed:   *emit.Array               = emit.keyed(f, "index.Entry");
    val rs:      *vector.Vector[*rows.Row] = in.rows;
    var handled: vector.Vector[str]        = vector.init[str](a);
    var i:       usize                     = 0;
    for (i < rs.len) {
        val r:   *rows.Row                 = rs.data[i];
        var ops: vector.Vector[emit.Value] = vector.init[emit.Value](a);
        var k:   usize                     = 0;
        for (k < r.form.operands.len) {
            val o:  *forms.Operand                = ?r.form.operands.data[k];
            val sh: res[emit.Value, diag.Refusal] = shape(?p, in, a, r, o);
            if (sel sh.err) { ret err[diag.Refusal].err{sh.err}; }
            val x: *emit.Record = emit.record(f, "operand.Operand");
            emit.member(f, x, "shape", sh.ok);
            emit.member(f, x, "role", role(o.role));
            if (o.what == forms.MEMORY || o.what == forms.MOFFS || o.what == forms.STRING || o.what == forms.REGISTER) { emit.member(f, x, "width", number(o.width::i64)); }
            or                                                                                                         { emit.member(f, x, "width", number(0)); }
            emit.member(f, x, "quantity", name(quantity_of(o)));
            emit.member(f, x, "write", name("operand.AS_ROW"));
            vector.push[emit.Value](?ops, rec_value(x));
            k = k + 1;
        }
        var operands: emit.Value = name("row.NO_OPERANDS");
        if (ops.len > 0) { operands = span(f, "row.Operands", "gen_operand.OPERANDS", emit.pooled(f, ?p.ops, ops.data, ops.len::u32), ops.len::u32); }
        opcode_record(?p, r);
        val fields: emit.Value                    = fields_of(?p, a, r, i::u32);
        val req:    res[emit.Value, diag.Refusal] = requirement_of(?p, a, in, r);
        if (sel req.err) { ret err[diag.Refusal].err{req.err}; }
        val e: res[u32, diag.Refusal] = effect_of(?p, a, in, r);
        if (sel e.err) { ret err[diag.Refusal].err{e.err}; }
        val rr: *emit.Record = emit.record(f, "row.Row");
        emit.member(f, rr, "key", emit.Value.text{r.key});
        emit.member(f, rr, "mnemonic", emit.Value.text{r.mnemonic});
        emit.member(f, rr, "operands", operands);
        emit.member(f, rr, "encoding", fields);
        emit.member(f, rr, "requires", req.ok);
        emit.member(f, rr, "effect", emit.element(f, "gen_effect.EFFECTS", e.ok));
        emit.member(f, rr, "ct", emit.Value.address{"ct.DEPENDENT"});
        emit.member(f, rr, "constraints", name("constraint.NO_CONSTRAINTS"));
        emit.member(f, rr, "flags", number(0));
        emit.member(f, rr, "index", number(i::i64));
        emit.item(f, p.table, rec_value(rr));
        val entry: *emit.Record = emit.record(f, "index.Entry");
        emit.member(f, entry, "key", emit.Value.text{r.key});
        emit.member(f, entry, "row", number(i::i64));
        emit.entry(f, keyed, r.key, rec_value(entry));
        if (!pushed(vector.push[str](?handled, r.key))) { ret err[diag.Refusal].err{memory(r.key)}; }
        i = i + 1;
    }
    val named: err[diag.Refusal] = set.handles(c, ?handled);
    if (sel named.err) { ret named; }
    emit.declare(fo, "CLASSES", nil, emit.Value.array{p.classes.array});
    emit.declare_array(fo, "NUMBERS", p.numbers.array);
    emit.declare(fo, "OPERANDS", nil, emit.Value.array{p.ops.array});
    emit.declare(fe, "OPCODES", nil, emit.Value.array{p.opcodes});
    emit.declare(fe, "SLICES", nil, emit.Value.array{p.slices.array});
    emit.declare(fe, "FIELDS", nil, emit.Value.array{p.fields.array});
    emit.declare(fx, "WORDS", nil, emit.Value.array{p.words.array});
    emit.declare(fx, "ACCESSES", nil, emit.Value.array{p.access.array});
    emit.declare(fx, "FIXED", nil, emit.Value.array{p.fixed.array});
    emit.declare(fx, "EFFECTS", nil, emit.Value.array{p.effects.array});
    emit.declare(fr, "IDS", nil, emit.Value.array{p.ids.array});
    emit.declare(fr, "ALTERNATIVES", nil, emit.Value.array{p.alts.array});
    emit.declare(f, "ROWS", nil, emit.Value.array{p.table});
    emit.declare(f, "KEYS", nil, emit.Value.array{keyed});
    val codec: *emit.Record = emit.record(f, "dispatch.Codec");
    emit.member(f, codec, "fields", emit.Value.address{"x86_field.TABLE"});
    emit.member(f, codec, "registers", emit.Value.address{"gen_register.FILE"});
    emit.member(f, codec, "rows", span(f, "row.Rows", "ROWS", 0, rs.len::u32));
    emit.member(f, codec, "keys", span(f, "index.Index", "KEYS", 0, rs.len::u32));
    emit.member(f, codec, "dispatch", emit.Value.address{"gen_dispatch.DISPATCH"});
    emit.member(f, codec, "element", number(0));
    emit.member(f, codec, "forms", name("x86_form.FIELDS"));
    emit.declare(f, "CODEC", "dispatch.Codec", rec_value(codec));
    emit.declare(f, "ROW_COUNT", "u32", number(rs.len::i64));
    ret err[diag.Refusal].ok{};
}

# bits fixed under a mask, one cube of a row's match word
rec Bits {
    value: u64;
    mask:  u64;
}

fun bits_of(ks: *keys.Keys, which: u32) u64 {
    val k: *dispatch.Key = ?ks.field[which];
    if (k.len >= 64) { ret ~0::u64; }
    ret ((1::u64 << k.len::u64) - 1) << k.lo::u64;
}

fun value_at(ks: *keys.Keys, which: u32, c: *Bits) u64 {
    val k: *dispatch.Key = ?ks.field[which];
    ret (c.value & bits_of(ks, which)) >> k.lo::u64;
}

# whether `r` has an operand of kind `what` that broadcasts, any of kind `what` when `broadcast` is false
fun holds(r: *rows.Row, what: forms.What, broadcast: bool) bool {
    var i: usize = 0;
    for (i < r.form.operands.len) {
        val o: *forms.Operand = ?r.form.operands.data[i];
        if (o.what == what && (!broadcast || o.broadcast)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the 66 the osz key reads of `r` under `cf`: the configuration's in the legacy space and evex map 4, where it is 66, else
# whether its pp is 01
fun osz_key(r: *rows.Row, cf: forms.Config) u64 {
    if (r.space == forms.LEGACY || (r.space == forms.EVEX && r.form.map == forms.APX_MAP)) { ret cf.osz::u64; }
    if (r.reading.simd == x86_opcode.P66)                                                  { ret 1; }
    ret 0;
}

# the values of the rep key `r` admits, as bit v for value v, 0 for any
fun reps_of(r: *rows.Row) u64 {
    if (r.space != forms.LEGACY) {
        if (r.reading.simd == x86_opcode.PF3) { ret 0x8; }
        if (r.reading.simd == x86_opcode.PF2) { ret 0x4; }
        ret 0x1;
    }
    ret r.reading.reps::u64;
}

# the evex.aaa an evex row of no opmask operand reads: apx's condition's low bits, nf, else none
fun aaa_of(r: *rows.Row) u64 {
    if (r.reading.scc != x86_opcode.NO_SCC)     { ret r.reading.scc::u64 & 7; }
    if ((r.reading.flags & x86_opcode.NF) != 0) { ret 4; }
    ret 0;
}

fun add_bits(out: *vector.Vector[Bits], c: Bits) bool {
    var i: usize = 0;
    for (i < out.len) {
        if (out.data[i].value == c.value && out.data[i].mask == c.mask) { ret true; }
        i = i + 1;
    }
    ret pushed(vector.push[Bits](out, c));
}

# the cube of `r` under configuration `cf` before its repeat prefix and the registers its low bits and rex bits hold
fun config_cube(ks: *keys.Keys, r: *rows.Row, cf: forms.Config) Bits {
    var c:  Bits = Bits{value: 0, mask: 0};
    val ev: bool = r.space == forms.EVEX;
    keys.fix(ks, keys.MAP, ((r.space::u64) << 5) | r.form.map::u64, ?c.value, ?c.mask);
    keys.fix(ks, keys.OPCODE, r.form.opcode::u64, ?c.value, ?c.mask);
    keys.fix(ks, keys.MODE, cf.mode::u64, ?c.value, ?c.mask);
    if (r.form.modrm)                   { keys.fix(ks, keys.DIRECT, r.form.direct::u64, ?c.value, ?c.mask); }
    if (r.form.digit != forms.NO_DIGIT) { keys.fix(ks, keys.REG, r.form.digit::u64, ?c.value, ?c.mask); }
    keys.fix(ks, keys.OSZ, osz_key(r, cf), ?c.value, ?c.mask);
    keys.fix(ks, keys.W, cf.rexw::u64, ?c.value, ?c.mask);
    keys.fix(ks, keys.REX2, cf.rex2::u64, ?c.value, ?c.mask);
    if ((r.flags & x86_opcode.LOCKED) != 0) { keys.fix(ks, keys.LOCK, 1, ?c.value, ?c.mask); }
    keys.fix(ks, keys.ASZ, cf.asz::u64, ?c.value, ?c.mask);
    # evex.l'l of a register form under evex.b is its rounding, which sae ignores
    val rounded: bool = ev && r.form.direct && cf.bcrc == 1 && holds(r, forms.ROUNDING, false);
    if (r.space != forms.LEGACY && r.reading.length != x86_opcode.LIG && !rounded) { keys.fix(ks, keys.VL, r.reading.length::u64, ?c.value, ?c.mask); }
    # evex.b of a memory form that broadcasts is the operand's
    if (ev && (r.form.direct || !holds(r, forms.MEMORY, true))) { keys.fix(ks, keys.B, cf.bcrc::u64, ?c.value, ?c.mask); }
    if (r.reading.rmdigit != forms.NO_DIGIT)                    { keys.fix(ks, keys.RM, r.reading.rmdigit::u64, ?c.value, ?c.mask); }
    if (ev && placed(r, forms.MASK) == 0xFF)                    { keys.fix(ks, keys.AAA, aaa_of(r), ?c.value, ?c.mask); }
    if (r.reading.scc != x86_opcode.NO_SCC)                     { keys.fix(ks, keys.V4, (r.reading.scc >> 3)::u64, ?c.value, ?c.mask); }
    ret c;
}

# the cubes of `r` into `out`: one per configuration, repeat prefix it admits, register its opcode's low bits and rex
# bits hold and rex bits it admits
fun row_cubes(ks: *keys.Keys, r: *rows.Row, out: *vector.Vector[Bits]) bool {
    val reps: u64   = reps_of(r);
    var k:    usize = 0;
    for (k < r.configs.len) {
        val cf:   forms.Config = r.configs.data[k];
        val base: Bits         = config_cube(ks, r, cf);
        var rep:  u64          = 0;
        for (rep < 4) {
            if (reps == 0 || ((reps >> rep) & 1) != 0) {
                var c: Bits = base;
                if (reps != 0) { keys.fix(ks, keys.REP, rep, ?c.value, ?c.mask); }
                if (placed(r, forms.LOW) != 0xFF) {
                    val o: *forms.Operand = ?r.form.operands.data[placed(r, forms.LOW)];
                    var n: u64            = 0;
                    for (n < 32) {
                        val reached: bool = (cf.mode == 2 || n < 8) && (cf.rex2 == 1 || n < 16);
                        if (reached && ((o.numbers >> n) & 1) != 0) {
                            var d: Bits = c;
                            keys.fix(ks, keys.OPCODE, (r.form.opcode::u64 | (n & 7)), ?d.value, ?d.mask);
                            keys.fix(ks, keys.REXB, (n >> 3) & 3, ?d.value, ?d.mask);
                            if (!add_bits(out, d)) { ret false; }
                        }
                        n = n + 1;
                    }
                }
                or (r.reading.rexb != 0) {
                    var b: u64 = 0;
                    for (b < 4) {
                        if (((r.reading.rexb >> b::u8) & 1) != 0 && (cf.mode == 2 || b == 0) && (cf.rex2 == 1 || b < 2)) {
                            var d: Bits = c;
                            keys.fix(ks, keys.REXB, b, ?d.value, ?d.mask);
                            if (!add_bits(out, d)) { ret false; }
                        }
                        b = b + 1;
                    }
                }
                or (!add_bits(out, c)) { ret false; }
            }
            rep = rep + 1;
        }
        k = k + 1;
    }
    ret true;
}

# the cubes of `cubes` joined where every value a field's reader returns is a cube that is otherwise one, the field
# left open, until no more join
fun join_cubes(a: *A.Allocator, ks: *keys.Keys, cubes: *vector.Vector[Bits]) bool {
    var changed: bool = true;
    for (changed) {
        changed = false;
        var f: u32 = 0;
        for (f < keys.FIELD_COUNT) {
            val k: *dispatch.Key = ?ks.field[f];
            if (k.len <= 6) {
                val bits: u64                 = bits_of(ks, f);
                val dom:  u64                 = keys.domain(f, k.len);
                var kept: vector.Vector[Bits] = vector.init[Bits](a);
                var dead: vector.Vector[bool] = vector.init[bool](a);
                var i:    usize               = 0;
                for (i < cubes.len) {
                    if (!pushed(vector.push[bool](?dead, false))) { ret false; }
                    i = i + 1;
                }
                i = 0;
                for (i < cubes.len) {
                    if (!dead.data[i]) {
                        val c: *Bits = ?cubes.data[i];
                        if ((c.mask & bits) == bits) {
                            var seen: u64   = 1::u64 << value_at(ks, f, c);
                            var j:    usize = i + 1;
                            for (j < cubes.len) {
                                val d: *Bits = ?cubes.data[j];
                                if (!dead.data[j] && d.mask == c.mask && (d.value & ~bits) == (c.value & ~bits)) { seen = seen | (1::u64 << value_at(ks, f, d)); }
                                j = j + 1;
                            }
                            if ((seen & dom) == dom) {
                                j = i + 1;
                                for (j < cubes.len) {
                                    val d: *Bits = ?cubes.data[j];
                                    if (!dead.data[j] && d.mask == c.mask && (d.value & ~bits) == (c.value & ~bits)) { dead.data[j] = true; }
                                    j = j + 1;
                                }
                                if (!pushed(vector.push[Bits](?kept, Bits{value: c.value & ~bits, mask: c.mask & ~bits}))) { ret false; }
                                changed = true;
                            }
                            or (!pushed(vector.push[Bits](?kept, @c))) { ret false; }
                        }
                        or (!pushed(vector.push[Bits](?kept, @c))) { ret false; }
                    }
                    i = i + 1;
                }
                @cubes = kept;
            }
            f = f + 1;
        }
    }
    ret true;
}

# the dispatch over every row's configurations, each a cube over the keys, joined where they cover a field
fun dispatch_table(c: *set.Context, a: *A.Allocator, in: *Input) err[diag.Refusal] {
    val rs:   *vector.Vector[*rows.Row]       = in.rows;
    var pats: vector.Vector[dispatch.Pattern] = vector.init[dispatch.Pattern](a);
    var i:    usize                           = 0;
    for (i < rs.len) {
        val r:     *rows.Row           = rs.data[i];
        var cubes: vector.Vector[Bits] = vector.init[Bits](a);
        if (!row_cubes(in.keys, r, ?cubes))  { ret err[diag.Refusal].err{memory(r.key)}; }
        if (!join_cubes(a, in.keys, ?cubes)) { ret err[diag.Refusal].err{memory(r.key)}; }
        val n:     usize                        = cubes.len;
        val words: res[*u64, A.Error]           = A.allocate[u64](a, n * 2);
        val made:  res[*dispatch.Cube, A.Error] = A.allocate[dispatch.Cube](a, n);
        if (sel words.err) { ret err[diag.Refusal].err{memory(r.key)}; }
        if (sel made.err)  { ret err[diag.Refusal].err{memory(r.key)}; }
        var k: usize = 0;
        for (k < n) {
            words.ok[k * 2]     = cubes.data[k].value;
            words.ok[k * 2 + 1] = cubes.data[k].mask;
            made.ok[k]          = dispatch.Cube{value: ?words.ok[k * 2], mask: ?words.ok[k * 2 + 1]};
            k                   = k + 1;
        }
        vector.push[dispatch.Pattern](?pats, dispatch.Pattern{row: i::u32, name: r.key, cubes: made.ok, count: n::u32});
        i = i + 1;
    }
    var space: dispatch.Space                    = dispatch.Space{words: 1, keys: in.keys.keys.data, key_count: in.keys.keys.len::u32};
    val built: res[dispatch.Built, diag.Refusal] = dispatch.build(a, ?space, pats.data, pats.len::u32);
    if (sel built.err) { ret err[diag.Refusal].err{built.err}; }
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "dispatch");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f: *emit.File = opened.ok;
    emit.uses(f, "masc.isa.x86.gen_key");
    var b: dispatch.Built = built.ok;
    dispatch.declare(f, "DISPATCH", "gen_key.KEYS", in.keys.keys.len::u32, ?b);
    ret err[diag.Refusal].ok{};
}

# a row's own spelling under its mnemonic
# a comparison whose predicate immediate llvm 23.1.1 prints in its mnemonic, as `cmpltps xmm1, xmm2` of cmpps with
# predicate 1 (llvm-project 7ddb67460b168b17ebb263dc99bf956b56d7e517 llvm/lib/Target/X86/MCTargetDesc/
# X86InstPrinterCommon.cpp printCMPMnemonic, printVPCMPMnemonic, printVPCOMMnemonic, and X86InstrInfo.td's
# CMPSS/CMPPS aliases): the predicate's name follows the stem, and the rest of the mnemonic after it
# ---
# iclass: XED's ICLASS
# stem:   the mnemonic's part before the name
# names:  the name of each predicate from 0, empty for one llvm prints as an immediate
# count:  how many predicates are named
rec Predicated {
    iclass: str;
    stem:   str;
    names:  *str;
    count:  u32;
}

val SSE_PREDICATES: [8]str = [8]str{"eq", "lt", "le", "unord", "neq", "nlt", "nle", "ord"};

val AVX_PREDICATES: [32]str = [32]str{
    "eq", "lt", "le", "unord", "neq", "nlt", "nle", "ord", "eq_uq", "nge", "ngt", "false", "neq_oq", "ge", "gt", "true",
    "eq_os", "lt_oq", "le_oq", "unord_s", "neq_us", "nlt_uq", "nle_uq", "ord_s", "eq_us", "nge_uq", "ngt_uq", "false_os",
    "neq_os", "ge_oq", "gt_oq", "true_us",
};

val VPCMP_PREDICATES: [8]str = [8]str{"eq", "lt", "le", "", "neq", "nlt", "nle", ""};

val VPCOM_PREDICATES: [8]str = [8]str{"lt", "le", "gt", "ge", "eq", "neq", "false", "true"};

val PREDICATED_COUNT: u32 = 27;

val PREDICATED: [PREDICATED_COUNT]Predicated = [PREDICATED_COUNT]Predicated{
    Predicated{iclass: "CMPPS", stem: "cmp", names: ?SSE_PREDICATES[0], count: 8},
    Predicated{iclass: "CMPPD", stem: "cmp", names: ?SSE_PREDICATES[0], count: 8},
    Predicated{iclass: "CMPSS", stem: "cmp", names: ?SSE_PREDICATES[0], count: 8},
    Predicated{iclass: "CMPSD_XMM", stem: "cmp", names: ?SSE_PREDICATES[0], count: 8},
    Predicated{iclass: "VCMPPS", stem: "vcmp", names: ?AVX_PREDICATES[0], count: 32},
    Predicated{iclass: "VCMPPD", stem: "vcmp", names: ?AVX_PREDICATES[0], count: 32},
    Predicated{iclass: "VCMPSS", stem: "vcmp", names: ?AVX_PREDICATES[0], count: 32},
    Predicated{iclass: "VCMPSD", stem: "vcmp", names: ?AVX_PREDICATES[0], count: 32},
    Predicated{iclass: "VCMPPH", stem: "vcmp", names: ?AVX_PREDICATES[0], count: 32},
    Predicated{iclass: "VCMPSH", stem: "vcmp", names: ?AVX_PREDICATES[0], count: 32},
    Predicated{iclass: "VCMPBF16", stem: "vcmp", names: ?AVX_PREDICATES[0], count: 32},
    Predicated{iclass: "VPCMPB", stem: "vpcmp", names: ?VPCMP_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCMPW", stem: "vpcmp", names: ?VPCMP_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCMPD", stem: "vpcmp", names: ?VPCMP_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCMPQ", stem: "vpcmp", names: ?VPCMP_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCMPUB", stem: "vpcmp", names: ?VPCMP_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCMPUW", stem: "vpcmp", names: ?VPCMP_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCMPUD", stem: "vpcmp", names: ?VPCMP_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCMPUQ", stem: "vpcmp", names: ?VPCMP_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCOMB", stem: "vpcom", names: ?VPCOM_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCOMW", stem: "vpcom", names: ?VPCOM_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCOMD", stem: "vpcom", names: ?VPCOM_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCOMQ", stem: "vpcom", names: ?VPCOM_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCOMUB", stem: "vpcom", names: ?VPCOM_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCOMUW", stem: "vpcom", names: ?VPCOM_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCOMUD", stem: "vpcom", names: ?VPCOM_PREDICATES[0], count: 8},
    Predicated{iclass: "VPCOMUQ", stem: "vpcom", names: ?VPCOM_PREDICATES[0], count: 8},
};

# the comparison family of `r`, nil for a row of none
fun predicated(r: *rows.Row) *Predicated {
    var i: u32 = 0;
    for (i < PREDICATED_COUNT) {
        if (str_equals(PREDICATED[i].iclass, r.ins.iclass)) { ret ?PREDICATED[i]; }
        i = i + 1;
    }
    ret nil;
}

# an alias of a row before its index is built
# ---
# row:        the base row
# mnemonic:   its mnemonic
# template:   its spelling
# count:      its operands
# fixed:      the base operand it fixes, the predicate immediate, NO_FIXED for none
# value:      the predicate
# preference: its preference for printing, 0 for an alias that is only read
rec Spelled {
    row:        u32;
    mnemonic:   str;
    template:   str;
    count:      u32;
    fixed:      usize;
    value:      i64;
    preference: i64;
}

val NO_FIXED: usize = 0xFFFF_FFFF;

# each row of an implied 1, as d1's shift by one, read too as its own template with `, 1` after it, into `out` in row
# order: llvm-mc 23.1.1 reads a shift or rotate by an immediate 1 as the row of the implied 1, which llvm-objdump
# prints without it (llvm-project 7ddb67460b168b17ebb263dc99bf956b56d7e517
# llvm/lib/Target/X86/AsmParser/X86AsmParser.cpp, "shr/sar/shl/sal/rcl/rcr/rol/ror $1"), so the shorter row is the one
# the text reads as, ahead of the immediate's
fun one_aliases(f: *emit.File, rs: *vector.Vector[*rows.Row], out: *vector.Vector[Spelled]) err[diag.Refusal] {
    var i: usize = 0;
    for (i < rs.len) {
        val r: *rows.Row = rs.data[i];
        if (r.form.constant) {
            val a: Spelled = Spelled{row: i::u32, mnemonic: r.mnemonic, template: emit.concat(f, template(f, r), ", 1"), count: r.form.operands.len::u32, fixed: NO_FIXED, value: 0, preference: 0};
            if (!pushed(vector.push[Spelled](out, a))) { ret err[diag.Refusal].err{memory(r.key)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the aliases of `x` and `y`, each in row order, into `out` in row order
fun merged(x: *vector.Vector[Spelled], y: *vector.Vector[Spelled], out: *vector.Vector[Spelled]) bool {
    var i: usize = 0;
    var j: usize = 0;
    for (i < x.len || j < y.len) {
        var take: Spelled;
        if (j >= y.len || (i < x.len && x.data[i].row <= y.data[j].row)) {
            take = x.data[i];
            i    = i + 1;
        }
        or {
            take = y.data[j];
            j    = j + 1;
        }
        if (!pushed(vector.push[Spelled](out, take))) { ret false; }
    }
    ret true;
}

# each comparison row's aliases, one per named predicate, into `out` in row order
fun predicate_aliases(f: *emit.File, rs: *vector.Vector[*rows.Row], out: *vector.Vector[Spelled]) err[diag.Refusal] {
    var i: usize = 0;
    for (i < rs.len) {
        val r: *rows.Row   = rs.data[i];
        val p: *Predicated = predicated(r);
        if (p != nil) {
            val imm: u8    = operand_of(r, forms.IMM);
            val n:   usize = str_len(p.stem);
            if (imm == 0xFF || !str_starts_with(r.mnemonic, p.stem)) { ret err[diag.Refusal].err{diag.refusal(nil, 0, NO_PREDICATE, r.key)}; }
            var k: u32 = 0;
            for (k < p.count) {
                if (str_len(p.names[k]) > 0) {
                    val spelled: str     = emit.concat(f, emit.concat(f, p.stem, p.names[k]), ?r.mnemonic[n]);
                    val a:       Spelled = Spelled{row: i::u32, mnemonic: spelled, template: spelled_without(f, r, spelled, imm::usize), count: (r.form.operands.len - 1)::u32, fixed: imm::usize, value: k::i64, preference: 1};
                    if (!pushed(vector.push[Spelled](out, a))) { ret err[diag.Refusal].err{memory(r.key)}; }
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

rec Cand {
    key:   str;
    row:   u32;
    alias: u32;
}

fun by_candidate(x: *Cand, y: *Cand) i64 {
    val c: i64 = str_compare(x.key, y.key);
    if (c != 0)            { ret c; }
    if (x.row < y.row)     { ret -1; }
    if (x.row > y.row)     { ret 1; }
    if (x.alias < y.alias) { ret -1; }
    if (x.alias > y.alias) { ret 1; }
    ret 0;
}

# the hole of operand `i`, its format after a colon when it has one
fun hole(f: *emit.File, i: usize, format: str) str {
    var digits: [8]u8;
    digits[0] = '<';
    digits[1] = '0' + i::u8;
    digits[2] = 0;
    var t: str = emit.concat(f, ?digits[0], "");
    if (format != nil) { t = emit.concat(f, emit.concat(f, t, ":"), format); }
    ret emit.concat(f, t, ">");
}

# whether operand `o` is a decorator of the operand before it, evex's opmask or `{z}`, written after it in braces
fun decorates(o: *forms.Operand) bool {
    ret (o.what == forms.REGISTER && o.place == forms.MASK) || o.what == forms.ZEROING;
}

# whether operand `o` is x87's st(0) where XED names it beside another, which llvm-objdump 23.1.1 never writes as an
# operand: a memory form writes nothing for it, as `fadd dword ptr [eax]`, and a register form the text `st` where
# its asm string spells it, as `fadd st, st(1)`, which the operands topic states
fun hidden(o: *forms.Operand) bool {
    ret o.what == forms.REGISTER && o.place == forms.FIXED && o.fixed != nil && str_equals(o.fixed.class, "st") && o.fixed.number == 0;
}

# the plain operands `r` writes in order, into `out`: the operands topic's, else XED's but for a hidden st(0)
fun plain_order(r: *rows.Row, out: *rows.Token) usize {
    var len: usize = 0;
    if (r.written != nil) {
        for (len < r.written.len) {
            out[len] = r.written.data[len];
            len      = len + 1;
        }
        ret len;
    }
    var i: usize = 0;
    for (i < r.form.operands.len) {
        val o: *forms.Operand = ?r.form.operands.data[i];
        if (rows.plain(o) && !hidden(o)) {
            out[len] = rows.Token{operand: i::u8, format: nil, text: nil};
            len      = len + 1;
        }
        i = i + 1;
    }
    ret len;
}

# the template of `r` in intel syntax as llvm-mc 23.1.1 reads it and llvm-objdump 23.1.1 prints it: its mnemonic, apx's
# default flags as `{dfv=...}`, then its plain operands comma separated, each followed by the opmask and `{z}` that
# decorate it in braces, an optional one in a group of its own, and a rounding control or `{sae}` in braces after the
# last operand that is no immediate, as Intel SDM 325462-093US Vol 2 writes `{er}` and `{sae}` on the last source and
# llvm-mc reads `vrangesd xmm1 {k1} {z}, xmm2, xmm3, {sae}, 1`
fun template(f: *emit.File, r: *rows.Row) str {
    ret spelled_without(f, r, r.mnemonic, r.form.operands.len);
}

# the number of operand `i` of `r` in a spelling that leaves operand `skip` out
fun renumbered(f: *emit.File, i: usize, skip: usize, format: str) str {
    if (i > skip) { ret hole(f, i - 1, format); }
    ret hole(f, i, format);
}

# the template of `r` under `mnemonic` with operand `skip` left out and the operands after it numbered one less, as
# an alias that fixes it spells the row, and with every operand when `skip` is past the last
fun spelled_without(f: *emit.File, r: *rows.Row, mnemonic: str, skip: usize) str {
    var t:     str   = mnemonic;
    val n:     usize = r.form.operands.len;
    var round: usize = n;
    var i:     usize = 0;
    for (i < n) {
        val o: *forms.Operand = ?r.form.operands.data[i];
        if (o.what == forms.DFV)      { t = emit.concat(f, emit.concat(f, emit.concat(f, t, " {dfv="), renumbered(f, i, skip, nil)), "}"); }
        if (o.what == forms.ROUNDING) { round = i; }
        i = i + 1;
    }
    var all:   [16]rows.Token;
    val held:  usize = plain_order(r, ?all[0]);
    var order: [16]rows.Token;
    var count: usize = 0;
    var m:     usize = 0;
    for (m < held) {
        if (all[m].operand == rows.NO_TOKEN || all[m].operand::usize != skip) {
            order[count] = all[m];
            count        = count + 1;
        }
        m = m + 1;
    }
    var last: usize = count;
    var k:    usize = 0;
    for (k < count) {
        val op: u8 = order[k].operand;
        if (op == rows.NO_TOKEN || r.form.operands.data[op].what != forms.IMM) { last = k; }
        k = k + 1;
    }
    k = 0;
    for (k < count) {
        if (k == 0) { t = emit.concat(f, t, " "); }
        or          { t = emit.concat(f, t, ", "); }
        val tok: rows.Token = order[k];
        if (tok.operand == rows.NO_TOKEN) { t = emit.concat(f, t, tok.text); }
        or {
            t = emit.concat(f, t, renumbered(f, tok.operand::usize, skip, tok.format));
            var j: usize = tok.operand::usize + 1;
            for (j < n && decorates(?r.form.operands.data[j])) {
                var piece: str = emit.concat(f, emit.concat(f, " {", renumbered(f, j, skip, nil)), "}");
                if (optional(?r.form.operands.data[j])) { piece = emit.concat(f, emit.concat(f, "<[", piece), "]>"); }
                t = emit.concat(f, t, piece);
                j = j + 1;
            }
        }
        if (k == last && round < n) { t = emit.concat(f, emit.concat(f, emit.concat(f, t, ", {"), renumbered(f, round, skip, nil)), "}"); }
        k = k + 1;
    }
    ret t;
}

# the syntax table: each row's template, and the rows by mnemonic, each mnemonic's candidates in row order
fun syntax_table(c: *set.Context, a: *A.Allocator, in: *Input) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "syntax");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f: *emit.File = opened.ok;
    emit.uses(f, "masc.core.operand");
    emit.uses(f, "masc.core.requirement");
    emit.uses(f, "masc.core.syntax");
    emit.uses(f, "std.types.string.str");
    val rs:       *vector.Vector[*rows.Row] = in.rows;
    val forms_at: *emit.Array               = emit.array(f, "str");
    var i:        usize                     = 0;
    for (i < rs.len) {
        emit.item(f, forms_at, emit.Value.text{template(f, rs.data[i])});
        i = i + 1;
    }
    var predicates: vector.Vector[Spelled] = vector.init[Spelled](a);
    val made:       err[diag.Refusal]      = predicate_aliases(f, rs, ?predicates);
    if (sel made.err) { ret made; }
    var ones: vector.Vector[Spelled] = vector.init[Spelled](a);
    val once: err[diag.Refusal]      = one_aliases(f, rs, ?ones);
    if (sel once.err) { ret once; }
    var spelled: vector.Vector[Spelled] = vector.init[Spelled](a);
    if (!merged(?predicates, ?ones, ?spelled)) { ret err[diag.Refusal].err{memory("aliases")}; }
    var sources: emit.Pool   = emit.pool(f, "syntax.Source");
    val aliases: *emit.Array = emit.array(f, "syntax.Alias");
    i = 0;
    for (i < spelled.len) {
        val al:   *Spelled                  = ?spelled.data[i];
        var vals: vector.Vector[emit.Value] = vector.init[emit.Value](a);
        var j:    usize                     = 0;
        var base: usize                     = al.count::usize;
        if (al.fixed != NO_FIXED) { base = base + 1; }
        for (j < base) {
            var v: emit.Value = emit.Value.variant{emit.variant(f, "syntax.Source.operand", number(j::i64))};
            if (j > al.fixed) { v = emit.Value.variant{emit.variant(f, "syntax.Source.operand", number((j - 1)::i64))}; }
            if (j == al.fixed) {
                val imm: emit.Value = emit.Value.variant{emit.variant(f, "operand.Value.immediate", number(al.value))};
                v = emit.Value.variant{emit.variant(f, "syntax.Source.value", imm)};
            }
            if (!pushed(vector.push[emit.Value](?vals, v))) { ret err[diag.Refusal].err{memory(al.template)}; }
            j = j + 1;
        }
        val r: *emit.Record = emit.record(f, "syntax.Alias");
        emit.member(f, r, "row", number(al.row::i64));
        emit.member(f, r, "template", emit.Value.text{al.template});
        emit.member(f, r, "count", number(al.count::i64));
        emit.member(f, r, "sources", span(f, "syntax.Sources", "SOURCES", emit.pooled(f, ?sources, vals.data, vals.len::u32), vals.len::u32));
        emit.member(f, r, "derive", emit.Value.name{"nil"});
        emit.member(f, r, "exclusions", name("syntax.NO_EXCLUSIONS"));
        emit.member(f, r, "requires", name("requirement.NO_ALTERNATIVES"));
        emit.member(f, r, "preference", number(al.preference));
        emit.item(f, aliases, rec_value(r));
        i = i + 1;
    }
    var cands: vector.Vector[Cand] = vector.init[Cand](a);
    i = 0;
    for (i < rs.len) {
        if (!pushed(vector.push[Cand](?cands, Cand{key: rs.data[i].mnemonic, row: i::u32, alias: 0}))) { ret err[diag.Refusal].err{memory(rs.data[i].key)}; }
        i = i + 1;
    }
    i = 0;
    for (i < spelled.len) {
        val key: str = spelled.data[i].mnemonic;
        if (!pushed(vector.push[Cand](?cands, Cand{key: key, row: spelled.data[i].row, alias: i::u32 + 1}))) { ret err[diag.Refusal].err{memory(key)}; }
        i = i + 1;
    }
    sort.sort_by[Cand](cands.data, cands.len, by_candidate);
    val entries:    *emit.Array = emit.array(f, "syntax.Entry");
    val candidates: *emit.Array = emit.array(f, "syntax.Candidate");
    i = 0;
    for (i < cands.len) {
        var j: usize = i;
        for (j < cands.len && str_equals(cands.data[j].key, cands.data[i].key)) {
            val cd: *emit.Record = emit.record(f, "syntax.Candidate");
            emit.member(f, cd, "row", number(cands.data[j].row::i64));
            emit.member(f, cd, "alias", number(cands.data[j].alias::i64));
            emit.item(f, candidates, rec_value(cd));
            j = j + 1;
        }
        val e: *emit.Record = emit.record(f, "syntax.Entry");
        emit.member(f, e, "key", emit.Value.text{cands.data[i].key});
        emit.member(f, e, "first", number(i::i64));
        emit.member(f, e, "len", number((j - i)::i64));
        emit.item(f, entries, rec_value(e));
        i = j;
    }
    emit.declare(f, "FORM_TEXT", nil, emit.Value.array{forms_at});
    emit.declare(f, "SOURCES", nil, emit.Value.array{sources.array});
    emit.declare(f, "ALIAS_ROWS", nil, emit.Value.array{aliases});
    emit.declare(f, "ALIAS_COUNT", "u32", number(spelled.len::i64));
    emit.declare(f, "ENTRIES", nil, emit.Value.array{entries});
    emit.declare(f, "CANDIDATES", nil, emit.Value.array{candidates});
    emit.declare(f, "FORM_COUNT", "u32", number(rs.len::i64));
    emit.declare(f, "ENTRY_COUNT", "u32", number(emit.length(entries)::i64));
    emit.declare(f, "CANDIDATE_COUNT", "u32", number(emit.length(candidates)::i64));
    ret err[diag.Refusal].ok{};
}

# the tables of the rows of `in`
# whether the one operand of `r` is a target, the bits of it into `bits`
fun relative_only(r: *rows.Row, bits: *u8) bool {
    if (r.form.operands.len != 1 || r.form.operands.data[0].what != forms.RELATIVE) { ret false; }
    @bits = r.form.operands.data[0].taken.bits;
    ret true;
}

# the row of `r`'s instruction whose one operand is a target of `bits` bits at mode `mode`, its index among the rows
# into `out`, NO_LONGER for no row, and a refusal for two
fun longer_at(in: *Input, r: *rows.Row, mode: u8, bits: u8, out: *u32) err[diag.Refusal] {
    @out = NO_LONGER;
    var i: usize = 0;
    for (i < in.rows.len) {
        val o:    *rows.Row = in.rows.data[i];
        var held: u8        = 0;
        if (o != r && str_equals(o.ins.iclass, r.ins.iclass) && ((o.modes >> mode) & 1) != 0 && relative_only(o, ?held) && held == bits) {
            if (@out != NO_LONGER) { ret err[diag.Refusal].err{diag.refusal(nil, 0, TWO_LONGER, r.key)}; }
            @out = i::u32;
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

val NO_LONGER: u32 = 0xFFFF_FFFF;

# the relaxation table: each row whose one operand is an 8-bit target, jmp's and jcc's, becomes the row of its
# instruction whose target is as wide as the code's operand size at each width it is one at, rel16 in 16-bit code and
# rel32 in 32- and 64-bit code, as llvm-mc 23.1.1 relaxes a jump whose target is out of range or another section's or
# undefined (X86AsmBackend relaxInstruction, Intel SDM 325462-093US Vol 2A JMP, Jcc). a row with no wider row, as
# loop's and jcxz's, is not relaxed
fun relax_table(c: *set.Context, a: *A.Allocator, in: *Input) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "relax");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f: *emit.File = opened.ok;
    emit.uses(f, "masc.core.index");
    emit.uses(f, "masc.core.relax");
    var sources: emit.Pool   = emit.pool(f, "relax.Source");
    var steps:   emit.Pool   = emit.pool(f, "relax.Step");
    var forms_p: emit.Pool   = emit.pool(f, "relax.Steps");
    val table:   *emit.Array = emit.array(f, "relax.Relaxation");
    val keyed:   *emit.Array = emit.keyed(f, "index.Entry");
    var target:  emit.Value  = emit.Value.variant{emit.bare(f, "relax.Source.target")};
    val held:    u32         = emit.pooled(f, ?sources, ?target, 1);
    var count:   u32         = 0;
    var i:       usize       = 0;
    for (i < in.rows.len) {
        val r:    *rows.Row = in.rows.data[i];
        var bits: u8        = 0;
        if (relative_only(r, ?bits) && bits == 8) {
            var each: vector.Vector[emit.Value] = vector.init[emit.Value](a);
            var last: u32                       = NO_LONGER;
            var mode: u8                        = 0;
            for (mode < 3) {
                if (((r.modes >> mode) & 1) != 0) {
                    var wide: u8 = 32;
                    if (mode == 0) { wide = 16; }
                    var longer: u32               = NO_LONGER;
                    val got:    err[diag.Refusal] = longer_at(in, r, mode, wide, ?longer);
                    if (sel got.err) { ret got; }
                    if (longer != NO_LONGER && longer != last) {
                        val st: *emit.Record = emit.record(f, "relax.Step");
                        emit.member(f, st, "row", number(longer::i64));
                        emit.member(f, st, "values", span(f, "relax.Sources", "SOURCES", held, 1));
                        var one:  emit.Value = rec_value(st);
                        val at:   u32        = emit.pooled(f, ?steps, ?one, 1);
                        var form: emit.Value = span(f, "relax.Steps", "STEPS", at, 1);
                        if (!pushed(vector.push[emit.Value](?each, form))) { ret err[diag.Refusal].err{memory(r.key)}; }
                        last = longer;
                    }
                }
                mode = mode + 1;
            }
            if (each.len > 0) {
                val rx: *emit.Record = emit.record(f, "relax.Relaxation");
                emit.member(f, rx, "row", number(i::i64));
                emit.member(f, rx, "operand", number(0));
                emit.member(f, rx, "forms", span(f, "relax.Forms", "FORMS", emit.pooled(f, ?forms_p, each.data, each.len::u32), each.len::u32));
                emit.item(f, table, rec_value(rx));
                val entry: *emit.Record = emit.record(f, "index.Entry");
                emit.member(f, entry, "key", emit.Value.text{r.key});
                emit.member(f, entry, "row", number(count::i64));
                emit.entry(f, keyed, r.key, rec_value(entry));
                count = count + 1;
            }
        }
        i = i + 1;
    }
    emit.declare(f, "SOURCES", nil, emit.Value.array{sources.array});
    emit.declare(f, "STEPS", nil, emit.Value.array{steps.array});
    emit.declare(f, "FORMS", nil, emit.Value.array{forms_p.array});
    emit.declare(f, "RELAXATION_KEYS", nil, emit.Value.array{keyed});
    emit.declare(f, "RELAXATION_ROWS", nil, emit.Value.array{table});
    val all: *emit.Record = emit.record(f, "relax.Relaxations");
    emit.member(f, all, "at", emit.element(f, "RELAXATION_ROWS", 0));
    emit.member(f, all, "len", number(count::i64));
    emit.member(f, all, "keys", span(f, "index.Index", "RELAXATION_KEYS", 0, count));
    emit.declare(f, "RELAXATIONS", "relax.Relaxations", rec_value(all));
    ret err[diag.Refusal].ok{};
}

pub fun generate(c: *set.Context, in: *Input) err[diag.Refusal] {
    var i: usize = 0;
    for (i < in.named.len) {
        val n:    *forms.Named = ?in.named.data[i];
        var most: u32          = class_count(in, n.class);
        if (n.number + 1 > most) { map.insert[str, u32](?in.counts, n.class, n.number + 1); }
        i = i + 1;
    }
    val k: err[diag.Refusal] = keys.generate(c, in.keys);
    if (sel k.err) { ret k; }
    val d: err[diag.Refusal] = dispatch_table(c, c.alloc, in);
    if (sel d.err) { ret d; }
    val r: err[diag.Refusal] = row_table(c, c.alloc, in);
    if (sel r.err) { ret r; }
    val x: err[diag.Refusal] = relax_table(c, c.alloc, in);
    if (sel x.err) { ret x; }
    ret syntax_table(c, c.alloc, in);
}
