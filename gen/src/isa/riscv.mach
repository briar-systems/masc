# the riscv generator
#
# it reads riscv-opcodes, maps its records onto rows, and emits the risc-v
# catalog beside masc's riscv modules: the rows with their operands,
# encodings, requirements and effects, and the codec over them (gen_row), the
# decode dispatch (gen_dispatch), the csr id space (gen_csr), and the
# relaxation rows and the code fill (gen_relax). shared lists, such as an
# operand list many rows have, are emitted once and pointed into. every
# constant-time class is the dependent one: the rows the scalar and vector
# crypto lists make independent under zkt and zvkt are a later overlay.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;
use std.types.view.view_eq_str;

use A: std.allocator;
use std.collections.map;
use std.collections.sort;
use std.collections.vector;
use std.format;

use masc.core.constraint;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.operand;
use masc.core.quantity;
use masc.core.register;

use masc.core.layout;
use riscv_field:    masc.isa.riscv.field;
use riscv_key:      masc.isa.riscv.key;
use riscv_register: masc.isa.riscv.register;

use masc.isa.riscv.gen_register;

use gen.diag;
use gen.dispatch;
use gen.emit;
use gen.isa.riscv.compress;
use gen.isa.riscv.dialect;
use gen.isa.riscv.effects;
use gen.isa.riscv.facts;
use gen.isa.riscv.handles;
use gen.isa.riscv.mapping;
use gen.isa.riscv.overlay;
use gen.isa.riscv.read;
use gen.isa.riscv.spell;
use gen.lines;
use gen.set;

pub val KEYS_MANGLE:    str = "two row keys mangle to one identifier";
pub val NO_RELAX_ROW:   str = "relaxation or fill names a mnemonic with no single row";
pub val CSR_STATE:      str = "csr state row disagrees with riscv-opcodes, or names no csr";
pub val CSR_CORRECTION: str = "overlay csr names no csr of riscv-opcodes, or states the width it already has";

# the riscv set's catalog, as the tables write it
rec Tables {
    alloc:    *A.Allocator;
    catalog:  *mapping.Catalog;
    rows:     *emit.File;
    ids:      emit.Pool;
    alts:     emit.Pool;
    ops:      emit.Pool;
    slices:   emit.Pool;
    words:    emit.Pool;
    access:   emit.Pool;
    terms:    emit.Pool;
    rules:    emit.Pool;
    switches: emit.Pool;
    fixed:    emit.Pool;
    effects:  emit.Pool;
    sides:    emit.Pool;
    keeps:    emit.Pool;
    fields:   *emit.Array;
    table:    *emit.Array;
    # the first row of each mnemonic and how many it has
    first: map.Map[str, u32];
    count: map.Map[str, u32];
    # the run in ALTERNATIVES each row's requirement is
    reqs:    vector.Vector[u32];
    req_len: vector.Vector[u32];
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun memory() diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, nil);
}

fun number(n: i64) emit.Value {
    ret emit.Value.number{n};
}

fun name(s: str) emit.Value {
    ret emit.Value.name{s};
}

fun boolean(b: bool) emit.Value {
    if (b) { ret name("true"); }
    ret name("false");
}

fun role(r: operand.Role) emit.Value {
    if (r == operand.READ)       { ret name("operand.READ"); }
    if (r == operand.WRITE)      { ret name("operand.WRITE"); }
    if (r == operand.READ_WRITE) { ret name("operand.READ_WRITE"); }
    ret name("operand.NONE");
}

fun transfer(t: effect.Transfer) emit.Value {
    if (t == effect.JUMP)   { ret name("effect.JUMP"); }
    if (t == effect.CALL)   { ret name("effect.CALL"); }
    if (t == effect.RETURN) { ret name("effect.RETURN"); }
    if (t == effect.TRAP)   { ret name("effect.TRAP"); }
    ret name("effect.NONE");
}

fun target(t: effect.Target) emit.Value {
    if (t == effect.DIRECT)   { ret name("effect.DIRECT"); }
    if (t == effect.INDIRECT) { ret name("effect.INDIRECT"); }
    ret name("effect.UNTARGETED");
}

fun latency(l: effect.Latency) emit.Value {
    if (l == effect.FEW)    { ret name("effect.FEW"); }
    if (l == effect.MANY)   { ret name("effect.MANY"); }
    if (l == effect.SERIAL) { ret name("effect.SERIAL"); }
    ret name("effect.ONE");
}

# an operand index, field.NO_OPERAND by name
fun index(op: u8) emit.Value {
    if (op == field.NO_OPERAND) { ret name("field.NO_OPERAND"); }
    ret number(op::i64);
}

fun record(f: *emit.File, of: str) *emit.Record {
    ret emit.record(f, of);
}

fun member(f: *emit.File, r: *emit.Record, n: str, v: emit.Value) {
    emit.member(f, r, n, v);
}

fun rec_value(r: *emit.Record) emit.Value {
    ret emit.Value.record{r};
}

# the alternative of a requirement that holds every atom of `all` and excludes none
fun alternative(f: *emit.File, all: emit.Value) emit.Value {
    val r: *emit.Record = record(f, "requirement.Alternative");
    member(f, r, "all", all);
    member(f, r, "none", name("requirement.NO_IDS"));
    ret rec_value(r);
}

# a pointer and count record over run `at` of `count` items of the array declared `array`
fun span(f: *emit.File, of: str, array: str, at: u32, count: u32) emit.Value {
    val r: *emit.Record = record(f, of);
    member(f, r, "at", emit.element(f, array, at));
    member(f, r, "len", number(count::i64));
    ret rec_value(r);
}

# a run as `span`, or the shared constant `empty` of `of` when it holds no items
fun span_or(f: *emit.File, of: str, empty: str, array: str, at: u32, count: u32) emit.Value {
    if (count == 0) { ret name(empty); }
    ret span(f, of, array, at, count);
}

# the path the overlay names array `at` by
fun named(at: ptr) opt[str] {
    var i: u32 = 0;
    for (i < overlay.NAMED_COUNT) {
        if (overlay.NAMED[i].at == at) { ret opt[str].some{overlay.NAMED[i].path}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

# a static list a riscv field layout points into, spelled from the overlay, or `empty` when it has none
fun list(t: *Tables, of: str, empty: str, at: ptr, count: u32) res[emit.Value, diag.Refusal] {
    val f: *emit.File = t.rows;
    if (count == 0) { ret res[emit.Value, diag.Refusal].ok{name(empty)}; }
    val path: opt[str] = named(at);
    if (sel path.none) { ret res[emit.Value, diag.Refusal].err{diag.refusal(nil, 0, mapping.UNNAMED_ARRAY, of)}; }
    ret res[emit.Value, diag.Refusal].ok{span(f, of, path.some, 0, count)};
}

fun immediate(t: *Tables, imm: *operand.Immediate, fixup: str) res[emit.Value, diag.Refusal] {
    val f: *emit.File   = t.rows;
    val r: *emit.Record = record(f, "operand.Immediate");
    member(f, r, "bits", number(imm.bits::i64));
    if (imm.sign == operand.SIGNED) { member(f, r, "sign", name("operand.SIGNED")); }
    or                              { member(f, r, "sign", name("operand.UNSIGNED")); }
    member(f, r, "scale", number(imm.scale::i64));
    member(f, r, "bias", number(imm.bias));
    if (fixup == nil) { member(f, r, "fixup", name("operand.NO_FIXUP")); }
    or                { member(f, r, "fixup", name(fixup)); }
    member(f, r, "format", name("operand.INTEGER"));
    val excluded: res[emit.Value, diag.Refusal] = list(t, "operand.Integers", "operand.NO_INTEGERS", imm.excluded.at, imm.excluded.len);
    if (sel excluded.err) { ret excluded; }
    member(f, r, "excluded", excluded.ok);
    ret res[emit.Value, diag.Refusal].ok{rec_value(r)};
}

# element width `e` as its literal
fun element(f: *emit.File, e: operand.Element) emit.Value {
    if (sel e.fixed) { ret emit.Value.variant{emit.variant(f, "operand.Element.fixed", number(e.fixed::i64))}; }
    if (sel e.state) { ret emit.Value.variant{emit.variant(f, "operand.Element.state", number(e.state::i64))}; }
    ret emit.Value.variant{emit.bare(f, "operand.Element.none")};
}

# span `s` as its literal
fun span_of(f: *emit.File, s: operand.Span) emit.Value {
    if (sel s.fixed)  { ret emit.Value.variant{emit.variant(f, "operand.Span.fixed", number(s.fixed::i64))}; }
    if (sel s.scaled) { ret emit.Value.variant{emit.bare(f, "operand.Span.scaled")}; }
    if (sel s.group)  { ret emit.Value.variant{emit.variant(f, "operand.Span.group", number(s.group::i64))}; }
    ret emit.Value.variant{emit.bare(f, "operand.Span.packed")};
}

fun register_shape(t: *Tables, class: u16, first: u32, count: u32, excluded: operand.Numbers, op: *mapping.Operand) res[emit.Value, diag.Refusal] {
    val f: *emit.File   = t.rows;
    val r: *emit.Record = record(f, "operand.Register");
    member(f, r, "classes", span(f, "operand.Classes", "CLASSES", class::u32, 1));
    member(f, r, "first", number(first::i64));
    member(f, r, "count", number(count::i64));
    val ex: res[emit.Value, diag.Refusal] = list(t, "operand.Numbers", "operand.NO_NUMBERS", excluded.at, excluded.len);
    if (sel ex.err) { ret ex; }
    member(f, r, "excluded", ex.ok);
    member(f, r, "fields", number(op.fields::i64));
    member(f, r, "element", element(f, op.element));
    member(f, r, "span", span_of(f, op.span));
    ret res[emit.Value, diag.Refusal].ok{emit.Value.variant{emit.variant(f, "operand.Shape.register", rec_value(r))}};
}

# the shape of operand `op`
fun shape(t: *Tables, op: *mapping.Operand) res[emit.Value, diag.Refusal] {
    val f: *emit.File = t.rows;
    if (op.use == overlay.REGISTER || op.use == overlay.SREG) { ret register_shape(t, op.class, op.position.first, op.position.count, op.position.excluded, op); }
    if (op.use == mapping.IMPLICIT)                           { ret register_shape(t, op.class, 0, 0, operand.NO_NUMBERS, op); }
    if (op.use == mapping.MARKER)                             { ret res[emit.Value, diag.Refusal].ok{emit.Value.variant{emit.variant(f, "operand.Shape.marker", name(op.fixup))}}; }
    if (op.use == overlay.CSR) {
        val r: *emit.Record = record(f, "operand.Typed");
        member(f, r, "space", name("riscv_csr.SPACE"));
        member(f, r, "bits", number(op.layout.value.bits::i64));
        member(f, r, "fixup", name("operand.NO_FIXUP"));
        ret res[emit.Value, diag.Refusal].ok{emit.Value.variant{emit.variant(f, "operand.Shape.id", rec_value(r))}};
    }
    if (op.use == overlay.CHOICE) {
        val e:    *operand.Enumeration = ?op.choice.values;
        val path: opt[str]             = named(e.members);
        val keys: opt[str]             = named(e.names.at);
        if (sel path.none) { ret res[emit.Value, diag.Refusal].err{diag.refusal(nil, 0, mapping.UNNAMED_ARRAY, op.arg)}; }
        if (sel keys.none) { ret res[emit.Value, diag.Refusal].err{diag.refusal(nil, 0, mapping.UNNAMED_ARRAY, op.arg)}; }
        val r: *emit.Record = record(f, "operand.Enumeration");
        member(f, r, "members", emit.element(f, path.some, 0));
        member(f, r, "count", number(e.count::i64));
        member(f, r, "mask", boolean(e.mask));
        member(f, r, "names", span(f, "index.Index", keys.some, 0, e.names.len));
        ret res[emit.Value, diag.Refusal].ok{emit.Value.variant{emit.variant(f, "operand.Shape.enumerant", rec_value(r))}};
    }
    if (op.use == overlay.ADJUST) {
        val imm: res[emit.Value, diag.Refusal] = immediate(t, op.adjust, nil);
        if (sel imm.err) { ret imm; }
        ret res[emit.Value, diag.Refusal].ok{emit.Value.variant{emit.variant(f, "operand.Shape.immediate", imm.ok)}};
    }
    val imm: res[emit.Value, diag.Refusal] = immediate(t, ?op.layout.value, op.fixup);
    if (sel imm.err) { ret imm; }
    if (op.relative) {
        val r: *emit.Record = record(f, "operand.Relative");
        member(f, r, "offset", imm.ok);
        member(f, r, "anchor", name("operand.START"));
        ret res[emit.Value, diag.Refusal].ok{emit.Value.variant{emit.variant(f, "operand.Shape.relative", rec_value(r))}};
    }
    ret res[emit.Value, diag.Refusal].ok{emit.Value.variant{emit.variant(f, "operand.Shape.immediate", imm.ok)}};
}

fun slice(f: *emit.File, op: u32, lo: u8, len: u8, at: u8) emit.Value {
    val r: *emit.Record = record(f, "field.Slice");
    member(f, r, "operand", number(op::i64));
    member(f, r, "part", name("field.NUMBER"));
    member(f, r, "lo", number(lo::i64));
    member(f, r, "len", number(len::i64));
    member(f, r, "at", number(at::i64));
    member(f, r, "invert", name("false"));
    ret rec_value(r);
}

# the slices of `row`'s operands, which the unit kind packs
fun slices(t: *Tables, row: *mapping.Row, out: *vector.Vector[emit.Value]) err[diag.Refusal] {
    val f: *emit.File = t.rows;
    var i: usize      = 0;
    for (i < row.operands.len) {
        val op:     *mapping.Operand = ?row.operands.data[i];
        var pieces: layout.Pieces    = layout.NO_PIECES;
        if (op.use == overlay.REGISTER) {
            if (!pushed(vector.push[emit.Value](out, slice(f, i::u32, 0, op.position.len, op.position.at)))) { ret err[diag.Refusal].err{memory()}; }
        }
        or (op.use == overlay.IMMEDIATE || op.use == overlay.CSR) { pieces = op.layout.pieces; }
        or (op.use == overlay.CHOICE)                             { pieces = op.choice.pieces; }
        var k: u32 = 0;
        for (k < pieces.len) {
            val p: layout.Piece = pieces.at[k];
            if (!pushed(vector.push[emit.Value](out, slice(f, i::u32, p.lo, p.len, p.at)))) { ret err[diag.Refusal].err{memory()}; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the run in ALTERNATIVES of `row`'s requirement
fun requirement(t: *Tables, row: *mapping.Row, at: *u32, len: *u32) {
    val f:    *emit.File                = t.rows;
    var alts: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
    var i:    usize                     = 0;
    for (i < row.requirement.alternatives.len) {
        val alt: *mapping.Alternative      = row.requirement.alternatives.data[i];
        var ids: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
        var k:   usize                     = 0;
        for (k < alt.ids.len) {
            val n: str = mapping.atom_name(f.alloc, t.catalog.facts, alt.ids.data[k]);
            vector.push[emit.Value](?ids, name(emit.concat(f, "riscv_extension.id.", emit.ident(f, n))));
            k = k + 1;
        }
        val first: u32 = emit.pooled(f, ?t.ids, ids.data, ids.len::u32);
        vector.push[emit.Value](?alts, alternative(f, span_or(f, "requirement.Ids", "requirement.NO_IDS", "IDS", first, ids.len::u32)));
        i = i + 1;
    }
    @len = alts.len::u32;
    @at  = 0;
    if (alts.len > 0) { @at = emit.pooled(f, ?t.alts, alts.data, alts.len::u32); }
}

fun requirement_value(f: *emit.File, at: u32, len: u32) emit.Value {
    ret requirement_span(f, "ALTERNATIVES", at, len);
}

# a requirement over a run of alternatives of `array`, the shared constant when it has none
fun requirement_span(f: *emit.File, array: str, at: u32, len: u32) emit.Value {
    if (len == 0) { ret name("requirement.NO_ALTERNATIVES"); }
    ret span(f, "requirement.Requirement", array, at, len);
}

# a register set over the file's rows, as words in WORDS
fun set_value(t: *Tables, rows: *vector.Vector[u32]) emit.Value {
    val f: *emit.File = t.rows;
    if (rows.len == 0) { ret empty_set(f); }
    var words: [4]u64;
    var top:   u32   = 0;
    var i:     usize = 0;
    for (i < rows.len) {
        val r: u32 = rows.data[i];
        words[r / 64] = words[r / 64] | (1::u64 << (r % 64)::u64);
        if (r / 64 + 1 > top) { top = r / 64 + 1; }
        i = i + 1;
    }
    var items: [4]emit.Value;
    var k:     u32 = 0;
    for (k < top) {
        items[k] = emit.Value.hex{words[k]};
        k        = k + 1;
    }
    val at: u32          = emit.pooled(f, ?t.words, ?items[0], top);
    val r:  *emit.Record = record(f, "effect.Set");
    member(f, r, "words", emit.element(f, "WORDS", at));
    member(f, r, "len", number(top::i64));
    ret rec_value(r);
}

fun empty_set(f: *emit.File) emit.Value {
    ret name("effect.NO_WORDS");
}

fun scaled(f: *emit.File, s: quantity.Scaled) emit.Value {
    val r: *emit.Record = record(f, "quantity.Scaled");
    member(f, r, "fixed", number(s.fixed::i64));
    member(f, r, "per", number(s.per::i64));
    member(f, r, "scale", number(s.scale::i64));
    ret rec_value(r);
}

fun access(f: *emit.File, a: *mapping.Access) emit.Value {
    val w: *emit.Record = record(f, "effect.Width");
    member(f, w, "element", scaled(f, a.element));
    if (a.one) { member(f, w, "count", emit.Value.variant{emit.bare(f, "effect.Count.one")}); }
    or         { member(f, w, "count", emit.Value.variant{emit.bare(f, "effect.Count.unstated")}); }
    val r: *emit.Record = record(f, "effect.Access");
    member(f, r, "role", role(a.role));
    member(f, r, "operand", index(a.address));
    if (a.base == effect.NO_ROW) { member(f, r, "base", name("effect.NO_ROW")); }
    or                           { member(f, r, "base", number(a.base::i64)); }
    member(f, r, "forming", emit.Value.hex{a.forming::u64});
    member(f, r, "width", rec_value(w));
    member(f, r, "governor", index(a.governor));
    ret rec_value(r);
}

# the terms of one rule as a run of TERMS
fun terms(t: *Tables, ts: *vector.Vector[mapping.Term]) emit.Value {
    val f:     *emit.File                = t.rows;
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
    var k:     usize                     = 0;
    for (k < ts.len) {
        val x: *mapping.Term = ?ts.data[k];
        val m: *emit.Record  = record(f, "effect.Term");
        member(f, m, "operand", number(x.operand::i64));
        if (sel x.test.register)  { member(f, m, "test", emit.Value.variant{emit.variant(f, "effect.Test.register", set_value(t, ?x.test.register))}); }
        or (sel x.test.enumerant) { member(f, m, "test", emit.Value.variant{emit.variant(f, "effect.Test.enumerant", number(x.test.enumerant::i64))}); }
        vector.push[emit.Value](?items, rec_value(m));
        k = k + 1;
    }
    if (items.len == 0) { ret name("effect.NO_TERMS"); }
    ret span(f, "effect.Terms", "TERMS", emit.pooled(f, ?t.terms, items.data, items.len::u32), items.len::u32);
}

# the control rules of an effect as a run of RULES
fun rules(t: *Tables, rs: *vector.Vector[mapping.Rule]) emit.Value {
    val f:     *emit.File                = t.rows;
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
    var i:     usize                     = 0;
    for (i < rs.len) {
        val r:    *mapping.Rule = ?rs.data[i];
        val rule: *emit.Record  = record(f, "effect.Rule");
        member(f, rule, "terms", terms(t, ?r.terms));
        member(f, rule, "transfer", transfer(r.transfer));
        member(f, rule, "target", target(r.target));
        member(f, rule, "conditional", boolean(r.conditional));
        vector.push[emit.Value](?items, rec_value(rule));
        i = i + 1;
    }
    if (items.len == 0) { ret name("effect.NO_RULES"); }
    ret span(f, "effect.Rules", "RULES", emit.pooled(f, ?t.rules, items.data, items.len::u32), items.len::u32);
}

# registers read and written as an effect.Touched
fun touched(t: *Tables, read: *vector.Vector[u32], written: *vector.Vector[u32]) emit.Value {
    if (read.len == 0 && written.len == 0) { ret name("effect.NO_TOUCHED"); }
    val r: *emit.Record = record(t.rows, "effect.Touched");
    member(t.rows, r, "read", set_value(t, read));
    member(t.rows, r, "written", set_value(t, written));
    ret rec_value(r);
}

# the register rules of an effect as a run of REGISTER_RULES
fun register_rules(t: *Tables, rs: *vector.Vector[mapping.RegisterRule]) emit.Value {
    val f:     *emit.File                = t.rows;
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
    var i:     usize                     = 0;
    for (i < rs.len) {
        val r:    *mapping.RegisterRule = ?rs.data[i];
        val rule: *emit.Record          = record(f, "effect.RegisterRule");
        member(f, rule, "terms", terms(t, ?r.terms));
        member(f, rule, "touched", touched(t, ?r.read, ?r.written));
        vector.push[emit.Value](?items, rec_value(rule));
        i = i + 1;
    }
    if (items.len == 0) { ret name("effect.NO_REGISTER_RULES"); }
    ret span(f, "effect.RegisterRules", "REGISTER_RULES", emit.pooled(f, ?t.switches, items.data, items.len::u32), items.len::u32);
}

# the index in EFFECTS of `row`'s effect
fun effect_of(t: *Tables, row: *mapping.Row) u32 {
    val f:        *emit.File      = t.rows;
    val e:        *mapping.Effect = ?row.effect;
    val implicit: *emit.Record    = record(f, "effect.Ruled");
    member(f, implicit, "otherwise", touched(t, ?e.read, ?e.written));
    member(f, implicit, "rules", register_rules(t, ?e.switches));
    member(f, implicit, "may", touched(t, ?e.may.read, ?e.may.written));
    member(f, implicit, "must", touched(t, ?e.must.read, ?e.must.written));
    val flags: *emit.Record = record(f, "effect.Flags");
    member(f, flags, "read", empty_set(f));
    member(f, flags, "written", empty_set(f));
    member(f, flags, "undefined", empty_set(f));
    member(f, flags, "kept", empty_set(f));
    var accesses: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
    var i:        usize                     = 0;
    for (i < e.accesses.len) {
        vector.push[emit.Value](?accesses, access(f, ?e.accesses.data[i]));
        i = i + 1;
    }
    var memory: emit.Value = name("effect.NO_ACCESSES");
    if (accesses.len > 0) { memory = span(f, "effect.Accesses", "ACCESSES", emit.pooled(f, ?t.access, accesses.data, accesses.len::u32), accesses.len::u32); }
    val control: *emit.Record = record(f, "effect.Control");
    member(f, control, "transfer", transfer(e.control.transfer));
    member(f, control, "target", target(e.control.target));
    member(f, control, "conditional", boolean(e.control.conditional));
    member(f, control, "operand", index(e.control.operand));
    member(f, control, "rules", rules(t, ?e.rules));
    var stack: emit.Value = emit.Value.variant{emit.bare(f, "effect.Stack.none")};
    if (e.delta != field.NO_OPERAND) {
        val d: *emit.Record = record(f, "effect.Delta");
        member(f, d, "bytes", number(0));
        member(f, d, "operand", number(e.delta::i64));
        stack = emit.Value.variant{emit.variant(f, "effect.Stack.delta", rec_value(d))};
    }
    var fixeds: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
    i = 0;
    for (i < e.fixed.len) {
        val x: *emit.Record = record(f, "effect.Fixed");
        member(f, x, "operand", number(e.fixed.data[i].operand::i64));
        member(f, x, "register", number(e.fixed.data[i].register::i64));
        vector.push[emit.Value](?fixeds, rec_value(x));
        i = i + 1;
    }
    var fixed: emit.Value = name("effect.NO_FIXEDS");
    if (fixeds.len > 0) { fixed = span(f, "effect.Fixeds", "FIXED", emit.pooled(f, ?t.fixed, fixeds.data, fixeds.len::u32), fixeds.len::u32); }
    val r: *emit.Record = record(f, "effect.Effect");
    member(f, r, "implicit", emit.Value.variant{emit.variant(f, "effect.Registers.ruled", rec_value(implicit))});
    member(f, r, "flags", rec_value(flags));
    member(f, r, "memory", memory);
    member(f, r, "control", rec_value(control));
    member(f, r, "stack", stack);
    member(f, r, "latency", latency(e.latency));
    member(f, r, "fixed", fixed);
    var one: [1]emit.Value = [1]emit.Value{rec_value(r)};
    ret emit.pooled(f, ?t.effects, ?one[0], 1);
}

fun permit(p: constraint.Permit) emit.Value {
    if (p == constraint.BY_WIDTHS)  { ret name("constraint.BY_WIDTHS"); }
    if (p == constraint.SAME_WIDTH) { ret name("constraint.SAME_WIDTH"); }
    ret name("constraint.DISJOINT");
}

fun side(f: *emit.File, s: constraint.Side) emit.Value {
    val r: *emit.Record = record(f, "constraint.Side");
    member(f, r, "operand", number(s.operand::i64));
    member(f, r, "part", name("constraint.WHOLE"));
    ret rec_value(r);
}

# the register constraints of `row` as a run of CONSTRAINTS, each against list a run of SIDES and each mask term a run of TERMS
fun constraints_of(t: *Tables, row: *mapping.Row) emit.Value {
    val f:     *emit.File                = t.rows;
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
    var i:     usize                     = 0;
    for (i < row.keeps.len) {
        val k:       *mapping.Keep = ?row.keeps.data[i];
        var against: emit.Value    = emit.Value.variant{emit.variant(f, "constraint.Against.register", number(k.register::i64))};
        if (k.register == effect.NO_ROW) {
            var sides: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
            var j:     usize                     = 0;
            for (j < k.against.len) {
                vector.push[emit.Value](?sides, side(f, k.against.data[j]));
                j = j + 1;
            }
            val run: emit.Value = span(f, "constraint.Sides", "SIDES", emit.pooled(f, ?t.sides, sides.data, sides.len::u32), sides.len::u32);
            against = emit.Value.variant{emit.variant(f, "constraint.Against.sides", run)};
        }
        var when: emit.Value = name("effect.NO_TERMS");
        if (k.mask != field.NO_OPERAND) {
            val m: *emit.Record = record(f, "effect.Term");
            member(f, m, "operand", number(k.mask::i64));
            member(f, m, "test", emit.Value.variant{emit.variant(f, "effect.Test.enumerant", name("riscv_field.MASKED"))});
            var one: [1]emit.Value = [1]emit.Value{rec_value(m)};
            when = span(f, "effect.Terms", "TERMS", emit.pooled(f, ?t.terms, ?one[0], 1), 1);
        }
        val c: *emit.Record = record(f, "constraint.Constraint");
        member(f, c, "side", side(f, k.side));
        member(f, c, "against", against);
        member(f, c, "permit", permit(k.permit));
        member(f, c, "when", when);
        vector.push[emit.Value](?items, rec_value(c));
        i = i + 1;
    }
    if (items.len == 0) { ret name("constraint.NO_CONSTRAINTS"); }
    ret span(f, "constraint.Constraints", "CONSTRAINTS", emit.pooled(f, ?t.keeps, items.data, items.len::u32), items.len::u32);
}

# the bits of the floating-point format `text[at..at + len]` names as a mnemonic's suffix: h and bf16 a half, s and w a
# single, d a double and q a quad. 0 for a suffix naming no format
fun format_bits(text: str, at: usize, len: usize) u16 {
    val v: View = view(?text[at], len);
    if (view_eq_str(v, "h") || view_eq_str(v, "bf16")) { ret 16; }
    if (view_eq_str(v, "s") || view_eq_str(v, "w"))    { ret 32; }
    if (view_eq_str(v, "d"))                           { ret 64; }
    if (view_eq_str(v, "q"))                           { ret 128; }
    ret 0;
}

# the bits of the format a floating-point write of `mnemonic` leaves in its destination: the letter after `fl` of a
# load, as flw, c.fldsp and flh, else its first suffix, as fli.s, the destination's format, as fadd.s, fcvt.s.d and fmv.w.x. 0
# for a mnemonic stating none, as vfmv.f.s, whose width is the element width state sets
fun result_bits(mnemonic: str) u16 {
    var at:  usize = 0;
    val len: usize = str_len(mnemonic);
    if (len > 2 && mnemonic[0] == 'c' && mnemonic[1] == '.') { at = 2; }
    val load: bool = len >= at + 3 && mnemonic[at] == 'f' && mnemonic[at + 1] == 'l';
    if (load && (len == at + 3 || (len == at + 5 && mnemonic[at + 3] == 's' && mnemonic[at + 4] == 'p'))) { ret format_bits(mnemonic, at + 2, 1); }
    var dot: usize = at;
    for (dot < len && mnemonic[dot] != '.') { dot = dot + 1; }
    if (dot == len) { ret 0; }
    var end: usize = dot + 1;
    for (end < len && mnemonic[end] != '.') { end = end + 1; }
    ret format_bits(mnemonic, dot + 1, end - dot - 1);
}

# what operand `op` of row `r` leaves where it writes. no risc-v encoding family decides the rest of a bank, as x86 vex
# does, so every write extends as its register's row states. a write of an f register holds the result of its format
# in its low bits and nan-boxes it, setting every bit above (src/unpriv/d-st-ext.adoc, "NaN Boxing of Narrower
# Values": a narrower transfer, compute or sign-injection result, n < FLEN, is held in the low n bits with the upper
# bits all ones), so each f, d, q, zfh and zfhmin row writing an f register states its format's width and ONES above
fun write_of(f: *emit.File, r: *mapping.Row, op: *mapping.Operand) emit.Value {
    val register_use: bool = op.use == overlay.REGISTER || op.use == overlay.SREG || op.use == mapping.IMPLICIT;
    if (!register_use || (op.role & operand.WRITE) == 0 || op.class::u32 >= riscv_register.FILE.class_count) { ret name("operand.AS_ROW"); }
    if (riscv_register.FILE.classes[op.class].kind != register.FLOAT)                                        { ret name("operand.AS_ROW"); }
    val bits: u16 = result_bits(r.mnemonic);
    if (bits == 0) { ret name("operand.AS_ROW"); }
    val w: *emit.Record = record(f, "operand.Write");
    member(f, w, "extend", emit.Value.variant{emit.bare(f, "opt[register.Extend].none")});
    member(f, w, "result", number(bits::i64));
    member(f, w, "above", name("register.ONES"));
    ret rec_value(w);
}

# row `i` of the catalog written into the tables
fun row(t: *Tables, i: u32) err[diag.Refusal] {
    val f:   *emit.File                = t.rows;
    val r:   *mapping.Row              = t.catalog.rows.data[i];
    var ops: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
    var k:   usize                     = 0;
    for (k < r.operands.len) {
        val op:     *mapping.Operand              = ?r.operands.data[k];
        val shaped: res[emit.Value, diag.Refusal] = shape(t, op);
        if (sel shaped.err) { ret err[diag.Refusal].err{diag.refusal(r.record.path, r.record.line, shaped.err.message, shaped.err.subject)}; }
        val o: *emit.Record = record(f, "operand.Operand");
        member(f, o, "shape", shaped.ok);
        member(f, o, "role", role(op.role));
        member(f, o, "width", number(0));
        member(f, o, "quantity", name("operand.ONE"));
        member(f, o, "write", write_of(f, r, op));
        vector.push[emit.Value](?ops, rec_value(o));
        k = k + 1;
    }
    var operands: emit.Value = name("row.NO_OPERANDS");
    if (ops.len > 0) { operands = span(f, "row.Operands", "OPERANDS", emit.pooled(f, ?t.ops, ops.data, ops.len::u32), ops.len::u32); }
    var sl:     vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
    val sliced: err[diag.Refusal]         = slices(t, r, ?sl);
    if (sel sliced.err) { ret sliced; }
    var slice_list: emit.Value = name("field.NO_SLICES");
    if (sl.len > 0) { slice_list = span(f, "field.Slices", "SLICES", emit.pooled(f, ?t.slices, sl.data, sl.len::u32), sl.len::u32); }
    val fl: *emit.Record = record(f, "field.Field");
    member(f, fl, "kind", number(r.kind::i64));
    member(f, fl, "width", number(r.width::i64));
    member(f, fl, "fixed", emit.Value.hex{r.match});
    member(f, fl, "mask", emit.Value.hex{r.mask});
    member(f, fl, "slices", slice_list);
    member(f, fl, "operand", index(r.whole));
    member(f, fl, "param", emit.Value.hex{r.param});
    emit.item(f, t.fields, rec_value(fl));
    var at:  u32 = 0;
    var len: u32 = 0;
    requirement(t, r, ?at, ?len);
    vector.push[u32](?t.reqs, at);
    vector.push[u32](?t.req_len, len);
    val e:  u32          = effect_of(t, r);
    val rr: *emit.Record = record(f, "row.Row");
    member(f, rr, "key", emit.Value.text{r.key});
    member(f, rr, "mnemonic", emit.Value.text{r.mnemonic});
    member(f, rr, "operands", operands);
    member(f, rr, "encoding", span(f, "field.Fields", "FIELDS", i, 1));
    member(f, rr, "requires", requirement_value(f, at, len));
    member(f, rr, "effect", emit.element(f, "EFFECTS", e));
    member(f, rr, "ct", emit.Value.address{"ct.DEPENDENT"});
    member(f, rr, "constraints", constraints_of(t, r));
    if (r.hint) { member(f, rr, "flags", name("row.HINT")); }
    or          { member(f, rr, "flags", number(0)); }
    member(f, rr, "index", number(i::i64));
    emit.item(f, t.table, rec_value(rr));
    ret err[diag.Refusal].ok{};
}

# the dispatch over the rows, every row one cube over the instruction's bits and the context word, but a marked row,
# whose bits are its base's and decode as its base
fun dispatched(t: *Tables, c: *set.Context) err[diag.Refusal] {
    val rows:  *vector.Vector[*mapping.Row]    = ?t.catalog.rows;
    val got:   res[*u64, A.Error]              = A.allocate[u64](t.alloc, rows.len * 4 + 1);
    val cubes: res[*dispatch.Cube, A.Error]    = A.allocate[dispatch.Cube](t.alloc, rows.len + 1);
    val pats:  res[*dispatch.Pattern, A.Error] = A.allocate[dispatch.Pattern](t.alloc, rows.len + 1);
    if (sel got.err)   { ret err[diag.Refusal].err{memory()}; }
    if (sel cubes.err) { ret err[diag.Refusal].err{memory()}; }
    if (sel pats.err)  { ret err[diag.Refusal].err{memory()}; }
    val words: *u64  = got.ok;
    var n:     usize = 0;
    var i:     usize = 0;
    for (i < rows.len) {
        val r: *mapping.Row = rows.data[i];
        if (r.mark == nil) {
            words[n * 4]     = r.match;
            words[n * 4 + 1] = r.context;
            words[n * 4 + 2] = r.mask;
            words[n * 4 + 3] = r.context_mask;
            cubes.ok[n]      = dispatch.Cube{value: ?words[n * 4], mask: ?words[n * 4 + 2]};
            pats.ok[n]       = dispatch.Pattern{row: i::u32, name: r.mnemonic, cubes: ?cubes.ok[n], count: 1};
            n                = n + 1;
        }
        i = i + 1;
    }
    var keys: [15]dispatch.Key;
    var k:    u32 = 0;
    for (k < 15) {
        keys[k] = dispatch.Key{name: riscv_key.KEYS[k].name, word: 0, lo: riscv_key.POSITIONS[k].lo, len: riscv_key.POSITIONS[k].len};
        k       = k + 1;
    }
    var space: dispatch.Space                    = dispatch.Space{words: 2, keys: ?keys[0], key_count: 15};
    val built: res[dispatch.Built, diag.Refusal] = dispatch.build(t.alloc, ?space, pats.ok, n::u32);
    if (sel built.err) { ret err[diag.Refusal].err{built.err}; }
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "dispatch");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f: *emit.File = opened.ok;
    emit.uses(f, "riscv_key: masc.isa.riscv.key");
    var b: dispatch.Built = built.ok;
    dispatch.declare(f, "DISPATCH", "riscv_key.KEYS", 15, ?b);
    ret err[diag.Refusal].ok{};
}

# the rows of the catalog, their pools and the codec
# the handle of row `i`, a constant named by its key's identifier, refused when another row's key has that identifier
fun handle(t: *Tables, taken: *map.Map[str, u32], i: u32) err[diag.Refusal] {
    val f:     *emit.File = t.rows;
    val key:   str        = t.catalog.rows.data[i].key;
    val id:    str        = emit.ident(f, key);
    val prior: opt[*u32]  = map.get[str, u32](taken, ?id);
    if (sel prior.some) {
        val both: res[str, StrError] = str_join(t.alloc, t.catalog.rows.data[@prior.some].key, " and ", key);
        if (sel both.err) { ret err[diag.Refusal].err{memory()}; }
        ret err[diag.Refusal].err{diag.refusal(nil, 0, KEYS_MANGLE, both.ok)};
    }
    val inserted: res[bool, A.Error] = map.insert[str, u32](taken, id, i);
    if (sel inserted.err) { ret err[diag.Refusal].err{memory()}; }
    emit.declare(f, id, "*row.Row", emit.element(f, "ROWS", i));
    ret err[diag.Refusal].ok{};
}

fun rows(t: *Tables, c: *set.Context) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "row");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f: *emit.File = opened.ok;
    t.rows     = f;
    t.ids      = emit.pool(f, "requirement.Id");
    t.alts     = emit.pool(f, "requirement.Alternative");
    t.ops      = emit.pool(f, "operand.Operand");
    t.slices   = emit.pool(f, "field.Slice");
    t.words    = emit.pool(f, "u64");
    t.access   = emit.pool(f, "effect.Access");
    t.terms    = emit.pool(f, "effect.Term");
    t.rules    = emit.pool(f, "effect.Rule");
    t.switches = emit.pool(f, "effect.RegisterRule");
    t.fixed    = emit.pool(f, "effect.Fixed");
    t.effects  = emit.pool(f, "effect.Effect");
    t.sides    = emit.pool(f, "constraint.Side");
    t.keeps    = emit.pool(f, "constraint.Constraint");
    t.fields   = emit.array(f, "field.Field");
    t.table    = emit.array(f, "row.Row");
    t.reqs     = vector.init[u32](t.alloc);
    t.req_len  = vector.init[u32](t.alloc);
    emit.uses(f, "masc.core.constraint");
    emit.uses(f, "masc.core.ct");
    emit.uses(f, "masc.core.effect");
    emit.uses(f, "masc.core.extension");
    emit.uses(f, "masc.core.requirement");
    emit.uses(f, "masc.core.field");
    emit.uses(f, "masc.core.index");
    emit.uses(f, "masc.core.operand");
    emit.uses(f, "masc.core.register");
    emit.uses(f, "masc.core.quantity");
    emit.uses(f, "masc.core.row");
    emit.uses(f, "masc.core.dispatch");
    emit.uses(f, "masc.isa.riscv.gen_dispatch");
    emit.uses(f, "riscv_csr: masc.isa.riscv.csr");
    emit.uses(f, "riscv_extension: masc.isa.riscv.extension");
    emit.uses(f, "riscv_field: masc.isa.riscv.field");
    emit.uses(f, "riscv_fixup: masc.isa.riscv.fixup");
    emit.uses(f, "riscv_register: masc.isa.riscv.register");
    emit.uses(f, "std.types.bool.false");
    emit.uses(f, "std.types.bool.true");
    emit.uses(f, "std.types.option.opt");
    val classes: *emit.Array = emit.array(f, "u16");
    var k:       u32         = 0;
    for (k < riscv_register.FILE.class_count) {
        emit.item(f, classes, number(k::i64));
        k = k + 1;
    }
    emit.declare(f, "CLASSES", nil, emit.Value.array{classes});
    val keys:  *emit.Array       = emit.keyed(f, "index.Entry");
    var taken: map.Map[str, u32] = map.init[str, u32](t.alloc);
    var i:     u32               = 0;
    for (i < t.catalog.rows.len::u32) {
        val done: err[diag.Refusal] = row(t, i);
        if (sel done.err) { ret done; }
        val entry: *emit.Record = record(f, "index.Entry");
        member(f, entry, "key", emit.Value.text{t.catalog.rows.data[i].key});
        member(f, entry, "row", number(i::i64));
        emit.entry(f, keys, t.catalog.rows.data[i].key, rec_value(entry));
        val handled: err[diag.Refusal] = handle(t, ?taken, i);
        if (sel handled.err) { ret handled; }
        i = i + 1;
    }
    emit.declare(f, "IDS", nil, emit.Value.array{t.ids.array});
    emit.declare(f, "ALTERNATIVES", nil, emit.Value.array{t.alts.array});
    emit.declare(f, "OPERANDS", nil, emit.Value.array{t.ops.array});
    emit.declare(f, "SLICES", nil, emit.Value.array{t.slices.array});
    emit.declare(f, "WORDS", nil, emit.Value.array{t.words.array});
    emit.declare(f, "ACCESSES", nil, emit.Value.array{t.access.array});
    emit.declare(f, "TERMS", nil, emit.Value.array{t.terms.array});
    emit.declare(f, "RULES", nil, emit.Value.array{t.rules.array});
    emit.declare(f, "REGISTER_RULES", nil, emit.Value.array{t.switches.array});
    emit.declare(f, "FIXED", nil, emit.Value.array{t.fixed.array});
    emit.declare(f, "EFFECTS", nil, emit.Value.array{t.effects.array});
    emit.declare(f, "SIDES", nil, emit.Value.array{t.sides.array});
    emit.declare(f, "CONSTRAINTS", nil, emit.Value.array{t.keeps.array});
    emit.declare(f, "FIELDS", nil, emit.Value.array{t.fields});
    emit.declare(f, "ROWS", nil, emit.Value.array{t.table});
    emit.declare(f, "KEYS", nil, emit.Value.array{keys});
    val codec: *emit.Record = record(f, "dispatch.Codec");
    member(f, codec, "fields", emit.Value.address{"riscv_field.TABLE"});
    member(f, codec, "registers", emit.Value.address{"riscv_register.FILE"});
    member(f, codec, "rows", span_or(f, "row.Rows", "row.NO_ROWS", "ROWS", 0, t.catalog.rows.len::u32));
    member(f, codec, "keys", span_or(f, "index.Index", "index.NO_ENTRIES", "KEYS", 0, t.catalog.rows.len::u32));
    member(f, codec, "dispatch", emit.Value.address{"gen_dispatch.DISPATCH"});
    # the narrowest element width is sew_min's, which the walks test a mask against
    member(f, codec, "element", emit.Value.name{"riscv_register.SEW_MIN + 1"});
    member(f, codec, "forms", emit.Value.name{"riscv_field.FORMS"});
    emit.declare(f, "CODEC", "dispatch.Codec", rec_value(codec));
    ret err[diag.Refusal].ok{};
}

fun by_name(x: *read.Csr, y: *read.Csr) i64 {
    ret str_compare(x.name, y.name);
}

# the row of the register file's csr class that states the csr `csr`, none when no row does
fun state_row(csr: str) opt[u32] {
    val found: opt[u32] = mapping.register_row(?riscv_register.FILE, csr);
    if (sel found.none)                                                            { ret opt[u32].none{}; }
    if (riscv_register.FILE.registers[found.some].class != gen_register.CSR_CLASS) { ret opt[u32].none{}; }
    ret found;
}

# every state row is a csr riscv-opcodes names, under the number the row states
fun stated_csrs(s: *read.Source) err[diag.Refusal] {
    var i: u32 = 0;
    for (i < riscv_register.FILE.register_count) {
        val r: *register.Register = ?riscv_register.FILE.registers[i];
        if (r.class == gen_register.CSR_CLASS) {
            var k:     usize = 0;
            var found: bool  = false;
            for (k < s.csrs.len) {
                if (str_equals(s.csrs.data[k].name, r.name)) {
                    if (s.csrs.data[k].number != r.number::u32) { ret err[diag.Refusal].err{diag.refusal(read.CSRS, 0, CSR_STATE, r.name)}; }
                    found = true;
                }
                k = k + 1;
            }
            if (!found) { ret err[diag.Refusal].err{diag.refusal(read.CSRS, 0, CSR_STATE, r.name)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the csr of `s`, sorted by name, that is named `name`, by binary search
fun csr_named(s: *read.Source, name: str) opt[usize] {
    var lo: usize = 0;
    var hi: usize = s.csrs.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val c:   i64   = str_compare(s.csrs.data[mid].name, name);
        if (c == 0) { ret opt[usize].some{mid}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret opt[usize].none{};
}

# the overlay's corrections made to the csrs of `s`, sorted by name: a width set, or a csr left out. a row that names no
# csr, or states the width riscv-opcodes already does, is refused, so the overlay holds only what corrects the source
fun correct_csrs(a: *A.Allocator, s: *read.Source) err[diag.Refusal] {
    var gone: vector.Vector[bool] = vector.init[bool](a);
    var i:    usize               = 0;
    for (i < s.csrs.len) {
        if (!pushed(vector.push[bool](?gone, false))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    var k: u32 = 0;
    for (k < overlay.CSRS_COUNT) {
        val o:  *overlay.Csr = ?overlay.CSRS[k];
        val at: opt[usize]   = csr_named(s, o.name);
        if (sel at.none)   { ret err[diag.Refusal].err{diag.refusal(read.CSRS, 0, CSR_CORRECTION, o.name)}; }
        if (o.skip != nil) { gone.data[at.some] = true; }
        or {
            if (s.csrs.data[at.some].rv32 == o.rv32) { ret err[diag.Refusal].err{diag.refusal(read.CSRS, 0, CSR_CORRECTION, o.name)}; }
            s.csrs.data[at.some].rv32 = o.rv32;
        }
        k = k + 1;
    }
    var kept: usize = 0;
    i = 0;
    for (i < s.csrs.len) {
        if (!gone.data[i]) {
            s.csrs.data[kept] = s.csrs.data[i];
            kept              = kept + 1;
        }
        i = i + 1;
    }
    s.csrs.len = kept;
    ret err[diag.Refusal].ok{};
}

# the csr id space: every named csr sorted by name, and their indices sorted by number
fun csrs(t: *Tables, c: *set.Context, s: *read.Source) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "csr");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f: *emit.File = opened.ok;
    emit.uses(f, "masc.core.extension");
    emit.uses(f, "masc.core.requirement");
    emit.uses(f, "riscv_csr: masc.isa.riscv.csr");
    emit.uses(f, "riscv_extension: masc.isa.riscv.extension");
    emit.uses(f, "riscv_register: masc.isa.riscv.register");
    sort.sort_by[read.Csr](s.csrs.data, s.csrs.len, by_name);
    val corrected: err[diag.Refusal] = correct_csrs(t.alloc, s);
    if (sel corrected.err) { ret corrected; }
    val stated: err[diag.Refusal] = stated_csrs(s);
    if (sel stated.err) { ret stated; }
    val table: *emit.Array        = emit.array(f, "riscv_csr.Csr");
    var order: vector.Vector[u64] = vector.init[u64](t.alloc);
    var i:     usize              = 0;
    for (i < s.csrs.len) {
        val x: *read.Csr = ?s.csrs.data[i];
        if (i > 0 && str_equals(s.csrs.data[i - 1].name, x.name)) { ret err[diag.Refusal].err{diag.refusal(read.CSRS, 0, emit.KEY_TWICE, x.name)}; }
        val r: *emit.Record = record(f, "riscv_csr.Csr");
        member(f, r, "name", emit.Value.text{x.name});
        val state: opt[u32] = state_row(x.name);
        if (sel state.some) {
            # the register row states this number, so the table reads the row's constant and never repeats it
            val owner: res[str, StrError] = str_join(t.alloc, "riscv_register.", emit.ident(f, x.name), "::u32");
            if (sel owner.err) { ret err[diag.Refusal].err{memory()}; }
            member(f, r, "number", name(owner.ok));
        }
        or { member(f, r, "number", emit.Value.hex{x.number::u64}); }
        member(f, r, "requires", requirement_span(f, if_rv32(x.rv32), 0, if_count(x.rv32)));
        emit.item(f, table, rec_value(r));
        vector.push[u64](?order, (x.number::u64 << 32) | i::u64);
        i = i + 1;
    }
    sort.sort[u64](order.data, order.len);
    val by_number: *emit.Array = emit.array(f, "u32");
    i = 0;
    for (i < order.len) {
        emit.item(f, by_number, number((order.data[i] & 0xFFFF_FFFF)::i64));
        i = i + 1;
    }
    val rv32: *emit.Array = emit.array(f, "requirement.Id");
    emit.item(f, rv32, name("riscv_extension.id.XLEN_32"));
    val only: *emit.Array = emit.array(f, "requirement.Alternative");
    emit.item(f, only, alternative(f, span(f, "requirement.Ids", "RV32_ID", 0, 1)));
    emit.declare(f, "RV32_ID", nil, emit.Value.array{rv32});
    emit.declare(f, "RV32_ONLY", nil, emit.Value.array{only});
    emit.declare(f, "CSRS", nil, emit.Value.array{table});
    emit.declare(f, "BY_NUMBER", nil, emit.Value.array{by_number});
    emit.declare(f, "TABLE", "riscv_csr.Csrs", span_or(f, "riscv_csr.Csrs", "riscv_csr.NO_CSRS", "CSRS", 0, s.csrs.len::u32));
    ret err[diag.Refusal].ok{};
}

fun if_rv32(rv32: bool) str {
    if (rv32) { ret "RV32_ONLY"; }
    ret nil;
}

fun if_count(rv32: bool) u32 {
    if (rv32) { ret 1; }
    ret 0;
}

# the index of the one row of `mnemonic`
fun only(t: *Tables, mnemonic: str) res[u32, diag.Refusal] {
    val count: opt[*u32] = map.get[str, u32](?t.count, ?mnemonic);
    if (sel count.none)   { ret res[u32, diag.Refusal].err{diag.refusal(nil, 0, NO_RELAX_ROW, mnemonic)}; }
    if (@count.some != 1) { ret res[u32, diag.Refusal].err{diag.refusal(nil, 0, NO_RELAX_ROW, mnemonic)}; }
    val first: opt[*u32] = map.get[str, u32](?t.first, ?mnemonic);
    if (sel first.none) { ret res[u32, diag.Refusal].err{diag.refusal(nil, 0, NO_RELAX_ROW, mnemonic)}; }
    ret res[u32, diag.Refusal].ok{@first.some};
}

fun source(f: *emit.File, of: str, payload: emit.Value) emit.Value {
    ret emit.Value.variant{emit.variant(f, emit.concat(f, "relax.Source.", of), payload)};
}

fun bare_source(f: *emit.File, of: str) emit.Value {
    ret emit.Value.variant{emit.bare(f, emit.concat(f, "relax.Source.", of))};
}

# the sources of a step over row `to`, the row relaxed `from`: its registers in
# order, then `link`, and its relative operand `relative`
fun step(t: *Tables, f: *emit.File, sources: *emit.Pool, from: *mapping.Row, to: u32, relative: emit.Value, link: str) res[emit.Value, diag.Refusal] {
    val row:    *mapping.Row              = t.catalog.rows.data[to];
    var values: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
    var taken:  usize                     = 0;
    var i:      usize                     = 0;
    for (i < row.operands.len) {
        val op: *mapping.Operand = ?row.operands.data[i];
        if (op.relative) { vector.push[emit.Value](?values, relative); }
        or {
            var found: bool = false;
            for (taken < from.operands.len && !found) {
                val use: overlay.Use = from.operands.data[taken].use;
                if (use == overlay.REGISTER) {
                    vector.push[emit.Value](?values, source(f, "operand", number(taken::i64)));
                    found = true;
                }
                taken = taken + 1;
            }
            if (!found) {
                val reg: opt[u32] = mapping.register_row(?riscv_register.FILE, link);
                if (sel reg.none) { ret res[emit.Value, diag.Refusal].err{diag.refusal(nil, 0, mapping.UNKNOWN_NAME, link)}; }
                vector.push[emit.Value](?values, source(f, "register", number(reg.some::i64)));
            }
        }
        i = i + 1;
    }
    val at: u32          = emit.pooled(f, sources, values.data, values.len::u32);
    val r:  *emit.Record = record(f, "relax.Step");
    member(f, r, "row", number(to::i64));
    member(f, r, "values", span_or(f, "relax.Sources", "relax.NO_SOURCES", "SOURCES", at, values.len::u32));
    ret res[emit.Value, diag.Refusal].ok{rec_value(r)};
}

fun relative_of(row: *mapping.Row) u8 {
    var i: usize = 0;
    for (i < row.operands.len) {
        if (row.operands.data[i].relative) { ret i::u8; }
        i = i + 1;
    }
    ret field.NO_OPERAND;
}

# the relaxation rows and the code fill
fun relaxations(t: *Tables, c: *set.Context) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "relax");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f: *emit.File = opened.ok;
    emit.uses(f, "masc.core.index");
    emit.uses(f, "masc.core.relax");
    emit.uses(f, "masc.core.fill");
    emit.uses(f, "masc.isa.riscv.gen_row");
    var sources: emit.Pool   = emit.pool(f, "relax.Source");
    var steps:   emit.Pool   = emit.pool(f, "relax.Step");
    val table:   *emit.Array = emit.array(f, "relax.Relaxation");
    val keys:    *emit.Array = emit.keyed(f, "index.Entry");
    var i:       u32         = 0;
    for (i < effects.RELAXES_COUNT) {
        val rx:   *effects.Relax         = ?effects.RELAXES[i];
        val from: res[u32, diag.Refusal] = only(t, rx.from);
        if (sel from.err) { ret err[diag.Refusal].err{from.err}; }
        val to: res[u32, diag.Refusal] = only(t, rx.to);
        if (sel to.err) { ret err[diag.Refusal].err{to.err}; }
        val row:  *mapping.Row              = t.catalog.rows.data[from.ok];
        var form: vector.Vector[emit.Value] = vector.init[emit.Value](t.alloc);
        if (rx.inverted) {
            val first: res[emit.Value, diag.Refusal] = step(t, f, ?sources, row, to.ok, bare_source(f, "past"), rx.link);
            if (sel first.err) { ret err[diag.Refusal].err{first.err}; }
            val far: res[u32, diag.Refusal] = only(t, effects.FAR);
            if (sel far.err) { ret err[diag.Refusal].err{far.err}; }
            var none: mapping.Row = @row;
            none.operands.len = 0;
            val jump: res[emit.Value, diag.Refusal] = step(t, f, ?sources, ?none, far.ok, bare_source(f, "target"), effects.FAR_LINK);
            if (sel jump.err) { ret err[diag.Refusal].err{jump.err}; }
            vector.push[emit.Value](?form, first.ok);
            vector.push[emit.Value](?form, jump.ok);
        }
        or {
            val one: res[emit.Value, diag.Refusal] = step(t, f, ?sources, row, to.ok, bare_source(f, "target"), rx.link);
            if (sel one.err) { ret err[diag.Refusal].err{one.err}; }
            vector.push[emit.Value](?form, one.ok);
        }
        val at: u32          = emit.pooled(f, ?steps, form.data, form.len::u32);
        val r:  *emit.Record = record(f, "relax.Relaxation");
        member(f, r, "row", number(from.ok::i64));
        member(f, r, "operand", number(relative_of(row)::i64));
        member(f, r, "form", span_or(f, "relax.Steps", "relax.NO_STEPS", "STEPS", at, form.len::u32));
        emit.item(f, table, rec_value(r));
        val entry: *emit.Record = record(f, "index.Entry");
        member(f, entry, "key", emit.Value.text{row.key});
        member(f, entry, "row", number(i::i64));
        emit.entry(f, keys, row.key, rec_value(entry));
        i = i + 1;
    }
    emit.declare(f, "SOURCES", nil, emit.Value.array{sources.array});
    emit.declare(f, "STEPS", nil, emit.Value.array{steps.array});
    emit.declare(f, "RELAXATION_KEYS", nil, emit.Value.array{keys});
    val all: *emit.Record = record(f, "relax.Relaxations");
    member(f, all, "at", emit.element(f, "RELAXATION_ROWS", 0));
    member(f, all, "len", number(emit.length(table)::i64));
    member(f, all, "keys", span_or(f, "index.Index", "index.NO_ENTRIES", "RELAXATION_KEYS", 0, emit.length(table)));
    emit.declare(f, "RELAXATIONS", "relax.Relaxations", rec_value(all));
    emit.declare(f, "RELAXATION_ROWS", nil, emit.Value.array{table});
    # each no-op is its row's fixed bits with every operand zero, in its unit's bytes
    val patterns: *emit.Array = emit.array(f, "fill.Pattern");
    var p:        u32         = 0;
    for (p < 2) {
        val at: res[u32, diag.Refusal] = only(t, effects.FILLS[p]);
        if (sel at.err) { ret err[diag.Refusal].err{at.err}; }
        val r:     *mapping.Row = t.catalog.rows.data[at.ok];
        val bytes: [4]u8        = [4]u8{(r.match & 0xFF)::u8, ((r.match >> 8) & 0xFF)::u8, ((r.match >> 16) & 0xFF)::u8, ((r.match >> 24) & 0xFF)::u8};
        val len:   u32          = r.width::u32 / 8;
        val nop:   str          = emit.concat(f, "NOP_", emit.ident(f, r.mnemonic));
        emit.declare_array(f, nop, emit.bytes(f, ?bytes[0], len::usize));
        val pr: *emit.Record = record(f, "fill.Pattern");
        member(f, pr, "bytes", emit.element(f, nop, 0));
        member(f, pr, "len", number(len::i64));
        member(f, pr, "requires", requirement_span(f, "gen_row.ALTERNATIVES", t.reqs.data[at.ok], t.req_len.data[at.ok]));
        emit.item(f, patterns, rec_value(pr));
        p = p + 1;
    }
    emit.uses(f, "masc.core.extension");
    emit.uses(f, "masc.core.requirement");
    emit.declare(f, "FILL_PATTERNS", nil, emit.Value.array{patterns});
    emit.declare(f, "FILL", "fill.Fill", span_fill(f));
    ret err[diag.Refusal].ok{};
}

fun span_fill(f: *emit.File) emit.Value {
    val r: *emit.Record = record(f, "fill.Fill");
    member(f, r, "patterns", emit.element(f, "FILL_PATTERNS", 0));
    member(f, r, "count", number(2));
    # llvm-mc 23.1.1 writes the c.nop of a gap that is not a multiple of four first, then four byte nops
    # (RISCVAsmBackend::writeNopData, llvm/lib/Target/RISCV/MCTargetDesc/RISCVAsmBackend.cpp)
    member(f, r, "order", emit.Value.name{"fill.REMAINDER_FIRST"});
    ret rec_value(r);
}

# the pseudo ops the dialect adds, read as lines of their files beside the records riscv-opcodes states
fun pseudos(a: *A.Allocator, s: *read.Source) err[diag.Refusal] {
    var i: u32 = 0;
    for (i < dialect.PSEUDOS_COUNT) {
        val x:    *overlay.Extra                 = ?dialect.PSEUDOS[i];
        var line: lines.Line                     = lines.Line{file: "gen/src/riscv/dialect.mach", number: i + 1, text: view(x.text, str_len(x.text))};
        val got:  res[read.Record, diag.Refusal] = read.parse(a, ?s.args, ?line, x.file);
        if (sel got.err)                                           { ret err[diag.Refusal].err{got.err}; }
        if (!pushed(vector.push[read.Record](?s.records, got.ok))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the syntax tables: each row's template, the respelling aliases and the index by mnemonic
fun syntaxes(c: *set.Context, s: *read.Source, catalog: *mapping.Catalog) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "syntax");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    ret spell.generate(c.alloc, opened.ok, s, catalog, ?riscv_register.FILE);
}

# the compressions: each base row's shorter rows
fun compressions(c: *set.Context, catalog: *mapping.Catalog) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "compress");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    ret compress.generate(c.alloc, opened.ok, catalog, ?riscv_register.FILE);
}

# the handles of the register file, one per register row and one index per class
fun registers(c: *set.Context) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "register");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    ret handles.generate(c.alloc, opened.ok, ?riscv_register.FILE);
}

# the riscv catalog generated from riscv-opcodes
pub fun generate(c: *set.Context) err[diag.Refusal] {
    val got: res[read.Source, diag.Refusal] = read.read(c.alloc, c.tree);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var s:     read.Source       = got.ok;
    val added: err[diag.Refusal] = pseudos(c.alloc, ?s);
    if (sel added.err) { ret added; }
    val based: err[diag.Refusal] = mapping.hint_bases(c.alloc, ?s);
    if (sel based.err) { ret based; }
    var x:     facts.Facts;
    val known: err[diag.Refusal] = facts.build(c.alloc, c.inputs.data[0], ?x);
    if (sel known.err) { ret known; }
    var catalog: mapping.Catalog;
    val built:   err[diag.Refusal] = mapping.build(c.alloc, ?s, ?x, ?riscv_register.FILE, ?catalog);
    if (sel built.err)        { ret built; }
    if (catalog.idle.len > 0) { ret err[diag.Refusal].err{diag.refusal(nil, 0, mapping.NO_ROW, catalog.idle.data[0])}; }
    var t: Tables;
    t.alloc   = c.alloc;
    t.catalog = ?catalog;
    t.first   = map.init[str, u32](c.alloc);
    t.count   = map.init[str, u32](c.alloc);
    var i: u32 = 0;
    for (i < catalog.rows.len::u32) {
        val m:     str       = catalog.rows.data[i].mnemonic;
        val known: opt[*u32] = map.get[str, u32](?t.count, ?m);
        if (sel known.some) { @known.some = @known.some + 1; }
        or {
            map.insert[str, u32](?t.count, m, 1);
            map.insert[str, u32](?t.first, m, i);
        }
        i = i + 1;
    }
    val wrote: err[diag.Refusal] = rows(?t, c);
    if (sel wrote.err) { ret wrote; }
    val spread: err[diag.Refusal] = dispatched(?t, c);
    if (sel spread.err) { ret spread; }
    val named: err[diag.Refusal] = csrs(?t, c, ?s);
    if (sel named.err) { ret named; }
    val handled: err[diag.Refusal] = registers(c);
    if (sel handled.err) { ret handled; }
    val spelled: err[diag.Refusal] = syntaxes(c, ?s, ?catalog);
    if (sel spelled.err) { ret spelled; }
    val shortened: err[diag.Refusal] = compressions(c, ?catalog);
    if (sel shortened.err) { ret shortened; }
    ret relaxations(?t, c);
}
