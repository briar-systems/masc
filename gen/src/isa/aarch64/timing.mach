# the timing topic: the rows whose timing depends on no input under PSTATE.DIT
#
# the model states no instruction's timing, so the topic gen/data/aarch64/timing.txt names each operation the manual
# lists as a data-independent-time instruction (DDI 0487, "About PSTATE.DIT"), one line each:
#
#   dit <operation> | independent
#
# a row of a named operation is independent of its inputs under dit=on and dependent on all of them otherwise, and
# every other row is dependent. the model states nothing any line states, so no line overrides it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use gen.diag;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "timing";

pub val BAD_LINE: str = "timing line is not `dit <operation> | independent`";
pub val TWICE:    str = "operation stated twice";

pub rec Timing {
    dit: map.Map[str, u32];
}

fun inserted(r: res[bool, A.Error]) bool {
    ret sel r.ok;
}

fun found(o: opt[*u32]) bool {
    ret sel o.some;
}

# the timing topic of the data tree `tree`
pub fun read(a: *A.Allocator, tree: *source.Tree) res[Timing, diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, TOPIC);
    if (sel got.err) { ret res[Timing, diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, nil, topic.unstated);
    if (sel checked.err) { ret res[Timing, diag.Refusal].err{checked.err}; }
    var out: Timing = Timing{dit: map.init[str, u32](a)};
    var i:   usize  = 0;
    for (i < t.facts.len) {
        var l:    topic.Line        = topic.Line{fact: nil, key: vector.init[str](a), ws: vector.init[str](a)};
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err) { ret res[Timing, diag.Refusal].err{read.err}; }
        val w:    opt[str] = topic.only(?l);
        var word: str      = "";
        if (sel w.some)                                                  { word = w.some; }
        if (!topic.is(?l, "dit", 2) || !str_equals(word, "independent")) { ret res[Timing, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
        val op: str = l.key.data[1];
        if (found(map.get[str, u32](?out.dit, ?op)))               { ret res[Timing, diag.Refusal].err{topic.refuse(l.fact, TWICE, op)}; }
        if (!inserted(map.insert[str, u32](?out.dit, op, i::u32))) { ret res[Timing, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        i = i + 1;
    }
    ret res[Timing, diag.Refusal].ok{out};
}

# whether operation `op` is independent of its inputs under dit=on
pub fun dit(t: *Timing, op: str) bool {
    if (op == nil) { ret false; }
    ret found(map.get[str, u32](?t.dit, ?op));
}
