# the fixups topic: the fixup kind a row's symbolic operand takes by default
#
# neither the instruction model nor the A64 ISA XML states a relocation, so the topic gen/data/aarch64/fixups.txt
# states the kind each operand rule takes, read from the ELF for the Arm 64-bit Architecture (aaelf64), one line per
# rule, and one per instruction where an instruction of a rule takes another, as bl's label is a call:
#
#   fixup <rule> | <kind>
#   fixup <instruction> <rule> | <kind>
#
# the kind is a constant of masc.isa.aarch64.fixup by its name in lower case, and an operand of no line takes no
# symbol. a line no row's operand reads is refused, so the topic never names a rule the model has left

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_to_upper;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use gen.isa.aarch64.mapping;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "fixups";

pub val BAD_LINE: str = "fixups line is not `fixup [<instruction>] <rule> | <kind>`";
pub val TWICE:    str = "rule stated twice";
pub val UNUSED:   str = "fixups line names a rule no row's operand reads";

# one line
# ---
# instruction: the instruction it holds for, nil for every instruction of the rule
# rule:        the operand rule
# kind:        the emitted constant of the fixup kind
# fact:        the line, for its refusals
# used:        whether a row's operand reads it
pub rec Line {
    instruction: str;
    rule:        str;
    kind:        str;
    fact:        *topic.Fact;
    used:        bool;
}

pub rec Fixups {
    lines: vector.Vector[Line];
}

fun fits(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# `name` in upper case after the module's name, as `jump26` is `aarch64_fixup.JUMP26`, nil when the storage is refused
fun constant(a: *A.Allocator, name: str) str {
    val upper: res[str, StrError] = str_to_upper(a, name);
    if (sel upper.err) { ret nil; }
    val got: res[str, StrError] = str_join(a, "aarch64_fixup.", upper.ok);
    if (sel got.err) { ret nil; }
    ret got.ok;
}

# the fixups topic of the data tree `tree`
pub fun read(a: *A.Allocator, tree: *source.Tree) res[Fixups, diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, TOPIC);
    if (sel got.err) { ret res[Fixups, diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, nil, topic.unstated);
    if (sel checked.err) { ret res[Fixups, diag.Refusal].err{checked.err}; }
    var out: Fixups = Fixups{lines: vector.init[Line](a)};
    var i:   usize  = 0;
    for (i < t.facts.len) {
        var l:    topic.Line        = topic.Line{fact: nil, key: vector.init[str](a), ws: vector.init[str](a)};
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err) { ret res[Fixups, diag.Refusal].err{read.err}; }
        val w:    opt[str] = topic.only(?l);
        var word: str      = nil;
        if (sel w.some) { word = w.some; }
        var ins:  str = nil;
        var rule: str = nil;
        if (topic.is(?l, "fixup", 2)) { rule = l.key.data[1]; }
        or (topic.is(?l, "fixup", 3)) {
            ins  = l.key.data[1];
            rule = l.key.data[2];
        }
        if (rule == nil || word == nil) { ret res[Fixups, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
        var k: usize = 0;
        for (k < out.lines.len) {
            val o: *Line = ?out.lines.data[k];
            if (str_equals(o.rule, rule) && ((o.instruction == nil && ins == nil) || (o.instruction != nil && ins != nil && str_equals(o.instruction, ins)))) { ret res[Fixups, diag.Refusal].err{topic.refuse(l.fact, TWICE, rule)}; }
            k = k + 1;
        }
        val kind: str = constant(a, word);
        if (kind == nil)                                                                                                     { ret res[Fixups, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        if (!fits(vector.push[Line](?out.lines, Line{instruction: ins, rule: rule, kind: kind, fact: l.fact, used: false}))) { ret res[Fixups, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        i = i + 1;
    }
    ret res[Fixups, diag.Refusal].ok{out};
}

# the fixup kind an operand of rule `rule` of instruction `ins` takes, its instruction's line before its rule's, nil for
# none
pub fun kind_of(f: *Fixups, ins: str, rule: str) str {
    var general: *Line = nil;
    var i:       usize = 0;
    for (i < f.lines.len) {
        val l: *Line = ?f.lines.data[i];
        if (str_equals(l.rule, rule)) {
            if (l.instruction != nil && str_equals(l.instruction, ins)) {
                l.used = true;
                ret l.kind;
            }
            if (l.instruction == nil) { general = l; }
        }
        i = i + 1;
    }
    if (general == nil) { ret nil; }
    general.used = true;
    ret general.kind;
}

# the fixup kind of every immediate and relative target of rows `all` and of their aliases' own operands, refused at a
# line no operand reads
pub fun apply(f: *Fixups, all: *vector.Vector[mapping.Row]) err[diag.Refusal] {
    var i: usize = 0;
    for (i < all.len) {
        val r: *mapping.Row = ?all.data[i];
        given(f, r.instruction.name, ?r.operands);
        var k: usize = 0;
        for (k < r.aliases.len) {
            given(f, r.instruction.name, ?r.aliases.data[k].operands);
            k = k + 1;
        }
        i = i + 1;
    }
    ret unused(f);
}

# the fixup kind of each immediate and relative target of `ops`, operands of instruction `ins`
fun given(f: *Fixups, ins: str, ops: *vector.Vector[mapping.Operand]) {
    var j: usize = 0;
    for (j < ops.len) {
        val op: *mapping.Operand = ?ops.data[j];
        if ((op.shape == mapping.IMMEDIATE || op.shape == mapping.RELATIVE) && op.rule != nil) { op.fixup = kind_of(f, ins, op.rule.id); }
        j = j + 1;
    }
}

# the refusal of the first line no operand read, ok when every line was
fun unused(f: *Fixups) err[diag.Refusal] {
    var i: usize = 0;
    for (i < f.lines.len) {
        if (!f.lines.data[i].used) { ret err[diag.Refusal].err{topic.refuse(f.lines.data[i].fact, UNUSED, f.lines.data[i].rule)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}
