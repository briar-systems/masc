# the aarch64 extension catalog generator
#
# it reads Arm's feature model, Features.json of the vendored AARCHMRS
# release, and llvm's names for the features, AArch64Features.td, and
# emits the catalog's data beside masc's aarch64 modules: an id for each
# row, the rows with their implications and revisions, the levels, the
# conflicts and combinations, the name index, the names -march gives the
# rows and the attributes -mattr takes, each with the rows it covers. how the model is read is gen.isa.aarch64.feature's,
# and how the names are, gen.isa.aarch64.llvm's.
#
# a level is named armvN-a for the version vNAp0 and armvN.M-a for vNApM,
# as llvm-mc's -march and .arch spell it, and selects its version. an
# llvm name covers the rows of its FEAT_* names, or, for a name that gives
# none, as sve2-aes, those of the features it implies. a FEAT_* name llvm
# gives that the model has no row for is listed in LLVM_UNLISTED, so a
# release that adds it shows in the table's drift.
#
# a processor is a level too, after the versions, of the version and the
# features the overlay's cpus topic states llvm enables for it, a feature
# llvm names that the model has no row for dropped.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_join;

use A: std.allocator;
use std.collections.map;
use std.collections.sort;
use std.collections.vector;

use gen.diag;
use gen.emit;
use gen.isa.aarch64.feature;
use gen.isa.aarch64.llvm;
use topic: gen.overlay;
use gen.set;
use gen.source;
use gen.tar;

pub val FEATURES: str = "Features.json";
pub val NAMES:    str = "AArch64Features.td";

pub val NO_NAMES:    str = "input holds no AArch64Features.td";
pub val NO_IMPLIED:  str = "llvm feature implies a def the file does not give";
pub val NAMED_TWICE: str = "llvm name covers different rows in two defs";
pub val IDENT_TWICE: str = "two rows mangle to one identifier";
pub val OWN_NAME:    str = "llvm name is a row's or a level's own name and covers other rows";
pub val CPUS:        str = "cpus";
pub val BAD_CPU:     str = "cpus line is not `cpu <name> | <level> <FEAT_*>...`";
pub val CPU_LEVEL:   str = "cpus line names no version's level first";
pub val CPU_FEATURE: str = "cpus line names a feature neither the model nor llvm's unlisted names have";
pub val CPU_TWICE:   str = "cpus line names a processor twice, or one a row or a version is named";

# a processor and the rows its level selects, its version first
rec Cpu {
    name:    str;
    members: vector.Vector[u32];
}

# one llvm name and the rows it covers
# ---
# march:     whether -march and .arch take it
# attribute: whether -mattr takes it, a target feature's or an architecture's name
rec Spelt {
    name:      str;
    ids:       vector.Vector[u32];
    march:     bool;
    attribute: bool;
}

fun memory(subject: str) err[diag.Refusal] {
    ret err[diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, subject)};
}

fun number(n: i64) emit.Value {
    ret emit.Value.number{n};
}

fun name(s: str) emit.Value {
    ret emit.Value.name{s};
}

# the identifier of row `row`: SIMD for FEAT_AdvSIMD, VN_M for vNApM, else the name after FEAT_
fun ident(f: *emit.File, row: str) str {
    if (str_equals(row, "FEAT_AdvSIMD")) { ret "SIMD"; }
    if (feature.version(row)) {
        var v: [5]u8;
        v[0] = 'V';
        v[1] = row[1];
        v[2] = '_';
        v[3] = row[4];
        v[4] = 0;
        ret emit.ident(f, ?v[0]);
    }
    ret emit.ident(f, ?row[5]);
}

# the level name of version `row`
fun level(a: *A.Allocator, row: str) str {
    var v:    [12]u8;
    var n:    usize = 0;
    val head: str   = "armv";
    for (n < 4) {
        v[n] = head[n];
        n    = n + 1;
    }
    v[n] = row[1];
    n    = n + 1;
    if (row[4] != '0') {
        v[n]     = '.';
        v[n + 1] = row[4];
        n        = n + 2;
    }
    v[n]     = '-';
    v[n + 1] = 'a';
    v[n + 2] = 0;
    val got: res[str, StrError] = str_join(a, ?v[0]);
    if (sel got.err) { ret nil; }
    ret got.ok;
}

fun by_spelt(a: *Spelt, b: *Spelt) i64 {
    ret str_compare(a.name, b.name);
}

fun by_text(a: *str, b: *str) i64 {
    ret str_compare(@a, @b);
}

fun by_id(a: *u32, b: *u32) i64 {
    if (@a < @b) { ret -1; }
    if (@a > @b) { ret 1; }
    ret 0;
}

fun holds(v: *vector.Vector[u32], id: u32) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun listed(v: *vector.Vector[str], s: str) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (str_equals(v.data[i], s)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun same(a: *vector.Vector[u32], b: *vector.Vector[u32]) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the spelling of `spelt` named `n`
fun spelt_named(spelt: *vector.Vector[Spelt], n: str) opt[*Spelt] {
    var i: usize = 0;
    for (i < spelt.len) {
        if (str_equals(spelt.data[i].name, n)) { ret opt[*Spelt].some{?spelt.data[i]}; }
        i = i + 1;
    }
    ret opt[*Spelt].none{};
}

# `n` covering `ids` added to the names, refused when a name covers other rows already
fun spell(spelt: *vector.Vector[Spelt], n: str, ids: *vector.Vector[u32], march: bool, attribute: bool, file: str) err[diag.Refusal] {
    var i: usize = 0;
    for (i < spelt.len) {
        if (str_equals(spelt.data[i].name, n)) {
            if (!same(?spelt.data[i].ids, ids)) { ret err[diag.Refusal].err{diag.refusal(file, 0, NAMED_TWICE, n)}; }
            spelt.data[i].march     = spelt.data[i].march || march;
            spelt.data[i].attribute = spelt.data[i].attribute || attribute;
            ret err[diag.Refusal].ok{};
        }
        i = i + 1;
    }
    val pushed: res[usize, A.Error] = vector.push[Spelt](spelt, Spelt{name: n, ids: @ids, march: march, attribute: attribute});
    if (sel pushed.err) { ret memory(n); }
    ret err[diag.Refusal].ok{};
}

# the rows each llvm name covers, and the FEAT names that have none
fun spellings(a: *A.Allocator, m: *feature.Model, names: *llvm.Names, file: str, spelt: *vector.Vector[Spelt], unlisted: *vector.Vector[str]) err[diag.Refusal] {
    var march: vector.Vector[str] = vector.init[str](a);
    var i:     usize              = 0;
    for (i < names.extensions.len) {
        val e: *llvm.Extension = ?names.extensions.data[i];
        if (e.visible[0] != 0) { vector.push[str](?march, e.visible); }
        if (e.alias[0] != 0)   { vector.push[str](?march, e.alias); }
        i = i + 1;
    }
    i = 0;
    for (i < names.extensions.len) {
        val e:   *llvm.Extension    = ?names.extensions.data[i];
        var ids: vector.Vector[u32] = vector.init[u32](a);
        var k:   usize              = 0;
        for (k < e.arm.len) {
            val id: opt[u32] = feature.row(m, e.arm.data[k]);
            if (sel id.some) {
                if (!holds(?ids, id.some)) { vector.push[u32](?ids, id.some); }
            }
            or (!listed(unlisted, e.arm.data[k])) { vector.push[str](unlisted, e.arm.data[k]); }
            k = k + 1;
        }
        if (e.arm.len == 0) {
            k = 0;
            for (k < e.implies.len) {
                var found: bool  = false;
                var j:     usize = 0;
                for (j < names.extensions.len) {
                    val d: *llvm.Extension = ?names.extensions.data[j];
                    if (str_equals(d.name, e.implies.data[k])) {
                        found = true;
                        var x: usize = 0;
                        for (x < d.arm.len) {
                            val id: opt[u32] = feature.row(m, d.arm.data[x]);
                            if (sel id.some) {
                                if (!holds(?ids, id.some)) { vector.push[u32](?ids, id.some); }
                            }
                            x = x + 1;
                        }
                    }
                    j = j + 1;
                }
                if (!found) { ret err[diag.Refusal].err{diag.refusal(file, 0, NO_IMPLIED, e.implies.data[k])}; }
                k = k + 1;
            }
        }
        if (ids.len > 0) {
            sort.sort_by[u32](ids.data, ids.len, by_id);
            val each: [3]str = [3]str{e.feature, e.visible, e.alias};
            k = 0;
            for (k < 3) {
                val n: str = each[k];
                if (n[0] != 0) {
                    val added: err[diag.Refusal] = spell(spelt, n, ?ids, listed(?march, n), k == 0, file);
                    if (sel added.err) { ret added; }
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < names.architectures.len) {
        val arch: *llvm.Architecture = ?names.architectures.data[i];
        var v:    [6]u8;
        v[0] = 'v';
        v[1] = '0' + arch.major::u8;
        v[2] = 'A';
        v[3] = 'p';
        v[4] = '0' + arch.minor::u8;
        v[5] = 0;
        val id: opt[u32] = feature.row(m, ?v[0]);
        if (sel id.some) {
            var ids: vector.Vector[u32] = vector.init[u32](a);
            vector.push[u32](?ids, id.some);
            val added: err[diag.Refusal] = spell(spelt, arch.name, ?ids, false, true, file);
            if (sel added.err) { ret added; }
        }
        i = i + 1;
    }
    sort.sort_by[Spelt](spelt.data, spelt.len, by_spelt);
    sort.sort_by[str](unlisted.data, unlisted.len, by_text);
    ret err[diag.Refusal].ok{};
}

# a run of ids in pool `p` declared as `array`, as requirement.Ids, or NO_IDS when empty
fun run(f: *emit.File, p: *emit.Pool, array: str, idents: *vector.Vector[str], ids: *vector.Vector[u32]) emit.Value {
    if (ids.len == 0) { ret name("requirement.NO_IDS"); }
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](f.alloc);
    var i:     usize                     = 0;
    for (i < ids.len) {
        vector.push[emit.Value](?items, name(idents.data[ids.data[i]]));
        i = i + 1;
    }
    val at: u32          = emit.pooled(f, p, items.data, items.len::u32);
    val r:  *emit.Record = emit.record(f, "requirement.Ids");
    emit.member(f, r, "at", emit.element(f, array, at));
    emit.member(f, r, "len", number(ids.len::i64));
    ret emit.Value.record{r};
}

fun entry(f: *emit.File, key: str, row: u32) emit.Value {
    val e: *emit.Record = emit.record(f, "index.Entry");
    emit.member(f, e, "key", emit.Value.text{key});
    emit.member(f, e, "row", number(row::i64));
    ret emit.Value.record{e};
}

# the one atom `item` as requirement.Ids, pooled in NAMED
fun one(f: *emit.File, p: *emit.Pool, item: emit.Value) emit.Value {
    var items: [1]emit.Value = [1]emit.Value{item};
    val r:     *emit.Record  = emit.record(f, "requirement.Ids");
    emit.member(f, r, "at", emit.element(f, "NAMED", emit.pooled(f, p, ?items[0], 1)));
    emit.member(f, r, "len", number(1));
    ret emit.Value.record{r};
}

# a name index entry keyed `key` over `rows`, a row's or a level's own name when `canonical`, an alias otherwise
fun name_entry(f: *emit.File, key: str, rows: emit.Value, canonical: bool) emit.Value {
    val e: *emit.Record = emit.record(f, "extension.NameEntry");
    emit.member(f, e, "key", emit.Value.text{key});
    emit.member(f, e, "rows", rows);
    if (canonical) { emit.member(f, e, "canonical", name("true")); }
    or             { emit.member(f, e, "canonical", name("false")); }
    ret emit.Value.record{e};
}

# the table of model `m` and its llvm names
fun table(c: *set.Context, m: *feature.Model, spelt: *vector.Vector[Spelt], unlisted: *vector.Vector[str], cpus: *vector.Vector[Cpu]) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "extension");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f: *emit.File = opened.ok;
    emit.uses(f, "std.types.bool.false");
    emit.uses(f, "std.types.bool.true");
    emit.uses(f, "std.types.string.str");
    emit.uses(f, "masc.core.extension");
    emit.uses(f, "masc.core.index");
    emit.uses(f, "masc.core.requirement");
    val count:  u32                = m.rows.len::u32;
    var idents: vector.Vector[str] = vector.init[str](c.alloc);
    var seen:   map.Map[str, u32]  = map.init[str, u32](c.alloc);
    var i:      u32                = 0;
    for (i < count) {
        val id:    str       = ident(f, m.rows.data[i]);
        var key:   str       = id;
        val known: opt[*u32] = map.get[str, u32](?seen, ?key);
        if (sel known.some) { ret err[diag.Refusal].err{diag.refusal(f.path, 0, IDENT_TWICE, m.rows.data[i])}; }
        map.insert[str, u32](?seen, id, i);
        vector.push[str](?idents, id);
        emit.declare(f, id, "requirement.Id", number(i::i64));
        i = i + 1;
    }
    emit.declare(f, "COUNT", "u32", number(count::i64));

    var implied: emit.Pool   = emit.pool(f, "requirement.Id");
    val rows:    *emit.Array = emit.array(f, "extension.Extension");
    i = 0;
    for (i < count) {
        val r: *emit.Record = emit.record(f, "extension.Extension");
        emit.member(f, r, "name", emit.Value.text{m.rows.data[i]});
        emit.member(f, r, "implies", run(f, ?implied, "IMPLIED", ?idents, ?m.implies.data[i]));
        emit.member(f, r, "revision", emit.Value.text{m.revisions.data[i]});
        emit.item(f, rows, emit.Value.record{r});
        i = i + 1;
    }
    emit.declare(f, "ROWS", nil, emit.Value.array{rows});
    emit.declare_array(f, "IMPLIED", implied.array);

    val members:   *emit.Array          = emit.array(f, "requirement.Id");
    val levels:    *emit.Array          = emit.array(f, "extension.Level");
    val named:     *emit.Array          = emit.keyed(f, "extension.NameEntry");
    var keyed:     emit.Pool            = emit.pool(f, "requirement.Id");
    var canonical: vector.Vector[Spelt] = vector.init[Spelt](c.alloc);
    i = 0;
    for (i < m.versions) {
        val v:  u32 = 4 + i;
        val ln: str = level(c.alloc, m.rows.data[v]);
        if (ln == nil) { ret memory(m.rows.data[v]); }
        emit.item(f, members, name(idents.data[v]));
        val r: *emit.Record = emit.record(f, "extension.Level");
        emit.member(f, r, "name", emit.Value.text{ln});
        val ids: *emit.Record = emit.record(f, "requirement.Ids");
        emit.member(f, ids, "at", emit.element(f, "LEVEL_MEMBERS", emit.length(members) - 1));
        emit.member(f, ids, "len", number(1));
        emit.member(f, r, "kind", name("extension.ARCH"));
        emit.member(f, r, "members", emit.Value.record{ids});
        emit.member(f, r, "state", name("requirement.NO_IDS"));
        emit.item(f, levels, emit.Value.record{r});
        emit.entry(f, named, ln, name_entry(f, ln, one(f, ?keyed, number((count + i)::i64)), true));
        var held: vector.Vector[u32] = vector.init[u32](c.alloc);
        vector.push[u32](?held, v);
        vector.push[Spelt](?canonical, Spelt{name: ln, ids: held, march: false, attribute: false});
        i = i + 1;
    }
    var p: usize = 0;
    for (p < cpus.len) {
        val cpu:   *Cpu  = ?cpus.data[p];
        val first: u32   = emit.length(members);
        var k:     usize = 0;
        for (k < cpu.members.len) {
            emit.item(f, members, name(idents.data[cpu.members.data[k]]));
            k = k + 1;
        }
        val r: *emit.Record = emit.record(f, "extension.Level");
        emit.member(f, r, "name", emit.Value.text{cpu.name});
        val ids: *emit.Record = emit.record(f, "requirement.Ids");
        emit.member(f, ids, "at", emit.element(f, "LEVEL_MEMBERS", first));
        emit.member(f, ids, "len", number(cpu.members.len::i64));
        emit.member(f, r, "kind", name("extension.CPU"));
        emit.member(f, r, "members", emit.Value.record{ids});
        emit.member(f, r, "state", name("requirement.NO_IDS"));
        emit.item(f, levels, emit.Value.record{r});
        val at: u32 = count + m.versions + p::u32;
        emit.entry(f, named, cpu.name, name_entry(f, cpu.name, one(f, ?keyed, number(at::i64)), true));
        var held: vector.Vector[u32] = vector.init[u32](c.alloc);
        vector.push[u32](?held, at);
        vector.push[Spelt](?canonical, Spelt{name: cpu.name, ids: held, march: false, attribute: false});
        p = p + 1;
    }
    emit.declare(f, "LEVEL_MEMBERS", nil, emit.Value.array{members});
    emit.declare(f, "LEVELS", nil, emit.Value.array{levels});
    emit.declare(f, "LEVEL_COUNT", "u32", number((m.versions + cpus.len::u32)::i64));
    i = 0;
    for (i < count) {
        emit.entry(f, named, m.rows.data[i], name_entry(f, m.rows.data[i], one(f, ?keyed, name(idents.data[i])), true));
        var held: vector.Vector[u32] = vector.init[u32](c.alloc);
        vector.push[u32](?held, i);
        vector.push[Spelt](?canonical, Spelt{name: m.rows.data[i], ids: held, march: false, attribute: false});
        i = i + 1;
    }

    val conflicts: *emit.Array = emit.array(f, "extension.Conflict");
    var k:         usize       = 0;
    for (k < m.conflicts.len) {
        val r: *emit.Record = emit.record(f, "extension.Conflict");
        emit.member(f, r, "a", name(idents.data[m.conflicts.data[k].a]));
        emit.member(f, r, "b", name(idents.data[m.conflicts.data[k].b]));
        emit.item(f, conflicts, emit.Value.record{r});
        k = k + 1;
    }
    emit.declare(f, "CONFLICTS", nil, emit.Value.array{conflicts});
    emit.declare(f, "CONFLICT_COUNT", "u32", number(m.conflicts.len::i64));

    var combined:     emit.Pool   = emit.pool(f, "requirement.Id");
    val combinations: *emit.Array = emit.array(f, "extension.Combination");
    k = 0;
    for (k < m.combinations.len) {
        val x: *feature.Combination = ?m.combinations.data[k];
        val r: *emit.Record         = emit.record(f, "extension.Combination");
        emit.member(f, r, "by", name(idents.data[x.by]));
        emit.member(f, r, "when", run(f, ?combined, "COMBINED", ?idents, ?x.when));
        emit.member(f, r, "implies", run(f, ?combined, "COMBINED", ?idents, ?x.then));
        emit.item(f, combinations, emit.Value.record{r});
        k = k + 1;
    }
    emit.declare(f, "COMBINATIONS", nil, emit.Value.array{combinations});
    emit.declare(f, "COMBINATION_COUNT", "u32", number(m.combinations.len::i64));
    emit.declare_array(f, "COMBINED", combined.array);

    # llvm's names are aliases of the rows they cover, but for one that is a row's or a level's own name, which must
    # name the same row, as llvm's armv8.1-a names v8Ap1, the member of the level armv8.1-a
    var spelled:    emit.Pool   = emit.pool(f, "requirement.Id");
    val marched:    *emit.Array = emit.array(f, "index.Entry");
    val attributes: *emit.Array = emit.array(f, "extension.NameEntry");
    k = 0;
    for (k < spelt.len) {
        val s:   *Spelt      = ?spelt.data[k];
        val own: opt[*Spelt] = spelt_named(?canonical, s.name);
        if (sel own.some) {
            if (!same(?own.some.ids, ?s.ids)) { ret err[diag.Refusal].err{diag.refusal(f.path, 0, OWN_NAME, s.name)}; }
        }
        or {
            val rows: emit.Value = run(f, ?spelled, "SPELLED", ?idents, ?s.ids);
            emit.entry(f, named, s.name, name_entry(f, s.name, rows, false));
        }
        if (s.march && s.ids.len == 1) { emit.item(f, marched, entry(f, s.name, s.ids.data[0])); }
        if (s.attribute)               { emit.item(f, attributes, name_entry(f, s.name, run(f, ?spelled, "SPELLED", ?idents, ?s.ids), false)); }
        k = k + 1;
    }
    emit.seal(f, named);
    emit.declare(f, "NAMES", nil, emit.Value.array{named});
    emit.declare(f, "NAME_COUNT", "u32", number(emit.length(named)::i64));
    emit.declare_array(f, "NAMED", keyed.array);
    emit.declare(f, "MARCH_NAMES", nil, emit.Value.array{marched});
    emit.declare(f, "MARCH_COUNT", "u32", number(emit.length(marched)::i64));
    emit.declare(f, "ATTRIBUTES", nil, emit.Value.array{attributes});
    emit.declare(f, "ATTRIBUTE_COUNT", "u32", number(emit.length(attributes)::i64));
    emit.declare_array(f, "SPELLED", spelled.array);

    val missing: *emit.Array = emit.array(f, "str");
    k = 0;
    for (k < unlisted.len) {
        emit.item(f, missing, emit.Value.text{unlisted.data[k]});
        k = k + 1;
    }
    emit.declare_array(f, "LLVM_UNLISTED", missing);
    emit.declare(f, "LLVM_UNLISTED_COUNT", "u32", number(unlisted.len::i64));
    ret err[diag.Refusal].ok{};
}

# the aarch64 extension catalog generated from the feature model and llvm's names
pub fun generate(c: *set.Context) err[diag.Refusal] {
    val archive: res[*source.File, diag.Refusal] = tar.release(c.tree, c.generator.source.path);
    if (sel archive.err) { ret err[diag.Refusal].err{archive.err}; }
    val features: res[source.File, diag.Refusal] = tar.member(c.alloc, archive.ok, FEATURES);
    if (sel features.err) { ret err[diag.Refusal].err{features.err}; }
    var ff:   source.File                      = features.ok;
    val read: res[feature.Model, diag.Refusal] = feature.read(c.alloc, ?ff);
    if (sel read.err) { ret err[diag.Refusal].err{read.err}; }
    var m:        feature.Model = read.ok;
    val vendored: *source.Tree  = set.input(c, "llvm-aarch64");
    val over:     *source.Tree  = set.input(c, "aarch64-overlay");
    if (vendored == nil || over == nil) { ret err[diag.Refusal].err{diag.refusal(nil, 0, NO_NAMES, nil)}; }
    val td: opt[*source.File] = source.find(vendored, NAMES);
    if (sel td.none) { ret err[diag.Refusal].err{diag.refusal(nil, 0, NO_NAMES, nil)}; }
    val names: res[llvm.Names, diag.Refusal] = llvm.read(c.alloc, td.some);
    if (sel names.err) { ret err[diag.Refusal].err{names.err}; }
    var n:        llvm.Names           = names.ok;
    var spelt:    vector.Vector[Spelt] = vector.init[Spelt](c.alloc);
    var unlisted: vector.Vector[str]   = vector.init[str](c.alloc);
    val spelled:  err[diag.Refusal]    = spellings(c.alloc, ?m, ?n, td.some.path, ?spelt, ?unlisted);
    if (sel spelled.err) { ret spelled; }
    var cpus:      vector.Vector[Cpu] = vector.init[Cpu](c.alloc);
    val read_cpus: err[diag.Refusal]  = processors(c.alloc, over, ?m, ?unlisted, ?cpus);
    if (sel read_cpus.err) { ret read_cpus; }
    ret table(c, ?m, ?spelt, ?unlisted, ?cpus);
}

# the processors the cpus topic of `tree` states, each line's level the version it names first and its features rows
# of model `m`, a feature llvm names that the model has no row for, one of `unlisted`, dropped
fun processors(a: *A.Allocator, tree: *source.Tree, m: *feature.Model, unlisted: *vector.Vector[str], out: *vector.Vector[Cpu]) err[diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, CPUS);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, nil, topic.unstated);
    if (sel checked.err) { ret checked; }
    var i: usize = 0;
    for (i < t.facts.len) {
        var l:    topic.Line        = topic.Line{fact: nil, key: vector.init[str](a), ws: vector.init[str](a)};
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err)                            { ret read; }
        if (!topic.is(?l, "cpu", 2) || l.ws.len < 1) { ret err[diag.Refusal].err{topic.refuse(l.fact, BAD_CPU, nil)}; }
        val cpu: str   = l.key.data[1];
        var k:   usize = 0;
        for (k < out.len) {
            if (str_equals(out.data[k].name, cpu)) { ret err[diag.Refusal].err{topic.refuse(l.fact, CPU_TWICE, cpu)}; }
            k = k + 1;
        }
        var key: str       = cpu;
        val own: opt[*u32] = map.get[str, u32](?m.ids, ?key);
        if (sel own.some) { ret err[diag.Refusal].err{topic.refuse(l.fact, CPU_TWICE, cpu)}; }
        var version: u32 = 0;
        var v:       u32 = 0;
        for (v < m.versions) {
            val ln: str = level(a, m.rows.data[4 + v]);
            if (ln == nil)                    { ret memory(cpu); }
            if (str_equals(ln, cpu))          { ret err[diag.Refusal].err{topic.refuse(l.fact, CPU_TWICE, cpu)}; }
            if (str_equals(ln, l.ws.data[0])) { version = 4 + v; }
            v = v + 1;
        }
        if (version == 0) { ret err[diag.Refusal].err{topic.refuse(l.fact, CPU_LEVEL, l.ws.data[0])}; }
        var members: vector.Vector[u32] = vector.init[u32](a);
        vector.push[u32](?members, version);
        var w: usize = 1;
        for (w < l.ws.len) {
            var fk: str       = l.ws.data[w];
            val id: opt[*u32] = map.get[str, u32](?m.ids, ?fk);
            if (sel id.some) {
                if (!holds(?members, @id.some)) { vector.push[u32](?members, @id.some); }
            }
            or (!listed(unlisted, fk)) { ret err[diag.Refusal].err{topic.refuse(l.fact, CPU_FEATURE, fk)}; }
            w = w + 1;
        }
        vector.push[Cpu](out, Cpu{name: cpu, members: members});
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}
