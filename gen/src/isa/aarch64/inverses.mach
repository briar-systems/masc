# the inverses topic: the inverse of each conditional branch
#
# neither the instruction model nor the A64 ISA XML states a branch's inverse, so the topic gen/data/aarch64/inverses.txt
# states masc's own, each read against the branch's condition in the Arm ARM. an inverse's operands are those of the
# branch, its condition flipped where the line says:
#
#   invert <row> | to=<row> [flip=<mask> fixed=<member>,...] [args=<arg>,...]
#
# rows are named by key. `flip` flips the row's condition by `mask` and `fixed` names its members whose flip is no
# inverse, a branch holding one having none. `args` names, for each operand of the inverse but its target, the operand
# of the branch it takes, `<n>`, or that immediate plus or minus a constant, `<n>+<k>` or `<n>-<k>`, as cbgt's inverse
# is cbge with its registers swapped and cblt with its immediate one more, a sum the inverse does not admit leaving the
# branch none

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "inverses";

pub val BAD_LINE: str = "inverses line is not `invert <row> | to=<row> [flip=<mask> fixed=<member>,...] [args=<arg>,...]`";
pub val TWICE:    str = "inverses states a row twice";

# an operand of the inverse taken from the branch
# ---
# operand: the operand of the branch
# by:      what is added to it, 0 for its value as it is
pub rec Arg {
    operand: u8;
    by:      i64;
}

# one inverse
# ---
# from:  the key of the branch
# to:    the key of its inverse
# flip:  the bits its condition flips, 0 for a row with no condition
# fixed: the condition's members whose flip is no inverse
# args:  each operand of the inverse but its target, from the branch, none for each operand from its own place
# fact:  the line, for its refusals
pub rec Inverse {
    from:  str;
    to:    str;
    flip:  u32;
    fixed: vector.Vector[str];
    args:  vector.Vector[Arg];
    fact:  *topic.Fact;
}

fun fits(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# the members `text` names, split on commas
fun members(a: *A.Allocator, text: str, out: *vector.Vector[str]) bool {
    var start: usize = 0;
    var i:     usize = 0;
    for (true) {
        val c: u8 = text[i];
        if (c == 0 || c == ',') {
            val got: res[str, StrError] = str_copy_slice(a, text, start, i - start);
            if (sel got.err)                          { ret false; }
            if (!fits(vector.push[str](out, got.ok))) { ret false; }
            if (c == 0)                               { ret true; }
            start = i + 1;
        }
        i = i + 1;
    }
    ret true;
}

# the args `text` names, split on commas, each `<n>`, `<n>+<k>` or `<n>-<k>`
fun args_of(a: *A.Allocator, f: *topic.Fact, text: str, out: *vector.Vector[Arg]) err[diag.Refusal] {
    var words: vector.Vector[str] = vector.init[str](a);
    if (!members(a, text, ?words)) { ret err[diag.Refusal].err{topic.refuse(f, diag.MEMORY, nil)}; }
    var i: usize = 0;
    for (i < words.len) {
        val w:   str   = words.data[i];
        var cut: usize = 0;
        for (w[cut] != 0 && w[cut] != '+' && w[cut] != '-') { cut = cut + 1; }
        val head: res[str, StrError] = str_copy_slice(a, w, 0, cut);
        if (sel head.err) { ret err[diag.Refusal].err{topic.refuse(f, diag.MEMORY, nil)}; }
        val n: res[i64, diag.Refusal] = topic.number(f, head.ok);
        if (sel n.err)               { ret err[diag.Refusal].err{n.err}; }
        if (n.ok < 0 || n.ok > 0xff) { ret err[diag.Refusal].err{topic.refuse(f, BAD_LINE, w)}; }
        var by: i64 = 0;
        if (w[cut] != 0) {
            val k: res[i64, diag.Refusal] = topic.number(f, ?w[cut + 1]);
            if (sel k.err) { ret err[diag.Refusal].err{k.err}; }
            if (k.ok <= 0) { ret err[diag.Refusal].err{topic.refuse(f, BAD_LINE, w)}; }
            by = k.ok;
            if (w[cut] == '-') { by = 0 - k.ok; }
        }
        if (!fits(vector.push[Arg](out, Arg{operand: n.ok::u8, by: by}))) { ret err[diag.Refusal].err{topic.refuse(f, diag.MEMORY, nil)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the inverses topic of the data tree `tree`, each inverse in file order
pub fun read(a: *A.Allocator, tree: *source.Tree) res[vector.Vector[Inverse], diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, TOPIC);
    if (sel got.err) { ret res[vector.Vector[Inverse], diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, nil, topic.unstated);
    if (sel checked.err) { ret res[vector.Vector[Inverse], diag.Refusal].err{checked.err}; }
    var out: vector.Vector[Inverse] = vector.init[Inverse](a);
    var i:   usize                  = 0;
    for (i < t.facts.len) {
        var l:    topic.Line        = topic.Line{fact: nil, key: vector.init[str](a), ws: vector.init[str](a)};
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err)               { ret res[vector.Vector[Inverse], diag.Refusal].err{read.err}; }
        if (!topic.is(?l, "invert", 2)) { ret res[vector.Vector[Inverse], diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
        val to: opt[str] = topic.value(?l.ws, "to");
        if (sel to.none) { ret res[vector.Vector[Inverse], diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
        var inv: Inverse  = Inverse{from: l.key.data[1], to: to.some, flip: 0, fixed: vector.init[str](a), args: vector.init[Arg](a), fact: l.fact};
        val f:   opt[str] = topic.value(?l.ws, "flip");
        val fx:  opt[str] = topic.value(?l.ws, "fixed");
        val ag:  opt[str] = topic.value(?l.ws, "args");
        var n:   usize    = 1;
        if (sel ag.some) {
            val parsed: err[diag.Refusal] = args_of(a, l.fact, ag.some, ?inv.args);
            if (sel parsed.err) { ret res[vector.Vector[Inverse], diag.Refusal].err{parsed.err}; }
            n = n + 1;
        }
        if (sel f.some) {
            val mask: res[i64, diag.Refusal] = topic.number(l.fact, f.some);
            if (sel mask.err)                         { ret res[vector.Vector[Inverse], diag.Refusal].err{mask.err}; }
            if (mask.ok <= 0 || mask.ok > 0xffffffff) { ret res[vector.Vector[Inverse], diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, f.some)}; }
            inv.flip = mask.ok::u32;
            n        = n + 1;
        }
        if (sel fx.some) {
            if (sel f.none)                       { ret res[vector.Vector[Inverse], diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, fx.some)}; }
            if (!members(a, fx.some, ?inv.fixed)) { ret res[vector.Vector[Inverse], diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
            n = n + 1;
        }
        if (l.ws.len != n) { ret res[vector.Vector[Inverse], diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
        var k: usize = 0;
        for (k < out.len) {
            if (str_equals(out.data[k].from, inv.from)) { ret res[vector.Vector[Inverse], diag.Refusal].err{topic.refuse(l.fact, TWICE, inv.from)}; }
            k = k + 1;
        }
        if (!fits(vector.push[Inverse](?out, inv))) { ret res[vector.Vector[Inverse], diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        i = i + 1;
    }
    ret res[vector.Vector[Inverse], diag.Refusal].ok{out};
}
