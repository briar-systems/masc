# the mapping of the instruction model onto aarch64 rows
#
# an instruction's assembly is read as a tree: literal text, the tokens' texts, an optional text as `#`, its operand
# symbols, each one the operands topic states, and the choices whose branches hold operands. a choice with a branch of
# the model's empty default rules is an optional group: the row spells every operand of its other branch, and each set
# of such groups left out is an alias of the row whose sources give the left out operands the defaults the topic
# states, so `ldr x0, [x1]` is `ldr x0, [x1, #0]`. a choice of operand branches the topic states as a rows choice over
# fields is a row per branch, as `<Wm>` or `<Xm>` by option.
#
# a choice the topic makes `rows` of is spelled in place by each member, one row per member, the member fixing the
# bits of the choice's fields it encodes and its own condition holding with the instruction's, so a row's element
# widths are fixed, as `add z0.s, z1.s, z2.s` is the row add_z_zz_.s. a member of several cubes fixes the bits they
# share and leaves the rest to the operands that share its fields, each enumerant among them keeping the members that
# lie in one of its cubes. every other operand takes the bits of its fields its row leaves free, from its value's high
# bit, and every bit of the encoding is the encoding's, a member's or one operand's. an operand written again, as the
# destructive `<Zdn>`, is one operand at each of its holes.
#
# a row's requirement is its conditions as alternatives over the catalog's features, each field test of a condition
# decided by the bits the row fixes. the streaming topic states under which value of streaming each alternative holds.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use std.collections.map;
use std.collections.sort;
use std.collections.vector;

use json.lib.json;

use masc.core.field;
use masc.core.operand;

use gen.diag;
use gen.isa.aarch64;
use gen.isa.aarch64.expr;
use gen.isa.aarch64.feature;
use gen.isa.aarch64.instructions;
use gen.isa.aarch64.operands;
use gen.isa.aarch64.streaming;
use gen.overlay;

pub val UNSTATED:     str = "operand rule the operands topic does not state";
pub val NO_ELEMENT:   str = "element specifier the operands topic does not state";
pub val NO_CLASS:     str = "register class the register file does not hold";
pub val NO_FIELD:     str = "operand is encoded in a field the encoding does not have";
pub val UNHELD:       str = "encoding leaves bits no operand holds";
pub val HELD_TWICE:   str = "bits held by two operands";
pub val MEMBERS:      str = "choice members differ from the text the model gives it";
pub val MEMBER_BITS:  str = "member bits differ in length from the choice's fields or fix a bit the encoding fixes";
pub val OPEN_MEMBER:  str = "enumerant member leaves a bit open";
pub val NO_MEMBER:    str = "enumerant keeps no member in its row";
pub val TEXT_RULE:    str = "assembly rule that is no operand is neither text nor an optional text";
pub val CONDITION:    str = "condition the mapping does not read";
pub val UNDECIDED:    str = "condition tests bits the row leaves to its operands";
pub val NO_FEATURE:   str = "condition names a feature the catalog does not hold";
pub val NEVER:        str = "row's conditions never hold";
pub val NUMBERED:     str = "rule of a register spelled by its number is not text around one number";
pub val SPELLED:      str = "rule of an immediate is not text and optional text around one number";
pub val CHOSEN:       str = "register of the chosen class follows no rows member";
pub val CHOICES:      str = "choice of operand branches the operands topic does not state";
pub val BRANCHES:     str = "optional group is not one branch of default rules beside one of operands";
pub val NO_DEFAULT:   str = "operand of an optional group states no default";
pub val UNROLED:      str = "register states no role, and its instruction no role line for it";
pub val NO_RANGE:     str = "immediate range is no block of its bits";
pub val NO_CUBE:      str = "number by other fields has no cube the row's bits decide";
pub val NOT_POWER:    str = "number's bits weigh no distinct powers of two";
pub val GAPPED:       str = "immediate's bits leave a gap in its value";
pub val NEGATIVE:     str = "register number is negative";
pub val TWO_KINDS:    str = "row has two operands a field kind of its own encodes";
pub val UNMAPPED:     str = "operand shape the mapping does not read yet";
pub val TOO_MANY:     str = "instruction has more optional groups than the mapping spells";
pub val LIST_FIRST:   str = "list's first member is not its lowest";
pub val NO_WIDTH:     str = "immediate of a kind of its own is the value of no register or element of a width it takes";
pub val LIST_SPELLED: str = "list written again with other members than where it is first written";
pub val DERIVED_OUT:  str = "hole derives its value from an operand its spelling leaves out";

# the rule of no hole
val NO_RULE: u32 = 0xFFFF_FFFF;

# the most registers one operand covers from the one it names
val MAX_FIELDS: u32 = 4;

# the format of a register hole that spells the register by its number, as masc.core.syntax names it
val NUMBER: str = "number";

# the most optional groups one instruction may have, whose subsets are its aliases
val MAX_GROUPS: u32 = 6;

# what an operand is
pub def Shape: u8;

pub val REGISTER:  Shape = 0;
pub val IMMEDIATE: Shape = 1;
pub val ENUMERANT: Shape = 2;
pub val RELATIVE:  Shape = 3;

# one enumerant member: its text and its value
pub rec Member {
    name:  str;
    value: u32;
}

# one operand of a row
# ---
# rule:            the rule it is, by its display
# fact:            what the topic states of it
# shape:           what it is
# classes:         a register's classes, by their index in the register file
# first:           a register's first number
# count:           how many numbers it admits from first, 0 for every number of the class
# excluded:        the numbers within its range a register does not admit
# element:         the width of the elements a register holds
# role:            how the row uses it
# immediate:       an immediate's number
# members:         an enumerant's members, in the topic's order
# slices:          where its bits lie, its operand left for the row to number
# format:          the format its hole hands the syntax, nil for none
# kind:            the aarch64 field kind its bits are, 0 for the unit's slices
# param:           that kind's param
# open:            whether an enumerant admits every value of its bits, those no member names spelled by number
# mask:            whether an enumerant's value is any union of its members
# page:            whether a relative target is a 4KB page's
# prefix:          the text before its number the register's name holds, as `v` of `V<m>`, nil for none
# excluded_values: the values an immediate's bits hold beyond its range
# own:             the instruction bits a field kind of its own encodes, which no slice holds
# places:          the instruction bits of its fields, from the high bit
# row_mask:        the bits its row fixes where it was built
# fields:          how many registers a register covers from the one it names, as casp's pair 2
# list:            whether it is a list of registers, its members the register it would be and the ones after it
# length:          a list's members
# stride:          how far past the one before each member of a list lies, 1 for the next
# leading:         the numbers of its member range a list's first member never takes
# joined:          a list's member rules in written order, the first its own
pub rec Operand {
    rule:            *instructions.Rule;
    fact:            *operands.Fact;
    shape:           Shape;
    classes:         vector.Vector[u16];
    first:           u32;
    count:           u32;
    excluded:        vector.Vector[u32];
    element:         operand.Element;
    role:            operand.Role;
    immediate:       operand.Immediate;
    members:         vector.Vector[Member];
    slices:          vector.Vector[field.Slice];
    format:          str;
    kind:            u16;
    param:           u64;
    open:            bool;
    mask:            bool;
    page:            bool;
    prefix:          str;
    excluded_values: vector.Vector[i64];
    own:             u64;
    places:          vector.Vector[u8];
    row_mask:        u64;
    fields:          u8;
    list:            bool;
    length:          u8;
    stride:          u8;
    leading:         vector.Vector[u32];
    joined:          vector.Vector[u32];
}

# a hole a row spells as a value derived from another operand's, as casp's `<X(s+1)>` from `<Xs>`
# ---
# rule:   the hole's rule
# base:   the rule of the operand it derives from
# format: the derivation, as `+1` or `=w,wzr`, nil for the base's own value written again
pub rec Derived {
    rule:   u32;
    base:   u32;
    format: str;
}

# the aarch64 field kinds an operand may be, as masc.isa.aarch64.field numbers them
pub val UNIT_KIND:     u16 = 0;
pub val BITMASK_KIND:  u16 = 1;
pub val FLOAT8_KIND:   u16 = 2;
pub val MULTIPLE_KIND: u16 = 3;

# one way to meet a row's requirement, its atoms as the emitted constants name them
pub rec Alternative {
    all:  vector.Vector[str];
    none: vector.Vector[str];
}

# where an alias takes a value of its row's operand from
# ---
# operand:   this operand of the alias
# immediate: this immediate
# enumerant: this enumerant's value
# register:  the register at this row of the register file
pub tag Source: u8 {
    operand:   u8;
    immediate: i64;
    enumerant: u32;
    register:  u32;
}

# a spelling of a row with optional groups left out
# ---
# template:   its spelling over its own operands
# count:      how many operands it has
# sources:    where each operand of the row takes its value from
# preference: how many groups it leaves out, the most printed
pub rec Alias {
    template:   str;
    count:      u8;
    sources:    vector.Vector[Source];
    preference: u8;
}

# a row
# ---
# key:         its key, the instruction's name and each member it is made of, as `add_z_zz_.s`
# mnemonic:    its mnemonic
# template:    its spelling
# instruction: the instruction it is an encoding of
# fixed:       its fixed bits
# mask:        which bits are fixed
# operands:    its operands in written order
# requires:    its requirement's alternatives
# aliases:     its spellings with optional groups left out
# derived:     the holes it spells as values derived from its operands'
pub rec Row {
    key:         str;
    mnemonic:    str;
    template:    str;
    instruction: *instructions.Instruction;
    fixed:       u64;
    mask:        u64;
    operands:    vector.Vector[Operand];
    requires:    vector.Vector[Alternative];
    aliases:     vector.Vector[Alias];
    derived:     vector.Vector[Derived];
}

# what the mapping reads
# ---
# model:     the instruction model
# operands:  the operands topic
# streaming: the streaming topic
# features:  the feature model, whose rows the catalog holds
# registers: the register families
pub rec Sources {
    model:     *instructions.Model;
    operands:  *operands.Operands;
    streaming: *streaming.Streaming;
    features:  *feature.Model;
    registers: *aarch64.Families;
}

# a node of an instruction's template tree
# ---
# text:         literal text
# hole:         an operand symbol, by its rule
# optional:     text that may be left out, as `#`
# alternatives: a choice whose branches hold operands, by its index in the mapper's alternatives
pub tag Node: u8 {
    text:         str;
    hole:         u32;
    optional:     str;
    alternatives: u32;
}

# a choice whose branches hold operands
# ---
# rule:     the choice
# branches: each branch's nodes
# fact:     the topic's rows choice over its branches, nil for an optional group
# parent:   the optional group it lies in, -1 for none
pub rec Alternatives {
    rule:     u32;
    branches: vector.Vector[vector.Vector[Node]];
    fact:     *operands.Fact;
    parent:   i32;
}

# a piece of one spelling of an instruction
# ---
# text:     literal text
# hole:     an operand symbol, by its rule
# optional: text that may be left out
# member:   the text of a rows member written in place, by the index of its choice among the row's
pub tag Piece: u8 {
    text:     str;
    hole:     u32;
    optional: str;
    member:   u32;
}

# a rows choice of a row: an operand the topic makes rows of, or a choice of operand branches
# ---
# rule:   the choice
# fact:   the topic's fact of it
# places: the bit positions of its fields, from the high bit
# hole:   whether it is an operand written in place, false for a choice of branches
rec Choice {
    rule:   u32;
    fact:   *operands.Fact;
    places: vector.Vector[u8];
    hole:   bool;
}

# bits a member of several cubes leaves to the operands that share its fields
# ---
# places: the bit positions of its fields, from the high bit
# cubes:  the member's cubes over them
rec Within {
    places: *vector.Vector[u8];
    cubes:  *vector.Vector[str];
}

rec Mapper {
    alloc:   *A.Allocator;
    src:     *Sources;
    ins:     *instructions.Instruction;
    alts:    vector.Vector[Alternatives];
    failed:  bool;
    failure: diag.Refusal;
}

fun fail(m: *Mapper, message: str, subject: str) {
    if (m.failed) { ret; }
    m.failed = true;
    var s: str = subject;
    if (m.ins != nil) {
        val both: res[str, StrError] = str_join(m.alloc, m.ins.name, ": ", subject);
        if (sel both.ok) { s = both.ok; }
    }
    if (subject == nil && m.ins != nil) { s = m.ins.name; }
    m.failure = diag.refusal(instructions.INSTRUCTIONS, 0, message, s);
}

fun pushed(m: *Mapper, got: res[usize, A.Error]) {
    if (sel got.err) { fail(m, diag.MEMORY, nil); }
}

# `s` in lower case, owned
fun lower(m: *Mapper, s: str) str {
    val len: usize             = str_len(s);
    val got: res[*u8, A.Error] = A.allocate[u8](m.alloc, len + 1);
    if (sel got.err) {
        fail(m, diag.MEMORY, nil);
        ret "";
    }
    var i: usize = 0;
    for (i < len) {
        var c: u8 = s[i];
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        got.ok[i] = c;
        i         = i + 1;
    }
    got.ok[len] = 0;
    ret got.ok;
}

fun join(m: *Mapper, a: str, b: str) str {
    val got: res[str, StrError] = str_join(m.alloc, a, b);
    if (sel got.err) {
        fail(m, diag.MEMORY, nil);
        ret "";
    }
    ret got.ok;
}

# whether the instruction encodes an operand by the symbol `display`
fun encoded(ins: *instructions.Instruction, display: str) *instructions.Encoded {
    if (display == nil) { ret nil; }
    var i: usize = 0;
    for (i < ins.encoded.len) {
        if (str_equals(ins.encoded.data[i].display, display)) { ret ?ins.encoded.data[i]; }
        i = i + 1;
    }
    ret nil;
}

# the text a token is written as: one space between words, a comma and a space between operands
fun token_text(r: *instructions.Rule) str {
    if (str_equals(r.id, "SPACE")) { ret " "; }
    if (str_equals(r.id, "COMMA")) { ret ", "; }
    ret r.token;
}

# the rule `s` refers to, nil for a literal
fun referred(m: *Mapper, s: instructions.Symbol) *instructions.Rule {
    if (sel s.rule) { ret ?m.src.model.rules.data[s.rule]; }
    ret nil;
}

# the text of `symbols` with every optional text in it, a rule spelled by its own text and a token by its default,
# nil when a choice in it is no optional text
fun spelled(m: *Mapper, symbols: *vector.Vector[instructions.Symbol]) str {
    var out: str   = "";
    var i:   usize = 0;
    for (i < symbols.len && !m.failed) {
        val s: instructions.Symbol = symbols.data[i];
        if (sel s.literal) { out = join(m, out, s.literal); }
        if (sel s.rule) {
            val r: *instructions.Rule = ?m.src.model.rules.data[s.rule];
            if (r.kind == instructions.TOKEN) {
                val t: str = token_text(r);
                if (t == nil) { ret nil; }
                out = join(m, out, t);
            }
            or (r.kind == instructions.RULE) {
                val t: str = spelled(m, ?r.symbols);
                if (t == nil) { ret nil; }
                out = join(m, out, t);
            }
            or {
                if (r.choices.len != 2) { ret nil; }
                val a: *vector.Vector[instructions.Symbol] = ?r.choices.data[0];
                val b: *vector.Vector[instructions.Symbol] = ?r.choices.data[1];
                var t: str                                 = nil;
                if (a.len > 0 && b.len == 0) { t = spelled(m, a); }
                or (a.len == 0 && b.len > 0) { t = spelled(m, b); }
                if (t == nil)                { ret nil; }
                out = join(m, out, t);
            }
        }
        i = i + 1;
    }
    ret out;
}

# whether `nodes` hold an operand
fun has_operand(nodes: *vector.Vector[Node]) bool {
    var i: usize = 0;
    for (i < nodes.len) {
        val n: Node = nodes.data[i];
        if (sel n.hole)         { ret true; }
        if (sel n.alternatives) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the text of `nodes` that hold no operand, every optional text in it
fun text_of(m: *Mapper, nodes: *vector.Vector[Node]) str {
    var out: str   = "";
    var i:   usize = 0;
    for (i < nodes.len) {
        val n: Node = nodes.data[i];
        if (sel n.text)     { out = join(m, out, n.text); }
        if (sel n.optional) { out = join(m, out, n.optional); }
        i = i + 1;
    }
    ret out;
}

# `symbols` as a tree, a rule no operand is read for its text, in an optional group `parent`
fun tree(m: *Mapper, symbols: *vector.Vector[instructions.Symbol], parent: i32, out: *vector.Vector[Node]) {
    var i: usize = 0;
    for (i < symbols.len && !m.failed) {
        val s: instructions.Symbol = symbols.data[i];
        if (sel s.literal) { pushed(m, vector.push[Node](out, Node.text{s.literal})); }
        if (sel s.rule) {
            val r: *instructions.Rule = ?m.src.model.rules.data[s.rule];
            if (encoded(m.ins, r.display) != nil) { pushed(m, vector.push[Node](out, Node.hole{s.rule})); }
            or (r.kind == instructions.TOKEN) {
                val t: str = token_text(r);
                if (t == nil) { fail(m, TEXT_RULE, r.id); }
                or            { pushed(m, vector.push[Node](out, Node.text{t})); }
            }
            or (r.kind == instructions.RULE) { tree(m, ?r.symbols, parent, out); }
            or (one_of(m, r) != nil)         { one(m, r, parent, out); }
            or {
                val at:  u32          = m.alts.len::u32;
                var alt: Alternatives = Alternatives{rule: s.rule, branches: vector.init[vector.Vector[Node]](m.alloc), fact: nil, parent: parent};
                pushed(m, vector.push[Alternatives](?m.alts, alt));
                var any: bool  = false;
                var k:   usize = 0;
                for (k < r.choices.len && !m.failed) {
                    var b: vector.Vector[Node] = vector.init[Node](m.alloc);
                    tree(m, ?r.choices.data[k], at::i32, ?b);
                    if (has_operand(?b)) { any = true; }
                    pushed(m, vector.push[vector.Vector[Node]](?m.alts.data[at].branches, b));
                    k = k + 1;
                }
                if (m.failed) { ret; }
                if (!any) {
                    # a choice no operand is read for is text that may be left out
                    val bs: *vector.Vector[vector.Vector[Node]] = ?m.alts.data[at].branches;
                    m.alts.len = at::usize;
                    if (bs.len != 2)                               { fail(m, TEXT_RULE, r.id); }
                    or (bs.data[0].len > 0 && bs.data[1].len == 0) { pushed(m, vector.push[Node](out, Node.optional{text_of(m, ?bs.data[0])})); }
                    or (bs.data[0].len == 0 && bs.data[1].len > 0) { pushed(m, vector.push[Node](out, Node.optional{text_of(m, ?bs.data[1])})); }
                    or                                             { fail(m, TEXT_RULE, r.id); }
                }
                or {
                    pushed(m, vector.push[Node](out, Node.alternatives{at}));
                }
            }
        }
        i = i + 1;
    }
}

# the rule choice `r` is one operand of, as the topic states it, nil for a choice the topic states no such line of
fun one_of(m: *Mapper, r: *instructions.Rule) str {
    val got: opt[*operands.Fact] = operands.of(m.src.operands, r.id);
    if (sel got.none)                 { ret nil; }
    if (got.some.use != operands.ONE) { ret nil; }
    ret got.some.one;
}

# whether `symbols` refer to rule `id`, through rules and choices
fun refers(m: *Mapper, symbols: *vector.Vector[instructions.Symbol], id: str) bool {
    var i: usize = 0;
    for (i < symbols.len) {
        val s: instructions.Symbol = symbols.data[i];
        if (sel s.rule) {
            val r: *instructions.Rule = ?m.src.model.rules.data[s.rule];
            if (str_equals(r.id, id))                                     { ret true; }
            if (r.kind == instructions.RULE && refers(m, ?r.symbols, id)) { ret true; }
            if (r.kind == instructions.CHOICE) {
                var k: usize = 0;
                for (k < r.choices.len) {
                    if (refers(m, ?r.choices.data[k], id)) { ret true; }
                    k = k + 1;
                }
            }
        }
        i = i + 1;
    }
    ret false;
}

# choice `r` read as the one operand of the rule the topic names: its branch of that rule, beside an empty branch
# when it has one, so the choice is an optional group of it. the other branches spell the operand's values by number,
# which its operand's syntax reads and writes
fun one(m: *Mapper, r: *instructions.Rule, parent: i32, out: *vector.Vector[Node]) {
    val id:    str   = one_of(m, r);
    var named: i64   = -1;
    var empty: i64   = -1;
    var k:     usize = 0;
    for (k < r.choices.len) {
        if (refers(m, ?r.choices.data[k], id))                             { named = k::i64; }
        or (r.choices.data[k].len == 0 || defaults(m, ?r.choices.data[k])) { empty = k::i64; }
        k = k + 1;
    }
    if (named < 0) {
        fail(m, CHOICES, r.id);
        ret;
    }
    if (empty < 0) {
        tree(m, ?r.choices.data[named::usize], parent, out);
        ret;
    }
    val at:  u32          = m.alts.len::u32;
    var alt: Alternatives = Alternatives{rule: 0, branches: vector.init[vector.Vector[Node]](m.alloc), fact: nil, parent: parent};
    pushed(m, vector.push[Alternatives](?m.alts, alt));
    var none: vector.Vector[Node] = vector.init[Node](m.alloc);
    var held: vector.Vector[Node] = vector.init[Node](m.alloc);
    tree(m, ?r.choices.data[named::usize], at::i32, ?held);
    pushed(m, vector.push[vector.Vector[Node]](?m.alts.data[at].branches, none));
    pushed(m, vector.push[vector.Vector[Node]](?m.alts.data[at].branches, held));
    var ri:    u32       = 0;
    val found: opt[*u32] = map.get[str, u32](?m.src.model.ids, ?r.id);
    if (sel found.some) { ri = @found.some; }
    m.alts.data[at].rule = ri;
    pushed(m, vector.push[Node](out, Node.alternatives{at}));
}

# whether `symbols` are the model's default rules alone, which hold no text
fun defaults(m: *Mapper, symbols: *vector.Vector[instructions.Symbol]) bool {
    var i: usize = 0;
    for (i < symbols.len) {
        val s: instructions.Symbol = symbols.data[i];
        if (sel s.literal) { ret false; }
        if (sel s.rule) {
            val r: *instructions.Rule = ?m.src.model.rules.data[s.rule];
            if (r.kind != instructions.RULE || r.symbols.len > 0) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

# whether alternatives `a` is an optional group: one empty branch, the model's default rules, beside one of operands
fun optional_group(a: *Alternatives) bool {
    ret a.fact == nil;
}

# the branch of optional group `a` that holds its operands
fun full(a: *Alternatives) usize {
    if (a.branches.data[0].len == 0) { ret 1; }
    ret 0;
}

# the alternatives of the tree read: an optional group checked, a choice of operand branches given its fact
fun settle(m: *Mapper) {
    var i: usize = 0;
    for (i < m.alts.len && !m.failed) {
        val a:     *Alternatives = ?m.alts.data[i];
        var empty: u32           = 0;
        var k:     usize         = 0;
        for (k < a.branches.len) {
            if (a.branches.data[k].len == 0) { empty = empty + 1; }
            k = k + 1;
        }
        val r: *instructions.Rule = ?m.src.model.rules.data[a.rule];
        if (empty > 0) {
            if (empty != 1 || a.branches.len != 2) { fail(m, BRANCHES, r.id); }
        }
        or {
            val got: opt[*operands.Fact] = operands.of(m.src.operands, r.id);
            var f:   *operands.Fact      = nil;
            if (sel got.some)                                                                        { f = got.some; }
            if (f == nil || f.use != operands.CHOICE || f.how != operands.ROWS || f.fields.len == 0) { fail(m, CHOICES, r.id); }
            or                                                                                       { a.fact = f; }
        }
        i = i + 1;
    }
}

# the bit positions of the fields `fields` names, from the high bit of the first
fun positions(m: *Mapper, fields: *vector.Vector[str], out: *vector.Vector[u8]) {
    var i: usize = 0;
    for (i < fields.len && !m.failed) {
        var found: bool  = false;
        var k:     usize = 0;
        for (k < m.ins.bits.len) {
            val b: *instructions.Bits = ?m.ins.bits.data[k];
            if (b.name != nil && str_equals(b.name, fields.data[i])) {
                found = true;
                var p: u8 = b.width;
                for (p > 0) {
                    p = p - 1;
                    pushed(m, vector.push[u8](out, b.start + p));
                }
            }
            k = k + 1;
        }
        if (!found) { fail(m, NO_FIELD, fields.data[i]); }
        i = i + 1;
    }
}

# the text of member `k` of choice rule `r`
fun member_text(m: *Mapper, r: *instructions.Rule, k: usize) str {
    val t: str = spelled(m, ?r.choices.data[k]);
    if (t == nil) {
        fail(m, MEMBERS, r.id);
        ret "";
    }
    ret t;
}

# the condition of member `k` of choice rule `r`: the condition of the rule the member is, nil for none
fun member_condition(m: *Mapper, r: *instructions.Rule, k: usize) *json.Value {
    val c: *vector.Vector[instructions.Symbol] = ?r.choices.data[k];
    if (c.len != 1) { ret nil; }
    val s: instructions.Symbol = c.data[0];
    if (!sel s.rule) { ret nil; }
    ret m.src.model.rules.data[s.rule].condition;
}

# the topic's member of choice `f` that member `k` of choice rule `r` is: by its text, or for a choice of operand
# branches by the rule of the branch's first operand
fun choice_member(m: *Mapper, r: *instructions.Rule, f: *operands.Fact, k: usize, a: *Alternatives) *operands.Member {
    var text: str = nil;
    if (a != nil) {
        val b: *vector.Vector[Node] = ?a.branches.data[k];
        var i: usize                = 0;
        for (i < b.len && text == nil) {
            val n: Node = b.data[i];
            if (sel n.hole) { text = m.src.model.rules.data[n.hole].id; }
            i = i + 1;
        }
    }
    or            { text = member_text(m, r, k); }
    if (m.failed) { ret nil; }
    var i: usize = 0;
    for (i < f.members.len) {
        if (str_equals(f.members.data[i].text, text)) { ret ?f.members.data[i]; }
        i = i + 1;
    }
    fail(m, MEMBERS, text);
    ret nil;
}

# condition evaluation
#
# a condition is read as alternatives, each a conjunction of features held and features not held. a test of a
# field's bits is decided by the bits the row fixes, and a condition that tests bits the row leaves open is refused

rec Conjunction {
    all:  vector.Vector[str];
    none: vector.Vector[str];
}

rec Formula {
    alternatives: vector.Vector[Conjunction];
}

fun formula(m: *Mapper) Formula {
    ret Formula{alternatives: vector.init[Conjunction](m.alloc)};
}

fun conjunction(m: *Mapper) Conjunction {
    ret Conjunction{all: vector.init[str](m.alloc), none: vector.init[str](m.alloc)};
}

fun truth(m: *Mapper, held: bool) Formula {
    var f: Formula = formula(m);
    if (held) { pushed(m, vector.push[Conjunction](?f.alternatives, conjunction(m))); }
    ret f;
}

fun holds(names: *vector.Vector[str], name: str) bool {
    var i: usize = 0;
    for (i < names.len) {
        if (str_equals(names.data[i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun copy(m: *Mapper, c: *Conjunction) Conjunction {
    var out: Conjunction = conjunction(m);
    var i:   usize       = 0;
    for (i < c.all.len) {
        pushed(m, vector.push[str](?out.all, c.all.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < c.none.len) {
        pushed(m, vector.push[str](?out.none, c.none.data[i]));
        i = i + 1;
    }
    ret out;
}

# `a` and `b` both, each pair of alternatives joined, a pair that holds and lacks one feature dropped
fun both(m: *Mapper, a: *Formula, b: *Formula) Formula {
    var out: Formula = formula(m);
    var i:   usize   = 0;
    for (i < a.alternatives.len) {
        var k: usize = 0;
        for (k < b.alternatives.len) {
            var c:  Conjunction  = copy(m, ?a.alternatives.data[i]);
            val y:  *Conjunction = ?b.alternatives.data[k];
            var ok: bool         = true;
            var j:  usize        = 0;
            for (j < y.all.len) {
                if (holds(?c.none, y.all.data[j])) { ok = false; }
                if (!holds(?c.all, y.all.data[j])) { pushed(m, vector.push[str](?c.all, y.all.data[j])); }
                j = j + 1;
            }
            j = 0;
            for (j < y.none.len) {
                if (holds(?c.all, y.none.data[j]))   { ok = false; }
                if (!holds(?c.none, y.none.data[j])) { pushed(m, vector.push[str](?c.none, y.none.data[j])); }
                j = j + 1;
            }
            if (ok) { pushed(m, vector.push[Conjunction](?out.alternatives, c)); }
            k = k + 1;
        }
        i = i + 1;
    }
    ret out;
}

fun either(m: *Mapper, a: *Formula, b: *Formula) Formula {
    var out: Formula = formula(m);
    var i:   usize   = 0;
    for (i < a.alternatives.len) {
        pushed(m, vector.push[Conjunction](?out.alternatives, a.alternatives.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < b.alternatives.len) {
        pushed(m, vector.push[Conjunction](?out.alternatives, b.alternatives.data[i]));
        i = i + 1;
    }
    ret out;
}

# not `a`: every alternative failing, so for each one a feature it holds lacked or one it lacks held
fun negated(m: *Mapper, a: *Formula) Formula {
    var out: Formula = truth(m, true);
    var i:   usize   = 0;
    for (i < a.alternatives.len) {
        val c:   *Conjunction = ?a.alternatives.data[i];
        var any: Formula      = formula(m);
        var k:   usize        = 0;
        for (k < c.all.len) {
            var x: Conjunction = conjunction(m);
            pushed(m, vector.push[str](?x.none, c.all.data[k]));
            pushed(m, vector.push[Conjunction](?any.alternatives, x));
            k = k + 1;
        }
        k = 0;
        for (k < c.none.len) {
            var x: Conjunction = conjunction(m);
            pushed(m, vector.push[str](?x.all, c.none.data[k]));
            pushed(m, vector.push[Conjunction](?any.alternatives, x));
            k = k + 1;
        }
        out = both(m, ?out, ?any);
        i   = i + 1;
    }
    ret out;
}

# the bits field `name` holds in the row, as a pattern of 0, 1 and x from its high bit
fun field_bits(m: *Mapper, name: str, fixed: u64, mask: u64, out: *vector.Vector[u8]) bool {
    var k: usize = 0;
    for (k < m.ins.bits.len) {
        val b: *instructions.Bits = ?m.ins.bits.data[k];
        if (b.name != nil && str_equals(b.name, name)) {
            var p: u8 = b.width;
            for (p > 0) {
                p = p - 1;
                val at: u64 = (b.start + p)::u64;
                var c:  u8  = 'x';
                if (((mask >> at) & 1) != 0) { c = '0' + ((fixed >> at) & 1)::u8; }
                pushed(m, vector.push[u8](out, c));
            }
            ret true;
        }
        k = k + 1;
    }
    ret false;
}

# whether the row's bits `bits` match the model's pattern `quoted`, `'01x'`: 1 when they do, 0 when they do not and
# -1 when a bit the pattern tests is open
fun matches(bits: *vector.Vector[u8], pattern: str) i32 {
    val len: usize = str_len(pattern);
    if (len != bits.len + 2) { ret -2; }
    var open: bool  = false;
    var i:    usize = 0;
    for (i < bits.len) {
        val want: u8 = pattern[i + 1];
        val got:  u8 = bits.data[i];
        if (want != 'x') {
            if (got == 'x')  { open = true; }
            or (got != want) { ret 0; }
        }
        i = i + 1;
    }
    if (open) { ret -1; }
    ret 1;
}

# the decided truth of a field test `left op right` over the row's bits, -1 when undecided and -2 when malformed
fun field_test(m: *Mapper, e: *json.Value, fixed: u64, mask: u64) i32 {
    val left:  *json.Value = at(e, "left");
    val right: *json.Value = at(e, "right");
    if (!instructions.kind(left, "AST.Identifier")) { ret -2; }
    val name: str               = string(m, left, "value");
    var bits: vector.Vector[u8] = vector.init[u8](m.alloc);
    if (!field_bits(m, name, fixed, mask, ?bits)) { ret -2; }
    val op: str = string(m, e, "op");
    if (instructions.kind(right, "Values.Value")) {
        val got: i32 = matches(?bits, string(m, right, "value"));
        if (got < 0)              { ret got; }
        if (str_equals(op, "==")) { ret got; }
        if (str_equals(op, "!=")) { ret 1 - got; }
        ret -2;
    }
    if (instructions.kind(right, "AST.Set") && str_equals(op, "IN")) {
        val values: *json.Value = at(right, "values");
        if (values == nil || values.kind != json.ARRAY) { ret -2; }
        var open: bool  = false;
        var i:    usize = 0;
        for (i < values.count) {
            val got: i32 = matches(?bits, string(m, ?values.children[i], "value"));
            if (got == 1)  { ret 1; }
            if (got == -1) { open = true; }
            if (got == -2) { ret -2; }
            i = i + 1;
        }
        if (open) { ret -1; }
        ret 0;
    }
    ret -2;
}

fun at(v: *json.Value, key: str) *json.Value {
    if (v == nil || v.kind != json.OBJECT) { ret nil; }
    val got: opt[*json.Value] = json.value_find(v, key);
    if (sel got.none) { ret nil; }
    ret got.some;
}

# the text of string member `key` of `v`, owned, empty when it is absent
fun string(m: *Mapper, v: *json.Value, key: str) str {
    val s: *json.Value = at(v, key);
    if (s == nil || s.kind != json.STRING) { ret ""; }
    # the string's bytes lie within the document unterminated, so they are copied by their length
    val got: res[*u8, A.Error] = A.allocate[u8](m.alloc, s.str_len + 1);
    if (sel got.err) {
        fail(m, diag.MEMORY, nil);
        ret "";
    }
    var i: usize = 0;
    for (i < s.str_len) {
        got.ok[i] = s.str_val[i];
        i         = i + 1;
    }
    got.ok[s.str_len] = 0;
    ret got.ok;
}

# condition `e` as alternatives over features, its field tests decided by the row's bits. where `top` holds, `e` is a
# conjunct the row's condition holds only with, so a test of bits an operand of `row` holds that refuses values is
# those values excluded from the operand
fun condition(m: *Mapper, e: *json.Value, fixed: u64, mask: u64, row: *Row, top: bool) Formula {
    if (e == nil) { ret truth(m, true); }
    if (top) {
        val ex: i32 = exclude(m, row, e);
        if (ex >= 0) { ret truth(m, ex == 1); }
    }
    if (instructions.kind(e, "AST.Bool")) {
        val v: *json.Value = at(e, "value");
        ret truth(m, v != nil && v.kind == json.BOOL && json.value_bool(v));
    }
    if (instructions.kind(e, "AST.Function")) {
        val args: *json.Value = at(e, "arguments");
        if (!str_equals(string(m, e, "name"), "IsFeatureImplemented") || args == nil || args.kind != json.ARRAY || args.count != 1 || !instructions.kind(?args.children[0], "AST.Identifier")) {
            fail(m, CONDITION, string(m, e, "name"));
            ret truth(m, false);
        }
        var c: Conjunction = conjunction(m);
        pushed(m, vector.push[str](?c.all, string(m, ?args.children[0], "value")));
        var f: Formula = formula(m);
        pushed(m, vector.push[Conjunction](?f.alternatives, c));
        ret f;
    }
    if (instructions.kind(e, "AST.UnaryOp") && str_equals(string(m, e, "op"), "!")) {
        var inner: Formula = condition(m, at(e, "expr"), fixed, mask, row, false);
        ret negated(m, ?inner);
    }
    if (instructions.kind(e, "AST.BinaryOp")) {
        val op: str = string(m, e, "op");
        if (str_equals(op, "&&") || str_equals(op, "||")) {
            val and: bool    = str_equals(op, "&&");
            var a:   Formula = condition(m, at(e, "left"), fixed, mask, row, top && and);
            var b:   Formula = condition(m, at(e, "right"), fixed, mask, row, top && and);
            if (str_equals(op, "&&")) { ret both(m, ?a, ?b); }
            ret either(m, ?a, ?b);
        }
        val decided: i32 = field_test(m, e, fixed, mask);
        if (decided == -1) {
            fail(m, UNDECIDED, op);
            ret truth(m, false);
        }
        if (decided >= 0) { ret truth(m, decided == 1); }
    }
    fail(m, CONDITION, string(m, e, "_type"));
    ret truth(m, false);
}

# a test of a field against a pattern: the field's instruction bits from the high bit and the pattern's bits, `x` for
# a bit it leaves
rec Test {
    places:  vector.Vector[u8];
    pattern: str;
}

# the test `F == 'p'` that `e` is into `out`, false when it is none
fun equality(m: *Mapper, e: *json.Value, out: *vector.Vector[Test]) bool {
    if (!instructions.kind(e, "AST.BinaryOp")) { ret false; }
    val op: str = string(m, e, "op");
    if (str_equals(op, "&&"))  { ret equality(m, at(e, "left"), out) && equality(m, at(e, "right"), out); }
    if (!str_equals(op, "==")) { ret false; }
    ret test_of(m, at(e, "left"), at(e, "right"), out);
}

# the test of field `left` against value `right` into `out`, false when they are no field and pattern
fun test_of(m: *Mapper, left: *json.Value, right: *json.Value, out: *vector.Vector[Test]) bool {
    if (!instructions.kind(left, "AST.Identifier") || !instructions.kind(right, "Values.Value")) { ret false; }
    var t: Test = Test{places: vector.init[u8](m.alloc), pattern: nil};
    if (!expr.places(m.ins, string(m, left, "value"), ?t.places)) { ret false; }
    val quoted: str   = string(m, right, "value");
    val n:      usize = str_len(quoted);
    if (n != t.places.len + 2) { ret false; }
    val got: res[str, StrError] = str_copy_slice(m.alloc, quoted, 1, n - 2);
    if (sel got.err) {
        fail(m, diag.MEMORY, nil);
        ret false;
    }
    t.pattern = got.ok;
    pushed(m, vector.push[Test](out, t));
    ret true;
}

# the cubes of bits condition `e` refuses, each a conjunction of tests: `F != 'p'`, `!(F == 'p' && ...)` or
# `!(F IN {...})`, into `out`. false when `e` is none of these
fun refused_cubes(m: *Mapper, e: *json.Value, out: *vector.Vector[vector.Vector[Test]]) bool {
    if (instructions.kind(e, "AST.BinaryOp") && str_equals(string(m, e, "op"), "!=")) {
        var cube: vector.Vector[Test] = vector.init[Test](m.alloc);
        if (!test_of(m, at(e, "left"), at(e, "right"), ?cube)) { ret false; }
        pushed(m, vector.push[vector.Vector[Test]](out, cube));
        ret true;
    }
    if (!instructions.kind(e, "AST.UnaryOp") || !str_equals(string(m, e, "op"), "!")) { ret false; }
    val inner: *json.Value = at(e, "expr");
    if (instructions.kind(inner, "AST.BinaryOp") && str_equals(string(m, inner, "op"), "IN")) {
        val left:   *json.Value = at(inner, "left");
        val values: *json.Value = at(at(inner, "right"), "values");
        if (values == nil || values.kind != json.ARRAY) { ret false; }
        var i: usize = 0;
        for (i < values.count) {
            var cube: vector.Vector[Test] = vector.init[Test](m.alloc);
            if (!test_of(m, left, ?values.children[i], ?cube)) { ret false; }
            pushed(m, vector.push[vector.Vector[Test]](out, cube));
            i = i + 1;
        }
        ret true;
    }
    var cube: vector.Vector[Test] = vector.init[Test](m.alloc);
    if (!equality(m, inner, ?cube)) { ret false; }
    pushed(m, vector.push[vector.Vector[Test]](out, cube));
    ret true;
}

# the instruction bits operand `op` sets for the raw number `raw` its slices place
fun placed_bits(op: *Operand, raw: u64) u64 {
    var out: u64   = 0;
    var i:   usize = 0;
    for (i < op.slices.len) {
        val s: *field.Slice = ?op.slices.data[i];
        var b: u64          = (raw >> s.lo::u64) & field.ones(s.len);
        if (s.invert) { b = ~b & field.ones(s.len); }
        out = out | (b << s.at::u64);
        i   = i + 1;
    }
    ret out;
}

# whether bits `bits`, the row's fixed ones beside those an operand sets, meet every test of `cube`
fun meets(cube: *vector.Vector[Test], bits: u64) bool {
    var i: usize = 0;
    for (i < cube.len) {
        val t: *Test = ?cube.data[i];
        var k: usize = 0;
        for (k < t.places.len) {
            val c: u8 = t.pattern[k];
            if (c != 'x' && (c - '0')::u64 != ((bits >> t.places.data[k]::u64) & 1)) { ret false; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret true;
}

# the most raw numbers an immediate is searched over for the values a condition refuses
val MAX_SEARCHED: u64 = 0x1_0000;

# condition `e` of row `row` read as the values it refuses an operand: 1 when it holds once they are excluded from the
# operand that holds its bits, 0 when the row's own bits refuse it, -1 when it is no such test
fun exclude(m: *Mapper, row: *Row, e: *json.Value) i32 {
    var cubes: vector.Vector[vector.Vector[Test]] = vector.init[vector.Vector[Test]](m.alloc);
    if (!refused_cubes(m, e, ?cubes)) { ret -1; }
    var c: usize = 0;
    for (c < cubes.len && !m.failed) {
        val cube: *vector.Vector[Test] = ?cubes.data[c];
        # the open bits of the cube, which one operand must hold
        var open: u64   = 0;
        var i:    usize = 0;
        for (i < cube.len) {
            val t: *Test = ?cube.data[i];
            var k: usize = 0;
            for (k < t.places.len) {
                if (t.pattern[k] != 'x' && ((row.mask >> t.places.data[k]::u64) & 1) == 0) { open = open | (1::u64 << t.places.data[k]::u64); }
                k = k + 1;
            }
            i = i + 1;
        }
        if (open == 0) {
            # the row's own bits decide the cube
            if (meets(cube, row.fixed)) { ret 0; }
        }
        or {
            var held: i64   = -1;
            var j:    usize = 0;
            for (j < row.operands.len) {
                if ((placed_bits(?row.operands.data[j], 0xFFFF_FFFF_FFFF_FFFF) & open) == open) { held = j::i64; }
                j = j + 1;
            }
            if (held < 0) { ret -1; }
            refuse_values(m, row, ?row.operands.data[held::usize], cube);
        }
        c = c + 1;
    }
    ret 1;
}

# the values of operand `op` of row `row` whose bits meet `cube` excluded from it
fun refuse_values(m: *Mapper, row: *Row, op: *Operand, cube: *vector.Vector[Test]) {
    if (op.shape == REGISTER && !op.list) {
        val total: u32 = class_total(m, op);
        var n:     u32 = op.first;
        for (n < range_end(op, total)) {
            if (meets(cube, row.fixed | placed_bits(op, (n - op.first)::u64)) && !holds_u32(?op.excluded, n)) { pushed(m, vector.push[u32](?op.excluded, n)); }
            n = n + 1;
        }
        ret;
    }
    if (op.shape == ENUMERANT && !op.open && !op.mask) {
        var kept: usize = 0;
        var i:    usize = 0;
        for (i < op.members.len) {
            if (!meets(cube, row.fixed | placed_bits(op, op.members.data[i].value::u64))) {
                op.members.data[kept] = op.members.data[i];
                kept                  = kept + 1;
            }
            i = i + 1;
        }
        op.members.len = kept;
        ret;
    }
    if (op.shape == IMMEDIATE && op.kind == UNIT_KIND) {
        val imm:  *operand.Immediate = ?op.immediate;
        val n:    u64                = (imm.bits - imm.scale)::u64;
        val span: u64                = 1::u64 << n;
        if (span > MAX_SEARCHED) {
            fail(m, UNDECIDED, op.rule.id);
            ret;
        }
        var raw: u64 = 0;
        for (raw < span) {
            if (meets(cube, row.fixed | placed_bits(op, raw))) {
                var v: i64 = raw:~i64;
                if (imm.sign == operand.SIGNED && ((raw >> (n - 1)) & 1) != 0) { v = v - span:~i64; }
                pushed(m, vector.push[i64](?op.excluded_values, (v << imm.scale::i64) + imm.bias));
            }
            raw = raw + 1;
        }
        ret;
    }
    fail(m, UNDECIDED, op.rule.id);
}

# the emitted constant of feature `name`, refused when the catalog does not hold it
fun atom(m: *Mapper, name: str) str {
    val row: opt[u32] = feature.row(m.src.features, name);
    if (sel row.none) {
        fail(m, NO_FEATURE, name);
        ret "";
    }
    if (str_equals(name, "FEAT_AdvSIMD")) { ret "gen_extension.SIMD"; }
    if (!str_starts_with(name, "FEAT_")) {
        fail(m, NO_FEATURE, name);
        ret "";
    }
    var out: str               = "gen_extension.";
    val len: usize             = str_len(name);
    val got: res[*u8, A.Error] = A.allocate[u8](m.alloc, len);
    if (sel got.err) {
        fail(m, diag.MEMORY, nil);
        ret "";
    }
    var i: usize = 5;
    for (i < len) {
        var c: u8 = name[i];
        if (c >= 'a' && c <= 'z')                                { c = c - 32; }
        or (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) { c = '_'; }
        got.ok[i - 5] = c;
        i             = i + 1;
    }
    got.ok[len - 5] = 0;
    ret join(m, out, got.ok);
}

# the alternatives of row conditions `f` with the streaming value each holds under
fun requirement(m: *Mapper, f: *Formula, out: *vector.Vector[Alternative]) {
    val mode: streaming.Mode = streaming.mode(m.src.streaming, m.ins.group);
    var i:    usize          = 0;
    for (i < f.alternatives.len && !m.failed) {
        val c: *Conjunction = ?f.alternatives.data[i];
        var a: Alternative  = Alternative{all: vector.init[str](m.alloc), none: vector.init[str](m.alloc)};
        var k: usize        = 0;
        for (k < c.all.len) {
            pushed(m, vector.push[str](?a.all, atom(m, c.all.data[k])));
            k = k + 1;
        }
        k = 0;
        for (k < c.none.len) {
            pushed(m, vector.push[str](?a.none, atom(m, c.none.data[k])));
            k = k + 1;
        }
        val state: str = streaming.state(m.src.streaming, mode, ?c.all);
        if (state != nil) { pushed(m, vector.push[str](?a.all, state)); }
        pushed(m, vector.push[Alternative](out, a));
        i = i + 1;
    }
    if (!m.failed && out.len == 0) { fail(m, NEVER, nil); }
}

# the class of register file class name `name`
fun class_index(m: *Mapper, name: str) u16 {
    var i: usize = 0;
    for (i < m.src.registers.classes.len) {
        if (str_equals(m.src.registers.classes.data[i].name, name)) { ret i::u16; }
        i = i + 1;
    }
    fail(m, NO_CLASS, name);
    ret 0;
}

# the numbers register `op`'s classes hold, the most any of them does, as x's 31 and xzr's 32
fun class_total(m: *Mapper, op: *Operand) u32 {
    var total: u32   = 0;
    var i:     usize = 0;
    for (i < op.classes.len) {
        val c: u32 = m.src.registers.classes.data[op.classes.data[i]].count;
        if (c > total) { total = c; }
        i = i + 1;
    }
    ret total;
}

# operand `r`'s fact, refused when the topic states none
fun fact(m: *Mapper, r: *instructions.Rule) *operands.Fact {
    # a rule whose uses encode it in other fields is stated once per fields, as `T_SD@sz`
    val e: *instructions.Encoded = encoded(m.ins, r.display);
    if (e != nil && e.fields.len > 0) {
        var key: str   = join(m, r.id, "@");
        var i:   usize = 0;
        for (i < e.fields.len) {
            if (i > 0) { key = join(m, key, ":"); }
            key = join(m, key, e.fields.data[i]);
            i   = i + 1;
        }
        val keyed: opt[*operands.Fact] = operands.of(m.src.operands, key);
        if (sel keyed.some) { ret keyed.some; }
    }
    val got: opt[*operands.Fact] = operands.of(m.src.operands, r.id);
    if (sel got.none) {
        fail(m, UNSTATED, r.id);
        ret nil;
    }
    ret got.some;
}

# the free bits of `places` under `mask`, from the high bit
fun free(places: *vector.Vector[u8], mask: u64, out: *vector.Vector[u8], m: *Mapper) {
    var i: usize = 0;
    for (i < places.len) {
        if (((mask >> places.data[i]::u64) & 1) == 0) { pushed(m, vector.push[u8](out, places.data[i])); }
        i = i + 1;
    }
}

# the slices of a value whose bits from `lo` up lie at `free`, its high bit first, inverted when `invert` holds
fun slices(m: *Mapper, free: *vector.Vector[u8], lo: u8, invert: bool, out: *vector.Vector[field.Slice]) {
    val n: usize = free.len;
    var i: usize = 0;
    for (i < n) {
        # a run of positions falling by one from i
        var end: usize = i + 1;
        for (end < n && free.data[end] + 1 == free.data[end - 1]) { end = end + 1; }
        val low:   u8 = free.data[end - 1];
        val vbit:  u8 = (n - end)::u8 + lo;
        val count: u8 = (end - i)::u8;
        pushed(m, vector.push[field.Slice](out, field.Slice{operand: 0, part: field.NUMBER, lo: vbit, len: count, at: low, invert: invert}));
        i = end;
    }
}

# the element a register written as `.<spec>` holds
fun element_of(m: *Mapper, spec: str) operand.Element {
    val e: opt[*operands.Element] = operands.element(m.src.operands, spec);
    if (sel e.none) {
        fail(m, NO_ELEMENT, spec);
        ret operand.Element.none{};
    }
    ret operand.Element.fixed{e.some.bits};
}

# the role of register operand `r` of fact `f`: its line's, or its instruction's role line for it
fun role_for(m: *Mapper, f: *operands.Fact, r: *instructions.Rule) operand.Role {
    var ro: operands.Role = f.role;
    if (ro == operands.UNSTATED)   { ro = operands.role(m.src.operands, m.ins.name, r.id); }
    if (ro == operands.READ)       { ret operand.READ; }
    if (ro == operands.WRITE)      { ret operand.WRITE; }
    if (ro == operands.READ_WRITE) { ret operand.READ_WRITE; }
    if (ro == operands.NONE)       { ret operand.NONE; }
    fail(m, UNROLED, r.id);
    ret operand.NONE;
}

# the exponent of `n`, a power of two, -1 when it is none
fun exponent(n: u64) i32 {
    var e: i32 = 0;
    for (e < 64) {
        if ((1::u64 << e::u64) == n) { ret e; }
        e = e + 1;
    }
    ret -1;
}

# the instruction bits of `name`, a field or a slice `F[hi:lo]` or `F[b]` of one, from the high bit
fun slice_places(m: *Mapper, name: str, out: *vector.Vector[u8]) {
    val len:  usize = str_len(name);
    var open: usize = 0;
    for (open < len && name[open] != '[') { open = open + 1; }
    if (open == len) {
        if (!expr.places(m.ins, name, out)) { fail(m, NO_FIELD, name); }
        ret;
    }
    val base: res[str, StrError] = str_copy_slice(m.alloc, name, 0, open);
    if (sel base.err) {
        fail(m, diag.MEMORY, nil);
        ret;
    }
    var all: vector.Vector[u8] = vector.init[u8](m.alloc);
    if (!expr.places(m.ins, base.ok, ?all)) {
        fail(m, NO_FIELD, name);
        ret;
    }
    var hi: usize = 0;
    var k:  usize = open + 1;
    for (name[k] >= '0' && name[k] <= '9') {
        hi = hi * 10 + (name[k] - '0')::usize;
        k  = k + 1;
    }
    var lo: usize = hi;
    if (name[k] == ':') {
        k  = k + 1;
        lo = 0;
        for (name[k] >= '0' && name[k] <= '9') {
            lo = lo * 10 + (name[k] - '0')::usize;
            k  = k + 1;
        }
    }
    if (hi >= all.len || lo > hi) {
        fail(m, NO_FIELD, name);
        ret;
    }
    var b: usize = hi + 1;
    for (b > lo) {
        b = b - 1;
        pushed(m, vector.push[u8](out, all.data[all.len - 1 - b]));
    }
}

# the bits of `fields` the row leaves free and fixes, as a pattern from the high bit: 0, 1 or x
fun pattern_of(m: *Mapper, row: *Row, fields: *vector.Vector[str]) str {
    var places: vector.Vector[u8] = vector.init[u8](m.alloc);
    var f:      usize             = 0;
    for (f < fields.len) {
        slice_places(m, fields.data[f], ?places);
        f = f + 1;
    }
    val got: res[*u8, A.Error] = A.allocate[u8](m.alloc, places.len + 1);
    if (sel got.err) {
        fail(m, diag.MEMORY, nil);
        ret "";
    }
    var i: usize = 0;
    for (i < places.len) {
        val at: u64 = places.data[i]::u64;
        var c:  u8  = 'x';
        if (((row.mask >> at) & 1) != 0) {
            c = '0';
            if (((row.fixed >> at) & 1) != 0) { c = '1'; }
        }
        got.ok[i] = c;
        i         = i + 1;
    }
    got.ok[places.len] = 0;
    ret got.ok;
}

# whether cube `cube` holds every value of `bits`, false when it holds none, and `open` set when it holds some only
fun cube_holds(bits: str, cube: str, open: *bool) bool {
    if (str_len(bits) != str_len(cube)) { ret false; }
    var some: bool  = false;
    var i:    usize = 0;
    for (bits[i] != 0) {
        val b: u8 = bits[i];
        val c: u8 = cube[i];
        if (c != 'x') {
            if (b == 'x') { some = true; }
            or (b != c)   { ret false; }
        }
        i = i + 1;
    }
    if (some) {
        @open = true;
        ret false;
    }
    ret true;
}

# the expression of fact `f` over row `row`: the cube its by fields' bits decide, its stated value, or its fields'
# bits `fields` alone
fun number_expr(m: *Mapper, row: *Row, f: *operands.Fact, fields: *vector.Vector[str]) *expr.Expr {
    if (f.by.len > 0) {
        val bits:  str        = pattern_of(m, row, ?f.by);
        var found: *expr.Expr = nil;
        var open:  bool       = false;
        var i:     usize      = 0;
        for (i < f.cubes.len) {
            if (cube_holds(bits, f.cubes.data[i].bits, ?open)) {
                if (found != nil) { open = true; }
                found = ?f.cubes.data[i].value;
            }
            i = i + 1;
        }
        if (found == nil || open) {
            fail(m, NO_CUBE, f.rule);
            ret nil;
        }
        ret found;
    }
    if (f.valued) { ret ?f.value; }
    # the fields alone, the by fields left out
    val got: res[expr.Expr, str] = expr.of_fields(m.alloc, fields, f.use != operands.REGISTER && f.sign == operand.SIGNED);
    if (sel got.err) {
        fail(m, got.err, f.rule);
        ret nil;
    }
    val at: res[*expr.Expr, A.Error] = A.allocate[expr.Expr](m.alloc, 1);
    if (sel at.err) {
        fail(m, diag.MEMORY, nil);
        ret nil;
    }
    @at.ok = got.ok;
    ret at.ok;
}

# `e` over row `row`'s free bits
fun affine_of(m: *Mapper, row: *Row, e: *expr.Expr, rule: str) expr.Affine {
    val got: res[expr.Affine, str] = expr.affine(m.alloc, e, m.ins, row.fixed, row.mask);
    if (sel got.err) {
        fail(m, got.err, rule);
        ret expr.Affine{constant: 0, terms: vector.init[expr.Term](m.alloc)};
    }
    ret got.ok;
}

# a free bit's place in a value: the value bit `bit` lies at instruction bit `at`
rec Placed {
    bit: u8;
    at:  u8;
}

fun by_bit(a: *Placed, b: *Placed) i64 {
    if (a.bit > b.bit) { ret -1; }
    if (a.bit < b.bit) { ret 1; }
    ret 0;
}

# the value bits of `aff`'s terms, each weight a distinct power of two times `sign`, highest first, the bits from `lo`
# up numbered from 0. false when a weight is no such power
fun placed(m: *Mapper, aff: *expr.Affine, sign: i64, skip: i64, out: *vector.Vector[Placed]) bool {
    var i: usize = 0;
    for (i < aff.terms.len) {
        val t: expr.Term = aff.terms.data[i];
        if (i::i64 != skip) {
            val w: i64 = t.weight * sign;
            if (w <= 0) { ret false; }
            val e: i32 = exponent(w:~u64);
            if (e < 0) { ret false; }
            pushed(m, vector.push[Placed](out, Placed{bit: e::u8, at: t.at}));
        }
        i = i + 1;
    }
    sort.sort_by[Placed](out.data, out.len, by_bit);
    i = 1;
    for (i < out.len) {
        if (out.data[i].bit == out.data[i - 1].bit) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the slices of value bits `ps`, each value bit less `lo`, inverted when `invert` holds
fun slices_of(m: *Mapper, ps: *vector.Vector[Placed], lo: u8, invert: bool, out: *vector.Vector[field.Slice]) {
    val n: usize = ps.len;
    var i: usize = 0;
    for (i < n) {
        var end: usize = i + 1;
        for (end < n && ps.data[end].bit + 1 == ps.data[end - 1].bit && ps.data[end].at + 1 == ps.data[end - 1].at) { end = end + 1; }
        val last: Placed = ps.data[end - 1];
        pushed(m, vector.push[field.Slice](out, field.Slice{operand: 0, part: field.NUMBER, lo: last.bit - lo, len: (end - i)::u8, at: last.at, invert: invert}));
        i = end;
    }
}

# register operand `out` of fact `f` numbered by `aff`: its first number, range, exclusions and slices
fun fit_register(m: *Mapper, aff: *expr.Affine, f: *operands.Fact, total: u64, out: *Operand) {
    var ps: vector.Vector[Placed] = vector.init[Placed](m.alloc);
    if (!placed(m, aff, 1, -1, ?ps)) {
        fail(m, NOT_POWER, f.rule);
        ret;
    }
    if (aff.constant < 0) {
        fail(m, NEGATIVE, f.rule);
        ret;
    }
    out.first = aff.constant::u32;
    var held: u64   = 0;
    var top:  u32   = 0;
    var i:    usize = 0;
    for (i < ps.len) {
        held = held | (1::u64 << ps.data[i].bit::u64);
        if (ps.data[i].bit::u32 + 1 > top) { top = ps.data[i].bit::u32 + 1; }
        i = i + 1;
    }
    val reach: u64 = 1::u64 << top::u64;
    var count: u64 = reach;
    if (out.first::u64 + count > total) {
        if (out.first::u64 >= total) {
            fail(m, NEGATIVE, f.rule);
            ret;
        }
        count = total - out.first::u64;
    }
    if (out.first > 0 || count < total) { out.count = count::u32; }
    var d: u64 = 0;
    for (d < count) {
        val n: u64 = out.first::u64 + d;
        if ((d & ~held) != 0 || (n % f.step::u64) != 0) { pushed(m, vector.push[u32](?out.excluded, n::u32)); }
        d = d + 1;
    }
    slices_of(m, ?ps, 0, false, ?out.slices);
}

# the encoded bits of value `v` of `imm`, inverted when `invert` holds, over `n` bits
fun encode_value(imm: *operand.Immediate, invert: bool, v: i64, n: usize) u64 {
    var d: u64 = ((v - imm.bias) >> imm.scale::i64):~u64;
    if (invert) { d = ~d; }
    ret d & field.ones(n::u8);
}

# immediate operand `out` numbered by `aff`: its sign, scale, bias and slices, a range held to a block of its bits
fun fit_immediate(m: *Mapper, row: *Row, aff: *expr.Affine, f: *operands.Fact, ranged: bool, out: *Operand) {
    # a value an odd number times a number of its bits, as ld3's `3*SInt(imm4)`, is a multiple
    val q: i64 = odd_factor(aff);
    if (q > 1) {
        fit_multiple(m, row, aff, f, q, out);
        ret;
    }
    # the sign: every weight positive, one negative top bit of a signed number, or every weight negative
    var neg:  usize = 0;
    var low:  i64   = -1;
    var high: i64   = 0;
    var top:  i64   = -1;
    var i:    usize = 0;
    for (i < aff.terms.len) {
        val w: i64 = aff.terms.data[i].weight;
        if (w < 0) {
            neg = neg + 1;
            if (top < 0 || aff.terms.data[top::usize].weight > w) { top = i::i64; }
        }
        i = i + 1;
    }
    var sign:   operand.Sign = operand.UNSIGNED;
    var invert: bool         = false;
    var by:     i64          = 1;
    var skip:   i64          = -1;
    if (neg == aff.terms.len && neg > 0) {
        invert = true;
        by     = -1;
    }
    or (neg == 1 && aff.terms.len > 1) {
        sign = operand.SIGNED;
        skip = top;
    }
    or (neg == 1 && aff.terms.len == 1 && f.sign == operand.SIGNED) {
        sign = operand.SIGNED;
        skip = top;
    }
    or (neg > 0) {
        fail(m, NOT_POWER, f.rule);
        ret;
    }
    var ps: vector.Vector[Placed] = vector.init[Placed](m.alloc);
    if (!placed(m, aff, by, skip, ?ps)) {
        fail(m, NOT_POWER, f.rule);
        ret;
    }
    if (skip >= 0) {
        val w: i64 = -aff.terms.data[skip::usize].weight;
        val e: i32 = exponent(w:~u64);
        if (e < 0) {
            fail(m, NOT_POWER, f.rule);
            ret;
        }
        pushed(m, vector.push[Placed](?ps, Placed{bit: e::u8, at: aff.terms.data[skip::usize].at}));
        sort.sort_by[Placed](ps.data, ps.len, by_bit);
    }
    var scale: u8 = 0;
    if (ps.len > 0) { scale = ps.data[ps.len - 1].bit; }
    i = 0;
    for (i < ps.len) {
        if (ps.data[i].bit != scale + (ps.len - 1 - i)::u8) {
            fail(m, GAPPED, f.rule);
            ret;
        }
        i = i + 1;
    }
    var bias: i64 = aff.constant;
    if (invert) {
        i = 0;
        for (i < aff.terms.len) {
            bias = bias + aff.terms.data[i].weight;
            i    = i + 1;
        }
    }
    out.immediate = operand.Immediate{bits: ps.len::u8 + scale, sign: sign, scale: scale, bias: bias, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS};
    if (ranged && f.ranged) { block(m, row, f, invert, ?ps, out); }
    if (m.failed)           { ret; }
    slices_of(m, ?ps, scale, invert, ?out.slices);
}

# the odd factor every weight of `aff` shares, 1 for none
fun odd_factor(aff: *expr.Affine) i64 {
    var g: i64   = 0;
    var i: usize = 0;
    for (i < aff.terms.len) {
        var w: i64 = aff.terms.data[i].weight;
        if (w < 0) { w = -w; }
        var a: i64 = g;
        var b: i64 = w;
        for (b != 0) {
            val r: i64 = a % b;
            a = b;
            b = r;
        }
        g = a;
        i = i + 1;
    }
    if (g == 0) { ret 1; }
    for ((g & 1) == 0) { g = g >> 1; }
    ret g;
}

# immediate operand `out` numbered by `aff`, whose weights share the odd factor `q`: a value q times a number of its
# bits, which the multiple field kind divides by q, its other values excluded
fun fit_multiple(m: *Mapper, row: *Row, aff: *expr.Affine, f: *operands.Fact, q: i64, out: *Operand) {
    var inner: expr.Affine = expr.Affine{constant: 0, terms: vector.init[expr.Term](m.alloc)};
    var i:     usize       = 0;
    for (i < aff.terms.len) {
        pushed(m, vector.push[expr.Term](?inner.terms, expr.Term{at: aff.terms.data[i].at, weight: aff.terms.data[i].weight / q}));
        i = i + 1;
    }
    fit_immediate(m, row, ?inner, f, false, out);
    if (m.failed) { ret; }
    val n:      operand.Immediate = out.immediate;
    val len:    u8                = n.bits - n.scale;
    val signed: bool              = n.sign == operand.SIGNED;
    var least:  i64               = 0;
    var most:   i64               = (1::i64 << len::i64) - 1;
    if (signed) {
        least = -(1::i64 << (len - 1)::i64);
        most  = (1::i64 << (len - 1)::i64) - 1;
    }
    # the bits of q times the number: the fewest that hold q times each end
    var wide: u8 = 1;
    for (wide < 62 && !(fits(least * q, wide, signed) && fits(most * q, wide, signed))) { wide = wide + 1; }
    val bias: i64 = aff.constant + n.bias;
    if (f.ranged && (f.lo != bias + ((least * q) << n.scale::i64) || f.hi != bias + ((most * q) << n.scale::i64))) {
        fail(m, NO_RANGE, f.rule);
        ret;
    }
    var lo: i64 = 0;
    var hi: i64 = (1::i64 << wide::i64) - 1;
    if (signed) {
        lo = -(1::i64 << (wide - 1)::i64);
        hi = (1::i64 << (wide - 1)::i64) - 1;
    }
    if (hi - lo + 1 - (most - least + 1) > MAX_EXCLUDED) {
        fail(m, NO_RANGE, f.rule);
        ret;
    }
    var d: i64 = lo;
    for (d <= hi) {
        if (d % q != 0 || d / q < least || d / q > most) { pushed(m, vector.push[i64](?out.excluded_values, bias + (d << n.scale::i64))); }
        d = d + 1;
    }
    out.immediate.bits = wide + n.scale;
    out.immediate.bias = bias;
    out.kind           = MULTIPLE_KIND;
    var sign: u64 = 0;
    if (signed) { sign = 1; }
    out.param = q:~u64 | (len::u64 << 8) | (sign << 16);
}

# whether `v` is a number of `bits` bits, two's complement when `signed`
fun fits(v: i64, bits: u8, signed: bool) bool {
    if (signed) { ret v >= -(1::i64 << (bits - 1)::i64) && v < (1::i64 << (bits - 1)::i64); }
    ret v >= 0 && v < (1::i64 << bits::i64);
}

# the most values outside its range an immediate excludes rather than its range being a block of its bits
val MAX_EXCLUDED: i64 = 256;

# the range of immediate `out` held to its bits `ps`: a range that is a block of its encodings fixes the bits every
# value in it shares in the row, taking them out of `ps` and moving the bias by what they hold, and any other range
# excludes the values its bits hold beyond it. refused when it excludes more than MAX_EXCLUDED
fun block(m: *Mapper, row: *Row, f: *operands.Fact, invert: bool, ps: *vector.Vector[Placed], out: *Operand) {
    val imm:   *operand.Immediate = ?out.immediate;
    val n:     usize              = ps.len;
    val sc:    i64                = imm.scale::i64;
    var least: i64                = 0;
    var most:  i64                = (1::i64 << n::i64) - 1;
    if (imm.sign == operand.SIGNED) {
        least = -(1::i64 << (n - 1)::i64);
        most  = (1::i64 << (n - 1)::i64) - 1;
    }
    # a range stated over every use holds in a row only as far as the row's bits reach, as tbz's 0 to 63 is 0 to 31
    # where b5 is fixed
    var dlo: i64 = (f.lo - imm.bias) >> sc;
    var dhi: i64 = (f.hi - imm.bias) >> sc;
    if (((f.lo - imm.bias) & ((1::i64 << sc) - 1)) != 0 || dlo > most || dhi < least) {
        fail(m, NO_RANGE, f.rule);
        ret;
    }
    if (dlo < least)                 { dlo = least; }
    if (dhi > most)                  { dhi = most; }
    if (dlo == least && dhi == most) { ret; }
    # a block of patterns: within one sign, the patterns of a run of values are a run of patterns
    var fmin: u64 = 0;
    var fmax: u64 = 0;
    var k:    i32 = -1;
    if (!(imm.sign == operand.SIGNED && dlo < 0 && dhi >= 0)) {
        val ones: u64 = field.ones(n::u8);
        fmin = dlo:~u64 & ones;
        fmax = dhi:~u64 & ones;
        if (invert) {
            fmin = ~(dhi:~u64) & ones;
            fmax = ~(dlo:~u64) & ones;
        }
        val span: u64 = fmax - fmin + 1;
        k = exponent(span);
        if (k >= 0 && (fmin & (span - 1)) != 0) { k = -1; }
    }
    if (k < 0) {
        # no block: the values outside the range excluded
        if ((most - least) - (dhi - dlo) > MAX_EXCLUDED) {
            fail(m, NO_RANGE, f.rule);
            ret;
        }
        var ex: vector.Vector[i64] = vector.init[i64](m.alloc);
        var d:  i64                = least;
        for (d <= most) {
            if (d < dlo || d > dhi) { pushed(m, vector.push[i64](?ex, imm.bias + (d << sc))); }
            d = d + 1;
        }
        out.excluded_values = ex;
        ret;
    }
    val hb:  u64   = fmin >> k::u64;
    val top: usize = n - k::usize;
    var i:   usize = 0;
    for (i < top) {
        val at: u64 = ps.data[i].at::u64;
        val b:  u64 = (hb >> (top - 1 - i)::u64) & 1;
        row.mask  = row.mask | (1::u64 << at);
        row.fixed = row.fixed | (b << at);
        i         = i + 1;
    }
    # the value the fixed bits add
    var d: u64 = hb;
    if (invert) { d = ~hb & field.ones(top::u8); }
    var add: i64 = d:~i64;
    if (imm.sign == operand.SIGNED && ((d >> (top - 1)::u64) & 1) != 0) { add = add - (1::i64 << top::i64); }
    imm.bias = imm.bias + (add << (k::i64 + sc));
    imm.sign = operand.UNSIGNED;
    imm.bits = k::u8 + imm.scale;
    var kept: usize = 0;
    i = top;
    for (i < n) {
        ps.data[kept] = ps.data[i];
        kept          = kept + 1;
        i             = i + 1;
    }
    ps.len = kept;
}

# whether member bits `bits` over `places` lie in one of the cubes of `w` where their places meet
fun inside(bits: str, places: *vector.Vector[u8], w: *Within) bool {
    var c: usize = 0;
    for (c < w.cubes.len) {
        val cube: str   = w.cubes.data[c];
        var fits: bool  = true;
        var i:    usize = 0;
        for (i < places.len && fits) {
            var k: usize = 0;
            for (k < w.places.len) {
                if (w.places.data[k] == places.data[i] && bits[i] != 'x' && cube[k] != 'x' && bits[i] != cube[k]) { fits = false; }
                k = k + 1;
            }
            i = i + 1;
        }
        if (fits) { ret true; }
        c = c + 1;
    }
    ret false;
}

# the topic member of enumerant `f` whose text is `text`, nil for none
fun topic_member(f: *operands.Fact, text: str) *operands.Member {
    var i: usize = 0;
    for (i < f.members.len) {
        if (str_equals(f.members.data[i].text, text)) { ret ?f.members.data[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether `text` is the numbered member `#`
fun numbered_member(text: str) bool {
    ret text[0] == '#' && text[1] == 0;
}

# the members of enumerant `r` of fact `f` its row keeps, by the bits of its fields `places` the row leaves free. the
# empty member, the bits an optional text encodes when left out, and the numbered member `#` are no names
fun enumerant(m: *Mapper, row: *Row, r: *instructions.Rule, f: *operands.Fact, places: *vector.Vector[u8], within: *vector.Vector[Within], out: *Operand) {
    # every branch of the model is a member of the topic, but for a mask's, whose branches spell lists of members
    var k: usize = 0;
    for (k < r.choices.len && !m.failed && f.how != operands.MASK && r.kind == instructions.CHOICE) {
        if (!number_branch(m, ?r.choices.data[k])) {
            val t: str = member_text(m, r, k);
            if (!m.failed && topic_member(f, t) == nil) { fail(m, MEMBERS, r.id); }
        }
        or (!open_member(f)) { fail(m, MEMBERS, r.id); }
        k = k + 1;
    }
    out.mask = f.how == operands.MASK;
    var i: usize = 0;
    for (i < f.members.len && !m.failed) {
        val mem: *operands.Member = ?f.members.data[i];
        if (numbered_member(mem.text)) {
            out.open = true;
            i        = i + 1;
            cnt;
        }
        var c: usize = 0;
        for (c < mem.cubes.len && !m.failed) {
            val bits: str = mem.cubes.data[c];
            if (str_len(bits) != places.len) {
                fail(m, MEMBER_BITS, mem.text);
                ret;
            }
            var kept:  bool = true;
            var value: u32  = 0;
            k = 0;
            for (k < places.len) {
                val at: u64 = places.data[k]::u64;
                val b:  u8  = bits[k];
                if (((row.mask >> at) & 1) != 0) {
                    if (b != 'x' && (b - '0')::u64 != ((row.fixed >> at) & 1)) { kept = false; }
                }
                or {
                    if (b == 'x') {
                        fail(m, OPEN_MEMBER, mem.text);
                        ret;
                    }
                    value = (value << 1) | (b - '0')::u32;
                }
                k = k + 1;
            }
            var w: usize = 0;
            for (w < within.len && kept) {
                if (!inside(bits, places, ?within.data[w])) { kept = false; }
                w = w + 1;
            }
            if (kept && str_len(mem.text) > 0) { pushed(m, vector.push[Member](?out.members, Member{name: lower(m, mem.text), value: value})); }
            c = c + 1;
        }
        i = i + 1;
    }
    if (!m.failed && out.members.len == 0 && !out.open) { fail(m, NO_MEMBER, r.id); }
}

# whether branch `c` of a choice is a number, the numbered spelling of an enumerant, through the rules it names
fun number_branch(m: *Mapper, c: *vector.Vector[instructions.Symbol]) bool {
    var i: usize = 0;
    for (i < c.len) {
        val s: instructions.Symbol = c.data[i];
        if (sel s.rule) {
            val r: *instructions.Rule = ?m.src.model.rules.data[s.rule];
            if (is_number(r))                                                { ret true; }
            if (r.kind == instructions.RULE && number_branch(m, ?r.symbols)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# whether enumerant `f` has the numbered member `#`
fun open_member(f: *operands.Fact) bool {
    var i: usize = 0;
    for (i < f.members.len) {
        if (numbered_member(f.members.data[i].text)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the width of the value a row's bitmask or float immediate holds: the element of its first register that has one, or
# the width of its first register's class
# the element width of the row's first register operand that states one, 0 for none
fun element_width(row: *Row) u8 {
    var i: usize = 0;
    for (i < row.operands.len) {
        val op: *Operand = ?row.operands.data[i];
        if (op.shape == REGISTER) {
            if (sel op.element.fixed) { ret op.element.fixed::u8; }
        }
        i = i + 1;
    }
    ret 0;
}

fun value_width(m: *Mapper, row: *Row) u8 {
    var i: usize = 0;
    for (i < row.operands.len) {
        val op: *Operand = ?row.operands.data[i];
        if (op.shape == REGISTER) {
            if (sel op.element.fixed) { ret op.element.fixed::u8; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < row.operands.len) {
        val op: *Operand = ?row.operands.data[i];
        if (op.shape == REGISTER && op.classes.len > 0) {
            val c: *aarch64.Class = ?m.src.registers.classes.data[op.classes.data[0]];
            ret c.width.fixed::u8;
        }
        i = i + 1;
    }
    ret 0;
}

# operand `r` of row `row`, its fields at `places`, written after member text `before` and with specifier `spec`, built
# into `out`
fun build(m: *Mapper, row: *Row, r: *instructions.Rule, fields: *vector.Vector[str], places: *vector.Vector[u8], before: str, spec: str, within: *vector.Vector[Within], out: *Operand) {
    val f: *operands.Fact = fact(m, r);
    if (f == nil) { ret; }
    @out = Operand{
        rule:            r,
        fact:            f,
        shape:           REGISTER,
        classes:         vector.init[u16](m.alloc),
        first:           0,
        count:           0,
        excluded:        vector.init[u32](m.alloc),
        element:         operand.Element.none{},
        role:            operand.READ,
        immediate:       operand.Immediate{bits: 0, sign: operand.UNSIGNED, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS},
        members:         vector.init[Member](m.alloc),
        slices:          vector.init[field.Slice](m.alloc),
        format:          nil,
        kind:            UNIT_KIND,
        param:           0,
        open:            false,
        mask:            false,
        page:            false,
        prefix:          nil,
        excluded_values: vector.init[i64](m.alloc),
        own:             0,
        places:          vector.init[u8](m.alloc),
        row_mask:        row.mask,
        fields:          1,
        list:            false,
        length:          0,
        stride:          0,
        leading:         vector.init[u32](m.alloc),
        joined:          vector.init[u32](m.alloc),
    };
    var p: usize = 0;
    for (p < places.len) {
        pushed(m, vector.push[u8](?out.places, places.data[p]));
        p = p + 1;
    }
    if (f.use == operands.REGISTER) {
        var i: usize = 0;
        for (i < f.classes.len && !m.failed) {
            val name: str = f.classes.data[i];
            if (name[0] == '*') {
                if (before == nil) { fail(m, CHOSEN, r.id); }
                or                 { pushed(m, vector.push[u16](?out.classes, class_index(m, join(m, lower(m, before), ?name[1])))); }
            }
            or { pushed(m, vector.push[u16](?out.classes, class_index(m, name))); }
            i = i + 1;
        }
        if (m.failed) { ret; }
        out.role = role_for(m, f, r);
        val e: *expr.Expr = number_expr(m, row, f, fields);
        if (m.failed) { ret; }
        var aff: expr.Affine    = affine_of(m, row, e, r.id);
        val c:   *aarch64.Class = ?m.src.registers.classes.data[out.classes.data[0]];
        if (m.failed) { ret; }
        fit_register(m, ?aff, f, class_total(m, out)::u64, out);
        if (spec != nil) { out.element = element_of(m, spec); }
        if (c.tile)      { out.format = NUMBER; }
        ret;
    }
    if (f.use == operands.IMMEDIATE || f.use == operands.RELATIVE) {
        out.shape = IMMEDIATE;
        if (f.use == operands.RELATIVE) { out.shape = RELATIVE; }
        out.role = operand.READ;
        out.page = f.page;
        if (f.kind != operands.NUMBER) {
            # a field kind of its own encodes the value from its fields' free bits
            var bits: vector.Vector[u8] = vector.init[u8](m.alloc);
            free(places, row.mask, ?bits, m);
            # the value is as wide as the register or element it is the value of
            val width: u8 = value_width(m, row);
            if (width == 0) {
                fail(m, NO_WIDTH, r.id);
                ret;
            }
            out.immediate.bits = width;
            if (f.kind == operands.BITMASK) {
                out.kind = BITMASK_KIND;
                var at: u8    = 0xFF;
                var i:  usize = 0;
                for (i < bits.len) {
                    if (bits.data[i] < at) { at = bits.data[i]; }
                    out.own = out.own | (1::u64 << bits.data[i]::u64);
                    i       = i + 1;
                }
                # a64's code decodes to its register's width, sve's to 64 bits replicating the element
                var domain: u8 = width;
                if (element_width(row) != 0) { domain = 64; }
                out.param = width::u64 | (domain::u64 << 8) | (at::u64 << 16);
            }
            or {
                out.kind             = FLOAT8_KIND;
                out.immediate.format = operand.FLOAT;
                out.param            = width::u64;
                slices(m, ?bits, 0, false, ?out.slices);
            }
            ret;
        }
        val e: *expr.Expr = number_expr(m, row, f, fields);
        if (m.failed) { ret; }
        var aff: expr.Affine = affine_of(m, row, e, r.id);
        if (m.failed) { ret; }
        fit_immediate(m, row, ?aff, f, true, out);
        ret;
    }
    out.shape = ENUMERANT;
    out.role  = operand.READ;
    enumerant(m, row, r, f, places, within, out);
    var bits: vector.Vector[u8] = vector.init[u8](m.alloc);
    free(places, row.mask, ?bits, m);
    slices(m, ?bits, 0, false, ?out.slices);
}

# `template` followed by the text of numbered register rule `r`, its literals in lower case and `hole` for its one
# number, as `<ZAd>` is `ZA` and a number
fun numbered(m: *Mapper, template: str, r: *instructions.Rule, hole: str) str {
    var out:     str   = template;
    var numbers: u32   = 0;
    var i:       usize = 0;
    for (i < r.symbols.len) {
        val s: instructions.Symbol = r.symbols.data[i];
        if (sel s.literal) { out = join(m, out, lower(m, s.literal)); }
        if (sel s.rule) {
            if (!str_equals(m.src.model.rules.data[s.rule].id, "UInteger")) { fail(m, NUMBERED, r.id); }
            out     = join(m, out, hole);
            numbers = numbers + 1;
        }
        i = i + 1;
    }
    if (numbers != 1) { fail(m, NUMBERED, r.id); }
    ret out;
}

# whether rule `r` is the model's number token
fun is_number(r: *instructions.Rule) bool {
    ret str_equals(r.id, "UInteger") || str_equals(r.id, "SInteger");
}

# `template` followed by the text of immediate rule `r`: its literals in lower case, an optional text as an optional
# group and `hole` for its one number, as `C<m>` is `c` and a number. `numbers` counts the numbers written
fun around(m: *Mapper, template: str, r: *instructions.Rule, hole: str, numbers: *u32) str {
    if (is_number(r)) {
        @numbers = @numbers + 1;
        ret join(m, template, hole);
    }
    var out: str = template;
    if (r.kind == instructions.RULE) {
        var i: usize = 0;
        for (i < r.symbols.len && !m.failed) {
            val s: instructions.Symbol = r.symbols.data[i];
            if (sel s.literal) { out = join(m, out, lower(m, s.literal)); }
            if (sel s.rule)    { out = around(m, out, ?m.src.model.rules.data[s.rule], hole, numbers); }
            i = i + 1;
        }
        ret out;
    }
    if (r.kind == instructions.CHOICE && r.choices.len == 2) {
        val a: *vector.Vector[instructions.Symbol] = ?r.choices.data[0];
        val b: *vector.Vector[instructions.Symbol] = ?r.choices.data[1];
        var t: str                                 = nil;
        if (a.len > 0 && b.len == 0) { t = spelled(m, a); }
        or (a.len == 0 && b.len > 0) { t = spelled(m, b); }
        if (t != nil)                { ret join(m, join(m, join(m, out, "<["), lower(m, t)), "]>"); }
    }
    fail(m, SPELLED, r.id);
    ret out;
}

# the text written after piece `k` up to the next operand, its members spelled
fun after(m: *Mapper, ps: *vector.Vector[Piece], k: usize, members: *vector.Vector[str]) str {
    var out: str   = "";
    var i:   usize = k + 1;
    for (i < ps.len) {
        val p: Piece = ps.data[i];
        if (sel p.text)   { out = join(m, out, p.text); }
        or (sel p.member) { out = join(m, out, members.data[p.member]); }
        or                { ret out; }
        i = i + 1;
    }
    ret out;
}

# the specifier written after a register at piece `k`, as `s` of `z0.s` or `16b` of `v0.16b`, nil when none is
fun specifier(m: *Mapper, ps: *vector.Vector[Piece], k: usize, members: *vector.Vector[str]) str {
    val t: str = after(m, ps, k, members);
    if (str_len(t) < 2 || t[0] != '.') { ret nil; }
    var end: usize = 1;
    for ((t[end] >= 'a' && t[end] <= 'z') || (t[end] >= 'A' && t[end] <= 'Z') || (t[end] >= '0' && t[end] <= '9')) { end = end + 1; }
    if (end == 1) { ret nil; }
    val got: res[str, StrError] = str_copy_slice(m.alloc, t, 1, end - 1);
    if (sel got.err) {
        fail(m, diag.MEMORY, nil);
        ret nil;
    }
    ret lower(m, got.ok);
}

# the index of the row's choice that rule `rule` is, -1 for none
fun choice_of(choices: *vector.Vector[Choice], rule: u32) i64 {
    var i: usize = 0;
    for (i < choices.len) {
        if (choices.data[i].hole && choices.data[i].rule == rule) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

# whether operand `op` takes its class from the member written before it
fun chosen(op: *Operand) bool {
    if (op.shape != REGISTER) { ret false; }
    var i: usize = 0;
    for (i < op.fact.classes.len) {
        if (op.fact.classes.data[i][0] == '*') { ret true; }
        i = i + 1;
    }
    ret false;
}

# the hole text of operand `op` numbered `n`, after `template`
fun hole_text(m: *Mapper, template: str, op: *Operand, n: u32) str {
    var hole: str = "<";
    hole = join(m, hole, digits(m, n));
    if (op.format != nil) { hole = join(m, join(m, hole, ":"), op.format); }
    hole = join(m, hole, ">");
    if (op.format != nil && str_equals(op.format, NUMBER)) { ret numbered(m, template, op.rule, hole); }
    if (op.shape == REGISTER && only_number(m, op.rule)) {
        if (!chosen(op) || ends_with_class(m, template, op)) { ret join(m, unprefixed(m, template, op), hole); }
    }
    if (op.shape == IMMEDIATE || op.shape == RELATIVE) {
        var numbers: u32 = 0;
        val out:     str = around(m, template, op.rule, hole, ?numbers);
        if (numbers != 1) { fail(m, SPELLED, op.rule.id); }
        ret out;
    }
    ret join(m, template, hole);
}

# whether rule `r` is the model's number alone, as `<m>` of `V<m>`
fun only_number(m: *Mapper, r: *instructions.Rule) bool {
    if (r.kind != instructions.RULE || r.symbols.len != 1) { ret false; }
    val s: instructions.Symbol = r.symbols.data[0];
    if (!sel s.rule) { ret false; }
    ret is_number(?m.src.model.rules.data[s.rule]);
}

# the letters `text` ends with, nil for none
fun trailing_word(m: *Mapper, text: str) str {
    val n: usize = str_len(text);
    var k: usize = n;
    for (k > 0 && ((text[k - 1] >= 'a' && text[k - 1] <= 'z') || (text[k - 1] >= 'A' && text[k - 1] <= 'Z'))) { k = k - 1; }
    if (k == n) { ret nil; }
    val got: res[str, StrError] = str_copy_slice(m.alloc, text, k, n - k);
    if (sel got.err) {
        fail(m, diag.MEMORY, nil);
        ret nil;
    }
    ret got.ok;
}

# whether `template` ends with the name of register operand `op`'s class
fun ends_with_class(m: *Mapper, template: str, op: *Operand) bool {
    val name: str   = m.src.registers.classes.data[op.classes.data[0]].name;
    val n:    usize = str_len(name);
    val t:    usize = str_len(template);
    if (n > t) { ret false; }
    var k: usize = 0;
    for (k < n) {
        if (template[t - n + k] != name[k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

# `template` without the class's name written before a register spelled by its number alone, as the `v` of `V<m>`,
# which the register's own name holds
fun unprefixed(m: *Mapper, template: str, op: *Operand) str {
    val c:    *aarch64.Class = ?m.src.registers.classes.data[op.classes.data[0]];
    val name: str            = c.name;
    val n:    usize          = str_len(name);
    val t:    usize          = str_len(template);
    if (n > t) {
        fail(m, NUMBERED, op.rule.id);
        ret template;
    }
    var k: usize = 0;
    for (k < n) {
        if (template[t - n + k] != name[k]) {
            fail(m, NUMBERED, op.rule.id);
            ret template;
        }
        k = k + 1;
    }
    val got: res[str, StrError] = str_copy_slice(m.alloc, template, 0, t - n);
    if (sel got.err) {
        fail(m, diag.MEMORY, nil);
        ret template;
    }
    ret got.ok;
}

# the spelling of pieces `ps` over the row's operands, `rules` naming each operand's rule and `numbering` the number
# each operand's hole takes, -1 for an operand the spelling leaves out
fun spell(m: *Mapper, ps: *vector.Vector[Piece], row: *Row, rules: *vector.Vector[u32], members: *vector.Vector[str], numbering: *vector.Vector[i64]) str {
    var out: str   = "";
    var i:   usize = 0;
    for (i < ps.len && !m.failed) {
        val p: Piece = ps.data[i];
        if (sel p.text)     { out = join(m, out, lower(m, p.text)); }
        if (sel p.optional) { out = join(m, join(m, join(m, out, "<["), lower(m, p.optional)), "]>"); }
        if (sel p.member) {
            # a member that names the class of the register after it is spelled by the register's name
            var named: bool = false;
            if (i + 1 < ps.len) {
                val q: Piece = ps.data[i + 1];
                if (sel q.hole) {
                    var j: usize = 0;
                    for (j < rules.len) {
                        if (rules.data[j] == q.hole && chosen(?row.operands.data[j])) { named = true; }
                        j = j + 1;
                    }
                }
            }
            if (!named) { out = join(m, out, members.data[p.member]); }
        }
        if (sel p.hole) {
            val j: i64 = operand_of(rules, p.hole);
            if (j >= 0) { out = hole_text(m, out, ?row.operands.data[j::usize], numbering.data[j::usize]::u32); }
            or          { out = derived_text(m, out, p.hole, row, rules, numbering); }
        }
        i = i + 1;
    }
    ret out;
}

# the hole text of rule `rule`, a hole row `row` derives from another operand's, after `template`
fun derived_text(m: *Mapper, template: str, rule: u32, row: *Row, rules: *vector.Vector[u32], numbering: *vector.Vector[i64]) str {
    var i: usize = 0;
    for (i < row.derived.len) {
        val d: *Derived = ?row.derived.data[i];
        if (d.rule == rule) {
            val j: i64 = operand_of(rules, d.base);
            if (j < 0 || numbering.data[j::usize] < 0) {
                fail(m, DERIVED_OUT, m.src.model.rules.data[rule].id);
                ret template;
            }
            if (d.format == nil) { ret hole_text(m, template, ?row.operands.data[j::usize], numbering.data[j::usize]::u32); }
            ret join(m, template, join(m, join(m, join(m, "<", digits(m, numbering.data[j::usize]::u32)), join(m, ":", d.format)), ">"));
        }
        i = i + 1;
    }
    ret template;
}

# the pieces of `nodes` under `picks`, each optional group whose bit of `left` is set left out, the alternatives
# taken noted in `visited`
fun flatten(m: *Mapper, nodes: *vector.Vector[Node], picks: *vector.Vector[usize], left: u64, visited: *vector.Vector[u32], choices: *vector.Vector[Choice], out: *vector.Vector[Piece]) {
    var i: usize = 0;
    for (i < nodes.len && !m.failed) {
        val n: Node = nodes.data[i];
        if (sel n.text)     { pushed(m, vector.push[Piece](out, Piece.text{n.text})); }
        if (sel n.optional) { pushed(m, vector.push[Piece](out, Piece.optional{n.optional})); }
        if (sel n.hole) {
            val k: i64 = choice_of(choices, n.hole);
            if (k >= 0) { pushed(m, vector.push[Piece](out, Piece.member{k::u32})); }
            or          { pushed(m, vector.push[Piece](out, Piece.hole{n.hole})); }
        }
        if (sel n.alternatives) {
            val a: *Alternatives = ?m.alts.data[n.alternatives];
            pushed(m, vector.push[u32](visited, n.alternatives));
            if (optional_group(a)) {
                if (((left >> n.alternatives::u64) & 1) == 0) { flatten(m, ?a.branches.data[full(a)], picks, left, visited, choices, out); }
            }
            or { flatten(m, ?a.branches.data[picks.data[n.alternatives]], picks, left, visited, choices, out); }
        }
        i = i + 1;
    }
}

# the rows choices among the holes of `nodes` under `picks`, each once, and the choices of branches taken
fun gather(m: *Mapper, nodes: *vector.Vector[Node], picks: *vector.Vector[usize], out: *vector.Vector[Choice]) {
    var i: usize = 0;
    for (i < nodes.len && !m.failed) {
        val n: Node = nodes.data[i];
        if (sel n.hole) {
            val r: *instructions.Rule = ?m.src.model.rules.data[n.hole];
            val f: *operands.Fact     = fact(m, r);
            if (f != nil && f.use == operands.CHOICE && f.how == operands.ROWS && choice_of(out, n.hole) < 0) {
                var c: Choice = Choice{rule: n.hole, fact: f, places: vector.init[u8](m.alloc), hole: true};
                positions(m, ?encoded(m.ins, r.display).fields, ?c.places);
                if (r.kind != instructions.CHOICE || r.choices.len != f.members.len) { fail(m, MEMBERS, r.id); }
                pushed(m, vector.push[Choice](out, c));
            }
        }
        if (sel n.alternatives) {
            val a: *Alternatives = ?m.alts.data[n.alternatives];
            if (optional_group(a)) { gather(m, ?a.branches.data[full(a)], picks, out); }
            or {
                var c: Choice = Choice{rule: n.alternatives, fact: a.fact, places: vector.init[u8](m.alloc), hole: false};
                positions(m, ?a.fact.fields, ?c.places);
                if (a.branches.len != a.fact.members.len) { fail(m, MEMBERS, m.src.model.rules.data[a.rule].id); }
                pushed(m, vector.push[Choice](out, c));
                gather(m, ?a.branches.data[picks.data[n.alternatives]], picks, out);
            }
        }
        i = i + 1;
    }
}

# what fixing a member's bits came to
# ---
# FIXED:     its bits fixed
# DISJOINT:  no cube of it agrees with the bits the row fixes, so the row is no encoding of it
# MALFORMED: its bits differ in length from the choice's fields
def Fixing: u8;

val FIXED:     Fixing = 0;
val DISJOINT:  Fixing = 1;
val MALFORMED: Fixing = 2;

# the bits member `mem` of a choice over `places` fixes, folded into `fixed` and `mask`: the bits its cubes that agree
# with the row share, and the cubes of a member of several such noted in `within`
fun fix(m: *Mapper, mem: *operands.Member, places: *vector.Vector[u8], fixed: *u64, mask: *u64, within: *vector.Vector[Within]) Fixing {
    var kept: vector.Vector[str] = vector.init[str](m.alloc);
    var c:    usize              = 0;
    for (c < mem.cubes.len) {
        val cube: str = mem.cubes.data[c];
        if (str_len(cube) != places.len) { ret MALFORMED; }
        var agrees: bool  = true;
        var k:      usize = 0;
        for (k < places.len) {
            val at: u64 = places.data[k]::u64;
            if (cube[k] != 'x' && ((@mask >> at) & 1) != 0 && (cube[k] - '0')::u64 != ((@fixed >> at) & 1)) { agrees = false; }
            k = k + 1;
        }
        if (agrees) { pushed(m, vector.push[str](?kept, cube)); }
        c = c + 1;
    }
    if (kept.len == 0) { ret DISJOINT; }
    var k: usize = 0;
    for (k < places.len) {
        val at:   u64  = places.data[k]::u64;
        val b:    u8   = kept.data[0][k];
        var same: bool = b != 'x';
        c = 1;
        for (c < kept.len) {
            if (kept.data[c][k] != b) { same = false; }
            c = c + 1;
        }
        if (same) {
            @mask = @mask | (1::u64 << at);
            if (b == '1') { @fixed = @fixed | (1::u64 << at); }
        }
        k = k + 1;
    }
    if (kept.len > 1) {
        val cubes: res[*vector.Vector[str], A.Error] = A.allocate[vector.Vector[str]](m.alloc, 1);
        if (sel cubes.err) {
            fail(m, diag.MEMORY, nil);
            ret FIXED;
        }
        @cubes.ok = kept;
        pushed(m, vector.push[Within](within, Within{places: places, cubes: cubes.ok}));
    }
    ret FIXED;
}

# whether some cube of `w` agrees with the bits `mask` fixes to `fixed`
fun agrees(w: *Within, fixed: u64, mask: u64) bool {
    var c: usize = 0;
    for (c < w.cubes.len) {
        val cube: str   = w.cubes.data[c];
        var ok:   bool  = true;
        var k:    usize = 0;
        for (k < w.places.len) {
            val at: u64 = w.places.data[k]::u64;
            if (cube[k] != 'x' && ((mask >> at) & 1) != 0 && (cube[k] - '0')::u64 != ((fixed >> at) & 1)) { ok = false; }
            k = k + 1;
        }
        if (ok) { ret true; }
        c = c + 1;
    }
    ret false;
}

# the row of the instruction made of members `chosen` of its choices, with its aliases
fun row_of(m: *Mapper, root: *vector.Vector[Node], picks: *vector.Vector[usize], choices: *vector.Vector[Choice], chosen: *vector.Vector[usize], out: *vector.Vector[Row]) {
    val ins:   *instructions.Instruction = m.ins;
    var fixed: u64                       = 0;
    var mask:  u64                       = 0;
    var i:     usize                     = 0;
    for (i < ins.bits.len) {
        val b: *instructions.Bits = ?ins.bits.data[i];
        var k: u8                 = 0;
        for (k < b.width) {
            val c:  u8  = b.pattern[(b.width - 1 - k)::usize];
            val at: u64 = (b.start + k)::u64;
            if (c != 'x') {
                mask = mask | (1::u64 << at);
                if (c == '1') { fixed = fixed | (1::u64 << at); }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    # the fields the decode refuses every other value of
    val pinned: opt[*vector.Vector[operands.Fixed]] = operands.fixed(m.src.operands, ins.name);
    if (sel pinned.some) {
        var p: usize = 0;
        for (p < pinned.some.len) {
            val fx:     *operands.Fixed   = ?pinned.some.data[p];
            var places: vector.Vector[u8] = vector.init[u8](m.alloc);
            if (!expr.places(ins, fx.field, ?places) || places.len != str_len(fx.bits)) {
                fail(m, NO_FIELD, fx.field);
                ret;
            }
            var k: usize = 0;
            for (k < places.len) {
                val at: u64 = places.data[k]::u64;
                if (((mask >> at) & 1) != 0) {
                    fail(m, MEMBER_BITS, fx.field);
                    ret;
                }
                mask = mask | (1::u64 << at);
                if (fx.bits[k] == '1') { fixed = fixed | (1::u64 << at); }
                k = k + 1;
            }
            p = p + 1;
        }
    }
    var key:     str                        = ins.name;
    var members: vector.Vector[str]         = vector.init[str](m.alloc);
    var conds:   vector.Vector[*json.Value] = vector.init[*json.Value](m.alloc);
    var within:  vector.Vector[Within]      = vector.init[Within](m.alloc);
    i = 0;
    for (i < choices.len && !m.failed) {
        val ch: *Choice            = ?choices.data[i];
        var r:  *instructions.Rule = ?m.src.model.rules.data[ch.rule];
        var a:  *Alternatives      = nil;
        if (!ch.hole) {
            a = ?m.alts.data[ch.rule];
            r = ?m.src.model.rules.data[a.rule];
        }
        val mem: *operands.Member = choice_member(m, r, ch.fact, chosen.data[i], a);
        if (mem == nil) { ret; }
        val fixing: Fixing = fix(m, mem, ?ch.places, ?fixed, ?mask, ?within);
        if (fixing == MALFORMED) {
            fail(m, MEMBER_BITS, mem.text);
            ret;
        }
        # members whose bits contradict the encoding's or each other's make no row
        if (fixing == DISJOINT) { ret; }
        val text: str = lower(m, mem.text);
        pushed(m, vector.push[str](?members, text));
        key = join(m, join(m, key, "."), text);
        if (ch.hole) {
            val c: *json.Value = member_condition(m, r, chosen.data[i]);
            if (c != nil) { pushed(m, vector.push[*json.Value](?conds, c)); }
        }
        i = i + 1;
    }
    # a member of several cubes holds in the row only where one of them agrees with every bit the row fixes
    i = 0;
    for (i < within.len) {
        if (!agrees(?within.data[i], fixed, mask)) { ret; }
        i = i + 1;
    }
    var row:     Row                  = Row{key: key, mnemonic: nil, template: "", instruction: ins, fixed: fixed, mask: mask, operands: vector.init[Operand](m.alloc), requires: vector.init[Alternative](m.alloc), aliases: vector.init[Alias](m.alloc), derived: vector.init[Derived](m.alloc)};
    var visited: vector.Vector[u32]   = vector.init[u32](m.alloc);
    var ps:      vector.Vector[Piece] = vector.init[Piece](m.alloc);
    flatten(m, root, picks, 0, ?visited, choices, ?ps);
    # the operands, in written order, each once
    var rules: vector.Vector[u32] = vector.init[u32](m.alloc);
    i = 0;
    for (i < ps.len && !m.failed) {
        val p: Piece = ps.data[i];
        if (sel p.hole) {
            var seen: bool  = false;
            var k:    usize = 0;
            for (k < rules.len) {
                if (rules.data[k] == p.hole) { seen = true; }
                k = k + 1;
            }
            if (!seen) {
                val r:      *instructions.Rule    = ?m.src.model.rules.data[p.hole];
                val e:      *instructions.Encoded = encoded(ins, r.display);
                var places: vector.Vector[u8]     = vector.init[u8](m.alloc);
                positions(m, ?e.fields, ?places);
                var before: str = nil;
                if (i > 0) {
                    val q: Piece = ps.data[i - 1];
                    if (sel q.member) { before = members.data[q.member]; }
                    # a class the encoding fixes is text before the number, as `D<d>` of a scalar of one size
                    if (sel q.text) { before = trailing_word(m, q.text); }
                }
                var op: Operand;
                build(m, ?row, r, ?e.fields, ?places, before, specifier(m, ?ps, i, ?members), ?within, ?op);
                if (m.failed) { ret; }
                pushed(m, vector.push[u32](?rules, p.hole));
                pushed(m, vector.push[Operand](?row.operands, op));
            }
        }
        i = i + 1;
    }
    if (m.failed) { ret; }
    joined(m, ?row, ?ps, ?rules, ?members);
    if (m.failed) { ret; }
    # the bits each operand holds
    var held: u64 = row.mask;
    i = 0;
    for (i < row.operands.len) {
        val op: *Operand = ?row.operands.data[i];
        if ((held & op.own) != 0) { fail(m, HELD_TWICE, op.rule.id); }
        held = held | op.own;
        var k: usize = 0;
        for (k < op.slices.len) {
            val s:    *field.Slice = ?op.slices.data[k];
            val bits: u64          = field.ones(s.len) << s.at::u64;
            if ((held & bits) != 0) { fail(m, HELD_TWICE, op.rule.id); }
            held      = held | bits;
            s.operand = i::u8;
            k         = k + 1;
        }
        i = i + 1;
    }
    if (m.failed)            { ret; }
    if (held != 0xFFFF_FFFF) { fail(m, UNHELD, nil); }
    var kinds: u32 = 0;
    i = 0;
    for (i < row.operands.len) {
        if (row.operands.data[i].kind != UNIT_KIND) { kinds = kinds + 1; }
        i = i + 1;
    }
    if (kinds > 1) { fail(m, TWO_KINDS, nil); }
    var numbering: vector.Vector[i64] = vector.init[i64](m.alloc);
    i = 0;
    for (i < rules.len) {
        pushed(m, vector.push[i64](?numbering, i::i64));
        i = i + 1;
    }
    row.template = spell(m, ?ps, ?row, ?rules, ?members, ?numbering);
    # the mnemonic is the template's text before its first space
    var end: usize = 0;
    for (row.template[end] != 0 && row.template[end] != ' ') { end = end + 1; }
    val mn: res[str, StrError] = str_copy_slice(m.alloc, row.template, 0, end);
    if (sel mn.ok) { row.mnemonic = mn.ok; }
    or             { fail(m, diag.MEMORY, nil); }
    # the requirement: every condition of the instruction and of the members it is made of
    var f: Formula = truth(m, true);
    i = 0;
    for (i < ins.conditions.len && !m.failed) {
        var c: Formula = condition(m, ins.conditions.data[i], row.fixed, row.mask, ?row, true);
        f = both(m, ?f, ?c);
        i = i + 1;
    }
    i = 0;
    for (i < conds.len && !m.failed) {
        var c: Formula = condition(m, conds.data[i], row.fixed, row.mask, ?row, true);
        f = both(m, ?f, ?c);
        i = i + 1;
    }
    requirement(m, ?f, ?row.requires);
    aliases(m, root, picks, choices, ?visited, ?rules, ?members, ?row);
    if (!m.failed) { pushed(m, vector.push[Row](out, row)); }
}

# the operand of `rules` that rule `rule` is, -1 for none
fun operand_of(rules: *vector.Vector[u32], rule: u32) i64 {
    var j: usize = 0;
    for (j < rules.len) {
        if (rules.data[j] == rule) { ret j::i64; }
        j = j + 1;
    }
    ret -1;
}

# the rule of hole piece `p`, NO_RULE for a piece that is no hole
fun hole_of(p: Piece) u32 {
    if (sel p.hole) { ret p.hole; }
    ret NO_RULE;
}

# the text of piece `p` in lower case, nil for a piece that is no text
fun piece_text(m: *Mapper, p: Piece, members: *vector.Vector[str]) str {
    if (sel p.text)   { ret lower(m, p.text); }
    if (sel p.member) { ret members.data[p.member]; }
    ret nil;
}

# the text between pieces `a` and `b`, nil when a piece between them is no text
fun between(m: *Mapper, ps: *vector.Vector[Piece], a: usize, b: usize, members: *vector.Vector[str]) str {
    var out: str   = "";
    var i:   usize = a + 1;
    for (i < b) {
        val t: str = piece_text(m, ps.data[i], members);
        if (t == nil) { ret nil; }
        out = join(m, out, t);
        i   = i + 1;
    }
    ret out;
}

# the text after piece `k` up to the next piece that is no text
fun following(m: *Mapper, ps: *vector.Vector[Piece], k: usize, members: *vector.Vector[str]) str {
    var out: str   = "";
    var i:   usize = k + 1;
    for (i < ps.len) {
        val t: str = piece_text(m, ps.data[i], members);
        if (t == nil) { ret out; }
        out = join(m, out, t);
        i   = i + 1;
    }
    ret out;
}

# whether `t` holds the character `c`
fun holds_char(t: str, c: u8) bool {
    if (t == nil) { ret false; }
    var i: usize = 0;
    for (t[i] != 0) {
        if (t[i] == c) { ret true; }
        i = i + 1;
    }
    ret false;
}

# `t`'s first `n` characters
fun prefix_of(m: *Mapper, t: str, n: usize) str {
    val got: res[str, StrError] = str_copy_slice(m.alloc, t, 0, n);
    if (sel got.err) {
        fail(m, diag.MEMORY, nil);
        ret "";
    }
    ret got.ok;
}

# whether the slices of `a` and `b` lie at the same bits and hold the same bits of their numbers
fun same_slices(a: *Operand, b: *Operand) bool {
    if (a.slices.len != b.slices.len || a.kind != b.kind || a.own != b.own) { ret false; }
    var i: usize = 0;
    for (i < a.slices.len) {
        val x: *field.Slice = ?a.slices.data[i];
        val y: *field.Slice = ?b.slices.data[i];
        if (x.lo != y.lo || x.len != y.len || x.at != y.at || x.invert != y.invert) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `a` and `b` list the same classes in the same order
fun same_classes(a: *Operand, b: *Operand) bool {
    if (a.classes.len != b.classes.len) { ret false; }
    var i: usize = 0;
    for (i < a.classes.len) {
        if (a.classes.data[i] != b.classes.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `a` and `b` state the same element
fun same_element(a: operand.Element, b: operand.Element) bool {
    if (sel a.none) {
        if (sel b.none) { ret true; }
        ret false;
    }
    if (sel a.fixed) {
        if (sel b.fixed) { ret a.fixed == b.fixed; }
    }
    ret false;
}

# the end of register `op`'s range in a class of `total` registers
fun range_end(op: *Operand, total: u32) u32 {
    if (op.count == 0) { ret total; }
    ret op.first + op.count;
}

# whether register `op` admits number `n` of a class of `total` registers
fun admits(op: *Operand, n: u32, total: u32) bool {
    if (n < op.first || n >= range_end(op, total)) { ret false; }
    var i: usize = 0;
    for (i < op.excluded.len) {
        if (op.excluded.data[i] == n) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the brace group `{ ... }` of holes `holes` joined into one list operand where its registers are the one register and
# those a stride after it, written `<a>.e, <b>.e` or as the range `<a>.e-<z>.e`: the first operand becomes the list,
# the rules of the rest noted in `gone`
fun list_group(m: *Mapper, row: *Row, ps: *vector.Vector[Piece], rules: *vector.Vector[u32], members: *vector.Vector[str], holes: *vector.Vector[usize], gone: *vector.Vector[u32]) {
    val j0: i64 = operand_of(rules, hole_of(ps.data[holes.data[0]]));
    if (j0 < 0) { ret; }
    val op0: *Operand = ?row.operands.data[j0::usize];
    # a list written again, as a destructive operand, was joined where it was first written
    if (op0.list || op0.shape != REGISTER) { ret; }
    val b: str = between(m, ps, holes.data[0], holes.data[1], members);
    if (b == nil) { ret; }
    var end: usize = str_len(b);
    for (end > 0 && b[end - 1] == ' ') { end = end - 1; }
    if (end == 0) { ret; }
    val sep: u8 = b[end - 1];
    if (sep != ',' && sep != '-') { ret; }
    var e: usize = end - 1;
    for (e > 0 && b[e - 1] == ' ') { e = e - 1; }
    val elem:  str  = prefix_of(m, b, e);
    val range: bool = sep == '-';
    if (range && holes.len != 2) { ret; }
    var k: usize = 1;
    for (k + 1 < holes.len) {
        val t: str = between(m, ps, holes.data[k], holes.data[k + 1], members);
        if (t == nil || !str_equals(t, b)) { ret; }
        k = k + 1;
    }
    if (!str_starts_with(following(m, ps, holes.data[holes.len - 1], members), elem)) { ret; }
    val total:  u32 = class_total(m, op0);
    var stride: u32 = 0;
    var lo:     u32 = op0.first;
    var hi:     u32 = range_end(op0, total);
    k = 1;
    for (k < holes.len) {
        val j: i64 = operand_of(rules, hole_of(ps.data[holes.data[k]]));
        if (j < 0) { ret; }
        val op: *Operand = ?row.operands.data[j::usize];
        if (op.shape != REGISTER || op.list || !same_classes(op0, op) || !same_slices(op0, op) || !same_element(op0.element, op.element)) { ret; }
        if (op.first <= op0.first)                                                                                                        { ret; }
        val d: u32 = op.first - op0.first;
        if (k == 1)                         { stride = d; }
        if (!range && d != stride * k::u32) { ret; }
        if (op.first < lo)                  { lo = op.first; }
        if (range_end(op, total) > hi)      { hi = range_end(op, total); }
        k = k + 1;
    }
    var length: u32 = holes.len::u32;
    if (range) {
        length = stride + 1;
        stride = 1;
    }
    if (length > 0xFF || stride > 0xFF) { ret; }
    if (lo != op0.first) {
        fail(m, LIST_FIRST, op0.rule.id);
        ret;
    }
    if (hi > total) { hi = total; }
    # the first member takes the numbers the first operand admits, every member any of the members' range
    var n: u32 = lo;
    for (n < hi) {
        if (!admits(op0, n, total)) { pushed(m, vector.push[u32](?op0.leading, n)); }
        n = n + 1;
    }
    op0.excluded.len = 0;
    op0.first        = lo;
    op0.count        = 0;
    if (lo > 0 || hi < total) { op0.count = hi - lo; }
    op0.list   = true;
    op0.length = length::u8;
    op0.stride = stride::u8;
    op0.format = nil;
    if (e > 0) { op0.format = elem; }
    k = 0;
    for (k < holes.len) {
        val rule: u32 = hole_of(ps.data[holes.data[k]]);
        pushed(m, vector.push[u32](?op0.joined, rule));
        if (k > 0) { pushed(m, vector.push[u32](gone, rule)); }
        k = k + 1;
    }
}

# the lists, pairs and views of row `row` joined: each brace group of a register and the ones a stride after it one
# list operand, and an operand whose number another's gives, as casp's `<X(s+1)>`, sqincb's `<Wdn>` beside `<Xdn>` or
# sme's `<offs2>` beside `<offs1>`, a hole deriving its value from the other's
fun joined(m: *Mapper, row: *Row, ps: *vector.Vector[Piece], rules: *vector.Vector[u32], members: *vector.Vector[str]) {
    var gone:  vector.Vector[u32]   = vector.init[u32](m.alloc);
    var holes: vector.Vector[usize] = vector.init[usize](m.alloc);
    var open:  bool                 = false;
    var i:     usize                = 0;
    for (i < ps.len && !m.failed) {
        val p: Piece = ps.data[i];
        if (sel p.text) {
            if (holds_char(p.text, '{')) {
                open      = true;
                holes.len = 0;
            }
            if (holds_char(p.text, '}') && open) {
                open = false;
                if (holes.len >= 2) { list_group(m, row, ps, rules, members, ?holes, ?gone); }
            }
        }
        if (sel p.hole) {
            if (open) { pushed(m, vector.push[usize](?holes, i)); }
        }
        i = i + 1;
    }
    if (m.failed) { ret; }
    # a later operand of the same bits whose number or value another's gives
    var a: usize = 0;
    for (a < row.operands.len && !m.failed) {
        val x: *Operand = ?row.operands.data[a];
        if (!x.list && !holds_u32(?gone, rules.data[a])) {
            var b: usize = a + 1;
            for (b < row.operands.len) {
                val y: *Operand = ?row.operands.data[b];
                if (!y.list && !holds_u32(?gone, rules.data[b]) && x.shape == y.shape && same_slices(x, y)) {
                    val format: str = derivation(m, x, y);
                    if (format != nil) {
                        if (str_equals(format, "")) {
                            pushed(m, vector.push[Derived](?row.derived, Derived{rule: rules.data[b], base: rules.data[a], format: nil}));
                        }
                        or {
                            pushed(m, vector.push[Derived](?row.derived, Derived{rule: rules.data[b], base: rules.data[a], format: format}));
                        }
                        x.role = x.role | y.role;
                        pushed(m, vector.push[u32](?gone, rules.data[b]));
                    }
                }
                b = b + 1;
            }
        }
        a = a + 1;
    }
    # the operands joined into others leave the row
    var w: usize = 0;
    i = 0;
    for (i < row.operands.len) {
        if (!holds_u32(?gone, rules.data[i])) {
            row.operands.data[w] = row.operands.data[i];
            rules.data[w]        = rules.data[i];
            w                    = w + 1;
        }
        i = i + 1;
    }
    row.operands.len = w;
    rules.len        = w;
    collapse(m, ps, row, rules, members);
}

# whether `v` holds `x`
fun holds_u32(v: *vector.Vector[u32], x: u32) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == x) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the derivation of `y`'s value from `x`'s, two operands of the same bits: "" for the same value, `+k` for a
# register k numbers past within the registers `x` comes to cover or an immediate k more, `=c,...` for a register of the
# same number in `y`'s classes, nil for none
fun derivation(m: *Mapper, x: *Operand, y: *Operand) str {
    if (x.shape == REGISTER) {
        if (!same_element(x.element, y.element) && !(sel y.element.none)) { ret nil; }
        if (same_classes(x, y)) {
            if (y.first == x.first)                                      { ret ""; }
            if (y.first < x.first || y.first - x.first > MAX_FIELDS - 1) { ret nil; }
            val k: u32 = y.first - x.first;
            if (k + 1 > x.fields::u32) { x.fields = (k + 1)::u8; }
            ret join(m, "+", digits(m, k));
        }
        if (y.first != x.first) { ret nil; }
        var out: str   = "=";
        var i:   usize = 0;
        for (i < y.classes.len) {
            if (i > 0) { out = join(m, out, ","); }
            out = join(m, out, m.src.registers.classes.data[y.classes.data[i]].name);
            i   = i + 1;
        }
        ret out;
    }
    if (x.shape == IMMEDIATE) {
        val p: *operand.Immediate = ?x.immediate;
        val q: *operand.Immediate = ?y.immediate;
        if (p.bits != q.bits || p.sign != q.sign || p.scale != q.scale || x.kind != UNIT_KIND) { ret nil; }
        if (q.bias == p.bias)                                                                  { ret ""; }
        if (q.bias < p.bias)                                                                   { ret nil; }
        ret join(m, "+", digits(m, (q.bias - p.bias)::u32));
    }
    ret nil;
}

# the pieces `ps` of row `row` with each list written by its first member's hole alone: the members after it and the
# element after the last of them left out, its element the hole's format
fun collapse(m: *Mapper, ps: *vector.Vector[Piece], row: *Row, rules: *vector.Vector[u32], members: *vector.Vector[str]) {
    var out: vector.Vector[Piece] = vector.init[Piece](m.alloc);
    var i:   usize                = 0;
    for (i < ps.len && !m.failed) {
        val p: Piece = ps.data[i];
        pushed(m, vector.push[Piece](?out, p));
        i = i + 1;
        if (sel p.hole) {
            val j: i64 = operand_of(rules, p.hole);
            if (j >= 0) {
                val op: *Operand = ?row.operands.data[j::usize];
                if (op.list) {
                    # the members after the first, each a hole of its rule in order
                    var seen: usize = 1;
                    for (i < ps.len && seen < op.joined.len) {
                        val q: Piece = ps.data[i];
                        if (sel q.hole) {
                            if (q.hole != op.joined.data[seen]) { fail(m, LIST_SPELLED, op.rule.id); }
                            seen = seen + 1;
                        }
                        i = i + 1;
                    }
                    if (seen < op.joined.len) { fail(m, LIST_SPELLED, op.rule.id); }
                    # the last member's element
                    var left: usize = 0;
                    if (op.format != nil) { left = str_len(op.format); }
                    for (left > 0 && i < ps.len && !m.failed) {
                        val t: str = piece_text(m, ps.data[i], members);
                        if (t == nil) { fail(m, LIST_SPELLED, op.rule.id); }
                        or {
                            val n: usize = str_len(t);
                            if (n <= left) {
                                left = left - n;
                                i    = i + 1;
                            }
                            or {
                                val q: Piece = ps.data[i];
                                if (sel q.text) {
                                    val rest: res[str, StrError] = str_copy_slice(m.alloc, q.text, left, n - left);
                                    if (sel rest.ok) { pushed(m, vector.push[Piece](?out, Piece.text{rest.ok})); }
                                    or               { fail(m, diag.MEMORY, nil); }
                                }
                                or { fail(m, LIST_SPELLED, op.rule.id); }
                                left = 0;
                                i    = i + 1;
                            }
                        }
                    }
                }
            }
        }
    }
    @ps = out;
}

# the value operand `op` takes where its optional group is left out
fun omitted(m: *Mapper, op: *Operand) Source {
    if (op.shape == IMMEDIATE && op.fact.defaulted) { ret Source.immediate{op.fact.default}; }
    if (op.shape == ENUMERANT && op.fact.omitted != nil) {
        val name: str   = lower(m, op.fact.omitted);
        var i:    usize = 0;
        for (i < op.members.len) {
            if (str_equals(op.members.data[i].name, name)) { ret Source.enumerant{op.members.data[i].value}; }
            i = i + 1;
        }
    }
    if (op.shape == ENUMERANT) {
        # the empty member: the bits the left out text encodes
        val none: *operands.Member = topic_member(op.fact, "");
        if (none != nil) {
            var v: u32 = 0;
            if (empty_value(m, op, none, ?v)) { ret Source.enumerant{v}; }
        }
    }
    if (op.shape == REGISTER && op.fact.omitted != nil) {
        var i: usize = 0;
        for (i < m.src.registers.rows.len) {
            if (str_equals(m.src.registers.rows.data[i].name, op.fact.omitted)) { ret Source.register{i::u32}; }
            i = i + 1;
        }
    }
    fail(m, NO_DEFAULT, op.rule.id);
    ret Source.operand{0};
}

# the value of the empty member `none` of enumerant `op` in its row: its bits at the bits the row leaves free
fun empty_value(m: *Mapper, op: *Operand, none: *operands.Member, out: *u32) bool {
    if (none.cubes.len != 1) { ret false; }
    val bits: str = none.cubes.data[0];
    # the operand's free bits are its slices', from the high bit, and the member's bits are over its fields
    var v:     u32   = 0;
    var count: usize = 0;
    var k:     usize = 0;
    for (k < op.places.len) {
        val at: u64 = op.places.data[k]::u64;
        if (((op.row_mask >> at) & 1) == 0) {
            if (bits[k] == 'x') { ret false; }
            v     = (v << 1) | (bits[k] - '0')::u32;
            count = count + 1;
        }
        k = k + 1;
    }
    @out = v;
    ret true;
}

# whether optional group `k` lies within a group `left` leaves out
fun beneath(m: *Mapper, k: u32, left: u64) bool {
    var p: i32 = m.alts.data[k].parent;
    for (p >= 0) {
        if (((left >> p::u64) & 1) != 0) { ret true; }
        p = m.alts.data[p::usize].parent;
    }
    ret false;
}

# every spelling of row `row` with a set of its optional groups left out
fun aliases(m: *Mapper, root: *vector.Vector[Node], picks: *vector.Vector[usize], choices: *vector.Vector[Choice], visited: *vector.Vector[u32], rules: *vector.Vector[u32], members: *vector.Vector[str], row: *Row) {
    var groups: vector.Vector[u32] = vector.init[u32](m.alloc);
    var i:      usize              = 0;
    for (i < visited.len) {
        if (optional_group(?m.alts.data[visited.data[i]])) { pushed(m, vector.push[u32](?groups, visited.data[i])); }
        i = i + 1;
    }
    if (groups.len::u32 > MAX_GROUPS) {
        fail(m, TOO_MANY, nil);
        ret;
    }
    var set: u64 = 1;
    for (set < (1::u64 << groups.len::u64) && !m.failed) {
        var left:  u64   = 0;
        var count: u8    = 0;
        var k:     usize = 0;
        for (k < groups.len) {
            if (((set >> k::u64) & 1) != 0) {
                left  = left | (1::u64 << groups.data[k]::u64);
                count = count + 1;
            }
            k = k + 1;
        }
        # a group within one left out is left out with it, so only the outermost is named
        var canonical: bool = true;
        k = 0;
        for (k < groups.len) {
            if (((set >> k::u64) & 1) != 0 && beneath(m, groups.data[k], left)) { canonical = false; }
            k = k + 1;
        }
        if (canonical) {
            var seen: vector.Vector[u32]   = vector.init[u32](m.alloc);
            var ps:   vector.Vector[Piece] = vector.init[Piece](m.alloc);
            flatten(m, root, picks, left, ?seen, choices, ?ps);
            collapse(m, ?ps, row, rules, members);
            var numbering: vector.Vector[i64] = vector.init[i64](m.alloc);
            k = 0;
            for (k < rules.len) {
                pushed(m, vector.push[i64](?numbering, -1));
                k = k + 1;
            }
            var n: i64 = 0;
            k = 0;
            for (k < ps.len) {
                val p: Piece = ps.data[k];
                if (sel p.hole) {
                    var j: usize = 0;
                    for (j < rules.len) {
                        if (rules.data[j] == p.hole && numbering.data[j] < 0) {
                            numbering.data[j] = n;
                            n                 = n + 1;
                        }
                        j = j + 1;
                    }
                }
                k = k + 1;
            }
            var alias: Alias = Alias{template: spell(m, ?ps, row, rules, members, ?numbering), count: n::u8, sources: vector.init[Source](m.alloc), preference: count};
            k = 0;
            for (k < rules.len && !m.failed) {
                if (numbering.data[k] >= 0) { pushed(m, vector.push[Source](?alias.sources, Source.operand{numbering.data[k]::u8})); }
                or                          { pushed(m, vector.push[Source](?alias.sources, omitted(m, ?row.operands.data[k]))); }
                k = k + 1;
            }
            pushed(m, vector.push[Alias](?row.aliases, alias));
        }
        set = set + 1;
    }
}

fun digits(m: *Mapper, n: u32) str {
    var buf: [12]u8;
    var len: usize = 0;
    var v:   u32   = n;
    if (v == 0) {
        buf[0] = '0';
        len    = 1;
    }
    for (v > 0) {
        buf[len] = '0' + (v % 10)::u8;
        len      = len + 1;
        v        = v / 10;
    }
    val got: res[*u8, A.Error] = A.allocate[u8](m.alloc, len + 1);
    if (sel got.err) {
        fail(m, diag.MEMORY, nil);
        ret "";
    }
    var i: usize = 0;
    for (i < len) {
        got.ok[i] = buf[len - 1 - i];
        i         = i + 1;
    }
    got.ok[len] = 0;
    ret got.ok;
}

# the next combination of `counts` after `at`, the last counting fastest, false when `at` is the last
fun next(at: *vector.Vector[usize], counts: *vector.Vector[usize]) bool {
    var k: usize = at.len;
    for (k > 0) {
        k          = k - 1;
        at.data[k] = at.data[k] + 1;
        if (at.data[k] < counts.data[k]) { ret true; }
        at.data[k] = 0;
    }
    ret false;
}

# the rows of instruction `ins`, one per choice of operand branches and combination of its rows choices' members
fun rows_of(m: *Mapper, ins: *instructions.Instruction, out: *vector.Vector[Row]) {
    m.ins  = ins;
    m.alts = vector.init[Alternatives](m.alloc);
    var root: vector.Vector[Node] = vector.init[Node](m.alloc);
    tree(m, ?ins.symbols, -1, ?root);
    settle(m);
    if (m.failed) { ret; }
    # every pick of a branch of each choice of operand branches
    var picks:  vector.Vector[usize] = vector.init[usize](m.alloc);
    var counts: vector.Vector[usize] = vector.init[usize](m.alloc);
    var i:      usize                = 0;
    for (i < m.alts.len) {
        pushed(m, vector.push[usize](?picks, 0));
        if (optional_group(?m.alts.data[i])) { pushed(m, vector.push[usize](?counts, 1)); }
        or                                   { pushed(m, vector.push[usize](?counts, m.alts.data[i].branches.len)); }
        i = i + 1;
    }
    for (!m.failed) {
        # a pick of a choice its other picks leave untaken is the first's again
        var seen: vector.Vector[u32]    = vector.init[u32](m.alloc);
        var none: vector.Vector[Choice] = vector.init[Choice](m.alloc);
        var ps:   vector.Vector[Piece]  = vector.init[Piece](m.alloc);
        flatten(m, ?root, ?picks, 0, ?seen, ?none, ?ps);
        var again: bool = false;
        i = 0;
        for (i < picks.len) {
            if (picks.data[i] != 0) {
                var taken: bool  = false;
                var k:     usize = 0;
                for (k < seen.len) {
                    if (seen.data[k] == i::u32) { taken = true; }
                    k = k + 1;
                }
                if (!taken) { again = true; }
            }
            i = i + 1;
        }
        if (!again) {
            var choices: vector.Vector[Choice] = vector.init[Choice](m.alloc);
            gather(m, ?root, ?picks, ?choices);
            var chosen: vector.Vector[usize] = vector.init[usize](m.alloc);
            var many:   vector.Vector[usize] = vector.init[usize](m.alloc);
            i = 0;
            for (i < choices.len) {
                if (choices.data[i].hole) {
                    pushed(m, vector.push[usize](?chosen, 0));
                    pushed(m, vector.push[usize](?many, m.src.model.rules.data[choices.data[i].rule].choices.len));
                }
                or {
                    pushed(m, vector.push[usize](?chosen, picks.data[choices.data[i].rule]));
                    pushed(m, vector.push[usize](?many, 1));
                }
                i = i + 1;
            }
            # a choice of branches stays at its pick while the members count
            var at: vector.Vector[usize] = vector.init[usize](m.alloc);
            i = 0;
            for (i < chosen.len) {
                pushed(m, vector.push[usize](?at, 0));
                i = i + 1;
            }
            for (!m.failed) {
                i = 0;
                for (i < chosen.len) {
                    if (choices.data[i].hole) { chosen.data[i] = at.data[i]; }
                    i = i + 1;
                }
                row_of(m, ?root, ?picks, ?choices, ?chosen, out);
                if (!next(?at, ?many)) { brk; }
            }
        }
        if (!next(?picks, ?counts)) { brk; }
    }
}

# whether the operands topic withholds instruction `ins`, which then makes no row
fun withheld(src: *Sources, ins: *instructions.Instruction) bool {
    val w: opt[*overlay.Fact] = operands.withheld(src.operands, ins.name);
    ret sel w.some;
}

# the rows of every instruction of the model, in its order
pub fun map_rows(a: *A.Allocator, src: *Sources, out: *vector.Vector[Row]) err[diag.Refusal] {
    var m: Mapper = Mapper{alloc: a, src: src, ins: nil, alts: vector.init[Alternatives](a), failed: false, failure: diag.refusal(nil, 0, nil, nil)};
    var i: usize  = 0;
    for (i < src.model.instructions.len && !m.failed) {
        val ins: *instructions.Instruction = ?src.model.instructions.data[i];
        if (!withheld(src, ins)) { rows_of(?m, ins, out); }
        i = i + 1;
    }
    if (m.failed) { ret err[diag.Refusal].err{m.failure}; }
    ret err[diag.Refusal].ok{};
}

# the instructions of the model the mapping refuses, each with its refusal, the rest mapped into `out`
pub fun survey(a: *A.Allocator, src: *Sources, out: *vector.Vector[Row], refused: *vector.Vector[diag.Refusal]) {
    var i: usize = 0;
    for (i < src.model.instructions.len) {
        if (withheld(src, ?src.model.instructions.data[i])) {
            i = i + 1;
            cnt;
        }
        var m:    Mapper             = Mapper{alloc: a, src: src, ins: nil, alts: vector.init[Alternatives](a), failed: false, failure: diag.refusal(nil, 0, nil, nil)};
        var rows: vector.Vector[Row] = vector.init[Row](a);
        rows_of(?m, ?src.model.instructions.data[i], ?rows);
        if (m.failed) { vector.push[diag.Refusal](refused, m.failure); }
        or {
            var k: usize = 0;
            for (k < rows.len) {
                vector.push[Row](out, rows.data[k]);
                k = k + 1;
            }
        }
        i = i + 1;
    }
}
