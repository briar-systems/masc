# the respellings topic: a mnemonic a row is also read under
#
# the Arm ARM gives a load or store of a base and an offset two encodings, the scaled unsigned offset of ldr and the
# unscaled signed one of ldur, and an offset only one of them holds has one encoding of the access, so the plain
# mnemonic names whichever holds it (ARM DDI 0487, "LDR (immediate)" and "LDUR"). the model spells each row under its
# own mnemonic alone, so the topic gen/data/aarch64/respellings.txt states the further mnemonic each row of a mnemonic
# is read under:
#
#   respell <mnemonic> | <mnemonic>
#
# the row keeps its own spelling for printing and the respelling is only read. the parser tries a mnemonic's
# candidates in row order and the unscaled rows precede the scaled ones, so the respelling is tried after every row of
# the mnemonic it takes (syntax.Candidate), and an offset the scaled form holds is the scaled row's. a line no row's
# mnemonic reads is refused

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use gen.isa.aarch64.mapping;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "respellings";

pub val BAD_LINE: str = "respellings line is not `respell <mnemonic> | <mnemonic>`";
pub val TWICE:    str = "mnemonic respelled twice";
pub val UNUSED:   str = "respellings line names a mnemonic no row has";

# one line
# ---
# from: the mnemonic of the rows
# to:   the mnemonic they are also read under
# fact: the line, for its refusals
# used: whether a row has the mnemonic
pub rec Line {
    from: str;
    to:   str;
    fact: *topic.Fact;
    used: bool;
}

pub rec Respellings {
    lines: vector.Vector[Line];
}

fun fits(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# the respellings topic of the data tree `tree`
pub fun read(a: *A.Allocator, tree: *source.Tree) res[Respellings, diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, TOPIC);
    if (sel got.err) { ret res[Respellings, diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, nil, topic.unstated);
    if (sel checked.err) { ret res[Respellings, diag.Refusal].err{checked.err}; }
    var out: Respellings = Respellings{lines: vector.init[Line](a)};
    var i:   usize       = 0;
    for (i < t.facts.len) {
        var l:    topic.Line        = topic.Line{fact: nil, key: vector.init[str](a), ws: vector.init[str](a)};
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err) { ret res[Respellings, diag.Refusal].err{read.err}; }
        val w: opt[str] = topic.only(?l);
        if (!topic.is(?l, "respell", 2)) { ret res[Respellings, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
        if (sel w.none)                  { ret res[Respellings, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
        var k: usize = 0;
        for (k < out.lines.len) {
            if (str_equals(out.lines.data[k].from, l.key.data[1])) { ret res[Respellings, diag.Refusal].err{topic.refuse(l.fact, TWICE, l.key.data[1])}; }
            k = k + 1;
        }
        if (!fits(vector.push[Line](?out.lines, Line{from: l.key.data[1], to: w.some, fact: l.fact, used: false}))) { ret res[Respellings, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        i = i + 1;
    }
    ret res[Respellings, diag.Refusal].ok{out};
}

# the spelling of row `r` under the mnemonic of line `l`, only read, nil when the storage is refused
fun respelled(a: *A.Allocator, r: *mapping.Row, l: *Line) opt[mapping.Alias] {
    val joined: res[str, StrError] = str_join(a, l.to, ?r.template[str_len(l.from)]);
    if (sel joined.err) { ret opt[mapping.Alias].none{}; }
    var out: mapping.Alias = mapping.Alias{template: joined.ok, count: r.operands.len::u8, sources: vector.init[mapping.Source](a), exclusions: vector.init[mapping.Exclusion](a), preference: 0, requires: vector.init[mapping.Alternative](a), derive: nil, operands: vector.init[mapping.Operand](a), late: l.to};
    var i:   usize         = 0;
    for (i < r.operands.len) {
        if (!fits(vector.push[mapping.Source](?out.sources, mapping.Source.operand{i::u8}))) { ret opt[mapping.Alias].none{}; }
        i = i + 1;
    }
    ret opt[mapping.Alias].some{out};
}

# every row of a respelled mnemonic gains its respelling, refused at a line no row's mnemonic reads
pub fun apply(a: *A.Allocator, s: *Respellings, all: *vector.Vector[mapping.Row]) err[diag.Refusal] {
    var i: usize = 0;
    for (i < all.len) {
        val r: *mapping.Row = ?all.data[i];
        var k: usize        = 0;
        for (k < s.lines.len) {
            val l: *Line = ?s.lines.data[k];
            if (str_equals(l.from, r.mnemonic)) {
                l.used = true;
                val alias: opt[mapping.Alias] = respelled(a, r, l);
                if (sel alias.none)                                            { ret err[diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
                if (!fits(vector.push[mapping.Alias](?r.aliases, alias.some))) { ret err[diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret unused(s);
}

# the refusal of the first line no row read, ok when every line was
fun unused(s: *Respellings) err[diag.Refusal] {
    var i: usize = 0;
    for (i < s.lines.len) {
        if (!s.lines.data[i].used) { ret err[diag.Refusal].err{topic.refuse(s.lines.data[i].fact, UNUSED, s.lines.data[i].from)}; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}
