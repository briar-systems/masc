# the relax topic: the longer form of a branch whose target is out of range, and the code fill
#
# neither the instruction model nor the A64 ISA XML states a relaxation, and llvm-mc 23.1.1 and GNU as relax no aarch64
# branch, so the topic gen/data/aarch64/relax.txt states masc's own, each read against the branch's range in the Arm
# ARM. a branch relaxes to its inverse past the far branch to the target, the inverse's operands those of the row it
# replaces, its condition flipped where the line says:
#
#   relax <row> | to=<row> [flip=<mask> fixed=<member>,...]
#   far | row=<row>
#   fill | row=<row>
#
# rows are named by key. `flip` flips the row's condition by `mask` and `fixed` names its members whose flip is no
# inverse, a row holding one having no longer form. `far` names the branch to the target and `fill` the no-op the code
# fill repeats

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "relax";

pub val BAD_LINE: str = "relax line is not `relax <row> | to=<row> [flip=<mask> fixed=<member>,...]`, `far | row=<row>` or `fill | row=<row>`";
pub val TWICE:    str = "relax states a row, the far branch or the fill twice";
pub val NO_FAR:   str = "relax states no far branch or no fill";

# one relaxation
# ---
# from:  the key of the row relaxed
# to:    the key of its inverse
# flip:  the bits its condition flips, 0 for a row with no condition
# fixed: the condition's members whose flip is no inverse
# fact:  the line, for its refusals
pub rec Relax {
    from:  str;
    to:    str;
    flip:  u32;
    fixed: vector.Vector[str];
    fact:  *topic.Fact;
}

# the topic
# ---
# relaxes: each relaxation, in file order
# far:     the key of the far branch
# fill:    the key of the no-op
# fact:    the far branch's line, for its refusals
pub rec Relaxes {
    relaxes: vector.Vector[Relax];
    far:     str;
    fill:    str;
    fact:    *topic.Fact;
}

fun fits(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# the members `text` names, split on commas
fun members(a: *A.Allocator, text: str, out: *vector.Vector[str]) bool {
    var start: usize = 0;
    var i:     usize = 0;
    for (true) {
        val c: u8 = text[i];
        if (c == 0 || c == ',') {
            val got: res[str, StrError] = str_copy_slice(a, text, start, i - start);
            if (sel got.err)                          { ret false; }
            if (!fits(vector.push[str](out, got.ok))) { ret false; }
            if (c == 0)                               { ret true; }
            start = i + 1;
        }
        i = i + 1;
    }
    ret true;
}

# the relax topic of the data tree `tree`
pub fun read(a: *A.Allocator, tree: *source.Tree) res[Relaxes, diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, TOPIC);
    if (sel got.err) { ret res[Relaxes, diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, nil, topic.unstated);
    if (sel checked.err) { ret res[Relaxes, diag.Refusal].err{checked.err}; }
    var out: Relaxes = Relaxes{relaxes: vector.init[Relax](a), far: nil, fill: nil, fact: nil};
    var i:   usize   = 0;
    for (i < t.facts.len) {
        var l:    topic.Line        = topic.Line{fact: nil, key: vector.init[str](a), ws: vector.init[str](a)};
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err) { ret res[Relaxes, diag.Refusal].err{read.err}; }
        if (topic.is(?l, "far", 1) || topic.is(?l, "fill", 1)) {
            val row: opt[str] = topic.value(?l.ws, "row");
            var key: str      = nil;
            if (sel row.some)                { key = row.some; }
            if (key == nil || l.ws.len != 1) { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
            if (topic.is(?l, "far", 1)) {
                if (out.far != nil) { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, TWICE, key)}; }
                out.far  = key;
                out.fact = l.fact;
            }
            or {
                if (out.fill != nil) { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, TWICE, key)}; }
                out.fill = key;
            }
        }
        or (topic.is(?l, "relax", 2)) {
            val to: opt[str] = topic.value(?l.ws, "to");
            if (sel to.none) { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
            var rx: Relax    = Relax{from: l.key.data[1], to: to.some, flip: 0, fixed: vector.init[str](a), fact: l.fact};
            val f:  opt[str] = topic.value(?l.ws, "flip");
            val fx: opt[str] = topic.value(?l.ws, "fixed");
            var n:  usize    = 1;
            if (sel f.some) {
                val mask: res[i64, diag.Refusal] = topic.number(l.fact, f.some);
                if (sel mask.err)                         { ret res[Relaxes, diag.Refusal].err{mask.err}; }
                if (mask.ok <= 0 || mask.ok > 0xffffffff) { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, f.some)}; }
                rx.flip = mask.ok::u32;
                n       = n + 1;
            }
            if (sel fx.some) {
                if (sel f.none)                      { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, fx.some)}; }
                if (!members(a, fx.some, ?rx.fixed)) { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
                n = n + 1;
            }
            if (l.ws.len != n) { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
            var k: usize = 0;
            for (k < out.relaxes.len) {
                if (str_equals(out.relaxes.data[k].from, rx.from)) { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, TWICE, rx.from)}; }
                k = k + 1;
            }
            if (!fits(vector.push[Relax](?out.relaxes, rx))) { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        }
        or { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
        i = i + 1;
    }
    if (out.far == nil || out.fill == nil) { ret res[Relaxes, diag.Refusal].err{diag.refusal(nil, 0, NO_FAR, nil)}; }
    ret res[Relaxes, diag.Refusal].ok{out};
}
