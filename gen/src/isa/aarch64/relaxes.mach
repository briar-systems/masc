# the relax topic: the far branch a branch out of range relaxes past, and the code fill
#
# neither the instruction model nor the A64 ISA XML states a relaxation, and llvm-mc 23.1.1 and GNU as relax no aarch64
# branch, so the topic gen/data/aarch64/relax.txt states masc's own, each read against the branch's range in the Arm
# ARM. every branch the inverses topic states an inverse of relaxes to that inverse past the far branch to the target:
#
#   far | row=<row>
#   fill | row=<row>
#
# rows are named by key. `far` names the branch to the target and `fill` the no-op the code fill repeats

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "relax";

pub val BAD_LINE: str = "relax line is not `far | row=<row>` or `fill | row=<row>`";
pub val TWICE:    str = "relax states the far branch or the fill twice";
pub val NO_FAR:   str = "relax states no far branch or no fill";

# the topic
# ---
# far:  the key of the far branch
# fill: the key of the no-op
# fact: the far branch's line, for its refusals
pub rec Relaxes {
    far:  str;
    fill: str;
    fact: *topic.Fact;
}

# the relax topic of the data tree `tree`
pub fun read(a: *A.Allocator, tree: *source.Tree) res[Relaxes, diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, TOPIC);
    if (sel got.err) { ret res[Relaxes, diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, nil, topic.unstated);
    if (sel checked.err) { ret res[Relaxes, diag.Refusal].err{checked.err}; }
    var out: Relaxes = Relaxes{far: nil, fill: nil, fact: nil};
    var i:   usize   = 0;
    for (i < t.facts.len) {
        var l:    topic.Line        = topic.Line{fact: nil, key: vector.init[str](a), ws: vector.init[str](a)};
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err) { ret res[Relaxes, diag.Refusal].err{read.err}; }
        val far: bool     = topic.is(?l, "far", 1);
        val row: opt[str] = topic.value(?l.ws, "row");
        var key: str      = nil;
        if (sel row.some)                                                      { key = row.some; }
        if ((!far && !topic.is(?l, "fill", 1)) || key == nil || l.ws.len != 1) { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
        if ((far && out.far != nil) || (!far && out.fill != nil))              { ret res[Relaxes, diag.Refusal].err{topic.refuse(l.fact, TWICE, key)}; }
        if (far) {
            out.far  = key;
            out.fact = l.fact;
        }
        or { out.fill = key; }
        i = i + 1;
    }
    if (out.far == nil || out.fill == nil) { ret res[Relaxes, diag.Refusal].err{diag.refusal(nil, 0, NO_FAR, nil)}; }
    ret res[Relaxes, diag.Refusal].ok{out};
}
