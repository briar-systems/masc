# the streaming topic: under which value of streaming each row exists
#
# the model states an instruction's features, never the mode it runs in, so the topic gen/data/aarch64/streaming.txt
# states it per group of the model, one line each:
#
#   streaming <group> | <on|off|split|any>
#
# `on` holds only in streaming sve mode, `off` only outside it, `any` in both, and `split` is the sve instructions'
# rule: an alternative of a row's conditions that holds a feature of sme exists in streaming mode, and one that holds
# none outside it, as `FEAT_SVE || FEAT_SME` reads (DDI 0487, "Streaming SVE mode"). a row takes the line of its
# deepest group the topic names, and a row under no named group exists in both. the model states nothing any line
# states, so no line overrides it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "streaming";

pub val BAD_LINE: str = "streaming line is not `streaming <group> | on, off, split or any`";
pub val TWICE:    str = "group stated twice";

# under which value of streaming a row exists
pub def Mode: u8;

pub val ANY:   Mode = 0;
pub val ON:    Mode = 1;
pub val OFF:   Mode = 2;
pub val SPLIT: Mode = 3;

pub rec Line {
    group: str;
    mode:  Mode;
}

pub rec Streaming {
    lines: vector.Vector[Line];
}

fun fits(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# the streaming topic of the data tree `tree`
pub fun read(a: *A.Allocator, tree: *source.Tree) res[Streaming, diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, TOPIC);
    if (sel got.err) { ret res[Streaming, diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, nil, topic.unstated);
    if (sel checked.err) { ret res[Streaming, diag.Refusal].err{checked.err}; }
    var out: Streaming = Streaming{lines: vector.init[Line](a)};
    var i:   usize     = 0;
    for (i < t.facts.len) {
        var l:    topic.Line        = topic.Line{fact: nil, key: vector.init[str](a), ws: vector.init[str](a)};
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err) { ret res[Streaming, diag.Refusal].err{read.err}; }
        val w:    opt[str] = topic.only(?l);
        var word: str      = nil;
        if (sel w.some)                                   { word = w.some; }
        if (!topic.is(?l, "streaming", 2) || word == nil) { ret res[Streaming, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, nil)}; }
        var mode: Mode = ANY;
        if (str_equals(word, "on"))    { mode = ON; }
        or (str_equals(word, "off"))   { mode = OFF; }
        or (str_equals(word, "split")) { mode = SPLIT; }
        or (!str_equals(word, "any"))  { ret res[Streaming, diag.Refusal].err{topic.refuse(l.fact, BAD_LINE, word)}; }
        var k: usize = 0;
        for (k < out.lines.len) {
            if (str_equals(out.lines.data[k].group, l.key.data[1])) { ret res[Streaming, diag.Refusal].err{topic.refuse(l.fact, TWICE, l.key.data[1])}; }
            k = k + 1;
        }
        if (!fits(vector.push[Line](?out.lines, Line{group: l.key.data[1], mode: mode}))) { ret res[Streaming, diag.Refusal].err{topic.refuse(l.fact, diag.MEMORY, nil)}; }
        i = i + 1;
    }
    ret res[Streaming, diag.Refusal].ok{out};
}

# whether group path `path` is `group` or lies under it
fun under(path: str, group: str) bool {
    val n: usize = str_len(group);
    if (!str_starts_with(path, group)) { ret false; }
    ret path[n] == 0 || path[n] == '/';
}

# the mode of a row under group path `path`, its deepest named group's
pub fun mode(s: *Streaming, path: str) Mode {
    var best: usize = 0;
    var got:  Mode  = ANY;
    var i:    usize = 0;
    for (i < s.lines.len) {
        val g: str = s.lines.data[i].group;
        if (under(path, g) && str_len(g) > best) {
            best = str_len(g);
            got  = s.lines.data[i].mode;
        }
        i = i + 1;
    }
    ret got;
}

# the state atom an alternative holding features `features` exists under in mode `m`, as its emitted constant, nil for
# both values
pub fun state(s: *Streaming, m: Mode, features: *vector.Vector[str]) str {
    if (m == ON)  { ret "aarch64_extension.STREAMING_ON"; }
    if (m == OFF) { ret "aarch64_extension.STREAMING_OFF"; }
    if (m == SPLIT) {
        var i: usize = 0;
        for (i < features.len) {
            if (str_starts_with(features.data[i], "FEAT_SME")) { ret "aarch64_extension.STREAMING_ON"; }
            i = i + 1;
        }
        ret "aarch64_extension.STREAMING_OFF";
    }
    ret nil;
}
