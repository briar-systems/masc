# the operands topic: what each operand rule of the instruction model is as an operand
#
# the model states an operand symbol's text and the fields it is encoded in, never what the text means, so the topic
# gen/data/aarch64/operands.txt states it, one line for each rule the model's instructions use as an operand, keyed by
# the rule's id. the model dedups its rules on their full meaning, so one id is one meaning wherever it appears. the
# file's header states the grammar of each line: register, immediate, relative, choice, element, role, fixed,
# ignored, reserved, apart, needs and withheld lines. a register or immediate states its number as an expression of its fields where the fields alone do not hold
# it, so the mapping reads the number over each row's free bits rather than this reader shaping it.
#
# a role is read, write, read-write or none. a register line states its rule's role where every instruction using the
# rule shares it, and states none where they differ, so that each instruction's role line states it. a rule that states
# a role takes no role line, and a rule that states none takes a role line from each instruction using it. the model
# states nothing any line states, so no line overrides it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use masc.core.operand;

use gen.diag;
use gen.isa.aarch64.expr;
use topic: gen.overlay;
use gen.source;

pub val TOPIC: str = "operands";

pub val BAD_KIND:    str = "operands line is no register, immediate, relative, choice, element, role, fixed, ignored, reserved, apart, needs or withheld";
pub val BAD_NEED:    str = "needs line names no feature before its fields";
pub val BAD_APART:   str = "apart item is not `<rule>=<rule>[,<rule>...]`";
pub val BAD_ROLE:    str = "role is not read, write, read-write or none";
pub val NO_REGISTER: str = "role line names a rule that is no register rule";
pub val DISAGREED:   str = "role line names a rule that states its own role, which every instruction using it shares";
pub val UNREAD:      str = "role line names a rule no operand of its instruction's rows reads";
pub val UNIFORM:     str = "register rule states no role, and every role line for it states one";
pub val BAD_SIGN:    str = "immediate is not unsigned, signed, either, float8, bitmask or bytemask";
pub val BAD_DERIVED: str = "derived immediate is not a number of 1 to 64 bits with no value of its fields";
pub val BAD_CHOICE:  str = "choice is not rows, enumerant, mask or one";
pub val BAD_EXPR:    str = "expression of the line does not read";
pub val BAD_CUBE:    str = "by cube is not `<bits>=<expr>` over the by fields";
pub val BAD_MEMBER:  str = "choice member is not `<text>=<bits>`";
pub val BAD_PATTERN: str = "member bits are not 0, 1 and x";
pub val BAD_RANGE:   str = "range is not `<lo>,<hi>` with lo at most hi";
pub val NO_DEFAULT:  str = "choice default names no member";
pub val BAD_UNLESS:  str = "unless is not `<symbol>:<member>`";
pub val BAD_WHERE:   str = "where is not `<member>:<rule>[,<rule>]=<number>` of a member the choice names";
pub val TWICE:       str = "operand rule, specifier or instruction stated twice";

# how an operand rule is used
pub def Use: u8;

pub val REGISTER:  Use = 0;
pub val IMMEDIATE: Use = 1;
pub val RELATIVE:  Use = 2;
pub val CHOICE:    Use = 3;
pub val ONE:       Use = 4;

# what an immediate's bits hold
# ---
# NUMBER:   a number
# FLOAT8:   the 8-bit floating-point immediate, a sign, 3-bit exponent and 4-bit fraction
# BITMASK:  the logical immediate N:immr:imms
# BYTEMASK: movi's 64-bit immediate, a byte of ones or zeros per bit of a:b:c:d:e:f:g:h
pub def Kind: u8;

pub val NUMBER:   Kind = 0;
pub val FLOAT8:   Kind = 1;
pub val BITMASK:  Kind = 2;
pub val BYTEMASK: Kind = 3;

# how a choice is one operand or many rows
# ---
# ROWS:      a row of each member
# ENUMERANT: one operand of the members' values
# MASK:      one operand of any union of the members' bits
pub def How: u8;

pub val ROWS:      How = 0;
pub val ENUMERANT: How = 1;
pub val MASK:      How = 2;

# a role as the topic states it
pub def Role: u8;

pub val READ:       Role = 0;
pub val WRITE:      Role = 1;
pub val READ_WRITE: Role = 2;
pub val NONE:       Role = 3;
pub val UNSTATED:   Role = 4;

# one member of a choice
# ---
# text:  the text it spells, as the model writes it, or for a choice the model encodes in no field the rule of its
#        branch
# cubes: the bits of the choice's fields it encodes, from the high bit, `x` for a bit it leaves, one pattern per cube
# needs: the features it needs beyond its instruction's, alternatives of features all held, as dc's CGDSW needs
#        FEAT_MTE2, none for a member of none
pub rec Member {
    text:  str;
    cubes: vector.Vector[str];
    needs: vector.Vector[vector.Vector[str]];
}

# the one value of another operand that keeps an operand's text from being left out, as ldr's `<amount>`, optional only
# where `<extend>` is not LSL
# ---
# symbol: the other operand's symbol as the page writes it, as `<extend>`, nil for none
# member: the member of its choice that does
pub rec Unless {
    symbol: str;
    member: str;
}

# a member a choice spells, and takes where its text is left out, only where a register of the instruction is one
# number, as add's LSL where `<Xd|SP>` or `<Xn|SP>` is sp
# ---
# member: the member, nil for none
# rules:  the register rules, any one of which may be the number
# number: the number
pub rec Where {
    member: str;
    rules:  vector.Vector[str];
    number: u32;
}

# a number by the bits of other fields: the bits, from the high bit of the by fields, and the number under them
pub rec Cube {
    bits:  str;
    value: expr.Expr;
}

# what one operand rule is
# ---
# rule:      the rule's id
# use:       how it is used
# fact:      its line, for refusals
# classes:   a register's classes by name, the numbered class first
# role:      a register's role
# valued:    whether `value` states the number, false for its fields' bits alone
# value:     a register's number, an immediate's value or a relative target's offset
# step:      the stride of the numbers a register admits, 1 for every number
# by:        the fields whose bits choose among `cubes`, empty for none
# cubes:     the number under each pattern of the by fields
# kind:      what an immediate's bits hold
# sign:      an immediate's sign
# ranged:    whether `lo` and `hi` bound an immediate's values
# lo:        the least value a ranged immediate admits
# hi:        the most
# defaulted: whether an immediate has a value its left out text takes
# default:   that value
# derived:   the bits of an immediate an alias's derivation computes, which holds no bits of its own, 0 for any other
# page:      whether a relative target's offset is from the instruction's 4KB page
# how:       how a choice is used
# fields:    the field a choice of branches is by, empty for a choice the model encodes
# members:   a choice's members, in the line's order
# omitted:   the member an enumerant takes where its text is left out, or the register a register takes, by name, nil
#            for none
# one:       the rule a choice of branches is one operand of, nil for none
# unless:    the value of another operand where an immediate's or a choice's text may not be left out
# where:     the member a choice spells only where a register is one number
pub rec Fact {
    rule:      str;
    use:       Use;
    fact:      *topic.Fact;
    classes:   vector.Vector[str];
    role:      Role;
    valued:    bool;
    value:     expr.Expr;
    step:      u32;
    by:        vector.Vector[str];
    cubes:     vector.Vector[Cube];
    kind:      Kind;
    sign:      operand.Sign;
    ranged:    bool;
    lo:        i64;
    hi:        i64;
    defaulted: bool;
    default:   i64;
    derived:   u8;
    page:      bool;
    how:       How;
    fields:    vector.Vector[str];
    members:   vector.Vector[Member];
    omitted:   str;
    one:       str;
    unless:    Unless;
    where:     Where;
}

# an element specifier
pub rec Element {
    name:  str;
    bits:  u16;
    lanes: u8;
}

# a role line's role for one rule, under the fields its row fixes
# ---
# rule: the rule
# role: its role
# when: the fields and the bits each holds where the role is the rule's, every one a field the row fixes, none for the
#       role of a row no other case of the rule meets
# used: whether a row's operand took it
pub rec Roled {
    rule: str;
    role: Role;
    when: vector.Vector[Fixed];
    used: bool;
}

# the role lines of one instruction
pub rec Roles {
    instruction: str;
    fact:        *topic.Fact;
    roles:       vector.Vector[Roled];
}

# the topic as read
# ---
# facts:        every operand rule's fact, in file order
# rules:        each fact's index by its rule
# elements:     every specifier
# specifiers:   each specifier's index by its name
# roles:        every role line
# instructions: each role line's index by its instruction
# fixed:        each instruction's fixed lines, by name
# reserved:     each instruction's reserved lines, by name
# apart:        each instruction's apart lines, by name
# needs:        each instruction's needs line, by name
# ignored:      the fields each instruction's ignored line names, by name
# withheld:     every withheld instruction, by name, with the index of its line in `reasons`
# reasons:      each withheld line
pub rec Operands {
    facts:        vector.Vector[Fact];
    rules:        map.Map[str, u32];
    elements:     vector.Vector[Element];
    specifiers:   map.Map[str, u32];
    roles:        vector.Vector[Roles];
    instructions: map.Map[str, u32];
    fixed:        map.Map[str, vector.Vector[Fixed]];
    reserved:     map.Map[str, vector.Vector[Fixed]];
    apart:        map.Map[str, vector.Vector[Apart]];
    needs:        map.Map[str, Need];
    ignored:      map.Map[str, vector.Vector[str]];
    withheld:     map.Map[str, u32];
    reasons:      vector.Vector[*topic.Fact];
}

# a field an instruction's decode refuses every other value of where no operand of a row holds it
# ---
# field: the field
# bits:  its one value, from the high bit
pub rec Fixed {
    field: str;
    bits:  str;
}

# a feature an instruction's decode needs where its fields hold some bits, as pmull's FEAT_PMULL where size is 11
# ---
# feature: the feature
# tests:   the fields and the bits each holds
pub rec Need {
    feature: str;
    tests:   vector.Vector[Fixed];
}

# a register an instruction keeps apart from others, as ldp's rt2 from rt
# ---
# rule: the rule of the register kept apart
# from: the rules of the registers it is kept from
pub rec Apart {
    rule: str;
    from: vector.Vector[str];
}

fun fits(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun inserted(r: res[bool, A.Error]) bool {
    ret sel r.ok;
}

fun found(o: opt[*u32]) bool {
    ret sel o.some;
}

fun reject(l: *topic.Line, message: str, subject: str) err[diag.Refusal] {
    ret topic.reject(l, message, subject);
}

fun memory(l: *topic.Line) err[diag.Refusal] {
    ret reject(l, diag.MEMORY, nil);
}

# the role `w` names
fun role_of(l: *topic.Line, w: str, out: *Role) err[diag.Refusal] {
    if (str_equals(w, "read"))       { @out = READ; }
    or (str_equals(w, "write"))      { @out = WRITE; }
    or (str_equals(w, "read-write")) { @out = READ_WRITE; }
    or (str_equals(w, "none"))       { @out = NONE; }
    or                               { ret reject(l, BAD_ROLE, w); }
    ret err[diag.Refusal].ok{};
}

# the words of `text` split on `sep`
fun split(a: *A.Allocator, l: *topic.Line, text: str, sep: u8, out: *vector.Vector[str]) err[diag.Refusal] {
    val len:  usize = str_len(text);
    var from: usize = 0;
    var i:    usize = 0;
    for (i <= len) {
        if (i == len || text[i] == sep) {
            val got: res[str, StrError] = str_copy_slice(a, text, from, i - from);
            if (sel got.err)                          { ret memory(l); }
            if (!fits(vector.push[str](out, got.ok))) { ret memory(l); }
            from = i + 1;
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the first `len` bits of `w` with its `:` separators taken out, refused when they hold other than 0, 1 and x
fun pattern(a: *A.Allocator, l: *topic.Line, w: str, len: usize, out: *str) err[diag.Refusal] {
    val got: res[*u8, A.Error] = A.allocate[u8](a, len + 1);
    if (sel got.err) { ret memory(l); }
    var n: usize = 0;
    var i: usize = 0;
    for (i < len) {
        val c: u8 = w[i];
        if (c == '0' || c == '1' || c == 'x') {
            got.ok[n] = c;
            n         = n + 1;
        }
        or (c != ':') { ret reject(l, BAD_PATTERN, w); }
        i = i + 1;
    }
    if (n == 0) { ret reject(l, BAD_PATTERN, w); }
    got.ok[n] = 0;
    @out      = got.ok;
    ret err[diag.Refusal].ok{};
}

# a member `<text>=<bits>[,<bits>][@<features>]`, the last `=` dividing them, the features alternatives `/` of features
# `+` all held, as `CGDVAOC=011:1011:111@FEAT_OCCMO+FEAT_MTE`
fun member(a: *A.Allocator, l: *topic.Line, w: str, out: *vector.Vector[Member]) err[diag.Refusal] {
    var len: usize = str_len(w);
    var eq:  usize = len;
    var i:   usize = 0;
    for (i < len) {
        if (w[i] == '=') { eq = i; }
        i = i + 1;
    }
    var needs: vector.Vector[vector.Vector[str]] = vector.init[vector.Vector[str]](a);
    var whole: str                               = w;
    i = eq;
    for (i < len && w[i] != '@') { i = i + 1; }
    if (i < len) {
        var alts: vector.Vector[str] = vector.init[str](a);
        val each: err[diag.Refusal]  = split(a, l, ?w[i + 1], '/', ?alts);
        if (sel each.err) { ret each; }
        var k: usize = 0;
        for (k < alts.len) {
            var all:  vector.Vector[str] = vector.init[str](a);
            val also: err[diag.Refusal]  = split(a, l, alts.data[k], '+', ?all);
            if (sel also.err)                                        { ret also; }
            if (!fits(vector.push[vector.Vector[str]](?needs, all))) { ret memory(l); }
            k = k + 1;
        }
        val cut: res[str, StrError] = str_copy_slice(a, w, 0, i);
        if (sel cut.ok) { whole = cut.ok; }
        or              { ret memory(l); }
        len = i;
    }
    if (eq == len || eq + 1 == len) { ret reject(l, BAD_MEMBER, w); }
    val text: res[str, StrError] = str_copy_slice(a, w, 0, eq);
    if (sel text.err) { ret memory(l); }
    var words: vector.Vector[str] = vector.init[str](a);
    val parts: err[diag.Refusal]  = split(a, l, ?whole[eq + 1], ',', ?words);
    if (sel parts.err) { ret parts; }
    var m: Member = Member{text: text.ok, cubes: vector.init[str](a), needs: needs};
    i = 0;
    for (i < words.len) {
        var bits: str               = nil;
        val read: err[diag.Refusal] = pattern(a, l, words.data[i], str_len(words.data[i]), ?bits);
        if (sel read.err)                            { ret read; }
        if (!fits(vector.push[str](?m.cubes, bits))) { ret memory(l); }
        i = i + 1;
    }
    if (!fits(vector.push[Member](out, m))) { ret memory(l); }
    ret err[diag.Refusal].ok{};
}

fun number(l: *topic.Line, w: str, out: *i64) err[diag.Refusal] {
    val got: res[i64, diag.Refusal] = topic.number(l.fact, w);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    @out = got.ok;
    ret err[diag.Refusal].ok{};
}

# the named number `name`, `otherwise` when the line does not give it
fun named(l: *topic.Line, name: str, otherwise: i64, out: *i64) err[diag.Refusal] {
    val v: opt[str] = topic.value(?l.ws, name);
    if (sel v.none) {
        @out = otherwise;
        ret err[diag.Refusal].ok{};
    }
    ret number(l, v.some, out);
}

# the expression `w`
fun expression(a: *A.Allocator, l: *topic.Line, w: str, out: *expr.Expr) err[diag.Refusal] {
    val got: res[expr.Expr, str] = expr.parse(a, w);
    if (sel got.err) { ret reject(l, BAD_EXPR, w); }
    @out = got.ok;
    ret err[diag.Refusal].ok{};
}

# the named expression `name`, `valued` set when the line gives it
fun valued(a: *A.Allocator, l: *topic.Line, name: str, out: *Fact) err[diag.Refusal] {
    val v: opt[str] = topic.value(?l.ws, name);
    if (sel v.none) { ret err[diag.Refusal].ok{}; }
    out.valued = true;
    ret expression(a, l, v.some, ?out.value);
}

# `by=<fields>` and the cubes `<bits>=<expr>` after it
fun cubes(a: *A.Allocator, l: *topic.Line, from: usize, out: *Fact) err[diag.Refusal] {
    val by: opt[str] = topic.value(?l.ws, "by");
    if (sel by.none) { ret err[diag.Refusal].ok{}; }
    val split_by: err[diag.Refusal] = split(a, l, by.some, ':', ?out.by);
    if (sel split_by.err) { ret split_by; }
    var i: usize = from;
    for (i < l.ws.len) {
        val w:   str   = l.ws.data[i];
        val len: usize = str_len(w);
        var eq:  usize = 0;
        for (eq < len && w[eq] != '=') { eq = eq + 1; }
        if (is_cube(w)) {
            var pat: str               = nil;
            val got: err[diag.Refusal] = pattern(a, l, w, eq, ?pat);
            if (sel got.err) { ret got; }
            var c:  Cube              = Cube{bits: pat, value: expr.Expr{nodes: vector.init[expr.Node](a), pieces: vector.init[expr.Piece](a)}};
            val ex: err[diag.Refusal] = expression(a, l, ?w[eq + 1], ?c.value);
            if (sel ex.err)                              { ret ex; }
            if (!fits(vector.push[Cube](?out.cubes, c))) { ret memory(l); }
        }
        i = i + 1;
    }
    if (out.cubes.len == 0) { ret reject(l, BAD_CUBE, by.some); }
    ret err[diag.Refusal].ok{};
}

# whether word `w` is a cube `<bits>=...`
fun is_cube(w: str) bool {
    val len: usize = str_len(w);
    var k:   usize = 0;
    for (k < len && w[k] != '=') {
        if (w[k] != '0' && w[k] != '1' && w[k] != 'x' && w[k] != ':') { ret false; }
        k = k + 1;
    }
    ret k > 0 && k < len;
}

# every word of `l` past `from` one of `names` or a cube
fun only_named(l: *topic.Line, from: usize, names: *str, count: usize) err[diag.Refusal] {
    var i: usize = from;
    for (i < l.ws.len) {
        val w:  str   = l.ws.data[i];
        var ok: bool  = is_cube(w);
        var k:  usize = 0;
        for (k < count && !ok) {
            val n: str = names[k];
            if (str_starts_with(w, n) && w[str_len(n)] == '=') { ok = true; }
            k = k + 1;
        }
        if (!ok) { ret reject(l, topic.UNKNOWN_WORD, w); }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun register(a: *A.Allocator, l: *topic.Line, out: *Fact) err[diag.Refusal] {
    val names: [6]str            = [6]str{"class", "role", "number", "step", "by", "default"};
    val known: err[diag.Refusal] = only_named(l, 0, ?names[0], 6);
    if (sel known.err) { ret known; }
    var c:      str               = nil;
    val needed: err[diag.Refusal] = topic.needed(l, "class", ?c);
    if (sel needed.err) { ret needed; }
    val split_classes: err[diag.Refusal] = split(a, l, c, ',', ?out.classes);
    if (sel split_classes.err) { ret split_classes; }
    val role: opt[str] = topic.value(?l.ws, "role");
    if (sel role.some) {
        val roled: err[diag.Refusal] = role_of(l, role.some, ?out.role);
        if (sel roled.err) { ret roled; }
    }
    var step: i64               = 1;
    val s:    err[diag.Refusal] = named(l, "step", 1, ?step);
    if (sel s.err) { ret s; }
    out.step = step::u32;
    val d: opt[str] = topic.value(?l.ws, "default");
    if (sel d.some) { out.omitted = d.some; }
    val v: err[diag.Refusal] = valued(a, l, "number", out);
    if (sel v.err) { ret v; }
    ret cubes(a, l, 0, out);
}

fun immediate(a: *A.Allocator, l: *topic.Line, out: *Fact) err[diag.Refusal] {
    if (l.ws.len == 0) { ret reject(l, BAD_SIGN, nil); }
    val sign: str = l.ws.data[0];
    if (str_equals(sign, "unsigned")) { out.sign = operand.UNSIGNED; }
    or (str_equals(sign, "signed"))   { out.sign = operand.SIGNED; }
    or (str_equals(sign, "either"))   { out.sign = operand.EITHER; }
    or (str_equals(sign, "float8"))   { out.kind = FLOAT8; }
    or (str_equals(sign, "bitmask"))  { out.kind = BITMASK; }
    or (str_equals(sign, "bytemask")) { out.kind = BYTEMASK; }
    or                                { ret reject(l, BAD_SIGN, sign); }
    val names: [6]str            = [6]str{"value", "by", "range", "default", "unless", "derived"};
    val known: err[diag.Refusal] = only_named(l, 1, ?names[0], 6);
    if (sel known.err) { ret known; }
    val derived: opt[str] = topic.value(?l.ws, "derived");
    if (sel derived.some) {
        var bits: i64               = 0;
        val got:  err[diag.Refusal] = number(l, derived.some, ?bits);
        if (sel got.err) { ret got; }
        val valued_too: opt[str] = topic.value(?l.ws, "value");
        if (bits < 1 || bits > 64 || out.kind != NUMBER || sel valued_too.some) { ret reject(l, BAD_DERIVED, derived.some); }
        out.derived = bits::u8;
    }
    val v: err[diag.Refusal] = valued(a, l, "value", out);
    if (sel v.err) { ret v; }
    val by: err[diag.Refusal] = cubes(a, l, 1, out);
    if (sel by.err) { ret by; }
    val u: opt[str] = topic.value(?l.ws, "unless");
    if (sel u.some) {
        val got: err[diag.Refusal] = unless_of(a, l, u.some, ?out.unless);
        if (sel got.err) { ret got; }
    }
    val d: opt[str] = topic.value(?l.ws, "default");
    if (sel d.some) {
        out.defaulted = true;
        val got: err[diag.Refusal] = number(l, d.some, ?out.default);
        if (sel got.err) { ret got; }
    }
    val range: opt[str] = topic.value(?l.ws, "range");
    if (sel range.some) {
        var bounds: vector.Vector[str] = vector.init[str](a);
        val parts:  err[diag.Refusal]  = split(a, l, range.some, ',', ?bounds);
        if (sel parts.err)   { ret parts; }
        if (bounds.len != 2) { ret reject(l, BAD_RANGE, range.some); }
        val lo: err[diag.Refusal] = number(l, bounds.data[0], ?out.lo);
        if (sel lo.err) { ret lo; }
        val hi: err[diag.Refusal] = number(l, bounds.data[1], ?out.hi);
        if (sel hi.err)      { ret hi; }
        if (out.lo > out.hi) { ret reject(l, BAD_RANGE, range.some); }
        out.ranged = true;
    }
    ret err[diag.Refusal].ok{};
}

fun relative(a: *A.Allocator, l: *topic.Line, out: *Fact) err[diag.Refusal] {
    val names: [2]str            = [2]str{"value", "page"};
    val known: err[diag.Refusal] = topic.known(l, ?names[0], 2);
    if (sel known.err) { ret known; }
    var w:      str               = nil;
    val needed: err[diag.Refusal] = topic.needed(l, "value", ?w);
    if (sel needed.err) { ret needed; }
    out.valued = true;
    val ex: err[diag.Refusal] = expression(a, l, w, ?out.value);
    if (sel ex.err) { ret ex; }
    out.sign = operand.SIGNED;
    val page: res[bool, diag.Refusal] = topic.yes(l, "page", false);
    if (sel page.err) { ret err[diag.Refusal].err{page.err}; }
    out.page = page.ok;
    ret err[diag.Refusal].ok{};
}

fun choice(a: *A.Allocator, l: *topic.Line, out: *Fact) err[diag.Refusal] {
    if (l.ws.len == 0) { ret reject(l, BAD_CHOICE, nil); }
    val how: str = l.ws.data[0];
    if (str_starts_with(how, "one=")) {
        if (l.ws.len != 1) { ret reject(l, BAD_CHOICE, how); }
        out.use = ONE;
        out.one = ?how[4];
        ret err[diag.Refusal].ok{};
    }
    if (l.ws.len < 2)                 { ret reject(l, BAD_CHOICE, nil); }
    if (str_equals(how, "rows"))      { out.how = ROWS; }
    or (str_equals(how, "enumerant")) { out.how = ENUMERANT; }
    or (str_equals(how, "mask"))      { out.how = MASK; }
    or                                { ret reject(l, BAD_CHOICE, how); }
    var i: usize = 1;
    for (i < l.ws.len) {
        val w: str = l.ws.data[i];
        if (str_starts_with(w, "fields=")) {
            val got: err[diag.Refusal] = split(a, l, ?w[7], ',', ?out.fields);
            if (sel got.err) { ret got; }
        }
        or (str_starts_with(w, "default=")) { out.omitted = ?w[8]; }
        or (str_starts_with(w, "unless=")) {
            val got: err[diag.Refusal] = unless_of(a, l, ?w[7], ?out.unless);
            if (sel got.err) { ret got; }
        }
        or (str_starts_with(w, "where=")) {
            val got: err[diag.Refusal] = where_of(a, l, ?w[6], ?out.where);
            if (sel got.err) { ret got; }
        }
        or {
            val got: err[diag.Refusal] = member(a, l, w, ?out.members);
            if (sel got.err) { ret got; }
        }
        i = i + 1;
    }
    if (out.omitted != nil) {
        var held: bool  = false;
        var k:    usize = 0;
        for (k < out.members.len) {
            if (str_equals(out.members.data[k].text, out.omitted)) { held = true; }
            k = k + 1;
        }
        if (!held) { ret reject(l, NO_DEFAULT, out.omitted); }
    }
    if (out.where.member != nil) {
        var held: bool  = false;
        var k:    usize = 0;
        for (k < out.members.len) {
            if (str_equals(out.members.data[k].text, out.where.member)) { held = true; }
            k = k + 1;
        }
        if (!held) { ret reject(l, BAD_WHERE, out.where.member); }
    }
    ret err[diag.Refusal].ok{};
}

# `<symbol>:<member>`, the value of another operand where a text may not be left out
fun unless_of(a: *A.Allocator, l: *topic.Line, w: str, out: *Unless) err[diag.Refusal] {
    var parts: vector.Vector[str] = vector.init[str](a);
    val got:   err[diag.Refusal]  = split(a, l, w, ':', ?parts);
    if (sel got.err)                                                                  { ret got; }
    if (parts.len != 2 || str_len(parts.data[0]) == 0 || str_len(parts.data[1]) == 0) { ret reject(l, BAD_UNLESS, w); }
    @out = Unless{symbol: parts.data[0], member: parts.data[1]};
    ret err[diag.Refusal].ok{};
}

# `<member>:<rule>[,<rule>]=<number>`, a member spelled only where one of the rules' registers is the number
fun where_of(a: *A.Allocator, l: *topic.Line, w: str, out: *Where) err[diag.Refusal] {
    var parts: vector.Vector[str] = vector.init[str](a);
    val got:   err[diag.Refusal]  = split(a, l, w, ':', ?parts);
    if (sel got.err)                                   { ret got; }
    if (parts.len != 2 || str_len(parts.data[0]) == 0) { ret reject(l, BAD_WHERE, w); }
    var sides: vector.Vector[str] = vector.init[str](a);
    val eq:    err[diag.Refusal]  = split(a, l, parts.data[1], '=', ?sides);
    if (sel eq.err)     { ret eq; }
    if (sides.len != 2) { ret reject(l, BAD_WHERE, w); }
    var n:  i64               = 0;
    val at: err[diag.Refusal] = number(l, sides.data[1], ?n);
    if (sel at.err) { ret at; }
    if (n < 0)      { ret reject(l, BAD_WHERE, w); }
    out.member = parts.data[0];
    out.number = n::u32;
    ret split(a, l, sides.data[0], ',', ?out.rules);
}

fun fact_of(a: *A.Allocator, l: *topic.Line, out: *Fact) err[diag.Refusal] {
    @out = Fact{
        rule:      l.key.data[1],
        use:       REGISTER,
        fact:      l.fact,
        classes:   vector.init[str](a),
        role:      UNSTATED,
        valued:    false,
        value:     expr.Expr{nodes: vector.init[expr.Node](a), pieces: vector.init[expr.Piece](a)},
        step:      1,
        by:        vector.init[str](a),
        cubes:     vector.init[Cube](a),
        kind:      NUMBER,
        sign:      operand.UNSIGNED,
        ranged:    false,
        lo:        0,
        hi:        0,
        defaulted: false,
        default:   0,
        derived:   0,
        page:      false,
        how:       ROWS,
        fields:    vector.init[str](a),
        members:   vector.init[Member](a),
        omitted:   nil,
        one:       nil,
        unless:    Unless{symbol: nil, member: nil},
        where:     Where{member: nil, rules: vector.init[str](a), number: 0},
    };
    if (topic.is(l, "register", 2)) { ret register(a, l, out); }
    if (topic.is(l, "immediate", 2)) {
        out.use = IMMEDIATE;
        ret immediate(a, l, out);
    }
    if (topic.is(l, "relative", 2)) {
        out.use = RELATIVE;
        ret relative(a, l, out);
    }
    if (topic.is(l, "choice", 2)) {
        out.use = CHOICE;
        ret choice(a, l, out);
    }
    ret reject(l, BAD_KIND, l.key.data[0]);
}

fun element_of(l: *topic.Line, out: *Element) err[diag.Refusal] {
    val names: [2]str            = [2]str{"bits", "lanes"};
    val known: err[diag.Refusal] = topic.known(l, ?names[0], 2);
    if (sel known.err) { ret known; }
    var b:      str               = nil;
    val needed: err[diag.Refusal] = topic.needed(l, "bits", ?b);
    if (sel needed.err) { ret needed; }
    var bits:  i64               = 0;
    var lanes: i64               = 0;
    val got:   err[diag.Refusal] = number(l, b, ?bits);
    if (sel got.err) { ret got; }
    val counted: err[diag.Refusal] = named(l, "lanes", 0, ?lanes);
    if (sel counted.err) { ret counted; }
    @out = Element{name: l.key.data[1], bits: bits::u16, lanes: lanes::u8};
    ret err[diag.Refusal].ok{};
}

fun roles_of(a: *A.Allocator, l: *topic.Line, out: *Roles) err[diag.Refusal] {
    @out = Roles{instruction: l.key.data[1], fact: l.fact, roles: vector.init[Roled](a)};
    var i: usize = 0;
    for (i < l.ws.len) {
        val w:   str   = l.ws.data[i];
        val len: usize = str_len(w);
        var eq:  usize = 0;
        for (eq < len && w[eq] != '=') { eq = eq + 1; }
        if (eq == 0 || eq + 1 >= len) { ret reject(l, BAD_ROLE, w); }
        val rule: res[str, StrError] = str_copy_slice(a, w, 0, eq);
        if (sel rule.err) { ret memory(l); }
        # `<rule>=<role>`, or `<rule>="<role> when <field>=<bits> ..."` for a role under the fields the row fixes
        var cut: usize = eq + 1;
        for (cut < len && w[cut] != ' ') { cut = cut + 1; }
        val named: res[str, StrError] = str_copy_slice(a, w, eq + 1, cut - eq - 1);
        if (sel named.err) { ret memory(l); }
        var r:  Role              = READ;
        val ok: err[diag.Refusal] = role_of(l, named.ok, ?r);
        if (sel ok.err) { ret ok; }
        var c: Roled = Roled{rule: rule.ok, role: r, when: vector.init[Fixed](a), used: false};
        if (cut < len) {
            val tests: res[vector.Vector[str], diag.Refusal] = topic.words(a, l.fact, ?w[cut]);
            if (sel tests.err)                                             { ret err[diag.Refusal].err{tests.err}; }
            if (tests.ok.len < 2 || !str_equals(tests.ok.data[0], "when")) { ret reject(l, BAD_ROLE, w); }
            var rest: topic.Line = @l;
            rest.ws.data = ?tests.ok.data[1];
            rest.ws.len  = tests.ok.len - 1;
            val read: err[diag.Refusal] = fields_of(a, ?rest, ?c.when);
            if (sel read.err) { ret read; }
        }
        var k: usize = 0;
        for (k < out.roles.len) {
            if (str_equals(out.roles.data[k].rule, c.rule) && out.roles.data[k].when.len == 0 && c.when.len == 0) { ret reject(l, TWICE, c.rule); }
            k = k + 1;
        }
        if (!fits(vector.push[Roled](?out.roles, c))) { ret memory(l); }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun refused(l: *topic.Line, message: str, subject: str) res[Operands, diag.Refusal] {
    ret res[Operands, diag.Refusal].err{topic.refuse(l.fact, message, subject)};
}

# the operands topic of the data tree `tree`
pub fun read(a: *A.Allocator, tree: *source.Tree) res[Operands, diag.Refusal] {
    val got: res[topic.Topic, diag.Refusal] = topic.read(a, tree, TOPIC);
    if (sel got.err) { ret res[Operands, diag.Refusal].err{got.err}; }
    var t:       topic.Topic       = got.ok;
    val checked: err[diag.Refusal] = topic.check(?t, nil, topic.unstated);
    if (sel checked.err) { ret res[Operands, diag.Refusal].err{checked.err}; }
    var out: Operands = Operands{
        facts:        vector.init[Fact](a),
        rules:        map.init[str, u32](a),
        elements:     vector.init[Element](a),
        specifiers:   map.init[str, u32](a),
        roles:        vector.init[Roles](a),
        instructions: map.init[str, u32](a),
        fixed:        map.init[str, vector.Vector[Fixed]](a),
        reserved:     map.init[str, vector.Vector[Fixed]](a),
        apart:        map.init[str, vector.Vector[Apart]](a),
        ignored:      map.init[str, vector.Vector[str]](a),
        needs:        map.init[str, Need](a),
        withheld:     map.init[str, u32](a),
        reasons:      vector.init[*topic.Fact](a),
    };
    var i: usize = 0;
    for (i < t.facts.len) {
        var l:    topic.Line        = topic.Line{fact: nil, key: vector.init[str](a), ws: vector.init[str](a)};
        val read: err[diag.Refusal] = topic.line(a, ?t.facts.data[i], ?l);
        if (sel read.err)   { ret res[Operands, diag.Refusal].err{read.err}; }
        if (l.key.len != 2) { ret refused(?l, BAD_KIND, nil); }
        if (topic.is(?l, "element", 2)) {
            var e:  Element           = Element{name: nil, bits: 0, lanes: 0};
            val ok: err[diag.Refusal] = element_of(?l, ?e);
            if (sel ok.err)                                                                      { ret res[Operands, diag.Refusal].err{ok.err}; }
            if (found(map.get[str, u32](?out.specifiers, ?e.name)))                              { ret refused(?l, TWICE, e.name); }
            if (!inserted(map.insert[str, u32](?out.specifiers, e.name, out.elements.len::u32))) { ret refused(?l, diag.MEMORY, nil); }
            if (!fits(vector.push[Element](?out.elements, e)))                                   { ret refused(?l, diag.MEMORY, nil); }
        }
        or (topic.is(?l, "fixed", 2) || topic.is(?l, "reserved", 2)) {
            val name: str                  = l.key.data[1];
            var fs:   vector.Vector[Fixed] = vector.init[Fixed](a);
            val read: err[diag.Refusal]    = fields_of(a, ?l, ?fs);
            if (sel read.err) { ret res[Operands, diag.Refusal].err{read.err}; }
            var into: *map.Map[str, vector.Vector[Fixed]] = ?out.fixed;
            if (topic.is(?l, "reserved", 2)) { into = ?out.reserved; }
            val prior: opt[*vector.Vector[Fixed]] = map.get[str, vector.Vector[Fixed]](into, ?name);
            if (sel prior.some)                                                   { ret refused(?l, TWICE, name); }
            if (!inserted(map.insert[str, vector.Vector[Fixed]](into, name, fs))) { ret refused(?l, diag.MEMORY, nil); }
        }
        or (topic.is(?l, "apart", 2)) {
            val name: str                  = l.key.data[1];
            var ps:   vector.Vector[Apart] = vector.init[Apart](a);
            val read: err[diag.Refusal]    = aparts_of(a, ?l, ?ps);
            if (sel read.err) { ret res[Operands, diag.Refusal].err{read.err}; }
            val prior: opt[*vector.Vector[Apart]] = map.get[str, vector.Vector[Apart]](?out.apart, ?name);
            if (sel prior.some)                                                         { ret refused(?l, TWICE, name); }
            if (!inserted(map.insert[str, vector.Vector[Apart]](?out.apart, name, ps))) { ret refused(?l, diag.MEMORY, nil); }
        }
        or (topic.is(?l, "needs", 2)) {
            val name: str  = l.key.data[1];
            var n:    Need = Need{feature: nil, tests: vector.init[Fixed](a)};
            if (l.ws.len < 2 || !str_starts_with(l.ws.data[0], "FEAT_")) { ret refused(?l, BAD_NEED, name); }
            n.feature = l.ws.data[0];
            var rest: topic.Line = topic.Line{fact: l.fact, key: l.key, ws: vector.init[str](a)};
            var w:    usize      = 1;
            for (w < l.ws.len) {
                vector.push[str](?rest.ws, l.ws.data[w]);
                w = w + 1;
            }
            val read: err[diag.Refusal] = fields_of(a, ?rest, ?n.tests);
            if (sel read.err) { ret res[Operands, diag.Refusal].err{read.err}; }
            val prior: opt[*Need] = map.get[str, Need](?out.needs, ?name);
            if (sel prior.some)                                        { ret refused(?l, TWICE, name); }
            if (!inserted(map.insert[str, Need](?out.needs, name, n))) { ret refused(?l, diag.MEMORY, nil); }
        }
        or (topic.is(?l, "ignored", 2)) {
            val name: str                = l.key.data[1];
            var fs:   vector.Vector[str] = vector.init[str](a);
            var k:    usize              = 0;
            for (k < l.ws.len) {
                if (!fits(vector.push[str](?fs, l.ws.data[k]))) { ret refused(?l, diag.MEMORY, nil); }
                k = k + 1;
            }
            val prior: opt[*vector.Vector[str]] = map.get[str, vector.Vector[str]](?out.ignored, ?name);
            if (sel prior.some)                                                         { ret refused(?l, TWICE, name); }
            if (!inserted(map.insert[str, vector.Vector[str]](?out.ignored, name, fs))) { ret refused(?l, diag.MEMORY, nil); }
        }
        or (topic.is(?l, "withheld", 2)) {
            val name: str = l.key.data[1];
            if (found(map.get[str, u32](?out.withheld, ?name)))                             { ret refused(?l, TWICE, name); }
            if (!inserted(map.insert[str, u32](?out.withheld, name, out.reasons.len::u32))) { ret refused(?l, diag.MEMORY, nil); }
            if (!fits(vector.push[*topic.Fact](?out.reasons, l.fact)))                      { ret refused(?l, diag.MEMORY, nil); }
        }
        or (topic.is(?l, "role", 2)) {
            var r:  Roles;
            val ok: err[diag.Refusal] = roles_of(a, ?l, ?r);
            if (sel ok.err)                                                                            { ret res[Operands, diag.Refusal].err{ok.err}; }
            if (found(map.get[str, u32](?out.instructions, ?r.instruction)))                           { ret refused(?l, TWICE, r.instruction); }
            if (!inserted(map.insert[str, u32](?out.instructions, r.instruction, out.roles.len::u32))) { ret refused(?l, diag.MEMORY, nil); }
            if (!fits(vector.push[Roles](?out.roles, r)))                                              { ret refused(?l, diag.MEMORY, nil); }
        }
        or {
            var f:  Fact;
            val ok: err[diag.Refusal] = fact_of(a, ?l, ?f);
            if (sel ok.err)                                                              { ret res[Operands, diag.Refusal].err{ok.err}; }
            if (found(map.get[str, u32](?out.rules, ?f.rule)))                           { ret refused(?l, TWICE, f.rule); }
            if (!inserted(map.insert[str, u32](?out.rules, f.rule, out.facts.len::u32))) { ret refused(?l, diag.MEMORY, nil); }
            if (!fits(vector.push[Fact](?out.facts, f)))                                 { ret refused(?l, diag.MEMORY, nil); }
        }
        i = i + 1;
    }
    val held: err[diag.Refusal] = held_roles(a, ?out);
    if (sel held.err) { ret res[Operands, diag.Refusal].err{held.err}; }
    ret res[Operands, diag.Refusal].ok{out};
}

# the role lines held to the rules they name: a rule that states a role is every using instruction's, so no line
# names it, and a rule that states none takes lines that differ, or it states their one role itself
fun held_roles(a: *A.Allocator, o: *Operands) err[diag.Refusal] {
    var first:  vector.Vector[Role] = vector.init[Role](a);
    var varied: vector.Vector[bool] = vector.init[bool](a);
    var f:      usize               = 0;
    for (f < o.facts.len) {
        if (!fits(vector.push[Role](?first, UNSTATED))) { ret err[diag.Refusal].err{topic.refuse(o.facts.data[f].fact, diag.MEMORY, nil)}; }
        if (!fits(vector.push[bool](?varied, false)))   { ret err[diag.Refusal].err{topic.refuse(o.facts.data[f].fact, diag.MEMORY, nil)}; }
        f = f + 1;
    }
    var i: usize = 0;
    for (i < o.roles.len) {
        val r: *Roles = ?o.roles.data[i];
        var k: usize  = 0;
        for (k < r.roles.len) {
            val rule: str       = r.roles.data[k].rule;
            val at:   opt[*u32] = map.get[str, u32](?o.rules, ?rule);
            if (sel at.none) { ret err[diag.Refusal].err{topic.refuse(r.fact, NO_REGISTER, rule)}; }
            val fact: *Fact = ?o.facts.data[@at.some];
            if (fact.use != REGISTER)  { ret err[diag.Refusal].err{topic.refuse(r.fact, NO_REGISTER, rule)}; }
            if (fact.role != UNSTATED) { ret err[diag.Refusal].err{topic.refuse(r.fact, DISAGREED, rule)}; }
            val seen: Role = first.data[@at.some];
            if (seen == UNSTATED)             { first.data[@at.some] = r.roles.data[k].role; }
            or (seen != r.roles.data[k].role) { varied.data[@at.some] = true; }
            k = k + 1;
        }
        i = i + 1;
    }
    f = 0;
    for (f < o.facts.len) {
        if (first.data[f] != UNSTATED && !varied.data[f]) { ret err[diag.Refusal].err{topic.refuse(o.facts.data[f].fact, UNIFORM, o.facts.data[f].rule)}; }
        f = f + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the fact of rule `id`, none when the topic states none
pub fun of(o: *Operands, id: str) opt[*Fact] {
    val at: opt[*u32] = map.get[str, u32](?o.rules, ?id);
    if (sel at.none) { ret opt[*Fact].none{}; }
    ret opt[*Fact].some{?o.facts.data[@at.some]};
}

# the specifier `name`, none when the topic states none
pub fun element(o: *Operands, name: str) opt[*Element] {
    val at: opt[*u32] = map.get[str, u32](?o.specifiers, ?name);
    if (sel at.none) { ret opt[*Element].none{}; }
    ret opt[*Element].some{?o.elements.data[@at.some]};
}

# the role line of `instruction`, none when it has none. a reader takes the first case of a rule whose fields its row
# meets, the cases with fields before the one without, and marks it used
pub fun roles(o: *Operands, instruction: str) opt[*Roles] {
    val at: opt[*u32] = map.get[str, u32](?o.instructions, ?instruction);
    if (sel at.none) { ret opt[*Roles].none{}; }
    ret opt[*Roles].some{?o.roles.data[@at.some]};
}

# the refusal of the first role line no row's operand read, ok when every line was
pub fun unread(o: *Operands) err[diag.Refusal] {
    var i: usize = 0;
    for (i < o.roles.len) {
        val r: *Roles = ?o.roles.data[i];
        var k: usize  = 0;
        for (k < r.roles.len) {
            if (!r.roles.data[k].used) { ret err[diag.Refusal].err{topic.refuse(r.fact, UNREAD, r.roles.data[k].rule)}; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the withheld line of instruction `name`, none when it is not withheld
pub fun withheld(o: *Operands, name: str) opt[*topic.Fact] {
    val at: opt[*u32] = map.get[str, u32](?o.withheld, ?name);
    if (sel at.none) { ret opt[*topic.Fact].none{}; }
    ret opt[*topic.Fact].some{o.reasons.data[@at.some]};
}

# the fields instruction `name`'s ignored line names, whose bits no operand holds, none when it has none
pub fun ignored(o: *Operands, name: str) opt[*vector.Vector[str]] {
    ret map.get[str, vector.Vector[str]](?o.ignored, ?name);
}

# the fields instruction `name`'s fixed line fixes, none when it has none
pub fun fixed(o: *Operands, name: str) opt[*vector.Vector[Fixed]] {
    ret map.get[str, vector.Vector[Fixed]](?o.fixed, ?name);
}

# the bits of fields instruction `name`'s reserved line refuses, none when it has none
pub fun reserved(o: *Operands, name: str) opt[*vector.Vector[Fixed]] {
    ret map.get[str, vector.Vector[Fixed]](?o.reserved, ?name);
}

# the feature instruction `name`'s needs line states, none when it has none
pub fun needs(o: *Operands, name: str) opt[*Need] {
    ret map.get[str, Need](?o.needs, ?name);
}

# the registers instruction `name`'s apart line keeps apart, none when it has none
pub fun apart(o: *Operands, name: str) opt[*vector.Vector[Apart]] {
    ret map.get[str, vector.Vector[Apart]](?o.apart, ?name);
}

# each `<field>=<bits>` of line `l` into `out`
fun fields_of(a: *A.Allocator, l: *topic.Line, out: *vector.Vector[Fixed]) err[diag.Refusal] {
    var k: usize = 0;
    for (k < l.ws.len) {
        val w:   str   = l.ws.data[k];
        val len: usize = str_len(w);
        var eq:  usize = 0;
        for (eq < len && w[eq] != '=') { eq = eq + 1; }
        if (eq == 0 || eq + 1 >= len) { ret reject(l, BAD_MEMBER, w); }
        val field: res[str, StrError] = str_copy_slice(a, w, 0, eq);
        if (sel field.err) { ret reject(l, diag.MEMORY, nil); }
        var bits: str               = nil;
        val read: err[diag.Refusal] = pattern(a, l, ?w[eq + 1], len - eq - 1, ?bits);
        if (sel read.err)                                                       { ret read; }
        if (!fits(vector.push[Fixed](out, Fixed{field: field.ok, bits: bits}))) { ret reject(l, diag.MEMORY, nil); }
        k = k + 1;
    }
    ret err[diag.Refusal].ok{};
}

# each `<rule>=<rule>[,<rule>...]` of line `l` into `out`
fun aparts_of(a: *A.Allocator, l: *topic.Line, out: *vector.Vector[Apart]) err[diag.Refusal] {
    if (l.ws.len == 0) { ret reject(l, BAD_APART, nil); }
    var k: usize = 0;
    for (k < l.ws.len) {
        val w:   str   = l.ws.data[k];
        val len: usize = str_len(w);
        var eq:  usize = 0;
        for (eq < len && w[eq] != '=') { eq = eq + 1; }
        if (eq == 0 || eq + 1 >= len) { ret reject(l, BAD_APART, w); }
        val rule: res[str, StrError] = str_copy_slice(a, w, 0, eq);
        if (sel rule.err) { ret reject(l, diag.MEMORY, nil); }
        var p:     Apart             = Apart{rule: rule.ok, from: vector.init[str](a)};
        val split: err[diag.Refusal] = split(a, l, ?w[eq + 1], ',', ?p.from);
        if (sel split.err)                     { ret split; }
        if (p.from.len == 0)                   { ret reject(l, BAD_APART, w); }
        if (!fits(vector.push[Apart](out, p))) { ret reject(l, diag.MEMORY, nil); }
        k = k + 1;
    }
    ret err[diag.Refusal].ok{};
}
