# the reader of Arm's instruction model, AARCHMRS Instructions.json
#
# the model states every A64 encoding as an instruction under a tree of groups: its name, its 32 bits as fields and
# fixed bits, each a pattern of 0, 1 and x from its high bit, its assembly as literals and references to the
# assembly rules, the fields each operand symbol of its assembly is encoded in, its condition, and the aliases that
# respell it, each with the condition it is preferred under. a rule displays a symbol, as `<Zd>`, and states its
# text by literals, tokens and further rules, or as a choice of such texts. the open release states no rule's
# meaning, so how a symbol's text maps to the bits of its fields is masc's (the operands topic). the reader gives
# the records no meaning, and keeps each condition as the model's expression, which the mapping reads. a group's
# condition holds for every instruction under it, so an instruction carries its groups' conditions with its own.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

use json.lib.json;

use gen.diag;
use gen.document;
use gen.source;

pub val INSTRUCTIONS: str = "Instructions.json";

pub val NO_A64:     str = "instruction model holds no A64 instruction set";
pub val BAD_NODE:   str = "instruction model node is malformed";
pub val BAD_FIELD:  str = "encoding field is malformed or outside the 32 bits";
pub val BAD_BITS:   str = "encoding does not state each of the 32 bits once";
pub val BAD_SYMBOL: str = "assembly symbol is neither a literal nor a rule reference";
pub val NO_RULE:    str = "assembly names a rule the model does not state";
pub val BAD_RULE:   str = "assembly rule is not a rule, a choice or a token";

# the width of every A64 instruction
pub val WIDTH: u32 = 32;

# bits `start` to `start + width - 1` of an encoding, a named field or bits the model names no field for
# ---
# name:    the field's name, nil for unnamed bits
# start:   the lowest bit
# width:   how many bits
# pattern: each bit from the highest, `0`, `1` or `x` for a bit the encoding leaves to its operands
pub rec Bits {
    name:    str;
    start:   u8;
    width:   u8;
    pattern: str;
}

# one symbol of an assembly: literal text, or the rule of its index in the model's rules
pub tag Symbol: u8 {
    literal: str;
    rule:    u32;
}

# the fields an operand symbol is encoded in, from the highest bits
# ---
# display: the symbol, as `<Zd>`
# fields:  the field names, concatenated from the first
pub rec Encoded {
    display: str;
    fields:  vector.Vector[str];
}

# what a rule states
# ---
# RULE:   a text of symbols
# CHOICE: one of several texts
# TOKEN:  a lexical token, as UInteger or COMMA, its text its default
pub def Kind: u8;

pub val RULE:   Kind = 0;
pub val CHOICE: Kind = 1;
pub val TOKEN:  Kind = 2;

# one assembly rule
# ---
# id:        its id, which the model dedups on its full content, so two ids are two meanings
# display:   the symbol it displays, nil for a choice member's own text
# kind:      what it states
# symbols:   its text, for a rule
# choices:   its texts, for a choice
# token:     a token's default text, nil when it has none
# condition: the condition its text holds under, nil for always
pub rec Rule {
    id:        str;
    display:   str;
    kind:      Kind;
    symbols:   vector.Vector[Symbol];
    choices:   vector.Vector[vector.Vector[Symbol]];
    token:     str;
    condition: *json.Value;
}

# an alias of an instruction
# ---
# name:      its name
# operation: the id of its operation, which names its encodings on its page
# symbols:   its assembly
# encoded:   the fields each of its operand symbols is encoded in
# condition: the condition on the instruction's fields and features under which it is an alias at all
# preferred: the condition it is preferred under, nil when it is never preferred
pub rec Alias {
    name:      str;
    operation: str;
    symbols:   vector.Vector[Symbol];
    encoded:   vector.Vector[Encoded];
    condition: *json.Value;
    preferred: *json.Value;
}

# a condition of an instruction or of a group it is under, and the fields it names: the group's own, which a group's
# encoding names apart from the instruction's, as sve_mem_cst_ss's opc over the bits st1b calls 00 and size
# ---
# expr:   the condition
# fields: the named fields of the node that states it
pub rec Condition {
    expr:   *json.Value;
    fields: vector.Vector[Bits];
}

# one encoding of the A64 instruction set
# ---
# name:       its name, which the model gives every encoding uniquely
# group:      the names of the groups it is under from the outermost, joined by `/`
# bits:       its 32 bits, from the highest
# symbols:    its assembly
# encoded:    the fields each of its operand symbols is encoded in
# conditions: its groups' conditions from the outermost and its own last, all of which hold
# aliases:    its aliases, in the model's order
# operation:  the id of the operation it performs
pub rec Instruction {
    name:       str;
    group:      str;
    bits:       vector.Vector[Bits];
    symbols:    vector.Vector[Symbol];
    encoded:    vector.Vector[Encoded];
    conditions: vector.Vector[Condition];
    aliases:    vector.Vector[Alias];
    operation:  str;
}

# the A64 part of the model
# ---
# instructions: every A64 instruction, in the model's order
# rules:        every assembly rule, by index
# ids:          each rule's index by its id
pub rec Model {
    instructions: vector.Vector[Instruction];
    rules:        vector.Vector[Rule];
    ids:          map.Map[str, u32];
}

rec Reader {
    alloc:   *A.Allocator;
    doc:     *document.Document;
    model:   *Model;
    failed:  bool;
    failure: diag.Refusal;
}

fun fail(r: *Reader, message: str, subject: str) {
    if (r.failed) { ret; }
    r.failed  = true;
    r.failure = diag.refusal(r.doc.file.path, 0, message, subject);
}

fun pushed(r: *Reader, got: res[usize, A.Error]) {
    if (sel got.err) { fail(r, diag.MEMORY, nil); }
}

# member `key` of `v`, nil when absent
fun at(v: *json.Value, key: str) *json.Value {
    if (v == nil || v.kind != json.OBJECT) { ret nil; }
    val m: opt[*json.Value] = json.value_find(v, key);
    if (sel m.none) { ret nil; }
    ret m.some;
}

# whether string member `key` of `v` is `text`
fun is(v: *json.Value, key: str, text: str) bool {
    val got: *json.Value = at(v, key);
    if (got == nil || got.kind != json.STRING) { ret false; }
    var i: usize = 0;
    for (i < got.str_len) {
        if (text[i] == 0 || text[i] != got.str_val[i]) { ret false; }
        i = i + 1;
    }
    ret text[i] == 0;
}

# whether `v` is a node of type `t`
pub fun kind(v: *json.Value, t: str) bool {
    ret is(v, "_type", t);
}

# the decoded string member `key` of `v`, nil when it is absent or not a string
fun text(r: *Reader, v: *json.Value, key: str) str {
    val m: *json.Value = at(v, key);
    if (m == nil || m.kind != json.STRING) { ret nil; }
    val got: res[str, diag.Refusal] = document.text(r.alloc, r.doc, m, key);
    if (sel got.err) {
        fail(r, got.err.message, key);
        ret nil;
    }
    ret got.ok;
}

# the string member `key` of `v`, refused when it is absent
fun needed(r: *Reader, v: *json.Value, key: str) str {
    val got: str = text(r, v, key);
    if (got == nil) { fail(r, BAD_NODE, key); }
    ret got;
}

# the items of array member `key` of `v`, nil when it is absent or not an array
fun items(v: *json.Value, key: str) *json.Value {
    val m: *json.Value = at(v, key);
    if (m == nil || m.kind != json.ARRAY) { ret nil; }
    ret m;
}

# a pattern value as the model quotes it, `'01x'`, with its quotes taken off
fun pattern(r: *Reader, v: *json.Value, width: u32) str {
    val quoted: str = text(r, v, "value");
    if (quoted == nil) {
        fail(r, BAD_FIELD, nil);
        ret nil;
    }
    val len: usize = str_len(quoted);
    if (len != width::usize + 2 || quoted[0] != '\'' || quoted[len - 1] != '\'') {
        fail(r, BAD_FIELD, quoted);
        ret nil;
    }
    var i: usize = 1;
    for (i + 1 < len) {
        val c: u8 = quoted[i];
        if (c != '0' && c != '1' && c != 'x') {
            fail(r, BAD_FIELD, quoted);
            ret nil;
        }
        quoted[i - 1] = c;
        i             = i + 1;
    }
    quoted[len - 2] = 0;
    ret quoted;
}

# the encoding of instruction node `n`, each of its 32 bits stated once
fun encoding(r: *Reader, n: *json.Value, out: *vector.Vector[Bits]) {
    val values: *json.Value = items(at(n, "encoding"), "values");
    if (values == nil) {
        fail(r, BAD_NODE, "encoding");
        ret;
    }
    var seen: u64   = 0;
    var i:    usize = 0;
    for (i < values.count && !r.failed) {
        val v:     *json.Value = document.item(values, i);
        val range: *json.Value = at(v, "range");
        val s:     *json.Value = at(range, "start");
        val w:     *json.Value = at(range, "width");
        if (s == nil || w == nil || s.kind != json.NUMBER || w.kind != json.NUMBER) {
            fail(r, BAD_FIELD, nil);
            ret;
        }
        val start: i64 = json.value_number(s);
        val width: i64 = json.value_number(w);
        if (start < 0 || width < 1 || start + width > WIDTH::i64) {
            fail(r, BAD_FIELD, nil);
            ret;
        }
        val bits: u64 = ((1::u64 << width:~u64) - 1) << start:~u64;
        if ((seen & bits) != 0) {
            fail(r, BAD_BITS, nil);
            ret;
        }
        seen = seen | bits;
        var name: str = nil;
        if (kind(v, "Instruction.Encodeset.Field")) { name = needed(r, v, "name"); }
        val p: str = pattern(r, at(v, "value"), width::u32);
        pushed(r, vector.push[Bits](out, Bits{name: name, start: start::u8, width: width::u8, pattern: p}));
        i = i + 1;
    }
    if (!r.failed && seen != 0xFFFF_FFFF) { fail(r, BAD_BITS, nil); }
}

# the named fields of group node `n`'s encoding, which need not cover every bit
fun named(r: *Reader, n: *json.Value, out: *vector.Vector[Bits]) {
    val values: *json.Value = items(at(n, "encoding"), "values");
    if (values == nil) { ret; }
    var i: usize = 0;
    for (i < values.count && !r.failed) {
        val v:     *json.Value = document.item(values, i);
        val range: *json.Value = at(v, "range");
        val s:     *json.Value = at(range, "start");
        val w:     *json.Value = at(range, "width");
        if (s == nil || w == nil || s.kind != json.NUMBER || w.kind != json.NUMBER) {
            fail(r, BAD_FIELD, nil);
            ret;
        }
        val start: i64 = json.value_number(s);
        val width: i64 = json.value_number(w);
        if (start < 0 || width < 1 || start + width > WIDTH::i64) {
            fail(r, BAD_FIELD, nil);
            ret;
        }
        if (kind(v, "Instruction.Encodeset.Field")) {
            val p: str = pattern(r, at(v, "value"), width::u32);
            pushed(r, vector.push[Bits](out, Bits{name: needed(r, v, "name"), start: start::u8, width: width::u8, pattern: p}));
        }
        i = i + 1;
    }
}

# the symbols of assembly node `a`, none for the empty text, which the model states as null
fun symbols(r: *Reader, a: *json.Value, out: *vector.Vector[Symbol]) {
    if (a == nil || a.kind == json.NULL) { ret; }
    val held: *json.Value = at(a, "symbols");
    if (held != nil && held.kind == json.NULL) { ret; }
    val list: *json.Value = items(a, "symbols");
    if (list == nil) {
        fail(r, BAD_NODE, "symbols");
        ret;
    }
    var i: usize = 0;
    for (i < list.count && !r.failed) {
        val s: *json.Value = document.item(list, i);
        if (kind(s, "Instruction.Symbols.Literal")) { pushed(r, vector.push[Symbol](out, Symbol.literal{needed(r, s, "value")})); }
        or (kind(s, "Instruction.Symbols.RuleReference")) {
            val id:    str       = needed(r, s, "rule_id");
            val found: opt[*u32] = map.get[str, u32](?r.model.ids, ?id);
            if (sel found.some) { pushed(r, vector.push[Symbol](out, Symbol.rule{@found.some})); }
            or                  { fail(r, NO_RULE, id); }
        }
        or { fail(r, BAD_SYMBOL, nil); }
        i = i + 1;
    }
}

# the fields each operand symbol of node `n` is encoded in
fun encoded(r: *Reader, n: *json.Value, out: *vector.Vector[Encoded]) {
    val e: *json.Value = at(at(n, "_meta"), "encoded_in");
    if (e == nil) { ret; }
    if (e.kind != json.OBJECT) {
        fail(r, BAD_NODE, "encoded_in");
        ret;
    }
    var i: usize = 0;
    for (i < e.count && !r.failed) {
        val dup: res[*u8, A.Error] = A.allocate[u8](r.alloc, json.value_key_len(e, i) + 1);
        if (sel dup.err) {
            fail(r, diag.MEMORY, nil);
            ret;
        }
        var k: usize = 0;
        for (k < json.value_key_len(e, i)) {
            dup.ok[k] = e.keys[i][k];
            k         = k + 1;
        }
        dup.ok[k] = 0;
        var fields: vector.Vector[str] = vector.init[str](r.alloc);
        val list:   *json.Value        = document.item(e, i);
        if (list.kind != json.ARRAY) {
            fail(r, BAD_NODE, dup.ok);
            ret;
        }
        k = 0;
        for (k < list.count) {
            val f: *json.Value = document.item(list, k);
            if (!kind(f, "AST.Identifier")) {
                fail(r, BAD_NODE, dup.ok);
                ret;
            }
            pushed(r, vector.push[str](?fields, needed(r, f, "value")));
            k = k + 1;
        }
        pushed(r, vector.push[Encoded](out, Encoded{display: dup.ok, fields: fields}));
        i = i + 1;
    }
}

fun alias(r: *Reader, n: *json.Value, out: *vector.Vector[Alias]) {
    var a: Alias = Alias{name: needed(r, n, "name"), operation: text(r, n, "operation_id"), symbols: vector.init[Symbol](r.alloc), encoded: vector.init[Encoded](r.alloc), condition: at(n, "condition"), preferred: at(n, "preferred")};
    symbols(r, at(n, "assembly"), ?a.symbols);
    encoded(r, n, ?a.encoded);
    pushed(r, vector.push[Alias](out, a));
}

fun instruction(r: *Reader, n: *json.Value, group: str, conditions: *vector.Vector[Condition]) {
    var ins: Instruction = Instruction{
        name:       needed(r, n, "name"),
        group:      group,
        bits:       vector.init[Bits](r.alloc),
        symbols:    vector.init[Symbol](r.alloc),
        encoded:    vector.init[Encoded](r.alloc),
        conditions: vector.init[Condition](r.alloc),
        aliases:    vector.init[Alias](r.alloc),
        operation:  text(r, n, "operation_id"),
    };
    var i: usize = 0;
    for (i < conditions.len) {
        pushed(r, vector.push[Condition](?ins.conditions, conditions.data[i]));
        i = i + 1;
    }
    encoding(r, n, ?ins.bits);
    val own: *json.Value = at(n, "condition");
    if (own != nil) { pushed(r, vector.push[Condition](?ins.conditions, Condition{expr: own, fields: ins.bits})); }
    symbols(r, at(n, "assembly"), ?ins.symbols);
    encoded(r, n, ?ins.encoded);
    val children: *json.Value = items(n, "children");
    if (children != nil) {
        i = 0;
        for (i < children.count && !r.failed) {
            val c: *json.Value = document.item(children, i);
            if (kind(c, "Instruction.InstructionAlias")) { alias(r, c, ?ins.aliases); }
            or                                           { fail(r, BAD_NODE, ins.name); }
            i = i + 1;
        }
    }
    pushed(r, vector.push[Instruction](?r.model.instructions, ins));
}

# the instructions under group node `n`, at path `group`, under `conditions`
fun group_of(r: *Reader, n: *json.Value, group: str, conditions: *vector.Vector[Condition]) {
    val children: *json.Value = items(n, "children");
    if (children == nil) { ret; }
    var i: usize = 0;
    for (i < children.count && !r.failed) {
        val c: *json.Value = document.item(children, i);
        if (kind(c, "Instruction.Instruction")) { instruction(r, c, group, conditions); }
        or (kind(c, "Instruction.InstructionGroup")) {
            val name: str = needed(r, c, "name");
            var path: str = name;
            if (group != nil && group[0] != 0) {
                val joined: res[str, StrError] = str_join(r.alloc, group, "/", name);
                if (sel joined.err) {
                    fail(r, diag.MEMORY, nil);
                    ret;
                }
                path = joined.ok;
            }
            val held: usize       = conditions.len;
            val cond: *json.Value = at(c, "condition");
            if (cond != nil) {
                var fields: vector.Vector[Bits] = vector.init[Bits](r.alloc);
                named(r, c, ?fields);
                pushed(r, vector.push[Condition](conditions, Condition{expr: cond, fields: fields}));
            }
            group_of(r, c, path, conditions);
            conditions.len = held;
        }
        or { fail(r, BAD_NODE, group); }
        i = i + 1;
    }
}

# every assembly rule of `rules`, named first so a rule may reference one stated after it
fun rules(r: *Reader, all: *json.Value) {
    if (all == nil || all.kind != json.OBJECT) {
        fail(r, BAD_NODE, "assembly_rules");
        ret;
    }
    var i: usize = 0;
    for (i < all.count && !r.failed) {
        val len: usize             = json.value_key_len(all, i);
        val dup: res[*u8, A.Error] = A.allocate[u8](r.alloc, len + 1);
        if (sel dup.err) {
            fail(r, diag.MEMORY, nil);
            ret;
        }
        var k: usize = 0;
        for (k < len) {
            dup.ok[k] = all.keys[i][k];
            k         = k + 1;
        }
        dup.ok[k] = 0;
        val inserted: res[bool, A.Error] = map.insert[str, u32](?r.model.ids, dup.ok, i::u32);
        if (sel inserted.err) {
            fail(r, diag.MEMORY, nil);
            ret;
        }
        pushed(r, vector.push[Rule](?r.model.rules, Rule{id: dup.ok, display: nil, kind: RULE, symbols: vector.init[Symbol](r.alloc), choices: vector.init[vector.Vector[Symbol]](r.alloc), token: nil, condition: nil}));
        i = i + 1;
    }
    i = 0;
    for (i < all.count && !r.failed) {
        val v:    *json.Value = document.item(all, i);
        val rule: *Rule       = ?r.model.rules.data[i];
        rule.display   = text(r, v, "display");
        rule.condition = at(v, "condition");
        if (kind(v, "Instruction.Rules.Rule")) { symbols(r, at(v, "symbols"), ?rule.symbols); }
        or (kind(v, "Instruction.Rules.Choice")) {
            rule.kind = CHOICE;
            val choices: *json.Value = items(v, "choices");
            if (choices == nil) { fail(r, BAD_RULE, rule.id); }
            var k: usize = 0;
            for (choices != nil && k < choices.count && !r.failed) {
                var one: vector.Vector[Symbol] = vector.init[Symbol](r.alloc);
                symbols(r, document.item(choices, k), ?one);
                pushed(r, vector.push[vector.Vector[Symbol]](?rule.choices, one));
                k = k + 1;
            }
        }
        or (kind(v, "Instruction.Rules.Token")) {
            rule.kind  = TOKEN;
            rule.token = text(r, v, "default");
        }
        or { fail(r, BAD_RULE, rule.id); }
        i = i + 1;
    }
}

# the A64 instructions and the assembly rules of Instructions.json
# ---
# a:   allocator for the model, which outlives every reader of it
# f:   the Instructions.json file
# ret: the model, or the refusal of the file
pub fun read(a: *A.Allocator, f: *source.File) res[Model, diag.Refusal] {
    val parsed: res[document.Document, diag.Refusal] = document.read(a, f);
    if (sel parsed.err) { ret res[Model, diag.Refusal].err{parsed.err}; }
    var doc: document.Document = parsed.ok;
    var m:   Model             = Model{instructions: vector.init[Instruction](a), rules: vector.init[Rule](a), ids: map.init[str, u32](a)};
    var r:   Reader            = Reader{alloc: a, doc: ?doc, model: ?m, failed: false, failure: diag.refusal(nil, 0, nil, nil)};
    rules(?r, at(?doc.root, "assembly_rules"));
    val sets: *json.Value = items(?doc.root, "instructions");
    if (sets == nil) { fail(?r, BAD_NODE, "instructions"); }
    var found: bool  = false;
    var i:     usize = 0;
    for (sets != nil && i < sets.count && !r.failed) {
        val s: *json.Value = document.item(sets, i);
        if (kind(s, "Instruction.InstructionSet") && is(s, "name", "A64")) {
            found = true;
            var conditions: vector.Vector[Condition] = vector.init[Condition](a);
            val cond:       *json.Value              = at(s, "condition");
            if (cond != nil) {
                var fields: vector.Vector[Bits] = vector.init[Bits](a);
                named(?r, s, ?fields);
                pushed(?r, vector.push[Condition](?conditions, Condition{expr: cond, fields: fields}));
            }
            group_of(?r, s, "", ?conditions);
        }
        i = i + 1;
    }
    if (!r.failed && !found) { fail(?r, NO_A64, nil); }
    if (r.failed)            { ret res[Model, diag.Refusal].err{r.failure}; }
    ret res[Model, diag.Refusal].ok{m};
}

# the rule `id` names, none when the model states none
pub fun rule(m: *Model, id: str) opt[*Rule] {
    val found: opt[*u32] = map.get[str, u32](?m.ids, ?id);
    if (sel found.none) { ret opt[*Rule].none{}; }
    ret opt[*Rule].some{?m.rules.data[@found.some]};
}
