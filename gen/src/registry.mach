val ROWS: [8]*source.Source = [8]*source.Source{?RISCV_OPCODES, ?AARCH64_REGISTERS, ?AARCHMRS, ?LLVM_AARCH64, ?X86_REGISTERS, ?RISCV_EXTENSIONS, ?RISCV_OVERLAY, ?X86_EXTENSIONS};

# every generator source
pub val SOURCES: source.Sources = source.Sources{at: ?ROWS[0], len: 8};

val RISCV_INPUTS: [2]*source.Source = [2]*source.Source{?RISCV_EXTENSIONS, ?RISCV_OVERLAY};

val RISCV: set.Generator = set.Generator{name: "riscv", set: "riscv", source: ?RISCV_OPCODES, inputs: source.Refs{at: ?RISCV_INPUTS[0], len: 2}, generate: riscv.generate};

val AARCH64: set.Generator = set.Generator{name: "aarch64", set: "aarch64", source: ?AARCH64_REGISTERS, inputs: source.NO_REFS, generate: aarch64.generate};

val NAMES: [1]*source.Source = [1]*source.Source{?LLVM_AARCH64};

val AARCH64_EXTENSION: set.Generator = set.Generator{name: "aarch64", set: "aarch64", source: ?AARCHMRS, inputs: source.Refs{at: ?NAMES[0], len: 1}, generate: aarch64_extension.generate};

val X86_CATALOG: [1]*source.Source = [1]*source.Source{?X86_EXTENSIONS};

val X86: set.Generator = set.Generator{name: "x86", set: "x86", source: ?X86_REGISTERS, inputs: source.Refs{at: ?X86_CATALOG[0], len: 1}, generate: x86.generate};

val RISCV_EXTENSION: set.Generator = set.Generator{name: "riscv", set: "riscv", source: ?RISCV_EXTENSIONS, inputs: source.NO_REFS, generate: catalog.generate};

val X86_EXTENSION: set.Generator = set.Generator{name: "x86", set: "x86", source: ?X86_EXTENSIONS, inputs: source.NO_REFS, generate: catalog.generate};

val ALL: [6]*set.Generator = [6]*set.Generator{?RISCV, ?RISCV_EXTENSION, ?AARCH64, ?AARCH64_EXTENSION, ?X86, ?X86_EXTENSION};

# every registered generator
pub val GENERATORS: set.Generators = set.Generators{at: ?ALL[0], len: 6};
