# the source table and the registered generators
#
# every source a generator reads is one row of the source table, with its
# upstream, its exact revision, its licence and its checksum, and its
# attribution in masc's NOTICE. every set's generator is one row of the
# generators. adding a set's generator is a row in each and its module.

use gen.aarch64;
use gen.riscv;
use gen.set;
use gen.source;

val ROWS: [4]source.Source = [4]source.Source{
    source.Source{
        name:     "riscv-opcodes",
        upstream: "https://github.com/riscv/riscv-opcodes",
        revision: "5783cf3bea312a48d28e3e2c8a2fcb55603e4bed",
        licence:  "BSD-3-Clause",
        notice:   "LICENSE",
        path:     "vendor/riscv-opcodes",
        checksum: "008462c10a81d209a1b8ffbe148450e7e8809f53d879bf7833a93b0b309755c4",
    },
    source.Source{
        name:     "aarch64-registers",
        upstream: nil,
        revision: "aadwarf64 bd017eeca341c06915b9a02ae111b480416d248f, llvm CodeViewRegisters.def 7ddb67460b168b17ebb263dc99bf956b56d7e517, sail-arm 1bf2e5574ba9d704639a28401b6a387dcb113cae",
        licence:  "MIT",
        notice:   "LICENSE",
        path:     "vendor/aarch64-registers",
        checksum: "b9c6add7fa776aa0c254db76a484ec0f5a4d4eb69edc2cbd78eb0b19edf3a738",
    },
    source.Source{
        name:     "aarchmrs",
        upstream: "https://developer.arm.com/-/cdn-downloads/permalink/Exploration-Tools-OS-Machine-Readable-Data/AARCHMRS_BSD/AARCHMRS_OPENSOURCE_A_profile_FAT-2026-09.tar.gz",
        revision: "2026-09_rel (AARCHMRS_OPENSOURCE_A_profile_FAT-2026-09.tar.gz, sha256 d5bf3f538663fb18be081ba8e9f08b188ed06f81dd19d4aa2da5b2795103a4ec)",
        licence:  "BSD-3-Clause",
        notice:   "LICENSE",
        path:     "vendor/aarchmrs",
        checksum: "5df3b5c5b2a65494768a64d9cfe0cd8d21072191e2d7307b310b376db53b39ab",
    },
    source.Source{
        name:     "llvm-aarch64",
        upstream: "https://github.com/llvm/llvm-project/blob/7ddb67460b168b17ebb263dc99bf956b56d7e517/llvm/lib/Target/AArch64/AArch64Features.td",
        revision: "7ddb67460b168b17ebb263dc99bf956b56d7e517",
        licence:  "Apache-2.0 WITH LLVM-exception",
        notice:   "LICENSE.TXT",
        path:     "vendor/llvm-aarch64",
        checksum: "2bf10673bc27220f1d431338208ef8610b7c9d8b8b6f07108cd8c679a26249f1",
    },
};

# every generator source
pub val SOURCES: source.Sources = source.Sources{at: ?ROWS[0], len: 4};

val RISCV: set.Generator = set.Generator{name: "riscv", set: "riscv", source: ?ROWS[0], inputs: source.NO_REFS, generate: riscv.generate};

val AARCH64: set.Generator = set.Generator{name: "aarch64", set: "aarch64", source: ?ROWS[1], inputs: source.NO_REFS, generate: aarch64.generate};

val ALL: [2]*set.Generator = [2]*set.Generator{?RISCV, ?AARCH64};

# every registered generator
pub val GENERATORS: set.Generators = set.Generators{at: ?ALL[0], len: 2};
