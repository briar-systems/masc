    name:     "x86-extensions",
    upstream: nil,
    revision: "Intel SDM 325462-093US, Intel ISE 319433-062, Intel AVX10.2 361050-005US, Intel APX 355828-009US, x86-64 psABI e1ce098331da5dbd66e1ffc74162380bcc213236, AMD APM 24594 3.28, XED 0bcb6237345c5066726dcc08b3d87928df3b5b26, llvm-project bd58c858ea9b5a41716cd8e09935904cf2470d7b",
    licence:  "MIT",
    notice:   "LICENSE",
    path:     "data/x86/extensions",
    checksum: "5a3523e8765040620e75e36adb7d74aef7062224a864df6a9902aaacd46cc3d9",
