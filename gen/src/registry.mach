val ROWS: [18]*source.Source = [18]*source.Source{?RISCV_OPCODES, ?AARCH64_REGISTERS, ?AARCHMRS, ?AARCH64_OVERLAY, ?LLVM_AARCH64, ?X86_REGISTERS, ?RISCV_EXTENSIONS, ?RISCV_OVERLAY, ?X86_EXTENSIONS, ?XED, ?X86_OVERLAY, ?LLVM_CPUID, ?WABT, ?WASM_SPEC, ?WASM_OVERLAY, ?WASM_FEATURES, ?SPIRV_HEADERS, ?SPIRV_OVERLAY};

# every generator source
pub val SOURCES: source.Sources = source.Sources{at: ?ROWS[0], len: 18};

val CITED_ROWS: [1]*source.Cited = [1]*source.Cited{?A64_ISA_XML};

# every release an overlay cites that gen does not hold
pub val CITED: source.Citeds = source.Citeds{at: ?CITED_ROWS[0], len: 1};

val RISCV_INPUTS: [2]*source.Source = [2]*source.Source{?RISCV_EXTENSIONS, ?RISCV_OVERLAY};

val RISCV: set.Generator = set.Generator{name: "riscv", set: "riscv", source: ?RISCV_OPCODES, inputs: source.Refs{at: ?RISCV_INPUTS[0], len: 2}, generate: riscv.generate};

val SYSTEM: [1]*source.Source = [1]*source.Source{?AARCHMRS};

val AARCH64: set.Generator = set.Generator{name: "aarch64", set: "aarch64", source: ?AARCH64_REGISTERS, inputs: source.Refs{at: ?SYSTEM[0], len: 1}, generate: aarch64.generate};

val NAMES: [2]*source.Source = [2]*source.Source{?LLVM_AARCH64, ?AARCH64_OVERLAY};

val AARCH64_EXTENSION: set.Generator = set.Generator{name: "aarch64", set: "aarch64", source: ?AARCHMRS, inputs: source.Refs{at: ?NAMES[0], len: 2}, generate: aarch64_extension.generate};

val ROW_INPUTS: [2]*source.Source = [2]*source.Source{?AARCH64_OVERLAY, ?AARCH64_REGISTERS};

val AARCH64_ROWS: set.Generator = set.Generator{name: "aarch64", set: "aarch64", source: ?AARCHMRS, inputs: source.Refs{at: ?ROW_INPUTS[0], len: 2}, generate: aarch64_rows.generate};

val X86_CATALOG: [1]*source.Source = [1]*source.Source{?X86_EXTENSIONS};

val X86: set.Generator = set.Generator{name: "x86", set: "x86", source: ?X86_REGISTERS, inputs: source.Refs{at: ?X86_CATALOG[0], len: 1}, generate: x86.generate};

val RISCV_EXTENSION: set.Generator = set.Generator{name: "riscv", set: "riscv", source: ?RISCV_EXTENSIONS, inputs: source.NO_REFS, generate: catalog.generate};

val X86_EXTENSION: set.Generator = set.Generator{name: "x86", set: "x86", source: ?X86_EXTENSIONS, inputs: source.NO_REFS, generate: catalog.generate};

val XED_INPUTS: [4]*source.Source = [4]*source.Source{?X86_EXTENSIONS, ?X86_OVERLAY, ?LLVM_CPUID, ?X86_REGISTERS};

val X86_ISA_SET: set.Generator = set.Generator{name: "xed", set: "x86", source: ?XED, inputs: source.Refs{at: ?XED_INPUTS[0], len: 4}, generate: isa_set.generate};

val WASM_INPUTS: [3]*source.Source = [3]*source.Source{?WASM_SPEC, ?WASM_OVERLAY, ?WASM_FEATURES};

val WASM: set.Generator = set.Generator{name: "wasm", set: "wasm", source: ?WABT, inputs: source.Refs{at: ?WASM_INPUTS[0], len: 3}, generate: wasm.generate};

val WASM_EXTENSION: set.Generator = set.Generator{name: "wasm", set: "wasm", source: ?WASM_FEATURES, inputs: source.NO_REFS, generate: catalog.generate};

val SPIRV_INPUTS: [1]*source.Source = [1]*source.Source{?SPIRV_OVERLAY};

val SPIRV: set.Generator = set.Generator{name: "spirv", set: "spirv", source: ?SPIRV_HEADERS, inputs: source.Refs{at: ?SPIRV_INPUTS[0], len: 1}, generate: spirv.generate};

val ALL: [11]*set.Generator = [11]*set.Generator{?RISCV, ?RISCV_EXTENSION, ?AARCH64, ?AARCH64_EXTENSION, ?AARCH64_ROWS, ?X86, ?X86_EXTENSION, ?X86_ISA_SET, ?WASM, ?WASM_EXTENSION, ?SPIRV};

# every registered generator
pub val GENERATORS: set.Generators = set.Generators{at: ?ALL[0], len: 11};
