# every generator source
pub val SOURCES: source.Sources = source.Sources{at: ?ROWS[0], len: 7};

val RISCV: set.Generator = set.Generator{name: "riscv", set: "riscv", source: ?ROWS[0], inputs: source.NO_REFS, generate: riscv.generate};

val AARCH64: set.Generator = set.Generator{name: "aarch64", set: "aarch64", source: ?ROWS[1], inputs: source.NO_REFS, generate: aarch64.generate};

val NAMES: [1]*source.Source = [1]*source.Source{?ROWS[3]};

val AARCH64_EXTENSION: set.Generator = set.Generator{name: "aarch64", set: "aarch64", source: ?ROWS[2], inputs: source.Refs{at: ?NAMES[0], len: 1}, generate: aarch64_extension.generate};

val X86_CATALOG: [1]*source.Source = [1]*source.Source{?ROWS[6]};

val X86: set.Generator = set.Generator{name: "x86", set: "x86", source: ?ROWS[4], inputs: source.Refs{at: ?X86_CATALOG[0], len: 1}, generate: x86.generate};

val RISCV_EXTENSION: set.Generator = set.Generator{name: "riscv", set: "riscv", source: ?ROWS[5], inputs: source.NO_REFS, generate: catalog.generate};

val X86_EXTENSION: set.Generator = set.Generator{name: "x86", set: "x86", source: ?ROWS[6], inputs: source.NO_REFS, generate: catalog.generate};

val ALL: [6]*set.Generator = [6]*set.Generator{?RISCV, ?RISCV_EXTENSION, ?AARCH64, ?AARCH64_EXTENSION, ?X86, ?X86_EXTENSION};

# every registered generator
pub val GENERATORS: set.Generators = set.Generators{at: ?ALL[0], len: 6};
