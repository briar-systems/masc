# the decode dispatch generated from a set's rows
#
# a set describes each decodable row by the bits that identify it, as one or
# more cubes over its match space: words of fixed bits under a mask. the
# space holds the instruction's bits and whatever else tells rows apart, such
# as a decode mode or an operand-size context, and a row whose bits are a
# union, such as an x86 form for every mod but 3, is several cubes. the set
# names its dispatch keys over the same space, in the order it prefers them,
# each the generator-side reading of the runtime key of the same position.
#
# each node reads the first key every row reaching it fixes that tells them
# apart, so a key is never read where some row leaves it open. what no key
# tells apart is a leaf, and its rows must be ordered: two rows that can
# match the same bits are admitted only when one is strictly more specific,
# which is tried first. anything else is ambiguous and refused, naming both.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_join;

use A: std.allocator;
use std.allocator.testing;
use std.collections.sort;
use std.collections.vector;

use core_dispatch: masc.core.dispatch;

use gen.diag;
use gen.emit;

# a generator-side dispatch key: bits `lo` to `lo + len - 1` of word `word` of the match space
pub rec Key {
    name: str;
    word: u32;
    lo:   u8;
    len:  u8;
}

# a set's match space: how many words it is and the keys over it, in preference order
pub rec Space {
    words:     u32;
    keys:      *Key;
    key_count: u32;
}

# bits fixed under a mask, each `words` long
pub rec Cube {
    value: *u64;
    mask:  *u64;
}

# what identifies one decodable row
# ---
# row:   the row's index in the set's rows
# name:  what the row is called, for a refusal
# cubes: the cubes its bits are the union of
# count: how many cubes it has
pub rec Pattern {
    row:   u32;
    name:  str;
    cubes: *Cube;
    count: u32;
}

# a built dispatch in the shape of `masc.core.dispatch.Dispatch`, its root at node 0
pub rec Built {
    nodes:      vector.Vector[core_dispatch.Node];
    entries:    vector.Vector[core_dispatch.Entry];
    candidates: vector.Vector[u32];
}

pub val AMBIGUOUS: str = "rows match the same bits and neither is more specific";
pub val NO_KEY:    str = "no key is fixed by every row";
pub val NO_ROWS:   str = "dispatch over no rows";

# one cube of one row reaching a node
rec Item {
    pattern: *Pattern;
    cube:    *Cube;
}

rec Builder {
    alloc: *A.Allocator;
    space: *Space;
    out:   *Built;
}

# whether a push was given its storage
fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun ones(len: u8) u64 {
    if (len >= 64) { ret ~0::u64; }
    ret (1::u64 << len::u64) - 1;
}

fun fixes(k: *Key, c: *Cube) bool {
    ret ((c.mask[k.word] >> k.lo::u64) & ones(k.len)) == ones(k.len);
}

fun read(k: *Key, c: *Cube) u64 {
    ret (c.value[k.word] >> k.lo::u64) & ones(k.len);
}

fun memory() diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, nil);
}

# the refusal of rows `x` and `y` as ambiguous
fun ambiguous(b: *Builder, x: *Pattern, y: *Pattern) err[diag.Refusal] {
    val both: res[str, StrError] = str_join(b.alloc, x.name, " and ", y.name);
    if (sel both.err) { ret err[diag.Refusal].err{memory()}; }
    ret err[diag.Refusal].err{diag.refusal(nil, 0, AMBIGUOUS, both.ok)};
}

# whether some bits match both cubes
fun overlaps(b: *Builder, x: *Cube, y: *Cube) bool {
    var w: u32 = 0;
    for (w < b.space.words) {
        if (((x.value[w] ^ y.value[w]) & x.mask[w] & y.mask[w]) != 0) { ret false; }
        w = w + 1;
    }
    ret true;
}

# whether every bits matching `x` match `y`
fun within(b: *Builder, x: *Cube, y: *Cube) bool {
    var w: u32 = 0;
    for (w < b.space.words) {
        if ((y.mask[w] & ~x.mask[w]) != 0 || ((x.value[w] ^ y.value[w]) & y.mask[w]) != 0) { ret false; }
        w = w + 1;
    }
    ret true;
}

# the first key every item fixes, one that tells them apart when `split`
fun choose(b: *Builder, items: *vector.Vector[Item], split: bool) opt[u32] {
    var k: u32 = 0;
    for (k < b.space.key_count) {
        val key:   *Key  = ?b.space.keys[k];
        var fixed: bool  = true;
        var apart: bool  = false;
        var i:     usize = 0;
        for (i < items.len && fixed) {
            if (!fixes(key, items.data[i].cube))                                { fixed = false; }
            or (read(key, items.data[i].cube) != read(key, items.data[0].cube)) { apart = true; }
            i = i + 1;
        }
        if (fixed && (apart || !split)) { ret opt[u32].some{k}; }
        k = k + 1;
    }
    ret opt[u32].none{};
}

# whether the items are of more than one row
fun several(items: *vector.Vector[Item]) bool {
    var i: usize = 1;
    for (i < items.len) {
        if (items.data[i].pattern.row != items.data[0].pattern.row) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun by_row(x: *Item, y: *Item) i64 {
    if (x.pattern.row < y.pattern.row) { ret -1; }
    if (x.pattern.row > y.pattern.row) { ret 1; }
    ret 0;
}

# the leaf's rows ordered most specific first, or the refusal of two it cannot order
fun leaf(b: *Builder, items: *vector.Vector[Item], entry: usize) err[diag.Refusal] {
    sort.sort_by[Item](items.data, items.len, by_row);
    var rows: vector.Vector[*Pattern] = vector.init[*Pattern](b.alloc);
    var i:    usize                   = 0;
    for (i < items.len) {
        if (i == 0 || items.data[i].pattern.row != items.data[i - 1].pattern.row) {
            if (!pushed(vector.push[*Pattern](?rows, items.data[i].pattern))) { ret err[diag.Refusal].err{memory()}; }
        }
        i = i + 1;
    }
    val n: usize = rows.len;
    # before[x * n + y]: row x must be tried before row y
    val got: res[*bool, A.Error] = A.zallocate[bool](b.alloc, n * n + 1);
    if (sel got.err) { ret err[diag.Refusal].err{memory()}; }
    val before: *bool = got.ok;
    var x:      usize = 0;
    for (x < items.len) {
        var y: usize = x + 1;
        for (y < items.len) {
            val p: *Item = ?items.data[x];
            val q: *Item = ?items.data[y];
            if (p.pattern.row != q.pattern.row && overlaps(b, p.cube, q.cube)) {
                val p_in: bool = within(b, p.cube, q.cube);
                val q_in: bool = within(b, q.cube, p.cube);
                if (p_in == q_in) { ret ambiguous(b, p.pattern, q.pattern); }
                var pi: usize = 0;
                var qi: usize = 0;
                var r:  usize = 0;
                for (r < n) {
                    if (rows.data[r] == p.pattern) { pi = r; }
                    if (rows.data[r] == q.pattern) { qi = r; }
                    r = r + 1;
                }
                if (p_in) { before[pi * n + qi] = true; }
                or        { before[qi * n + pi] = true; }
            }
            y = y + 1;
        }
        x = x + 1;
    }
    b.out.entries.data[entry].first = b.out.candidates.len::u32;
    b.out.entries.data[entry].count = n::u32;
    val placed: res[*bool, A.Error] = A.zallocate[bool](b.alloc, n + 1);
    if (sel placed.err) { ret err[diag.Refusal].err{memory()}; }
    var done: usize = 0;
    for (done < n) {
        var pick: opt[usize] = opt[usize].none{};
        var c:    usize      = 0;
        for (c < n && sel pick.none) {
            if (!placed.ok[c]) {
                var free: bool  = true;
                var d:    usize = 0;
                for (d < n) {
                    if (!placed.ok[d] && before[d * n + c]) { free = false; }
                    d = d + 1;
                }
                if (free) { pick = opt[usize].some{c}; }
            }
            c = c + 1;
        }
        if (sel pick.none) { ret ambiguous(b, rows.data[0], rows.data[n - 1]); }
        placed.ok[pick.some] = true;
        if (!pushed(vector.push[u32](?b.out.candidates, rows.data[pick.some].row))) { ret err[diag.Refusal].err{memory()}; }
        done = done + 1;
    }
    ret err[diag.Refusal].ok{};
}

# node `at` built over `items`, reading `key`
fun node(b: *Builder, at: usize, key: u32, items: *vector.Vector[Item]) err[diag.Refusal] {
    val k: *Key = ?b.space.keys[key];
    # items grouped by the key's value, in value order
    var values: vector.Vector[u64] = vector.init[u64](b.alloc);
    var i:      usize              = 0;
    for (i < items.len) {
        if (!pushed(vector.push[u64](?values, read(k, items.data[i].cube)))) { ret err[diag.Refusal].err{memory()}; }
        i = i + 1;
    }
    sort.sort[u64](values.data, values.len);
    val first: usize = b.out.entries.len;
    i = 0;
    for (i < values.len) {
        if (i == 0 || values.data[i] != values.data[i - 1]) {
            if (!pushed(vector.push[core_dispatch.Entry](?b.out.entries, core_dispatch.Entry{value: values.data[i], node: 0, first: 0, count: 0}))) { ret err[diag.Refusal].err{memory()}; }
        }
        i = i + 1;
    }
    b.out.nodes.data[at] = core_dispatch.Node{key: key::u16, first: first::u32, count: (b.out.entries.len - first)::u32};
    var e: usize = first;
    for (e < first + b.out.nodes.data[at].count::usize) {
        val value: u64                 = b.out.entries.data[e].value;
        var group: vector.Vector[Item] = vector.init[Item](b.alloc);
        var j:     usize               = 0;
        for (j < items.len) {
            if (read(k, items.data[j].cube) == value) {
                if (!pushed(vector.push[Item](?group, items.data[j]))) { ret err[diag.Refusal].err{memory()}; }
            }
            j = j + 1;
        }
        var next: opt[u32] = opt[u32].none{};
        if (several(?group)) { next = choose(b, ?group, true); }
        if (sel next.some) {
            val child: usize = b.out.nodes.len;
            if (!pushed(vector.push[core_dispatch.Node](?b.out.nodes, core_dispatch.Node{key: 0, first: 0, count: 0}))) { ret err[diag.Refusal].err{memory()}; }
            b.out.entries.data[e].node = (child + 1)::u32;
            val built: err[diag.Refusal] = node(b, child, next.some, ?group);
            if (sel built.err) { ret built; }
        }
        or {
            val ordered: err[diag.Refusal] = leaf(b, ?group, e);
            if (sel ordered.err) { ret ordered; }
        }
        e = e + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the dispatch over `patterns`, or the refusal of rows it cannot tell apart
# ---
# a:        allocator for the dispatch and its scratch
# space:    the set's match space and keys
# patterns: what identifies each decodable row
# count:    how many patterns there are
pub fun build(a: *A.Allocator, space: *Space, patterns: *Pattern, count: u32) res[Built, diag.Refusal] {
    var out:   Built               = Built{nodes: vector.init[core_dispatch.Node](a), entries: vector.init[core_dispatch.Entry](a), candidates: vector.init[u32](a)};
    var b:     Builder             = Builder{alloc: a, space: space, out: ?out};
    var items: vector.Vector[Item] = vector.init[Item](a);
    var i:     u32                 = 0;
    for (i < count) {
        var c: u32 = 0;
        for (c < patterns[i].count) {
            if (!pushed(vector.push[Item](?items, Item{pattern: ?patterns[i], cube: ?patterns[i].cubes[c]}))) { ret res[Built, diag.Refusal].err{memory()}; }
            c = c + 1;
        }
        i = i + 1;
    }
    if (items.len == 0) { ret res[Built, diag.Refusal].err{diag.refusal(nil, 0, NO_ROWS, nil)}; }
    # the root reads a key even when one row reaches it
    val split: opt[u32] = choose(?b, ?items, true);
    var key:   opt[u32] = split;
    if (sel split.none)                                                                                       { key = choose(?b, ?items, false); }
    if (sel key.none)                                                                                         { ret res[Built, diag.Refusal].err{diag.refusal(nil, 0, NO_KEY, nil)}; }
    if (!pushed(vector.push[core_dispatch.Node](?out.nodes, core_dispatch.Node{key: 0, first: 0, count: 0}))) { ret res[Built, diag.Refusal].err{memory()}; }
    val built: err[diag.Refusal] = node(?b, 0, key.some, ?items);
    if (sel built.err) { ret res[Built, diag.Refusal].err{built.err}; }
    ret res[Built, diag.Refusal].ok{out};
}

# `d` emitted into `f` as `name`, a `dispatch.Dispatch` over the runtime keys at `keys`
# ---
# f:     the table it is emitted into
# name:  the constant it is declared as, its arrays named from it
# keys:  the path of the set's runtime key array, which `f` must use the module of
# count: how many runtime keys there are
# d:     the dispatch
pub fun declare(f: *emit.File, name: str, keys: str, count: u32, d: *Built) {
    emit.uses(f, "masc.core.dispatch");
    val nodes: *emit.Array = emit.array(f, "dispatch.Node");
    var i:     usize       = 0;
    for (i < d.nodes.len) {
        val n: *core_dispatch.Node = ?d.nodes.data[i];
        val r: *emit.Record        = emit.record(f, "dispatch.Node");
        emit.member(f, r, "key", emit.Value.number{n.key::i64});
        emit.member(f, r, "first", emit.Value.number{n.first::i64});
        emit.member(f, r, "count", emit.Value.number{n.count::i64});
        emit.item(f, nodes, emit.Value.record{r});
        i = i + 1;
    }
    val entries: *emit.Array = emit.array(f, "dispatch.Entry");
    i = 0;
    for (i < d.entries.len) {
        val e: *core_dispatch.Entry = ?d.entries.data[i];
        val r: *emit.Record         = emit.record(f, "dispatch.Entry");
        emit.member(f, r, "value", emit.Value.hex{e.value});
        emit.member(f, r, "node", emit.Value.number{e.node::i64});
        emit.member(f, r, "first", emit.Value.number{e.first::i64});
        emit.member(f, r, "count", emit.Value.number{e.count::i64});
        emit.item(f, entries, emit.Value.record{r});
        i = i + 1;
    }
    val candidates: *emit.Array = emit.array(f, "u32");
    i = 0;
    for (i < d.candidates.len) {
        emit.item(f, candidates, emit.Value.number{d.candidates.data[i]::i64});
        i = i + 1;
    }
    val r: *emit.Record = emit.record(f, "dispatch.Dispatch");
    emit.member(f, r, "keys", emit.Value.address{emit.concat(f, keys, "[0]")});
    emit.member(f, r, "key_count", emit.Value.number{count::i64});
    emit.member(f, r, "nodes", emit.declare_array(f, emit.concat(f, name, "_NODES"), nodes));
    emit.member(f, r, "node_count", emit.Value.number{d.nodes.len::i64});
    emit.member(f, r, "entries", emit.declare_array(f, emit.concat(f, name, "_ENTRIES"), entries));
    emit.member(f, r, "entry_count", emit.Value.number{d.entries.len::i64});
    emit.member(f, r, "candidates", emit.declare_array(f, emit.concat(f, name, "_CANDIDATES"), candidates));
    emit.member(f, r, "candidate_count", emit.Value.number{d.candidates.len::i64});
    emit.declare(f, name, "dispatch.Dispatch", emit.Value.record{r});
}

# risc-v-like keys and rows for the test below: the length class, the major opcode and funct3
#[testing]
val T_KEYS: [3]Key = [3]Key{
    Key{name: "length", word: 0, lo: 0, len: 2},
    Key{name: "opcode", word: 0, lo: 0, len: 7},
    Key{name: "funct3", word: 0, lo: 12, len: 3},
};

#[testing]
val T_SPACE: Space = Space{words: 1, keys: ?T_KEYS[0], key_count: 3};

# c.li, addi, beq, nop as addi x0, x0, 0, and a second spelling of addi's bits
#[testing]
val T_VALUES: [5]u64 = [5]u64{0x4001, 0x13, 0x63, 0x13, 0x13};

#[testing]
val T_MASKS: [5]u64 = [5]u64{0xE003, 0x707F, 0x707F, 0xFFFFFFFF, 0x707F};

#[testing]
val T_CUBES: [5]Cube = [5]Cube{
    Cube{value: ?T_VALUES[0], mask: ?T_MASKS[0]},
    Cube{value: ?T_VALUES[1], mask: ?T_MASKS[1]},
    Cube{value: ?T_VALUES[2], mask: ?T_MASKS[2]},
    Cube{value: ?T_VALUES[3], mask: ?T_MASKS[3]},
    Cube{value: ?T_VALUES[4], mask: ?T_MASKS[4]},
};

#[testing]
val T_PATTERNS: [5]Pattern = [5]Pattern{
    Pattern{row: 0, name: "c.li", cubes: ?T_CUBES[0], count: 1},
    Pattern{row: 1, name: "addi", cubes: ?T_CUBES[1], count: 1},
    Pattern{row: 2, name: "beq", cubes: ?T_CUBES[2], count: 1},
    Pattern{row: 3, name: "nop", cubes: ?T_CUBES[3], count: 1},
    Pattern{row: 4, name: "addx", cubes: ?T_CUBES[4], count: 1},
};

# the leaf the bits `value` reach, walked as the runtime walks
#[testing]
fun t_leaf(d: *Built, value: u64) opt[*core_dispatch.Entry] {
    var n: *core_dispatch.Node = ?d.nodes.data[0];
    for {
        val k:     *Key = ?T_KEYS[n.key];
        val v:     u64  = (value >> k.lo::u64) & ones(k.len);
        var found: bool = false;
        var e:     u32  = n.first;
        for (e < n.first + n.count && !found) {
            if (d.entries.data[e].value == v) { found = true; }
            or                                { e = e + 1; }
        }
        if (!found) { ret opt[*core_dispatch.Entry].none{}; }
        val entry: *core_dispatch.Entry = ?d.entries.data[e];
        if (entry.node == 0) { ret opt[*core_dispatch.Entry].some{entry}; }
        n = ?d.nodes.data[entry.node - 1];
    }
}

test build__the_dispatch_generated_from_rows_is_unambiguous_or_refused {
    var t: testing.Testing;
    testing.make(?t);
    val got: res[Built, diag.Refusal] = build(testing.allocator_of(?t), ?T_SPACE, ?T_PATTERNS[0], 4);
    if (sel got.err) { ret 1; }
    var d: Built = got.ok;
    # every row is a candidate of the leaf its own bits reach
    var i: u32 = 0;
    for (i < 4) {
        val reached: opt[*core_dispatch.Entry] = t_leaf(?d, T_VALUES[i]);
        if (sel reached.none) { ret 2; }
        var listed: bool = false;
        var c:      u32  = 0;
        for (c < reached.some.count) {
            if (d.candidates.data[reached.some.first + c] == i) { listed = true; }
            c = c + 1;
        }
        if (!listed) { ret 3; }
        i = i + 1;
    }
    # nop is more specific than addi, so it is tried first
    val shared: opt[*core_dispatch.Entry] = t_leaf(?d, 0x13);
    if (sel shared.none)                                                     { ret 4; }
    if (shared.some.count != 2 || d.candidates.data[shared.some.first] != 3) { ret 5; }
    val twice: res[Built, diag.Refusal] = build(testing.allocator_of(?t), ?T_SPACE, ?T_PATTERNS[0], 5);
    if (!(sel twice.err && twice.err.message == AMBIGUOUS)) { ret 6; }
    ret 0;
}
