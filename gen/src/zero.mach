# the constants generated tables spell that are their type's zero
#
# a record literal leaves out a member whose value is zero, since the language
# zero-initializes every member a literal omits, so a table states only what
# differs from zero. a number, `false` and `nil` are plainly zero. a named
# constant is zero only by its definition in masc, so each one a generator
# spells is listed here beside the test of its value, and a listed constant
# that is no longer zero refuses the run rather than dropping a member.
#
# only masc's core and the x86 opcode facts gen already reads are listed: a
# set's own field kinds are spelled in full, as their modules reach the tables.

use std.types.bool.bool;
use std.types.string.str;

use masc.core.compress;
use masc.core.constraint;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.fill;
use masc.core.form;
use masc.core.mode;
use masc.core.operand;
use masc.core.quantity;
use masc.core.register;
use masc.core.requirement;
use masc.core.row;
use masc.core.switch;
use masc.core.syntax;
use x86_opcode: masc.isa.x86.opcode;

# a constant as generated tables spell it, and whether its value is zero
pub rec Zero {
    name: str;
    zero: bool;
}

pub val COUNT: u32 = 51;

# every listed constant
pub fun known() [51]Zero {
    ret [51]Zero{
        Zero{name: "compress.NO_CONDITIONS", zero: compress.NO_CONDITIONS.at == nil && compress.NO_CONDITIONS.len == 0},
        Zero{name: "compress.NO_ORIGINS", zero: compress.NO_ORIGINS.at == nil && compress.NO_ORIGINS.len == 0},
        Zero{name: "constraint.DISJOINT", zero: constraint.DISJOINT == 0},
        Zero{name: "constraint.NO_CONSTRAINTS", zero: constraint.NO_CONSTRAINTS.at == nil && constraint.NO_CONSTRAINTS.len == 0},
        Zero{name: "constraint.WHOLE", zero: constraint.WHOLE == 0},
        Zero{name: "effect.FLAT", zero: effect.FLAT == 0},
        Zero{name: "effect.NONE", zero: effect.NONE == 0},
        Zero{name: "effect.NO_ACCESSES", zero: effect.NO_ACCESSES.at == nil && effect.NO_ACCESSES.len == 0},
        Zero{name: "effect.NO_ENTRIES", zero: effect.NO_ENTRIES.at == nil && effect.NO_ENTRIES.len == 0},
        Zero{name: "effect.NO_FIXEDS", zero: effect.NO_FIXEDS.at == nil && effect.NO_FIXEDS.len == 0},
        Zero{name: "effect.NO_ORDERINGS", zero: effect.NO_ORDERINGS.at == nil && effect.NO_ORDERINGS.len == 0},
        Zero{name: "effect.NO_REGISTER_RULES", zero: effect.NO_REGISTER_RULES.at == nil && effect.NO_REGISTER_RULES.len == 0},
        Zero{name: "effect.NO_RELATIONS", zero: effect.NO_RELATIONS.at == nil && effect.NO_RELATIONS.len == 0},
        Zero{name: "effect.NO_RULES", zero: effect.NO_RULES.at == nil && effect.NO_RULES.len == 0},
        Zero{name: "effect.NO_TERMS", zero: effect.NO_TERMS.at == nil && effect.NO_TERMS.len == 0},
        Zero{name: "effect.NO_TYPES", zero: effect.NO_TYPES.at == nil && effect.NO_TYPES.len == 0},
        Zero{name: "effect.NO_WRITES", zero: effect.NO_WRITES.at == nil && effect.NO_WRITES.len == 0},
        Zero{name: "effect.ONE", zero: effect.ONE == 0},
        Zero{name: "effect.UNTARGETED", zero: effect.UNTARGETED == 0},
        Zero{name: "extension.ARCH", zero: extension.ARCH == 0},
        Zero{name: "field.NO_SLICES", zero: field.NO_SLICES.at == nil && field.NO_SLICES.len == 0},
        Zero{name: "field.NUMBER", zero: field.NUMBER == 0},
        Zero{name: "fill.LONGEST_FIRST", zero: fill.LONGEST_FIRST == 0},
        Zero{name: "form.NO_FORM_FIELDS", zero: form.NO_FORM_FIELDS.at == nil && form.NO_FORM_FIELDS.len == 0},
        Zero{name: "mode.NO_SETTINGS", zero: mode.NO_SETTINGS.at == nil && mode.NO_SETTINGS.len == 0},
        Zero{name: "operand.ADJACENT", zero: operand.ADJACENT == 0},
        Zero{name: "operand.INTEGER", zero: operand.INTEGER == 0},
        Zero{name: "operand.NO_FIXUP", zero: operand.NO_FIXUP == 0},
        Zero{name: "operand.NO_GROUP", zero: operand.NO_GROUP.at == nil && operand.NO_GROUP.len == 0},
        Zero{name: "operand.NO_INTEGERS", zero: operand.NO_INTEGERS.at == nil && operand.NO_INTEGERS.len == 0},
        Zero{name: "operand.NO_NUMBERS", zero: operand.NO_NUMBERS.at == nil && operand.NO_NUMBERS.len == 0},
        Zero{name: "operand.NO_VALUES", zero: operand.NO_VALUES.at == nil && operand.NO_VALUES.len == 0},
        Zero{name: "operand.ONE", zero: operand.ONE == 0},
        Zero{name: "operand.STRING", zero: operand.STRING == 0},
        Zero{name: "operand.UNSIGNED", zero: operand.UNSIGNED == 0},
        Zero{name: "operand.UNSTATED", zero: operand.UNSTATED == 0},
        Zero{name: "quantity.NO_BOUNDS", zero: quantity.NO_BOUNDS.at == nil && quantity.NO_BOUNDS.len == 0},
        Zero{name: "quantity.NO_GAUGES", zero: quantity.NO_GAUGES.at == nil && quantity.NO_GAUGES.len == 0},
        Zero{name: "register.DWARF", zero: register.DWARF == 0},
        Zero{name: "register.GENERAL", zero: register.GENERAL == 0},
        Zero{name: "register.UNSTATED", zero: register.UNSTATED == 0},
        Zero{name: "requirement.NO_ALTERNATIVES", zero: requirement.NO_ALTERNATIVES.at == nil && requirement.NO_ALTERNATIVES.len == 0},
        Zero{name: "requirement.NO_IDS", zero: requirement.NO_IDS.at == nil && requirement.NO_IDS.len == 0},
        Zero{name: "row.NO_OPERANDS", zero: row.NO_OPERANDS.at == nil && row.NO_OPERANDS.len == 0},
        Zero{name: "switch.NO_SCRATCH", zero: switch.NO_SCRATCH.at == nil && switch.NO_SCRATCH.len == 0},
        Zero{name: "syntax.NO_EXCLUSIONS", zero: syntax.NO_EXCLUSIONS.at == nil && syntax.NO_EXCLUSIONS.len == 0},
        Zero{name: "x86_opcode.L128", zero: x86_opcode.L128 == 0},
        Zero{name: "x86_opcode.LEGACY", zero: x86_opcode.LEGACY == 0},
        Zero{name: "x86_opcode.NO_ADDRESS", zero: x86_opcode.NO_ADDRESS == 0},
        Zero{name: "x86_opcode.NO_SIMD", zero: x86_opcode.NO_SIMD == 0},
        Zero{name: "x86_opcode.NO_SIZE", zero: x86_opcode.NO_SIZE == 0},
    };
}
