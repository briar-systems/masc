# the layers of XED's datafiles and the files each lists by kind
#
# a layer is a `.cfg` file under datafiles. each line lists one datafile of a kind, as
# `kind : file [: priority]` or `add : kind : file [: priority]`, the file relative to the
# layer's directory. XED's build reads base `files.cfg` and `files-xregs.cfg` first and then the
# layers of every chip and technology it builds, which by default is all of them
# (xed_mbuild.py _configure_libxed_extensions and _parse_extf_files_new,
# pysrc/xed_chips_to_layers.py). the reader reads every layer of the copy in that order, the
# rest by path, except the two no build lists: files-xmm.cfg, the xmm rows of a build without
# avx that avx-regs.txt widens, and xsave-regs, two tracking pseudo-registers no instruction
# names.
#
# per kind, a file listed at a higher priority drops those listed lower, as the dec-spine of
# avx512 drops the base one, and a file listed twice for one kind is refused as XED refuses it.
# the lines that add, remove or replace C sources of XED's library, add tests or mark files
# for enc2 are the build's own and carry no data. any other command is refused

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_last_index_char;
use std.types.string.str_starts_with;
use std.types.view.View;
use std.types.view.view;
use std.types.view.view_eq_str;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use gen.lines;
use gen.source;
use gen.x86.xed.text;

# one datafile a layer lists
# ---
# kind:     what it holds, as the layer names it, such as `dec-instructions`
# file:     the datafile in the copy
# priority: the priority it was listed at
# listed:   the layer line that lists it
pub rec Listed {
    kind:     str;
    file:     *source.File;
    priority: u32;
    listed:   lines.Line;
}

pub val ROOT: str = "datafiles/";

pub val NO_LAYERS: str = "copy has no datafiles/files.cfg";
pub val COMMAND:   str = "layer line is not a datafile of a known kind or a build line";
pub val NO_FILE:   str = "listed datafile not in the copy";
pub val TWICE:     str = "datafile listed twice for one kind";
pub val PRIORITY:  str = "priority is not a number";

# the layers XED's build reads before every other, in order
val BASE: [2]str = [2]str{"datafiles/files.cfg", "datafiles/files-xregs.cfg"};

# the layers no XED build lists
val UNLISTED: [2]str = [2]str{"datafiles/files-xmm.cfg", "datafiles/xsave-regs/files.cfg"};

# the kinds of datafile XED's generator takes (xed_mbuild.py generator_inputs_t)
val KINDS: [19]str = [19]str{
    "dec-spine", "dec-instructions", "enc-instructions", "dec-patterns", "enc-patterns", "enc-dec-patterns", "fields", "state", "registers",
    "widths", "extra-widths", "pointer-names", "element-types", "element-type-base", "chip-models", "conversion-table", "cpuid",
    "map-descriptions", "errors",
};

# the lines of a layer that are the build's own
val BUILD: [6]str = [6]str{"add-source", "remove-source", "replace-source", "no-enc2-instructions", "add-tests", "define"};

fun among(v: View, names: *str, count: u32) opt[str] {
    var i: u32 = 0;
    for (i < count) {
        if (view_eq_str(v, names[i])) { ret opt[str].some{names[i]}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

fun listed_base(path: str) bool {
    ret str_equals(path, BASE[0]) || str_equals(path, BASE[1]);
}

fun unlisted(path: str) bool {
    ret str_equals(path, UNLISTED[0]) || str_equals(path, UNLISTED[1]);
}

# the colon-separated fields of `l`, each trimmed
fun fields(a: *A.Allocator, l: *lines.Line) res[vector.Vector[View], diag.Refusal] {
    var out:  vector.Vector[View] = vector.init[View](a);
    var from: usize               = 0;
    var i:    usize               = 0;
    for (i <= l.text.len) {
        if (i == l.text.len || l.text.data[i] == ':') {
            if (!text.pushed(vector.push[View](?out, text.trim(text.part(l.text, from, i - from))))) { ret res[vector.Vector[View], diag.Refusal].err{text.memory(l)}; }
            from = i + 1;
        }
        i = i + 1;
    }
    ret res[vector.Vector[View], diag.Refusal].ok{out};
}

rec Reading {
    alloc:    *A.Allocator;
    tree:     *source.Tree;
    files:    *vector.Vector[Listed];
    priority: vector.Vector[u32];
}

fun kind_at(name: str) u32 {
    var i: u32 = 0;
    for (i < 19) {
        if (str_equals(KINDS[i], name)) { ret i; }
        i = i + 1;
    }
    ret 19;
}

# the file `name` of the layer at `layer` listed as `kind` at `priority`, kept as XED keeps it
fun add(r: *Reading, l: *lines.Line, layer: str, kind: str, name: View, priority: u32) err[diag.Refusal] {
    val cut:  opt[usize] = str_last_index_char(layer, '/');
    var keep: usize      = 0;
    if (sel cut.some) { keep = cut.some + 1; }
    val dir: res[str, StrError] = str_copy_slice(r.alloc, layer, 0, keep);
    if (sel dir.err) { ret err[diag.Refusal].err{text.memory(l)}; }
    val leaf: res[str, diag.Refusal] = text.owned(r.alloc, l, name);
    if (sel leaf.err) { ret err[diag.Refusal].err{leaf.err}; }
    val path: res[str, StrError] = str_join(r.alloc, dir.ok, leaf.ok);
    if (sel path.err) { ret err[diag.Refusal].err{text.memory(l)}; }
    val file: opt[*source.File] = source.find(r.tree, path.ok);
    if (sel file.none) { ret err[diag.Refusal].err{lines.refuse(l, NO_FILE, path.ok)}; }
    val k: u32 = kind_at(kind);
    if (r.priority.data[k] > priority) { ret err[diag.Refusal].ok{}; }
    if (r.priority.data[k] < priority) {
        r.priority.data[k] = priority;
        var kept: usize = 0;
        var i:    usize = 0;
        for (i < r.files.len) {
            if (!str_equals(r.files.data[i].kind, kind)) {
                r.files.data[kept] = r.files.data[i];
                kept               = kept + 1;
            }
            i = i + 1;
        }
        r.files.len = kept;
    }
    var i: usize = 0;
    for (i < r.files.len) {
        if (r.files.data[i].file == file.some && str_equals(r.files.data[i].kind, kind)) { ret err[diag.Refusal].err{lines.refuse(l, TWICE, path.ok)}; }
        i = i + 1;
    }
    if (!text.pushed(vector.push[Listed](r.files, Listed{kind: kind, file: file.some, priority: priority, listed: @l}))) { ret err[diag.Refusal].err{text.memory(l)}; }
    ret err[diag.Refusal].ok{};
}

fun layer(r: *Reading, f: *source.File) err[diag.Refusal] {
    val got: res[vector.Vector[lines.Line], diag.Refusal] = text.read(r.alloc, f, false);
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var i: usize = 0;
    for (i < got.ok.len) {
        val l:     *lines.Line                            = ?got.ok.data[i];
        val split: res[vector.Vector[View], diag.Refusal] = fields(r.alloc, l);
        if (sel split.err) { ret err[diag.Refusal].err{split.err}; }
        val w:     *vector.Vector[View] = ?split.ok;
        var first: usize                = 0;
        if (view_eq_str(w.data[0], "add")) { first = 1; }
        val build: opt[str] = among(w.data[0], ?BUILD[0], 6);
        if (sel build.some) {
            i = i + 1;
            cnt;
        }
        if (w.len < first + 2 || w.len > first + 3) { ret err[diag.Refusal].err{lines.refuse(l, COMMAND, nil)}; }
        val kind: opt[str] = among(w.data[first], ?KINDS[0], 19);
        if (sel kind.none) { ret err[diag.Refusal].err{lines.refuse(l, COMMAND, nil)}; }
        var priority: u32 = 1;
        if (w.len == first + 3) {
            val n: opt[u64] = text.number(w.data[first + 2]);
            if (sel n.none)      { ret err[diag.Refusal].err{lines.refuse(l, PRIORITY, nil)}; }
            if (n.some > 0xFFFF) { ret err[diag.Refusal].err{lines.refuse(l, PRIORITY, nil)}; }
            priority = n.some::u32;
        }
        val added: err[diag.Refusal] = add(r, l, f.path, kind.some, w.data[first + 1], priority);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# every datafile the layers of `t` list, in the order XED's build reads them
# ---
# a:   allocator for the list
# t:   the copy's tree
# ret: the files, each with its kind, or the refusal of a layer line
pub fun read(a: *A.Allocator, t: *source.Tree) res[vector.Vector[Listed], diag.Refusal] {
    var files: vector.Vector[Listed] = vector.init[Listed](a);
    var r:     Reading               = Reading{alloc: a, tree: t, files: ?files, priority: vector.init[u32](a)};
    var k:     u32                   = 0;
    for (k < 20) {
        if (!text.pushed(vector.push[u32](?r.priority, 1))) { ret res[vector.Vector[Listed], diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, nil)}; }
        k = k + 1;
    }
    var b: u32 = 0;
    for (b < 2) {
        val base: opt[*source.File] = source.find(t, BASE[b]);
        if (sel base.none) { ret res[vector.Vector[Listed], diag.Refusal].err{diag.refusal(BASE[b], 0, NO_LAYERS, nil)}; }
        val read: err[diag.Refusal] = layer(?r, base.some);
        if (sel read.err) { ret res[vector.Vector[Listed], diag.Refusal].err{read.err}; }
        b = b + 1;
    }
    var i: usize = 0;
    for (i < t.files.len) {
        val f: *source.File = ?t.files.data[i];
        if (str_starts_with(f.path, ROOT) && str_ends_with(f.path, ".cfg") && !listed_base(f.path) && !unlisted(f.path)) {
            val read: err[diag.Refusal] = layer(?r, f);
            if (sel read.err) { ret res[vector.Vector[Listed], diag.Refusal].err{read.err}; }
        }
        i = i + 1;
    }
    ret res[vector.Vector[Listed], diag.Refusal].ok{files};
}

# the files of `kind`, in order
pub fun of(a: *A.Allocator, files: *vector.Vector[Listed], kind: str) res[vector.Vector[*Listed], diag.Refusal] {
    var out: vector.Vector[*Listed] = vector.init[*Listed](a);
    var i:   usize                  = 0;
    for (i < files.len) {
        if (str_equals(files.data[i].kind, kind)) {
            if (!text.pushed(vector.push[*Listed](?out, ?files.data[i]))) { ret res[vector.Vector[*Listed], diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, kind)}; }
        }
        i = i + 1;
    }
    ret res[vector.Vector[*Listed], diag.Refusal].ok{out};
}
