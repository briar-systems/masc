# the table of XED's ISA sets as requirements over the x86 catalog
#
# the xed generator reads the XED copy into the model and emits gen_isa_set beside masc's x86
# modules: every ISA set XED names, in its cpuid files or as the ISA_SET of an instruction,
# spelled as XED spells it and sorted, with what it requires of a selection. a set requires any
# one of its cpuid groups, each the rows its cpuid bits name, and a group that implies another
# under the catalog's implications is dropped, the first of two equivalent ones kept. so an avx10
# group of an avx512 set, whose version implies the family and avx512vl, leaves the family's own
# group alone. the rulings below are the ones worked out on #29 for the catalog of #28:
#   a cpuid bit names the catalog row of its name, or the row RENAMES gives it. a feature whose
#   enable bit XED names apart (pku and ospku, klsupported and klenabled, intelpt and ptwrite, a
#   padlock unit and its _en bit) is one row, the leaf 1EH _mirrored amx bits are the rows of
#   their leaf 07H names, ace_vsn1 is the ace row, and the avx10 bits name the avx10 versions:
#   avx10_enabled and avx10_ver1 avx10_1, avx10_ver2 avx10_2, avx10_v1_aux avx10_vnni_int
#   a set XED gives no cpuid bit is answered by hand: NONE for the sets every x86 processor
#   executes, and BY_HAND for the rest, each the row of its feature, whose CPUID bit AMD's APM
#   volume 3 Appendix D (Table D-1) or Intel's SDM states
# a cpuid name that names no row, a set without cpuid bits that neither list answers, and an entry
# of either list that XED no longer needs are refused, so a new XED revision cannot be read past
# them

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_to_upper;

use A: std.allocator;
use std.collections.map;
use std.collections.sort;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.extension;
use masc_requirement: masc.core.requirement;
use x86_extension:    masc.isa.x86.extension;

use gen.diag;
use gen.emit;
use gen.set;
use gen.x86.xed;

# a cpuid name and the catalog row it names
rec Rename {
    bit: str;
    row: str;
}

# a set without cpuid bits and the catalog row it requires
rec Answer {
    set: str;
    row: str;
}

val RENAMES: [31]Rename = [31]Rename{
    Rename{bit: "ace_vsn1", row: "ace"},
    Rename{bit: "adoxadcx", row: "adx"},
    Rename{bit: "amx_bf16_mirrored", row: "amx_bf16"},
    Rename{bit: "amx_complex_mirrored", row: "amx_complex"},
    Rename{bit: "amx_fp16_mirrored", row: "amx_fp16"},
    Rename{bit: "amx_int8_mirrored", row: "amx_int8"},
    Rename{bit: "apx_f_nci_ndd_nf", row: "apx_nci_ndd_nf"},
    Rename{bit: "avx10_enabled", row: "avx10_1"},
    Rename{bit: "avx10_v1_aux", row: "avx10_vnni_int"},
    Rename{bit: "avx10_ver1", row: "avx10_1"},
    Rename{bit: "avx10_ver2", row: "avx10_2"},
    Rename{bit: "bf16", row: "avx512_bf16"},
    Rename{bit: "bhi_ctrl", row: "ibhf"},
    Rename{bit: "cmpxchg16b", row: "cx16"},
    Rename{bit: "fpu", row: "x87"},
    Rename{bit: "fxsave", row: "fxsr"},
    Rename{bit: "intel64", row: "x86-64"},
    Rename{bit: "intelpt", row: "ptwrite"},
    Rename{bit: "klenabled", row: "keylocker"},
    Rename{bit: "klsupported", row: "keylocker"},
    Rename{bit: "klwide", row: "keylocker_wide"},
    Rename{bit: "movebe", row: "movbe"},
    Rename{bit: "ospku", row: "pku"},
    Rename{bit: "pclmulqdq", row: "pclmul"},
    Rename{bit: "rdp", row: "rdpid"},
    Rename{bit: "rdwrfsgs", row: "fsgsbase"},
    Rename{bit: "sse4", row: "sse41"},
    Rename{bit: "via_padlock_aes_en", row: "via_padlock_aes"},
    Rename{bit: "via_padlock_pmm_en", row: "via_padlock_pmm"},
    Rename{bit: "via_padlock_rng_en", row: "via_padlock_rng"},
    Rename{bit: "via_padlock_sha_en", row: "via_padlock_sha"},
};

# the sets every x86 processor executes, which no cpuid bit enumerates
val NONE: [15]str = [15]str{
    "FAT_NOP", "I186", "I286PROTECTED", "I286REAL", "I386", "I486", "I486REAL", "I86", "PAUSE", "PENTIUMREAL", "PPRO", "PPRO_UD0_LONG",
    "PPRO_UD0_SHORT", "PREFETCH_NOP", "RDPMC",
};

# the sets XED gives no cpuid bit that need a row: x87 its own, the prefetches of sse_prefetch
# sse, amd's SYSCALL_AMD and SYSRET_AMD sce, ENCLV sgx, and the rest the row of their own feature
val BY_HAND: [14]Answer = [14]Answer{
    Answer{set: "3DNOW", row: "3dnow"},
    Answer{set: "AMD", row: "sce"},
    Answer{set: "AMD_INVLPGB", row: "invlpgb"},
    Answer{set: "CLZERO", row: "clzero"},
    Answer{set: "FMA4", row: "fma4"},
    Answer{set: "LWP", row: "lwp"},
    Answer{set: "SGX_ENCLV", row: "sgx"},
    Answer{set: "SSE_PREFETCH", row: "sse"},
    Answer{set: "SVM", row: "svm"},
    Answer{set: "TBM", row: "tbm"},
    Answer{set: "TDX", row: "tdx"},
    Answer{set: "VMFUNC", row: "vmfunc"},
    Answer{set: "X87", row: "x87"},
    Answer{set: "XOP", row: "xop"},
};

pub val NO_ROW:     str = "cpuid name or answer names no row of the x86 catalog";
pub val UNANSWERED: str = "ISA set has no cpuid bit and no answer";
pub val STALE:      str = "answer or rename for what XED no longer names without cpuid bits";

fun memory(subject: str) diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, subject);
}

# the catalog row `name`
fun row(name: str) res[masc_requirement.Id, diag.Refusal] {
    val id: opt[masc_requirement.Id] = extension.lookup(?x86_extension.CATALOG, name, 0, str_len(name));
    if (sel id.none)                    { ret res[masc_requirement.Id, diag.Refusal].err{diag.refusal(nil, 0, NO_ROW, name)}; }
    if (id.some >= x86_extension.COUNT) { ret res[masc_requirement.Id, diag.Refusal].err{diag.refusal(nil, 0, NO_ROW, name)}; }
    ret res[masc_requirement.Id, diag.Refusal].ok{id.some};
}

# the row a cpuid name names, noting which renames were used
fun bit_row(name: str, used: *bool) res[masc_requirement.Id, diag.Refusal] {
    var i: u32 = 0;
    for (i < 31) {
        if (str_equals(RENAMES[i].bit, name)) {
            used[i] = true;
            ret row(RENAMES[i].row);
        }
        i = i + 1;
    }
    ret row(name);
}

# one set's requirement
rec Need {
    name:         str;
    alternatives: vector.Vector[vector.Vector[masc_requirement.Id]];
}

fun holds(x: *vector.Vector[masc_requirement.Id], id: masc_requirement.Id) bool {
    var i: usize = 0;
    for (i < x.len) {
        if (x.data[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub val CONFLICTING: str = "cpuid group names rows the x86 catalog sets in conflict";

# whether `x` implies every id of `y` under the catalog's implications
fun covers(a: *A.Allocator, x: *vector.Vector[masc_requirement.Id], y: *vector.Vector[masc_requirement.Id]) res[bool, diag.Refusal] {
    val made: res[extension.Request, extension.Error] = extension.request(a, ?x86_extension.CATALOG, "", diagnostic.START);
    if (sel made.err) { ret res[bool, diag.Refusal].err{memory(nil)}; }
    var r: extension.Request = made.ok;
    var i: usize             = 0;
    for (i < x.len) {
        extension.request_add(?r, x.data[i]);
        i = i + 1;
    }
    val closed: res[extension.Selection, extension.Error] = extension.close(r);
    if (sel closed.err) { ret res[bool, diag.Refusal].err{diag.refusal(nil, 0, CONFLICTING, nil)}; }
    var c:    extension.Selection = closed.ok;
    var held: bool                = true;
    i = 0;
    for (i < y.len) {
        if (!extension.has(?c, y.data[i])) { held = false; }
        i = i + 1;
    }
    extension.release(?c);
    ret res[bool, diag.Refusal].ok{held};
}

fun by_name(x: *Need, y: *Need) i64 {
    ret str_compare(x.name, y.name);
}

fun upper(a: *A.Allocator, s: str) res[str, diag.Refusal] {
    val u: res[str, StrError] = str_to_upper(a, s);
    if (sel u.err) { ret res[str, diag.Refusal].err{memory(s)}; }
    ret res[str, diag.Refusal].ok{u.ok};
}

# the requirement of `name`, from its cpuid groups or its answer
fun need(a: *A.Allocator, x: *xed.Xed, name: str, used: *bool, answered: *bool) res[Need, diag.Refusal] {
    var n:     Need                = Need{name: name, alternatives: vector.init[vector.Vector[masc_requirement.Id]](a)};
    val found: opt[*xed.cpuid.Set] = xed.cpuid.find(?x.cpuid, name);
    var s:     *xed.cpuid.Set      = nil;
    if (sel found.some) { s = found.some; }
    if (s != nil && s.groups.len > 0) {
        var g: usize = 0;
        for (g < s.groups.len) {
            val group: *xed.cpuid.Group                   = ?s.groups.data[g];
            var ids:   vector.Vector[masc_requirement.Id] = vector.init[masc_requirement.Id](a);
            var k:     usize                              = 0;
            for (k < group.bits.len) {
                val id: res[masc_requirement.Id, diag.Refusal] = bit_row(group.bits.data[k], used);
                if (sel id.err) { ret res[Need, diag.Refusal].err{diag.refusal(group.line.file, group.line.number, NO_ROW, group.bits.data[k])}; }
                if (!holds(?ids, id.ok)) {
                    val pushed: res[usize, A.Error] = vector.push[masc_requirement.Id](?ids, id.ok);
                    if (sel pushed.err) { ret res[Need, diag.Refusal].err{memory(name)}; }
                }
                k = k + 1;
            }
            # an alternative that implies another is dropped, the first of two equivalent ones kept
            var drop: bool  = false;
            var j:    usize = 0;
            for (j < n.alternatives.len) {
                val over: res[bool, diag.Refusal] = covers(a, ?ids, ?n.alternatives.data[j]);
                if (sel over.err) { ret res[Need, diag.Refusal].err{diag.refusal(group.line.file, group.line.number, over.err.message, name)}; }
                if (over.ok)      { drop = true; }
                j = j + 1;
            }
            if (!drop) {
                var kept: usize = 0;
                j = 0;
                for (j < n.alternatives.len) {
                    val under: res[bool, diag.Refusal] = covers(a, ?n.alternatives.data[j], ?ids);
                    if (sel under.err) { ret res[Need, diag.Refusal].err{under.err}; }
                    if (!under.ok) {
                        n.alternatives.data[kept] = n.alternatives.data[j];
                        kept                      = kept + 1;
                    }
                    j = j + 1;
                }
                n.alternatives.len = kept;
                val pushed: res[usize, A.Error] = vector.push[vector.Vector[masc_requirement.Id]](?n.alternatives, ids);
                if (sel pushed.err) { ret res[Need, diag.Refusal].err{memory(name)}; }
            }
            g = g + 1;
        }
        ret res[Need, diag.Refusal].ok{n};
    }
    var i: u32 = 0;
    for (i < 15) {
        if (str_equals(NONE[i], name)) {
            answered[i] = true;
            ret res[Need, diag.Refusal].ok{n};
        }
        i = i + 1;
    }
    i = 0;
    for (i < 14) {
        if (str_equals(BY_HAND[i].set, name)) {
            answered[15 + i] = true;
            val id: res[masc_requirement.Id, diag.Refusal] = row(BY_HAND[i].row);
            if (sel id.err) { ret res[Need, diag.Refusal].err{id.err}; }
            var ids:    vector.Vector[masc_requirement.Id] = vector.init[masc_requirement.Id](a);
            val pushed: res[usize, A.Error]                = vector.push[masc_requirement.Id](?ids, id.ok);
            if (sel pushed.err) { ret res[Need, diag.Refusal].err{memory(name)}; }
            val alt: res[usize, A.Error] = vector.push[vector.Vector[masc_requirement.Id]](?n.alternatives, ids);
            if (sel alt.err) { ret res[Need, diag.Refusal].err{memory(name)}; }
            ret res[Need, diag.Refusal].ok{n};
        }
        i = i + 1;
    }
    ret res[Need, diag.Refusal].err{diag.refusal(nil, 0, UNANSWERED, name)};
}

# every ISA set the model names, in upper case, sorted and once each
fun names(a: *A.Allocator, x: *xed.Xed) res[vector.Vector[str], diag.Refusal] {
    var seen: map.Map[str, u32]  = map.init[str, u32](a);
    var out:  vector.Vector[str] = vector.init[str](a);
    var i:    usize              = 0;
    for (i < x.cpuid.sets.len + x.instructions.len) {
        var name: str = nil;
        if (i < x.cpuid.sets.len) { name = x.cpuid.sets.data[i].name; }
        or {
            val u: res[str, diag.Refusal] = upper(a, x.instructions.data[i - x.cpuid.sets.len].isa_set);
            if (sel u.err) { ret res[vector.Vector[str], diag.Refusal].err{u.err}; }
            name = u.ok;
        }
        if (!map.contains[str, u32](?seen, ?name)) {
            val put: res[bool, A.Error] = map.insert[str, u32](?seen, name, 0);
            if (sel put.err) { ret res[vector.Vector[str], diag.Refusal].err{memory(name)}; }
            val pushed: res[usize, A.Error] = vector.push[str](?out, name);
            if (sel pushed.err) { ret res[vector.Vector[str], diag.Refusal].err{memory(name)}; }
        }
        i = i + 1;
    }
    ret res[vector.Vector[str], diag.Refusal].ok{out};
}

fun number(n: i64) emit.Value {
    ret emit.Value.number{n};
}

fun name(s: str) emit.Value {
    ret emit.Value.name{s};
}

fun span(f: *emit.File, of: str, array: str, at: u32, count: u32) emit.Value {
    val r: *emit.Record = emit.record(f, of);
    emit.member(f, r, "at", emit.element(f, array, at));
    emit.member(f, r, "len", number(count::i64));
    ret emit.Value.record{r};
}

# the table of every set's requirement
fun table(c: *set.Context, needs: *vector.Vector[Need]) err[diag.Refusal] {
    val made: res[*emit.File, diag.Refusal] = set.table(c, "isa_set");
    if (sel made.err) { ret err[diag.Refusal].err{made.err}; }
    val f: *emit.File = made.ok;
    emit.uses(f, "masc.core.index");
    emit.uses(f, "masc.core.requirement");
    emit.uses(f, "x86_extension: masc.isa.x86.extension");
    var ids:      emit.Pool   = emit.pool(f, "requirement.Id");
    var alts:     emit.Pool   = emit.pool(f, "requirement.Ids");
    val requires: *emit.Array = emit.array(f, "requirement.Requirement");
    val entries:  *emit.Array = emit.keyed(f, "index.Entry");
    var i:        usize       = 0;
    for (i < needs.len) {
        val n:   *Need                     = ?needs.data[i];
        var run: vector.Vector[emit.Value] = vector.init[emit.Value](c.alloc);
        var k:   usize                     = 0;
        for (k < n.alternatives.len) {
            val alt:  *vector.Vector[masc_requirement.Id] = ?n.alternatives.data[k];
            var each: vector.Vector[emit.Value]           = vector.init[emit.Value](c.alloc);
            var j:    usize                               = 0;
            for (j < alt.len) {
                val row_name: str = x86_extension.CATALOG.extensions[alt.data[j]].name;
                vector.push[emit.Value](?each, name(emit.concat(f, "x86_extension.", emit.ident(f, row_name))));
                j = j + 1;
            }
            val first: u32 = emit.pooled(f, ?ids, each.data, each.len::u32);
            vector.push[emit.Value](?run, span(f, "requirement.Ids", "IDS", first, each.len::u32));
            k = k + 1;
        }
        if (run.len == 0) { emit.item(f, requires, name("requirement.NONE")); }
        or {
            val at: u32 = emit.pooled(f, ?alts, run.data, run.len::u32);
            emit.item(f, requires, span(f, "requirement.Requirement", "ALTERNATIVES", at, run.len::u32));
        }
        val e: *emit.Record = emit.record(f, "index.Entry");
        emit.member(f, e, "key", emit.Value.text{n.name});
        emit.member(f, e, "row", number(i::i64));
        emit.entry(f, entries, n.name, emit.Value.record{e});
        i = i + 1;
    }
    emit.declare(f, "IDS", nil, emit.Value.array{ids.array});
    emit.declare(f, "ALTERNATIVES", nil, emit.Value.array{alts.array});
    emit.declare(f, "REQUIRES", nil, emit.Value.array{requires});
    emit.declare(f, "NAMES", nil, emit.Value.array{entries});
    val index: *emit.Record = emit.record(f, "index.Index");
    emit.member(f, index, "at", emit.element(f, "NAMES", 0));
    emit.member(f, index, "len", number(needs.len::i64));
    emit.declare(f, "INDEX", "index.Index", emit.Value.record{index});
    emit.declare(f, "COUNT", "u32", number(needs.len::i64));
    ret err[diag.Refusal].ok{};
}

# the xed generator: the XED copy read into the model, and the table of its ISA sets emitted
pub fun generate(c: *set.Context) err[diag.Refusal] {
    val read: res[xed.Xed, diag.Refusal] = xed.read(c.alloc, c.tree);
    if (sel read.err) { ret err[diag.Refusal].err{read.err}; }
    var x:   xed.Xed                               = read.ok;
    val all: res[vector.Vector[str], diag.Refusal] = names(c.alloc, ?x);
    if (sel all.err) { ret err[diag.Refusal].err{all.err}; }
    var used:     [31]bool;
    var answered: [29]bool;
    var needs:    vector.Vector[Need] = vector.init[Need](c.alloc);
    var i:        usize               = 0;
    for (i < all.ok.len) {
        val n: res[Need, diag.Refusal] = need(c.alloc, ?x, all.ok.data[i], ?used[0], ?answered[0]);
        if (sel n.err) { ret err[diag.Refusal].err{n.err}; }
        val pushed: res[usize, A.Error] = vector.push[Need](?needs, n.ok);
        if (sel pushed.err) { ret err[diag.Refusal].err{memory(all.ok.data[i])}; }
        i = i + 1;
    }
    var k: u32 = 0;
    for (k < 31) {
        if (!used[k]) { ret err[diag.Refusal].err{diag.refusal(nil, 0, STALE, RENAMES[k].bit)}; }
        k = k + 1;
    }
    k = 0;
    for (k < 29) {
        if (!answered[k]) {
            if (k < 15) { ret err[diag.Refusal].err{diag.refusal(nil, 0, STALE, NONE[k])}; }
            ret err[diag.Refusal].err{diag.refusal(nil, 0, STALE, BY_HAND[k - 15].set)};
        }
        k = k + 1;
    }
    sort.sort_by[Need](needs.data, needs.len, by_name);
    ret table(c, ?needs);
}
