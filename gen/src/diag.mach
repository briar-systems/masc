# the refusal every generator step reports
#
# a refusal names where it is, a source file and line or a table, so a
# malformed record, a defective source or an ambiguous table is found from
# the message alone.

use std.types.string.str;

# why a step was refused
# ---
# file:    the source file or the generated table the refusal is in, nil when neither
# line:    its line, 0 when the refusal is not about one line
# message: the diagnostic
# subject: what it names, such as a source, a key or a row, nil when nothing
pub rec Refusal {
    file:    str;
    line:    u32;
    message: str;
    subject: str;
}

pub val MEMORY: str = "out of memory";

pub fun refusal(file: str, line: u32, message: str, subject: str) Refusal {
    ret Refusal{file: file, line: line, message: message, subject: subject};
}
