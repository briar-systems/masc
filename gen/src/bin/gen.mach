# the table generator program
#
# usage: gen [--check] [<masc root>]. it writes every generated table into
# masc's tree, or with --check reports each one that drifted from what its
# generator emits, and exits 1 on any drift or refusal. the root defaults to
# the working directory.

use std.print;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.arena;
use std.allocator.page;
use std.collections.vector;

use gen.diag;
use gen.registry;
use gen.run;

fun shown(s: str) str {
    if (s == nil) { ret "-"; }
    ret s;
}

fun usage() i64 {
    print.eprintln("usage: gen [--check] [<masc root>]");
    ret 2;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var check: bool = false;
    var root:  str  = ".";
    var given: bool = false;
    var i:     i64  = 1;
    for (i < argc) {
        val arg: str = argv[i]::str;
        if (str_equals(arg, "--check")) { check = true; }
        or (!given && arg[0] != '-') {
            root  = arg;
            given = true;
        }
        or { ret usage(); }
        i = i + 1;
    }
    var back: A.Allocator;
    page.make(?back);
    var ar:   arena.Arena;
    var a:    A.Allocator;
    val made: err[A.Error] = arena.init(?ar, ?back, 1 << 24);
    if (sel made.err) {
        print.eprintln("gen: out of memory");
        ret 1;
    }
    arena.make(?a, ?ar);
    fin { arena.dnit(?ar); }
    var drift: vector.Vector[run.Drift] = vector.init[run.Drift](?a);
    val ran:   err[diag.Refusal]        = run.run(?a, root, ?registry.SOURCES, ?registry.GENERATORS, check, ?drift);
    if (sel ran.err) {
        val r: diag.Refusal = ran.err;
        print.eprintlnf("gen: {}:{}: {} ({})", shown(r.file), r.line, r.message, shown(r.subject));
        ret 1;
    }
    var k: usize = 0;
    for (k < drift.len) {
        print.eprintlnf("gen: {}:{}: {}", drift.data[k].path, drift.data[k].line, drift.data[k].message);
        k = k + 1;
    }
    if (drift.len > 0) { ret 1; }
    ret 0;
}
