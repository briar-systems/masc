# the contract every set's generator implements
#
# a set's generator is one small module over the framework: it reads its
# source through the tree it is handed, maps it to rows, and emits them as
# tables it opens through `table`. it owns parsing its source and the
# meaning of its rows. the framework owns the source check before it runs,
# where each table lives and what it is called, its header, its layout, the
# decode dispatch over its rows, the handles that name its rows and the drift
# check after it. a set's generator uses this module and reaches the
# framework through it.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;

use A: std.allocator;
use std.collections.map;
use std.collections.vector;

# the framework a set's generator reads its source and emits its tables through
fwd gen.diag;
fwd gen.dispatch;
fwd gen.document;
fwd gen.emit;
fwd gen.lines;
fwd gen.overlay;
fwd gen.source;

# one set's generator
# ---
# name:     the generator's name, as the generated headers spell it
# set:      the set it emits, the directory under src/isa its tables live in
# source:   the row of the source table it reads
# inputs:   the further rows it reads, each beside its source
# generate: reads the trees and emits the set's tables into the context
pub rec Generator {
    name:     str;
    set:      str;
    source:   *source.Source;
    inputs:   source.Refs;
    generate: fun(*Context) err[diag.Refusal];
}

# registered generators, each held by pointer
pub rec Generators {
    at:  **Generator;
    len: u32;
}

# what a generator runs with
# ---
# alloc:     allocator for everything it builds, which outlives the run
# generator: the generator running
# tree:      its source's tree, checked against its record
# inputs:    the tree of each of its inputs, in their order, each checked against its record
# tables:    the tables it has opened
pub rec Context {
    alloc:     *A.Allocator;
    generator: *Generator;
    tree:      *source.Tree;
    inputs:    vector.Vector[*source.Tree];
    tables:    vector.Vector[*emit.File];
}

# the tree of the running generator's input named `name`, nil when it is given none
pub fun input(c: *Context, name: str) *source.Tree {
    var i: usize = 0;
    for (i < c.inputs.len && i < c.generator.inputs.len::usize) {
        if (str_equals(c.generator.inputs.at[i].name, name)) { ret c.inputs.data[i]; }
        i = i + 1;
    }
    ret nil;
}

# a new table `name` of the running generator's set, emitted when the generator returns
pub fun table(c: *Context, name: str) res[*emit.File, diag.Refusal] {
    val got: res[*emit.File, A.Error] = A.allocate[emit.File](c.alloc, 1);
    if (sel got.err) { ret res[*emit.File, diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, name)}; }
    @got.ok       = emit.file(c.alloc, c.generator.set, name, c.generator.name, c.generator.source);
    got.ok.inputs = c.generator.inputs;
    val pushed: res[usize, A.Error] = vector.push[*emit.File](?c.tables, got.ok);
    if (sel pushed.err) { ret res[*emit.File, diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, name)}; }
    ret res[*emit.File, diag.Refusal].ok{got.ok};
}

pub val HANDLES_MANGLE: str = "two row keys mangle to one identifier";

# the handles of the running generator's rows: table row_index, where each row's key's identifier (emit.ident) is a
# scalar constant of the row's index among the set's rows, so a consumer names a row statically and reaches it through
# masc.core.row.at. a handle is a scalar, never a pointer, which costs the object no relocation. two keys that mangle
# to one identifier are refused, naming both
# ---
# keys: each row's key, in the order of the set's rows
pub fun handles(c: *Context, keys: *vector.Vector[str]) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = table(c, "row_index");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f:     *emit.File        = opened.ok;
    var taken: map.Map[str, u32] = map.init[str, u32](c.alloc);
    var i:     usize             = 0;
    for (i < keys.len) {
        val id:    str       = emit.ident(f, keys.data[i]);
        val prior: opt[*u32] = map.get[str, u32](?taken, ?id);
        if (sel prior.some) {
            val both: res[str, StrError] = str_join(c.alloc, keys.data[@prior.some], " and ", keys.data[i]);
            if (sel both.err) { ret err[diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, keys.data[i])}; }
            ret err[diag.Refusal].err{diag.refusal(nil, 0, HANDLES_MANGLE, both.ok)};
        }
        val inserted: res[bool, A.Error] = map.insert[str, u32](?taken, id, i::u32);
        if (sel inserted.err) { ret err[diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, keys.data[i])}; }
        emit.declare(f, id, "u32", emit.Value.number{i::i64});
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}
