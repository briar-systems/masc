# the contract every set's generator implements
#
# a set's generator is one small module over the framework: it reads its
# source through the tree it is handed, maps it to rows, and emits them as
# tables it opens through `table`. it owns parsing its source and the
# meaning of its rows. the framework owns the source check before it runs,
# where each table lives and what it is called, its header, its layout, the
# decode dispatch over its rows and the drift check after it. a set's
# generator uses this module and reaches the framework through it.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;

# the framework a set's generator reads its source and emits its tables through
fwd gen.diag;
fwd gen.dispatch;
fwd gen.document;
fwd gen.emit;
fwd gen.lines;
fwd gen.source;

# one set's generator
# ---
# name:     the generator's name, as the generated headers spell it
# set:      the set it emits, the directory under src/isa its tables live in
# source:   the row of the source table it reads
# inputs:   the further rows it reads, each beside its source
# generate: reads the trees and emits the set's tables into the context
pub rec Generator {
    name:     str;
    set:      str;
    source:   *source.Source;
    inputs:   source.Refs;
    generate: fun(*Context) err[diag.Refusal];
}

# registered generators, each held by pointer
pub rec Generators {
    at:  **Generator;
    len: u32;
}

# what a generator runs with
# ---
# alloc:     allocator for everything it builds, which outlives the run
# generator: the generator running
# tree:      its source's tree, checked against its record
# inputs:    the tree of each of its inputs, in their order, each checked against its record
# tables:    the tables it has opened
pub rec Context {
    alloc:     *A.Allocator;
    generator: *Generator;
    tree:      *source.Tree;
    inputs:    vector.Vector[*source.Tree];
    tables:    vector.Vector[*emit.File];
}

# a new table `name` of the running generator's set, emitted when the generator returns
pub fun table(c: *Context, name: str) res[*emit.File, diag.Refusal] {
    val got: res[*emit.File, A.Error] = A.allocate[emit.File](c.alloc, 1);
    if (sel got.err) { ret res[*emit.File, diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, name)}; }
    @got.ok       = emit.file(c.alloc, c.generator.set, name, c.generator.name, c.generator.source);
    got.ok.inputs = c.generator.inputs;
    val pushed: res[usize, A.Error] = vector.push[*emit.File](?c.tables, got.ok);
    if (sel pushed.err) { ret res[*emit.File, diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, name)}; }
    ret res[*emit.File, diag.Refusal].ok{got.ok};
}
