# the shared reader of json sources
#
# a json source, such as the spir-v grammars, is parsed whole through the
# json library, and read through lookups that refuse what the set expects
# and does not find, naming the file, the line of the refusal where the
# document gives one, and the member. strings come back decoded, as owned
# text the set can keep.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use json;

use gen.diag;
use gen.source;

# a parsed json file of a source's tree
# ---
# file: the file it was parsed from, which its strings point into
# root: its top value
pub rec Document {
    file: *source.File;
    root: json.Value;
}

pub val SYNTAX:     str = "malformed json";
pub val DEPTH:      str = "json nests too deep";
pub val MISSING:    str = "member missing";
pub val NOT_OBJECT: str = "value is not an object";
pub val NOT_ARRAY:  str = "value is not an array";
pub val NOT_STRING: str = "value is not a string";
pub val NOT_NUMBER: str = "value is not an integer";

# the line of byte `at` of `f`
fun line_of(f: *source.File, at: usize) u32 {
    var line: u32   = 1;
    var i:    usize = 0;
    for (i < at && i < f.len) {
        if (f.data[i] == '\n') { line = line + 1; }
        i = i + 1;
    }
    ret line;
}

# the line `v` starts on, 0 when the document does not place it
fun place(d: *Document, v: *json.Value) u32 {
    if (v.kind != json.STRING) { ret 0; }
    val at: usize = v.str_val::usize - d.file.data::usize;
    ret line_of(d.file, at);
}

fun refuse[T](d: *Document, v: *json.Value, message: str, subject: str) res[T, diag.Refusal] {
    ret res[T, diag.Refusal].err{diag.refusal(d.file.path, place(d, v), message, subject)};
}

# `f` parsed as json
# ---
# a:   allocator for the document, which outlives every reader of it
# f:   the file of a source's tree
# ret: the document, or the refusal naming the line of the defect
pub fun read(a: *A.Allocator, f: *source.File) res[Document, diag.Refusal] {
    val parsed: res[json.Value, json.JsonError] = json.parse(f.data, f.len, a);
    if (sel parsed.err) {
        val e: json.JsonError = parsed.err;
        if (sel e.syntax) { ret res[Document, diag.Refusal].err{diag.refusal(f.path, line_of(f, e.syntax), SYNTAX, nil)}; }
        if (sel e.depth)  { ret res[Document, diag.Refusal].err{diag.refusal(f.path, line_of(f, e.depth), DEPTH, nil)}; }
        ret res[Document, diag.Refusal].err{diag.refusal(f.path, 0, diag.MEMORY, nil)};
    }
    ret res[Document, diag.Refusal].ok{Document{file: f, root: parsed.ok}};
}

# member `key` of object `v`
pub fun member(d: *Document, v: *json.Value, key: str) res[*json.Value, diag.Refusal] {
    if (v.kind != json.OBJECT) { ret refuse[*json.Value](d, v, NOT_OBJECT, key); }
    val found: opt[*json.Value] = json.value_find(v, key);
    if (sel found.none) { ret refuse[*json.Value](d, v, MISSING, key); }
    ret res[*json.Value, diag.Refusal].ok{found.some};
}

# member `key` of object `v`, none when it is absent
pub fun optional(d: *Document, v: *json.Value, key: str) res[opt[*json.Value], diag.Refusal] {
    if (v.kind != json.OBJECT) { ret refuse[opt[*json.Value]](d, v, NOT_OBJECT, key); }
    ret res[opt[*json.Value], diag.Refusal].ok{json.value_find(v, key)};
}

# how many items array `v` holds
pub fun count(d: *Document, v: *json.Value, subject: str) res[usize, diag.Refusal] {
    if (v.kind != json.ARRAY) { ret refuse[usize](d, v, NOT_ARRAY, subject); }
    ret res[usize, diag.Refusal].ok{v.count};
}

# item `i` of array `v`, which `count` has bounded
pub fun item(v: *json.Value, i: usize) *json.Value {
    ret ?v.children[i];
}

# the decoded text of string `v`, owned
pub fun text(a: *A.Allocator, d: *Document, v: *json.Value, subject: str) res[str, diag.Refusal] {
    if (v.kind != json.STRING) { ret refuse[str](d, v, NOT_STRING, subject); }
    val got: res[*u8, A.Error] = A.allocate[u8](a, v.str_len + 1);
    if (sel got.err) { ret res[str, diag.Refusal].err{diag.refusal(d.file.path, place(d, v), diag.MEMORY, subject)}; }
    val decoded: res[usize, json.JsonError] = json.value_string_decode(v, got.ok, v.str_len);
    if (sel decoded.err) { ret refuse[str](d, v, SYNTAX, subject); }
    got.ok[decoded.ok] = 0;
    ret res[str, diag.Refusal].ok{got.ok};
}

# the integer `v`
pub fun integer(d: *Document, v: *json.Value, subject: str) res[i64, diag.Refusal] {
    if (v.kind != json.NUMBER || json.value_is_float(v)) { ret refuse[i64](d, v, NOT_NUMBER, subject); }
    ret res[i64, diag.Refusal].ok{json.value_number(v)};
}
