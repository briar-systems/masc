# the decode dispatch keys of a set whose instructions are one word, read from its keys topic and written as gen_key
#
# each line of a set's gen/data/<set>/keys.txt is a key, `key <name> | lo=<bit>
# len=<bits>`, in the order the dispatch prefers them. the generator builds the
# dispatch over them in process and writes their positions and names, which
# masc's key module of the set forwards and reads.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;

use gen.diag;
use gen.dispatch;
use gen.emit;
use gen.overlay;
use gen.set;

pub val TOPIC: str = "keys";

pub val BAD_KEY: str = "keys line is not `key <name> | lo=<bit> len=<bits>`";
pub val WIDE:    str = "key reads past an instruction's 32 bits";
pub val NO_KEYS: str = "keys topic states no key";

# the keys in preference order, each over the instruction's one word
pub rec Keys {
    keys: vector.Vector[dispatch.Key];
}

# the keys topic `t` read into `out`
pub fun read(a: *A.Allocator, t: *overlay.Topic, out: *Keys) err[diag.Refusal] {
    out.keys = vector.init[dispatch.Key](a);
    val checked: err[diag.Refusal] = overlay.check(t, nil, overlay.unstated);
    if (sel checked.err) { ret checked; }
    var i: usize = 0;
    for (i < t.facts.len) {
        val f: *overlay.Fact = ?t.facts.data[i];
        val k: str           = f.key;
        if (str_len(k) < 5 || k[0] != 'k' || k[1] != 'e' || k[2] != 'y' || k[3] != ' ') { ret err[diag.Refusal].err{overlay.refuse(f, BAD_KEY, k)}; }
        val ws: res[vector.Vector[str], diag.Refusal] = overlay.words(a, f, f.fact);
        if (sel ws.err)     { ret err[diag.Refusal].err{ws.err}; }
        if (ws.ok.len != 2) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_KEY, f.fact)}; }
        val lo:  opt[str] = overlay.value(?ws.ok, "lo");
        val len: opt[str] = overlay.value(?ws.ok, "len");
        if (sel lo.none)  { ret err[diag.Refusal].err{overlay.refuse(f, BAD_KEY, f.fact)}; }
        if (sel len.none) { ret err[diag.Refusal].err{overlay.refuse(f, BAD_KEY, f.fact)}; }
        val l: res[i64, diag.Refusal] = overlay.number(f, lo.some);
        val n: res[i64, diag.Refusal] = overlay.number(f, len.some);
        if (sel l.err)                                { ret err[diag.Refusal].err{l.err}; }
        if (sel n.err)                                { ret err[diag.Refusal].err{n.err}; }
        if (l.ok < 0 || n.ok < 1 || l.ok + n.ok > 32) { ret err[diag.Refusal].err{overlay.refuse(f, WIDE, k)}; }
        val pushed: res[usize, A.Error] = vector.push[dispatch.Key](?out.keys, dispatch.Key{name: ?k[4], word: 0, lo: l.ok::u8, len: n.ok::u8});
        if (sel pushed.err) { ret err[diag.Refusal].err{overlay.refuse(f, diag.MEMORY, nil)}; }
        i = i + 1;
    }
    if (out.keys.len == 0) { ret err[diag.Refusal].err{diag.refusal(t.path, 0, NO_KEYS, nil)}; }
    ret err[diag.Refusal].ok{};
}

# the keys written as gen_key: their positions and their names, in preference order
# ---
# bits:     the use line of the set's module that states the position record, as `riscv_bits: masc.isa.riscv.bits`
# position: the position record's path under that use, as `riscv_bits.Position`, of members `lo` and `len`
pub fun generate(c: *set.Context, ks: *Keys, bits: str, position: str) err[diag.Refusal] {
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "key");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f: *emit.File = opened.ok;
    emit.uses(f, bits);
    val positions: *emit.Array = emit.array(f, position);
    val names:     *emit.Array = emit.array(f, "str");
    var i:         usize       = 0;
    for (i < ks.keys.len) {
        val k: *dispatch.Key = ?ks.keys.data[i];
        val r: *emit.Record  = emit.record(f, position);
        emit.member(f, r, "lo", emit.Value.number{k.lo::i64});
        emit.member(f, r, "len", emit.Value.number{k.len::i64});
        emit.item(f, positions, emit.Value.record{r});
        emit.item(f, names, emit.Value.text{k.name});
        i = i + 1;
    }
    emit.declare_array(f, "POSITIONS", positions);
    emit.declare_array(f, "NAMES", names);
    emit.uses(f, "std.types.string.str");
    ret err[diag.Refusal].ok{};
}
