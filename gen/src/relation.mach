# the value relations an overlay states, read and emitted alike for every set (masc.core.effect.Relation)
#
# a set's effects topic states a relation of its rows in these words, each operand named as the set names its
# operands: risc-v by its argument, the stack pointer an implicit line places by its register's name, aarch64 by its
# assembly rule, and x86 by its XED operand number
#
#   to=<operand> from=<operand> [by=<operand>] [negated=yes] [shift=<operand> step=<bits>] [constant=<n>] [when]
#   to=<operand> from=<operand> plus=<operand> [negated=yes] [shift=<operand> step=<bits>] [when]
#   to=<operand> from=<operand> transferred=yes
#   to=<operand> base=<operand> [constant=<n>]
#   to=<operand> formed=<operand>
#   to=<operand> number=<operand> [shift=<operand>] [step=<bits>] [extend=<bits>] [inverted=yes]
#   to=<operand> from=<operand> combined=<add|or|and|shl|insert> by=<operand> [shift=<operand> step=<bits>]
#                [width=<bits>] [extend=<bits>]
#
# where [when] is `when=<operand> equals=<n>`, and an operand may be named by alternatives apart by a `/`, the first
# a row has taken.
#
# `to` is the register written, `from` the register read and `by` the immediate added, subtracted with `negated=yes`,
# and shifted left by `step` bits for each unit of the value of `shift`. `plus` adds the value of a register
# operand, which states no number, as aarch64's post-index `x1`, shifted and negated as an immediate is, as aarch64's
# `add x0, x1, x2, lsl #3` and risc-v sub, and `transferred` adds the bytes the row's one access transfers, as
# aarch64's post-index `#16`, which the set fills into `constant` before `resolve`. `when` names an operand whose value
# must be `equals` for the relation to hold at all, as the shift type of aarch64's shifted register add, lsl being 0.
# `base` starts from the base of a memory operand and adds its displacement, as x86 lea. `formed` states the register
# holds what the row forms from that operand and its own address alone, as risc-v auipc and aarch64 adrp
# (effect.Holds.formed). `number` states the register holds that operand's value alone, shifted left by `step` bits for
# each unit of the value of `shift`, or by `step` bits with no shift, complemented with `inverted=yes`, and
# sign-extended from bit `extend` - 1, as risc-v lui and aarch64 movz and movn (effect.Holds.number). `combined`
# states the register holds the one read combined with the immediate `by`, shifted as an addend is, by a sum, an or,
# an and, a left shift of the register by the immediate, or an insert of `width` bits at the shift, sign-extended from
# bit `extend` - 1, as risc-v addiw and slli and aarch64 orr and movk (effect.Holds.combined), which a reader follows
# only through a register holding a number. masc's set check holds each relation to its row

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use std.collections.vector;

use masc.core.effect;
use masc.core.field;

use gen.diag;
use gen.emit;
use gen.overlay;

pub val BAD_OFFSET: str = "offset line states no to, not exactly one of from, base, formed and number, a by beside base, anything beside formed, more beside transferred than a from, beside plus anything but a from, a negation, a shift and step and a condition, beside number anything but a shift, a step, an extend and an inversion, beside combined anything but a from, a by, a shift and step, a width and an extend, a width beside any combination but insert or none beside insert, a condition beside anything but an offset, a shift and step not together but beside number, or a when and equals not together";
pub val NO_NAMED:   str = "offset line names an operand the row does not have";

# an offset line read, its operands by the set's names
# ---
# to:          the register written
# from:        the register read, nil when base is given
# base:        the memory operand whose base is read and whose displacement is added, nil when from is given
# formed:      the operand the value is formed from with the instruction's address alone, nil for none
# number:      the operand the value is built from alone, nil for none
# combined:    how the register read combines with the immediate `by`, nil for none
# extend:      the bits a number or a combination is sign-extended from, 0 for none
# width:       the bits an insert replaces, 0 for none
# inverted:    whether a number is complemented
# by:          the immediate added, nil for none
# plus:        the register operand added, nil for none
# transferred: whether the bytes the row's access transfers are added
# shift:       the operand whose value times step shifts the immediate, nil for none
# step:        the bits each unit of shift shifts by
# negated:     whether the immediate is subtracted
# constant:    a number added whatever the operands
# when:        the operand whose value must be `equals` for the relation to hold, nil for none
# equals:      the value `when` must hold
pub rec Stated {
    to:          str;
    from:        str;
    base:        str;
    formed:      str;
    number:      str;
    combined:    str;
    extend:      u8;
    width:       u8;
    inverted:    bool;
    by:          str;
    plus:        str;
    transferred: bool;
    shift:       str;
    step:        u8;
    negated:     bool;
    constant:    i64;
    when:        str;
    equals:      i64;
}

val NAMES: [18]str = [18]str{"to", "from", "base", "formed", "number", "combined", "extend", "width", "inverted", "by", "plus", "transferred", "shift", "step", "negated", "constant", "when", "equals"};

# whether word `w` is a named value of NAMES
fun named(w: str) bool {
    var k: usize = 0;
    for (k < 18) {
        val n:   str   = NAMES[k];
        val len: usize = str_len(n);
        if (str_len(w) > len && w[len] == '=') {
            var same: bool  = true;
            var c:    usize = 0;
            for (c < len) {
                if (w[c] != n[c]) { same = false; }
                c = c + 1;
            }
            if (same) { ret true; }
        }
        k = k + 1;
    }
    ret false;
}

# the bits word `word` of line `l` names, refused outside 1 to 63
fun bits_of(l: *overlay.Line, word: str, out: *u8) err[diag.Refusal] {
    val res_n: res[i64, diag.Refusal] = overlay.number(l.fact, word);
    if (sel res_n.err)                  { ret err[diag.Refusal].err{res_n.err}; }
    if (res_n.ok <= 0 || res_n.ok > 63) { ret overlay.reject(l, BAD_OFFSET, word); }
    @out = res_n.ok::u8;
    ret err[diag.Refusal].ok{};
}

# the shift and step of line `l` into `out`, together or neither unless `alone` lets a step stand without a shift, and
# how many words they take
fun shifted(l: *overlay.Line, out: *Stated, alone: bool, words: *usize) err[diag.Refusal] {
    val step: opt[str] = overlay.value(?l.ws, "step");
    if (out.shift != nil && sel step.none)           { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
    if (out.shift == nil && sel step.some && !alone) { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
    if (out.shift != nil)                            { @words = @words + 1; }
    if (sel step.some) {
        val err_step: err[diag.Refusal] = bits_of(l, step.some, ?out.step);
        if (sel err_step.err) { ret err_step; }
        @words = @words + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the condition of line `l` into `out`, a when and an equals together or neither, and how many words it takes
fun conditioned(l: *overlay.Line, out: *Stated, words: *usize) err[diag.Refusal] {
    val equals: opt[str] = overlay.value(?l.ws, "equals");
    if ((out.when == nil) != (sel equals.none)) { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
    if (sel equals.some) {
        val res_n: res[i64, diag.Refusal] = overlay.number(l.fact, equals.some);
        if (sel res_n.err) { ret err[diag.Refusal].err{res_n.err}; }
        out.equals = res_n.ok;
        @words     = @words + 2;
    }
    ret err[diag.Refusal].ok{};
}

# the extend of line `l` into `out`, and how many words it takes
fun extending(l: *overlay.Line, out: *Stated, words: *usize) err[diag.Refusal] {
    val extend: opt[str] = overlay.value(?l.ws, "extend");
    if (sel extend.none) { ret err[diag.Refusal].ok{}; }
    @words = @words + 1;
    ret bits_of(l, extend.some, ?out.extend);
}

# the words of line `l`'s fact from `from` on read as an offset into `out`
pub fun read(l: *overlay.Line, from: usize, out: *Stated) err[diag.Refusal] {
    var i: usize = from;
    for (i < l.ws.len) {
        if (!named(l.ws.data[i])) { ret overlay.reject(l, overlay.UNKNOWN_WORD, l.ws.data[i]); }
        i = i + 1;
    }
    @out = Stated{to: nil, from: overlay.optional(l, "from", nil), base: overlay.optional(l, "base", nil), formed: overlay.optional(l, "formed", nil), number: overlay.optional(l, "number", nil), combined: overlay.optional(l, "combined", nil), extend: 0, width: 0, inverted: false, by: overlay.optional(l, "by", nil), plus: overlay.optional(l, "plus", nil), shift: overlay.optional(l, "shift", nil), step: 0, negated: false, constant: 0, when: overlay.optional(l, "when", nil), equals: 0};
    val to: err[diag.Refusal] = overlay.needed(l, "to", ?out.to);
    if (sel to.err) { ret to; }
    var sources: u32 = 0;
    if (out.from != nil)                                    { sources = sources + 1; }
    if (out.base != nil)                                    { sources = sources + 1; }
    if (out.formed != nil)                                  { sources = sources + 1; }
    if (out.number != nil)                                  { sources = sources + 1; }
    if (sources != 1 || (out.base != nil && out.by != nil)) { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
    if (out.number != nil)                                  { ret numbered(l, from, out); }
    if (out.formed != nil) {
        # a formed value takes no addend, shift or constant: the relocation states it whole
        if (l.ws.len - from != 2) { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
        ret err[diag.Refusal].ok{};
    }
    if (out.combined != nil) { ret combining(l, from, out); }
    var words:    usize             = 2;
    val err_when: err[diag.Refusal] = conditioned(l, out, ?words);
    if (sel err_when.err) { ret err_when; }
    val transferred: res[bool, diag.Refusal] = overlay.yes(l, "transferred", false);
    if (sel transferred.err) { ret err[diag.Refusal].err{transferred.err}; }
    out.transferred = transferred.ok;
    if (out.transferred) {
        # the transferred bytes are the whole of what is added, so they take nothing beside them
        if (out.from == nil || out.plus != nil || out.when != nil || l.ws.len - from != 3) { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
        ret err[diag.Refusal].ok{};
    }
    val negated: res[bool, diag.Refusal] = overlay.yes(l, "negated", false);
    if (sel negated.err) { ret err[diag.Refusal].err{negated.err}; }
    out.negated = negated.ok;
    if (out.negated) { words = words + 1; }
    val err_shift: err[diag.Refusal] = shifted(l, out, false, ?words);
    if (sel err_shift.err) { ret err_shift; }
    if (out.plus != nil) {
        # a register addend states no number, so it takes no immediate or constant beside it
        if (out.from == nil || out.by != nil || l.ws.len - from != words + 1) { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
        ret err[diag.Refusal].ok{};
    }
    val extend:   opt[str] = overlay.value(?l.ws, "extend");
    val width:    opt[str] = overlay.value(?l.ws, "width");
    val inverted: opt[str] = overlay.value(?l.ws, "inverted");
    if (sel extend.some || sel width.some || sel inverted.some) { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
    val constant: opt[str] = overlay.value(?l.ws, "constant");
    if (sel constant.some) {
        val n: res[i64, diag.Refusal] = overlay.number(l.fact, constant.some);
        if (sel n.err) { ret err[diag.Refusal].err{n.err}; }
        out.constant = n.ok;
    }
    ret err[diag.Refusal].ok{};
}

# the combination, shift, width and extend of a combined line `l` into `out`, nothing else beside its to, from and by
fun combining(l: *overlay.Line, from: usize, out: *Stated) err[diag.Refusal] {
    if (out.from == nil || out.by == nil || out.plus != nil || out.when != nil) { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
    var words:     usize             = 4;
    val err_shift: err[diag.Refusal] = shifted(l, out, false, ?words);
    if (sel err_shift.err) { ret err_shift; }
    val width: opt[str] = overlay.value(?l.ws, "width");
    if (sel width.some) {
        val err_width: err[diag.Refusal] = bits_of(l, width.some, ?out.width);
        if (sel err_width.err) { ret err_width; }
        words = words + 1;
    }
    val insert: bool = str_equals(out.combined, "insert");
    if (insert != (sel width.some))                                                                                                                             { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
    if (!insert && !str_equals(out.combined, "add") && !str_equals(out.combined, "or") && !str_equals(out.combined, "and") && !str_equals(out.combined, "shl")) { ret overlay.reject(l, BAD_OFFSET, out.combined); }
    val err_extend: err[diag.Refusal] = extending(l, out, ?words);
    if (sel err_extend.err)       { ret err_extend; }
    if (l.ws.len - from != words) { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
    ret err[diag.Refusal].ok{};
}

# the shift, step, extend and inversion of a number line `l` into `out`, nothing else beside its to and number
fun numbered(l: *overlay.Line, from: usize, out: *Stated) err[diag.Refusal] {
    if (out.by != nil || out.plus != nil || out.when != nil) { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
    var words:     usize             = 2;
    val err_shift: err[diag.Refusal] = shifted(l, out, true, ?words);
    if (sel err_shift.err) { ret err_shift; }
    val err_extend: err[diag.Refusal] = extending(l, out, ?words);
    if (sel err_extend.err) { ret err_extend; }
    val inverted: res[bool, diag.Refusal] = overlay.yes(l, "inverted", false);
    if (sel inverted.err) { ret err[diag.Refusal].err{inverted.err}; }
    out.inverted = inverted.ok;
    if (out.inverted)             { words = words + 1; }
    if (l.ws.len - from != words) { ret overlay.reject(l, BAD_OFFSET, l.fact.key); }
    ret err[diag.Refusal].ok{};
}

# the operand of a row a set names `name`, field.NO_OPERAND when it has none
pub def Find: fun(ptr, str) u8;

# the operand `name` names through `find`, the name itself in `missing` when it names none. a name may list
# alternatives apart by a `/`, the first the row has taken, as the immediate of risc-v c.slli is c_nzuimm6hi in rv64's
# row and c_nzuimm6lo in rv32's
fun found(ctx: ptr, find: Find, name: str, missing: *str) u8 {
    var one:   [64]u8;
    var start: usize = 0;
    val len:   usize = str_len(name);
    for (start <= len) {
        var end: usize = start;
        for (end < len && name[end] != '/') { end = end + 1; }
        if (end - start < 64) {
            var k: usize = 0;
            for (k < end - start) {
                one[k] = name[start + k];
                k      = k + 1;
            }
            one[end - start] = 0;
            val at: u8 = find(ctx, ?one[0]);
            if (at != field.NO_OPERAND) { ret at; }
        }
        start = end + 1;
    }
    @missing = name;
    ret field.NO_OPERAND;
}

# offset `st` of a row as a relation, its operands found through `find`, or the first name that names none, or
# `transferred` where the set has not filled the bytes its row's access transfers
pub fun resolve(st: *Stated, ctx: ptr, find: Find) res[effect.Relation, str] {
    if (st.transferred) { ret res[effect.Relation, str].err{"transferred"}; }
    var missing: str = nil;
    val to:      u8  = found(ctx, find, st.to, ?missing);
    var shift:   u8  = field.NO_OPERAND;
    if (st.shift != nil) { shift = found(ctx, find, st.shift, ?missing); }
    if (st.formed != nil) {
        val formed: u8 = found(ctx, find, st.formed, ?missing);
        if (missing != nil) { ret res[effect.Relation, str].err{missing}; }
        ret res[effect.Relation, str].ok{effect.Relation{to: effect.Place.operand{to}, holds: effect.Holds.formed{formed}}};
    }
    if (st.number != nil) {
        val built: u8 = found(ctx, find, st.number, ?missing);
        if (missing != nil) { ret res[effect.Relation, str].err{missing}; }
        ret res[effect.Relation, str].ok{effect.Relation{to: effect.Place.operand{to}, holds: effect.Holds.number{effect.Number{operand: built, shift: shift, step: st.step, extend: st.extend, inverted: st.inverted}}}};
    }
    if (st.combined != nil) {
        val read: u8 = found(ctx, find, st.from, ?missing);
        val imm:  u8 = found(ctx, find, st.by, ?missing);
        if (missing != nil) { ret res[effect.Relation, str].err{missing}; }
        var by: effect.Combination = effect.ADD;
        if (str_equals(st.combined, "or"))     { by = effect.OR; }
        or (str_equals(st.combined, "and"))    { by = effect.AND; }
        or (str_equals(st.combined, "shl"))    { by = effect.SHL; }
        or (str_equals(st.combined, "insert")) { by = effect.INSERT; }
        val c: effect.Combined = effect.Combined{from: effect.Source.operand{read}, operand: imm, by: by, shift: shift, step: st.step, width: st.width, extend: st.extend};
        ret res[effect.Relation, str].ok{effect.Relation{to: effect.Place.operand{to}, holds: effect.Holds.combined{c}}};
    }
    var from: effect.Source = effect.Source.operand{0};
    var by:   effect.Addend = effect.Addend.none{};
    if (st.base != nil) {
        val base: u8 = found(ctx, find, st.base, ?missing);
        from = effect.Source.base{base};
        by   = effect.Addend.displacement{base};
    }
    or                  { from = effect.Source.operand{found(ctx, find, st.from, ?missing)}; }
    if (st.by != nil)   { by = effect.Addend.immediate{found(ctx, find, st.by, ?missing)}; }
    if (st.plus != nil) { by = effect.Addend.held{found(ctx, find, st.plus, ?missing)}; }
    var when: u8 = field.NO_OPERAND;
    if (st.when != nil) { when = found(ctx, find, st.when, ?missing); }
    if (missing != nil) { ret res[effect.Relation, str].err{missing}; }
    val o: effect.Offset = effect.Offset{from: from, by: by, negated: st.negated, shift: shift, step: st.step, constant: st.constant, when: when, equals: st.equals};
    ret res[effect.Relation, str].ok{effect.Relation{to: effect.Place.operand{to}, holds: effect.Holds.offset{o}}};
}

fun number(n: i64) emit.Value {
    ret emit.Value.number{n};
}

fun place(f: *emit.File, p: *effect.Place) emit.Value {
    if (sel p.row)     { ret emit.Value.variant{emit.variant(f, "effect.Place.row", number(p.row::i64))}; }
    if (sel p.operand) { ret emit.Value.variant{emit.variant(f, "effect.Place.operand", number(p.operand::i64))}; }
    ret emit.Value.name{"nil"};
}

fun source(f: *emit.File, s: *effect.Source) emit.Value {
    if (sel s.row)     { ret emit.Value.variant{emit.variant(f, "effect.Source.row", number(s.row::i64))}; }
    if (sel s.base)    { ret emit.Value.variant{emit.variant(f, "effect.Source.base", number(s.base::i64))}; }
    if (sel s.operand) { ret emit.Value.variant{emit.variant(f, "effect.Source.operand", number(s.operand::i64))}; }
    ret emit.Value.name{"nil"};
}

fun addend(f: *emit.File, a: *effect.Addend) emit.Value {
    if (sel a.immediate)    { ret emit.Value.variant{emit.variant(f, "effect.Addend.immediate", number(a.immediate::i64))}; }
    if (sel a.displacement) { ret emit.Value.variant{emit.variant(f, "effect.Addend.displacement", number(a.displacement::i64))}; }
    if (sel a.held)         { ret emit.Value.variant{emit.variant(f, "effect.Addend.held", number(a.held::i64))}; }
    ret emit.Value.variant{emit.bare(f, "effect.Addend.none")};
}

# relation `r` as a literal
pub fun value(f: *emit.File, r: *effect.Relation) emit.Value {
    val x: *emit.Record = emit.record(f, "effect.Relation");
    emit.member(f, x, "to", place(f, ?r.to));
    if (sel r.holds.offset) { emit.member(f, x, "holds", emit.Value.variant{emit.variant(f, "effect.Holds.offset", offset(f, ?r.holds.offset))}); }
    if (sel r.holds.formed) { emit.member(f, x, "holds", emit.Value.variant{emit.variant(f, "effect.Holds.formed", number(r.holds.formed::i64))}); }
    if (sel r.holds.number) {
        val n:  effect.Number = r.holds.number;
        val nr: *emit.Record  = emit.record(f, "effect.Number");
        emit.member(f, nr, "operand", number(n.operand::i64));
        emit.member(f, nr, "shift", operand_of(n.shift));
        emit.member(f, nr, "step", number(n.step::i64));
        emit.member(f, nr, "extend", number(n.extend::i64));
        emit.member(f, nr, "inverted", truth(n.inverted));
        emit.member(f, x, "holds", emit.Value.variant{emit.variant(f, "effect.Holds.number", emit.Value.record{nr})});
    }
    if (sel r.holds.combined) {
        val c:  effect.Combined = r.holds.combined;
        val cr: *emit.Record    = emit.record(f, "effect.Combined");
        emit.member(f, cr, "from", source(f, ?c.from));
        emit.member(f, cr, "operand", number(c.operand::i64));
        emit.member(f, cr, "by", emit.Value.name{combination(c.by)});
        emit.member(f, cr, "shift", operand_of(c.shift));
        emit.member(f, cr, "step", number(c.step::i64));
        emit.member(f, cr, "width", number(c.width::i64));
        emit.member(f, cr, "extend", number(c.extend::i64));
        emit.member(f, x, "holds", emit.Value.variant{emit.variant(f, "effect.Holds.combined", emit.Value.record{cr})});
    }
    ret emit.Value.record{x};
}

# the name of combination `c`
fun combination(c: effect.Combination) str {
    if (c == effect.OR)     { ret "effect.OR"; }
    if (c == effect.AND)    { ret "effect.AND"; }
    if (c == effect.SHL)    { ret "effect.SHL"; }
    if (c == effect.INSERT) { ret "effect.INSERT"; }
    ret "effect.ADD";
}

# operand index `op` as a literal, field.NO_OPERAND by its name
fun operand_of(op: u8) emit.Value {
    if (op == field.NO_OPERAND) { ret emit.Value.name{"field.NO_OPERAND"}; }
    ret number(op::i64);
}

fun truth(b: bool) emit.Value {
    if (b) { ret emit.Value.name{"true"}; }
    ret emit.Value.name{"false"};
}

# offset `o` as a literal
fun offset(f: *emit.File, o: *effect.Offset) emit.Value {
    val of: *emit.Record = emit.record(f, "effect.Offset");
    emit.member(f, of, "from", source(f, ?o.from));
    emit.member(f, of, "by", addend(f, ?o.by));
    emit.member(f, of, "negated", truth(o.negated));
    emit.member(f, of, "shift", operand_of(o.shift));
    emit.member(f, of, "step", number(o.step::i64));
    emit.member(f, of, "constant", number(o.constant));
    emit.member(f, of, "when", operand_of(o.when));
    emit.member(f, of, "equals", number(o.equals));
    ret emit.Value.record{of};
}

# relations `rs` as a run of the array RELATIONS that `pool` fills, effect.NO_RELATIONS for none
pub fun values(f: *emit.File, pool: *emit.Pool, rs: *vector.Vector[effect.Relation]) emit.Value {
    if (rs.len == 0) { ret emit.Value.name{"effect.NO_RELATIONS"}; }
    var items: vector.Vector[emit.Value] = vector.init[emit.Value](f.alloc);
    var i:     usize                     = 0;
    for (i < rs.len) {
        vector.push[emit.Value](?items, value(f, ?rs.data[i]));
        i = i + 1;
    }
    val at: u32          = emit.pooled(f, pool, items.data, items.len::u32);
    val r:  *emit.Record = emit.record(f, "effect.Relations");
    emit.member(f, r, "at", emit.element(f, "RELATIONS", at));
    emit.member(f, r, "len", number(rs.len::i64));
    ret emit.Value.record{r};
}
