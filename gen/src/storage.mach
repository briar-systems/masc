# the storage tables of a register file, shared by every set's register generator: each row's lying list and the view of
# each pair of classes
#
# a row's lying list holds every other row that `register.lies` within it, with that placement, and a pair of classes
# is a view by the rule `register.View` states. both depend only on the file's storage facts, so they are derived here
# once rather than by every query of a consumer. rows of two banks never lie within one another, but a tuple's storage
# is its members', so a row is compared only with the rows of its bank, or of its members' banks for a tuple.
#
# a generator that keeps its own model of the file states the facts `register.lies` reads, its quantities, slot
# bindings, class widths and row footprints, in a file `blank` makes, and leaves the rest of it unstated.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.map;
use std.collections.sort;
use std.collections.vector;

use masc.core.index;
use masc.core.quantity;
use masc.core.register;
use masc.core.requirement;

use gen.diag;
use gen.emit;
use gen.handles;

# the lying lists and views of a file, laid out as `register.File` states them
# ---
# lying: every row's lying list, end to end in row order
# first: register_count + 1 offsets into lying
# views: class_count * class_count entries, the pair (part, whole) at part * class_count + whole
pub rec Tables {
    lying: vector.Vector[register.Lying];
    first: vector.Vector[u32];
    views: vector.Vector[register.View];
}

# rows grouped by a key, as offsets into one array of rows: the rows of key k are rows[first[k] .. first[k + 1]], each
# group in row order
rec Groups {
    first: *u32;
    rows:  *u32;
}

fun memory() diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, nil);
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# a file of `quantities` quantities, `bindings` slot bindings, `classes` classes and `rows` register rows, each zero, for
# a generator to state its storage facts in
pub fun blank(a: *A.Allocator, quantities: u32, bindings: u32, classes: u32, rows: u32) res[register.File, diag.Refusal] {
    val qs: res[*quantity.Quantity, A.Error] = A.zallocate[quantity.Quantity](a, quantities::usize + 1);
    if (sel qs.err) { ret res[register.File, diag.Refusal].err{memory()}; }
    val bs: res[*quantity.Binding, A.Error] = A.zallocate[quantity.Binding](a, bindings::usize + 1);
    if (sel bs.err) { ret res[register.File, diag.Refusal].err{memory()}; }
    val cs: res[*register.Class, A.Error] = A.zallocate[register.Class](a, classes::usize + 1);
    if (sel cs.err) { ret res[register.File, diag.Refusal].err{memory()}; }
    val rs: res[*register.Register, A.Error] = A.zallocate[register.Register](a, rows::usize + 1);
    if (sel rs.err) { ret res[register.File, diag.Refusal].err{memory()}; }
    ret res[register.File, diag.Refusal].ok{register.File{
        quantities:     quantity.Quantities{at: qs.ok, len: quantities},
        bindings:       quantity.Bindings{at: bs.ok, len: bindings},
        slot_count:     0,
        classes:        cs.ok,
        class_count:    classes,
        class_names:    index.NO_ENTRIES,
        registers:      rs.ok,
        register_count: rows,
        aliases:        nil,
        alias_count:    0,
        names:          index.NO_ENTRIES,
        columns:        nil,
        column_count:   0,
        lying:          nil,
        lying_first:    nil,
        views:          nil,
    }};
}

# an amount of `fixed` plus `per` times the multiplier of slot `scale`
pub fun scaled(fixed: u32, per: u32, scale: u8) quantity.Scaled {
    ret quantity.Scaled{fixed: fixed, per: per, scale: scale};
}

# quantity `name` of `unit` bits times a power of two up to `max`
pub fun powers(name: str, unit: u32, max: u32) quantity.Quantity {
    ret quantity.Quantity{name: name, unit: unit, domain: quantity.Domain.powers{quantity.Range{least: 1, most: max}}, bounds: quantity.NO_BOUNDS, gauges: quantity.NO_GAUGES};
}

# slot `slot` bound to quantity `q`, under any requirement, which no storage fact reads
pub fun binding(slot: u32, q: u32) quantity.Binding {
    ret quantity.Binding{slot: slot::u8, when: requirement.NO_ALTERNATIVES, quantity: q::u8};
}

# the rows of `file` grouped by class where `by_class` holds, else by bank with tuples left out, keys below `keys`
fun group(a: *A.Allocator, keys: u32, file: *register.File, by_class: bool) res[Groups, diag.Refusal] {
    val first: res[*u32, A.Error] = A.zallocate[u32](a, keys::usize + 1);
    if (sel first.err) { ret res[Groups, diag.Refusal].err{memory()}; }
    val count: u32                = file.register_count;
    val rows:  res[*u32, A.Error] = A.allocate[u32](a, count::usize + 1);
    if (sel rows.err) { ret res[Groups, diag.Refusal].err{memory()}; }
    var i: u32 = 0;
    for (i < count) {
        val r: *register.Register = ?file.registers[i];
        if (by_class)           { first.ok[r.class::u32 + 1] = first.ok[r.class::u32 + 1] + 1; }
        or (!register.tuple(r)) { first.ok[r.bank::u32 + 1] = first.ok[r.bank::u32 + 1] + 1; }
        i = i + 1;
    }
    val put: res[*u32, A.Error] = A.allocate[u32](a, keys::usize + 1);
    if (sel put.err) { ret res[Groups, diag.Refusal].err{memory()}; }
    var k: u32 = 0;
    for (k < keys) {
        put.ok[k]       = first.ok[k];
        first.ok[k + 1] = first.ok[k + 1] + first.ok[k];
        k               = k + 1;
    }
    i = 0;
    for (i < count) {
        val r:   *register.Register = ?file.registers[i];
        var key: u32                = r.bank::u32;
        if (by_class) { key = r.class::u32; }
        if (by_class || !register.tuple(r)) {
            rows.ok[put.ok[key]] = i;
            put.ok[key]          = put.ok[key] + 1;
        }
        i = i + 1;
    }
    ret res[Groups, diag.Refusal].ok{Groups{first: first.ok, rows: rows.ok}};
}

fun by_row(a: *u32, b: *u32) i64 {
    if (@a < @b) { ret -1; }
    if (@a > @b) { ret 1; }
    ret 0;
}

# the rows that may lie within row `w`: the rows of its bank, or of its members' banks for a tuple, in row order
fun candidates(file: *register.File, banks: *Groups, w: u32, out: *vector.Vector[u32]) err[diag.Refusal] {
    out.len = 0;
    val whole: *register.Register = ?file.registers[w];
    var k:     u32                = 0;
    var n:     u32                = 1;
    if (register.tuple(whole)) { n = whole.members.len; }
    for (k < n) {
        var bank: u32 = whole.bank::u32;
        if (register.tuple(whole)) { bank = file.registers[whole.members.at[k]].bank::u32; }
        var j: u32 = banks.first[bank];
        for (j < banks.first[bank + 1]) {
            if (!pushed(vector.push[u32](out, banks.rows[j]))) { ret err[diag.Refusal].err{memory()}; }
            j = j + 1;
        }
        k = k + 1;
    }
    if (n > 1) {
        sort.sort_by[u32](out.data, out.len, by_row);
        var kept: usize = 0;
        var i:    usize = 0;
        for (i < out.len) {
            if (kept == 0 || out.data[kept - 1] != out.data[i]) {
                out.data[kept] = out.data[i];
                kept           = kept + 1;
            }
            i = i + 1;
        }
        out.len = kept;
    }
    ret err[diag.Refusal].ok{};
}

# every entry of a file's lying lists grouped by the row it names: row p's are entry[first[p] .. first[p + 1]], each
# an index into the lying entries, held by the row of `by` at the same index
rec Held {
    first: *u32;
    entry: *u32;
    by:    *u32;
}

# the view of class `part` within class `whole`, NO_VIEW when the pair is no view
fun view(file: *register.File, t: *Tables, classes: *Groups, held: *Held, part: u32, whole: u32) register.View {
    if (part == whole || classes.first[part] == classes.first[part + 1]) { ret register.NO_VIEW; }
    var found: register.View = register.NO_VIEW;
    var i:     u32           = classes.first[part];
    for (i < classes.first[part + 1]) {
        val p:   u32                = classes.rows[i];
        var hit: u32                = register.NO_ROW;
        var at:  register.Placement = register.NO_PLACEMENT;
        var h:   u32                = held.first[p];
        for (h < held.first[p + 1]) {
            val w: u32 = held.by[h];
            if (file.registers[w].class::u32 == whole) {
                if (hit != register.NO_ROW) { ret register.NO_VIEW; }
                hit = w;
                at  = t.lying.data[held.entry[h]].placement;
            }
            h = h + 1;
        }
        if (hit == register.NO_ROW)                        { ret register.NO_VIEW; }
        if (found.part == register.NO_ROW)                 { found = register.View{placement: at, part: p, whole: hit}; }
        or (!register.same_placement(found.placement, at)) { ret register.NO_VIEW; }
        i = i + 1;
    }
    i = classes.first[whole];
    for (i < classes.first[whole + 1]) {
        val w:     u32 = classes.rows[i];
        var count: u32 = 0;
        var e:     u32 = t.first.data[w];
        for (e < t.first.data[w + 1]) {
            if (file.registers[t.lying.data[e].row].class::u32 == part) { count = count + 1; }
            e = e + 1;
        }
        if (count != 1) { ret register.NO_VIEW; }
        i = i + 1;
    }
    ret found;
}

# the entries of lists `t` of `n` rows grouped by the row each names
fun hold(a: *A.Allocator, t: *Tables, n: u32) res[Held, diag.Refusal] {
    val first: res[*u32, A.Error] = A.zallocate[u32](a, n::usize + 1);
    if (sel first.err) { ret res[Held, diag.Refusal].err{memory()}; }
    val entry: res[*u32, A.Error] = A.allocate[u32](a, t.lying.len + 1);
    if (sel entry.err) { ret res[Held, diag.Refusal].err{memory()}; }
    val by: res[*u32, A.Error] = A.allocate[u32](a, t.lying.len + 1);
    if (sel by.err) { ret res[Held, diag.Refusal].err{memory()}; }
    val put: res[*u32, A.Error] = A.allocate[u32](a, n::usize + 1);
    if (sel put.err) { ret res[Held, diag.Refusal].err{memory()}; }
    var e: usize = 0;
    for (e < t.lying.len) {
        first.ok[t.lying.data[e].row + 1] = first.ok[t.lying.data[e].row + 1] + 1;
        e                                 = e + 1;
    }
    var i: u32 = 0;
    for (i < n) {
        put.ok[i]       = first.ok[i];
        first.ok[i + 1] = first.ok[i + 1] + first.ok[i];
        i               = i + 1;
    }
    var w: u32 = 0;
    for (w < n) {
        var k: u32 = t.first.data[w];
        for (k < t.first.data[w + 1]) {
            val r: u32 = t.lying.data[k].row;
            entry.ok[put.ok[r]] = k;
            by.ok[put.ok[r]]    = w;
            put.ok[r]           = put.ok[r] + 1;
            k                   = k + 1;
        }
        w = w + 1;
    }
    ret res[Held, diag.Refusal].ok{Held{first: first.ok, entry: entry.ok, by: by.ok}};
}

# the lying lists and views of `file`, whose storage facts are stated
pub fun derive(a: *A.Allocator, file: *register.File) res[Tables, diag.Refusal] {
    var t:    Tables = Tables{lying: vector.init[register.Lying](a), first: vector.init[u32](a), views: vector.init[register.View](a)};
    val n:    u32    = file.register_count;
    var keys: u32    = 0;
    var i:    u32    = 0;
    for (i < n) {
        if (file.registers[i].bank::u32 + 1 > keys) { keys = file.registers[i].bank::u32 + 1; }
        i = i + 1;
    }
    val banks: res[Groups, diag.Refusal] = group(a, keys, file, false);
    if (sel banks.err) { ret res[Tables, diag.Refusal].err{banks.err}; }
    var near: vector.Vector[u32] = vector.init[u32](a);
    i = 0;
    for (i < n) {
        if (!pushed(vector.push[u32](?t.first, t.lying.len::u32))) { ret res[Tables, diag.Refusal].err{memory()}; }
        val listed: err[diag.Refusal] = candidates(file, ?banks.ok, i, ?near);
        if (sel listed.err) { ret res[Tables, diag.Refusal].err{listed.err}; }
        var j: usize = 0;
        for (j < near.len) {
            val p: u32 = near.data[j];
            if (p != i) {
                val at: opt[register.Placement] = register.lies(file, ?file.registers[p], ?file.registers[i]);
                if (sel at.some) {
                    if (!pushed(vector.push[register.Lying](?t.lying, register.Lying{row: p, placement: at.some}))) { ret res[Tables, diag.Refusal].err{memory()}; }
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if (!pushed(vector.push[u32](?t.first, t.lying.len::u32))) { ret res[Tables, diag.Refusal].err{memory()}; }
    val held: res[Held, diag.Refusal] = hold(a, ?t, n);
    if (sel held.err) { ret res[Tables, diag.Refusal].err{held.err}; }
    val classes: res[Groups, diag.Refusal] = group(a, file.class_count, file, true);
    if (sel classes.err) { ret res[Tables, diag.Refusal].err{classes.err}; }
    var part: u32 = 0;
    for (part < file.class_count) {
        var whole: u32 = 0;
        for (whole < file.class_count) {
            val v: register.View = view(file, ?t, ?classes.ok, ?held.ok, part, whole);
            if (!pushed(vector.push[register.View](?t.views, v))) { ret res[Tables, diag.Refusal].err{memory()}; }
            whole = whole + 1;
        }
        part = part + 1;
    }
    ret res[Tables, diag.Refusal].ok{t};
}

fun number(n: u64) emit.Value {
    ret emit.Value.number{n::i64};
}

fun placement(f: *emit.File, p: register.Placement) emit.Value {
    val r: *emit.Record = emit.record(f, "register.Placement");
    emit.member(f, r, "offset", number(p.offset));
    emit.member(f, r, "width", number(p.width));
    emit.member(f, r, "stride", number(p.stride));
    emit.member(f, r, "count", number(p.count));
    ret emit.Value.record{r};
}

# array `arr` declared as `id`, entered in `taken`, and the address of its first item, nil when it is empty
fun table(f: *emit.File, taken: *map.Map[str, str], id: str, arr: *emit.Array) res[emit.Value, diag.Refusal] {
    if (emit.length(arr) == 0) { ret res[emit.Value, diag.Refusal].ok{emit.Value.name{"nil"}}; }
    val declared: err[diag.Refusal] = handles.declare_handle(f, taken, id, id, nil, emit.Value.array{arr});
    if (sel declared.err) { ret res[emit.Value, diag.Refusal].err{declared.err}; }
    ret res[emit.Value, diag.Refusal].ok{emit.element(f, id, 0)};
}

# the lying lists and views of `file`, whose storage facts are stated, written into `f` as LYING, LYING_FIRST and VIEWS,
# each identifier entered in `taken`, and the file record `into`'s lying, lying_first and views members set to them
pub fun generate(f: *emit.File, file: *register.File, taken: *map.Map[str, str], into: *emit.Record) err[diag.Refusal] {
    val derived: res[Tables, diag.Refusal] = derive(f.alloc, file);
    if (sel derived.err) { ret err[diag.Refusal].err{derived.err}; }
    val t:     *Tables     = ?derived.ok;
    val lying: *emit.Array = emit.array(f, "register.Lying");
    var i:     usize       = 0;
    for (i < t.lying.len) {
        val r: *emit.Record = emit.record(f, "register.Lying");
        emit.member(f, r, "row", number(t.lying.data[i].row::u64));
        emit.member(f, r, "placement", placement(f, t.lying.data[i].placement));
        emit.item(f, lying, emit.Value.record{r});
        i = i + 1;
    }
    val first: *emit.Array = emit.array(f, "u32");
    i = 0;
    if (file.register_count > 0) {
        for (i < t.first.len) {
            emit.item(f, first, number(t.first.data[i]::u64));
            i = i + 1;
        }
    }
    val views: *emit.Array = emit.array(f, "register.View");
    i = 0;
    for (i < t.views.len) {
        val v: register.View = t.views.data[i];
        if (v.part == register.NO_ROW) { emit.item(f, views, emit.Value.name{"register.NO_VIEW"}); }
        or {
            val r: *emit.Record = emit.record(f, "register.View");
            emit.member(f, r, "placement", placement(f, v.placement));
            emit.member(f, r, "part", number(v.part::u64));
            emit.member(f, r, "whole", number(v.whole::u64));
            emit.item(f, views, emit.Value.record{r});
        }
        i = i + 1;
    }
    val at_lying: res[emit.Value, diag.Refusal] = table(f, taken, "LYING", lying);
    if (sel at_lying.err) { ret err[diag.Refusal].err{at_lying.err}; }
    val at_first: res[emit.Value, diag.Refusal] = table(f, taken, "LYING_FIRST", first);
    if (sel at_first.err) { ret err[diag.Refusal].err{at_first.err}; }
    val at_views: res[emit.Value, diag.Refusal] = table(f, taken, "VIEWS", views);
    if (sel at_views.err) { ret err[diag.Refusal].err{at_views.err}; }
    emit.member(f, into, "lying", at_lying.ok);
    emit.member(f, into, "lying_first", at_first.ok);
    emit.member(f, into, "views", at_views.ok);
    ret err[diag.Refusal].ok{};
}
