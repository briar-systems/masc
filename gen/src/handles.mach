# the handles of a register file, shared by every set's register generator: a constant per register row, holding its identity, and a
# constant per class, holding its index
#
# a handle is named by the row's canonical name through the one mangling rule of generated handles, so `x0` is `X0` and the
# class `csr` is `CSR_CLASS`. an alias gets no handle of its own, since it names a row that already has one. two names that
# mangle to one identifier are refused, naming both, so every handle can be spelt without a collision.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_join;

use A: std.allocator;
use std.collections.map;

use masc.core.register;

use gen.diag;
use gen.emit;

pub val NAMES_MANGLE: str = "two register or class names mangle to one identifier";

fun memory() diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, nil);
}

# public constant `id` of type `of` declared as `v`, refused when another handle has the identifier. `name` is the name it came from
pub fun declare_handle(f: *emit.File, taken: *map.Map[str, str], id: str, name: str, of: str, v: emit.Value) err[diag.Refusal] {
    val prior: opt[*str] = map.get[str, str](taken, ?id);
    if (sel prior.some) {
        val both: res[str, StrError] = str_join(f.alloc, @prior.some, " and ", name);
        if (sel both.err) { ret err[diag.Refusal].err{memory()}; }
        ret err[diag.Refusal].err{diag.refusal(nil, 0, NAMES_MANGLE, both.ok)};
    }
    val inserted: res[bool, A.Error] = map.insert[str, str](taken, id, name);
    if (sel inserted.err) { ret err[diag.Refusal].err{memory()}; }
    emit.declare(f, id, of, v);
    ret err[diag.Refusal].ok{};
}

# the handle of register row `name`, numbered `number` in class `class`, holding its identity
pub fun row(f: *emit.File, taken: *map.Map[str, str], name: str, class: u16, number: u16) err[diag.Refusal] {
    ret declare_handle(f, taken, emit.ident(f, name), name, "register.Id", emit.Value.hex{register.make(class, number)::u64});
}

# the handle of class `name`, holding its index `k`
pub fun class(f: *emit.File, taken: *map.Map[str, str], name: str, k: u32) err[diag.Refusal] {
    ret declare_handle(f, taken, emit.concat(f, emit.ident(f, name), "_CLASS"), name, "u16", emit.Value.number{k::i64});
}

# the handles of `file`'s registers and classes, written into `f`, each identifier entered in `taken`
pub fun generate(a: *A.Allocator, f: *emit.File, file: *register.File, taken: *map.Map[str, str]) err[diag.Refusal] {
    emit.uses(f, "masc.core.register");
    var i: u32 = 0;
    for (i < file.register_count) {
        val r:    *register.Register = ?file.registers[i];
        val done: err[diag.Refusal]  = row(f, taken, r.name, r.class, r.number);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    var k: u32 = 0;
    for (k < file.class_count) {
        val done: err[diag.Refusal] = class(f, taken, file.classes[k].name, k);
        if (sel done.err) { ret done; }
        k = k + 1;
    }
    ret err[diag.Refusal].ok{};
}
