# the run of every generator, writing its tables or checking them for drift
#
# a run loads every source of the table from the gen project and checks it
# against its record before any generator reads it, runs each registered
# generator over its source's tree, and renders what it emitted in memory.
# then it writes the tables into masc's tree, or in check mode compares each
# with the committed file and reports every drift, including a generated
# file no generator emits. neither mode reaches the network: a run reads the
# tree it is given and nothing else.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_ends_with;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use std.collections.vector;
use fs: std.filesystem;
use std.io.error;

use gen.diag;
use gen.emit;
use gen.set;
use gen.source;

# a committed table that differs from what its generator emits
# ---
# path:    the table, relative to masc's root
# line:    the first line that differs, 0 when the whole file is missing or stray
# message: how it differs
pub rec Drift {
    path:    str;
    line:    u32;
    message: str;
}

pub val CHANGED:      str = "differs from what its generator emits";
pub val MISSING:      str = "not committed";
pub val STRAY:        str = "no generator emits it";
pub val UNLISTED:     str = "generator reads a source not in the source table";
pub val SOURCE_TWICE: str = "source listed twice";
pub val TABLE_TWICE:  str = "table emitted twice";
pub val UNWRITTEN:    str = "table cannot be written";
pub val UNREADABLE:   str = "masc's tree cannot be read";

# the drift of committed `got` from emitted `want`, none when they are the same bytes
pub fun compare(path: str, want: *u8, want_len: usize, got: *u8, got_len: usize) opt[Drift] {
    var line: u32   = 1;
    var i:    usize = 0;
    for (i < want_len && i < got_len) {
        if (want[i] != got[i]) { ret opt[Drift].some{Drift{path: path, line: line, message: CHANGED}}; }
        if (want[i] == '\n')   { line = line + 1; }
        i = i + 1;
    }
    if (want_len == got_len) { ret opt[Drift].none{}; }
    ret opt[Drift].some{Drift{path: path, line: line, message: CHANGED}};
}

# whether a push was given its storage
fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun memory(subject: str) err[diag.Refusal] {
    ret err[diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, subject)};
}

fun join(a: *A.Allocator, x: str, y: str, z: str) opt[str] {
    val res_str_join: res[str, StrError] = str_join(a, x, y, z);
    if (sel res_str_join.err) { ret opt[str].none{}; }
    ret opt[str].some{res_str_join.ok};
}

# a rendered table and where it goes
rec Table {
    path:  str;
    bytes: vector.Vector[u8];
}

# whether `path` is a table some generator emitted
fun emitted(tables: *vector.Vector[Table], path: str) bool {
    var i: usize = 0;
    for (i < tables.len) {
        if (str_compare(tables.data[i].path, path) == 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# every generated file under src/isa no generator emitted, as drift
fun strays(a: *A.Allocator, root: str, tables: *vector.Vector[Table], drift: *vector.Vector[Drift]) err[diag.Refusal] {
    val opt_isa: opt[str] = join(a, root, "/", "src/isa");
    if (sel opt_isa.none) { ret memory(root); }
    val res_sets: res[vector.Vector[fs.Listed], fs.FsError] = fs.read_dir(a, opt_isa.some);
    if (sel res_sets.err) { ret err[diag.Refusal].err{diag.refusal(opt_isa.some, 0, UNREADABLE, nil)}; }
    var i: usize = 0;
    for (i < res_sets.ok.len) {
        if (sel res_sets.ok.data[i].unspellable) { ret err[diag.Refusal].err{diag.refusal(opt_isa.some, 0, UNREADABLE, nil)}; }
        val opt_dir: opt[str] = join(a, opt_isa.some, "/", res_sets.ok.data[i].name);
        if (sel opt_dir.none) { ret memory(root); }
        val res_is_dir: res[bool, error.Error] = fs.is_dir(opt_dir.some);
        if (sel res_is_dir.ok && res_is_dir.ok) {
            val res_files: res[vector.Vector[fs.Listed], fs.FsError] = fs.read_dir(a, opt_dir.some);
            if (sel res_files.err) { ret err[diag.Refusal].err{diag.refusal(opt_dir.some, 0, UNREADABLE, nil)}; }
            var j: usize = 0;
            for (j < res_files.ok.len) {
                if (sel res_files.ok.data[j].unspellable) { ret err[diag.Refusal].err{diag.refusal(opt_dir.some, 0, UNREADABLE, nil)}; }
                val name: str = res_files.ok.data[j].name;
                if (str_starts_with(name, emit.PREFIX) && str_ends_with(name, ".mach")) {
                    val opt_set: opt[str] = join(a, "src/isa/", res_sets.ok.data[i].name, "/");
                    if (sel opt_set.none) { ret memory(name); }
                    val opt_path: opt[str] = join(a, opt_set.some, name, "");
                    if (sel opt_path.none) { ret memory(name); }
                    if (!emitted(tables, opt_path.some)) {
                        if (!pushed(vector.push[Drift](drift, Drift{path: opt_path.some, line: 0, message: STRAY}))) { ret memory(name); }
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the directory `inner` is under `outer`, relative to it, none when it is not under it
fun inside(outer: str, inner: str) opt[str] {
    val n: usize = str_len(outer);
    if (str_len(inner) <= n + 1 || inner[n] != '/') { ret opt[str].none{}; }
    var k: usize = 0;
    for (k < n) {
        if (inner[k] != outer[k]) { ret opt[str].none{}; }
        k = k + 1;
    }
    ret opt[str].some{?inner[n + 1]};
}

# the row of `sources` that `s` is, none when it is no row
fun row_of(sources: *source.Sources, s: *source.Source) opt[usize] {
    var i: u32 = 0;
    for (i < sources.len) {
        if (sources.at[i] == s) { ret opt[usize].some{i::usize}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# every generator run over its checked source, its tables written into masc's tree or checked against it
# ---
# a:          allocator for the run, which outlives it
# root:       masc's root, which holds the gen project at gen/
# sources:    the source table
# cited:      the releases the overlays cite and gen does not hold
# generators: the registered generators
# check:      whether to compare with the committed tables rather than write them
# drift:      where every drift is reported
# ret:        ok, or the refusal of a source, a generator or a table
pub fun run(a: *A.Allocator, root: str, sources: *source.Sources, cited: *source.Citeds, generators: *set.Generators, check: bool, drift: *vector.Vector[Drift]) err[diag.Refusal] {
    var i: u32 = 0;
    for (i < cited.len) {
        val c:         *source.Cited     = cited.at[i];
        val err_whole: err[diag.Refusal] = source.recorded(c);
        if (sel err_whole.err) { ret err_whole; }
        var j: u32 = 0;
        for (j < sources.len) {
            if (str_compare(sources.at[j].name, c.name) == 0) { ret err[diag.Refusal].err{diag.refusal(nil, 0, SOURCE_TWICE, c.name)}; }
            j = j + 1;
        }
        j = 0;
        for (j < i) {
            if (str_compare(cited.at[j].name, c.name) == 0) { ret err[diag.Refusal].err{diag.refusal(nil, 0, SOURCE_TWICE, c.name)}; }
            j = j + 1;
        }
        i = i + 1;
    }
    var trees: vector.Vector[source.Tree] = vector.init[source.Tree](a);
    i = 0;
    for (i < sources.len) {
        val s: *source.Source = sources.at[i];
        var j: u32            = 0;
        for (j < i) {
            if (str_compare(sources.at[j].name, s.name) == 0) { ret err[diag.Refusal].err{diag.refusal(nil, 0, SOURCE_TWICE, s.name)}; }
            j = j + 1;
        }
        val opt_dir: opt[str] = join(a, root, "/gen/", s.path);
        if (sel opt_dir.none) { ret memory(s.name); }
        val res_tree: res[source.Tree, diag.Refusal] = source.load(a, opt_dir.some);
        if (sel res_tree.err) { ret err[diag.Refusal].err{res_tree.err}; }
        var t: source.Tree = res_tree.ok;
        j = 0;
        for (j < sources.len) {
            val opt_nested: opt[str] = inside(s.path, sources.at[j].path);
            if (sel opt_nested.some) { source.without(?t, opt_nested.some); }
            j = j + 1;
        }
        val err_verified: err[diag.Refusal] = source.verify(s, ?t);
        if (sel err_verified.err)                         { ret err_verified; }
        if (!pushed(vector.push[source.Tree](?trees, t))) { ret memory(s.name); }
        i = i + 1;
    }
    var tables: vector.Vector[Table] = vector.init[Table](a);
    i = 0;
    for (i < generators.len) {
        val g:          *set.Generator = generators.at[i];
        val opt_row_of: opt[usize]     = row_of(sources, g.source);
        if (sel opt_row_of.none) { ret err[diag.Refusal].err{diag.refusal(nil, 0, UNLISTED, g.name)}; }
        var c: set.Context = set.Context{alloc: a, generator: g, tree: ?trees.data[opt_row_of.some], inputs: vector.init[*source.Tree](a), tables: vector.init[*emit.File](a)};
        var n: u32         = 0;
        for (n < g.inputs.len) {
            val input:   *source.Source = g.inputs.at[n];
            val opt_row: opt[usize]     = row_of(sources, input);
            if (sel opt_row.none)                                                         { ret err[diag.Refusal].err{diag.refusal(nil, 0, UNLISTED, g.name)}; }
            if (!pushed(vector.push[*source.Tree](?c.inputs, ?trees.data[opt_row.some]))) { ret memory(g.name); }
            n = n + 1;
        }
        val err_generated: err[diag.Refusal] = g.generate(?c);
        if (sel err_generated.err) { ret err_generated; }
        var k: usize = 0;
        for (k < c.tables.len) {
            val f:            *emit.File                           = c.tables.data[k];
            val res_rendered: res[vector.Vector[u8], diag.Refusal] = emit.render(f);
            if (sel res_rendered.err)                                                              { ret err[diag.Refusal].err{res_rendered.err}; }
            if (emitted(?tables, f.path))                                                          { ret err[diag.Refusal].err{diag.refusal(f.path, 0, TABLE_TWICE, g.name)}; }
            if (!pushed(vector.push[Table](?tables, Table{path: f.path, bytes: res_rendered.ok}))) { ret memory(f.path); }
            k = k + 1;
        }
        i = i + 1;
    }
    var t: usize = 0;
    for (t < tables.len) {
        val table:    *Table   = ?tables.data[t];
        val opt_full: opt[str] = join(a, root, "/", table.path);
        if (sel opt_full.none) { ret memory(table.path); }
        if (check) {
            val res_committed: res[vector.Vector[u8], fs.FsError] = fs.read_bytes(a, opt_full.some);
            if (sel res_committed.ok) {
                val opt_compare: opt[Drift] = compare(table.path, table.bytes.data, table.bytes.len, res_committed.ok.data, res_committed.ok.len);
                if (sel opt_compare.some) {
                    if (!pushed(vector.push[Drift](drift, opt_compare.some))) { ret memory(table.path); }
                }
            }
            or {
                if (!pushed(vector.push[Drift](drift, Drift{path: table.path, line: 0, message: MISSING}))) { ret memory(table.path); }
            }
        }
        or {
            val err_wrote: err[fs.FsError] = fs.write_bytes(opt_full.some, table.bytes.data, table.bytes.len, 0o644);
            if (sel err_wrote.err) { ret err[diag.Refusal].err{diag.refusal(table.path, 0, UNWRITTEN, nil)}; }
        }
        t = t + 1;
    }
    ret strays(a, root, ?tables, drift);
}
