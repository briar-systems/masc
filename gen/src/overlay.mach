# the reader of cited overlays, the facts masc states beside a generator's source
#
# an overlay is a topic of a set's own data tree, the file `<topic>.txt` of
# gen/data/<set>, one fact per line:
#
#   key | fact | cites | overrides
#
# a line whose first byte past its indent is `#` is a comment, and a blank
# line is dropped. `key` names what the fact is about, `fact` states it in the
# topic's own words, `cites` names where it is read from and is never empty,
# and `overrides` is `-` for a fact the source does not state, or else what
# the source states that the fact replaces, so the line holds both. a topic's
# reader hands `check` what its source states for each fact. an overlay that
# restates the source, states otherwise than the source without naming it, or
# names an override the source does not state, is refused naming its line, so
# a source that comes to state a fact the overlay holds is found the run it
# changes.
#
# the words of a fact split on spaces, a `"` quoting a run that holds them or
# a bar, as `name=", rne"` or `"ssctr|smctr"`, and a word `key=value` is a
# named value `value` reads. a number is decimal, or hexadecimal after `0x`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.view.view;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use gen.diag;
use gen.lines;
use gen.source;

pub val NO_TOPIC:     str = "data tree holds no file for the topic";
pub val BAD_LINE:     str = "overlay line is not `key | fact | cites | overrides`";
pub val NO_KEY:       str = "overlay line names no key";
pub val NO_FACT:      str = "overlay line states no fact";
pub val UNCITED:      str = "overlay fact cites nothing";
pub val RESTATES:     str = "overlay restates a fact its source states";
pub val CONTRADICTS:  str = "overlay states otherwise than its source without naming the override";
pub val NOTHING:      str = "overlay overrides a fact its source does not state";
pub val STALE:        str = "overlay overrides what its source no longer states";
pub val OPEN_QUOTE:   str = "fact holds a quote it does not close";
pub val UNKNOWN_WORD: str = "fact holds a word its topic does not read";
pub val BAD_NUMBER:   str = "fact holds a word that is no number";

# one fact of a topic
# ---
# key:       what it is about
# fact:      what it states, in the topic's words
# cites:     where it is read from
# overrides: what the source states that it replaces, nil for a fact the source does not state
# line:      where it is, for its refusals
pub rec Fact {
    key:       str;
    fact:      str;
    cites:     str;
    overrides: str;
    line:      lines.Line;
}

# a topic's facts, in file order
pub rec Topic {
    path:  str;
    facts: vector.Vector[Fact];
}

# what the source states on the matter `f` speaks to, none when it states nothing
pub def Stated: fun(ptr, *Fact) opt[str];

fun space(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\r';
}

# `len` bytes from `data` copied with a nul after them, nil when the storage is refused
fun copy(a: *A.Allocator, data: *u8, len: usize) str {
    val got: res[*char, A.Error] = A.allocate[char](a, len + 1);
    if (sel got.err) { ret nil; }
    val out: str   = got.ok;
    var i:   usize = 0;
    for (i < len) {
        out[i] = data[i];
        i      = i + 1;
    }
    out[len] = 0;
    ret out;
}

# bytes `from` to `to` of `data` trimmed and copied, nil when the copy is refused
fun owned(a: *A.Allocator, data: *u8, from: usize, to: usize) str {
    var lo: usize = from;
    var hi: usize = to;
    for (lo < hi && space(data[lo])) {
        lo = lo + 1;
    }
    for (hi > lo && space(data[hi - 1])) {
        hi = hi - 1;
    }
    ret copy(a, ?data[lo], hi - lo);
}

fun memory(l: *lines.Line) diag.Refusal {
    ret lines.refuse(l, diag.MEMORY, nil);
}

# the fact on bytes `from` to `to` of `f`, line `number`, split on its bars
fun parse(a: *A.Allocator, f: *source.File, number: u32, from: usize, to: usize) res[Fact, diag.Refusal] {
    var l:    lines.Line = lines.Line{file: f.path, number: number, text: view(?f.data[from], to - from)};
    var bars: [3]usize;
    var n:    u32        = 0;
    var i:    usize      = from;
    var open: bool       = false;
    for (i < to) {
        if (f.data[i] == '"') { open = !open; }
        if (f.data[i] == '|' && !open) {
            if (n == 3) { ret res[Fact, diag.Refusal].err{lines.refuse(?l, BAD_LINE, nil)}; }
            bars[n] = i;
            n       = n + 1;
        }
        i = i + 1;
    }
    if (n != 3) { ret res[Fact, diag.Refusal].err{lines.refuse(?l, BAD_LINE, nil)}; }
    val key:   str = owned(a, f.data, from, bars[0]);
    val fact:  str = owned(a, f.data, bars[0] + 1, bars[1]);
    val cites: str = owned(a, f.data, bars[1] + 1, bars[2]);
    val over:  str = owned(a, f.data, bars[2] + 1, to);
    if (key == nil || fact == nil || cites == nil || over == nil) { ret res[Fact, diag.Refusal].err{memory(?l)}; }
    if (str_len(key) == 0)                                        { ret res[Fact, diag.Refusal].err{lines.refuse(?l, NO_KEY, nil)}; }
    if (str_len(fact) == 0)                                       { ret res[Fact, diag.Refusal].err{lines.refuse(?l, NO_FACT, key)}; }
    if (str_len(cites) == 0)                                      { ret res[Fact, diag.Refusal].err{lines.refuse(?l, UNCITED, key)}; }
    var overrides: str = over;
    if (str_len(overrides) == 0)    { ret res[Fact, diag.Refusal].err{lines.refuse(?l, BAD_LINE, key)}; }
    if (str_equals(overrides, "-")) { overrides = nil; }
    ret res[Fact, diag.Refusal].ok{Fact{key: key, fact: fact, cites: cites, overrides: overrides, line: l}};
}

# the facts of file `f`, in its order
pub fun facts(a: *A.Allocator, f: *source.File) res[Topic, diag.Refusal] {
    var t:      Topic = Topic{path: f.path, facts: vector.init[Fact](a)};
    var at:     usize = 0;
    var number: u32   = 0;
    for (at < f.len) {
        number = number + 1;
        var end: usize = at;
        for (end < f.len && f.data[end] != '\n') {
            end = end + 1;
        }
        var first: usize = at;
        for (first < end && space(f.data[first])) {
            first = first + 1;
        }
        if (first < end && f.data[first] != '#') {
            val got: res[Fact, diag.Refusal] = parse(a, f, number, first, end);
            if (sel got.err) { ret res[Topic, diag.Refusal].err{got.err}; }
            val pushed: res[usize, A.Error] = vector.push[Fact](?t.facts, got.ok);
            if (sel pushed.err) { ret res[Topic, diag.Refusal].err{memory(?got.ok.line)}; }
        }
        at = end + 1;
    }
    ret res[Topic, diag.Refusal].ok{t};
}

# the facts of topic `topic` of the data tree `tree`, read from `<topic>.txt`
pub fun read(a: *A.Allocator, tree: *source.Tree, topic: str) res[Topic, diag.Refusal] {
    val path: res[str, StrError] = str_join(a, topic, ".txt");
    if (sel path.err) { ret res[Topic, diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, topic)}; }
    val f: opt[*source.File] = source.find(tree, path.ok);
    if (sel f.none) { ret res[Topic, diag.Refusal].err{diag.refusal(path.ok, 0, NO_TOPIC, topic)}; }
    ret facts(a, f.some);
}

# the refusal of fact `f`
pub fun refuse(f: *Fact, message: str, subject: str) diag.Refusal {
    ret lines.refuse(?f.line, message, subject);
}

# `t` held to its source: each fact is one the source does not state, or overrides exactly what it states
# ---
# ctx:    what `stated` reads
# stated: what the source states on each fact's matter
pub fun check(t: *Topic, ctx: ptr, stated: Stated) err[diag.Refusal] {
    var i: usize = 0;
    for (i < t.facts.len) {
        val f:    *Fact    = ?t.facts.data[i];
        val held: opt[str] = stated(ctx, f);
        if (f.overrides == nil) {
            if (sel held.some && str_equals(held.some, f.fact)) { ret err[diag.Refusal].err{refuse(f, RESTATES, f.key)}; }
            if (sel held.some)                                  { ret err[diag.Refusal].err{refuse(f, CONTRADICTS, f.key)}; }
        }
        or {
            if (sel held.none)                       { ret err[diag.Refusal].err{refuse(f, NOTHING, f.key)}; }
            if (str_equals(held.some, f.fact))       { ret err[diag.Refusal].err{refuse(f, RESTATES, f.key)}; }
            if (!str_equals(held.some, f.overrides)) { ret err[diag.Refusal].err{refuse(f, STALE, f.key)}; }
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# a source that states nothing a topic states, as a topic of masc's own facts alone
pub fun unstated(ctx: ptr, f: *Fact) opt[str] {
    ret opt[str].none{};
}

# the words of `text`, split on spaces, a `"` quoting a run that holds them
pub fun words(a: *A.Allocator, f: *Fact, text: str) res[vector.Vector[str], diag.Refusal] {
    var out: vector.Vector[str] = vector.init[str](a);
    val len: usize              = str_len(text);
    var at:  usize              = 0;
    for (at < len) {
        if (space(text[at])) {
            at = at + 1;
            cnt;
        }
        var word: vector.Vector[u8] = vector.init[u8](a);
        var open: bool              = false;
        for (at < len && (open || !space(text[at]))) {
            if (text[at] == '"') { open = !open; }
            or {
                val put: res[usize, A.Error] = vector.push[u8](?word, text[at]);
                if (sel put.err) { ret res[vector.Vector[str], diag.Refusal].err{memory(?f.line)}; }
            }
            at = at + 1;
        }
        if (open) { ret res[vector.Vector[str], diag.Refusal].err{refuse(f, OPEN_QUOTE, f.key)}; }
        val made: str = copy(a, word.data, word.len);
        if (made == nil) { ret res[vector.Vector[str], diag.Refusal].err{memory(?f.line)}; }
        val pushed: res[usize, A.Error] = vector.push[str](?out, made);
        if (sel pushed.err) { ret res[vector.Vector[str], diag.Refusal].err{memory(?f.line)}; }
    }
    ret res[vector.Vector[str], diag.Refusal].ok{out};
}

# the value `name=` gives in `ws`, none when no word names it
pub fun value(ws: *vector.Vector[str], name: str) opt[str] {
    val n: usize = str_len(name);
    var i: usize = 0;
    for (i < ws.len) {
        val w: str = ws.data[i];
        if (str_len(w) > n && w[n] == '=') {
            var same: bool  = true;
            var k:    usize = 0;
            for (k < n) {
                if (w[k] != name[k]) { same = false; }
                k = k + 1;
            }
            if (same) { ret opt[str].some{?w[n + 1]}; }
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

# the number `word` spells, decimal with an optional `-`, or hexadecimal after `0x`
pub fun number(f: *Fact, word: str) res[i64, diag.Refusal] {
    val len:      usize = str_len(word);
    var at:       usize = 0;
    var negative: bool  = false;
    if (len > 0 && word[0] == '-') {
        negative = true;
        at       = 1;
    }
    var base: i64 = 10;
    if (len > at + 2 && word[at] == '0' && (word[at + 1] == 'x' || word[at + 1] == 'X')) {
        base = 16;
        at   = at + 2;
    }
    if (at == len || len - at > 16) { ret res[i64, diag.Refusal].err{refuse(f, BAD_NUMBER, word)}; }
    var n: i64 = 0;
    for (at < len) {
        val c: u8  = word[at];
        var d: i64 = -1;
        if (c >= '0' && c <= '9')               { d = (c - '0')::i64; }
        or (base == 16 && c >= 'a' && c <= 'f') { d = (c - 'a')::i64 + 10; }
        or (base == 16 && c >= 'A' && c <= 'F') { d = (c - 'A')::i64 + 10; }
        if (d < 0)                              { ret res[i64, diag.Refusal].err{refuse(f, BAD_NUMBER, word)}; }
        n  = n * base + d;
        at = at + 1;
    }
    if (negative) { n = 0 - n; }
    ret res[i64, diag.Refusal].ok{n};
}

#[testing]
fun t_file(text: str) source.File {
    ret source.File{path: "t.txt", data: text, len: str_len(text)};
}

#[testing]
fun t_held(ctx: ptr, f: *Fact) opt[str] {
    if (str_equals(f.key, "stated")) { ret opt[str].some{"source"}; }
    ret opt[str].none{};
}

test facts__a_line_is_its_four_fields_and_comments_are_dropped {
    var tt: testing.Testing;
    testing.make(?tt);
    var f:   source.File              = t_file("# a comment\n\n  key one | fact two | cite (#1) | -\nk | f | c | was\nq | \"a|b\" | c | -\n");
    val got: res[Topic, diag.Refusal] = facts(testing.allocator_of(?tt), ?f);
    if (sel got.err)           { ret 1; }
    if (got.ok.facts.len != 3) { ret 2; }
    val a: *Fact = ?got.ok.facts.data[0];
    if (!str_equals(a.key, "key one") || !str_equals(a.fact, "fact two") || !str_equals(a.cites, "cite (#1)") || a.overrides != nil) { ret 3; }
    if (a.line.number != 3)                                                                                                          { ret 4; }
    if (!str_equals(got.ok.facts.data[1].overrides, "was"))                                                                          { ret 5; }
    if (!str_equals(got.ok.facts.data[2].fact, "\"a|b\""))                                                                           { ret 6; }
    ret 0;
}

test facts__a_line_short_of_a_field_or_uncited_is_refused {
    var tt: testing.Testing;
    testing.make(?tt);
    var short: source.File              = t_file("k | f | c\n");
    val a:     res[Topic, diag.Refusal] = facts(testing.allocator_of(?tt), ?short);
    if (!(sel a.err && a.err.message == BAD_LINE)) { ret 1; }
    var bare: source.File              = t_file("k | f |  | -\n");
    val b:    res[Topic, diag.Refusal] = facts(testing.allocator_of(?tt), ?bare);
    if (!(sel b.err && b.err.message == UNCITED)) { ret 2; }
    ret 0;
}

test check__an_overlay_restating_or_contradicting_its_source_is_refused {
    var tt: testing.Testing;
    testing.make(?tt);
    var cases: [5]str = [5]str{"own | x | c | -\n", "stated | source | c | -\n", "stated | other | c | -\n", "own | x | c | was\n", "stated | other | c | gone\n"};
    var want:  [5]str = [5]str{nil, RESTATES, CONTRADICTS, NOTHING, STALE};
    var i:     u32    = 0;
    for (i < 5) {
        var f: source.File              = t_file(cases[i]);
        var t: res[Topic, diag.Refusal] = facts(testing.allocator_of(?tt), ?f);
        if (sel t.err) { ret 10 + i::i32; }
        val got: err[diag.Refusal] = check(?t.ok, nil, t_held);
        if (want[i] == nil && sel got.err)                                  { ret 20 + i::i32; }
        if (want[i] != nil && !(sel got.err && got.err.message == want[i])) { ret 30 + i::i32; }
        i = i + 1;
    }
    var ok: source.File              = t_file("stated | other | c | source\n");
    var t:  res[Topic, diag.Refusal] = facts(testing.allocator_of(?tt), ?ok);
    if (sel t.err) { ret 1; }
    val kept: err[diag.Refusal] = check(?t.ok, nil, t_held);
    if (sel kept.err) { ret 2; }
    ret 0;
}

test words__a_quote_holds_spaces_and_a_named_value_is_read {
    var tt: testing.Testing;
    testing.make(?tt);
    var f: source.File              = t_file("k | a name=\", rne\" \"\" b=2 | c | -\n");
    val t: res[Topic, diag.Refusal] = facts(testing.allocator_of(?tt), ?f);
    if (sel t.err) { ret 1; }
    val ws: res[vector.Vector[str], diag.Refusal] = words(testing.allocator_of(?tt), ?t.ok.facts.data[0], t.ok.facts.data[0].fact);
    if (sel ws.err)                  { ret 2; }
    if (ws.ok.len != 4)              { ret 3; }
    if (str_len(ws.ok.data[2]) != 0) { ret 4; }
    val name: opt[str] = value(?ws.ok, "name");
    if (!(sel name.some && str_equals(name.some, ", rne"))) { ret 5; }
    val b: opt[str] = value(?ws.ok, "b");
    if (!(sel b.some && str_equals(b.some, "2"))) { ret 6; }
    val c: opt[str] = value(?ws.ok, "c");
    if (sel c.some) { ret 7; }
    val hex: res[i64, diag.Refusal] = number(?t.ok.facts.data[0], "0x1F");
    val neg: res[i64, diag.Refusal] = number(?t.ok.facts.data[0], "-12");
    val bad: res[i64, diag.Refusal] = number(?t.ok.facts.data[0], "1a");
    if (!(sel hex.ok && hex.ok == 31) || !(sel neg.ok && neg.ok == -12)) { ret 8; }
    if (!(sel bad.err && bad.err.message == BAD_NUMBER))                 { ret 9; }
    ret 0;
}
