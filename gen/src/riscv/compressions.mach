# the reviewed compressions of the vendor tools
#
# riscv-opcodes states the compressed encodings and not what they stand for.
# each is written here against the instruction it shortens, from the
# expansion column of the RVC instruction listings (riscv-isa-manual, "RVC
# Instruction Set Listings", the Zcb chapter, and zicfiss's c.sspush and
# c.sspopchk in cfi.adoc) and from the patterns llvm compresses by (its RVC
# and Zc instruction definitions, checked against llvm-mc 23.1.1), as addiw
# with rs1 zero to c.li. a base mnemonic's entries are tried in the order given, which is the order the vendor tools
# prefer, and the tables are matched against every row of both mnemonics, so
# a compressed form that has an rv32 and an rv64 row is a compression of
# each. whether a value fits is the shorter row's own check.
#
# `from` is, for each operand of the shorter row in order, the argument of
# the base row it takes its value from, `a|b` standing for whichever of the
# two names the base row has, `a:s20` for that operand's number sign extended
# from twenty bits, and `=x2` for a fixed register. `when` is the conditions
# on the base row's values: `a=b` for two arguments holding one value, `a=x0`
# for an argument holding a register, and `a=#255` for a number.

use std.types.string.str;

# one compression
# ---
# base:   the instruction shortened
# packed: the compressed instruction
# from:   where each operand of the compressed instruction takes its value from
# when:   what the instruction's values must hold
pub rec Entry {
    base:   str;
    packed: str;
    from:   str;
    when:   str;
}

pub val ENTRIES_COUNT: u32 = 65;

pub val ENTRIES: [ENTRIES_COUNT]Entry = [ENTRIES_COUNT]Entry{
    Entry{base: "add", packed: "c.mv", from: "rd rs2", when: "rs1=x0"},
    Entry{base: "add", packed: "c.mv", from: "rd rs1", when: "rs2=x0"},
    Entry{base: "add", packed: "c.add", from: "rd rs2", when: "rs1=rd"},
    Entry{base: "add", packed: "c.add", from: "rd rs1", when: "rs2=rd"},
    Entry{base: "add.uw", packed: "c.zext.w", from: "rd", when: "rs1=rd rs2=x0"},
    Entry{base: "addi", packed: "c.nop", from: "", when: "rd=x0 rs1=x0 imm12=#0"},
    Entry{base: "addi", packed: "c.li", from: "rd imm12", when: "rs1=x0"},
    Entry{base: "addi", packed: "c.addi", from: "rd imm12", when: "rs1=rd"},
    Entry{base: "addi", packed: "c.addi16sp", from: "=x2 imm12", when: "rd=x2 rs1=x2"},
    Entry{base: "addi", packed: "c.addi4spn", from: "rd =x2 imm12", when: "rs1=x2"},
    Entry{base: "addi", packed: "c.mv", from: "rd rs1", when: "imm12=#0"},
    Entry{base: "addiw", packed: "c.li", from: "rd imm12", when: "rs1=x0"},
    Entry{base: "addiw", packed: "c.addiw", from: "rd imm12", when: "rs1=rd"},
    Entry{base: "addw", packed: "c.addw", from: "rd rs2", when: "rs1=rd"},
    Entry{base: "addw", packed: "c.addw", from: "rd rs1", when: "rs2=rd"},
    Entry{base: "and", packed: "c.and", from: "rd rs2", when: "rs1=rd"},
    Entry{base: "and", packed: "c.and", from: "rd rs1", when: "rs2=rd"},
    Entry{base: "andi", packed: "c.zext.b", from: "rd", when: "rs1=rd imm12=#255"},
    Entry{base: "andi", packed: "c.andi", from: "rd imm12", when: "rs1=rd"},
    Entry{base: "beq", packed: "c.beqz", from: "rs1 bimm12hi", when: "rs2=x0"},
    Entry{base: "bne", packed: "c.bnez", from: "rs1 bimm12hi", when: "rs2=x0"},
    Entry{base: "ebreak", packed: "c.ebreak", from: "", when: ""},
    Entry{base: "fld", packed: "c.fld", from: "rd rs1 imm12", when: ""},
    Entry{base: "fld", packed: "c.fldsp", from: "rd imm12 =x2", when: "rs1=x2"},
    Entry{base: "flw", packed: "c.flw", from: "rd rs1 imm12", when: ""},
    Entry{base: "flw", packed: "c.flwsp", from: "rd imm12 =x2", when: "rs1=x2"},
    Entry{base: "fsd", packed: "c.fsd", from: "rs1 rs2 imm12hi", when: ""},
    Entry{base: "fsd", packed: "c.fsdsp", from: "rs2 imm12hi =x2", when: "rs1=x2"},
    Entry{base: "fsw", packed: "c.fsw", from: "rs1 rs2 imm12hi", when: ""},
    Entry{base: "fsw", packed: "c.fswsp", from: "rs2 imm12hi =x2", when: "rs1=x2"},
    Entry{base: "jal", packed: "c.j", from: "jimm20", when: "rd=x0"},
    Entry{base: "jal", packed: "c.jal", from: "jimm20", when: "rd=x1"},
    Entry{base: "jalr", packed: "c.jr", from: "rs1", when: "rd=x0 imm12=#0"},
    Entry{base: "jalr", packed: "c.jalr", from: "rs1", when: "rd=x1 imm12=#0"},
    Entry{base: "lbu", packed: "c.lbu", from: "rd rs1 imm12", when: ""},
    Entry{base: "ld", packed: "c.ld", from: "rd|rd_e rs1 imm12", when: ""},
    Entry{base: "ld", packed: "c.ldsp", from: "rd|rd_e imm12 =x2", when: "rs1=x2"},
    Entry{base: "lh", packed: "c.lh", from: "rd rs1 imm12", when: ""},
    Entry{base: "lhu", packed: "c.lhu", from: "rd rs1 imm12", when: ""},
    Entry{base: "lui", packed: "c.lui", from: "rd imm20:s20", when: ""},
    Entry{base: "lw", packed: "c.lw", from: "rd rs1 imm12", when: ""},
    Entry{base: "lw", packed: "c.lwsp", from: "rd imm12 =x2", when: "rs1=x2"},
    Entry{base: "mul", packed: "c.mul", from: "rd rs2", when: "rs1=rd"},
    Entry{base: "mul", packed: "c.mul", from: "rd rs1", when: "rs2=rd"},
    Entry{base: "or", packed: "c.or", from: "rd rs2", when: "rs1=rd"},
    Entry{base: "or", packed: "c.or", from: "rd rs1", when: "rs2=rd"},
    Entry{base: "sb", packed: "c.sb", from: "rs1 rs2 imm12hi", when: ""},
    Entry{base: "sd", packed: "c.sd", from: "rs1 rs2|rs2_e imm12hi", when: ""},
    Entry{base: "sd", packed: "c.sdsp", from: "rs2|rs2_e imm12hi =x2", when: "rs1=x2"},
    Entry{base: "sext.b", packed: "c.sext.b", from: "rd", when: "rs1=rd"},
    Entry{base: "sext.h", packed: "c.sext.h", from: "rd", when: "rs1=rd"},
    Entry{base: "sh", packed: "c.sh", from: "rs1 rs2 imm12hi", when: ""},
    Entry{base: "slli", packed: "c.slli", from: "rd shamtd|shamtw", when: "rs1=rd"},
    Entry{base: "srai", packed: "c.srai", from: "rd shamtd|shamtw", when: "rs1=rd"},
    Entry{base: "srli", packed: "c.srli", from: "rd shamtd|shamtw", when: "rs1=rd"},
    Entry{base: "sspopchk.x5", packed: "c.sspopchk.x5", from: "", when: ""},
    Entry{base: "sspush.x1", packed: "c.sspush.x1", from: "", when: ""},
    Entry{base: "sub", packed: "c.sub", from: "rd rs2", when: "rs1=rd"},
    Entry{base: "subw", packed: "c.subw", from: "rd rs2", when: "rs1=rd"},
    Entry{base: "sw", packed: "c.sw", from: "rs1 rs2 imm12hi", when: ""},
    Entry{base: "sw", packed: "c.swsp", from: "rs2 imm12hi =x2", when: "rs1=x2"},
    Entry{base: "xor", packed: "c.xor", from: "rd rs2", when: "rs1=rd"},
    Entry{base: "xor", packed: "c.xor", from: "rd rs1", when: "rs2=rd"},
    Entry{base: "xori", packed: "c.not", from: "rd", when: "rs1=rd imm12=#-1"},
    Entry{base: "zext.h", packed: "c.zext.h", from: "rd", when: "rs1=rd"},
};
