# the reviewed register constraints the riscv generator adds to riscv-opcodes
#
# riscv-opcodes states no constraint between operands. the forms the manual
# reserves because their operands share registers are here, every table
# matched by mnemonic as `overlay.matches` reads a pattern. facts are from the
# riscv-isa-manual at 36fdac54a526: src/unpriv/vector-common.adoc for the
# vector extension and src/unpriv/zvk.adoc for the vector crypto extensions.
# arguments are riscv-opcodes' own names, and registers the register file's.

use std.types.string.str;

use masc.core.constraint;

# a row's argument kept apart from others
# ---
# mnemonic: the rows it applies to
# arg:      the argument kept apart
# against:  the arguments it is kept from, split by spaces, empty when `register` names what it is kept from
# register: the register it is kept from, empty when `against` names arguments
# permit:   the overlap allowed nonetheless
pub rec Keep {
    mnemonic: str;
    arg:      str;
    against:  str;
    register: str;
    permit:   constraint.Permit;
}

# the constraints each instruction states, every one a reserved encoding when broken
# - "Vector Operands": a widening destination, of twice the element width, may overlap a single-width source only in
#   its highest-numbered registers, and a narrowing destination its double-width source only from its lowest. the
#   widening and narrowing rows are "Widening Vector Arithmetic Instructions", "Narrowing Vector Arithmetic
#   Instructions" and their conversions; a widening reduction's destination is a scalar and states none
# - "Vector Indexed Segment Loads and Stores": an indexed segment load's destination groups cannot overlap vs2
# - "Vector Integer Add-with-Carry / Subtract-with-Borrow Instructions": vadc's and vsbc's destination is not v0, and
#   "Vector Integer Merge Instructions" and "Vector Floating-Point Merge Instruction" encode vmerge and vfmerge as
#   masked instructions whose destination is no mask, so "Vector Masking" keeps theirs from v0 as well
# - "vmsbf.m", "vmsif.m", "vmsof.m" and "Vector Iota Instruction": the destination cannot overlap the source
# - "Vector Slide-up Instructions" and "Vector Slide-1-up": the destination cannot overlap the source
# - "Vector Register Gather Instructions": the destination cannot overlap any source group
# - "Vector Compress Instruction": the destination cannot overlap the source group or the mask source vs1
# - zvk.adoc, "Instruction Constraints": the .vs rounds' vd cannot overlap their vs2 element group, the sha-2 rounds'
#   and message schedule's vd cannot overlap vs1 or vs2, and sm3's vd cannot overlap vs2
pub val KEEPS_COUNT: u32 = 42;

pub val KEEPS: [KEEPS_COUNT]Keep = [KEEPS_COUNT]Keep{
    Keep{mnemonic: "vw*.vv", arg: "vd", against: "vs2 vs1", register: "", permit: constraint.HIGHEST},
    Keep{mnemonic: "vw*.vx", arg: "vd", against: "vs2", register: "", permit: constraint.HIGHEST},
    Keep{mnemonic: "vw*.vi", arg: "vd", against: "vs2", register: "", permit: constraint.HIGHEST},
    Keep{mnemonic: "vw*.wv", arg: "vd", against: "vs1", register: "", permit: constraint.HIGHEST},
    Keep{mnemonic: "vfw*.vv", arg: "vd", against: "vs2 vs1", register: "", permit: constraint.HIGHEST},
    Keep{mnemonic: "vfw*.vf", arg: "vd", against: "vs2", register: "", permit: constraint.HIGHEST},
    Keep{mnemonic: "vfw*.wv", arg: "vd", against: "vs1", register: "", permit: constraint.HIGHEST},
    Keep{mnemonic: "vfwcvt*", arg: "vd", against: "vs2", register: "", permit: constraint.HIGHEST},
    Keep{mnemonic: "vnsrl.w*", arg: "vd", against: "vs2", register: "", permit: constraint.LOWEST},
    Keep{mnemonic: "vnsra.w*", arg: "vd", against: "vs2", register: "", permit: constraint.LOWEST},
    Keep{mnemonic: "vnclip.w*", arg: "vd", against: "vs2", register: "", permit: constraint.LOWEST},
    Keep{mnemonic: "vnclipu.w*", arg: "vd", against: "vs2", register: "", permit: constraint.LOWEST},
    Keep{mnemonic: "vfncvt*", arg: "vd", against: "vs2", register: "", permit: constraint.LOWEST},
    Keep{mnemonic: "vluxseg*", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vloxseg*", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vadc.v*m", arg: "vd", against: "", register: "v0", permit: constraint.DISJOINT},
    Keep{mnemonic: "vsbc.v*m", arg: "vd", against: "", register: "v0", permit: constraint.DISJOINT},
    Keep{mnemonic: "vmerge.v*m", arg: "vd", against: "", register: "v0", permit: constraint.DISJOINT},
    Keep{mnemonic: "vfmerge.vfm", arg: "vd", against: "", register: "v0", permit: constraint.DISJOINT},
    Keep{mnemonic: "vmsbf.m", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vmsif.m", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vmsof.m", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "viota.m", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vslideup.v*", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vslide1up.vx", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vfslide1up.vf", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vrgather.vv", arg: "vd", against: "vs2 vs1", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vrgatherei16.vv", arg: "vd", against: "vs2 vs1", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vrgather.vx", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vrgather.vi", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vcompress.vm", arg: "vd", against: "vs2 vs1", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vaesdf.vs", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vaesdm.vs", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vaesef.vs", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vaesem.vs", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vaesz.vs", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vsm4r.vs", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vsha2ch.vv", arg: "vd", against: "vs1 vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vsha2cl.vv", arg: "vd", against: "vs1 vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vsha2ms.vv", arg: "vd", against: "vs1 vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vsm3me.vv", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
    Keep{mnemonic: "vsm3c.vi", arg: "vd", against: "vs2", register: "", permit: constraint.DISJOINT},
};

# "Vector Masking": a masked instruction's destination cannot overlap the mask register v0, unless it is written with
# a mask value, as by a compare, or with a reduction's scalar. every vector row with a vm argument and a vd keeps vd
# from MASK_REGISTER while vm is v0.t, but the rows these patterns match. vmsbf.m, vmsif.m and vmsof.m write a mask
# but keep vd from v0 by their own rule, so no pattern matches them
pub val MASK_ARG:      str = "vm";
pub val MASK_REGISTER: str = "v0";

pub val MASK_FREE_COUNT: u32 = 18;

pub val MASK_FREE: [MASK_FREE_COUNT]str = [MASK_FREE_COUNT]str{
    "vmseq.*",
    "vmsne.*",
    "vmsltu.*",
    "vmslt.*",
    "vmsleu.*",
    "vmsle.*",
    "vmsgtu.*",
    "vmsgt.*",
    "vmfeq.*",
    "vmfne.*",
    "vmflt.*",
    "vmfle.*",
    "vmfgt.*",
    "vmfge.*",
    "vred*",
    "vfred*",
    "vwred*",
    "vfwred*",
};

# "Vector Load/Store Segment Instructions": the destination of a segment load covers one group per field, nf + 1 of
# them, nf being bits 31 to 29 of the encoding
pub val SEGMENTED_COUNT: u32 = 4;

pub val SEGMENTED: [SEGMENTED_COUNT]str = [SEGMENTED_COUNT]str{"vlseg*", "vlsseg*", "vluxseg*", "vloxseg*"};

pub val NF_LO: u64 = 29;
