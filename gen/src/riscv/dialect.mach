# the pseudo ops the vendor tools read and riscv-opcodes does not state, in riscv-opcodes' own syntax, and the file of their base
# ---
# each respells a base the file already admits, with the arguments and fixed
# bits the manual's table of pseudoinstructions gives it. fence with no
# operands is `iorw, iorw`, and fgt and fge are flt and fle with their
# sources swapped
pub val PSEUDOS_COUNT: u32 = 15;

pub val PSEUDOS: [PSEUDOS_COUNT]overlay.Extra = [PSEUDOS_COUNT]overlay.Extra{
    overlay.Extra{file: "rv_i", text: "$pseudo_op rv_i::xori not rd rs1 31..20=0xfff 14..12=4 6..2=0x04 1..0=3"},
    overlay.Extra{file: "rv64_i", text: "$pseudo_op rv64_i::subw negw rd rs2 31..25=32 19..15=0 14..12=0 6..2=0x0E 1..0=3"},
    overlay.Extra{file: "rv_i", text: "$pseudo_op rv_i::addi li rd imm12 19..15=0 14..12=0 6..2=0x04 1..0=3"},
    overlay.Extra{file: "rv_i", text: "$pseudo_op rv_i::fence fence 31..28=0 pred succ 19..15=0 14..12=0 11..7=0 6..2=0x03 1..0=3"},
    overlay.Extra{file: "rv_i", text: "$pseudo_op rv_i::fence fence 31..28=0 27..24=15 23..20=15 19..15=0 14..12=0 11..7=0 6..2=0x03 1..0=3"},
    overlay.Extra{file: "rv_zifencei", text: "$pseudo_op rv_zifencei::fence.i fence.i 31..20=0 19..15=0 14..12=1 11..7=0 6..2=0x03 1..0=3"},
    overlay.Extra{file: "rv_s", text: "$pseudo_op rv_s::sfence.vma sfence.vma 11..7=0 19..15=0 24..20=0 31..25=0x09 14..12=0 6..2=0x1C 1..0=3"},
    overlay.Extra{file: "rv_f", text: "$pseudo_op rv_f::flt.s fgt.s rd rs1 rs2 31..27=0x14 14..12=1 26..25=0 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_f", text: "$pseudo_op rv_f::fle.s fge.s rd rs1 rs2 31..27=0x14 14..12=0 26..25=0 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_d", text: "$pseudo_op rv_d::flt.d fgt.d rd rs1 rs2 31..27=0x14 14..12=1 26..25=1 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_d", text: "$pseudo_op rv_d::fle.d fge.d rd rs1 rs2 31..27=0x14 14..12=0 26..25=1 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_zfh", text: "$pseudo_op rv_zfh::flt.h fgt.h rd rs1 rs2 31..27=0x14 14..12=1 26..25=2 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_zfh", text: "$pseudo_op rv_zfh::fle.h fge.h rd rs1 rs2 31..27=0x14 14..12=0 26..25=2 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_q", text: "$pseudo_op rv_q::flt.q fgt.q rd rs1 rs2 31..27=0x14 14..12=1 26..25=3 6..2=0x14 1..0=3"},
    overlay.Extra{file: "rv_q", text: "$pseudo_op rv_q::fle.q fge.q rd rs1 rs2 31..27=0x14 14..12=0 26..25=3 6..2=0x14 1..0=3"},
};

# an operand written with a format its hook reads, by an argument of its group
# ---
# arg:    the argument
# format: the format handed to the syntax's immediate hook
pub rec Format {
    arg:    str;
    format: str;
}

# vsetvli's zimm11 and vsetivli's zimm10 are a vtype, written as its fields (`e32, m2, ta, ma`)
pub val FORMATS_COUNT: u32 = 2;

pub val FORMATS: [FORMATS_COUNT]Format = [FORMATS_COUNT]Format{
    Format{arg: "zimm10", format: "vtype"},
    Format{arg: "zimm11", format: "vtype"},
};

# a row written by a template of the dialect's own, with `<argument>` for an operand
# ---
# mnemonic: the row
# text:     its template
pub rec Template {
    mnemonic: str;
    text:     str;
}

# jalr takes its offset beside its base, as a load does (riscv-asm.md, "Pseudoinstructions"), but is no memory access
pub val TEMPLATES_COUNT: u32 = 1;

pub val TEMPLATES: [TEMPLATES_COUNT]Template = [TEMPLATES_COUNT]Template{
    Template{mnemonic: "jalr", text: "jalr <rd>, <imm12>(<rs1>)"},
};

# the multiply adds, which write their multiplicand before their multiplier (riscv-v-spec, "Vector Single-Width Integer Multiply-Add Instructions") while rank puts vs2 first
pub val REVERSED_COUNT: u32 = 21;

pub val REVERSED: [REVERSED_COUNT]str = [REVERSED_COUNT]str{
    "vfmacc.*",
    "vfmadd.*",
    "vfmsac.*",
    "vfmsub.*",
    "vfnmacc.*",
    "vfnmadd.*",
    "vfnmsac.*",
    "vfnmsub.*",
    "vfwmacc.*",
    "vfwmaccbf16.*",
    "vfwmsac.*",
    "vfwnmacc.*",
    "vfwnmsac.*",
    "vmacc.*",
    "vmadd.*",
    "vnmsac.*",
    "vnmsub.*",
    "vwmacc.*",
    "vwmaccsu.*",
    "vwmaccu.*",
    "vwmaccus.*",
};

# the rows that read the mask register as an operand of their own, written `v0` after the others (riscv-v-spec, "Vector Integer Add-with-Carry")
pub val CARRIES_COUNT: u32 = 4;

pub val CARRIES: [CARRIES_COUNT]str = [CARRIES_COUNT]str{"*.vim", "*.vvm", "*.vxm", "*.vfm"};
