# the reviewed effect facts the riscv generator adds to riscv-opcodes
#
# riscv-opcodes states no effect. a row's registers by role come from its
# arguments, and what they do not state is here: the roles that differ from
# an argument's default, the stack pointer the compressed stack forms name
# but hold in their fixed bits, the registers no operand names, memory
# accesses and their width, control transfer, stack change, latency and the
# default fixup kind of each relocatable operand. every table is matched by
# mnemonic, a trailing `*` matching a prefix, and the first row that matches
# is taken. register names are the register file's own. facts are from the
# riscv-isa-manual at 36fdac54a526.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use masc.core.effect;
use masc.core.operand;

use riscv_field: masc.isa.riscv.field;

# the role of the operand an argument names, every other argument being read
pub rec Role {
    arg:  str;
    role: operand.Role;
}

# destinations are written, a compressed rd_rs1 is read and written, and a
# csr instruction reads and writes the csr it names, which is its csr access
pub val ROLES_COUNT: u32 = 12;

pub val ROLES: [ROLES_COUNT]Role = [ROLES_COUNT]Role{
    Role{arg: "csr", role: operand.READ_WRITE},
    Role{arg: "rd", role: operand.WRITE},
    Role{arg: "rd_e", role: operand.WRITE},
    Role{arg: "rd_n0", role: operand.WRITE},
    Role{arg: "rd_n0_e", role: operand.WRITE},
    Role{arg: "rd_n2", role: operand.WRITE},
    Role{arg: "rd_p", role: operand.WRITE},
    Role{arg: "rd_p_e", role: operand.WRITE},
    Role{arg: "rd_rs1", role: operand.READ_WRITE},
    Role{arg: "rd_rs1_n0", role: operand.READ_WRITE},
    Role{arg: "rd_rs1_p", role: operand.READ_WRITE},
    Role{arg: "vd", role: operand.WRITE},
};

# a row's role for one argument in place of the default
pub rec Recast {
    mnemonic: str;
    arg:      str;
    role:     operand.Role;
}

# the rows whose role for an argument differs from its default, the first row that matches taken. these are
# - the whole register loads, moves and the mask logicals, which write every element of vd: no tail or inactive element
#   keeps its value, so vd stays a pure destination
# - the vector instructions that read their destination as an operand (the multiply adds, slide up, and the crypto
#   rounds whose vd holds the state), and zcmp's moves, whose s registers cm.mvsa01 writes and cm.mva01s reads
# - zacas's and zabha's amocas, which compares memory with the value rd holds and writes the loaded value back to rd
#   (riscv-isa-manual 36fdac54a526, src/unpriv/zacas.adoc), so rd, or rd's pair, is read and written
#
# a vector destination these read is one of the instruction's source operands, which the overlap rules over element
# widths read (gen.riscv.constraints)
pub val RECASTS_COUNT: u32 = 42;

pub val RECASTS: [RECASTS_COUNT]Recast = [RECASTS_COUNT]Recast{
    Recast{mnemonic: "vl1re*", arg: "vd", role: operand.WRITE},
    Recast{mnemonic: "vl2re*", arg: "vd", role: operand.WRITE},
    Recast{mnemonic: "vl4re*", arg: "vd", role: operand.WRITE},
    Recast{mnemonic: "vl8re*", arg: "vd", role: operand.WRITE},
    Recast{mnemonic: "vlm.v", arg: "vd", role: operand.WRITE},
    Recast{mnemonic: "vm*.mm", arg: "vd", role: operand.WRITE},
    Recast{mnemonic: "vmv1r.v", arg: "vd", role: operand.WRITE},
    Recast{mnemonic: "vmv2r.v", arg: "vd", role: operand.WRITE},
    Recast{mnemonic: "vmv4r.v", arg: "vd", role: operand.WRITE},
    Recast{mnemonic: "vmv8r.v", arg: "vd", role: operand.WRITE},
    Recast{mnemonic: "cm.mvsa01", arg: "c_sreg1", role: operand.WRITE},
    Recast{mnemonic: "cm.mvsa01", arg: "c_sreg2", role: operand.WRITE},
    Recast{mnemonic: "amocas.*", arg: "rd", role: operand.READ_WRITE},
    Recast{mnemonic: "vaesdf.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vaesdm.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vaesef.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vaesem.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vaeskf2.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vaesz.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfmacc.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfmadd.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfmsac.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfmsub.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfnmacc.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfnmadd.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfnmsac.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfnmsub.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfwmacc*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfwmsac.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfwnmacc.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfwnmsac.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vghsh.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vgmul.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vmacc.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vmadd.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vnmsac.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vnmsub.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vsha2*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vslideup.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vsm3c.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vsm4r.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vwmacc*", arg: "vd", role: operand.READ_WRITE},
};

# every other vector instruction reads vd as well, though not as a source operand. an element past vl, or masked off,
# keeps vd's value under the undisturbed policies of vtype (vta = 0, vma = 0), riscv-isa-manual 36fdac54a526,
# src/unpriv/vector-common.adoc, "Vector Tail Agnostic and Vector Mask Agnostic". the policy is vtype's value at run
# time, which no operand holds and so no register rule can test, so vd is read whatever the policy: under agnostic
# policies the read is spurious, which costs a scheduler a dependency and never misses one
pub val UNDISTURBED: Recast = Recast{mnemonic: "v*", arg: "vd", role: operand.READ_WRITE};

# the stack pointer a compressed stack form spells but holds in its fixed bits, as an operand fixed to x2
# ---
# at:   where it stands among the row's operands, LAST for after every other
# role: how the row uses it
pub rec Implicit {
    mnemonic: str;
    at:       u8;
    role:     operand.Role;
}

pub val LAST: u8 = 0xFF;

pub val IMPLICITS_COUNT: u32 = 10;

pub val IMPLICITS: [IMPLICITS_COUNT]Implicit = [IMPLICITS_COUNT]Implicit{
    Implicit{mnemonic: "c.addi16sp", at: 0, role: operand.READ_WRITE},
    Implicit{mnemonic: "c.addi4spn", at: 1, role: operand.READ},
    Implicit{mnemonic: "c.fldsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.flwsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.fsdsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.fswsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.ldsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.lwsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.sdsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.swsp", at: LAST, role: operand.READ},
};

# the register the implicit operand is fixed to
pub val STACK_POINTER: str = "x2";

# registers a row reads and writes that no operand names, by the register file's names split by spaces
pub rec Uses {
    mnemonic: str;
    read:     str;
    written:  str;
}

# the link register of the compressed calls and cm.jalt, zcmp's argument
# moves, and the stack pointer and every register of the largest list that
# cm.push may save and the pops restore, since the list operand chooses among them
pub val USES_COUNT: u32 = 9;

pub val USES: [USES_COUNT]Uses = [USES_COUNT]Uses{
    Uses{mnemonic: "c.jal", read: "", written: "x1"},
    Uses{mnemonic: "c.jalr", read: "", written: "x1"},
    Uses{mnemonic: "cm.jalt", read: "", written: "x1"},
    Uses{mnemonic: "cm.mva01s", read: "", written: "x10 x11"},
    Uses{mnemonic: "cm.mvsa01", read: "x10 x11", written: ""},
    Uses{mnemonic: "cm.pop", read: "x2", written: "x1 x2 x8 x9 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27"},
    Uses{mnemonic: "cm.popret", read: "x2", written: "x1 x2 x8 x9 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27"},
    Uses{mnemonic: "cm.popretz", read: "x2", written: "x1 x2 x8 x9 x10 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27"},
    Uses{mnemonic: "cm.push", read: "x1 x2 x8 x9 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27", written: "x2"},
};

# the control and status state a row reads and writes that no operand names, by the register file's names split by spaces
# ---
# mnemonic: the rows it states, a pattern with an optional `*`
# arg:      an argument the row must have, empty when none is needed
# read:     the state it reads
# written:  the state it writes
#
# a table is a domain of state, and its first row that matches a mnemonic and has its argument is the one taken, so a
# row for an exception comes before the row for the rule it excepts. every domain applies, so a row can take a state
# from each. state that accrues (fflags, vxsat) is both read and written, since an instruction adds to what is there
# and a write that left it undefined would let a pass drop the sets before it
pub rec State {
    mnemonic: str;
    arg:      str;
    read:     str;
    written:  str;
}

# the vector configuration, riscv-isa-manual 36fdac54a526, src/unpriv/vector-common.adoc
# - "Vector Start Index": every vector instruction, vset* included, begins at vstart and resets it to zero
# - "Configuration-Setting Instructions" and "AVL encoding": vset* write vl and vtype. vsetvli with rd and rs1 both x0
#   keeps vl and requires the new VLMAX to equal the old one, so vset* read vl and vtype whatever their operands
# - "Vector Length": the fault-only-first loads may shorten vl
# - "Vector Type Illegal": the whole register loads and stores do not depend on vtype, and depend on neither vl
# - "Whole Vector Register Move": vmv<nr>r.v states its element width from SEW, so it reads vtype and not vl
# - every other vector instruction depends on vl and vtype. the mask loads and stores depend on vtype through its
#   constraint on vl ("Vector Unit-Stride Instructions")
pub val CONFIGS_COUNT: u32 = 12;

pub val CONFIGS: [CONFIGS_COUNT]State = [CONFIGS_COUNT]State{
    State{mnemonic: "vset*", arg: "", read: "vl vtype", written: "vl vtype vstart"},
    State{mnemonic: "vle*ff.v", arg: "", read: "vl vtype vstart", written: "vl vstart"},
    State{mnemonic: "vl1re*", arg: "", read: "vstart", written: "vstart"},
    State{mnemonic: "vl2re*", arg: "", read: "vstart", written: "vstart"},
    State{mnemonic: "vl4re*", arg: "", read: "vstart", written: "vstart"},
    State{mnemonic: "vl8re*", arg: "", read: "vstart", written: "vstart"},
    State{mnemonic: "vs1r.v", arg: "", read: "vstart", written: "vstart"},
    State{mnemonic: "vs2r.v", arg: "", read: "vstart", written: "vstart"},
    State{mnemonic: "vs4r.v", arg: "", read: "vstart", written: "vstart"},
    State{mnemonic: "vs8r.v", arg: "", read: "vstart", written: "vstart"},
    State{mnemonic: "vmv*r.v", arg: "", read: "vtype vstart", written: "vstart"},
    State{mnemonic: "v*", arg: "", read: "vl vtype vstart", written: "vstart"},
};

# the floating-point state. riscv-isa-manual 36fdac54a526, src/unpriv/f-st-ext.adoc, "Floating-Point Control and Status
# Register" and the sections on computational, conversion and compare instructions, with the same sections of d-st-ext,
# q-st-ext, zfh and zfa, and src/unpriv/vector-common.adoc, "Vector Arithmetic Instruction Formats" and "Vector
# Floating-Point Exception Flags"
# - an instruction with a rounding mode field rounds by the field, or by frm when the field says dynamic, and raises
#   exception flags in fflags. frm is read only under the dynamic field, which REGISTER_RULES states
# - the compares, min and max, and the Zfa forms without a field, raise the invalid flag, and fcvtmod.w.d raises its
#   flags and rounds toward zero
# - sign injection, classify, the moves, the immediate load, loads and stores raise nothing and round nothing
# - every vector floating-point instruction uses frm, those that do not depend on it too, since an invalid frm makes
#   any of them reserved, and sets fflags for each active element. activity is a mask's value, so fflags is written
#   whatever the mask says. the instructions that raise nothing are the sign injections, classify, the moves, merge
#   and the slides by one
# - a row with a floating-point register operand, or restated on the x registers from one, that no row here states is
#   refused, so a new one states its state. a restated row has the semantics of its f row (src/unpriv/zfinx.adoc,
#   norm:Zfinx_x_regs), so the same rows state it
pub val FLOATS_COUNT: u32 = 32;

pub val FLOATS: [FLOATS_COUNT]State = [FLOATS_COUNT]State{
    State{mnemonic: "fsgnj*", arg: "", read: "", written: ""},
    State{mnemonic: "fclass.*", arg: "", read: "", written: ""},
    State{mnemonic: "fmv*", arg: "", read: "", written: ""},
    State{mnemonic: "fli.*", arg: "", read: "", written: ""},
    State{mnemonic: "flw", arg: "", read: "", written: ""},
    State{mnemonic: "fld", arg: "", read: "", written: ""},
    State{mnemonic: "flh", arg: "", read: "", written: ""},
    State{mnemonic: "flq", arg: "", read: "", written: ""},
    State{mnemonic: "fsw", arg: "", read: "", written: ""},
    State{mnemonic: "fsd", arg: "", read: "", written: ""},
    State{mnemonic: "fsh", arg: "", read: "", written: ""},
    State{mnemonic: "fsq", arg: "", read: "", written: ""},
    State{mnemonic: "c.fl*", arg: "", read: "", written: ""},
    State{mnemonic: "c.fs*", arg: "", read: "", written: ""},
    State{mnemonic: "*", arg: "rm", read: "fflags", written: "fflags"},
    State{mnemonic: "fmin.*", arg: "", read: "fflags", written: "fflags"},
    State{mnemonic: "fmax.*", arg: "", read: "fflags", written: "fflags"},
    State{mnemonic: "fminm.*", arg: "", read: "fflags", written: "fflags"},
    State{mnemonic: "fmaxm.*", arg: "", read: "fflags", written: "fflags"},
    State{mnemonic: "feq.*", arg: "", read: "fflags", written: "fflags"},
    State{mnemonic: "flt.*", arg: "", read: "fflags", written: "fflags"},
    State{mnemonic: "fle.*", arg: "", read: "fflags", written: "fflags"},
    State{mnemonic: "fltq.*", arg: "", read: "fflags", written: "fflags"},
    State{mnemonic: "fleq.*", arg: "", read: "fflags", written: "fflags"},
    State{mnemonic: "fcvtmod.w.d", arg: "", read: "fflags", written: "fflags"},
    State{mnemonic: "vfsgnj*", arg: "", read: "frm", written: ""},
    State{mnemonic: "vfclass.v", arg: "", read: "frm", written: ""},
    State{mnemonic: "vfmv*", arg: "", read: "frm", written: ""},
    State{mnemonic: "vfmerge.*", arg: "", read: "frm", written: ""},
    State{mnemonic: "vfslide1*", arg: "", read: "frm", written: ""},
    State{mnemonic: "vf*", arg: "", read: "frm fflags", written: "fflags"},
    State{mnemonic: "vmf*", arg: "", read: "frm fflags", written: "fflags"},
};

# the vector fixed-point state, riscv-isa-manual 36fdac54a526, src/unpriv/vector-common.adoc, "Vector Fixed-Point
# Arithmetic Instructions": the averaging adds and subtracts, the fractional multiply, the scaling shifts and the
# narrowing clips round by vxrm, and the saturating adds and subtracts, the fractional multiply and the clips set vxsat
pub val FIXEDS_COUNT: u32 = 8;

pub val FIXEDS: [FIXEDS_COUNT]State = [FIXEDS_COUNT]State{
    State{mnemonic: "vaadd*", arg: "", read: "vxrm", written: ""},
    State{mnemonic: "vasub*", arg: "", read: "vxrm", written: ""},
    State{mnemonic: "vnclip*", arg: "", read: "vxrm vxsat", written: "vxsat"},
    State{mnemonic: "vsadd*", arg: "", read: "vxsat", written: "vxsat"},
    State{mnemonic: "vsmul.*", arg: "", read: "vxrm vxsat", written: "vxsat"},
    State{mnemonic: "vssra.*", arg: "", read: "vxrm", written: ""},
    State{mnemonic: "vssrl.*", arg: "", read: "vxrm", written: ""},
    State{mnemonic: "vssub*", arg: "", read: "vxsat", written: "vxsat"},
};

# how an access's element width is stated
# ---
# FIXED:  `bits` bits
# SUFFIX: the width the mnemonic's last part names: b 8, h 16, w 32, d 64, q 128
# XLEN:   one register of the integer file, as zcmp saves, its count no operand states
# BLOCK:  a cache block, whose size the platform states and no operand gives
pub def Element: u8;

pub val FIXED:  Element = 0;
pub val SUFFIX: Element = 1;
pub val XLEN:   Element = 2;
pub val BLOCK:  Element = 3;

# a scalar memory access: its role and its width. its address is the row's
# address register (rs1, rs1_p, or the stack pointer), offset by the row's
# immediate when it has one, and for zcmp the stack pointer, which no operand names
pub rec Memory {
    mnemonic: str;
    role:     operand.Role;
    element:  Element;
    bits:     u32;
}

pub val MEMORIES_COUNT: u32 = 72;

pub val MEMORIES: [MEMORIES_COUNT]Memory = [MEMORIES_COUNT]Memory{
