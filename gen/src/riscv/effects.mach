    Memory{mnemonic: "lr.*", role: operand.READ, element: SUFFIX, bits: 0},
    Memory{mnemonic: "lw", role: operand.READ, element: FIXED, bits: 32},
    Memory{mnemonic: "lw.aq", role: operand.READ, element: FIXED, bits: 32},
    Memory{mnemonic: "lwu", role: operand.READ, element: FIXED, bits: 32},
    Memory{mnemonic: "sb", role: operand.WRITE, element: FIXED, bits: 8},
    Memory{mnemonic: "sb.rl", role: operand.WRITE, element: FIXED, bits: 8},
    Memory{mnemonic: "sc.*", role: operand.WRITE, element: SUFFIX, bits: 0},
    Memory{mnemonic: "sd", role: operand.WRITE, element: FIXED, bits: 64},
    Memory{mnemonic: "sd.rl", role: operand.WRITE, element: FIXED, bits: 64},
    Memory{mnemonic: "sh", role: operand.WRITE, element: FIXED, bits: 16},
    Memory{mnemonic: "sh.rl", role: operand.WRITE, element: FIXED, bits: 16},
    Memory{mnemonic: "ssamoswap.*", role: operand.READ_WRITE, element: SUFFIX, bits: 0},
    Memory{mnemonic: "sw", role: operand.WRITE, element: FIXED, bits: 32},
    Memory{mnemonic: "sw.rl", role: operand.WRITE, element: FIXED, bits: 32},
    Memory{mnemonic: "vl*", role: operand.READ, element: FIXED, bits: 0},
    Memory{mnemonic: "vs*", role: operand.WRITE, element: FIXED, bits: 0},
};

# the major opcodes of the vector loads and stores, the only rows `vl*` and `vs*` match as accesses
pub val LOAD_FP:  u64 = 0x07;
pub val STORE_FP: u64 = 0x27;

# a control transfer: what it does, where to, whether it may fall through, and the argument holding its target
pub rec Control {
    mnemonic:    str;
    transfer:    effect.Transfer;
    target:      effect.Target;
    conditional: bool;
    arg:         str;
}

# jal and jalr are jumps by default, and their rules below say when the
# registers they name make them calls or a return
pub val CONTROLS_COUNT: u32 = 27;

pub val CONTROLS: [CONTROLS_COUNT]Control = [CONTROLS_COUNT]Control{
    Control{mnemonic: "beq", transfer: effect.JUMP, target: effect.DIRECT, conditional: true, arg: "bimm12hi"},
    Control{mnemonic: "bge", transfer: effect.JUMP, target: effect.DIRECT, conditional: true, arg: "bimm12hi"},
    Control{mnemonic: "bgeu", transfer: effect.JUMP, target: effect.DIRECT, conditional: true, arg: "bimm12hi"},
    Control{mnemonic: "blt", transfer: effect.JUMP, target: effect.DIRECT, conditional: true, arg: "bimm12hi"},
    Control{mnemonic: "bltu", transfer: effect.JUMP, target: effect.DIRECT, conditional: true, arg: "bimm12hi"},
    Control{mnemonic: "bne", transfer: effect.JUMP, target: effect.DIRECT, conditional: true, arg: "bimm12hi"},
    Control{mnemonic: "c.beqz", transfer: effect.JUMP, target: effect.DIRECT, conditional: true, arg: "c_bimm9hi"},
    Control{mnemonic: "c.bnez", transfer: effect.JUMP, target: effect.DIRECT, conditional: true, arg: "c_bimm9hi"},
    Control{mnemonic: "c.ebreak", transfer: effect.TRAP, target: effect.UNTARGETED, conditional: false, arg: ""},
    Control{mnemonic: "c.j", transfer: effect.JUMP, target: effect.DIRECT, conditional: false, arg: "c_imm12"},
    Control{mnemonic: "c.jal", transfer: effect.CALL, target: effect.DIRECT, conditional: false, arg: "c_imm12"},
    Control{mnemonic: "c.jalr", transfer: effect.CALL, target: effect.INDIRECT, conditional: false, arg: "c_rs1_n0"},
    Control{mnemonic: "c.jr", transfer: effect.JUMP, target: effect.INDIRECT, conditional: false, arg: "rs1_n0"},
    Control{mnemonic: "cm.jalt", transfer: effect.CALL, target: effect.INDIRECT, conditional: false, arg: "c_index"},
    Control{mnemonic: "cm.jt", transfer: effect.JUMP, target: effect.INDIRECT, conditional: false, arg: "c_index_jt"},
    Control{mnemonic: "cm.popret", transfer: effect.RETURN, target: effect.UNTARGETED, conditional: false, arg: ""},
    Control{mnemonic: "cm.popretz", transfer: effect.RETURN, target: effect.UNTARGETED, conditional: false, arg: ""},
    Control{mnemonic: "ebreak", transfer: effect.TRAP, target: effect.UNTARGETED, conditional: false, arg: ""},
    Control{mnemonic: "ecall", transfer: effect.TRAP, target: effect.UNTARGETED, conditional: false, arg: ""},
    Control{mnemonic: "jal", transfer: effect.JUMP, target: effect.DIRECT, conditional: false, arg: "jimm20"},
    Control{mnemonic: "jalr", transfer: effect.JUMP, target: effect.INDIRECT, conditional: false, arg: "rs1"},
    Control{mnemonic: "mnret", transfer: effect.RETURN, target: effect.UNTARGETED, conditional: false, arg: ""},
    Control{mnemonic: "mret", transfer: effect.RETURN, target: effect.UNTARGETED, conditional: false, arg: ""},
    Control{mnemonic: "sret", transfer: effect.RETURN, target: effect.UNTARGETED, conditional: false, arg: ""},
    Control{mnemonic: "wrs.nto", transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, arg: ""},
    Control{mnemonic: "wrs.sto", transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, arg: ""},
    Control{mnemonic: "wfi", transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, arg: ""},
};

# a test of an argument's value
# ---
# registers: its register is one of these, by the register file's names split by spaces
# enumerant: its enumerant is exactly this value
pub tag Test: u8 {
    registers: str;
    enumerant: u32;
}

# a test of one argument
# ---
# arg:  the argument, empty when the term is not used
# test: what its value must meet
pub rec Term {
    arg:  str;
    test: Test;
}

# a control transfer a row has instead of its own when its registers meet both terms
pub rec Rule {
    mnemonic:    str;
    transfer:    effect.Transfer;
    target:      effect.Target;
    conditional: bool;
    first:       Term;
    second:      Term;
}

# the calling convention's meaning of the registers jal and jalr name, from
# the riscv-isa-manual's unprivileged chapter, Unconditional Jumps, and its
# table of return-address stack hints. the link registers are x1 and x5.
# - a write to a link register is a call. when rd and rs1 are both links and
#   differ, as a coroutine swap, the manual hints a pop then a push, which is
#   still a call, since the instruction links and transfers to rs1. the pop is
#   a prediction hint and not a transfer kind, so it is not stated
# - rd x0 with a link rs1 is a return, the manual's pop hint
# - any other write of rd or to x0 is a jump. a jalr that writes a register
#   other than a link and reads a link only hints a pop, and is a jump
# c.jr is jalr with rd x0, so a link rs1 makes it a return. c.jalr always writes x1
pub val RULES_COUNT: u32 = 4;

pub val RULES: [RULES_COUNT]Rule = [RULES_COUNT]Rule{
    Rule{mnemonic: "c.jr", transfer: effect.RETURN, target: effect.UNTARGETED, conditional: false, first: Term{arg: "rs1_n0", test: Test.registers{"x1 x5"}}, second: Term{arg: "", test: Test.registers{""}}},
    Rule{mnemonic: "jal", transfer: effect.CALL, target: effect.DIRECT, conditional: false, first: Term{arg: "rd", test: Test.registers{"x1 x5"}}, second: Term{arg: "", test: Test.registers{""}}},
    Rule{mnemonic: "jalr", transfer: effect.CALL, target: effect.INDIRECT, conditional: false, first: Term{arg: "rd", test: Test.registers{"x1 x5"}}, second: Term{arg: "", test: Test.registers{""}}},
    Rule{mnemonic: "jalr", transfer: effect.RETURN, target: effect.UNTARGETED, conditional: false, first: Term{arg: "rd", test: Test.registers{"x0"}}, second: Term{arg: "rs1", test: Test.registers{"x1 x5"}}},
};

# registers a row reads and writes as well as its own when an argument meets the term
# ---
# mnemonic: the rows it states, a pattern with an optional `*`
# term:     the test the row's argument must meet, a row without the argument taking none of it
# read:     the further registers it reads then, by the register file's names split by spaces
# written:  the further registers it writes then
#
# at most one row may match a mnemonic and have its argument, and a row two match is refused naming both, so each fact
# has one owner. a row holds that one rule, whose sets are the row's own with these added and which stands in for them
# whenever the term holds
pub rec RegisterRule {
    mnemonic: str;
    term:     Term;
    read:     str;
    written:  str;
}

# a row whose rounding mode field is dynamic rounds by frm, and any other field rounds by itself and leaves frm unread,
# riscv-isa-manual 36fdac54a526, src/unpriv/f-st-ext.adoc, "Floating-Point Control and Status Register"
pub val REGISTER_RULES_COUNT: u32 = 1;

pub val REGISTER_RULES: [REGISTER_RULES_COUNT]RegisterRule = [REGISTER_RULES_COUNT]RegisterRule{
    RegisterRule{mnemonic: "*", term: Term{arg: "rm", test: Test.enumerant{riscv_field.DYN}}, read: "frm", written: ""},
};

# a change to the stack pointer by the value of an argument's operand, as zcmp's adjustment
pub rec Stack {
    mnemonic: str;
    arg:      str;
}

pub val STACKS_COUNT: u32 = 4;

pub val STACKS: [STACKS_COUNT]Stack = [STACKS_COUNT]Stack{
    Stack{mnemonic: "cm.pop", arg: "c_spimm"},
    Stack{mnemonic: "cm.popret", arg: "c_spimm"},
    Stack{mnemonic: "cm.popretz", arg: "c_spimm"},
    Stack{mnemonic: "cm.push", arg: "c_spimm"},
};

# a latency class, the last row naming every row no other names
pub rec Latency {
    mnemonic: str;
    latency:  effect.Latency;
}

# divides and square roots are long, multiplies and floating point and
# vector operations are pipelined, and csr access, fences, traps, returns,
# waits and the cache and translation maintenance serialize
pub val LATENCIES_COUNT: u32 = 44;

pub val LATENCIES: [LATENCIES_COUNT]Latency = [LATENCIES_COUNT]Latency{
    Latency{mnemonic: "div*", latency: effect.MANY},
    Latency{mnemonic: "rem*", latency: effect.MANY},
    Latency{mnemonic: "fdiv.*", latency: effect.MANY},
    Latency{mnemonic: "fsqrt.*", latency: effect.MANY},
    Latency{mnemonic: "vdiv*", latency: effect.MANY},
    Latency{mnemonic: "vrem*", latency: effect.MANY},
    Latency{mnemonic: "vfdiv.*", latency: effect.MANY},
    Latency{mnemonic: "vfrdiv.*", latency: effect.MANY},
    Latency{mnemonic: "vfsqrt.*", latency: effect.MANY},
    Latency{mnemonic: "csrr*", latency: effect.SERIAL},
    Latency{mnemonic: "fence*", latency: effect.SERIAL},
    Latency{mnemonic: "sfence.*", latency: effect.SERIAL},
    Latency{mnemonic: "hfence.*", latency: effect.SERIAL},
    Latency{mnemonic: "sinval.*", latency: effect.SERIAL},
    Latency{mnemonic: "hinval.*", latency: effect.SERIAL},
    Latency{mnemonic: "cbo.*", latency: effect.SERIAL},
    Latency{mnemonic: "ecall", latency: effect.SERIAL},
    Latency{mnemonic: "ebreak", latency: effect.SERIAL},
    Latency{mnemonic: "c.ebreak", latency: effect.SERIAL},
    Latency{mnemonic: "mret", latency: effect.SERIAL},
    Latency{mnemonic: "sret", latency: effect.SERIAL},
    Latency{mnemonic: "mnret", latency: effect.SERIAL},
    Latency{mnemonic: "wfi", latency: effect.SERIAL},
    Latency{mnemonic: "wrs.*", latency: effect.SERIAL},
    Latency{mnemonic: "sctrclr", latency: effect.SERIAL},
    Latency{mnemonic: "vset*", latency: effect.SERIAL},
    Latency{mnemonic: "mul*", latency: effect.FEW},
    Latency{mnemonic: "clmul*", latency: effect.FEW},
    Latency{mnemonic: "aes*", latency: effect.FEW},
    Latency{mnemonic: "sha*", latency: effect.FEW},
    Latency{mnemonic: "sm3*", latency: effect.FEW},
    Latency{mnemonic: "sm4*", latency: effect.FEW},
    Latency{mnemonic: "f*", latency: effect.FEW},
    Latency{mnemonic: "v*", latency: effect.FEW},
    Latency{mnemonic: "amo*", latency: effect.FEW},
    Latency{mnemonic: "lr.*", latency: effect.FEW},
    Latency{mnemonic: "sc.*", latency: effect.FEW},
    Latency{mnemonic: "ssamoswap.*", latency: effect.FEW},
    Latency{mnemonic: "cm.push", latency: effect.FEW},
    Latency{mnemonic: "cm.pop*", latency: effect.FEW},
    Latency{mnemonic: "cm.jalt", latency: effect.FEW},
    Latency{mnemonic: "cm.jt", latency: effect.FEW},
    Latency{mnemonic: "c.*", latency: effect.ONE},
    Latency{mnemonic: "*", latency: effect.ONE},
};

# a marked row: a copy of a base row with a marker operand after its own, the
# symbol of the relocation that lets the linker relax the sequence it ends, and
# the register the sequence names fixed, from riscv-elf-psabi-doc 48969b7,
# riscv-elf.adoc, "Thread Local Storage": the local exec add through tp, and
# the descriptor call through t0, both of which llvm-mc requires
# ---
# mnemonic:  the base row's mnemonic, which names one row
# specifier: the marked row's key after its base's key and a dot
# fixup:     the marker's fixup kind, by its path in the riscv fixup module
# arg:       the argument of the operand the sequence fixes
# register:  the register it is fixed to, by the register file's name
pub rec Mark {
    mnemonic:  str;
    specifier: str;
    fixup:     str;
    arg:       str;
    register:  str;
}

pub val MARKS_COUNT: u32 = 2;

pub val MARKS: [MARKS_COUNT]Mark = [MARKS_COUNT]Mark{
    Mark{mnemonic: "add", specifier: "tprel_add", fixup: "riscv_fixup.TPREL_ADD", arg: "rs2", register: "x4"},
    Mark{mnemonic: "jalr", specifier: "tlsdesc_call", fixup: "riscv_fixup.TLSDESC_PCREL_CALL", arg: "rd", register: "x5"},
};

# the fixup kind a symbol takes by default in a row's relocatable operand, by
# its path in the riscv fixup module: %lo's i and s forms, %hi, %pcrel_hi,
# the branch and jump offsets and their compressed forms
pub rec Fixup {
    mnemonic: str;
    kind:     str;
}

pub val FIXUPS_COUNT: u32 = 40;

pub val FIXUPS: [FIXUPS_COUNT]Fixup = [FIXUPS_COUNT]Fixup{
    Fixup{mnemonic: "addi", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "addiw", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "andi", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "auipc", kind: "riscv_fixup.PCREL_HI20"},
    Fixup{mnemonic: "beq", kind: "riscv_fixup.BRANCH12"},
    Fixup{mnemonic: "bge", kind: "riscv_fixup.BRANCH12"},
    Fixup{mnemonic: "bgeu", kind: "riscv_fixup.BRANCH12"},
    Fixup{mnemonic: "blt", kind: "riscv_fixup.BRANCH12"},
    Fixup{mnemonic: "bltu", kind: "riscv_fixup.BRANCH12"},
    Fixup{mnemonic: "bne", kind: "riscv_fixup.BRANCH12"},
    Fixup{mnemonic: "c.beqz", kind: "riscv_fixup.RVC_BRANCH"},
    Fixup{mnemonic: "c.bnez", kind: "riscv_fixup.RVC_BRANCH"},
    Fixup{mnemonic: "c.j", kind: "riscv_fixup.RVC_JUMP"},
    Fixup{mnemonic: "c.jal", kind: "riscv_fixup.RVC_JUMP"},
    Fixup{mnemonic: "fld", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "flh", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "flq", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "flw", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "fsd", kind: "riscv_fixup.LO12_S"},
    Fixup{mnemonic: "fsh", kind: "riscv_fixup.LO12_S"},
    Fixup{mnemonic: "fsq", kind: "riscv_fixup.LO12_S"},
    Fixup{mnemonic: "fsw", kind: "riscv_fixup.LO12_S"},
    Fixup{mnemonic: "jal", kind: "riscv_fixup.JAL20"},
    Fixup{mnemonic: "jalr", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "lb", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "lbu", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "ld", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "lh", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "lhu", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "lui", kind: "riscv_fixup.HI20"},
    Fixup{mnemonic: "lw", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "lwu", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "ori", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "sb", kind: "riscv_fixup.LO12_S"},
    Fixup{mnemonic: "sd", kind: "riscv_fixup.LO12_S"},
    Fixup{mnemonic: "sh", kind: "riscv_fixup.LO12_S"},
    Fixup{mnemonic: "slti", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "sltiu", kind: "riscv_fixup.LO12_I"},
    Fixup{mnemonic: "sw", kind: "riscv_fixup.LO12_S"},
    Fixup{mnemonic: "xori", kind: "riscv_fixup.LO12_I"},
};

# the rows riscv-opcodes states once but whose encoding differs by width, so
# each is a row at rv32 and a row at rv64: zcmp's, whose stack adjustment's
# base differs, with whether the adjustment is written negative, and
# amocas.d, whose registers are even pairs at rv32
pub rec Split {
    mnemonic: str;
    negative: bool;
}

pub val SPLITS_COUNT: u32 = 5;

pub val SPLITS: [SPLITS_COUNT]Split = [SPLITS_COUNT]Split{
    Split{mnemonic: "amocas.d", negative: false},
    Split{mnemonic: "cm.pop", negative: false},
    Split{mnemonic: "cm.popret", negative: false},
    Split{mnemonic: "cm.popretz", negative: false},
    Split{mnemonic: "cm.push", negative: true},
};

# the longer form of a row whose target is out of range
# ---
# from:     the row relaxed
# to:       the row of the form's first step
# inverted: whether the first step is the inverted branch, skipping a jal to the target
# link:     for a form of one step, the register its jal or branch takes in place of the operand
#           the row relaxed holds implicitly, by the register file's name
pub rec Relax {
    from:     str;
    to:       str;
    inverted: bool;
    link:     str;
}

# a branch out of range becomes the inverted branch past a jal x0, a
# compressed branch becomes its full branch against x0, and the compressed
# jumps become jal with x0 or ra
pub val RELAXES_COUNT: u32 = 10;

pub val RELAXES: [RELAXES_COUNT]Relax = [RELAXES_COUNT]Relax{
    Relax{from: "beq", to: "bne", inverted: true, link: ""},
    Relax{from: "bge", to: "blt", inverted: true, link: ""},
    Relax{from: "bgeu", to: "bltu", inverted: true, link: ""},
    Relax{from: "blt", to: "bge", inverted: true, link: ""},
    Relax{from: "bltu", to: "bgeu", inverted: true, link: ""},
    Relax{from: "bne", to: "beq", inverted: true, link: ""},
    Relax{from: "c.beqz", to: "beq", inverted: false, link: "x0"},
    Relax{from: "c.bnez", to: "bne", inverted: false, link: "x0"},
    Relax{from: "c.j", to: "jal", inverted: false, link: "x0"},
    Relax{from: "c.jal", to: "jal", inverted: false, link: "x1"},
};

# the jump of an inverted branch's form, and the register it links to
pub val FAR:      str = "jal";
pub val FAR_LINK: str = "x0";

# the no-ops the code fill writes, longest first: addi x0, x0, 0 and c.nop
pub val FILLS: [2]str = [2]str{"addi", "c.nop"};
