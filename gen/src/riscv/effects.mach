# the reviewed effect facts the riscv generator adds to riscv-opcodes
#
# riscv-opcodes states no effect. a row's registers by role come from its
# arguments, and what they do not state is here: the roles that differ from
# an argument's default, the stack pointer the compressed stack forms name
# but hold in their fixed bits, the registers no operand names, memory
# accesses and their width, control transfer, stack change, latency and the
# default fixup kind of each relocatable operand. every table is matched by
# mnemonic, a trailing `*` matching a prefix, and the first row that matches
# is taken. register names are the register file's own. facts are from the
# riscv-isa-manual at 36fdac54a526.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use masc.core.effect;
use masc.core.operand;

# the role of the operand an argument names, every other argument being read
pub rec Role {
    arg:  str;
    role: operand.Role;
}

# destinations are written, a compressed rd_rs1 is read and written, and a
# csr instruction reads and writes the csr it names, which is its csr access
pub val ROLES_COUNT: u32 = 12;

pub val ROLES: [ROLES_COUNT]Role = [ROLES_COUNT]Role{
    Role{arg: "csr", role: operand.READ_WRITE},
    Role{arg: "rd", role: operand.WRITE},
    Role{arg: "rd_e", role: operand.WRITE},
    Role{arg: "rd_n0", role: operand.WRITE},
    Role{arg: "rd_n0_e", role: operand.WRITE},
    Role{arg: "rd_n2", role: operand.WRITE},
    Role{arg: "rd_p", role: operand.WRITE},
    Role{arg: "rd_p_e", role: operand.WRITE},
    Role{arg: "rd_rs1", role: operand.READ_WRITE},
    Role{arg: "rd_rs1_n0", role: operand.READ_WRITE},
    Role{arg: "rd_rs1_p", role: operand.READ_WRITE},
    Role{arg: "vd", role: operand.WRITE},
};

# a row's role for one argument in place of the default
pub rec Recast {
    mnemonic: str;
    arg:      str;
    role:     operand.Role;
}

# the vector instructions that read their destination as well (the multiply
# adds, slide up, and the crypto rounds whose vd holds the state), and zcmp's
# moves, whose s registers cm.mvsa01 writes and cm.mva01s reads
pub val RECASTS_COUNT: u32 = 30;

pub val RECASTS: [RECASTS_COUNT]Recast = [RECASTS_COUNT]Recast{
    Recast{mnemonic: "cm.mvsa01", arg: "c_sreg1", role: operand.WRITE},
    Recast{mnemonic: "cm.mvsa01", arg: "c_sreg2", role: operand.WRITE},
    Recast{mnemonic: "vaesdf.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vaesdm.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vaesef.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vaesem.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vaeskf2.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vaesz.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfmacc.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfmadd.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfmsac.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfmsub.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfnmacc.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfnmadd.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfnmsac.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfnmsub.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfwmacc*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfwmsac.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfwnmacc.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vfwnmsac.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vghsh.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vgmul.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vmacc.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vmadd.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vnmsac.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vnmsub.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vsha2*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vslideup.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vsm3c.*", arg: "vd", role: operand.READ_WRITE},
    Recast{mnemonic: "vsm4r.*", arg: "vd", role: operand.READ_WRITE},
};

# the stack pointer a compressed stack form spells but holds in its fixed bits, as an operand fixed to x2
# ---
# at:   where it stands among the row's operands, LAST for after every other
# role: how the row uses it
pub rec Implicit {
    mnemonic: str;
    at:       u8;
    role:     operand.Role;
}

pub val LAST: u8 = 0xFF;

pub val IMPLICITS_COUNT: u32 = 10;

pub val IMPLICITS: [IMPLICITS_COUNT]Implicit = [IMPLICITS_COUNT]Implicit{
    Implicit{mnemonic: "c.addi16sp", at: 0, role: operand.READ_WRITE},
    Implicit{mnemonic: "c.addi4spn", at: 1, role: operand.READ},
    Implicit{mnemonic: "c.fldsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.flwsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.fsdsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.fswsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.ldsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.lwsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.sdsp", at: LAST, role: operand.READ},
    Implicit{mnemonic: "c.swsp", at: LAST, role: operand.READ},
};

# the register the implicit operand is fixed to
pub val STACK_POINTER: str = "x2";

# registers a row reads and writes that no operand names, by the register file's names split by spaces
pub rec Uses {
    mnemonic: str;
    read:     str;
    written:  str;
}

# the link register of the compressed calls and cm.jalt, zcmp's argument
# moves, and the stack pointer and every register of the largest list that
# cm.push may save and the pops restore, since the list operand chooses among them
pub val USES_COUNT: u32 = 9;

pub val USES: [USES_COUNT]Uses = [USES_COUNT]Uses{
    Uses{mnemonic: "c.jal", read: "", written: "x1"},
    Uses{mnemonic: "c.jalr", read: "", written: "x1"},
    Uses{mnemonic: "cm.jalt", read: "", written: "x1"},
    Uses{mnemonic: "cm.mva01s", read: "", written: "x10 x11"},
    Uses{mnemonic: "cm.mvsa01", read: "x10 x11", written: ""},
    Uses{mnemonic: "cm.pop", read: "x2", written: "x1 x2 x8 x9 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27"},
    Uses{mnemonic: "cm.popret", read: "x2", written: "x1 x2 x8 x9 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27"},
    Uses{mnemonic: "cm.popretz", read: "x2", written: "x1 x2 x8 x9 x10 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27"},
    Uses{mnemonic: "cm.push", read: "x1 x2 x8 x9 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27", written: "x2"},
};

# how an access's element width is stated
# ---
# FIXED:  `bits` bits
# SUFFIX: the width the mnemonic's last part names: b 8, h 16, w 32, d 64, q 128
# XLEN:   one register of the integer file, as zcmp saves, its count no operand states
# BLOCK:  a cache block, whose size the platform states and no operand gives
pub def Element: u8;

pub val FIXED:  Element = 0;
pub val SUFFIX: Element = 1;
pub val XLEN:   Element = 2;
pub val BLOCK:  Element = 3;

# a scalar memory access: its role and its width. its address is the row's
# address register (rs1, rs1_p, or the stack pointer), offset by the row's
# immediate when it has one, and for zcmp the stack pointer, which no operand names
pub rec Memory {
    mnemonic: str;
    role:     operand.Role;
    element:  Element;
    bits:     u32;
}

pub val MEMORIES_COUNT: u32 = 72;

pub val MEMORIES: [MEMORIES_COUNT]Memory = [MEMORIES_COUNT]Memory{
