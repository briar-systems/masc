# the compression table: the compressions of the vendor tools written against the rows of the catalog
#
# each entry of `compressions` names a base mnemonic and a compressed one,
# and is written once for every row of each, so a compressed form with an
# rv32 and an rv64 row is a compression of both. the tokens of an entry are
# resolved against the base row's operands and refused when they name none,
# so a new row is reviewed before it is compressed.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.view.view;

use A: std.allocator;
use std.collections.sort;
use std.collections.vector;

use masc.core.field;
use masc.core.register;

use gen.diag;
use gen.emit;
use gen.riscv.compressions;
use gen.riscv.mapping;

pub val NO_ROW:      str = "compression names a mnemonic with no row";
pub val NO_ARGUMENT: str = "compression names an argument the row does not have";
pub val OPERANDS:    str = "compression gives the compressed row a different number of operands than it has";
pub val NO_REGISTER: str = "compression names a register the file does not have";
pub val BAD_NUMBER:  str = "compression names a number that is not one";

# the generator's state
rec State {
    file: *register.File;
    out:  *emit.File;
}

# one compression before it is emitted
# ---
# base:   the base row's index
# packed: the compressed row's index
# order:  the entry's place in the table
# from:   the origins, as emitted values
# when:   the conditions, as emitted values
rec Pending {
    base:   u32;
    packed: u32;
    order:  u32;
    from:   vector.Vector[emit.Value];
    when:   vector.Vector[emit.Value];
}

fun refuse(message: str, subject: str) diag.Refusal {
    ret diag.refusal("gen/src/riscv/compressions.mach", 0, message, subject);
}

fun memory() diag.Refusal {
    ret diag.refusal(nil, 0, diag.MEMORY, nil);
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun number(n: i64) emit.Value {
    ret emit.Value.number{n};
}

# the length of the space separated token of `text` at `at`
fun token_len(text: str, at: usize) usize {
    var end: usize = at;
    for (text[end] != 0 && text[end] != ' ') {
        end = end + 1;
    }
    ret end - at;
}

fun next_token(text: str, at: usize) usize {
    val end: usize = at + token_len(text, at);
    if (text[end] == ' ') { ret end + 1; }
    ret end;
}

# the first row spelled `name`, and how many follow it: rows are in mnemonic order
fun rows_named(catalog: *mapping.Catalog, name: str, first: *u32, count: *u32) bool {
    var lo: usize = 0;
    var hi: usize = catalog.rows.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (str_compare(catalog.rows.data[mid].mnemonic, name) < 0) { lo = mid + 1; }
        or                                                          { hi = mid; }
    }
    var n: u32 = 0;
    for (lo + n::usize < catalog.rows.len && str_compare(catalog.rows.data[lo + n::usize].mnemonic, name) == 0) {
        n = n + 1;
    }
    @first = lo::u32;
    @count = n;
    ret n > 0;
}

# the operand of `row` formed from the argument of `len` bytes at `at` in `text`, field.NO_OPERAND when none: `a|b` names whichever of the two the row has
fun operand_for(row: *mapping.Row, text: str, at: usize, len: usize) u8 {
    var from: usize = at;
    for (from <= at + len) {
        var end: usize = from;
        for (end < at + len && text[end] != '|') {
            end = end + 1;
        }
        var i: usize = 0;
        for (i < row.operands.len) {
            val group: str   = row.operands.data[i].group;
            var g:     usize = 0;
            for (group[g] != 0) {
                if (token_len(group, g) == end - from) {
                    var same: bool  = true;
                    var k:    usize = 0;
                    for (k < end - from) {
                        if (group[g + k] != text[from + k]) { same = false; }
                        k = k + 1;
                    }
                    if (same) { ret i::u8; }
                }
                g = next_token(group, g);
            }
            i = i + 1;
        }
        from = end + 1;
    }
    ret field.NO_OPERAND;
}

# the register row the `len` bytes at `at` in `text` name
fun register_named(st: *State, text: str, at: usize, len: usize) opt[u32] {
    ret register.row_named(st.file, view(?text[at], len), false);
}

# the number of the `len` bytes at `at` in `text`, which may be negative
fun number_at(text: str, at: usize, len: usize, out: *i64) bool {
    var i:   usize = 0;
    var neg: bool  = false;
    if (len > 0 && text[at] == '-') {
        neg = true;
        i   = 1;
    }
    if (i == len) { ret false; }
    var n: i64 = 0;
    for (i < len) {
        if (text[at + i] < '0' || text[at + i] > '9') { ret false; }
        n = n * 10 + (text[at + i] - '0')::i64;
        i = i + 1;
    }
    if (neg) { n = -n; }
    @out = n;
    ret true;
}

# the origin the token of `len` bytes at `at` in `from` states for an operand of the compressed row
fun origin(st: *State, base: *mapping.Row, from: str, at: usize, len: usize) res[emit.Value, diag.Refusal] {
    val f: *emit.File = st.out;
    if (from[at] == '=') {
        val r: opt[u32] = register_named(st, from, at + 1, len - 1);
        if (sel r.none) { ret res[emit.Value, diag.Refusal].err{refuse(NO_REGISTER, from)}; }
        ret res[emit.Value, diag.Refusal].ok{emit.Value.variant{emit.variant(f, "compress.Origin.register", number(r.some::i64))}};
    }
    var name: usize = len;
    var i:    usize = 0;
    for (i < len) {
        if (from[at + i] == ':') {
            name = i;
            brk;
        }
        i = i + 1;
    }
    val op: u8 = operand_for(base, from, at, name);
    if (op == field.NO_OPERAND) { ret res[emit.Value, diag.Refusal].err{refuse(NO_ARGUMENT, from)}; }
    if (name == len)            { ret res[emit.Value, diag.Refusal].ok{emit.Value.variant{emit.variant(f, "compress.Origin.operand", number(op::i64))}}; }
    # `a:s20` is the operand's number sign extended from twenty bits
    var bits: i64 = 0;
    if (from[at + name + 1] != 's' || !number_at(from, at + name + 2, len - name - 2, ?bits)) { ret res[emit.Value, diag.Refusal].err{refuse(BAD_NUMBER, from)}; }
    val e: *emit.Record = emit.record(f, "compress.Extension");
    emit.member(f, e, "operand", number(op::i64));
    emit.member(f, e, "bits", number(bits));
    ret res[emit.Value, diag.Refusal].ok{emit.Value.variant{emit.variant(f, "compress.Origin.extended", emit.Value.record{e})}};
}

# the condition the token of `len` bytes at `at` in `when` states on the base row's values
fun condition(st: *State, base: *mapping.Row, when: str, at: usize, len: usize) res[emit.Value, diag.Refusal] {
    val f:  *emit.File = st.out;
    var eq: usize      = 0;
    for (eq < len && when[at + eq] != '=') {
        eq = eq + 1;
    }
    if (eq == len) { ret res[emit.Value, diag.Refusal].err{refuse(NO_ARGUMENT, when)}; }
    val left: u8 = operand_for(base, when, at, eq);
    if (left == field.NO_OPERAND) { ret res[emit.Value, diag.Refusal].err{refuse(NO_ARGUMENT, when)}; }
    val rest:  usize = at + eq + 1;
    val rlen:  usize = len - eq - 1;
    var needs: emit.Value;
    var n:     i64   = 0;
    if (when[rest] == '#') {
        if (!number_at(when, rest + 1, rlen - 1, ?n)) { ret res[emit.Value, diag.Refusal].err{refuse(BAD_NUMBER, when)}; }
        needs = emit.Value.variant{emit.variant(f, "compress.Need.immediate", number(n))};
    }
    or {
        val r: opt[u32] = register_named(st, when, rest, rlen);
        if (sel r.some) { needs = emit.Value.variant{emit.variant(f, "compress.Need.register", number(r.some::i64))}; }
        or {
            val right: u8 = operand_for(base, when, rest, rlen);
            if (right == field.NO_OPERAND) { ret res[emit.Value, diag.Refusal].err{refuse(NO_ARGUMENT, when)}; }
            needs = emit.Value.variant{emit.variant(f, "compress.Need.operand", number(right::i64))};
        }
    }
    val c: *emit.Record = emit.record(f, "compress.Condition");
    emit.member(f, c, "operand", number(left::i64));
    emit.member(f, c, "needs", needs);
    ret res[emit.Value, diag.Refusal].ok{emit.Value.record{c}};
}

fun by_base(x: *Pending, y: *Pending) i64 {
    if (x.base != y.base)   { ret x.base::i64 - y.base::i64; }
    if (x.order != y.order) { ret x.order::i64 - y.order::i64; }
    ret x.packed::i64 - y.packed::i64;
}

# a pointer and count record over run `at` of `count` items of the array declared `array`, the shared constant `empty` when it holds none
fun span(f: *emit.File, of: str, empty: str, array: str, at: u32, count: u32) emit.Value {
    if (count == 0) { ret emit.Value.name{empty}; }
    val r: *emit.Record = emit.record(f, of);
    emit.member(f, r, "at", emit.element(f, array, at));
    emit.member(f, r, "len", number(count::i64));
    ret emit.Value.record{r};
}

# the compression table of the catalog, written into `f`
pub fun generate(a: *A.Allocator, f: *emit.File, catalog: *mapping.Catalog, file: *register.File) err[diag.Refusal] {
    var st: State = State{file: file, out: f};
    emit.uses(f, "masc.core.compress");
    var all: vector.Vector[Pending] = vector.init[Pending](a);
    var e:   u32                    = 0;
    for (e < compressions.ENTRIES_COUNT) {
        val entry:  *compressions.Entry = ?compressions.ENTRIES[e];
        var bfirst: u32                 = 0;
        var bcount: u32                 = 0;
        var pfirst: u32                 = 0;
        var pcount: u32                 = 0;
        if (!rows_named(catalog, entry.base, ?bfirst, ?bcount))   { ret err[diag.Refusal].err{refuse(NO_ROW, entry.base)}; }
        if (!rows_named(catalog, entry.packed, ?pfirst, ?pcount)) { ret err[diag.Refusal].err{refuse(NO_ROW, entry.packed)}; }
        var b: u32 = 0;
        for (b < bcount) {
            var p: u32 = 0;
            for (p < pcount) {
                val base:   *mapping.Row = catalog.rows.data[bfirst + b];
                val packed: *mapping.Row = catalog.rows.data[pfirst + p];
                var item:   Pending      = Pending{base: base.index, packed: packed.index, order: e, from: vector.init[emit.Value](a), when: vector.init[emit.Value](a)};
                var at:     usize        = 0;
                for (entry.from[at] != 0) {
                    val len: usize                         = token_len(entry.from, at);
                    val o:   res[emit.Value, diag.Refusal] = origin(?st, base, entry.from, at, len);
                    if (sel o.err)                                          { ret err[diag.Refusal].err{o.err}; }
                    if (!pushed(vector.push[emit.Value](?item.from, o.ok))) { ret err[diag.Refusal].err{memory()}; }
                    at = next_token(entry.from, at);
                }
                if (item.from.len != packed.operands.len) { ret err[diag.Refusal].err{refuse(OPERANDS, entry.packed)}; }
                at = 0;
                for (entry.when[at] != 0) {
                    val len: usize                         = token_len(entry.when, at);
                    val c:   res[emit.Value, diag.Refusal] = condition(?st, base, entry.when, at, len);
                    if (sel c.err)                                          { ret err[diag.Refusal].err{c.err}; }
                    if (!pushed(vector.push[emit.Value](?item.when, c.ok))) { ret err[diag.Refusal].err{memory()}; }
                    at = next_token(entry.when, at);
                }
                if (!pushed(vector.push[Pending](?all, item))) { ret err[diag.Refusal].err{memory()}; }
                p = p + 1;
            }
            b = b + 1;
        }
        e = e + 1;
    }
    sort.sort_by[Pending](all.data, all.len, by_base);
    var origins:    emit.Pool   = emit.pool(f, "compress.Origin");
    var conditions: emit.Pool   = emit.pool(f, "compress.Condition");
    val table:      *emit.Array = emit.array(f, "compress.Compression");
    var i:          usize       = 0;
    for (i < all.len) {
        val p:  *Pending     = ?all.data[i];
        val fr: u32          = emit.pooled(f, ?origins, p.from.data, p.from.len::u32);
        val wh: u32          = emit.pooled(f, ?conditions, p.when.data, p.when.len::u32);
        val r:  *emit.Record = emit.record(f, "compress.Compression");
        emit.member(f, r, "base", number(p.base::i64));
        emit.member(f, r, "packed", number(p.packed::i64));
        emit.member(f, r, "from", span(f, "compress.Origins", "compress.NO_ORIGINS", "ORIGINS", fr, p.from.len::u32));
        emit.member(f, r, "when", span(f, "compress.Conditions", "compress.NO_CONDITIONS", "CONDITIONS", wh, p.when.len::u32));
        emit.item(f, table, emit.Value.record{r});
        i = i + 1;
    }
    emit.declare(f, "ORIGINS", nil, emit.Value.array{origins.array});
    emit.declare(f, "CONDITIONS", nil, emit.Value.array{conditions.array});
    emit.declare(f, "COMPRESSION_ROWS", nil, emit.Value.array{table});
    emit.declare(f, "COMPRESSION_COUNT", "u32", number(emit.length(table)::i64));
    ret err[diag.Refusal].ok{};
}
