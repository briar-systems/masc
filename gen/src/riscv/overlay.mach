# where an argument's operand stands among a row's operands: lowest first,
# and in the order written among equals. destinations lead, then the vector
# source vs2 and a csr, then the first, second and third sources, a register
# list, the immediates and last the modifiers
pub rec Rank {
    arg:  str;
    rank: u8;
}

