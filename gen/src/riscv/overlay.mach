# a vector file's rows whose scalar rd and rs1 are f registers: the floating
# point instructions, vfirst.m being a mask instruction whose rd is an x register
pub val FLOAT_SCALARS: [2]str = [2]str{"vf*", "vmf*"};
pub val NOT_FLOAT:     str    = "vfirst.m";

# whether `name` matches `pattern`, whose one `*` matches any run of characters
pub fun matches(pattern: str, name: str) bool {
    val plen: usize = str_len(pattern);
    val nlen: usize = str_len(name);
    var star: usize = 0;
    for (star < plen && pattern[star] != '*') {
        star = star + 1;
    }
    if (star == plen) {
        if (plen != nlen) { ret false; }
        var i: usize = 0;
        for (i < plen) {
            if (pattern[i] != name[i]) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    val tail: usize = plen - star - 1;
    if (nlen < star + tail) { ret false; }
    var k: usize = 0;
    for (k < star) {
        if (pattern[k] != name[k]) { ret false; }
        k = k + 1;
    }
    k = 0;
    for (k < tail) {
        if (pattern[star + 1 + k] != name[nlen - tail + k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

# a layout a row takes for one of its argument groups in place of the group's own
# ---
# mnemonic: the rows it applies to, as `matches` reads a pattern
# args:     the group it replaces
# layout:   the layout taken
pub rec Override {
    mnemonic: str;
    args:     str;
    layout:   *riscv_field.Layout;
}

# c.nop's immediate is any value, its nonzero ones being hints, zfa's fli
# names its constant by index in the rs1 field, and cm.jalt's indices start at
# 32, below which the encoding is cm.jt
pub val OVERRIDES_COUNT: u32 = 3;

pub val OVERRIDES: [OVERRIDES_COUNT]Override = [OVERRIDES_COUNT]Override{
    Override{mnemonic: "c.nop", args: "c_nzimm6hi c_nzimm6lo", layout: ?riscv_field.CI6},
    Override{mnemonic: "cm.jalt", args: "c_index", layout: ?riscv_field.CINDEX_JALT},
    Override{mnemonic: "fli.*", args: "rs1", layout: ?riscv_field.FLI5},
};

# the arrays of the riscv field module a generated operand points into, by
# address and by the path the generated table spells, so a pointer the
# mapping meets is spelled from this list or refused
