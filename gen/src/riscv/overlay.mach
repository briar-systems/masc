# the reviewed facts the riscv generator adds to riscv-opcodes
#
# riscv-opcodes states encodings. what it does not state is written here,
# each table read in one place by the mapping: the extension each file and
# each split file's instructions belong to, which masc layout each argument
# is, the register class of an argument, the implicit stack pointer of the
# compressed stack forms, and the effects: memory width, control transfer,
# csr access, implicit registers, stack change and latency. names of
# extensions and registers are the catalog's and the register file's own
# spellings, resolved and refused when unknown, so no id is restated here.
# sources: the riscv-isa-manual at 36fdac54a526 for the extension of each
# instruction and its effects, and riscv-opcodes' own parser
# (src/riscv_opcodes/constants.py) for the arguments it adds in code.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use riscv_field: masc.isa.riscv.field;

use gen.riscv.read;

# an extension file and the extensions its instructions require, as the
# catalog spells them: alternatives split by `|`, the extensions of one
# alternative by spaces, and empty for none. a file read for no rows names
# why in `skip`
pub rec File {
    name:     str;
    requires: str;
    skip:     str;
}

# the requirement of the instructions of `file` that `mnemonic` matches,
# where a split file holds several extensions. a trailing `*` matches any
# mnemonic with that prefix, and the first row that matches is taken
pub rec Member {
    file:     str;
    mnemonic: str;
    requires: str;
}

