# the files that hold more than one extension, each from the manual at
# 36fdac54a526: rv_a and rv64_a hold zalrsc and zaamo (src/unpriv/a-st-ext.adoc),
# rv_m and rv64_m hold the multiplies of zmmul (src/unpriv/zmmul.adoc),
# rv_zicbo holds zicbom and zicboz (src/unpriv/cmo.adoc), rv_zvbb holds zvkb,
# the proper subset of zvbb in section "Zvkb Vector Cryptography
# Bit-manipulation" of src/unpriv/zvk.adoc, which zvbb, zvkn and zvks all
# imply, and the floating point instructions of rv_v need zve32f
# (src/unpriv/vector-common.adoc), vfirst.m being a mask instruction, and its
# accesses of 64-bit elements or indices need an elen of 64, zve64x. some zcb
# instructions need another extension too (src/unpriv/zcb.adoc): c.mul zmmul,
# c.sext.b, c.sext.h and c.zext.h zbb, and c.zext.w zba
pub val MEMBERS_COUNT: u32 = 25;

pub val MEMBERS: [MEMBERS_COUNT]Member = [MEMBERS_COUNT]Member{
    Member{file: "rv64_a", mnemonic: "lr.*", requires: "rv64 zalrsc"},
    Member{file: "rv64_a", mnemonic: "sc.*", requires: "rv64 zalrsc"},
    Member{file: "rv64_m", mnemonic: "mulw", requires: "rv64 zmmul"},
    Member{file: "rv_a", mnemonic: "lr.*", requires: "zalrsc"},
    Member{file: "rv_a", mnemonic: "sc.*", requires: "zalrsc"},
    Member{file: "rv_m", mnemonic: "mul*", requires: "zmmul"},
    Member{file: "rv64_zcb", mnemonic: "c.zext.w", requires: "rv64 zcb zba"},
    Member{file: "rv_v", mnemonic: "*e64.v", requires: "zve64x"},
    Member{file: "rv_v", mnemonic: "*e64ff.v", requires: "zve64x"},
    Member{file: "rv_v", mnemonic: "*ei64.v", requires: "zve64x"},
    Member{file: "rv_v", mnemonic: "vfirst.m", requires: "zve32x"},
    Member{file: "rv_v", mnemonic: "vf*", requires: "zve32f"},
    Member{file: "rv_v", mnemonic: "vmf*", requires: "zve32f"},
    Member{file: "rv_v_aliases", mnemonic: "vf*", requires: "zve32f"},
    Member{file: "rv_v_aliases", mnemonic: "vmf*", requires: "zve32f"},
    Member{file: "rv_zcb", mnemonic: "c.mul", requires: "zcb zmmul"},
    Member{file: "rv_zcb", mnemonic: "c.sext.b", requires: "zcb zbb"},
    Member{file: "rv_zcb", mnemonic: "c.sext.h", requires: "zcb zbb"},
    Member{file: "rv_zcb", mnemonic: "c.zext.h", requires: "zcb zbb"},
    Member{file: "rv_zicbo", mnemonic: "cbo.zero", requires: "zicboz"},
    Member{file: "rv_zvbb", mnemonic: "vandn.*", requires: "zvkb"},
    Member{file: "rv_zvbb", mnemonic: "vbrev8.v", requires: "zvkb"},
    Member{file: "rv_zvbb", mnemonic: "vrev8.v", requires: "zvkb"},
    Member{file: "rv_zvbb", mnemonic: "vrol.*", requires: "zvkb"},
    Member{file: "rv_zvbb", mnemonic: "vror.*", requires: "zvkb"},
};

# what an argument group is in masc's riscv field module
# ---
# REGISTER:  a position
# IMMEDIATE: a layout, as an immediate or a relative target
# CHOICE:    an enumerant
# CSR:       the csr layout, as an id of the csr space
# ADJUST:    zcmp's stack adjustment, which the stack kind encodes whole
# SREG:      a zcmp s register, which the sregs kind encodes whole
pub def Use: u8;

pub val REGISTER:  Use = 0;
pub val IMMEDIATE: Use = 1;
pub val CHOICE:    Use = 2;
pub val CSR:       Use = 3;
pub val ADJUST:    Use = 4;
pub val SREG:      Use = 5;

# the arguments that form one operand, split by spaces, and what they are
# ---
# position: a register's position, for REGISTER and SREG
# layout:   an immediate's layout, for IMMEDIATE and CSR
# choice:   an enumerant's choice, for CHOICE
pub rec Group {
    args:     str;
    use:      Use;
    position: *riscv_field.Position;
    layout:   *riscv_field.Layout;
    choice:   *riscv_field.Choice;
}

# every argument of a ratified instruction, the groups of several first so they are taken whole
pub val GROUPS_COUNT: u32 = 76;

pub val GROUPS: [GROUPS_COUNT]Group = [GROUPS_COUNT]Group{
    Group{args: "mop_r_t_30 mop_r_t_27_26 mop_r_t_21_20", use: IMMEDIATE, position: nil, layout: ?riscv_field.MOPR5, choice: nil},
    Group{args: "mop_rr_t_30 mop_rr_t_27_26", use: IMMEDIATE, position: nil, layout: ?riscv_field.MOPRR3, choice: nil},
