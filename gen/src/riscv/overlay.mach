# a register argument that must name an aligned register group, as a
# position whose odd or unaligned numbers are excluded
# ---
# mnemonic: the rows it applies to, as `matches` reads a pattern
# arg:      the argument
# position: the aligned position taken in place of the group's
# width:    the width under which it applies, empty for every width
pub rec Align {
    mnemonic: str;
    arg:      str;
    position: *riscv_field.Position;
    width:    str;
}

# the whole register moves, loads and stores of n registers name a group whose
