# the order facts an overlay states, read, resolved against a row and emitted alike for every set
# (masc.core.effect.Order)
#
# a set's effects topic states how a row orders the memory accesses around it in these words:
#
#   [before=<kinds>] [after=<kinds>] [field=<field> bits=<pattern>]
#
# kinds are letters of r, w, i and o, memory reads and writes and device input and output, and an access before the row
# of a kind in before stays before it, one after it of a kind in after stays after it. a fact with no field holds for
# every row it names. a fact with a field holds where the field's bits meet the pattern, its bits from the field's high
# bit, 0, 1, or x for a bit either value meets, so the order is read from the encoding wherever the encoding carries it.
# a set that names fields by name may join several by `:`, as aarch64's `L:o0`, their bits then the first field's high
# and each pattern's parted by `:` alike.
# where the row fixes the field's tested bits the fact holds for the row or does not, and where one operand holds them
# it is an ordering of that operand's value (effect.Ordering). every fact a row's facts name joins its order, so a row
# states its order whole by the facts of each field that carries one, and a fact of a field that orders nothing under
# the row's bits, as a relaxed atomic's acquire bit, still states that the row's order was read

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;

use masc.core.effect;
use masc.core.field;

use gen.diag;
use gen.emit;
use gen.overlay;

pub val BAD_KINDS:    str = "order kinds are not letters of r, w, i and o";
pub val BAD_PATTERN:  str = "order bits are not 0, 1 and x, or are given without a field or a field without them";
pub val EMPTY:        str = "order fact states no kinds";
pub val WIDTH:        str = "order bits are not as wide as the field the row has";
pub val TWO_OPERANDS: str = "order field's tested bits lie in more than one operand";
pub val NO_FIELD:     str = "order names a field the row does not have";
pub val UNSTATED:     str = "atomic or fence row states no order";
pub val IDLE:         str = "order or ordered line names no row";

# the most bits a field may have
pub val MAX_BITS: usize = 32;

# an order fact read
# ---
# before: the kinds before the row it orders
# after:  the kinds after it it orders
# field:  the field whose bits decide whether it holds, nil for one that always holds
# mask:   the field's bits the pattern tests, from its low bit
# value:  what those bits must be
# width:  the bits of the pattern, the field's width
pub rec Stated {
    before: effect.Kinds;
    after:  effect.Kinds;
    field:  str;
    mask:   u32;
    value:  u32;
    width:  u8;
}

# the kinds `text` spells
fun kinds_of(text: str, out: *effect.Kinds) bool {
    var k: effect.Kinds = effect.NO_KINDS;
    var i: usize        = 0;
    for (i < str_len(text)) {
        val c: u8 = text[i];
        if (c == 'r') { k = k | effect.READS; }
        or (c == 'w') { k = k | effect.WRITES; }
        or (c == 'i') { k = k | effect.INPUTS; }
        or (c == 'o') { k = k | effect.OUTPUTS; }
        or            { ret false; }
        i = i + 1;
    }
    @out = k;
    ret true;
}

# the order fact of line `l`, its words those of the fact's named values `before`, `after`, `field` and `bits`
pub fun read(l: *overlay.Line, out: *Stated) err[diag.Refusal] {
    @out = Stated{before: effect.NO_KINDS, after: effect.NO_KINDS, field: nil, mask: 0, value: 0, width: 0};
    val before: opt[str] = overlay.value(?l.ws, "before");
    val after:  opt[str] = overlay.value(?l.ws, "after");
    val named:  opt[str] = overlay.value(?l.ws, "field");
    val bits:   opt[str] = overlay.value(?l.ws, "bits");
    if (sel before.some) {
        if (!kinds_of(before.some, ?out.before)) { ret overlay.reject(l, BAD_KINDS, before.some); }
    }
    if (sel after.some) {
        if (!kinds_of(after.some, ?out.after)) { ret overlay.reject(l, BAD_KINDS, after.some); }
    }
    if (out.before == effect.NO_KINDS && out.after == effect.NO_KINDS) { ret overlay.reject(l, EMPTY, l.fact.key); }
    var field:   str = nil;
    var pattern: str = nil;
    if (sel named.some)                     { field = named.some; }
    if (sel bits.some)                      { pattern = bits.some; }
    if ((field == nil) != (pattern == nil)) { ret overlay.reject(l, BAD_PATTERN, l.fact.fact); }
    if (field == nil)                       { ret err[diag.Refusal].ok{}; }
    val len:   usize = str_len(pattern);
    var width: usize = 0;
    var i:     usize = 0;
    for (i < len) {
        if (pattern[i] != ':') { width = width + 1; }
        i = i + 1;
    }
    if (width == 0 || width > MAX_BITS) { ret overlay.reject(l, BAD_PATTERN, pattern); }
    var left: usize = width;
    i = 0;
    for (i < len) {
        # the pattern's first character is the field's high bit, and a `:` parts the bits of fields joined
        val c: u8 = pattern[i];
        if (c != ':') {
            left = left - 1;
            val bit: u32 = 1::u32 << left::u32;
            if (c == '1') {
                out.mask  = out.mask | bit;
                out.value = out.value | bit;
            }
            or (c == '0') { out.mask = out.mask | bit; }
            or (c != 'x') { ret overlay.reject(l, BAD_PATTERN, pattern); }
        }
        i = i + 1;
    }
    out.field = field;
    out.width = width::u8;
    ret err[diag.Refusal].ok{};
}

# whether `w` is what an ordered line states of the rows it names: `atomic` or `fence`
pub fun requirement(w: str) bool {
    ret str_equals(w, "atomic") || str_equals(w, "fence");
}

# line `l` refused unless its fact is one word an ordered line states
pub fun required(l: *overlay.Line) err[diag.Refusal] {
    val w: opt[str] = overlay.only(l);
    if (sel w.some) {
        if (requirement(w.some)) { ret err[diag.Refusal].ok{}; }
    }
    ret overlay.reject(l, overlay.BAD_FACT, l.fact.fact);
}

# a bit of an operand's value
# ---
# operand: the operand, by its index
# bit:     the bit of its value
pub rec Bit {
    operand: u8;
    bit:     u8;
}

# where one bit of a field lies in a row: fixed by the row to a value, or held by an operand's value
pub tag Place: u8 {
    fixed:   bool;
    operand: Bit;
}

# a row's order as its facts build it
# ---
# before, after: the kinds its fixed bits decide
# by:     the orderings of its operands' values
# stated: whether any fact named it, though one that holds under none of its bits
pub rec Built {
    before: effect.Kinds;
    after:  effect.Kinds;
    by:     vector.Vector[effect.Ordering];
    stated: bool;
}

# a row's order before any fact names it
pub fun init(a: *A.Allocator) Built {
    ret Built{before: effect.NO_KINDS, after: effect.NO_KINDS, by: vector.init[effect.Ordering](a), stated: false};
}

# fact `s` joined into `b`, the field's bits placed by `places` from its low bit, `count` of them, none for a row
# without the field
# ---
# ret: why the fact cannot be resolved against the row, as a message of this module
pub fun join(b: *Built, s: *Stated, places: *Place, count: usize) res[bool, str] {
    b.stated = true;
    if (s.field == nil) {
        b.before = b.before | s.before;
        b.after  = b.after | s.after;
        ret res[bool, str].ok{true};
    }
    if (places == nil)           { ret res[bool, str].err{NO_FIELD}; }
    if (count != s.width::usize) { ret res[bool, str].err{WIDTH}; }
    var op:    u8    = field.NO_OPERAND;
    var mask:  u32   = 0;
    var value: u32   = 0;
    var holds: bool  = true;
    var k:     usize = 0;
    for (k < count) {
        val bit: u32 = 1::u32 << k::u32;
        if ((s.mask & bit) != 0) {
            val want: bool  = (s.value & bit) != 0;
            val p:    Place = places[k];
            if (sel p.fixed) {
                if (p.fixed != want) { holds = false; }
            }
            if (sel p.operand) {
                val at: Bit = p.operand;
                if (op == field.NO_OPERAND) { op = at.operand; }
                if (op != at.operand)       { ret res[bool, str].err{TWO_OPERANDS}; }
                mask = mask | (1::u32 << at.bit::u32);
                if (want) { value = value | (1::u32 << at.bit::u32); }
            }
        }
        k = k + 1;
    }
    if (!holds) { ret res[bool, str].ok{true}; }
    if (op == field.NO_OPERAND) {
        b.before = b.before | s.before;
        b.after  = b.after | s.after;
        ret res[bool, str].ok{true};
    }
    val g:      effect.Ordering     = effect.Ordering{operand: op + 1, mask: mask, value: value, before: s.before, after: s.after};
    val pushed: res[usize, A.Error] = vector.push[effect.Ordering](?b.by, g);
    if (sel pushed.err) { ret res[bool, str].err{diag.MEMORY}; }
    ret res[bool, str].ok{true};
}

fun number(n: i64) emit.Value {
    ret emit.Value.number{n};
}

# the order `b` as a literal, its orderings a run of the array ORDERINGS that `pool` fills, effect.UNORDERED for one
# that orders nothing under any operand value
pub fun value(f: *emit.File, pool: *emit.Pool, b: *Built) emit.Value {
    if (b.before == effect.NO_KINDS && b.after == effect.NO_KINDS && b.by.len == 0) { ret emit.Value.name{"effect.UNORDERED"}; }
    var by: emit.Value = emit.Value.name{"effect.NO_ORDERINGS"};
    if (b.by.len > 0) {
        var items: vector.Vector[emit.Value] = vector.init[emit.Value](f.alloc);
        var i:     usize                     = 0;
        for (i < b.by.len) {
            val g: *effect.Ordering = ?b.by.data[i];
            val x: *emit.Record     = emit.record(f, "effect.Ordering");
            emit.member(f, x, "operand", number(g.operand::i64));
            emit.member(f, x, "mask", emit.Value.hex{g.mask::u64});
            emit.member(f, x, "value", emit.Value.hex{g.value::u64});
            emit.member(f, x, "before", number(g.before::i64));
            emit.member(f, x, "after", number(g.after::i64));
            vector.push[emit.Value](?items, emit.Value.record{x});
            i = i + 1;
        }
        val at: u32          = emit.pooled(f, pool, items.data, items.len::u32);
        val r:  *emit.Record = emit.record(f, "effect.Orderings");
        emit.member(f, r, "at", emit.element(f, "ORDERINGS", at));
        emit.member(f, r, "len", number(b.by.len::i64));
        by = emit.Value.record{r};
    }
    val o: *emit.Record = emit.record(f, "effect.Order");
    emit.member(f, o, "before", number(b.before::i64));
    emit.member(f, o, "after", number(b.after::i64));
    emit.member(f, o, "semantics", number(0));
    emit.member(f, o, "failure", number(0));
    emit.member(f, o, "scope", number(0));
    emit.member(f, o, "execution", number(0));
    emit.member(f, o, "by", by);
    ret emit.Value.record{o};
}
