# the x86 generator
#
# it reads the register families masc writes under vendor/x86-registers and emits the x86-64 register file beside masc's x86
# modules: the scales, classes, register rows with their banks, views, places, write extensions and the reach of each, the dwarf and
# codeview columns and the
# indexes over them. a family is a line of the source, and a row's name, number, bank and requirement, and the number of every
# register in a debug format, are derived here, so the table is never edited by hand

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;
use std.types.view.view_eq_str;

use A: std.allocator;
use std.collections.sort;
use std.collections.vector;
use std.format;

use gen.diag;
use gen.emit;
use gen.lines;
use gen.set;
use gen.source;

pub val FAMILIES: str = "registers.txt";

pub val BAD_RECORD:   str = "register record is not a scale, fix, class or number";
pub val BAD_FIELDS:   str = "register record has the wrong number of fields";
pub val BAD_NUMBER:   str = "field is not a number";
pub val BAD_WIDTH:    str = "width is neither bits nor a scale";
pub val BAD_NAMES:    str = "names are not a list of names, patterns with a range and dashes, inside the class's count";
pub val BAD_KIND:     str = "kind is not a register kind";
pub val BAD_EXTEND:   str = "extend is not keep, zeroes or ones, or states none for a register";
pub val BAD_FLAG:     str = "flag is not zero, stack or pc, or states none for a register";
pub val BAD_REQUIRES: str = "required extension is not one the register file names, or states none for a register";
pub val BAD_BANK:     str = "bank is not new, with a class or of a class by a delta, or names a class that does not hold it";
pub val BAD_PIECES:   str = "pieces are not a stride and a count in bits";
pub val BAD_OFFSET:   str = "offset is not bits, number or number times bits";
pub val BAD_PLACES:   str = "places are not a step and a count in bits";
pub val BAD_REACH:    str = "reach is not bank or an offset and a width in bits";
pub val BAD_FIX:      str = "fixing names no scale, no extension, or a multiplier outside the scale";
pub val BAD_FORMAT:   str = "debug format is not dwarf or codeview";
pub val UNKNOWN:      str = "name is not a scale, class or register";
pub val NO_FILE:      str = "source has no register families";
pub val CLASS_TWICE:  str = "class named twice";
pub val NUMBERED:     str = "register numbered twice in one format";

# a width, offset, stride or count: fixed plus per times the multiplier of one scale
rec Quantity {
    fixed: u32;
    per:   u32;
    scale: u8;
}

rec Scale {
    name: str;
    unit: u32;
    max:  u32;
}

rec Fix {
    scale:      u32;
    extension:  str;
    multiplier: u32;
}

# one class of the source
# ---
# names:  the list of names, a name or a pattern and a range per entry, a dash for a number without a register
# bank:   0 for banks of its own, 1 for the bank of the first register of `with`, 2 for the bank of the register `delta` past a
#         register's number in `with`, 3 for one bank every register of it shares
# base:   the bank of its first register, assigned once every class is read
# offset: 0 for none, 1 for `fixed` bits, 2 for the register's number times `fixed` bits
# places: how many places each register may be, 1 for one, each `step` bits past the last
# reach:  whether a write's extension reaches only the part `reach_offset` bits past the register for `reach_width` bits, the whole
#         bank else
# extend, flags and requires: the attribute for each number, as a list of `range:value` entries and a last plain value
rec Class {
    name:      str;
    kind:      str;
    width:     Quantity;
    count:     u32;
    first:     u32;
    names:     str;
    bank:      u32;
    with:      i64;
    with_name: str;
    delta:     i64;
    base:      u32;
    stride:    u32;
    pieces:    u32;
    offset:    u32;
    fixed:     u32;
    places:    u32;
    step:      u32;
    extend:    str;
    part:      bool;
    reach_at:  u32;
    reach_len: u32;
    flags:     str;
    requires:  str;
    line:      lines.Line;
}

rec Row {
    name:      str;
    class:     u32;
    number:    u32;
    bank:      u32;
    offset:    Quantity;
    stride:    Quantity;
    count:     Quantity;
    places:    u32;
    step:      u32;
    flags:     str;
    requires:  str;
    extend:    str;
    part:      bool;
    reach_at:  u32;
    reach_len: u32;
    dwarf:     i64;
    cv:        i64;
}

# the names a `number` record gives to consecutive numbers of one debug format
rec Numbering {
    format: u32;
    first:  u32;
    names:  str;
    line:   lines.Line;
}

rec Families {
    alloc:      *A.Allocator;
    scales:     vector.Vector[Scale];
    fixes:      vector.Vector[Fix];
    classes:    vector.Vector[Class];
    numberings: vector.Vector[Numbering];
    rows:       vector.Vector[Row];
}

fun memory(l: *lines.Line) diag.Refusal {
    ret lines.refuse(l, diag.MEMORY, nil);
}

fun owned(a: *A.Allocator, l: *lines.Line, v: View) res[str, diag.Refusal] {
    val got: res[str, StrError] = str_copy_slice(a, v.data, 0, v.len);
    if (sel got.err) { ret res[str, diag.Refusal].err{memory(l)}; }
    ret res[str, diag.Refusal].ok{got.ok};
}

fun pushed(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# the decimal number of `len` bytes from `at`, none when they are not digits
fun digits(text: str, at: usize, len: usize) i64 {
    if (len == 0 || len > 9) { ret -1; }
    var n: i64   = 0;
    var i: usize = 0;
    for (i < len) {
        val c: u8 = text[at + i];
        if (c < '0' || c > '9') { ret -1; }
        n = n * 10 + (c - '0')::i64;
        i = i + 1;
    }
    ret n;
}

fun decimal(l: *lines.Line, v: View) res[u32, diag.Refusal] {
    if (v.len == 0 || v.len > 9) { ret res[u32, diag.Refusal].err{lines.refuse(l, BAD_NUMBER, nil)}; }
    var n: u32   = 0;
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] < '0' || v.data[i] > '9') { ret res[u32, diag.Refusal].err{lines.refuse(l, BAD_NUMBER, nil)}; }
        n = n * 10 + (v.data[i] - '0')::u32;
        i = i + 1;
    }
    ret res[u32, diag.Refusal].ok{n};
}

fun scale_named(f: *Families, v: View) opt[u8] {
    var i: usize = 0;
    for (i < f.scales.len) {
        if (view_eq_str(v, f.scales.data[i].name)) { ret opt[u8].some{i::u8}; }
        i = i + 1;
    }
    ret opt[u8].none{};
}

# a width: bits, or a scale for one unit of it per multiplier
fun width(f: *Families, l: *lines.Line, v: View) res[Quantity, diag.Refusal] {
    if (v.len > 0 && v.data[0] >= '0' && v.data[0] <= '9') {
        val n: res[u32, diag.Refusal] = decimal(l, v);
        if (sel n.err) { ret res[Quantity, diag.Refusal].err{n.err}; }
        ret res[Quantity, diag.Refusal].ok{Quantity{fixed: n.ok, per: 0, scale: 0}};
    }
    val s: opt[u8] = scale_named(f, v);
    if (sel s.none) { ret res[Quantity, diag.Refusal].err{lines.refuse(l, BAD_WIDTH, nil)}; }
    ret res[Quantity, diag.Refusal].ok{Quantity{fixed: 0, per: f.scales.data[s.some].unit, scale: s.some}};
}

fun kind(l: *lines.Line, v: View) res[str, diag.Refusal] {
    if (view_eq_str(v, "general"))   { ret res[str, diag.Refusal].ok{"register.GENERAL"}; }
    if (view_eq_str(v, "float"))     { ret res[str, diag.Refusal].ok{"register.FLOAT"}; }
    if (view_eq_str(v, "vector"))    { ret res[str, diag.Refusal].ok{"register.VECTOR"}; }
    if (view_eq_str(v, "predicate")) { ret res[str, diag.Refusal].ok{"register.PREDICATE"}; }
    if (view_eq_str(v, "flags"))     { ret res[str, diag.Refusal].ok{"register.FLAGS"}; }
    if (view_eq_str(v, "tile"))      { ret res[str, diag.Refusal].ok{"register.TILE"}; }
    if (view_eq_str(v, "system"))    { ret res[str, diag.Refusal].ok{"register.SYSTEM"}; }
    ret res[str, diag.Refusal].err{lines.refuse(l, BAD_KIND, nil)};
}

fun extend_named(v: View) str {
    if (view_eq_str(v, "keep"))   { ret "register.KEEP"; }
    if (view_eq_str(v, "zeroes")) { ret "register.ZEROES"; }
    if (view_eq_str(v, "ones"))   { ret "register.ONES"; }
    ret nil;
}

fun flag_named(v: View) str {
    if (view_eq_str(v, "-"))     { ret "0"; }
    if (view_eq_str(v, "zero"))  { ret "register.ZERO"; }
    if (view_eq_str(v, "stack")) { ret "register.STACK"; }
    if (view_eq_str(v, "pc"))    { ret "register.PC"; }
    ret nil;
}

# the id an extension token names in the register file's extension module, nil when it names none
fun extension_id(v: View) str {
    if (view_eq_str(v, "x86-64"))   { ret "x86_extension.X64"; }
    if (view_eq_str(v, "sse"))      { ret "x86_extension.SSE"; }
    if (view_eq_str(v, "avx"))      { ret "x86_extension.AVX"; }
    if (view_eq_str(v, "avx512f"))  { ret "x86_extension.AVX512F"; }
    if (view_eq_str(v, "x87"))      { ret "x86_extension.X87"; }
    if (view_eq_str(v, "mmx"))      { ret "x86_extension.MMX"; }
    if (view_eq_str(v, "amx_tile")) { ret "x86_extension.AMX_TILE"; }
    if (view_eq_str(v, "apx_f"))    { ret "x86_extension.APX_F"; }
    ret nil;
}

# the value of an attribute for register number `n`: the first entry of the comma list whose range holds it, a plain entry holding every
# number. none when no entry holds it
fun ranged(spec: str, n: u32, out: *View) bool {
    val len: usize = str_len(spec);
    var at:  usize = 0;
    for (at <= len) {
        var end: usize = at;
        for (end < len && spec[end] != ',') {
            end = end + 1;
        }
        var colon: usize = end;
        var i:     usize = at;
        for (i < end) {
            if (spec[i] == ':') { colon = i; }
            i = i + 1;
        }
        var holds: bool = colon == end;
        if (colon < end) {
            var dash: usize = colon;
            i = at;
            for (i < colon) {
                if (spec[i] == '-') { dash = i; }
                i = i + 1;
            }
            var lo: i64 = -1;
            var hi: i64 = -1;
            if (dash < colon) {
                lo = digits(spec, at, dash - at);
                hi = digits(spec, dash + 1, colon - dash - 1);
            }
            or {
                lo = digits(spec, at, colon - at);
                hi = lo;
            }
            if (lo >= 0 && hi >= 0) { holds = n::i64 >= lo && n::i64 <= hi; }
        }
        if (holds) {
            var from: usize = at;
            if (colon < end) { from = colon + 1; }
            @out = View{data: ?spec[from], len: end - from};
            ret true;
        }
        at = end + 1;
    }
    ret false;
}

# the call `fn` over each value of an attribute, each entry's value after its range
fun each_value(spec: str, fn: fun(View) bool) bool {
    val len: usize = str_len(spec);
    var at:  usize = 0;
    for (at <= len) {
        var end: usize = at;
        for (end < len && spec[end] != ',') {
            end = end + 1;
        }
        var from: usize = at;
        var i:    usize = at;
        for (i < end) {
            if (spec[i] == ':') { from = i + 1; }
            i = i + 1;
        }
        if (!fn(View{data: ?spec[from], len: end - from})) { ret false; }
        at = end + 1;
    }
    ret true;
}

fun extend_ok(v: View) bool {
    ret extend_named(v) != nil;
}

fun flag_ok(v: View) bool {
    ret flag_named(v) != nil;
}

# whether every extension a requirement value names is one the register file names, `-` naming none
fun requires_ok(v: View) bool {
    if (view_eq_str(v, "-")) { ret true; }
    var at: usize = 0;
    for (at <= v.len) {
        var end: usize = at;
        for (end < v.len && v.data[end] != '|' && v.data[end] != '&') {
            end = end + 1;
        }
        if (extension_id(View{data: ?v.data[at], len: end - at}) == nil) { ret false; }
        at = end + 1;
    }
    ret true;
}

# two numbers of `v` either side of its first `sep`, none when it has no `sep` or either side is not a number
fun pair(l: *lines.Line, v: View, sep: u8, a: *u32, b: *u32) bool {
    var at: usize = 0;
    for (at < v.len && v.data[at] != sep) {
        at = at + 1;
    }
    if (at == v.len) { ret false; }
    val x: res[u32, diag.Refusal] = decimal(l, View{data: v.data, len: at});
    val y: res[u32, diag.Refusal] = decimal(l, View{data: ?v.data[at + 1], len: v.len - at - 1});
    if (sel x.err) { ret false; }
    if (sel y.err) { ret false; }
    @a = x.ok;
    @b = y.ok;
    ret true;
}

fun class_line(f: *Families, l: *lines.Line, t: *vector.Vector[View]) err[diag.Refusal] {
    if (t.len != 15) { ret err[diag.Refusal].err{lines.refuse(l, BAD_FIELDS, nil)}; }
    var c: Class;
    c.line = @l;
    val name: res[str, diag.Refusal] = owned(f.alloc, l, t.data[1]);
    if (sel name.err) { ret err[diag.Refusal].err{name.err}; }
    c.name = name.ok;
    val k: res[str, diag.Refusal] = kind(l, t.data[2]);
    if (sel k.err) { ret err[diag.Refusal].err{k.err}; }
    c.kind = k.ok;
    val w: res[Quantity, diag.Refusal] = width(f, l, t.data[3]);
    if (sel w.err) { ret err[diag.Refusal].err{w.err}; }
    c.width = w.ok;
    val n: res[u32, diag.Refusal] = decimal(l, t.data[4]);
    if (sel n.err) { ret err[diag.Refusal].err{n.err}; }
    c.count = n.ok;
    val first: res[u32, diag.Refusal] = decimal(l, t.data[5]);
    if (sel first.err) { ret err[diag.Refusal].err{first.err}; }
    c.first = first.ok;
    val names: res[str, diag.Refusal] = owned(f.alloc, l, t.data[6]);
    if (sel names.err) { ret err[diag.Refusal].err{names.err}; }
    c.names = names.ok;
    c.with  = -1;
    val bank: View = t.data[7];
    if (view_eq_str(bank, "new"))    { c.bank = 0; }
    or (view_eq_str(bank, "shared")) { c.bank = 3; }
    or {
        var at: usize = 0;
        if (bank.len > 5 && view_eq_str(View{data: bank.data, len: 5}, "with:")) {
            c.bank = 1;
            at     = 5;
        }
        or (bank.len > 3 && view_eq_str(View{data: bank.data, len: 3}, "of:")) {
            c.bank = 2;
            at     = 3;
        }
        or { ret err[diag.Refusal].err{lines.refuse(l, BAD_BANK, nil)}; }
        var end: usize = at;
        for (end < bank.len && bank.data[end] != '@') {
            end = end + 1;
        }
        val with: res[str, diag.Refusal] = owned(f.alloc, l, View{data: ?bank.data[at], len: end - at});
        if (sel with.err) { ret err[diag.Refusal].err{with.err}; }
        c.with_name = with.ok;
        if (c.bank == 2) {
            if (end >= bank.len) { ret err[diag.Refusal].err{lines.refuse(l, BAD_BANK, nil)}; }
            var sign: i64   = 1;
            var from: usize = end + 1;
            if (bank.data[from] == '-') {
                sign = -1;
                from = from + 1;
            }
            val d: res[u32, diag.Refusal] = decimal(l, View{data: ?bank.data[from], len: bank.len - from});
            if (sel d.err) { ret err[diag.Refusal].err{d.err}; }
            c.delta = sign * d.ok::i64;
        }
    }
    if (!view_eq_str(t.data[8], "-")) {
        var x: usize = 0;
        for (x < t.data[8].len && t.data[8].data[x] != 'x') {
            x = x + 1;
        }
        if (x == t.data[8].len) { ret err[diag.Refusal].err{lines.refuse(l, BAD_PIECES, nil)}; }
        val st: res[u32, diag.Refusal] = decimal(l, View{data: t.data[8].data, len: x});
        if (sel st.err) { ret err[diag.Refusal].err{st.err}; }
        val pc: res[u32, diag.Refusal] = decimal(l, View{data: ?t.data[8].data[x + 1], len: t.data[8].len - x - 1});
        if (sel pc.err) { ret err[diag.Refusal].err{pc.err}; }
        c.stride = st.ok;
        c.pieces = pc.ok;
    }
    val off: View = t.data[9];
    if (view_eq_str(off, "number")) {
        c.offset = 2;
        c.fixed  = 1;
    }
    or (off.len > 7 && view_eq_str(View{data: off.data, len: 7}, "number*")) {
        val o: res[u32, diag.Refusal] = decimal(l, View{data: ?off.data[7], len: off.len - 7});
        if (sel o.err) { ret err[diag.Refusal].err{lines.refuse(l, BAD_OFFSET, nil)}; }
        c.offset = 2;
        c.fixed  = o.ok;
    }
    or (!view_eq_str(off, "-")) {
        val o: res[u32, diag.Refusal] = decimal(l, off);
        if (sel o.err) { ret err[diag.Refusal].err{o.err}; }
        c.offset = 1;
        c.fixed  = o.ok;
    }
    c.places = 1;
    if (!view_eq_str(t.data[10], "-")) {
        if (!pair(l, t.data[10], 'x', ?c.step, ?c.places) || c.places < 2 || c.step == 0) { ret err[diag.Refusal].err{lines.refuse(l, BAD_PLACES, nil)}; }
    }
    val e: res[str, diag.Refusal] = owned(f.alloc, l, t.data[11]);
    if (sel e.err) { ret err[diag.Refusal].err{e.err}; }
    c.extend = e.ok;
    if (!view_eq_str(t.data[12], "bank")) {
        if (!pair(l, t.data[12], '+', ?c.reach_at, ?c.reach_len) || c.reach_len == 0) { ret err[diag.Refusal].err{lines.refuse(l, BAD_REACH, nil)}; }
        c.part = true;
    }
    val fl: res[str, diag.Refusal] = owned(f.alloc, l, t.data[13]);
    if (sel fl.err) { ret err[diag.Refusal].err{fl.err}; }
    c.flags = fl.ok;
    val rq: res[str, diag.Refusal] = owned(f.alloc, l, t.data[14]);
    if (sel rq.err) { ret err[diag.Refusal].err{rq.err}; }
    c.requires = rq.ok;
    if (!each_value(c.extend, extend_ok))           { ret err[diag.Refusal].err{lines.refuse(l, BAD_EXTEND, nil)}; }
    if (!each_value(c.flags, flag_ok))              { ret err[diag.Refusal].err{lines.refuse(l, BAD_FLAG, nil)}; }
    if (!each_value(c.requires, requires_ok))       { ret err[diag.Refusal].err{lines.refuse(l, BAD_REQUIRES, nil)}; }
    if (!pushed(vector.push[Class](?f.classes, c))) { ret err[diag.Refusal].err{memory(l)}; }
    ret err[diag.Refusal].ok{};
}

fun read(a: *A.Allocator, t: *source.Tree, f: *Families) err[diag.Refusal] {
    val file: opt[*source.File] = source.find(t, FAMILIES);
    if (sel file.none) { ret err[diag.Refusal].err{diag.refusal(FAMILIES, 0, NO_FILE, nil)}; }
    val got: res[vector.Vector[lines.Line], diag.Refusal] = lines.read(a, file.some, '#');
    if (sel got.err) { ret err[diag.Refusal].err{got.err}; }
    var ls: vector.Vector[lines.Line] = got.ok;
    var i:  usize                     = 0;
    for (i < ls.len) {
        val l:  *lines.Line                            = ?ls.data[i];
        val tk: res[vector.Vector[View], diag.Refusal] = lines.tokens(a, l);
        if (sel tk.err) { ret err[diag.Refusal].err{tk.err}; }
        var tokens: vector.Vector[View] = tk.ok;
        var done:   err[diag.Refusal]   = err[diag.Refusal].ok{};
        if (view_eq_str(tokens.data[0], "scale")) {
            if (tokens.len != 4) { ret err[diag.Refusal].err{lines.refuse(l, BAD_FIELDS, nil)}; }
            val name: res[str, diag.Refusal] = owned(a, l, tokens.data[1]);
            if (sel name.err) { ret err[diag.Refusal].err{name.err}; }
            val unit: res[u32, diag.Refusal] = decimal(l, tokens.data[2]);
            if (sel unit.err) { ret err[diag.Refusal].err{unit.err}; }
            val max: res[u32, diag.Refusal] = decimal(l, tokens.data[3]);
            if (sel max.err)                                                                              { ret err[diag.Refusal].err{max.err}; }
            if (!pushed(vector.push[Scale](?f.scales, Scale{name: name.ok, unit: unit.ok, max: max.ok}))) { ret err[diag.Refusal].err{memory(l)}; }
        }
        or (view_eq_str(tokens.data[0], "fix")) {
            if (tokens.len != 4) { ret err[diag.Refusal].err{lines.refuse(l, BAD_FIELDS, nil)}; }
            val s: opt[u8] = scale_named(f, tokens.data[1]);
            if (sel s.none)                          { ret err[diag.Refusal].err{lines.refuse(l, BAD_FIX, nil)}; }
            if (extension_id(tokens.data[2]) == nil) { ret err[diag.Refusal].err{lines.refuse(l, BAD_FIX, nil)}; }
            val m: res[u32, diag.Refusal] = decimal(l, tokens.data[3]);
            if (sel m.err)                                                                 { ret err[diag.Refusal].err{m.err}; }
            if (m.ok == 0 || (m.ok & (m.ok - 1)) != 0 || m.ok > f.scales.data[s.some].max) { ret err[diag.Refusal].err{lines.refuse(l, BAD_FIX, nil)}; }
            val ext: res[str, diag.Refusal] = owned(a, l, tokens.data[2]);
            if (sel ext.err)                                                                                       { ret err[diag.Refusal].err{ext.err}; }
            if (!pushed(vector.push[Fix](?f.fixes, Fix{scale: s.some::u32, extension: ext.ok, multiplier: m.ok}))) { ret err[diag.Refusal].err{memory(l)}; }
        }
        or (view_eq_str(tokens.data[0], "class")) { done = class_line(f, l, ?tokens); }
        or (view_eq_str(tokens.data[0], "number")) {
            if (tokens.len < 4) { ret err[diag.Refusal].err{lines.refuse(l, BAD_FIELDS, nil)}; }
            var n: Numbering;
            n.line = @l;
            if (view_eq_str(tokens.data[1], "dwarf"))    { n.format = 0; }
            or (view_eq_str(tokens.data[1], "codeview")) { n.format = 1; }
            or                                           { ret err[diag.Refusal].err{lines.refuse(l, BAD_FORMAT, nil)}; }
            val first: res[u32, diag.Refusal] = decimal(l, tokens.data[2]);
            if (sel first.err) { ret err[diag.Refusal].err{first.err}; }
            n.first = first.ok;
            var joined: str   = nil;
            var k:      usize = 3;
            for (k < tokens.len) {
                val one: res[str, diag.Refusal] = owned(a, l, tokens.data[k]);
                if (sel one.err)   { ret err[diag.Refusal].err{one.err}; }
                if (joined == nil) { joined = one.ok; }
                or {
                    val both: res[str, StrError] = str_join(a, joined, ",", one.ok);
                    if (sel both.err) { ret err[diag.Refusal].err{memory(l)}; }
                    joined = both.ok;
                }
                k = k + 1;
            }
            n.names = joined;
            if (!pushed(vector.push[Numbering](?f.numberings, n))) { ret err[diag.Refusal].err{memory(l)}; }
        }
        or                { ret err[diag.Refusal].err{lines.refuse(l, BAD_RECORD, nil)}; }
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the name a pattern gives number `n`, its `%` replaced by the decimal digits
fun spell(a: *A.Allocator, pattern: str, n: u32) res[str, StrError] {
    var digits: [12]u8;
    val len:    usize = format.put_i64(?digits[0], n::i64);
    digits[len] = 0;
    var at: usize = 0;
    for (pattern[at] != 0 && pattern[at] != '%') {
        at = at + 1;
    }
    if (pattern[at] == 0) { ret str_copy_slice(a, pattern, 0, at); }
    val head: res[str, StrError] = str_copy_slice(a, pattern, 0, at);
    if (sel head.err) { ret head; }
    ret str_join(a, head.ok, ?digits[0], ?pattern[at + 1]);
}

# one entry of a list of names: a name, a dash, or a pattern and a range as `r%d:8-15`
# ---
# ret: the names the entry stands for, one per number, a nil name for a dash, appended to `out`
fun entry(a: *A.Allocator, text: str, from: usize, to: usize, out: *vector.Vector[str]) bool {
    var colon: usize = to;
    var i:     usize = from;
    for (i < to) {
        if (text[i] == ':') { colon = i; }
        i = i + 1;
    }
    if (colon == to) {
        if (to - from == 1 && text[from] == '-') { ret pushed(vector.push[str](out, nil)); }
        val one: res[str, StrError] = str_copy_slice(a, text, from, to - from);
        if (sel one.err) { ret false; }
        ret pushed(vector.push[str](out, one.ok));
    }
    var dash: usize = colon;
    i = colon + 1;
    for (i < to) {
        if (text[i] == '-') { dash = i; }
        i = i + 1;
    }
    if (dash == colon) { ret false; }
    val lo: i64 = digits(text, colon + 1, dash - colon - 1);
    val hi: i64 = digits(text, dash + 1, to - dash - 1);
    if (lo < 0 || hi < lo) { ret false; }
    val pattern: res[str, StrError] = str_copy_slice(a, text, from, colon - from);
    if (sel pattern.err) { ret false; }
    var n: i64 = lo;
    for (n <= hi) {
        val spelled: res[str, StrError] = spell(a, pattern.ok, n::u32);
        if (sel spelled.err)                            { ret false; }
        if (!pushed(vector.push[str](out, spelled.ok))) { ret false; }
        n = n + 1;
    }
    ret true;
}

# the names of a comma list, in order
fun names_of(a: *A.Allocator, text: str, out: *vector.Vector[str]) bool {
    val len: usize = str_len(text);
    var at:  usize = 0;
    for (at <= len) {
        var end: usize = at;
        for (end < len && text[end] != ',') {
            end = end + 1;
        }
        if (end == at || !entry(a, text, at, end, out)) { ret false; }
        at = end + 1;
    }
    ret true;
}

fun class_named(f: *Families, name: str) i64 {
    var i: usize = 0;
    for (i < f.classes.len) {
        if (str_equals(f.classes.data[i].name, name)) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

# the banks of every class, then the rows of every class in the order of the classes, which is the order of their identities
fun expand(f: *Families) err[diag.Refusal] {
    var i:    usize = 0;
    var next: u32   = 0;
    for (i < f.classes.len) {
        val c: *Class = ?f.classes.data[i];
        var j: usize  = 0;
        for (j < i) {
            if (str_equals(f.classes.data[j].name, c.name)) { ret err[diag.Refusal].err{lines.refuse(?c.line, CLASS_TWICE, c.name)}; }
            j = j + 1;
        }
        if (c.bank == 1 || c.bank == 2) {
            val w: i64 = class_named(f, c.with_name);
            if (w < 0 || w::usize >= i) { ret err[diag.Refusal].err{lines.refuse(?c.line, BAD_BANK, c.with_name)}; }
            val held: u32 = f.classes.data[w].bank;
            if (held != 0 && !(held == 3 && c.bank == 1)) { ret err[diag.Refusal].err{lines.refuse(?c.line, BAD_BANK, c.with_name)}; }
            c.with = w;
        }
        if (c.bank == 0) {
            c.base = next;
            next   = next + c.count;
        }
        or (c.bank == 3) {
            c.base = next;
            next   = next + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < f.classes.len) {
        val c:     *Class             = ?f.classes.data[i];
        var names: vector.Vector[str] = vector.init[str](f.alloc);
        if (!names_of(f.alloc, c.names, ?names) || c.first + names.len::u32 > c.count) { ret err[diag.Refusal].err{lines.refuse(?c.line, BAD_NAMES, c.names)}; }
        var k: usize = 0;
        for (k < names.len) {
            if (names.data[k] == nil) {
                k = k + 1;
                cnt;
            }
            val n: u32 = c.first + k::u32;
            var r: Row;
            r.name   = names.data[k];
            r.class  = i::u32;
            r.number = n;
            r.dwarf  = -1;
            r.cv     = -1;
            r.count  = Quantity{fixed: 1, per: 0, scale: 0};
            var v: View;
            if (!ranged(c.extend, n, ?v) || extend_named(v) == nil) { ret err[diag.Refusal].err{lines.refuse(?c.line, BAD_EXTEND, r.name)}; }
            r.extend = extend_named(v);
            if (!ranged(c.flags, n, ?v) || flag_named(v) == nil) { ret err[diag.Refusal].err{lines.refuse(?c.line, BAD_FLAG, r.name)}; }
            r.flags = flag_named(v);
            if (!ranged(c.requires, n, ?v)) { ret err[diag.Refusal].err{lines.refuse(?c.line, BAD_REQUIRES, r.name)}; }
            r.requires = nil;
            if (!view_eq_str(v, "-")) {
                val spec: res[str, StrError] = str_copy_slice(f.alloc, v.data, 0, v.len);
                if (sel spec.err) { ret err[diag.Refusal].err{lines.refuse(?c.line, diag.MEMORY, r.name)}; }
                r.requires = spec.ok;
            }
            if (c.bank == 0)                                     { r.bank = c.base + n; }
            or (c.bank == 3)                                     { r.bank = c.base; }
            or (c.bank == 1 && f.classes.data[c.with].bank == 3) { r.bank = f.classes.data[c.with].base; }
            or (c.bank == 1)                                     { r.bank = f.classes.data[c.with].base + f.classes.data[c.with].first; }
            or {
                val m: i64    = n::i64 + c.delta;
                val o: *Class = ?f.classes.data[c.with];
                if (m < o.first::i64 || m >= (o.first + o.count)::i64) { ret err[diag.Refusal].err{lines.refuse(?c.line, BAD_BANK, r.name)}; }
                r.bank = o.base + m::u32;
            }
            if (c.offset == 1) { r.offset = Quantity{fixed: c.fixed, per: 0, scale: 0}; }
            or (c.offset == 2) { r.offset = Quantity{fixed: n * c.fixed, per: 0, scale: 0}; }
            r.places    = c.places;
            r.step      = c.step;
            r.part      = c.part;
            r.reach_at  = c.reach_at;
            r.reach_len = c.reach_len;
            if (c.pieces != 0) {
                r.stride = Quantity{fixed: c.stride, per: 0, scale: 0};
                r.count  = Quantity{fixed: c.pieces, per: 0, scale: 0};
            }
            if (!pushed(vector.push[Row](?f.rows, r))) { ret err[diag.Refusal].err{lines.refuse(?c.line, diag.MEMORY, r.name)}; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

# the numbers each `number` record gives, consecutive from its first
fun number_rows(f: *Families) err[diag.Refusal] {
    var i: usize = 0;
    for (i < f.numberings.len) {
        val n:     *Numbering         = ?f.numberings.data[i];
        var names: vector.Vector[str] = vector.init[str](f.alloc);
        if (!names_of(f.alloc, n.names, ?names)) { ret err[diag.Refusal].err{lines.refuse(?n.line, BAD_NAMES, n.names)}; }
        var k: usize = 0;
        for (k < names.len) {
            var found: i64   = -1;
            var j:     usize = 0;
            for (j < f.rows.len) {
                if (names.data[k] != nil && str_equals(f.rows.data[j].name, names.data[k])) { found = j::i64; }
                j = j + 1;
            }
            if (found < 0) { ret err[diag.Refusal].err{lines.refuse(?n.line, UNKNOWN, names.data[k])}; }
            val row: *Row = ?f.rows.data[found];
            if (n.format == 0) {
                if (row.dwarf >= 0) { ret err[diag.Refusal].err{lines.refuse(?n.line, NUMBERED, row.name)}; }
                row.dwarf = (n.first + k::u32)::i64;
            }
            or {
                if (row.cv >= 0) { ret err[diag.Refusal].err{lines.refuse(?n.line, NUMBERED, row.name)}; }
                row.cv = (n.first + k::u32)::i64;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[diag.Refusal].ok{};
}

fun number(n: i64) emit.Value {
    ret emit.Value.number{n};
}

fun name(s: str) emit.Value {
    ret emit.Value.name{s};
}

fun quantity(f: *emit.File, q: Quantity) emit.Value {
    val r: *emit.Record = emit.record(f, "quantity.Scaled");
    emit.member(f, r, "fixed", number(q.fixed::i64));
    emit.member(f, r, "per", number(q.per::i64));
    emit.member(f, r, "scale", number(q.scale::i64));
    ret emit.Value.record{r};
}

# the places of a row, ONE_PLACE for one
fun places(f: *emit.File, x: *Row) emit.Value {
    if (x.places == 1) { ret name("register.ONE_PLACE"); }
    val r: *emit.Record = emit.record(f, "register.Places");
    emit.member(f, r, "count", quantity(f, Quantity{fixed: x.places, per: 0, scale: 0}));
    emit.member(f, r, "step", quantity(f, Quantity{fixed: x.step, per: 0, scale: 0}));
    ret emit.Value.record{r};
}

# the reach of a row's extension, the whole bank or one piece of it past the register
fun reach(f: *emit.File, x: *Row) emit.Value {
    if (!x.part) { ret emit.Value.variant{emit.bare(f, "register.Reach.bank")}; }
    val p: *emit.Record = emit.record(f, "register.Part");
    emit.member(f, p, "offset", quantity(f, Quantity{fixed: x.reach_at, per: 0, scale: 0}));
    emit.member(f, p, "stride", quantity(f, Quantity{fixed: 0, per: 0, scale: 0}));
    emit.member(f, p, "count", quantity(f, Quantity{fixed: 1, per: 0, scale: 0}));
    emit.member(f, p, "width", quantity(f, Quantity{fixed: x.reach_len, per: 0, scale: 0}));
    ret emit.Value.variant{emit.variant(f, "register.Reach.part", emit.Value.record{p})};
}

fun known(seen: *vector.Vector[str], text: str) bool {
    var i: usize = 0;
    for (i < seen.len) {
        if (str_equals(seen.data[i], text)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# `spec` declared as arrays, one id array per alternative and the alternatives, once each. an alternative is extensions joined by `&`
fun declare_requirement(f: *emit.File, spec: str, seen: *vector.Vector[str]) err[diag.Refusal] {
    if (known(seen, spec)) { ret err[diag.Refusal].ok{}; }
    vector.push[str](seen, spec);
    val alts: *emit.Array = emit.array(f, "requirement.Ids");
    val len:  usize       = str_len(spec);
    var at:   usize       = 0;
    for (at <= len) {
        var end: usize = at;
        for (end < len && spec[end] != '|') {
            end = end + 1;
        }
        val token: res[str, StrError] = str_copy_slice(f.alloc, spec, at, end - at);
        if (sel token.err) { ret err[diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, spec)}; }
        val label: str = emit.concat(f, "ID_", emit.ident(f, token.ok));
        var count: u32 = 0;
        if (!known(seen, label)) {
            vector.push[str](seen, label);
            val ids:  *emit.Array = emit.array(f, "requirement.Id");
            var from: usize       = at;
            var to:   usize       = at;
            for (from <= end) {
                to = from;
                for (to < end && spec[to] != '&') {
                    to = to + 1;
                }
                emit.item(f, ids, name(extension_id(View{data: ?spec[from], len: to - from})));
                from = to + 1;
            }
            emit.declare(f, label, nil, emit.Value.array{ids});
        }
        var n: u32   = 1;
        var i: usize = at;
        for (i < end) {
            if (spec[i] == '&') { n = n + 1; }
            i = i + 1;
        }
        count = n;
        val r: *emit.Record = emit.record(f, "requirement.Ids");
        emit.member(f, r, "at", emit.element(f, label, 0));
        emit.member(f, r, "len", number(count::i64));
        emit.item(f, alts, emit.Value.record{r});
        at = end + 1;
    }
    emit.declare(f, emit.concat(f, "REQUIRES_", emit.ident(f, spec)), nil, emit.Value.array{alts});
    ret err[diag.Refusal].ok{};
}

fun requirement_value(f: *emit.File, spec: str) emit.Value {
    if (spec == nil) { ret name("requirement.NO_ALTERNATIVES"); }
    var n: u32   = 1;
    var i: usize = 0;
    for (spec[i] != 0) {
        if (spec[i] == '|') { n = n + 1; }
        i = i + 1;
    }
    val r: *emit.Record = emit.record(f, "requirement.Requirement");
    emit.member(f, r, "at", emit.element(f, emit.concat(f, "REQUIRES_", emit.ident(f, spec)), 0));
    emit.member(f, r, "len", number(n::i64));
    ret emit.Value.record{r};
}

# a column of one debug format: the number of every row, and the rows by number
fun column(c: *set.Context, f: *emit.File, fam: *Families, tag: str, format: str, cv: bool, out: *emit.Array) err[diag.Refusal] {
    val numbers: *emit.Array        = emit.array(f, "u32");
    var order:   vector.Vector[u64] = vector.init[u64](c.alloc);
    var i:       usize              = 0;
    for (i < fam.rows.len) {
        var n: i64 = fam.rows.data[i].dwarf;
        if (cv)    { n = fam.rows.data[i].cv; }
        if (n < 0) { emit.item(f, numbers, name("register.UNNUMBERED")); }
        or {
            emit.item(f, numbers, number(n));
            if (!pushed(vector.push[u64](?order, (n::u64 << 32) | i::u64))) { ret err[diag.Refusal].err{diag.refusal(nil, 0, diag.MEMORY, tag)}; }
        }
        i = i + 1;
    }
    sort.sort[u64](order.data, order.len);
    val numbered: *emit.Array = emit.array(f, "index.Number");
    i = 0;
    for (i < order.len) {
        val r: *emit.Record = emit.record(f, "index.Number");
        emit.member(f, r, "key", number((order.data[i] >> 32)::i64));
        emit.member(f, r, "row", number((order.data[i] & 0xFFFF_FFFF)::i64));
        emit.item(f, numbered, emit.Value.record{r});
        if (i > 0 && (order.data[i - 1] >> 32) == (order.data[i] >> 32)) { ret err[diag.Refusal].err{diag.refusal(FAMILIES, 0, emit.KEY_TWICE, tag)}; }
        i = i + 1;
    }
    val rows:    str = emit.concat(f, tag, "_NUMBERS");
    val ordered: str = emit.concat(f, tag, "_NUMBERED");
    emit.declare(f, rows, nil, emit.Value.array{numbers});
    emit.declare(f, ordered, nil, emit.Value.array{numbered});
    val col: *emit.Record = emit.record(f, "register.Column");
    emit.member(f, col, "format", name(format));
    emit.member(f, col, "numbers", emit.element(f, rows, 0));
    emit.member(f, col, "len", number(fam.rows.len::i64));
    val idx: *emit.Record = emit.record(f, "index.Numbers");
    emit.member(f, idx, "at", emit.element(f, ordered, 0));
    emit.member(f, idx, "len", number(order.len::i64));
    emit.member(f, col, "numbered", emit.Value.record{idx});
    emit.item(f, out, emit.Value.record{col});
    ret err[diag.Refusal].ok{};
}

# the x86 register file generated from the register families
pub fun generate(c: *set.Context) err[diag.Refusal] {
    var fam: Families;
    fam.alloc      = c.alloc;
    fam.scales     = vector.init[Scale](c.alloc);
    fam.fixes      = vector.init[Fix](c.alloc);
    fam.classes    = vector.init[Class](c.alloc);
    fam.numberings = vector.init[Numbering](c.alloc);
    fam.rows       = vector.init[Row](c.alloc);
    val read_it: err[diag.Refusal] = read(c.alloc, c.tree, ?fam);
    if (sel read_it.err) { ret read_it; }
    val expanded: err[diag.Refusal] = expand(?fam);
    if (sel expanded.err) { ret expanded; }
    val numbered: err[diag.Refusal] = number_rows(?fam);
    if (sel numbered.err) { ret numbered; }
    val opened: res[*emit.File, diag.Refusal] = set.table(c, "register");
    if (sel opened.err) { ret err[diag.Refusal].err{opened.err}; }
    val f: *emit.File = opened.ok;
    emit.uses(f, "x86_extension: masc.isa.x86.extension");
    emit.uses(f, "masc.core.index");
    emit.uses(f, "masc.core.register");
    emit.uses(f, "masc.core.quantity");
    emit.uses(f, "masc.core.requirement");

    val scales: *emit.Array = emit.array(f, "quantity.Scale");
    var i:      usize       = 0;
    for (i < fam.scales.len) {
        val fixes: *emit.Array = emit.array(f, "quantity.Fixing");
        var j:     usize       = 0;
        for (j < fam.fixes.len) {
            if (fam.fixes.data[j].scale::usize == i) {
                val x: *emit.Record = emit.record(f, "quantity.Fixing");
                emit.member(f, x, "by", name(extension_id(view(fam.fixes.data[j].extension, str_len(fam.fixes.data[j].extension)))));
                emit.member(f, x, "multiplier", number(fam.fixes.data[j].multiplier::i64));
                emit.item(f, fixes, emit.Value.record{x});
            }
            j = j + 1;
        }
        val r: *emit.Record = emit.record(f, "quantity.Scale");
        emit.member(f, r, "name", emit.Value.text{fam.scales.data[i].name});
        emit.member(f, r, "max", number(fam.scales.data[i].max::i64));
        if (emit.length(fixes) == 0) { emit.member(f, r, "fixes", name("quantity.NO_FIXINGS")); }
        or {
            val label: str = emit.concat(f, "FIXES_", emit.ident(f, fam.scales.data[i].name));
            emit.declare(f, label, nil, emit.Value.array{fixes});
            val fx: *emit.Record = emit.record(f, "quantity.Fixings");
            emit.member(f, fx, "at", emit.element(f, label, 0));
            emit.member(f, fx, "len", number(emit.length(fixes)::i64));
            emit.member(f, r, "fixes", emit.Value.record{fx});
        }
        emit.item(f, scales, emit.Value.record{r});
        i = i + 1;
    }
    emit.declare(f, "SCALES", nil, emit.Value.array{scales});

    val classes: *emit.Array = emit.array(f, "register.Class");
    val names:   *emit.Array = emit.keyed(f, "index.Entry");
    i = 0;
    for (i < fam.classes.len) {
        val k: *Class       = ?fam.classes.data[i];
        val r: *emit.Record = emit.record(f, "register.Class");
        emit.member(f, r, "name", emit.Value.text{k.name});
        emit.member(f, r, "kind", name(k.kind));
        emit.member(f, r, "width", quantity(f, k.width));
        emit.member(f, r, "count", number(k.count::i64));
        emit.item(f, classes, emit.Value.record{r});
        val e: *emit.Record = emit.record(f, "index.Entry");
        emit.member(f, e, "key", emit.Value.text{k.name});
        emit.member(f, e, "row", number(i::i64));
        emit.entry(f, names, k.name, emit.Value.record{e});
        emit.declare(f, emit.concat(f, emit.ident(f, k.name), "_CLASS"), "u16", number(i::i64));
        i = i + 1;
    }
    emit.declare(f, "CLASSES", nil, emit.Value.array{classes});
    emit.declare(f, "CLASS_NAMES", nil, emit.Value.array{names});

    var seen: vector.Vector[str] = vector.init[str](c.alloc);
    i = 0;
    for (i < fam.rows.len) {
        if (fam.rows.data[i].requires != nil) {
            val declared: err[diag.Refusal] = declare_requirement(f, fam.rows.data[i].requires, ?seen);
            if (sel declared.err) { ret declared; }
        }
        i = i + 1;
    }
    val rows:    *emit.Array = emit.array(f, "register.Register");
    val spelled: *emit.Array = emit.keyed(f, "index.Entry");
    i = 0;
    for (i < fam.rows.len) {
        val x: *Row         = ?fam.rows.data[i];
        val r: *emit.Record = emit.record(f, "register.Register");
        emit.member(f, r, "name", emit.Value.text{x.name});
        emit.member(f, r, "class", number(x.class::i64));
        emit.member(f, r, "number", number(x.number::i64));
        emit.member(f, r, "bank", number(x.bank::i64));
        emit.member(f, r, "offset", quantity(f, x.offset));
        emit.member(f, r, "stride", quantity(f, x.stride));
        emit.member(f, r, "count", quantity(f, x.count));
        emit.member(f, r, "places", places(f, x));
        emit.member(f, r, "flags", name(x.flags));
        emit.member(f, r, "requires", requirement_value(f, x.requires));
        emit.member(f, r, "extend", name(x.extend));
        emit.member(f, r, "reach", reach(f, x));
        emit.item(f, rows, emit.Value.record{r});
        val e: *emit.Record = emit.record(f, "index.Entry");
        emit.member(f, e, "key", emit.Value.text{x.name});
        emit.member(f, e, "row", number(i::i64));
        emit.entry(f, spelled, x.name, emit.Value.record{e});
        i = i + 1;
    }
    emit.declare(f, "REGISTERS", nil, emit.Value.array{rows});
    emit.declare(f, "NAMES", nil, emit.Value.array{spelled});

    val columns: *emit.Array       = emit.array(f, "register.Column");
    val dwarf:   err[diag.Refusal] = column(c, f, ?fam, "DWARF", "register.DWARF", false, columns);
    if (sel dwarf.err) { ret dwarf; }
    val codeview: err[diag.Refusal] = column(c, f, ?fam, "CODEVIEW", "register.CODEVIEW", true, columns);
    if (sel codeview.err) { ret codeview; }
    emit.declare(f, "COLUMNS", nil, emit.Value.array{columns});

    val file: *emit.Record = emit.record(f, "register.File");
    emit.member(f, file, "scales", emit.element(f, "SCALES", 0));
    emit.member(f, file, "scale_count", number(fam.scales.len::i64));
    emit.member(f, file, "classes", emit.element(f, "CLASSES", 0));
    emit.member(f, file, "class_count", number(fam.classes.len::i64));
    val cn: *emit.Record = emit.record(f, "index.Index");
    emit.member(f, cn, "at", emit.element(f, "CLASS_NAMES", 0));
    emit.member(f, cn, "len", number(fam.classes.len::i64));
    emit.member(f, file, "class_names", emit.Value.record{cn});
    emit.member(f, file, "registers", emit.element(f, "REGISTERS", 0));
    emit.member(f, file, "register_count", number(fam.rows.len::i64));
    emit.member(f, file, "aliases", name("nil"));
    emit.member(f, file, "alias_count", number(0));
    val nm: *emit.Record = emit.record(f, "index.Index");
    emit.member(f, nm, "at", emit.element(f, "NAMES", 0));
    emit.member(f, nm, "len", number(fam.rows.len::i64));
    emit.member(f, file, "names", emit.Value.record{nm});
    emit.member(f, file, "columns", emit.element(f, "COLUMNS", 0));
    emit.member(f, file, "column_count", number(2));
    emit.declare(f, "FILE", "register.File", emit.Value.record{file});
    ret err[diag.Refusal].ok{};
}
