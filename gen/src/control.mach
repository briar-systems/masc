# the trap words every set's control facts read, read and emitted alike (masc.core.effect.Transfer)
#
# a set's control fact names its transfer by a word of its own topic, and a trap states beside it whether the handler
# resumes at the next instruction:
#
#   transfer=trap returns=<yes|no>
#
# `returns=yes` is a trap that comes back, as a system call or a breakpoint a debugger continues from (effect.TRAP),
# and `returns=no` one nothing falls through after, as an undefined instruction or wasm unreachable (effect.FAULT). a
# trap that states neither, and a `returns` beside any other transfer, is refused, so every trap row is classified by
# its line

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use masc.core.effect;

use gen.diag;
use gen.overlay;

pub val UNCLASSIFIED: str = "trap states neither returns=yes nor returns=no";
pub val NOT_A_TRAP:   str = "returns is stated of a transfer that is no trap";

# the transfer of trap line `l`, TRAP when it returns and FAULT when it does not, refused when it states neither
pub fun trap(l: *overlay.Line, out: *effect.Transfer) err[diag.Refusal] {
    val stated: opt[str] = overlay.value(?l.ws, "returns");
    if (sel stated.none) { ret overlay.reject(l, UNCLASSIFIED, l.fact.key); }
    val returns: res[bool, diag.Refusal] = overlay.yes(l, "returns", false);
    if (sel returns.err) { ret err[diag.Refusal].err{returns.err}; }
    if (returns.ok)      { @out = effect.TRAP; }
    or                   { @out = effect.FAULT; }
    ret err[diag.Refusal].ok{};
}

# line `l` refused when it states `returns`, which only a trap reads
pub fun untrapped(l: *overlay.Line) err[diag.Refusal] {
    val stated: opt[str] = overlay.value(?l.ws, "returns");
    if (sel stated.some) { ret overlay.reject(l, NOT_A_TRAP, stated.some); }
    ret err[diag.Refusal].ok{};
}

# the effect constant of a set that names transfers by constant: a trap line's by whether it returns, through `out`,
# and any other line's left as `out` holds it, refused when it states `returns`
pub fun classified(l: *overlay.Line, word: str, out: *str) err[diag.Refusal] {
    if (!str_equals(word, "trap")) { ret untrapped(l); }
    var t:   effect.Transfer   = effect.NONE;
    val got: err[diag.Refusal] = trap(l, ?t);
    if (sel got.err) { ret got; }
    @out = constant(t);
    ret err[diag.Refusal].ok{};
}

# the name of the effect constant of transfer `t`
pub fun constant(t: effect.Transfer) str {
    if (t == effect.JUMP)   { ret "effect.JUMP"; }
    if (t == effect.CALL)   { ret "effect.CALL"; }
    if (t == effect.RETURN) { ret "effect.RETURN"; }
    if (t == effect.TRAP)   { ret "effect.TRAP"; }
    if (t == effect.MERGE)  { ret "effect.MERGE"; }
    if (t == effect.FAULT)  { ret "effect.FAULT"; }
    ret "effect.NONE";
}
