# a windows checkout must not turn LF into CRLF, or `mach fmt --check` there
# reads a different file from the one that was formatted
* text=auto eol=lf

# a vendored copy keeps its upstream bytes, which its recorded checksum is over
gen/vendor/** -text

# generated tables are reviewed through their generator and gen --check, not line by line
src/isa/*/gen_*.mach linguist-generated=true
