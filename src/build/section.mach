use masc.format.dialect;
use mink.model.merged;

# the section the format holds the traits in named `name`, its handle, opened once
fun open_raised(b: *Builder, name: str) res[Section, Refusal] {
    val named: res[table.Id[intern.Name], Refusal] = name_of(b, name);
    if (sel named.err) { ret res[Section, Refusal].err{named.err}; }
    var k: usize = 0;
    for (k < b.raised.len) {
        if (b.raised.data[k].name.index == named.ok.index) { ret res[Section, Refusal].ok{(RAISED_BASE + k::u32)}; }
        k = k + 1;
    }
    if (!held(vector.push[Raised](?b.raised, Raised{name: named.ok, bytes: vector.init[u8](b.a)}))) { ret res[Section, Refusal].err{memory()}; }
    ret res[Section, Refusal].ok{(RAISED_BASE + k::u32)};
}

# the section the format holds the traits in that the current section is, none for another
pub fun raising(b: *Builder) opt[*Raised] {
    if (b.finished)         { ret opt[*Raised].none{}; }
    if (sel b.current.none) { ret opt[*Raised].none{}; }
    val at: usize = b.current.some;
    if (at < RAISED_BASE::usize || at == STARTING::usize) { ret opt[*Raised].none{}; }
    ret opt[*Raised].some{?b.raised.data[at - RAISED_BASE::usize]};
}

# a new section, which is current once switched to. one opened apart is a section of its own each time. a section the
# format holds the traits in, as elf's `.note.gnu.property`, is no section of the object: its data is raised into the
# object's traits at finish (`raise_all`), so it takes data alone and is one section however often it is opened, and
# one opened apart is refused. a nameless one is written by the format's row for its key, so it takes the key and the
# flags that row reads back with, and two opens the format spells alike, by its name, flags and entry size, in no
# group and after no section, neither apart, are one section (`spelled_alike`), as coff writes relro data and
# read-only data both as `.rdata` and mach-o writes a key it merges in no section as `__const`. the section takes the
# largest alignment asked of it, and each contribution keeps its own by the alignment placed before it
pub fun open(b: *Builder, spec: Spec) res[Section, Refusal] {
    if (b.finished)                               { ret res[Section, Refusal].err{refuse(FINISHED)}; }
    if (!held(vector.reserve[Area](?b.areas, 1))) { ret res[Section, Refusal].err{memory()}; }
    var name: opt[table.Id[intern.Name]] = opt[table.Id[intern.Name]].none{};
    if (sel spec.name.some) {
        val holds: res[bool, fail.Fail] = trait.holds_traits(b.formats, b.format, b.arch, spec.name.some);
        if (sel holds.err) { ret res[Section, Refusal].err{failed(holds.err)}; }
        if (holds.ok) {
            if (spec.apart) { ret res[Section, Refusal].err{refuse(TRAIT_SECTION)}; }
            ret open_raised(b, spec.name.some);
        }
        val named: res[table.Id[intern.Name], Refusal] = name_of(b, spec.name.some);
        if (sel named.err) { ret res[Section, Refusal].err{named.err}; }
        name = opt[table.Id[intern.Name]].some{named.ok};
    }
    var kind:    *mink_section.Kind = spec.kind;
    var flags:   mink_section.Flags = spec.flags;
    var entsize: u64                = spec.entsize;
    if (sel spec.name.none) {
        # a key the format has no row for is spelled by nothing, so it stands as stated, alike to no other
        val res_written: res[mink_section.Key, fail.Fail] = b.naming.written(mink_section.Key{kind: spec.kind, entsize: spec.entsize});
        if (sel res_written.ok) {
            if (res_written.ok.kind != spec.kind) { flags = res_written.ok.kind.flags; }
            kind    = res_written.ok.kind;
            entsize = res_written.ok.entsize;
            if (!spec.apart) {
                val opt_alike: opt[Section] = spelled_alike(b, kind, flags, entsize, spec.disposition);
                if (sel opt_alike.some) { ret res[Section, Refusal].ok{opt_alike.some}; }
            }
        }
    }
    val index: u32  = b.areas.len::u32;
    var area:  Area = Area{
        name:        name,
        kind:        kind,
        flags:       flags,
        disposition: spec.disposition,
        entsize:     entsize,
        align:       1,
        bits:        mink_section.has(kind, mink_section.BITS),
        code:        (flags & mink_section.EXEC) != 0,
        fragments:   vector.init[Fragment](b.a),
        marks:       vector.init[u32](b.a),
        bytes:       vector.init[u8](b.a),
        apart:       spec.apart,
    };
    vector.push[Area](?b.areas, area);
    if (sel name.some) {
        if (!spec.apart && b.titled.data[name.some.index::usize] == 0) { b.titled.data[name.some.index::usize] = index + 1; }
    }
    # a section of the starting section's name is the starting section, which then stands for it
    if (sel b.started.none && !spec.apart && pending_name(b, spec.name)) { b.started = opt[u32].some{index}; }
    ret res[Section, Refusal].ok{index};
}

# the nameless section opened before that the format writes as it writes a nameless section of key `kind` and
# `entsize`, flags `flags` and disposition `disposition`, opened not apart, in no comdat group and after no section;
# none when none is
fun spelled_alike(b: *Builder, kind: *mink_section.Kind, flags: mink_section.Flags, entsize: u64, disposition: *mink_section.Disposition) opt[Section] {
    var k: usize = 0;
    for (k < b.areas.len) {
        val o: *Area = ?b.areas.data[k];
        k = k + 1;
        if (sel o.name.some || o.apart || sel o.group.some || sel o.owner.some)                         { cnt; }
        if (o.kind == kind && o.flags == flags && o.entsize == entsize && o.disposition == disposition) { ret opt[Section].some{(k - 1)::u32}; }
    }
    ret opt[Section].none{};
}

# section `s` put in the comdat group of signature `signature`, the group of each section of that signature, which keeps
# any one copy of it across the objects linked (mink's `group.ANY`). the object names the group by the signature's
# name, which a symbol of that name stands for, or which the format writes as a symbol of its own when the object holds
# none, as assemblers sign a group no label exposes. a section joins one group at most
pub fun join(b: *Builder, s: Section, signature: View) err[Refusal] {
    ret join_by(b, s, signature, ?mink_group.ANY);
}

# section `s` put in the comdat group of signature `signature`, which keeps a copy by `rule`, as coff's selections
# state one, every section of the signature's group stating the same rule. a rule that names a leader section, as
# coff's associative selection does, is `associate`'s, and refused here
pub fun join_by(b: *Builder, s: Section, signature: View, rule: *mink_group.Rule) err[Refusal] {
    if (b.finished)                                { ret refused(FINISHED); }
    if ((rule.caps & mink_group.ASSOCIATIVE) != 0) { ret refused(RULED); }
    if (s::usize >= b.areas.len)                   { ret refused(NO_SUCH); }
    val area: *Area = ?b.areas.data[s::usize];
    if (sel area.group.some || area.rule == ?mink_group.ASSOCIATE) { ret refused(REGROUPED); }
    if (signature.len == 0)                                        { ret refused(SIGNATURE); }
    val named: res[table.Id[intern.Name], Refusal] = name_bytes(b, signature.data, signature.len);
    if (sel named.err) { ret err[Refusal].err{named.err}; }
    var k: usize = 0;
    for (k < b.areas.len) {
        val other: *Area = ?b.areas.data[k];
        k = k + 1;
        if (sel other.group.some) {
            if (other.group.some.index == named.ok.index && other.rule != rule) { ret refused(RULED); }
        }
    }
    val into: *Area = ?b.areas.data[s::usize];
    into.group = opt[table.Id[intern.Name]].some{named.ok};
    into.rule  = rule;
    ret err[Refusal].ok{};
}

# every section cut at its symbols, as mach-o's `.subsections_via_symbols` cuts the whole file
# (mach-o/loader.h, MH_SUBSECTIONS_VIA_SYMBOLS): each one loaded whole is split, and unwind records and what only
# describes code keep their own disposition, as mink's mach-o reader reads them. refused where the dialect holds
# copies otherwise than as atoms, as no other format cuts a file so
pub fun split_by_symbols(b: *Builder) err[Refusal] {
    if (b.finished)       { ret refused(FINISHED); }
    if (b.dialect == nil) { ret refused(UNCUT); }
    val held_in: dialect.Copies = b.dialect.copies;
    if (!sel held_in.atoms) { ret refused(UNCUT); }
    var k: usize = 0;
    for (k < b.areas.len) {
        val area: *Area = ?b.areas.data[k];
        k = k + 1;
        if (area.disposition != ?mink_section.WHOLE)                                               { cnt; }
        if (mink_section.has(area.kind, mink_section.UNWIND) || mink_section.describes(area.kind)) { cnt; }
        area.disposition = ?mink_section.SPLIT;
    }
    ret err[Refusal].ok{};
}

# a section holding part of the copy of the merged definition `name` of identity `identity` (mink.model.merged), of
# the kind and flags `spec` states, for the caller to switch to. on a format whose copies are groups, a section of its
# own in the group the copy signature signs, one for each call, so a copy's code and its tables are sections of one
# group. on one whose copies are atoms, the one section of its holdings the dialect names for copies, cut at each
# symbol, the next label placed in it starting an atom of the copy, made a symbol of its own when it is none, so a
# copy's tables are atoms of it as its code is
pub fun copy(b: *Builder, spec: Spec, name: View, identity: u64) res[Section, Refusal] {
    if (b.finished)       { ret res[Section, Refusal].err{refuse(FINISHED)}; }
    if (b.dialect == nil) { ret res[Section, Refusal].err{refuse(NO_COPIES)}; }
    val held_in: dialect.Copies = b.dialect.copies;
    if (sel held_in.none) { ret res[Section, Refusal].err{refuse(NO_COPIES)}; }
    var spelled: vector.Vector[u8] = vector.init[u8](b.a);
    if (!held(vector.reserve[u8](?spelled, name.len + merged.EXTRA))) { ret res[Section, Refusal].err{memory()}; }
    merged.signature(name, identity, spelled.data);
    val signed: res[table.Id[intern.Name], Refusal] = name_bytes(b, spelled.data, name.len + merged.EXTRA);
    vector.dnit[u8](?spelled);
    if (sel signed.err) { ret res[Section, Refusal].err{signed.err}; }
    val k: res[u32, Refusal] = copy_index(b, signed.ok);
    if (sel k.err) { ret res[Section, Refusal].err{k.err}; }
    if (sel held_in.groups) {
        var own: Spec = spec;
        own.apart = true;
        val opened: res[Section, Refusal] = open(b, own);
        if (sel opened.err) { ret opened; }
        val sig:    View         = intern.bytes_of(?b.out.names, signed.ok);
        val joined: err[Refusal] = join(b, opened.ok, sig);
        if (sel joined.err) { ret res[Section, Refusal].err{joined.err}; }
        ret opened;
    }
    if (!sel held_in.atoms) { ret res[Section, Refusal].err{refuse(NO_COPIES)}; }
    val names: *dialect.CopySections = held_in.atoms;
    val found: opt[Section]          = copies_of(b, spec.kind);
    var at:    Section               = 0;
    if (sel found.some) { at = found.some; }
    or {
        val opened: res[Section, Refusal] = open(b, Spec{name: opt[str].some{copies_name(names, spec.kind)}, kind: spec.kind, flags: spec.flags, disposition: ?mink_section.SPLIT, entsize: 0, apart: true});
        if (sel opened.err) { ret opened; }
        at                             = opened.ok;
        b.areas.data[at::usize].copies = true;
    }
    b.areas.data[at::usize].copying = opt[u32].some{k.ok};
    ret res[Section, Refusal].ok{at};
}

# the section a replaceable definition of the kind `spec` states is placed in where the dialect holds copies as
# atoms: the one its copies are atoms of, which the format coalesces by symbol, as mach-o supports a weak definition
# only in a coalesced section (mach-o/nlist.h, N_WEAK_DEF). none where the dialect holds copies otherwise, the
# definition placed as any other
pub fun replaceable(b: *Builder, spec: Spec) res[opt[Section], Refusal] {
    if (b.finished)       { ret res[opt[Section], Refusal].err{refuse(FINISHED)}; }
    if (b.dialect == nil) { ret res[opt[Section], Refusal].ok{opt[Section].none{}}; }
    val held_in: dialect.Copies = b.dialect.copies;
    if (!sel held_in.atoms) { ret res[opt[Section], Refusal].ok{opt[Section].none{}}; }
    val found: opt[Section] = copies_of(b, spec.kind);
    if (sel found.some) { ret res[opt[Section], Refusal].ok{found}; }
    val opened: res[Section, Refusal] = open(b, Spec{name: opt[str].some{copies_name(held_in.atoms, spec.kind)}, kind: spec.kind, flags: spec.flags, disposition: ?mink_section.SPLIT, entsize: 0, apart: true});
    if (sel opened.err) { ret res[opt[Section], Refusal].err{opened.err}; }
    b.areas.data[opened.ok::usize].copies = true;
    ret res[opt[Section], Refusal].ok{opt[Section].some{opened.ok}};
}

# the index among the builder's copies of the one signed `signature`, added when there is none
fun copy_index(b: *Builder, signature: table.Id[intern.Name]) res[u32, Refusal] {
    var k: usize = 0;
    for (k < b.copies.len) {
        if (b.copies.data[k].signature.index == signature.index) { ret res[u32, Refusal].ok{k::u32}; }
        k = k + 1;
    }
    if (!held(vector.push[Copied](?b.copies, Copied{signature: signature}))) { ret res[u32, Refusal].err{memory()}; }
    ret res[u32, Refusal].ok{k::u32};
}

# the section copies of a merged definition of kind `kind` are atoms of, none until one is opened
fun copies_of(b: *Builder, kind: *mink_section.Kind) opt[Section] {
    var k: usize = 0;
    for (k < b.areas.len) {
        val area: *Area = ?b.areas.data[k];
        if (area.copies && area.kind == kind) { ret opt[Section].some{k::u32}; }
        k = k + 1;
    }
    ret opt[Section].none{};
}

# the name of the section copies of kind `kind` are atoms of, by what it holds
fun copies_name(names: *dialect.CopySections, kind: *mink_section.Kind) str {
    if ((kind.flags & mink_section.EXEC) != 0)      { ret names.text; }
    if (mink_section.has(kind, mink_section.RELRO)) { ret names.relro; }
    if ((kind.flags & mink_section.WRITE) != 0)     { ret names.data; }
    ret names.constant;
}

# section `s` ordered after section `owner` when linked, as an elf link-order section is ordered after the section it
# names (mink's `Section.owner`). a section takes one order at most, and a section the format holds the traits in is
# neither ordered nor an owner, since the object holds no section for it
pub fun order(b: *Builder, s: Section, owner: Section) err[Refusal] {
    if (b.finished)                                             { ret refused(FINISHED); }
    if (s::usize >= b.areas.len || owner::usize >= b.areas.len) { ret refused(ORDER); }
    if (s == owner)                                             { ret refused(ORDER); }
    val area: *Area = ?b.areas.data[s::usize];
    if (sel area.owner.some) { ret refused(REORDERED); }
    val into: *Area = ?b.areas.data[s::usize];
    into.owner = opt[u32].some{owner};
    ret err[Refusal].ok{};
}

# section `s` kept with section `leader` when linked, as a coff associative selection keeps a section with the leader
# it names: the object puts it in an associative group of its own whose leader is `leader`, and orders it after
# `leader` (mink's `Group.leader` and `Section.owner`). a section takes one group or order at most, and a section the
# format holds the traits in is neither kept nor a leader, since the object holds no section for it
pub fun associate(b: *Builder, s: Section, leader: Section) err[Refusal] {
    if (b.finished)                                              { ret refused(FINISHED); }
    if (s::usize >= b.areas.len || leader::usize >= b.areas.len) { ret refused(ORDER); }
    if (s == leader)                                             { ret refused(ORDER); }
    val area: *Area = ?b.areas.data[s::usize];
    if (sel area.owner.some)                                       { ret refused(REORDERED); }
    if (sel area.group.some || area.rule == ?mink_group.ASSOCIATE) { ret refused(REGROUPED); }
    val into: *Area = ?b.areas.data[s::usize];
    into.owner = opt[u32].some{leader};
    into.rule  = ?mink_group.ASSOCIATE;
    ret err[Refusal].ok{};
}

# whether section `s` is kept with the section it is ordered after, by `associate`
pub fun associated(b: *Builder, s: Section) bool {
    if (s::usize >= b.areas.len) { ret false; }
    val area: *Area = ?b.areas.data[s::usize];
    ret sel area.group.none && sel area.owner.some && area.rule == ?mink_group.ASSOCIATE;
}

# the section the label named `name` is placed in, none for a name no label placed so far has
pub fun placed_in(b: *Builder, name: View) opt[Section] {
    val known: opt[table.Id[intern.Name]] = find_name(b, name.data::*u8, name.len);
    if (sel known.none) { ret opt[Section].none{}; }
    val m: opt[*Mark] = mark_of(b, (label_called(b, known.some)));
    if (sel m.none)      { ret opt[Section].none{}; }
    if (!m.some.defined) { ret opt[Section].none{}; }
    ret opt[Section].some{m.some.section};
}

# the section `s` is ordered after, none for a section of no link order
pub fun owner_of(b: *Builder, s: Section) opt[Section] {
    if (s::usize >= b.areas.len) { ret opt[Section].none{}; }
    val o: opt[u32] = b.areas.data[s::usize].owner;
    if (sel o.none) { ret opt[Section].none{}; }
    ret opt[Section].some{o.some};
}

# the signature of the comdat group section `s` is in, none for a section in none
pub fun group_of(b: *Builder, s: Section) opt[View] {
    if (s::usize >= b.areas.len) { ret opt[View].none{}; }
    val g: opt[table.Id[intern.Name]] = b.areas.data[s::usize].group;
    if (sel g.none) { ret opt[View].none{}; }
    ret opt[View].some{name_at(b, g.some)};
}

# the rule the comdat group section `s` is in keeps a copy by, the associative rule for a section `associate` keeps,
# nil for a section in none
pub fun group_rule(b: *Builder, s: Section) *mink_group.Rule {
    if (s::usize >= b.areas.len) { ret nil; }
    ret b.areas.data[s::usize].rule;
}

# the first section opened with the name `name` and not apart, none when no section is. a nameless section has none
pub fun section_named(b: *Builder, name: View) opt[Section] {
    val known: opt[table.Id[intern.Name]] = find_name(b, name.data::*u8, name.len);
    if (sel known.none) { ret opt[Section].none{}; }
    var k: usize = 0;
    for (k < b.raised.len) {
        if (b.raised.data[k].name.index == known.some.index) { ret opt[Section].some{(RAISED_BASE + k::u32)}; }
        k = k + 1;
    }
    val slot: u32 = section_titled(b, known.some);
    if (slot == 0) { ret opt[Section].none{}; }
    ret opt[Section].some{(slot - 1)};
}

# whether section `s` was opened as `spec` states, its name aside
pub fun matches(b: *Builder, s: Section, spec: *Spec) bool {
    # a section raised into traits keeps no attributes of its own
    if (s >= RAISED_BASE)        { ret s - RAISED_BASE < b.raised.len::u32; }
    if (s::usize >= b.areas.len) { ret false; }
    val area: *Area = ?b.areas.data[s::usize];
    ret area.kind == spec.kind && area.flags == spec.flags && area.disposition == spec.disposition && area.entsize == spec.entsize;
}

# the current section, none before one is switched to, STARTING while it is the starting section not yet opened
pub fun current(b: *Builder) opt[Section] {
    if (sel b.current.none) { ret opt[Section].none{}; }
    ret opt[Section].some{(b.current.some::u32)};
}

# the section emission goes to until another is switched to, the one an assembly starts in, as `.text` on elf. it is opened as `open` opens `spec` only when something is written to it or a label is placed in it, or
# when a section of its name is opened, so a source that writes nothing before its first `.section` holds no empty one.
# until then its handle is STARTING, which `switch` takes
pub fun begin(b: *Builder, spec: Spec) err[Refusal] {
    if (b.finished)                     { ret refused(FINISHED); }
    if (sel b.start.some || spec.apart) { ret refused(STARTED); }
    b.start   = opt[Spec].some{spec};
    b.current = opt[usize].some{STARTING::usize};
    ret err[Refusal].ok{};
}

# make `s` the current section, its cursor where it was left. STARTING is the starting section, opened or not
pub fun switch(b: *Builder, s: Section) err[Refusal] {
    if (s == STARTING) {
        if (sel b.start.none)   { ret refused(NO_SUCH); }
        if (sel b.started.some) { b.current = opt[usize].some{b.started.some::usize}; }
        or                      { b.current = opt[usize].some{STARTING::usize}; }
        ret err[Refusal].ok{};
    }
    if (s >= RAISED_BASE) {
        if (s - RAISED_BASE >= b.raised.len::u32) { ret refused(NO_SUCH); }
    }
    or (s::usize >= b.areas.len) { ret refused(NO_SUCH); }
    b.current = opt[usize].some{s::usize};
    ret err[Refusal].ok{};
}

# no section left current, so nothing is written or placed until one is switched to, as while a source states what is
# no section of the object
pub fun leave(b: *Builder) err[Refusal] {
    if (b.finished) { ret refused(FINISHED); }
    b.current = opt[usize].none{};
    ret err[Refusal].ok{};
}

# whether `name` is the starting section's
fun pending_name(b: *Builder, name: opt[str]) bool {
    if (sel b.start.none) { ret false; }
    val start: Spec = b.start.some;
    if (sel start.name.none) { ret false; }
    if (sel name.none)       { ret false; }
    ret str_equals(start.name.some, name.some);
}

# the starting section opened, or found where a section of its name took its place, and made current
fun open_start(b: *Builder) res[usize, Refusal] {
    var at: u32 = 0;
    if (sel b.started.some) { at = b.started.some; }
    or {
        if (sel b.start.none) { ret res[usize, Refusal].err{refuse(NO_SECTION)}; }
        val opened: res[Section, Refusal] = open(b, b.start.some);
        if (sel opened.err) { ret res[usize, Refusal].err{opened.err}; }
        at = opened.ok;
    }
    b.started = opt[u32].some{at};
    b.current = opt[usize].some{at::usize};
    ret res[usize, Refusal].ok{at::usize};
}

# the current section's index when `at_cursor` answers it with nothing to open or refuse, none otherwise
pub fun cursor_open(b: *Builder) opt[usize] {
    if (b.finished)         { ret opt[usize].none{}; }
    if (sel b.current.none) { ret opt[usize].none{}; }
    val at: usize = b.current.some;
    if (at == STARTING::usize || at >= RAISED_BASE::usize) { ret opt[usize].none{}; }
    if (sel b.taken.some) {
        if (at < b.taken.some.areas) { ret opt[usize].none{}; }
    }
    ret opt[usize].some{at};
}

# the current section's index, refused before one is switched to. the starting section is opened here, as this is what
# writing to it or placing a label in it asks first
pub fun at_cursor(b: *Builder) res[usize, Refusal] {
    if (b.finished)         { ret res[usize, Refusal].err{refuse(FINISHED)}; }
    if (sel b.current.none) { ret res[usize, Refusal].err{refuse(NO_SECTION)}; }
    if (b.current.some == STARTING::usize) {
        val opened: res[usize, Refusal] = open_start(b);
        if (sel opened.err) { ret opened; }
    }
    if (b.current.some >= RAISED_BASE::usize)                    { ret res[usize, Refusal].err{refuse(RAISED)}; }
    if (sel b.taken.some && b.current.some < b.taken.some.areas) { ret res[usize, Refusal].err{refuse(SEALED)}; }
    ret res[usize, Refusal].ok{b.current.some};
}

# the current section, refused before one is switched to
pub fun here(b: *Builder) res[*Area, Refusal] {
    val at: res[usize, Refusal] = at_cursor(b);
    if (sel at.err) { ret res[*Area, Refusal].err{at.err}; }
    ret res[*Area, Refusal].ok{?b.areas.data[at.ok]};
}
