# how many labels the builder has made, named or not
pub fun label_count(b: *Builder) usize {
    ret b.labels.len;
}

# whether a label is named exactly `name`, by the interner's lookup
pub fun spells(b: *Builder, name: View) bool {
    val opt_known: opt[table.Id[intern.Name]] = find_name(b, name.data::*u8, name.len);
    if (sel opt_known.none) { ret false; }
    ret label_called(b, opt_known.some) != operand.NO_SYMBOL;
}

# the dialect of format `f` for `a`, nil for none
pub fun spoken_of(f: *mink_format.Format, a: *mink_arch.Arch) *dialect.Dialect {
    val opt_dialect_of: opt[*dialect.Dialect] = dialect.of(f, a);
    if (sel opt_dialect_of.some) { ret opt_dialect_of.some; }
    ret nil;
}

# a new label with no name, local until exposed, spelled in the object, when it is a symbol, by the dialect's temporary
# stem and a number, as `.Ltmp0` on elf and `Ltmp0` on mach-o, numbered as `stemmed` numbers
pub fun anonymous(b: *Builder) res[Label, Refusal] {
    if (b.finished)                                  { ret res[Label, Refusal].err{refuse(FINISHED)}; }
    if (!held(vector.push[Mark](?b.labels, Mark{}))) { ret res[Label, Refusal].err{memory()}; }
    ret res[Label, Refusal].ok{(b.labels.len::u32)};
}

# a new label with no name of its own, spelled in the object as `stem` and a number, as risc-v's `.Lpcrel_hi0`: the next number for the stem that no named label spells, in the order such labels are placed
pub fun stemmed(b: *Builder, stem: str) res[Label, Refusal] {
    if (b.finished)                                            { ret res[Label, Refusal].err{refuse(FINISHED)}; }
    if (stem == nil || stem[0] == 0)                           { ret res[Label, Refusal].err{refuse(NO_STEM)}; }
    if (str_len(stem) > syntax.MAX_ANONYMOUS)                  { ret res[Label, Refusal].err{refuse(NO_STEM)}; }
    if (!held(vector.push[Mark](?b.labels, Mark{stem: stem}))) { ret res[Label, Refusal].err{memory()}; }
    ret res[Label, Refusal].ok{(b.labels.len::u32)};
}

# `stem` and `n` in decimal written into `out`, how many bytes
pub fun stem_spelling(stem: str, n: u32, out: *u8) usize {
    var len: usize = 0;
    for (stem[len] != 0) {
        out[len] = stem[len];
        len      = len + 1;
    }
    var digits: [10]u8;
    var count:  usize = 0;
    var m:      u32   = n;
    for {
        digits[count] = '0' + (m % 10)::u8;
        count         = count + 1;
        m             = m / 10;
        if (m == 0) { brk; }
    }
    for (count > 0) {
        count    = count - 1;
        out[len] = digits[count];
        len      = len + 1;
    }
    ret len;
}

# the stem label `m` is spelled by in the object when it has no name of its own: the one it was made with, else the
# dialect's temporary stem, or the anonymous stem of the set's established syntax for a format with no dialect, nil for
# a named label
pub fun stem_for(b: *Builder, m: *Mark) str {
    if (sel m.name.some)  { ret nil; }
    if (m.stem != nil)    { ret m.stem; }
    if (b.dialect != nil) { ret b.dialect.temporary; }
    ret b.set.syntaxes.at[0].anonymous;
}

val NO_PLACE: u32 = 0xFFFF_FFFF;

fun by_order(x: *Order, y: *Order) i64 {
    if (x.section != y.section) {
        if (x.section < y.section) { ret -1; }
        ret 1;
    }
    if (x.fragment != y.fragment) {
        if (x.fragment < y.fragment) { ret -1; }
        ret 1;
    }
    if (x.id < y.id) { ret -1; }
    if (x.id > y.id) { ret 1; }
    ret 0;
}

# every label with no name of its own numbered after its stem: each the next number of its stem that no named label
# spells, in place order, by section, then statement, then the order made, and then the labels never placed in the
# order made. a text that lists the labels in place order, naming some and leaving others to the assembler, so reads
# back to the same numbers
pub fun number_stems(b: *Builder) err[Refusal] {
    var order: vector.Vector[Order]   = vector.init[Order](b.a);
    var stems: vector.Vector[Counter] = vector.init[Counter](b.a);
    if (!held(vector.reserve[Order](?order, b.labels.len))) { ret err[Refusal].err{memory()}; }
    var i: usize = 0;
    for (i < b.labels.len) {
        val m: *Mark = ?b.labels.data[i];
        if (stem_for(b, m) != nil) {
            var at: Order = Order{section: NO_PLACE, fragment: 0, id: (i + 1)::u32};
            if (m.defined) {
                at.section  = m.section;
                at.fragment = m.fragment;
            }
            vector.push[Order](?order, at);
        }
        i = i + 1;
    }
    sort.sort_by[Order](order.data, order.len, by_order);
    var room: [syntax.MAX_ANONYMOUS + 10]u8;
    var ok:   bool = true;
    i = 0;
    for (i < order.len && ok) {
        val m:    *Mark = ?b.labels.data[order.data[i].id::usize - 1];
        val stem: str   = stem_for(b, m);
        var k:    usize = 0;
        for (k < stems.len && !str_equals(stems.data[k].stem, stem)) { k = k + 1; }
        if (k == stems.len) { ok = held(vector.push[Counter](?stems, Counter{stem: stem, next: 0})); }
        if (ok) {
            var next: u32 = stems.data[k].next;
            for (spells(b, View{data: ?room[0], len: stem_spelling(stem, next, ?room[0])})) { next = next + 1; }
            m.number           = next;
            stems.data[k].next = next + 1;
        }
        i = i + 1;
    }
    vector.dnit[Order](?order);
    vector.dnit[Counter](?stems);
    if (!ok) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# a new label placed at the cursor of the current section, which is how a fact is attached to a place: the label is
# the place, and once the layout is settled `place_of` states where it finally lies, after relaxation and compression
pub fun position(b: *Builder) res[Label, Refusal] {
    val res_made: res[Label, Refusal] = anonymous(b);
    if (sel res_made.err) { ret res_made; }
    val err_placed: err[Refusal] = define(b, res_made.ok);
    if (sel err_placed.err) { ret res[Label, Refusal].err{err_placed.err}; }
    ret res_made;
}

# a new label for the start of the next instruction emitted into the current section, which is where a fact about that
# instruction belongs: alignment or data between are not part of it. with `end` set, a section that gets no instruction
# after it places the label at its end, and without it the layout refuses
pub fun next_position(b: *Builder, end: bool) res[Label, Refusal] {
    val res_at_cursor: res[usize, Refusal] = at_cursor(b);
    if (sel res_at_cursor.err)                         { ret res[Label, Refusal].err{res_at_cursor.err}; }
    if (!held(vector.reserve[Waiting](?b.waiting, 1))) { ret res[Label, Refusal].err{memory()}; }
    val res_made: res[Label, Refusal] = anonymous(b);
    if (sel res_made.err) { ret res_made; }
    vector.push[Waiting](?b.waiting, Waiting{label: res_made.ok, section: res_at_cursor.ok::u32, end: end});
    ret res_made;
}

# the places waiting in section `s` placed at fragment `at`
pub fun bind_waiting(b: *Builder, s: u32, at: u32) {
    var kept: usize = 0;
    var i:    usize = 0;
    for (i < b.waiting.len) {
        val w: Waiting = b.waiting.data[i];
        if (w.section == s) {
            put_at(b, ?b.labels.data[w.label::usize - 1], s, at);
        }
        or {
            b.waiting.data[kept] = w;
            kept                 = kept + 1;
        }
        i = i + 1;
    }
    vector.truncate[Waiting](?b.waiting, kept);
}

# the places still waiting settled: those allowed to end the section are placed at its end, and one that is not is refused.
# they keep waiting, so a layout that is not the last is undone by emitting more, which binds them to what follows
pub fun settle_waiting(b: *Builder) err[Refusal] {
    var i: usize = 0;
    for (i < b.waiting.len) {
        if (!b.waiting.data[i].end) { ret about(NO_INSTRUCTION, b.waiting.data[i].label); }
        i = i + 1;
    }
    i = 0;
    for (i < b.waiting.len) {
        val w: Waiting = b.waiting.data[i];
        put_at(b, ?b.labels.data[w.label::usize - 1], w.section, b.areas.data[w.section::usize].fragments.len::u32);
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# `w` added to what writes after the layout is settled, run once by `finish`
pub fun writer(b: *Builder, w: Writer) err[Refusal] {
    if (b.finished)                                { ret refused(FINISHED); }
    if (!held(vector.push[Writer](?b.writers, w))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# a source file the object names, stated as a local symbol of the source kind, as an ELF `STT_FILE` symbol. it is no
# label, so its name is not one that a label can be found by
pub fun source(b: *Builder, name: View) err[Refusal] {
    if (b.finished)                                                  { ret refused(FINISHED); }
    if (name.len == 0)                                               { ret refused(NAMELESS); }
    if (!held(vector.reserve[table.Id[intern.Name]](?b.sources, 1))) { ret err[Refusal].err{memory()}; }
    val res_name_bytes: res[table.Id[intern.Name], Refusal] = name_bytes(b, name.data::*u8, name.len);
    if (sel res_name_bytes.err) { ret err[Refusal].err{res_name_bytes.err}; }
    vector.push[table.Id[intern.Name]](?b.sources, res_name_bytes.ok);
    ret err[Refusal].ok{};
}

# the label named `name`, made local when it is new
pub fun label(b: *Builder, name: str) res[Label, Refusal] {
    ret label_bytes(b, name::*u8, str_len(name));
}

# the label named by the `n` bytes at `p`, made local when it is new
pub fun label_bytes(b: *Builder, p: *u8, n: usize) res[Label, Refusal] {
    if (b.finished) { ret res[Label, Refusal].err{refuse(FINISHED)}; }
    val res_name_bytes: res[table.Id[intern.Name], Refusal] = name_bytes(b, p, n);
    if (sel res_name_bytes.err) { ret res[Label, Refusal].err{res_name_bytes.err}; }
    ret label_of(b, res_name_bytes.ok);
}

# the label named by `id`, a name of the builder's object, made local when it is new, as a caller that interned the
# name in the object (`init_named`, `output`) hands the builder its handle. a handle the object holds no name of is
# refused
pub fun label_of(b: *Builder, id: table.Id[intern.Name]) res[Label, Refusal] {
    if (b.finished)                                    { ret res[Label, Refusal].err{refuse(FINISHED)}; }
    if (id.index::usize >= intern.count(?b.out.names)) { ret res[Label, Refusal].err{refuse(NO_SUCH)}; }
    val slot: u32 = label_called(b, id);
    if (slot != operand.NO_SYMBOL)                                                            { ret res[Label, Refusal].ok{slot}; }
    if (!slotted(b, id.index::usize + 1))                                                     { ret res[Label, Refusal].err{memory()}; }
    if (!held(vector.push[Mark](?b.labels, Mark{name: opt[table.Id[intern.Name]].some{id}}))) { ret res[Label, Refusal].err{memory()}; }
    b.named.data[id.index::usize] = b.labels.len::u32;
    ret res[Label, Refusal].ok{(b.labels.len::u32)};
}

# whether `l` existed when the layout was settled, so a writer running now may not restate it
fun sealed_label(b: *Builder, l: Label) bool {
    ret sel b.taken.some && l::usize <= b.taken.some.labels;
}

# whether `l` is spelled in the object in the private spelling of the builder's dialect, as elf's `.L`, which no
# assembler makes a local symbol of, so it is a symbol only with a binding other objects see
pub fun private_label(b: *Builder, l: Label) bool {
    if (b.dialect == nil) { ret false; }
    val opt_mark_of: opt[*Mark] = mark_of(b, l);
    if (sel opt_mark_of.none) { ret false; }
    val prefix: str = b.dialect.private;
    if (sel opt_mark_of.some.name.some) { ret leads(name_at(b, opt_mark_of.some.name.some), prefix); }
    val stem: str = stem_for(b, opt_mark_of.some);
    ret leads(View{data: stem::*u8, len: str_len(stem)}, prefix);
}

# whether `v` starts with `prefix`, which is not empty
fun leads(v: View, prefix: str) bool {
    val n: usize = str_len(prefix);
    if (n == 0 || v.len < n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# make `l` a symbol of the object, or restate how it is one. a local symbol of a label in the private spelling is
# refused, since the text that states it makes none: a private label is local by being no symbol
pub fun expose(b: *Builder, l: Label, e: Exposure) err[Refusal] {
    if (b.finished) { ret refused(FINISHED); }
    val opt_mark_of: opt[*Mark] = mark_of(b, l);
    if (sel opt_mark_of.none)                                   { ret refused(NO_SUCH); }
    if (sealed_label(b, l))                                     { ret refused(SEALED); }
    if (e.binding == ?mink_symbol.LOCAL && private_label(b, l)) { ret about(PRIVATE_LOCAL, l); }
    opt_mark_of.some.exposure = opt[Exposure].some{e};
    ret err[Refusal].ok{};
}

# place `l` at the cursor of the current section
pub fun define(b: *Builder, l: Label) err[Refusal] {
    val res_at_cursor: res[usize, Refusal] = at_cursor(b);
    if (sel res_at_cursor.err) { ret err[Refusal].err{res_at_cursor.err}; }
    val opt_mark_of: opt[*Mark] = mark_of(b, l);
    if (sel opt_mark_of.none)                                        { ret refused(NO_SUCH); }
    if (sealed_label(b, l))                                          { ret refused(SEALED); }
    if (opt_mark_of.some.defined || sel opt_mark_of.some.value.some) { ret about(REDEFINED, l); }
    put_at(b, opt_mark_of.some, res_at_cursor.ok::u32, b.areas.data[res_at_cursor.ok].fragments.len::u32);
    b.defined = opt[Label].some{l};
    if (!starts_copy(b, opt_mark_of.some, ?b.areas.data[res_at_cursor.ok])) { ret err[Refusal].ok{}; }
    ret starts_beside(b, res_at_cursor.ok);
}

# label `m`, just placed in `area`, made the start the section awaits: of an atom of the copy (`section.copy`), or of
# an item (`section.begin_item`), a symbol of its own when it is none, local to the object, so the format names what it
# starts by it and a format whose files are cut at their symbols cuts the section at it. a label in the private
# spelling is no symbol, as the text that states it makes none, so true when the start needs a label of its own beside
# it (`starts_beside`)
fun starts_copy(b: *Builder, m: *Mark, area: *Area) bool {
    val opt_copying: opt[u32] = area.copying;
    var stem:        str      = ITEM_STEM;
    if (sel opt_copying.some) {
        area.copying = opt[u32].none{};
        m.copy       = opt_copying;
        stem         = COPY_STEM;
    }
    or (area.starting) { area.starting = false; }
    or                 { ret false; }
    val exposed: bool = sel m.exposure.some;
    if (exposed) { ret false; }
    val opt_name: opt[table.Id[intern.Name]] = m.name;
    if (sel opt_name.some) {
        if (b.dialect != nil && leads(name_at(b, opt_name.some), b.dialect.private)) { ret true; }
    }
    m.exposure = opt[Exposure].some{local_exposure()};
    if (sel opt_name.none) { m.stem = stem; }
    ret false;
}

# a label of the item stem placed at the cursor of section `s`, after the label in the private spelling just placed
# there, a local symbol that starts the item in its place
fun starts_beside(b: *Builder, s: usize) err[Refusal] {
    val res_made: res[Label, Refusal] = stemmed(b, ITEM_STEM);
    if (sel res_made.err) { ret err[Refusal].err{res_made.err}; }
    val m: *Mark = ?b.labels.data[res_made.ok::usize - 1];
    m.exposure = opt[Exposure].some{local_exposure()};
    put_at(b, m, s::u32, b.areas.data[s].fragments.len::u32);
    ret err[Refusal].ok{};
}

# a local symbol's exposure, of no kind or size
fun local_exposure() Exposure {
    ret Exposure{binding: ?mink_symbol.LOCAL, visibility: ?mink_symbol.DEFAULT, kind: ?mink_symbol.NOTYPE, size: Size.none{}};
}

# the stems of the symbols that start a copy's atoms and an item's where no label of the source names one, which
# mach-o's linkers keep as atom boundaries, as they do llvm's `ltmp`
val COPY_STEM: str = "lcopy";
val ITEM_STEM: str = "litem";

# label `m` placed before fragment `fragment` of section `s`, after every label placed so far
fun put_at(b: *Builder, m: *Mark, s: u32, fragment: u32) {
    m.defined  = true;
    m.section  = s;
    m.fragment = fragment;
    m.order    = b.placings;
    b.placings = b.placings + 1;
}

# the label placed last when it is at the cursor of the current section, nothing written after it, as a function's
# label is where `.cfi_startproc` begins its frame. none when no label is there
pub fun placed_here(b: *Builder) opt[Label] {
    if (sel b.defined.none) { ret opt[Label].none{}; }
    val res_at_cursor: res[usize, Refusal] = at_cursor(b);
    if (sel res_at_cursor.err) { ret opt[Label].none{}; }
    val m: *Mark = ?b.labels.data[b.defined.some::usize - 1];
    if (m.section != res_at_cursor.ok::u32 || m.fragment != b.areas.data[res_at_cursor.ok].fragments.len::u32) { ret opt[Label].none{}; }
    ret b.defined;
}

# whether `l` is placed or given a value
# whether `l` starts an atom of a copy, where the dialect holds copies as atoms (`section.copy`)
pub fun starts_atom_of_copy(b: *Builder, l: Label) bool {
    val opt_mark: opt[*Mark] = mark_of(b, l);
    if (sel opt_mark.none) { ret false; }
    ret sel opt_mark.some.copy.some;
}

pub fun bound(b: *Builder, l: Label) bool {
    val opt_mark_of: opt[*Mark] = mark_of(b, l);
    if (sel opt_mark_of.none) { ret false; }
    ret opt_mark_of.some.defined || sel opt_mark_of.some.value.some;
}

# `l` given the value `v` in place of a place, refused for a label placed or given one already
fun valued(b: *Builder, l: Label, v: Value) err[Refusal] {
    if (b.finished) { ret refused(FINISHED); }
    val opt_mark_of: opt[*Mark] = mark_of(b, l);
    if (sel opt_mark_of.none)                                        { ret refused(NO_SUCH); }
    if (sealed_label(b, l))                                          { ret refused(SEALED); }
    if (opt_mark_of.some.defined || sel opt_mark_of.some.value.some) { ret about(REDEFINED, l); }
    opt_mark_of.some.value = opt[Value].some{v};
    ret err[Refusal].ok{};
}

# `l` made the number `value`, as `.set` makes a symbol of a constant
pub fun absolute(b: *Builder, l: Label, value: u64) err[Refusal] {
    ret valued(b, l, Value.absolute{value});
}

# `l` made common storage of `size` bytes at a boundary of `align`, a power of two, which the linker allocates. the
# label must be exposed with a binding other objects see by the time the builder finishes
pub fun common(b: *Builder, l: Label, size: u64, align: u64) err[Refusal] {
    if (align == 0 || (align & (align - 1)) != 0) { ret refused(BOUNDARY); }
    ret valued(b, l, Value.common{mink_object.Common{size: size, align: align}});
}

# `l` made to stand for `target` plus `addend`, wherever `target` comes to be
pub fun equate(b: *Builder, l: Label, target: Label, addend: i64) err[Refusal] {
    if (!names_label(b, target)) { ret refused(NOT_A_LABEL); }
    if (target == l)             { ret about(CYCLE, l); }
    ret valued(b, l, Value.equate{Equate{target: target, addend: addend}});
}

# `l` made a weak external that `target` defines when the link defines it no other way, searched for as `search` states
pub fun fall_back(b: *Builder, l: Label, target: Label, search: *mink_symbol.Search) err[Refusal] {
    if (!names_label(b, target)) { ret refused(NOT_A_LABEL); }
    if (target == l)             { ret about(CYCLE, l); }
    ret valued(b, l, Value.fallback{Fallback{target: target, search: search, moved: false}});
}

# `thunk` stated as the thunk that bridges `symbol` as `role`, as an arm64ec entry thunk bridges the function it enters.
# each label is made a symbol of the object in its own right when the object is handed over, so each must be placed,
# given a value or exposed by then
pub fun bridge(b: *Builder, symbol: Label, thunk: Label, role: *mink_bridge.Role) err[Refusal] {
    if (b.finished)                                                                                 { ret refused(FINISHED); }
    if (!names_label(b, symbol) || !names_label(b, thunk))                                          { ret refused(NOT_A_LABEL); }
    if (!held(vector.push[Bridged](?b.bridges, Bridged{symbol: symbol, thunk: thunk, role: role}))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# how many bridges the builder was given
pub fun bridge_count(b: *Builder) usize {
    ret b.bridges.len;
}

# the `k`-th bridge, in the order given
pub fun bridge_at(b: *Builder, k: usize) Bridged {
    ret b.bridges.data[k];
}

# the text `.weak.<name>.default.<object>` of the name `id` in `out`, `<object>` the builder's object's name, the label a
# coff weak symbol's definition moves to. the definition must be an external symbol (pe format, auxiliary format 3:
# weak externals), so it is named apart from every other object's by the one thing each object of a link holds alone
fun default_name(b: *Builder, id: table.Id[intern.Name], out: *vector.Vector[u8]) bool {
    val name: View = name_at(b, id);
    val head: str  = ".weak.";
    val tail: str  = ".default.";
    var ok:   bool = held(vector.reserve[u8](out, str_len(head) + name.len + str_len(tail) + b.called.len));
    ok = ok && put_text(out, head);
    ok = ok && put_bytes(out, name.data, name.len);
    ok = ok && put_text(out, tail);
    ret ok && put_bytes(out, b.called.data, b.called.len);
}

fun put_text(out: *vector.Vector[u8], s: str) bool {
    ret put_bytes(out, s::*u8, str_len(s));
}

fun put_bytes(out: *vector.Vector[u8], p: *u8, n: usize) bool {
    var k: usize = 0;
    for (k < n) {
        if (!held(vector.push[u8](out, p[k]))) { ret false; }
        k = k + 1;
    }
    ret true;
}

# `l`, a weak symbol named `name` with no fallback, made a weak external searched for as `search` whose fallback is
# its own definition, moved to a global label named by `default_name`. the definition is the place, the value, or
# absolute zero for a label never defined. common storage is left as it is. an object given no name is refused
fun weak_default(b: *Builder, l: Label, name: table.Id[intern.Name], search: *mink_symbol.Search) err[Refusal] {
    if (b.finished) { ret refused(FINISHED); }
    val opt_mark_of: opt[*Mark] = mark_of(b, l);
    if (sel opt_mark_of.none)                                                      { ret refused(NO_SUCH); }
    if (sealed_label(b, l))                                                        { ret refused(SEALED); }
    if (sel opt_mark_of.some.value.some && sel opt_mark_of.some.value.some.common) { ret err[Refusal].ok{}; }
    if (b.called.len == 0)                                                         { ret about(UNNAMED, l); }
    var text:  vector.Vector[u8] = vector.init[u8](b.a);
    val spelt: bool              = default_name(b, name, ?text);
    if (!spelt) {
        vector.dnit[u8](?text);
        ret err[Refusal].err{memory()};
    }
    val res_made: res[Label, Refusal] = label_bytes(b, text.data, text.len);
    vector.dnit[u8](?text);
    if (sel res_made.err) { ret err[Refusal].err{res_made.err}; }
    # the label vector may have moved
    val from: *Mark = ?b.labels.data[l::usize - 1];
    val to:   *Mark = ?b.labels.data[res_made.ok::usize - 1];
    if (to.defined || sel to.value.some) { ret about(REDEFINED, res_made.ok); }
    to.defined  = from.defined;
    to.section  = from.section;
    to.fragment = from.fragment;
    to.order    = from.order;
    to.value    = from.value;
    if (!from.defined && sel from.value.none) { to.value = opt[Value].some{Value.absolute{0}}; }
    var exposure:  Exposure      = Exposure{binding: ?mink_symbol.GLOBAL, visibility: ?mink_symbol.DEFAULT, kind: ?mink_symbol.NOTYPE, size: Size.none{}};
    val opt_shown: opt[Exposure] = from.exposure;
    if (sel opt_shown.some) {
        var kept: Exposure = opt_shown.some;
        exposure.kind = kept.kind;
        exposure.size = kept.size;
        kept.size     = Size.none{};
        from.exposure = opt[Exposure].some{kept};
    }
    to.exposure   = opt[Exposure].some{exposure};
    from.defined  = false;
    from.section  = 0;
    from.fragment = 0;
    from.order    = 0;
    from.value    = opt[Value].some{Value.fallback{Fallback{target: res_made.ok, search: search, moved: true}}};
    ret err[Refusal].ok{};
}

# every exposed weak label with no value of its own, none common, made a weak external with its definition moved by
# `weak_default` when the dialect states a search for a bare weak symbol, each as it was kept in `moved`. a label the
# source gave an equate or a fallback is left as it is
pub fun weaken(b: *Builder, moved: *vector.Vector[Moved]) err[Refusal] {
    if (b.dialect == nil || b.dialect.weak == nil) { ret err[Refusal].ok{}; }
    val count: usize = b.labels.len;
    var i:     usize = 0;
    for (i < count) {
        val m: *Mark = ?b.labels.data[i];
        i = i + 1;
        if (!sel m.exposure.some || sel m.value.some) { cnt; }
        val opt_named: opt[table.Id[intern.Name]] = m.name;
        if (sel opt_named.none) { cnt; }
        val opt_shown: opt[Exposure] = m.exposure;
        if (sel opt_shown.some) {
            if (opt_shown.some.binding != ?mink_symbol.WEAKLY) { cnt; }
        }
        if (!held(vector.push[Moved](moved, Moved{id: i::u32, mark: @m}))) { ret err[Refusal].err{memory()}; }
        val err_done: err[Refusal] = weak_default(b, (i::u32), opt_named.some, b.dialect.weak);
        if (sel err_done.err) { ret err_done; }
    }
    ret err[Refusal].ok{};
}

# the labels `weaken` moved put back as they were
pub fun unweaken(b: *Builder, moved: *vector.Vector[Moved]) {
    var i: usize = 0;
    for (i < moved.len) {
        b.labels.data[moved.data[i].id::usize - 1] = moved.data[i].mark;
        i                                          = i + 1;
    }
}

# the relocation `d` stated by itself in the current section
pub fun relocate(b: *Builder, d: Direct) err[Refusal] {
    if (b.finished) { ret refused(FINISHED); }
    val res_at_cursor: res[usize, Refusal] = at_cursor(b);
    if (sel res_at_cursor.err)                               { ret err[Refusal].err{res_at_cursor.err}; }
    if (sel d.at.some && !names_label(b, d.at.some))         { ret refused(NOT_A_LABEL); }
    if (sel d.target.some && !names_label(b, d.target.some)) { ret refused(NOT_A_LABEL); }
    if (sel b.relocs.err)                                    { ret err[Refusal].err{failed(b.relocs.err)}; }
    val res_row: res[*mink_row.Row, fail.Fail] = registry.relocation_by_kind(?b.relocs.ok, d.kind);
    if (sel res_row.err) { ret err[Refusal].err{failed(res_row.err)}; }
    val err_takes: err[fail.Fail] = reloc.allows_target(d.kind, sel d.target.none);
    if (sel err_takes.err) { ret err[Refusal].err{failed(err_takes.err)}; }
    var placed: Direct = d;
    placed.section = res_at_cursor.ok::u32;
    if (!held(vector.push[Direct](?b.direct, placed))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# a relocation of the set's fixup kind `fixup` at the cursor of the current section, naming `target`, as aarch64's
# `.tlsdesccall` marks the blr after it: a marker no bits hold, at the cursor, before any alignment between, and kept as `relocate` keeps one stated by itself, so one past every byte of its section is refused
pub fun mark(b: *Builder, fixup: operand.FixupKind, target: Label) err[Refusal] {
    val kind: *reloc.Kind = kind_of(b, fixup);
    if (kind == nil) { ret refused(UNBOUND); }
    val res_position: res[Label, Refusal] = position(b);
    if (sel res_position.err) { ret err[Refusal].err{res_position.err}; }
    ret relocate(b, Direct{at: opt[Label].some{res_position.ok}, offset: 0, kind: kind, target: opt[Label].some{target}, addend: 0});
}

# how many relocations were stated by themselves (`relocate`)
pub fun direct_count(b: *Builder) usize {
    ret b.direct.len;
}

# the `k`-th relocation stated by itself, its section the one it was stated in
pub fun direct_at(b: *Builder, k: usize) Direct {
    ret b.direct.data[k];
}

# the name the object's format gives relocation kind `kind` for the architecture, the one `relocation_named` reads,
# none for a kind it maps no row to
pub fun relocation_name(b: *Builder, kind: *reloc.Kind) opt[str] {
    if (sel b.relocs.err) { ret opt[str].none{}; }
    val res_row: res[*mink_row.Row, fail.Fail] = registry.relocation_by_kind(?b.relocs.ok, kind);
    if (sel res_row.err) { ret opt[str].none{}; }
    ret opt[str].some{res_row.ok.name};
}

# the relocation kind the object's format names `name` for the architecture, as elf's `R_RISCV_32`, none when no row
# of its is so named
pub fun relocation_named(b: *Builder, name: View) opt[*reloc.Kind] {
    if (sel b.relocs.err) { ret opt[*reloc.Kind].none{}; }
    val l: *mink_row.Lookup = b.relocs.ok.rows;
    val n: usize            = l.key_count;
    var i: usize            = 0;
    for (i < n) {
        val r: *mink_row.Row = mink_row.row_at(l, l.keys[i]);
        i = i + 1;
        if (str_len(r.name) == name.len && store.same_bytes(store.Bytes{data: r.name, len: name.len}, store.Bytes{data: name.data, len: name.len})) { ret opt[*reloc.Kind].some{r.kind}; }
    }
    ret opt[*reloc.Kind].none{};
}
