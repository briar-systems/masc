# the builder's state: its sections, fragments, labels and records, and the reads every part of it shares

use masc.core.field;
use masc.core.fill;
use core_fixup: masc.core.fixup;
use core_form:  masc.core.form;
use masc.core.index;
use masc.core.inst;
use masc.core.mode;
use masc.core.operand;
use masc.core.relax;
use masc.core.row;
use masc.core.set;
use core_source: masc.core.source;
use core_state:  masc.core.state;
use masc.core.stating;
use masc.core.syntax;
use masc.format.dialect;
use mink.base.fail;
use mink.base.intern;
use mink.base.table;
use mink_arch:   mink.catalog.arch;
use mink_format: mink.catalog.format;
use mink_trait:  mink.catalog.trait;
use mink.format.contract;
use mink_pair: mink.format.pair;
use mink.format.registry;
use mink.model.bridge;
use mink.model.frame;
use mink_group:  mink.model.group;
use mink_object: mink.model.object;
use mink.model.reloc;
use mink_section: mink.model.section;
use mink_symbol:  mink.model.symbol;
use A:            std.allocator;
use std.collections.vector;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use masc.build.refusal.Refusal;
use masc.build.refusal.failed;
use masc.build.refusal.held;
use masc.build.refusal.memory;

# a section of the builder, by its index, which is also its index in the finished object
pub rec Section {
    index: u32;
}

# a label, its id the symbol handle a symbolic operand carries, never operand.NO_SYMBOL
pub rec Label {
    id: u32;
}

# what a new section is
# ---
# name:        its name, none for a section of its kind alone, which the format names when it writes it and which is
#              re-entered by the handle `open` returns, never by a name
# kind:        the role it plays
# flags:       the flags it carries, its kind's or more
# disposition: how garbage collection treats it
# entsize:     the size of each entry of a section of entries, as strings to merge, 0 for none
# apart:       whether a named section is kept apart from the others of its name, never found by it and re-entered by
#              the handle `open` returns, as a nameless one is
pub rec Spec {
    name:        opt[str];
    kind:        *mink_section.Kind;
    flags:       mink_section.Flags;
    disposition: *mink_section.Disposition;
    entsize:     u64;
    apart:       bool;
}

# what makes a label a symbol of the object
# ---
# binding:    how far it is visible across objects
# visibility: how far it is visible across images
# kind:       what it names
# size:       its size
pub rec Exposure {
    binding:    *mink_symbol.Binding;
    visibility: *mink_symbol.Visibility;
    kind:       *mink_symbol.Kind;
    size:       Size;
}

# the difference of two labels plus an addend, measured once laid out
# ---
# plus:   the label added
# minus:  the label subtracted
# addend: the constant added
pub rec Difference {
    plus:   Label;
    minus:  Label;
    addend: i64;
}

# a symbol's size
# ---
# none:     no size is stated
# fixed:    this many bytes
# measured: the distance between two labels of one section, as `.size f, . - f` states it
pub tag Size: u8 {
    none;
    fixed:    u64;
    measured: Difference;
}

# an alignment
# ---
# boundary: the alignment in bytes, a power of two
# fill:     the byte it pads with, absent for the section's own: the set's code fill in code, zeros elsewhere. it is the
#           padding of alignment masc lays out as asked. code alignment the linker realigns is padded with the set's
#           nops under its realign marker whatever the fill, and `realigned_all` lists which those are
# max:      the most bytes it pads, absent for no limit. a gap past it is not padded
pub rec Align {
    boundary: u64;
    fill:     opt[u8];
    max:      opt[u64];
}

# a symbol's address or distance as data
# ---
# target: the label it refers to
# addend: added to the label's value
# width:  its width in bytes
# basis:  what its value is measured from
# kind:   the fixup kind it is relocated by, operand.NO_FIXUP for its basis's and width's own: a kind a specifier of the
#         set's spells on a datum of that basis and width under the object's format, as x86's `@DTPOFF` on a 32-bit
#         datum is a thread-local variable's offset in its module's block
pub rec Reference {
    target: Label;
    addend: i64;
    width:  u8;
    basis:  core_fixup.Basis;
    kind:   operand.FixupKind;
}

# an instruction stated by a format of the source dialect's instruction directive (`core_source.Insns`), as risc-v's
# `.insn r 0x33, 0, 0, a0, a1, a2`
# ---
# format: the format
# inst:   the format's row and the values given it
pub rec Formatted {
    format: *core_source.Format;
    inst:   inst.Inst;
}

# what an instruction was encoded from
# ---
# instruction: a row of the set's catalog and its values
# format:      a format and its values, whose row is no row of the catalog: the builder encodes, folds and relocates it as
#              it does a catalog row, and never compresses or relaxes it, so nothing that indexes the catalog reaches it
pub tag Encoded: u8 {
    instruction: inst.Inst;
    format:      Formatted;
}

# one encoded instruction of the finished object, as relaxation grew and the layout folded it
# ---
# section: the section it is in
# offset:  where it starts
# length:  how many bytes it is
# encoded: what it was encoded from
# run:     how many lines from this one its sequence wrote: 1 for an instruction written alone, however its form grew,
#          the sequence's lines for the first of a sequence, and 0 for a later line of one
pub rec Line {
    section: Section;
    offset:  u64;
    length:  u64;
    encoded: Encoded;
    run:     u32;
}

# an alignment the linker realigns, as the layout placed it
# ---
# section: the section it is in
# offset:  where its padding starts
# length:  how many bytes of padding it holds, its worst case
# fill:    the fill byte it was asked for, which its padding does not use
pub rec Realigned {
    section: Section;
    offset:  u64;
    length:  u64;
    fill:    opt[u8];
}

# the alignments the linker realigns
# ---
# at:  the first row, nil for none
# len: how many rows
pub rec Realignments {
    at:  *Realigned;
    len: usize;
}

# what an instruction fragment is written as
# ---
# catalog: a row of the set's catalog, as emitted
# format:  a format of the source dialect's instruction directive
pub tag Coded: u8 {
    catalog: *row.Row;
    format:  *core_source.Format;
}

# the row `of` is encoded by
pub fun coded(of: *Coded) *row.Row {
    if (sel of.format) { ret of.format.row; }
    ret of.catalog;
}

# an instruction fragment
# ---
# of:       what it is written as
# values:   its values' first slot in the builder's values
# count:    how many values
# members:  its list members' first slot in the builder's members
# literals: its literal bytes' first byte in the builder's literals
# marker:   the marker fixup kind riding beside it as written, operand.NO_FIXUP for none
# marked:   whether an instruction of its current form carries a marker, as the jal of a grown branch under relax, so
#           the linker may resize it
# form:     the encoding form it is written in, which its grown forms do not carry
# relax:    its row's relaxation, none for a row with no longer form
# initial:  its length as emitted, with every symbol encoded as zero
# depth:    how many relaxations it has grown by
# run:      how many instructions its sequence holds from it, 1 for one written alone and 0 past a sequence's first
pub rec Code {
    of:       Coded;
    values:   usize;
    count:    u32;
    members:  usize;
    literals: usize;
    marker:   operand.FixupKind;
    marked:   bool;
    form:     core_form.Form;
    relax:    opt[*relax.Relaxation];
    initial:  u64;
    depth:    u32;
    run:      u32;
}

# bytes of the builder's data store
pub rec Span {
    start: usize;
    len:   usize;
}

# a datum fragment
# ---
# fixup: the set-local fixup kind its basis and width take
# ref:   what it refers to
pub rec Datum {
    fixup: operand.FixupKind;
    ref:   Reference;
}

# a difference fragment, a value the layout settles
# ---
# of:       the difference it holds
# width:    its width in bytes, 0 for a leb128, whose length is its fragment's size
# encoding: how it is written
pub rec Gap {
    of:       Difference;
    width:    u8;
    encoding: core_fixup.Encoding;
}

# what a fragment is
pub tag Body: u8 {
    code:       Code;
    data:       Span;
    zero:       u64;
    align:      Align;
    datum:      Datum;
    difference: Gap;
}

# a fragment and where the current pass places it
# ---
# view:   the context it was written under, which admits, encodes, relaxes and fills it
# syntax: the index of the set's syntax it was written in
# modes:  the assembler modes it was written under, by their index among the builder's mode states
pub rec Fragment {
    body:   Body;
    offset: u64;
    size:   u64;
    view:   *core_state.Context;
    syntax: u32;
    modes:  u32;
}

# a section's state
# ---
# name:        its name in the builder's names, none for a nameless section
# kind:        the role it plays
# flags:       the flags it carries
# disposition: how garbage collection treats it
# entsize:     the size of each of its entries, 0 for none
# align:       the largest alignment asked of it, 1 for none
# bits:        whether it holds bytes, from its kind's roles
# code:        whether it holds code, from its flags
# fragments:   its fragments in order, its cursor their end
# marks:       per fragment, how many marked instructions come before it, so a span's markers are one subtraction
# size:        its length in the current pass
# bytes:       its encoded bytes once finished
# symbol:      the object's symbol for the section, made when a relocation needs it
# group:       the signature of the comdat group it is in, none for a section in none
# rule:        the rule its group keeps a copy by, the associative rule for a section kept with its owner, nil for a
#              section in none
# owner:       the index of the section it is ordered after when linked, none for a section of no link order, and for
#              an associative section the leader it is kept with
pub rec Area {
    name:        opt[table.Id[intern.Name]];
    kind:        *mink_section.Kind;
    flags:       mink_section.Flags;
    disposition: *mink_section.Disposition;
    entsize:     u64;
    align:       u64;
    bits:        bool;
    code:        bool;
    fragments:   vector.Vector[Fragment];
    marks:       vector.Vector[u32];
    size:        u64;
    bytes:       vector.Vector[u8];
    symbol:      opt[table.Id[mink_object.Symbol]];
    group:       opt[table.Id[intern.Name]];
    rule:        *mink_group.Rule;
    owner:       opt[u32];
}

# another label plus an addend, which a label stands for
pub rec Equate {
    target: u32;
    addend: i64;
}

# the label that defines a weak external when nothing else does, and how the link looks for a definition before it
# stands in, as a coff weak external's record names its target and its search characteristic
# ---
# target: the label that stands in, a symbol of the object in its own right
# search: how the link searches first, as mink's anti-dependency, which binds an arm64ec function's plain name to its
#         `#name` definition unless a definition of the plain name is linked
pub rec Fallback {
    target: u32;
    search: *mink_symbol.Search;
}

# the thunk that bridges a symbol between the two conventions of an image holding code of two, as an arm64ec object
# pairs a function with its entry thunk, each label a symbol of the object in its own right
# ---
# symbol: the label the thunk serves: the function an entry thunk enters, or the callee an exit thunk leaves for
# thunk:  the thunk's label
# role:   what the thunk is to the symbol, a row of mink's bridge roles
pub rec Bridged {
    symbol: Label;
    thunk:  Label;
    role:   *bridge.Role;
}

# a label's value when it is not placed
# ---
# absolute: this number
# common:   common storage of a size and an alignment, which the linker allocates
# equate:   another label plus an addend, as `.set alias, f + 4` makes one
# fallback: whatever the link defines it as, else another label, as `.weak_anti_dep f` with `.set f, "#f"` makes one
pub tag Value: u8 {
    absolute: u64;
    common:   mink_object.Common;
    equate:   Equate;
    fallback: Fallback;
}

# a label's state
# ---
# name:     its name in the builder's names, none for an anonymous label
# stem:     the stem an unnamed label was made with, its number following in the object, nil for the stem `stem_for`
#           gives a label made anonymous
# number:   that number, by place among the labels of its stem, skipping those named labels spell, once finished
# exposure: what makes it a symbol, none for a local label
# defined:  whether it is placed
# section:  the section it is placed in
# fragment: the fragment it precedes, the section's fragment count for its end
# order:    when it was placed among every label placed, which orders the labels placed before one fragment
# value:    what it is when it is not placed, none for a label placed or never given one
# size:     its size once finished, from its exposure
# symbol:   the object's symbol for it, once finished
# thread:   whether a thread-local relocation names it, once finished
pub rec Mark {
    name:     opt[table.Id[intern.Name]];
    stem:     str;
    number:   u32;
    exposure: opt[Exposure];
    defined:  bool;
    section:  u32;
    fragment: u32;
    order:    u32;
    value:    opt[Value];
    size:     opt[u64];
    symbol:   opt[table.Id[mink_object.Symbol]];
    thread:   bool;
}

# what a relocation names
# ---
# label:   a label
# nothing: nothing, for a marker
pub tag Aim: u8 {
    label: u32;
    nothing;
}

# a place waiting for the next instruction of a section
# ---
# label:   the label the place becomes
# section: the section
# end:     whether the section's end is the place when no instruction follows
pub rec Waiting {
    label:   u32;
    section: u32;
    end:     bool;
}

# the length of everything a writer can only append to, so taking its output back is truncation
# ---
# areas:    the sections
# labels:   the labels
# values:   the operand values of every instruction
# members:  the members of every list value
# literals: the bytes of every literal value
# data:     the bytes of every data fragment
# waiting:  the places waiting for an instruction
# names:    the names interned
# sources:  the source files stated
# realigns: the alignments the linker realigns
# current:  the current section
# started:  where the starting section was opened, none while it is not
# view:     the context what is emitted next is written under
# syntax:   the syntax what is emitted next is written in
# modes:    the assembler modes
# states:   the mode states recorded
# state:    the index of the modes among them
# told:     the facts instructions stated
pub rec Snapshot {
    areas:    usize;
    labels:   usize;
    values:   usize;
    members:  usize;
    literals: usize;
    data:     usize;
    waiting:  usize;
    names:    usize;
    sources:  usize;
    realigns: usize;
    current:  opt[usize];
    started:  opt[u32];
    view:     *core_state.Context;
    syntax:   u32;
    modes:    mode.State;
    states:   usize;
    state:    u32;
    told:     usize;
}

# something that writes more of the object once the layout of the rest is settled, from the final places of what facts
# were attached to, as the line records are
# ---
# name:    what it writes
# context: its state, which the caller owns and keeps until the builder is released
# write:   what it writes into the builder, nil for nothing, only into sections and labels it opens itself: what existed
#          when the layout was settled has its addresses fixed, so a writer that adds to a section or restates a label of
#          those is refused
# record:  what it states on the object once the object is made from the final layout, nil for nothing, as records of
#          mink's model at the places `place_of` reads. the builder is closed while it runs, as a finished one is, so
#          nothing it does can change what the object was made from
#
# a finish is all or none: when a writer, the layout after them, the encode or a record fails, everything every writer
# added is taken back and the object with every record on it is released, so a writer is run again from a clean state
# and need not be idempotent
pub rec Writer {
    name:    str;
    context: ptr;
    write:   fun(ptr, *Builder) err[Refusal];
    record:  fun(ptr, *Builder, *mink_object.Object) err[Refusal];
}

# a relocation stated by itself, as `.reloc offset, name, target` states one, which the object
# keeps as stated, its place encoded as the statements around it encode it: the builder folds it into no field and it
# changes no layout
# ---
# section: the section it patches
# at:      the label its place is at, none for the section's start
# offset:  its place past that
# kind:    what it computes
# target:  the label it names, none for nothing, as a marker names nothing
# addend:  its addend
# place:   its offset in its section, once finished
pub rec Direct {
    section: u32;
    at:      opt[Label];
    offset:  u64;
    kind:    *reloc.Kind;
    target:  opt[Label];
    addend:  i64;
    place:   u64;
}

# a relocation found by the last encode, before the object exists
# minus: the label a difference kind subtracts, as mach-o's subtractor pair subtracts it, 0 for none
pub rec Pending {
    section: u32;
    offset:  u64;
    kind:    *reloc.Kind;
    aim:     Aim;
    addend:  i64;
    minus:   u32;
}

# an encoded instruction's record before the values of the encode stop moving, its form the one it was encoded in
pub rec Entry {
    section: u32;
    offset:  u64;
    length:  u64;
    of:      Coded;
    values:  usize;
    count:   u32;
    run:     u32;
    form:    core_form.Form;
}

# the builder of one object
# ---
# a:         the allocator everything lives in
# formats:   the format registry the object's format facts are read from, borrowed
# format:    the object's format
# naming:    how the format names sections, whose conventions the source's sections take
# abi:       the caller's abi row, the object's conventions, nil until `traits` names one and for an architecture with
#            none
# chosen:    whether `traits` named it
# encoded:   the axes the format encodes for the architecture, each with whether the object must state it
# set:       the instruction set
# object:    the object's context, the selection the caller states at the state the architecture starts it at, with its
#            view of the set's register file
# view:      the context what is emitted next is written under, `object` or another the source states
# views:     every context other than `object` the source put in force, once each, in the order first put
# syntax:    the index of the set's syntax what is emitted next is written in
# arch:      the architecture of the object
# kinds:     each fixup kind's relocation kind, indexed by the kind, nil when unbound
# added:     each fixup kind's kind written where the instruction states an addend under the object's format, indexed
#            by the kind, NO_FIXUP when it is written as itself
# relocs:    the object's format's relocation rows for the architecture, which every relocation's kind must map to, the
#            registry's refusal for a format with none
# data_kind: each datum's fixup kind, indexed by basis then width, operand.NO_FIXUP for none
# adds:      per difference encoding and width (`pair_slot`), the fixup kind adding the label added, operand.NO_FIXUP for
#            none
# subs:      per difference encoding and width, the fixup kind subtracting the label subtracted, operand.NO_FIXUP for none
# areas:     the sections
# current:   the current section's index, none before one is switched to, STARTING while it is the starting section
#            and that is not yet opened
# start:     the starting section `begin` names, opened as `open` opens it when first written, none for no starting section
# started:   the index the starting section was opened at, none until it is
# labels:    the labels, label id less one
# names:     the names of sections and labels
# named:     per name, the label of that name, operand.NO_SYMBOL for none
# titled:    per name, the first section of that name, its index plus one, 0 for none
# values:    the operand values of every instruction
# members:   the members of every list value
# literals:  the bytes of every literal value
# data:      the bytes of every data fragment
# scratch:   room to encode into while measuring
# fixups:    room for the fixups of an encode
# pending:   the relocations of the last encode
# entries:   the instructions of the last encode
# listed:    the values of those instructions
# realigns:  the alignments the linker realigns in the last layout, in section order and then offset order
# raised:    the sections the format holds the traits in that the source wrote, raised into traits at finish
# sources:   the names of the source files the object states, in the order stated
# waiting:   the places waiting for the next instruction of a section
# writers:   what writes more of the object after the layout, in the order they were added
# taken:     while writers run, what existed when the layout was settled, which they may not change
# cts:       the ranges marked as built to run in constant time, the last open while `ct_end` is awaited
# frames:    the frames of the functions stated, the last open while `cfi_end` is awaited
# rules:     the rules of every frame, each at the statement it precedes
# kept:      the canonical frame addresses the open frame remembered, the last remembered last
# frame_to:  the tables the frames are written to, none for the format's default
# bridges:   the thunks that bridge labels between the conventions of an image holding code of two, in the order stated
# defined:   the label placed last, which `placed_here` answers while nothing is written after it
# mapping:   the mapping symbols written, the (format, architecture) pair's (`mink.format.pair.Mapping`), none where it
#            states none
# modes:     the assembler modes the next statement is read under, each at its initial value until changed
# states:    every value the modes have held, a new one recorded each time a mode changes, which fragments name by index
# state:     the index of `modes` among `states`
# passes:    how many passes the last layout took
# direct:    the relocations stated by themselves, in the order stated
# told:      the facts instructions state of the object, in the order stated
# finished:  whether the object was handed over
# placings:  how many times a label has been placed, the order the next is placed in
# atoms:     the exposed placed labels by section, fragment and the order placed, where the dialect splits sections into
#            atoms at them, made by each layout
# dialect:   the assembly dialect of the object's format and architecture, which spells the labels the builder names
#            and states how a relocation names a label that is no symbol, nil for a format masc states no dialect of
pub rec Builder {
    a:         *A.Allocator;
    formats:   *registry.Registry;
    format:    *mink_format.Format;
    naming:    *contract.Naming;
    abi:       *mink_arch.Abi;
    chosen:    bool;
    encoded:   table.Table[contract.Encoded];
    set:       *set.Set;
    object:    *core_state.Context;
    view:      *core_state.Context;
    views:     vector.Vector[*core_state.Context];
    syntax:    u32;
    arch:      *mink_arch.Arch;
    kinds:     vector.Vector[*reloc.Kind];
    added:     vector.Vector[operand.FixupKind];
    relocs:    res[registry.Relocations, fail.Fail];
    data_kind: [18]operand.FixupKind;
    adds:      [PAIR_SLOTS]operand.FixupKind;
    subs:      [PAIR_SLOTS]operand.FixupKind;
    areas:     vector.Vector[Area];
    current:   opt[usize];
    start:     opt[Spec];
    started:   opt[u32];
    labels:    vector.Vector[Mark];
    names:     intern.Interner;
    named:     vector.Vector[u32];
    titled:    vector.Vector[u32];
    values:    vector.Vector[operand.Value];
    members:   vector.Vector[operand.Value];
    literals:  vector.Vector[u8];
    data:      vector.Vector[u8];
    scratch:   vector.Vector[u8];
    fixups:    vector.Vector[field.Fixup];
    pending:   vector.Vector[Pending];
    entries:   vector.Vector[Entry];
    listed:    vector.Vector[operand.Value];
    realigns:  vector.Vector[Realigned];
    said:      vector.Vector[Said];
    texts:     vector.Vector[u8];
    raised:    vector.Vector[Raised];
    sources:   vector.Vector[table.Id[intern.Name]];
    waiting:   vector.Vector[Waiting];
    writers:   vector.Vector[Writer];
    taken:     opt[Snapshot];
    cts:       vector.Vector[Ct];
    frames:    vector.Vector[Framed];
    rules:     vector.Vector[Ruled];
    kept:      vector.Vector[Cfa];
    frame_to:  opt[frame.Destinations];
    bridges:   vector.Vector[Bridged];
    defined:   opt[Label];
    mapping:   opt[*mink_pair.Mapping];
    modes:     mode.State;
    states:    vector.Vector[mode.State];
    state:     u32;
    passes:    u32;
    direct:    vector.Vector[Direct];
    told:      vector.Vector[Told];
    finished:  bool;
    placings:  u32;
    atoms:     vector.Vector[Atom];
    dialect:   *dialect.Dialect;
}

# the first section handle of a section the format holds the traits in, as elf's `.note.gnu.property`, which is no
# section of the object: the source writes it as data and the builder raises its bytes into the object's traits
pub val RAISED_BASE: u32 = 0x8000_0000;

# the handle of the starting section `begin` names, which is no section of the object until something is written to it,
# a label is placed in it or a section of its name is opened, and then stands for that section
pub val STARTING: u32 = 0xFFFF_FFFF;

# a section the format holds the traits in, its name and the bytes the source wrote in it
pub rec Raised {
    name:  table.Id[intern.Name];
    bytes: vector.Vector[u8];
}

# a trait the source states, its text, for a text axis, in the builder's texts
# ---
# axis:    the axis
# setting: the value, a text's bytes in `text` and not here
# text:    the bytes of a text
# by_row:  whether an instruction the set reads as what it states stated it (`stating`)
pub rec Said {
    axis:    *mink_trait.Axis;
    setting: mink_trait.Setting;
    text:    Span;
    spelled: opt[Spelling];
    by_row:  bool;
}

# a fact an instruction states of the object (`stating`), its data's bytes in the builder's texts
# ---
# fact:  the fact's format and key
# value: its value
# data:  its data, none for a fact of a value alone
pub rec Told {
    fact:  stating.Fact;
    value: u64;
    data:  opt[Span];
}

# how the source spelled a trait it stated by the format's attribute tag, its bytes in the builder's texts
# ---
# named:   whether the tag is by name, `name` then its bytes and a nul
# name:    the tag's name
# number:  the tag's number, for a tag by number
# text:    whether the value is a text, `value` then its bytes
# value:   the value's text
# written: the value's number, for a number
pub rec Spelling {
    named:   bool;
    name:    Span;
    number:  u64;
    text:    bool;
    value:   Span;
    written: u64;
}

# a trait the source stated by the object format's attribute tag, as it spelled it
# ---
# tag:     the tag, by name or number
# written: the value, a text's bytes valid until the builder is next written or released
pub rec Spelled {
    tag:     contract.Tag;
    written: contract.Written;
}

# a range of statements of one section marked as built to run in constant time
# ---
# section: the section
# start:   the statement it starts at
# end:     the statement it ends before, while `open` is false
# open:    whether `ct_end` is awaited
pub rec Ct {
    section: u32;
    start:   u32;
    end:     u32;
    open:    bool;
}

# a frame's pointer at label `label`, the routine's or table's address, or with `indirect` a slot of the object that
# holds it
pub rec Pointed {
    label:    Label;
    indirect: bool;
}

# the frame of one function, stated by `cfi_start`, its rules and `cfi_end`
# ---
# function:    the label of the function
# section:     the section it lies in
# start:       the statement it starts at
# end:         the statement it ends before
# rules:       the first of its rules among the builder's
# count:       how many
# personality: its personality routine
# lsda:        its language specific data
# signal:      whether it is a signal handler's
# open:        whether `cfi_end` is awaited
# cfa:         the canonical frame address its rules leave at the cursor
# depth:       how many states its rules remember that none restores yet
pub rec Framed {
    function:    Label;
    section:     u32;
    start:       u32;
    end:         u32;
    rules:       usize;
    count:       usize;
    personality: opt[Pointed];
    lsda:        opt[Pointed];
    signal:      bool;
    open:        bool;
    cfa:         Cfa;
    depth:       u32;
}

# the canonical frame address an open frame's rules leave, as a register plus an offset that may scale, in dwarf numbers
# ---
# reg:      the register it is from
# fixed:    the bytes of the offset that do not scale
# scale:    the multiple of the value of `quantity` the offset adds, 0 when it does not scale
# quantity: the register whose value scales the offset, read only when `scale` is nonzero
pub rec Cfa {
    reg:      u16;
    fixed:    i64;
    scale:    i64;
    quantity: u16;
}

# a frame rule at the statement it takes effect before, an expression's bytes in the builder's texts
pub rec Ruled {
    at:         u32;
    rule:       frame.Rule;
    expression: Span;
}

# whether `ctx` is of the set's catalog and axes
pub fun of_set(s: *set.Set, ctx: *core_state.Context) bool {
    ret ctx.selection.catalog == s.extensions && ctx.axes.at == s.states.at && ctx.axes.len == s.states.len;
}

# the assembler modes fragment `f` was written under, which every computation over it reads, as a marker that holds only
# under some modes
pub fun modes_at(b: *Builder, f: *Fragment) *mode.State {
    ret ?b.states.data[f.modes::usize];
}

# the slot of a datum's basis and width among the builder's data kinds
pub fun datum_slot(basis: core_fixup.Basis, width: u8) usize {
    ret basis::usize * (core_fixup.MAX_WIDTH::usize + 1) + width::usize;
}

# how many slots the builder's difference pairs take: a fixed width's each, then a leb128's of each signedness
val PAIR_SLOTS: usize = 11;

# the slot of a difference pair of encoding `how` and `width` among the builder's pairs, a fixed width's its width
pub fun pair_slot(how: core_fixup.Encoding, width: u8) usize {
    if (how == core_fixup.FIXED) { ret width::usize; }
    ret core_fixup.MAX_WIDTH::usize + how::usize;
}

# the id of `s`'s bytes among the builder's names, a new name interned, and every name given its label and section slots
pub fun name_of(b: *Builder, s: str) res[table.Id[intern.Name], Refusal] {
    ret name_bytes(b, s::*u8, str_len(s));
}

# the id of the `n` bytes at `p` among the builder's names, as `name_of` makes it
pub fun name_bytes(b: *Builder, p: *u8, n: usize) res[table.Id[intern.Name], Refusal] {
    if (!held(vector.reserve[u32](?b.named, 1)) || !held(vector.reserve[u32](?b.titled, 1))) { ret res[table.Id[intern.Name], Refusal].err{memory()}; }
    val id: res[table.Id[intern.Name], fail.Fail] = intern.intern(?b.names, p, n);
    if (sel id.err) { ret res[table.Id[intern.Name], Refusal].err{failed(id.err)}; }
    if (b.named.len <= id.ok.index::usize) {
        b.named.data[b.named.len] = operand.NO_SYMBOL;
        vector.commit[u32](?b.named, 1);
        b.titled.data[b.titled.len] = 0;
        vector.commit[u32](?b.titled, 1);
    }
    ret res[table.Id[intern.Name], Refusal].ok{id.ok};
}

# a label's place in the order labels are numbered by
# ---
# section:  its section, NO_PLACE for one never placed
# fragment: the fragment it precedes
# id:       the label
pub rec Order {
    section:  u32;
    fragment: u32;
    id:       u32;
}

# the next number a stem gives
pub rec Counter {
    stem: str;
    next: u32;
}

pub fun mark_of(b: *Builder, l: Label) opt[*Mark] {
    if (l.id == operand.NO_SYMBOL || l.id::usize > b.labels.len) { ret opt[*Mark].none{}; }
    ret opt[*Mark].some{?b.labels.data[l.id::usize - 1]};
}

# a symbolic value naming `l` plus `addend`, of the operand's own fixup kind
pub fun target(l: Label, addend: i64) operand.Value {
    ret operand.Value.symbol{operand.Symbol{id: l.id, addend: addend, fixup: operand.NO_FIXUP}};
}

# whether symbol handle `id` names a label of the builder
pub fun names_label(b: *Builder, id: u32) bool {
    ret id != operand.NO_SYMBOL && id::usize <= b.labels.len;
}

# how many members and literal bytes `values` hold, within them too, refused when a symbol names no label or a list nests
pub rec Extent {
    members:  usize;
    literals: usize;
}

# what an instruction of a sequence measured
# ---
# len:    its length encoded
# split:  the symbol of a fixup of it that covers more instructions than the sequence has left, operand.NO_SYMBOL for none
# marker: the marker of the span of its fixups, operand.NO_FIXUP for none
pub rec Measured {
    len:    usize;
    split:  u32;
    marker: operand.FixupKind;
}

# the forms of a sequence as `put` writes it
# ---
# chosen: each instruction in the form it is written in, with the marker its span states
# lens:   each one's length as written, every symbol encoded as zero
# total:  the list members and literal bytes they hold
# slots:  the operand values they hold
pub rec Shaped {
    chosen: [relax.MAX_STEPS]relax.Emitted;
    lens:   [relax.MAX_STEPS]usize;
    total:  Extent;
    slots:  usize;
}

# `bytes` copied into the builder's texts, with a nul after them when `nul`, as a span of them
pub fun kept_text(b: *Builder, bytes: *u8, len: usize, nul: bool) res[Span, Refusal] {
    var n: usize = len;
    if (nul)                                    { n = n + 1; }
    if (!held(vector.reserve[u8](?b.texts, n))) { ret res[Span, Refusal].err{memory()}; }
    val start: usize = b.texts.len;
    var i:     usize = 0;
    for (i < len) {
        b.texts.data[start + i] = bytes[i];
        i                       = i + 1;
    }
    if (nul) { b.texts.data[start + len] = 0; }
    vector.commit[u8](?b.texts, n);
    ret res[Span, Refusal].ok{Span{start: start, len: len}};
}

# a section the object's format holds its traits in, as the source wrote it
# ---
# name:  its name
# bytes: the bytes written in it, valid until the builder is next written or released
pub rec TraitSection {
    name:  View;
    bytes: View;
}

# a frame as stated, for a reader of the record such as the listing
# ---
# function:    the label of the function
# section:     the section it lies in
# start:       the statement it begins before
# end:         the statement it ends before, the section's statement count for its end
# rules:       the index of its first rule, which `rule_at` reads
# count:       how many rules it states
# personality: its personality routine
# lsda:        its language specific data
# signal:      whether it is a signal handler's
pub rec Frame {
    function:    Label;
    section:     Section;
    start:       u32;
    end:         u32;
    rules:       usize;
    count:       usize;
    personality: opt[Pointed];
    lsda:        opt[Pointed];
    signal:      bool;
}

# a frame rule as stated, at the statement it takes effect before
# ---
# at:   the statement of its frame's section
# rule: the rule, an expression's bytes borrowed from the builder, valid until it is next written or released
pub rec Rule {
    at:   u32;
    rule: frame.Rule;
}

# the low `width` bytes of `value` into `out`, in the set's byte order, as every integer the builder writes is
pub fun ordered(b: *Builder, value: u64, width: usize, out: *u8) {
    var i: usize = 0;
    for (i < width) {
        var at: usize = i;
        if (b.set.codec.fields.order == field.BIG) { at = width - 1 - i; }
        out[at] = ((value >> (i * 8)::u64) & 0xFF)::u8;
        i       = i + 1;
    }
}

# the offset of fragment `at` of `area` in the current pass, its end for its fragment count
pub fun offset_at(area: *Area, at: u32) u64 {
    if (at::usize >= area.fragments.len) { ret area.size; }
    ret area.fragments.data[at::usize].offset;
}

# the gap an alignment at `offset` pads
pub fun gap(al: *Align, offset: u64) u64 {
    val pad: u64 = (al.boundary - (offset & (al.boundary - 1))) & (al.boundary - 1);
    if (sel al.max.some && pad > al.max.some) { ret 0; }
    ret pad;
}

# the relocation kind of fixup kind `kind`, nil when the set binds none
pub fun kind_of(b: *Builder, kind: operand.FixupKind) *reloc.Kind {
    if (kind::usize >= b.kinds.len) { ret nil; }
    ret b.kinds.data[kind::usize];
}

# the fixup kind fixup kind `kind` is written as for a symbol the instruction states `addend` to, its binding's added
# kind under the object's format where the addend is not zero, else itself
pub fun written_kind(b: *Builder, kind: operand.FixupKind, addend: i64) operand.FixupKind {
    if (addend == 0 || kind::usize >= b.added.len) { ret kind; }
    val added: operand.FixupKind = b.added.data[kind::usize];
    if (added == operand.NO_FIXUP) { ret kind; }
    ret added;
}

# an immediate's symbol folded by the set's folds
# ---
# fold:     the fold of its fixup kind
# distance: the distance its SELF fold measures, from fragment `j` for a SELF fold and from the partner's own fragment
#           for a PARTNER, which takes it whole
pub rec Folded {
    fold:     *core_fixup.Fold;
    distance: i64;
}

# whether no instruction the linker may resize lies between fragments `x` and `y` of `area`
pub fun settled(area: *Area, x: u32, y: u32) bool {
    ret area.marks.data[x::usize] == area.marks.data[y::usize];
}

# whether other objects may preempt `m`, so only the linker knows where it is
pub fun preemptible(m: *Mark) bool {
    ret sel m.exposure.some && mink_symbol.binds(m.exposure.some.binding, mink_symbol.EXTERNAL);
}

# whether a relocation can name `m`: it is placed, has a value, or other objects define it
pub fun known(m: *Mark) bool {
    ret m.defined || sel m.value.some || sel m.exposure.some;
}

# a label plus an addend
pub rec Aimed {
    id:     u32;
    addend: i64;
}

# the equate of `m`, none when it has none or, unless `exposed`, when it is a symbol of the object in its own right
fun equate_of(m: *Mark, exposed: bool) opt[Equate] {
    if (!exposed && sel m.exposure.some) { ret opt[Equate].none{}; }
    if (sel m.value.some) {
        if (sel m.value.some.equate) { ret opt[Equate].some{m.value.some.equate}; }
    }
    ret opt[Equate].none{};
}

# the label `id` plus `addend` stands for through its equates, every equate when `exposed` and else those of labels
# the object does not hold as symbols, none for a cycle
pub fun through(b: *Builder, id: u32, addend: i64, exposed: bool) opt[Aimed] {
    var at:    Aimed = Aimed{id: id, addend: addend};
    var steps: usize = 0;
    for {
        val next: opt[Equate] = equate_of(?b.labels.data[at.id::usize - 1], exposed);
        if (sel next.none) { brk; }
        steps = steps + 1;
        if (steps > b.labels.len) { ret opt[Aimed].none{}; }
        at = Aimed{id: next.some.target, addend: at.addend + next.some.addend};
    }
    ret opt[Aimed].some{at};
}

# whether `v` fits `width` bytes, read as signed or unsigned
pub fun fits(v: i64, width: usize) bool {
    if (width >= 8) { ret true; }
    val half: i64 = 1::i64 << (width * 8 - 1)::i64;
    ret v >= -half && v < half * 2;
}

# what a form came to
# ---
# far:    the step taking the target is out of range and its row has a longer form
# size:   the form's length, when it is not far
# marked: whether one of its steps carries a marker
pub rec Formed {
    far:    bool;
    size:   u64;
    marked: bool;
}

# the labels a difference stands for through their equates, and where the current pass places them
# ---
# plus:   the label added and the addend, through its equates
# minus:  the label subtracted, through its equates, its addend taken into plus's
# p:      plus's state
# q:      minus's state
# shared: whether both are placed in one section
# value:  the distance between them plus the addend in the current pass, when shared
pub rec Spread {
    plus:   Aimed;
    minus:  Aimed;
    p:      *Mark;
    q:      *Mark;
    shared: bool;
    value:  i64;
}

# the symbol of an atom and the fragment it is placed before
pub rec Based {
    symbol:   table.Id[mink_object.Symbol];
    fragment: u32;
}

# an exposed placed label in the index of atoms: its section, the fragment it precedes and the order it was placed in
pub rec Atom {
    section:  u32;
    fragment: u32;
    order:    u32;
    id:       u32;
}

# a relocation of the encoded builder by its place: a statement's, by its index among the pending, or one stated by
# itself, by its index among the direct
pub rec Placing {
    section: u32;
    offset:  u64;
    direct:  bool;
    index:   usize;
}

# what a section holds where a mapping symbol was last written
# ---
# UNMARKED: nothing marked yet
# CODE:     code, under the code mark last written
# DATA:     data
pub def Marked: u8;

# what a section was opened as, its name aside the rest of its spec
# ---
# name:        its name, none for a nameless section
# kind:        the role it plays
# flags:       the flags it carries
# disposition: how garbage collection treats it
# entsize:     the size of each of its entries, 0 for none
pub rec Opened {
    name:        opt[View];
    kind:        *mink_section.Kind;
    flags:       mink_section.Flags;
    disposition: *mink_section.Disposition;
    entsize:     u64;
}

# a fact an instruction the set reads as what it states stated (`stating`)
# ---
# fact:  its format and key
# value: its value
# data:  its data's bytes, none for a fact of a value alone
pub rec StatedFact {
    fact:  stating.Fact;
    value: u64;
    data:  opt[View];
}

# an instruction of the statement record, as it was written
# ---
# inst:   its row, in the form it was written in, and its values as given, symbols as symbols
# marker: the marker fixup kind riding beside it, operand.NO_FIXUP for none
# run:    how many instructions its sequence holds from it, 1 for one written alone and 0 past a sequence's first
pub rec Written {
    inst:   inst.Inst;
    marker: operand.FixupKind;
    run:    u32;
}

# a difference of labels as data
# ---
# of:       the difference
# width:    its width in bytes, 0 for a leb128
# encoding: how it is written
pub rec Measure {
    of:       Difference;
    width:    u8;
    encoding: core_fixup.Encoding;
}

# what a statement of the record is
# ---
# code:       an instruction
# data:       these bytes
# zero:       this many zero bytes
# align:      an alignment
# datum:      a symbol's address or distance as data
# difference: a difference of labels as data
pub tag Stated: u8 {
    code:       Written;
    format:     Formatted;
    data:       View;
    zero:       u64;
    align:      Align;
    datum:      Reference;
    difference: Measure;
}

# a statement of a section as the caller wrote it, which is what the builder encodes from
# ---
# stated: what it is
# view:   the context it was written under, which admits, encodes, relaxes and fills it, its selection and state
# syntax: the index of the set's syntax it was written in
# modes:  the assembler modes it was written under, valid until the builder is next written or released
# offset: where the last layout placed it
pub rec Statement {
    stated: Stated;
    view:   *core_state.Context;
    syntax: u32;
    modes:  *mode.State;
    offset: u64;
}

# where a label is placed in the statement record
# ---
# section:   its section
# statement: the statement it precedes, the section's statement count for its end
# order:     when it was placed among the labels of the builder, which orders those placed before one statement
pub rec Spot {
    section:   Section;
    statement: u32;
    order:     u32;
}

# the spelling of a label with no name of its own that the object names: a stem and a number following it
pub rec Stem {
    stem:   str;
    number: u32;
}
