# the axis of the object's architecture the attribute `tag` names in its format, none when it names none, as risc-v's
# `stack_align` or 4 names riscv-stack-align on elf
pub fun attribute(b: *Builder, tag: contract.Tag) res[opt[*mink_trait.Axis], Refusal] {
    val found: res[opt[*mink_trait.Axis], fail.Fail] = trait.attribute(b.formats, b.format, b.arch, tag);
    if (sel found.err) { ret res[opt[*mink_trait.Axis], Refusal].err{failed(found.err)}; }
    ret res[opt[*mink_trait.Axis], Refusal].ok{found.ok};
}

# the setting the value `v` written for the attribute that encodes `x` states on it in the object's format, as risc-v's
# `atomic_abi, 1` states a6c. a text is borrowed from where `v` lies
pub fun setting(b: *Builder, x: *mink_trait.Axis, v: contract.Written) res[mink_trait.Setting, Refusal] {
    val got: res[mink_trait.Setting, fail.Fail] = registry.setting(b.formats, b.format, x, v);
    if (sel got.err) { ret res[mink_trait.Setting, Refusal].err{failed(got.err)}; }
    ret res[mink_trait.Setting, Refusal].ok{got.ok};
}

# whether the set states `x` as the object's selection's spelling, so a statement of it names a selection
pub fun spells_selection(b: *Builder, x: *mink_trait.Axis) bool {
    val row: opt[*trait.Owned] = set.owner_of(b.set, x);
    if (sel row.none) { ret false; }
    val owner: trait.Owner = row.some.owner;
    if (!sel owner.selection) { ret false; }
    ret sel owner.selection.spelled;
}

# the object's selection's versioned spelling, in the builder's texts after what they hold, which the next text written
# there takes the place of
fun spelled_selection(b: *Builder) res[View, Refusal] {
    var out:     vector.Vector[u8] = vector.init[u8](b.a);
    val written: err[A.Error]      = extension.spell_versioned(b.object.selection, ?out);
    if (sel written.err) {
        vector.dnit[u8](?out);
        ret res[View, Refusal].err{memory()};
    }
    val kept: bool  = held(vector.reserve[u8](?b.texts, out.len));
    var i:    usize = 0;
    for (kept && i < out.len) {
        b.texts.data[b.texts.len + i] = out.data[i];
        i                             = i + 1;
    }
    vector.dnit[u8](?out);
    if (!kept) { ret res[View, Refusal].err{memory()}; }
    ret res[View, Refusal].ok{View{data: ?b.texts.data[b.texts.len], len: i}};
}

# the value an owner other than the source states on `x`, as the builder will state it, none where the source may: an
# axis of the source class, or a convention the caller's abi row leaves unstated, and none where the set leaves the axis
# unstated on every object. a selection's spelled text is a view
# into the builder's texts, an axis the set derives from the views written under is refused, as no value of it is known
# before the object is finished
fun owners_value(b: *Builder, x: *mink_trait.Axis) res[opt[mink_trait.Setting], Refusal] {
    val row: opt[*trait.Owned] = set.owner_of(b.set, x);
    if (sel row.some) {
        val owner: trait.Owner = row.some.owner;
        if (sel owner.derived)    { ret res[opt[mink_trait.Setting], Refusal].err{refuse(OWNED)}; }
        if (sel owner.unwritten)  { ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].none{}}; }
        if (!sel owner.selection) { ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].none{}}; }
        val by: trait.Selected = owner.selection;
        if (sel by.flag) { ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].some{mink_trait.Setting.flag{core_state.admits(b.object, by.flag)}}}; }
        val spelled: res[View, Refusal] = spelled_selection(b);
        if (sel spelled.err) { ret res[opt[mink_trait.Setting], Refusal].err{spelled.err}; }
        val text: store.Bytes = store.Bytes{data: spelled.ok.data, len: spelled.ok.len};
        ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].some{mink_trait.Setting.text{store.Held.borrowed{text}}}};
    }
    if (sel x.owner.convention) { ret res[opt[mink_trait.Setting], Refusal].ok{trait.convention(b.abi, x)}; }
    if (sel x.owner.fixed)      { ret res[opt[mink_trait.Setting], Refusal].ok{mink_arch.fixed_value(b.arch, x)}; }
    if (sel x.owner.source)     { ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].none{}}; }
    ret res[opt[mink_trait.Setting], Refusal].err{refuse(OWNED)};
}

# whether settings `a` and `b` are one value, a borrowed text by its bytes
fun agrees(a: mink_trait.Setting, b: mink_trait.Setting) bool {
    if (sel a.text) {
        if (!sel b.text)          { ret false; }
        if (!sel a.text.borrowed) { ret false; }
        if (!sel b.text.borrowed) { ret false; }
        ret store.same_bytes(a.text.borrowed, b.text.borrowed);
    }
    ret mink_trait.same(a, b);
}

# trait `t` stated of the object by its source, as risc-v's `.attribute stack_align, 16`, a later statement on the same
# axis taking its place. a text is copied, so its bytes need only outlive the call. a trait has one owner, so the source
# holds an axis of the source class, and a convention the caller's abi row leaves unstated. an axis another owner
# states is taken only at the value it states, as `.attribute arch` naming the object's own selection, and refused at
# another
pub fun state(b: *Builder, t: mink_trait.Trait) err[Refusal] {
    if (b.finished)                          { ret refused(FINISHED); }
    if (!mink_arch.has_axis(b.arch, t.axis)) { ret refused(NO_AXIS); }
    if (!mink_trait.fits(t.axis, t.setting)) { ret refused(TRAIT_VALUE); }
    val row: opt[*trait.Owned] = set.owner_of(b.set, t.axis);
    if (sel row.some) {
        if (sel row.some.owner.unwritten) { ret refused(UNWRITTEN); }
    }
    val owners: res[opt[mink_trait.Setting], Refusal] = owners_value(b, t.axis);
    if (sel owners.err) { ret err[Refusal].err{owners.err}; }
    if (sel owners.ok.some) {
        if (!agrees(owners.ok.some, t.setting)) { ret refused(DISAGREES); }
        ret err[Refusal].ok{};
    }
    var said: Said = Said{axis: t.axis, setting: t.setting, text: Span{start: 0, len: 0}, spelled: opt[Spelling].none{}, by_row: false};
    if (sel t.setting.text) {
        if (!sel t.setting.text.borrowed) { ret refused(TRAIT_VALUE); }
        val bytes: store.Bytes = t.setting.text.borrowed;
        if (!held(vector.reserve[u8](?b.texts, bytes.len))) { ret err[Refusal].err{memory()}; }
        said.text = Span{start: b.texts.len, len: bytes.len};
        var i: usize = 0;
        for (i < bytes.len) {
            b.texts.data[b.texts.len + i] = bytes.data[i];
            i                             = i + 1;
        }
        vector.commit[u8](?b.texts, bytes.len);
    }
    val before: opt[*Said] = said_on(b, t.axis);
    if (sel before.some) {
        @before.some = said;
        ret err[Refusal].ok{};
    }
    if (!held(vector.push[Said](?b.said, said))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# the context what is emitted next is written under, which admits and encodes it
pub fun view(b: *Builder) *core_state.Context {
    ret b.view;
}

# the abi row of the object's architecture whose conventions the object follows, as `-mabi=lp64d` names riscv64's, the
# convention facts the builder cannot know. it is named once, before the source states a trait, and an object of an
# architecture with abi rows that names none is refused at finish
pub fun traits(b: *Builder, abi: *mink_arch.Abi) err[Refusal] {
    if (b.finished)                       { ret refused(FINISHED); }
    if (b.chosen || b.said.len != 0)      { ret refused(ABI_LATE); }
    if (abi != nil && abi.arch != b.arch) { ret refused(OTHER_ABI); }
    b.abi    = abi;
    b.chosen = true;
    ret err[Refusal].ok{};
}

# the set's syntax of index `k` the one what is emitted next is written in, which the statement record keeps
pub fun in_syntax(b: *Builder, k: u32) err[Refusal] {
    if (k >= b.set.syntaxes.len) { ret refused(NO_SYNTAX); }
    b.syntax = k;
    ret err[Refusal].ok{};
}

# the index of the syntax what is emitted next is written in
pub fun syntax_of(b: *Builder) u32 {
    ret b.syntax;
}

# trait `t` stated of the object by its source as `state` states it, spelled by the format's attribute tag `tag` and the
# value `written` it maps from, which the listing restates it by
pub fun state_spelled(b: *Builder, t: mink_trait.Trait, tag: contract.Tag, written: contract.Written) err[Refusal] {
    val stated: err[Refusal] = state(b, t);
    if (sel stated.err) { ret stated; }
    val on: opt[*Said] = said_on(b, t.axis);
    # a trait its owner states at the value given is the owner's and needs no spelling of its own
    if (sel on.none) { ret stated; }
    var sp: Spelling = Spelling{named: false, name: Span{start: 0, len: 0}, number: 0, text: false, value: Span{start: 0, len: 0}, written: 0};
    if (sel tag.name) {
        val kept: res[Span, Refusal] = kept_text(b, tag.name, str_len(tag.name), true);
        if (sel kept.err) { ret err[Refusal].err{kept.err}; }
        sp.named = true;
        sp.name  = kept.ok;
    }
    or (sel tag.number) { sp.number = tag.number; }
    if (sel written.text) {
        val kept: res[Span, Refusal] = kept_text(b, written.text.data, written.text.len, false);
        if (sel kept.err) { ret err[Refusal].err{kept.err}; }
        sp.text  = true;
        sp.value = kept.ok;
    }
    or (sel written.number) { sp.written = written.number; }
    on.some.spelled = opt[Spelling].some{sp};
    ret err[Refusal].ok{};
}

# how many traits the source stated
pub fun said_count(b: *Builder) usize {
    ret b.said.len;
}

# how the source spelled the `k`-th trait it stated, none for one stated by no attribute tag
pub fun said_spelled(b: *Builder, k: usize) opt[Spelled] {
    val said: *Said = ?b.said.data[k];
    if (sel said.spelled.none) { ret opt[Spelled].none{}; }
    val sp:  Spelling     = said.spelled.some;
    var tag: contract.Tag = contract.Tag.number{sp.number};
    if (sp.named) { tag = contract.Tag.name{?b.texts.data[sp.name.start]}; }
    var written: contract.Written = contract.Written.number{sp.written};
    if (sp.text) { written = contract.Written.text{store.Bytes{data: ?b.texts.data[sp.value.start], len: sp.value.len}}; }
    ret opt[Spelled].some{Spelled{tag: tag, written: written}};
}

# how many sections the format holds its traits in the source wrote
pub fun raised_count(b: *Builder) usize {
    ret b.raised.len;
}

# the `k`-th section the format holds its traits in the source wrote, in the order it opened them
pub fun raised_at(b: *Builder, k: usize) TraitSection {
    val r: *Raised = ?b.raised.data[k];
    ret TraitSection{name: intern.bytes_of(?b.names, r.name), bytes: View{data: r.bytes.data, len: r.bytes.len}};
}

# whether the object's context or any context a fragment was written under admits `required`, so EF_RISCV_RVC is set
# when `.option arch, +c` turns c on in an object built without it
fun written_under(b: *Builder, required: requirement.Requirement) bool {
    if (core_state.admits(b.object, required)) { ret true; }
    var i: usize = 0;
    for (i < b.areas.len) {
        val area: *Area = ?b.areas.data[i];
        var j:    usize = 0;
        for (j < area.fragments.len) {
            val v: *core_state.Context = area.fragments.data[j].view;
            if (v != b.object && core_state.admits(v, required)) { ret true; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret false;
}

# what the source stated on `x`, none when it stated nothing. the source states few traits, each axis once
pub fun said_on(b: *Builder, x: *mink_trait.Axis) opt[*Said] {
    var i: usize = 0;
    for (i < b.said.len) {
        if (b.said.data[i].axis == x) { ret opt[*Said].some{?b.said.data[i]}; }
        i = i + 1;
    }
    ret opt[*Said].none{};
}

# what the source stated in `said` stated on `o`, a text owned by `o`
fun state_said(b: *Builder, o: *mink_object.Object, said: *Said) err[fail.Fail] {
    var setting: mink_trait.Setting = said.setting;
    if (sel said.setting.text) {
        val owned: res[store.Held, fail.Fail] = store.own(?o.store, ?b.texts.data[said.text.start], said.text.len);
        if (sel owned.err) { ret err[fail.Fail].err{owned.err}; }
        setting = mink_trait.Setting.text{owned.ok};
    }
    ret mink_object.state(o, said.axis, setting);
}

# `setting` stated on `o` on `x`, a borrowed text owned by `o`
fun state_on(o: *mink_object.Object, x: *mink_trait.Axis, setting: mink_trait.Setting) err[fail.Fail] {
    var on: mink_trait.Setting = setting;
    if (sel setting.text) {
        if (sel setting.text.borrowed) {
            val bytes: store.Bytes                = setting.text.borrowed;
            val owned: res[store.Held, fail.Fail] = store.own(?o.store, bytes.data, bytes.len);
            if (sel owned.err) { ret err[fail.Fail].err{owned.err}; }
            on = mink_trait.Setting.text{owned.ok};
        }
    }
    ret mink_object.state(o, x, on);
}

# every trait the sections the format holds the traits in state, raised from the bytes the source wrote in them, stated
# as the source states a trait (`state`), so a trait another owner states must agree with it. bytes that state no trait
# the format maps are refused, carrying the format's refusal, which names what no row maps
pub fun raise_all(b: *Builder) err[Refusal] {
    var k: usize = 0;
    for (k < b.raised.len) {
        val r:      *Raised                       = ?b.raised.data[k];
        var traits: table.Table[mink_trait.Trait] = table.make[mink_trait.Trait](b.a);
        val named:  View                          = intern.bytes_of(?b.names, r.name);
        val name:   store.Bytes                   = store.Bytes{data: named.data, len: named.len};
        val got:    err[fail.Fail]                = registry.raise(b.formats, b.format, b.arch, name, store.Bytes{data: r.bytes.data, len: r.bytes.len}, ?traits);
        var why:    err[Refusal]                  = err[Refusal].ok{};
        if (sel got.err) { why = err[Refusal].err{Refusal{message: RAISE, label: operand.NO_SYMBOL, object: opt[fail.Fail].some{got.err}}}; }
        var i: usize = 0;
        for (!sel why.err && i < table.count[mink_trait.Trait](?traits)) {
            val t:      mink_trait.Trait = @table.at[mink_trait.Trait](?traits, table.nth[mink_trait.Trait](i));
            val stated: err[Refusal]     = state(b, t);
            if (sel stated.err) { why = about_axis(stated.err.message, t.axis); }
            i = i + 1;
        }
        val released: err[fail.Fail] = table.release[mink_trait.Trait](?traits);
        if (sel why.err)      { ret why; }
        if (sel released.err) { ret err[Refusal].err{failed(released.err)}; }
        k = k + 1;
    }
    ret err[Refusal].ok{};
}

# the value the owner of `x` other than the source states on the finished object, as `owners_value`, and a derived
# axis's from every view written under
fun finished_value(b: *Builder, x: *mink_trait.Axis) res[opt[mink_trait.Setting], Refusal] {
    val row: opt[*trait.Owned] = set.owner_of(b.set, x);
    if (sel row.some) {
        val owner: trait.Owner = row.some.owner;
        if (sel owner.derived) { ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].some{mink_trait.Setting.flag{written_under(b, owner.derived)}}}; }
    }
    ret owners_value(b, x);
}

# the set's default of source axis `x`, none for none
fun default_of(b: *Builder, x: *mink_trait.Axis) opt[mink_trait.Setting] {
    val row: opt[*trait.Owned] = set.owner_of(b.set, x);
    if (sel row.none) { ret opt[mink_trait.Setting].none{}; }
    val owner: trait.Owner = row.some.owner;
    if (sel owner.source) { ret opt[mink_trait.Setting].some{owner.source.setting}; }
    ret opt[mink_trait.Setting].none{};
}

# the value the set's chosen row of source axis `x` gives it, the merge of the choices the atoms the object's selection
# holds name in the object's format, none for no chosen row or no atom held. a merge the axis refuses is refused naming it
fun chosen_of(b: *Builder, x: *mink_trait.Axis) res[opt[mink_trait.Setting], Refusal] {
    val none: opt[mink_trait.Setting] = opt[mink_trait.Setting].none{};
    val row:  opt[*trait.Owned]       = set.owner_of(b.set, x);
    if (sel row.none) { ret res[opt[mink_trait.Setting], Refusal].ok{none}; }
    val owner: trait.Owner = row.some.owner;
    if (!sel owner.chosen) { ret res[opt[mink_trait.Setting], Refusal].ok{none}; }
    val atoms: requirement.Atoms  = owner.chosen;
    var any:   bool               = false;
    var held:  mink_trait.Setting = mink_trait.Setting.flag{false};
    var i:     u32                = 0;
    for (i < atoms.len) {
        val atom: *requirement.Atom = ?atoms.at[i];
        i = i + 1;
        if (!extension.has(b.object.selection, atom.id)) { cnt; }
        val got: res[mink_trait.Setting, fail.Fail] = registry.setting(b.formats, b.format, x, contract.Written.number{atom.value});
        if (sel got.err) { ret res[opt[mink_trait.Setting], Refusal].err{failed(got.err)}; }
        if (!any) {
            held = got.ok;
            any  = true;
            cnt;
        }
        val joined: catalog_merge.Joined[mink_trait.Setting] = mink_trait.merge(x, held, got.ok);
        if (!sel joined.kept) { ret res[opt[mink_trait.Setting], Refusal].err{Refusal{message: TRAIT_VALUE, label: operand.NO_SYMBOL, axis: opt[*mink_trait.Axis].some{x}}}; }
        held = joined.kept;
    }
    if (!any) { ret res[opt[mink_trait.Setting], Refusal].ok{none}; }
    ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].some{held}};
}

# every axis of the architecture stated on `o` by its owner: one the set derives by its row, a convention by the caller's
# abi row, a fixed one by the architecture row, and one the source may state by its last statement or else the set's
# default or the choice the selection makes. an axis the format requires that no owner states is refused naming it
pub fun state_traits(b: *Builder, o: *mink_object.Object) err[Refusal] {
    var i: usize = 0;
    for (i < b.arch.axis_count) {
        val x: *mink_trait.Axis = b.arch.axes[i];
        i = i + 1;
        val owned: res[opt[mink_trait.Setting], Refusal] = finished_value(b, x);
        if (sel owned.err) { ret err[Refusal].err{owned.err}; }
        val chose: res[opt[mink_trait.Setting], Refusal] = chosen_of(b, x);
        if (sel chose.err) { ret err[Refusal].err{chose.err}; }
        var put:  err[fail.Fail]          = err[fail.Fail].ok{};
        val said: opt[*Said]              = said_on(b, x);
        val dflt: opt[mink_trait.Setting] = default_of(b, x);
        if (sel owned.ok.some)             { put = state_on(o, x, owned.ok.some); }
        or (sel said.some)                 { put = state_said(b, o, said.some); }
        or (sel dflt.some)                 { put = state_on(o, x, dflt.some); }
        or (sel chose.ok.some)             { put = state_on(o, x, chose.ok.some); }
        or (trait.required(?b.encoded, x)) { ret about_axis(MISSING_TRAIT, x); }
        if (sel put.err)                   { ret err[Refusal].err{failed(put.err)}; }
    }
    ret err[Refusal].ok{};
}
