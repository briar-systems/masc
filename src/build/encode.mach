# the encoding of a settled layout: every fragment's bytes, the relocations it needs and the differences it measures
#
# a datum, a symbol's address or distance as data, folds or relocates
# by the rule an instruction's fixup does. a difference of labels is a
# deferred value: whatever the source has placed when it is written, the
# layout measures it once both labels are placed, and it folds, relocates by
# the set's pair for its encoding or is refused at finish naming its label. a
# fixed-width one is its width long, and a leb128 starts empty and is as
# long as its value needs, measured each pass.
# a leb128 only grows, padded with continuation bytes when its value shrinks,
# so it settles with the instructions and adds at most a leb128's longest to
# the bound of passes. code alignment after an
# instruction the linker may resize pads its worst case and carries the set's
# realign marker, so the linker can shrink it back. a fixup whose relocation
# covers instructions after its own, as a call pair's, is written only in a
# sequence that holds them, with the marker the set's span states beside it.
use masc.codec.walk;
use masc.core.field;
use masc.core.fill;
use core_fixup: masc.core.fixup;
use masc.core.inst;
use masc.core.operand;
use masc.core.relax;
use masc.core.row;
use mink.base.fail;
use mink.format.registry;
use mink.model.reloc;
use mink_row: mink.reloc.row;
use std.collections.vector;
use std.encoding.leb128;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use masc.build.layout.distance;
use masc.build.layout.form;
use masc.build.layout.leb_size;
use masc.build.layout.pad;
use masc.build.layout.realigned;
use masc.build.layout.spread;
use masc.build.refusal.CYCLE;
use masc.build.refusal.DATUM_RANGE;
use masc.build.refusal.LOCAL_ONLY;
use masc.build.refusal.NO_PAIR;
use masc.build.refusal.NO_RELOCATION;
use masc.build.refusal.Refusal;
use masc.build.refusal.SHRANK;
use masc.build.refusal.UNBOUND;
use masc.build.refusal.UNRESOLVED;
use masc.build.refusal.UNSETTLED;
use masc.build.refusal.UNSITED;
use masc.build.refusal.about;
use masc.build.refusal.encoding;
use masc.build.refusal.held;
use masc.build.refusal.memory;
