# the encoding of a settled layout: every fragment's bytes, the relocations it needs and the differences it measures
#
# a datum, a symbol's address or distance as data, folds or relocates
# by the rule an instruction's fixup does. a difference of labels is a
# deferred value: whatever the source has placed when it is written, the
# layout measures it once both labels are placed, and it folds, relocates by
# the set's pair for its encoding or is refused at finish naming its label. a
# fixed-width one is its width long, and a leb128 starts empty and is as
# long as its value needs, measured each pass.
# a leb128 only grows, padded with continuation bytes when its value shrinks,
# so it settles with the instructions and adds at most a leb128's longest to
# the bound of passes. code alignment after an
# instruction the linker may resize pads its worst case and carries the set's
# realign marker, so the linker can shrink it back. a fixup whose relocation
# covers instructions after its own, as a call pair's, is written only in a
# sequence that holds them, with the marker the set's span states beside it.
use masc.codec.walk;
use masc.core.field;
use masc.core.fill;
use core_fixup: masc.core.fixup;
use masc.core.inst;
use masc.core.mode;
use masc.core.operand;
use masc.core.relax;
use masc.core.row;
use mink.base.fail;
use mink.format.registry;
use mink.model.reloc;
use mink_row: mink.reloc.row;
use std.collections.vector;
use std.encoding.leb128;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use masc.build.layout.distance;
use masc.build.layout.form;
use masc.build.layout.laid;
use masc.build.layout.leb_size;
use masc.build.layout.lengthen;
use masc.build.layout.pad;
use masc.build.layout.place;
use masc.build.layout.realigned;
use masc.build.layout.spans;
use masc.build.layout.spread;
use masc.build.refusal.CYCLE;
use masc.build.refusal.DATUM_RANGE;
use masc.build.refusal.LOCAL_ONLY;
use masc.build.refusal.NO_PAIR;
use masc.build.refusal.NO_RELOCATION;
use masc.build.refusal.Refusal;
use masc.build.refusal.SHRANK;
use masc.build.refusal.UNBOUND;
use masc.build.refusal.UNRESOLVED;
use masc.build.refusal.UNSETTLED;
use masc.build.refusal.UNSITED;
use masc.build.refusal.about;
use masc.build.refusal.encoding;
use masc.build.refusal.held;
use masc.build.refusal.memory;
use masc.build.refusal.refused;
use masc.build.state.Aim;
use masc.build.state.Aimed;
use masc.build.state.Align;
use masc.build.state.Area;
use masc.build.state.Builder;
use masc.build.state.Code;
use masc.build.state.Coded;
use masc.build.state.Datum;
use masc.build.state.Entry;
use masc.build.state.Formed;
use masc.build.state.Fragment;
use masc.build.state.Gap;
use masc.build.state.Measured;
use masc.build.state.Pending;
use masc.build.state.Realigned;
use masc.build.state.Spread;
use masc.build.state.coded;
use masc.build.state.datum_slot;
use masc.build.state.fits;
use masc.build.state.kind_of;
use masc.build.state.known;
use masc.build.state.modes_at;
use masc.build.state.offset_at;
use masc.build.state.ordered;
use masc.build.state.pair_slot;
use masc.build.state.preemptible;
use masc.build.state.settled;
use masc.build.state.through;
use masc.build.state.written_kind;

# what a relocation of kind `kind` adds to the symbol's addend for the field `offset` bytes into a step of row `r` and
# `length` bytes that operand `k` fixes: for a distance from the program counter the field's offset from the operand's
# anchor, since the relocation's place is the field, as R_X86_64_PC32 `ext - 4` for a field two bytes into a six byte
# instruction, else nothing
pub fun bias(r: *row.Row, length: usize, k: usize, offset: usize, kind: *reloc.Kind) i64 {
    if (!reloc.has(kind, reloc.PC)) { ret 0; }
    var from: i64 = offset::i64;
    if (operand.anchor_of(?r.operands.at[k]) == operand.END) { from = from - length::i64; }
    ret from;
}

# the relocations of the fixups of one step of row `r` and `length` bytes, encoded at `at` of section `s`
fun relocations(b: *Builder, s: u32, at: u64, r: *row.Row, length: usize, marks: usize, marker: operand.FixupKind) err[Refusal] {
    var i: usize = marks;
    for (i < b.fixups.len) {
        val fx:   *field.Fixup = ?b.fixups.data[i];
        val kind: *reloc.Kind  = kind_of(b, written_kind(b, fx.kind, fx.addend));
        if (kind == nil && core_fixup.local(b.set.locals, fx.kind)) { ret about(LOCAL_ONLY, fx.symbol); }
        if (kind == nil)                                            { ret about(UNBOUND, fx.symbol); }
        val aimed: opt[Aimed] = through(b, fx.symbol, fx.addend, false);
        if (sel aimed.none)                                   { ret about(CYCLE, fx.symbol); }
        if (!known(?b.labels.data[aimed.some.id::usize - 1])) { ret about(UNRESOLVED, fx.symbol); }
        val pended: err[Refusal] = pend(b, Pending{section: s, offset: at + fx.offset::u64, kind: kind, aim: Aim.label{aimed.some.id}, addend: aimed.some.addend + bias(r, length, fx.operand::usize, fx.offset, kind)}, fx.symbol);
        if (sel pended.err) { ret pended; }
        i = i + 1;
    }
    vector.truncate[field.Fixup](?b.fixups, marks);
    if (marker != operand.NO_FIXUP) {
        val kind: *reloc.Kind = kind_of(b, marker);
        if (kind == nil) { ret refused(UNBOUND); }
        val pended: err[Refusal] = pend(b, Pending{section: s, offset: at, kind: kind, aim: Aim.nothing{}, addend: 0}, operand.NO_SYMBOL);
        if (sel pended.err) { ret pended; }
    }
    ret err[Refusal].ok{};
}

# datum `d` at `offset` of section `s`, its value written when it folds, else zeros and a relocation
fun encode_datum(b: *Builder, s: u32, j: u32, area: *Area, d: *Datum, offset: u64) err[Refusal] {
    val width: usize = d.ref.width::usize;
    if (!held(vector.reserve[u8](?area.bytes, width))) { ret err[Refusal].err{memory()}; }
    var value:  u64      = 0;
    val folded: opt[i64] = distance(b, s, j, d.ref.target.id, d.ref.addend, d.fixup);
    if (sel folded.some) {
        if (width < 8) {
            val half: i64 = 1::i64 << (width * 8 - 1)::i64;
            if (folded.some < -half || folded.some >= half) { ret about(DATUM_RANGE, d.ref.target.id); }
        }
        value = folded.some:~u64;
    }
    or {
        val kind: *reloc.Kind = kind_of(b, d.fixup);
        if (kind == nil) { ret about(UNBOUND, d.ref.target.id); }
        val pushed: err[Refusal] = aim(b, s, offset, kind, d.ref.target.id, d.ref.addend);
        if (sel pushed.err) { ret pushed; }
    }
    ordered(b, value, width, ?area.bytes.data[area.bytes.len]);
    vector.commit[u8](?area.bytes, width);
    ret err[Refusal].ok{};
}

# a relocation of kind `kind` at `offset` of section `s` naming what label `id` plus `addend` stands for
pub fun aim(b: *Builder, s: u32, offset: u64, kind: *reloc.Kind, id: u32, addend: i64) err[Refusal] {
    val aimed: opt[Aimed] = through(b, id, addend, false);
    if (sel aimed.none)                                   { ret about(CYCLE, id); }
    if (!known(?b.labels.data[aimed.some.id::usize - 1])) { ret about(UNRESOLVED, id); }
    ret pend(b, Pending{section: s, offset: offset, kind: kind, aim: Aim.label{aimed.some.id}, addend: aimed.some.addend}, id);
}

# relocation `p` of the last encode, refused naming `label`, the kind and the format where the object's format maps no
# relocation of its kind for the architecture, as coff has no 8-bit absolute relocation for x86_64
fun pend(b: *Builder, p: Pending, label: u32) err[Refusal] {
    var why: opt[fail.Fail] = opt[fail.Fail].none{};
    if (sel b.relocs.ok) {
        var rows: registry.Relocations = b.relocs.ok;
        if (p.minus != 0) {
            val pairing: res[*mink_row.Pairing, fail.Fail] = mink_row.difference_of(rows.rows, p.kind);
            if (sel pairing.err) { why = opt[fail.Fail].some{fail.about(fail.in_record(fail.unsupported(pairing.err.text), b.format.name), p.kind.name)}; }
        }
        or {
            val row_: res[*registry.Row, fail.Fail] = registry.relocation_by_kind(?rows, p.kind);
            if (sel row_.err) { why = opt[fail.Fail].some{fail.about(fail.in_record(fail.unsupported(row_.err.text), b.format.name), p.kind.name)}; }
        }
    }
    or (sel b.relocs.err)                           { why = opt[fail.Fail].some{b.relocs.err}; }
    if (sel why.some)                               { ret err[Refusal].err{Refusal{message: NO_RELOCATION, label: label, object: why}}; }
    if (!held(vector.push[Pending](?b.pending, p))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# whether fixup kind `fixup` is bound on the architecture to a relocation kind the object's format maps, any bound one
# for a format of no relocation rows, which `pend` refuses as it refuses every other
fun maps(b: *Builder, fixup: operand.FixupKind) bool {
    if (fixup == operand.NO_FIXUP) { ret false; }
    val kind: *reloc.Kind = kind_of(b, fixup);
    if (kind == nil)      { ret false; }
    if (sel b.relocs.err) { ret true; }
    var rows: registry.Relocations          = b.relocs.ok;
    val row_: res[*registry.Row, fail.Fail] = registry.relocation_by_kind(?rows, kind);
    ret sel row_.ok;
}

# the neutral difference kind of `width` bytes the object's format writes by a difference row of its own, as mach-o's
# subtractor pair, nil for none
fun difference_kind(b: *Builder, width: u8) *reloc.Kind {
    if (sel b.relocs.err) { ret nil; }
    var k: *reloc.Kind = nil;
    if (width == 1) { k = ?reloc.DIFF8; }
    if (width == 2) { k = ?reloc.DIFF16; }
    if (width == 4) { k = ?reloc.DIFF32; }
    if (width == 8) { k = ?reloc.DIFF64; }
    if (k == nil)   { ret nil; }
    var rows:  registry.Relocations              = b.relocs.ok;
    val found: res[*mink_row.Pairing, fail.Fail] = mink_row.difference_of(rows.rows, k);
    if (sel found.err) { ret nil; }
    ret k;
}

# a relocation of difference kind `kind` at `offset` of section `s` naming what label `id` plus `addend` stands for less
# what label `minus` stands for
fun aim_less(b: *Builder, s: u32, offset: u64, kind: *reloc.Kind, id: u32, addend: i64, minus: u32) err[Refusal] {
    val aimed: opt[Aimed] = through(b, id, addend, false);
    val less:  opt[Aimed] = through(b, minus, 0, false);
    if (sel aimed.none)                                   { ret about(CYCLE, id); }
    if (sel less.none)                                    { ret about(CYCLE, minus); }
    if (!known(?b.labels.data[aimed.some.id::usize - 1])) { ret about(UNRESOLVED, id); }
    if (!known(?b.labels.data[less.some.id::usize - 1]))  { ret about(UNRESOLVED, minus); }
    ret pend(b, Pending{section: s, offset: offset, kind: kind, aim: Aim.label{aimed.some.id}, addend: aimed.some.addend - less.some.addend, minus: less.some.id}, id);
}

# difference `g` at `offset` of section `s`, measured as `d`, as the relocations of the set's pair of its encoding and
# width, the added label's then the subtracted one's
fun pair_of(b: *Builder, s: u32, offset: u64, g: *Gap, d: *Spread) err[Refusal] {
    val slot: usize       = pair_slot(g.encoding, g.width);
    val add:  *reloc.Kind = kind_of(b, b.adds[slot]);
    val sub:  *reloc.Kind = kind_of(b, b.subs[slot]);
    if (b.adds[slot] == operand.NO_FIXUP || b.subs[slot] == operand.NO_FIXUP || add == nil || sub == nil) { ret about(NO_PAIR, g.of.plus.id); }
    val added: err[Refusal] = aim(b, s, offset, add, d.plus.id, d.plus.addend);
    if (sel added.err) { ret added; }
    ret aim(b, s, offset, sub, d.minus.id, 0);
}

# `value` appended to `area` as a leb128 of `size` bytes, signed when `how` is SLEB, padded past its shortest
# with continuation bytes when an earlier pass grew it: 0x80 then 0x00 for an unsigned or
# nonnegative value, 0xff then 0x7f for a negative one
fun put_leb(area: *Area, how: core_fixup.Encoding, value: i64, size: u64) {
    var bytes: [10]u8;
    var n:     usize = 0;
    if (how == core_fixup.SLEB) { n = leb128.put_signed(?bytes[0], value); }
    or                          { n = leb128.put_unsigned(?bytes[0], value:~u64); }
    if (n::u64 < size) {
        var pad: u8 = 0x00;
        if (how == core_fixup.SLEB && value < 0) { pad = 0x7f; }
        bytes[n - 1] = bytes[n - 1] | 0x80;
        for (n::u64 < size - 1) {
            bytes[n] = pad | 0x80;
            n        = n + 1;
        }
        bytes[n] = pad;
        n        = n + 1;
    }
    var i: usize = 0;
    for (i < n) {
        area.bytes.data[area.bytes.len] = bytes[i];
        vector.commit[u8](?area.bytes, 1);
        i = i + 1;
    }
}

# difference `g` of `size` bytes at `offset`, fragment `j` of section `s`: its value when it folds, else its
# relocations, and zeros in a fixed width or the value the layout measured in a leb128 the linker sets. a difference
# whose subtracted label lies in the datum's own section and whose added label lies in another is the added label less
# a place of the datum's section: the set's pair of the encoding and width where it has one, which the linker resolves
# wherever the labels are, else its place-relative datum of the width against the added label, its addend the
# distance from the subtracted label to the datum, which no instruction the linker may resize lies within
fun encode_difference(b: *Builder, s: u32, j: u32, area: *Area, g: *Gap, offset: u64, size: u64) err[Refusal] {
    if (!held(vector.reserve[u8](?area.bytes, size::usize))) { ret err[Refusal].err{memory()}; }
    val m: res[Spread, Refusal] = spread(b, g);
    if (sel m.err) { ret err[Refusal].err{m.err}; }
    val d:      *Spread = ?m.ok;
    val leb:    bool    = g.encoding != core_fixup.FIXED;
    val own:    bool    = d.q.defined && d.q.section == s && d.q.fragment == j;
    var value:  i64     = 0;
    var folded: bool    = false;
    # a distance from the datum's own place to a symbol other objects may preempt is the linker's
    if (d.shared && (leb || !(own && preemptible(d.p)))) {
        if (settled(?b.areas.data[d.p.section::usize], d.p.fragment, d.q.fragment)) {
            if (!leb && !fits(d.value, g.width::usize)) { ret about(DATUM_RANGE, g.of.plus.id); }
            value  = d.value;
            folded = true;
        }
    }
    if (!folded) {
        val relative: operand.FixupKind = b.data_kind[datum_slot(core_fixup.RELATIVE, g.width)];
        val mapped:   bool              = maps(b, relative);
        if (!leb && own && mapped) {
            val kind: *reloc.Kind = kind_of(b, relative);
            if (kind == nil) { ret about(UNBOUND, g.of.plus.id); }
            val pushed: err[Refusal] = aim(b, s, offset, kind, d.plus.id, d.plus.addend);
            if (sel pushed.err) { ret pushed; }
        }
        or (d.shared) {
            val paired: err[Refusal] = pair_of(b, s, offset, g, d);
            if (sel paired.err) { ret paired; }
            if (leb)            { value = d.value; }
        }
        or (!leb && d.q.defined && d.q.section == s) {
            val slot:  usize       = pair_slot(g.encoding, g.width);
            val diff_: *reloc.Kind = difference_kind(b, g.width);
            if (b.adds[slot] != operand.NO_FIXUP && b.subs[slot] != operand.NO_FIXUP) {
                val paired: err[Refusal] = pair_of(b, s, offset, g, d);
                if (sel paired.err) { ret paired; }
            }
            or (diff_ != nil) {
                val pushed: err[Refusal] = aim_less(b, s, offset, diff_, d.plus.id, d.plus.addend, d.minus.id);
                if (sel pushed.err) { ret pushed; }
            }
            or {
                if (!mapped || !settled(area, d.q.fragment, j)) { ret about(UNSITED, g.of.plus.id); }
                val kind: *reloc.Kind = kind_of(b, relative);
                if (kind == nil) { ret about(UNBOUND, g.of.plus.id); }
                val from:   i64          = offset:~i64 - offset_at(area, d.q.fragment):~i64;
                val pushed: err[Refusal] = aim(b, s, offset, kind, d.plus.id, d.plus.addend + from);
                if (sel pushed.err) { ret pushed; }
            }
        }
        or { ret about(UNSITED, g.of.plus.id); }
    }
    if (leb) {
        if (leb_size(g.encoding, value) > size) { ret about(UNSETTLED, g.of.plus.id); }
        put_leb(area, g.encoding, value, size);
        ret err[Refusal].ok{};
    }
    ordered(b, value:~u64, g.width::usize, ?area.bytes.data[area.bytes.len]);
    vector.commit[u8](?area.bytes, g.width::usize);
    ret err[Refusal].ok{};
}

# the state of one layout pass's encoding
# ---
# keep:    whether the layout keeps the encoding of the pass that settles
# changed: whether a fragment grew in this pass, so the pass does not settle and its encoding is not kept
# refusal: the first refusal of this pass's encoding, which refuses the layout when the pass settles
# stopped: a refusal that refuses the layout at once, whatever the pass comes to
# lead:    the line of the first instruction of the sequence being written
# group:   how many lines that sequence holds
# left:    how many of its lines are still to be written
rec Pass {
    keep:    bool;
    changed: bool;
    refusal: opt[Refusal];
    stopped: opt[Refusal];
    lead:    usize;
    group:   u32;
    left:    u32;
}

# the layout refused with `why`, which `lay` answers at the fragment that stopped it
fun stop(p: *Pass, why: Refusal) {
    p.stopped = opt[Refusal].some{why};
}

# whether the pass is still writing: its encoding is kept, nothing grew and nothing was refused, so it may be the one
# that settles
fun writing(p: *Pass) bool {
    ret p.keep && !p.changed && sel p.refusal.none;
}

# refusal `e` of the pass's encoding taken as its first, which stops it writing
fun refuse_later(p: *Pass, e: err[Refusal]) {
    val first: bool = sel p.refusal.none;
    if (sel e.err) {
        if (first) { p.refusal = opt[Refusal].some{e.err}; }
    }
}

# every section laid out until no instruction or leb128 grows, the pass that settles leaving every section's bytes,
# relocations and encoded instructions when `keep`. an instruction only grows, by a longer form, and grows at most as
# often as its row's chain of relaxations is long, and a leb128 only grows, at most to its longest, so the passes are
# bounded by one more than the sum of those chains and of each leb128's longest, and a layout past the bound is
# refused. each pass encodes its fragments as it settles them until one grows, and an encoding refused before then
# refuses the layout only when no fragment grows after it
pub fun lay(b: *Builder, keep: bool) err[Refusal] {
    var out:   relax.Expansion;
    var bound: u32   = 1;
    var s:     usize = 0;
    for (s < b.areas.len) {
        var j: usize = 0;
        for (j < b.areas.data[s].fragments.len) {
            val f: *Fragment = ?b.areas.data[s].fragments.data[j];
            if (sel f.body.code) {
                val c: *Code = ?f.body.code;
                if (sel c.relax.some) { bound = bound + relax.depth(b.set.relax, b.set.codec, coded(?c.of)); }
            }
            or (sel f.body.difference) {
                if (f.body.difference.encoding != core_fixup.FIXED) { bound = bound + leb128.MAX_BYTES::u32; }
            }
            j = j + 1;
        }
        s = s + 1;
    }
    b.passes = 0;
    for {
        if (b.passes >= bound) { ret refused(UNSETTLED); }
        b.passes = b.passes + 1;
        vector.truncate[Realigned](?b.realigns, 0);
        s = 0;
        for (s < b.areas.len) {
            val placed: err[Refusal] = place(b, ?b.areas.data[s], s::u32);
            if (sel placed.err) { ret placed; }
            s = s + 1;
        }
        vector.truncate[Pending](?b.pending, 0);
        vector.truncate[Entry](?b.entries, 0);
        vector.truncate[operand.Value](?b.listed, 0);
        var p: Pass = Pass{keep: keep, changed: false, refusal: opt[Refusal].none{}, stopped: opt[Refusal].none{}, lead: 0, group: 1, left: 0};
        s = 0;
        for (s < b.areas.len) {
            vector.truncate[u8](?b.areas.data[s].bytes, 0);
            var j: usize = 0;
            for (j < b.areas.data[s].fragments.len) {
                put(b, s::u32, j::u32, ?out, ?p);
                if (sel p.stopped.some) { ret err[Refusal].err{p.stopped.some}; }
                j = j + 1;
            }
            s = s + 1;
        }
        if (!p.changed) {
            if (sel p.refusal.some) { ret err[Refusal].err{p.refusal.some}; }
            brk;
        }
    }
    ret err[Refusal].ok{};
}

# fragment `j` of section `s` grown as far as its target needs, its length reserved, marking the pass changed when
# either changed, and its bytes, relocations and lines written while the pass is writing, stopping the pass only where
# the layout is refused
fun put(b: *Builder, s: u32, j: u32, out: *relax.Expansion, p: *Pass) {
    val area: *Area     = ?b.areas.data[s::usize];
    val f:    *Fragment = ?area.fragments.data[j::usize];
    if (sel f.body.code) {
        val c: *Code = ?f.body.code;
        if (c.plain) {
            put_plain(b, s, f, c, p);
            ret;
        }
        for {
            val far: res[bool, Refusal] = form(b, s, j, c, out);
            if (sel far.err) {
                stop(p, far.err);
                ret;
            }
            if (!far.ok) { brk; }
            c.depth   = c.depth + 1;
            p.changed = true;
        }
        val coded_: opt[Formed] = put_code(b, s, j, f, c, out, p);
        if (sel coded_.none) { ret; }
        if (coded_.some.size > f.size) {
            f.size    = coded_.some.size;
            p.changed = true;
        }
        if (coded_.some.marked && !c.marked) {
            c.marked  = true;
            p.changed = true;
        }
        if (writing(p) && coded_.some.size != f.size) { refuse_later(p, refused(SHRANK)); }
        ret;
    }
    if (sel f.body.difference && lengthen(b, f, ?f.body.difference)) { p.changed = true; }
    if (!writing(p))                                                 { ret; }
    if (sel f.body.data) {
        if (!held(vector.reserve[u8](?area.bytes, f.body.data.len))) {
            stop(p, memory());
            ret;
        }
        var i: usize = 0;
        for (i < f.body.data.len) {
            area.bytes.data[area.bytes.len] = b.data.data[f.body.data.start + i];
            vector.commit[u8](?area.bytes, 1);
            i = i + 1;
        }
    }
    or (sel f.body.zero) {
        if (area.bits) {
            if (!held(vector.reserve[u8](?area.bytes, f.body.zero::usize))) {
                stop(p, memory());
                ret;
            }
            var i: u64 = 0;
            for (i < f.body.zero) {
                area.bytes.data[area.bytes.len] = 0;
                vector.commit[u8](?area.bytes, 1);
                i = i + 1;
            }
        }
    }
    or (sel f.body.align) {
        if (area.bits) {
            var al: Align = f.body.align;
            if (realigned(area, j::usize, ?al)) {
                # the padding is the code fill whatever the alignment asked, and the marker tells the linker its length
                al.fill = opt[u8].none{};
                if (f.size > 0) {
                    val kind: *reloc.Kind = kind_of(b, b.set.realign);
                    if (kind == nil) { refuse_later(p, refused(UNBOUND)); }
                    or               { refuse_later(p, pend(b, Pending{section: s, offset: f.offset, kind: kind, aim: Aim.nothing{}, addend: f.size:~i64}, operand.NO_SYMBOL)); }
                }
            }
            refuse_later(p, pad(b, area, ?al, f.view, f.size));
        }
    }
    or (sel f.body.datum)      { refuse_later(p, encode_datum(b, s, j, area, ?f.body.datum, f.offset)); }
    or (sel f.body.difference) { refuse_later(p, encode_difference(b, s, j, area, ?f.body.difference, f.offset, f.size)); }
}

# plain code fragment `f` of section `s`, which nothing of the layout moves, so a pass that is not writing passes over it
# and one that is writes the encoding made when it was emitted, which nothing since changes
fun put_plain(b: *Builder, s: u32, f: *Fragment, c: *Code, p: *Pass) {
    if (!writing(p)) { ret; }
    val area: *Area = ?b.areas.data[s::usize];
    val size: usize = c.initial::usize;
    if (!held(vector.reserve[u8](?area.bytes, size))) {
        stop(p, memory());
        ret;
    }
    val to:   *u8   = ?area.bytes.data[area.bytes.len];
    val from: *u8   = ?b.plains.data[c.encoded];
    var i:    usize = 0;
    for (i < size) {
        to[i] = from[i];
        i     = i + 1;
    }
    vector.commit[u8](?area.bytes, size);
    if (c.run > 0) { lead(b, c, p); }
    var run: u32 = 0;
    if (p.group == 1) { run = 1; }
    val of:   *row.Row  = coded(?c.of);
    var step: inst.Inst = inst.Inst{row: of, values: ?b.values.data[c.values], count: c.count, form: c.form};
    if (c.marker != operand.NO_FIXUP) {
        val rels: err[Refusal] = relocations(b, s, f.offset, of, size, b.fixups.len, c.marker);
        refuse_later(p, rels);
        if (sel rels.err) { ret; }
    }
    if (!listed(b, s, f.offset, size, c.of, ?step, run)) {
        stop(p, memory());
        ret;
    }
    wrote(b, p);
}

# the sequence code fragment `c` starts, under way in the pass `p`
fun lead(b: *Builder, c: *Code, p: *Pass) {
    p.lead  = b.entries.len;
    p.group = c.run;
    p.left  = p.group;
}

# step `ins` of `of`, written `length` bytes long at `at` of section `s`, and its values, added to the lines of the
# pass, false when they could not grow
fun listed(b: *Builder, s: u32, at: u64, length: usize, of: Coded, ins: *inst.Inst, run: u32) bool {
    if (!held(vector.reserve[operand.Value](?b.listed, ins.count::usize))) { ret false; }
    val first: usize = b.listed.len;
    var k:     u32   = 0;
    for (k < ins.count) {
        b.listed.data[b.listed.len] = ins.values[k];
        vector.commit[operand.Value](?b.listed, 1);
        k = k + 1;
    }
    val entry: Entry = Entry{section: s, offset: at, length: length::u64, of: of, values: first, count: ins.count, run: run, form: ins.form};
    ret held(vector.push[Entry](?b.entries, entry));
}

# one instruction of the sequence under way written: the first line of a sequence counts the lines its instructions wrote
fun wrote(b: *Builder, p: *Pass) {
    p.left = p.left - 1;
    if (p.left == 0 && p.group > 1) { b.entries.data[p.lead].run = (b.entries.len - p.lead)::u32; }
}

# step `ins`, `into` bytes into code fragment `j` of section `s` and encoded as the `len` bytes at `begin` of the
# section's, written again with each operand the layout lays out but leaves to the linker holding its distance from the
# step's anchor (`laid`)
fun show(b: *Builder, s: u32, j: u32, f: *Fragment, ins: *inst.Inst, begin: usize, into: usize, len: usize) err[field.Refusal] {
    var values: [row.MAX_OPERANDS]operand.Value;
    var any:    bool = false;
    var k:      u32  = 0;
    for (k < ins.count) {
        values[k] = ins.values[k];
        val d: opt[i64] = laid(b, s, j, ins.row, k, ?ins.values[k]);
        if (sel d.some) {
            var dist: i64 = d.some - into::i64;
            if (operand.anchor_of(?ins.row.operands.at[k]) == operand.END) { dist = dist - len::i64; }
            values[k] = operand.resolved(?ins.values[k], dist);
            any       = true;
        }
        k = k + 1;
    }
    if (!any) { ret err[field.Refusal].ok{}; }
    var shown: inst.Inst = inst.Inst{row: ins.row, values: ?values[0], count: ins.count, form: ins.form};
    ret walk.rewrite(b.set.codec, f.view, ?shown, ?b.areas.data[s::usize].bytes, begin, len, ?b.fixups);
}

# the steps of `out`, the form `c` of code fragment `f` of section `s`, encoded with what they come to, each carrying the
# marker its span states under the modes the fragment was written under: into the section's bytes with their
# relocations and lines while the pass is writing, else measured in scratch, none when the pass is stopped
fun put_code(b: *Builder, s: u32, j: u32, f: *Fragment, c: *Code, out: *relax.Expansion, p: *Pass) opt[Formed] {
    val area:  *Area              = ?b.areas.data[s::usize];
    val modes: *mode.State        = modes_at(b, f);
    val kept:  bool               = writing(p);
    var write: bool               = kept;
    var bytes: *vector.Vector[u8] = ?b.scratch;
    if (kept)              { bytes = ?area.bytes; }
    if (kept && c.run > 0) { lead(b, c, p); }
    var run: u32 = 0;
    if (p.group == 1) { run = 1; }
    val start:  usize = bytes.len;
    var marked: bool  = false;
    var i:      u32   = 0;
    for (i < out.count) {
        val n:     u32                       = out.steps[i].row.operands.len;
        var step:  inst.Inst                 = inst.Inst{row: out.steps[i].row, values: ?out.steps[i].values[0], count: n, form: out.steps[i].form};
        val begin: usize                     = bytes.len;
        val marks: usize                     = b.fixups.len;
        val done:  res[usize, field.Refusal] = walk.encode(b.set.codec, f.view, ?step, bytes, ?b.fixups);
        if (sel done.err) {
            vector.truncate[field.Fixup](?b.fixups, marks);
            if (!kept) { vector.truncate[u8](?b.scratch, start); }
            stop(p, encoding(done.err));
            ret opt[Formed].none{};
        }
        if (kept) {
            val shown: err[field.Refusal] = show(b, s, j, f, ?step, begin, begin - start, done.ok);
            if (sel shown.err) {
                vector.truncate[field.Fixup](?b.fixups, marks);
                stop(p, encoding(shown.err));
                ret opt[Formed].none{};
            }
        }
        if (out.steps[i].marker == operand.NO_FIXUP) {
            var got: Measured = Measured{len: done.ok, split: operand.NO_SYMBOL, marker: operand.NO_FIXUP};
            spans(b, modes, marks, relax.MAX_STEPS, ?got);
            out.steps[i].marker = got.marker;
        }
        marked = marked || out.steps[i].marker != operand.NO_FIXUP;
        val at: u64 = f.offset + (begin - start)::u64;
        if (write) {
            val rels: err[Refusal] = relocations(b, s, at, out.steps[i].row, done.ok, marks, out.steps[i].marker);
            refuse_later(p, rels);
            write = !sel rels.err;
        }
        vector.truncate[field.Fixup](?b.fixups, marks);
        if (write) {
            var of: Coded = Coded.catalog{out.steps[i].row};
            if (sel c.of.format) { of = c.of; }
            if (!listed(b, s, at, done.ok, of, ?step, run)) {
                stop(p, memory());
                ret opt[Formed].none{};
            }
        }
        i = i + 1;
    }
    val size: u64 = (bytes.len - start)::u64;
    if (!kept) { vector.truncate[u8](?b.scratch, start); }
    if (write) { wrote(b, p); }
    ret opt[Formed].some{Formed{size: size, marked: marked}};
}
