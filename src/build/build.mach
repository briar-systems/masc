# a builder over the x86-shaped set, the risc-v set's catalog, modes and traits under it
#[testing]
fun t_make_x86(t: *T) bool {
    if (!t_open(t, "rv64i")) { ret false; }
    val a: *A.Allocator = testing.allocator_of(?t.t);
    t.x          = riscv_set.SET;
    t.x.codec    = ?T_X86_CODEC;
    t.x.bindings = core_fixup.Bindings{at: ?T_X86_BINDINGS[0], len: 1};
    t.x.relax    = relax.Relaxations{at: ?T_X86_RELAXATIONS[0], len: 1, keys: index.Index{at: ?T_X86_RELAX_KEYS[0], len: 1}};
    t.x.compress = compress.NO_COMPRESSIONS;
    t.x.spans    = core_fixup.NO_SPANS;
    t.x.data     = core_fixup.NO_DATA;
    val built: res[Builder, Refusal] = make(a, ?t.formats, ?t.x, ?t.ctx, ?arch_riscv.RISCV64, ?mink_format.ELF);
    if (sel built.err) { ret false; }
    t.b = built.ok;
    val named: err[Refusal] = traits(?t.b, ?arch_riscv.RISCV_LP64D);
    if (sel named.err) { ret false; }
    ret true;
}

# row `at` of the x86-shaped set with the values `x` and `y`, of which it takes as many as it has operands, emitted
#[testing]
fun t_emit_x86(t: *T, at: u32, x: operand.Value, y: operand.Value) bool {
    val r:      *row.Row         = ?T_X86_ROWS[at];
    var values: [2]operand.Value = [2]operand.Value{x, y};
    var ins:    inst.Inst        = inst.Inst{row: r, values: ?values[0], count: r.operands.len};
    val done:   err[Refusal]     = emit(?t.b, ?ins, operand.NO_FIXUP);
    ret sel done.ok;
}

# a rip-relative address of label `l`
#[testing]
fun t_rip(l: Label) operand.Value {
    ret operand.Value.memory{operand.Address{base: register.NONE, index: register.NONE, scale: 0, disp: 0, segment: register.NONE, mode: operand.RELATIVE_PC, symbol: operand.Symbol{id: l.id, addend: 0, fixup: operand.NO_FIXUP}}};
}

# an abi row of riscv64 that states nothing, which mink's catalog has no row like
#[testing]
val T_NO_CONVENTION: mink_arch.Abi = mink_arch.Abi{name: "none", arch: ?arch_riscv.RISCV64, settings: nil, count: 0};

# a code section named `name`, made current
#[testing]
fun t_text(t: *T, name: str) Section {
    val s: res[Section, Refusal] = open(?t.b, Spec{name: opt[str].some{name}, kind: ?mink_section.TEXT, flags: mink_section.TEXT.flags, disposition: ?mink_section.WHOLE});
    if (sel s.err) { ret Section{index: 0xFFFF_FFFF}; }
    switch(?t.b, s.ok);
    ret s.ok;
}

# the first row spelled `mnemonic`
#[testing]
fun t_row(mnemonic: str) *row.Row {
    var i: u32 = 0;
    for (i < riscv_catalog.CODEC.rows.len) {
        if (str_equals(riscv_catalog.CODEC.rows.at[i].mnemonic, mnemonic)) { ret ?riscv_catalog.CODEC.rows.at[i]; }
        i = i + 1;
    }
    ret nil;
}

#[testing]
fun t_reg(n: u16) operand.Value {
    ret operand.Value.register{register.make(0, n)};
}

# `mnemonic` with the values `x`, `y` and `z`, of which it takes as many as it has operands, emitted
#[testing]
fun t_emit(t: *T, mnemonic: str, x: operand.Value, y: operand.Value, z: operand.Value) bool {
    val r:      *row.Row         = t_row(mnemonic);
    var values: [3]operand.Value = [3]operand.Value{x, y, z};
    var ins:    inst.Inst        = inst.Inst{row: r, values: ?values[0], count: r.operands.len};
    val done:   err[Refusal]     = emit(?t.b, ?ins, operand.NO_FIXUP);
    ret sel done.ok;
}

# the bytes `mnemonic` with the values given encodes to, appended to `out`
#[testing]
fun t_encode(t: *T, mnemonic: str, x: operand.Value, y: operand.Value, z: operand.Value, out: *vector.Vector[u8]) bool {
    val r:      *row.Row                   = t_row(mnemonic);
    var values: [3]operand.Value           = [3]operand.Value{x, y, z};
    var ins:    inst.Inst                  = inst.Inst{row: r, values: ?values[0], count: r.operands.len};
    var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](testing.allocator_of(?t.t));
    val done:   res[usize, field.Refusal]  = walk.encode(?riscv_catalog.CODEC, ?t.ctx, ?ins, out, ?fixups);
    vector.dnit[field.Fixup](?fixups);
    ret sel done.ok;
}

# the bytes of section `index` of `o`
#[testing]
fun t_bytes(o: *mink_object.Object, index: u32) store.Bytes {
    ret mink_object.bytes(o, ?mink_object.section_at(o, table.Id[mink_object.Section]{index: index}).contents);
}

# whether `n` bytes of `got` from `at` are `want`
#[testing]
fun t_same(got: store.Bytes, at: usize, want: *u8, n: usize) bool {
    if (at + n > got.len) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (got.data[at + i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun t_reloc(o: *mink_object.Object, i: usize) *mink_object.Reloc {
    ret ?o.relocs.items[i];
}

#[testing]
fun t_symbol(o: *mink_object.Object, id: table.Id[mink_object.Symbol]) *mink_object.Symbol {
    ret mink_object.symbol_at(o, id);
}

# the symbol relocation `r` names, nil when it names an entry
#[testing]
fun t_named_by(o: *mink_object.Object, r: *mink_object.Reloc) *mink_object.Symbol {
    if (sel r.target.symbol) { ret mink_object.symbol_at(o, r.target.symbol); }
    ret nil;
}

# whether `sym` is placed at `offset` of section `section`
#[testing]
fun t_placed(sym: *mink_object.Symbol, section: u32, offset: u64) bool {
    if (!sel sym.def.placed) { ret false; }
    ret sym.def.placed.section.index == section && sym.def.placed.offset == offset;
}

#[testing]
fun t_ok(e: err[Refusal]) bool {
    ret sel e.ok;
}

# a new anonymous label, id NO_SYMBOL when refused, which every later use refuses
#[testing]
fun t_anon(t: *T) Label {
    val l: res[Label, Refusal] = anonymous(?t.b);
    if (sel l.err) { ret Label{id: operand.NO_SYMBOL}; }
    ret l.ok;
}

# the label named `name`, id NO_SYMBOL when refused
#[testing]
fun t_named(t: *T, name: str) Label {
    val l: res[Label, Refusal] = label(?t.b, name);
    if (sel l.err) { ret Label{id: operand.NO_SYMBOL}; }
    ret l.ok;
}

#[testing]
val T_GLOBAL: Exposure = Exposure{binding: ?mink_symbol.GLOBAL, visibility: ?mink_symbol.DEFAULT, kind: ?mink_symbol.FUNCTION};

#[testing]
fun t_done(t: *T, o: *mink_object.Object) bool {
    mink_object.release(o);
    release(?t.b);
    register.release(?t.v);
    extension.release(?t.s);
    val released: err[fail.Fail] = registry.release(?t.formats);
    ret !sel released.err && testing.live_count(?t.t) == 0;
}

# `o` written to ELF bytes in memory and read back through mink's registry into the empty neutral object `back`
#[testing]
fun t_through_elf(t: *T, o: *mink_object.Object, back: *mink_object.Object) bool {
    val a:    *A.Allocator                   = testing.allocator_of(?t.t);
    val made: res[contract.Model, fail.Fail] = registry.from_neutral(?t.formats, ?mink_format.ELF, a, o);
    if (sel made.err) { ret false; }
    var m:        contract.Model            = made.ok;
    val w:        res[sink.Sink, fail.Fail] = contract.write(?m);
    val released: err[fail.Fail]            = contract.release(?m);
    if (sel w.err) { ret false; }
    var s: sink.Sink = w.ok;
    if (sel released.err) {
        val dropped: err[fail.Fail] = sink.release(?s);
        ret false;
    }
    var in: contract.Input                 = contract.Input{file: "masc.o", data: sink.data(?s), len: sink.len(?s)};
    val rd: res[contract.Model, fail.Fail] = registry.read(?t.formats, a, ?in);
    if (sel rd.err) {
        val dropped: err[fail.Fail] = sink.release(?s);
        ret false;
    }
    var x:    contract.Model = rd.ok;
    val conv: err[fail.Fail] = contract.to_neutral(?x, ?t.formats.relocs, back);
    val r1:   err[fail.Fail] = contract.release(?x);
    val r2:   err[fail.Fail] = sink.release(?s);
    ret !sel conv.err && !sel r1.err && !sel r2.err;
}

# whether mink's difference finds nothing between `a` and `b`
#[testing]
fun t_equal(t: *T, a: *mink_object.Object, b: *mink_object.Object) bool {
    val diff: res[str, fail.Fail] = compare.difference(testing.allocator_of(?t.t), a, b);
    if (sel diff.err) { ret false; }
    ret diff.ok == nil;
}

test build__a_forward_label_resolves_after_its_definition {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    t_text(?t, ".text");
    val l: Label = t_anon(?t);
    if (!t_emit(?t, "beq", t_reg(10), t_reg(11), target(l, 0)))              { ret 3; }
    if (!t_emit(?t, "addi", t_reg(0), t_reg(0), operand.Value.immediate{0})) { ret 4; }
    if (!t_ok(define(?t.b, l)))                                              { ret 5; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 6; }
    var o:    mink_object.Object = done.ok;
    var want: vector.Vector[u8]  = vector.init[u8](testing.allocator_of(?t.t));
    if (!t_encode(?t, "beq", t_reg(10), t_reg(11), operand.Value.relative{8}, ?want)) { ret 7; }
    if (!t_same(t_bytes(?o, 0), 0, want.data, 4))                                     { ret 8; }
    if (o.relocs.count != 0)                                                          { ret 9; }
    vector.dnit[u8](?want);
    if (!t_done(?t, ?o)) { ret 10; }
    ret 0;
}

test build__a_fixup_to_another_section_becomes_a_mink_relocation {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val text:  Section = t_text(?t, ".text");
    val other: Section = t_text(?t, ".text.other");
    val l:     Label   = t_anon(?t);
    val hi:    Label   = t_anon(?t);
    if (!t_emit(?t, "addi", t_reg(0), t_reg(0), operand.Value.immediate{0})) { ret 3; }
    if (!t_ok(define(?t.b, l)))                                              { ret 4; }
    switch(?t.b, text);
    # lla's high part names the target, and its low part the label of the high part
    var ex: relax.Expansion;
    if (!riscv_pseudo.lla(?t.ctx, register.make(0, 10), operand.Symbol{id: l.id, addend: 0, fixup: operand.NO_FIXUP}, hi.id, ?ex)) { ret 5; }
    if (!t_ok(define(?t.b, hi)))                                                                                                   { ret 6; }
    if (!t_ok(expansion(?t.b, ?ex)))                                                                                               { ret 7; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 8; }
    var o: mink_object.Object = done.ok;
    if (o.relocs.count != 2) { ret 9; }
    # the high part names the other section's symbol, the label's offset in the addend
    val high: *mink_object.Reloc = t_reloc(?o, 0);
    if (high.section.index != text.index || high.offset != 0 || high.kind != ?riscv_kinds.PCREL_HI20 || high.addend != 4) { ret 10; }
    val sym: *mink_object.Symbol = t_named_by(?o, high);
    if (sym == nil)                                                          { ret 11; }
    if (sym.kind != ?mink_symbol.SECTIONS || !t_placed(sym, other.index, 0)) { ret 12; }
    # the low part needs its partner at the label, so it names a local symbol there
    val low: *mink_object.Reloc = t_reloc(?o, 1);
    if (low.offset != 4 || low.kind != ?riscv_kinds.PCREL_LO12_I || low.addend != 0) { ret 14; }
    val at: *mink_object.Symbol = t_named_by(?o, low);
    if (at == nil)                                                        { ret 15; }
    if (at.binding != ?mink_symbol.LOCAL || !t_placed(at, text.index, 0)) { ret 16; }
    if (!t_done(?t, ?o))                                                  { ret 17; }
    ret 0;
}

test build__alignment_pads_with_the_sets_code_fill {
    var t: T;
    if (!t_make(?t, "rv64ic") || !t_relax(?t)) { ret 1; }
    t_text(?t, ".text");
    val two: [2]u8 = [2]u8{0xAA, 0xBB};
    if (!t_ok(data(?t.b, ?two[0], 2)))                                                      { ret 2; }
    if (!t_ok(align(?t.b, Align{boundary: 8, fill: opt[u8].none{}, max: opt[u64].none{}}))) { ret 3; }
    # after a call the linker may shrink, an alignment pads its worst case and says how long it is
    val ext: Label = t_named(?t, "ext");
    if (!t_ok(expose(?t.b, ext, T_GLOBAL))) { ret 4; }
    var ex: relax.Expansion;
    if (!riscv_pseudo.call(gen_register.X1, operand.Symbol{id: ext.id, addend: 0, fixup: operand.NO_FIXUP}, ?ex)) { ret 5; }
    if (!t_ok(expansion(?t.b, ?ex)))                                                                              { ret 6; }
    if (!t_ok(align(?t.b, Align{boundary: 16, fill: opt[u8].none{}, max: opt[u64].none{}})))                      { ret 7; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 8; }
    var o: mink_object.Object = done.ok;
    # a gap of six is c.nop and then the four byte nop, the remainder of four first
    val got:  store.Bytes = t_bytes(?o, 0);
    val nop:  *u8         = riscv_set.SET.fill.patterns[0].bytes;
    val cnop: *u8         = riscv_set.SET.fill.patterns[1].bytes;
    if (got.len != 30)                                                                   { ret 9; }
    if (!t_same(got, 2, cnop, 2) || !t_same(got, 4, nop, 4))                             { ret 10; }
    if (mink_object.section_at(?o, table.Id[mink_object.Section]{index: 0}).align != 16) { ret 11; }
    # sixteen less the shortest instruction, c.nop's two bytes: a c.nop and three nops
    if (!t_same(got, 16, cnop, 2) || !t_same(got, 18, nop, 4) || !t_same(got, 22, nop, 4) || !t_same(got, 26, nop, 4)) { ret 12; }
    if (o.relocs.count != 3)                                                                                           { ret 13; }
    val realign: *mink_object.Reloc = t_reloc(?o, 2);
    if (realign.kind != ?riscv_kinds.ALIGN || realign.offset != 16 || realign.addend != 14) { ret 14; }
    if (!t_done(?t, ?o))                                                                    { ret 15; }
    ret 0;
}

test build__a_fill_on_realigned_code_alignment_is_the_sets_nops_and_elsewhere_is_honoured {
    var t: T;
    if (!t_make(?t, "rv64ic") || !t_relax(?t)) { ret 1; }
    t_text(?t, ".text");
    val ext: Label = t_named(?t, "ext");
    if (!t_ok(expose(?t.b, ext, T_GLOBAL))) { ret 2; }
    var ex: relax.Expansion;
    if (!riscv_pseudo.call(gen_register.X1, operand.Symbol{id: ext.id, addend: 0, fixup: operand.NO_FIXUP}, ?ex)) { ret 3; }
    if (!t_ok(expansion(?t.b, ?ex)))                                                                              { ret 4; }
    if (!t_ok(align(?t.b, Align{boundary: 8, fill: opt[u8].some{0}, max: opt[u64].none{}})))                      { ret 5; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 6; }
    var o: mink_object.Object = done.ok;
    # six bytes of the set's nops, a c.nop and a four byte nop, under the marker, and the builder says where the fill was not used
    val got: store.Bytes = t_bytes(?o, 0);
    if (got.len != 14)                                                                                                         { ret 7; }
    if (!t_same(got, 8, riscv_set.SET.fill.patterns[1].bytes, 2) || !t_same(got, 10, riscv_set.SET.fill.patterns[0].bytes, 4)) { ret 8; }
    val mark: *mink_object.Reloc = t_reloc(?o, 2);
    if (o.relocs.count != 3 || mark.kind != ?riscv_kinds.ALIGN || mark.offset != 8 || mark.addend != 6) { ret 9; }
    val all: Realignments = realigned_all(?t.b);
    if (all.len != 1) { ret 10; }
    val said: *Realigned = all.at;
    if (said.offset != 8 || said.length != 6 || !sel said.fill.some) { ret 11; }
    if (sel said.fill.some) {
        if (said.fill.some != 0) { ret 11; }
    }
    if (!t_done(?t, ?o)) { ret 12; }
    # no instruction the linker may resize before it, so the fill is the one asked for
    var k: T;
    if (!t_make(?k, "rv64ic")) { ret 13; }
    t_text(?k, ".text");
    val two: [2]u8 = [2]u8{0xAA, 0xBB};
    if (!t_ok(data(?k.b, ?two[0], 2)))                                                       { ret 14; }
    if (!t_ok(align(?k.b, Align{boundary: 8, fill: opt[u8].some{0}, max: opt[u64].none{}}))) { ret 15; }
    val plain: res[mink_object.Object, Refusal] = finish(?k.b);
    if (sel plain.err) { ret 16; }
    var p:     mink_object.Object = plain.ok;
    val zeros: store.Bytes        = t_bytes(?p, 0);
    if (zeros.len != 8 || p.relocs.count != 0 || realigned_all(?k.b).len != 0) { ret 17; }
    var i: usize = 2;
    for (i < 8) {
        if (zeros.data[i] != 0) { ret 18; }
        i = i + 1;
    }
    if (!t_done(?k, ?p)) { ret 19; }
    ret 0;
}

test build__a_limit_on_realigned_code_alignment_is_refused_and_leaves_nothing {
    var t: T;
    if (!t_make(?t, "rv64ic") || !t_relax(?t)) { ret 1; }
    t_text(?t, ".text");
    val ext: Label = t_named(?t, "ext");
    if (!t_ok(expose(?t.b, ext, T_GLOBAL))) { ret 2; }
    var ex: relax.Expansion;
    if (!riscv_pseudo.call(gen_register.X1, operand.Symbol{id: ext.id, addend: 0, fixup: operand.NO_FIXUP}, ?ex)) { ret 3; }
    if (!t_ok(expansion(?t.b, ?ex)))                                                                              { ret 4; }
    if (!t_ok(align(?t.b, Align{boundary: 8, fill: opt[u8].none{}, max: opt[u64].some{4}})))                      { ret 5; }
    val first: res[mink_object.Object, Refusal] = finish(?t.b);
    if (!sel first.err)                               { ret 6; }
    if (!str_equals(first.err.message, REALIGN_FORM)) { ret 6; }
    val again: res[mink_object.Object, Refusal] = finish(?t.b);
    if (!sel again.err)                               { ret 7; }
    if (!str_equals(again.err.message, REALIGN_FORM)) { ret 7; }
    if (t.b.finished || t.b.pending.len != 0)         { ret 8; }
    release(?t.b);
    register.release(?t.v);
    extension.release(?t.s);
    registry.release(?t.formats);
    if (testing.live_count(?t.t) != 0) { ret 9; }
    ret 0;
}

test build__a_code_section_is_aligned_to_its_instructions {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    t_text(?t, ".text");
    if (!t_emit(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{1})) { ret 2; }
    val base: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel base.err) { ret 3; }
    var o: mink_object.Object = base.ok;
    if (mink_object.section_at(?o, table.Id[mink_object.Section]{index: 0}).align != 4) { ret 4; }
    if (!t_done(?t, ?o))                                                                { ret 5; }
    var c: T;
    if (!t_make(?c, "rv64ic")) { ret 6; }
    t_text(?c, ".text");
    if (!t_emit(?c, "addi", t_reg(10), t_reg(10), operand.Value.immediate{1})) { ret 7; }
    val packed: res[mink_object.Object, Refusal] = finish(?c.b);
    if (sel packed.err) { ret 8; }
    var p: mink_object.Object = packed.ok;
    if (mink_object.section_at(?p, table.Id[mink_object.Section]{index: 0}).align != 2) { ret 9; }
    if (!t_done(?c, ?p))                                                                { ret 10; }
    # what a caller asked is kept
    var k: T;
    if (!t_make(?k, "rv64i")) { ret 11; }
    t_text(?k, ".text");
    if (!t_emit(?k, "addi", t_reg(10), t_reg(10), operand.Value.immediate{1}))               { ret 12; }
    if (!t_ok(align(?k.b, Align{boundary: 16, fill: opt[u8].none{}, max: opt[u64].none{}}))) { ret 13; }
    val kept: res[mink_object.Object, Refusal] = finish(?k.b);
    if (sel kept.err) { ret 14; }
    var q: mink_object.Object = kept.ok;
    if (mink_object.section_at(?q, table.Id[mink_object.Section]{index: 0}).align != 16) { ret 15; }
    if (!t_done(?k, ?q))                                                                 { ret 16; }
    ret 0;
}

test build__relaxation_grows_a_branch_out_of_range_and_reaches_a_fixed_point {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    t_text(?t, ".text");
    val near: Label = t_anon(?t);
    val far:  Label = t_anon(?t);
    # the first branch reaches its target until the second grows, which pushes it out of range in turn
    if (!t_emit(?t, "beq", t_reg(10), t_reg(11), target(near, 0))) { ret 3; }
    if (!t_emit(?t, "beq", t_reg(12), t_reg(13), target(far, 0)))  { ret 4; }
    if (!t_ok(zero(?t.b, 4084)))                                   { ret 5; }
    if (!t_ok(define(?t.b, near)))                                 { ret 6; }
    if (!t_ok(zero(?t.b, 8000)))                                   { ret 7; }
    if (!t_ok(define(?t.b, far)))                                  { ret 8; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 9; }
    var o:  mink_object.Object     = done.ok;
    val at: opt[mink_object.Place] = place_of(?t.b, near);
    if (!(sel at.some && at.some.offset == 4100)) { ret 10; }
    if (line_count(?t.b) != 4)                    { ret 11; }
    val names: [4]str = [4]str{"bne", "jal", "bne", "jal"};
    var i:     usize  = 0;
    for (i < 4) {
        val ln: Line = line(?t.b, i);
        if (!str_equals(t_inst(?t.b, i).row.mnemonic, names[i]) || ln.offset != (i * 4)::u64) { ret 12; }
        i = i + 1;
    }
    # the far jump of the first branch reaches its target from its own place
    val to: operand.Value = t_inst(?t.b, 1).values[1];
    if (!(sel to.relative && to.relative == 4096)) { ret 13; }
    if (o.relocs.count != 0)                       { ret 14; }
    # each branch grows once, a pass apart, and a last pass finds nothing to grow: the bound, one more than the two
    # chains of one relaxation each, is met exactly
    if (t.b.passes != 3) { ret 16; }
    if (!t_done(?t, ?o)) { ret 15; }
    ret 0;
}

test build__branches_that_push_each_other_out_of_reach_settle_within_the_bound {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    t_text(?t, ".text");
    val back:  Label = t_anon(?t);
    val ahead: Label = t_anon(?t);
    # the first branch's target lies past the second, and the second's before the first, so each one growing moves the
    # other's target away from it: c.beqz to beq to the inverted branch past a jal, both, as llvm-mc 23.1.1 lays them
    if (!t_ok(define(?t.b, back)))                                 { ret 2; }
    if (!t_ok(zero(?t.b, 4092)))                                   { ret 3; }
    if (!t_emit(?t, "beq", t_reg(10), t_reg(0), target(ahead, 0))) { ret 4; }
    if (!t_emit(?t, "beq", t_reg(12), t_reg(0), target(back, 0)))  { ret 5; }
    if (!t_ok(zero(?t.b, 4088)))                                   { ret 6; }
    if (!t_ok(define(?t.b, ahead)))                                { ret 7; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 8; }
    var o: mink_object.Object = done.ok;
    if (line_count(?t.b) != 4) { ret 9; }
    val names: [4]str = [4]str{"c.bnez", "jal", "c.bnez", "jal"};
    var i:     usize  = 0;
    for (i < 4) {
        if (!str_equals(t_inst(?t.b, i).row.mnemonic, names[i])) { ret 10; }
        i = i + 1;
    }
    # both grow in the first pass, the first is pushed past beq's reach in the second and the second past it in the
    # third, and the fourth finds nothing to grow: within the bound of one more than two chains of two relaxations
    val bound: u32 = 1 + 2 * relax.depth(t.b.set.relax, t.b.set.codec, t_row("c.beqz"));
    if (bound != 5 || t.b.passes != 4) { ret 11; }
    if (o.relocs.count != 0)           { ret 12; }
    if (!t_done(?t, ?o))               { ret 13; }
    ret 0;
}

test build__an_unresolvable_fixup_is_refused {
    var t: T;
    if (!t_make(?t, "rv64i") || !t_relax(?t)) { ret 1; }
    t_text(?t, ".text");
    val ext: Label = t_named(?t, "ext");
    var ex:  relax.Expansion;
    if (!riscv_pseudo.call(gen_register.X1, operand.Symbol{id: ext.id, addend: 0, fixup: operand.NO_FIXUP}, ?ex)) { ret 3; }
    if (!t_ok(expansion(?t.b, ?ex)))                                                                              { ret 4; }
    val refused: res[mink_object.Object, Refusal] = finish(?t.b);
    if (!sel refused.err)                                                            { ret 5; }
    if (refused.err.label != ext.id || !str_equals(refused.err.message, UNRESOLVED)) { ret 6; }
    # the refusal left nothing behind: exposed, the label is an undefined symbol the call relocates against
    if (!t_ok(expose(?t.b, ext, T_GLOBAL))) { ret 7; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 8; }
    var o: mink_object.Object = done.ok;
    if (o.relocs.count != 2) { ret 9; }
    val call: *mink_object.Reloc = t_reloc(?o, 0);
    val mark: *mink_object.Reloc = t_reloc(?o, 1);
    if (call.kind != ?riscv_kinds.CALL_PLT_PAIR || mark.kind != ?riscv_kinds.RELAX || mark.offset != 0) { ret 10; }
    val callee: *mink_object.Symbol = t_named_by(?o, call);
    if (callee == nil || !sel callee.def.undefined) { ret 11; }
    # the marker names nothing, and no symbol stands in for it: the callee and the code's mapping symbol are all
    if (!sel mark.target.none || o.symbols.count != 2) { ret 12; }
    if (!t_done(?t, ?o))                               { ret 13; }
    ret 0;
}

test build__a_marker_takes_no_target_and_a_symbol_relocation_refuses_none {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var o:      mink_object.Object                          = mink_object.make(testing.allocator_of(?t.t), ?arch_riscv.RISCV64, ?catalog_kind.RELOCATABLE);
    val marker: res[table.Id[mink_object.Reloc], fail.Fail] = mink_object.add_reloc(?o, mink_object.Reloc{
        section: table.Id[mink_object.Section]{index: 0}, offset: 0, kind: ?riscv_kinds.RELAX, target: mink_object.Target.none{}, addend: 0,
    });
    if (sel marker.err) { ret 2; }
    val bare: res[table.Id[mink_object.Reloc], fail.Fail] = mink_object.add_reloc(?o, mink_object.Reloc{
        section: table.Id[mink_object.Section]{index: 0}, offset: 4, kind: ?reloc.ABS64, target: mink_object.Target.none{}, addend: 0,
    });
    if (!sel bare.err)   { ret 3; }
    if (!t_done(?t, ?o)) { ret 4; }
    ret 0;
}

# whether the object holds `x` as the flag `on`, stated or as leaving it unstated means
#[testing]
fun t_flag(o: *mink_object.Object, x: *mink_trait.Axis, on: bool) bool {
    val s: opt[mink_trait.Setting] = mink_object.effective(o, x);
    if (!sel s.some)      { ret false; }
    if (!sel s.some.flag) { ret false; }
    ret s.some.flag == on;
}

# the risc-v set with its shadow stack axis left unstated, as a set leaves an axis its reference never writes
#[testing]
fun t_unwritten(t: *T, rows: *trait.Owned) bool {
    if (!t_open(t, "rv64i")) { ret false; }
    var n: u32 = 0;
    for (n < riscv_set.SET.traits.len) {
        rows[n] = riscv_set.SET.traits.at[n];
        if (rows[n].axis == ?arch_riscv.RISCV_CFI_SS) { rows[n].owner = trait.Owner.unwritten{"a test"}; }
        n = n + 1;
    }
    t.x        = riscv_set.SET;
    t.x.traits = trait.Owners{at: rows, len: n};
    val built: res[Builder, Refusal] = make(testing.allocator_of(?t.t), ?t.formats, ?t.x, ?t.ctx, ?arch_riscv.RISCV64, ?mink_format.ELF);
    if (sel built.err) { ret false; }
    t.b = built.ok;
    val named: err[Refusal] = traits(?t.b, ?arch_riscv.RISCV_LP64D);
    ret sel named.ok;
}

# an axis the set leaves unstated is stated by no owner and refused from the source
test build__an_unwritten_axis_is_left_unstated_and_refused_from_the_source {
    var t:    T;
    var rows: [8]trait.Owned;
    if (!t_unwritten(?t, ?rows[0])) { ret 1; }
    val said: err[Refusal] = state(?t.b, mink_trait.Trait{axis: ?arch_riscv.RISCV_CFI_SS, setting: mink_trait.Setting.flag{true}});
    if (!sel said.err)                            { ret 2; }
    if (!str_equals(said.err.message, UNWRITTEN)) { ret 2; }
    val made: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel made.err) { ret 3; }
    var o:  mink_object.Object      = made.ok;
    val ss: opt[mink_trait.Setting] = mink_object.stated(?o, ?arch_riscv.RISCV_CFI_SS);
    if (sel ss.some)     { ret 4; }
    if (!t_done(?t, ?o)) { ret 5; }
    ret 0;
}

test build__every_encoded_axis_is_stated_by_its_owner {
    var c:   T;
    var i:   T;
    var zca: T;
    var tso: T;
    if (!t_make(?c, "rv64ic") || !t_make(?i, "rv64i") || !t_make(?zca, "rv64i_zca") || !t_make(?tso, "rv64i_ztso")) { ret 1; }
    val withc: res[mink_object.Object, Refusal] = finish(?c.b);
    val plain: res[mink_object.Object, Refusal] = finish(?i.b);
    val withz: res[mink_object.Object, Refusal] = finish(?zca.b);
    val witht: res[mink_object.Object, Refusal] = finish(?tso.b);
    if (sel withc.err) { ret 2; }
    if (sel plain.err) { ret 2; }
    if (sel withz.err) { ret 2; }
    if (sel witht.err) { ret 2; }
    var oc: mink_object.Object = withc.ok;
    var oi: mink_object.Object = plain.ok;
    var oz: mink_object.Object = withz.ok;
    var ot: mink_object.Object = witht.ok;
    # the selection's: rvc with c or zca, rve with e and tso with ztso
    if (!t_flag(?oc, ?arch_riscv.RISCV_RVC, true) || !t_flag(?oz, ?arch_riscv.RISCV_RVC, true))   { ret 3; }
    if (!t_flag(?oi, ?arch_riscv.RISCV_RVC, false) || !t_flag(?ot, ?arch_riscv.RISCV_RVC, false)) { ret 4; }
    if (!t_flag(?ot, ?arch_riscv.RISCV_TSO, true) || !t_flag(?oc, ?arch_riscv.RISCV_TSO, false))  { ret 5; }
    if (!t_flag(?oc, ?arch_riscv.RISCV_RVE, false))                                               { ret 6; }
    # the set's defaults, and the float abi of the caller's abi row
    if (!t_flag(?ot, ?arch_riscv.RISCV_CFI_LP_UNLABELED, false) || !t_flag(?ot, ?arch_riscv.RISCV_CFI_SS, false) || !t_flag(?ot, ?arch_riscv.RISCV_CFI_LP_FUNC_SIG, false)) { ret 7; }
    val abi: opt[mink_trait.Setting] = mink_object.stated(?oc, ?arch_riscv.RISCV_FLOAT_ABI);
    if (!sel abi.some)                               { ret 8; }
    if (!sel abi.some.choice)                        { ret 8; }
    if (abi.some.choice != ?arch_riscv.RISCV_DOUBLE) { ret 8; }
    # the object holds only the float abi, rvc and the selection's spelling: a clear flag and the rve the row fixes are
    # held as nothing, and the source states no other attribute
    if (table.count[mink_trait.Trait](?oc.traits) != 3)                                   { ret 9; }
    if (!t_done(?c, ?oc) || !t_done(?i, ?oi) || !t_done(?zca, ?oz) || !t_done(?tso, ?ot)) { ret 10; }
    ret 0;
}

test build__an_axis_the_format_requires_that_no_owner_states_is_refused_at_finish_naming_it {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    release(?t.b);
    val built: res[Builder, Refusal] = make(testing.allocator_of(?t.t), ?t.formats, ?riscv_set.SET, ?t.ctx, ?arch_riscv.RISCV64, ?mink_format.ELF);
    if (sel built.err) { ret 2; }
    t.b = built.ok;
    val named: err[Refusal] = traits(?t.b, ?T_NO_CONVENTION);
    if (sel named.err) { ret 2; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (!sel done.err)                                     { ret 3; }
    if (!str_equals(done.err.message, MISSING_TRAIT))      { ret 4; }
    if (!sel done.err.axis.some)                           { ret 5; }
    if (done.err.axis.some != ?arch_riscv.RISCV_FLOAT_ABI) { ret 5; }
    release(?t.b);
    register.release(?t.v);
    extension.release(?t.s);
    registry.release(?t.formats);
    if (testing.live_count(?t.t) != 0) { ret 6; }
    ret 0;
}

test build__a_trait_the_source_states_has_one_owner_and_the_last_statement_stands {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    # the abi row's float abi is taken again at its value and refused at another, as is the selection's tso
    val soft:     mink_trait.Trait = mink_trait.Trait{axis: ?arch_riscv.RISCV_FLOAT_ABI, setting: mink_trait.Setting.choice{?arch_riscv.RISCV_SOFT}};
    val double:   mink_trait.Trait = mink_trait.Trait{axis: ?arch_riscv.RISCV_FLOAT_ABI, setting: mink_trait.Setting.choice{?arch_riscv.RISCV_DOUBLE}};
    val tso:      mink_trait.Trait = mink_trait.Trait{axis: ?arch_riscv.RISCV_TSO, setting: mink_trait.Setting.flag{true}};
    val rvc:      mink_trait.Trait = mink_trait.Trait{axis: ?arch_riscv.RISCV_RVC, setting: mink_trait.Setting.flag{true}};
    val ibt:      mink_trait.Trait = mink_trait.Trait{axis: ?arch_x86.X86_IBT, setting: mink_trait.Setting.flag{true}};
    val supplied: err[Refusal]     = state(?t.b, soft);
    val selected: err[Refusal]     = state(?t.b, tso);
    val derived:  err[Refusal]     = state(?t.b, rvc);
    val foreign:  err[Refusal]     = state(?t.b, ibt);
    if (!t_ok(state(?t.b, double)))                                                                                        { ret 2; }
    if (!sel supplied.err)                                                                                                 { ret 2; }
    if (!str_equals(supplied.err.message, DISAGREES))                                                                      { ret 2; }
    if (!sel selected.err)                                                                                                 { ret 2; }
    if (!str_equals(selected.err.message, DISAGREES))                                                                      { ret 2; }
    if (!sel derived.err)                                                                                                  { ret 3; }
    if (!str_equals(derived.err.message, OWNED))                                                                           { ret 3; }
    if (!sel foreign.err)                                                                                                  { ret 4; }
    if (!str_equals(foreign.err.message, NO_AXIS))                                                                         { ret 4; }
    if (!t_ok(state(?t.b, mink_trait.Trait{axis: ?arch_riscv.RISCV_STACK_ALIGN, setting: mink_trait.Setting.number{8}})))  { ret 5; }
    if (!t_ok(state(?t.b, mink_trait.Trait{axis: ?arch_riscv.RISCV_STACK_ALIGN, setting: mink_trait.Setting.number{16}}))) { ret 6; }
    val made: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel made.err) { ret 7; }
    var o:     mink_object.Object      = made.ok;
    val align: opt[mink_trait.Setting] = mink_object.stated(?o, ?arch_riscv.RISCV_STACK_ALIGN);
    if (!sel align.some)                           { ret 8; }
    if (!sel align.some.number)                    { ret 8; }
    if (align.some.number != 16)                   { ret 8; }
    if (!t_flag(?o, ?arch_riscv.RISCV_RVC, false)) { ret 9; }
    if (!t_done(?t, ?o))                           { ret 10; }
    ret 0;
}

# an object of an architecture with abi rows is built under one of its own, named before finish, and in a format that
# encodes its traits
test build__a_foreign_abi_row_is_refused_a_missing_one_at_finish_and_a_format_with_no_traits_at_construction {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val a:       *A.Allocator          = testing.allocator_of(?t.t);
    val missing: res[Builder, Refusal] = make(a, ?t.formats, ?riscv_set.SET, ?t.ctx, ?arch_riscv.RISCV64, ?mink_format.ELF);
    if (sel missing.err) { ret 2; }
    var unnamed: Builder                          = missing.ok;
    val other:   err[Refusal]                     = traits(?unnamed, ?arch_riscv.RISCV_ILP32D);
    val bare:    res[mink_object.Object, Refusal] = finish(?unnamed);
    release(?unnamed);
    if (!sel other.err)                            { ret 3; }
    if (!str_equals(other.err.message, OTHER_ABI)) { ret 3; }
    if (!sel bare.err)                             { ret 2; }
    if (!str_equals(bare.err.message, NO_ABI))     { ret 2; }
    # mach-o has no code for riscv64, so it encodes no traits of its objects
    val macho: res[Builder, Refusal] = make(a, ?t.formats, ?riscv_set.SET, ?t.ctx, ?arch_riscv.RISCV64, ?mink_format.MACHO);
    if (!sel macho.err)                            { ret 4; }
    if (!str_equals(macho.err.message, NO_TRAITS)) { ret 4; }
    if (!sel macho.err.object.some)                { ret 4; }
    release(?t.b);
    register.release(?t.v);
    extension.release(?t.s);
    registry.release(?t.formats);
    if (testing.live_count(?t.t) != 0) { ret 5; }
    ret 0;
}

# an rv64 context does not enter riscv32, whose entry needs xlen=32
test build__a_context_that_does_not_enter_the_architecture_is_refused {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val a:      *A.Allocator          = testing.allocator_of(?t.t);
    val narrow: res[Builder, Refusal] = make(a, ?t.formats, ?riscv_set.SET, ?t.ctx, ?arch_riscv.RISCV32, ?mink_format.ELF);
    if (!sel narrow.err)                       { ret 2; }
    if (!str_equals(narrow.err.message, MODE)) { ret 3; }
    val refusal: Refusal = narrow.err;
    if (!sel refusal.mode.some) { ret 4; }
    var m: Mismatch = refusal.mode.some;
    if (!str_equals(m.arch, "riscv32")) { ret 5; }
    var out:    vector.Vector[u8] = vector.init[u8](a);
    val worded: err[A.Error]      = core_state.spell_unmet(?m.unmet, ?out);
    if (sel worded.err || !extension.t_spelled(?out, "needs xlen=32")) { ret 6; }
    vector.dnit[u8](?out);
    release(?t.b);
    register.release(?t.v);
    extension.release(?t.s);
    registry.release(?t.formats);
    if (testing.live_count(?t.t) != 0) { ret 8; }
    ret 0;
}

# a statement's context may hold what the object's does not, and never another value of an axis the object does not
# switch: an rv64i object takes an rv64i_zba stretch, and refuses an rv32i one (#248)
test under__a_wider_context_is_taken_and_one_at_another_xlen_refused {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var wide: T;
    if (!t_open(?wide, "rv64i_zba")) { ret 2; }
    var other: T;
    if (!t_open(?other, "rv32i")) { ret 3; }
    val taken: err[Refusal] = under(?t.b, ?wide.ctx);
    if (sel taken.err)                                        { ret 4; }
    if (view(?t.b) != ?wide.ctx || object_of(?t.b) != ?t.ctx) { ret 5; }
    val refused: err[Refusal] = under(?t.b, ?other.ctx);
    var widened: bool         = false;
    if (sel refused.err)                     { widened = str_equals(refused.err.message, WIDENED); }
    if (!widened || view(?t.b) != ?wide.ctx) { ret 6; }
    release(?t.b);
    register.release(?t.v);
    extension.release(?t.s);
    register.release(?wide.v);
    extension.release(?wide.s);
    register.release(?other.v);
    extension.release(?other.s);
    ret 0;
}

test build__a_local_label_is_not_exported {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    t_text(?t, ".text");
    val f:    Label = t_named(?t, "f");
    val loop: Label = t_named(?t, ".Lloop");
    if (!t_ok(expose(?t.b, f, T_GLOBAL)))                          { ret 3; }
    if (!t_ok(define(?t.b, f)) || !t_ok(define(?t.b, loop)))       { ret 4; }
    if (!t_emit(?t, "beq", t_reg(10), t_reg(11), target(loop, 0))) { ret 5; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 6; }
    var o: mink_object.Object = done.ok;
    # the exported label and the code's mapping symbol
    if (o.symbols.count != 2) { ret 7; }
    val only: View = mink_object.name_of(?o, t_symbol(?o, table.Id[mink_object.Symbol]{index: 0}).name);
    if (only.len != 1 || only.data[0] != 'f') { ret 8; }
    val loop_symbol: opt[table.Id[mink_object.Symbol]] = symbol_of(?t.b, loop);
    if (sel loop_symbol.some) { ret 9; }
    if (!t_done(?t, ?o))      { ret 10; }
    ret 0;
}

test build__the_listing_record_matches_the_bytes_it_describes {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    t_text(?t, ".text");
    val ext:  Label = t_named(?t, "ext");
    val next: Label = t_anon(?t);
    if (!t_ok(expose(?t.b, ext, T_GLOBAL)))                                     { ret 3; }
    if (!t_emit(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{-5})) { ret 4; }
    if (!t_emit(?t, "beq", t_reg(10), t_reg(0), target(next, 0)))               { ret 5; }
    if (!t_emit(?t, "jal", t_reg(1), target(ext, 0), operand.Value.none{}))     { ret 6; }
    if (!t_ok(define(?t.b, next)))                                              { ret 7; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 8; }
    var o:   mink_object.Object         = done.ok;
    val got: store.Bytes                = t_bytes(?o, 0);
    var out: vector.Vector[u8]          = vector.init[u8](testing.allocator_of(?t.t));
    var fx:  vector.Vector[field.Fixup] = vector.init[field.Fixup](testing.allocator_of(?t.t));
    if (line_count(?t.b) != 3) { ret 9; }
    var i: usize = 0;
    for (i < line_count(?t.b)) {
        val ln:  Line      = line(?t.b, i);
        var ins: inst.Inst = t_inst(?t.b, i);
        out.len = 0;
        val again: res[usize, field.Refusal] = walk.encode(?riscv_catalog.CODEC, ?t.ctx, ?ins, ?out, ?fx);
        if (sel again.err)                                     { ret 10; }
        if (again.ok::u64 != ln.length)                        { ret 10; }
        if (!t_same(got, ln.offset::usize, out.data, out.len)) { ret 11; }
        i = i + 1;
    }
    vector.dnit[u8](?out);
    vector.dnit[field.Fixup](?fx);
    if (!t_done(?t, ?o)) { ret 12; }
    ret 0;
}

test build__switching_sections_keeps_each_sections_cursor {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val first:  Section = t_text(?t, ".text");
    val second: Section = t_text(?t, ".text.second");
    val l:      Label   = t_anon(?t);
    switch(?t.b, first);
    if (!t_emit(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{1})) { ret 3; }
    switch(?t.b, second);
    if (!t_emit(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{2})) { ret 4; }
    switch(?t.b, first);
    if (!t_ok(define(?t.b, l)))                                                { ret 5; }
    if (!t_emit(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{3})) { ret 6; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 7; }
    var o: mink_object.Object = done.ok;
    if (t_bytes(?o, first.index).len != 8 || t_bytes(?o, second.index).len != 4) { ret 8; }
    val at: opt[mink_object.Place] = place_of(?t.b, l);
    if (!(sel at.some && (at.some.section.index == first.index && at.some.offset == 4))) { ret 9; }
    var want: vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t.t));
    if (!t_encode(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{3}, ?want)) { ret 10; }
    if (!t_same(t_bytes(?o, first.index), 4, want.data, 4))                             { ret 11; }
    vector.dnit[u8](?want);
    if (!t_done(?t, ?o)) { ret 12; }
    ret 0;
}

# whether statement `j` of section `s` was written with the position mode at `v`
#[testing]
fun t_moded(t: *T, s: Section, j: usize, v: *mode.Value) bool {
    var values: [row.MAX_OPERANDS]operand.Value;
    val st:     Statement  = statement(?t.b, s, j, ?values[0]);
    var want:   mode.State = mode.initial(?t.b.set.assembly);
    if (!mode.change(?want, mode.Setting{mode: ?riscv_mode.POSITION, value: v})) { ret false; }
    ret mode.same(st.modes, ?want);
}

# each statement records the modes it was written under, a new state only when a mode changes, and a writer's change
# is taken back with the rest of what it wrote
test build__a_statement_records_the_assembler_modes_it_was_written_under {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val text: Section      = t_text(?t, ".text");
    var one:  u8           = 1;
    val pic:  mode.Setting = mode.Setting{mode: ?riscv_mode.POSITION, value: ?riscv_mode.PIC};
    if (!t_ok(data(?t.b, ?one, 1)) || !t_ok(set_mode(?t.b, pic)) || !t_ok(data(?t.b, ?one, 1))) { ret 2; }
    # setting a mode to the value it holds records nothing new
    if (!t_ok(set_mode(?t.b, pic)) || t.b.states.len != 2)                                         { ret 3; }
    if (!t_ok(set_mode(?t.b, mode.Setting{mode: ?riscv_mode.POSITION, value: ?riscv_mode.NOPIC}))) { ret 4; }
    if (!t_ok(data(?t.b, ?one, 1)))                                                                { ret 5; }
    if (!t_moded(?t, text, 0, ?riscv_mode.NOPIC) || !t_moded(?t, text, 1, ?riscv_mode.PIC))        { ret 6; }
    if (!t_moded(?t, text, 2, ?riscv_mode.NOPIC))                                                  { ret 7; }
    var before: Snapshot = snapshot(?t.b);
    if (!t_ok(set_mode(?t.b, pic))) { ret 8; }
    restore(?t.b, ?before);
    if (t.b.states.len != 3 || !mode.same(?t.b.modes, ?t.b.states.data[t.b.state::usize])) { ret 9; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 10; }
    var o: mink_object.Object = done.ok;
    if (!t_done(?t, ?o)) { ret 11; }
    ret 0;
}

# a nameless code section, made current
#[testing]
fun t_nameless(t: *T) Section {
    val s: res[Section, Refusal] = open(?t.b, Spec{name: opt[str].none{}, kind: ?mink_section.TEXT, flags: mink_section.TEXT.flags, disposition: ?mink_section.WHOLE});
    if (sel s.err) { ret Section{index: 0xFFFF_FFFF}; }
    switch(?t.b, s.ok);
    ret s.ok;
}

# whether section `index` of `o` is named `name`
#[testing]
fun t_section_is(o: *mink_object.Object, index: u32, name: str) bool {
    val named: opt[table.Id[intern.Name]] = mink_object.section_at(o, table.Id[mink_object.Section]{index: index}).name;
    if (sel named.none) { ret false; }
    val v: View = mink_object.name_of(o, named.some);
    ret v.len == str_len(name) && t_same(store.Bytes{data: v.data, len: v.len}, 0, name::*u8, v.len);
}

test build__nameless_sections_of_one_kind_stay_apart_and_read_back_through_elf_named_by_it {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val first:  Section = t_nameless(?t);
    val second: Section = t_nameless(?t);
    if (first.index == second.index || section_count(?t.b) != 2) { ret 2; }
    # a nameless section has no name to be found by, so neither is the `.text` its format names it
    val dot_text: View         = View{data: ".text", len: 5};
    val found:    opt[Section] = section_named(?t.b, dot_text);
    val was:      Opened       = opened(?t.b, first);
    if (sel found.some || sel was.name.some)                                   { ret 3; }
    if (!t_emit(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{1})) { ret 4; }
    switch(?t.b, first);
    if (!t_emit(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{2})) { ret 5; }
    if (!t_emit(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{3})) { ret 5; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 6; }
    var o: mink_object.Object = done.ok;
    if (o.sections.count != 2 || t_bytes(?o, first.index).len != 8 || t_bytes(?o, second.index).len != 4) { ret 7; }
    val stated: opt[table.Id[intern.Name]] = mink_object.section_at(?o, table.Id[mink_object.Section]{index: 0}).name;
    if (sel stated.some) { ret 8; }
    var r:     mink_object.Object = mink_object.make(testing.allocator_of(?t.t), o.target.arch, nil);
    val ok:    bool               = t_through_elf(?t, ?o, ?r);
    val named: bool               = ok && r.sections.count == 2 && t_section_is(?r, 0, ".text") && t_section_is(?r, 1, ".text");
    val same:  bool               = named && t_equal(?t, ?o, ?r);
    val freed: err[fail.Fail]     = mink_object.release(?r);
    if (!same || sel freed.err) { ret 9; }
    if (!t_done(?t, ?o))        { ret 10; }
    ret 0;
}

test build__a_zero_size_is_no_size_and_reads_back_through_elf_equal_to_the_built_one {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    t_text(?t, ".text");
    val start: Label    = t_named(?t, "start");
    val empty: Label    = t_named(?t, "empty");
    val stop:  Label    = t_anon(?t);
    val fixed: Exposure = Exposure{binding: ?mink_symbol.GLOBAL, visibility: ?mink_symbol.DEFAULT, kind: ?mink_symbol.FUNCTION, size: Size.fixed{0}};
    val span:  Exposure = Exposure{binding: ?mink_symbol.GLOBAL, visibility: ?mink_symbol.DEFAULT, kind: ?mink_symbol.FUNCTION, size: Size.measured{Difference{plus: stop, minus: empty, addend: 0}}};
    if (!t_ok(expose(?t.b, start, fixed)))                                     { ret 2; }
    if (!t_ok(expose(?t.b, empty, span)))                                      { ret 3; }
    if (!t_ok(define(?t.b, start)))                                            { ret 4; }
    if (!t_ok(define(?t.b, empty)))                                            { ret 5; }
    if (!t_ok(define(?t.b, stop)))                                             { ret 6; }
    if (!t_emit(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{1})) { ret 7; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 8; }
    var o:   mink_object.Object  = done.ok;
    val sym: *mink_object.Symbol = t_symbol(?o, table.Id[mink_object.Symbol]{index: 0});
    if (sel sym.size.some) { ret 9; }
    var r:     mink_object.Object = mink_object.make(testing.allocator_of(?t.t), o.target.arch, nil);
    val ok:    bool               = t_through_elf(?t, ?o, ?r);
    val same:  bool               = ok && t_equal(?t, ?o, ?r);
    val freed: err[fail.Fail]     = mink_object.release(?r);
    if (!same || sel freed.err) { ret 10; }
    if (!t_done(?t, ?o))        { ret 11; }
    ret 0;
}

test build__an_instruction_is_written_in_the_shortest_form_the_selection_admits {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    t_text(?t, ".text");
    val far: Label = t_anon(?t);
    if (!t_emit(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{1})) { ret 2; }
    # a compressed branch out of range relaxes through the set's rows: c.beqz to beq to an inverted branch past a jump,
    # the inverted branch itself compressed
    if (!t_emit(?t, "c.beqz", t_reg(10), target(far, 0), operand.Value.none{})) { ret 3; }
    if (!t_ok(zero(?t.b, 6000)))                                                { ret 4; }
    if (!t_ok(define(?t.b, far)))                                               { ret 5; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 6; }
    var o: mink_object.Object = done.ok;
    if (line_count(?t.b) != 3) { ret 7; }
    val packed: Line = line(?t.b, 0);
    if (!str_equals(t_inst(?t.b, 0).row.mnemonic, "c.addi") || packed.length != 2)                               { ret 8; }
    if (!str_equals(t_inst(?t.b, 1).row.mnemonic, "c.bnez") || !str_equals(t_inst(?t.b, 2).row.mnemonic, "jal")) { ret 9; }
    val past: operand.Value = t_inst(?t.b, 1).values[1];
    if (!(sel past.relative && past.relative == 6)) { ret 9; }
    if (!t_done(?t, ?o))                            { ret 10; }
    # without c the base form is written
    var plain: T;
    if (!t_make(?plain, "rv64i")) { ret 11; }
    t_text(?plain, ".text");
    if (!t_emit(?plain, "addi", t_reg(10), t_reg(10), operand.Value.immediate{1})) { ret 12; }
    val base: res[mink_object.Object, Refusal] = finish(?plain.b);
    if (sel base.err) { ret 13; }
    var p:    mink_object.Object = base.ok;
    val wide: Line               = line(?plain.b, 0);
    if (!str_equals(t_inst(?plain.b, 0).row.mnemonic, "addi") || wide.length != 4 || t_bytes(?p, 0).len != 4) { ret 14; }
    if (!t_done(?plain, ?p))                                                                                  { ret 15; }
    ret 0;
}

test build__a_datum_relocates_or_folds_as_a_fixup_does {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val data: res[Section, Refusal] = open(?t.b, Spec{name: opt[str].some{".data"}, kind: ?mink_section.DATA, flags: mink_section.DATA.flags, disposition: ?mink_section.WHOLE});
    if (sel data.err) { ret 2; }
    switch(?t.b, data.ok);
    val ext:  Label = t_named(?t, "ext");
    val here: Label = t_anon(?t);
    if (!t_ok(expose(?t.b, ext, T_GLOBAL))) { ret 3; }
    # an address is the linker's, and a distance within the section folds
    if (!t_ok(datum(?t.b, Reference{target: ext, addend: 2, width: 8, basis: core_fixup.ABSOLUTE})))  { ret 4; }
    if (!t_ok(define(?t.b, here)))                                                                    { ret 5; }
    if (!t_ok(zero(?t.b, 4)))                                                                         { ret 6; }
    if (!t_ok(datum(?t.b, Reference{target: here, addend: 0, width: 4, basis: core_fixup.RELATIVE}))) { ret 7; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 8; }
    var o: mink_object.Object = done.ok;
    if (o.relocs.count != 1) { ret 9; }
    val address: *mink_object.Reloc = t_reloc(?o, 0);
    if (address.kind != ?reloc.ABS64 || address.offset != 0 || address.addend != 2) { ret 10; }
    val sym: *mink_object.Symbol = t_named_by(?o, address);
    if (sym == nil || !sel sym.def.undefined) { ret 11; }
    val back: [4]u8 = [4]u8{0xFC, 0xFF, 0xFF, 0xFF};
    if (!t_same(t_bytes(?o, 0), 12, ?back[0], 4)) { ret 12; }
    if (!t_done(?t, ?o))                          { ret 13; }
    ret 0;
}

# the state of a typed stream of the tests: how many instructions it observed, and whether its record refuses
#[testing]
rec TStream {
    count:  u32;
    refuse: bool;
}

#[testing]
fun t_stream_make(a: *A.Allocator) res[ptr, A.Error] {
    val got: res[*TStream, A.Error] = A.allocate[TStream](a, 1);
    if (sel got.err) { ret res[ptr, A.Error].err{got.err}; }
    @got.ok = TStream{count: 0, refuse: false};
    ret res[ptr, A.Error].ok{got.ok::ptr};
}

#[testing]
fun t_stream_release(a: *A.Allocator, p: ptr) {
    val freed: err[A.Error] = A.deallocate[TStream](a, p::*TStream, 1);
}

#[testing]
fun t_stream_begin(p: ptr) {
    val s: *TStream = p::*TStream;
    s.count = 0;
}

#[testing]
fun t_stream_observe(p: ptr, ins: *inst.Inst) err[field.Refusal] {
    val s: *TStream = p::*TStream;
    s.count = s.count + 1;
    ret err[field.Refusal].ok{};
}

#[testing]
fun t_stream_width(p: ptr, id: u32) opt[u8] {
    ret opt[u8].none{};
}

#[testing]
fun t_stream_space(p: ptr, space: u16, index: u32) opt[u32] {
    ret opt[u32].none{};
}

# an entry of the function space for every instruction observed, or a refusal
#[testing]
fun t_stream_record(p: ptr, v: *core_state.Context, o: *mink_object.Object) err[fail.Fail] {
    val s: *TStream = p::*TStream;
    if (s.refuse) { ret err[fail.Fail].err{fail.unsupported("refused by the test")}; }
    var i: u32 = 0;
    for (i < s.count) {
        val added: res[table.Id[mink_object.Entry], fail.Fail] = mink_object.add_entry(o, mink_object.Entry{space: ?mink_space.FUNCTIONS, name: opt[table.Id[intern.Name]].none{}, import: opt[mink_object.Import].none{}, body: opt[mink_object.Place].none{}, signature: opt[table.Id[mink_object.Entry]].none{}});
        if (sel added.err) { ret err[fail.Fail].err{added.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
val T_STREAM: stream.Hooks = stream.Hooks{types: stream.Names{at: nil, len: 0}, make: t_stream_make, release: t_stream_release, begin: t_stream_begin, observe: t_stream_observe, width: t_stream_width, space: t_stream_space, record: t_stream_record};

# a set's typed stream observes every instruction the builder admits and records on the object what they defined, and
# a refused record hands over no object and leaves the builder to finish again
test build__a_typed_stream_records_on_the_object_what_its_instructions_defined {
    var t: T;
    if (!t_open(?t, "rv64i")) { ret 1; }
    var codec: dispatch.Codec = @riscv_set.SET.codec;
    codec.stream = ?T_STREAM;
    t.x          = riscv_set.SET;
    t.x.codec    = ?codec;
    val built: res[Builder, Refusal] = make(testing.allocator_of(?t.t), ?t.formats, ?t.x, ?t.ctx, ?arch_riscv.RISCV64, ?mink_format.ELF);
    if (sel built.err) { ret 2; }
    t.b = built.ok;
    if (!t_ok(traits(?t.b, ?arch_riscv.RISCV_LP64D))) { ret 3; }
    t_text(?t, ".text");
    if (!t_emit(?t, "addi", t_reg(10), t_reg(10), operand.Value.immediate{1})) { ret 4; }
    if (!t_emit(?t, "addi", t_reg(11), t_reg(11), operand.Value.immediate{2})) { ret 4; }
    val state: *TStream = t.ctx.stream::*TStream;
    if (state.count != 2) { ret 5; }
    state.refuse = true;
    val refused: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel refused.ok) {
        mink_object.release(?refused.ok);
        ret 6;
    }
    state.refuse = false;
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 7; }
    var o: mink_object.Object = done.ok;
    if (table.count[mink_object.Entry](?o.entries) != 2) { ret 8; }
    if (!t_done(?t, ?o))                                 { ret 9; }
    ret 0;
}

# a writer that opens a section of its own, places a label and writes into it, and fails the first time it runs: its
# context counts the runs
#[testing]
fun t_extra(context: ptr, b: *Builder) err[Refusal] {
    val runs: *u32 = context::*u32;
    @runs = @runs + 1;
    val s: res[Section, Refusal] = open(b, Spec{name: opt[str].some{".extra"}, kind: ?mink_section.DATA, flags: mink_section.DATA.flags, disposition: ?mink_section.WHOLE});
    if (sel s.err) { ret err[Refusal].err{s.err}; }
    switch(b, s.ok);
    val at: res[Label, Refusal] = position(b);
    if (sel at.err) { ret err[Refusal].err{at.err}; }
    var two: [2]u8        = [2]u8{1, 2};
    val put: err[Refusal] = data(b, ?two[0], 2);
    if (sel put.err) { ret put; }
    if (@runs == 1)  { ret refused(OBJECT); }
    ret err[Refusal].ok{};
}

test build__a_finish_that_fails_in_a_writer_leaves_no_trace_and_a_rerun_writes_once {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val text: Section = t_text(?t, ".text");
    if (!t_emit(?t, "addi", t_reg(0), t_reg(0), operand.Value.immediate{0})) { ret 2; }
    var runs: u32 = 0;
    if (!t_ok(writer(?t.b, Writer{name: "extra", context: ?runs, write: t_extra}))) { ret 3; }
    val names:  usize                            = intern.count(?t.b.names);
    val failed: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel failed.ok) {
        mink_object.release(?failed.ok);
        ret 4;
    }
    if (t.b.areas.len != 1 || t.b.labels.len != 0 || t.b.data.len != 0) { ret 5; }
    if (sel t.b.current.none)                                           { ret 6; }
    if (t.b.current.some != text.index::usize)                          { ret 7; }
    if (intern.count(?t.b.names) != names)                              { ret 13; }
    val next: res[table.Id[intern.Name], Refusal] = name_of(?t.b, ".extra");
    if (!sel next.ok)                  { ret 14; }
    if (next.ok.index::usize != names) { ret 15; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 8; }
    var o: mink_object.Object = done.ok;
    if (runs != 2)                                                  { ret 9; }
    if (t.b.areas.len != 2 || t.b.areas.data[1].fragments.len != 1) { ret 10; }
    if (t.b.labels.len != 1 || t.b.data.len != 2)                   { ret 11; }
    if (!t_done(?t, ?o))                                            { ret 12; }
    ret 0;
}

# a writer that adds a byte to the current section, which the layout already settled
#[testing]
fun t_into_text(context: ptr, b: *Builder) err[Refusal] {
    var one: [1]u8 = [1]u8{0};
    ret data(b, ?one[0], 1);
}

test build__a_writer_emitting_into_a_sealed_section_is_refused_and_the_section_is_left_as_it_was {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    t_text(?t, ".text");
    if (!t_emit(?t, "addi", t_reg(0), t_reg(0), operand.Value.immediate{0}))         { ret 2; }
    if (!t_ok(writer(?t.b, Writer{name: "text", context: nil, write: t_into_text}))) { ret 3; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.ok) {
        mink_object.release(?done.ok);
        ret 4;
    }
    if (!str_equals(done.err.message, SEALED))                     { ret 5; }
    if (t.b.areas.data[0].fragments.len != 1 || t.b.data.len != 0) { ret 6; }
    var none: mink_object.Object = mink_object.make(testing.allocator_of(?t.t), ?arch_riscv.RISCV64, ?catalog_kind.RELOCATABLE);
    if (!t_done(?t, ?none)) { ret 7; }
    ret 0;
}

test build__a_next_position_before_alignment_binds_to_the_next_instruction {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    t_text(?t, ".text");
    if (!t_emit(?t, "addi", t_reg(0), t_reg(0), operand.Value.immediate{0})) { ret 2; }
    val l: res[Label, Refusal] = next_position(?t.b, false);
    if (sel l.err)                                                                           { ret 3; }
    if (!t_ok(align(?t.b, Align{boundary: 16, fill: opt[u8].none{}, max: opt[u64].none{}}))) { ret 4; }
    if (!t_emit(?t, "addi", t_reg(0), t_reg(0), operand.Value.immediate{0}))                 { ret 5; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 6; }
    var o:  mink_object.Object     = done.ok;
    val at: opt[mink_object.Place] = place_of(?t.b, l.ok);
    if (sel at.none)          { ret 9; }
    if (at.some.offset != 16) { ret 7; }
    if (!t_done(?t, ?o))      { ret 8; }
    ret 0;
}

test build__a_next_position_with_no_instruction_after_it_is_refused_unless_an_end_is_stated {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    t_text(?t, ".text");
    if (!t_emit(?t, "addi", t_reg(0), t_reg(0), operand.Value.immediate{0})) { ret 2; }
    val l: res[Label, Refusal] = next_position(?t.b, false);
    if (sel l.err) { ret 3; }
    val no: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel no.ok) {
        mink_object.release(?no.ok);
        ret 4;
    }
    if (!str_equals(no.err.message, NO_INSTRUCTION) || no.err.label != l.ok.id) { ret 5; }
    var none: mink_object.Object = mink_object.make(testing.allocator_of(?t.t), ?arch_riscv.RISCV64, ?catalog_kind.RELOCATABLE);
    if (!t_done(?t, ?none)) { ret 6; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 7; }
    t_text(?u, ".text");
    if (!t_emit(?u, "addi", t_reg(0), t_reg(0), operand.Value.immediate{0})) { ret 8; }
    val e: res[Label, Refusal] = next_position(?u.b, true);
    if (sel e.err) { ret 9; }
    val done: res[mink_object.Object, Refusal] = finish(?u.b);
    if (sel done.err) { ret 10; }
    var o:  mink_object.Object     = done.ok;
    val at: opt[mink_object.Place] = place_of(?u.b, e.ok);
    if (sel at.none)         { ret 13; }
    if (at.some.offset != 4) { ret 11; }
    if (!t_done(?u, ?o))     { ret 12; }
    ret 0;
}

test build__the_written_object_reads_back_through_mink_equal_to_the_built_one {
    var t: T;
    if (!t_make(?t, "rv64ic") || !t_relax(?t)) { ret 1; }
    t_text(?t, ".text");
    val back: Label = t_anon(?t);
    val fwd:  Label = t_anon(?t);
    val hi:   Label = t_anon(?t);
    val d:    Label = t_named(?t, "d");
    val ext:  Label = t_named(?t, "ext");
    if (!t_ok(expose(?t.b, ext, T_GLOBAL))) { ret 2; }
    if (!t_ok(define(?t.b, back)))          { ret 3; }
    # a forward and a backward branch, folded within the section
    if (!t_emit(?t, "beq", t_reg(10), t_reg(11), target(fwd, 0))) { ret 4; }
    var call: relax.Expansion;
    if (!riscv_pseudo.call(gen_register.X1, operand.Symbol{id: ext.id, addend: 0, fixup: operand.NO_FIXUP}, ?call)) { ret 5; }
    if (!t_ok(expansion(?t.b, ?call)))                                                                              { ret 6; }
    if (!t_ok(align(?t.b, Align{boundary: 16, fill: opt[u8].none{}, max: opt[u64].none{}})))                        { ret 7; }
    if (!t_emit(?t, "bne", t_reg(10), t_reg(11), target(back, 0)))                                                  { ret 8; }
    if (!t_ok(define(?t.b, fwd)))                                                                                   { ret 9; }
    var lla: relax.Expansion;
    if (!riscv_pseudo.lla(?t.ctx, register.make(0, 10), operand.Symbol{id: d.id, addend: 0, fixup: operand.NO_FIXUP}, hi.id, ?lla)) { ret 10; }
    if (!t_ok(define(?t.b, hi)))                                                                                                    { ret 11; }
    if (!t_ok(expansion(?t.b, ?lla)))                                                                                               { ret 12; }
    val data: res[Section, Refusal] = open(?t.b, Spec{name: opt[str].some{".data"}, kind: ?mink_section.DATA, flags: mink_section.DATA.flags, disposition: ?mink_section.WHOLE});
    if (sel data.err) { ret 13; }
    switch(?t.b, data.ok);
    val here: Label = t_anon(?t);
    if (!t_ok(define(?t.b, d)))                                                                       { ret 14; }
    if (!t_ok(datum(?t.b, Reference{target: ext, addend: 2, width: 8, basis: core_fixup.ABSOLUTE})))  { ret 15; }
    if (!t_ok(define(?t.b, here)))                                                                    { ret 16; }
    if (!t_ok(zero(?t.b, 4)))                                                                         { ret 17; }
    if (!t_ok(datum(?t.b, Reference{target: here, addend: 0, width: 4, basis: core_fixup.RELATIVE}))) { ret 18; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 19; }
    var o:  mink_object.Object = done.ok;
    var r:  mink_object.Object = mink_object.make(testing.allocator_of(?t.t), o.target.arch, nil);
    val ok: bool               = t_through_elf(?t, ?o, ?r);
    # the call, the lla pair with their markers, the alignment, the branches across the call and the absolute datum are
    # what the file has to carry
    val same:  bool           = ok && o.relocs.count == 10 && t_equal(?t, ?o, ?r);
    val freed: err[fail.Fail] = mink_object.release(?r);
    if (!same || sel freed.err) { ret 20; }
    if (!t_done(?t, ?o))        { ret 21; }
    ret 0;
}

test build__a_rip_relative_address_folds_to_a_label_of_its_section_and_relocates_to_an_external_one {
    var t: T;
    if (!t_make_x86(?t)) { ret 1; }
    t_text(?t, ".text");
    val l:   Label = t_anon(?t);
    val ext: Label = t_named(?t, "ext");
    if (!t_ok(expose(?t.b, ext, T_GLOBAL)))                   { ret 2; }
    if (!t_emit_x86(?t, 0, t_rip(l), operand.Value.none{}))   { ret 3; }
    if (!t_emit_x86(?t, 0, t_rip(ext), operand.Value.none{})) { ret 4; }
    if (!t_ok(define(?t.b, l)))                               { ret 5; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 6; }
    var o: mink_object.Object = done.ok;
    # rip is the end of the first jmp, 6 bytes before the label
    val want: [12]u8 = [12]u8{0xFF, 0x25, 0x06, 0x00, 0x00, 0x00, 0xFF, 0x25, 0x00, 0x00, 0x00, 0x00};
    if (!t_same(t_bytes(?o, 0), 0, ?want[0], 12)) { ret 7; }
    if (o.relocs.count != 1)                      { ret 8; }
    val r: *mink_object.Reloc = t_reloc(?o, 0);
    if (r.offset != 8 || r.kind != ?reloc.PC32) { ret 9; }
    # the field is 4 bytes before the end the address is measured from, as llvm-mc writes ext-4
    if (r.addend != -4) { ret 12; }
    val sym: *mink_object.Symbol = t_named_by(?o, r);
    if (sym == nil || sym.binding != ?mink_symbol.GLOBAL) { ret 10; }
    if (!t_done(?t, ?o))                                  { ret 11; }
    ret 0;
}

test build__a_relocation_from_an_end_anchored_operand_is_biased_by_its_distance_to_the_end {
    var t: T;
    if (!t_make_x86(?t)) { ret 1; }
    t_text(?t, ".text");
    val ext: Label = t_named(?t, "ext");
    val l:   Label = t_anon(?t);
    if (!t_ok(expose(?t.b, ext, T_GLOBAL))) { ret 2; }
    # the near form is 10 bytes, its target field 1 byte in and its address 5 bytes in, both 4 bytes long
    if (!t_emit_x86(?t, 2, target(ext, 0), t_rip(ext))) { ret 3; }
    if (!t_ok(define(?t.b, l)))                         { ret 4; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 5; }
    var o: mink_object.Object = done.ok;
    if (o.relocs.count != 2) { ret 6; }
    val a: *mink_object.Reloc = t_reloc(?o, 0);
    val c: *mink_object.Reloc = t_reloc(?o, 1);
    if (a.offset != 1 || a.addend != -9 || c.offset != 6 || c.addend != -4) { ret 7; }
    if (!t_done(?t, ?o))                                                    { ret 8; }
    ret 0;
}

test build__a_grown_form_folds_its_other_pc_relative_operands_as_its_target {
    var t: T;
    if (!t_make_x86(?t)) { ret 1; }
    t_text(?t, ".text");
    val l: Label = t_anon(?t);
    # the short target is out of reach, so the jump grows to its near form, which carries the address over
    if (!t_emit_x86(?t, 1, target(l, 0), t_rip(l))) { ret 2; }
    if (!t_ok(zero(?t.b, 200)))                     { ret 3; }
    if (!t_ok(define(?t.b, l)))                     { ret 4; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 5; }
    var o: mink_object.Object = done.ok;
    # both distances are from the near form's end, 200 bytes before the label
    val want: [10]u8 = [10]u8{0xE9, 0xC8, 0x00, 0x00, 0x00, 0x05, 0xC8, 0x00, 0x00, 0x00};
    if (!t_same(t_bytes(?o, 0), 0, ?want[0], 10)) { ret 6; }
    if (o.relocs.count != 0)                      { ret 7; }
    if (!t_done(?t, ?o))                          { ret 8; }
    ret 0;
}

# a constant-time range and a function's frame reach mink's object at the offsets the layout placed them at, the frame
# starting from the one the set states for riscv64, its canonical frame address at sp with no offset, and its rule at
# the instruction it precedes
test build__ct_ranges_and_frames_reach_minks_object_at_their_laid_out_offsets {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val text: Section = t_text(?t, ".text");
    val f:    Label   = t_named(?t, "f");
    if (!t_ok(expose(?t.b, f, T_GLOBAL)) || !t_ok(define(?t.b, f)) || !t_ok(cfi_start(?t.b, f))) { ret 2; }
    if (!t_emit(?t, "addi", t_reg(2), t_reg(2), operand.Value.immediate{-16}))                   { ret 3; }
    if (!t_ok(cfi(?t.b, frame.Rule.cfa_offset{16})) || !t_ok(ct_begin(?t.b)))                    { ret 4; }
    if (!t_emit(?t, "add", t_reg(10), t_reg(10), t_reg(11)))                                     { ret 5; }
    if (!t_ok(ct_end(?t.b)) || !t_ok(cfi_end(?t.b)))                                             { ret 6; }
    # a range ended with none begun, and a rule with no frame open
    if (t_ok(ct_end(?t.b)) || t_ok(cfi(?t.b, frame.Rule.cfa_offset{0}))) { ret 7; }
    val made: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel made.err) { ret 8; }
    var o: mink_object.Object = made.ok;
    if (table.count[mink_object.CtRange](?o.ct) != 1 || table.count[mink_object.Frame](?o.frames) != 1) { ret 9; }
    val c: *mink_object.CtRange = table.at[mink_object.CtRange](?o.ct, table.nth[mink_object.CtRange](0));
    if (c.section.index != text.index || c.start != 4 || c.end != 8) { ret 10; }
    val fr: *mink_object.Frame = table.at[mink_object.Frame](?o.frames, table.nth[mink_object.Frame](0));
    if (fr.start != 0 || fr.end != 8 || fr.cie.code_align != 1 || fr.cie.data_align != -8)        { ret 11; }
    if (table.count[frame.Rule](?fr.cie.initial) != 1 || table.count[frame.Step](?fr.steps) != 1) { ret 12; }
    val cfa: frame.Rule = @table.at[frame.Rule](?fr.cie.initial, table.nth[frame.Rule](0));
    if (!sel cfa.def_cfa)                                { ret 13; }
    if (cfa.def_cfa.reg != 2 || cfa.def_cfa.offset != 0) { ret 13; }
    val step: *frame.Step = table.at[frame.Step](?fr.steps, table.nth[frame.Step](0));
    val rule: frame.Rule  = step.rule;
    if (step.at != 4)          { ret 14; }
    if (!sel rule.cfa_offset)  { ret 14; }
    if (rule.cfa_offset != 16) { ret 14; }
    if (!t_done(?t, ?o))       { ret 15; }
    ret 0;
}

# a set whose one row takes a group of two ids, as spir-v's `OpDecorate` holds ids within a value: its kind writes each
# member as a word and records the fixup of a symbolic one by `field.inner_fixup`, a symbol taking fixup kind 1
#[testing]
val T_GROUP_ID: operand.Operand = operand.Operand{shape: operand.Shape.id{operand.Typed{space: 0, bits: 32, fixup: 1}}, role: operand.READ, width: 0, quantity: operand.ONE};

#[testing]
val T_GROUP_MEMBERS: [2]operand.Operand = [2]operand.Operand{T_GROUP_ID, T_GROUP_ID};

#[testing]
val T_GROUP_OPERANDS: [1]operand.Operand = [1]operand.Operand{operand.Operand{shape: operand.Shape.group{operand.Group{at: ?T_GROUP_MEMBERS[0], len: 2}}, role: operand.READ, width: 0, quantity: operand.ONE}};

#[testing]
val T_GROUP_FIELDS: [1]field.Field = [1]field.Field{field.Field{kind: 0, width: 0, fixed: 0, mask: 0, slices: field.NO_SLICES, operand: field.NO_OPERAND, param: 0}};

#[testing]
val T_GROUP_ROWS: [1]row.Row = [1]row.Row{
    row.Row{key: "decorate", mnemonic: "decorate", operands: row.Operands{at: ?T_GROUP_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?T_GROUP_FIELDS[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?T_X86_EFFECT, ct: ?ct.INDEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0, index: 0},
};

# each member of the group a word, a symbolic one zero with its fixup recorded where the word starts
#[testing]
fun t_group_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val v: operand.Value = enc.values[0];
    if (!sel v.group) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, 0, 0)}; }
    val members: operand.Values = v.group;
    var i:       u32            = 0;
    for (i < members.len) {
        val m:     *operand.Value     = ?members.at[i];
        val noted: err[field.Refusal] = field.inner_fixup(enc, 0, ?T_GROUP_MEMBERS[i].shape, m, enc.out.len - enc.start);
        if (sel noted.err) { ret noted; }
        var word: u64 = 0;
        if (sel m.id) { word = m.id::u64; }
        val put_: err[field.Refusal] = field.put(enc, word, 4);
        if (sel put_.err) { ret put_; }
        i = i + 1;
    }
    ret err[field.Refusal].ok{};
}

#[testing]
fun t_group_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, 0, 0)};
}

#[testing]
val T_GROUP_KIND: field.Kind = field.Kind{name: "words", admit: nil, encode: t_group_encode, decode: t_group_decode, finish: nil, complete: nil};

#[testing]
val T_GROUP_KINDS: [1]*field.Kind = [1]*field.Kind{?T_GROUP_KIND};

#[testing]
val T_GROUP_TABLE: field.Table = field.Table{kinds: ?T_GROUP_KINDS[0], count: 1, order: field.LITTLE};

#[testing]
val T_GROUP_KEYS: [1]index.Entry = [1]index.Entry{index.Entry{key: "decorate", row: 0}};

#[testing]
val T_GROUP_CODEC: dispatch.Codec = dispatch.Codec{fields: ?T_GROUP_TABLE, registers: ?riscv_register.FILE, rows: row.Rows{at: ?T_GROUP_ROWS[0], len: 1}, keys: index.Index{at: ?T_GROUP_KEYS[0], len: 1}, dispatch: nil};

#[testing]
val T_GROUP_BINDINGS: [1]core_fixup.Binding = [1]core_fixup.Binding{core_fixup.Binding{fixup: 1, kind: ?reloc.ABS32}};

# a symbol held inside a value, a group's member, is relocated as a top-level one is, at the word that holds it (#327
# finding of #328)
test build__a_symbol_inside_a_value_is_relocated_as_a_top_level_one_is {
    var t: T;
    if (!t_open(?t, "rv64i")) { ret 1; }
    t.x          = riscv_set.SET;
    t.x.codec    = ?T_GROUP_CODEC;
    t.x.bindings = core_fixup.Bindings{at: ?T_GROUP_BINDINGS[0], len: 1};
    t.x.relax    = relax.NO_RELAXATIONS;
    t.x.compress = compress.NO_COMPRESSIONS;
    t.x.spans    = core_fixup.NO_SPANS;
    t.x.data     = core_fixup.NO_DATA;
    val built: res[Builder, Refusal] = make(testing.allocator_of(?t.t), ?t.formats, ?t.x, ?t.ctx, ?arch_riscv.RISCV64, ?mink_format.ELF);
    if (sel built.err) { ret 2; }
    t.b = built.ok;
    if (!t_ok(traits(?t.b, ?arch_riscv.RISCV_LP64D))) { ret 3; }
    t_text(?t, ".text");
    val x: Label = t_named(?t, "x");
    if (!t_ok(expose(?t.b, x, T_GLOBAL))) { ret 4; }
    var members: [2]operand.Value = [2]operand.Value{operand.Value.id{7}, operand.Value.symbol{operand.Symbol{id: x.id, addend: 3, fixup: operand.NO_FIXUP}}};
    var values:  [1]operand.Value = [1]operand.Value{operand.Value.group{operand.Values{at: ?members[0], len: 2}}};
    var ins:     inst.Inst        = inst.Inst{row: ?T_GROUP_ROWS[0], values: ?values[0], count: 1};
    if (!t_ok(emit(?t.b, ?ins, operand.NO_FIXUP))) { ret 5; }
    val done: res[mink_object.Object, Refusal] = finish(?t.b);
    if (sel done.err) { ret 6; }
    var o:    mink_object.Object = done.ok;
    val want: [8]u8              = [8]u8{7, 0, 0, 0, 0, 0, 0, 0};
    if (!t_same(t_bytes(?o, 0), 0, ?want[0], 8) || o.relocs.count != 1) { ret 7; }
    val r: *mink_object.Reloc = t_reloc(?o, 0);
    if (r.offset != 4 || r.kind != ?reloc.ABS32 || r.addend != 3) { ret 8; }
    val sym: *mink_object.Symbol = t_named_by(?o, r);
    if (sym == nil || sym.binding != ?mink_symbol.GLOBAL) { ret 9; }
    if (!t_done(?t, ?o))                                  { ret 10; }
    ret 0;
}
