# whether the builder's abi row is one its object is built under: the architecture's own, none only where its family
# has no abi rows, and one whose convention the set states admits the object's context and every context the source
# put in force, as `.option arch, +d` in an ilp32e object is not, refused with the convention's cited reason and the
# context it does not admit when not
fun check_abi(b: *Builder) err[Refusal] {
    if (b.abi == nil) {
        if (b.arch.family.abi_count > 0) { ret refused(NO_ABI); }
        ret err[Refusal].ok{};
    }
    if (b.abi.arch != b.arch) { ret refused(OTHER_ABI); }
    val c: opt[*set.Convention] = set.unconventional(b.set, b.abi, b.object);
    if (sel c.some) { ret refused(c.some.refusal); }
    var i: usize = 0;
    for (i < b.views.len) {
        val v: *core_state.Context  = b.views.data[i];
        val w: opt[*set.Convention] = set.unconventional(b.set, b.abi, v);
        if (sel w.some) { ret err[Refusal].err{Refusal{message: w.some.refusal, label: operand.NO_SYMBOL, view: v}}; }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# whether the object's context `object`, of the set `s`, enters the set's architecture `arch`, as every object the set
# writes for `arch` must, refused naming what it lacks
pub fun enters(s: *set.Set, arch: *mink_arch.Arch, object: *core_state.Context) err[Refusal] {
    val row: opt[*set.Arch] = set.arch_of(s, arch);
    if (sel row.none)       { ret err[Refusal].err{refuse(ARCH)}; }
    if (!of_set(s, object)) { ret err[Refusal].err{refuse(SELECTION)}; }
    ret check_entry(row.some, object);
}

# whether the object's context enters architecture row `row`, which the set registers for every architecture it serves
fun check_entry(row: *set.Arch, object: *core_state.Context) err[Refusal] {
    if (core_state.admits(object, row.enters)) { ret err[Refusal].ok{}; }
    var m: Mismatch = Mismatch{arch: row.arch.name, unmet: core_state.nothing_unmet()};
    core_state.unmet(object, row.enters, ?m.unmet);
    ret err[Refusal].err{Refusal{message: MODE, label: operand.NO_SYMBOL, mode: opt[Mismatch].some{m}}};
}

# a builder of an object for `arch` in format `format` over `s`, under the object's context `object`, which the caller
# makes with `set.open` and keeps, with its selection and view, until the builder is released. a format that encodes no
# traits for the architecture is refused naming it. the object's conventions are the abi row `traits` names
pub fun make(a: *A.Allocator, formats: *registry.Registry, s: *set.Set, object: *core_state.Context, arch: *mink_arch.Arch, format: *mink_format.Format) res[Builder, Refusal] {
    val entered: err[Refusal] = enters(s, arch, object);
    if (sel entered.err) { ret res[Builder, Refusal].err{entered.err}; }
    var encoded: table.Table[contract.Encoded] = table.make[contract.Encoded](a);
    val listed:  err[fail.Fail]                = trait.encodes(formats, format, arch, ?encoded);
    if (sel listed.err) {
        val released: err[fail.Fail] = table.release[contract.Encoded](?encoded);
        ret res[Builder, Refusal].err{Refusal{message: NO_TRAITS, label: operand.NO_SYMBOL, object: opt[fail.Fail].some{listed.err}}};
    }
    val naming: res[*contract.Naming, fail.Fail] = registry.naming(formats, format);
    if (sel naming.err) {
        val released: err[fail.Fail] = table.release[contract.Encoded](?encoded);
        ret res[Builder, Refusal].err{Refusal{message: NO_NAMING, label: operand.NO_SYMBOL, object: opt[fail.Fail].some{naming.err}}};
    }
    var b: Builder = Builder{
        a:        a,
        formats:  formats,
        format:   format,
        naming:   naming.ok,
        abi:      nil,
        chosen:   false,
        encoded:  encoded,
        set:      s,
        object:   object,
        view:     object,
        views:    vector.init[*core_state.Context](a),
        syntax:   0,
        arch:     arch,
        kinds:    vector.init[*reloc.Kind](a),
        added:    vector.init[operand.FixupKind](a),
        relocs:   registry.relocations(formats, format, arch),
        areas:    vector.init[Area](a),
        current:  opt[usize].none{},
        start:    opt[Spec].none{},
        started:  opt[u32].none{},
        labels:   vector.init[Mark](a),
        names:    intern.make(a),
        named:    vector.init[u32](a),
        titled:   vector.init[u32](a),
        values:   vector.init[operand.Value](a),
        members:  vector.init[operand.Value](a),
        literals: vector.init[u8](a),
        data:     vector.init[u8](a),
        scratch:  vector.init[u8](a),
        fixups:   vector.init[field.Fixup](a),
        pending:  vector.init[Pending](a),
        entries:  vector.init[Entry](a),
        listed:   vector.init[operand.Value](a),
        realigns: vector.init[Realigned](a),
        said:     vector.init[Said](a),
        texts:    vector.init[u8](a),
        raised:   vector.init[Raised](a),
        sources:  vector.init[table.Id[intern.Name]](a),
        waiting:  vector.init[Waiting](a),
        writers:  vector.init[Writer](a),
        taken:    opt[Snapshot].none{},
        cts:      vector.init[Ct](a),
        frames:   vector.init[Framed](a),
        rules:    vector.init[Ruled](a),
        kept:     vector.init[Cfa](a),
        frame_to: opt[frame.Destinations].none{},
        bridges:  vector.init[Bridged](a),
        defined:  opt[Label].none{},
        mapping:  mapping_of(formats, arch, format),
        modes:    mode.initial(?s.assembly),
        states:   vector.init[mode.State](a),
        state:    0,
        direct:   vector.init[Direct](a),
        told:     vector.init[Told](a),
        finished: false,
        placings: 0,
        atoms:    vector.init[Atom](a),
        dialect:  spoken_of(format, arch),
    };
    # the bindings indexed by fixup kind, so a relocation's kind is one load
    var top: usize = 0;
    var i:   u32   = 0;
    for (i < s.bindings.len) {
        if (s.bindings.at[i].fixup::usize > top) { top = s.bindings.at[i].fixup::usize; }
        i = i + 1;
    }
    var ok: bool = held(vector.push[mode.State](?b.states, b.modes));
    ok = ok && (s.bindings.len == 0 || held(vector.reserve[*reloc.Kind](?b.kinds, top + 1)));
    ok = ok && (s.bindings.len == 0 || held(vector.reserve[operand.FixupKind](?b.added, top + 1)));
    if (ok && s.bindings.len > 0) {
        var k: usize = 0;
        for (k <= top) {
            b.kinds.data[k] = nil;
            b.added.data[k] = operand.NO_FIXUP;
            k               = k + 1;
        }
        vector.truncate[*reloc.Kind](?b.kinds, 0);
        vector.commit[*reloc.Kind](?b.kinds, top + 1);
        vector.truncate[operand.FixupKind](?b.added, 0);
        vector.commit[operand.FixupKind](?b.added, top + 1);
        i = 0;
        # a kind bound on other architectures alone stays unbound here, refused where an instruction takes it
        for (i < s.bindings.len) {
            val bound: *core_fixup.Binding = ?s.bindings.at[i];
            if (core_fixup.binds(bound, arch)) {
                b.kinds.data[bound.fixup::usize] = bound.kind;
                b.added.data[bound.fixup::usize] = core_fixup.added(bound, format);
            }
            i = i + 1;
        }
    }
    i = 0;
    for (i < s.data.len) {
        val d: *core_fixup.Datum = ?s.data.at[i];
        if (d.basis <= core_fixup.RELATIVE && d.width <= core_fixup.MAX_WIDTH) { b.data_kind[datum_slot(d.basis, d.width)] = d.fixup; }
        i = i + 1;
    }
    i = 0;
    for (i < s.pairs.len) {
        val q: *core_fixup.Pair = ?s.pairs.at[i];
        if (q.width <= core_fixup.MAX_WIDTH && q.encoding <= core_fixup.SLEB) {
            b.adds[pair_slot(q.encoding, q.width)] = q.add;
            b.subs[pair_slot(q.encoding, q.width)] = q.sub;
        }
        i = i + 1;
    }
    # a typed stream's state is the object's, begun with it, which every view of the object reads
    if (ok && s.codec.stream != nil) {
        if (object.stream != nil) {
            release(?b);
            ret res[Builder, Refusal].err{refuse(STREAMED)};
        }
        val made: res[ptr, A.Error] = s.codec.stream.make(a);
        ok = sel made.ok;
        if (sel made.ok) {
            s.codec.stream.begin(made.ok);
            object.stream = made.ok;
        }
    }
    if (!ok) {
        release(?b);
        ret res[Builder, Refusal].err{memory()};
    }
    ret res[Builder, Refusal].ok{b};
}

# the mapping symbols an object of `arch` in `format` holds, as mink's pair of them states them. a format that states
# nothing for the architecture marks nothing
pub fun mapping_of(formats: *registry.Registry, arch: *mink_arch.Arch, format: *mink_format.Format) opt[*mink_pair.Mapping] {
    val r: res[*registration.Registration, fail.Fail] = registry.by_format(formats, format);
    if (sel r.err) { ret opt[*mink_pair.Mapping].none{}; }
    val p: res[*mink_pair.Pair, fail.Fail] = registration.pair_of(r.ok, arch);
    if (sel p.err) { ret opt[*mink_pair.Mapping].none{}; }
    ret p.ok.mapping;
}

# how the object's format names sections
pub fun naming(b: *Builder) *contract.Naming {
    ret b.naming;
}

# the assembler modes the next statement is read under, which the reader of each statement reads them through
pub fun modes_of(b: *Builder) *mode.State {
    ret ?b.modes;
}

# the mode of `to` at its value for the statements after, as the caller's flags start the source and a directive changes
# it between statements
pub fun set_mode(b: *Builder, to: mode.Setting) err[Refusal] {
    var next: mode.State = b.modes;
    if (!mode.change(?next, to))                         { ret refused(OTHER_MODE); }
    if (mode.same(?next, ?b.modes))                      { ret err[Refusal].ok{}; }
    if (!held(vector.push[mode.State](?b.states, next))) { ret err[Refusal].err{memory()}; }
    b.modes = next;
    b.state = (b.states.len - 1)::u32;
    ret err[Refusal].ok{};
}

# give back everything the builder owns. a finished object is the caller's and is not touched
pub fun release(b: *Builder) {
    var i: usize = 0;
    for (i < b.areas.len) {
        val area: *Area = ?b.areas.data[i];
        vector.dnit[Fragment](?area.fragments);
        vector.dnit[u32](?area.marks);
        vector.dnit[u8](?area.bytes);
        i = i + 1;
    }
    vector.dnit[*reloc.Kind](?b.kinds);
    vector.dnit[operand.FixupKind](?b.added);
    vector.dnit[Area](?b.areas);
    vector.dnit[Mark](?b.labels);
    intern.release(?b.names);
    vector.dnit[u32](?b.named);
    vector.dnit[u32](?b.titled);
    vector.dnit[operand.Value](?b.values);
    vector.dnit[operand.Value](?b.members);
    vector.dnit[u8](?b.literals);
    vector.dnit[u8](?b.data);
    vector.dnit[u8](?b.scratch);
    vector.dnit[field.Fixup](?b.fixups);
    vector.dnit[Pending](?b.pending);
    vector.dnit[Entry](?b.entries);
    vector.dnit[operand.Value](?b.listed);
    vector.dnit[Realigned](?b.realigns);
    val released: err[fail.Fail] = table.release[contract.Encoded](?b.encoded);
    vector.dnit[Said](?b.said);
    vector.dnit[*core_state.Context](?b.views);
    vector.dnit[u8](?b.texts);
    var r: usize = 0;
    for (r < b.raised.len) {
        vector.dnit[u8](?b.raised.data[r].bytes);
        r = r + 1;
    }
    vector.dnit[Raised](?b.raised);
    vector.dnit[table.Id[intern.Name]](?b.sources);
    vector.dnit[Waiting](?b.waiting);
    vector.dnit[Writer](?b.writers);
    vector.dnit[Ct](?b.cts);
    vector.dnit[Framed](?b.frames);
    vector.dnit[Ruled](?b.rules);
    vector.dnit[Cfa](?b.kept);
    vector.dnit[Bridged](?b.bridges);
    vector.dnit[mode.State](?b.states);
    vector.dnit[Direct](?b.direct);
    vector.dnit[Told](?b.told);
    vector.dnit[Atom](?b.atoms);
    if (b.set.codec.stream != nil && b.object.stream != nil) {
        b.set.codec.stream.release(b.a, b.object.stream);
        b.object.stream = nil;
    }
}

# every section laid out to a fixed point from what was emitted, so the places of labels and the sizes of sections are
# final until something more is emitted. it starts from the instructions as emitted, so a refused layout leaves no growth
# behind
pub fun layout(b: *Builder) err[Refusal] {
    if (b.finished) { ret refused(FINISHED); }
    val placed: err[Refusal] = settle_waiting(b);
    if (sel placed.err)  { ret placed; }
    if (!index_atoms(b)) { ret err[Refusal].err{memory()}; }
    var s: usize = 0;
    for (s < b.areas.len) {
        val area: *Area = ?b.areas.data[s];
        area.symbol = opt[table.Id[mink_object.Symbol]].none{};
        var j: usize = 0;
        for (j < area.fragments.len) {
            val f: *Fragment = ?area.fragments.data[j];
            if (sel f.body.code) {
                f.body.code.depth = 0;
                f.size            = f.body.code.initial;
            }
            j = j + 1;
        }
        s = s + 1;
    }
    var i: usize = 0;
    for (i < b.labels.len) {
        b.labels.data[i].symbol = opt[table.Id[mink_object.Symbol]].none{};
        i                       = i + 1;
    }
    ret lay(b);
}

# the length of section `s` in the last layout
pub fun size_of(b: *Builder, s: Section) u64 {
    if (s.index::usize >= b.areas.len) { ret 0; }
    ret b.areas.data[s.index::usize].size;
}

# what a writer can only append to, as it is now
fun snapshot(b: *Builder) Snapshot {
    ret Snapshot{
        areas:    b.areas.len,
        labels:   b.labels.len,
        values:   b.values.len,
        members:  b.members.len,
        literals: b.literals.len,
        data:     b.data.len,
        waiting:  b.waiting.len,
        names:    intern.count(?b.names),
        sources:  b.sources.len,
        realigns: b.realigns.len,
        current:  b.current,
        started:  b.started,
        view:     b.view,
        syntax:   b.syntax,
        modes:    b.modes,
        states:   b.states.len,
        state:    b.state,
        told:     b.told.len,
    };
}

# everything added since `s` taken back by truncation, which is every effect of a writer, as it may only add
fun restore(b: *Builder, s: *Snapshot) {
    var i: usize = s.areas;
    for (i < b.areas.len) {
        val area: *Area = ?b.areas.data[i];
        if (sel area.name.some) {
            if (b.titled.data[area.name.some.index::usize] == i::u32 + 1) { b.titled.data[area.name.some.index::usize] = 0; }
        }
        vector.dnit[Fragment](?area.fragments);
        vector.dnit[u32](?area.marks);
        vector.dnit[u8](?area.bytes);
        i = i + 1;
    }
    vector.truncate[Area](?b.areas, s.areas);
    i = s.labels;
    for (i < b.labels.len) {
        val m: *Mark = ?b.labels.data[i];
        if (sel m.name.some) { b.named.data[m.name.some.index::usize] = operand.NO_SYMBOL; }
        i = i + 1;
    }
    vector.truncate[Mark](?b.labels, s.labels);
    vector.truncate[operand.Value](?b.values, s.values);
    vector.truncate[operand.Value](?b.members, s.members);
    vector.truncate[u8](?b.literals, s.literals);
    vector.truncate[u8](?b.data, s.data);
    vector.truncate[Waiting](?b.waiting, s.waiting);
    vector.truncate[table.Id[intern.Name]](?b.sources, s.sources);
    vector.truncate[Realigned](?b.realigns, s.realigns);
    # the mark is the interner's own count from `snapshot`, so truncating to it cannot be refused
    val cut: err[fail.Fail] = intern.truncate(?b.names, s.names);
    vector.truncate[u32](?b.named, s.names);
    vector.truncate[u32](?b.titled, s.names);
    b.current = s.current;
    b.started = s.started;
    b.view    = s.view;
    b.syntax  = s.syntax;
    b.modes   = s.modes;
    vector.truncate[mode.State](?b.states, s.states);
    b.state = s.state;
    vector.truncate[Told](?b.told, s.told);
}

# every writer run in order, each writing from the final places, refused at the first that fails
fun write_all(b: *Builder) err[Refusal] {
    var i: usize = 0;
    for (i < b.writers.len) {
        val w: *Writer = ?b.writers.data[i];
        if (w.write != nil) {
            val wrote: err[Refusal] = w.write(w.context, b);
            if (sel wrote.err) { ret wrote; }
        }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# every writer's records stated on `o` in order, with the builder closed, refused at the first that fails
fun record_all(b: *Builder, o: *mink_object.Object) err[Refusal] {
    b.finished = true;
    var made: err[Refusal] = err[Refusal].ok{};
    var i:    usize        = 0;
    for (i < b.writers.len) {
        val w: *Writer = ?b.writers.data[i];
        if (w.record != nil) {
            made = w.record(w.context, b, o);
            if (sel made.err) { brk; }
        }
        i = i + 1;
    }
    b.finished = false;
    ret made;
}

# the facts of the set's own its typed stream states on `o`, from what the object's instructions defined, under the
# object's context
fun record_stream(b: *Builder, o: *mink_object.Object) err[fail.Fail] {
    val h: *stream.Hooks = b.set.codec.stream;
    if (h == nil || h.record == nil) { ret err[fail.Fail].ok{}; }
    ret h.record(b.object.stream, b.object, o);
}

# the object made of the layout as it stands
fun produce(b: *Builder) res[mink_object.Object, Refusal] {
    val encoded: err[Refusal] = encode_all(b);
    if (sel encoded.err) { ret res[mink_object.Object, Refusal].err{encoded.err}; }
    val settled_: err[Refusal] = checked_labels(b);
    if (sel settled_.err) { ret res[mink_object.Object, Refusal].err{settled_.err}; }
    val numbered: err[Refusal] = number_stems(b);
    if (sel numbered.err) { ret res[mink_object.Object, Refusal].err{numbered.err}; }
    val raised: err[Refusal] = raise_all(b);
    if (sel raised.err) { ret res[mink_object.Object, Refusal].err{raised.err}; }
    var o:      mink_object.Object = mink_object.make(b.a, b.arch, ?catalog_kind.RELOCATABLE);
    val traits: err[Refusal]       = state_traits(b, ?o);
    if (sel traits.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{traits.err};
    }
    val built: err[fail.Fail] = build_object(b, ?o);
    if (sel built.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{failed(built.err)};
    }
    val told: err[fail.Fail] = record_told(b, ?o);
    if (sel told.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{failed(told.err)};
    }
    val mapped: err[Refusal] = map_sections(b, ?o);
    if (sel mapped.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{mapped.err};
    }
    val streamed: err[fail.Fail] = record_stream(b, ?o);
    if (sel streamed.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{failed(streamed.err)};
    }
    val marked: err[Refusal] = record_cts(b, ?o);
    if (sel marked.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{marked.err};
    }
    val framed_: err[Refusal] = record_frames(b, ?o);
    if (sel framed_.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{framed_.err};
    }
    val bridged: err[Refusal] = record_bridges(b, ?o);
    if (sel bridged.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{bridged.err};
    }
    val recorded: err[Refusal] = record_all(b, ?o);
    if (sel recorded.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{recorded.err};
    }
    ret res[mink_object.Object, Refusal].ok{o};
}

# the builder laid out to a fixed point and encoded, handed over as mink's neutral object, which the caller releases.
# once the layout is settled every writer runs, in the order added, and what they added is laid out with the rest, and
# once the object is made every writer states its records on it. a finish is all or none: a refused one takes back
# everything the writers added, releases the object with its records and leaves the builder as it was, to be emitted
# into and finished again, when the layout is made anew and every writer runs again from a clean state
pub fun finish(b: *Builder) res[mink_object.Object, Refusal] {
    if (b.finished) { ret res[mink_object.Object, Refusal].err{refuse(FINISHED)}; }
    val named: err[Refusal] = check_abi(b);
    if (sel named.err) { ret res[mink_object.Object, Refusal].err{named.err}; }
    var before: Snapshot             = snapshot(b);
    var moved:  vector.Vector[Moved] = vector.init[Moved](b.a);
    val weak:   err[Refusal]         = weaken(b, ?moved);
    var laid:   err[Refusal]         = weak;
    if (!sel laid.err) { laid = layout(b); }
    if (sel laid.err) {
        unweaken(b, ?moved);
        restore(b, ?before);
        vector.dnit[Moved](?moved);
        ret res[mink_object.Object, Refusal].err{laid.err};
    }
    if (b.writers.len > 0) {
        # writers write what no source statement scopes, under the object's selection
        val scoped: *core_state.Context = b.view;
        b.taken = opt[Snapshot].some{before};
        b.view  = b.object;
        val wrote: err[Refusal] = write_all(b);
        b.taken = opt[Snapshot].none{};
        b.view  = scoped;
        if (sel wrote.err) {
            unweaken(b, ?moved);
            restore(b, ?before);
            vector.dnit[Moved](?moved);
            ret res[mink_object.Object, Refusal].err{wrote.err};
        }
        val again: err[Refusal] = layout(b);
        if (sel again.err) {
            unweaken(b, ?moved);
            restore(b, ?before);
            vector.dnit[Moved](?moved);
            ret res[mink_object.Object, Refusal].err{again.err};
        }
    }
    val made: res[mink_object.Object, Refusal] = produce(b);
    if (sel made.err) {
        unweaken(b, ?moved);
        restore(b, ?before);
        vector.dnit[Moved](?moved);
        ret made;
    }
    vector.dnit[Moved](?moved);
    b.finished = true;
    ret made;
}

# how many encoded instructions the finished object has
pub fun line_count(b: *Builder) usize {
    ret b.entries.len;
}

# encoded instruction `i` of the finished object, in section order and then offset order
pub fun line(b: *Builder, i: usize) Line {
    val e:       *Entry    = ?b.entries.data[i];
    val ins:     inst.Inst = inst.Inst{row: coded(?e.of), values: ?b.listed.data[e.values], count: e.count, form: e.form};
    var encoded: Encoded   = Encoded.instruction{ins};
    if (sel e.of.format) { encoded = Encoded.format{Formatted{format: e.of.format, inst: ins}}; }
    ret Line{section: Section{index: e.section}, offset: e.offset, length: e.length, encoded: encoded, run: e.run};
}

# the alignments the linker realigns in the last layout, in section order and then offset order, where their padding is
# not what the alignment asked for. the rows are the builder's and are valid until it is next laid out or released
pub fun realigned_all(b: *Builder) Realignments {
    ret Realignments{at: b.realigns.data, len: b.realigns.len};
}

# where `l` lies once the layout is settled, in the finished object or after `layout`, none for a label never defined
pub fun place_of(b: *Builder, l: Label) opt[mink_object.Place] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none) { ret opt[mink_object.Place].none{}; }
    val at: *Mark = m.some;
    if (!at.defined) { ret opt[mink_object.Place].none{}; }
    val area: *Area = ?b.areas.data[at.section::usize];
    ret opt[mink_object.Place].some{mink_object.Place{section: table.Id[mink_object.Section]{index: at.section}, offset: offset_at(area, at.fragment)}};
}

# the symbol of the finished object `l` became, none for a local label no relocation names
pub fun symbol_of(b: *Builder, l: Label) opt[table.Id[mink_object.Symbol]] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none) { ret opt[table.Id[mink_object.Symbol]].none{}; }
    ret m.some.symbol;
}

# the name `l` was made with, none for an anonymous label or one of another builder
pub fun label_name(b: *Builder, l: Label) opt[View] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none)           { ret opt[View].none{}; }
    if (sel m.some.name.none) { ret opt[View].none{}; }
    ret opt[View].some{intern.bytes_of(?b.names, m.some.name.some)};
}

# how many sections the builder has opened
pub fun section_count(b: *Builder) usize {
    ret b.areas.len;
}

# how many facts the instructions the set reads as what they state stated, which `told_at` bounds
pub fun told_count(b: *Builder) usize {
    ret b.told.len;
}

# fact `i` of those the instructions the set reads as what they state stated, in the order stated
pub fun told_at(b: *Builder, i: usize) StatedFact {
    val t:   *Told      = ?b.told.data[i];
    var out: StatedFact = StatedFact{fact: t.fact, value: t.value, data: opt[View].none{}};
    if (sel t.data.some) { out.data = opt[View].some{View{data: ?b.texts.data[t.data.some.start], len: t.data.some.len}}; }
    ret out;
}

# the setting an instruction the set reads as what it states stated of axis `x`, none when none did
pub fun row_said(b: *Builder, x: *mink_trait.Axis) opt[mink_trait.Setting] {
    val on: opt[*Said] = said_on(b, x);
    if (sel on.some) {
        if (on.some.by_row) { ret opt[mink_trait.Setting].some{on.some.setting}; }
    }
    ret opt[mink_trait.Setting].none{};
}

# the setting the value `n` of an instruction's operand states of axis `x` in the builder's format, as `stated_by`
# maps it, none when the format maps it to none
pub fun setting_of(b: *Builder, x: *mink_trait.Axis, n: u64) opt[mink_trait.Setting] {
    val got: res[mink_trait.Setting, fail.Fail] = registry.setting(b.formats, b.format, x, contract.Written.number{n});
    if (sel got.err) { ret opt[mink_trait.Setting].none{}; }
    ret opt[mink_trait.Setting].some{got.ok};
}

# what section `s` was opened as, which `section_count` bounds
pub fun opened(b: *Builder, s: Section) Opened {
    val area: *Area     = ?b.areas.data[s.index::usize];
    var name: opt[View] = opt[View].none{};
    if (sel area.name.some) { name = opt[View].some{intern.bytes_of(?b.names, area.name.some)}; }
    ret Opened{name: name, kind: area.kind, flags: area.flags, disposition: area.disposition, entsize: area.entsize};
}

# how many statements section `s` holds, 0 for a section of another builder
pub fun statement_count(b: *Builder, s: Section) usize {
    if (s.index::usize >= b.areas.len) { ret 0; }
    ret b.areas.data[s.index::usize].fragments.len;
}

# statement `j` of section `s`, which `statement_count` bounds. an instruction's values are copied into `values`, which
# holds row.MAX_OPERANDS, and its lists and literals point into the builder, valid until it is next written or released
pub fun statement(b: *Builder, s: Section, j: usize, values: *operand.Value) Statement {
    val f:      *Fragment = ?b.areas.data[s.index::usize].fragments.data[j];
    var stated: Stated    = Stated.zero{0};
    if (sel f.body.code) {
        val c: *Code = ?f.body.code;
        recall(b, c, values);
        val ins: inst.Inst = inst.Inst{row: coded(?c.of), values: values, count: c.count, form: c.form};
        if (sel c.of.format) { stated = Stated.format{Formatted{format: c.of.format, inst: ins}}; }
        or                   { stated = Stated.code{Written{inst: ins, marker: c.marker, run: c.run}}; }
    }
    or (sel f.body.data)       { stated = Stated.data{View{data: ?b.data.data[f.body.data.start], len: f.body.data.len}}; }
    or (sel f.body.zero)       { stated = Stated.zero{f.body.zero}; }
    or (sel f.body.align)      { stated = Stated.align{f.body.align}; }
    or (sel f.body.datum)      { stated = Stated.datum{f.body.datum.ref}; }
    or (sel f.body.difference) { stated = Stated.difference{Measure{of: f.body.difference.of, width: f.body.difference.width, encoding: f.body.difference.encoding}}; }
    ret Statement{stated: stated, view: f.view, syntax: f.syntax, modes: modes_at(b, f), offset: f.offset};
}

# where `l` is placed in the statement record, none for a label not placed or of another builder
pub fun spot_of(b: *Builder, l: Label) opt[Spot] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none)      { ret opt[Spot].none{}; }
    if (!m.some.defined) { ret opt[Spot].none{}; }
    ret opt[Spot].some{Spot{section: Section{index: m.some.section}, statement: m.some.fragment, order: m.some.order}};
}

# what makes `l` a symbol of the object, none for a local label or one of another builder
pub fun exposure_of(b: *Builder, l: Label) opt[Exposure] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none) { ret opt[Exposure].none{}; }
    ret m.some.exposure;
}

# what `l` is given in place of a place, none for a label placed, never given a value, or of another builder
pub fun value_of(b: *Builder, l: Label) opt[Value] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none) { ret opt[Value].none{}; }
    ret m.some.value;
}

# the stem and number the object spells `l` by, once finished: the stem it was made with, or the stem `stem_for` gives
# a label made anonymous. none for a named label or one of another builder
pub fun stem_of(b: *Builder, l: Label) opt[Stem] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none) { ret opt[Stem].none{}; }
    val stem: str = stem_for(b, m.some);
    if (stem == nil) { ret opt[Stem].none{}; }
    ret opt[Stem].some{Stem{stem: stem, number: m.some.number}};
}

# how many source files the object names
pub fun source_count(b: *Builder) usize {
    ret b.sources.len;
}

# the name of source file `i`, in the order stated, which `source_count` bounds
pub fun source_at(b: *Builder, i: usize) View {
    ret intern.bytes_of(?b.names, b.sources.data[i]);
}

# the context of the first writer whose records `record` states, nil for none, as a module that added a writer finds
# its own facts on a builder again
pub fun writer_context(b: *Builder, record: fun(ptr, *Builder, *mink_object.Object) err[Refusal]) ptr {
    var i: usize = 0;
    for (i < b.writers.len) {
        if (b.writers.data[i].record == record) { ret b.writers.data[i].context; }
        i = i + 1;
    }
    ret nil;
}

# whether a writer states records on the object, facts that are no statement of a section, but the writer whose context
# is `besides`, nil for none, whose records the caller states itself
pub fun records(b: *Builder, besides: ptr) bool {
    var i: usize = 0;
    for (i < b.writers.len) {
        if (b.writers.data[i].record != nil && b.writers.data[i].context != besides) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the object was handed over, so the statement record and the layout are final
pub fun handed_over(b: *Builder) bool {
    ret b.finished;
}
