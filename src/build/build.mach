#[testing]
use riscv_mode: masc.isa.riscv.mode;

pub val ARCH:              str = "the set does not serve this architecture";
pub val SELECTION:         str = "the context is not of the set's extension catalog and state axes";
pub val MODE:              str = "the context does not enter the architecture";
pub val NO_SECTION:        str = "no section is current";
pub val NO_SUCH:           str = "section or label of another builder";
pub val NO_BYTES:          str = "bytes in a section that holds none";
pub val NOT_A_LABEL:       str = "operand names no label of this builder";
pub val NESTED:            str = "list member that is itself a list";
pub val TOO_MANY:          str = "more instructions than an expansion holds";
pub val SPLIT:             str = "symbol whose relocation covers instructions past the sequence it is emitted in";
pub val MARKED:            str = "instruction given a marker other than the one its relocation's span states";
pub val REDEFINED:         str = "label defined twice";
pub val BOUNDARY:          str = "alignment is not a power of two";
pub val NO_FILL:           str = "no fill pattern the selection admits fills the gap";
pub val RELAXED_ALIGN:     str = "code alignment after an instruction the linker may resize, which the set has no marker to realign";
pub val REALIGN_FORM:      str = "code alignment the linker realigns takes no limit";
pub val NO_DATUM:          str = "the set relocates no datum of this basis and width";
pub val DATUM_RANGE:       str = "datum value out of range of its width";
pub val UNRESOLVED:        str = "fixup names a label neither defined nor exposed";
pub val UNBOUND:           str = "fixup kind has no relocation kind";
pub val LOCAL_ONLY:        str = "fixup kind no format relocates, whose target is no label of the section the assembler measures";
pub val NO_RELOCATION:     str = "relocation kind the object's format does not map for the architecture";
pub val CHAIN:             str = "relaxation grows a step of a longer form";
pub val EXPAND:            str = "longer form refused";
pub val SHRANK:            str = "instruction encodes shorter than the layout reserved";
pub val UNSETTLED:         str = "layout did not settle within its bound of passes";
pub val MISSING_TRAIT:     str = "trait axis the object's format requires that no owner states, as a convention the caller's abi row leaves unstated";
pub val TRAIT_VALUE:       str = "trait stated with a value its axis does not have";
pub val NO_ABI:            str = "object of an architecture with abi rows, built under none";
pub val OTHER_ABI:         str = "abi row of another architecture than the object's";
pub val NO_TRAITS:         str = "object format that encodes no traits for the architecture";
pub val NO_NAMING:         str = "object format that names no sections";
pub val DISAGREES:         str = "trait stated with another value than its owner states on the object";
pub val TRAIT_SECTION:     str = "section the object's format holds its traits in, opened apart";
pub val RAISED:            str = "statement other than data in a section the object's format holds its traits in";
pub val RAISE:             str = "section the object's format holds its traits in, whose bytes state no traits it maps";
pub val ACROSS:            str = "difference of labels not both placed in one section";
pub val NO_PAIR:           str = "the set relocates no difference of this width across code the linker may resize";
pub val LOCAL_COMMON:      str = "common storage given to a label no other object can see";
pub val UNPLACED:          str = "label equated to a label that is never placed";
pub val CYCLE:             str = "labels equated to each other in a cycle";
pub val WIDTH:             str = "integer width outside 1 to 8 bytes";
pub val NEGATIVE:          str = "symbol size measured from a label after its end";
pub val FINISHED:          str = "builder already finished";
pub val OBJECT:            str = "object refused";
pub val NO_INSTRUCTION:    str = "place attached to the next instruction, and no instruction follows in its section";
pub val SEALED:            str = "writer changed a section or label that existed when the layout was settled";
pub val NAMELESS:          str = "source file has no name";
pub val OTHER_MODE:        str = "assembler mode of another set, or a value it does not take";
pub val NO_STEM:           str = "label stem empty or longer than a stem holds";
pub val WIDENED:           str = "context of another register file, catalog, axes or stream, or at another value of an axis the object does not switch";
pub val NO_AXIS:           str = "trait of an axis the architecture does not have";
pub val OWNED:             str = "trait the set derives from the views the object is written under, which the source does not state";
pub val UNWRITTEN:         str = "trait the set leaves unstated on every object, as its reference does, which the source does not state";
pub val NO_SYNTAX:         str = "no syntax of the set at this index";
pub val ABI_LATE:          str = "abi row named twice, or after the source stated a trait";
pub val CT_OPEN:           str = "constant-time range begun inside another, or ended where none is begun";
pub val CT_SPLIT:          str = "constant-time range that ends in another section than it begins, or is never ended";
pub val FRAME_OPEN:        str = "frame begun inside another, or a rule or end where none is begun";
pub val FRAME_SPLIT:       str = "frame that ends in another section than it begins, or is never ended";
pub val FRAME_SYMBOL:      str = "frame of a function, personality or language data whose label is no symbol of the object";
pub val NO_FRAME:          str = "frame of an architecture the set states no starting frame for";
pub val NOT_REMEMBERED:    str = "frame state restored where none is remembered";
pub val CFA_SCALES:        str = "canonical frame address register or offset changed alone while its offset scales";
pub val STARTED:           str = "starting section named twice, or opened apart";
pub val NOT_THREAD:        str = "symbol a thread-local relocation names, stated as a type other than thread-local";
pub val STREAMED:          str = "object context already in a stream";
pub val REGROUPED:         str = "section put in a group twice";
pub val SIGNATURE:         str = "section group with an empty signature";
pub val REORDERED:         str = "section given a link order twice";
pub val ORDER:             str = "section ordered after itself or after one the object holds no section for";
pub val UNVERSIONED:       str = "symbol version whose alias names no version after an @";
pub val UNDEFINED_DEFAULT: str = "default symbol version, `@@`, of a symbol the object does not define";
pub val VERSIONS:          str = "symbol renamed to two versions";
pub val NO_SYMBOL:         str = "symbol version of a label that is no symbol of the object";
pub val RELOCATED_PAST:    str = "relocation stated past its section's end, or at a label of another section";
pub val STATED_TWICE:      str = "trait an instruction states that an earlier instruction stated";
pub val STATED_VALUE:      str = "operand an instruction states a trait or fact by that holds no value it maps";

# an architecture the object's context does not enter
# ---
# arch:  the architecture asked for
# unmet: what of the requirement it enters the context lacks
pub rec Mismatch {
    arch:  str;
    unmet: core_state.Unmet;
}

# why the builder refused, leaving itself as it was
# ---
# message: what was refused, one of the wordings above, field.MEMORY or the cited reason of a convention the object's
#          context is not admitted by
# label:   the label it is about, operand.NO_SYMBOL for none
# encode:  the encoder's refusal, when an encode was refused
# object:  mink's failure, when the object refused
# mode:    the architecture and what of its entry the object's context lacks, when it does not enter it
# axis:    the trait axis, when a trait was refused or no one states one
# view:    the context the object's code was written under that a convention does not admit, nil when it is the
#          object's own or the refusal is of something else
pub rec Refusal {
    message: str;
    label:   u32;
    encode:  opt[field.Refusal];
    object:  opt[fail.Fail];
    mode:    opt[Mismatch];
    axis:    opt[*mink_trait.Axis];
    view:    *core_state.Context;
}

# a section of the builder, by its index, which is also its index in the finished object
pub rec Section {
    index: u32;
}

# a label, its id the symbol handle a symbolic operand carries, never operand.NO_SYMBOL
pub rec Label {
    id: u32;
}

# what a new section is
# ---
# name:        its name, none for a section of its kind alone, which the format names when it writes it and which is
#              re-entered by the handle `open` returns, never by a name
# kind:        the role it plays
# flags:       the flags it carries, its kind's or more
# disposition: how garbage collection treats it
# entsize:     the size of each entry of a section of entries, as strings to merge, 0 for none
# apart:       whether a named section is kept apart from the others of its name, never found by it and re-entered by
#              the handle `open` returns, as a nameless one is
pub rec Spec {
    name:        opt[str];
    kind:        *mink_section.Kind;
    flags:       mink_section.Flags;
    disposition: *mink_section.Disposition;
    entsize:     u64;
    apart:       bool;
}

# what makes a label a symbol of the object
# ---
# binding:    how far it is visible across objects
# visibility: how far it is visible across images
# kind:       what it names
# size:       its size
pub rec Exposure {
    binding:    *mink_symbol.Binding;
    visibility: *mink_symbol.Visibility;
    kind:       *mink_symbol.Kind;
    size:       Size;
}

# the difference of two labels plus an addend, measured once laid out
# ---
# plus:   the label added
# minus:  the label subtracted
# addend: the constant added
pub rec Difference {
    plus:   Label;
    minus:  Label;
    addend: i64;
}

# a symbol's size
# ---
# none:     no size is stated
# fixed:    this many bytes
# measured: the distance between two labels of one section, as `.size f, . - f` states it
pub tag Size: u8 {
    none;
    fixed:    u64;
    measured: Difference;
}

# an alignment
# ---
# boundary: the alignment in bytes, a power of two
# fill:     the byte it pads with, absent for the section's own: the set's code fill in code, zeros elsewhere. it is the
#           padding of alignment masc lays out as asked. code alignment the linker realigns is padded with the set's
#           nops under its realign marker whatever the fill, and `realigned_all` lists which those are
# max:      the most bytes it pads, absent for no limit. a gap past it is not padded
pub rec Align {
    boundary: u64;
    fill:     opt[u8];
    max:      opt[u64];
}

# a symbol's address or distance as data
# ---
# target: the label it refers to
# addend: added to the label's value
# width:  its width in bytes
# basis:  what its value is measured from
pub rec Reference {
    target: Label;
    addend: i64;
    width:  u8;
    basis:  core_fixup.Basis;
}

# an instruction stated by a format of the source dialect's instruction directive (`core_source.Insns`), as risc-v's
# `.insn r 0x33, 0, 0, a0, a1, a2`
# ---
# format: the format
# inst:   the format's row and the values given it
pub rec Formatted {
    format: *core_source.Format;
    inst:   inst.Inst;
}

# what an instruction was encoded from
# ---
# instruction: a row of the set's catalog and its values
# format:      a format and its values, whose row is no row of the catalog: the builder encodes, folds and relocates it as
#              it does a catalog row, and never compresses or relaxes it, so nothing that indexes the catalog reaches it
pub tag Encoded: u8 {
    instruction: inst.Inst;
    format:      Formatted;
}

# one encoded instruction of the finished object, as relaxation grew and the layout folded it
# ---
# section: the section it is in
# offset:  where it starts
# length:  how many bytes it is
# encoded: what it was encoded from
# run:     how many lines from this one its sequence wrote: 1 for an instruction written alone, however its form grew,
#          the sequence's lines for the first of a sequence, and 0 for a later line of one
pub rec Line {
    section: Section;
    offset:  u64;
    length:  u64;
    encoded: Encoded;
    run:     u32;
}

# an alignment the linker realigns, as the layout placed it
# ---
# section: the section it is in
# offset:  where its padding starts
# length:  how many bytes of padding it holds, its worst case
# fill:    the fill byte it was asked for, which its padding does not use
pub rec Realigned {
    section: Section;
    offset:  u64;
    length:  u64;
    fill:    opt[u8];
}

# the alignments the linker realigns
# ---
# at:  the first row, nil for none
# len: how many rows
pub rec Realignments {
    at:  *Realigned;
    len: usize;
}

# what an instruction fragment is written as
# ---
# catalog: a row of the set's catalog, as emitted
# format:  a format of the source dialect's instruction directive
tag Coded: u8 {
    catalog: *row.Row;
    format:  *core_source.Format;
}

# the row `of` is encoded by
fun coded(of: *Coded) *row.Row {
    if (sel of.format) { ret of.format.row; }
    ret of.catalog;
}

# an instruction fragment
# ---
# of:       what it is written as
# values:   its values' first slot in the builder's values
# count:    how many values
# members:  its list members' first slot in the builder's members
# literals: its literal bytes' first byte in the builder's literals
# marker:   the marker fixup kind riding beside it as written, operand.NO_FIXUP for none
# marked:   whether an instruction of its current form carries a marker, as the jal of a grown branch under relax, so
#           the linker may resize it
# form:     the encoding form it is written in, which its grown forms do not carry
# relax:    its row's relaxation, none for a row with no longer form
# initial:  its length as emitted, with every symbol encoded as zero
# depth:    how many relaxations it has grown by
# run:      how many instructions its sequence holds from it, 1 for one written alone and 0 past a sequence's first
rec Code {
    of:       Coded;
    values:   usize;
    count:    u32;
    members:  usize;
    literals: usize;
    marker:   operand.FixupKind;
    marked:   bool;
    form:     core_form.Form;
    relax:    opt[*relax.Relaxation];
    initial:  u64;
    depth:    u32;
    run:      u32;
}

# bytes of the builder's data store
rec Span {
    start: usize;
    len:   usize;
}

# a datum fragment
# ---
# fixup: the set-local fixup kind its basis and width take
# ref:   what it refers to
rec Datum {
    fixup: operand.FixupKind;
    ref:   Reference;
}

# a difference fragment
# ---
# of:    the difference it holds
# width: its width in bytes
rec Gap {
    of:    Difference;
    width: u8;
}

# what a fragment is
tag Body: u8 {
    code:       Code;
    data:       Span;
    zero:       u64;
    align:      Align;
    datum:      Datum;
    difference: Gap;
}

# a fragment and where the current pass places it
# ---
# view:   the context it was written under, which admits, encodes, relaxes and fills it
# syntax: the index of the set's syntax it was written in
# modes:  the assembler modes it was written under, by their index among the builder's mode states
rec Fragment {
    body:   Body;
    offset: u64;
    size:   u64;
    view:   *core_state.Context;
    syntax: u32;
    modes:  u32;
}

# a section's state
# ---
# name:        its name in the builder's names, none for a nameless section
# kind:        the role it plays
# flags:       the flags it carries
# disposition: how garbage collection treats it
# entsize:     the size of each of its entries, 0 for none
# align:       the largest alignment asked of it, 1 for none
# bits:        whether it holds bytes, from its kind's roles
# code:        whether it holds code, from its flags
# fragments:   its fragments in order, its cursor their end
# marks:       per fragment, how many marked instructions come before it, so a span's markers are one subtraction
# size:        its length in the current pass
# bytes:       its encoded bytes once finished
# symbol:      the object's symbol for the section, made when a relocation needs it
# group:       the signature of the comdat group it is in, none for a section in none
# owner:       the index of the section it is ordered after when linked, none for a section of no link order
rec Area {
    name:        opt[table.Id[intern.Name]];
    kind:        *mink_section.Kind;
    flags:       mink_section.Flags;
    disposition: *mink_section.Disposition;
    entsize:     u64;
    align:       u64;
    bits:        bool;
    code:        bool;
    fragments:   vector.Vector[Fragment];
    marks:       vector.Vector[u32];
    size:        u64;
    bytes:       vector.Vector[u8];
    symbol:      opt[table.Id[mink_object.Symbol]];
    group:       opt[table.Id[intern.Name]];
    owner:       opt[u32];
}

# another label plus an addend, which a label stands for
pub rec Equate {
    target: u32;
    addend: i64;
}

# a label's value when it is not placed
# ---
# absolute: this number
# common:   common storage of a size and an alignment, which the linker allocates
# equate:   another label plus an addend, as `.set alias, f + 4` makes one
pub tag Value: u8 {
    absolute: u64;
    common:   mink_object.Common;
    equate:   Equate;
}

# a label's state
# ---
# name:     its name in the builder's names, none for an anonymous label
# exposure: what makes it a symbol, none for a local label
# defined:  whether it is placed
# section:  the section it is placed in
# fragment: the fragment it precedes, the section's fragment count for its end
# value:    what it is when it is not placed, none for a label placed or never given one
# size:     its size once finished, from its exposure
# symbol:   the object's symbol for it, once finished
# stem:     the stem an unnamed label was made with, its number following in the object, nil for the anonymous stem of
#           the set's established syntax
# number:   that number, by place among the labels of its stem, skipping those named labels spell, once finished
# thread:   whether a thread-local relocation names it, once finished
# renamed:  the version its symbol is renamed to, its index among the builder's versions plus one, 0 for none, once
#           finished
rec Mark {
    name:     opt[table.Id[intern.Name]];
    stem:     str;
    number:   u32;
    exposure: opt[Exposure];
    defined:  bool;
    section:  u32;
    fragment: u32;
    value:    opt[Value];
    size:     opt[u64];
    symbol:   opt[table.Id[mink_object.Symbol]];
    thread:   bool;
    renamed:  u32;
}

# what a relocation names
# ---
# label:   a label
# nothing: nothing, for a marker
tag Aim: u8 {
    label: u32;
    nothing;
}

# a place waiting for the next instruction of a section
# ---
# label:   the label the place becomes
# section: the section
# end:     whether the section's end is the place when no instruction follows
rec Waiting {
    label:   u32;
    section: u32;
    end:     bool;
}

# the length of everything a writer can only append to, so taking its output back is truncation
# ---
# areas:    the sections
# labels:   the labels
# values:   the operand values of every instruction
# members:  the members of every list value
# literals: the bytes of every literal value
# data:     the bytes of every data fragment
# waiting:  the places waiting for an instruction
# names:    the names interned
# sources:  the source files stated
# realigns: the alignments the linker realigns
# current:  the current section
# started:  where the starting section was opened, none while it is not
# view:     the context what is emitted next is written under
# syntax:   the syntax what is emitted next is written in
# modes:    the assembler modes
# states:   the mode states recorded
# state:    the index of the modes among them
# told:     the facts instructions stated
rec Snapshot {
    areas:    usize;
    labels:   usize;
    values:   usize;
    members:  usize;
    literals: usize;
    data:     usize;
    waiting:  usize;
    names:    usize;
    sources:  usize;
    realigns: usize;
    current:  opt[usize];
    started:  opt[u32];
    view:     *core_state.Context;
    syntax:   u32;
    modes:    mode.State;
    states:   usize;
    state:    u32;
    told:     usize;
}

# something that writes more of the object once the layout of the rest is settled, from the final places of what facts
# were attached to, as the line records are
# ---
# name:    what it writes
# context: its state, which the caller owns and keeps until the builder is released
# write:   what it writes into the builder, nil for nothing, only into sections and labels it opens itself: what existed
#          when the layout was settled has its addresses fixed, so a writer that adds to a section or restates a label of
#          those is refused
# record:  what it states on the object once the object is made from the final layout, nil for nothing, as records of
#          mink's model at the places `place_of` reads. the builder is closed while it runs, as a finished one is, so
#          nothing it does can change what the object was made from
#
# a finish is all or none: when a writer, the layout after them, the encode or a record fails, everything every writer
# added is taken back and the object with every record on it is released, so a writer is run again from a clean state
# and need not be idempotent
pub rec Writer {
    name:    str;
    context: ptr;
    write:   fun(ptr, *Builder) err[Refusal];
    record:  fun(ptr, *Builder, *mink_object.Object) err[Refusal];
}

# a symbol version a label's symbol is stated with, as `.symver name, alias@version` states one (gas manual,
# ".symver"), which the object holds as a symbol of the alias's name, as elf's relocatable objects name a version
# ---
# label: the label
# alias: the alias as stated: a name, then `@`, `@@` or `@@@`, then the version's name
# keep:  whether the label's own symbol is kept beside the alias, as it is but with `remove`
rec Versioned {
    label: Label;
    alias: table.Id[intern.Name];
    keep:  bool;
}

# a relocation stated by itself, as `.reloc offset, name, target` states one (gas manual, ".reloc"), which the object
# keeps as stated, its place encoded as the statements around it encode it: the builder folds it into no field and it
# changes no layout
# ---
# section: the section it patches
# at:      the label its place is at, none for the section's start
# offset:  its place past that
# kind:    what it computes
# target:  the label it names, none for nothing, as a marker names nothing
# addend:  its addend
# place:   its offset in its section, once finished
pub rec Direct {
    section: u32;
    at:      opt[Label];
    offset:  u64;
    kind:    *reloc.Kind;
    target:  opt[Label];
    addend:  i64;
    place:   u64;
}

# a relocation found by the last encode, before the object exists
rec Pending {
    section: u32;
    offset:  u64;
    kind:    *reloc.Kind;
    aim:     Aim;
    addend:  i64;
}

# an encoded instruction's record before the values of the encode stop moving, its form the one it was encoded in
rec Entry {
    section: u32;
    offset:  u64;
    length:  u64;
    of:      Coded;
    values:  usize;
    count:   u32;
    run:     u32;
    form:    core_form.Form;
}

# the builder of one object
# ---
# a:         the allocator everything lives in
# formats:   the format registry the object's format facts are read from, borrowed
# format:    the object's format
# naming:    how the format names sections, whose conventions the source's sections take
# abi:       the caller's abi row, the object's conventions, nil until `traits` names one and for an architecture with
#            none
# chosen:    whether `traits` named it
# encoded:   the axes the format encodes for the architecture, each with whether the object must state it
# set:       the instruction set
# object:    the object's context, the selection the caller states at the state the architecture starts it at, with its
#            view of the set's register file
# view:      the context what is emitted next is written under, `object` or another the source states
# views:     every context other than `object` the source put in force, once each, in the order first put
# syntax:    the index of the set's syntax what is emitted next is written in
# arch:      the architecture of the object
# kinds:     each fixup kind's relocation kind, indexed by the kind, nil when unbound
# relocs:    the object's format's relocation rows for the architecture, which every relocation's kind must map to, the
#            registry's refusal for a format with none
# data_kind: each datum's fixup kind, indexed by basis then width, operand.NO_FIXUP for none
# adds:      per difference width, the fixup kind adding the label added, operand.NO_FIXUP for none
# subs:      per difference width, the fixup kind subtracting the label subtracted, operand.NO_FIXUP for none
# areas:     the sections
# current:   the current section's index, none before one is switched to, STARTING while it is the starting section
#            and that is not yet opened
# start:     the starting section `begin` names, opened as `open` opens it when first written, none for no starting section
# started:   the index the starting section was opened at, none until it is
# labels:    the labels, label id less one
# names:     the names of sections and labels
# named:     per name, the label of that name, operand.NO_SYMBOL for none
# titled:    per name, the first section of that name, its index plus one, 0 for none
# values:    the operand values of every instruction
# members:   the members of every list value
# literals:  the bytes of every literal value
# data:      the bytes of every data fragment
# scratch:   room to encode into while measuring
# fixups:    room for the fixups of an encode
# pending:   the relocations of the last encode
# entries:   the instructions of the last encode
# listed:    the values of those instructions
# realigns:  the alignments the linker realigns in the last layout, in section order and then offset order
# raised:    the sections the format holds the traits in that the source wrote, raised into traits at finish
# sources:   the names of the source files the object states, in the order stated
# waiting:   the places waiting for the next instruction of a section
# writers:   what writes more of the object after the layout, in the order they were added
# taken:     while writers run, what existed when the layout was settled, which they may not change
# cts:       the ranges marked as built to run in constant time, the last open while `ct_end` is awaited
# frames:    the frames of the functions stated, the last open while `cfi_end` is awaited
# rules:     the rules of every frame, each at the statement it precedes
# kept:      the canonical frame addresses the open frame remembered, the last remembered last
# frame_to:  the tables the frames are written to, none for the format's default
# defined:   the label placed last, which `placed_here` answers while nothing is written after it
# mapping:   the mapping symbols written, the (format, architecture) pair's (`mink.format.pair.Mapping`), none where it
#            states none
# modes:     the assembler modes the next statement is read under, each at its initial value until changed
# states:    every value the modes have held, a new one recorded each time a mode changes, which fragments name by index
# state:     the index of `modes` among `states`
# passes:    how many passes the last layout took
# versions:  the symbol versions stated, in the order stated
# direct:    the relocations stated by themselves, in the order stated
# told:      the facts instructions state of the object, in the order stated
# finished:  whether the object was handed over
pub rec Builder {
    a:         *A.Allocator;
    formats:   *registry.Registry;
    format:    *mink_format.Format;
    naming:    *contract.Naming;
    abi:       *mink_arch.Abi;
    chosen:    bool;
    encoded:   table.Table[contract.Encoded];
    set:       *set.Set;
    object:    *core_state.Context;
    view:      *core_state.Context;
    views:     vector.Vector[*core_state.Context];
    syntax:    u32;
    arch:      *mink_arch.Arch;
    kinds:     vector.Vector[*reloc.Kind];
    relocs:    res[registry.Relocations, fail.Fail];
    data_kind: [18]operand.FixupKind;
    adds:      [9]operand.FixupKind;
    subs:      [9]operand.FixupKind;
    areas:     vector.Vector[Area];
    current:   opt[usize];
    start:     opt[Spec];
    started:   opt[u32];
    labels:    vector.Vector[Mark];
    names:     intern.Interner;
    named:     vector.Vector[u32];
    titled:    vector.Vector[u32];
    values:    vector.Vector[operand.Value];
    members:   vector.Vector[operand.Value];
    literals:  vector.Vector[u8];
    data:      vector.Vector[u8];
    scratch:   vector.Vector[u8];
    fixups:    vector.Vector[field.Fixup];
    pending:   vector.Vector[Pending];
    entries:   vector.Vector[Entry];
    listed:    vector.Vector[operand.Value];
    realigns:  vector.Vector[Realigned];
    said:      vector.Vector[Said];
    texts:     vector.Vector[u8];
    raised:    vector.Vector[Raised];
    sources:   vector.Vector[table.Id[intern.Name]];
    waiting:   vector.Vector[Waiting];
    writers:   vector.Vector[Writer];
    taken:     opt[Snapshot];
    cts:       vector.Vector[Ct];
    frames:    vector.Vector[Framed];
    rules:     vector.Vector[Ruled];
    kept:      vector.Vector[Cfa];
    frame_to:  opt[frame.Destinations];
    defined:   opt[Label];
    mapping:   opt[*mink_pair.Mapping];
    modes:     mode.State;
    states:    vector.Vector[mode.State];
    state:     u32;
    passes:    u32;
    versions:  vector.Vector[Versioned];
    direct:    vector.Vector[Direct];
    told:      vector.Vector[Told];
    finished:  bool;
}

# the first section handle of a section the format holds the traits in, as elf's `.note.gnu.property`, which is no
# section of the object: the source writes it as data and the builder raises its bytes into the object's traits
pub val RAISED_BASE: u32 = 0x8000_0000;

# the handle of the starting section `begin` names, which is no section of the object until something is written to it,
# a label is placed in it or a section of its name is opened, and then stands for that section
pub val STARTING: u32 = 0xFFFF_FFFF;

# a section the format holds the traits in, its name and the bytes the source wrote in it
rec Raised {
    name:  table.Id[intern.Name];
    bytes: vector.Vector[u8];
}

# a trait the source states, its text, for a text axis, in the builder's texts
# ---
# axis:    the axis
# setting: the value, a text's bytes in `text` and not here
# text:    the bytes of a text
# by_row:  whether an instruction the set reads as what it states stated it (`stating`)
rec Said {
    axis:    *mink_trait.Axis;
    setting: mink_trait.Setting;
    text:    Span;
    spelled: opt[Spelling];
    by_row:  bool;
}

# a fact an instruction states of the object (`stating`), its data's bytes in the builder's texts
# ---
# fact:  the fact's format and key
# value: its value
# data:  its data, none for a fact of a value alone
rec Told {
    fact:  stating.Fact;
    value: u64;
    data:  opt[Span];
}

# how the source spelled a trait it stated by the format's attribute tag, its bytes in the builder's texts
# ---
# named:   whether the tag is by name, `name` then its bytes and a nul
# name:    the tag's name
# number:  the tag's number, for a tag by number
# text:    whether the value is a text, `value` then its bytes
# value:   the value's text
# written: the value's number, for a number
rec Spelling {
    named:   bool;
    name:    Span;
    number:  u64;
    text:    bool;
    value:   Span;
    written: u64;
}

# a trait the source stated by the object format's attribute tag, as it spelled it
# ---
# tag:     the tag, by name or number
# written: the value, a text's bytes valid until the builder is next written or released
pub rec Spelled {
    tag:     contract.Tag;
    written: contract.Written;
}

# a range of statements of one section marked as built to run in constant time
# ---
# section: the section
# start:   the statement it starts at
# end:     the statement it ends before, while `open` is false
# open:    whether `ct_end` is awaited
rec Ct {
    section: u32;
    start:   u32;
    end:     u32;
    open:    bool;
}

# a frame's pointer at label `label`, the routine's or table's address, or with `indirect` a slot of the object that
# holds it, as gcc's `DW.ref.__gxx_personality_v0`
pub rec Pointed {
    label:    Label;
    indirect: bool;
}

# the frame of one function, stated by `cfi_start`, its rules and `cfi_end`
# ---
# function:    the label of the function
# section:     the section it lies in
# start:       the statement it starts at
# end:         the statement it ends before
# rules:       the first of its rules among the builder's
# count:       how many
# personality: its personality routine
# lsda:        its language specific data
# signal:      whether it is a signal handler's
# open:        whether `cfi_end` is awaited
# cfa:         the canonical frame address its rules leave at the cursor
# depth:       how many states its rules remember that none restores yet
rec Framed {
    function:    Label;
    section:     u32;
    start:       u32;
    end:         u32;
    rules:       usize;
    count:       usize;
    personality: opt[Pointed];
    lsda:        opt[Pointed];
    signal:      bool;
    open:        bool;
    cfa:         Cfa;
    depth:       u32;
}

# the canonical frame address an open frame's rules leave, as a register plus an offset that may scale, in dwarf numbers
# ---
# reg:      the register it is from
# fixed:    the bytes of the offset that do not scale
# scale:    the multiple of the value of `quantity` the offset adds, 0 when it does not scale
# quantity: the register whose value scales the offset, read only when `scale` is nonzero
pub rec Cfa {
    reg:      u16;
    fixed:    i64;
    scale:    i64;
    quantity: u16;
}

# a frame rule at the statement it takes effect before, an expression's bytes in the builder's texts
rec Ruled {
    at:         u32;
    rule:       frame.Rule;
    expression: Span;
}

fun refuse(message: str) Refusal {
    ret Refusal{message: message, label: operand.NO_SYMBOL};
}

fun refused(message: str) err[Refusal] {
    ret err[Refusal].err{refuse(message)};
}

fun about(message: str, label: u32) err[Refusal] {
    ret err[Refusal].err{Refusal{message: message, label: label}};
}

fun memory() Refusal {
    ret refuse(field.MEMORY);
}

fun encoding(r: field.Refusal) Refusal {
    ret Refusal{message: r.message, label: operand.NO_SYMBOL, encode: opt[field.Refusal].some{r}};
}

fun failed(f: fail.Fail) Refusal {
    ret Refusal{message: OBJECT, label: operand.NO_SYMBOL, object: opt[fail.Fail].some{f}};
}

fun held(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

fun about_axis(message: str, x: *mink_trait.Axis) err[Refusal] {
    ret err[Refusal].err{Refusal{message: message, label: operand.NO_SYMBOL, axis: opt[*mink_trait.Axis].some{x}}};
}

# whether the builder's abi row is one its object is built under: the architecture's own, none only where its family
# has no abi rows, and one whose convention the set states admits the object's context and every context the source
# put in force, as `.option arch, +d` in an ilp32e object is not, refused with the convention's cited reason and the
# context it does not admit when not
fun check_abi(b: *Builder) err[Refusal] {
    if (b.abi == nil) {
        if (b.arch.family.abi_count > 0) { ret refused(NO_ABI); }
        ret err[Refusal].ok{};
    }
    if (b.abi.arch != b.arch) { ret refused(OTHER_ABI); }
    val c: opt[*set.Convention] = set.unconventional(b.set, b.abi, b.object);
    if (sel c.some) { ret refused(c.some.refusal); }
    var i: usize = 0;
    for (i < b.views.len) {
        val v: *core_state.Context  = b.views.data[i];
        val w: opt[*set.Convention] = set.unconventional(b.set, b.abi, v);
        if (sel w.some) { ret err[Refusal].err{Refusal{message: w.some.refusal, label: operand.NO_SYMBOL, view: v}}; }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# whether `ctx` is of the set's catalog and axes
fun of_set(s: *set.Set, ctx: *core_state.Context) bool {
    ret ctx.selection.catalog == s.extensions && ctx.axes.at == s.states.at && ctx.axes.len == s.states.len;
}

# whether the object's context `object`, of the set `s`, enters the set's architecture `arch`, as every object the set
# writes for `arch` must, refused naming what it lacks
pub fun enters(s: *set.Set, arch: *mink_arch.Arch, object: *core_state.Context) err[Refusal] {
    val row: opt[*set.Arch] = set.arch_of(s, arch);
    if (sel row.none)       { ret err[Refusal].err{refuse(ARCH)}; }
    if (!of_set(s, object)) { ret err[Refusal].err{refuse(SELECTION)}; }
    ret check_entry(row.some, object);
}

# whether the object's context enters architecture row `row`, which the set registers for every architecture it serves
fun check_entry(row: *set.Arch, object: *core_state.Context) err[Refusal] {
    if (core_state.admits(object, row.enters)) { ret err[Refusal].ok{}; }
    var m: Mismatch = Mismatch{arch: row.arch.name, unmet: core_state.nothing_unmet()};
    core_state.unmet(object, row.enters, ?m.unmet);
    ret err[Refusal].err{Refusal{message: MODE, label: operand.NO_SYMBOL, mode: opt[Mismatch].some{m}}};
}

# a builder of an object for `arch` in format `format` over `s`, under the object's context `object`, which the caller
# makes with `set.open` and keeps, with its selection and view, until the builder is released. a format that encodes no
# traits for the architecture is refused naming it. the object's conventions are the abi row `traits` names
pub fun make(a: *A.Allocator, formats: *registry.Registry, s: *set.Set, object: *core_state.Context, arch: *mink_arch.Arch, format: *mink_format.Format) res[Builder, Refusal] {
    val entered: err[Refusal] = enters(s, arch, object);
    if (sel entered.err) { ret res[Builder, Refusal].err{entered.err}; }
    var encoded: table.Table[contract.Encoded] = table.make[contract.Encoded](a);
    val listed:  err[fail.Fail]                = trait.encodes(formats, format, arch, ?encoded);
    if (sel listed.err) {
        val released: err[fail.Fail] = table.release[contract.Encoded](?encoded);
        ret res[Builder, Refusal].err{Refusal{message: NO_TRAITS, label: operand.NO_SYMBOL, object: opt[fail.Fail].some{listed.err}}};
    }
    val naming: res[*contract.Naming, fail.Fail] = registry.naming(formats, format);
    if (sel naming.err) {
        val released: err[fail.Fail] = table.release[contract.Encoded](?encoded);
        ret res[Builder, Refusal].err{Refusal{message: NO_NAMING, label: operand.NO_SYMBOL, object: opt[fail.Fail].some{naming.err}}};
    }
    var b: Builder = Builder{
        a:        a,
        formats:  formats,
        format:   format,
        naming:   naming.ok,
        abi:      nil,
        chosen:   false,
        encoded:  encoded,
        set:      s,
        object:   object,
        view:     object,
        views:    vector.init[*core_state.Context](a),
        syntax:   0,
        arch:     arch,
        kinds:    vector.init[*reloc.Kind](a),
        relocs:   registry.relocations(formats, format, arch),
        areas:    vector.init[Area](a),
        current:  opt[usize].none{},
        start:    opt[Spec].none{},
        started:  opt[u32].none{},
        labels:   vector.init[Mark](a),
        names:    intern.make(a),
        named:    vector.init[u32](a),
        titled:   vector.init[u32](a),
        values:   vector.init[operand.Value](a),
        members:  vector.init[operand.Value](a),
        literals: vector.init[u8](a),
        data:     vector.init[u8](a),
        scratch:  vector.init[u8](a),
        fixups:   vector.init[field.Fixup](a),
        pending:  vector.init[Pending](a),
        entries:  vector.init[Entry](a),
        listed:   vector.init[operand.Value](a),
        realigns: vector.init[Realigned](a),
        said:     vector.init[Said](a),
        texts:    vector.init[u8](a),
        raised:   vector.init[Raised](a),
        sources:  vector.init[table.Id[intern.Name]](a),
        waiting:  vector.init[Waiting](a),
        writers:  vector.init[Writer](a),
        taken:    opt[Snapshot].none{},
        cts:      vector.init[Ct](a),
        frames:   vector.init[Framed](a),
        rules:    vector.init[Ruled](a),
        kept:     vector.init[Cfa](a),
        frame_to: opt[frame.Destinations].none{},
        defined:  opt[Label].none{},
        mapping:  mapping_of(formats, arch, format),
        modes:    mode.initial(?s.assembly),
        states:   vector.init[mode.State](a),
        state:    0,
        versions: vector.init[Versioned](a),
        direct:   vector.init[Direct](a),
        told:     vector.init[Told](a),
        finished: false,
    };
    # the bindings indexed by fixup kind, so a relocation's kind is one load
    var top: usize = 0;
    var i:   u32   = 0;
    for (i < s.bindings.len) {
        if (s.bindings.at[i].fixup::usize > top) { top = s.bindings.at[i].fixup::usize; }
        i = i + 1;
    }
    var ok: bool = held(vector.push[mode.State](?b.states, b.modes));
    ok = ok && (s.bindings.len == 0 || held(vector.reserve[*reloc.Kind](?b.kinds, top + 1)));
    if (ok && s.bindings.len > 0) {
        var k: usize = 0;
        for (k <= top) {
            b.kinds.data[k] = nil;
            k               = k + 1;
        }
        b.kinds.len = top + 1;
        i           = 0;
        # a kind bound on other architectures alone stays unbound here, refused where an instruction takes it
        for (i < s.bindings.len) {
            if (core_fixup.binds(?s.bindings.at[i], arch)) { b.kinds.data[s.bindings.at[i].fixup::usize] = s.bindings.at[i].kind; }
            i = i + 1;
        }
    }
    i = 0;
    for (i < s.data.len) {
        val d: *core_fixup.Datum = ?s.data.at[i];
        if (d.basis <= core_fixup.RELATIVE && d.width <= core_fixup.MAX_WIDTH) { b.data_kind[datum_slot(d.basis, d.width)] = d.fixup; }
        i = i + 1;
    }
    i = 0;
    for (i < s.pairs.len) {
        val q: *core_fixup.Pair = ?s.pairs.at[i];
        if (q.width <= core_fixup.MAX_WIDTH) {
            b.adds[q.width::usize] = q.add;
            b.subs[q.width::usize] = q.sub;
        }
        i = i + 1;
    }
    # a typed stream's state is the object's, begun with it, which every view of the object reads
    if (ok && s.codec.stream != nil) {
        if (object.stream != nil) {
            release(?b);
            ret res[Builder, Refusal].err{refuse(STREAMED)};
        }
        val made: res[ptr, A.Error] = s.codec.stream.make(a);
        ok = sel made.ok;
        if (sel made.ok) {
            s.codec.stream.begin(made.ok);
            object.stream = made.ok;
        }
    }
    if (!ok) {
        release(?b);
        ret res[Builder, Refusal].err{memory()};
    }
    ret res[Builder, Refusal].ok{b};
}

# the mapping symbols an object of `arch` in `format` holds, as mink's pair of them states them. a format that states
# nothing for the architecture marks nothing
pub fun mapping_of(formats: *registry.Registry, arch: *mink_arch.Arch, format: *mink_format.Format) opt[*mink_pair.Mapping] {
    val r: res[*registration.Registration, fail.Fail] = registry.by_format(formats, format);
    if (sel r.err) { ret opt[*mink_pair.Mapping].none{}; }
    val p: res[*mink_pair.Pair, fail.Fail] = registration.pair_of(r.ok, arch);
    if (sel p.err) { ret opt[*mink_pair.Mapping].none{}; }
    ret p.ok.mapping;
}

# how the object's format names sections
pub fun naming(b: *Builder) *contract.Naming {
    ret b.naming;
}

# the assembler modes the next statement is read under, which the reader of each statement reads them through
pub fun modes_of(b: *Builder) *mode.State {
    ret ?b.modes;
}

# the mode of `to` at its value for the statements after, as the caller's flags start the source and a directive changes
# it between statements
pub fun set_mode(b: *Builder, to: mode.Setting) err[Refusal] {
    var next: mode.State = b.modes;
    if (!mode.change(?next, to))                         { ret refused(OTHER_MODE); }
    if (mode.same(?next, ?b.modes))                      { ret err[Refusal].ok{}; }
    if (!held(vector.push[mode.State](?b.states, next))) { ret err[Refusal].err{memory()}; }
    b.modes = next;
    b.state = (b.states.len - 1)::u32;
    ret err[Refusal].ok{};
}

# the assembler modes fragment `f` was written under, which every computation over it reads, as a marker that holds only
# under some modes
fun modes_at(b: *Builder, f: *Fragment) *mode.State {
    ret ?b.states.data[f.modes::usize];
}

# the slot of a datum's basis and width among the builder's data kinds
fun datum_slot(basis: core_fixup.Basis, width: u8) usize {
    ret basis::usize * (core_fixup.MAX_WIDTH::usize + 1) + width::usize;
}

# give back everything the builder owns. a finished object is the caller's and is not touched
pub fun release(b: *Builder) {
    var i: usize = 0;
    for (i < b.areas.len) {
        val area: *Area = ?b.areas.data[i];
        vector.dnit[Fragment](?area.fragments);
        vector.dnit[u32](?area.marks);
        vector.dnit[u8](?area.bytes);
        i = i + 1;
    }
    vector.dnit[*reloc.Kind](?b.kinds);
    vector.dnit[Area](?b.areas);
    vector.dnit[Mark](?b.labels);
    intern.release(?b.names);
    vector.dnit[u32](?b.named);
    vector.dnit[u32](?b.titled);
    vector.dnit[operand.Value](?b.values);
    vector.dnit[operand.Value](?b.members);
    vector.dnit[u8](?b.literals);
    vector.dnit[u8](?b.data);
    vector.dnit[u8](?b.scratch);
    vector.dnit[field.Fixup](?b.fixups);
    vector.dnit[Pending](?b.pending);
    vector.dnit[Entry](?b.entries);
    vector.dnit[operand.Value](?b.listed);
    vector.dnit[Realigned](?b.realigns);
    val released: err[fail.Fail] = table.release[contract.Encoded](?b.encoded);
    vector.dnit[Said](?b.said);
    vector.dnit[*core_state.Context](?b.views);
    vector.dnit[u8](?b.texts);
    var r: usize = 0;
    for (r < b.raised.len) {
        vector.dnit[u8](?b.raised.data[r].bytes);
        r = r + 1;
    }
    vector.dnit[Raised](?b.raised);
    vector.dnit[table.Id[intern.Name]](?b.sources);
    vector.dnit[Waiting](?b.waiting);
    vector.dnit[Writer](?b.writers);
    vector.dnit[Ct](?b.cts);
    vector.dnit[Framed](?b.frames);
    vector.dnit[Ruled](?b.rules);
    vector.dnit[Cfa](?b.kept);
    vector.dnit[mode.State](?b.states);
    vector.dnit[Versioned](?b.versions);
    vector.dnit[Direct](?b.direct);
    vector.dnit[Told](?b.told);
    if (b.set.codec.stream != nil && b.object.stream != nil) {
        b.set.codec.stream.release(b.a, b.object.stream);
        b.object.stream = nil;
    }
}

# the id of `s`'s bytes among the builder's names, a new name interned, and every name given its label and section slots
fun name_of(b: *Builder, s: str) res[table.Id[intern.Name], Refusal] {
    ret name_bytes(b, s::*u8, str_len(s));
}

# the id of the `n` bytes at `p` among the builder's names, as `name_of` makes it
fun name_bytes(b: *Builder, p: *u8, n: usize) res[table.Id[intern.Name], Refusal] {
    if (!held(vector.reserve[u32](?b.named, 1)) || !held(vector.reserve[u32](?b.titled, 1))) { ret res[table.Id[intern.Name], Refusal].err{memory()}; }
    val id: res[table.Id[intern.Name], fail.Fail] = intern.intern(?b.names, p, n);
    if (sel id.err) { ret res[table.Id[intern.Name], Refusal].err{failed(id.err)}; }
    if (b.named.len <= id.ok.index::usize) {
        b.named.data[b.named.len]   = operand.NO_SYMBOL;
        b.named.len                 = b.named.len + 1;
        b.titled.data[b.titled.len] = 0;
        b.titled.len                = b.titled.len + 1;
    }
    ret res[table.Id[intern.Name], Refusal].ok{id.ok};
}

# the section the format holds the traits in named `name`, its handle, opened once
fun open_raised(b: *Builder, name: str) res[Section, Refusal] {
    val named: res[table.Id[intern.Name], Refusal] = name_of(b, name);
    if (sel named.err) { ret res[Section, Refusal].err{named.err}; }
    var k: usize = 0;
    for (k < b.raised.len) {
        if (b.raised.data[k].name.index == named.ok.index) { ret res[Section, Refusal].ok{Section{index: RAISED_BASE + k::u32}}; }
        k = k + 1;
    }
    if (!held(vector.push[Raised](?b.raised, Raised{name: named.ok, bytes: vector.init[u8](b.a)}))) { ret res[Section, Refusal].err{memory()}; }
    ret res[Section, Refusal].ok{Section{index: RAISED_BASE + k::u32}};
}

# the section the format holds the traits in that the current section is, none for another
fun raising(b: *Builder) opt[*Raised] {
    if (b.finished)         { ret opt[*Raised].none{}; }
    if (sel b.current.none) { ret opt[*Raised].none{}; }
    val at: usize = b.current.some;
    if (at < RAISED_BASE::usize || at == STARTING::usize) { ret opt[*Raised].none{}; }
    ret opt[*Raised].some{?b.raised.data[at - RAISED_BASE::usize]};
}

# a new section, which is current once switched to. a nameless one, or one opened apart, is a section of its own each
# time. a section the format holds the traits in, as elf's `.note.gnu.property`, is no section of the object: its data
# is raised into the object's traits at finish (`raise_all`), so it takes data alone and is one section however often
# it is opened, and one opened apart is refused
pub fun open(b: *Builder, spec: Spec) res[Section, Refusal] {
    if (b.finished)                               { ret res[Section, Refusal].err{refuse(FINISHED)}; }
    if (!held(vector.reserve[Area](?b.areas, 1))) { ret res[Section, Refusal].err{memory()}; }
    var name: opt[table.Id[intern.Name]] = opt[table.Id[intern.Name]].none{};
    if (sel spec.name.some) {
        val holds: res[bool, fail.Fail] = trait.holds_traits(b.formats, b.format, b.arch, spec.name.some);
        if (sel holds.err) { ret res[Section, Refusal].err{failed(holds.err)}; }
        if (holds.ok) {
            if (spec.apart) { ret res[Section, Refusal].err{refuse(TRAIT_SECTION)}; }
            ret open_raised(b, spec.name.some);
        }
        val named: res[table.Id[intern.Name], Refusal] = name_of(b, spec.name.some);
        if (sel named.err) { ret res[Section, Refusal].err{named.err}; }
        name = opt[table.Id[intern.Name]].some{named.ok};
    }
    val index: u32  = b.areas.len::u32;
    var area:  Area = Area{
        name:        name,
        kind:        spec.kind,
        flags:       spec.flags,
        disposition: spec.disposition,
        entsize:     spec.entsize,
        align:       1,
        bits:        mink_section.has(spec.kind, mink_section.BITS),
        code:        (spec.flags & mink_section.EXEC) != 0,
        fragments:   vector.init[Fragment](b.a),
        marks:       vector.init[u32](b.a),
        bytes:       vector.init[u8](b.a),
    };
    vector.push[Area](?b.areas, area);
    if (sel name.some) {
        if (!spec.apart && b.titled.data[name.some.index::usize] == 0) { b.titled.data[name.some.index::usize] = index + 1; }
    }
    # a section of the starting section's name is the starting section, which then stands for it
    if (sel b.started.none && !spec.apart && pending_name(b, spec.name)) { b.started = opt[u32].some{index}; }
    ret res[Section, Refusal].ok{Section{index: index}};
}

# section `s` put in the comdat group of signature `signature`, the group of each section of that signature, which keeps
# any one copy of it across the objects linked (mink's `group.ANY`). the object names the group by the signature's
# name, which a symbol of that name stands for, or which the format writes as a symbol of its own when the object holds
# none, as assemblers sign a group no label exposes. a section joins one group at most
pub fun join(b: *Builder, s: Section, signature: View) err[Refusal] {
    if (b.finished)                    { ret refused(FINISHED); }
    if (s.index::usize >= b.areas.len) { ret refused(NO_SUCH); }
    val area: *Area = ?b.areas.data[s.index::usize];
    if (sel area.group.some) { ret refused(REGROUPED); }
    if (signature.len == 0)  { ret refused(SIGNATURE); }
    val named: res[table.Id[intern.Name], Refusal] = name_bytes(b, signature.data, signature.len);
    if (sel named.err) { ret err[Refusal].err{named.err}; }
    val into: *Area = ?b.areas.data[s.index::usize];
    into.group = opt[table.Id[intern.Name]].some{named.ok};
    ret err[Refusal].ok{};
}

# section `s` ordered after section `owner` when linked, as an elf link-order section is ordered after the section it
# names (mink's `Section.owner`). a section takes one order at most, and a section the format holds the traits in is
# neither ordered nor an owner, since the object holds no section for it
pub fun order(b: *Builder, s: Section, owner: Section) err[Refusal] {
    if (b.finished)                                                         { ret refused(FINISHED); }
    if (s.index::usize >= b.areas.len || owner.index::usize >= b.areas.len) { ret refused(ORDER); }
    if (s.index == owner.index)                                             { ret refused(ORDER); }
    val area: *Area = ?b.areas.data[s.index::usize];
    if (sel area.owner.some) { ret refused(REORDERED); }
    val into: *Area = ?b.areas.data[s.index::usize];
    into.owner = opt[u32].some{owner.index};
    ret err[Refusal].ok{};
}

# the section the label named `name` is placed in, none for a name no label placed so far has
pub fun placed_in(b: *Builder, name: View) opt[Section] {
    val known: opt[table.Id[intern.Name]] = intern.find(?b.names, name.data::*u8, name.len);
    if (sel known.none) { ret opt[Section].none{}; }
    val m: opt[*Mark] = mark_of(b, Label{id: b.named.data[known.some.index::usize]});
    if (sel m.none)      { ret opt[Section].none{}; }
    if (!m.some.defined) { ret opt[Section].none{}; }
    ret opt[Section].some{Section{index: m.some.section}};
}

# the section `s` is ordered after, none for a section of no link order
pub fun owner_of(b: *Builder, s: Section) opt[Section] {
    if (s.index::usize >= b.areas.len) { ret opt[Section].none{}; }
    val o: opt[u32] = b.areas.data[s.index::usize].owner;
    if (sel o.none) { ret opt[Section].none{}; }
    ret opt[Section].some{Section{index: o.some}};
}

# the signature of the comdat group section `s` is in, none for a section in none
pub fun group_of(b: *Builder, s: Section) opt[View] {
    if (s.index::usize >= b.areas.len) { ret opt[View].none{}; }
    val g: opt[table.Id[intern.Name]] = b.areas.data[s.index::usize].group;
    if (sel g.none) { ret opt[View].none{}; }
    ret opt[View].some{intern.bytes_of(?b.names, g.some)};
}

# the first section opened with the name `name` and not apart, none when no section is. a nameless section has none
pub fun section_named(b: *Builder, name: View) opt[Section] {
    val known: opt[table.Id[intern.Name]] = intern.find(?b.names, name.data::*u8, name.len);
    if (sel known.none) { ret opt[Section].none{}; }
    var k: usize = 0;
    for (k < b.raised.len) {
        if (b.raised.data[k].name.index == known.some.index) { ret opt[Section].some{Section{index: RAISED_BASE + k::u32}}; }
        k = k + 1;
    }
    val slot: u32 = b.titled.data[known.some.index::usize];
    if (slot == 0) { ret opt[Section].none{}; }
    ret opt[Section].some{Section{index: slot - 1}};
}

# whether section `s` was opened as `spec` states, its name aside
pub fun matches(b: *Builder, s: Section, spec: *Spec) bool {
    # a section raised into traits keeps no attributes of its own
    if (s.index >= RAISED_BASE)        { ret s.index - RAISED_BASE < b.raised.len::u32; }
    if (s.index::usize >= b.areas.len) { ret false; }
    val area: *Area = ?b.areas.data[s.index::usize];
    ret area.kind == spec.kind && area.flags == spec.flags && area.disposition == spec.disposition && area.entsize == spec.entsize;
}

# the current section, none before one is switched to, STARTING while it is the starting section not yet opened
pub fun current(b: *Builder) opt[Section] {
    if (sel b.current.none) { ret opt[Section].none{}; }
    ret opt[Section].some{Section{index: b.current.some::u32}};
}

# the section emission goes to until another is switched to, the one an assembly starts in, as the gnu assembler starts
# in `.text`. it is opened as `open` opens `spec` only when something is written to it or a label is placed in it, or
# when a section of its name is opened, so a source that writes nothing before its first `.section` holds no empty one.
# until then its handle is STARTING, which `switch` takes
pub fun begin(b: *Builder, spec: Spec) err[Refusal] {
    if (b.finished)                     { ret refused(FINISHED); }
    if (sel b.start.some || spec.apart) { ret refused(STARTED); }
    b.start   = opt[Spec].some{spec};
    b.current = opt[usize].some{STARTING::usize};
    ret err[Refusal].ok{};
}

# make `s` the current section, its cursor where it was left. STARTING is the starting section, opened or not
pub fun switch(b: *Builder, s: Section) err[Refusal] {
    if (s.index == STARTING) {
        if (sel b.start.none)   { ret refused(NO_SUCH); }
        if (sel b.started.some) { b.current = opt[usize].some{b.started.some::usize}; }
        or                      { b.current = opt[usize].some{STARTING::usize}; }
        ret err[Refusal].ok{};
    }
    if (s.index >= RAISED_BASE) {
        if (s.index - RAISED_BASE >= b.raised.len::u32) { ret refused(NO_SUCH); }
    }
    or (s.index::usize >= b.areas.len) { ret refused(NO_SUCH); }
    b.current = opt[usize].some{s.index::usize};
    ret err[Refusal].ok{};
}

# whether `name` is the starting section's
fun pending_name(b: *Builder, name: opt[str]) bool {
    if (sel b.start.none) { ret false; }
    val start: Spec = b.start.some;
    if (sel start.name.none) { ret false; }
    if (sel name.none)       { ret false; }
    ret str_equals(start.name.some, name.some);
}

# the starting section opened, or found where a section of its name took its place, and made current
fun open_start(b: *Builder) res[usize, Refusal] {
    var at: u32 = 0;
    if (sel b.started.some) { at = b.started.some; }
    or {
        if (sel b.start.none) { ret res[usize, Refusal].err{refuse(NO_SECTION)}; }
        val opened: res[Section, Refusal] = open(b, b.start.some);
        if (sel opened.err) { ret res[usize, Refusal].err{opened.err}; }
        at = opened.ok.index;
    }
    b.started = opt[u32].some{at};
    b.current = opt[usize].some{at::usize};
    ret res[usize, Refusal].ok{at::usize};
}

# the current section's index, refused before one is switched to. the starting section is opened here, as this is what
# writing to it or placing a label in it asks first
fun at_cursor(b: *Builder) res[usize, Refusal] {
    if (b.finished)         { ret res[usize, Refusal].err{refuse(FINISHED)}; }
    if (sel b.current.none) { ret res[usize, Refusal].err{refuse(NO_SECTION)}; }
    if (b.current.some == STARTING::usize) {
        val opened: res[usize, Refusal] = open_start(b);
        if (sel opened.err) { ret opened; }
    }
    if (b.current.some >= RAISED_BASE::usize)                    { ret res[usize, Refusal].err{refuse(RAISED)}; }
    if (sel b.taken.some && b.current.some < b.taken.some.areas) { ret res[usize, Refusal].err{refuse(SEALED)}; }
    ret res[usize, Refusal].ok{b.current.some};
}

# the current section, refused before one is switched to
fun here(b: *Builder) res[*Area, Refusal] {
    val at: res[usize, Refusal] = at_cursor(b);
    if (sel at.err) { ret res[*Area, Refusal].err{at.err}; }
    ret res[*Area, Refusal].ok{?b.areas.data[at.ok]};
}

# how many labels the builder has made, named or not
pub fun label_count(b: *Builder) usize {
    ret b.labels.len;
}

# whether a label is named exactly `name`, by the interner's lookup
pub fun spells(b: *Builder, name: View) bool {
    val known: opt[table.Id[intern.Name]] = intern.find(?b.names, name.data::*u8, name.len);
    if (sel known.none) { ret false; }
    ret b.named.data[known.some.index::usize] != operand.NO_SYMBOL;
}

# a new label with no name, local until exposed, spelled in the object, when it is a symbol, by the anonymous stem of
# the set's established syntax and a number, as llvm-mc spells `.Ltmp0`, numbered as `stemmed` numbers
pub fun anonymous(b: *Builder) res[Label, Refusal] {
    if (b.finished)                                  { ret res[Label, Refusal].err{refuse(FINISHED)}; }
    if (!held(vector.push[Mark](?b.labels, Mark{}))) { ret res[Label, Refusal].err{memory()}; }
    ret res[Label, Refusal].ok{Label{id: b.labels.len::u32}};
}

# a new label with no name of its own, spelled in the object as `stem` and a number, as llvm-mc spells risc-v's
# `.Lpcrel_hi0`: the next number for the stem that no named label spells, in the order such labels are placed
pub fun stemmed(b: *Builder, stem: str) res[Label, Refusal] {
    if (b.finished)                                            { ret res[Label, Refusal].err{refuse(FINISHED)}; }
    if (stem == nil || stem[0] == 0)                           { ret res[Label, Refusal].err{refuse(NO_STEM)}; }
    if (str_len(stem) > syntax.MAX_ANONYMOUS)                  { ret res[Label, Refusal].err{refuse(NO_STEM)}; }
    if (!held(vector.push[Mark](?b.labels, Mark{stem: stem}))) { ret res[Label, Refusal].err{memory()}; }
    ret res[Label, Refusal].ok{Label{id: b.labels.len::u32}};
}

# `stem` and `n` in decimal written into `out`, how many bytes
fun stem_spelling(stem: str, n: u32, out: *u8) usize {
    var len: usize = 0;
    for (stem[len] != 0) {
        out[len] = stem[len];
        len      = len + 1;
    }
    var digits: [10]u8;
    var count:  usize = 0;
    var m:      u32   = n;
    for {
        digits[count] = '0' + (m % 10)::u8;
        count         = count + 1;
        m             = m / 10;
        if (m == 0) { brk; }
    }
    for (count > 0) {
        count    = count - 1;
        out[len] = digits[count];
        len      = len + 1;
    }
    ret len;
}

# the stem label `m` is spelled by in the object when it has no name of its own: the one it was made with, else the
# anonymous stem of the set's established syntax, nil for a named label
fun stem_for(b: *Builder, m: *Mark) str {
    if (sel m.name.some) { ret nil; }
    if (m.stem != nil)   { ret m.stem; }
    ret b.set.syntaxes.at[0].anonymous;
}

# a label's place in the order labels are numbered by
# ---
# section:  its section, NO_PLACE for one never placed
# fragment: the fragment it precedes
# id:       the label
rec Order {
    section:  u32;
    fragment: u32;
    id:       u32;
}

val NO_PLACE: u32 = 0xFFFF_FFFF;

fun by_order(x: *Order, y: *Order) i64 {
    if (x.section != y.section) {
        if (x.section < y.section) { ret -1; }
        ret 1;
    }
    if (x.fragment != y.fragment) {
        if (x.fragment < y.fragment) { ret -1; }
        ret 1;
    }
    if (x.id < y.id) { ret -1; }
    if (x.id > y.id) { ret 1; }
    ret 0;
}

# the next number a stem gives
rec Counter {
    stem: str;
    next: u32;
}

# every label with no name of its own numbered after its stem: each the next number of its stem that no named label
# spells, in place order, by section, then statement, then the order made, and then the labels never placed in the
# order made. a text that lists the labels in place order, naming some and leaving others to the assembler, so reads
# back to the same numbers
fun number_stems(b: *Builder) err[Refusal] {
    var order: vector.Vector[Order]   = vector.init[Order](b.a);
    var stems: vector.Vector[Counter] = vector.init[Counter](b.a);
    if (!held(vector.reserve[Order](?order, b.labels.len))) { ret err[Refusal].err{memory()}; }
    var i: usize = 0;
    for (i < b.labels.len) {
        val m: *Mark = ?b.labels.data[i];
        if (stem_for(b, m) != nil) {
            var at: Order = Order{section: NO_PLACE, fragment: 0, id: (i + 1)::u32};
            if (m.defined) {
                at.section  = m.section;
                at.fragment = m.fragment;
            }
            vector.push[Order](?order, at);
        }
        i = i + 1;
    }
    sort.sort_by[Order](order.data, order.len, by_order);
    var room: [syntax.MAX_ANONYMOUS + 10]u8;
    var ok:   bool = true;
    i = 0;
    for (i < order.len && ok) {
        val m:    *Mark = ?b.labels.data[order.data[i].id::usize - 1];
        val stem: str   = stem_for(b, m);
        var k:    usize = 0;
        for (k < stems.len && !str_equals(stems.data[k].stem, stem)) { k = k + 1; }
        if (k == stems.len) { ok = held(vector.push[Counter](?stems, Counter{stem: stem, next: 0})); }
        if (ok) {
            var next: u32 = stems.data[k].next;
            for (spells(b, View{data: ?room[0], len: stem_spelling(stem, next, ?room[0])})) { next = next + 1; }
            m.number           = next;
            stems.data[k].next = next + 1;
        }
        i = i + 1;
    }
    vector.dnit[Order](?order);
    vector.dnit[Counter](?stems);
    if (!ok) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# a new label placed at the cursor of the current section, which is how a fact is attached to a place: the label is
# the place, and once the layout is settled `place_of` states where it finally lies, after relaxation and compression
pub fun position(b: *Builder) res[Label, Refusal] {
    val made: res[Label, Refusal] = anonymous(b);
    if (sel made.err) { ret made; }
    val placed: err[Refusal] = define(b, made.ok);
    if (sel placed.err) { ret res[Label, Refusal].err{placed.err}; }
    ret made;
}

# a new label for the start of the next instruction emitted into the current section, which is where a fact about that
# instruction belongs: alignment or data between are not part of it. with `end` set, a section that gets no instruction
# after it places the label at its end, and without it the layout refuses
pub fun next_position(b: *Builder, end: bool) res[Label, Refusal] {
    val at: res[usize, Refusal] = at_cursor(b);
    if (sel at.err)                                    { ret res[Label, Refusal].err{at.err}; }
    if (!held(vector.reserve[Waiting](?b.waiting, 1))) { ret res[Label, Refusal].err{memory()}; }
    val made: res[Label, Refusal] = anonymous(b);
    if (sel made.err) { ret made; }
    vector.push[Waiting](?b.waiting, Waiting{label: made.ok.id, section: at.ok::u32, end: end});
    ret made;
}

# the places waiting in section `s` placed at fragment `at`
fun bind_waiting(b: *Builder, s: u32, at: u32) {
    var kept: usize = 0;
    var i:    usize = 0;
    for (i < b.waiting.len) {
        val w: Waiting = b.waiting.data[i];
        if (w.section == s) {
            val m: *Mark = ?b.labels.data[w.label::usize - 1];
            m.defined  = true;
            m.section  = s;
            m.fragment = at;
        }
        or {
            b.waiting.data[kept] = w;
            kept                 = kept + 1;
        }
        i = i + 1;
    }
    b.waiting.len = kept;
}

# the places still waiting settled: those allowed to end the section are placed at its end, and one that is not is refused.
# they keep waiting, so a layout that is not the last is undone by emitting more, which binds them to what follows
fun settle_waiting(b: *Builder) err[Refusal] {
    var i: usize = 0;
    for (i < b.waiting.len) {
        if (!b.waiting.data[i].end) { ret about(NO_INSTRUCTION, b.waiting.data[i].label); }
        i = i + 1;
    }
    i = 0;
    for (i < b.waiting.len) {
        val w: Waiting = b.waiting.data[i];
        val m: *Mark   = ?b.labels.data[w.label::usize - 1];
        m.defined  = true;
        m.section  = w.section;
        m.fragment = b.areas.data[w.section::usize].fragments.len::u32;
        i          = i + 1;
    }
    ret err[Refusal].ok{};
}

# `w` added to what writes after the layout is settled, run once by `finish`
pub fun writer(b: *Builder, w: Writer) err[Refusal] {
    if (b.finished)                                { ret refused(FINISHED); }
    if (!held(vector.push[Writer](?b.writers, w))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# a source file the object names, stated as a local symbol of the source kind, as an ELF `STT_FILE` symbol. it is no
# label, so its name is not one that a label can be found by
pub fun source(b: *Builder, name: View) err[Refusal] {
    if (b.finished)                                                  { ret refused(FINISHED); }
    if (name.len == 0)                                               { ret refused(NAMELESS); }
    if (!held(vector.reserve[table.Id[intern.Name]](?b.sources, 1))) { ret err[Refusal].err{memory()}; }
    val id: res[table.Id[intern.Name], Refusal] = name_bytes(b, name.data::*u8, name.len);
    if (sel id.err) { ret err[Refusal].err{id.err}; }
    vector.push[table.Id[intern.Name]](?b.sources, id.ok);
    ret err[Refusal].ok{};
}

# the label named `name`, made local when it is new
pub fun label(b: *Builder, name: str) res[Label, Refusal] {
    if (b.finished) { ret res[Label, Refusal].err{refuse(FINISHED)}; }
    val known: opt[table.Id[intern.Name]] = intern.find(?b.names, name::*u8, str_len(name));
    if (sel known.some) {
        val slot: u32 = b.named.data[known.some.index::usize];
        if (slot != operand.NO_SYMBOL) { ret res[Label, Refusal].ok{Label{id: slot}}; }
    }
    if (!held(vector.reserve[Mark](?b.labels, 1))) { ret res[Label, Refusal].err{memory()}; }
    val id: res[table.Id[intern.Name], Refusal] = name_of(b, name);
    if (sel id.err) { ret res[Label, Refusal].err{id.err}; }
    vector.push[Mark](?b.labels, Mark{name: opt[table.Id[intern.Name]].some{id.ok}});
    b.named.data[id.ok.index::usize] = b.labels.len::u32;
    ret res[Label, Refusal].ok{Label{id: b.labels.len::u32}};
}

# whether `l` existed when the layout was settled, so a writer running now may not restate it
fun sealed_label(b: *Builder, l: Label) bool {
    ret sel b.taken.some && l.id::usize <= b.taken.some.labels;
}

fun mark_of(b: *Builder, l: Label) opt[*Mark] {
    if (l.id == operand.NO_SYMBOL || l.id::usize > b.labels.len) { ret opt[*Mark].none{}; }
    ret opt[*Mark].some{?b.labels.data[l.id::usize - 1]};
}

# make `l` a symbol of the object, or restate how it is one
pub fun expose(b: *Builder, l: Label, e: Exposure) err[Refusal] {
    if (b.finished) { ret refused(FINISHED); }
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none)         { ret refused(NO_SUCH); }
    if (sealed_label(b, l)) { ret refused(SEALED); }
    m.some.exposure = opt[Exposure].some{e};
    ret err[Refusal].ok{};
}

# place `l` at the cursor of the current section
pub fun define(b: *Builder, l: Label) err[Refusal] {
    val at: res[usize, Refusal] = at_cursor(b);
    if (sel at.err) { ret err[Refusal].err{at.err}; }
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none)                              { ret refused(NO_SUCH); }
    if (sealed_label(b, l))                      { ret refused(SEALED); }
    if (m.some.defined || sel m.some.value.some) { ret about(REDEFINED, l.id); }
    m.some.defined  = true;
    m.some.section  = at.ok::u32;
    m.some.fragment = b.areas.data[at.ok].fragments.len::u32;
    b.defined       = opt[Label].some{l};
    ret err[Refusal].ok{};
}

# the label placed last when it is at the cursor of the current section, nothing written after it, as a function's
# label is where `.cfi_startproc` begins its frame. none when no label is there
pub fun placed_here(b: *Builder) opt[Label] {
    if (sel b.defined.none) { ret opt[Label].none{}; }
    val at: res[usize, Refusal] = at_cursor(b);
    if (sel at.err) { ret opt[Label].none{}; }
    val m: *Mark = ?b.labels.data[b.defined.some.id::usize - 1];
    if (m.section != at.ok::u32 || m.fragment != b.areas.data[at.ok].fragments.len::u32) { ret opt[Label].none{}; }
    ret b.defined;
}

# whether `l` is placed or given a value
pub fun bound(b: *Builder, l: Label) bool {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none) { ret false; }
    ret m.some.defined || sel m.some.value.some;
}

# a symbolic value naming `l` plus `addend`, of the operand's own fixup kind
pub fun target(l: Label, addend: i64) operand.Value {
    ret operand.Value.symbol{operand.Symbol{id: l.id, addend: addend, fixup: operand.NO_FIXUP}};
}

# `l` given the value `v` in place of a place, refused for a label placed or given one already
fun valued(b: *Builder, l: Label, v: Value) err[Refusal] {
    if (b.finished) { ret refused(FINISHED); }
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none)                              { ret refused(NO_SUCH); }
    if (sealed_label(b, l))                      { ret refused(SEALED); }
    if (m.some.defined || sel m.some.value.some) { ret about(REDEFINED, l.id); }
    m.some.value = opt[Value].some{v};
    ret err[Refusal].ok{};
}

# `l` made the number `value`, as `.set` makes a symbol of a constant
pub fun absolute(b: *Builder, l: Label, value: u64) err[Refusal] {
    ret valued(b, l, Value.absolute{value});
}

# `l` made common storage of `size` bytes at a boundary of `align`, a power of two, which the linker allocates. the
# label must be exposed with a binding other objects see by the time the builder finishes
pub fun common(b: *Builder, l: Label, size: u64, align: u64) err[Refusal] {
    if (align == 0 || (align & (align - 1)) != 0) { ret refused(BOUNDARY); }
    ret valued(b, l, Value.common{mink_object.Common{size: size, align: align}});
}

# `l` made to stand for `target` plus `addend`, wherever `target` comes to be
pub fun equate(b: *Builder, l: Label, target: Label, addend: i64) err[Refusal] {
    if (!names_label(b, target.id)) { ret refused(NOT_A_LABEL); }
    if (target.id == l.id)          { ret about(CYCLE, l.id); }
    ret valued(b, l, Value.equate{Equate{target: target.id, addend: addend}});
}

# label `l`'s symbol stated with the version `alias` names: an alias of that name beside the label's own symbol
# when `keep` and the label is defined, else the label's symbol renamed to it, as llvm-mc 23.1.1 writes them
# (ELFObjectWriter.cpp, executePostLayoutBinding). an alias of `@@@` names the default version `@@` of a defined label
# and a version `@` of an undefined one. a label no symbol stands for, as one never referred to, states none
pub fun version(b: *Builder, l: Label, alias: View, keep: bool) err[Refusal] {
    if (b.finished)               { ret refused(FINISHED); }
    if (!names_label(b, l.id))    { ret refused(NOT_A_LABEL); }
    if (versioned_at(alias) == 0) { ret about(UNVERSIONED, l.id); }
    val named: res[table.Id[intern.Name], Refusal] = name_bytes(b, alias.data, alias.len);
    if (sel named.err)                                                                                { ret err[Refusal].err{named.err}; }
    if (!held(vector.push[Versioned](?b.versions, Versioned{label: l, alias: named.ok, keep: keep}))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# where the version of alias `alias` starts, its first `@`, 0 when it has none, names nothing before it or names no
# version after it
pub fun versioned_at(alias: View) usize {
    var i: usize = 0;
    for (i < alias.len && alias.data[i] != '@') {
        i = i + 1;
    }
    if (i == 0 || i == alias.len) { ret 0; }
    var k: usize = i;
    for (k < alias.len && alias.data[k] == '@') {
        k = k + 1;
    }
    if (k - i > 3 || k == alias.len) { ret 0; }
    ret i;
}

# how many `@` the version of alias `alias` starts with, which `versioned_at` found at `at`
fun ats(alias: View, at: usize) usize {
    var k: usize = at;
    for (k < alias.len && alias.data[k] == '@') {
        k = k + 1;
    }
    ret k - at;
}

# the relocation `d` stated by itself in the current section
pub fun relocate(b: *Builder, d: Direct) err[Refusal] {
    if (b.finished) { ret refused(FINISHED); }
    val at: res[usize, Refusal] = at_cursor(b);
    if (sel at.err)                                             { ret err[Refusal].err{at.err}; }
    if (sel d.at.some && !names_label(b, d.at.some.id))         { ret refused(NOT_A_LABEL); }
    if (sel d.target.some && !names_label(b, d.target.some.id)) { ret refused(NOT_A_LABEL); }
    if (sel b.relocs.err)                                       { ret err[Refusal].err{failed(b.relocs.err)}; }
    val row_: res[*mink_row.Row, fail.Fail] = registry.relocation_by_kind(?b.relocs.ok, d.kind);
    if (sel row_.err) { ret err[Refusal].err{failed(row_.err)}; }
    val takes: err[fail.Fail] = reloc.allows_target(d.kind, sel d.target.none);
    if (sel takes.err) { ret err[Refusal].err{failed(takes.err)}; }
    var placed: Direct = d;
    placed.section = at.ok::u32;
    if (!held(vector.push[Direct](?b.direct, placed))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# a relocation of the set's fixup kind `fixup` at the cursor of the current section, naming `target`, as aarch64's
# `.tlsdesccall` marks the blr after it: a marker no bits hold, at the place llvm-mc 23.1.1 puts it, before any
# alignment between, and kept as `relocate` keeps one stated by itself, so one past every byte of its section is refused
pub fun mark(b: *Builder, fixup: operand.FixupKind, target: Label) err[Refusal] {
    val kind: *reloc.Kind = kind_of(b, fixup);
    if (kind == nil) { ret refused(UNBOUND); }
    val at: res[Label, Refusal] = position(b);
    if (sel at.err) { ret err[Refusal].err{at.err}; }
    ret relocate(b, Direct{at: opt[Label].some{at.ok}, offset: 0, kind: kind, target: opt[Label].some{target}, addend: 0});
}

# the relocation kind the object's format names `name` for the architecture, as elf's `R_RISCV_32`, none when no row
# of its is so named
pub fun relocation_named(b: *Builder, name: View) opt[*reloc.Kind] {
    if (sel b.relocs.err) { ret opt[*reloc.Kind].none{}; }
    val l: *mink_row.Lookup = b.relocs.ok.rows;
    val n: usize            = table.count[*mink_row.Row](?l.keys);
    var i: usize            = 0;
    for (i < n) {
        val r: *mink_row.Row = table.items[*mink_row.Row](?l.keys)[i];
        i = i + 1;
        if (str_len(r.name) == name.len && store.same_bytes(store.Bytes{data: r.name, len: name.len}, store.Bytes{data: name.data, len: name.len})) { ret opt[*reloc.Kind].some{r.kind}; }
    }
    ret opt[*reloc.Kind].none{};
}

# whether symbol handle `id` names a label of the builder
fun names_label(b: *Builder, id: u32) bool {
    ret id != operand.NO_SYMBOL && id::usize <= b.labels.len;
}

# how many members and literal bytes `values` hold, within them too, refused when a symbol names no label or a list nests
rec Extent {
    members:  usize;
    literals: usize;
}

fun literal_len(v: *operand.Value) usize {
    if (sel v.literal) { ret v.literal.len::usize; }
    ret 0;
}

fun extent(b: *Builder, values: *operand.Value, count: u32) res[Extent, Refusal] {
    var e: Extent = Extent{members: 0, literals: 0};
    var k: u32    = 0;
    for (k < count) {
        val held: err[Refusal] = extent_of(b, ?values[k], ?e);
        if (sel held.err) { ret res[Extent, Refusal].err{held.err}; }
        k = k + 1;
    }
    ret res[Extent, Refusal].ok{e};
}

# the members and literal bytes `v` holds added to `e`, with those the values it holds within it hold, as a variadic
# operand's groups or an enumerant's params
fun extent_of(b: *Builder, v: *operand.Value, e: *Extent) err[Refusal] {
    if (sel v.symbol && !names_label(b, v.symbol.id)) { ret err[Refusal].err{refuse(NOT_A_LABEL)}; }
    if (sel v.memory) {
        val id: u32 = v.memory.symbol.id;
        if (id != operand.NO_SYMBOL && !names_label(b, id)) { ret err[Refusal].err{refuse(NOT_A_LABEL)}; }
    }
    e.literals = e.literals + literal_len(v);
    val inner: operand.Values = operand.inner(v);
    e.members = e.members + inner.len::usize;
    var m: u32 = 0;
    for (m < inner.len) {
        val w: *operand.Value = ?inner.at[m];
        if (sel v.list && sel w.list) { ret err[Refusal].err{refuse(NESTED)}; }
        val held: err[Refusal] = extent_of(b, w, e);
        if (sel held.err) { ret held; }
        m = m + 1;
    }
    ret err[Refusal].ok{};
}

# `v`'s literal bytes appended to the literals store, where `recall` points the value
fun keep_literal(b: *Builder, v: *operand.Value) {
    if (!sel v.literal) { ret; }
    var i: u32 = 0;
    for (i < v.literal.len) {
        b.literals.data[b.literals.len + i::usize] = v.literal.at[i];
        i                                          = i + 1;
    }
    b.literals.len = b.literals.len + v.literal.len::usize;
}

# the stored values of `c` copied into `out`, the values they hold within them and their literals pointed at the stores,
# which do not move while they are read
fun recall(b: *Builder, c: *Code, out: *operand.Value) {
    var m: usize = c.members;
    var l: usize = c.literals;
    var k: u32   = 0;
    for (k < c.count) {
        out[k] = b.values.data[c.values + k::usize];
        recall_of(b, ?out[k], ?m, ?l);
        k = k + 1;
    }
}

# `v`'s literal and the values it holds within it pointed at the stores from members `m` and literals `l`, in the order
# `keep_value` stored them, both moved past what it holds
fun recall_of(b: *Builder, v: *operand.Value, m: *usize, l: *usize) {
    if (sel v.literal) {
        v.literal.at = ?b.literals.data[@l];
        @l           = @l + v.literal.len::usize;
    }
    val count: u32 = operand.inner(v).len;
    if (count == 0) { ret; }
    val first: usize = @m;
    operand.move_inner(v, ?b.members.data[first]);
    @m = first + count::usize;
    var i: u32 = 0;
    for (i < count) {
        recall_of(b, ?b.members.data[first + i::usize], m, l);
        i = i + 1;
    }
}

# the length of `ins` encoded under view `v`, measured in scratch and left as found
fun measure(b: *Builder, v: *core_state.Context, ins: *inst.Inst) res[usize, field.Refusal] {
    val done: res[Measured, field.Refusal] = spanned(b, v, ?b.modes, ins, relax.MAX_STEPS);
    if (sel done.err) { ret res[usize, field.Refusal].err{done.err}; }
    ret res[usize, field.Refusal].ok{done.ok.len};
}

# what an instruction of a sequence measured
# ---
# len:    its length encoded
# split:  the symbol of a fixup of it that covers more instructions than the sequence has left, operand.NO_SYMBOL for none
# marker: the marker of the span of its fixups, operand.NO_FIXUP for none
rec Measured {
    len:    usize;
    split:  u32;
    marker: operand.FixupKind;
}

# `ins` encoded under view `v` in scratch and left as found, its length with the first of its fixups that covers more than the
# `left` instructions from it to its sequence's end, and the marker its span states under the modes `modes`
fun spanned(b: *Builder, v: *core_state.Context, modes: *mode.State, ins: *inst.Inst, left: u32) res[Measured, field.Refusal] {
    val start: usize                     = b.scratch.len;
    val marks: usize                     = b.fixups.len;
    val done:  res[usize, field.Refusal] = walk.encode(b.set.codec, v, ins, ?b.scratch, ?b.fixups);
    var got:   Measured                  = Measured{len: 0, split: operand.NO_SYMBOL, marker: operand.NO_FIXUP};
    if (sel done.ok) {
        got.len = done.ok;
        var i: usize = marks;
        for (i < b.fixups.len && got.split == operand.NO_SYMBOL) {
            val sp: opt[*core_fixup.Span] = core_fixup.span_of(b.set.spans, b.fixups.data[i].kind);
            if (sel sp.some) {
                if (sp.some.count > left)            { got.split = b.fixups.data[i].symbol; }
                if (mode.holds(modes, sp.some.when)) { got.marker = sp.some.marker; }
            }
            i = i + 1;
        }
    }
    b.scratch.len = start;
    b.fixups.len  = marks;
    if (sel done.err) { ret res[Measured, field.Refusal].err{done.err}; }
    ret res[Measured, field.Refusal].ok{got};
}

# whether any value of `s` is a symbol
fun symbolic(s: *relax.Emitted) bool {
    var k: u32 = 0;
    for (k < s.row.operands.len) {
        if (sel s.values[k].symbol) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the forms of a sequence as `put` writes it
# ---
# chosen: each instruction in the form it is written in, with the marker its span states
# lens:   each one's length as written, every symbol encoded as zero
# total:  the list members and literal bytes they hold
# slots:  the operand values they hold
rec Shaped {
    chosen: [relax.MAX_STEPS]relax.Emitted;
    lens:   [relax.MAX_STEPS]usize;
    total:  Extent;
    slots:  usize;
}

# the `count` instructions at `steps` in the forms they are written in under view `v`, into `out`, refused as `put`
# refuses them. each is the shortest form the view admits, except in a sequence holding a symbol, as a call pair, whose
# form its relocations fix. a fixup whose relocation covers instructions after its own is refused unless the sequence
# holds them, so a call pair is written as one sequence or not at all
fun shape(b: *Builder, v: *core_state.Context, modes: *mode.State, steps: *relax.Emitted, count: u32, out: *Shaped) err[Refusal] {
    var fixed: bool = false;
    var i:     u32  = 0;
    for (i < count && count > 1) {
        fixed = fixed || symbolic(?steps[i]);
        i     = i + 1;
    }
    out.total = Extent{members: 0, literals: 0};
    out.slots = 0;
    i         = 0;
    for (i < count) {
        # the shortest form the selection admits, once, before any layout
        out.chosen[i] = steps[i];
        # a sequence whose relocations fix its forms is written exact, which the listing states
        if (fixed) { out.chosen[i].form.bits = out.chosen[i].form.bits | core_form.EXACT; }
        var given:  inst.Inst = inst.Inst{row: steps[i].row, values: ?steps[i].values[0], count: steps[i].row.operands.len, form: out.chosen[i].form};
        var packed: relax.Emitted;
        if (compress.compress(b.set.codec, b.set.compress, b.set.relax, v, ?given, ?packed)) {
            packed.marker = steps[i].marker;
            out.chosen[i] = packed;
        }
        val s: *relax.Emitted       = ?out.chosen[i];
        val n: u32                  = s.row.operands.len;
        val e: res[Extent, Refusal] = extent(b, ?s.values[0], n);
        if (sel e.err) { ret err[Refusal].err{e.err}; }
        var ins:  inst.Inst                    = inst.Inst{row: s.row, values: ?s.values[0], count: n, form: s.form};
        val done: res[Measured, field.Refusal] = spanned(b, v, modes, ?ins, count - i);
        if (sel done.err)                       { ret err[Refusal].err{encoding(done.err)}; }
        if (done.ok.split != operand.NO_SYMBOL) { ret about(SPLIT, done.ok.split); }
        # the span's marker rides beside its instruction, whoever built the sequence
        if (done.ok.marker != operand.NO_FIXUP) {
            if (s.marker != operand.NO_FIXUP && s.marker != done.ok.marker) { ret refused(MARKED); }
            s.marker = done.ok.marker;
        }
        out.lens[i]        = done.ok.len;
        out.total.members  = out.total.members + e.ok.members;
        out.total.literals = out.total.literals + e.ok.literals;
        out.slots          = out.slots + n::usize;
        i                  = i + 1;
    }
    ret err[Refusal].ok{};
}

# the instructions of `ex` in the forms `expansion` writes them in under view `v` and the modes `modes`, into `out`, or
# why it refuses them. a listing reads a statement back through this, so what it prints is what the builder writes
pub fun forms(b: *Builder, v: *core_state.Context, modes: *mode.State, ex: *relax.Expansion, out: *relax.Expansion) err[Refusal] {
    if (ex.count > relax.MAX_STEPS) { ret refused(TOO_MANY); }
    var shaped: Shaped;
    val done:   err[Refusal] = shape(b, v, modes, ?ex.steps[0], ex.count, ?shaped);
    if (sel done.err) { ret done; }
    out.count = ex.count;
    var i: u32 = 0;
    for (i < ex.count) {
        out.steps[i] = shaped.chosen[i];
        i            = i + 1;
    }
    ret err[Refusal].ok{};
}

# what the `count` instructions `shaped` chose define added to the object's stream, in order, refused where one breaks
# what the stream holds. a refusal after the first leaves what those before it defined, which no set's sequences reach:
# a set with a stream states no sequences
fun observe(b: *Builder, shaped: *Shaped, count: u32) err[Refusal] {
    if (b.set.codec.stream == nil) { ret err[Refusal].ok{}; }
    var i: u32 = 0;
    for (i < count) {
        val s:    *relax.Emitted     = ?shaped.chosen[i];
        var ins:  inst.Inst          = inst.Inst{row: s.row, values: ?s.values[0], count: s.row.operands.len, form: s.form};
        val seen: err[field.Refusal] = b.set.codec.stream.observe(b.object.stream, ?ins);
        if (sel seen.err) { ret err[Refusal].err{encoding(seen.err)}; }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the number an operand value holds, an enumerant's or an immediate's, none for another
fun number_of(v: *operand.Value) opt[u64] {
    if (sel v.enumerant) { ret opt[u64].some{v.enumerant.value::u64}; }
    if (sel v.immediate) {
        if (v.immediate >= 0) { ret opt[u64].some{v.immediate::u64}; }
    }
    ret opt[u64].none{};
}

# the instruction `steps`, one the set reads as what it states of the object (`stating`), stated on it in place of being
# written to a section: each trait its operands state, at the choice the object's format maps the value to, as the
# source states one (`state`), and each fact, kept until the object is made. it is shaped and observed as any
# instruction is, so the view admits it and the stream sees it, and every value is mapped before anything is stated,
# so a refusal states nothing. a trait an earlier instruction stated is refused, as a module states each once
fun stated_by(b: *Builder, steps: *relax.Emitted) err[Refusal] {
    if (b.finished) { ret refused(FINISHED); }
    var shaped: Shaped;
    val formed: err[Refusal] = shape(b, b.view, ?b.modes, steps, 1, ?shaped);
    if (sel formed.err) { ret formed; }
    val s:      *relax.Emitted = ?shaped.chosen[0];
    var traits: [row.MAX_OPERANDS]mink_trait.Trait;
    var nt:     u32            = 0;
    var facts:  u32            = 0;
    var bytes:  usize          = 0;
    var i:      u32            = 0;
    for (i < b.set.statings.len) {
        val st: *stating.Stating = ?b.set.statings.at[i];
        i = i + 1;
        if (st.row != s.row) { cnt; }
        val v:    *operand.Value = ?s.values[st.operand];
        val what: stating.Stated = st.stated;
        if (sel what.trait) {
            val n: opt[u64] = number_of(v);
            if (sel n.none) { ret refused(STATED_VALUE); }
            val got: res[mink_trait.Setting, fail.Fail] = registry.setting(b.formats, b.format, what.trait, contract.Written.number{n.some});
            if (sel got.err) { ret err[Refusal].err{failed(got.err)}; }
            val before: opt[*Said] = said_on(b, what.trait);
            if (sel before.some) {
                if (before.some.by_row) { ret about_axis(STATED_TWICE, what.trait); }
            }
            traits[nt] = mink_trait.Trait{axis: what.trait, setting: got.ok};
            nt         = nt + 1;
        }
        or (sel v.literal) {
            facts = facts + 1;
            bytes = bytes + v.literal.len::usize;
        }
        or {
            val n: opt[u64] = number_of(v);
            if (sel n.none) { ret refused(STATED_VALUE); }
            facts = facts + 1;
        }
    }
    var ok: bool = held(vector.reserve[Told](?b.told, facts::usize));
    ok = ok && held(vector.reserve[u8](?b.texts, bytes));
    ok = ok && held(vector.reserve[Said](?b.said, nt::usize));
    if (!ok) { ret err[Refusal].err{memory()}; }
    val observed: err[Refusal] = observe(b, ?shaped, 1);
    if (sel observed.err) { ret observed; }
    var k: u32 = 0;
    for (k < nt) {
        val stated: err[Refusal] = state(b, traits[k]);
        if (sel stated.err) { ret stated; }
        val on: opt[*Said] = said_on(b, traits[k].axis);
        if (sel on.some) { on.some.by_row = true; }
        k = k + 1;
    }
    i = 0;
    for (i < b.set.statings.len) {
        val st: *stating.Stating = ?b.set.statings.at[i];
        i = i + 1;
        if (st.row != s.row) { cnt; }
        val what: stating.Stated = st.stated;
        if (sel what.fact) {
            val v:    *operand.Value = ?s.values[st.operand];
            var told: Told           = Told{fact: what.fact, value: 0, data: opt[Span].none{}};
            if (sel v.literal) {
                val kept: res[Span, Refusal] = kept_text(b, v.literal.at, v.literal.len::usize, false);
                if (sel kept.err) { ret err[Refusal].err{kept.err}; }
                told.data = opt[Span].some{kept.ok};
            }
            or {
                val n: opt[u64] = number_of(v);
                if (sel n.some) { told.value = n.some; }
            }
            vector.push[Told](?b.told, told);
        }
    }
    ret err[Refusal].ok{};
}

# the facts instructions stated, added to `o` in the order stated, their data owned by `o`
fun record_told(b: *Builder, o: *mink_object.Object) err[fail.Fail] {
    var i: usize = 0;
    for (i < b.told.len) {
        val t:    *Told                = ?b.told.data[i];
        var data: mink_object.Contents = mink_object.Contents.zero{0};
        if (sel t.data.some) {
            val owned: res[mink_object.Contents, fail.Fail] = mink_object.own(o, ?b.texts.data[t.data.some.start], t.data.some.len);
            if (sel owned.err) { ret err[fail.Fail].err{owned.err}; }
            data = owned.ok;
        }
        val added: res[table.Id[mink_object.Fact], fail.Fail] = mink_object.add_fact(o, mink_object.Fact{format: t.fact.format, key: t.fact.key, value: t.value, data: data});
        if (sel added.err) { ret err[fail.Fail].err{added.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the instructions `steps` appended to the current section under the builder's view, all or none, in the forms `shape`
# chooses, or one the set reads as what it states of the object stated on it (`stated_by`)
fun put(b: *Builder, steps: *relax.Emitted, count: u32) err[Refusal] {
    if (count == 1 && stating.states(b.set.statings, steps[0].row)) { ret stated_by(b, steps); }
    val area: res[*Area, Refusal] = here(b);
    if (sel area.err)  { ret err[Refusal].err{area.err}; }
    if (!area.ok.bits) { ret refused(NO_BYTES); }
    var shaped: Shaped;
    val formed: err[Refusal] = shape(b, b.view, ?b.modes, steps, count, ?shaped);
    if (sel formed.err) { ret formed; }
    val total: Extent = shaped.total;
    val slots: usize  = shaped.slots;
    var ok:    bool   = held(vector.reserve[Fragment](?area.ok.fragments, count::usize));
    ok = ok && held(vector.reserve[operand.Value](?b.values, slots));
    ok = ok && held(vector.reserve[operand.Value](?b.members, total.members));
    ok = ok && held(vector.reserve[u8](?b.literals, total.literals));
    if (!ok) { ret err[Refusal].err{memory()}; }
    val observed: err[Refusal] = observe(b, ?shaped, count);
    if (sel observed.err) { ret observed; }
    val cur: res[usize, Refusal] = at_cursor(b);
    if (sel cur.ok) { bind_waiting(b, cur.ok::u32, area.ok.fragments.len::u32); }
    var i: u32 = 0;
    for (i < count) {
        val s:    *relax.Emitted         = ?shaped.chosen[i];
        val n:    u32                    = s.row.operands.len;
        val rx:   opt[*relax.Relaxation] = relax.find(b.set.relax, s.row);
        var code: Code                   = Code{
            of:       Coded.catalog{s.row},
            values:   b.values.len,
            count:    n,
            members:  b.members.len,
            literals: b.literals.len,
            marker:   s.marker,
            marked:   s.marker != operand.NO_FIXUP,
            form:     s.form,
            relax:    rx,
            initial:  shaped.lens[i]::u64,
            depth:    0,
            run:      0,
        };
        if (i == 0) { code.run = count; }
        keep_values(b, ?s.values[0], n);
        vector.push[Fragment](?area.ok.fragments, Fragment{body: Body.code{code}, size: shaped.lens[i]::u64, view: b.view, syntax: b.syntax, modes: b.state});
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the `n` values at `values` appended to the builder's values, the values they hold within them and their literal bytes
# to its own, each reserved
fun keep_values(b: *Builder, values: *operand.Value, n: u32) {
    var k: u32 = 0;
    for (k < n) {
        val v: *operand.Value = ?values[k];
        b.values.data[b.values.len] = @v;
        b.values.len                = b.values.len + 1;
        keep_value(b, v);
        k = k + 1;
    }
}

# `v`'s literal bytes and the values it holds within it appended to the builder's stores, its own run of members first
# and then what each of them holds, the order `recall_of` reads them in
fun keep_value(b: *Builder, v: *operand.Value) {
    keep_literal(b, v);
    val inner: operand.Values = operand.inner(v);
    val first: usize          = b.members.len;
    var i:     u32            = 0;
    for (i < inner.len) {
        b.members.data[first + i::usize] = inner.at[i];
        i                                = i + 1;
    }
    b.members.len = first + inner.len::usize;
    i             = 0;
    for (i < inner.len) {
        keep_value(b, ?b.members.data[first + i::usize]);
        i = i + 1;
    }
}

# the instruction format `f` states with `values`, of its row's operands, at the cursor of the current section under the
# builder's view, as risc-v's `.insn` states an encoding no catalog row has. it is written as given: never compressed,
# relaxed or read as a catalog row, its symbols folded and relocated as a catalog row's are
pub fun format(b: *Builder, f: *core_source.Format, values: *operand.Value) err[Refusal] {
    val area: res[*Area, Refusal] = here(b);
    if (sel area.err)  { ret err[Refusal].err{area.err}; }
    if (!area.ok.bits) { ret refused(NO_BYTES); }
    val n: u32                  = f.row.operands.len;
    val e: res[Extent, Refusal] = extent(b, values, n);
    if (sel e.err) { ret err[Refusal].err{e.err}; }
    var ins:  inst.Inst                    = inst.Inst{row: f.row, values: values, count: n};
    val done: res[Measured, field.Refusal] = spanned(b, b.view, ?b.modes, ?ins, 1);
    if (sel done.err)                       { ret err[Refusal].err{encoding(done.err)}; }
    if (done.ok.split != operand.NO_SYMBOL) { ret about(SPLIT, done.ok.split); }
    var ok: bool = held(vector.reserve[Fragment](?area.ok.fragments, 1));
    ok = ok && held(vector.reserve[operand.Value](?b.values, n::usize));
    ok = ok && held(vector.reserve[operand.Value](?b.members, e.ok.members));
    ok = ok && held(vector.reserve[u8](?b.literals, e.ok.literals));
    if (!ok) { ret err[Refusal].err{memory()}; }
    val cur: res[usize, Refusal] = at_cursor(b);
    if (sel cur.ok) { bind_waiting(b, cur.ok::u32, area.ok.fragments.len::u32); }
    val code: Code = Code{
        of:       Coded.format{f},
        values:   b.values.len,
        count:    n,
        members:  b.members.len,
        literals: b.literals.len,
        marker:   done.ok.marker,
        marked:   done.ok.marker != operand.NO_FIXUP,
        relax:    opt[*relax.Relaxation].none{},
        initial:  done.ok.len::u64,
        depth:    0,
        run:      1,
    };
    keep_values(b, values, n);
    vector.push[Fragment](?area.ok.fragments, Fragment{body: Body.code{code}, size: done.ok.len::u64, view: b.view, syntax: b.syntax, modes: b.state});
    ret err[Refusal].ok{};
}

# `ins` encoded at the cursor of the current section, with the marker fixup kind `marker` riding beside it, operand.NO_FIXUP for none
pub fun emit(b: *Builder, ins: *inst.Inst, marker: operand.FixupKind) err[Refusal] {
    if (ins.count != ins.row.operands.len) { ret err[Refusal].err{encoding(field.refusal(field.OPERAND_COUNT, field.NO_OPERAND, 0))}; }
    var one: relax.Emitted = relax.Emitted{row: ins.row, marker: marker, form: ins.form};
    var k:   u32           = 0;
    for (k < ins.count) {
        one.values[k] = ins.values[k];
        k             = k + 1;
    }
    ret put(b, ?one, 1);
}

# every instruction of `ex`, an expansion of a pseudo instruction, at the cursor of the current section, all or none
pub fun expansion(b: *Builder, ex: *relax.Expansion) err[Refusal] {
    if (ex.count > relax.MAX_STEPS) { ret refused(TOO_MANY); }
    ret put(b, ?ex.steps[0], ex.count);
}

# context `v` the one what is emitted next is written under: the object's, or another the source states, narrower as a
# source dialect's `.option norvc` or wider as its `.option arch, +zbb`. the context is the caller's and outlives the
# builder. it is refused when it views another register file, is of another catalog or axes, or sets an axis the
# object does not switch to another value, as `.option arch, rv32i` in an rv64 object would
pub fun under(b: *Builder, v: *core_state.Context) err[Refusal] {
    if (!of_set(b.set, v) || v.view == nil || v.view.file != b.object.view.file || v.stream != b.object.stream) { ret refused(WIDENED); }
    var i: u32 = 0;
    for (i < v.axes.len) {
        if (!v.axes.at[i].switchable && v.values.at[i] != b.object.values.at[i]) { ret refused(WIDENED); }
        i = i + 1;
    }
    var known: bool  = v == b.object;
    var k:     usize = 0;
    for (!known && k < b.views.len) {
        known = b.views.data[k] == v;
        k     = k + 1;
    }
    if (!known && !held(vector.push[*core_state.Context](?b.views, v))) { ret err[Refusal].err{memory()}; }
    b.view = v;
    ret err[Refusal].ok{};
}

# the axis of the object's architecture the attribute `tag` names in its format, none when it names none, as risc-v's
# `stack_align` or 4 names riscv-stack-align on elf
pub fun attribute(b: *Builder, tag: contract.Tag) res[opt[*mink_trait.Axis], Refusal] {
    val found: res[opt[*mink_trait.Axis], fail.Fail] = trait.attribute(b.formats, b.format, b.arch, tag);
    if (sel found.err) { ret res[opt[*mink_trait.Axis], Refusal].err{failed(found.err)}; }
    ret res[opt[*mink_trait.Axis], Refusal].ok{found.ok};
}

# the setting the value `v` written for the attribute that encodes `x` states on it in the object's format, as risc-v's
# `atomic_abi, 1` states a6c. a text is borrowed from where `v` lies
pub fun setting(b: *Builder, x: *mink_trait.Axis, v: contract.Written) res[mink_trait.Setting, Refusal] {
    val got: res[mink_trait.Setting, fail.Fail] = registry.setting(b.formats, b.format, x, v);
    if (sel got.err) { ret res[mink_trait.Setting, Refusal].err{failed(got.err)}; }
    ret res[mink_trait.Setting, Refusal].ok{got.ok};
}

# whether the set states `x` as the object's selection's spelling, so a statement of it names a selection
pub fun spells_selection(b: *Builder, x: *mink_trait.Axis) bool {
    val row: opt[*trait.Owned] = set.owner_of(b.set, x);
    if (sel row.none) { ret false; }
    val owner: trait.Owner = row.some.owner;
    if (!sel owner.selection) { ret false; }
    ret sel owner.selection.spelled;
}

# the object's selection's versioned spelling, in the builder's texts after what they hold, which the next text written
# there takes the place of
fun spelled_selection(b: *Builder) res[View, Refusal] {
    var out:     vector.Vector[u8] = vector.init[u8](b.a);
    val written: err[A.Error]      = extension.spell_versioned(b.object.selection, ?out);
    if (sel written.err) {
        vector.dnit[u8](?out);
        ret res[View, Refusal].err{memory()};
    }
    val kept: bool  = held(vector.reserve[u8](?b.texts, out.len));
    var i:    usize = 0;
    for (kept && i < out.len) {
        b.texts.data[b.texts.len + i] = out.data[i];
        i                             = i + 1;
    }
    vector.dnit[u8](?out);
    if (!kept) { ret res[View, Refusal].err{memory()}; }
    ret res[View, Refusal].ok{View{data: ?b.texts.data[b.texts.len], len: i}};
}

# the value an owner other than the source states on `x`, as the builder will state it, none where the source may: an
# axis of the source class, or a convention the caller's abi row leaves unstated, and none where the set leaves the axis
# unstated on every object. a selection's spelled text is a view
# into the builder's texts, an axis the set derives from the views written under is refused, as no value of it is known
# before the object is finished
fun owners_value(b: *Builder, x: *mink_trait.Axis) res[opt[mink_trait.Setting], Refusal] {
    val row: opt[*trait.Owned] = set.owner_of(b.set, x);
    if (sel row.some) {
        val owner: trait.Owner = row.some.owner;
        if (sel owner.derived)    { ret res[opt[mink_trait.Setting], Refusal].err{refuse(OWNED)}; }
        if (sel owner.unwritten)  { ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].none{}}; }
        if (!sel owner.selection) { ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].none{}}; }
        val by: trait.Selected = owner.selection;
        if (sel by.flag) { ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].some{mink_trait.Setting.flag{core_state.admits(b.object, by.flag)}}}; }
        val spelled: res[View, Refusal] = spelled_selection(b);
        if (sel spelled.err) { ret res[opt[mink_trait.Setting], Refusal].err{spelled.err}; }
        val text: store.Bytes = store.Bytes{data: spelled.ok.data, len: spelled.ok.len};
        ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].some{mink_trait.Setting.text{store.Held.borrowed{text}}}};
    }
    if (sel x.owner.convention) { ret res[opt[mink_trait.Setting], Refusal].ok{trait.convention(b.abi, x)}; }
    if (sel x.owner.fixed)      { ret res[opt[mink_trait.Setting], Refusal].ok{mink_arch.fixed_value(b.arch, x)}; }
    if (sel x.owner.source)     { ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].none{}}; }
    ret res[opt[mink_trait.Setting], Refusal].err{refuse(OWNED)};
}

# whether settings `a` and `b` are one value, a borrowed text by its bytes
fun agrees(a: mink_trait.Setting, b: mink_trait.Setting) bool {
    if (sel a.text) {
        if (!sel b.text)          { ret false; }
        if (!sel a.text.borrowed) { ret false; }
        if (!sel b.text.borrowed) { ret false; }
        ret store.same_bytes(a.text.borrowed, b.text.borrowed);
    }
    ret mink_trait.same(a, b);
}

# trait `t` stated of the object by its source, as risc-v's `.attribute stack_align, 16`, a later statement on the same
# axis taking its place. a text is copied, so its bytes need only outlive the call. a trait has one owner, so the source
# holds an axis of the source class, and a convention the caller's abi row leaves unstated. an axis another owner
# states is taken only at the value it states, as `.attribute arch` naming the object's own selection, and refused at
# another
pub fun state(b: *Builder, t: mink_trait.Trait) err[Refusal] {
    if (b.finished)                          { ret refused(FINISHED); }
    if (!mink_arch.has_axis(b.arch, t.axis)) { ret refused(NO_AXIS); }
    if (!mink_trait.fits(t.axis, t.setting)) { ret refused(TRAIT_VALUE); }
    val row: opt[*trait.Owned] = set.owner_of(b.set, t.axis);
    if (sel row.some) {
        if (sel row.some.owner.unwritten) { ret refused(UNWRITTEN); }
    }
    val owners: res[opt[mink_trait.Setting], Refusal] = owners_value(b, t.axis);
    if (sel owners.err) { ret err[Refusal].err{owners.err}; }
    if (sel owners.ok.some) {
        if (!agrees(owners.ok.some, t.setting)) { ret refused(DISAGREES); }
        ret err[Refusal].ok{};
    }
    var said: Said = Said{axis: t.axis, setting: t.setting, text: Span{start: 0, len: 0}, spelled: opt[Spelling].none{}, by_row: false};
    if (sel t.setting.text) {
        if (!sel t.setting.text.borrowed) { ret refused(TRAIT_VALUE); }
        val bytes: store.Bytes = t.setting.text.borrowed;
        if (!held(vector.reserve[u8](?b.texts, bytes.len))) { ret err[Refusal].err{memory()}; }
        said.text = Span{start: b.texts.len, len: bytes.len};
        var i: usize = 0;
        for (i < bytes.len) {
            b.texts.data[b.texts.len + i] = bytes.data[i];
            i                             = i + 1;
        }
        b.texts.len = b.texts.len + bytes.len;
    }
    val before: opt[*Said] = said_on(b, t.axis);
    if (sel before.some) {
        @before.some = said;
        ret err[Refusal].ok{};
    }
    if (!held(vector.push[Said](?b.said, said))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# the context what is emitted next is written under, which admits and encodes it
pub fun view(b: *Builder) *core_state.Context {
    ret b.view;
}

# the abi row of the object's architecture whose conventions the object follows, as `-mabi=lp64d` names riscv64's, the
# convention facts the builder cannot know. it is named once, before the source states a trait, and an object of an
# architecture with abi rows that names none is refused at finish
pub fun traits(b: *Builder, abi: *mink_arch.Abi) err[Refusal] {
    if (b.finished)                       { ret refused(FINISHED); }
    if (b.chosen || b.said.len != 0)      { ret refused(ABI_LATE); }
    if (abi != nil && abi.arch != b.arch) { ret refused(OTHER_ABI); }
    b.abi    = abi;
    b.chosen = true;
    ret err[Refusal].ok{};
}

# the set's syntax of index `k` the one what is emitted next is written in, which the statement record keeps
pub fun in_syntax(b: *Builder, k: u32) err[Refusal] {
    if (k >= b.set.syntaxes.len) { ret refused(NO_SYNTAX); }
    b.syntax = k;
    ret err[Refusal].ok{};
}

# the index of the syntax what is emitted next is written in
pub fun syntax_of(b: *Builder) u32 {
    ret b.syntax;
}

# `bytes` copied into the builder's texts, with a nul after them when `nul`, as a span of them
fun kept_text(b: *Builder, bytes: *u8, len: usize, nul: bool) res[Span, Refusal] {
    var n: usize = len;
    if (nul)                                    { n = n + 1; }
    if (!held(vector.reserve[u8](?b.texts, n))) { ret res[Span, Refusal].err{memory()}; }
    val start: usize = b.texts.len;
    var i:     usize = 0;
    for (i < len) {
        b.texts.data[start + i] = bytes[i];
        i                       = i + 1;
    }
    if (nul) { b.texts.data[start + len] = 0; }
    b.texts.len = start + n;
    ret res[Span, Refusal].ok{Span{start: start, len: len}};
}

# trait `t` stated of the object by its source as `state` states it, spelled by the format's attribute tag `tag` and the
# value `written` it maps from, which the listing restates it by
pub fun state_spelled(b: *Builder, t: mink_trait.Trait, tag: contract.Tag, written: contract.Written) err[Refusal] {
    val stated: err[Refusal] = state(b, t);
    if (sel stated.err) { ret stated; }
    val on: opt[*Said] = said_on(b, t.axis);
    # a trait its owner states at the value given is the owner's and needs no spelling of its own
    if (sel on.none) { ret stated; }
    var sp: Spelling = Spelling{named: false, name: Span{start: 0, len: 0}, number: 0, text: false, value: Span{start: 0, len: 0}, written: 0};
    if (sel tag.name) {
        val kept: res[Span, Refusal] = kept_text(b, tag.name, str_len(tag.name), true);
        if (sel kept.err) { ret err[Refusal].err{kept.err}; }
        sp.named = true;
        sp.name  = kept.ok;
    }
    or (sel tag.number) { sp.number = tag.number; }
    if (sel written.text) {
        val kept: res[Span, Refusal] = kept_text(b, written.text.data, written.text.len, false);
        if (sel kept.err) { ret err[Refusal].err{kept.err}; }
        sp.text  = true;
        sp.value = kept.ok;
    }
    or (sel written.number) { sp.written = written.number; }
    on.some.spelled = opt[Spelling].some{sp};
    ret err[Refusal].ok{};
}

# how many traits the source stated
pub fun said_count(b: *Builder) usize {
    ret b.said.len;
}

# how the source spelled the `k`-th trait it stated, none for one stated by no attribute tag
pub fun said_spelled(b: *Builder, k: usize) opt[Spelled] {
    val said: *Said = ?b.said.data[k];
    if (sel said.spelled.none) { ret opt[Spelled].none{}; }
    val sp:  Spelling     = said.spelled.some;
    var tag: contract.Tag = contract.Tag.number{sp.number};
    if (sp.named) { tag = contract.Tag.name{?b.texts.data[sp.name.start]}; }
    var written: contract.Written = contract.Written.number{sp.written};
    if (sp.text) { written = contract.Written.text{store.Bytes{data: ?b.texts.data[sp.value.start], len: sp.value.len}}; }
    ret opt[Spelled].some{Spelled{tag: tag, written: written}};
}

# a section the object's format holds its traits in, as the source wrote it
# ---
# name:  its name
# bytes: the bytes written in it, valid until the builder is next written or released
pub rec TraitSection {
    name:  View;
    bytes: View;
}

# how many sections the format holds its traits in the source wrote
pub fun raised_count(b: *Builder) usize {
    ret b.raised.len;
}

# the `k`-th section the format holds its traits in the source wrote, in the order it opened them
pub fun raised_at(b: *Builder, k: usize) TraitSection {
    val r: *Raised = ?b.raised.data[k];
    ret TraitSection{name: intern.bytes_of(?b.names, r.name), bytes: View{data: r.bytes.data, len: r.bytes.len}};
}

# the section and statement the cursor of the current section is at, refused before one is switched to or in a section
# the format holds its traits in
fun statement_at(b: *Builder) res[Ct, Refusal] {
    if (b.finished) { ret res[Ct, Refusal].err{refuse(FINISHED)}; }
    val at: res[usize, Refusal] = at_cursor(b);
    if (sel at.err) { ret res[Ct, Refusal].err{at.err}; }
    ret res[Ct, Refusal].ok{Ct{section: at.ok::u32, start: b.areas.data[at.ok].fragments.len::u32, end: 0, open: false}};
}

# the statements from the cursor of the current section marked as built to run in constant time, up to the cursor
# `ct_end` is called at, which mink's object carries in memory and no format writes
pub fun ct_begin(b: *Builder) err[Refusal] {
    if (b.cts.len > 0 && b.cts.data[b.cts.len - 1].open) { ret refused(CT_OPEN); }
    val here: res[Ct, Refusal] = statement_at(b);
    if (sel here.err) { ret err[Refusal].err{here.err}; }
    var c: Ct = here.ok;
    c.open = true;
    if (!held(vector.push[Ct](?b.cts, c))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# the constant-time range begun last ended at the cursor of the current section, the section it begun in
pub fun ct_end(b: *Builder) err[Refusal] {
    if (b.cts.len == 0 || !b.cts.data[b.cts.len - 1].open) { ret refused(CT_OPEN); }
    val here: res[Ct, Refusal] = statement_at(b);
    if (sel here.err) { ret err[Refusal].err{here.err}; }
    val c: *Ct = ?b.cts.data[b.cts.len - 1];
    if (here.ok.section != c.section) { ret refused(CT_SPLIT); }
    c.end  = here.ok.start;
    c.open = false;
    ret err[Refusal].ok{};
}

# the frame begun last, while it is open
fun open_frame(b: *Builder) opt[*Framed] {
    if (b.frames.len == 0 || !b.frames.data[b.frames.len - 1].open) { ret opt[*Framed].none{}; }
    ret opt[*Framed].some{?b.frames.data[b.frames.len - 1]};
}

# the frame of the function `function` begun at the cursor of the current section, its rules starting from the frame
# the set states its architecture's functions start in, as `.cfi_startproc` begins one. the builder hands mink typed
# frame records, and mink writes their bytes
pub fun cfi_start(b: *Builder, function: Label) err[Refusal] {
    val already: opt[*Framed] = open_frame(b);
    if (sel already.some) { ret refused(FRAME_OPEN); }
    val row: opt[*set.Arch] = set.arch_of(b.set, b.arch);
    if (sel row.none)          { ret refused(ARCH); }
    if (row.some.frame == nil) { ret refused(NO_FRAME); }
    val here: res[Ct, Refusal] = statement_at(b);
    if (sel here.err) { ret err[Refusal].err{here.err}; }
    val known: opt[*Mark] = mark_of(b, function);
    if (sel known.none) { ret refused(NO_SUCH); }
    val start: *set.Frame = row.some.frame;
    val cfa:   opt[u32]   = core_state.debug_number(b.object.view.file, start.cfa_register, register.DWARF, b.object);
    if (sel cfa.none) { ret refused(NO_FRAME); }
    val f: Framed = Framed{
        function:    function,
        section:     here.ok.section,
        start:       here.ok.start,
        end:         0,
        rules:       b.rules.len,
        count:       0,
        personality: opt[Pointed].none{},
        lsda:        opt[Pointed].none{},
        signal:      false,
        open:        true,
        cfa:         Cfa{reg: cfa.some::u16, fixed: start.cfa_offset, scale: 0, quantity: 0},
        depth:       0,
    };
    if (!held(vector.push[Framed](?b.frames, f))) { ret err[Refusal].err{memory()}; }
    b.kept.len = 0;
    ret err[Refusal].ok{};
}

# the canonical frame address the open frame's rules leave at the cursor, none when no frame is open
pub fun cfa(b: *Builder) opt[Cfa] {
    val open: opt[*Framed] = open_frame(b);
    if (sel open.none) { ret opt[Cfa].none{}; }
    ret opt[Cfa].some{open.some.cfa};
}

# the canonical frame address and remembered states of frame `f` after rule `rule`, refused with both as they were when
# the rule restores a state none remembers or changes the register or offset alone of an address whose offset scales
fun follow(b: *Builder, f: *Framed, rule: frame.Rule) err[Refusal] {
    if (sel rule.def_cfa) {
        f.cfa = Cfa{reg: rule.def_cfa.reg, fixed: rule.def_cfa.offset, scale: 0, quantity: 0};
    }
    or (sel rule.def_cfa_scaled) {
        val d: frame.Scaled = rule.def_cfa_scaled;
        f.cfa = Cfa{reg: d.reg, fixed: d.fixed, scale: d.scale, quantity: d.quantity};
    }
    or (sel rule.cfa_offset) {
        if (f.cfa.scale != 0) { ret refused(CFA_SCALES); }
        f.cfa.fixed = rule.cfa_offset;
    }
    or (sel rule.cfa_register) {
        if (f.cfa.scale != 0) { ret refused(CFA_SCALES); }
        f.cfa.reg = rule.cfa_register;
    }
    or (sel rule.remember) {
        if (!held(vector.push[Cfa](?b.kept, f.cfa))) { ret err[Refusal].err{memory()}; }
        f.depth = f.depth + 1;
    }
    or (sel rule.restore_state) {
        if (f.depth == 0 || b.kept.len == 0) { ret refused(NOT_REMEMBERED); }
        b.kept.len = b.kept.len - 1;
        f.cfa      = b.kept.data[b.kept.len];
        f.depth    = f.depth - 1;
    }
    ret err[Refusal].ok{};
}

# rule `rule` of the open frame taking effect at the cursor of the current section, as a `.cfi_*` directive states one.
# an expression's bytes are copied, so they need only outlive the call
pub fun cfi(b: *Builder, rule: frame.Rule) err[Refusal] {
    val open: opt[*Framed] = open_frame(b);
    if (sel open.none) { ret refused(FRAME_OPEN); }
    val here: res[Ct, Refusal] = statement_at(b);
    if (sel here.err)                         { ret err[Refusal].err{here.err}; }
    if (here.ok.section != open.some.section) { ret refused(FRAME_SPLIT); }
    var r: Ruled = Ruled{at: here.ok.start, rule: rule, expression: Span{start: 0, len: 0}};
    if (sel rule.expression) {
        val e: store.Held = rule.expression;
        if (!sel e.borrowed) { ret refused(TRAIT_VALUE); }
        val kept: res[Span, Refusal] = kept_text(b, e.borrowed.data, e.borrowed.len, false);
        if (sel kept.err) { ret err[Refusal].err{kept.err}; }
        r.expression = kept.ok;
    }
    if (!held(vector.reserve[Ruled](?b.rules, 1))) { ret err[Refusal].err{memory()}; }
    val followed: err[Refusal] = follow(b, open.some, rule);
    if (sel followed.err) { ret followed; }
    vector.push[Ruled](?b.rules, r);
    open.some.count = open.some.count + 1;
    ret err[Refusal].ok{};
}

# the open frame's personality routine, at `p`
pub fun cfi_personality(b: *Builder, p: Pointed) err[Refusal] {
    val open:  opt[*Framed] = open_frame(b);
    val known: opt[*Mark]   = mark_of(b, p.label);
    if (sel open.none)  { ret refused(FRAME_OPEN); }
    if (sel known.none) { ret refused(NO_SUCH); }
    open.some.personality = opt[Pointed].some{p};
    ret err[Refusal].ok{};
}

# the open frame's language specific data, at `p`
pub fun cfi_lsda(b: *Builder, p: Pointed) err[Refusal] {
    val open:  opt[*Framed] = open_frame(b);
    val known: opt[*Mark]   = mark_of(b, p.label);
    if (sel open.none)  { ret refused(FRAME_OPEN); }
    if (sel known.none) { ret refused(NO_SUCH); }
    open.some.lsda = opt[Pointed].some{p};
    ret err[Refusal].ok{};
}

# the tables every frame is written to, as `.cfi_sections` states them, in place of the format's default
pub fun cfi_sections(b: *Builder, to: frame.Destinations) {
    b.frame_to = opt[frame.Destinations].some{to};
}

# the open frame made a signal handler's, as `.cfi_signal_frame` makes one
pub fun cfi_signal(b: *Builder) err[Refusal] {
    val open: opt[*Framed] = open_frame(b);
    if (sel open.none) { ret refused(FRAME_OPEN); }
    open.some.signal = true;
    ret err[Refusal].ok{};
}

# the open frame ended at the cursor of the current section, the section it begun in
pub fun cfi_end(b: *Builder) err[Refusal] {
    val open: opt[*Framed] = open_frame(b);
    if (sel open.none) { ret refused(FRAME_OPEN); }
    val here: res[Ct, Refusal] = statement_at(b);
    if (sel here.err)                         { ret err[Refusal].err{here.err}; }
    if (here.ok.section != open.some.section) { ret refused(FRAME_SPLIT); }
    open.some.end  = here.ok.start;
    open.some.open = false;
    ret err[Refusal].ok{};
}

# whether the source stated a frame, which the listing does not restate
pub fun framed(b: *Builder) bool {
    ret b.frames.len > 0;
}

# every constant-time range marked on `o`, at the offsets the layout placed its statements at
fun record_cts(b: *Builder, o: *mink_object.Object) err[Refusal] {
    var i: usize = 0;
    for (i < b.cts.len) {
        val c:    *Ct   = ?b.cts.data[i];
        val area: *Area = ?b.areas.data[c.section::usize];
        if (c.open) { ret refused(CT_SPLIT); }
        val marked: res[table.Id[mink_object.CtRange], fail.Fail] = mink_object.mark_ct(o, mink_object.CtRange{section: table.Id[mink_object.Section]{index: c.section}, start: offset_at(area, c.start), end: offset_at(area, c.end)});
        if (sel marked.err) { ret err[Refusal].err{failed(marked.err)}; }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the symbol label `l` became in the finished object
fun frame_symbol(b: *Builder, l: Label) res[table.Id[mink_object.Symbol], Refusal] {
    val got: opt[table.Id[mink_object.Symbol]] = symbol_of(b, l);
    if (sel got.none) { ret res[table.Id[mink_object.Symbol], Refusal].err{Refusal{message: FRAME_SYMBOL, label: l.id}}; }
    ret res[table.Id[mink_object.Symbol], Refusal].ok{got.some};
}

# the rules a frame of the object's architecture starts from: its canonical frame address, the return address where
# the set states it is saved, by mink's return address column, then the set's other starting rules
fun starting(b: *Builder, o: *mink_object.Object, f: table.Id[mink_object.Frame], start: *set.Frame) err[Refusal] {
    val unwind: opt[mink_arch.Unwind] = b.arch.unwind;
    if (sel unwind.none) { ret refused(NO_FRAME); }
    val cfa: opt[u32] = core_state.debug_number(b.object.view.file, start.cfa_register, register.DWARF, b.object);
    if (sel cfa.none) { ret refused(NO_FRAME); }
    val added: err[fail.Fail] = mink_object.add_initial(o, f, frame.Rule.def_cfa{frame.Offset{reg: cfa.some::u16, offset: start.cfa_offset}});
    if (sel added.err) { ret err[Refusal].err{failed(added.err)}; }
    val saved: opt[i64] = start.return_saved_at;
    if (sel saved.some) {
        val ra: err[fail.Fail] = mink_object.add_initial(o, f, frame.Rule.offset{frame.Offset{reg: unwind.some.ra, offset: saved.some}});
        if (sel ra.err) { ret err[Refusal].err{failed(ra.err)}; }
    }
    var i: u32 = 0;
    for (i < start.initial.len) {
        val more: err[fail.Fail] = mink_object.add_initial(o, f, start.initial.at[i]);
        if (sel more.err) { ret err[Refusal].err{failed(more.err)}; }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the frame pointer `p` names, by the object's symbol at its label
fun frame_pointer(b: *Builder, p: Pointed) res[mink_object.Pointer, Refusal] {
    val s: res[table.Id[mink_object.Symbol], Refusal] = frame_symbol(b, p.label);
    if (sel s.err) { ret res[mink_object.Pointer, Refusal].err{s.err}; }
    ret res[mink_object.Pointer, Refusal].ok{mink_object.Pointer{symbol: s.ok, indirect: p.indirect}};
}

# every frame stated handed to `o` as mink's frame records, its rules at the offsets the layout placed their statements
# at, an expression's bytes borrowed from the builder's texts
fun record_frames(b: *Builder, o: *mink_object.Object) err[Refusal] {
    o.frame_to = b.frame_to;
    if (b.frames.len == 0) { ret err[Refusal].ok{}; }
    val row: opt[*set.Arch] = set.arch_of(b.set, b.arch);
    if (sel row.none)          { ret refused(NO_FRAME); }
    if (row.some.frame == nil) { ret refused(NO_FRAME); }
    val start: *set.Frame = row.some.frame;
    var i:     usize      = 0;
    for (i < b.frames.len) {
        val fr: *Framed = ?b.frames.data[i];
        if (fr.open) { ret refused(FRAME_SPLIT); }
        val area:     *Area                                      = ?b.areas.data[fr.section::usize];
        val function: res[table.Id[mink_object.Symbol], Refusal] = frame_symbol(b, fr.function);
        if (sel function.err) { ret err[Refusal].err{function.err}; }
        val made: res[table.Id[mink_object.Frame], fail.Fail] = mink_object.add_frame(o, function.ok, offset_at(area, fr.start), offset_at(area, fr.end), start.code_align, start.data_align);
        if (sel made.err) { ret err[Refusal].err{failed(made.err)}; }
        val began: err[Refusal] = starting(b, o, made.ok, start);
        if (sel began.err) { ret began; }
        var k: usize = 0;
        for (k < fr.count) {
            val r:    *Ruled     = ?b.rules.data[fr.rules + k];
            val kept: frame.Rule = r.rule;
            var rule: frame.Rule = kept;
            if (sel kept.expression) { rule = frame.Rule.expression{store.Held.borrowed{store.Bytes{data: ?b.texts.data[r.expression.start], len: r.expression.len}}}; }
            val stepped: err[fail.Fail] = mink_object.add_step(o, made.ok, frame.Step{at: offset_at(area, r.at), rule: rule});
            if (sel stepped.err) { ret err[Refusal].err{failed(stepped.err)}; }
            k = k + 1;
        }
        val f: *mink_object.Frame = table.at[mink_object.Frame](?o.frames, made.ok);
        f.signal = fr.signal;
        if (sel fr.personality.some) {
            val p: res[mink_object.Pointer, Refusal] = frame_pointer(b, fr.personality.some);
            if (sel p.err) { ret err[Refusal].err{p.err}; }
            f.personality = opt[mink_object.Pointer].some{p.ok};
        }
        if (sel fr.lsda.some) {
            val l: res[mink_object.Pointer, Refusal] = frame_pointer(b, fr.lsda.some);
            if (sel l.err) { ret err[Refusal].err{l.err}; }
            f.lsda = opt[mink_object.Pointer].some{l.ok};
        }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the object's context, which enters its architecture and states its selection traits
pub fun object_of(b: *Builder) *core_state.Context {
    ret b.object;
}

# the `n` bytes at `p` at the cursor of the current section
pub fun data(b: *Builder, p: *u8, n: usize) err[Refusal] {
    val raised: opt[*Raised] = raising(b);
    if (sel raised.some) {
        if (!held(vector.reserve[u8](?raised.some.bytes, n))) { ret err[Refusal].err{memory()}; }
        var k: usize = 0;
        for (k < n) {
            raised.some.bytes.data[raised.some.bytes.len + k] = p[k];
            k                                                 = k + 1;
        }
        raised.some.bytes.len = raised.some.bytes.len + n;
        ret err[Refusal].ok{};
    }
    val area: res[*Area, Refusal] = here(b);
    if (sel area.err)                                                                                    { ret err[Refusal].err{area.err}; }
    if (!area.ok.bits)                                                                                   { ret refused(NO_BYTES); }
    if (!held(vector.reserve[Fragment](?area.ok.fragments, 1)) || !held(vector.reserve[u8](?b.data, n))) { ret err[Refusal].err{memory()}; }
    val start: usize = b.data.len;
    var i:     usize = 0;
    for (i < n) {
        b.data.data[start + i] = p[i];
        i                      = i + 1;
    }
    b.data.len = start + n;
    vector.push[Fragment](?area.ok.fragments, Fragment{body: Body.data{Span{start: start, len: n}}, size: n::u64, view: b.view, syntax: b.syntax, modes: b.state});
    ret err[Refusal].ok{};
}

# `n` zero bytes at the cursor of the current section, which in a section holding no bytes are only its size
pub fun zero(b: *Builder, n: u64) err[Refusal] {
    val raised: opt[*Raised] = raising(b);
    if (sel raised.some) { ret pad_raised(raised.some, n, 0); }
    val area: res[*Area, Refusal] = here(b);
    if (sel area.err)                                                                                                                            { ret err[Refusal].err{area.err}; }
    if (!held(vector.push[Fragment](?area.ok.fragments, Fragment{body: Body.zero{n}, size: n, view: b.view, syntax: b.syntax, modes: b.state}))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# the cursor of the current section padded to `al`
pub fun align(b: *Builder, al: Align) err[Refusal] {
    val raised: opt[*Raised] = raising(b);
    if (sel raised.some) {
        if (al.boundary == 0 || (al.boundary & (al.boundary - 1)) != 0) { ret refused(BOUNDARY); }
        var fill: u8 = 0;
        if (sel al.fill.some) { fill = al.fill.some; }
        ret pad_raised(raised.some, gap(?al, raised.some.bytes.len::u64), fill);
    }
    val area: res[*Area, Refusal] = here(b);
    if (sel area.err)                                                                                                                              { ret err[Refusal].err{area.err}; }
    if (al.boundary == 0 || (al.boundary & (al.boundary - 1)) != 0)                                                                                { ret refused(BOUNDARY); }
    if (!held(vector.push[Fragment](?area.ok.fragments, Fragment{body: Body.align{al}, size: 0, view: b.view, syntax: b.syntax, modes: b.state}))) { ret err[Refusal].err{memory()}; }
    if (al.boundary > area.ok.align)                                                                                                               { area.ok.align = al.boundary; }
    ret err[Refusal].ok{};
}

# `n` bytes of `fill` after the bytes the source wrote in raised section `r`
fun pad_raised(r: *Raised, n: u64, fill: u8) err[Refusal] {
    if (!held(vector.reserve[u8](?r.bytes, n::usize))) { ret err[Refusal].err{memory()}; }
    var k: usize = 0;
    for (k < n::usize) {
        r.bytes.data[r.bytes.len + k] = fill;
        k                             = k + 1;
    }
    r.bytes.len = r.bytes.len + n::usize;
    ret err[Refusal].ok{};
}

# a datum at the cursor of the current section, which folds or relocates as an instruction's fixup does
pub fun datum(b: *Builder, r: Reference) err[Refusal] {
    val area: res[*Area, Refusal] = here(b);
    if (sel area.err)                                                                    { ret err[Refusal].err{area.err}; }
    if (!area.ok.bits)                                                                   { ret refused(NO_BYTES); }
    if (!names_label(b, r.target.id))                                                    { ret refused(NOT_A_LABEL); }
    if (r.basis > core_fixup.RELATIVE || r.width == 0 || r.width > core_fixup.MAX_WIDTH) { ret refused(NO_DATUM); }
    val fixup: operand.FixupKind = b.data_kind[datum_slot(r.basis, r.width)];
    if (fixup == operand.NO_FIXUP) { ret refused(NO_DATUM); }
    if (!held(vector.push[Fragment](?area.ok.fragments, Fragment{body: Body.datum{Datum{fixup: fixup, ref: r}}, size: r.width::u64, view: b.view, syntax: b.syntax, modes: b.state}))) {
        ret err[Refusal].err{memory()};
    }
    ret err[Refusal].ok{};
}

# the low `width` bytes of `value` into `out`, in the set's byte order, as every integer the builder writes is
pub fun ordered(b: *Builder, value: u64, width: usize, out: *u8) {
    var i: usize = 0;
    for (i < width) {
        var at: usize = i;
        if (b.set.codec.fields.order == field.BIG) { at = width - 1 - i; }
        out[at] = ((value >> (i * 8)::u64) & 0xFF)::u8;
        i       = i + 1;
    }
}

# the low `width` bytes of `value` at the cursor of the current section, in the set's byte order
pub fun integer(b: *Builder, value: u64, width: u8) err[Refusal] {
    if (width == 0 || width > core_fixup.MAX_WIDTH) { ret refused(WIDTH); }
    var bytes: [8]u8;
    ordered(b, value, width::usize, ?bytes[0]);
    ret data(b, ?bytes[0], width::usize);
}

# the difference `d` as a datum of `width` bytes at the cursor of the current section. once laid out it folds when
# both labels lie in one section with nothing between that the linker may resize, is relocated by the set's relative
# datum when the label subtracted is the datum's own place, and by the set's pair for its width when the linker may
# resize code between them. labels of two sections are refused
pub fun difference(b: *Builder, d: Difference, width: u8) err[Refusal] {
    val area: res[*Area, Refusal] = here(b);
    if (sel area.err)                                              { ret err[Refusal].err{area.err}; }
    if (!area.ok.bits)                                             { ret refused(NO_BYTES); }
    if (!names_label(b, d.plus.id) || !names_label(b, d.minus.id)) { ret refused(NOT_A_LABEL); }
    if (width == 0 || width > core_fixup.MAX_WIDTH)                { ret refused(WIDTH); }
    if (!held(vector.push[Fragment](?area.ok.fragments, Fragment{body: Body.difference{Gap{of: d, width: width}}, size: width::u64, view: b.view, syntax: b.syntax, modes: b.state}))) {
        ret err[Refusal].err{memory()};
    }
    ret err[Refusal].ok{};
}

# the offset of fragment `at` of `area` in the current pass, its end for its fragment count
fun offset_at(area: *Area, at: u32) u64 {
    if (at::usize >= area.fragments.len) { ret area.size; }
    ret area.fragments.data[at::usize].offset;
}

# the gap an alignment at `offset` pads
fun gap(al: *Align, offset: u64) u64 {
    val pad: u64 = (al.boundary - (offset & (al.boundary - 1))) & (al.boundary - 1);
    if (sel al.max.some && pad > al.max.some) { ret 0; }
    ret pad;
}

# the shortest fill pattern view `v` admits, 0 for none
fun shortest(b: *Builder, v: *core_state.Context) u64 {
    if (b.set.fill == nil) { ret 0; }
    var i: u32 = b.set.fill.count;
    for (i > 0) {
        i = i - 1;
        val p: *fill.Pattern = ?b.set.fill.patterns[i];
        if (core_state.admits(v, p.requires)) { ret p.len::u64; }
    }
    ret 0;
}

# the alignment `area` is finished with: what was asked, raised to the shortest fill pattern the object's selection
# admits when it holds an instruction, which is the set's own statement of its smallest instruction
fun aligned(b: *Builder, area: *Area) u64 {
    var j: usize = 0;
    for (j < area.fragments.len) {
        if (sel area.fragments.data[j].body.code) {
            val least: u64 = shortest(b, b.object);
            if (least > area.align) { ret least; }
            ret area.align;
        }
        j = j + 1;
    }
    ret area.align;
}

# whether alignment fragment `j` of `area` is realigned by the linker: code alignment after an instruction it may resize
fun realigned(area: *Area, j: usize, al: *Align) bool {
    ret area.code && area.marks.data[j] > 0 && al.boundary > 1;
}

# every fragment of `area` placed from the sizes of the last pass, and its marker counts taken. code
# alignment after a marked instruction pads its worst case, the boundary less the shortest instruction its
# view admits, and is itself marked, since the linker shrinks it and listed in the builder's realigned alignments
fun place(b: *Builder, area: *Area, s: u32) err[Refusal] {
    if (!held(vector.ensure[u32](?area.marks, area.fragments.len + 1))) { ret err[Refusal].err{memory()}; }
    var at:     u64   = 0;
    var marked: u32   = 0;
    var j:      usize = 0;
    for (j < area.fragments.len) {
        val f: *Fragment = ?area.fragments.data[j];
        area.marks.data[j] = marked;
        f.offset           = at;
        if (sel f.body.align) {
            val al: *Align = ?f.body.align;
            if (realigned(area, j, al)) {
                if (b.set.realign == operand.NO_FIXUP) { ret refused(RELAXED_ALIGN); }
                if (sel al.max.some)                   { ret refused(REALIGN_FORM); }
                val least: u64 = shortest(b, f.view);
                if (least == 0) { ret refused(NO_FILL); }
                f.size = 0;
                if (al.boundary > least) {
                    f.size = al.boundary - least;
                    marked = marked + 1;
                }
                if (!held(vector.push[Realigned](?b.realigns, Realigned{section: Section{index: s}, offset: at, length: f.size, fill: al.fill}))) {
                    ret err[Refusal].err{memory()};
                }
            }
            or { f.size = gap(al, at); }
        }
        if (sel f.body.code && f.body.code.marked) { marked = marked + 1; }
        at = at + f.size;
        j  = j + 1;
    }
    area.marks.data[area.fragments.len] = marked;
    area.marks.len                      = area.fragments.len + 1;
    area.size                           = at;
    ret err[Refusal].ok{};
}

# the relocation kind of fixup kind `kind`, nil when the set binds none
fun kind_of(b: *Builder, kind: operand.FixupKind) *reloc.Kind {
    if (kind::usize >= b.kinds.len) { ret nil; }
    ret b.kinds.data[kind::usize];
}

# the distance from fragment `j` of section `s` to the symbol operand `k` names as a distance from the program counter,
# a relative target or a pc-relative address, none when it does not fold, and with `across` none only when the layout
# cannot measure it
fun fold(b: *Builder, s: u32, j: u32, r: *row.Row, k: u32, v: *operand.Value, across: bool) opt[i64] {
    val desc: *operand.Operand    = ?r.operands.at[k];
    val sym:  opt[operand.Symbol] = operand.pc_symbol(desc, v);
    if (sel sym.none) { ret opt[i64].none{}; }
    var fixup: operand.FixupKind = operand.default_fixup(desc);
    if (sym.some.fixup != operand.NO_FIXUP) { fixup = sym.some.fixup; }
    ret measured(b, s, j, sym.some.id, sym.some.addend, fixup, across);
}

# an immediate's symbol folded by the set's folds
# ---
# fold:     the fold of its fixup kind
# distance: the distance its SELF fold measures, from fragment `j` for a SELF fold and from the partner's own fragment
#           for a PARTNER, which takes it whole
rec Folded {
    fold:     *core_fixup.Fold;
    distance: i64;
}

# the fold of immediate operand `k` of row `r` holding `v` in fragment `j` of section `s`, a symbol of a fixup kind the
# set folds, none when it does not fold: a SELF fold where the distance to its symbol is known, and a PARTNER where its
# symbol labels the start of an instruction in the section whose SELF fold does
fun fold_immediate(b: *Builder, s: u32, j: u32, r: *row.Row, k: u32, v: *operand.Value) opt[Folded] {
    val desc: *operand.Operand = ?r.operands.at[k];
    if (!sel desc.shape.immediate) { ret opt[Folded].none{}; }
    if (!sel v.symbol)             { ret opt[Folded].none{}; }
    val sym:   operand.Symbol    = v.symbol;
    var fixup: operand.FixupKind = operand.default_fixup(desc);
    if (sym.fixup != operand.NO_FIXUP) { fixup = sym.fixup; }
    val fo: opt[*core_fixup.Fold] = core_fixup.fold_of(b.set.folds, fixup);
    if (sel fo.none) { ret opt[Folded].none{}; }
    if (fo.some.measure == core_fixup.SELF) {
        val d: opt[i64] = measured(b, s, j, sym.id, sym.addend, fixup, false);
        if (sel d.none) { ret opt[Folded].none{}; }
        ret opt[Folded].some{Folded{fold: fo.some, distance: d.some}};
    }
    val aimed: opt[Aimed] = through(b, sym.id, sym.addend, false);
    if (sel aimed.none)         { ret opt[Folded].none{}; }
    if (aimed.some.addend != 0) { ret opt[Folded].none{}; }
    val m: *Mark = ?b.labels.data[aimed.some.id::usize - 1];
    if (!m.defined || m.section != s) { ret opt[Folded].none{}; }
    val area: *Area = ?b.areas.data[s::usize];
    if (m.fragment::usize >= area.fragments.len) { ret opt[Folded].none{}; }
    val f: *Fragment = ?area.fragments.data[m.fragment::usize];
    if (!sel f.body.code) { ret opt[Folded].none{}; }
    val c: *Code = ?f.body.code;
    if (c.depth != 0) { ret opt[Folded].none{}; }
    val pr:    *row.Row = coded(?c.of);
    var given: [row.MAX_OPERANDS]operand.Value;
    recall(b, c, ?given[0]);
    var p: u32 = 0;
    for (p < c.count) {
        val own: opt[Folded] = fold_immediate(b, s, m.fragment, pr, p, ?given[p]);
        if (sel own.some) {
            if (own.some.fold.measure == core_fixup.SELF) { ret opt[Folded].some{Folded{fold: fo.some, distance: own.some.distance}}; }
        }
        p = p + 1;
    }
    ret opt[Folded].none{};
}

# every value of the steps of `out`, the form of fragment `j` of section `s` under view `v`, that names a symbol by its
# distance from the program counter and folds, replaced by that distance from its own step's anchor, and every
# immediate whose symbol the set's folds fold, replaced by the number its fold gives. each step is measured with those
# values zero, as a length is the length of an encoding
fun fold_form(b: *Builder, s: u32, j: u32, v: *core_state.Context, out: *relax.Expansion) err[Refusal] {
    var probe: relax.Expansion = @out;
    var any:   bool            = false;
    var i:     u32             = 0;
    for (i < out.count) {
        val r: *row.Row = out.steps[i].row;
        var k: u32      = 0;
        for (k < r.operands.len) {
            val folded: opt[i64] = fold(b, s, j, r, k, ?out.steps[i].values[k], false);
            if (sel folded.some) {
                probe.steps[i].values[k] = operand.resolved(?probe.steps[i].values[k], 0);
                any                      = true;
            }
            val held: opt[Folded] = fold_immediate(b, s, j, r, k, ?out.steps[i].values[k]);
            if (sel held.some) {
                probe.steps[i].values[k] = operand.Value.immediate{0};
                any                      = true;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    if (!any) { ret err[Refusal].ok{}; }
    var at: i64 = 0;
    i = 0;
    for (i < out.count) {
        val r:    *row.Row                  = out.steps[i].row;
        var step: inst.Inst                 = inst.Inst{row: r, values: ?probe.steps[i].values[0], count: r.operands.len, form: probe.steps[i].form};
        val len:  res[usize, field.Refusal] = measure(b, v, ?step);
        if (sel len.err) { ret err[Refusal].err{encoding(len.err)}; }
        var k: u32 = 0;
        for (k < r.operands.len) {
            val folded: opt[i64] = fold(b, s, j, r, k, ?out.steps[i].values[k], false);
            if (sel folded.some) {
                var d: i64 = folded.some - at;
                if (operand.anchor_of(?r.operands.at[k]) == operand.END) { d = d - len.ok::i64; }
                out.steps[i].values[k] = operand.resolved(?out.steps[i].values[k], d);
            }
            val held: opt[Folded] = fold_immediate(b, s, j, r, k, ?out.steps[i].values[k]);
            if (sel held.some) {
                var d: i64 = held.some.distance;
                if (held.some.fold.measure == core_fixup.SELF) {
                    d = d - at;
                    if (held.some.fold.anchor == operand.END) { d = d - len.ok::i64; }
                }
                out.steps[i].values[k] = operand.Value.immediate{held.some.fold.value(d)};
            }
            k = k + 1;
        }
        at = at + len.ok::i64;
        i  = i + 1;
    }
    ret err[Refusal].ok{};
}

# the distance from fragment `j` of section `s` to label `id` plus `addend` under fixup kind `fixup`, none when the
# assembler cannot know it: the label is elsewhere or undefined, other objects may preempt it, the kind is not plainly
# pc-relative, or an instruction the linker may resize lies between
fun distance(b: *Builder, s: u32, j: u32, id: u32, addend: i64, fixup: operand.FixupKind) opt[i64] {
    ret measured(b, s, j, id, addend, fixup, false);
}

# the distance `distance` answers, and with `across` also one an instruction the linker may resize lies within, which
# the layout measures to choose a form by but leaves to the linker, since the linker only ever shrinks code
fun measured(b: *Builder, s: u32, j: u32, id: u32, addend: i64, fixup: operand.FixupKind, across: bool) opt[i64] {
    val aimed: opt[Aimed] = through(b, id, addend, false);
    if (sel aimed.none) { ret opt[i64].none{}; }
    val m: *Mark = ?b.labels.data[aimed.some.id::usize - 1];
    if (!m.defined || m.section != s) { ret opt[i64].none{}; }
    # a symbol other objects may refer to may be preempted, so its distance is the linker's
    if (preemptible(m))         { ret opt[i64].none{}; }
    if (!folds_fixup(b, fixup)) { ret opt[i64].none{}; }
    val area: *Area = ?b.areas.data[s::usize];
    var hi:   u32   = j + 1;
    if (m.fragment > hi)                                                      { hi = m.fragment; }
    if (!across && (!settled(area, j, hi) || !settled(area, m.fragment, hi))) { ret opt[i64].none{}; }
    val to:   u64 = offset_at(area, m.fragment);
    val from: u64 = area.fragments.data[j::usize].offset;
    ret opt[i64].some{to:~i64 - from:~i64 + aimed.some.addend};
}

# whether the builder folds fixup kind `fixup` when its target is a label it measures: a local kind, or one bound to a
# relocation kind `folds_kind` folds
fun folds_fixup(b: *Builder, fixup: operand.FixupKind) bool {
    ret core_fixup.local(b.set.locals, fixup) || folds_kind(kind_of(b, fixup));
}

# whether the builder folds a fixup of relocation kind `kind`, nil for none, when its target is a label it measures: a
# plainly pc-relative kind, no got, page, thread-local or partner kind, as llvm-mc resolves a branch to a local label
pub fun folds_kind(kind: *reloc.Kind) bool {
    if (kind == nil || !reloc.has(kind, reloc.PC)) { ret false; }
    ret (kind.caps & (reloc.GOT | reloc.PAGE | reloc.TLS | reloc.PARTNER)) == 0;
}

# whether the builder folds a fixup of relocation kind `kind` held by value `v` of operand `desc`, nil for a datum, to a
# label of the fragment's own section that other objects cannot preempt, when no instruction the linker may resize lies
# between them: an operand naming its target by its distance from the program counter, or a datum, of a kind
# `folds_kind` folds. a reader of an object asks it of a relocation the object holds against such a label, which a
# reassembly would not keep
pub fun folds(desc: *operand.Operand, v: *operand.Value, kind: *reloc.Kind) bool {
    if (desc != nil) {
        val sym: opt[operand.Symbol] = operand.pc_symbol(desc, v);
        if (sel sym.none) { ret false; }
    }
    ret folds_kind(kind);
}

# whether no instruction the linker may resize lies between fragments `x` and `y` of `area`
fun settled(area: *Area, x: u32, y: u32) bool {
    ret area.marks.data[x::usize] == area.marks.data[y::usize];
}

# whether other objects may preempt `m`, so only the linker knows where it is
fun preemptible(m: *Mark) bool {
    ret sel m.exposure.some && mink_symbol.binds(m.exposure.some.binding, mink_symbol.EXTERNAL);
}

# whether a relocation can name `m`: it is placed, has a value, or other objects define it
fun known(m: *Mark) bool {
    ret m.defined || sel m.value.some || sel m.exposure.some;
}

# a label plus an addend
rec Aimed {
    id:     u32;
    addend: i64;
}

# the equate of `m`, none when it has none or, unless `exposed`, when it is a symbol of the object in its own right
fun equate_of(m: *Mark, exposed: bool) opt[Equate] {
    if (!exposed && sel m.exposure.some) { ret opt[Equate].none{}; }
    if (sel m.value.some) {
        if (sel m.value.some.equate) { ret opt[Equate].some{m.value.some.equate}; }
    }
    ret opt[Equate].none{};
}

# the label `id` plus `addend` stands for through its equates, every equate when `exposed` and else those of labels
# the object does not hold as symbols, none for a cycle
fun through(b: *Builder, id: u32, addend: i64, exposed: bool) opt[Aimed] {
    var at:    Aimed = Aimed{id: id, addend: addend};
    var steps: usize = 0;
    for {
        val next: opt[Equate] = equate_of(?b.labels.data[at.id::usize - 1], exposed);
        if (sel next.none) { brk; }
        steps = steps + 1;
        if (steps > b.labels.len) { ret opt[Aimed].none{}; }
        at = Aimed{id: next.some.target, addend: at.addend + next.some.addend};
    }
    ret opt[Aimed].some{at};
}

# whether `v` fits `width` bytes, read as signed or unsigned
fun fits(v: i64, width: usize) bool {
    if (width >= 8) { ret true; }
    val half: i64 = 1::i64 << (width * 8 - 1)::i64;
    ret v >= -half && v < half * 2;
}

# what a form came to
# ---
# far:    the step taking the target is out of range and its row has a longer form
# size:   the form's length, when it is not far
# marked: whether one of its steps carries a marker
rec Formed {
    far:    bool;
    size:   u64;
    marked: bool;
}

# the instructions fragment `j` of section `s` is at depth `c.depth`, into `out`, with what they come to
fun form(b: *Builder, s: u32, j: u32, c: *Code, out: *relax.Expansion) res[Formed, Refusal] {
    val codec: *dispatch.Codec     = b.set.codec;
    val v:     *core_state.Context = b.areas.data[s::usize].fragments.data[j::usize].view;
    val r:     *row.Row            = coded(?c.of);
    var given: [row.MAX_OPERANDS]operand.Value;
    recall(b, c, ?given[0]);
    # the distance to the relaxed operand's target as the layout measures it, folded or not, none when only the
    # linker knows it
    var reach: opt[i64] = opt[i64].none{};
    var near:  opt[i64] = opt[i64].none{};
    if (sel c.relax.some) {
        val op: u32 = c.relax.some.operand::u32;
        reach = fold(b, s, j, r, op, ?given[op], true);
        near  = fold(b, s, j, r, op, ?given[op], false);
    }
    var target: u32 = 0;
    if (c.depth == 0) {
        out.count           = 1;
        out.steps[0].row    = r;
        out.steps[0].marker = c.marker;
        out.steps[0].form   = c.form;
        var k: u32 = 0;
        for (k < c.count) {
            out.steps[0].values[k] = given[k];
            k                      = k + 1;
        }
    }
    or {
        # a grown form takes its target from the layout when it folds, and its other symbols fold below by the same rule
        var from:       inst.Inst           = inst.Inst{row: r, values: ?given[0], count: c.count};
        var shortening: compress.Shortening = compress.Shortening{codec: codec, all: b.set.compress, ctx: v};
        val why:        opt[str]            = relax.grown(codec, v, b.set.relax, ?from, c.depth, near, compress.shorten(?shortening), out, ?target, ?b.scratch, ?b.fixups);
        if (sel why.some) {
            if (str_equals(why.some, relax.CHAIN)) { ret res[Formed, Refusal].err{refuse(CHAIN)}; }
            ret res[Formed, Refusal].err{refuse(EXPAND)};
        }
        out.steps[0].marker = c.marker;
    }
    val folding: err[Refusal] = fold_form(b, s, j, v, out);
    if (sel folding.err) { ret res[Formed, Refusal].err{folding.err}; }
    if (sel c.relax.some) {
        val reached: opt[bool] = relax.reaches(codec, v, b.set.relax, out, target, reach, ?b.scratch, ?b.fixups);
        if (sel reached.none) { ret res[Formed, Refusal].err{refuse(EXPAND)}; }
        if (!reached.some) {
            if (out.count != 1) { ret res[Formed, Refusal].err{refuse(CHAIN)}; }
            ret res[Formed, Refusal].ok{Formed{far: true, size: 0, marked: false}};
        }
    }
    # each step the form grew to carries the marker its span states under the modes the fragment was written under
    val modes:  *mode.State = modes_at(b, ?b.areas.data[s::usize].fragments.data[j::usize]);
    var size:   u64         = 0;
    var marked: bool        = false;
    var i:      u32         = 0;
    for (i < out.count) {
        var step: inst.Inst                    = inst.Inst{row: out.steps[i].row, values: ?out.steps[i].values[0], count: out.steps[i].row.operands.len, form: out.steps[i].form};
        val done: res[Measured, field.Refusal] = spanned(b, v, modes, ?step, relax.MAX_STEPS);
        if (sel done.err)                            { ret res[Formed, Refusal].err{encoding(done.err)}; }
        if (out.steps[i].marker == operand.NO_FIXUP) { out.steps[i].marker = done.ok.marker; }
        marked = marked || out.steps[i].marker != operand.NO_FIXUP;
        size   = size + done.ok.len::u64;
        i      = i + 1;
    }
    ret res[Formed, Refusal].ok{Formed{far: false, size: size, marked: marked}};
}

# fragment `j` of section `s` grown as far as its target needs, and its length reserved, answering whether either changed
fun settle(b: *Builder, s: u32, j: u32, out: *relax.Expansion) res[bool, Refusal] {
    val f: *Fragment = ?b.areas.data[s::usize].fragments.data[j::usize];
    if (!sel f.body.code) { ret res[bool, Refusal].ok{false}; }
    val c:       *Code = ?f.body.code;
    var changed: bool  = false;
    for {
        val formed: res[Formed, Refusal] = form(b, s, j, c, out);
        if (sel formed.err) { ret res[bool, Refusal].err{formed.err}; }
        if (formed.ok.far) {
            c.depth = c.depth + 1;
            changed = true;
            cnt;
        }
        if (formed.ok.size > f.size) {
            f.size  = formed.ok.size;
            changed = true;
        }
        if (formed.ok.marked && !c.marked) {
            c.marked = true;
            changed  = true;
        }
        brk;
    }
    ret res[bool, Refusal].ok{changed};
}

# every section laid out until no instruction grows. an instruction only grows, by a longer form, and grows at most
# as often as its row's chain of relaxations is long, so the passes are bounded by one more than the sum of those
# chains, and a layout past the bound is refused
fun lay(b: *Builder) err[Refusal] {
    var out:   relax.Expansion;
    var bound: u32   = 1;
    var s:     usize = 0;
    for (s < b.areas.len) {
        var j: usize = 0;
        for (j < b.areas.data[s].fragments.len) {
            val f: *Fragment = ?b.areas.data[s].fragments.data[j];
            if (sel f.body.code) {
                val c: *Code = ?f.body.code;
                if (sel c.of.catalog) { bound = bound + relax.depth(b.set.relax, b.set.codec, c.of.catalog); }
            }
            j = j + 1;
        }
        s = s + 1;
    }
    b.passes = 0;
    for {
        if (b.passes >= bound) { ret refused(UNSETTLED); }
        b.passes       = b.passes + 1;
        b.realigns.len = 0;
        s              = 0;
        for (s < b.areas.len) {
            val placed: err[Refusal] = place(b, ?b.areas.data[s], s::u32);
            if (sel placed.err) { ret placed; }
            s = s + 1;
        }
        var changed: bool = false;
        s = 0;
        for (s < b.areas.len) {
            var j: usize = 0;
            for (j < b.areas.data[s].fragments.len) {
                val grew: res[bool, Refusal] = settle(b, s::u32, j::u32, ?out);
                if (sel grew.err) { ret err[Refusal].err{grew.err}; }
                changed = changed || grew.ok;
                j       = j + 1;
            }
            s = s + 1;
        }
        if (!changed) { brk; }
    }
    ret err[Refusal].ok{};
}

# `size` bytes of padding for `al` appended to `area`: its fill byte, the set's code fill view `v` admits in code, or zeros
fun pad(b: *Builder, area: *Area, al: *Align, v: *core_state.Context, size: u64) err[Refusal] {
    if (!held(vector.reserve[u8](?area.bytes, size::usize))) { ret err[Refusal].err{memory()}; }
    if (!area.code || sel al.fill.some) {
        var byte: u8 = 0;
        if (sel al.fill.some) { byte = al.fill.some; }
        var i: u64 = 0;
        for (i < size) {
            area.bytes.data[area.bytes.len] = byte;
            area.bytes.len                  = area.bytes.len + 1;
            i                               = i + 1;
        }
        ret err[Refusal].ok{};
    }
    var left: u64 = size;
    for (b.set.fill != nil && left > 0) {
        val pattern: *fill.Pattern = fill.next(b.set.fill, v, left);
        if (pattern == nil) { brk; }
        var i: u32 = 0;
        for (i < pattern.len) {
            area.bytes.data[area.bytes.len] = pattern.bytes[i];
            area.bytes.len                  = area.bytes.len + 1;
            i                               = i + 1;
        }
        left = left - pattern.len::u64;
    }
    if (left > 0) { ret refused(NO_FILL); }
    ret err[Refusal].ok{};
}

# what a relocation of kind `kind` adds to the symbol's addend for the field `offset` bytes into a step of row `r` and
# `length` bytes that operand `k` fixes: for a distance from the program counter the field's offset from the operand's
# anchor, since the relocation's place is the field, as llvm-mc writes R_X86_64_PC32 `ext - 4` for a field two bytes
# into a six byte instruction, else nothing
pub fun bias(r: *row.Row, length: usize, k: usize, offset: usize, kind: *reloc.Kind) i64 {
    if (!reloc.has(kind, reloc.PC)) { ret 0; }
    var from: i64 = offset::i64;
    if (operand.anchor_of(?r.operands.at[k]) == operand.END) { from = from - length::i64; }
    ret from;
}

# the relocations of the fixups of one step of row `r` and `length` bytes, encoded at `at` of section `s`
fun relocations(b: *Builder, s: u32, at: u64, r: *row.Row, length: usize, marks: usize, marker: operand.FixupKind) err[Refusal] {
    var i: usize = marks;
    for (i < b.fixups.len) {
        val fx:   *field.Fixup = ?b.fixups.data[i];
        val kind: *reloc.Kind  = kind_of(b, fx.kind);
        if (kind == nil && core_fixup.local(b.set.locals, fx.kind)) { ret about(LOCAL_ONLY, fx.symbol); }
        if (kind == nil)                                            { ret about(UNBOUND, fx.symbol); }
        val aimed: opt[Aimed] = through(b, fx.symbol, fx.addend, false);
        if (sel aimed.none)                                   { ret about(CYCLE, fx.symbol); }
        if (!known(?b.labels.data[aimed.some.id::usize - 1])) { ret about(UNRESOLVED, fx.symbol); }
        val pended: err[Refusal] = pend(b, Pending{section: s, offset: at + fx.offset::u64, kind: kind, aim: Aim.label{aimed.some.id}, addend: aimed.some.addend + bias(r, length, fx.operand::usize, fx.offset, kind)}, fx.symbol);
        if (sel pended.err) { ret pended; }
        i = i + 1;
    }
    b.fixups.len = marks;
    if (marker != operand.NO_FIXUP) {
        val kind: *reloc.Kind = kind_of(b, marker);
        if (kind == nil) { ret refused(UNBOUND); }
        val pended: err[Refusal] = pend(b, Pending{section: s, offset: at, kind: kind, aim: Aim.nothing{}, addend: 0}, operand.NO_SYMBOL);
        if (sel pended.err) { ret pended; }
    }
    ret err[Refusal].ok{};
}

# datum `d` at `offset` of section `s`, its value written when it folds, else zeros and a relocation
fun encode_datum(b: *Builder, s: u32, j: u32, area: *Area, d: *Datum, offset: u64) err[Refusal] {
    val width: usize = d.ref.width::usize;
    if (!held(vector.reserve[u8](?area.bytes, width))) { ret err[Refusal].err{memory()}; }
    var value:  u64      = 0;
    val folded: opt[i64] = distance(b, s, j, d.ref.target.id, d.ref.addend, d.fixup);
    if (sel folded.some) {
        if (width < 8) {
            val half: i64 = 1::i64 << (width * 8 - 1)::i64;
            if (folded.some < -half || folded.some >= half) { ret about(DATUM_RANGE, d.ref.target.id); }
        }
        value = folded.some:~u64;
    }
    or {
        val kind: *reloc.Kind = kind_of(b, d.fixup);
        if (kind == nil) { ret about(UNBOUND, d.ref.target.id); }
        val pushed: err[Refusal] = aim(b, s, offset, kind, d.ref.target.id, d.ref.addend);
        if (sel pushed.err) { ret pushed; }
    }
    ordered(b, value, width, ?area.bytes.data[area.bytes.len]);
    area.bytes.len = area.bytes.len + width;
    ret err[Refusal].ok{};
}

# a relocation of kind `kind` at `offset` of section `s` naming what label `id` plus `addend` stands for
fun aim(b: *Builder, s: u32, offset: u64, kind: *reloc.Kind, id: u32, addend: i64) err[Refusal] {
    val aimed: opt[Aimed] = through(b, id, addend, false);
    if (sel aimed.none)                                   { ret about(CYCLE, id); }
    if (!known(?b.labels.data[aimed.some.id::usize - 1])) { ret about(UNRESOLVED, id); }
    ret pend(b, Pending{section: s, offset: offset, kind: kind, aim: Aim.label{aimed.some.id}, addend: aimed.some.addend}, id);
}

# relocation `p` of the last encode, refused naming `label`, the kind and the format where the object's format maps no
# relocation of its kind for the architecture, as coff has no 8-bit absolute relocation for x86_64
fun pend(b: *Builder, p: Pending, label: u32) err[Refusal] {
    var why: opt[fail.Fail] = opt[fail.Fail].none{};
    if (sel b.relocs.ok) {
        var rows: registry.Relocations          = b.relocs.ok;
        val row_: res[*registry.Row, fail.Fail] = registry.relocation_by_kind(?rows, p.kind);
        if (sel row_.err) { why = opt[fail.Fail].some{fail.about(fail.in_record(fail.unsupported(row_.err.text), b.format.name), p.kind.name)}; }
    }
    or (sel b.relocs.err)                           { why = opt[fail.Fail].some{b.relocs.err}; }
    if (sel why.some)                               { ret err[Refusal].err{Refusal{message: NO_RELOCATION, label: label, object: why}}; }
    if (!held(vector.push[Pending](?b.pending, p))) { ret err[Refusal].err{memory()}; }
    ret err[Refusal].ok{};
}

# difference `g` at `offset`, fragment `j` of section `s`: its value when it folds, else zeros and its relocations
fun encode_difference(b: *Builder, s: u32, j: u32, area: *Area, g: *Gap, offset: u64) err[Refusal] {
    val width: usize = g.width::usize;
    if (!held(vector.reserve[u8](?area.bytes, width))) { ret err[Refusal].err{memory()}; }
    val plus:  opt[Aimed] = through(b, g.of.plus.id, g.of.addend, false);
    val minus: opt[Aimed] = through(b, g.of.minus.id, 0, false);
    if (sel plus.none)  { ret about(CYCLE, g.of.plus.id); }
    if (sel minus.none) { ret about(CYCLE, g.of.minus.id); }
    val p:      *Mark = ?b.labels.data[plus.some.id::usize - 1];
    val q:      *Mark = ?b.labels.data[minus.some.id::usize - 1];
    val addend: i64   = plus.some.addend - minus.some.addend;
    val own:    bool  = q.defined && q.section == s && q.fragment == j;
    val shared: bool  = p.defined && q.defined && p.section == q.section;
    var value:  u64   = 0;
    var folded: bool  = false;
    # a distance from the datum's own place to a symbol other objects may preempt is the linker's
    if (shared && !(own && preemptible(p))) {
        val home: *Area = ?b.areas.data[p.section::usize];
        if (settled(home, p.fragment, q.fragment)) {
            val v: i64 = offset_at(home, p.fragment):~i64 - offset_at(home, q.fragment):~i64 + addend;
            if (!fits(v, width)) { ret about(DATUM_RANGE, g.of.plus.id); }
            value  = v:~u64;
            folded = true;
        }
    }
    if (!folded) {
        val relative: operand.FixupKind = b.data_kind[datum_slot(core_fixup.RELATIVE, g.width)];
        if (own && relative != operand.NO_FIXUP) {
            val kind: *reloc.Kind = kind_of(b, relative);
            if (kind == nil) { ret about(UNBOUND, g.of.plus.id); }
            val pushed: err[Refusal] = aim(b, s, offset, kind, plus.some.id, addend);
            if (sel pushed.err) { ret pushed; }
        }
        or (shared) {
            val add: *reloc.Kind = kind_of(b, b.adds[width]);
            val sub: *reloc.Kind = kind_of(b, b.subs[width]);
            if (b.adds[width] == operand.NO_FIXUP || b.subs[width] == operand.NO_FIXUP || add == nil || sub == nil) { ret about(NO_PAIR, g.of.plus.id); }
            val added: err[Refusal] = aim(b, s, offset, add, plus.some.id, addend);
            if (sel added.err) { ret added; }
            val taken: err[Refusal] = aim(b, s, offset, sub, minus.some.id, 0);
            if (sel taken.err) { ret taken; }
        }
        or { ret about(ACROSS, g.of.plus.id); }
    }
    ordered(b, value, width, ?area.bytes.data[area.bytes.len]);
    area.bytes.len = area.bytes.len + width;
    ret err[Refusal].ok{};
}

# every section's bytes, relocations and encoded instructions from the settled layout
fun encode_all(b: *Builder) err[Refusal] {
    var out:   relax.Expansion;
    var lead:  usize = 0;
    var group: u32   = 1;
    var left:  u32   = 0;
    b.pending.len = 0;
    b.entries.len = 0;
    b.listed.len  = 0;
    var s: usize = 0;
    for (s < b.areas.len) {
        val area: *Area = ?b.areas.data[s];
        area.bytes.len = 0;
        var j: usize = 0;
        for (j < area.fragments.len) {
            val f: *Fragment = ?area.fragments.data[j];
            if (sel f.body.code) {
                val formed: res[Formed, Refusal] = form(b, s::u32, j::u32, ?f.body.code, ?out);
                if (sel formed.err) { ret err[Refusal].err{formed.err}; }
                if (f.body.code.run > 0) {
                    lead  = b.entries.len;
                    group = f.body.code.run;
                    left  = group;
                }
                var run: u32 = 0;
                if (group == 1) { run = 1; }
                val start: usize = area.bytes.len;
                var i:     u32   = 0;
                for (i < out.count) {
                    val n:     u32                       = out.steps[i].row.operands.len;
                    var step:  inst.Inst                 = inst.Inst{row: out.steps[i].row, values: ?out.steps[i].values[0], count: n, form: out.steps[i].form};
                    val begin: usize                     = area.bytes.len;
                    val marks: usize                     = b.fixups.len;
                    val done:  res[usize, field.Refusal] = walk.encode(b.set.codec, f.view, ?step, ?area.bytes, ?b.fixups);
                    if (sel done.err) { ret err[Refusal].err{encoding(done.err)}; }
                    val at:   u64          = f.offset + (begin - start)::u64;
                    val rels: err[Refusal] = relocations(b, s::u32, at, out.steps[i].row, done.ok, marks, out.steps[i].marker);
                    if (sel rels.err)                                              { ret rels; }
                    if (!held(vector.reserve[operand.Value](?b.listed, n::usize))) { ret err[Refusal].err{memory()}; }
                    val first: usize = b.listed.len;
                    var k:     u32   = 0;
                    for (k < n) {
                        b.listed.data[b.listed.len] = out.steps[i].values[k];
                        b.listed.len                = b.listed.len + 1;
                        k                           = k + 1;
                    }
                    var of: Coded = Coded.catalog{out.steps[i].row};
                    if (sel f.body.code.of.format) { of = f.body.code.of; }
                    val entry: Entry = Entry{section: s::u32, offset: at, length: done.ok::u64, of: of, values: first, count: n, run: run, form: out.steps[i].form};
                    if (!held(vector.push[Entry](?b.entries, entry))) { ret err[Refusal].err{memory()}; }
                    i = i + 1;
                }
                if ((area.bytes.len - start)::u64 != f.size) { ret refused(SHRANK); }
                # the first line of a sequence counts the lines its instructions wrote
                left = left - 1;
                if (left == 0 && group > 1) { b.entries.data[lead].run = (b.entries.len - lead)::u32; }
            }
            or (sel f.body.data) {
                if (!held(vector.reserve[u8](?area.bytes, f.body.data.len))) { ret err[Refusal].err{memory()}; }
                var i: usize = 0;
                for (i < f.body.data.len) {
                    area.bytes.data[area.bytes.len] = b.data.data[f.body.data.start + i];
                    area.bytes.len                  = area.bytes.len + 1;
                    i                               = i + 1;
                }
            }
            or (sel f.body.zero) {
                if (area.bits) {
                    if (!held(vector.reserve[u8](?area.bytes, f.body.zero::usize))) { ret err[Refusal].err{memory()}; }
                    var i: u64 = 0;
                    for (i < f.body.zero) {
                        area.bytes.data[area.bytes.len] = 0;
                        area.bytes.len                  = area.bytes.len + 1;
                        i                               = i + 1;
                    }
                }
            }
            or (sel f.body.align) {
                if (area.bits) {
                    var al: Align = f.body.align;
                    if (realigned(area, j, ?al)) {
                        # the padding is the code fill whatever the alignment asked, and the marker tells the linker its length
                        al.fill = opt[u8].none{};
                        if (f.size > 0) {
                            val kind: *reloc.Kind = kind_of(b, b.set.realign);
                            if (kind == nil) { ret refused(UNBOUND); }
                            val pended: err[Refusal] = pend(b, Pending{section: s::u32, offset: f.offset, kind: kind, aim: Aim.nothing{}, addend: f.size:~i64}, operand.NO_SYMBOL);
                            if (sel pended.err) { ret pended; }
                        }
                    }
                    val padded: err[Refusal] = pad(b, area, ?al, f.view, f.size);
                    if (sel padded.err) { ret padded; }
                }
            }
            or (sel f.body.datum) {
                val put_: err[Refusal] = encode_datum(b, s::u32, j::u32, area, ?f.body.datum, f.offset);
                if (sel put_.err) { ret put_; }
            }
            or (sel f.body.difference) {
                val put_: err[Refusal] = encode_difference(b, s::u32, j::u32, area, ?f.body.difference, f.offset);
                if (sel put_.err) { ret put_; }
            }
            j = j + 1;
        }
        s = s + 1;
    }
    ret err[Refusal].ok{};
}

fun interned(o: *mink_object.Object, v: View) res[table.Id[intern.Name], fail.Fail] {
    ret mink_object.name(o, v.data, v.len);
}

fun no_name(o: *mink_object.Object) res[table.Id[intern.Name], fail.Fail] {
    ret mink_object.name_str(o, "");
}

# the name label `m` has in the object: its own, or its stem and number
fun mark_name(b: *Builder, o: *mink_object.Object, m: *Mark) res[table.Id[intern.Name], fail.Fail] {
    if (sel m.name.some) { ret interned(o, intern.bytes_of(?b.names, m.name.some)); }
    var room: [syntax.MAX_ANONYMOUS + 10]u8;
    ret interned(o, View{data: ?room[0], len: stem_spelling(stem_for(b, m), m.number, ?room[0])});
}

fun keep(slot: *opt[table.Id[mink_object.Symbol]], id: table.Id[mink_object.Symbol]) {
    @slot = opt[table.Id[mink_object.Symbol]].some{id};
}

# the object's symbol a relocation naming local label `m` names: one at the label when the label must keep its own place
# through the link, its section holding an instruction the linker may resize, the kind needing a partner there or
# naming an index, as wasm's function index, which has no offset to add, or the label thread-local, which a section
# symbol never is, else its section's, the label's offset added to the addend
fun local_symbol(b: *Builder, o: *mink_object.Object, m: *Mark, kind: *reloc.Kind, addend: *i64) res[table.Id[mink_object.Symbol], fail.Fail] {
    if (!m.defined) {
        # a number has no section to stand for it, so it is a symbol of its own
        if (sel m.symbol.some) { ret res[table.Id[mink_object.Symbol], fail.Fail].ok{m.symbol.some}; }
        val name: res[table.Id[intern.Name], fail.Fail] = mark_name(b, o, m);
        if (sel name.err) { ret res[table.Id[mink_object.Symbol], fail.Fail].err{name.err}; }
        val made: res[table.Id[mink_object.Symbol], fail.Fail] = mink_object.add_symbol(o, mink_object.Symbol{
            name:       name.ok,
            binding:    ?mink_symbol.LOCAL,
            visibility: ?mink_symbol.DEFAULT,
            kind:       kind_for(m, ?mink_symbol.NOTYPE),
            def:        definition(b, m),
        });
        if (sel made.ok) { keep(?m.symbol, made.ok); }
        ret made;
    }
    val area:   *Area = ?b.areas.data[m.section::usize];
    val offset: u64   = offset_at(area, m.fragment);
    val own:    bool  = area.marks.data[area.fragments.len] > 0 || reloc.has(kind, reloc.PARTNER) || reloc.has(kind, reloc.INDEX) || m.thread;
    if (own) {
        if (sel m.symbol.some) { ret res[table.Id[mink_object.Symbol], fail.Fail].ok{m.symbol.some}; }
        val name: res[table.Id[intern.Name], fail.Fail] = mark_name(b, o, m);
        if (sel name.err) { ret res[table.Id[mink_object.Symbol], fail.Fail].err{name.err}; }
        val made: res[table.Id[mink_object.Symbol], fail.Fail] = mink_object.add_symbol(o, mink_object.Symbol{
            name:       name.ok,
            binding:    ?mink_symbol.LOCAL,
            visibility: ?mink_symbol.DEFAULT,
            kind:       kind_for(m, ?mink_symbol.NOTYPE),
            def:        mink_object.Definition.placed{mink_object.Place{section: table.Id[mink_object.Section]{index: m.section}, offset: offset}},
        });
        if (sel made.ok) { keep(?m.symbol, made.ok); }
        ret made;
    }
    @addend = @addend + offset:~i64;
    if (sel area.symbol.some) { ret res[table.Id[mink_object.Symbol], fail.Fail].ok{area.symbol.some}; }
    val name: res[table.Id[intern.Name], fail.Fail] = no_name(o);
    if (sel name.err) { ret res[table.Id[mink_object.Symbol], fail.Fail].err{name.err}; }
    val made: res[table.Id[mink_object.Symbol], fail.Fail] = mink_object.add_symbol(o, mink_object.Symbol{
        name:       name.ok,
        binding:    ?mink_symbol.LOCAL,
        visibility: ?mink_symbol.DEFAULT,
        kind:       ?mink_symbol.SECTIONS,
        def:        mink_object.Definition.placed{mink_object.Place{section: table.Id[mink_object.Section]{index: m.section}, offset: 0}},
    });
    if (sel made.ok) { keep(?area.symbol, made.ok); }
    ret made;
}

# where label `m` is in the object, its equates followed to a place or a number, which `checked_labels` has checked they reach
fun definition(b: *Builder, m: *Mark) mink_object.Definition {
    if (m.defined) {
        ret mink_object.Definition.placed{mink_object.Place{section: table.Id[mink_object.Section]{index: m.section}, offset: offset_at(?b.areas.data[m.section::usize], m.fragment)}};
    }
    if (sel m.value.none) { ret mink_object.Definition.undefined{}; }
    val v: Value = m.value.some;
    if (sel v.absolute) { ret mink_object.Definition.absolute{v.absolute}; }
    if (sel v.common)   { ret mink_object.Definition.common{v.common}; }
    if (sel v.equate) {
        val root: opt[Aimed] = through(b, v.equate.target, v.equate.addend, true);
        if (sel root.some) {
            val r: *Mark = ?b.labels.data[root.some.id::usize - 1];
            if (r.defined) {
                val at: i64 = offset_at(?b.areas.data[r.section::usize], r.fragment):~i64 + root.some.addend;
                ret mink_object.Definition.placed{mink_object.Place{section: table.Id[mink_object.Section]{index: r.section}, offset: at:~u64}};
            }
            if (sel r.value.some) {
                if (sel r.value.some.absolute) { ret mink_object.Definition.absolute{(r.value.some.absolute:~i64 + root.some.addend):~u64}; }
            }
        }
    }
    ret mink_object.Definition.undefined{};
}

# every label checked against the layout, and each symbol's size measured: common storage is exposed, an exposed
# equate reaches a place or a number, and a measured size spans two labels of one section in order
fun checked_labels(b: *Builder) err[Refusal] {
    var i: usize = 0;
    for (i < b.labels.len) {
        val m:  *Mark = ?b.labels.data[i];
        val id: u32   = (i + 1)::u32;
        m.size   = opt[u64].none{};
        m.thread = false;
        if (sel m.value.some) {
            val v: Value = m.value.some;
            if (sel v.common && !preemptible(m)) { ret about(LOCAL_COMMON, id); }
            if (sel v.equate && sel m.exposure.some) {
                val root: opt[Aimed] = through(b, id, 0, true);
                if (sel root.none) { ret about(CYCLE, id); }
                val r:       *Mark = ?b.labels.data[root.some.id::usize - 1];
                var reached: bool  = r.defined;
                if (sel r.value.some) { reached = reached || sel r.value.some.absolute; }
                if (!reached)         { ret about(UNPLACED, id); }
            }
        }
        if (sel m.exposure.some) {
            val size: Size = m.exposure.some.size;
            if (sel size.fixed) { m.size = mink_object.sized(size.fixed); }
            if (sel size.measured) {
                val plus:  opt[Aimed] = through(b, size.measured.plus.id, size.measured.addend, true);
                val minus: opt[Aimed] = through(b, size.measured.minus.id, 0, true);
                if (sel plus.none)  { ret about(CYCLE, id); }
                if (sel minus.none) { ret about(CYCLE, id); }
                val p: *Mark = ?b.labels.data[plus.some.id::usize - 1];
                val q: *Mark = ?b.labels.data[minus.some.id::usize - 1];
                if (!p.defined || !q.defined || p.section != q.section) { ret about(ACROSS, id); }
                val home: *Area = ?b.areas.data[p.section::usize];
                val v:    i64   = offset_at(home, p.fragment):~i64 - offset_at(home, q.fragment):~i64 + plus.some.addend - minus.some.addend;
                if (v < 0) { ret about(NEGATIVE, id); }
                m.size = mink_object.sized(v:~u64);
            }
        }
        i = i + 1;
    }
    val versioned: err[Refusal] = renamed_labels(b);
    if (sel versioned.err) { ret versioned; }
    val placed: err[Refusal] = direct_places(b);
    if (sel placed.err) { ret placed; }
    ret threaded(b);
}

# whether label `m` has a value, placed or given one, rather than another object's
fun defined(b: *Builder, m: *Mark) bool {
    val def: mink_object.Definition = definition(b, m);
    ret !sel def.undefined;
}

# each label whose symbol a version renames marked with it, refused when two do, or when a default version names a
# label the object does not define. a version of a label no symbol stands for is refused when the label is placed,
# as a private one is, and states nothing when it is another object's that is never referred to
fun renamed_labels(b: *Builder) err[Refusal] {
    var i: usize = 0;
    for (i < b.labels.len) {
        b.labels.data[i].renamed = 0;
        i                        = i + 1;
    }
    i = 0;
    for (i < b.versions.len) {
        val v:     *Versioned = ?b.versions.data[i];
        val m:     *Mark      = ?b.labels.data[v.label.id::usize - 1];
        val alias: View       = intern.bytes_of(?b.names, v.alias);
        val at:    usize      = versioned_at(alias);
        i = i + 1;
        if (sel m.exposure.none) {
            if (defined(b, m)) { ret about(NO_SYMBOL, v.label.id); }
            cnt;
        }
        val n: usize = ats(alias, at);
        if (!defined(b, m) && n == 2)          { ret about(UNDEFINED_DEFAULT, v.label.id); }
        if (v.keep && defined(b, m) && n != 3) { cnt; }
        if (m.renamed != 0)                    { ret about(VERSIONS, v.label.id); }
        m.renamed = i::u32;
    }
    ret err[Refusal].ok{};
}

# the name version `v` gives a symbol into `out`: its alias, `@@@` written `@@` for a label the object defines and `@`
# for one it does not
fun version_name(b: *Builder, v: *Versioned, out: *vector.Vector[u8]) bool {
    val m:     *Mark = ?b.labels.data[v.label.id::usize - 1];
    val alias: View  = intern.bytes_of(?b.names, v.alias);
    val at:    usize = versioned_at(alias);
    var skip:  usize = 0;
    if (ats(alias, at) == 3) {
        skip = 1;
        if (!defined(b, m)) { skip = 2; }
    }
    out.len = 0;
    if (!held(vector.reserve[u8](out, alias.len))) { ret false; }
    var k: usize = 0;
    for (k < alias.len) {
        if (k < at || k >= at + skip) {
            out.data[out.len] = alias.data[k];
            out.len           = out.len + 1;
        }
        k = k + 1;
    }
    ret true;
}

# each relocation stated by itself placed in its section, refused when its label is in another section or its place
# is past the section's end
fun direct_places(b: *Builder) err[Refusal] {
    var i: usize = 0;
    for (i < b.direct.len) {
        val d:    *Direct = ?b.direct.data[i];
        val area: *Area   = ?b.areas.data[d.section::usize];
        i = i + 1;
        var base: u64 = 0;
        if (sel d.at.some) {
            val root: opt[Aimed] = through(b, d.at.some.id, 0, true);
            if (sel root.none) { ret about(CYCLE, d.at.some.id); }
            val r: *Mark = ?b.labels.data[root.some.id::usize - 1];
            if (!r.defined || r.section != d.section) { ret about(RELOCATED_PAST, d.at.some.id); }
            val at: i64 = offset_at(area, r.fragment):~i64 + root.some.addend;
            if (at < 0) { ret refused(RELOCATED_PAST); }
            base = at:~u64;
        }
        d.place = base + d.offset;
        if (d.place >= area.size) { ret refused(RELOCATED_PAST); }
    }
    ret err[Refusal].ok{};
}

# whether relocation kind `k` makes the symbol it names thread-local: a thread-local value of the symbol itself, not the
# partner a second half of a pair names, as `%tlsdesc_load_lo` names the label at its `%tlsdesc_hi`
fun threads(k: *reloc.Kind) bool {
    ret reloc.has(k, reloc.TLS) && !reloc.has(k, reloc.PARTNER);
}

# every label a thread-local relocation names marked thread-local, as llvm's ELF streamer types such a symbol STT_TLS,
# and refused when its exposure states another type
fun threaded(b: *Builder) err[Refusal] {
    var i: usize = 0;
    for (i < b.pending.len) {
        val p: *Pending = ?b.pending.data[i];
        if (sel p.aim.label) {
            if (threads(p.kind)) {
                val m: *Mark = ?b.labels.data[p.aim.label::usize - 1];
                m.thread = true;
                if (sel m.exposure.some) {
                    val k: *mink_symbol.Kind = m.exposure.some.kind;
                    if (k != ?mink_symbol.NOTYPE && !mink_symbol.names(k, mink_symbol.THREAD)) { ret about(NOT_THREAD, p.aim.label); }
                }
            }
        }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the type label `m` has in the object: its stated one, or thread-local when untyped and named by a thread-local
# relocation
fun kind_for(m: *Mark, stated: *mink_symbol.Kind) *mink_symbol.Kind {
    if (m.thread && stated == ?mink_symbol.NOTYPE) { ret ?mink_symbol.TLS; }
    ret stated;
}

# the section of the object `area` is ordered after, whose index is its area's
fun owned(area: *Area) opt[table.Id[mink_object.Section]] {
    if (sel area.owner.none) { ret opt[table.Id[mink_object.Section]].none{}; }
    ret opt[table.Id[mink_object.Section]].some{table.Id[mink_object.Section]{index: area.owner.some}};
}

# the sections, symbols and relocations of the encoded builder added to `o`
fun build_object(b: *Builder, o: *mink_object.Object) err[fail.Fail] {
    var i: usize = 0;
    i = 0;
    for (i < b.areas.len) {
        val area: *Area                      = ?b.areas.data[i];
        var name: opt[table.Id[intern.Name]] = opt[table.Id[intern.Name]].none{};
        if (sel area.name.some) {
            val named: res[table.Id[intern.Name], fail.Fail] = interned(o, intern.bytes_of(?b.names, area.name.some));
            if (sel named.err) { ret err[fail.Fail].err{named.err}; }
            name = opt[table.Id[intern.Name]].some{named.ok};
        }
        var contents: mink_object.Contents = mink_object.Contents.zero{area.size};
        if (area.bits) {
            val owned: res[mink_object.Contents, fail.Fail] = mink_object.own(o, area.bytes.data, area.bytes.len);
            if (sel owned.err) { ret err[fail.Fail].err{owned.err}; }
            contents = owned.ok;
        }
        val added: res[table.Id[mink_object.Section], fail.Fail] = mink_object.add_section(o, mink_object.Section{
            name:        name,
            kind:        area.kind,
            flags:       area.flags,
            align:       aligned(b, area),
            entsize:     area.entsize,
            contents:    contents,
            owner:       owned(area),
            disposition: area.disposition,
        });
        if (sel added.err) { ret err[fail.Fail].err{added.err}; }
        i = i + 1;
    }
    val grouped: err[fail.Fail] = groups_out(b, o);
    if (sel grouped.err) { ret grouped; }
    # the source files come before the symbols, as the locals they name the file of follow them
    i = 0;
    for (i < b.sources.len) {
        val name: res[table.Id[intern.Name], fail.Fail] = interned(o, intern.bytes_of(?b.names, b.sources.data[i]));
        if (sel name.err) { ret err[fail.Fail].err{name.err}; }
        val made: res[table.Id[mink_object.Symbol], fail.Fail] = mink_object.add_symbol(o, mink_object.Symbol{
            name:       name.ok,
            binding:    ?mink_symbol.LOCAL,
            visibility: ?mink_symbol.DEFAULT,
            kind:       ?mink_symbol.SOURCE,
            def:        mink_object.Definition.absolute{0},
        });
        if (sel made.err) { ret err[fail.Fail].err{made.err}; }
        i = i + 1;
    }
    var spelled: vector.Vector[u8] = vector.init[u8](b.a);
    val named:   err[fail.Fail]    = label_symbols(b, o, ?spelled);
    vector.dnit[u8](?spelled);
    if (sel named.err) { ret named; }
    i = 0;
    for (i < b.pending.len) {
        val p:     *Pending                          = ?b.pending.data[i];
        var aimed: res[mink_object.Reloc, fail.Fail] = aimed_at(b, o, p.kind, p.aim, p.addend);
        if (sel aimed.err) { ret err[fail.Fail].err{aimed.err}; }
        aimed.ok.section = table.Id[mink_object.Section]{index: p.section};
        aimed.ok.offset  = p.offset;
        val added: res[table.Id[mink_object.Reloc], fail.Fail] = mink_object.add_reloc(o, aimed.ok);
        if (sel added.err) { ret err[fail.Fail].err{added.err}; }
        i = i + 1;
    }
    # the relocations stated by themselves, after those of the statements
    i = 0;
    for (i < b.direct.len) {
        val d:   *Direct = ?b.direct.data[i];
        var aim: Aim     = Aim.nothing{};
        if (sel d.target.some) { aim = Aim.label{d.target.some.id}; }
        var aimed: res[mink_object.Reloc, fail.Fail] = aimed_at(b, o, d.kind, aim, d.addend);
        if (sel aimed.err) { ret err[fail.Fail].err{aimed.err}; }
        aimed.ok.section = table.Id[mink_object.Section]{index: d.section};
        aimed.ok.offset  = d.place;
        val added: res[table.Id[mink_object.Reloc], fail.Fail] = mink_object.add_reloc(o, aimed.ok);
        if (sel added.err) { ret err[fail.Fail].err{added.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a relocation of `kind` naming `aim` plus `addend` in `o`, its place left for the caller: an exposed label's symbol,
# else the symbol `local_symbol` gives a local one, the label's offset then in the addend
fun aimed_at(b: *Builder, o: *mink_object.Object, kind: *reloc.Kind, aim: Aim, addend: i64) res[mink_object.Reloc, fail.Fail] {
    var plus:   i64                = addend;
    var target: mink_object.Target = mink_object.Target.none{};
    if (sel aim.label) {
        val m: *Mark = ?b.labels.data[aim.label::usize - 1];
        if (sel m.exposure.some) {
            if (sel m.symbol.some) { target = mink_object.Target.symbol{m.symbol.some}; }
        }
        or {
            val found: res[table.Id[mink_object.Symbol], fail.Fail] = local_symbol(b, o, m, kind, ?plus);
            if (sel found.err) { ret res[mink_object.Reloc, fail.Fail].err{found.err}; }
            target = mink_object.Target.symbol{found.ok};
        }
    }
    ret res[mink_object.Reloc, fail.Fail].ok{mink_object.Reloc{section: table.Id[mink_object.Section]{index: 0}, offset: 0, kind: kind, target: target, addend: plus}};
}

# every exposed label's symbol added to `o`, named as its version renames it, then each alias a version keeps beside a
# defined label's symbol, which takes its value, binding, visibility, type and size, `name` the room a version's name is
# spelled in
fun label_symbols(b: *Builder, o: *mink_object.Object, name: *vector.Vector[u8]) err[fail.Fail] {
    var i: usize = 0;
    for (i < b.labels.len) {
        val m: *Mark = ?b.labels.data[i];
        i = i + 1;
        if (sel m.exposure.none) { cnt; }
        var named: res[table.Id[intern.Name], fail.Fail] = res[table.Id[intern.Name], fail.Fail].ok{table.Id[intern.Name]{index: 0}};
        if (m.renamed != 0) {
            if (!version_name(b, ?b.versions.data[(m.renamed - 1)::usize], name)) { ret err[fail.Fail].err{fail.overflow("symbol version name")}; }
            named = interned(o, View{data: name.data, len: name.len});
        }
        or                 { named = mark_name(b, o, m); }
        if (sel named.err) { ret err[fail.Fail].err{named.err}; }
        val made: res[table.Id[mink_object.Symbol], fail.Fail] = add_label_symbol(b, o, m, m.exposure.some, named.ok);
        if (sel made.err) { ret err[fail.Fail].err{made.err}; }
        m.symbol = opt[table.Id[mink_object.Symbol]].some{made.ok};
    }
    i = 0;
    for (i < b.versions.len) {
        val v: *Versioned = ?b.versions.data[i];
        val m: *Mark      = ?b.labels.data[v.label.id::usize - 1];
        i = i + 1;
        if (m.renamed == i::u32 || !defined(b, m)) { cnt; }
        if (sel m.exposure.some) {
            if (!version_name(b, v, name)) { ret err[fail.Fail].err{fail.overflow("symbol version name")}; }
            val named: res[table.Id[intern.Name], fail.Fail] = interned(o, View{data: name.data, len: name.len});
            if (sel named.err) { ret err[fail.Fail].err{named.err}; }
            val made: res[table.Id[mink_object.Symbol], fail.Fail] = add_label_symbol(b, o, m, m.exposure.some, named.ok);
            if (sel made.err) { ret err[fail.Fail].err{made.err}; }
        }
    }
    ret err[fail.Fail].ok{};
}

# the symbol of exposed label `m` named `name` added to `o`
fun add_label_symbol(b: *Builder, o: *mink_object.Object, m: *Mark, e: Exposure, name: table.Id[intern.Name]) res[table.Id[mink_object.Symbol], fail.Fail] {
    ret mink_object.add_symbol(o, mink_object.Symbol{
        name:       name,
        binding:    e.binding,
        visibility: e.visibility,
        kind:       kind_for(m, e.kind),
        def:        definition(b, m),
        size:       m.size,
    });
}

# the comdat groups of the sections, one per signature in the order its first section was opened, each section in its
# signature's group
fun groups_out(b: *Builder, o: *mink_object.Object) err[fail.Fail] {
    # per builder name, the object's group of that signature plus one, 0 for none yet
    var made: vector.Vector[u32]  = vector.init[u32](b.a);
    val room: res[usize, A.Error] = vector.reserve[u32](?made, b.named.len);
    if (sel room.err) { ret err[fail.Fail].err{fail.refused(room.err)}; }
    var k: usize = 0;
    for (k < b.named.len) {
        made.data[k] = 0;
        k            = k + 1;
    }
    made.len = b.named.len;
    var done: err[fail.Fail] = err[fail.Fail].ok{};
    var i:    usize          = 0;
    for (i < b.areas.len && sel done.ok) {
        val g: opt[table.Id[intern.Name]] = b.areas.data[i].group;
        if (sel g.some) {
            val at: usize = g.some.index::usize;
            if (made.data[at] == 0) {
                val sig: res[table.Id[intern.Name], fail.Fail] = interned(o, intern.bytes_of(?b.names, g.some));
                if (sel sig.err) { done = err[fail.Fail].err{sig.err}; }
                if (sel sig.ok) {
                    val added: res[table.Id[mink_object.Group], fail.Fail] = mink_object.add_group(o, mink_object.Group{signature: sig.ok, rule: ?mink_group.ANY});
                    if (sel added.err) { done = err[fail.Fail].err{added.err}; }
                    if (sel added.ok)  { made.data[at] = added.ok.index + 1; }
                }
            }
            if (sel done.ok) { mink_object.section_at(o, table.Id[mink_object.Section]{index: i::u32}).group = opt[table.Id[mink_object.Group]].some{table.Id[mink_object.Group]{index: made.data[at] - 1}}; }
        }
        i = i + 1;
    }
    vector.dnit[u32](?made);
    ret done;
}

# what a section holds where a mapping symbol was last written
# ---
# UNMARKED: nothing marked yet
# CODE:     code, under the code mark last written
# DATA:     data
def Marked: u8;

val UNMARKED: Marked = 0;
val CODE:     Marked = 1;
val DATA:     Marked = 2;

# a mapping symbol named `name` at `offset` of section `s`, a local symbol of no type
fun mark_place(b: *Builder, o: *mink_object.Object, s: usize, offset: u64, name: *u8, len: usize) err[Refusal] {
    val named: res[table.Id[intern.Name], fail.Fail] = mink_object.name(o, name, len);
    if (sel named.err) { ret err[Refusal].err{failed(named.err)}; }
    val made: res[table.Id[mink_object.Symbol], fail.Fail] = mink_object.add_symbol(o, mink_object.Symbol{
        name:       named.ok,
        binding:    ?mink_symbol.LOCAL,
        visibility: ?mink_symbol.DEFAULT,
        kind:       ?mink_symbol.NOTYPE,
        def:        mink_object.Definition.placed{mink_object.Place{section: table.Id[mink_object.Section]{index: s::u32}, offset: offset}},
    });
    if (sel made.err) { ret err[Refusal].err{failed(made.err)}; }
    ret err[Refusal].ok{};
}

# the code mark of view `v` into `out`: the mapping's code stem, followed by the view's versioned selection when the
# mapping names the view
fun code_mark(b: *Builder, m: *mink_pair.Mapping, v: *core_state.Context, out: *vector.Vector[u8]) bool {
    out.len = 0;
    val stem: err[A.Error] = extension.append(out, m.code);
    if (sel stem.err) { ret false; }
    if (!m.per_view)  { ret true; }
    val spelled: err[A.Error] = extension.spell_versioned(v.selection, out);
    ret sel spelled.ok;
}

# the mapping symbols of every section: a code mark where code starts, at a section's start, after data, or under a
# view whose code mark is another, and a data mark where data starts, as llvm-mc 23.1.1 writes `$x` and `$d`
# (RISCVELFStreamer.cpp and AArch64ELFStreamer.cpp emitMappingSymbol). an alignment starts neither, so its padding
# reads as what came before it, and a section holding only labels holds no mark
fun map_sections(b: *Builder, o: *mink_object.Object) err[Refusal] {
    if (sel b.mapping.none) { ret err[Refusal].ok{}; }
    val m:    *mink_pair.Mapping = b.mapping.some;
    var name: vector.Vector[u8]  = vector.init[u8](b.a);
    var last: vector.Vector[u8]  = vector.init[u8](b.a);
    var done: err[Refusal]       = err[Refusal].ok{};
    var s:    usize              = 0;
    for (s < b.areas.len && sel done.ok) {
        val area: *Area               = ?b.areas.data[s];
        var at:   Marked              = UNMARKED;
        var seen: *core_state.Context = nil;
        var j:    usize               = 0;
        for (j < area.fragments.len && sel done.ok) {
            val f: *Fragment = ?area.fragments.data[j];
            j = j + 1;
            if (sel f.body.align) { cnt; }
            if (!sel f.body.code) {
                if (at != DATA) { done = mark_place(b, o, s, f.offset, m.data, str_len(m.data)); }
                at = DATA;
                cnt;
            }
            # a view's mark is spelled once each time the view changes, and written when it is another than the last
            if (at == CODE && f.view == seen) { cnt; }
            seen = f.view;
            if (!code_mark(b, m, f.view, ?name)) {
                done = err[Refusal].err{memory()};
                cnt;
            }
            if (at == CODE && store.same_bytes(store.Bytes{data: name.data, len: name.len}, store.Bytes{data: last.data, len: last.len})) { cnt; }
            done     = mark_place(b, o, s, f.offset, name.data, name.len);
            at       = CODE;
            last.len = 0;
            if (!held(vector.reserve[u8](?last, name.len))) {
                done = err[Refusal].err{memory()};
                cnt;
            }
            var k: usize = 0;
            for (k < name.len) {
                last.data[k] = name.data[k];
                k            = k + 1;
            }
            last.len = name.len;
        }
        s = s + 1;
    }
    vector.dnit[u8](?name);
    vector.dnit[u8](?last);
    ret done;
}

# whether the object's context or any context a fragment was written under admits `required`, as the gnu assembler
# sets EF_RISCV_RVC when `.option arch, +c` turns c on in an object built without it
fun written_under(b: *Builder, required: requirement.Requirement) bool {
    if (core_state.admits(b.object, required)) { ret true; }
    var i: usize = 0;
    for (i < b.areas.len) {
        val area: *Area = ?b.areas.data[i];
        var j:    usize = 0;
        for (j < area.fragments.len) {
            val v: *core_state.Context = area.fragments.data[j].view;
            if (v != b.object && core_state.admits(v, required)) { ret true; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret false;
}

# what the source stated on `x`, none when it stated nothing. the source states few traits, each axis once
fun said_on(b: *Builder, x: *mink_trait.Axis) opt[*Said] {
    var i: usize = 0;
    for (i < b.said.len) {
        if (b.said.data[i].axis == x) { ret opt[*Said].some{?b.said.data[i]}; }
        i = i + 1;
    }
    ret opt[*Said].none{};
}

# what the source stated in `said` stated on `o`, a text owned by `o`
fun state_said(b: *Builder, o: *mink_object.Object, said: *Said) err[fail.Fail] {
    var setting: mink_trait.Setting = said.setting;
    if (sel said.setting.text) {
        val owned: res[store.Held, fail.Fail] = store.own(?o.store, ?b.texts.data[said.text.start], said.text.len);
        if (sel owned.err) { ret err[fail.Fail].err{owned.err}; }
        setting = mink_trait.Setting.text{owned.ok};
    }
    ret mink_object.state(o, said.axis, setting);
}

# `setting` stated on `o` on `x`, a borrowed text owned by `o`
fun state_on(o: *mink_object.Object, x: *mink_trait.Axis, setting: mink_trait.Setting) err[fail.Fail] {
    var on: mink_trait.Setting = setting;
    if (sel setting.text) {
        if (sel setting.text.borrowed) {
            val bytes: store.Bytes                = setting.text.borrowed;
            val owned: res[store.Held, fail.Fail] = store.own(?o.store, bytes.data, bytes.len);
            if (sel owned.err) { ret err[fail.Fail].err{owned.err}; }
            on = mink_trait.Setting.text{owned.ok};
        }
    }
    ret mink_object.state(o, x, on);
}

# every trait the sections the format holds the traits in state, raised from the bytes the source wrote in them, stated
# as the source states a trait (`state`), so a trait another owner states must agree with it. bytes that state no trait
# the format maps are refused, carrying the format's refusal, which names what no row maps
fun raise_all(b: *Builder) err[Refusal] {
    var k: usize = 0;
    for (k < b.raised.len) {
        val r:      *Raised                       = ?b.raised.data[k];
        var traits: table.Table[mink_trait.Trait] = table.make[mink_trait.Trait](b.a);
        val named:  View                          = intern.bytes_of(?b.names, r.name);
        val name:   store.Bytes                   = store.Bytes{data: named.data, len: named.len};
        val got:    err[fail.Fail]                = registry.raise(b.formats, b.format, b.arch, name, store.Bytes{data: r.bytes.data, len: r.bytes.len}, ?traits);
        var why:    err[Refusal]                  = err[Refusal].ok{};
        if (sel got.err) { why = err[Refusal].err{Refusal{message: RAISE, label: operand.NO_SYMBOL, object: opt[fail.Fail].some{got.err}}}; }
        var i: usize = 0;
        for (!sel why.err && i < table.count[mink_trait.Trait](?traits)) {
            val t:      mink_trait.Trait = @table.at[mink_trait.Trait](?traits, table.nth[mink_trait.Trait](i));
            val stated: err[Refusal]     = state(b, t);
            if (sel stated.err) { why = about_axis(stated.err.message, t.axis); }
            i = i + 1;
        }
        val released: err[fail.Fail] = table.release[mink_trait.Trait](?traits);
        if (sel why.err)      { ret why; }
        if (sel released.err) { ret err[Refusal].err{failed(released.err)}; }
        k = k + 1;
    }
    ret err[Refusal].ok{};
}

# the value the owner of `x` other than the source states on the finished object, as `owners_value`, and a derived
# axis's from every view written under
fun finished_value(b: *Builder, x: *mink_trait.Axis) res[opt[mink_trait.Setting], Refusal] {
    val row: opt[*trait.Owned] = set.owner_of(b.set, x);
    if (sel row.some) {
        val owner: trait.Owner = row.some.owner;
        if (sel owner.derived) { ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].some{mink_trait.Setting.flag{written_under(b, owner.derived)}}}; }
    }
    ret owners_value(b, x);
}

# the set's default of source axis `x`, none for none
fun default_of(b: *Builder, x: *mink_trait.Axis) opt[mink_trait.Setting] {
    val row: opt[*trait.Owned] = set.owner_of(b.set, x);
    if (sel row.none) { ret opt[mink_trait.Setting].none{}; }
    val owner: trait.Owner = row.some.owner;
    if (sel owner.source) { ret opt[mink_trait.Setting].some{owner.source.setting}; }
    ret opt[mink_trait.Setting].none{};
}

# the value the set's chosen row of source axis `x` gives it, the merge of the choices the atoms the object's selection
# holds name in the object's format, none for no chosen row or no atom held. a merge the axis refuses is refused naming it
fun chosen_of(b: *Builder, x: *mink_trait.Axis) res[opt[mink_trait.Setting], Refusal] {
    val none: opt[mink_trait.Setting] = opt[mink_trait.Setting].none{};
    val row:  opt[*trait.Owned]       = set.owner_of(b.set, x);
    if (sel row.none) { ret res[opt[mink_trait.Setting], Refusal].ok{none}; }
    val owner: trait.Owner = row.some.owner;
    if (!sel owner.chosen) { ret res[opt[mink_trait.Setting], Refusal].ok{none}; }
    val atoms: requirement.Atoms  = owner.chosen;
    var any:   bool               = false;
    var held:  mink_trait.Setting = mink_trait.Setting.flag{false};
    var i:     u32                = 0;
    for (i < atoms.len) {
        val atom: *requirement.Atom = ?atoms.at[i];
        i = i + 1;
        if (!extension.has(b.object.selection, atom.id)) { cnt; }
        val got: res[mink_trait.Setting, fail.Fail] = registry.setting(b.formats, b.format, x, contract.Written.number{atom.value});
        if (sel got.err) { ret res[opt[mink_trait.Setting], Refusal].err{failed(got.err)}; }
        if (!any) {
            held = got.ok;
            any  = true;
            cnt;
        }
        val joined: catalog_merge.Joined[mink_trait.Setting] = mink_trait.merge(x, held, got.ok);
        if (!sel joined.kept) { ret res[opt[mink_trait.Setting], Refusal].err{Refusal{message: TRAIT_VALUE, label: operand.NO_SYMBOL, axis: opt[*mink_trait.Axis].some{x}}}; }
        held = joined.kept;
    }
    if (!any) { ret res[opt[mink_trait.Setting], Refusal].ok{none}; }
    ret res[opt[mink_trait.Setting], Refusal].ok{opt[mink_trait.Setting].some{held}};
}

# every axis of the architecture stated on `o` by its owner: one the set derives by its row, a convention by the caller's
# abi row, a fixed one by the architecture row, and one the source may state by its last statement or else the set's
# default or the choice the selection makes. an axis the format requires that no owner states is refused naming it
fun state_traits(b: *Builder, o: *mink_object.Object) err[Refusal] {
    var i: usize = 0;
    for (i < b.arch.axis_count) {
        val x: *mink_trait.Axis = b.arch.axes[i];
        i = i + 1;
        val owned: res[opt[mink_trait.Setting], Refusal] = finished_value(b, x);
        if (sel owned.err) { ret err[Refusal].err{owned.err}; }
        val chose: res[opt[mink_trait.Setting], Refusal] = chosen_of(b, x);
        if (sel chose.err) { ret err[Refusal].err{chose.err}; }
        var put:  err[fail.Fail]          = err[fail.Fail].ok{};
        val said: opt[*Said]              = said_on(b, x);
        val dflt: opt[mink_trait.Setting] = default_of(b, x);
        if (sel owned.ok.some)             { put = state_on(o, x, owned.ok.some); }
        or (sel said.some)                 { put = state_said(b, o, said.some); }
        or (sel dflt.some)                 { put = state_on(o, x, dflt.some); }
        or (sel chose.ok.some)             { put = state_on(o, x, chose.ok.some); }
        or (trait.required(?b.encoded, x)) { ret about_axis(MISSING_TRAIT, x); }
        if (sel put.err)                   { ret err[Refusal].err{failed(put.err)}; }
    }
    ret err[Refusal].ok{};
}

# every section laid out to a fixed point from what was emitted, so the places of labels and the sizes of sections are
# final until something more is emitted. it starts from the instructions as emitted, so a refused layout leaves no growth
# behind
pub fun layout(b: *Builder) err[Refusal] {
    if (b.finished) { ret refused(FINISHED); }
    val placed: err[Refusal] = settle_waiting(b);
    if (sel placed.err) { ret placed; }
    var s: usize = 0;
    for (s < b.areas.len) {
        val area: *Area = ?b.areas.data[s];
        area.symbol = opt[table.Id[mink_object.Symbol]].none{};
        var j: usize = 0;
        for (j < area.fragments.len) {
            val f: *Fragment = ?area.fragments.data[j];
            if (sel f.body.code) {
                f.body.code.depth = 0;
                f.size            = f.body.code.initial;
            }
            j = j + 1;
        }
        s = s + 1;
    }
    var i: usize = 0;
    for (i < b.labels.len) {
        b.labels.data[i].symbol = opt[table.Id[mink_object.Symbol]].none{};
        i                       = i + 1;
    }
    ret lay(b);
}

# the length of section `s` in the last layout
pub fun size_of(b: *Builder, s: Section) u64 {
    if (s.index::usize >= b.areas.len) { ret 0; }
    ret b.areas.data[s.index::usize].size;
}

# what a writer can only append to, as it is now
fun snapshot(b: *Builder) Snapshot {
    ret Snapshot{
        areas:    b.areas.len,
        labels:   b.labels.len,
        values:   b.values.len,
        members:  b.members.len,
        literals: b.literals.len,
        data:     b.data.len,
        waiting:  b.waiting.len,
        names:    intern.count(?b.names),
        sources:  b.sources.len,
        realigns: b.realigns.len,
        current:  b.current,
        started:  b.started,
        view:     b.view,
        syntax:   b.syntax,
        modes:    b.modes,
        states:   b.states.len,
        state:    b.state,
        told:     b.told.len,
    };
}

# everything added since `s` taken back by truncation, which is every effect of a writer, as it may only add
fun restore(b: *Builder, s: *Snapshot) {
    var i: usize = s.areas;
    for (i < b.areas.len) {
        val area: *Area = ?b.areas.data[i];
        if (sel area.name.some) {
            if (b.titled.data[area.name.some.index::usize] == i::u32 + 1) { b.titled.data[area.name.some.index::usize] = 0; }
        }
        vector.dnit[Fragment](?area.fragments);
        vector.dnit[u32](?area.marks);
        vector.dnit[u8](?area.bytes);
        i = i + 1;
    }
    b.areas.len = s.areas;
    i           = s.labels;
    for (i < b.labels.len) {
        val m: *Mark = ?b.labels.data[i];
        if (sel m.name.some) { b.named.data[m.name.some.index::usize] = operand.NO_SYMBOL; }
        i = i + 1;
    }
    b.labels.len   = s.labels;
    b.values.len   = s.values;
    b.members.len  = s.members;
    b.literals.len = s.literals;
    b.data.len     = s.data;
    b.waiting.len  = s.waiting;
    b.sources.len  = s.sources;
    b.realigns.len = s.realigns;
    # the mark is the interner's own count from `snapshot`, so truncating to it cannot be refused
    val cut: err[fail.Fail] = intern.truncate(?b.names, s.names);
    b.named.len  = s.names;
    b.titled.len = s.names;
    b.current    = s.current;
    b.started    = s.started;
    b.view       = s.view;
    b.syntax     = s.syntax;
    b.modes      = s.modes;
    b.states.len = s.states;
    b.state      = s.state;
    b.told.len   = s.told;
}

# every writer run in order, each writing from the final places, refused at the first that fails
fun write_all(b: *Builder) err[Refusal] {
    var i: usize = 0;
    for (i < b.writers.len) {
        val w: *Writer = ?b.writers.data[i];
        if (w.write != nil) {
            val wrote: err[Refusal] = w.write(w.context, b);
            if (sel wrote.err) { ret wrote; }
        }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# every writer's records stated on `o` in order, with the builder closed, refused at the first that fails
fun record_all(b: *Builder, o: *mink_object.Object) err[Refusal] {
    b.finished = true;
    var made: err[Refusal] = err[Refusal].ok{};
    var i:    usize        = 0;
    for (i < b.writers.len) {
        val w: *Writer = ?b.writers.data[i];
        if (w.record != nil) {
            made = w.record(w.context, b, o);
            if (sel made.err) { brk; }
        }
        i = i + 1;
    }
    b.finished = false;
    ret made;
}

# the facts of the set's own its typed stream states on `o`, from what the object's instructions defined, under the
# object's context
fun record_stream(b: *Builder, o: *mink_object.Object) err[fail.Fail] {
    val h: *stream.Hooks = b.set.codec.stream;
    if (h == nil || h.record == nil) { ret err[fail.Fail].ok{}; }
    ret h.record(b.object.stream, b.object, o);
}

# the object made of the layout as it stands
fun produce(b: *Builder) res[mink_object.Object, Refusal] {
    val encoded: err[Refusal] = encode_all(b);
    if (sel encoded.err) { ret res[mink_object.Object, Refusal].err{encoded.err}; }
    val settled_: err[Refusal] = checked_labels(b);
    if (sel settled_.err) { ret res[mink_object.Object, Refusal].err{settled_.err}; }
    val numbered: err[Refusal] = number_stems(b);
    if (sel numbered.err) { ret res[mink_object.Object, Refusal].err{numbered.err}; }
    val raised: err[Refusal] = raise_all(b);
    if (sel raised.err) { ret res[mink_object.Object, Refusal].err{raised.err}; }
    var o:      mink_object.Object = mink_object.make(b.a, b.arch, ?catalog_kind.RELOCATABLE);
    val traits: err[Refusal]       = state_traits(b, ?o);
    if (sel traits.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{traits.err};
    }
    val built: err[fail.Fail] = build_object(b, ?o);
    if (sel built.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{failed(built.err)};
    }
    val told: err[fail.Fail] = record_told(b, ?o);
    if (sel told.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{failed(told.err)};
    }
    val mapped: err[Refusal] = map_sections(b, ?o);
    if (sel mapped.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{mapped.err};
    }
    val streamed: err[fail.Fail] = record_stream(b, ?o);
    if (sel streamed.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{failed(streamed.err)};
    }
    val marked: err[Refusal] = record_cts(b, ?o);
    if (sel marked.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{marked.err};
    }
    val framed_: err[Refusal] = record_frames(b, ?o);
    if (sel framed_.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{framed_.err};
    }
    val recorded: err[Refusal] = record_all(b, ?o);
    if (sel recorded.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, Refusal].err{recorded.err};
    }
    ret res[mink_object.Object, Refusal].ok{o};
}

# the builder laid out to a fixed point and encoded, handed over as mink's neutral object, which the caller releases.
# once the layout is settled every writer runs, in the order added, and what they added is laid out with the rest, and
# once the object is made every writer states its records on it. a finish is all or none: a refused one takes back
# everything the writers added, releases the object with its records and leaves the builder as it was, to be emitted
# into and finished again, when the layout is made anew and every writer runs again from a clean state
pub fun finish(b: *Builder) res[mink_object.Object, Refusal] {
    if (b.finished) { ret res[mink_object.Object, Refusal].err{refuse(FINISHED)}; }
    val named: err[Refusal] = check_abi(b);
    if (sel named.err) { ret res[mink_object.Object, Refusal].err{named.err}; }
    val laid: err[Refusal] = layout(b);
    if (sel laid.err) { ret res[mink_object.Object, Refusal].err{laid.err}; }
    var before: Snapshot = snapshot(b);
    if (b.writers.len > 0) {
        # writers write what no source statement scopes, under the object's selection
        val scoped: *core_state.Context = b.view;
        b.taken = opt[Snapshot].some{before};
        b.view  = b.object;
        val wrote: err[Refusal] = write_all(b);
        b.taken = opt[Snapshot].none{};
        b.view  = scoped;
        if (sel wrote.err) {
            restore(b, ?before);
            ret res[mink_object.Object, Refusal].err{wrote.err};
        }
        val again: err[Refusal] = layout(b);
        if (sel again.err) {
            restore(b, ?before);
            ret res[mink_object.Object, Refusal].err{again.err};
        }
    }
    val made: res[mink_object.Object, Refusal] = produce(b);
    if (sel made.err) {
        restore(b, ?before);
        ret made;
    }
    b.finished = true;
    ret made;
}

# how many encoded instructions the finished object has
pub fun line_count(b: *Builder) usize {
    ret b.entries.len;
}

# encoded instruction `i` of the finished object, in section order and then offset order
pub fun line(b: *Builder, i: usize) Line {
    val e:       *Entry    = ?b.entries.data[i];
    val ins:     inst.Inst = inst.Inst{row: coded(?e.of), values: ?b.listed.data[e.values], count: e.count, form: e.form};
    var encoded: Encoded   = Encoded.instruction{ins};
    if (sel e.of.format) { encoded = Encoded.format{Formatted{format: e.of.format, inst: ins}}; }
    ret Line{section: Section{index: e.section}, offset: e.offset, length: e.length, encoded: encoded, run: e.run};
}

# the alignments the linker realigns in the last layout, in section order and then offset order, where their padding is
# not what the alignment asked for. the rows are the builder's and are valid until it is next laid out or released
pub fun realigned_all(b: *Builder) Realignments {
    ret Realignments{at: b.realigns.data, len: b.realigns.len};
}

# where `l` lies once the layout is settled, in the finished object or after `layout`, none for a label never defined
pub fun place_of(b: *Builder, l: Label) opt[mink_object.Place] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none) { ret opt[mink_object.Place].none{}; }
    val at: *Mark = m.some;
    if (!at.defined) { ret opt[mink_object.Place].none{}; }
    val area: *Area = ?b.areas.data[at.section::usize];
    ret opt[mink_object.Place].some{mink_object.Place{section: table.Id[mink_object.Section]{index: at.section}, offset: offset_at(area, at.fragment)}};
}

# the symbol of the finished object `l` became, none for a local label no relocation names
pub fun symbol_of(b: *Builder, l: Label) opt[table.Id[mink_object.Symbol]] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none) { ret opt[table.Id[mink_object.Symbol]].none{}; }
    ret m.some.symbol;
}

# the name `l` was made with, none for an anonymous label or one of another builder
pub fun label_name(b: *Builder, l: Label) opt[View] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none)           { ret opt[View].none{}; }
    if (sel m.some.name.none) { ret opt[View].none{}; }
    ret opt[View].some{intern.bytes_of(?b.names, m.some.name.some)};
}

# what a section was opened as, its name aside the rest of its spec
# ---
# name:        its name, none for a nameless section
# kind:        the role it plays
# flags:       the flags it carries
# disposition: how garbage collection treats it
# entsize:     the size of each of its entries, 0 for none
pub rec Opened {
    name:        opt[View];
    kind:        *mink_section.Kind;
    flags:       mink_section.Flags;
    disposition: *mink_section.Disposition;
    entsize:     u64;
}

# how many sections the builder has opened
pub fun section_count(b: *Builder) usize {
    ret b.areas.len;
}

# what section `s` was opened as, which `section_count` bounds
pub fun opened(b: *Builder, s: Section) Opened {
    val area: *Area     = ?b.areas.data[s.index::usize];
    var name: opt[View] = opt[View].none{};
    if (sel area.name.some) { name = opt[View].some{intern.bytes_of(?b.names, area.name.some)}; }
    ret Opened{name: name, kind: area.kind, flags: area.flags, disposition: area.disposition, entsize: area.entsize};
}

# an instruction of the statement record, as it was written
# ---
# inst:   its row, in the form it was written in, and its values as given, symbols as symbols
# marker: the marker fixup kind riding beside it, operand.NO_FIXUP for none
# run:    how many instructions its sequence holds from it, 1 for one written alone and 0 past a sequence's first
pub rec Written {
    inst:   inst.Inst;
    marker: operand.FixupKind;
    run:    u32;
}

# a difference of labels as data
# ---
# of:    the difference
# width: its width in bytes
pub rec Measure {
    of:    Difference;
    width: u8;
}

# what a statement of the record is
# ---
# code:       an instruction
# data:       these bytes
# zero:       this many zero bytes
# align:      an alignment
# datum:      a symbol's address or distance as data
# difference: a difference of labels as data
pub tag Stated: u8 {
    code:       Written;
    format:     Formatted;
    data:       View;
    zero:       u64;
    align:      Align;
    datum:      Reference;
    difference: Measure;
}

# a statement of a section as the caller wrote it, which is what the builder encodes from
# ---
# stated: what it is
# view:   the context it was written under, which admits, encodes, relaxes and fills it, its selection and state
# syntax: the index of the set's syntax it was written in
# modes:  the assembler modes it was written under, valid until the builder is next written or released
# offset: where the last layout placed it
pub rec Statement {
    stated: Stated;
    view:   *core_state.Context;
    syntax: u32;
    modes:  *mode.State;
    offset: u64;
}

# how many statements section `s` holds, 0 for a section of another builder
pub fun statement_count(b: *Builder, s: Section) usize {
    if (s.index::usize >= b.areas.len) { ret 0; }
    ret b.areas.data[s.index::usize].fragments.len;
}

# statement `j` of section `s`, which `statement_count` bounds. an instruction's values are copied into `values`, which
# holds row.MAX_OPERANDS, and its lists and literals point into the builder, valid until it is next written or released
pub fun statement(b: *Builder, s: Section, j: usize, values: *operand.Value) Statement {
    val f:      *Fragment = ?b.areas.data[s.index::usize].fragments.data[j];
    var stated: Stated    = Stated.zero{0};
    if (sel f.body.code) {
        val c: *Code = ?f.body.code;
        recall(b, c, values);
        val ins: inst.Inst = inst.Inst{row: coded(?c.of), values: values, count: c.count, form: c.form};
        if (sel c.of.format) { stated = Stated.format{Formatted{format: c.of.format, inst: ins}}; }
        or                   { stated = Stated.code{Written{inst: ins, marker: c.marker, run: c.run}}; }
    }
    or (sel f.body.data)       { stated = Stated.data{View{data: ?b.data.data[f.body.data.start], len: f.body.data.len}}; }
    or (sel f.body.zero)       { stated = Stated.zero{f.body.zero}; }
    or (sel f.body.align)      { stated = Stated.align{f.body.align}; }
    or (sel f.body.datum)      { stated = Stated.datum{f.body.datum.ref}; }
    or (sel f.body.difference) { stated = Stated.difference{Measure{of: f.body.difference.of, width: f.body.difference.width}}; }
    ret Statement{stated: stated, view: f.view, syntax: f.syntax, modes: modes_at(b, f), offset: f.offset};
}

# where a label is placed in the statement record
# ---
# section:   its section
# statement: the statement it precedes, the section's statement count for its end
pub rec Spot {
    section:   Section;
    statement: u32;
}

# where `l` is placed in the statement record, none for a label not placed or of another builder
pub fun spot_of(b: *Builder, l: Label) opt[Spot] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none)      { ret opt[Spot].none{}; }
    if (!m.some.defined) { ret opt[Spot].none{}; }
    ret opt[Spot].some{Spot{section: Section{index: m.some.section}, statement: m.some.fragment}};
}

# what makes `l` a symbol of the object, none for a local label or one of another builder
pub fun exposure_of(b: *Builder, l: Label) opt[Exposure] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none) { ret opt[Exposure].none{}; }
    ret m.some.exposure;
}

# what `l` is given in place of a place, none for a label placed, never given a value, or of another builder
pub fun value_of(b: *Builder, l: Label) opt[Value] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none) { ret opt[Value].none{}; }
    ret m.some.value;
}

# the spelling of a label with no name of its own that the object names: a stem and a number following it
pub rec Stem {
    stem:   str;
    number: u32;
}

# the stem and number the object spells `l` by, once finished: the stem it was made with, or the anonymous stem of the
# set's established syntax for a label made anonymous. none for a named label or one of another builder
pub fun stem_of(b: *Builder, l: Label) opt[Stem] {
    val m: opt[*Mark] = mark_of(b, l);
    if (sel m.none) { ret opt[Stem].none{}; }
    val stem: str = stem_for(b, m.some);
    if (stem == nil) { ret opt[Stem].none{}; }
    ret opt[Stem].some{Stem{stem: stem, number: m.some.number}};
}

# how many source files the object names
pub fun source_count(b: *Builder) usize {
    ret b.sources.len;
}

# the name of source file `i`, in the order stated, which `source_count` bounds
pub fun source_at(b: *Builder, i: usize) View {
    ret intern.bytes_of(?b.names, b.sources.data[i]);
}

# whether a writer states records on the object, facts that are no statement of a section, but the writer whose context
# is `besides`, nil for none, whose records the caller states itself
pub fun records(b: *Builder, besides: ptr) bool {
    var i: usize = 0;
    for (i < b.writers.len) {
        if (b.writers.data[i].record != nil && b.writers.data[i].context != besides) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the object was handed over, so the statement record and the layout are final
pub fun handed_over(b: *Builder) bool {
    ret b.finished;
}

# the row and values line `i` was encoded from, whatever it was written as
#[testing]
fun t_inst(b: *Builder, i: usize) inst.Inst {
    val ln: Line = line(b, i);
    if (sel ln.encoded.format) { ret ln.encoded.format.inst; }
    ret ln.encoded.instruction;
}

# a test's selection, its register view, its context and a builder of a risc-v object over them
#[testing]
rec T {
    t:   testing.Testing;
    s:   extension.Selection;
    v:   register.Available;
    ctx: core_state.Context;
    b:   Builder;
    x:   set.Set;

    formats: registry.Registry;
}

# the test's context of the selection `isa` spells for riscv64, with its view
#[testing]
fun t_open(t: *T, isa: str) bool {
    testing.make(?t.t);
    val a:       *A.Allocator                      = testing.allocator_of(?t.t);
    val formats: res[registry.Registry, fail.Fail] = registry.builtin(a);
    if (sel formats.err) { ret false; }
    t.formats = formats.ok;
    val made: res[extension.Selection, extension.Error] = extension.select(a, ?riscv_extension.CATALOG, isa, diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    val row: opt[*set.Arch] = set.arch_of(?riscv_set.SET, ?arch_riscv.RISCV64);
    if (sel row.none) { ret false; }
    val opened: res[core_state.Context, core_state.Opened] = set.open(a, ?riscv_set.SET, row.some, ?t.s, ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx = opened.ok;
    ret true;
}

#[testing]
fun t_make(t: *T, isa: str) bool {
    if (!t_open(t, isa)) { ret false; }
    val a:     *A.Allocator          = testing.allocator_of(?t.t);
    val built: res[Builder, Refusal] = make(a, ?t.formats, ?riscv_set.SET, ?t.ctx, ?arch_riscv.RISCV64, ?mink_format.ELF);
    if (sel built.err) { ret false; }
    t.b = built.ok;
    val named: err[Refusal] = traits(?t.b, ?arch_riscv.RISCV_LP64D);
    if (sel named.err) { ret false; }
    ret true;
}

# the builder of `t` relaxed, so the relocations llvm-mc marks under +relax carry their marker and the linker may resize
# the instructions they ride on
#[testing]
fun t_relax(t: *T) bool {
    val set: err[Refusal] = set_mode(?t.b, mode.Setting{mode: ?riscv_mode.RELAXING, value: ?riscv_mode.RELAX});
    ret sel set.ok;
}

# an x86-shaped set for the tests below, over the risc-v catalog and file: `jmpm` is jmp through a rip-relative address,
# ff 25 disp32, and `jmp8m` and `jmp32m` take a short or near relative target and a rip-relative address, the short
# form relaxing to the near one with the address carried over. every distance is measured from the instruction's end
