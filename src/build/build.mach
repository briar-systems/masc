    operand.Operand{shape: operand.Shape.relative{operand.Relative{offset: operand.Immediate{bits: 8, sign: operand.SIGNED, scale: 0, bias: 0, fixup: 1, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, anchor: operand.END}}, role: operand.NONE, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.memory{operand.Memory{base: operand.Register{classes: operand.Classes{at: nil, len: 0}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}, index: operand.Register{classes: operand.Classes{at: nil, len: 0}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}, segment: operand.Register{classes: operand.Classes{at: nil, len: 0}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}, scales: 0, disp: operand.Immediate{bits: 32, sign: operand.SIGNED, scale: 0, bias: 0, fixup: 1, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, forms: operand.PCREL, anchor: operand.END}}, role: operand.READ, width: 64, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.relative{operand.Relative{offset: operand.Immediate{bits: 32, sign: operand.SIGNED, scale: 0, bias: 0, fixup: 1, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, anchor: operand.END}}, role: operand.NONE, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.memory{operand.Memory{base: operand.Register{classes: operand.Classes{at: nil, len: 0}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}, index: operand.Register{classes: operand.Classes{at: nil, len: 0}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}, segment: operand.Register{classes: operand.Classes{at: nil, len: 0}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}, scales: 0, disp: operand.Immediate{bits: 32, sign: operand.SIGNED, scale: 0, bias: 0, fixup: 1, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, forms: operand.PCREL, anchor: operand.END}}, role: operand.READ, width: 64, quantity: operand.ONE},
};

