#[testing]
val T_X86_ROWS: [3]row.Row = [3]row.Row{
    row.Row{key: "jmpm", mnemonic: "jmpm", operands: row.Operands{at: ?T_X86_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?T_X86_FIELDS[0], len: 2}, requires: requirement.NO_ALTERNATIVES, effect: ?T_X86_EFFECT, ct: ?ct.INDEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0, index: 0},
    row.Row{key: "jmp8m", mnemonic: "jmp8m", operands: row.Operands{at: ?T_X86_OPERANDS[1], len: 2}, encoding: field.Fields{at: ?T_X86_FIELDS[2], len: 4}, requires: requirement.NO_ALTERNATIVES, effect: ?T_X86_EFFECT, ct: ?ct.INDEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0, index: 1},
    row.Row{key: "jmp32m", mnemonic: "jmp32m", operands: row.Operands{at: ?T_X86_OPERANDS[3], len: 2}, encoding: field.Fields{at: ?T_X86_FIELDS[6], len: 4}, requires: requirement.NO_ALTERNATIVES, effect: ?T_X86_EFFECT, ct: ?ct.INDEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0, index: 2},
