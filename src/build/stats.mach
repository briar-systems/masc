# what a builder measures of its work when the caller asks
#
# a caller owns a `Stats`, zeroed, and hands it to `measure`. the builder then reads the monotonic clock around each stage
# and adds the time to that stage's field, and sets the counts its stages produced. a builder never handed one reads no
# clock and counts nothing. a stage's timer is one field here and one `begin` and `lap` pair around the stage

use std.chrono.time;
use std.types.option.opt;

# the measures of a builder
# ---
# layout:       nanoseconds spent laying out, summed over every layout the builder made, a finish making two when writers add.
#               it holds the encoding too, as the pass that settles writes every section's bytes and relocations
# encode:       nanoseconds spent making the object from the encoding the layout kept, summed over every finish
# instructions: how many machine instructions the last encoding wrote, as `line_count` counts them
pub rec Stats {
    layout:       u64;
    encode:       u64;
    instructions: u64;
}

# the clock read to start timing a stage, none when no stats are asked for or the clock refused
pub fun begin(s: *Stats) opt[time.Instant] {
    if (s == nil) { ret opt[time.Instant].none{}; }
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret opt[time.Instant].none{}; }
    ret opt[time.Instant].some{now.ok};
}

# adds the time since `from` to the stage field `into`, as nothing when the stage was not started
pub fun lap(from: opt[time.Instant], into: *u64) {
    if (sel from.none) { ret; }
    val gone: time.Elapsed = time.elapsed(from.some);
    if (sel gone.err) { ret; }
    if (sel gone.ok) {
        if (gone.ok >= 0) { @into = @into + gone.ok::u64; }
    }
}
