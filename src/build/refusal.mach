# why the builder refused a call: the typed refusal and the wording of every defect it names

use masc.core.field;
use masc.core.mode;
use masc.core.operand;
use core_state: masc.core.state;
use mink.base.fail;
use mink_trait: mink.catalog.trait;
use A:          std.allocator;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

pub val ARCH: str = "the set does not serve this architecture";

pub val SELECTION: str = "the context is not of the set's extension catalog and state axes";

pub val MODE: str = "the context does not enter the architecture";

pub val NO_SECTION: str = "no section is current";

pub val NO_SUCH: str = "section or label of another builder";

pub val NO_BYTES: str = "bytes in a section that holds none";

pub val NOT_A_LABEL: str = "operand names no label of this builder";

pub val NESTED: str = "list member that is itself a list";

pub val TOO_MANY: str = "more instructions than an expansion holds";

pub val SPLIT: str = "symbol whose relocation covers instructions past the sequence it is emitted in";

pub val MARKED: str = "instruction given a marker other than the one its relocation's span states";

pub val REDEFINED: str = "label defined twice";

pub val BOUNDARY: str = "alignment is not a power of two";

pub val NO_FILL: str = "no fill pattern the selection admits fills the gap";

pub val RELAXED_ALIGN: str = "code alignment after an instruction the linker may resize, which the set has no marker to realign";

pub val REALIGN_FORM: str = "code alignment the linker realigns takes no limit";

pub val NO_DATUM: str = "the set relocates no datum of this basis and width";

pub val NO_DATUM_KIND: str = "no specifier of the set's states this relocation kind on a datum of this basis and width under the object's format";

pub val DATUM_RANGE: str = "datum value out of range of its width";

pub val UNRESOLVED: str = "fixup names a label neither defined nor exposed";

pub val UNBOUND: str = "fixup kind has no relocation kind";

pub val LOCAL_ONLY: str = "fixup kind no format relocates, whose target is no label of the section the assembler measures";

pub val NO_RELOCATION: str = "relocation kind the object's format does not map for the architecture";

pub val CHAIN: str = "relaxation grows a step of a longer form";

pub val EXPAND: str = "longer form refused";

pub val SHRANK: str = "instruction encodes shorter than the layout reserved";

pub val UNSETTLED: str = "layout did not settle within its bound of passes";

pub val MISSING_TRAIT: str = "trait axis the object's format requires that no owner states, as a convention the caller's abi row leaves unstated";

pub val TRAIT_VALUE: str = "trait stated with a value its axis does not have";

pub val NO_ABI: str = "object of an architecture with abi rows, built under none";

pub val OTHER_ABI: str = "abi row of another architecture than the object's";

pub val NO_TRAITS: str = "object format that encodes no traits for the architecture";

pub val NO_NAMING: str = "object format that names no sections";

pub val DISAGREES: str = "trait stated with another value than its owner states on the object";

pub val TRAIT_SECTION: str = "section the object's format holds its traits in, opened apart";

pub val RAISED: str = "statement other than data in a section the object's format holds its traits in";

pub val RAISE: str = "section the object's format holds its traits in, whose bytes state no traits it maps";

pub val ACROSS: str = "difference of labels not both placed in one section";

pub val UNSITED: str = "difference of labels in two sections whose subtracted label lies outside the datum's section, or with code the linker may resize between it and the datum and no pair of the set's for it";

pub val NO_PAIR: str = "the set relocates no difference of this encoding and width across code the linker may resize";

pub val LOCAL_COMMON: str = "common storage given to a label no other object can see";

pub val UNPLACED: str = "label equated to a label that is never placed";

pub val LOCAL_FALLBACK: str = "fallback given to a label no other object can see";

pub val FALLEN: str = "fallback to a label that is neither placed nor a symbol other objects see";

pub val CYCLE: str = "labels equated to each other in a cycle";

pub val WIDTH: str = "integer width outside 1 to 8 bytes, or a width given a leb128";

pub val NEGATIVE: str = "symbol size measured from a label after its end";

pub val FINISHED: str = "builder already finished";

pub val OBJECT: str = "object refused";

pub val NO_INSTRUCTION: str = "place attached to the next instruction, and no instruction follows in its section";

pub val SEALED: str = "writer changed a section or label that existed when the layout was settled";

pub val NAMELESS: str = "source file has no name";

pub val OTHER_MODE: str = "assembler mode of another set, or a value it does not take";

pub val NO_STEM: str = "label stem empty or longer than a stem holds";

pub val WIDENED: str = "context of another register file, catalog, axes or stream, or at another value of an axis the object does not switch";

pub val NO_AXIS: str = "trait of an axis the architecture does not have";

pub val OWNED: str = "trait the set derives from the views the object is written under, which the source does not state";

pub val UNWRITTEN: str = "trait the set leaves unstated on every object, as its reference does, which the source does not state";

pub val NO_SYNTAX: str = "no syntax of the set at this index";

pub val ABI_LATE: str = "abi row named twice, or after the source stated a trait";

pub val CT_OPEN: str = "constant-time range begun inside another, or ended where none is begun";

pub val CT_SPLIT: str = "constant-time range that ends in another section than it begins, or is never ended";

pub val FRAME_OPEN: str = "frame begun inside another, or a rule or end where none is begun";

pub val FRAME_SPLIT: str = "frame that ends in another section than it begins, or is never ended";

pub val FRAME_SYMBOL: str = "frame whose function, personality or language data is an exposed label with no symbol of the object";

pub val NO_FRAME: str = "frame of an architecture the set states no starting frame for";

pub val NOT_REMEMBERED: str = "frame state restored where none is remembered";

pub val CFA_SCALES: str = "canonical frame address register or offset changed alone while its offset scales";

pub val STARTED: str = "starting section named twice, or opened apart";

pub val NOT_THREAD: str = "symbol a thread-local relocation names, stated as a type other than thread-local";

pub val STREAMED: str = "object context already in a stream";

pub val REGROUPED: str = "section put in a group twice";

pub val SIGNATURE: str = "section group with an empty signature";

pub val RULED: str = "comdat group whose sections keep a copy by two rules";

pub val REORDERED: str = "section given a link order twice";

pub val ORDER: str = "section ordered after itself or after one the object holds no section for";

pub val RELOCATED_PAST: str = "relocation stated past its section's end, or at a label of another section";

pub val STATED_TWICE: str = "trait an instruction states that an earlier instruction stated";

pub val STATED_VALUE: str = "operand an instruction states a trait or fact by that holds no value it maps";

# an architecture the object's context does not enter
# ---
# arch:  the architecture asked for
# unmet: what of the requirement it enters the context lacks
pub rec Mismatch {
    arch:  str;
    unmet: core_state.Unmet;
}

# why the builder refused, leaving itself as it was
# ---
# message: what was refused, one of the wordings above, field.MEMORY or the cited reason of a convention the object's
#          context is not admitted by
# label:   the label it is about, operand.NO_SYMBOL for none
# encode:  the encoder's refusal, when an encode was refused
# object:  mink's failure, when the object refused
# mode:    the architecture and what of its entry the object's context lacks, when it does not enter it
# axis:    the trait axis, when a trait was refused or no one states one
# view:    the context the object's code was written under that a convention does not admit, nil when it is the
#          object's own or the refusal is of something else
pub rec Refusal {
    message: str;
    label:   u32;
    encode:  opt[field.Refusal];
    object:  opt[fail.Fail];
    mode:    opt[Mismatch];
    axis:    opt[*mink_trait.Axis];
    view:    *core_state.Context;
}

pub fun refuse(message: str) Refusal {
    ret Refusal{message: message, label: operand.NO_SYMBOL};
}

pub fun refused(message: str) err[Refusal] {
    ret err[Refusal].err{refuse(message)};
}

pub fun about(message: str, label: u32) err[Refusal] {
    ret err[Refusal].err{Refusal{message: message, label: label}};
}

pub fun memory() Refusal {
    ret refuse(field.MEMORY);
}

pub fun encoding(r: field.Refusal) Refusal {
    ret Refusal{message: r.message, label: operand.NO_SYMBOL, encode: opt[field.Refusal].some{r}};
}

pub fun failed(f: fail.Fail) Refusal {
    ret Refusal{message: OBJECT, label: operand.NO_SYMBOL, object: opt[fail.Fail].some{f}};
}

pub fun held(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

pub fun about_axis(message: str, x: *mink_trait.Axis) err[Refusal] {
    ret err[Refusal].err{Refusal{message: message, label: operand.NO_SYMBOL, axis: opt[*mink_trait.Axis].some{x}}};
}
