# inline assembly for mach: parsing and effects at sema time, encoding after register allocation
#
# a consumer hands masc the text of an inline block and its operands, each
# by name, what it may be placed in and how the block uses it. `parse` reads
# the text under the context the enclosing function runs under into a block,
# or refuses it with diagnostics at their spans in the text. `effects` answers
# the footprint of the whole block, which the allocator reads as it reads an
# instruction's, and `encode` writes the block through the builder once every
# operand has its location. the types land before the implementation, so
# consumers build against their shape.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;

use masc.build.build;
use masc.core.diagnostic;
use masc.core.effect;
use masc.core.footprint;
use masc.core.operand;
use masc.core.set;
use masc.core.state;

# a parsed block: its text and what masc reads it as, which only masc reads
# ---
# text:   the block's text as the consumer wrote it, its text form
# set:    the instruction set it is read in
# parsed: masc's reading of it
pub rec Block {
    text:   View;
    set:    *set.Set;
    parsed: ptr;
}

# what an immediate operand may hold
# ---
# bits:     how many bits its value has
# signed:   whether it is read as signed
# symbolic: whether a symbol plus an addend may stand for it
pub rec Immediate {
    bits:     u8;
    signed:   bool;
    symbolic: bool;
}

# what an operand of a block may be placed in
# ---
# class:     a register of this class of the set's register file, by its handle
# memory:    memory the block addresses
# immediate: a constant of this kind
pub tag Constraint: u8 {
    class: u16;
    memory;
    immediate: Immediate;
}

# an operand of a block
# ---
# name:       how the text names it
# constraint: what it may be placed in
# role:       how the block uses it, as an instruction's operand role states it
pub rec Operand {
    name:       str;
    constraint: Constraint;
    role:       operand.Role;
}

# operands as a pointer to the consumer's rows and a count
pub rec Operands {
    at:  *Operand;
    len: u32;
}

# diagnostics as a pointer to rows and a count, each at its span in the block's text
pub rec Diagnostics {
    at:  *diagnostic.Diagnostic;
    len: u32;
}

# where an operand lies once allocated, as the set's operand values state it: a register, memory, a constant or a symbol
pub def Location: operand.Value;

# locations as a pointer to rows and a count, one per operand in the order the block was parsed with
pub rec Locations {
    at:  *Location;
    len: u32;
}

# the block `text` read in set `s` under the context the enclosing function runs under, its operands `operands`
pub def Parse: fun(*A.Allocator, View, *set.Set, *state.Context, Operands) res[Block, Diagnostics];

# the footprint of the whole block, filled into the footprint given, undecided with the reason when it is not decided
pub def Effects: fun(*Block, *footprint.Footprint) res[effect.Answer[*footprint.Footprint], A.Error];

# the block written through the builder at its cursor with its operands at `locations`
pub def Encode: fun(*Block, Locations, *build.Builder) err[build.Refusal];
