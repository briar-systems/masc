# the masc command line
#
# `masc <command> [options]`, read by std.args against each command's flag
# rows. the commands are one table of rows, each its help page, the most
# operands it takes and what it runs, so a command is one row, and each lives
# in its own module under masc.cli.cmds. the flags of the registered sets'
# assembler modes are rows made from the sets' mode rows, so a set's mode flag
# is never an edit here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.heap;
use std.args;
use fs: std.filesystem;
use std.io.writer;

use masc.cli.context;
use masc.cli.context.Run;
use masc.core.mode;
use masc.core.set;
use masc.isa.isa;
use masc.tool.help;
use masc.tool.render;
use masc.tool.text;

use masc.cli.cmds.assemble;
use masc.cli.cmds.disassemble;
use masc.cli.cmds.targets;

val PROGRAM: str = "masc";
val TITLE:   str = "masc - the assembler of the mach toolchain";

val GLOBAL_FLAGS: [1]*args.Flag = [1]*args.Flag{?context.F_HELP};

val HELP_PAGE: help.Page = help.Page{
    name:    "help",
    summary: "show command help",
    usage:   "help [command]",
    effect:  "show the overview, or the page of a command",
    flags:   ?GLOBAL_FLAGS[0],
    count:   1,
};

# one command
# ---
# page:     its help, which holds its name and flag rows
# operands: how many operands it takes at most
# least:    how many it takes at least
# modes:    whether it takes the mode flags of the registered sets
# run:      what it runs once its line is read
rec Command {
    page:     *help.Page;
    operands: usize;
    least:    usize;
    modes:    bool;
    run:      fun(*Run) render.Exit;
}

val COMMAND_COUNT: usize                  = 4;
val COMMANDS:      [COMMAND_COUNT]Command = [COMMAND_COUNT]Command{
    Command{page: ?assemble.PAGE, operands: 1, least: 1, modes: true, run: assemble.run},
    Command{page: ?disassemble.PAGE, operands: 1, least: 1, modes: false, run: disassemble.run},
    Command{page: ?targets.PAGE, operands: 0, least: 0, modes: false, run: targets.run},
    Command{page: ?HELP_PAGE, operands: 1, least: 0, modes: false, run: topic},
};

# the row of the help command, which a bare flag in place of a command word runs
val HELP_COMMAND: usize = 3;

# every page, in command order, for the overview
val PAGES: [COMMAND_COUNT]*help.Page = [COMMAND_COUNT]*help.Page{?assemble.PAGE, ?disassemble.PAGE, ?targets.PAGE, ?HELP_PAGE};

fun command_named(name: str) *Command {
    var i: usize = 0;
    for (i < COMMAND_COUNT) {
        if (str_equals(COMMANDS[i].page.name, name)) { ret ?COMMANDS[i]; }
        i = i + 1;
    }

    ret nil;
}

fun overview(t: *text.Text) {
    help.overview(t, TITLE, PROGRAM, ?PAGES[0], COMMAND_COUNT, ?GLOBAL_FLAGS[0], 1);
}

fun refuse_flag(r: *Run, why: args.Error) render.Exit {
    if (sel why.unknown)       { ret context.refuse(r, "cli.flag_unknown", "unknown flag", why.unknown.flag); }
    if (sel why.missing_value) { ret context.refuse(r, "cli.flag_missing_value", "flag takes a value", why.missing_value.flag); }
    if (sel why.repeated)      { ret context.refuse(r, "cli.flag_repeated", "flag given twice", why.repeated.flag); }

    ret render.INTERNAL;
}

# whether `name` is the spelling of one of the first `count` rows of `rows`
fun spelled(rows: *args.Flag, count: usize, name: str) bool {
    var i: usize = 0;
    for (i < count) {
        if (str_equals(rows[i].name, name)) { ret true; }
        i = i + 1;
    }

    ret false;
}

# a switch row for every distinct flag of the registered sets' assembler modes, into `rows`, how many, none when they
# are more than the rows hold
fun mode_rows(registry: *set.Registry, rows: *args.Flag) opt[usize] {
    var n: usize = 0;
    var i: u32   = 0;
    for (i < registry.count) {
        val all: *mode.Modes = ?registry.sets[i].assembly;
        var j:   u32         = 0;
        for (j < all.len) {
            val m: *mode.Mode = all.at[j];
            var k: u32        = 0;
            for (k < m.values.len) {
                val v: *mode.Value = m.values.at[k];
                k = k + 1;
                if (v.flag == nil || spelled(rows, n, v.flag)) { cnt; }
                if (n == context.MAX_MODE_FLAGS)               { ret opt[usize].none{}; }

                rows[n] = args.Flag{name: v.flag, short: nil, kind: args.SWITCH, negatable: false, occurs: args.Occurs.once{}, value: "", doc: v.doc};
                n       = n + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    ret opt[usize].some{n};
}

# the page of `c` into `r` with its flag rows, its page's own and, for a command that takes them, the mode flags before
# the last. false when the mode flags are more than the rows hold
fun paged(r: *Run, c: *Command) bool {
    r.moded = 0;
    if (c.modes) {
        val made: opt[usize] = mode_rows(?isa.REGISTRY, ?r.moding[0]);
        if (sel made.none) { ret false; }
        r.moded = made.some;
    }

    var n: usize = 0;
    var i: usize = 0;
    for (i + 1 < c.page.count) {
        r.rows[n] = c.page.flags[i];
        n         = n + 1;
        i         = i + 1;
    }

    var k: usize = 0;
    for (k < r.moded) {
        r.rows[n] = ?r.moding[k];
        n         = n + 1;
        k         = k + 1;
    }

    if (c.page.count > 0) {
        r.rows[n] = c.page.flags[c.page.count - 1];
        n         = n + 1;
    }

    r.page       = @c.page;
    r.page.flags = ?r.rows[0];
    r.page.count = n;
    ret true;
}

fun unpaged(r: *Run) render.Exit {
    render.headline(?r.err, "cli.flags", "the registered sets declare more mode flags than the command line holds");
    ret render.INTERNAL;
}

# the command's flag rows read from argument `start` on, its operands kept. a refusal is rendered, and nil means read
fun read(r: *Run, c: *Command, start: usize) opt[render.Exit] {
    r.count = 0;
    if (!paged(r, c)) { ret opt[render.Exit].some{unpaged(r)}; }

    r.reader = args.reader(r.args, start, r.page.flags, r.page.count, ?r.settings[0]);
    for {
        val e: res[args.Event, args.Error] = args.read(?r.reader);
        if (sel e.err) { ret opt[render.Exit].some{refuse_flag(r, e.err)}; }
        if (sel e.ok) {
            if (sel e.ok.done) { brk; }
            if (sel e.ok.operand) {
                val word: str = r.args.argv[e.ok.operand]::str;
                if (r.count == c.operands) { ret opt[render.Exit].some{context.refuse(r, "cli.operand_extra", "operand not taken", word)}; }

                r.operands[r.count] = word;
                r.count             = r.count + 1;
            }
        }
    }

    ret opt[render.Exit].none{};
}

# the command entry for `help`: the overview, or the page of the command named
fun topic(r: *Run) render.Exit {
    if (r.count == 0) {
        overview(?r.out);
        ret render.SUCCESS;
    }

    val c: *Command = command_named(r.operands[0]);
    if (c == nil)     { ret context.refuse(r, "cli.unknown_command", "unknown command", r.operands[0]); }
    if (!paged(r, c)) { ret unpaged(r); }

    help.page(?r.out, PROGRAM, ?r.page);
    ret render.SUCCESS;
}

# route the command word to its command, its output left in `r.out` and `r.err`
fun route(r: *Run) render.Exit {
    val word: opt[str] = args.get(r.args, 1);
    if (sel word.none) {
        overview(?r.out);
        ret render.SUCCESS;
    }

    # a flag in place of a command word is read as the help command's
    val c: *Command = command_named(word.some);
    if (c == nil && word.some[0] == '-') {
        val refused: opt[render.Exit] = read(r, ?COMMANDS[HELP_COMMAND], 1);
        if (sel refused.some) { ret refused.some; }

        overview(?r.out);
        ret render.SUCCESS;
    }

    if (c == nil) {
        render.quoted(?r.err, "cli.unknown_command", "unknown command", word.some);
        overview(?r.err);
        ret render.USER;
    }

    val refused: opt[render.Exit] = read(r, c, 2);
    if (sel refused.some) { ret refused.some; }

    val help_given: res[bool, args.Misread] = args.on(r.reader, ?context.F_HELP);
    if (sel help_given.err) { ret context.misread(r, help_given.err); }
    if (help_given.ok) {
        help.page(?r.out, PROGRAM, ?r.page);
        ret render.SUCCESS;
    }

    if (r.count < c.least) { ret context.refuse(r, "cli.operand_missing", "the command needs an operand", c.page.name); }

    ret c.run(r);
}

fun emit(f: fs.File, t: *text.Text) bool {
    if (t.out.len == 0) { ret true; }

    var w: writer.Writer          = fs.writer(f);
    val r: err[writer.WriteError] = writer.write_all(?w, t.out.data, t.out.len);
    ret sel r.ok;
}

# the command line `v` run in `a`, its output written to stdout and stderr
fun run(a: *A.Allocator, v: args.Args) render.Exit {
    var r: Run;
    r.a    = a;
    r.args = v;
    r.out  = text.make(a);
    r.err  = text.make(a);

    var exit: render.Exit = route(?r);
    if (r.out.failed || r.err.failed) {
        text.clear(?r.err);
        r.err.failed = false;
        render.headline(?r.err, "cli.memory", "out of memory");
        exit = render.INTERNAL;
    }

    if (!emit(fs.STDOUT, ?r.out) || !emit(fs.STDERR, ?r.err)) { exit = render.ENVIRONMENT; }

    text.release(?r.out);
    text.release(?r.err);
    ret exit;
}

# primary entry point for the masc binary, every allocation in one heap given back whole when the command ends
# ---
# argc: the number of arguments, including the program name
# argv: the arguments, including the program name
# ret:  the command's exit code, one of masc.tool.render's
pub fun dispatch(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;

    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret render.INTERNAL; }

    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret render.INTERNAL; }

    val code: render.Exit = run(?a, args.of(argc::usize, argv));

    val d: err[A.Error] = heap.dnit(?h);
    if (sel d.err) { ret render.INTERNAL; }

    ret code;
}
