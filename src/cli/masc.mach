# the masc command line
#
# `masc <command> [options]`, read by std.args against one root command. the
# commands are one table of rows, each its command, whether it takes the mode
# flags of the registered sets and what it runs, and each lives in its own
# module under masc.cli.cmds, so a command is one row. masc declares its own
# help, version, short flags and exit codes, kept the same as mach, mirl and
# mink by hand. the mode flags are made from the sets' mode rows when the line
# is read and listed after the flags of every command that takes them, so a
# set's mode flag is never an edit here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.heap;
use std.args;
use args_help: std.args.help;
use std.collections.slice.Slice;
use fs: std.filesystem;
use std.io.writer;
use std.io.writer.WriteError;
use std.io.writer.Writer;

use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.file;

use masc.cli.context;
use masc.cli.context.Run;
use masc.core.mode;
use masc.core.set;
use masc.isa.isa;
use masc.tool.render;
use masc.tool.text;

use masc.cli.cmds.assemble;
use masc.cli.cmds.disassemble;
use masc.cli.cmds.inline;
use masc.cli.cmds.listing;
use masc.cli.cmds.targets;
use masc.cli.cmds.walk;

# the flag the root lists asking for masc's version alone on one line
val VERSION: args.Flag = args.Flag{long: "version", short: 0, value: nil, repeat: false, negatable: false, help: "print the version alone on one line"};

val HELP_FLAG_COUNT: usize                       = 1;
val HELP_FLAGS:      [HELP_FLAG_COUNT]*args.Flag = [HELP_FLAG_COUNT]*args.Flag{?context.HELP};

# `masc help [<command>]`, the overview or a command's page
val HELP_COMMAND: args.Command = args.Command{
    name:        "help",
    help:        "show the overview, or the page of the command named",
    usage:       "[<command>]",
    flags:       Slice[*args.Flag]{data: ?HELP_FLAGS[0], size: HELP_FLAG_COUNT},
    operand_min: 0,
    operand_max: 1,
};

val ROOT_FLAG_COUNT: usize                       = 2;
val ROOT_FLAGS:      [ROOT_FLAG_COUNT]*args.Flag = [ROOT_FLAG_COUNT]*args.Flag{?context.HELP, ?VERSION};

# one command
# ---
# command: its record, its own flags and nothing of the mode flags
# modes:   whether it takes the mode flags of the registered sets, listed after its own
# run:     what it runs once its line is read, nil for help, which is answered here
rec Verb {
    command: *args.Command;
    modes:   bool;
    run:     fun(*Run) render.Exit;
}

# masc's commands, in the overview's order
val VERB_COUNT: usize            = 7;
val VERBS:      [VERB_COUNT]Verb = [VERB_COUNT]Verb{
    Verb{command: ?assemble.COMMAND, modes: true, run: assemble.run},
    Verb{command: ?disassemble.COMMAND, modes: false, run: disassemble.run},
    Verb{command: ?listing.COMMAND, modes: true, run: listing.run},
    Verb{command: ?inline.COMMAND, modes: false, run: inline.run},
    Verb{command: ?walk.COMMAND, modes: false, run: walk.run},
    Verb{command: ?targets.COMMAND, modes: false, run: targets.run},
    Verb{command: ?HELP_COMMAND, modes: false, run: nil},
};

# the most flags a command lists, the mode flags included
val MAX_FLAGS: usize = 48;

# the root the line is read against, made from the command table and the registered sets' mode flags
# ---
# moding:   a flag per distinct mode flag of the registered sets, the first `modes.n` of them
# spelled:  each one's spelling as the sets' mode rows state it
# modes:    the mode flags, as a command that takes them reads them
# flags:    for each command that takes them, its own flags and the mode flags after
# joined:   for each command that takes them, its record over its flags in `flags`
# commands: every command of the root, the joined one where it takes the mode flags
# root:     the root
rec Line {
    moding:   [context.MAX_MODE_FLAGS]args.Flag;
    spelled:  [context.MAX_MODE_FLAGS]str;
    modes:    context.Modes;
    flags:    [VERB_COUNT][MAX_FLAGS]*args.Flag;
    joined:   [VERB_COUNT]args.Command;
    commands: [VERB_COUNT]*args.Command;
    root:     args.Command;
}

# whether `name` is one of the first `count` of `names`
fun spelled(names: *str, count: usize, name: str) bool {
    var i: usize = 0;
    for (i < count) {
        if (str_equals(names[i], name)) { ret true; }
        i = i + 1;
    }

    ret false;
}

# a flag for every distinct flag of the registered sets' assembler modes into `l`, false when they are more than it
# holds or one is not spelled `--name`
fun mode_flags(registry: *set.Registry, l: *Line) bool {
    var n: usize = 0;
    var i: u32   = 0;
    for (i < registry.count) {
        val all: *mode.Modes = ?registry.sets[i].assembly;
        var j:   u32         = 0;
        for (j < all.len) {
            val m: *mode.Mode = all.at[j];
            var k: u32        = 0;
            for (k < m.values.len) {
                val v: *mode.Value = m.values.at[k];
                k = k + 1;
                if (v.flag == nil || spelled(?l.spelled[0], n, v.flag)) { cnt; }
                if (n == context.MAX_MODE_FLAGS)                        { ret false; }
                if (v.flag[0] != '-' || v.flag[1] != '-')               { ret false; }

                l.moding[n]  = args.Flag{long: (?v.flag[2])::str, short: 0, value: nil, repeat: false, negatable: false, help: v.doc};
                l.spelled[n] = v.flag;
                n            = n + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    l.modes = context.Modes{flags: ?l.moding[0], spelled: ?l.spelled[0], n: n};
    ret true;
}

# the root of `l` made from the command table, false when the mode flags are more than it holds
fun line_of(l: *Line) bool {
    if (!mode_flags(?isa.REGISTRY, l)) { ret false; }

    var i: usize = 0;
    for (i < VERB_COUNT) {
        val v: *Verb = ?VERBS[i];
        l.commands[i] = v.command;
        if (v.modes && l.modes.n > 0) {
            val own: usize = v.command.flags.size;
            if (own + l.modes.n > MAX_FLAGS) { ret false; }
            var k: usize = 0;
            for (k < own) {
                l.flags[i][k] = v.command.flags.data[k];
                k             = k + 1;
            }
            k = 0;
            for (k < l.modes.n) {
                l.flags[i][own + k] = ?l.moding[k];
                k                   = k + 1;
            }
            l.joined[i]       = @v.command;
            l.joined[i].flags = Slice[*args.Flag]{data: ?l.flags[i][0], size: own + l.modes.n};
            l.commands[i]     = ?l.joined[i];
        }
        i = i + 1;
    }

    l.root = args.Command{
        name:        "masc",
        help:        "masc, the assembler of the mach toolchain. see `masc help <command>` for a command's page",
        usage:       nil,
        flags:       Slice[*args.Flag]{data: ?ROOT_FLAGS[0], size: ROOT_FLAG_COUNT},
        commands:    Slice[*args.Command]{data: ?l.commands[0], size: VERB_COUNT},
        operand_min: 0,
        operand_max: 0,
    };
    ret true;
}

# the row of the command the root's `command` is
fun verb_of(l: *Line, command: *args.Command) *Verb {
    var i: usize = 0;
    for (i < VERB_COUNT) {
        if (l.commands[i] == command) { ret ?VERBS[i]; }
        i = i + 1;
    }

    ret nil;
}

# what the sink `s` holds moved into `t`, the sink given back
fun put(t: *text.Text, s: *Sink) {
    text.bytes(t, sink.data(s), sink.len(s));
    val released: err[Fail] = sink.release(s);
}

# the page of the command `line` matched into `r.out`
fun page(r: *Run, line: *args.Parsed) render.Exit {
    var s: Sink   = sink.make(r.a, LITTLE);
    var w: Writer = sink.writer(?s);

    val h: err[WriteError] = args_help.render(line, ?w, args_help.terminal_width());
    if (sel h.err) {
        val released: err[Fail] = sink.release(?s);
        ret context.failed(r, "cli.help", file.written(h.err, "cannot write the help page"));
    }

    put(?r.out, ?s);
    ret render.SUCCESS;
}

# why std.args refused the line `line`, into `r.err`
fun refused(r: *Run, line: *args.Parsed) render.Exit {
    var s: Sink   = sink.make(r.a, LITTLE);
    var w: Writer = sink.writer(?s);

    render.begin(?r.err, "cli.line");
    val d: err[WriteError] = args.describe(line, ?w);
    if (sel d.err) { r.err.failed = true; }
    put(?r.err, ?s);
    text.byte(?r.err, '\n');
    ret render.USER;
}

# the command entry for `help`: the overview, or the page of the command its operand names, read as that command's
# own line without its operands
fun topic(r: *Run, l: *Line) render.Exit {
    val named: str = context.operand(r, 0);
    if (named == nil) {
        var root: args.Parsed = args.parse(?l.root, args.of(1, r.line.args.argv));
        ret page(r, ?root);
    }

    var words: [3]*u8      = [3]*u8{r.line.args.argv[0], named::*u8, nil};
    var shown: args.Parsed = args.parse(?l.root, args.of(2, ?words[0]));
    if (sel shown.refusal.some) {
        val why: args.Refusal = shown.refusal.some;
        if (sel why.unknown_command) { ret refused(r, ?shown); }
    }

    ret page(r, ?shown);
}

# the line read against the root of `l` and routed to its command, its output left in `r.out` and `r.err`
fun route(r: *Run, l: *Line, v: args.Args) render.Exit {
    if (!line_of(l)) {
        render.headline(?r.err, "cli.flags", "the registered sets declare more mode flags than the command line holds");
        ret render.INTERNAL;
    }

    var line: args.Parsed = args.parse(?l.root, v);
    r.line = ?line;
    # a page asked for is shown whatever operands the line gives
    if (sel line.refusal.some) {
        val why: args.Refusal = line.refusal.some;
        if (!sel why.operands || !args.given(?line, ?context.HELP)) { ret refused(r, ?line); }
    }
    if (args.given(?line, ?context.HELP)) { ret page(r, ?line); }
    if (line.command == ?l.root) {
        if (args.given(?line, ?VERSION)) {
            text.put(?r.out, $project.version);
            text.byte(?r.out, '\n');
            ret render.SUCCESS;
        }
        val shown: render.Exit = page(r, ?line);
        if (shown != render.SUCCESS) { ret shown; }
        ret render.USER;
    }
    if (args.given(?line, ?context.QUIET) && args.given(?line, ?context.VERBOSE)) {
        ret context.refuse(r, "cli.line", "-q and -v ask for opposite things, give one of", "--quiet, --verbose");
    }

    val c: *Verb = verb_of(l, line.command);
    if (c == nil)     { ret render.INTERNAL; }
    if (c.run == nil) { ret topic(r, l); }

    r.modes = nil;
    if (c.modes && l.modes.n > 0) { r.modes = ?l.modes; }
    ret c.run(r);
}

fun emit(f: fs.File, t: *text.Text) bool {
    if (t.out.len == 0) { ret true; }

    var w: writer.Writer          = fs.writer(f);
    val r: err[writer.WriteError] = writer.write_all(?w, t.out.data, t.out.len);
    ret sel r.ok;
}

# the command line `v` run in `a`, its output written to stdout and stderr
fun run(a: *A.Allocator, v: args.Args) render.Exit {
    var l: Line;
    var r: Run;
    r.a   = a;
    r.out = text.make(a);
    r.err = text.make(a);

    var exit: render.Exit = route(?r, ?l, v);
    if (r.out.failed || r.err.failed) {
        text.clear(?r.err);
        r.err.failed = false;
        render.headline(?r.err, "cli.memory", "out of memory");
        exit = render.INTERNAL;
    }

    if (!emit(fs.STDOUT, ?r.out) || !emit(fs.STDERR, ?r.err)) { exit = render.ENVIRONMENT; }

    text.release(?r.out);
    text.release(?r.err);
    ret exit;
}

# primary entry point for the masc binary, every allocation in one heap given back whole when the command ends
# ---
# argc: the number of arguments, including the program name
# argv: the arguments, including the program name
# ret:  the command's exit code, one of masc.tool.render's
pub fun dispatch(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;

    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret render.INTERNAL; }

    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret render.INTERNAL; }

    val code: render.Exit = run(?a, args.of(argc::usize, argv));

    val d: err[A.Error] = heap.dnit(?h);
    if (sel d.err) { ret render.INTERNAL; }

    ret code;
}
