# the masc command line
#
# `masc <command> [options]`, read by std.args against one command set. the
# commands are one table of rows, each its spec, whether it takes the mode
# flags of the registered sets and what it runs, and each lives in its own
# module under masc.cli.cmds, so a command is one row. the line is read and
# its help is rendered from the specs alone, and the program dispatches on the
# spec the line names. the mode flags are a table made from the sets' mode
# rows when the line is read, joined to the tables of every command that takes
# them, so a set's mode flag is never an edit here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.heap;
use std.args;
use args_help: std.args.help;
use fs:        std.filesystem;
use std.io.writer;
use std.io.writer.WriteError;
use std.io.writer.Writer;

use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.file;

use masc.cli.context;
use masc.cli.context.Run;
use masc.core.mode;
use masc.core.set;
use masc.isa.isa;
use masc.tool.render;
use masc.tool.text;

use masc.cli.cmds.assemble;
use masc.cli.cmds.disassemble;
use masc.cli.cmds.inline;
use masc.cli.cmds.listing;
use masc.cli.cmds.targets;
use masc.cli.cmds.walk;

# the flag every command takes, asking for its page
val HELP_FLAG:  args.FlagSpec = args.FlagSpec{name: "--help", value: "", arity: args.ARITY_FLAG, doc: "show a command's page in place of running it", default: "", negatable: false, occurs: args.Occurs.once{}, alias_of: nil};
val HELP_SHORT: args.FlagSpec = args.FlagSpec{name: "-h", value: "", arity: args.ARITY_FLAG, doc: "short for --help", default: "", negatable: false, occurs: args.Occurs.once{}, alias_of: ?HELP_FLAG};

val COMMON_ROWS: [2]*args.FlagSpec = [2]*args.FlagSpec{?HELP_FLAG, ?HELP_SHORT};
val COMMON:      [1]args.TableRef  = [1]args.TableRef{args.TableRef{rows: ?COMMON_ROWS[0], n: 2, accepted: nil, docs: nil}};

# the help command, whose page is the overview and which names a command to show the page of
val HELP: args.CommandSpec = args.CommandSpec{
    name:            "help",
    id:              0,
    aliases:         nil,
    alias_n:         0,
    grammar:         " [command]",
    summary:         "show the overview, or a command's page",
    effect:          "show the overview, or the page of the command named",
    exits:           nil,
    exit_n:          0,
    terminator:      "",
    tables:          nil,
    table_n:         0,
    refused:         nil,
    refused_n:       0,
    refusal:         "",
    relations:       nil,
    relation_n:      0,
    constraints:     nil,
    constraint_n:    0,
    operand_min:     0,
    operand_max:     1,
    truncate_at_sep: false,
    actions:         nil,
    action_n:        0,
    examples:        nil,
    example_n:       0,
};

# `--help` or `-h` in the command word's place asks the help command, so for the overview
val GLOBALS: [1]args.Global = [1]args.Global{args.Global{row: ?HELP_FLAG, command: ?HELP}};

# one command
# ---
# spec:  its registration, its own tables and nothing of the mode flags
# modes: whether it takes the mode flags of the registered sets, joined after its own tables
# run:   what it runs once its line is read
rec Command {
    spec:  *args.CommandSpec;
    modes: bool;
    run:   fun(*Run) render.Exit;
}

# masc's commands, in the overview's order
val COMMAND_COUNT: usize                  = 7;
val COMMANDS:      [COMMAND_COUNT]Command = [COMMAND_COUNT]Command{
    Command{spec: ?assemble.SPEC, modes: true, run: assemble.run},
    Command{spec: ?disassemble.SPEC, modes: false, run: disassemble.run},
    Command{spec: ?listing.SPEC, modes: true, run: listing.run},
    Command{spec: ?inline.SPEC, modes: false, run: inline.run},
    Command{spec: ?walk.SPEC, modes: false, run: walk.run},
    Command{spec: ?targets.SPEC, modes: false, run: targets.run},
    Command{spec: ?HELP, modes: false, run: topic},
};

# the most tables a command composes, the mode flags' included
val MAX_TABLES: usize = 4;

# the command set the line is read against, made from the command table and the registered sets' mode flags
# ---
# moding: a row per distinct mode flag of the registered sets, the first `moded` of them
# moded:  how many
# rows:   the first `moded` rows of moding, as a table lists them
# modes:  the table of them
# tables: for each command that takes them, its own tables and the mode flags' after
# joined: for each command that takes them, its spec over its tables in `tables`
# specs:  every command's spec in the set, the joined one where it takes the mode flags
# set:    the set
rec Line {
    moding: [context.MAX_MODE_FLAGS]args.FlagSpec;
    moded:  usize;
    rows:   [context.MAX_MODE_FLAGS]*args.FlagSpec;
    modes:  args.TableRef;
    tables: [COMMAND_COUNT][MAX_TABLES]args.TableRef;
    joined: [COMMAND_COUNT]args.CommandSpec;
    specs:  [COMMAND_COUNT]*args.CommandSpec;
    set:    args.CommandSet;
}

# whether `name` is the spelling of one of the first `count` rows of `rows`
fun spelled(rows: *args.FlagSpec, count: usize, name: str) bool {
    var i: usize = 0;
    for (i < count) {
        if (str_equals(rows[i].name, name)) { ret true; }
        i = i + 1;
    }

    ret false;
}

# a flag row for every distinct flag of the registered sets' assembler modes into `l`, false when they are more than
# it holds
fun mode_rows(registry: *set.Registry, l: *Line) bool {
    l.moded = 0;
    var i: u32 = 0;
    for (i < registry.count) {
        val all: *mode.Modes = ?registry.sets[i].assembly;
        var j:   u32         = 0;
        for (j < all.len) {
            val m: *mode.Mode = all.at[j];
            var k: u32        = 0;
            for (k < m.values.len) {
                val v: *mode.Value = m.values.at[k];
                k = k + 1;
                if (v.flag == nil || spelled(?l.moding[0], l.moded, v.flag)) { cnt; }
                if (l.moded == context.MAX_MODE_FLAGS)                       { ret false; }

                l.moding[l.moded] = args.FlagSpec{name: v.flag, value: "", arity: args.ARITY_FLAG, doc: v.doc, default: "", negatable: false, occurs: args.Occurs.once{}, alias_of: nil};
                l.rows[l.moded]   = ?l.moding[l.moded];
                l.moded           = l.moded + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    l.modes = args.TableRef{rows: ?l.rows[0], n: l.moded, accepted: nil, docs: nil};
    ret true;
}

# the set of `l` made from the command table, false when the mode flags are more than it holds
fun line_of(l: *Line) bool {
    if (!mode_rows(?isa.REGISTRY, l)) { ret false; }

    var i: usize = 0;
    for (i < COMMAND_COUNT) {
        val c: *Command = ?COMMANDS[i];
        l.specs[i] = c.spec;
        if (c.modes && l.moded > 0) {
            var k: usize = 0;
            for (k < c.spec.table_n) {
                l.tables[i][k] = c.spec.tables[k];
                k              = k + 1;
            }
            l.tables[i][k]      = l.modes;
            l.joined[i]         = @c.spec;
            l.joined[i].tables  = ?l.tables[i][0];
            l.joined[i].table_n = k + 1;
            l.specs[i]          = ?l.joined[i];
        }
        i = i + 1;
    }

    l.set = args.CommandSet{
        program:    "masc",
        title:      "masc - the assembler of the mach toolchain",
        footer:     "see `masc help <command>` for a command's page",
        specs:      ?l.specs[0],
        n:          COMMAND_COUNT,
        help:       ?HELP,
        help_flag:  ?HELP_FLAG,
        common:     ?COMMON[0],
        common_n:   1,
        relations:  nil,
        relation_n: 0,
        removed:    nil,
        removed_n:  0,
        exits:      ?render.EXITS[0],
        exit_n:     render.EXIT_COUNT,
        globals:    ?GLOBALS[0],
        global_n:   1,
    };
    ret true;
}

# the row of the command the set's spec `spec` registers
fun command_of(l: *Line, spec: *args.CommandSpec) *Command {
    var i: usize = 0;
    for (i < COMMAND_COUNT) {
        if (l.specs[i] == spec) { ret ?COMMANDS[i]; }
        i = i + 1;
    }

    ret nil;
}

# what the sink `s` holds moved into `t`, the sink given back
fun put(t: *text.Text, s: *Sink) {
    text.bytes(t, sink.data(s), sink.len(s));
    val released: err[Fail] = sink.release(s);
}

# the page `p` of the set into `r.out`
fun page(r: *Run, set: *args.CommandSet, p: args_help.Page) render.Exit {
    var s: Sink   = sink.make(r.a, LITTLE);
    var w: Writer = sink.writer(?s);

    val h: err[args_help.HelpError] = args_help.render(set, ?w, p, args_help.terminal_width());
    if (sel h.err) {
        val e:        args_help.HelpError = h.err;
        val released: err[Fail]           = sink.release(?s);
        if (sel e.malformed) {
            render.quoted(?r.err, "cli.table", "masc's command table breaks the std.args contract", e.malformed.why);
            ret render.INTERNAL;
        }
        ret context.failed(r, "cli.help", file.written(e.write, "cannot write the help page"));
    }

    put(?r.out, ?s);
    ret render.SUCCESS;
}

# why std.args refused the line, into `r.err`
fun refused(r: *Run) render.Exit {
    var s: Sink   = sink.make(r.a, LITTLE);
    var w: Writer = sink.writer(?s);

    render.begin(?r.err, "cli.line");
    val d: err[WriteError] = args.describe(?r.line, ?w);
    if (sel d.err) { r.err.failed = true; }
    put(?r.err, ?s);
    text.byte(?r.err, '\n');

    if (sel r.line.refusal.some) {
        val why: args.Refusal = r.line.refusal.some;
        if (sel why.malformed) { ret render.INTERNAL; }
    }

    ret render.USER;
}

# the command entry for `help`: the overview, or the page of the command named
fun topic(r: *Run) render.Exit {
    val named: str = context.operand(r, 0);
    if (named == nil) { ret page(r, r.line.set, args_help.Page{command: nil, action: nil}); }

    val c: *args.CommandSpec = args.command_for(r.line.set, named);
    if (c == nil) { ret context.refuse(r, "cli.unknown_command", "unknown command", named); }

    ret page(r, r.line.set, args_help.Page{command: c, action: nil});
}

# the line read against the set of `l` and routed to its command, its output left in `r.out` and `r.err`
fun route(r: *Run, l: *Line, v: args.Args) render.Exit {
    if (!line_of(l)) {
        render.headline(?r.err, "cli.flags", "the registered sets declare more mode flags than the command line holds");
        ret render.INTERNAL;
    }

    r.line = args.parse(?l.set, v, 1);
    if (sel r.line.refusal.some)      { ret refused(r); }
    if (r.line.command == nil)        { ret page(r, ?l.set, args_help.Page{command: nil, action: nil}); }
    if (args.help_requested(?r.line)) { ret page(r, ?l.set, args_help.page_of(?r.line)); }

    val c: *Command = command_of(l, r.line.command);
    if (c == nil) { ret render.INTERNAL; }

    r.modes = nil;
    if (c.modes && l.moded > 0) { r.modes = ?l.modes; }
    ret c.run(r);
}

fun emit(f: fs.File, t: *text.Text) bool {
    if (t.out.len == 0) { ret true; }

    var w: writer.Writer          = fs.writer(f);
    val r: err[writer.WriteError] = writer.write_all(?w, t.out.data, t.out.len);
    ret sel r.ok;
}

# the command line `v` run in `a`, its output written to stdout and stderr
fun run(a: *A.Allocator, v: args.Args) render.Exit {
    var l: Line;
    var r: Run;
    r.a   = a;
    r.out = text.make(a);
    r.err = text.make(a);

    var exit: render.Exit = route(?r, ?l, v);
    if (r.out.failed || r.err.failed) {
        text.clear(?r.err);
        r.err.failed = false;
        render.headline(?r.err, "cli.memory", "out of memory");
        exit = render.INTERNAL;
    }

    if (!emit(fs.STDOUT, ?r.out) || !emit(fs.STDERR, ?r.err)) { exit = render.ENVIRONMENT; }

    text.release(?r.out);
    text.release(?r.err);
    ret exit;
}

# primary entry point for the masc binary, every allocation in one heap given back whole when the command ends
# ---
# argc: the number of arguments, including the program name
# argv: the arguments, including the program name
# ret:  the command's exit code, one of masc.tool.render's
pub fun dispatch(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;

    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret render.INTERNAL; }

    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret render.INTERNAL; }

    val code: render.Exit = run(?a, args.of(argc::usize, argv));

    val d: err[A.Error] = heap.dnit(?h);
    if (sel d.err) { ret render.INTERNAL; }

    ret code;
}
