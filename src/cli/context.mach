# what every command of the masc command line shares: its run context, the
# flag rows several commands take, the target its flags name, and the
# refusals it renders

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.args;
use std.collections.vector;
use fs: std.filesystem;

use mink.base.fail;
use mink.base.table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink_arch:     mink.catalog.arch;
use mink_format:   mink.catalog.format;
use mink_target:   mink.catalog.target;
use mink_registry: mink.format.registry;
use mink_object:   mink.model.object;

use masc.asm.model;
use masc.core.diagnostic;
use masc.core.extension;
use masc.core.register;
use masc.core.set;
use masc.core.state;
use masc.emit.emit;
use masc.format.dialect;
use masc.isa.isa;
use masc.tool.object;
use masc.tool.render;
use masc.tool.target;
use masc.tool.text;

# the flags several commands take, each with its one meaning in mach, mirl, masc and mink
pub val HELP:       args.Flag = args.Flag{long: "help", short: 'h', value: nil, repeat: false, negatable: false, help: "show this command's page"};
pub val OUTPUT:     args.Flag = args.Flag{long: "output", short: 'o', value: "path", repeat: false, negatable: false, help: "write the output here"};
pub val VERBOSE:    args.Flag = args.Flag{long: "verbose", short: 'v', value: nil, repeat: true, negatable: false, help: "report what was written, and with -vv the target it was written for"};
pub val QUIET:      args.Flag = args.Flag{long: "quiet", short: 'q', value: nil, repeat: false, negatable: false, help: "print no notes, only refusals"};
pub val TARGET:     args.Flag = args.Flag{long: "target", short: 't', value: "sys-arch", repeat: false, negatable: false, help: "the target, a system and an architecture as `mach info targets` spells them, such as linux-x86_64"};
pub val ENV:        args.Flag = args.Flag{long: "env", short: 0, value: "env", repeat: false, negatable: false, help: "the environment of the system, the system's when not given"};
pub val ABI:        args.Flag = args.Flag{long: "abi", short: 0, value: "abi", repeat: false, negatable: false, help: "the calling convention, by its psABI name, the system's when not given"};
pub val ISA:        args.Flag = args.Flag{long: "isa", short: 0, value: "isa", repeat: false, negatable: false, help: "the instruction set the code may use, in masc's selection spelling, such as rv64gc, the system's floor when not given"};
pub val EXT:        args.Flag = args.Flag{long: "ext", short: 0, value: "name", repeat: true, negatable: false, help: "an extension the target adds to its instruction set, by its name in masc's catalog, once per extension"};
pub val CODE_MODEL: args.Flag = args.Flag{long: "code-model", short: 0, value: "name", repeat: false, negatable: false, help: "the code model, as the target's psABI names it, the system's when not given"};
pub val SYNTAX:     args.Flag = args.Flag{long: "syntax", short: 0, value: "name", repeat: false, negatable: false, help: "the assembly syntax, the set's established one when not given"};

# the most mode flags the registered sets declare
pub val MAX_MODE_FLAGS: usize = 16;

# the most extensions a command line adds with --ext
pub val MAX_EXTS: usize = 64;

# the permissions of a text file a command writes
val TEXT_MODE: i32 = 0o644;

# the registered sets' mode flags as a command lists them
# ---
# flags:   the flags, as std.args reads them
# spelled: each flag's spelling as the sets' mode rows state it, as `--pic`
# n:       how many
pub rec Modes {
    flags:   *args.Flag;
    spelled: *str;
    n:       usize;
}

# a command line being run
# ---
# a:      the allocator everything lives in
# line:   the command line, read against masc's commands
# modes:  the registered sets' mode flags, for a command that takes them, nil for one that does not
# chosen: the mode flags given, the first `chose` of them
# chose:  how many
# target: the target mink's catalog resolved from the flags, once a command has opened it
# exts:   the extensions --ext adds, the first `added` of them
# added:  how many
# out:    what goes to stdout
# err:    what goes to stderr
pub rec Run {
    a:      *A.Allocator;
    line:   *args.Parsed;
    modes:  *Modes;
    chosen: [MAX_MODE_FLAGS]str;
    chose:  u32;
    target: mink_target.Target;
    exts:   [MAX_EXTS]str;
    added:  u32;
    out:    text.Text;
    err:    text.Text;
}

# the operand at `i` of the command line, which the command's bounds guarantee
pub fun operand(r: *Run, i: usize) str {
    val at: opt[str] = args.operand(r.line, i);
    if (sel at.none) { ret nil; }
    ret at.some;
}

# how often -v was given: 0 for none, 1 to report what was written, 2 for the target too
pub fun verbosity(r: *Run) usize {
    ret args.occurrences(r.line, ?VERBOSE);
}

# whether -q asks for no notes
pub fun quiet(r: *Run) bool {
    ret args.given(r.line, ?QUIET);
}

# the end of a command whose storage was refused
pub fun memory(r: *Run) render.Exit {
    render.headline(?r.err, "cli.memory", "out of memory");
    ret render.INTERNAL;
}

pub fun refuse(r: *Run, code: str, message: str, subject: str) render.Exit {
    render.quoted(?r.err, code, message, subject);
    ret render.USER;
}

pub fun failed(r: *Run, code: str, f: fail.Fail) render.Exit {
    render.failure(?r.err, code, f);
    ret render.exit_of(f);
}

# the target the flags name resolved by mink's catalog, every narrowing flag given handed to it whole, and its
# instruction set checked against the set serving its architecture
fun resolved(r: *Run) opt[render.Exit] {
    val named: str = args.value(r.line, ?TARGET);
    if (named == nil) { ret opt[render.Exit].some{refuse(r, "cli.flag_missing", "the command needs the flag", "--target")}; }

    r.added = 0;
    var each: args.Values = args.values(r.line, ?EXT);
    for {
        val hit: opt[args.Hit] = args.next_value(?each);
        if (sel hit.none)        { brk; }
        if (r.added == MAX_EXTS) { ret opt[render.Exit].some{refuse(r, "cli.ext", "the command line adds more extensions than masc reads, at", hit.some.value)}; }
        r.exts[r.added] = hit.some.value;
        r.added         = r.added + 1;
    }

    val spec: res[mink_target.Spec, mink_target.Refusal] = mink_target.parse(named);
    if (sel spec.err) { ret opt[render.Exit].some{refused_target(r, spec.err)}; }

    var narrowing: mink_target.Narrowing                        = mink_target.Narrowing{env: args.value(r.line, ?ENV), abi: args.value(r.line, ?ABI), isa: args.value(r.line, ?ISA), ext: ?r.exts[0], ext_count: r.added::usize, code_model: args.value(r.line, ?CODE_MODEL)};
    val row:       res[mink_target.Target, mink_target.Refusal] = mink_target.resolve(spec.ok, ?narrowing);
    if (sel row.err) { ret opt[render.Exit].some{refused_target(r, row.err)}; }

    r.target = row.ok;
    val checked: err[mink_target.Refusal] = isa.check(r.a, ?r.target);
    if (sel checked.err) { ret opt[render.Exit].some{refused_target(r, checked.err)}; }
    ret opt[render.Exit].none{};
}

# the refusal `why` of the target the flags name, as mink's catalog words it, into `r.err`
fun refused_target(r: *Run, why: mink_target.Refusal) render.Exit {
    var s:    Sink                = sink.make(r.a, LITTLE);
    var held: mink_target.Refusal = why;
    render.begin(?r.err, "target");
    val written: err[fail.Fail] = mink_target.write(?held, ?s);
    if (sel written.err) { r.err.failed = true; }
    text.bytes(?r.err, sink.data(?s), sink.len(?s));
    text.byte(?r.err, '\n');
    val released: err[fail.Fail] = sink.release(?s);
    ret render.USER;
}

# the target the flags name, with the mode flags and extensions given in the run's storage, none with its refusal
# rendered where mink's catalog refuses its instruction set or calling convention
fun request_of(r: *Run) res[target.Request, render.Exit] {
    val spelled: res[str, mink_target.Refusal] = mink_target.isa(?r.target);
    if (sel spelled.err) { ret res[target.Request, render.Exit].err{refused_target(r, spelled.err)}; }
    val row: res[opt[*mink_arch.Abi], mink_target.Refusal] = mink_target.abi(?r.target);
    if (sel row.err) { ret res[target.Request, render.Exit].err{refused_target(r, row.err)}; }
    var abi: *mink_arch.Abi = nil;
    if (sel row.ok.some) { abi = row.ok.some; }
    r.chose = 0;
    if (r.modes != nil) {
        var i: usize = 0;
        for (i < r.modes.n) {
            if (args.given(r.line, ?r.modes.flags[i])) {
                r.chosen[r.chose] = r.modes.spelled[i];
                r.chose           = r.chose + 1;
            }
            i = i + 1;
        }
    }
    ret res[target.Request, render.Exit].ok{target.Request{
        arch:   r.target.arch,
        abi:    abi,
        isa:    spelled.ok,
        added:  target.Names{at: ?r.exts[0], len: r.added},
        syntax: args.value(r.line, ?SYNTAX),
        modes:  target.Flags{at: ?r.chosen[0], len: r.chose},
    }};
}

# the target the flags name opened into `t`, a refusal rendered when it is not, with `t` then not held
pub fun open_target(r: *Run, t: *target.Target) opt[render.Exit] {
    val named: opt[render.Exit] = resolved(r);
    if (sel named.some) { ret named; }

    val made: res[target.Request, render.Exit] = request_of(r);
    if (sel made.err) { ret opt[render.Exit].some{made.err}; }

    val q:      target.Request      = made.ok;
    val opened: err[target.Refusal] = target.open(r.a, ?isa.REGISTRY, q, t);
    if (sel opened.err) { ret opt[render.Exit].some{refuse_target(r, opened.err, q.isa)}; }

    if (verbosity(r) > 1) { noted(r, ?q); }
    ret opt[render.Exit].none{};
}

# the target the flags name, as it was resolved, noted on stderr
fun noted(r: *Run, q: *target.Request) {
    text.put(?r.err, "note[target]: ");
    text.put(?r.err, r.target.sys.name);
    text.byte(?r.err, '-');
    text.put(?r.err, r.target.arch.name);
    text.put(?r.err, ", abi ");
    if (q.abi != nil) { text.put(?r.err, q.abi.name); }
    or                { text.put(?r.err, "none"); }
    text.put(?r.err, ", isa ");
    text.put(?r.err, q.isa);
    text.put(?r.err, ", format ");
    text.put(?r.err, r.target.format.name);
    text.byte(?r.err, '\n');
}

# a target with the object format it is written in and that format's assembly dialect
# ---
# t:       the target, which `release_output` gives back
# format:  the object format, the target system's
# dialect: its assembly dialect for the architecture
pub rec Output {
    t:       target.Target;
    format:  *mink_format.Format;
    dialect: *dialect.Dialect;
}

# the target the flags name opened into `o`, its object format and that format's dialect, a refusal rendered when they
# are not, with nothing then held
pub fun open_output(r: *Run, o: *Output) opt[render.Exit] {
    val opened: opt[render.Exit] = open_target(r, ?o.t);
    if (sel opened.some) { ret opened; }

    val spoken: res[*dialect.Dialect, object.Refusal] = object.dialect_of(r.target.format, o.t.arch);
    if (sel spoken.err) {
        target.release(?o.t);
        ret opt[render.Exit].some{refuse_object(r, spoken.err)};
    }

    o.format  = r.target.format;
    o.dialect = spoken.ok;
    ret opt[render.Exit].none{};
}

pub fun release_output(o: *Output) {
    target.release(?o.t);
}

pub fun refuse_target(r: *Run, why: target.Refusal, spelling: str) render.Exit {
    if (sel why.unserved)  { ret refuse(r, "target.unserved", "no instruction set serves the architecture", why.unserved.name); }
    if (sel why.syntax)    { ret refuse(r, "target.syntax", "the set has no syntax", why.syntax); }
    if (sel why.extension) { ret refuse(r, "target.ext", "the set's catalog has no extension", why.extension); }
    if (sel why.mode)      { ret refuse(r, "target.mode", "the set has no assembler mode the flag chooses", why.mode); }
    if (sel why.twice)     { ret refuse(r, "target.mode", "another flag chooses a value of the same mode as", why.twice); }
    if (sel why.selection) { ret refuse_selection(r, why.selection, spelling); }
    if (sel why.context)   { ret refuse_context(r, why.context, spelling); }
    ret memory(r);
}

fun refuse_selection(r: *Run, why: extension.Error, spelling: str) render.Exit {
    if (sel why.refused) {
        render.headline(?r.err, "target.selection", why.refused.message);
        render.place(?r.err, "--isa", spelling, str_len(spelling), why.refused.span);
        ret render.USER;
    }
    if (sel why.conflict) { ret refuse(r, "target.selection", "the selection holds extensions that conflict", spelling); }
    ret memory(r);
}

fun refuse_context(r: *Run, why: state.Opened, spelling: str) render.Exit {
    if (sel why.state) { ret refuse(r, "target.selection", "the selection states two values of one state axis, or one no axis takes", spelling); }
    val e: register.Error = why.view;
    if (sel e.empty) { ret refuse(r, "target.selection", "the selection bounds a quantity of the register file to no value", spelling); }
    ret memory(r);
}

pub fun refuse_object(r: *Run, why: object.Refusal) render.Exit {
    if (sel why.dialect) { ret refuse(r, "object.format", "masc states no assembly dialect of the format for the architecture", why.dialect.format.name); }
    ret render.INTERNAL;
}

# the refusal `why` to assemble `src[0..len]`, the file `path`
pub fun refused_source(r: *Run, path: str, src: *u8, len: usize, why: *model.Refusal) {
    if (sel why.mode.some) {
        render.mode(?r.err, "asm.mode", ?why.mode.some);
        ret;
    }
    render.refusal(?r.err, "asm.refused", path, src, len, why.message, why.span, ?why.unmet);
    if (sel why.cause.some) { render.failure(?r.err, "asm.cause", why.cause.some); }
}

# the diagnostic `d` about `src[0..len]`, the file `path`, worded under `ctx`
pub fun diagnosed(r: *Run, code: str, path: str, src: *u8, len: usize, ctx: *state.Context, d: *diagnostic.Diagnostic) {
    render.begin(?r.err, code);
    if (!r.err.failed) {
        val spelled: err[A.Error] = state.spell_diagnostic(ctx, d, ?r.err.out);
        if (sel spelled.err) { r.err.failed = true; }
    }
    text.byte(?r.err, '\n');
    render.place(?r.err, path, src, len, d.span);
}

# the file at `path` read whole into `out`, its refusal rendered as false
pub fun load(r: *Run, path: str, out: *vector.Vector[u8]) bool {
    val loaded: res[vector.Vector[u8], fs.FsError] = fs.read_bytes(r.a, path);
    if (sel loaded.err) {
        render.quoted(?r.err, "io.read", "cannot read the file", path);
        ret false;
    }

    @out = loaded.ok;
    ret true;
}

# `len` bytes of text at `data` written as the file `path`, its refusal rendered
pub fun save_text(r: *Run, path: str, data: *u8, len: usize) render.Exit {
    val saved: err[fs.FsError] = fs.write_bytes(path, data, len, TEXT_MODE);
    if (sel saved.err) {
        render.quoted(?r.err, "io.write", "cannot write the file", path);
        ret render.ENVIRONMENT;
    }

    ret render.SUCCESS;
}

# the register of the target's set named `name` in its register file, as the emit api reads the file, without regard to
# case where the target's syntax reads registers so, a refusal rendered as none
pub fun register_named(r: *Run, t: *target.Target, name: str) opt[register.Id] {
    val file: opt[*register.File] = emit.registers(t.set);
    if (sel file.none) {
        render.quoted(?r.err, "cli.register", "the instruction set has no register file to name", name);
        ret opt[register.Id].none{};
    }

    val id: opt[register.Id] = register.named(file.some, View{data: name, len: str_len(name)}, t.set.syntaxes.at[t.syntax].fold);
    if (sel id.none) { render.quoted(?r.err, "cli.register", "the instruction set has no register", name); }
    ret id;
}

# the object `o` assembled from the file `path` written as a file of format `f` at `out`, which it releases, its counts
# noted when `verbose`
pub fun saved_object(r: *Run, formats: *mink_registry.Registry, o: *mink_object.Object, f: *mink_format.Format, path: str, out: str, verbose: bool) render.Exit {
    val saved: err[fail.Fail] = object.save(formats, r.a, o, f, out);
    var exit:  render.Exit    = render.SUCCESS;
    if (sel saved.err) { exit = failed(r, "object.write", saved.err); }
    or (verbose) {
        text.put(?r.out, path);
        text.put(?r.out, ": ");
        text.decimal(?r.out, table.count[mink_object.Section](?o.sections)::i64);
        text.put(?r.out, " sections, ");
        text.decimal(?r.out, table.count[mink_object.Symbol](?o.symbols)::i64);
        text.put(?r.out, " symbols, ");
        text.decimal(?r.out, table.count[mink_object.Reloc](?o.relocs)::i64);
        text.put(?r.out, " relocations, written to ");
        wrote(r, out, f);
    }

    mink_object.release(o);
    ret exit;
}

# the tail of a verbose line: the file `out` written in format `f`
pub fun wrote(r: *Run, out: str, f: *mink_format.Format) {
    text.put(?r.out, out);
    text.put(?r.out, " as ");
    text.put(?r.out, f.name);
    text.byte(?r.out, '\n');
}

# the command `run` runs with mink's built in format registry, given back once it has run
pub fun with_formats(r: *Run, run: fun(*Run, *mink_registry.Registry) render.Exit) render.Exit {
    val made: res[mink_registry.Registry, fail.Fail] = mink_registry.builtin(r.a);
    if (sel made.err) { ret failed(r, "object.formats", made.err); }

    var formats:  mink_registry.Registry = made.ok;
    val exit:     render.Exit            = run(r, ?formats);
    val released: err[fail.Fail]         = mink_registry.release(?formats);
    if (exit != render.SUCCESS) { ret exit; }
    if (sel released.err)       { ret failed(r, "object.formats", released.err); }

    ret exit;
}
