# how the command line writes what people read beside a command's product:
# counts with their nouns, sizes in one scaled unit and labelled rows, each
# one way for every command, as mach, mirl and mink print theirs

use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use masc.tool.text;
use masc.tool.text.Text;

# `n` with its noun, `one` when n is 1 and `many` otherwise
pub fun count(t: *Text, n: usize, one: str, many: str) {
    text.decimal(t, n::i64);
    text.byte(t, ' ');
    if (n == 1) { text.put(t, one); }
    or          { text.put(t, many); }
}

# `bytes` as a size: exact below a KiB, then the largest binary unit it holds one of, rounded to the nearest
# tenth while under ten of the unit and to the nearest whole above (`512 B`, `1.5 KiB`, `78 KiB`)
pub fun size(t: *Text, bytes: usize) {
    val ki: usize = 1024;
    if (bytes < ki) {
        text.decimal(t, bytes::i64);
        text.put(t, " B");
        ret;
    }
    val units: [3]str = [3]str{" KiB", " MiB", " GiB"};
    var per:   usize  = ki;
    var k:     usize  = 0;
    for (k < 2 && whole(bytes, per) >= ki) {
        per = per * ki;
        k   = k + 1;
    }
    val tenth: usize = tenths(bytes, per);
    if (tenth < 100) {
        text.decimal(t, (tenth / 10)::i64);
        text.byte(t, '.');
        text.decimal(t, (tenth % 10)::i64);
    }
    or { text.decimal(t, whole(bytes, per)::i64); }
    text.put(t, units[k]);
}

# n in tenths of `per`, rounded to nearest
fun tenths(n: usize, per: usize) usize {
    ret (n * 10 + per / 2) / per;
}

# n in wholes of `per`, rounded to nearest
fun whole(n: usize, per: usize) usize {
    ret (n + per / 2) / per;
}

# the label of a row padded with spaces to `width`, the widest label of its block, then the space before its value
pub fun label(t: *Text, name: str, width: usize) {
    text.put(t, name);
    var n: usize = str_len(name);
    for (n < width) {
        text.byte(t, ' ');
        n = n + 1;
    }
    text.byte(t, ' ');
}
