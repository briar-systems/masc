# how every line the command line prints for a person is laid out: results, rows of columns, and
# the one written form of a duration, a size and a count, as mach, mirl and mink lay theirs out
#
# a row is cells in columns. each column has a width, sits its cells left or right, and has the
# spaces that part it from the column before. a blank cell keeps its column, so the cells after it
# stay in theirs, and a row never ends in spaces: padding is written only when text follows it.
#
# a number is rounded to the nearest of its last digit, and shows a tenth while it is under ten of
# its unit: a size is exact bytes below a KiB, then KiB, MiB or GiB (`1.5 KiB`, `51 KiB`); a
# measured duration is microseconds below a millisecond, milliseconds below a second (`1.5ms`,
# `468ms`), seconds to a tenth below a minute (`18.5s`), then minutes and whole seconds. a count of
# one takes the singular noun.
#
# a result is a verb from one closed table and what it acted on, on one line, then its fields
# beneath it, one a line, indented INDENT, each key padded to the block's widest and GAP before its
# value. a field with nothing to say is left out, so a count of zero is never printed.

use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use chrono_duration: std.chrono.duration;
use std_format:      std.format;

use masc.tool.text;

# where a cell sits in its column
pub def Align: u8;

pub val LEFT:  Align = 0;
pub val RIGHT: Align = 1;

# the spaces between two columns, unless a column states its own
pub val GAP: usize = 2;

# one column of a block
# ---
# width: the cells' room; a longer cell takes more and pushes the rest of its row
# align: LEFT or RIGHT
# gap:   the spaces before the column; the first column's gap indents the row
pub rec Column {
    width: usize;
    align: Align;
    gap:   usize;
}

# widen a column to hold `s`
pub fun fit(c: *Column, s: str) {
    if (s == nil) { ret; }
    val l: usize = str_len(s);
    if (l > c.width) { c.width = l; }
}

# write a row's cells in their columns and end the line
# ---
# t:     where the row goes
# cols:  the block's columns
# texts: one text per column, nil or empty for a blank cell
# n:     how many columns
pub fun row(t: *text.Text, cols: *Column, texts: *str, n: usize) {
    var owed: usize = 0;
    var i:    usize = 0;
    for (i < n) {
        val c: *Column = ?cols[i];
        val s: str     = texts[i];
        i = i + 1;
        var l: usize = 0;
        if (s != nil) { l = str_len(s); }
        var pad: usize = 0;
        if (l < c.width) { pad = c.width - l; }
        owed = owed + c.gap;
        if (l == 0) {
            owed = owed + pad;
            cnt;
        }
        if (c.align == RIGHT) {
            owed = owed + pad;
            pad  = 0;
        }
        spaces(t, owed);
        text.put(t, s);
        owed = pad;
    }
    text.byte(t, '\n');
}

# write n spaces
pub fun spaces(t: *text.Text, n: usize) {
    var i: usize = 0;
    for (i < n) {
        text.byte(t, ' ');
        i = i + 1;
    }
}

# the room one written number, duration or size takes, its terminator included
pub val TEXT_CAP: usize = 48;

# storage one written value lives in while its line is written
pub rec Text {
    bytes: [TEXT_CAP]u8;
}

# the room one field's value takes when it is written of parts, as `linux-x86_64`, its terminator
# included
pub val VALUE_CAP: usize = 256;

# storage one field's value lives in while its result is written, and how much is in it
pub rec Value {
    bytes: [VALUE_CAP]u8;
    len:   usize;
}

# v emptied, to be written by `add`
pub fun value_init(v: *Value) {
    v.len      = 0;
    v.bytes[0] = 0;
}

# `s` added to what v holds, what does not fit dropped
pub fun add(v: *Value, s: str) {
    if (s == nil) { ret; }
    var i: usize = 0;
    for (s[i] != 0 && v.len + 1 < VALUE_CAP) {
        v.bytes[v.len] = s[i];
        v.len          = v.len + 1;
        i              = i + 1;
    }
    v.bytes[v.len] = 0;
}

# what v holds, nil when it holds nothing
pub fun value_of(v: *Value) str {
    if (v.len == 0) { ret nil; }
    ret (?v.bytes[0])::str;
}

# a count in decimal
pub fun count(t: *Text, n: u64) str {
    ret finish(t, put_u64(t, 0, n));
}

# a count as a field's value: nil for none, which leaves the field out
pub fun nonzero(t: *Text, n: u64) str {
    if (n == 0) { ret nil; }
    ret count(t, n);
}

# a count with its noun, as `11 lines`
pub fun counted(t: *Text, n: u64, one: str, many: str) str {
    var l: usize = put_u64(t, 0, n);
    l = put(t, l, " ");
    ret finish(t, put(t, l, noun(n, one, many)));
}

# a measured duration, rounded to the nearest of its last digit: a tenth below ten of
# microseconds or milliseconds and whole above, seconds to a tenth below a minute, then minutes
# and whole seconds. zero is `0us`
pub fun duration(t: *Text, d: chrono_duration.Duration) str {
    if (d <= 0) { ret finish(t, put(t, 0, "0us")); }
    val n:  u64 = d::u64;
    val us: u64 = chrono_duration.MICROSECOND::u64;
    val ms: u64 = chrono_duration.MILLISECOND::u64;
    val s:  u64 = chrono_duration.SECOND::u64;
    if (tenths(n, us) < 100) { ret finish(t, put(t, put_tenths(t, tenths(n, us)), "us")); }
    if (whole(n, us) < 1000) { ret finish(t, put(t, put_u64(t, 0, whole(n, us)), "us")); }
    if (tenths(n, ms) < 100) { ret finish(t, put(t, put_tenths(t, tenths(n, ms)), "ms")); }
    if (whole(n, ms) < 1000) { ret finish(t, put(t, put_u64(t, 0, whole(n, ms)), "ms")); }
    if (tenths(n, s) < 600)  { ret finish(t, put(t, put_tenths(t, tenths(n, s)), "s")); }
    val all: u64   = whole(n, s);
    var l:   usize = put_u64(t, 0, all / 60);
    l = put(t, l, "m");
    l = put_u64(t, l, all % 60);
    ret finish(t, put(t, l, "s"));
}

# a size in bytes: exact below a KiB, then the largest binary unit it holds one of, rounded to
# the nearest tenth below ten of the unit and to the nearest whole above
pub fun size(t: *Text, bytes: u64) str {
    val ki: u64 = 1024;
    if (bytes < ki) { ret finish(t, put(t, put_u64(t, 0, bytes), " B")); }
    val units: [3]str = [3]str{" KiB", " MiB", " GiB"};
    var per:   u64    = ki;
    var k:     usize  = 0;
    for (k < 2 && whole(bytes, per) >= ki) {
        per = per * ki;
        k   = k + 1;
    }
    if (tenths(bytes, per) < 100) { ret finish(t, put(t, put_tenths(t, tenths(bytes, per)), units[k])); }
    ret finish(t, put(t, put_u64(t, 0, whole(bytes, per)), units[k]));
}

# the noun a count takes
pub fun noun(n: u64, one: str, many: str) str {
    if (n == 1) { ret one; }
    ret many;
}

# n in tenths of `per`, rounded to nearest
fun tenths(n: u64, per: u64) u64 {
    ret (n * 10 + per / 2) / per;
}

# n in wholes of `per`, rounded to nearest
fun whole(n: u64, per: u64) u64 {
    ret (n + per / 2) / per;
}

# tenths written as `<whole>.<tenth>` at the start of t
fun put_tenths(t: *Text, n: u64) usize {
    var l: usize = put_u64(t, 0, n / 10);
    l = put(t, l, ".");
    ret put_u64(t, l, n % 10);
}

fun put_u64(t: *Text, at: usize, n: u64) usize {
    ret at + std_format.put_u64(?t.bytes[at], n);
}

fun put(t: *Text, at: usize, s: str) usize {
    var l: usize = at;
    var i: usize = 0;
    for (s[i] != 0 && l + 1 < TEXT_CAP) {
        t.bytes[l] = s[i];
        l          = l + 1;
        i          = i + 1;
    }
    ret l;
}

fun finish(t: *Text, l: usize) str {
    t.bytes[l] = 0;
    ret (?t.bytes[0])::str;
}

# what a result says was done, the word that opens it
pub def Verb: u8;

pub val ASSEMBLED:    Verb = 0;
pub val DISASSEMBLED: Verb = 1;
pub val LISTED:       Verb = 2;
pub val VERIFIED:     Verb = 3;
pub val FAILED:       Verb = 4;

val VERB_COUNT: usize = 5;

val VERBS: [VERB_COUNT]str = [VERB_COUNT]str{"assembled", "disassembled", "listed", "verified", "failed"};

# the word a verb says, as `assembled`
pub fun verb_word(v: Verb) str {
    ret VERBS[v];
}

# one line of a result's block: what the value is, then the value
# ---
# key:   the field's name, as `time`
# value: what the result has for it, nil or empty for nothing, which leaves the field out
pub rec Field {
    key:   str;
    value: str;
}

# the spaces a result's fields are indented by
pub val INDENT: usize = 2;

# a result: its verb and what it acted on on one line, then each field that has a value on a line
# of its own, indented INDENT, its key padded to the widest key shown and GAP before its value
# ---
# t:       where the result goes
# v:       what was done
# subject: what it was done to
# fields:  the result's fields in the order they show, n of them
pub fun result(t: *text.Text, v: Verb, subject: str, fields: *Field, n: usize) {
    text.put(t, VERBS[v]);
    text.byte(t, ' ');
    text.put(t, subject);
    text.byte(t, '\n');
    var width: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (shown(?fields[i]) && str_len(fields[i].key) > width) { width = str_len(fields[i].key); }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        val f: *Field = ?fields[i];
        i = i + 1;
        if (!shown(f)) { cnt; }
        spaces(t, INDENT);
        text.put(t, f.key);
        spaces(t, width - str_len(f.key) + GAP);
        text.put(t, f.value);
        text.byte(t, '\n');
    }
}

fun shown(f: *Field) bool {
    ret f.value != nil && f.value[0] != 0;
}

# a path as a result shows it, without a leading `./`
pub fun shown_path(p: str) str {
    if (p != nil && p[0] == '.' && p[1] == '/' && p[2] != 0) { ret (p::usize + 2)::str; }
    ret p;
}
