# the masc command line
#
# `masc <command> [options]`, read by std.args against each command's flag
# rows. the commands are one table of rows, each its help page, the most
# operands it takes and what it runs, so a command is one row. every option
# maps onto a library call: the target onto masc.tool.target, the format and
# the written object onto masc.tool.object, the assembly onto masc.asm.asm,
# the read object and its text onto masc.disasm.disasm, and every diagnostic
# and help page onto masc.tool.render and masc.tool.help. the flags of the
# registered sets' assembler modes are rows made from the sets' mode rows, so
# a set's mode flag is never an edit here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.testing;
use std.args;
use std.collections.vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.io.writer;

use mink;

use masc.asm.asm;
use masc.asm.model;
use masc.core.diagnostic;
use masc.core.extension;
use masc.core.mode;
use masc.core.set;
use masc.disasm.disasm;
use masc.format.dialect;
use masc.isa.isa;
use masc.tool.help;
use masc.tool.info;
use masc.tool.object;
use masc.tool.render;
use masc.tool.target;
use masc.tool.text;

val PROGRAM: str = "masc";
val TITLE:   str = "masc - the assembler of the mach toolchain";

val F_HELP:    args.Flag = args.Flag{name: "--help", short: "-h", kind: args.SWITCH, negatable: false, occurs: args.Occurs.once{}, value: "", doc: "show the overview, or a command's page in place of running it"};
val F_TARGET:  args.Flag = args.Flag{name: "--target", short: "-t", kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "arch", doc: "the architecture, by its name in mink's catalog"};
val F_ISA:     args.Flag = args.Flag{name: "--isa", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "selection", doc: "the extensions, in the set's selection syntax, as rv64gc_zba"};
val F_SYNTAX:  args.Flag = args.Flag{name: "--syntax", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "name", doc: "the assembly syntax, the set's established one by default"};
val F_ABI:     args.Flag = args.Flag{name: "--abi", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "name", doc: "the abi, as the set's -mabi option names it"};
val F_FORMAT:  args.Flag = args.Flag{name: "--format", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "name", doc: "the object format, by its name in mink's catalog, when several name the architecture"};
val F_OUTPUT:  args.Flag = args.Flag{name: "--output", short: "-o", kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "path", doc: "write the output here"};
val F_VERBOSE: args.Flag = args.Flag{name: "--verbose", short: "-v", kind: args.SWITCH, negatable: false, occurs: args.Occurs.once{}, value: "", doc: "report what was written"};
val F_ALIASES: args.Flag = args.Flag{name: "--aliases", short: nil, kind: args.SWITCH, negatable: true, occurs: args.Occurs.once{}, value: "", doc: "print an instruction by its preferred alias, the default"};

val GLOBAL_FLAGS:      [1]*args.Flag = [1]*args.Flag{?F_HELP};
val ASSEMBLE_FLAGS:    [8]*args.Flag = [8]*args.Flag{?F_TARGET, ?F_ISA, ?F_SYNTAX, ?F_ABI, ?F_FORMAT, ?F_OUTPUT, ?F_VERBOSE, ?F_HELP};
val DISASSEMBLE_FLAGS: [7]*args.Flag = [7]*args.Flag{?F_TARGET, ?F_ISA, ?F_SYNTAX, ?F_ALIASES, ?F_OUTPUT, ?F_VERBOSE, ?F_HELP};

val ASSEMBLE_PAGE: help.Page = help.Page{
    name:    "assemble",
    summary: "assemble a source file into an object file",
    usage:   "assemble <input> --target <arch> --isa <selection> -o <path> [options]",
    effect:  "assemble the source file into mink's neutral object and write it in the target's object format",
    flags:   ?ASSEMBLE_FLAGS[0],
    count:   8,
};
val DISASSEMBLE_PAGE: help.Page = help.Page{
    name:    "disassemble",
    summary: "print an object file as assembly source",
    usage:   "disassemble <input> --target <arch> --isa <selection> [options]",
    effect:  "read the object file through mink and print it as source that assembles back to the same sections, on stdout or to -o",
    flags:   ?DISASSEMBLE_FLAGS[0],
    count:   7,
};
val INFO_PAGE: help.Page = help.Page{
    name:    "info",
    summary: "list the registered instruction sets with their syntaxes and levels",
    usage:   "info",
    effect:  "list every registered instruction set: the architectures it serves, its syntaxes and its levels",
    flags:   ?GLOBAL_FLAGS[0],
    count:   1,
};
val HELP_PAGE: help.Page = help.Page{
    name:    "help",
    summary: "show command help",
    usage:   "help [command]",
    effect:  "show the overview, or the page of a command",
    flags:   ?GLOBAL_FLAGS[0],
    count:   1,
};

# the most mode flags the registered sets declare, the most flags a command reads and the most operands it takes
val MAX_MODE_FLAGS: usize = 16;
val MAX_FLAGS:      usize = 8 + MAX_MODE_FLAGS;
val MAX_OPERANDS:   usize = 1;

# a command line being run
# ---
# a:        the allocator everything lives in
# args:     the arguments
# command:  the command word's row
# page:     its help with its flag rows, the page's own and its mode flags
# rows:     the flag rows the reader reads
# moding:   a flag row per distinct mode flag of the registered sets, the first `moded` of them, for a command that
#           takes them
# moded:    how many
# chosen:   the mode flags given, the first `chose` of them
# chose:    how many
# reader:   the reader of its flags, which points at settings
# settings: one per flag row
# operands: the operands, in order
# count:    how many
# out:      what goes to stdout
# err:      what goes to stderr
rec Run {
    a:        *A.Allocator;
    args:     args.Args;
    command:  *Command;
    page:     help.Page;
    rows:     [MAX_FLAGS]*args.Flag;
    moding:   [MAX_MODE_FLAGS]args.Flag;
    moded:    usize;
    chosen:   [MAX_MODE_FLAGS]str;
    chose:    u32;
    reader:   args.Reader;
    settings: [MAX_FLAGS]args.Setting;
    operands: [MAX_OPERANDS]str;
    count:    usize;
    out:      text.Text;
    err:      text.Text;
}

# one command
# ---
# page:     its help, which holds its name and flag rows
# operands: how many operands it takes at most
# least:    how many it takes at least
# modes:    whether it takes the mode flags of the registered sets
# run:      what it runs once its line is read
rec Command {
    page:     *help.Page;
    operands: usize;
    least:    usize;
    modes:    bool;
    run:      fun(*Run) render.Exit;
}

val COMMAND_COUNT: usize                  = 4;
val COMMANDS:      [COMMAND_COUNT]Command = [COMMAND_COUNT]Command{
    Command{page: ?ASSEMBLE_PAGE, operands: 1, least: 1, modes: true, run: assemble},
    Command{page: ?DISASSEMBLE_PAGE, operands: 1, least: 1, modes: false, run: disassemble},
    Command{page: ?INFO_PAGE, operands: 0, least: 0, modes: false, run: list},
    Command{page: ?HELP_PAGE, operands: 1, least: 0, modes: false, run: topic},
};

# every page, in command order, for the overview
val PAGES: [COMMAND_COUNT]*help.Page = [COMMAND_COUNT]*help.Page{?ASSEMBLE_PAGE, ?DISASSEMBLE_PAGE, ?INFO_PAGE, ?HELP_PAGE};

fun command_named(name: str) *Command {
    var i: usize = 0;
    for (i < COMMAND_COUNT) {
        if (str_equals(COMMANDS[i].page.name, name)) { ret ?COMMANDS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the end of a command whose register view or selection storage was refused
fun memory(r: *Run) render.Exit {
    render.headline(?r.err, "cli.memory", "out of memory");
    ret render.INTERNAL;
}

fun refuse(r: *Run, code: str, message: str, subject: str) render.Exit {
    render.quoted(?r.err, code, message, subject);
    ret render.USER;
}

fun overview(t: *text.Text) {
    help.overview(t, TITLE, PROGRAM, ?PAGES[0], COMMAND_COUNT, ?GLOBAL_FLAGS[0], 1);
}

fun refuse_flag(r: *Run, why: args.Error) render.Exit {
    if (sel why.unknown)       { ret refuse(r, "cli.flag_unknown", "unknown flag", why.unknown.flag); }
    if (sel why.missing_value) { ret refuse(r, "cli.flag_missing_value", "flag takes a value", why.missing_value.flag); }
    if (sel why.repeated)      { ret refuse(r, "cli.flag_repeated", "flag given twice", why.repeated.flag); }
    ret render.INTERNAL;
}

# whether `name` is the spelling of one of the first `count` rows of `rows`
fun spelled(rows: *args.Flag, count: usize, name: str) bool {
    var i: usize = 0;
    for (i < count) {
        if (str_equals(rows[i].name, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a switch row for every distinct flag of the registered sets' assembler modes, into `rows`, how many, none when they
# are more than the rows hold
fun mode_rows(registry: *set.Registry, rows: *args.Flag) opt[usize] {
    var n: usize = 0;
    var i: u32   = 0;
    for (i < registry.count) {
        val all: *mode.Modes = ?registry.sets[i].assembly;
        var j:   u32         = 0;
        for (j < all.len) {
            val m: *mode.Mode = all.at[j];
            var k: u32        = 0;
            for (k < m.values.len) {
                val v: *mode.Value = m.values.at[k];
                k = k + 1;
                if (v.flag == nil || spelled(rows, n, v.flag)) { cnt; }
                if (n == MAX_MODE_FLAGS)                       { ret opt[usize].none{}; }
                rows[n] = args.Flag{name: v.flag, short: nil, kind: args.SWITCH, negatable: false, occurs: args.Occurs.once{}, value: "", doc: v.doc};
                n       = n + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret opt[usize].some{n};
}

# the page of `c` into `r` with its flag rows, its page's own and, for a command that takes them, the mode flags before
# the last. false when the mode flags are more than the rows hold
fun paged(r: *Run, c: *Command) bool {
    r.moded = 0;
    if (c.modes) {
        val made: opt[usize] = mode_rows(?isa.REGISTRY, ?r.moding[0]);
        if (sel made.none) { ret false; }
        r.moded = made.some;
    }
    var n: usize = 0;
    var i: usize = 0;
    for (i + 1 < c.page.count) {
        r.rows[n] = c.page.flags[i];
        n         = n + 1;
        i         = i + 1;
    }
    var k: usize = 0;
    for (k < r.moded) {
        r.rows[n] = ?r.moding[k];
        n         = n + 1;
        k         = k + 1;
    }
    if (c.page.count > 0) {
        r.rows[n] = c.page.flags[c.page.count - 1];
        n         = n + 1;
    }
    r.page       = @c.page;
    r.page.flags = ?r.rows[0];
    r.page.count = n;
    ret true;
}

fun unpaged(r: *Run) render.Exit {
    render.headline(?r.err, "cli.flags", "the registered sets declare more mode flags than the command line holds");
    ret render.INTERNAL;
}

# the command's flag rows read from argument `start` on, its operands kept. a refusal is rendered, and nil means read
fun read(r: *Run, c: *Command, start: usize) opt[render.Exit] {
    r.command = c;
    r.count   = 0;
    if (!paged(r, c)) { ret opt[render.Exit].some{unpaged(r)}; }
    r.reader = args.reader(r.args, start, r.page.flags, r.page.count, ?r.settings[0]);
    for {
        val e: res[args.Event, args.Error] = args.read(?r.reader);
        if (sel e.err) { ret opt[render.Exit].some{refuse_flag(r, e.err)}; }
        if (sel e.ok) {
            if (sel e.ok.done) { brk; }
            if (sel e.ok.operand) {
                val word: str = r.args.argv[e.ok.operand]::str;
                if (r.count == c.operands) { ret opt[render.Exit].some{refuse(r, "cli.operand_extra", "operand not taken", word)}; }
                r.operands[r.count] = word;
                r.count             = r.count + 1;
            }
        }
    }
    ret opt[render.Exit].none{};
}

# the end of a command that read a flag outside its table, or one that collects: a bug of the command's flag table
fun misread(r: *Run, why: args.Misread) render.Exit {
    if (sel why.unlisted)  { render.quoted(?r.err, "cli.flag_unlisted", "flag is not in the command's table", why.unlisted.name); }
    if (sel why.repeating) { render.quoted(?r.err, "cli.flag_collects", "flag collects and has no single value", why.repeating.name); }
    ret render.INTERNAL;
}

# whether instructions print by their preferred alias: on unless --no-aliases
fun aliases(r: *Run) res[bool, args.Misread] {
    val on: res[bool, args.Misread] = args.on(r.reader, ?F_ALIASES);
    if (sel on.err) { ret on; }
    ret res[bool, args.Misread].ok{!args.given(r.reader, ?F_ALIASES) || on.ok};
}

# the target the flags name, with the mode flags given in the run's storage. the options storage is the caller's
fun request_of(r: *Run, abi: *target.Option) res[target.Request, args.Misread] {
    val arch:      res[str, args.Misread] = args.value(r.reader, ?F_TARGET);
    val selection: res[str, args.Misread] = args.value(r.reader, ?F_ISA);
    val syntax:    res[str, args.Misread] = args.value(r.reader, ?F_SYNTAX);
    val spelled:   res[str, args.Misread] = args.value(r.reader, ?F_ABI);
    if (sel arch.err)      { ret res[target.Request, args.Misread].err{arch.err}; }
    if (sel selection.err) { ret res[target.Request, args.Misread].err{selection.err}; }
    if (sel syntax.err)    { ret res[target.Request, args.Misread].err{syntax.err}; }
    if (sel spelled.err)   { ret res[target.Request, args.Misread].err{spelled.err}; }
    var q: target.Request = target.Request{arch: arch.ok, selection: selection.ok, syntax: syntax.ok, options: target.NO_OPTIONS, modes: target.NO_FLAGS};
    r.chose = 0;
    var i: usize = 0;
    for (i < r.moded) {
        if (args.given(r.reader, ?r.moding[i])) {
            r.chosen[r.chose] = r.moding[i].name;
            r.chose           = r.chose + 1;
        }
        i = i + 1;
    }
    q.modes = target.Flags{at: ?r.chosen[0], len: r.chose};
    if (q.selection == nil) { q.selection = ""; }
    if (spelled.ok != nil) {
        abi.option = "-mabi";
        abi.value  = spelled.ok;
        q.options  = target.Options{at: abi, len: 1};
    }
    ret res[target.Request, args.Misread].ok{q};
}

fun refuse_selection(r: *Run, why: extension.Error, spelling: str) render.Exit {
    if (sel why.refused) {
        render.headline(?r.err, "target.selection", why.refused.message);
        render.place(?r.err, "--isa", spelling, str_len(spelling), why.refused.span);
        ret render.USER;
    }
    if (sel why.conflict) { ret refuse(r, "target.selection", "the selection holds extensions that conflict", spelling); }
    ret memory(r);
}

fun refuse_target(r: *Run, why: target.Refusal, spelling: str) render.Exit {
    if (sel why.arch)      { ret refuse(r, "target.arch", "unknown architecture", why.arch); }
    if (sel why.unserved)  { ret refuse(r, "target.unserved", "no instruction set serves the architecture", why.unserved.name); }
    if (sel why.syntax)    { ret refuse(r, "target.syntax", "the set has no syntax", why.syntax); }
    if (sel why.option)    { ret refuse(r, "target.option", "the set states no abi", why.option.value); }
    if (sel why.mode)      { ret refuse(r, "target.mode", "the set has no assembler mode the flag chooses", why.mode); }
    if (sel why.twice)     { ret refuse(r, "target.mode", "another flag chooses a value of the same mode as", why.twice); }
    if (sel why.selection) { ret refuse_selection(r, why.selection, spelling); }
    ret memory(r);
}

fun refuse_object(r: *Run, why: object.Refusal) render.Exit {
    if (sel why.format)    { ret refuse(r, "object.format", "unknown object format", why.format); }
    if (sel why.unnamed)   { ret refuse(r, "object.format", "the format names no code for the architecture", why.unnamed.format.name); }
    if (sel why.ambiguous) { ret refuse(r, "object.format", "choose the object format with --format, several name the architecture", why.ambiguous.name); }
    if (sel why.dialect)   { ret refuse(r, "object.format", "masc states no assembly dialect of the format", why.dialect.name); }
    ret render.INTERNAL;
}

fun failed(r: *Run, code: str, f: mink.fail.Fail) render.Exit {
    render.failure(?r.err, code, f);
    ret render.exit_of(f);
}

# the refusal `why` to assemble `src[0..len]`, the file `path`
fun refused(r: *Run, path: str, src: *u8, len: usize, why: *model.Refusal) {
    if (sel why.mode.some) {
        render.mode(?r.err, "asm.mode", ?why.mode.some);
        ret;
    }
    render.refusal(?r.err, "asm.refused", path, src, len, why.message, why.span, ?why.unmet);
}

fun assemble(r: *Run) render.Exit {
    val path:    str                     = r.operands[0];
    val output:  res[str, args.Misread]  = args.value(r.reader, ?F_OUTPUT);
    val named:   res[str, args.Misread]  = args.value(r.reader, ?F_FORMAT);
    val verbose: res[bool, args.Misread] = args.on(r.reader, ?F_VERBOSE);
    if (sel output.err)  { ret misread(r, output.err); }
    if (sel named.err)   { ret misread(r, named.err); }
    if (sel verbose.err) { ret misread(r, verbose.err); }
    val out: str = output.ok;
    if (out == nil) { ret refuse(r, "cli.flag_missing", "the command needs the flag", "--output"); }
    var abi:  target.Option;
    val made: res[target.Request, args.Misread] = request_of(r, ?abi);
    if (sel made.err) { ret misread(r, made.err); }
    val q:      target.Request      = made.ok;
    var t:      target.Target;
    val opened: err[target.Refusal] = target.open(r.a, ?isa.REGISTRY, q, ?t);
    if (sel opened.err) { ret refuse_target(r, opened.err, q.selection); }
    val format: res[*mink.format.Format, object.Refusal] = object.format_for(t.arch, named.ok);
    if (sel format.err) {
        target.release(?t);
        ret refuse_object(r, format.err);
    }
    val spoken: res[*dialect.Dialect, object.Refusal] = object.dialect_of(format.ok);
    if (sel spoken.err) {
        target.release(?t);
        ret refuse_object(r, spoken.err);
    }
    val loaded: res[mink.file.Loaded, mink.fail.Fail] = mink.file.load(r.a, path);
    if (sel loaded.err) {
        target.release(?t);
        ret failed(r, "io.read", loaded.err);
    }
    var source: mink.file.Loaded                       = loaded.ok;
    val built:  res[mink.object.Object, model.Refusal] = asm.assemble(r.a, t.set, ?t.available, target.assembler(?t, spoken.ok), source.input.data, source.input.len, diagnostic.START);
    if (sel built.err) {
        refused(r, path, source.input.data, source.input.len, ?built.err);
        mink.file.unload(?source);
        target.release(?t);
        ret render.USER;
    }
    var o:     mink.object.Object  = built.ok;
    val saved: err[mink.fail.Fail] = object.save(r.a, ?o, format.ok, out);
    var exit:  render.Exit         = render.SUCCESS;
    if (sel saved.err) { exit = failed(r, "object.write", saved.err); }
    or (verbose.ok) {
        text.put(?r.out, path);
        text.put(?r.out, ": ");
        text.decimal(?r.out, o.sections.count::i64);
        text.put(?r.out, " sections, ");
        text.decimal(?r.out, o.symbols.count::i64);
        text.put(?r.out, " symbols, ");
        text.decimal(?r.out, o.relocs.count::i64);
        text.put(?r.out, " relocations, written to ");
        text.put(?r.out, out);
        text.put(?r.out, " as ");
        text.put(?r.out, format.ok.name);
        text.byte(?r.out, '\n');
    }
    mink.object.release(?o);
    mink.file.unload(?source);
    target.release(?t);
    ret exit;
}

# how instructions are spelled: by their preferred alias unless --no-aliases
fun spelling(aliased: bool) disasm.Spelling {
    if (aliased) { ret disasm.ALIASES; }
    ret disasm.FORMS;
}

fun disassemble(r: *Run) render.Exit {
    val path:    str                     = r.operands[0];
    val written: res[str, args.Misread]  = args.value(r.reader, ?F_OUTPUT);
    val aliased: res[bool, args.Misread] = aliases(r);
    val verbose: res[bool, args.Misread] = args.on(r.reader, ?F_VERBOSE);
    if (sel written.err) { ret misread(r, written.err); }
    if (sel aliased.err) { ret misread(r, aliased.err); }
    if (sel verbose.err) { ret misread(r, verbose.err); }
    val output: str                               = written.ok;
    var abi:    target.Option;
    val made:   res[target.Request, args.Misread] = request_of(r, ?abi);
    if (sel made.err) { ret misread(r, made.err); }
    val q:      target.Request      = made.ok;
    var t:      target.Target;
    val opened: err[target.Refusal] = target.open(r.a, ?isa.REGISTRY, q, ?t);
    if (sel opened.err) { ret refuse_target(r, opened.err, q.selection); }
    val got: res[disasm.File, mink.fail.Fail] = disasm.open(r.a, path);
    if (sel got.err) {
        target.release(?t);
        ret failed(r, "object.read", got.err);
    }
    var f:      disasm.File                           = got.ok;
    val spoken: res[*dialect.Dialect, object.Refusal] = object.dialect_of(f.format);
    if (sel spoken.err) {
        val shut: err[mink.fail.Fail] = disasm.close(?f);
        target.release(?t);
        ret refuse_object(r, spoken.err);
    }
    var printed: vector.Vector[u8]  = vector.init[u8](r.a);
    var into:    *vector.Vector[u8] = ?r.out.out;
    if (output != nil) { into = ?printed; }
    val options: disasm.Options      = disasm.Options{syntax: t.syntax, spelling: spelling(aliased.ok), dialect: spoken.ok};
    val done:    err[disasm.Refusal] = disasm.disassemble(r.a, t.set, ?t.available, options, ?f.object, into);
    var exit:    render.Exit         = render.SUCCESS;
    if (sel done.err) {
        render.unprinted(?r.err, "disasm.refused", path, ?f.object, ?done.err);
        exit = render.USER;
    }
    or (output != nil) {
        val written: err[fs.FsError] = fs.write_bytes(output, printed.data, printed.len, mink.file.MODE);
        if (sel written.err) {
            render.quoted(?r.err, "io.write", "cannot write the file", output);
            exit = render.ENVIRONMENT;
        }
        or (verbose.ok) {
            text.put(?r.out, path);
            text.put(?r.out, ": ");
            text.decimal(?r.out, printed.len::i64);
            text.put(?r.out, " bytes of source, written to ");
            text.put(?r.out, output);
            text.byte(?r.out, '\n');
        }
    }
    vector.dnit[u8](?printed);
    val closed: err[mink.fail.Fail] = disasm.close(?f);
    target.release(?t);
    if (sel closed.err) {
        if (exit == render.SUCCESS) { ret failed(r, "object.read", closed.err); }
    }
    ret exit;
}

fun list(r: *Run) render.Exit {
    info.describe(?isa.REGISTRY, ?r.out);
    ret render.SUCCESS;
}

fun topic(r: *Run) render.Exit {
    if (r.count == 0) {
        overview(?r.out);
        ret render.SUCCESS;
    }
    val c: *Command = command_named(r.operands[0]);
    if (c == nil)     { ret refuse(r, "cli.unknown_command", "unknown command", r.operands[0]); }
    if (!paged(r, c)) { ret unpaged(r); }
    help.page(?r.out, PROGRAM, ?r.page);
    ret render.SUCCESS;
}

# the command line `a` run, its output left in `r.out` and `r.err`
fun dispatch(r: *Run) render.Exit {
    val word: opt[str] = args.get(r.args, 1);
    if (sel word.none) {
        overview(?r.out);
        ret render.SUCCESS;
    }
    val c: *Command = command_named(word.some);
    if (c == nil && word.some[0] == '-') {
        val refused: opt[render.Exit] = read(r, ?COMMANDS[3], 1);
        if (sel refused.some) { ret refused.some; }
        overview(?r.out);
        ret render.SUCCESS;
    }
    if (c == nil) {
        render.quoted(?r.err, "cli.unknown_command", "unknown command", word.some);
        overview(?r.err);
        ret render.USER;
    }
    val refused: opt[render.Exit] = read(r, c, 2);
    if (sel refused.some) { ret refused.some; }
    val help_given: res[bool, args.Misread] = args.on(r.reader, ?F_HELP);
    if (sel help_given.err) { ret misread(r, help_given.err); }
    if (help_given.ok) {
        help.page(?r.out, PROGRAM, ?r.page);
        ret render.SUCCESS;
    }
    if (r.count < c.least) { ret refuse(r, "cli.operand_missing", "the command needs an operand", c.page.name); }
    ret c.run(r);
}

fun emit(f: fs.File, t: *text.Text) bool {
    if (t.out.len == 0) { ret true; }
    var w: writer.Writer          = fs.writer(f);
    val r: err[writer.WriteError] = writer.write_all(?w, t.out.data, t.out.len);
    ret sel r.ok;
}

fun start(r: *Run, a: *A.Allocator, v: args.Args) {
    r.a    = a;
    r.args = v;
    r.out  = text.make(a);
    r.err  = text.make(a);
}

fun finish(r: *Run) {
    text.release(?r.out);
    text.release(?r.err);
}

# the command line `v` run, its output written to stdout and stderr
pub fun run(a: *A.Allocator, v: args.Args) i64 {
    var r: Run;
    start(?r, a, v);
    var exit: render.Exit = dispatch(?r);
    if (r.out.failed || r.err.failed) {
        text.clear(?r.err);
        r.err.failed = false;
        render.headline(?r.err, "cli.memory", "out of memory");
        exit = render.INTERNAL;
    }
    if (!emit(fs.STDOUT, ?r.out) || !emit(fs.STDERR, ?r.err)) { exit = render.ENVIRONMENT; }
    finish(?r);
    ret exit;
}

# whether the disassemble line `argv[0..argc]` reads and prints by alias
#[testing]
fun t_aliases(a: *A.Allocator, argc: usize, argv: **u8, want: bool) bool {
    var r: Run;
    start(?r, a, args.of(argc, argv));
    val refused: opt[render.Exit] = read(?r, ?COMMANDS[1], 2);
    var ok:      bool             = false;
    if (sel refused.none) {
        val got: res[bool, args.Misread] = aliases(?r);
        if (sel got.ok) { ok = got.ok == want; }
    }
    finish(?r);
    ret ok;
}

test read__a_negatable_switch_takes_key_and_no_key {
    var tt: testing.Testing;
    testing.make(?tt);
    val a:   *A.Allocator = testing.allocator_of(?tt);
    var off: [4]*u8       = [4]*u8{"masc", "disassemble", "--no-aliases", "x.o"};
    var on:  [4]*u8       = [4]*u8{"masc", "disassemble", "--aliases", "x.o"};
    var not: [3]*u8       = [3]*u8{"masc", "disassemble", "x.o"};
    if (!t_aliases(a, 4, ?off[0], false)) { ret 1; }
    if (!t_aliases(a, 4, ?on[0], true))   { ret 2; }
    if (!t_aliases(a, 3, ?not[0], true))  { ret 3; }
    if (testing.live_count(?tt) != 0)     { ret 4; }
    ret 0;
}

# the stderr of the line `argv[0..argc]` copied into `into`, and its exit
#[testing]
fun t_line(a: *A.Allocator, argc: usize, argv: **u8, into: *vector.Vector[u8]) render.Exit {
    var r: Run;
    start(?r, a, args.of(argc, argv));
    val exit: render.Exit = dispatch(?r);
    var i:    usize       = 0;
    for (i < r.err.out.len) {
        vector.push[u8](into, r.err.out.data[i]);
        i = i + 1;
    }
    finish(?r);
    ret exit;
}

#[testing]
val T_SOURCE: str = "nop\n";

#[testing]
val T_INPUT: str = "mode-refusal-test.s";

test assemble__a_selection_of_another_mode_names_both_modes {
    var tt: testing.Testing;
    testing.make(?tt);
    val a:     *A.Allocator    = testing.allocator_of(?tt);
    val wrote: err[fs.FsError] = fs.write_bytes(T_INPUT, T_SOURCE, str_len(T_SOURCE), 0o644);
    if (sel wrote.err) { ret 1; }
    var line: [13]*u8             = [13]*u8{"masc", "assemble", T_INPUT, "-o", "mode-refusal-test.o", "--target", "riscv64", "--isa", "rv32gc", "--abi", "lp64d", "--format", "elf"};
    var got:  vector.Vector[u8]   = vector.init[u8](a);
    val exit: render.Exit         = t_line(a, 13, ?line[0], ?got);
    val gone: err[io_error.Error] = fs.remove_file(T_INPUT);
    var ok:   bool                = exit == render.USER && !sel gone.err;
    ok = ok && t_has(?got, "error[asm.mode]") && t_has(?got, "'riscv64'") && t_has(?got, "'rv64'") && t_has(?got, "'rv32'");
    vector.dnit[u8](?got);
    if (!ok)                          { ret 2; }
    if (testing.live_count(?tt) != 0) { ret 3; }
    ret 0;
}

# whether `word` appears in the bytes of `v`
#[testing]
fun t_has(v: *vector.Vector[u8], word: str) bool {
    val n: usize = str_len(word);
    var i: usize = 0;
    for (i + n <= v.len) {
        var j: usize = 0;
        for (j < n && v.data[i + j] == word[j]) { j = j + 1; }
        if (j == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

test assemble__two_values_of_one_mode_are_refused_by_the_target {
    var tt: testing.Testing;
    testing.make(?tt);
    val a:    *A.Allocator      = testing.allocator_of(?tt);
    var line: [11]*u8           = [11]*u8{"masc", "assemble", "x.s", "-o", "x.o", "-t", "riscv64", "--isa", "rv64i", "--pic", "--no-pic"};
    var got:  vector.Vector[u8] = vector.init[u8](a);
    val exit: render.Exit       = t_line(a, 11, ?line[0], ?got);
    val ok:   bool              = exit == render.USER && t_has(?got, "error[target.mode]: another flag chooses a value of the same mode as '--pic'\n");
    vector.dnit[u8](?got);
    if (!ok)                          { ret 1; }
    if (testing.live_count(?tt) != 0) { ret 2; }
    ret 0;
}
