# the stage log under -v and -vv, on stderr, in the columns of mach's log lines
#
# a log line is a stamp, the stage, its time and what it did:
#
#     [  0.01] target      103us  linux-x86_64
#                                 isa         cx8,cmov,x87,fxsr,osfxsr,mmx,sce,sse,sse2
#     [  0.02] parse       2.4ms  11 lines
#
# the stamp is the seconds since the command began, to a hundredth, in a field six wide. the stage's
# label is LABEL_W columns wide and its time is right-aligned in TIME_W. under -vv the target's line
# is followed by its facts, each at FACT_LEAD, the column a line's detail starts at, its key in a
# column FACT_KEY_W wide and then its value.

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use chrono_duration: std.chrono.duration;
use std.chrono.time;
use std_format: std.format;

use masc.cli.layout;
use masc.tool.text;

# a log line's label column and time column, and the lead in place of its stamp
pub val LABEL_W: usize = 11;
pub val TIME_W:  usize = 6;
pub val STAMP_W: usize = 9;

# the lead of a fact beneath the target's log line, and its key's column
pub val FACT_LEAD:  usize = 28;
pub val FACT_KEY_W: usize = 12;

# an instant the log measures from: absent when the clock refused the sample, so a duration
# measured from it is zero rather than invented
pub def Instant: opt[time.Instant];

# the instant now, or none when the clock refused
pub fun sample() Instant {
    val res_instant: time.InstantClock = time.instant();
    if (sel res_instant.ok) { ret Instant.some{res_instant.ok}; }
    ret Instant.none{};
}

# the time since start, zero when either sample is absent
pub fun elapsed(start: Instant) chrono_duration.Duration {
    if (sel start.none) { ret 0; }
    val res_instant: time.InstantClock = time.instant();
    if (sel res_instant.err) { ret 0; }
    ret time.instant_sub(res_instant.ok, start.some);
}

# a log line's lead: `at`, the time since the command began when the stage closed, the stage's
# label and its time `d`, each in its column; what the stage did follows, each part by `detail`,
# and `end` closes the line
pub fun head(t: *text.Text, at: chrono_duration.Duration, label: str, d: chrono_duration.Duration) {
    stamp(t, at);
    text.put(t, label);
    val used: usize = str_len(label);
    if (used < LABEL_W) { layout.spaces(t, LABEL_W - used); }
    var dt: layout.Text;
    right(t, layout.duration(?dt, d), TIME_W);
}

# one part of what a stage did after its line's columns, two spaces before it, nothing for nil
pub fun detail(t: *text.Text, s: str) {
    if (s == nil || s[0] == 0) { ret; }
    text.put(t, "  ");
    text.put(t, s);
}

# the end of a log line
pub fun end(t: *text.Text) {
    text.byte(t, '\n');
}

# one of the target's facts beneath its log line: its key in a column, then its value
pub fun fact(t: *text.Text, key: str, value: str) {
    fact_key(t, key);
    text.put(t, value);
    text.byte(t, '\n');
}

# a fact's lead and its key in their columns; its value and the line's end follow
pub fun fact_key(t: *text.Text, key: str) {
    layout.spaces(t, FACT_LEAD);
    text.put(t, key);
    val used: usize = str_len(key);
    if (used < FACT_KEY_W) { layout.spaces(t, FACT_KEY_W - used); }
}

# `[  0.07] `: a duration in seconds to two places, right-aligned in its brackets
fun stamp(t: *text.Text, d: chrono_duration.Duration) {
    var cs: u64 = 0;
    if (d > 0) { cs = (d::u64 + 5000000) / 10000000; }
    var digits: [24]u8;
    var l:      usize = std_format.put_u64(?digits[0], cs / 100);
    digits[l] = '.';
    l         = l + 1;
    if (cs % 100 < 10) {
        digits[l] = '0';
        l         = l + 1;
    }
    l         = l + std_format.put_u64(?digits[l], cs % 100);
    digits[l] = 0;
    text.byte(t, '[');
    right(t, (?digits[0])::str, STAMP_W - 3);
    text.put(t, "] ");
}

# s right-aligned in `width`
fun right(t: *text.Text, s: str, width: usize) {
    val l: usize = str_len(s);
    if (l < width) { layout.spaces(t, width - l); }
    text.put(t, s);
}
