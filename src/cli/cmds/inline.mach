# `masc inline`: read a file as one inline assembly block and write it as an object file

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.args;
use std.collections.slice.Slice;

use mink_registry: mink.format.registry;
use mink_object:   mink.model.object;

use masc.asm.model;
use build_refusal: masc.build.refusal;
use build_state:   masc.build.state;
use masc.cli.assembly;
use masc.cli.context;
use masc.cli.context.Run;
use masc.core.diagnostic;
use masc.core.operand;
use masc.core.register;
use masc.emit;
use masc.inline;
use masc.tool.render;
use masc.tool.target;
use masc.tool.text;

val F_OPERAND: args.Flag = args.Flag{long: "operand", short: 0, value: "name=register", repeat: true, negatable: false, help: "an operand the block names, placed in the register"};

val FLAG_COUNT: usize                  = 12;
val FLAGS:      [FLAG_COUNT]*args.Flag = [FLAG_COUNT]*args.Flag{?context.HELP, ?context.TARGET, ?context.ENV, ?context.ABI, ?context.ISA, ?context.EXT, ?context.CODE_MODEL, ?context.SYNTAX, ?F_OPERAND, ?context.OUTPUT, ?context.VERBOSE, ?context.QUIET};

pub val COMMAND: args.Command = args.Command{
    name:        "inline",
    help:        "assemble one inline assembly block into an object file",
    usage:       "<input> -t <sys-arch> -o <path>",
    flags:       Slice[*args.Flag]{data: ?FLAGS[0], size: FLAG_COUNT},
    operand_min: 1,
    operand_max: 1,
};

# the most operands a block declares, and the longest name one has
val MAX_OPERANDS: usize = 16;
val MAX_NAME:     usize = 32;

# the operands `--operand` declares
# ---
# names:     each operand's name, terminated
# operands:  each operand, its name in `names`
# locations: where each lies, the register it names
# count:     how many
rec Declared {
    names:     [MAX_OPERANDS][MAX_NAME]u8;
    operands:  [MAX_OPERANDS]inline.Operand;
    locations: [MAX_OPERANDS]inline.Location;
    count:     usize;
}

# the file the line names read as one inline assembly block, its operands placed as `--operand` declares them, and
# written as the object file `--output` names, by mink's built-in formats
# ---
# r:   the run, its line read against this command
# ret: the command's exit code
pub fun run(r: *Run) render.Exit {
    ret inline_with(r, mink_registry.builtin());
}

# the declaration `spelled`, `name=register`, read into `d` under the target `t`, a refusal rendered as false
fun declared(r: *Run, t: *target.Target, spelled: str, d: *Declared) bool {
    if (d.count == MAX_OPERANDS) {
        render.quoted(context.error(r), "inline.operand", "the block declares more operands than masc reads, at", spelled);
        ret false;
    }

    var n: usize = 0;
    for (spelled[n] != 0 && spelled[n] != '=') { n = n + 1; }
    if (spelled[n] != '=' || n == 0 || spelled[n + 1] == 0) {
        render.quoted(context.error(r), "inline.operand", "an operand is declared as name=register, not", spelled);
        ret false;
    }
    if (n >= MAX_NAME) {
        render.quoted(context.error(r), "inline.operand", "the operand's name is longer than masc reads", spelled);
        ret false;
    }

    val opt_reg: opt[register.Id] = context.register_named(r, t, ?spelled[n + 1]);
    if (sel opt_reg.none) { ret false; }

    val k: usize = d.count;
    var i: usize = 0;
    for (i < n) {
        d.names[k][i] = spelled[i];
        i             = i + 1;
    }
    d.names[k][n]  = 0;
    d.operands[k]  = inline.Operand{name: ?d.names[k][0], constraint: inline.Constraint.class{register.class_of(opt_reg.some)}, role: operand.READ_WRITE};
    d.locations[k] = operand.Value.register{opt_reg.some};
    d.count        = k + 1;
    ret true;
}

# the block the line names assembled as `run` assembles it, by the formats `formats`
fun inline_with(r: *Run, formats: *mink_registry.Registry) render.Exit {
    val path: str = context.operand(r, 0);
    val out:  str = args.value(r.line, ?context.OUTPUT);
    if (out == nil) { ret context.refuse(r, "cli.flag_missing", "the command needs the flag", "--output"); }

    var o:          context.Output;
    val opt_opened: opt[render.Exit] = context.output_init(r, ?o);
    if (sel opt_opened.some) { ret opt_opened.some; }

    var d:    Declared;
    var each: args.Values = args.values(r.line, ?F_OPERAND);
    d.count = 0;
    for {
        val opt_hit: opt[args.Hit] = args.next_value(?each);
        if (sel opt_hit.none) { brk; }
        if (!declared(r, ?o.t, opt_hit.some.value, ?d)) {
            context.output_dnit(?o);
            ret render.USER;
        }
    }

    context.begin(r, path);
    var a: assembly.Assembly;
    assembly.init(r, ?a);
    var file: mink_object.Object;
    var exit: render.Exit = assembly.load(r, ?a, path);
    if (exit == render.SUCCESS) { exit = encoded(r, ?a, formats, ?o, path, ?d, ?file); }
    if (exit == render.SUCCESS) { exit = assembly.written(r, formats, ?o, ?file, out); }

    assembly.dnit(?a);
    context.output_dnit(?o);
    ret exit;
}

# the block the assembly holds, read from the file `path`, parsed with the operands `d` and encoded at the start of the
# object's first section into `out`
fun encoded(r: *Run, a: *assembly.Assembly, formats: *mink_registry.Registry, o: *context.Output, path: str, d: *Declared, out: *mink_object.Object) render.Exit {
    val text_of:    View                                  = View{data: a.source.data, len: a.source.len};
    val res_parsed: res[inline.Block, inline.Diagnostics] = inline.parse(r.a, text_of, diagnostic.START, o.t.set, ?o.t.context, o.format, inline.Operands{at: ?d.operands[0], len: d.count::u32});
    if (sel res_parsed.err) {
        var i: u32 = 0;
        for (i < res_parsed.err.len) {
            context.diagnosed(r, "inline.refused", path, a.source.data, a.source.len, ?o.t.context, ?res_parsed.err.at[i]);
            i = i + 1;
        }
        inline.diagnostics_dnit(r.a, res_parsed.err);
        assembly.unparsed(r, a);
        ret render.USER;
    }

    var block: inline.Block = res_parsed.ok;
    var m:     model.Assembler;
    val begun: render.Exit  = assembly.begun(r, a, o, formats, path, model.NO_LAYERS, ?m);
    if (begun != render.SUCCESS) {
        inline.dnit(?block);
        ret begun;
    }

    val b:        *build_state.Builder       = model.builder(?m);
    val err_done: err[build_refusal.Refusal] = inline.encode(?block, inline.Locations{at: ?d.locations[0], len: d.count::u32}, b, nil, nil);
    inline.dnit(?block);
    var exit: render.Exit = render.SUCCESS;
    if (sel err_done.err) {
        unencoded(r, b, path, ?err_done.err);
        assembly.unparsed(r, a);
        exit = render.USER;
    }
    or {
        val res_finished: res[*mink_object.Object, render.Exit] = assembly.finish(r, a, ?m, path);
        if (sel res_finished.err) { exit = res_finished.err; }
        or                        { exit = assembly.taken(r, a, ?m, path, out); }
    }
    model.dnit(?m);
    ret exit;
}

# the builder's refusal `why` to encode the block of the file `path`, worded by the emit api
fun unencoded(r: *Run, b: *build_state.Builder, path: str, why: *build_refusal.Refusal) {
    val t: *text.Text = context.error(r);
    render.begin(t, "inline.encode");
    if (!t.failed) {
        val err_spelled: err[A.Error] = emit.spell(b, why, ?t.out);
        if (sel err_spelled.err) { t.failed = true; }
    }
    text.put(t, " in '");
    text.put(t, path);
    text.put(t, "'\n");
}
