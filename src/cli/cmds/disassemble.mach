# `masc disassemble`: print an object file as assembly source

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use std.args;
use std.collections.vector;

use mink.base.fail;
use mink_arch: mink.catalog.arch;
use mink.catalog.trait;
use mink_registry: mink.format.registry;
use mink_object:   mink.model.object;

use masc.cli.context;
use masc.cli.context.Run;
use masc.core.set;
use masc.disasm.disasm;
use masc.format.dialect;
use masc.tool.object;
use masc.tool.render;
use masc.tool.target;
use masc.tool.text;

val F_ALIASES: args.FlagSpec = args.FlagSpec{name: "--aliases", value: "", arity: args.ARITY_FLAG, doc: "print an instruction by its preferred alias", default: "on, --no-aliases prints every instruction by its own form", negatable: true, occurs: args.Occurs.once{}, alias_of: nil};

val ROWS:   [9]*args.FlagSpec = [9]*args.FlagSpec{?context.F_ARCH, ?context.A_ARCH, ?context.F_ISA, ?context.F_SYNTAX, ?F_ALIASES, ?context.F_OUTPUT, ?context.A_OUTPUT, ?context.F_VERBOSE, ?context.A_VERBOSE};
val TABLES: [1]args.TableRef  = [1]args.TableRef{args.TableRef{rows: ?ROWS[0], n: 9, accepted: nil, docs: nil}};

pub val SPEC: args.CommandSpec = args.CommandSpec{
    name:            "disassemble",
    id:              0,
    aliases:         nil,
    alias_n:         0,
    grammar:         " <input> --arch <arch>",
    summary:         "print an object file as assembly source",
    effect:          "read the object file through mink and print it as source that assembles back to the same sections, on stdout or to -o",
    exits:           nil,
    exit_n:          0,
    terminator:      "",
    tables:          ?TABLES[0],
    table_n:         1,
    refused:         nil,
    refused_n:       0,
    refusal:         "",
    relations:       nil,
    relation_n:      0,
    constraints:     nil,
    constraint_n:    0,
    operand_min:     1,
    operand_max:     1,
    truncate_at_sep: false,
    actions:         nil,
    action_n:        0,
    examples:        nil,
    example_n:       0,
};

pub fun run(r: *Run) render.Exit {
    ret context.with_formats(r, disassemble_with);
}

# whether instructions print by their preferred alias: on unless --no-aliases
fun aliases(r: *Run) res[bool, args.Misread] {
    val on: res[bool, args.Misread] = args.on(?r.line, ?F_ALIASES);
    if (sel on.err) { ret on; }

    ret res[bool, args.Misread].ok{!args.given(?r.line, ?F_ALIASES) || on.ok};
}

# how instructions are spelled: by their preferred alias unless --no-aliases
fun spelling(aliased: bool) disasm.Spelling {
    if (aliased) { ret disasm.ALIASES; }
    ret disasm.FORMS;
}

fun disassemble_with(r: *Run, formats: *mink_registry.Registry) render.Exit {
    val path:    str                     = context.operand(r, 0);
    val written: res[str, args.Misread]  = args.value(?r.line, ?context.F_OUTPUT);
    val aliased: res[bool, args.Misread] = aliases(r);
    val verbose: res[bool, args.Misread] = args.on(?r.line, ?context.F_VERBOSE);
    if (sel written.err) { ret context.misread(r, written.err); }
    if (sel aliased.err) { ret context.misread(r, aliased.err); }
    if (sel verbose.err) { ret context.misread(r, verbose.err); }

    val output: str              = written.ok;
    var t:      target.Target;
    val opened: opt[render.Exit] = context.open_target(r, false, ?t);
    if (sel opened.some) { ret opened.some; }

    val got: res[disasm.File, fail.Fail] = disasm.open(formats, r.a, path);
    if (sel got.err) {
        target.release(?t);
        ret context.failed(r, "object.read", got.err);
    }

    var f:      disasm.File                           = got.ok;
    val spoken: res[*dialect.Dialect, object.Refusal] = object.dialect_of(f.format, t.arch);
    if (sel spoken.err) {
        val shut: err[fail.Fail] = disasm.close(?f);
        target.release(?t);
        ret context.refuse_object(r, spoken.err);
    }

    # the listing goes to stdout, or is gathered here when it goes to a file
    var printed: vector.Vector[u8]  = vector.init[u8](r.a);
    var into:    *vector.Vector[u8] = ?r.out.out;
    if (output != nil) { into = ?printed; }

    val options: disasm.Options      = disasm.Options{syntax: t.syntax, spelling: spelling(aliased.ok), dialect: spoken.ok, formats: formats};
    val done:    err[disasm.Refusal] = disasm.disassemble(r.a, t.set, ?t.context, options, ?f.object, into);
    var exit:    render.Exit         = render.SUCCESS;
    if (sel done.err) {
        render.unprinted(?r.err, "disasm.refused", path, ?f.object, ?done.err);
        exit = render.USER;
    }
    or (!unwritten(r, t.set, path, ?f.object)) {
        render.headline(?r.err, "cli.memory", "out of memory");
        exit = render.INTERNAL;
    }
    or (output != nil) {
        exit = context.save_text(r, output, printed.data, printed.len);
        if (exit == render.SUCCESS && verbose.ok) {
            text.put(?r.out, path);
            text.put(?r.out, ": ");
            text.decimal(?r.out, printed.len::i64);
            text.put(?r.out, " bytes of source, written to ");
            text.put(?r.out, output);
            text.byte(?r.out, '\n');
        }
    }

    vector.dnit[u8](?printed);
    val closed: err[fail.Fail] = disasm.close(?f);
    target.release(?t);
    if (sel closed.err) {
        if (exit == render.SUCCESS) { ret context.failed(r, "object.read", closed.err); }
    }

    ret exit;
}

# the traits of object `o` of file `path` that its disassembly does not state, noted on stderr, false when memory ran out
fun unwritten(r: *Run, s: *set.Set, path: str, o: *mink_object.Object) bool {
    var rows: vector.Vector[trait.Trait]               = vector.init[trait.Trait](r.a);
    val left: res[opt[*mink_arch.Abi], disasm.Refusal] = disasm.unwritten(s, o, ?rows);
    if (sel left.ok) { render.unwritten(?r.err, path, left.ok, ?rows); }

    vector.dnit[trait.Trait](?rows);
    ret sel left.ok;
}
