# `masc isas`: list the registered instruction sets, with the architectures
# each serves, its syntaxes and its levels
#
# a listing, so one table under one header row on stdout at every level: a
# row per set, its architectures by their names in mink's catalog, then its
# syntaxes with the established one first and its levels, each read from the
# set's own rows, comma-joined, `-` for a list with no members.
#
#     arches                             syntaxes  levels
#     riscv64,riscv32,riscv64e,riscv32e  riscv     rv32i,rv64i,rv64gc,...

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.args;
use std.collections.slice.Slice;
use std.collections.vector;

use masc.cli.context;
use masc.cli.context.Run;
use masc.cli.layout;
use masc.core.set;
use masc.isa;
use masc.tool.render;
use masc.tool.text;
use masc.tool.text.Text;

val FLAG_COUNT: usize                  = 1;
val FLAGS:      [FLAG_COUNT]*args.Flag = [FLAG_COUNT]*args.Flag{?context.HELP};

pub val COMMAND: args.Command = args.Command{
    name:        "isas",
    help:        "list the registered instruction sets",
    usage:       nil,
    flags:       Slice[*args.Flag]{data: ?FLAGS[0], size: FLAG_COUNT},
    operand_min: 0,
    operand_max: 0,
};

# the listing's columns and their header row
val COLUMNS: usize        = 3;
val HEADS:   [COLUMNS]str = [COLUMNS]str{"arches", "syntaxes", "levels"};

# the cell of set `s` in column `c` written into `t` and ended with a nul, its names comma-joined, `-` for none
fun cell(t: *Text, s: *set.Set, c: usize) {
    var n: u32 = 0;
    if (c == 0) { n = s.arches.len; }
    or (c == 1) { n = s.syntaxes.len; }
    or          { n = s.extensions.level_count; }
    if (n == 0) { text.byte(t, '-'); }
    var k: u32 = 0;
    for (k < n) {
        if (k > 0)  { text.byte(t, ','); }
        if (c == 0) { text.put(t, s.arches.at[k].arch.name); }
        or (c == 1) { text.put(t, s.syntaxes.at[k].name); }
        or          { text.put(t, s.extensions.levels[k].name); }
        k = k + 1;
    }
    text.byte(t, 0);
}

# the registered instruction sets, the architectures each serves, its syntaxes and its levels, listed on stdout
# ---
# r:   the run, its line read against this command
# ret: the command's exit code
pub fun run(r: *Run) render.Exit {
    # every cell is written first, so the columns fit the widest before a row is
    var cells: Text                 = text.init(r.a);
    var at:    vector.Vector[usize] = vector.init[usize](r.a);
    var full:  bool                 = true;
    var i:     u32                  = 0;
    for (i < isa.REGISTRY.count && full) {
        var c: usize = 0;
        for (c < COLUMNS) {
            val res_pushed: res[usize, A.Error] = vector.push[usize](?at, cells.out.len);
            if (sel res_pushed.err) { full = false; }
            cell(?cells, isa.REGISTRY.sets[i], c);
            c = c + 1;
        }
        i = i + 1;
    }

    var exit: render.Exit = render.SUCCESS;
    if (!full || cells.failed) { exit = context.memory(r); }
    or                         { listed(r, ?cells, ?at); }
    text.dnit(?cells);
    vector.dnit[usize](?at);
    ret exit;
}

# the header row and a row per set, the cells `at` places in `cells`, on stdout
fun listed(r: *Run, cells: *Text, at: *vector.Vector[usize]) {
    var cols: [COLUMNS]layout.Column = [COLUMNS]layout.Column{
        layout.Column{width: 0, align: layout.LEFT, gap: 0},
        layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP},
        layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP},
    };
    var c: usize = 0;
    for (c < COLUMNS) {
        layout.fit(?cols[c], HEADS[c]);
        c = c + 1;
    }
    var k: usize = 0;
    for (k < at.len) {
        layout.fit(?cols[k % COLUMNS], (?cells.out.data[at.data[k]])::str);
        k = k + 1;
    }

    val t: *Text = context.stdout(r);
    layout.row(t, ?cols[0], ?HEADS[0], COLUMNS);
    var row: usize = 0;
    for (row * COLUMNS < at.len) {
        var texts: [COLUMNS]str;
        c = 0;
        for (c < COLUMNS) {
            texts[c] = (?cells.out.data[at.data[row * COLUMNS + c]])::str;
            c        = c + 1;
        }
        layout.row(t, ?cols[0], ?texts[0], COLUMNS);
        row = row + 1;
    }
}
