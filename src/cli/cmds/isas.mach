# `masc isas`: list the registered instruction sets, with the architectures
# each serves, its syntaxes and its levels
#
# one block per set: the architectures it serves by their names in mink's
# catalog, then its syntaxes with the established one first and its levels,
# each read from the set's own rows, `-` for a list with no members.
#
#     riscv64 riscv32
#       syntaxes: riscv
#       levels:   rv32i rv64i rv64gc ...

use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.args;
use std.collections.slice.Slice;

use masc.cli.context;
use masc.cli.context.Run;
use masc.cli.report;
use masc.core.set;
use masc.isa;
use masc.tool.render;
use masc.tool.text;
use masc.tool.text.Text;

val FLAG_COUNT: usize                  = 1;
val FLAGS:      [FLAG_COUNT]*args.Flag = [FLAG_COUNT]*args.Flag{?context.HELP};

pub val COMMAND: args.Command = args.Command{
    name:        "isas",
    help:        "list the registered instruction sets",
    usage:       nil,
    flags:       Slice[*args.Flag]{data: ?FLAGS[0], size: FLAG_COUNT},
    operand_min: 0,
    operand_max: 0,
};

# the labels of a set's rows, under its architectures
val SYNTAXES: str = "syntaxes:";
val LEVELS:   str = "levels:";

# the registered instruction sets, the architectures each serves, its syntaxes and its levels, described on stdout
# ---
# r:   the run, its line read against this command
# ret: the command's exit code
pub fun run(r: *Run) render.Exit {
    var width: usize = str_len(SYNTAXES);
    if (str_len(LEVELS) > width) { width = str_len(LEVELS); }
    val t: *Text = ?r.out;
    var i: u32   = 0;
    for (i < isa.REGISTRY.count) {
        val s: *set.Set = isa.REGISTRY.sets[i];
        var k: u32      = 0;
        for (k < s.arches.len) {
            if (k > 0) { text.byte(t, ' '); }
            text.put(t, s.arches.at[k].arch.name);
            k = k + 1;
        }
        text.put(t, "\n  ");
        report.label(t, SYNTAXES, width);
        if (s.syntaxes.len == 0) { text.byte(t, '-'); }
        k = 0;
        for (k < s.syntaxes.len) {
            if (k > 0) { text.byte(t, ' '); }
            text.put(t, s.syntaxes.at[k].name);
            k = k + 1;
        }
        text.put(t, "\n  ");
        report.label(t, LEVELS, width);
        if (s.extensions.level_count == 0) { text.byte(t, '-'); }
        k = 0;
        for (k < s.extensions.level_count) {
            if (k > 0) { text.byte(t, ' '); }
            text.put(t, s.extensions.levels[k].name);
            k = k + 1;
        }
        text.byte(t, '\n');
        i = i + 1;
    }
    ret render.SUCCESS;
}
