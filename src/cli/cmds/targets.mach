# `masc targets`: list the instruction sets `--arch` names, with their
# syntaxes and levels

use std.types.bool.false;

use std.args;

use masc.cli.context;
use masc.cli.context.Run;
use masc.isa.isa;
use masc.tool.info;
use masc.tool.render;

pub val SPEC: args.CommandSpec = args.CommandSpec{
    name:            "targets",
    id:              0,
    aliases:         nil,
    alias_n:         0,
    grammar:         "",
    summary:         "list the registered instruction sets with their syntaxes and levels",
    effect:          "list every registered instruction set: the architectures it serves, its syntaxes and its levels",
    exits:           nil,
    exit_n:          0,
    terminator:      "",
    tables:          nil,
    table_n:         0,
    refused:         nil,
    refused_n:       0,
    refusal:         "",
    relations:       nil,
    relation_n:      0,
    constraints:     nil,
    constraint_n:    0,
    operand_min:     0,
    operand_max:     0,
    truncate_at_sep: false,
    actions:         nil,
    action_n:        0,
    examples:        nil,
    example_n:       0,
};

pub fun run(r: *Run) render.Exit {
    info.describe(?isa.REGISTRY, ?r.out);
    ret render.SUCCESS;
}
