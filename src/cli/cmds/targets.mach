# `masc targets`: list the registered instruction sets, with their
# syntaxes and levels

use std.types.size.usize;

use std.args;
use std.collections.slice.Slice;

use masc.cli.context;
use masc.cli.context.Run;
use masc.isa.isa;
use masc.tool.info;
use masc.tool.render;

val FLAG_COUNT: usize                  = 1;
val FLAGS:      [FLAG_COUNT]*args.Flag = [FLAG_COUNT]*args.Flag{?context.HELP};

pub val COMMAND: args.Command = args.Command{
    name:        "targets",
    help:        "list every registered instruction set: the architectures it serves, its syntaxes and its levels",
    usage:       nil,
    flags:       Slice[*args.Flag]{data: ?FLAGS[0], size: FLAG_COUNT},
    operand_min: 0,
    operand_max: 0,
};

pub fun run(r: *Run) render.Exit {
    info.describe(?isa.REGISTRY, ?r.out);
    ret render.SUCCESS;
}
