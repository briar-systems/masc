# `masc targets`: list the instruction sets `--arch` names, with their
# syntaxes and levels

use std.args;

use masc.cli.context;
use masc.cli.context.Run;
use masc.isa.isa;
use masc.tool.help;
use masc.tool.info;
use masc.tool.render;

val FLAGS: [1]*args.Flag = [1]*args.Flag{?context.F_HELP};

pub val PAGE: help.Page = help.Page{
    name:    "targets",
    summary: "list the registered instruction sets with their syntaxes and levels",
    usage:   "targets",
    effect:  "list every registered instruction set: the architectures it serves, its syntaxes and its levels",
    flags:   ?FLAGS[0],
    count:   1,
};

pub fun run(r: *Run) render.Exit {
    info.describe(?isa.REGISTRY, ?r.out);
    ret render.SUCCESS;
}
