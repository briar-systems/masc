# `masc assemble`: assemble a source file into an object file

use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.args;
use std.collections.slice.Slice;
use std.collections.vector;

use mink_registry: mink.format.registry;
use mink_object:   mink.model.object;

use masc.asm;
use masc.asm.cfi;
use masc.asm.line;
use masc.asm.model;
use masc.asm.seh;
use masc.cli.context;
use masc.cli.context.Run;
use masc.core.diagnostic;
use masc.tool.object;
use masc.tool.render;
use masc.tool.target;
use masc.tool.text;

val FLAG_COUNT: usize                  = 11;
val FLAGS:      [FLAG_COUNT]*args.Flag = [FLAG_COUNT]*args.Flag{?context.HELP, ?context.TARGET, ?context.ENV, ?context.ABI, ?context.ISA, ?context.EXT, ?context.CODE_MODEL, ?context.SYNTAX, ?context.OUTPUT, ?context.VERBOSE, ?context.QUIET};

pub val COMMAND: args.Command = args.Command{
    name:        "assemble",
    help:        "assemble a source file into an object file",
    usage:       "<input> -t <sys-arch> -o <path>",
    flags:       Slice[*args.Flag]{data: ?FLAGS[0], size: FLAG_COUNT},
    operand_min: 1,
    operand_max: 1,
};

pub fun run(r: *Run) render.Exit {
    ret assemble_with(r, mink_registry.builtin());
}

fun assemble_with(r: *Run, formats: *mink_registry.Registry) render.Exit {
    val path:    str  = context.operand(r, 0);
    val out:     str  = args.value(r.line, ?context.OUTPUT);
    val verbose: bool = context.verbosity(r) > 0;
    if (out == nil) { ret context.refuse(r, "cli.flag_missing", "the command needs the flag", "--output"); }

    var o:      context.Output;
    val opened: opt[render.Exit] = context.open_output(r, ?o);
    if (sel opened.some) { ret opened.some; }

    var source: vector.Vector[u8];
    if (!context.load(r, path, ?source)) {
        context.release_output(?o);
        ret render.ENVIRONMENT;
    }

    # the line, call frame and windows unwind directives layered over the assembly
    var lines:  line.Context                           = line.make(r.a);
    var over:   model.Layer                            = line.layer(?lines);
    var frames: cfi.Text                               = cfi.make();
    var framed: model.Layer                            = cfi.layer(?frames);
    var codes:  seh.Text                               = seh.make();
    var coded:  model.Layer                            = seh.layer(?codes);
    var layers: [3]*model.Layer                        = [3]*model.Layer{?over, ?framed, ?coded};
    val built:  res[mink_object.Object, model.Refusal] = asm.assembled(r.a, o.t.set, ?o.t.context, target.assembler(?o.t, formats, o.dialect, model.Layers{at: ?layers[0], len: 3}, path), source.data, source.len, diagnostic.START);
    line.release(?lines);
    if (sel built.err) {
        context.refused_source(r, path, source.data, source.len, ?built.err);
        vector.dnit[u8](?source);
        context.release_output(?o);
        ret render.USER;
    }

    var file: mink_object.Object = built.ok;
    val exit: render.Exit        = context.saved_object(r, formats, ?file, o.format, path, out, verbose);

    vector.dnit[u8](?source);
    context.release_output(?o);
    ret exit;
}
