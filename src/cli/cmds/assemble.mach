# `masc assemble`: assemble a source file into an object file

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.args;
use std.collections.vector;
use fs: std.filesystem;

use mink.base.fail;
use mink.base.table;
use mink.bytes.sink;
use mink_format:   mink.catalog.format;
use mink_registry: mink.format.registry;
use mink_object:   mink.model.object;

use masc.asm.asm;
use masc.asm.cfi;
use masc.asm.line;
use masc.asm.model;
use masc.asm.seh;
use masc.cli.context;
use masc.cli.context.Run;
use masc.core.diagnostic;
use masc.format.dialect;
use masc.isa.isa;
use masc.tool.help;
use masc.tool.object;
use masc.tool.render;
use masc.tool.target;
use masc.tool.text;

val F_FORMAT: args.Flag = args.Flag{name: "--format", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "name", doc: "the object format, by its name in mink's catalog, when several name the architecture"};

val FLAGS: [8]*args.Flag = [8]*args.Flag{?context.F_TARGET, ?context.F_ISA, ?context.F_SYNTAX, ?context.F_ABI, ?F_FORMAT, ?context.F_OUTPUT, ?context.F_VERBOSE, ?context.F_HELP};

pub val PAGE: help.Page = help.Page{
    name:    "assemble",
    summary: "assemble a source file into an object file",
    usage:   "assemble <input> --target <arch> --isa <selection> -o <path> [options]",
    effect:  "assemble the source file into mink's neutral object and write it in the target's object format",
    flags:   ?FLAGS[0],
    count:   8,
};

pub fun run(r: *Run) render.Exit {
    ret context.with_formats(r, assemble_with);
}

fun assemble_with(r: *Run, formats: *mink_registry.Registry) render.Exit {
    val path:    str                     = r.operands[0];
    val output:  res[str, args.Misread]  = args.value(r.reader, ?context.F_OUTPUT);
    val named:   res[str, args.Misread]  = args.value(r.reader, ?F_FORMAT);
    val verbose: res[bool, args.Misread] = args.on(r.reader, ?context.F_VERBOSE);
    if (sel output.err)  { ret context.misread(r, output.err); }
    if (sel named.err)   { ret context.misread(r, named.err); }
    if (sel verbose.err) { ret context.misread(r, verbose.err); }

    val out: str = output.ok;
    if (out == nil) { ret context.refuse(r, "cli.flag_missing", "the command needs the flag", "--output"); }

    val made: res[target.Request, args.Misread] = context.request_of(r, true);
    if (sel made.err) { ret context.misread(r, made.err); }

    val q:      target.Request      = made.ok;
    var t:      target.Target;
    val opened: err[target.Refusal] = target.open(r.a, ?isa.REGISTRY, q, ?t);
    if (sel opened.err) { ret context.refuse_target(r, opened.err, q.selection); }

    val defaulted: err[target.Refusal] = target.default_abi(r.a, ?t);
    if (sel defaulted.err) {
        target.release(?t);
        ret context.refuse_target(r, defaulted.err, q.selection);
    }

    val format: res[*mink_format.Format, object.Refusal] = object.format_for(formats, t.arch, named.ok);
    if (sel format.err) {
        target.release(?t);
        ret context.refuse_object(r, format.err);
    }

    val spoken: res[*dialect.Dialect, object.Refusal] = object.dialect_of(format.ok, t.arch);
    if (sel spoken.err) {
        target.release(?t);
        ret context.refuse_object(r, spoken.err);
    }

    val loaded: res[vector.Vector[u8], fs.FsError] = fs.read_bytes(r.a, path);
    if (sel loaded.err) {
        target.release(?t);
        render.quoted(?r.err, "io.read", "cannot read the file", path);
        ret render.ENVIRONMENT;
    }

    # the line, call frame and windows unwind directives layered over the assembly
    var source: vector.Vector[u8]                 = loaded.ok;
    var lines:  line.Context                      = line.make(r.a);
    var over:   model.Layer                       = line.layer(?lines);
    var frames: cfi.Text                          = cfi.make();
    var framed: model.Layer                       = cfi.layer(?frames);
    var codes:  seh.Text                          = seh.make();
    var coded:  model.Layer                       = seh.layer(?codes);
    var layers: [3]*model.Layer                   = [3]*model.Layer{?over, ?framed, ?coded};
    val built:  res[asm.Assembled, model.Refusal] = asm.assembled(r.a, t.set, ?t.context, target.assembler(?t, formats, spoken.ok, model.Layers{at: ?layers[0], len: 3}), source.data, source.len, diagnostic.START);
    line.release(?lines);
    if (sel built.err) {
        refused(r, path, source.data, source.len, ?built.err);
        vector.dnit[u8](?source);
        target.release(?t);
        ret render.USER;
    }

    var file: asm.Assembled = built.ok;
    var exit: render.Exit   = render.SUCCESS;
    if (sel file.object) { exit = saved_object(r, formats, ?file.object, format.ok, path, out, verbose.ok); }
    or (sel file.module) { exit = saved_module(r, ?file.module, format.ok, path, out, verbose.ok); }

    vector.dnit[u8](?source);
    target.release(?t);
    ret exit;
}

# the refusal `why` to assemble `src[0..len]`, the file `path`
fun refused(r: *Run, path: str, src: *u8, len: usize, why: *model.Refusal) {
    if (sel why.mode.some) {
        render.mode(?r.err, "asm.mode", ?why.mode.some);
        ret;
    }
    render.refusal(?r.err, "asm.refused", path, src, len, why.message, why.span, ?why.unmet);
    if (sel why.cause.some) { render.failure(?r.err, "asm.cause", why.cause.some); }
}

# the object `o` assembled from the file `path` written as a file of format `f` at `out`, which it releases, its counts
# noted when `verbose`
fun saved_object(r: *Run, formats: *mink_registry.Registry, o: *mink_object.Object, f: *mink_format.Format, path: str, out: str, verbose: bool) render.Exit {
    val saved: err[fail.Fail] = object.save(formats, r.a, o, f, out);
    var exit:  render.Exit    = render.SUCCESS;
    if (sel saved.err) { exit = context.failed(r, "object.write", saved.err); }
    or (verbose) {
        text.put(?r.out, path);
        text.put(?r.out, ": ");
        text.decimal(?r.out, table.count[mink_object.Section](?o.sections)::i64);
        text.put(?r.out, " sections, ");
        text.decimal(?r.out, table.count[mink_object.Symbol](?o.symbols)::i64);
        text.put(?r.out, " symbols, ");
        text.decimal(?r.out, table.count[mink_object.Reloc](?o.relocs)::i64);
        text.put(?r.out, " relocations, written to ");
        wrote(r, out, f);
    }

    mink_object.release(o);
    ret exit;
}

# the bytes `module` of the module of format `f` the file `path` states written at `out`, which it releases, their
# count noted when `verbose`
fun saved_module(r: *Run, module: *sink.Sink, f: *mink_format.Format, path: str, out: str, verbose: bool) render.Exit {
    val saved: err[fail.Fail] = object.save_module(module, out);
    var exit:  render.Exit    = render.SUCCESS;
    if (sel saved.err) { exit = context.failed(r, "object.write", saved.err); }
    or (verbose) {
        text.put(?r.out, path);
        text.put(?r.out, ": ");
        text.decimal(?r.out, sink.len(module)::i64);
        text.put(?r.out, " bytes of module, written to ");
        wrote(r, out, f);
    }

    val released: err[fail.Fail] = sink.release(module);
    ret exit;
}

# the tail of a verbose line: the file `out` written in format `f`
fun wrote(r: *Run, out: str, f: *mink_format.Format) {
    text.put(?r.out, out);
    text.put(?r.out, " as ");
    text.put(?r.out, f.name);
    text.byte(?r.out, '\n');
}
