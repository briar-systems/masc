# `masc assemble`: assemble a source file into an object file

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use std.args;
use std.collections.vector;

use mink.base.fail;
use mink.bytes.sink;
use mink_format:   mink.catalog.format;
use mink_registry: mink.format.registry;

use masc.asm.asm;
use masc.asm.cfi;
use masc.asm.line;
use masc.asm.model;
use masc.asm.seh;
use masc.cli.context;
use masc.cli.context.Run;
use masc.core.diagnostic;
use masc.tool.object;
use masc.tool.render;
use masc.tool.target;
use masc.tool.text;

val ROWS:   [10]*args.FlagSpec = [10]*args.FlagSpec{?context.F_ARCH, ?context.A_ARCH, ?context.F_ISA, ?context.F_SYNTAX, ?context.F_ABI, ?context.F_FORMAT, ?context.F_OUTPUT, ?context.A_OUTPUT, ?context.F_VERBOSE, ?context.A_VERBOSE};
val TABLES: [1]args.TableRef   = [1]args.TableRef{args.TableRef{rows: ?ROWS[0], n: 10, accepted: nil, docs: nil}};

pub val SPEC: args.CommandSpec = args.CommandSpec{
    name:            "assemble",
    id:              0,
    aliases:         nil,
    alias_n:         0,
    grammar:         " <input> --arch <arch> -o <path>",
    summary:         "assemble a source file into an object file",
    effect:          "assemble the source file into mink's neutral object and write it in the target's object format",
    exits:           nil,
    exit_n:          0,
    terminator:      "",
    tables:          ?TABLES[0],
    table_n:         1,
    refused:         nil,
    refused_n:       0,
    refusal:         "",
    relations:       nil,
    relation_n:      0,
    constraints:     nil,
    constraint_n:    0,
    operand_min:     1,
    operand_max:     1,
    truncate_at_sep: false,
    actions:         nil,
    action_n:        0,
    examples:        nil,
    example_n:       0,
};

pub fun run(r: *Run) render.Exit {
    ret context.with_formats(r, assemble_with);
}

fun assemble_with(r: *Run, formats: *mink_registry.Registry) render.Exit {
    val path:    str                     = context.operand(r, 0);
    val output:  res[str, args.Misread]  = args.value(?r.line, ?context.F_OUTPUT);
    val verbose: res[bool, args.Misread] = args.on(?r.line, ?context.F_VERBOSE);
    if (sel output.err)  { ret context.misread(r, output.err); }
    if (sel verbose.err) { ret context.misread(r, verbose.err); }

    val out: str = output.ok;
    if (out == nil) { ret context.refuse(r, "cli.flag_missing", "the command needs the flag", "--output"); }

    var o:      context.Output;
    val opened: opt[render.Exit] = context.open_output(r, formats, ?o);
    if (sel opened.some) { ret opened.some; }

    var source: vector.Vector[u8];
    if (!context.load(r, path, ?source)) {
        context.release_output(?o);
        ret render.ENVIRONMENT;
    }

    # the line, call frame and windows unwind directives layered over the assembly
    var lines:  line.Context                      = line.make(r.a);
    var over:   model.Layer                       = line.layer(?lines);
    var frames: cfi.Text                          = cfi.make();
    var framed: model.Layer                       = cfi.layer(?frames);
    var codes:  seh.Text                          = seh.make();
    var coded:  model.Layer                       = seh.layer(?codes);
    var layers: [3]*model.Layer                   = [3]*model.Layer{?over, ?framed, ?coded};
    val built:  res[asm.Assembled, model.Refusal] = asm.assembled(r.a, o.t.set, ?o.t.context, target.assembler(?o.t, formats, o.dialect, model.Layers{at: ?layers[0], len: 3}), source.data, source.len, diagnostic.START);
    line.release(?lines);
    if (sel built.err) {
        context.refused_source(r, path, source.data, source.len, ?built.err);
        vector.dnit[u8](?source);
        context.release_output(?o);
        ret render.USER;
    }

    var file: asm.Assembled = built.ok;
    var exit: render.Exit   = render.SUCCESS;
    if (sel file.object) { exit = context.saved_object(r, formats, ?file.object, o.format, path, out, verbose.ok); }
    or (sel file.module) { exit = saved_module(r, ?file.module, o.format, path, out, verbose.ok); }

    vector.dnit[u8](?source);
    context.release_output(?o);
    ret exit;
}

# the bytes `module` of the module of format `f` the file `path` states written at `out`, which it releases, their
# count noted when `verbose`
fun saved_module(r: *Run, module: *sink.Sink, f: *mink_format.Format, path: str, out: str, verbose: bool) render.Exit {
    val saved: err[fail.Fail] = object.save_module(module, out);
    var exit:  render.Exit    = render.SUCCESS;
    if (sel saved.err) { exit = context.failed(r, "object.write", saved.err); }
    or (verbose) {
        text.put(?r.out, path);
        text.put(?r.out, ": ");
        text.decimal(?r.out, sink.len(module)::i64);
        text.put(?r.out, " bytes of module, written to ");
        context.wrote(r, out, f);
    }

    val released: err[fail.Fail] = sink.release(module);
    ret exit;
}
