# the registration of instruction sets, one module per set beside this one
#
# the registry lists every set's record, one line each, and is read by
# architecture through `find`. it lives above the core because it names every
# set module, and each set module builds on the core.
#
# it also checks a target mink's catalog resolved against the set serving its
# architecture: mink checks the target's spelling and rows, and masc owns the
# extension names, conflicts and implications of its instruction set, so a
# tool runs `check` once, right after mink's `resolve`, reads its refusal as it
# reads one of `resolve`, and keeps the closed selection it gives.

use std.print;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;

use mink.base.fail;
use mink_arch:   mink.catalog.arch;
use mink_target: mink.catalog.target;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.operand;
use masc.core.quantity;
use masc.core.register;
use masc.core.row;
use masc.core.set;

use aarch64_set: masc.isa.aarch64.set;
use riscv_set:   masc.isa.riscv.set;
use spirv_set:   masc.isa.spirv.set;
use wasm_set:    masc.isa.wasm.set;
use x86_set:     masc.isa.x86.set;

# every registered instruction set
val SETS: [5]*set.Set = [5]*set.Set{?riscv_set.SET, ?x86_set.SET, ?wasm_set.SET, ?spirv_set.SET, ?aarch64_set.SET};

# registered sets, each held by pointer
pub rec Registry {
    sets:  **set.Set;
    count: u32;
}

pub val REGISTRY: Registry = Registry{sets: ?SETS[0], count: 5};

# the set of `registry` serving `arch`
pub fun find(registry: *Registry, arch: *mink_arch.Arch) opt[*set.Set] {
    var i: u32 = 0;
    for (i < registry.count) {
        val s:       *set.Set       = registry.sets[i];
        val opt_row: opt[*set.Arch] = set.arch_of(s, arch);
        if (sel opt_row.some) { ret opt[*set.Set].some{s}; }
        i = i + 1;
    }
    ret opt[*set.Set].none{};
}

# which registered sets read a spelling as a selection
# ---
# none: no set reads it
# many: more than one set reads it
# one:  the one set that reads it
pub tag Reader: u8 {
    none;
    many;
    one: *set.Set;
}

# the set of `registry` whose catalog reads `spelling` as a selection, as an inline block's head names the set its
# body is written in. a spelling whose extensions conflict is read by its set all the same
pub fun reader(a: *A.Allocator, registry: *Registry, spelling: str) res[Reader, A.Error] {
    var found: Reader = Reader.none{};
    var i:     u32    = 0;
    for (i < registry.count) {
        val s: *set.Set = registry.sets[i];
        i = i + 1;
        if (s.extensions == nil) { cnt; }
        var res_chosen: res[extension.Selection, extension.Error] = extension.select(a, s.extensions, spelling, diagnostic.START);
        if (sel res_chosen.err) {
            if (sel res_chosen.err.memory)  { ret res[Reader, A.Error].err{res_chosen.err.memory}; }
            if (sel res_chosen.err.refused) { cnt; }
        }
        if (sel res_chosen.ok) {
            val err_dropped: err[A.Error] = extension.dnit(?res_chosen.ok);
            if (sel err_dropped.err) { ret res[Reader, A.Error].err{err_dropped.err}; }
        }
        if (sel found.one) { ret res[Reader, A.Error].ok{Reader.many{}}; }
        found = Reader.one{s};
    }
    ret res[Reader, A.Error].ok{found};
}

# the set serving a target's architecture and the closed selection it holds of the target's instruction set and
# extensions, which `dnit` gives back
# ---
# set:       the registered set serving the architecture
# arch:      the set's row of the architecture
# selection: the selection, closed under the catalog's implications
pub rec Checked {
    set:       *set.Set;
    arch:      *set.Arch;
    selection: extension.Selection;
}

# give back what `c` holds
pub fun dnit(c: *Checked) {
    val err_dropped: err[A.Error] = extension.dnit(?c.selection);
}

# the refusal of the target's `part`, given as `given`, for the static reason `why`, listing what `accepts` lists, in
# the shape of mink's catalog's own
fun refusal(part: mink_target.Part, given: str, why: str, accepts: opt[fail.Accepts]) fail.Fail {
    var shown: View = View{data: nil, len: 0};
    if (given != nil) { shown = View{data: given::*u8, len: str_len(given)}; }
    val r: fail.Refused = fail.Refused{part: mink_target.part_name(part), given: shown, accepts: accepts};
    ret fail.refusing(fail.in_record(fail.malformed(why), "target"), r);
}

# the name at `i` of the extension catalog `a.rows` points at, nil past the last
fun name_at(a: *fail.Accepts, i: usize) str {
    val catalog: *extension.Catalog = a.rows::*extension.Catalog;
    if (i < catalog.names.len::usize) { ret catalog.name_keys[i]; }
    ret nil;
}

# the instruction set and extensions of the target `t`, as mink's catalog resolved it, checked once against the
# catalog of the registered set serving its architecture, and the closed selection they make, held in `a`, which the
# caller releases. a tool runs it once, right after mink's `resolve`, and every later step takes the selection it
# gives rather than selecting again
# ---
# ret: the set and selection, none for an architecture no registered set serves where the target states no isa and no
#      ext, or a refusal in the shape of mink's catalog's: of part isa, for an isa the set's selection syntax refuses,
#      or one the architecture takes from no registered set, or a selection masc could not hold; of part extension, for
#      an ext the set's catalog does not name, accepting every name it does, an ext on an architecture no registered
#      set serves, or one the selection's closure holds that conflicts with another
pub fun check(a: *A.Allocator, t: *mink_target.Target) res[opt[Checked], fail.Fail] {
    val res_read: res[str, fail.Fail] = mink_target.isa(t);
    var spelling: str                 = "";
    if (sel res_read.err) {
        if (t.ext_count == 0) { ret res[opt[Checked], fail.Fail].ok{opt[Checked].none{}}; }
        ret res[opt[Checked], fail.Fail].err{res_read.err};
    }
    spelling = res_read.ok;

    var opt_found: opt[*set.Set] = opt[*set.Set].none{};
    var row:       *set.Arch     = nil;
    var i:         u32           = 0;
    for (i < REGISTRY.count && sel opt_found.none) {
        val opt_arch_of: opt[*set.Arch] = set.arch_of(REGISTRY.sets[i], t.arch);
        if (sel opt_arch_of.some) {
            opt_found = opt[*set.Set].some{REGISTRY.sets[i]};
            row       = opt_arch_of.some;
        }
        i = i + 1;
    }
    val opt_none: opt[fail.Accepts] = opt[fail.Accepts].none{};
    if (sel opt_found.none) {
        if (t.ext_count > 0)  { ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.extension{}, t.ext[0], "no instruction set is registered for the architecture", opt_none)}; }
        if (sel t.isa.stated) { ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.isa{}, spelling, "no instruction set is registered for the architecture", opt_none)}; }
        ret res[opt[Checked], fail.Fail].ok{opt[Checked].none{}};
    }

    val catalog:    *extension.Catalog                        = opt_found.some.extensions;
    val res_chosen: res[extension.Selection, extension.Added] = extension.select_adding(a, catalog, spelling, t.ext, t.ext_count::u32);
    if (sel res_chosen.ok) { ret res[opt[Checked], fail.Fail].ok{opt[Checked].some{Checked{set: opt_found.some, arch: row, selection: res_chosen.ok}}}; }

    val why: extension.Added = res_chosen.err;
    if (sel why.name) {
        val opt_names: opt[fail.Accepts] = opt[fail.Accepts].some{fail.Accepts{name: name_at, rows: catalog::ptr, key: nil, within: nil}};
        ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.extension{}, t.ext[why.name], "the architecture has no extension named {}", opt_names)};
    }

    val e: extension.Error = why.selection;
    if (sel e.refused) { ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.isa{}, spelling, e.refused.message, opt_none)}; }
    if (sel e.conflict) {
        if (e.conflict.a < catalog.count) {
            ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.extension{}, catalog.extensions[e.conflict.a].name, "{} conflicts with another extension the instruction set holds", opt_none)};
        }
        ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.isa{}, spelling, "the instruction set holds extensions that conflict", opt_none)};
    }
    ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.isa{}, spelling, "the instruction set cannot hold the selection", opt_none)};
}

# every register write a row states as a write alone, narrower than its register, states what lies above its result,
# so a write that keeps the rest of its register, which reads it, is never stated as one that does not, as x86 movss's
# of xmm once was. a class as wide as a state's multiplier, as x86's cr0 or risc-v's x registers, has no width to be
# narrower than, and a row that states no operand width, as aarch64's, states nothing this can compare
test registry__narrow_writes_state_the_rest {
    var failed: u32 = 0;
    var s:      u32 = 0;
    for (s < REGISTRY.count) {
        val st: *set.Set = REGISTRY.sets[s];
        s = s + 1;
        if (st.codec == nil || st.codec.registers == nil) { cnt; }
        val file: *register.File = st.codec.registers;
        var i:    u32            = 0;
        for (i < st.codec.rows.len) {
            val r: *row.Row = ?st.codec.rows.at[i];
            i = i + 1;
            var k: u32 = 0;
            for (k < r.operands.len) {
                val o: *operand.Operand = ?r.operands.at[k];
                k = k + 1;
                if (!(sel o.shape.register))                                                       { cnt; }
                if ((o.role & operand.READ) != 0 || (o.role & operand.WRITE) == 0 || o.width == 0) { cnt; }
                var c: u32 = 0;
                for (c < o.shape.register.classes.len) {
                    val w: quantity.Scaled = file.classes[o.shape.register.classes.at[c]].width;
                    c = c + 1;
                    if (w.per != 0 || o.width::u32 >= w.fixed) { cnt; }
                    val opt_narrowed: opt[operand.Narrowed] = operand.narrowed(?o.write, w.fixed::u64);
                    if (sel opt_narrowed.some) {
                        if (opt_narrowed.some.above == register.ZEROES || opt_narrowed.some.above == register.ONES) { cnt; }
                    }
                    print.eprintlnf("{} writes operand {} narrower than its register and states nothing above it", r.key, k - 1);
                    failed = failed + 1;
                }
            }
        }
    }
    if (failed != 0) { ret 1; }
}
