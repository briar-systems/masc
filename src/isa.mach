# the registration of instruction sets, one module per set beside this one
#
# the registry lists every set's record, one line each, and is read by
# architecture through `find`. it lives above the core because it names every
# set module, and each set module builds on the core.
#
# it also checks a target mink's catalog resolved against the set serving its
# architecture: mink checks the target's spelling and rows, and masc owns the
# extension names, conflicts and implications of its instruction set, so a
# tool runs `check` once, right after mink's `resolve`, reads its refusal as it
# reads one of `resolve`, and keeps the closed selection it gives.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;

use mink.base.fail;
use mink_arch:   mink.catalog.arch;
use mink_target: mink.catalog.target;

use masc.core.extension;
use masc.core.set;

use aarch64_set: masc.isa.aarch64.set;
use riscv_set:   masc.isa.riscv.set;
use spirv_set:   masc.isa.spirv.set;
use wasm_set:    masc.isa.wasm.set;
use x86_set:     masc.isa.x86.set;

# every registered instruction set
val SETS: [5]*set.Set = [5]*set.Set{?riscv_set.SET, ?x86_set.SET, ?wasm_set.SET, ?spirv_set.SET, ?aarch64_set.SET};

# registered sets, each held by pointer
pub rec Registry {
    sets:  **set.Set;
    count: u32;
}

pub val REGISTRY: Registry = Registry{sets: ?SETS[0], count: 5};

# the set of `registry` serving `arch`
pub fun find(registry: *Registry, arch: *mink_arch.Arch) opt[*set.Set] {
    var i: u32 = 0;
    for (i < registry.count) {
        val s:   *set.Set       = registry.sets[i];
        val row: opt[*set.Arch] = set.arch_of(s, arch);
        if (sel row.some) { ret opt[*set.Set].some{s}; }
        i = i + 1;
    }
    ret opt[*set.Set].none{};
}

# the set serving a target's architecture and the closed selection it holds of the target's instruction set and
# extensions, which `release` gives back
# ---
# set:       the registered set serving the architecture
# arch:      the set's row of the architecture
# selection: the selection, closed under the catalog's implications
pub rec Checked {
    set:       *set.Set;
    arch:      *set.Arch;
    selection: extension.Selection;
}

# give back what `c` holds
pub fun release(c: *Checked) {
    val dropped: err[A.Error] = extension.release(?c.selection);
}

# the refusal of the target's `part`, given as `given`, for the static reason `why`, listing what `accepts` lists, in
# the shape of mink's catalog's own
fun refusal(part: mink_target.Part, given: str, why: str, accepts: opt[fail.Accepts]) fail.Fail {
    var shown: View = View{data: nil, len: 0};
    if (given != nil) { shown = View{data: given::*u8, len: str_len(given)}; }
    val r: fail.Refused = fail.Refused{part: mink_target.part_name(part), given: shown, accepts: accepts};
    ret fail.refusing(fail.in_record(fail.malformed(why), "target"), r);
}

# the name at `i` of the extension catalog `a.rows` points at, nil past the last
fun name_at(a: *fail.Accepts, i: usize) str {
    val catalog: *extension.Catalog = a.rows::*extension.Catalog;
    if (i < catalog.names.len::usize) { ret catalog.name_keys[i]; }
    ret nil;
}

# the instruction set and extensions of the target `t`, as mink's catalog resolved it, checked once against the
# catalog of the registered set serving its architecture, and the closed selection they make, held in `a`, which the
# caller releases. a tool runs it once, right after mink's `resolve`, and every later step takes the selection it
# gives rather than selecting again
# ---
# ret: the set and selection, none for an architecture no registered set serves where the target states no isa and no
#      ext, or a refusal in the shape of mink's catalog's: of part isa, for an isa the set's selection syntax refuses,
#      or one the architecture takes from no registered set, or a selection masc could not hold; of part extension, for
#      an ext the set's catalog does not name, accepting every name it does, an ext on an architecture no registered
#      set serves, or one the selection's closure holds that conflicts with another
pub fun check(a: *A.Allocator, t: *mink_target.Target) res[opt[Checked], fail.Fail] {
    val read:     res[str, fail.Fail] = mink_target.isa(t);
    var spelling: str                 = "";
    if (sel read.err) {
        if (t.ext_count == 0) { ret res[opt[Checked], fail.Fail].ok{opt[Checked].none{}}; }
        ret res[opt[Checked], fail.Fail].err{read.err};
    }
    spelling = read.ok;

    var found: opt[*set.Set] = opt[*set.Set].none{};
    var row:   *set.Arch     = nil;
    var i:     u32           = 0;
    for (i < REGISTRY.count && sel found.none) {
        val got: opt[*set.Arch] = set.arch_of(REGISTRY.sets[i], t.arch);
        if (sel got.some) {
            found = opt[*set.Set].some{REGISTRY.sets[i]};
            row   = got.some;
        }
        i = i + 1;
    }
    val none: opt[fail.Accepts] = opt[fail.Accepts].none{};
    if (sel found.none) {
        if (t.ext_count > 0)  { ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.extension{}, t.ext[0], "masc registers no instruction set for the architecture", none)}; }
        if (sel t.isa.stated) { ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.isa{}, spelling, "masc registers no instruction set for the architecture", none)}; }
        ret res[opt[Checked], fail.Fail].ok{opt[Checked].none{}};
    }

    val catalog: *extension.Catalog                        = found.some.extensions;
    val chosen:  res[extension.Selection, extension.Added] = extension.select_adding(a, catalog, spelling, t.ext, t.ext_count::u32);
    if (sel chosen.ok) { ret res[opt[Checked], fail.Fail].ok{opt[Checked].some{Checked{set: found.some, arch: row, selection: chosen.ok}}}; }

    val why: extension.Added = chosen.err;
    if (sel why.name) {
        val names: opt[fail.Accepts] = opt[fail.Accepts].some{fail.Accepts{name: name_at, rows: catalog::ptr, key: nil, within: nil}};
        ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.extension{}, t.ext[why.name], "masc's catalog of the architecture names no such extension", names)};
    }

    val e: extension.Error = why.selection;
    if (sel e.refused) { ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.isa{}, spelling, e.refused.message, none)}; }
    if (sel e.conflict) {
        if (e.conflict.a < catalog.count) {
            ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.extension{}, catalog.extensions[e.conflict.a].name, "the extension conflicts with another the instruction set holds", none)};
        }
        ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.isa{}, spelling, "the instruction set holds extensions that conflict", none)};
    }
    ret res[opt[Checked], fail.Fail].err{refusal(mink_target.Part.isa{}, spelling, "masc could not hold the selection", none)};
}
