# an assembler over `s` with the core directives, the set's integer data directives and `options.layers`, its
# current section `.text`, writing under the object's context `object`, which the caller makes with `set.open` for
# `options.arch` and keeps until the assembler is released
pub fun make(a: *A.Allocator, s: *set.Set, object: *state.Context, options: model.Options) res[model.Assembler, model.Refusal] {
    val made: res[model.Assembler, model.Refusal] = model.make(a, s, object, options, ?core.LAYER, core.integers);
    if (sel made.err) { ret made; }
    var m:     model.Assembler = made.ok;
    val begun: err[str]        = core.begin(?m);
    if (sel begun.err) {
        model.release(?m);
        ret res[model.Assembler, model.Refusal].err{model.Refusal{message: begun.err, span: diagnostic.Span{start: diagnostic.START, len: 0}, site: diagnostic.START, mode: opt[build.Mismatch].none{}, unmet: state.nothing_unmet()}};
    }
    ret res[model.Assembler, model.Refusal].ok{m};
}

# the `len` bytes of `text`, whose first byte is at `origin`, assembled under the object's context `object` into mink's
# neutral object, which the caller releases
pub fun assemble(a: *A.Allocator, s: *set.Set, object: *state.Context, options: model.Options, text: *u8, len: usize, origin: diagnostic.Position) res[mink_object.Object, model.Refusal] {
    val made: res[model.Assembler, model.Refusal] = make(a, s, object, options);
    if (sel made.err) { ret res[mink_object.Object, model.Refusal].err{made.err}; }
    var m:     model.Assembler    = made.ok;
    var lexer: source.Lexer       = source.lexer(text, len, origin, ?s.source);
    var feed:  source.Feed        = source.feed(?lexer);
    val ran:   err[model.Refusal] = model.run(?m, ?feed);
    if (sel ran.err) {
        model.release(?m);
        ret res[mink_object.Object, model.Refusal].err{ran.err};
    }
    val o: res[mink_object.Object, model.Refusal] = model.finish(?m);
    model.release(?m);
    ret o;
}

# a test's allocator, selection, register view and context
#[testing]
rec T {
    t:   testing.Testing;
    s:   extension.Selection;
    v:   register.Available;
    ctx: state.Context;

    formats: registry.Registry;
}

#[testing]
fun t_make(t: *T, isa: str) bool {
    ret t_make_at(t, isa, ?riscv_set.SET.arches.at[0]);
}

# the test's context of the selection `isa` spells, opened for the set's architecture `row`
#[testing]
fun t_make_at(t: *T, isa: str, row: *set.Arch) bool {
    testing.make(?t.t);
    val a:       *A.Allocator                      = testing.allocator_of(?t.t);
    val formats: res[registry.Registry, fail.Fail] = registry.builtin(a);
    if (sel formats.err) { ret false; }
    t.formats = formats.ok;
    val made: res[extension.Selection, extension.Error] = extension.select(a, ?riscv_extension.CATALOG, isa, diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    val opened: res[state.Context, state.Opened] = set.open(a, ?riscv_set.SET, row, ?t.s, ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx = opened.ok;
    ret true;
}

#[testing]
fun t_options(t: *T) model.Options {
    ret model.Options{arch: ?arch_riscv.RISCV64, formats: ?t.formats, syntax: 0, abi: trait.t_abi(?arch_riscv.RISCV64, "lp64d"), dialect: ?dialect.ELF, layers: model.NO_LAYERS};
}

#[testing]
fun t_assemble(t: *T, text: str) res[mink_object.Object, model.Refusal] {
    ret assemble(testing.allocator_of(?t.t), ?riscv_set.SET, ?t.ctx, t_options(t), text, str_len(text), diagnostic.START);
}

# everything the test made given back, and whether nothing is left live
#[testing]
fun t_release(t: *T) bool {
    register.release(?t.v);
    extension.release(?t.s);
    val released: err[fail.Fail] = registry.release(?t.formats);
    ret !sel released.err && testing.live_count(?t.t) == 0;
}

#[testing]
fun t_done(t: *T, o: *mink_object.Object) bool {
    mink_object.release(o);
    ret t_release(t);
}

#[testing]
fun t_is(v: View, s: str) bool {
    if (v.len != str_len(s)) { ret false; }
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the index of the section of `o` named `name`, the section count for none
#[testing]
fun t_index(o: *mink_object.Object, name: str) u32 {
    var i: usize = 0;
    for (i < o.sections.count) {
        val named: opt[table.Id[intern.Name]] = o.sections.items[i].name;
        if (sel named.some) {
            if (t_is(mink_object.name_of(o, named.some), name)) { ret i::u32; }
        }
        i = i + 1;
    }
    ret o.sections.count::u32;
}

# the section of `o` named `name`, nil for none
#[testing]
fun t_section(o: *mink_object.Object, name: str) *mink_object.Section {
    val i: u32 = t_index(o, name);
    if (i::usize >= o.sections.count) { ret nil; }
    ret ?o.sections.items[i];
}

# the symbol of `o` named `name`, nil for none
#[testing]
fun t_symbol(o: *mink_object.Object, name: str) *mink_object.Symbol {
    var i: usize = 0;
    for (i < o.symbols.count) {
        if (t_is(mink_object.name_of(o, o.symbols.items[i].name), name)) { ret ?o.symbols.items[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether section `name` of `o` holds exactly the `n` bytes at `want`
#[testing]
fun t_holds(o: *mink_object.Object, name: str, want: *u8, n: usize) bool {
    val s: *mink_object.Section = t_section(o, name);
    if (s == nil) { ret false; }
    val got: store.Bytes = mink_object.bytes(o, ?s.contents);
    if (got.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (got.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `got` was refused with `message` at `line` and `column`, an object it made released
#[testing]
fun t_refused(got: *res[mink_object.Object, model.Refusal], message: str, line: u32, column: u32) bool {
    if (sel got.ok) {
        mink_object.release(?got.ok);
        ret false;
    }
    val d: model.Refusal = got.err;
    ret str_equals(d.message, message) && d.span.start.line == line && d.span.start.column == column;
}

test asm__a_label_difference_in_one_section_folds_to_a_constant {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option relax\na: addi a0, a0, 1\n addi a0, a0, 2\nb:\n.data\n.long b - a\n.text\nc: call f\nd:\n.data\n.long d - c\n");
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    # two instructions apart, and across a call the linker may relax, which only the linker measures
    val want: [8]u8 = [8]u8{8, 0, 0, 0, 0, 0, 0, 0};
    if (!t_holds(?o, ".data", ?want[0], 8)) { ret 3; }
    val data: u32   = t_index(?o, ".data");
    var add:  bool  = false;
    var sub:  bool  = false;
    var i:    usize = 0;
    for (i < o.relocs.count) {
        val r: *mink_object.Reloc = ?o.relocs.items[i];
        if (r.section.index == data && r.offset == 4 && r.kind == ?riscv_kinds.ADD32) { add = true; }
        if (r.section.index == data && r.offset == 4 && r.kind == ?riscv_kinds.SUB32) { sub = true; }
        if (r.section.index == data && r.offset == 0)                                 { ret 4; }
        i = i + 1;
    }
    if (!add || !sub)    { ret 5; }
    if (!t_done(?t, ?o)) { ret 6; }
    ret 0;
}

test asm__a_label_difference_across_sections_is_refused {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, "a: nop\n.data\nb: .long 0\n.long b - a\n");
    if (!t_refused(?got, build.ACROSS, 4, 7)) { ret 2; }
    if (!t_release(?t))                       { ret 3; }
    ret 0;
}

test asm__a_numbered_local_label_resolves_forward_and_backward {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, "1: nop\n j 1f\n j 1b\n1: nop\n j 1b\n");
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    # jal x0 forward 8, back 8 to the first 1, and back 4 to the second
    val want: [20]u8 = [20]u8{0x13, 0, 0, 0, 0x6f, 0, 0x80, 0, 0x6f, 0xf0, 0x9f, 0xff, 0x13, 0, 0, 0, 0x6f, 0xf0, 0xdf, 0xff};
    if (!t_holds(?o, ".text", ?want[0], 20)) { ret 3; }
    if (!t_done(?t, ?o))                     { ret 4; }
    # a forward reference no definition follows is refused where it is made
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 5; }
    var never: res[mink_object.Object, model.Refusal] = t_assemble(?u, "nop\n j 2f\n");
    if (!t_refused(?never, model.NEVER_AFTER, 2, 2)) { ret 6; }
    if (!t_release(?u))                              { ret 7; }
    ret 0;
}

test asm__an_llvm_anonymous_label_spelling_assembles {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".Ltmp0:\n nop\n j .Ltmp0\n");
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    if (!t_done(?t, ?o)) { ret 3; }
    ret 0;
}

# whether `o` relocates `.text` at `offset` by `kind` against the symbol named `to`
#[testing]
fun t_relocates(o: *mink_object.Object, offset: u64, kind: *reloc.Kind, to: str) bool {
    val named: *mink_object.Symbol = t_symbol(o, to);
    var i:     usize               = 0;
    for (i < o.relocs.count) {
        val r: *mink_object.Reloc = ?o.relocs.items[i];
        i = i + 1;
        if (r.offset != offset || r.kind != kind) { cnt; }
        if (!sel r.target.symbol)                 { cnt; }
        ret named != nil && ?o.symbols.items[r.target.symbol.index] == named;
    }
    ret false;
}

# whether section `name` of `o` is `len` bytes long and begins with the `n` bytes at `want`
#[testing]
fun t_begins(o: *mink_object.Object, name: str, want: *u8, n: usize, len: usize) bool {
    val s: *mink_object.Section = t_section(o, name);
    if (s == nil) { ret false; }
    val got: store.Bytes = mink_object.bytes(o, ?s.contents);
    if (got.len != len) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (got.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# local branches and jumps, both ways and out of reach, and branches and a jump to a symbol only the linker knows,
# under rv64gc. llvm-mc 23.1.1 (-triple=riscv64 -mattr=+c) writes the bytes and relocations below
#[testing]
val T_BRANCHES: str = "1: beq a0, zero, 2f\nbne s1, zero, 1b\nbeq zero, a2, 2f\nbeq a0, a1, 2f\nj 1b\nj 2f\n2: beq a2, zero, g\nbne a0, a1, g\nj g\nbeq a0, zero, 3f\nbeq a0, zero, 4f\n.fill 300, 1, 0\n3: nop\n.fill 5000, 1, 0\n4: nop\n";

#[testing]
val T_BRANCH_BYTES: [42]u8 = [42]u8{
    0x19, 0xc5, 0xfd, 0xfc, 0x09, 0xc6, 0x63, 0x04, 0xb5, 0x00, 0xdd, 0xbf, 0x09, 0xa0, 0x19, 0xe2, 0x6f, 0x00, 0x00, 0x00, 0x63,
    0x04, 0xb5, 0x00, 0x6f, 0x00, 0x00, 0x00, 0x6f, 0x00, 0x00, 0x00, 0x63, 0x0b, 0x05, 0x12, 0x19, 0xe1, 0x6f, 0x10, 0xa0, 0x4b,
};

# the same under `.option norvc`, which keeps every form full length (llvm-mc 23.1.1, -mattr=+c)
#[testing]
val T_FULL: str = ".option norvc\n1: beq a0, zero, 1b\nj 1b\nbeq a0, zero, g\nj g\n";

#[testing]
val T_FULL_BYTES: [20]u8 = [20]u8{0x63, 0x00, 0x05, 0x00, 0x6f, 0xf0, 0xdf, 0xff, 0x63, 0x14, 0x05, 0x00, 0x6f, 0x00, 0x00, 0x00, 0x6f, 0x00, 0x00, 0x00};

# a jump and a branch across a call the linker may shrink, which stay compressed and relocate (llvm-mc 23.1.1,
# -mattr=+c,+relax, whose policy for a call masc's is)
#[testing]
val T_ACROSS: str = ".option relax\nj out\nbeq a0, zero, out\ncall h\nout: nop\n";

#[testing]
val T_ACROSS_BYTES: [14]u8 = [14]u8{0x01, 0xa0, 0x01, 0xc1, 0x97, 0x00, 0x00, 0x00, 0xe7, 0x80, 0x00, 0x00, 0x01, 0x00};

test asm__a_branch_is_laid_out_in_the_shortest_form_that_reaches_as_llvm_mc_lays_it {
    var t: T;
    if (!t_make(?t, "rv64gc")) { ret 1; }
    # c.beqz and c.bnez forward and back, swapped registers too, beq with no short form, c.j both ways, the inverted
    # branch past a jal for each symbol only the linker knows, j to it as jal, and beq and the long form out of reach
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, T_BRANCHES);
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    if (!t_begins(?o, ".text", ?T_BRANCH_BYTES[0], 42, 5346))                                                                                                  { ret 3; }
    if (o.relocs.count != 3)                                                                                                                                   { ret 4; }
    if (!t_relocates(?o, 0x10, ?riscv_kinds.JAL20, "g") || !t_relocates(?o, 0x18, ?riscv_kinds.JAL20, "g") || !t_relocates(?o, 0x1c, ?riscv_kinds.JAL20, "g")) { ret 5; }
    if (!t_done(?t, ?o))                                                                                                                                       { ret 6; }
    var u: T;
    if (!t_make(?u, "rv64gc")) { ret 7; }
    var full: res[mink_object.Object, model.Refusal] = t_assemble(?u, T_FULL);
    if (sel full.err) { ret 8; }
    var p: mink_object.Object = full.ok;
    if (!t_holds(?p, ".text", ?T_FULL_BYTES[0], 20))                                                       { ret 9; }
    if (p.relocs.count != 2)                                                                               { ret 10; }
    if (!t_relocates(?p, 0xc, ?riscv_kinds.JAL20, "g") || !t_relocates(?p, 0x10, ?riscv_kinds.JAL20, "g")) { ret 11; }
    if (!t_done(?u, ?p))                                                                                   { ret 12; }
    var w: T;
    if (!t_make(?w, "rv64gc")) { ret 13; }
    var across: res[mink_object.Object, model.Refusal] = t_assemble(?w, T_ACROSS);
    if (sel across.err) { ret 14; }
    var q: mink_object.Object = across.ok;
    if (!t_holds(?q, ".text", ?T_ACROSS_BYTES[0], 14))                                                            { ret 15; }
    if (q.relocs.count != 4)                                                                                      { ret 16; }
    if (!t_relocates(?q, 0, ?riscv_kinds.RVC_JUMP, "out") || !t_relocates(?q, 2, ?riscv_kinds.RVC_BRANCH, "out")) { ret 17; }
    if (!t_relocates(?q, 4, ?riscv_kinds.CALL_PLT_PAIR, "h"))                                                     { ret 18; }
    if (!t_done(?w, ?q))                                                                                          { ret 19; }
    ret 0;
}

#[testing]
val T_PIC: [1]mode.Setting = [1]mode.Setting{mode.Setting{mode: ?riscv_mode.POSITION, value: ?riscv_mode.PIC}};

test asm__la_is_lla_without_pic_and_a_got_load_with_it {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    # x is global, so other objects may preempt it and the pair relocates rather than folds
    val text: str                                    = "la a0, x\n.globl x\nx: nop\n";
    var got:  res[mink_object.Object, model.Refusal] = t_assemble(?t, text);
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    # auipc a0 and addi a0, a0, the low part naming the label of the high
    val lla: [12]u8 = [12]u8{0x17, 0x05, 0, 0, 0x13, 0x05, 0x05, 0, 0x13, 0, 0, 0};
    if (!t_holds(?o, ".text", ?lla[0], 12))                            { ret 3; }
    if (!t_relocates(?o, 0, ?riscv_kinds.PCREL_HI20, "x"))             { ret 4; }
    if (!t_relocates(?o, 4, ?riscv_kinds.PCREL_LO12_I, ".Lpcrel_hi0")) { ret 5; }
    if (!t_done(?t, ?o))                                               { ret 6; }
    # under pic, auipc a0 for the got entry and ld a0, a0
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 7; }
    var options: model.Options = t_options(?u);
    options.modes = mode.Settings{at: ?T_PIC[0], len: 1};
    var pic: res[mink_object.Object, model.Refusal] = assemble(testing.allocator_of(?u.t), ?riscv_set.SET, ?u.ctx, options, text, str_len(text), diagnostic.START);
    if (sel pic.err) { ret 8; }
    var p:        mink_object.Object = pic.ok;
    val got_load: [12]u8             = [12]u8{0x17, 0x05, 0, 0, 0x03, 0x35, 0x05, 0, 0x13, 0, 0, 0};
    if (!t_holds(?p, ".text", ?got_load[0], 12))                       { ret 9; }
    if (!t_relocates(?p, 0, ?riscv_kinds.GOT_PCREL_HI20, "x"))         { ret 10; }
    if (!t_relocates(?p, 4, ?riscv_kinds.PCREL_LO12_I, ".Lpcrel_hi0")) { ret 11; }
    if (!t_done(?u, ?p))                                               { ret 12; }
    # the low part's label takes the next number of the stem that no label of the source spells
    var v: T;
    if (!t_make(?v, "rv64i")) { ret 13; }
    var taken: res[mink_object.Object, model.Refusal] = t_assemble(?v, ".Lpcrel_hi0:\nla a0, x\nla a1, x\n.globl x\nx: nop\n");
    if (sel taken.err) { ret 14; }
    var q: mink_object.Object = taken.ok;
    if (!t_relocates(?q, 4, ?riscv_kinds.PCREL_LO12_I, ".Lpcrel_hi1"))  { ret 15; }
    if (!t_relocates(?q, 12, ?riscv_kinds.PCREL_LO12_I, ".Lpcrel_hi2")) { ret 16; }
    if (!t_done(?v, ?q))                                                { ret 17; }
    ret 0;
}

# which of the two `la` of `text` load from the got: bit 0 the first, bit 1 the second, 4 when it does not assemble
#[testing]
fun t_la_pic(text: str) u32 {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 4; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, text);
    if (sel got.err) { ret 4; }
    var o:    mink_object.Object = got.ok;
    var seen: u32                = 0;
    if (t_relocates(?o, 0, ?riscv_kinds.GOT_PCREL_HI20, "x")) { seen = seen | 1; }
    if (t_relocates(?o, 8, ?riscv_kinds.GOT_PCREL_HI20, "x")) { seen = seen | 2; }
    if (!t_done(?t, ?o))                                      { ret 4; }
    ret seen;
}

test asm__option_pic_and_nopic_change_what_la_expands_to_and_pop_restores_it {
    if (t_la_pic("la a0, x\n.option pic\nla a0, x\nx: nop\n") != 2)                            { ret 1; }
    if (t_la_pic(".option pic\nla a0, x\n.option nopic\nla a0, x\nx: nop\n") != 1)             { ret 2; }
    if (t_la_pic(".option push\n.option pic\nla a0, x\n.option pop\nla a0, x\nx: nop\n") != 1) { ret 3; }
    ret 0;
}

# whether `o` holds exactly the `n` relocations of the kinds at `kinds` at the offsets at `offsets`, in any order
#[testing]
fun t_relocations(o: *mink_object.Object, offsets: *u64, kinds: **reloc.Kind, n: usize) bool {
    if (o.relocs.count != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        var found: bool  = false;
        var j:     usize = 0;
        for (j < o.relocs.count) {
            val r: *mink_object.Reloc = ?o.relocs.items[j];
            if (r.offset == offsets[i] && r.kind == kinds[i]) { found = true; }
            j = j + 1;
        }
        if (!found) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
val T_PAIR: str = "lla a0, x\n1: auipc a1, %pcrel_hi(x)\naddi a1, a1, %pcrel_lo(1b)\nx: nop\n";

# `lla` and the explicit pair to a local label fold into their numbers unrelaxed and relocate with their markers relaxed,
# as llvm-mc 23.1.1 writes them (-triple=riscv64, and -mattr=+relax)
test asm__a_pc_relative_pair_to_a_local_label_folds_unless_relaxed {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, T_PAIR);
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    # auipc a0, 0 and addi a0, a0, 16, then auipc a1, 0 and addi a1, a1, 8, each pair measured from its auipc
    val folded: [20]u8 = [20]u8{0x17, 0x05, 0, 0, 0x13, 0x05, 0x05, 0x01, 0x97, 0x05, 0, 0, 0x93, 0x85, 0x85, 0x00, 0x13, 0, 0, 0};
    if (!t_holds(?o, ".text", ?folded[0], 20) || o.relocs.count != 0) { ret 3; }
    if (!t_done(?t, ?o))                                              { ret 4; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 5; }
    var relaxed: res[mink_object.Object, model.Refusal] = t_assemble(?u, ".option relax\nlla a0, x\n1: auipc a1, %pcrel_hi(x)\naddi a1, a1, %pcrel_lo(1b)\nx: nop\n");
    if (sel relaxed.err) { ret 6; }
    var p:     mink_object.Object = relaxed.ok;
    val zeros: [20]u8             = [20]u8{0x17, 0x05, 0, 0, 0x13, 0x05, 0x05, 0, 0x97, 0x05, 0, 0, 0x93, 0x85, 0x05, 0, 0x13, 0, 0, 0};
    if (!t_holds(?p, ".text", ?zeros[0], 20)) { ret 7; }
    val at:    [8]u64         = [8]u64{0, 0, 4, 4, 8, 8, 12, 12};
    val kinds: [8]*reloc.Kind = [8]*reloc.Kind{?riscv_kinds.PCREL_HI20, ?riscv_kinds.RELAX, ?riscv_kinds.PCREL_LO12_I, ?riscv_kinds.RELAX, ?riscv_kinds.PCREL_HI20, ?riscv_kinds.RELAX, ?riscv_kinds.PCREL_LO12_I, ?riscv_kinds.RELAX};
    if (!t_relocations(?p, ?at[0], ?kinds[0], 8))                      { ret 8; }
    if (!t_relocates(?p, 0, ?riscv_kinds.PCREL_HI20, "x"))             { ret 9; }
    if (!t_relocates(?p, 4, ?riscv_kinds.PCREL_LO12_I, ".Lpcrel_hi0")) { ret 10; }
    if (!t_done(?u, ?p))                                               { ret 11; }
    ret 0;
}

#[testing]
val T_TLS: str = "call f\nlui a0, %tprel_hi(t)\nadd a0, a0, tp, %tprel_add(t)\naddi a0, a0, %tprel_lo(t)\n1: auipc a0, %tls_ie_pcrel_hi(t)\nld a0, %pcrel_lo(1b)(a0)\n2: auipc a0, %tls_gd_pcrel_hi(t)\naddi a0, a0, %pcrel_lo(2b)\n3: auipc a0, %tlsdesc_hi(t)\nld a1, %tlsdesc_load_lo(3b)(a0)\naddi a0, a0, %tlsdesc_add_lo(3b)\njalr t0, 0(a1), %tlsdesc_call(3b)\n";

# T_TLS relaxed by a push, then a call after the pop restores the mode
#[testing]
val T_TLS_RELAXED: str = ".option push\n.option relax\ncall f\nlui a0, %tprel_hi(t)\nadd a0, a0, tp, %tprel_add(t)\naddi a0, a0, %tprel_lo(t)\n1: auipc a0, %tls_ie_pcrel_hi(t)\nld a0, %pcrel_lo(1b)(a0)\n2: auipc a0, %tls_gd_pcrel_hi(t)\naddi a0, a0, %pcrel_lo(2b)\n3: auipc a0, %tlsdesc_hi(t)\nld a1, %tlsdesc_load_lo(3b)(a0)\naddi a0, a0, %tlsdesc_add_lo(3b)\njalr t0, 0(a1), %tlsdesc_call(3b)\n.option pop\ncall f\n";

# the relocations of a call and the psabi's tls sequences, with R_RISCV_RELAX beside exactly the kinds llvm-mc 23.1.1
# marks under +relax and beside none without it, the relax mode set by `.option relax` and restored by `.option pop`
test asm__relax_marks_the_kinds_llvm_mc_marks_and_only_while_relaxed {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var plain: res[mink_object.Object, model.Refusal] = t_assemble(?t, T_TLS);
    if (sel plain.err) { ret 2; }
    var o:     mink_object.Object = plain.ok;
    val at:    [12]u64            = [12]u64{0, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44, 48};
    val kinds: [12]*reloc.Kind    = [12]*reloc.Kind{
        ?riscv_kinds.CALL_PLT_PAIR, ?riscv_kinds.TPREL_HI20, ?riscv_kinds.TPREL_ADD, ?riscv_kinds.TPREL_LO12_I,
        ?riscv_kinds.TLS_GOT_PCREL_HI20, ?riscv_kinds.PCREL_LO12_I, ?riscv_kinds.TLS_GD_PCREL_HI20, ?riscv_kinds.PCREL_LO12_I,
        ?riscv_kinds.TLSDESC_HI20, ?riscv_kinds.TLSDESC_PCREL_LOAD_LO12, ?riscv_kinds.TLSDESC_PCREL_ADD_LO12, ?riscv_kinds.TLSDESC_PCREL_CALL,
    };
    if (!t_relocations(?o, ?at[0], ?kinds[0], 12)) { ret 3; }
    if (!t_done(?t, ?o))                           { ret 4; }
    # relaxed, a marker beside the call, the tprel parts, the low parts of the ie and gd pairs and the tlsdesc high part,
    # and the call after the pop unmarked
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 5; }
    var relaxed: res[mink_object.Object, model.Refusal] = t_assemble(?u, T_TLS_RELAXED);
    if (sel relaxed.err) { ret 7; }
    var p:     mink_object.Object = relaxed.ok;
    val all:   [20]u64            = [20]u64{0, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44, 48, 0, 8, 12, 16, 24, 32, 36, 52};
    val every: [20]*reloc.Kind    = [20]*reloc.Kind{
        ?riscv_kinds.CALL_PLT_PAIR, ?riscv_kinds.TPREL_HI20, ?riscv_kinds.TPREL_ADD, ?riscv_kinds.TPREL_LO12_I,
        ?riscv_kinds.TLS_GOT_PCREL_HI20, ?riscv_kinds.PCREL_LO12_I, ?riscv_kinds.TLS_GD_PCREL_HI20, ?riscv_kinds.PCREL_LO12_I,
        ?riscv_kinds.TLSDESC_HI20, ?riscv_kinds.TLSDESC_PCREL_LOAD_LO12, ?riscv_kinds.TLSDESC_PCREL_ADD_LO12, ?riscv_kinds.TLSDESC_PCREL_CALL,
        ?riscv_kinds.RELAX, ?riscv_kinds.RELAX, ?riscv_kinds.RELAX, ?riscv_kinds.RELAX, ?riscv_kinds.RELAX,
        ?riscv_kinds.RELAX, ?riscv_kinds.RELAX, ?riscv_kinds.CALL_PLT_PAIR,
    };
    if (!t_relocations(?p, ?all[0], ?every[0], 20)) { ret 8; }
    if (!t_done(?u, ?p))                            { ret 9; }
    ret 0;
}

test asm__a_symbol_given_two_bindings_is_refused {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".globl f\n.global f\n.local f\n");
    if (!t_refused(?got, model.TWO_BINDINGS, 3, 8)) { ret 2; }
    if (!t_release(?t))                             { ret 3; }
    ret 0;
}

# `.type` with gnu_unique_object states an object of the unique binding over a global or local binding stated before,
# and a global one stated after it or a weak one before it is refused, as llvm-mc 23.1.1 reads them (#181)
test asm__gnu_unique_object_states_the_unique_binding {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, "\t.globl a\n\t.type a, @gnu_unique_object\n\t.local c\n\t.type c, @gnu_unique_object\n\t.data\na:\nc:\n\t.word 1\n");
    if (sel got.err) { ret 2; }
    var o: mink_object.Object  = got.ok;
    val a: *mink_object.Symbol = t_symbol(?o, "a");
    val c: *mink_object.Symbol = t_symbol(?o, "c");
    if (a == nil || a.binding != ?symbol.UNIQUELY || a.kind != ?symbol.DATA) { ret 3; }
    if (c == nil || c.binding != ?symbol.UNIQUELY || c.kind != ?symbol.DATA) { ret 4; }
    if (!t_done(?t, ?o))                                                     { ret 5; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 6; }
    var after: res[mink_object.Object, model.Refusal] = t_assemble(?u, ".type b, @gnu_unique_object\n.globl b\n");
    if (!t_refused(?after, model.TWO_BINDINGS, 2, 8)) { ret 7; }
    var weak: res[mink_object.Object, model.Refusal] = t_assemble(?u, ".weak b\n.type b, @gnu_unique_object\n");
    if (!t_refused(?weak, model.TWO_BINDINGS, 2, 10)) { ret 8; }
    if (!t_release(?u))                               { ret 9; }
    ret 0;
}

test asm__section_flags_and_type_are_set_from_the_directive {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".section .rodata.str1.1,\"aMS\",@progbits,1\n.asciz \"x\"\n.section .tbss,\"awT\",@nobits\n.zero 8\n.section .note.GNU-stack,\"\",@progbits\n.section .init_array,\"aw\",@init_array\n.section .misc,\"ax\",%progbits\n");
    if (sel got.err) { ret 2; }
    var o:       mink_object.Object   = got.ok;
    val strings: *mink_object.Section = t_section(?o, ".rodata.str1.1");
    if (strings == nil || strings.kind != ?section.MERGED_STRINGS)                                  { ret 3; }
    if (strings.flags != (section.ALLOC | section.MERGE | section.STRINGS) || strings.entsize != 1) { ret 4; }
    val tbss: *mink_object.Section = t_section(?o, ".tbss");
    if (tbss == nil || tbss.kind != ?section.TLS_BSS || tbss.flags != (section.ALLOC | section.WRITE | section.TLS)) { ret 5; }
    val stack: *mink_object.Section = t_section(?o, ".note.GNU-stack");
    if (stack == nil || stack.kind != ?section.STACK_NOTE || stack.flags != 0) { ret 6; }
    val init: *mink_object.Section = t_section(?o, ".init_array");
    if (init == nil || init.kind != ?section.INIT_ARRAY) { ret 7; }
    val misc: *mink_object.Section = t_section(?o, ".misc");
    if (misc == nil || misc.kind != ?section.TEXT || misc.flags != (section.ALLOC | section.EXEC)) { ret 8; }
    if (!t_done(?t, ?o))                                                                           { ret 9; }
    ret 0;
}

# whether section `i` of `o` is named `name` and holds exactly the `n` bytes at `want`
#[testing]
fun t_holds_at(o: *mink_object.Object, i: u32, name: str, want: *u8, n: usize) bool {
    if (i::usize >= o.sections.count) { ret false; }
    val s:     *mink_object.Section       = ?o.sections.items[i];
    val named: opt[table.Id[intern.Name]] = s.name;
    if (sel named.none)                                  { ret false; }
    if (!t_is(mink_object.name_of(o, named.some), name)) { ret false; }
    val got: store.Bytes = mink_object.bytes(o, ?s.contents);
    if (got.len != n) { ret false; }
    var k: usize = 0;
    for (k < n) {
        if (got.data[k] != want[k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

test asm__a_unique_section_is_apart_from_the_others_of_its_name_as_llvm_mc_keeps_it {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".text\n.byte 1\n.section .text,\"ax\",@progbits,unique,1\n.byte 2\n.section .text,\"ax\",@progbits,unique,7\n.byte 3\n.section .text,\"ax\",@progbits, unique, 1\n.byte 4\n.section .text,\"ax\",@progbits\n.byte 5\n.section .rodata.x,\"aM\",@progbits,4,unique,3\n.word 1\n.section .rodata.x,\"aM\",@progbits,4\n.word 2\n");
    if (sel got.err) { ret 2; }
    var o:     mink_object.Object = got.ok;
    val first: [2]u8              = [2]u8{1, 5};
    val one:   [2]u8              = [2]u8{2, 4};
    val seven: [1]u8              = [1]u8{3};
    val three: [4]u8              = [4]u8{1, 0, 0, 0};
    val plain: [4]u8              = [4]u8{2, 0, 0, 0};
    if (o.sections.count != 5)                         { ret 3; }
    if (!t_holds_at(?o, 0, ".text", ?first[0], 2))     { ret 4; }
    if (!t_holds_at(?o, 1, ".text", ?one[0], 2))       { ret 5; }
    if (!t_holds_at(?o, 2, ".text", ?seven[0], 1))     { ret 6; }
    if (!t_holds_at(?o, 3, ".rodata.x", ?three[0], 4)) { ret 7; }
    if (!t_holds_at(?o, 4, ".rodata.x", ?plain[0], 4)) { ret 8; }
    if (o.sections.items[3].entsize != 4)              { ret 9; }
    if (!t_done(?t, ?o))                               { ret 10; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 11; }
    var bare: res[mink_object.Object, model.Refusal] = t_assemble(?u, ".section .text,\"ax\",@progbits,unique\n");
    if (!t_refused(?bare, model.NOT_A_NUMBER, 1, 37)) { ret 12; }
    if (!t_release(?u))                               { ret 13; }
    ret 0;
}

test asm__the_section_stack_restores_the_previous_section {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".text\n.pushsection .data\n.byte 1\n.popsection\nnop\n.data\n.byte 2\n.previous\nnop\n.section .rodata\n.byte 3\n.previous\nnop\n");
    if (sel got.err) { ret 2; }
    var o:    mink_object.Object = got.ok;
    val code: [12]u8             = [12]u8{0x13, 0, 0, 0, 0x13, 0, 0, 0, 0x13, 0, 0, 0};
    val data: [2]u8              = [2]u8{1, 2};
    if (!t_holds(?o, ".text", ?code[0], 12)) { ret 3; }
    if (!t_holds(?o, ".data", ?data[0], 2))  { ret 4; }
    if (!t_done(?t, ?o))                     { ret 5; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 6; }
    var empty: res[mink_object.Object, model.Refusal] = t_assemble(?u, "nop\n.popsection\n");
    if (!t_refused(?empty, model.EMPTY_STACK, 2, 12)) { ret 7; }
    if (!t_release(?u))                               { ret 8; }
    ret 0;
}

# a symbol a thread-local relocation names is typed thread-local when nothing states its type, and keeps a symbol of its
# own when local, as llvm-mc types and keeps it. a stated type other than thread-local is refused (#211)
test asm__a_symbol_a_thread_local_relocation_names_is_thread_local {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, "\tlui a0, %tprel_hi(x)\n\tlui a1, %tprel_hi(loc)\n\t.section .tdata, \"awT\", @progbits\nloc:\n\t.word 0\n");
    if (sel got.err) { ret 2; }
    var o:   mink_object.Object  = got.ok;
    val x:   *mink_object.Symbol = t_symbol(?o, "x");
    val loc: *mink_object.Symbol = t_symbol(?o, "loc");
    if (x == nil || x.kind != ?symbol.TLS || x.binding != ?symbol.GLOBAL)      { ret 3; }
    if (loc == nil || loc.kind != ?symbol.TLS || loc.binding != ?symbol.LOCAL) { ret 4; }
    if (!t_done(?t, ?o))                                                       { ret 5; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 6; }
    var typed: res[mink_object.Object, model.Refusal] = t_assemble(?u, "\t.type x, @object\n\tlui a0, %tprel_hi(x)\n");
    if (!t_refused(?typed, build.NOT_THREAD, 2, 2)) { ret 7; }
    if (!t_release(?u))                             { ret 8; }
    ret 0;
}

# the starting section is opened only when written to, a label is placed in it or a directive names it (#223)
test asm__the_starting_section_is_opened_only_when_written {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    # nothing before the first `.section`, and a `.pushsection` back to the start that writes nothing
    var data: res[mink_object.Object, model.Refusal] = t_assemble(?t, "\t.globl x\n\t.pushsection .data\nx:\n\t.byte 1\n\t.popsection\n");
    if (sel data.err) { ret 2; }
    var o: mink_object.Object = data.ok;
    if (o.sections.count != 1 || t_index(?o, ".data") != 0) { ret 3; }
    if (!t_done(?t, ?o))                                    { ret 4; }
    # a statement before the first `.section`, or a directive naming the start, opens it first, as before
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 5; }
    var code: res[mink_object.Object, model.Refusal] = t_assemble(?u, "\tnop\n\t.data\n\t.byte 1\n\t.text\n\tnop\n");
    if (sel code.err) { ret 6; }
    var p: mink_object.Object = code.ok;
    if (p.sections.count != 2 || t_index(?p, ".text") != 0 || t_index(?p, ".data") != 1) { ret 7; }
    if (!t_done(?u, ?p))                                                                 { ret 8; }
    var w: T;
    if (!t_make(?w, "rv64i")) { ret 9; }
    var named: res[mink_object.Object, model.Refusal] = t_assemble(?w, "\t.data\n\t.byte 1\n\t.text\n");
    if (sel named.err) { ret 10; }
    var q: mink_object.Object = named.ok;
    if (q.sections.count != 2 || t_index(?q, ".data") != 0 || t_index(?q, ".text") != 1) { ret 11; }
    if (!t_done(?w, ?q))                                                                 { ret 12; }
    ret 0;
}

# whether `o` holds mapping symbol `name` at `offset` of section `section`, a local symbol of no type
#[testing]
fun t_mapped(o: *mink_object.Object, section: str, offset: u64, name: str) bool {
    val at: u32   = t_index(o, section);
    var i:  usize = 0;
    for (i < o.symbols.count) {
        val sym: *mink_object.Symbol = ?o.symbols.items[i];
        i = i + 1;
        if (!t_is(mink_object.name_of(o, sym.name), name)) { cnt; }
        if (sel sym.def.placed) {
            val p: mink_object.Place = sym.def.placed;
            if (p.section.index == at && p.offset == offset) { ret sym.binding == ?symbol.LOCAL && sym.kind == ?symbol.NOTYPE; }
        }
    }
    ret false;
}

# how many symbols of `o` are named by a mapping stem, `$x` or `$d`
#[testing]
fun t_marks(o: *mink_object.Object) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < o.symbols.count) {
        val name: View = mink_object.name_of(o, o.symbols.items[i].name);
        if (name.len >= 2 && name.data[0] == '$' && (name.data[1] == 'x' || name.data[1] == 'd')) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# a code mark where code starts, named by the isa string it is written under, and a data mark where data starts, at
# the places llvm-mc 23.1.1 writes them for this source with `-mattr=+c` (#213). an alignment starts neither, and an
# isa changed and changed back with no instruction between writes nothing
test asm__mapping_symbols_mark_where_code_and_data_start_as_llvm_mc_writes_them {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, "\taddi a0, a0, 1\n\t.word 5\n\tc.nop\n\t.short 1\n\t.p2align 2\n\tnop\n\t.option arch, +zbb\n\tandn a0, a0, a1\n\t.option arch, -zbb\n\tnop\n\t.option arch, +zbb\n\t.option arch, -zbb\n\tnop\n\t.option push\n\t.option norvc\n\tnop\n\t.option pop\n\t.section .data\n\t.word 1\n\t.section .text.b, \"ax\"\n\tnop\n");
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    val c: str                = "$xrv64i2p1_c2p0_zca1p0";
    if (!t_mapped(?o, ".text", 0, c) || !t_mapped(?o, ".text", 2, "$d") || !t_mapped(?o, ".text", 6, c) || !t_mapped(?o, ".text", 8, "$d")) { ret 3; }
    if (!t_mapped(?o, ".text", 0xc, c) || !t_mapped(?o, ".text", 0xe, "$xrv64i2p1_c2p0_zca1p0_zbb1p0") || !t_mapped(?o, ".text", 0x12, c))  { ret 4; }
    if (!t_mapped(?o, ".text", 0x16, "$xrv64i2p1") || !t_mapped(?o, ".data", 0, "$d") || !t_mapped(?o, ".text.b", 0, c))                    { ret 5; }
    if (t_marks(?o) != 10)                                                                                                                  { ret 6; }
    if (!t_done(?t, ?o))                                                                                                                    { ret 7; }
    ret 0;
}

test asm__each_data_directive_writes_its_width_and_order {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".data\n.byte 1, -1\n.short 0x0203\n.word 0x04050607\n.long -2\n.quad 0x0102030405060708\n.float 1.5\n.double 1.5\n.ascii \"ab\"\n.asciz \"c\"\n.string \"d\\n\"\n");
    if (sel got.err) { ret 2; }
    var o:    mink_object.Object = got.ok;
    val want: [39]u8             = [39]u8{
        1, 0xff,
        0x03, 0x02,
        0x07, 0x06, 0x05, 0x04,
        0xfe, 0xff, 0xff, 0xff,
        0x08, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01,
        0x00, 0x00, 0xc0, 0x3f,
        0, 0, 0, 0, 0, 0, 0xf8, 0x3f,
        'a', 'b',
        'c', 0,
        'd', '\n', 0,
    };
    if (!t_holds(?o, ".data", ?want[0], 39)) { ret 3; }
    if (!t_done(?t, ?o))                     { ret 4; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 5; }
    var wide: res[mink_object.Object, model.Refusal] = t_assemble(?u, ".data\n.byte 256\n");
    if (!t_refused(?wide, model.RANGE, 2, 7)) { ret 6; }
    if (!t_release(?u))                       { ret 7; }
    ret 0;
}

# each literal rounds once, at its directive's width, to llvm-mc 23.1.1's bytes: an f32 midpoint an f64 step would
# round to even, a hexadecimal float, a subnormal, nan and infinity as llvm-mc spells and writes them, an overflow,
# an exponent letter with no digits
test asm__floats_round_once_at_their_width {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".data\n.float 1.00000005960464477540, 0x1.8p1, 0.70064923216240861e-45, -nan, Infinity, 1e40, 1.5e\n.double 0x1.000001p0, 2.4703282292062328e-324\n");
    if (sel got.err) { ret 2; }
    var o:    mink_object.Object = got.ok;
    val want: [44]u8             = [44]u8{
        0x01, 0x00, 0x80, 0x3f,
        0x00, 0x00, 0x40, 0x40,
        0x01, 0x00, 0x00, 0x00,
        0xff, 0xff, 0xff, 0xff,
        0x00, 0x00, 0x80, 0x7f,
        0x00, 0x00, 0x80, 0x7f,
        0x00, 0x00, 0xc0, 0x3f,
        0x00, 0x00, 0x00, 0x10, 0x00, 0x00, 0xf0, 0x3f,
        0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    };
    if (!t_holds(?o, ".data", ?want[0], 44)) { ret 3; }
    if (!t_done(?t, ?o))                     { ret 4; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 5; }
    var bare: res[mink_object.Object, model.Refusal] = t_assemble(?u, ".data\n.float 0x10\n");
    if (!t_refused(?bare, model.NOT_A_NUMBER, 2, 8)) { ret 6; }
    if (!t_release(?u))                              { ret 7; }
    ret 0;
}

test asm__uleb128_and_sleb128_encode_their_boundary_values {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".data\n.uleb128 0, 127, 128, 0xffffffffffffffff\n.sleb128 63, 64, -64, -65\n");
    if (sel got.err) { ret 2; }
    var o:    mink_object.Object = got.ok;
    val want: [20]u8             = [20]u8{0x00, 0x7f, 0x80, 0x01, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x01, 0x3f, 0xc0, 0x00, 0x40, 0xbf, 0x7f};
    if (!t_holds(?o, ".data", ?want[0], 20)) { ret 3; }
    if (!t_done(?t, ?o))                     { ret 4; }
    ret 0;
}

test asm__set_redefines_a_symbol_and_equ_refuses_a_redefinition {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".data\n.set x, 1\n.byte x\n.set x, x + 1\n.byte x\n.equ y, 3\n.byte y\n");
    if (sel got.err) { ret 2; }
    var o:    mink_object.Object = got.ok;
    val want: [3]u8              = [3]u8{1, 2, 3};
    if (!t_holds(?o, ".data", ?want[0], 3)) { ret 3; }
    # a local symbol of its last value
    val x: *mink_object.Symbol = t_symbol(?o, "x");
    if (x == nil || x.binding != ?symbol.LOCAL)       { ret 4; }
    if (!(sel x.def.absolute && x.def.absolute == 2)) { ret 4; }
    if (!t_done(?t, ?o))                              { ret 5; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 6; }
    var again: res[mink_object.Object, model.Refusal] = t_assemble(?u, ".equ y, 3\n.equ y, 4\n");
    if (!t_refused(?again, model.FIXED, 2, 6)) { ret 7; }
    if (!t_release(?u))                        { ret 8; }
    ret 0;
}

test asm__comm_and_lcomm_declare_common_and_local_storage {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".comm buf, 64, 16\n.lcomm tmp, 8, 8\nnop\n");
    if (sel got.err) { ret 2; }
    var o:   mink_object.Object  = got.ok;
    val buf: *mink_object.Symbol = t_symbol(?o, "buf");
    if (buf == nil || buf.binding != ?symbol.GLOBAL)             { ret 3; }
    if (!sel buf.def.common)                                     { ret 4; }
    if (buf.def.common.size != 64 || buf.def.common.align != 16) { ret 4; }
    val tmp: *mink_object.Symbol = t_symbol(?o, "tmp");
    if (tmp == nil || tmp.binding != ?symbol.LOCAL)                                        { ret 5; }
    if (!sel tmp.def.placed)                                                               { ret 6; }
    if (tmp.def.placed.section.index != t_index(?o, ".bss") || tmp.def.placed.offset != 0) { ret 6; }
    val bss: *mink_object.Section = t_section(?o, ".bss");
    if (bss == nil)                                         { ret 7; }
    if (!(sel bss.contents.zero && bss.contents.zero == 8)) { ret 7; }
    # the code after it is still in .text
    val nop: [4]u8 = [4]u8{0x13, 0, 0, 0};
    if (!t_holds(?o, ".text", ?nop[0], 4)) { ret 8; }
    if (!t_done(?t, ?o))                   { ret 9; }
    ret 0;
}

test asm__alignment_directives_pad_to_their_boundary {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".data\n.byte 1\n.balign 4\n.byte 2\n.p2align 3\n.byte 3\n.align 2\n.byte 4\n.balign 8, 0xaa\n.byte 5\n.p2align 4,,2\n.byte 6\n");
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    # risc-v's .align is a power of two, and a gap past the limit pads nothing
    val want: [18]u8 = [18]u8{1, 0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0, 4, 0xaa, 0xaa, 0xaa, 5, 6};
    if (!t_holds(?o, ".data", ?want[0], 18)) { ret 3; }
    if (!t_done(?t, ?o))                     { ret 4; }
    ret 0;
}

test asm__realigned_padding_is_llvm_mcs_c_nop_first {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option relax\n.text\ncall f\n.balign 8\nf: ret\n");
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    # llvm-mc 23.1.1 -triple=riscv64 -mattr=+c,+relax: the call, c.nop, one four byte nop, ret
    val want: [16]u8 = [16]u8{0x97, 0, 0, 0, 0xE7, 0x80, 0, 0, 0x01, 0x00, 0x13, 0, 0, 0, 0x82, 0x80};
    if (!t_holds(?o, ".text", ?want[0], 16)) { ret 3; }
    if (!t_done(?t, ?o))                     { ret 4; }
    # a view without c cannot hold c.nop, so its padding is four byte nops alone
    var u: T;
    if (!t_make(?u, "rv64ic")) { ret 5; }
    var narrow: res[mink_object.Object, model.Refusal] = t_assemble(?u, ".option relax\n.option norvc\n.text\ncall f\n.balign 16\nf: nop\n");
    if (sel narrow.err) { ret 6; }
    var p:    mink_object.Object = narrow.ok;
    val nops: [24]u8             = [24]u8{0x97, 0, 0, 0, 0xE7, 0x80, 0, 0, 0x13, 0, 0, 0, 0x13, 0, 0, 0, 0x13, 0, 0, 0, 0x13, 0, 0, 0};
    if (!t_holds(?p, ".text", ?nops[0], 24)) { ret 7; }
    if (!t_done(?u, ?p))                     { ret 8; }
    ret 0;
}

test asm__a_malformed_line_is_refused_at_its_column {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".data\n  .long 1 +* 2\n");
    if (!t_refused(?got, read.UNEXPECTED, 2, 11)) { ret 2; }
    if (!t_release(?t))                           { ret 3; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 4; }
    var head: res[mink_object.Object, model.Refusal] = t_assemble(?u, "nop\n , x\n");
    if (!t_refused(?head, source.MALFORMED, 2, 2)) { ret 5; }
    if (!t_release(?u))                            { ret 6; }
    ret 0;
}

# the e base is entered only by mink's riscv32e and riscv64e, so an rv64e selection does not enter riscv64, and the
# refusal names the base its entry needs. the e base's registers are walk's to test
test asm__an_e_base_selection_does_not_enter_riscv64 {
    var t: T;
    if (!t_make(?t, "rv64e")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, "nop\n");
    if (sel got.ok) {
        mink_object.release(?got.ok);
        ret 2;
    }
    if (!str_equals(got.err.message, build.MODE)) { ret 3; }
    val refused: model.Refusal = got.err;
    if (!sel refused.mode.some) { ret 3; }
    var m:      build.Mismatch    = refused.mode.some;
    var out:    vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t.t));
    val worded: err[A.Error]      = state.spell_unmet(?m.unmet, ?out);
    if (sel worded.err || !t_is(view(out.data, out.len), "needs base=i") || !str_equals(m.arch, "riscv64")) { ret 4; }
    vector.dnit[u8](?out);
    if (!t_release(?t)) { ret 5; }
    ret 0;
}

# whether `text` assembled for the set's architecture row `at` under the selection `isa` and the architecture's abi row
# `abi` is an object of that row's architecture holding rve set, as the row fixes it, when `fine`, and refused past the
# entry when not
#[testing]
fun t_e_base(isa: str, at: u32, abi: str, text: str, fine: bool) bool {
    var t:   T;
    val row: *set.Arch = ?riscv_set.SET.arches.at[at];
    if (!t_make_at(?t, isa, row)) { ret false; }
    var options: model.Options = t_options(?t);
    options.arch = row.arch;
    options.abi  = trait.t_abi(row.arch, abi);
    var got: res[mink_object.Object, model.Refusal] = assemble(testing.allocator_of(?t.t), ?riscv_set.SET, ?t.ctx, options, text, str_len(text), diagnostic.START);
    if (!fine) {
        if (sel got.ok) {
            mink_object.release(?got.ok);
            ret false;
        }
        val refused: model.Refusal = got.err;
        if (sel refused.mode.some) { ret false; }
        ret t_release(?t);
    }
    if (sel got.err) { ret false; }
    var o:  mink_object.Object = got.ok;
    val ok: bool               = o.target.arch == row.arch && t_flag(?o, ?arch_riscv.RISCV_RVE, true);
    ret t_done(?t, ?o) && ok;
}

# rv64e and rv32e enter riscv64e and riscv32e, whose rows fix rve set, and x16 to x31 are not theirs
# (src/unpriv/rv32e.adoc)
test asm__an_e_base_selection_assembles_for_riscv64e_and_riscv32e {
    if (!str_equals(riscv_set.SET.arches.at[2].arch.name, "riscv64e") || !str_equals(riscv_set.SET.arches.at[3].arch.name, "riscv32e")) { ret 1; }
    if (!t_e_base("rv64emc", 2, "lp64e", "\taddi a0, a5, 1\n\tc.addi a0, 1\n", true))                                                   { ret 2; }
    if (!t_e_base("rv32e", 3, "ilp32e", "\taddi a0, a5, 1\n", true))                                                                    { ret 3; }
    if (!t_e_base("rv64e", 2, "lp64e", "\taddi a0, a6, 1\n", false))                                                                    { ret 4; }
    ret 0;
}

test asm__an_unknown_directive_is_refused {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, "nop # .bogus\n.frobnicate 1\n");
    if (!t_refused(?got, model.UNKNOWN_DIRECTIVE, 2, 1)) { ret 2; }
    if (!t_release(?t))                                  { ret 3; }
    ret 0;
}

# a refusal under a narrowing names what the narrowing removed, which the object's selection holds, and a lift past the
# object's selection adds what it lifts, as llvm-mc's `.option rvc` turns c on
test asm__a_narrowing_refuses_what_it_removes_and_its_lift_widens {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    var removed: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option push\n.option norvc\nc.nop\n");
    if (sel removed.ok) {
        mink_object.release(?removed.ok);
        ret 2;
    }
    if (removed.err.span.start.line != 3) { ret 3; }
    var out:    vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t.t));
    val worded: err[A.Error]      = state.spell_refusal(removed.err.message, ?removed.err.unmet, ?out);
    if (sel worded.err || !t_is(view(out.data, out.len), "instruction not admitted by the selection: needs zca")) { ret 10; }
    vector.dnit[u8](?out);
    var popped: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option push\n.option pop\n.option pop\n");
    if (!t_refused(?popped, model.NOTHING_PUSHED, 3, 9)) { ret 4; }
    var unknown: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option frob\n");
    if (!t_refused(?unknown, model.UNKNOWN_FORM, 1, 9)) { ret 5; }
    if (!t_release(?t))                                 { ret 6; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 7; }
    var widened: res[mink_object.Object, model.Refusal] = t_assemble(?u, ".option norvc\n.option rvc\nc.nop\n");
    if (sel widened.err) { ret 8; }
    var o:   mink_object.Object = widened.ok;
    val nop: [2]u8              = [2]u8{0x01, 0x00};
    if (!t_holds(?o, ".text", ?nop[0], 2)) { ret 9; }
    if (!t_done(?u, ?o))                   { ret 9; }
    ret 0;
}

# whether `o` states flag `x` at `on`
#[testing]
fun t_flag(o: *mink_object.Object, x: *mink_trait.Axis, on: bool) bool {
    val got: opt[mink_trait.Setting] = mink_object.effective(o, x);
    ret sel got.some && (sel got.some.flag && got.some.flag == on);
}

# `.option arch, +zbb` admits zbb's rows past an rv64i object's selection for the lines after it and `.option pop` takes
# them back, as llvm-mc 23.1.1 assembles the kernel's alternatives (#248)
test asm__option_arch_widens_past_the_object_until_pop {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var popped: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option push\n.option arch, +zbb\nandn a0, a1, a2\n.option pop\nandn a0, a1, a2\n");
    if (!t_refused(?popped, field.NOT_ADMITTED, 5, 1)) { ret 2; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option push\n.option arch, +zbb\nandn a0, a1, a2\n.option pop\nadd a0, a1, a2\n");
    if (sel got.err) { ret 3; }
    var o:    mink_object.Object = got.ok;
    val want: [8]u8              = [8]u8{0x33, 0xf5, 0xc5, 0x40, 0x33, 0x85, 0xc5, 0x00};
    if (!t_holds(?o, ".text", ?want[0], 8)) { ret 4; }
    # rvc is the object's as a whole: an object built without c that writes under a view holding it states rvc
    if (!t_flag(?o, ?arch_riscv.RISCV_RVC, false)) { ret 5; }
    if (!t_done(?t, ?o))                           { ret 6; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 7; }
    var c: res[mink_object.Object, model.Refusal] = t_assemble(?u, ".option arch, +c\nc.nop\n");
    if (sel c.err) { ret 8; }
    var p: mink_object.Object = c.ok;
    if (!t_flag(?p, ?arch_riscv.RISCV_RVC, true)) { ret 9; }
    if (!t_done(?u, ?p))                          { ret 10; }
    ret 0;
}

#[testing]
val T_ZBB: [1]requirement.Id = [1]requirement.Id{riscv_extension.id.ZBB};

# a dialect's widening hook of the test: ebreak widens the selection by zbb, as spir-v's OpCapability widens it
#[testing]
fun t_widens(ins: *inst.Inst) requirement.Ids {
    if (ins.row == ?gen_row.ROWS[gen_row_index.EBREAK]) { ret requirement.Ids{at: ?T_ZBB[0], len: 1}; }
    ret requirement.NO_IDS;
}

# an instruction its dialect widens the selection by widens it once it is written, so a row gated on what it adds
# assembles after it and is refused before it
test asm__an_instruction_widens_the_selection_after_it_is_written {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var s: set.Set = riscv_set.SET;
    s.source.widens = t_widens;
    val text: str                                    = "ebreak\nandn a0, a1, a2\n";
    var got:  res[mink_object.Object, model.Refusal] = assemble(testing.allocator_of(?t.t), ?s, ?t.ctx, t_options(?t), text, str_len(text), diagnostic.START);
    if (sel got.err) { ret 2; }
    var o:    mink_object.Object = got.ok;
    val want: [8]u8              = [8]u8{0x73, 0x00, 0x10, 0x00, 0x33, 0xf5, 0xc5, 0x40};
    if (!t_holds(?o, ".text", ?want[0], 8)) { ret 3; }
    mink_object.release(?o);
    val before: str                                    = "andn a0, a1, a2\nebreak\n";
    var early:  res[mink_object.Object, model.Refusal] = assemble(testing.allocator_of(?t.t), ?s, ?t.ctx, t_options(?t), before, str_len(before), diagnostic.START);
    if (!t_refused(?early, field.NOT_ADMITTED, 1, 1)) { ret 4; }
    if (!t_release(?t))                               { ret 5; }
    ret 0;
}

test asm__option_push_and_pop_restore_the_selection {
    var t: T;
    if (!t_make(?t, "rv64ic_zba")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option push\n.option arch, -zba\n.option push\n.option arch, -c\n.option norvc\n.option pop\nc.nop\n.option pop\nsh1add a0, a1, a2\nc.nop\n");
    if (sel got.err) { ret 2; }
    var o:    mink_object.Object = got.ok;
    val want: [8]u8              = [8]u8{0x01, 0x00, 0x33, 0xa5, 0xc5, 0x20, 0x01, 0x00};
    if (!t_holds(?o, ".text", ?want[0], 8)) { ret 3; }
    if (!t_done(?t, ?o))                    { ret 4; }
    ret 0;
}

test asm__option_arch_changes_admission_for_the_lines_after_it {
    var t: T;
    if (!t_make(?t, "rv64imc_zba")) { ret 1; }
    var removed: res[mink_object.Object, model.Refusal] = t_assemble(?t, "sh1add a0, a1, a2\n.option arch, -zba\nsh1add a0, a1, a2\n");
    if (!t_refused(?removed, field.NOT_ADMITTED, 3, 1)) { ret 2; }
    if (sel removed.ok)                                 { ret 2; }
    # the refusal names what the restatement removed, which the object's selection holds
    var out:    vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t.t));
    val worded: err[A.Error]      = state.spell_refusal(removed.err.message, ?removed.err.unmet, ?out);
    if (sel worded.err || !t_is(view(out.data, out.len), "instruction not admitted by the selection: needs zba")) { ret 9; }
    vector.dnit[u8](?out);
    var whole: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option arch, rv64i\nadd a0, a1, a2\nmul a0, a1, a2\n");
    if (!t_refused(?whole, field.NOT_ADMITTED, 3, 1)) { ret 3; }
    # the object's xlen is not switched
    var other: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option arch, rv32i\n");
    if (!t_refused(?other, build.WIDENED, 1, 15)) { ret 4; }
    var implied: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option arch, -zca\n");
    if (!t_refused(?implied, model.STILL_IMPLIED, 1, 16)) { ret 5; }
    # an edit adds back what a narrowing took, and a lift what an edit took, as llvm-mc reads them
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".option arch, -zba, +zba\nsh1add a0, a1, a2\n.option norvc\n.option arch, +c\nc.nop\n.option arch, -c\n.option rvc\nc.nop\n");
    if (sel got.err) { ret 6; }
    var o:    mink_object.Object = got.ok;
    val want: [8]u8              = [8]u8{0x33, 0xa5, 0xc5, 0x20, 0x01, 0x00, 0x01, 0x00};
    if (!t_holds(?o, ".text", ?want[0], 8)) { ret 7; }
    if (!t_done(?t, ?o))                    { ret 8; }
    ret 0;
}

test asm__insn_states_an_instruction_by_its_encoding {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    var unknown: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".insn q 1, 2\n");
    if (!t_refused(?unknown, parse.UNKNOWN_FORMAT, 1, 7)) { ret 2; }
    var short: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".insn 4, 0x1\n");
    if (!t_refused(?short, model.LENGTH_MISMATCH, 1, 7)) { ret 3; }
    # bits 14 to 12 all set state an encoding of 192 bits or more, which no raw form takes
    var reserved: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".insn 0x707f\n");
    if (!t_refused(?reserved, model.RESERVED_LENGTH, 1, 7)) { ret 4; }
    # an 80 bit encoding is a literal past the integers, and a 4 byte stated length of one is refused (#296)
    var narrow: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".insn 4, 0x7f\n");
    if (!t_refused(?narrow, model.LENGTH_MISMATCH, 1, 7)) { ret 18; }
    var long: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".insn 10, 0x1234567890abcdef007f\n.insn 0x1234567890abcdef007f\n.insn 0x7f\n");
    if (sel long.err) { ret 19; }
    var w: mink_object.Object = long.ok;
    # the bytes gas 2.47 writes
    val gas: [30]u8 = [30]u8{0x7f, 0x00, 0xef, 0xcd, 0xab, 0x90, 0x78, 0x56, 0x34, 0x12, 0x7f, 0x00, 0xef, 0xcd, 0xab, 0x90, 0x78, 0x56, 0x34, 0x12, 0x7f, 0, 0, 0, 0, 0, 0, 0, 0, 0};
    if (!t_holds(?w, ".text", ?gas[0], 30)) { ret 20; }
    mink_object.release(?w);
    var wide: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".insn r 0x80, 0, 0, a0, a1, a2\n");
    if (!t_refused(?wide, field.OUT_OF_RANGE, 1, 9)) { ret 5; }
    # a format of fields, its load form, a compressed one, a branch folded to a label, and raw forms by length, the
    # bytes llvm-mc 23.1.1 writes
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".insn r 0x33, 0, 0, a0, a1, a2\nback:\n.insn i 0x03, 2, a0, 8(a1)\n.insn cl 0, 2, a0, 31(a1)\n.insn b 0x63, 1, a0, a1, back\n.insn 0x1\n.insn 6, 0x1f\n");
    if (sel got.err) { ret 6; }
    var o:    mink_object.Object = got.ok;
    val want: [22]u8             = [22]u8{0x33, 0x85, 0xc5, 0x00, 0x03, 0xa5, 0x85, 0x00, 0xe8, 0x5d, 0xe3, 0x1d, 0xb5, 0xfe, 0x01, 0x00, 0x1f, 0x00, 0x00, 0x00, 0x00, 0x00};
    if (!t_holds(?o, ".text", ?want[0], 22)) { ret 7; }
    mink_object.release(?o);
    # an opcode by its name, in any case, encodes as its number, and a quadrant name only in a compressed format (#259)
    var named: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".insn r OP, 0, 0, a0, a1, a2\nback:\n.insn i load, 2, a0, 8(a1)\n.insn cl C0, 2, a0, 31(a1)\n.insn b BRANCH, 1, a0, a1, back\n.insn 0x1\n.insn 6, 0x1f\n");
    if (sel named.err) { ret 14; }
    var n: mink_object.Object = named.ok;
    if (!t_holds(?n, ".text", ?want[0], 22)) { ret 15; }
    mink_object.release(?n);
    var quadrant: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".insn r C0, 0, 0, a0, a1, a2\n");
    if (sel quadrant.ok) {
        mink_object.release(?quadrant.ok);
        ret 17;
    }
    if (!t_release(?t)) { ret 16; }
    # a compressed encoding needs c or zca
    var plain: T;
    if (!t_make(?plain, "rv64i")) { ret 9; }
    var packed: res[mink_object.Object, model.Refusal] = t_assemble(?plain, ".insn 2, 0x1\n");
    if (!t_refused(?packed, field.NOT_ADMITTED, 1, 7)) { ret 10; }
    # a register operand of a format admits an f register under a selection without f, as llvm-mc 23.1.1 reads it (#260)
    var any: res[mink_object.Object, model.Refusal] = t_assemble(?plain, ".insn r 0x53, 0, 0, fa0, fa1, fa2\n");
    if (sel any.err) { ret 11; }
    var f:    mink_object.Object = any.ok;
    val fadd: [4]u8              = [4]u8{0x53, 0x85, 0xc5, 0x00};
    if (!t_holds(?f, ".text", ?fadd[0], 4)) { ret 12; }
    if (!t_done(?plain, ?f))                { ret 13; }
    ret 0;
}

# vmslt.vi and vmsltu.vi read as vmsle.vi and vmsleu.vi with the immediate less one, vmsltu.vi with 0 as vmsne.vv of vs2
# with itself, and an immediate whose decrement leaves simm5 is refused, the bytes llvm-mc 23.1.1 writes (#209)
test asm__vmslt_vi_reads_as_vmsle_vi_with_the_immediate_less_one {
    var t: T;
    if (!t_make(?t, "rv64iv")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, "vmslt.vi v1, v2, 16\nvmslt.vi v1, v2, -15\nvmslt.vi v1, v2, 0, v0.t\nvmsltu.vi v1, v2, 16\nvmsltu.vi v1, v2, 0\nvmsltu.vi v1, v2, 1\n");
    if (sel got.err) { ret 2; }
    var o:    mink_object.Object = got.ok;
    val want: [24]u8             = [24]u8{0xd7, 0xb0, 0x27, 0x76, 0xd7, 0x30, 0x28, 0x76, 0xd7, 0xb0, 0x2f, 0x74, 0xd7, 0xb0, 0x27, 0x72, 0xd7, 0x00, 0x21, 0x66, 0xd7, 0x30, 0x20, 0x72};
    if (!t_holds(?o, ".text", ?want[0], 24)) { ret 3; }
    mink_object.release(?o);
    var high: res[mink_object.Object, model.Refusal] = t_assemble(?t, "vmslt.vi v1, v2, 17\n");
    if (sel high.ok) {
        mink_object.release(?high.ok);
        ret 4;
    }
    var low: res[mink_object.Object, model.Refusal] = t_assemble(?t, "vmsltu.vi v1, v2, -16\n");
    if (sel low.ok) {
        mink_object.release(?low.ok);
        ret 5;
    }
    if (!t_release(?t)) { ret 6; }
    ret 0;
}

# the setting `text` assembled states on `x`, none when it is refused or states none. a text is checked against `want`,
# and is none when it differs
#[testing]
fun t_stated(t: *T, text: str, x: *mink_trait.Axis, want: str) opt[mink_trait.Setting] {
    var got: res[mink_object.Object, model.Refusal] = t_assemble(t, text);
    if (sel got.err) { ret opt[mink_trait.Setting].none{}; }
    var o:      mink_object.Object      = got.ok;
    var stated: opt[mink_trait.Setting] = mink_object.stated(?o, x);
    var same:   bool                    = true;
    if (sel stated.some) {
        val v: mink_trait.Setting = stated.some;
        if (sel v.text) {
            val bytes: store.Bytes = store.bytes(?o.store, ?v.text);
            same = t_is(View{data: bytes.data, len: bytes.len}, want);
        }
    }
    if (!same) { stated = opt[mink_trait.Setting].none{}; }
    mink_object.release(?o);
    ret stated;
}

# whether `got` is the number `n`
#[testing]
fun t_number(got: opt[mink_trait.Setting], n: u64) bool {
    if (!sel got.some)        { ret false; }
    if (!sel got.some.number) { ret false; }
    ret got.some.number == n;
}

# whether `got` is the choice `c`
#[testing]
fun t_choice(got: opt[mink_trait.Setting], c: *mink_trait.Choice) bool {
    if (!sel got.some)        { ret false; }
    if (!sel got.some.choice) { ret false; }
    ret got.some.choice == c;
}

# a tag is the elf psabi's, by its name less or with its vendor's prefix, or by its number (risc-v psabi, "RISC-V ELF
# Attributes"), and the object's selection states arch, which a statement of it may only name again
test asm__attribute_states_the_trait_the_format_names_by_the_tag {
    var t: T;
    if (!t_make(?t, "rv64im"))                                                                               { ret 1; }
    if (!t_number(t_stated(?t, ".attribute stack_align, 16\n", ?arch_riscv.RISCV_STACK_ALIGN, nil), 16))     { ret 2; }
    if (!t_number(t_stated(?t, ".attribute 4, 8\n", ?arch_riscv.RISCV_STACK_ALIGN, nil), 8))                 { ret 3; }
    if (!t_number(t_stated(?t, ".attribute Tag_RISCV_priv_spec, 1\n", ?arch_riscv.RISCV_PRIV_SPEC, nil), 1)) { ret 4; }
    val flag: opt[mink_trait.Setting] = t_stated(?t, ".attribute 6, 1\n", ?arch_riscv.RISCV_UNALIGNED_ACCESS, nil);
    if (!sel flag.some) { ret 5; }
    val on: mink_trait.Setting = flag.some;
    if (!sel on.flag) { ret 5; }
    if (!on.flag)     { ret 5; }
    # the selection's own versioned spelling, stated or not, and whatever spelling names it
    val arch: opt[mink_trait.Setting] = t_stated(?t, "nop\n", ?arch_riscv.RISCV_ARCH, "rv64i2p1_m2p0_zmmul1p0");
    if (!sel arch.some) { ret 6; }
    val named: opt[mink_trait.Setting] = t_stated(?t, ".attribute 5, \"rv64im\"\n", ?arch_riscv.RISCV_ARCH, "rv64i2p1_m2p0_zmmul1p0");
    if (!sel named.some) { ret 7; }
    var other: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".attribute arch, \"rv64i\"\n");
    if (!t_refused(?other, model.OTHER_SELECTION, 1, 18)) { ret 8; }
    var unknown: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".attribute 99, 1\n");
    if (!t_refused(?unknown, model.UNKNOWN_TAG, 1, 12)) { ret 9; }
    # a choice is the setting its written code maps to (risc-v psabi, Tag_RISCV_atomic_abi and Tag_RISCV_x3_reg_usage)
    if (!t_choice(t_stated(?t, ".attribute atomic_abi, 1\n", ?arch_riscv.RISCV_ATOMIC_ABI, nil), ?arch_riscv.RISCV_ATOMIC_A6C)) { ret 10; }
    if (!t_choice(t_stated(?t, ".attribute 16, 1\n", ?arch_riscv.RISCV_X3_REG_USAGE, nil), ?arch_riscv.RISCV_X3_GP))            { ret 11; }
    var code: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".attribute atomic_abi, 9\n");
    if (!t_refused(?code, model.TAG_VALUE, 1, 24)) { ret 12; }
    if (!t_release(?t))                            { ret 13; }
    ret 0;
}

# GA3's compute module, as spirv-as 2026.4 reads it
#[testing]
val T_GA3: str = "OpCapability Shader\nOpCapability Int64\nOpMemoryModel Logical GLSL450\nOpEntryPoint GLCompute %1 \"main\"\nOpExecutionMode %1 LocalSize 8 4 1\nOpDecorate %5 SpecId 3\n%2 = OpTypeVoid\n%3 = OpTypeFunction %2\n%4 = OpTypeInt 32 0\n%5 = OpSpecConstant %4 7\n%6 = OpConstant %4 1\n%7 = OpConstant %4 2\n%8 = OpTypeInt 64 0\n%9 = OpConstant %8 0x100000000\n%1 = OpFunction %2 None %3\n%10 = OpLabel\n%11 = OpIAdd %4 %5 %6\nOpSelectionMerge %13 None\nOpSwitch %11 %12 1 %14 2 %15\n%14 = OpLabel\nOpBranch %13\n%15 = OpLabel\nOpBranch %13\n%12 = OpLabel\nOpBranch %13\n%13 = OpLabel\n%16 = OpPhi %4 %6 %14 %7 %15 %11 %12\nOpReturn\nOpFunctionEnd\n";

# the words `spirv-as --preserve-numeric-ids --target-env spv1.0` 2026.4 writes for T_GA3, whose third is its generator
#[testing]
val T_GA3_WORDS: [104]u32 = [104]u32{
    0x07230203, 0x00010000, 0x00070000, 0x00000011, 0x00000000, 0x00020011, 0x00000001, 0x00020011,
    0x0000000b, 0x0003000e, 0x00000000, 0x00000001, 0x0005000f, 0x00000005, 0x00000001, 0x6e69616d,
    0x00000000, 0x00060010, 0x00000001, 0x00000011, 0x00000008, 0x00000004, 0x00000001, 0x00040047,
    0x00000005, 0x00000001, 0x00000003, 0x00020013, 0x00000002, 0x00030021, 0x00000003, 0x00000002,
    0x00040015, 0x00000004, 0x00000020, 0x00000000, 0x00040032, 0x00000004, 0x00000005, 0x00000007,
    0x0004002b, 0x00000004, 0x00000006, 0x00000001, 0x0004002b, 0x00000004, 0x00000007, 0x00000002,
    0x00040015, 0x00000008, 0x00000040, 0x00000000, 0x0005002b, 0x00000008, 0x00000009, 0x00000000,
    0x00000001, 0x00050036, 0x00000002, 0x00000001, 0x00000000, 0x00000003, 0x000200f8, 0x0000000a,
    0x00050080, 0x00000004, 0x0000000b, 0x00000005, 0x00000006, 0x000300f7, 0x0000000d, 0x00000000,
    0x000700fb, 0x0000000b, 0x0000000c, 0x00000001, 0x0000000e, 0x00000002, 0x0000000f, 0x000200f8,
    0x0000000e, 0x000200f9, 0x0000000d, 0x000200f8, 0x0000000f, 0x000200f9, 0x0000000d, 0x000200f8,
    0x0000000c, 0x000200f9, 0x0000000d, 0x000200f8, 0x0000000d, 0x000900f5, 0x00000004, 0x00000010,
    0x00000006, 0x0000000e, 0x00000007, 0x0000000f, 0x0000000b, 0x0000000c, 0x000100fd, 0x00010038
};

# the generator word, the one the tool that wrote a module names itself by, the only word GA3's two modules differ in
#[testing]
val T_GENERATOR: usize = 2;

# GA3: a compute module from spirv-as text, built through the builder into mink's spir-v container, is the module
# spirv-as writes for it word for word, but the generator word, which names the tool that wrote it
test asm__a_spirv_compute_module_builds_to_the_words_spirv_as_writes {
    var t: T;
    testing.make(?t.t);
    val a:       *A.Allocator                      = testing.allocator_of(?t.t);
    val formats: res[registry.Registry, fail.Fail] = registry.builtin(a);
    if (sel formats.err) { ret 1; }
    t.formats = formats.ok;
    val made: res[extension.Selection, extension.Error] = extension.select(a, ?spirv_extension.CATALOG, "spv1.0", diagnostic.START);
    if (sel made.err) { ret 1; }
    t.s = made.ok;
    val opened: res[state.Context, state.Opened] = set.open(a, ?spirv_set.SET, ?spirv_set.SET.arches.at[0], ?t.s, ?t.v);
    if (sel opened.err) { ret 1; }
    t.ctx = opened.ok;
    val options: model.Options                          = model.Options{arch: ?arch_spirv.SPIRV, formats: ?t.formats, syntax: 0, abi: nil, dialect: ?dialect.SPIRV, layers: model.NO_LAYERS};
    var got:     res[mink_object.Object, model.Refusal] = assemble(a, ?spirv_set.SET, ?t.ctx, options, T_GA3, str_len(T_GA3), diagnostic.START);
    if (sel got.err) { ret 2; }
    var o:     mink_object.Object             = got.ok;
    val built: res[contract.Model, fail.Fail] = registry.from_neutral(?t.formats, ?format.SPIRV, a, ?o);
    if (sel built.err) { ret 3; }
    var m:       contract.Model            = built.ok;
    val written: res[sink.Sink, fail.Fail] = contract.write(?m);
    var same:    bool                      = false;
    if (sel written.ok) {
        var bytes: sink.Sink = written.ok;
        val data:  *u8       = sink.data(?bytes);
        same = sink.len(?bytes) == 104 * 4;
        var i: usize = 0;
        for (same && i < 104) {
            val word: u32 = data[i * 4]::u32 | (data[i * 4 + 1]::u32 << 8) | (data[i * 4 + 2]::u32 << 16) | (data[i * 4 + 3]::u32 << 24);
            if (i != T_GENERATOR && word != T_GA3_WORDS[i]) { same = false; }
            i = i + 1;
        }
        sink.release(?bytes);
    }
    contract.release(?m);
    if (sel written.err) { ret 4; }
    if (!same)           { ret 5; }
    if (!t_done(?t, ?o)) { ret 6; }
    ret 0;
}

# the GNU property note gcc writes for -fcf-protection=full on risc-v: landing pads unlabeled and a shadow stack
#[testing]
val T_CFI_NOTE: str = "\tnop\n\t.section\t.note.gnu.property,\"a\"\n\t.align\t3\n\t.word\t4\n\t.word\t16\n\t.word\t5\n\t.string\t\"GNU\"\n\t.word\t-1073741824\n\t.word\t4\n\t.word\t3\n\t.align\t3\n";

# `o` written as elf and read back through mink, none when either is refused
#[testing]
fun t_elf_again(t: *T, o: *mink_object.Object) opt[mink_object.Object] {
    val a:     *A.Allocator                   = testing.allocator_of(?t.t);
    val built: res[contract.Model, fail.Fail] = registry.from_neutral(?t.formats, ?format.ELF, a, o);
    if (sel built.err) { ret opt[mink_object.Object].none{}; }
    var m:       contract.Model            = built.ok;
    val written: res[sink.Sink, fail.Fail] = contract.write(?m);
    if (sel written.err) {
        contract.release(?m);
        ret opt[mink_object.Object].none{};
    }
    var bytes: sink.Sink                      = written.ok;
    var in:    contract.Input                 = contract.Input{file: "t.o", data: sink.data(?bytes), len: sink.len(?bytes)};
    val read_: res[contract.Model, fail.Fail] = registry.read(?t.formats, a, ?in);
    var back:  mink_object.Object             = mink_object.make(a, nil);
    var ok:    bool                           = false;
    if (sel read_.ok) {
        var r:         contract.Model = read_.ok;
        val converted: err[fail.Fail] = contract.to_neutral(?r, ?t.formats.relocs, ?back);
        ok = !sel converted.err;
        contract.release(?r);
    }
    sink.release(?bytes);
    contract.release(?m);
    if (!ok) {
        mink_object.release(?back);
        ret opt[mink_object.Object].none{};
    }
    ret opt[mink_object.Object].some{back};
}

# the property note the source writes is raised into the object's traits through mink's elf rows, so the object holds
# no section of it and the note elf writes is the traits', the one llvm-mc 23.1.1 writes for the same source
test asm__a_property_note_the_source_writes_is_raised_into_the_traits {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, T_CFI_NOTE);
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    if (t_section(?o, ".note.gnu.property") != nil)                                                           { ret 3; }
    if (!t_flag(?o, ?arch_riscv.RISCV_CFI_LP_UNLABELED, true) || !t_flag(?o, ?arch_riscv.RISCV_CFI_SS, true)) { ret 4; }
    if (!t_flag(?o, ?arch_riscv.RISCV_CFI_LP_FUNC_SIG, false))                                                { ret 5; }
    var again: opt[mink_object.Object] = t_elf_again(?t, ?o);
    if (sel again.none) { ret 6; }
    var b:    mink_object.Object = again.some;
    val same: bool               = t_flag(?b, ?arch_riscv.RISCV_CFI_LP_UNLABELED, true) && t_flag(?b, ?arch_riscv.RISCV_CFI_SS, true) && t_flag(?b, ?arch_riscv.RISCV_CFI_LP_FUNC_SIG, false);
    mink_object.release(?b);
    if (!same)           { ret 7; }
    if (!t_done(?t, ?o)) { ret 8; }
    ret 0;
}

# a bit no trait row maps is refused carrying mink's refusal, which names it, and a statement other than data in a
# section the format holds the traits in is refused where it stands
test asm__a_property_note_mink_maps_no_trait_of_or_an_instruction_in_it_is_refused {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    var bit: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".section .note.gnu.property,\"a\"\n.align 3\n.word 4, 16, 5\n.string \"GNU\"\n.word -1073741824, 4, 8, 0\n");
    if (sel bit.ok) {
        mink_object.release(?bit.ok);
        ret 2;
    }
    if (!str_equals(bit.err.message, build.RAISE)) { ret 3; }
    if (!sel bit.err.cause.some)                   { ret 4; }
    var code: res[mink_object.Object, model.Refusal] = t_assemble(?t, "nop\n.section .note.gnu.property,\"a\"\nnop\n");
    if (!t_refused(?code, build.RAISED, 3, 1)) { ret 5; }
    var apart: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".section .riscv.attributes,\"\",@progbits,unique,1\n");
    if (!t_refused(?apart, build.TRAIT_SECTION, 1, 10)) { ret 6; }
    if (!t_release(?t))                                 { ret 7; }
    ret 0;
}

test asm__type_and_size_are_recorded_on_the_symbol {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".globl f\n.type f, @function\nf: addi a0, a0, 1\n ret\n.size f, . - f\n.data\n.type obj, %object\nobj: .long 0\n.size obj, 4\n");
    if (sel got.err) { ret 2; }
    var o: mink_object.Object  = got.ok;
    val f: *mink_object.Symbol = t_symbol(?o, "f");
    if (f == nil || f.kind != ?symbol.FUNCTION || f.binding != ?symbol.GLOBAL) { ret 3; }
    if (!(sel f.size.some && f.size.some == 8))                                { ret 4; }
    val obj: *mink_object.Symbol = t_symbol(?o, "obj");
    if (obj == nil || obj.kind != ?symbol.DATA || obj.binding != ?symbol.LOCAL) { ret 5; }
    if (!(sel obj.size.some && obj.size.some == 4))                             { ret 6; }
    if (!t_done(?t, ?o))                                                        { ret 7; }
    ret 0;
}

# a file of every core directive
#[testing]
val T_EVERY: str = "\t.text\n\t.globl main, helper\n\t.weak weakling\n\t.hidden helper\n\t.protected main\n\t.internal quiet\n\t.local quiet\n\t.type main, @function\nmain:\n\tcall helper\n\tcall weakling\n\tret\n\t.size main, . - main\n\t.p2align 2\nhelper: ret\nquiet: nop\n\t.balign 8\n\t.align 3\n\t.section .rodata, \"a\", @progbits\nmsg:\t.string \"hi\"\n\t.ascii \"x\"\n\t.asciz \"y\"\n\t.pushsection .data\n\t.byte 1\n\t.short 2\n\t.word 3\n\t.long main - .\n\t.quad msg + 1\n\t.uleb128 300\n\t.sleb128 -300\n\t.float 2.5\n\t.double -0.5\n\t.popsection\n\t.data\n\t.skip 3, 7\n\t.zero 2\n\t.fill 2, 2, 0x1234\n\t.set n, 4\n\t.equ m, n * 2\n\t.long m\n\t.previous\n\t.bss\n\t.zero 4\n\t.comm shared, 16, 8\n\t.lcomm own, 4\n\t.section .note.GNU-stack, \"\", @progbits\n";

test asm__a_file_of_every_core_directive_assembles_to_an_object_mink_reads {
    var t: T;
    if (!t_make(?t, "rv64imac")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, T_EVERY);
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    # the abi `-mabi=lp64d` spells is the one the object carries
    val carried: opt[mink_trait.Setting] = mink_object.stated(?o, ?arch_riscv.RISCV_FLOAT_ABI);
    if (sel carried.none)                                                              { ret 4; }
    if (!(sel carried.some.choice && carried.some.choice == ?arch_riscv.RISCV_DOUBLE)) { ret 4; }
    val main: *mink_object.Symbol = t_symbol(?o, "main");
    if (main == nil || main.visibility != ?symbol.PROTECTED)                                                                            { ret 5; }
    if (sel main.size.none)                                                                                                             { ret 5; }
    if (t_symbol(?o, "quiet") == nil || t_symbol(?o, "weakling") == nil || t_symbol(?o, "shared") == nil || t_symbol(?o, "own") == nil) { ret 6; }
    # mink's elf relocations for the object's architecture take each of its relocations
    val elf:   res[registry.Relocations, fail.Fail] = registry.relocations(?t.formats, ?format.ELF, o.target.arch);
    var taken: bool                                 = false;
    if (sel elf.ok) {
        var rows: registry.Relocations = elf.ok;
        taken = o.relocs.count > 0;
        var r: usize = 0;
        for (taken && r < o.relocs.count) {
            val row_: res[*registry.Row, fail.Fail] = registry.relocation_by_kind(?rows, o.relocs.items[r].kind);
            taken = sel row_.ok;
            r     = r + 1;
        }
    }
    if (!taken)          { ret 8; }
    if (!t_done(?t, ?o)) { ret 9; }
    ret 0;
}
