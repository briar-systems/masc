# assembling source text into objects through the builder
#
# the file-level assembler: a .s file read through the source model of
# `masc.asm.model` with the core directives of `masc.asm.core`, the set's
# integer data directives, and any layers the caller adds, into mink's
# neutral object in memory.
#
# a dialect whose text states the one module its format builds
# (`dialect.Dialect.module`) is read as the disassembler writes it. a module
# that is one instruction stream (`stream.Module.stream`), as spir-v's, is
# the builder's one section of that stream, so it is assembled as any other
# source. a module with text of its own (`stream.Module.printed`), as wasm's
# fields, is read whole by its set's reader, and the file is the bytes the
# format writes of the module it reads back to, which no neutral object
# stands between.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;

use mink.base.fail;
use mink.bytes.sink;
use mink_arch:   mink.catalog.arch;
use mink_object: mink.model.object;

use masc.asm.core;
use masc.asm.model;
use masc.asm.source;
use masc.build.build;
use masc.core.diagnostic;
use masc.core.field;
use masc.core.mode;
use masc.core.set;
use core_source: masc.core.source;
use masc.core.state;
use masc.core.stream;
use masc.core.trait;

# an assembler over `s` with the core directives, the set's integer data directives and `options.layers`, its
# current section `.text`, writing under the object's context `object`, which the caller makes with `set.open` for
# `options.arch` and keeps until the assembler is released
pub fun make(a: *A.Allocator, s: *set.Set, object: *state.Context, options: model.Options) res[model.Assembler, model.Refusal] {
    val made: res[model.Assembler, model.Refusal] = model.make(a, s, object, options, ?core.LAYER, core.integers, core.named_section);
    if (sel made.err) { ret made; }
    var m:     model.Assembler = made.ok;
    val begun: err[str]        = core.begin(?m);
    if (sel begun.err) {
        model.release(?m);
        ret res[model.Assembler, model.Refusal].err{model.Refusal{message: begun.err, span: diagnostic.Span{start: diagnostic.START, len: 0}, site: diagnostic.START, mode: opt[build.Mismatch].none{}, unmet: state.nothing_unmet()}};
    }
    ret res[model.Assembler, model.Refusal].ok{m};
}

# the `len` bytes of `text`, whose first byte is at `origin`, assembled under the object's context `object` into mink's
# neutral object, which the caller releases
pub fun assemble(a: *A.Allocator, s: *set.Set, object: *state.Context, options: model.Options, text: *u8, len: usize, origin: diagnostic.Position) res[mink_object.Object, model.Refusal] {
    val made: res[model.Assembler, model.Refusal] = make(a, s, object, options);
    if (sel made.err) { ret res[mink_object.Object, model.Refusal].err{made.err}; }
    var m:   model.Assembler    = made.ok;
    val ran: err[model.Refusal] = read(?m, s, text, len, origin);
    if (sel ran.err) {
        model.release(?m);
        ret res[mink_object.Object, model.Refusal].err{ran.err};
    }
    val o: res[mink_object.Object, model.Refusal] = model.finish(?m);
    model.release(?m);
    ret o;
}

# the `len` bytes of `text`, whose first byte is at `origin`, read by the assembler `m` over `s` into its builder, which
# the caller finishes, so a caller that reads the builder's record after the object is made, as a listing does, keeps it
pub fun read(m: *model.Assembler, s: *set.Set, text: *u8, len: usize, origin: diagnostic.Position) err[model.Refusal] {
    val seen: err[model.Refusal] = foreseen(m, s, text, len, origin);
    if (sel seen.err) { ret seen; }
    var lexer: source.Lexer = source.lexer(text, len, origin, ?s.source);
    var feed:  source.Feed  = source.feed(?lexer);
    ret model.run(m, ?feed);
}

# every instruction statement of the `len` bytes of `text`, whose first byte is at `origin`, handed to the stream's
# `ahead` before the assembler reads any, refused where the text is malformed as reading it would refuse it
fun foreseen(m: *model.Assembler, s: *set.Set, text: *u8, len: usize, origin: diagnostic.Position) err[model.Refusal] {
    if (s.codec == nil) { ret err[model.Refusal].ok{}; }
    val h: *stream.Hooks = s.codec.stream;
    if (h == nil || h.ahead == nil) { ret err[model.Refusal].ok{}; }
    val v:     *state.Context = build.view(model.builder(m));
    var lexer: source.Lexer   = source.lexer(text, len, origin, ?s.source);
    var feed:  source.Feed    = source.feed(?lexer);
    var st:    source.Statement;
    for {
        val more: res[bool, diagnostic.Diagnostic] = feed.next(feed.context, ?st);
        if (sel more.err)                  { ret err[model.Refusal].err{model.diagnosed(more.err, more.err.span.start, v)}; }
        if (!more.ok)                      { brk; }
        if (st.kind != source.INSTRUCTION) { cnt; }
        val whole: View     = View{data: ?st.text[st.head.at], len: st.body.at + st.body.len - st.head.at};
        val held:  err[str] = h.ahead(v.stream, whole);
        if (sel held.err) { ret err[model.Refusal].err{model.nowhere(held.err)}; }
    }
    ret err[model.Refusal].ok{};
}

# what a source assembles to, as its dialect states an object
# ---
# object: mink's neutral object, which the caller writes through the format and releases
# module: the bytes the format writes of the module the text states, which the caller writes as they are and releases
pub tag Assembled: u8 {
    object: mink_object.Object;
    module: sink.Sink;
}

# the `len` bytes of `text`, whose first byte is at `origin`, assembled under the object's context `object` as the
# dialect `options.dialect` states an object: the module of a dialect whose text prints one, read whole by its reader
# (`printed`), and every other text through the builder (`assemble`)
pub fun assembled(a: *A.Allocator, s: *set.Set, object: *state.Context, options: model.Options, text: *u8, len: usize, origin: diagnostic.Position) res[Assembled, model.Refusal] {
    val m: *stream.Module = options.dialect.module;
    if (m != nil) {
        if (sel m.printed) { ret printed(a, s, object, options.arch, m.printed, text, len, origin); }
    }
    val o: res[mink_object.Object, model.Refusal] = assemble(a, s, object, options, text, len, origin);
    if (sel o.err) { ret res[Assembled, model.Refusal].err{o.err}; }
    ret res[Assembled, model.Refusal].ok{Assembled.object{o.ok}};
}

# the bytes the format writes of the module the `len` bytes of `text`, whose first byte is at `origin`, read back to
# through `p` under the object's context `object` and a stream of its own, refused, as every object is, for a context
# that does not enter `arch`
fun printed(a: *A.Allocator, s: *set.Set, object: *state.Context, arch: *mink_arch.Arch, p: stream.Printed, text: *u8, len: usize, origin: diagnostic.Position) res[Assembled, model.Refusal] {
    val entered: err[build.Refusal] = build.enters(s, arch, object);
    if (sel entered.err) { ret res[Assembled, model.Refusal].err{model.refused_build(entered.err)}; }
    # a typed stream's state is the module's, begun by its reader, as the builder begins an object's
    var v: state.Context = @object;
    val h: *stream.Hooks = s.codec.stream;
    if (h != nil) {
        if (object.stream != nil) { ret res[Assembled, model.Refusal].err{model.nowhere(build.STREAMED)}; }
        val made: res[ptr, A.Error] = h.make(a);
        if (sel made.err) { ret res[Assembled, model.Refusal].err{model.nowhere(field.MEMORY)}; }
        v.stream = made.ok;
    }
    fin {
        if (h != nil) { h.release(a, v.stream); }
    }
    val back: res[sink.Sink, stream.Unread] = p.read(a, text, len, origin, ?v);
    if (sel back.ok) { ret res[Assembled, model.Refusal].ok{Assembled.module{back.ok}}; }
    var r: model.Refusal;
    if (sel back.err.text) { r = model.diagnosed(back.err.text, back.err.text.span.start, ?v); }
    or (sel back.err.written) {
        r       = model.nowhere(back.err.written.text);
        r.cause = opt[fail.Fail].some{back.err.written};
    }
    ret res[Assembled, model.Refusal].err{r};
}
