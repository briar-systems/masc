# the call frame directives of the gnu assembler, as rows of the source model's directive table
#
# each row reads its operands and makes the call of `masc.emit.cfi` of the
# same name on the assembler's builder, so the text is only a front end: what
# a directive writes is what the call writes. a register is a register of the
# set, read by its syntax's names, and an offset is a constant number of
# bytes. a directive outside a procedure, an end without a start and a
# procedure left open at the end of the source are refused.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use masc.asm.model;
use masc.build.build;
use masc.core.diagnostic;
use masc.core.field;
use rf: masc.core.register;
use masc.emit.cfi;

pub val NOT_A_REGISTER: str = "expected a register";
pub val NOT_A_BYTE:     str = "expected a byte";
pub val NOT_A_SECTION:  str = "expected .eh_frame or .debug_frame";

# what the layer keeps
# ---
# frames: the call frame facts it makes the calls on, attached to the assembler's builder by the first directive
# site:   where the open procedure was started, none when none is open
pub rec Text {
    frames: cfi.Frames;
    site:   opt[diagnostic.Position];
}

# the facts of the layer, attached to the builder when they are not
fun frames_of(m: *model.Assembler, args: *model.Args) res[*cfi.Frames, diagnostic.Diagnostic] {
    val t: *Text = args.layer.context::*Text;
    if (!t.frames.attached) {
        val done: err[build.Refusal] = cfi.attach(model.builder(m), ?t.frames);
        if (sel done.err) { ret res[*cfi.Frames, diagnostic.Diagnostic].err{model.refuse(args, 0, done.err.message)}; }
    }
    ret res[*cfi.Frames, diagnostic.Diagnostic].ok{?t.frames};
}

fun built(args: *model.Args, e: err[build.Refusal]) err[diagnostic.Diagnostic] {
    if (sel e.err) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, e.err.message)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# operand `k` as a register
fun register_of(args: *model.Args, k: u32) res[rf.Id, diagnostic.Diagnostic] {
    if (k >= args.count) { ret res[rf.Id, diagnostic.Diagnostic].err{model.refuse(args, k, NOT_A_REGISTER)}; }
    val v: model.Argument = args.items[k].value;
    if (!sel v.register) { ret res[rf.Id, diagnostic.Diagnostic].err{model.refuse(args, k, NOT_A_REGISTER)}; }
    ret res[rf.Id, diagnostic.Diagnostic].ok{v.register};
}

# operand `k` as a number of bytes
fun offset_of(args: *model.Args, k: u32) res[cfi.Offset, diagnostic.Diagnostic] {
    val n: res[i64, diagnostic.Diagnostic] = model.constant(args, k);
    if (sel n.err) { ret res[cfi.Offset, diagnostic.Diagnostic].err{n.err}; }
    ret res[cfi.Offset, diagnostic.Diagnostic].ok{cfi.bytes(n.ok)};
}

fun do_startproc(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    val done: err[diagnostic.Diagnostic] = built(args, cfi.start_proc(model.builder(m), f.ok));
    if (sel done.err) { ret done; }
    val t: *Text = args.layer.context::*Text;
    t.site = opt[diagnostic.Position].some{args.statement.site};
    ret done;
}

fun do_endproc(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    val done: err[diagnostic.Diagnostic] = built(args, cfi.end_proc(model.builder(m), f.ok));
    if (sel done.err) { ret done; }
    val t: *Text = args.layer.context::*Text;
    t.site = opt[diagnostic.Position].none{};
    ret done;
}

fun do_def_cfa(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    val r: res[rf.Id, diagnostic.Diagnostic] = register_of(args, 0);
    if (sel r.err) { ret err[diagnostic.Diagnostic].err{r.err}; }
    val o: res[cfi.Offset, diagnostic.Diagnostic] = offset_of(args, 1);
    if (sel o.err) { ret err[diagnostic.Diagnostic].err{o.err}; }
    ret built(args, cfi.def_cfa(model.builder(m), f.ok, r.ok, o.ok));
}

fun do_def_cfa_register(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    val r: res[rf.Id, diagnostic.Diagnostic] = register_of(args, 0);
    if (sel r.err) { ret err[diagnostic.Diagnostic].err{r.err}; }
    ret built(args, cfi.def_cfa_register(model.builder(m), f.ok, r.ok));
}

# `.cfi_def_cfa_offset` when the row's parameter is 0, `.cfi_adjust_cfa_offset` when 1
fun do_cfa_offset(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    val o: res[cfi.Offset, diagnostic.Diagnostic] = offset_of(args, 0);
    if (sel o.err)                 { ret err[diagnostic.Diagnostic].err{o.err}; }
    if (args.directive.param == 1) { ret built(args, cfi.adjust_cfa_offset(model.builder(m), f.ok, o.ok)); }
    ret built(args, cfi.def_cfa_offset(model.builder(m), f.ok, o.ok));
}

# a register saved at an offset: `.cfi_offset` when the row's parameter is 0, `.cfi_rel_offset` when 1 and
# `.cfi_val_offset` when 2
fun do_save(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    val r: res[rf.Id, diagnostic.Diagnostic] = register_of(args, 0);
    if (sel r.err) { ret err[diagnostic.Diagnostic].err{r.err}; }
    val o: res[cfi.Offset, diagnostic.Diagnostic] = offset_of(args, 1);
    if (sel o.err)                 { ret err[diagnostic.Diagnostic].err{o.err}; }
    if (args.directive.param == 1) { ret built(args, cfi.rel_offset(model.builder(m), f.ok, r.ok, o.ok)); }
    if (args.directive.param == 2) { ret built(args, cfi.val_offset(model.builder(m), f.ok, r.ok, o.ok)); }
    ret built(args, cfi.offset(model.builder(m), f.ok, r.ok, o.ok));
}

fun do_register(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    val r: res[rf.Id, diagnostic.Diagnostic] = register_of(args, 0);
    if (sel r.err) { ret err[diagnostic.Diagnostic].err{r.err}; }
    val other: res[rf.Id, diagnostic.Diagnostic] = register_of(args, 1);
    if (sel other.err) { ret err[diagnostic.Diagnostic].err{other.err}; }
    ret built(args, cfi.register(model.builder(m), f.ok, r.ok, other.ok));
}

# a rule of one register: `.cfi_restore` when the row's parameter is 0, `.cfi_undefined` when 1 and `.cfi_same_value`
# when 2
fun do_alone(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    val r: res[rf.Id, diagnostic.Diagnostic] = register_of(args, 0);
    if (sel r.err)                 { ret err[diagnostic.Diagnostic].err{r.err}; }
    if (args.directive.param == 1) { ret built(args, cfi.undefined(model.builder(m), f.ok, r.ok)); }
    if (args.directive.param == 2) { ret built(args, cfi.same_value(model.builder(m), f.ok, r.ok)); }
    ret built(args, cfi.restore(model.builder(m), f.ok, r.ok));
}

fun do_remember_state(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    ret built(args, cfi.remember_state(model.builder(m), f.ok));
}

fun do_restore_state(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    ret built(args, cfi.restore_state(model.builder(m), f.ok));
}

fun do_signal_frame(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    ret built(args, cfi.signal_frame(f.ok));
}

fun do_return_column(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    val r: res[rf.Id, diagnostic.Diagnostic] = register_of(args, 0);
    if (sel r.err) { ret err[diagnostic.Diagnostic].err{r.err}; }
    ret built(args, cfi.return_column(model.builder(m), f.ok, r.ok));
}

# `.cfi_escape`: every operand a byte
fun do_escape(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    var bytes: vector.Vector[u8]   = vector.init[u8](m.a);
    val room:  res[usize, A.Error] = vector.reserve[u8](?bytes, args.count::usize);
    if (sel room.err) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, field.MEMORY)}; }
    var k: u32 = 0;
    for (k < args.count) {
        val n: res[i64, diagnostic.Diagnostic] = model.constant(args, k);
        if (sel n.err) {
            vector.dnit[u8](?bytes);
            ret err[diagnostic.Diagnostic].err{n.err};
        }
        if (n.ok < -128 || n.ok > 255) {
            vector.dnit[u8](?bytes);
            ret err[diagnostic.Diagnostic].err{model.refuse(args, k, NOT_A_BYTE)};
        }
        bytes.data[bytes.len] = (n.ok & 0xFF)::u8;
        bytes.len             = bytes.len + 1;
        k                     = k + 1;
    }
    val done: err[diagnostic.Diagnostic] = built(args, cfi.escape(model.builder(m), f.ok, bytes.data, bytes.len));
    vector.dnit[u8](?bytes);
    ret done;
}

# `.cfi_personality` when the row's parameter is 0 and `.cfi_lsda` when 1: an encoding and the symbol it points at
fun do_pointer(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    val enc: res[i64, diagnostic.Diagnostic] = model.constant(args, 0);
    if (sel enc.err)                { ret err[diagnostic.Diagnostic].err{enc.err}; }
    if (enc.ok < 0 || enc.ok > 255) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, NOT_A_BYTE)}; }
    val target: res[build.Label, diagnostic.Diagnostic] = model.symbol(m, args, 1);
    if (sel target.err)            { ret err[diagnostic.Diagnostic].err{target.err}; }
    if (args.directive.param == 1) { ret built(args, cfi.lsda(model.builder(m), f.ok, enc.ok::u8, target.ok)); }
    ret built(args, cfi.personality(model.builder(m), f.ok, enc.ok::u8, target.ok));
}

fun is(v: View, s: str) bool {
    if (v.len != str_len(s)) { ret false; }
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# `.cfi_sections`: the sections the records go to
fun do_sections(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: res[*cfi.Frames, diagnostic.Diagnostic] = frames_of(m, args);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{f.err}; }
    var which: cfi.Sections = 0;
    var k:     u32          = 0;
    for (k < args.count) {
        val v: model.Argument = args.items[k].value;
        if (!sel v.name)                { ret err[diagnostic.Diagnostic].err{model.refuse(args, k, NOT_A_SECTION)}; }
        if (is(v.name, ".eh_frame"))    { which = which | cfi.EH_FRAME; }
        or (is(v.name, ".debug_frame")) { which = which | cfi.DEBUG_FRAME; }
        or                              { ret err[diagnostic.Diagnostic].err{model.refuse(args, k, NOT_A_SECTION)}; }
        k = k + 1;
    }
    cfi.sections(f.ok, which);
    ret err[diagnostic.Diagnostic].ok{};
}

val ONE_REGISTER:    [1]model.Item = [1]model.Item{model.REGISTER};
val TWO_REGISTERS:   [2]model.Item = [2]model.Item{model.REGISTER, model.REGISTER};
val REGISTER_OFFSET: [2]model.Item = [2]model.Item{model.REGISTER, model.EXPRESSION};
val ONE_OFFSET:      [1]model.Item = [1]model.Item{model.EXPRESSION};
val ENCODED_NAME:    [2]model.Item = [2]model.Item{model.EXPRESSION, model.NAME};

val REGISTER_ONLY: model.Shape = model.Shape{items: ?ONE_REGISTER[0], len: 1, least: 1, repeat: false, text: false};
val REGISTER_PAIR: model.Shape = model.Shape{items: ?TWO_REGISTERS[0], len: 2, least: 2, repeat: false, text: false};
val SAVED:         model.Shape = model.Shape{items: ?REGISTER_OFFSET[0], len: 2, least: 2, repeat: false, text: false};
val OFFSET_ONLY:   model.Shape = model.Shape{items: ?ONE_OFFSET[0], len: 1, least: 1, repeat: false, text: false};
val POINTER:       model.Shape = model.Shape{items: ?ENCODED_NAME[0], len: 2, least: 2, repeat: false, text: false};

# the call frame rows (gas manual, "CFI directives")
val ROWS: [21]model.Directive = [21]model.Directive{
    model.Directive{name: ".cfi_startproc", operands: model.NONE, handler: do_startproc, param: 0},
    model.Directive{name: ".cfi_endproc", operands: model.NONE, handler: do_endproc, param: 0},
    model.Directive{name: ".cfi_def_cfa", operands: SAVED, handler: do_def_cfa, param: 0},
    model.Directive{name: ".cfi_def_cfa_register", operands: REGISTER_ONLY, handler: do_def_cfa_register, param: 0},
    model.Directive{name: ".cfi_def_cfa_offset", operands: OFFSET_ONLY, handler: do_cfa_offset, param: 0},
    model.Directive{name: ".cfi_adjust_cfa_offset", operands: OFFSET_ONLY, handler: do_cfa_offset, param: 1},
    model.Directive{name: ".cfi_offset", operands: SAVED, handler: do_save, param: 0},
    model.Directive{name: ".cfi_rel_offset", operands: SAVED, handler: do_save, param: 1},
    model.Directive{name: ".cfi_val_offset", operands: SAVED, handler: do_save, param: 2},
    model.Directive{name: ".cfi_register", operands: REGISTER_PAIR, handler: do_register, param: 0},
    model.Directive{name: ".cfi_restore", operands: REGISTER_ONLY, handler: do_alone, param: 0},
    model.Directive{name: ".cfi_undefined", operands: REGISTER_ONLY, handler: do_alone, param: 1},
    model.Directive{name: ".cfi_same_value", operands: REGISTER_ONLY, handler: do_alone, param: 2},
    model.Directive{name: ".cfi_remember_state", operands: model.NONE, handler: do_remember_state, param: 0},
    model.Directive{name: ".cfi_restore_state", operands: model.NONE, handler: do_restore_state, param: 0},
    model.Directive{name: ".cfi_escape", operands: model.EXPRESSIONS, handler: do_escape, param: 0},
    model.Directive{name: ".cfi_personality", operands: POINTER, handler: do_pointer, param: 0},
    model.Directive{name: ".cfi_lsda", operands: POINTER, handler: do_pointer, param: 1},
    model.Directive{name: ".cfi_signal_frame", operands: model.NONE, handler: do_signal_frame, param: 0},
    model.Directive{name: ".cfi_return_column", operands: REGISTER_ONLY, handler: do_return_column, param: 0},
    model.Directive{name: ".cfi_sections", operands: model.NAMES, handler: do_sections, param: 0},
};

# a procedure left open at the end of the source is refused where it started
fun finish(context: ptr, m: *model.Assembler) err[model.Refusal] {
    val t: *Text = context::*Text;
    if (sel t.site.none) { ret err[model.Refusal].ok{}; }
    val d: diagnostic.Diagnostic = diagnostic.Diagnostic{message: cfi.NEVER_ENDED, span: diagnostic.Span{start: t.site.some, len: 0}};
    ret err[model.Refusal].err{model.Refusal{diagnostic: d, site: t.site.some}};
}

# give back the state of the layer, after the assembler is released
pub fun release(t: *Text) {
    cfi.release(?t.frames);
}

# the layer of the call frame rows over the text state `t`, which the caller keeps until it releases it after the assembler
pub fun layer(a: *A.Allocator, t: *Text) model.Layer {
    t.frames = cfi.make(a);
    t.site   = opt[diagnostic.Position].none{};
    ret model.Layer{name: "cfi", directives: model.Directives{at: ?ROWS[0], len: 21}, context: t::ptr, finish: finish};
}
