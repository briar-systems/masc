# the call frame directives of the gnu assembler, a layer of rows over the calls of `masc.emit.cfi`
#
# each row reads its operands and makes the call of the same name on the
# assembler's builder, so the text is only a front end: what a directive
# states is what the call states. a register is a register of the set, read by
# its syntax's names, or by its dwarf number as gcc writes it, which names the
# register of that number under the object's context and is refused when none
# has it. an offset is a constant number of bytes. a directive outside a
# procedure, an end without a start, a restore where no state is remembered
# and a procedure left open at the end of the source are refused.
#
# a personality or lsda pointer's encoding is mink's to choose, as every
# frame byte is, so its format bits are read and the omit encoding 0xff states
# none. an indirect encoding names the slot that holds the pointer, as gcc's
# `DW.ref.__gxx_personality_v0`, which mink's frame cannot state, so it is
# refused. `.cfi_sections` is refused, as mink's frame model states no choice
# of the sections a frame is written to, and so is `.cfi_startproc simple`,
# as the frame always begins from the rules the set states.

use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;

use masc.asm.model;
use masc.build.build;
use masc.core.diagnostic;
use masc.core.field;
use masc.core.operand;
use rf:          masc.core.register;
use core_syntax: masc.core.syntax;
use masc.emit.cfi;
use masc.syntax.expr;
use masc.syntax.read;

pub val NOT_A_REGISTER: str = "expected a register";
pub val NOT_A_BYTE:     str = "expected a byte";
pub val NEVER_ENDED:    str = "procedure never ended";
pub val NO_SECTIONS:    str = "the sections a frame is written to, which mink's frame model states no choice of";
pub val NO_FUNCTION:    str = "procedure with no label where it starts, which mink's frame names its function by";
pub val INDIRECT:       str = "indirect pointer encoding, whose symbol is the slot holding the pointer, which mink's frame cannot state";
pub val SIMPLE:         str = "procedure begun with no starting rules, which mink's frame always begins from the set's";
pub val NOT_SIMPLE:     str = "expected `simple` or nothing";

# the indirect bit of a pointer encoding
val INDIRECTLY: i64 = 0x80;

# the encoding of a pointer that is omitted
val OMIT: i64 = 0xFF;

# what the layer keeps
# ---
# site: where the open procedure was started, none when none is open
pub rec Text {
    site: opt[diagnostic.Position];
}

fun built(args: *model.Args, e: err[build.Refusal]) err[diagnostic.Diagnostic] {
    if (sel e.err) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, e.err.message)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# the register at the reader: a name of the set's syntax, or a dwarf number as gcc writes one, which names the register
# of that number under the object's context
fun register_at(m: *model.Assembler, rd: *core_syntax.Reader) res[rf.Id, diagnostic.Diagnostic] {
    read.skip(rd);
    val at: usize = rd.at;
    val c:  u8    = read.peek(rd);
    if (c >= '0' && c <= '9') {
        val n: res[i64, diagnostic.Diagnostic] = read.number(rd);
        if (sel n.err)                      { ret res[rf.Id, diagnostic.Diagnostic].err{n.err}; }
        if (n.ok < 0 || n.ok > 0xFFFF_FFFF) { ret res[rf.Id, diagnostic.Diagnostic].err{read.refuse(rd, NOT_A_REGISTER, at, rd.at - at)}; }
        val r: res[rf.Id, build.Refusal] = cfi.numbered(model.builder(m), n.ok::u32);
        if (sel r.err) { ret res[rf.Id, diagnostic.Diagnostic].err{read.refuse(rd, r.err.message, at, rd.at - at)}; }
        ret res[rf.Id, diagnostic.Diagnostic].ok{r.ok};
    }
    val v: res[model.Argument, diagnostic.Diagnostic] = model.read_item(m, rd, model.REGISTER);
    if (sel v.err) { ret res[rf.Id, diagnostic.Diagnostic].err{v.err}; }
    val got: model.Argument = v.ok;
    if (!sel got.register) { ret res[rf.Id, diagnostic.Diagnostic].err{read.refuse(rd, NOT_A_REGISTER, at, rd.at - at)}; }
    ret res[rf.Id, diagnostic.Diagnostic].ok{got.register};
}

# the comma between two operands at the reader
fun comma(rd: *core_syntax.Reader) err[diagnostic.Diagnostic] {
    read.skip(rd);
    if (read.peek(rd) != ',') { ret err[diagnostic.Diagnostic].err{read.refuse(rd, read.EXPECTED, rd.at, read.token(rd, rd.at))}; }
    rd.at = rd.at + 1;
    ret err[diagnostic.Diagnostic].ok{};
}

# the end of the operands at the reader
fun ended(rd: *core_syntax.Reader) err[diagnostic.Diagnostic] {
    read.skip(rd);
    if (rd.at < rd.end) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, read.UNEXPECTED, rd.at, rd.end - rd.at)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# the constant number of bytes at the reader
fun offset_at(rd: *core_syntax.Reader) res[cfi.Offset, diagnostic.Diagnostic] {
    read.skip(rd);
    val at: usize                                 = rd.at;
    val e:  res[expr.Expr, diagnostic.Diagnostic] = expr.parse(rd, operand.NO_FIXUP);
    if (sel e.err)          { ret res[cfi.Offset, diagnostic.Diagnostic].err{e.err}; }
    if (!sel e.ok.constant) { ret res[cfi.Offset, diagnostic.Diagnostic].err{read.refuse(rd, model.NOT_CONSTANT, at, rd.at - at)}; }
    ret res[cfi.Offset, diagnostic.Diagnostic].ok{cfi.bytes(e.ok.constant)};
}

# one register and the end
fun one_register(m: *model.Assembler, args: *model.Args) res[rf.Id, diagnostic.Diagnostic] {
    val r: res[rf.Id, diagnostic.Diagnostic] = register_at(m, args.reader);
    if (sel r.err) { ret r; }
    val e: err[diagnostic.Diagnostic] = ended(args.reader);
    if (sel e.err) { ret res[rf.Id, diagnostic.Diagnostic].err{e.err}; }
    ret r;
}

# a register, a comma, an offset and the end
rec Saved {
    reg: rf.Id;
    off: cfi.Offset;
}

fun register_offset(m: *model.Assembler, args: *model.Args) res[Saved, diagnostic.Diagnostic] {
    val r: res[rf.Id, diagnostic.Diagnostic] = register_at(m, args.reader);
    if (sel r.err) { ret res[Saved, diagnostic.Diagnostic].err{r.err}; }
    val c: err[diagnostic.Diagnostic] = comma(args.reader);
    if (sel c.err) { ret res[Saved, diagnostic.Diagnostic].err{c.err}; }
    val o: res[cfi.Offset, diagnostic.Diagnostic] = offset_at(args.reader);
    if (sel o.err) { ret res[Saved, diagnostic.Diagnostic].err{o.err}; }
    val e: err[diagnostic.Diagnostic] = ended(args.reader);
    if (sel e.err) { ret res[Saved, diagnostic.Diagnostic].err{e.err}; }
    ret res[Saved, diagnostic.Diagnostic].ok{Saved{reg: r.ok, off: o.ok}};
}

# the label placed where the procedure starts, which names its function
fun function_of(m: *model.Assembler, args: *model.Args) res[build.Label, diagnostic.Diagnostic] {
    val l: opt[build.Label] = build.placed_here(model.builder(m));
    if (sel l.none) { ret res[build.Label, diagnostic.Diagnostic].err{model.refuse(args, 0, NO_FUNCTION)}; }
    ret res[build.Label, diagnostic.Diagnostic].ok{l.some};
}

fun do_startproc(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val rd: *core_syntax.Reader = args.reader;
    read.skip(rd);
    if (rd.at < rd.end) {
        val at: usize = rd.at;
        if (read.take(rd, "simple")) {
            read.skip(rd);
            if (rd.at == rd.end) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, SIMPLE, at, 6)}; }
        }
        ret err[diagnostic.Diagnostic].err{read.refuse(rd, NOT_SIMPLE, at, rd.end - at)};
    }
    val target: res[build.Label, diagnostic.Diagnostic] = function_of(m, args);
    if (sel target.err) { ret err[diagnostic.Diagnostic].err{target.err}; }
    val done: err[diagnostic.Diagnostic] = built(args, cfi.start_proc(model.builder(m), target.ok));
    if (sel done.err) { ret done; }
    val t: *Text = args.layer.context::*Text;
    t.site = opt[diagnostic.Position].some{args.statement.site};
    ret done;
}

fun do_endproc(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val done: err[diagnostic.Diagnostic] = built(args, cfi.end_proc(model.builder(m)));
    if (sel done.err) { ret done; }
    val t: *Text = args.layer.context::*Text;
    t.site = opt[diagnostic.Position].none{};
    ret done;
}

fun do_def_cfa(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val s: res[Saved, diagnostic.Diagnostic] = register_offset(m, args);
    if (sel s.err) { ret err[diagnostic.Diagnostic].err{s.err}; }
    ret built(args, cfi.def_cfa(model.builder(m), s.ok.reg, s.ok.off));
}

fun do_def_cfa_register(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val r: res[rf.Id, diagnostic.Diagnostic] = one_register(m, args);
    if (sel r.err) { ret err[diagnostic.Diagnostic].err{r.err}; }
    ret built(args, cfi.def_cfa_register(model.builder(m), r.ok));
}

# `.cfi_def_cfa_offset` when the row's parameter is 0, `.cfi_adjust_cfa_offset` when 1
fun do_cfa_offset(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val n: res[i64, diagnostic.Diagnostic] = model.constant(args, 0);
    if (sel n.err)                 { ret err[diagnostic.Diagnostic].err{n.err}; }
    if (args.directive.param == 1) { ret built(args, cfi.adjust_cfa_offset(model.builder(m), cfi.bytes(n.ok))); }
    ret built(args, cfi.def_cfa_offset(model.builder(m), cfi.bytes(n.ok)));
}

# a register saved at an offset: `.cfi_offset` when the row's parameter is 0, `.cfi_rel_offset` when 1 and
# `.cfi_val_offset` when 2
fun do_save(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val s: res[Saved, diagnostic.Diagnostic] = register_offset(m, args);
    if (sel s.err)                 { ret err[diagnostic.Diagnostic].err{s.err}; }
    if (args.directive.param == 1) { ret built(args, cfi.rel_offset(model.builder(m), s.ok.reg, s.ok.off)); }
    if (args.directive.param == 2) { ret built(args, cfi.val_offset(model.builder(m), s.ok.reg, s.ok.off)); }
    ret built(args, cfi.offset(model.builder(m), s.ok.reg, s.ok.off));
}

fun do_register(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val r: res[rf.Id, diagnostic.Diagnostic] = register_at(m, args.reader);
    if (sel r.err) { ret err[diagnostic.Diagnostic].err{r.err}; }
    val c: err[diagnostic.Diagnostic] = comma(args.reader);
    if (sel c.err) { ret c; }
    val other: res[rf.Id, diagnostic.Diagnostic] = one_register(m, args);
    if (sel other.err) { ret err[diagnostic.Diagnostic].err{other.err}; }
    ret built(args, cfi.register(model.builder(m), r.ok, other.ok));
}

# a rule of one register: `.cfi_restore` when the row's parameter is 0, `.cfi_undefined` when 1, `.cfi_same_value`
# when 2 and `.cfi_return_column` when 3
fun do_alone(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val r: res[rf.Id, diagnostic.Diagnostic] = one_register(m, args);
    if (sel r.err)                 { ret err[diagnostic.Diagnostic].err{r.err}; }
    if (args.directive.param == 1) { ret built(args, cfi.undefined(model.builder(m), r.ok)); }
    if (args.directive.param == 2) { ret built(args, cfi.same_value(model.builder(m), r.ok)); }
    if (args.directive.param == 3) { ret built(args, cfi.return_column(model.builder(m), r.ok)); }
    ret built(args, cfi.restore(model.builder(m), r.ok));
}

# a rule of the frame as a whole: `.cfi_remember_state` when the row's parameter is 0, `.cfi_restore_state` when 1 and
# `.cfi_signal_frame` when 2
fun do_state(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    if (args.directive.param == 1) { ret built(args, cfi.restore_state(model.builder(m))); }
    if (args.directive.param == 2) { ret built(args, cfi.signal_frame(model.builder(m))); }
    ret built(args, cfi.remember_state(model.builder(m)));
}

# `.cfi_escape`: every operand a byte
fun do_escape(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    var bytes: vector.Vector[u8]   = vector.init[u8](m.a);
    val room:  res[usize, A.Error] = vector.reserve[u8](?bytes, args.count::usize);
    if (sel room.err) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, field.MEMORY)}; }
    var k: u32 = 0;
    for (k < args.count) {
        val n: res[i64, diagnostic.Diagnostic] = model.constant(args, k);
        if (sel n.err) {
            vector.dnit[u8](?bytes);
            ret err[diagnostic.Diagnostic].err{n.err};
        }
        if (n.ok < -128 || n.ok > 255) {
            vector.dnit[u8](?bytes);
            ret err[diagnostic.Diagnostic].err{model.refuse(args, k, NOT_A_BYTE)};
        }
        bytes.data[bytes.len] = (n.ok & 0xFF)::u8;
        bytes.len             = bytes.len + 1;
        k                     = k + 1;
    }
    val done: err[diagnostic.Diagnostic] = built(args, cfi.escape(model.builder(m), bytes.data, bytes.len));
    vector.dnit[u8](?bytes);
    ret done;
}

# `.cfi_personality` when the row's parameter is 0 and `.cfi_lsda` when 1: an encoding, whose format mink chooses, and
# the symbol it points at, none when the encoding is the omit one. an indirect encoding is refused
fun do_pointer(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val enc: res[i64, diagnostic.Diagnostic] = model.constant(args, 0);
    if (sel enc.err)                { ret err[diagnostic.Diagnostic].err{enc.err}; }
    if (enc.ok < 0 || enc.ok > 255) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, NOT_A_BYTE)}; }
    if (enc.ok == OMIT)             { ret err[diagnostic.Diagnostic].ok{}; }
    if ((enc.ok & INDIRECTLY) != 0) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, INDIRECT)}; }
    val target: res[build.Label, diagnostic.Diagnostic] = model.symbol(m, args, 1);
    if (sel target.err)            { ret err[diagnostic.Diagnostic].err{target.err}; }
    if (args.directive.param == 1) { ret built(args, cfi.lsda(model.builder(m), target.ok)); }
    ret built(args, cfi.personality(model.builder(m), target.ok));
}

fun do_sections(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, NO_SECTIONS)};
}

val ONE_OFFSET:   [1]model.Item = [1]model.Item{model.EXPRESSION};
val ENCODED_NAME: [2]model.Item = [2]model.Item{model.EXPRESSION, model.NAME};

val OFFSET_ONLY: model.Shape = model.Shape{items: ?ONE_OFFSET[0], len: 1, least: 1, repeat: false, text: false};
val POINTER:     model.Shape = model.Shape{items: ?ENCODED_NAME[0], len: 2, least: 1, repeat: false, text: false};

# the call frame rows (gas manual, "CFI directives")
val ROWS: [21]model.Directive = [21]model.Directive{
    model.Directive{name: ".cfi_startproc", operands: model.TEXT, handler: do_startproc, param: 0},
    model.Directive{name: ".cfi_endproc", operands: model.NO_ITEMS, handler: do_endproc, param: 0},
    model.Directive{name: ".cfi_def_cfa", operands: model.TEXT, handler: do_def_cfa, param: 0},
    model.Directive{name: ".cfi_def_cfa_register", operands: model.TEXT, handler: do_def_cfa_register, param: 0},
    model.Directive{name: ".cfi_def_cfa_offset", operands: OFFSET_ONLY, handler: do_cfa_offset, param: 0},
    model.Directive{name: ".cfi_adjust_cfa_offset", operands: OFFSET_ONLY, handler: do_cfa_offset, param: 1},
    model.Directive{name: ".cfi_offset", operands: model.TEXT, handler: do_save, param: 0},
    model.Directive{name: ".cfi_rel_offset", operands: model.TEXT, handler: do_save, param: 1},
    model.Directive{name: ".cfi_val_offset", operands: model.TEXT, handler: do_save, param: 2},
    model.Directive{name: ".cfi_register", operands: model.TEXT, handler: do_register, param: 0},
    model.Directive{name: ".cfi_restore", operands: model.TEXT, handler: do_alone, param: 0},
    model.Directive{name: ".cfi_undefined", operands: model.TEXT, handler: do_alone, param: 1},
    model.Directive{name: ".cfi_same_value", operands: model.TEXT, handler: do_alone, param: 2},
    model.Directive{name: ".cfi_return_column", operands: model.TEXT, handler: do_alone, param: 3},
    model.Directive{name: ".cfi_remember_state", operands: model.NO_ITEMS, handler: do_state, param: 0},
    model.Directive{name: ".cfi_restore_state", operands: model.NO_ITEMS, handler: do_state, param: 1},
    model.Directive{name: ".cfi_signal_frame", operands: model.NO_ITEMS, handler: do_state, param: 2},
    model.Directive{name: ".cfi_escape", operands: model.EXPRESSIONS, handler: do_escape, param: 0},
    model.Directive{name: ".cfi_personality", operands: POINTER, handler: do_pointer, param: 0},
    model.Directive{name: ".cfi_lsda", operands: POINTER, handler: do_pointer, param: 1},
    model.Directive{name: ".cfi_sections", operands: model.NAMES, handler: do_sections, param: 0},
};

# a procedure left open at the end of the source is refused where it started
fun finish(context: ptr, m: *model.Assembler) err[model.Refusal] {
    val t: *Text = context::*Text;
    if (sel t.site.none) { ret err[model.Refusal].ok{}; }
    val d: diagnostic.Span = diagnostic.Span{start: t.site.some, len: 0};
    ret err[model.Refusal].err{model.Refusal{message: NEVER_ENDED, span: d, site: t.site.some}};
}

# the state of a layer over an object, no procedure open
pub fun make() Text {
    ret Text{site: opt[diagnostic.Position].none{}};
}

# the layer of the call frame rows over the state `t`, which the caller keeps as long as the assembler
pub fun layer(t: *Text) model.Layer {
    ret model.Layer{name: "cfi", directives: model.Directives{at: ?ROWS[0], len: 21}, context: t::ptr, finish: finish};
}
