# the core directives of the gnu assembler, as rows of the source model's directive table
#
# sections and the section stack, symbol bindings, visibilities, types and
# sizes, data, strings, leb128 and floating point values, alignment, fills,
# equates and common storage, each a row over the model's operand syntaxes.
# what differs per target is the set's: the integer data directives and
# their widths, how `.align` reads, and the type prefixes. a section with no
# stated attributes takes the object format's convention for its name, as
# mink's naming states it. a section opened with the dialect's unique number, as elf's
# `unique, 1`, is a section apart from the others of its name, entered again
# only by that name and number. a section of a comdat group, its flags holding
# `G` and its type followed by the group's signature and `comdat`, is a
# section apart from the others of its name too, entered again by its name and
# signature. a link-order section, its flags holding `o` and its type
# followed by the symbol or section it is linked to, is ordered after that
# section and kept apart from the others of its name by it. a group that is no
# comdat group is refused, as mink's object holds comdat groups only, and so is
# an exclusion, since the builder states none.
#
# the grammar of `.section` and the directives that enter a section by its
# own name are the dialect's (`masc.format.dialect.Sections`): elf's above,
# mach-o's `segment,section, type, attributes`, whose type word mink's mach-o
# naming classifies, and coff's `"flags", selection, symbol`, whose flag
# letters and selection words are the dialect's rows and whose content word
# mink's coff naming classifies. each writes back as it reads, through
# `macho_header` and `coff_header`, so the listing and the disassembler spell
# a header the assembler reads to the same section.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;
use std.encoding.leb128;
use std.math.ieee;
use number: std.text.parse;

use mink.base.fail;
use mink.base.store;
use mink.catalog.arch;
use mink.format.contract;
use mink_group:   mink.model.group;
use mink_reloc:   mink.model.reloc;
use mink_section: mink.model.section;
use mink.model.symbol;

use masc.asm.model;
use masc.build.build;
use masc.core.diagnostic;
use masc.core.field;
use masc.core.operand;
use masc.core.source;
use masc.core.syntax;
use masc.format.dialect;
use masc.syntax.expr;
use masc.syntax.read;

pub val UNKNOWN_TYPE:      str = "unknown type";
pub val UNKNOWN_FLAG:      str = "section flag not supported";
pub val FLAGS_KIND:        str = "section flags its type cannot carry";
pub val NO_KIND:           str = "section the object format gives no kind of its name, type and flags";
pub val NO_ENTSIZE:        str = "section of entries to merge states no entry size";
pub val NEGATIVE:          str = "count is negative";
pub val SECTION_NAME:      str = "expected a section name";
pub val SIGNATURE:         str = "expected the signature of the section's group";
pub val UNTYPED_GROUP:     str = "section group stated with no section type";
pub val PLAIN_GROUP:       str = "section group that is no comdat group, which mink's object holds none of";
pub val UNTYPED_ORDER:     str = "link-order section stated with no section type";
pub val LINKED:            str = "expected the symbol or section a link-order section is linked to";
pub val UNLINKED:          str = "linked-to symbol is in no section, nor names one, so far";
pub val NO_FLOAT_FORMAT:   str = "no ieee 754 format of the row's width";
pub val SEGMENTED:         str = "expected a section named `segment,section`";
pub val UNKNOWN_ATTRIBUTE: str = "section attribute the neutral section holds nothing of apart from its kind";
pub val STUBS:             str = "symbol stub size, which no section mink's object holds states";
pub val UNKNOWN_SELECTION: str = "comdat selection no rule of mink's groups keeps";
pub val COMDAT_SYMBOL:     str = "expected the comdat symbol";

# why a section's header was not written
# ---
# kind:    no header of the dialect reads back to the section's kind, flags and element size
# quoted:  its name or its group's signature has no spelling the header takes
# grouped: its group keeps a copy by a rule no word of the dialect states, or the dialect states no group
# memory:  the output did not grow
pub tag Unwritten: u8 {
    kind;
    quoted;
    grouped;
    memory;
}

# the key the object format's convention gives a section named `name`, as elf's `.text` and `.text.hot` take text and
# mach-o's `__TEXT,__cstring` takes merged strings of one byte, none for none
fun convention(n: *contract.Naming, name: View) opt[mink_section.Key] {
    ret n.kind_of(store.Bytes{data: name.data, len: name.len});
}

# a section type word a `.section` states after `@`, which the object format's naming reads (gas manual, ".section",
# elf version)
# ---
# name: the word
# bits: whether a section of it holds bytes
rec Type {
    name: str;
    bits: bool;
}

val TYPES: [6]Type = [6]Type{
    Type{name: "progbits", bits: true},
    Type{name: "nobits", bits: false},
    Type{name: "note", bits: true},
    Type{name: "init_array", bits: true},
    Type{name: "fini_array", bits: true},
    Type{name: "preinit_array", bits: true},
};

fun same(v: View, s: str) bool {
    val n: usize = str_len(s);
    if (v.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun type_named(v: View) *Type {
    var i: usize = 0;
    for (i < 6) {
        if (same(v, TYPES[i].name)) { ret ?TYPES[i]; }
        i = i + 1;
    }
    ret nil;
}

# the attributes of a section named `name` with none stated, by the object format's naming `n`: its convention's kind,
# that kind's flags and the key's element size, or bytes with no flags, the name left for the caller to state
pub fun conventional(n: *contract.Naming, name: View) build.Spec {
    val c: opt[mink_section.Key] = convention(n, name);
    if (sel c.none) { ret build.Spec{name: opt[str].none{}, kind: ?mink_section.METADATA, flags: 0, disposition: ?mink_section.WHOLE, entsize: 0}; }
    ret build.Spec{name: opt[str].none{}, kind: c.some.kind, flags: c.some.kind.flags, disposition: ?mink_section.WHOLE, entsize: c.some.entsize};
}

# a letter of a `.section` flag string and the flag it states (gas manual, ".section", elf version)
rec Letter {
    letter: u8;
    flag:   mink_section.Flags;
}

# how many letters a flag string has
pub val FLAG_LETTERS: usize = 7;

val LETTERS: [FLAG_LETTERS]Letter = [FLAG_LETTERS]Letter{
    Letter{letter: 'a', flag: mink_section.ALLOC},
    Letter{letter: 'w', flag: mink_section.WRITE},
    Letter{letter: 'x', flag: mink_section.EXEC},
    Letter{letter: 'M', flag: mink_section.MERGE},
    Letter{letter: 'S', flag: mink_section.STRINGS},
    Letter{letter: 'T', flag: mink_section.TLS},
    Letter{letter: 'R', flag: mink_section.RETAIN},
};

# the letter of a `.section` flag string that puts the section in a group, which is no flag of the section
pub val GROUP_LETTER: u8 = 'G';

# the letter of a `.section` flag string that orders the section after the one it links to, as elf's link order, which
# is no flag of the section: the object's format derives it from the section's owner
pub val ORDER_LETTER: u8 = 'o';

# the flags spelled by a `.section` flag string, refused at the letter it does not support, `grouped` set when it holds
# the group letter and `ordered` when it holds the order letter
fun flags_of(args: *model.Args, rd: *syntax.Reader, spelled: View, at: usize, grouped: *bool, ordered: *bool) res[mink_section.Flags, diagnostic.Diagnostic] {
    var f: mink_section.Flags = 0;
    var i: usize              = 0;
    for (i < spelled.len) {
        if (spelled.data[i] == GROUP_LETTER) {
            @grouped = true;
            i        = i + 1;
            cnt;
        }
        if (spelled.data[i] == ORDER_LETTER) {
            @ordered = true;
            i        = i + 1;
            cnt;
        }
        var k: usize = 0;
        for (k < FLAG_LETTERS && LETTERS[k].letter != spelled.data[i]) {
            k = k + 1;
        }
        if (k == FLAG_LETTERS) { ret res[mink_section.Flags, diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_FLAG, at + 1 + i, 1)}; }
        f = f | LETTERS[k].flag;
        i = i + 1;
    }
    ret res[mink_section.Flags, diagnostic.Diagnostic].ok{f};
}

# the flag string that states `flags`, written to `out`, which holds FLAG_LETTERS bytes, none when a flag has no letter
pub fun flag_string(flags: mink_section.Flags, out: *u8) opt[usize] {
    var left: mink_section.Flags = flags;
    var n:    usize              = 0;
    var k:    usize              = 0;
    for (k < FLAG_LETTERS) {
        if ((flags & LETTERS[k].flag) != 0) {
            out[n] = LETTERS[k].letter;
            n      = n + 1;
            left   = left & ~LETTERS[k].flag;
        }
        k = k + 1;
    }
    if (left != 0) { ret opt[usize].none{}; }
    ret opt[usize].some{n};
}

# the key `.section name, "flags", @type, entsize` states, as the object format's naming `n` classifies a section of the
# name, type word, flags and element size, none where it gives such a section no key
fun stated_kind(n: *contract.Naming, name: View, t: *Type, flags: mink_section.Flags, entsize: u64) opt[mink_section.Key] {
    val k: res[mink_section.Key, fail.Fail] = n.kind_for(store.Bytes{data: name.data, len: name.len}, t.name, flags, entsize);
    if (sel k.err) { ret opt[mink_section.Key].none{}; }
    ret opt[mink_section.Key].some{k.ok};
}

# the type a `.section` states for the section `name` of `kind` with `flags` and entries of `entsize` so it reads back
# to that kind under the object format's naming `n`, none when no type does
pub fun section_type(n: *contract.Naming, name: View, kind: *mink_section.Kind, flags: mink_section.Flags, entsize: u64) opt[str] {
    if ((kind.flags & flags) != kind.flags) { ret opt[str].none{}; }
    var i: usize = 0;
    for (i < 6) {
        val t: *Type                 = ?TYPES[i];
        val k: opt[mink_section.Key] = stated_kind(n, name, t, flags, entsize);
        if (sel k.some && k.some.kind == kind) { ret opt[str].some{t.name}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

# a section's name, in quotes or as the text up to a comma or white space
fun section_name(m: *model.Assembler, rd: *syntax.Reader) res[View, diagnostic.Diagnostic] {
    if (read.peek(rd) == '"') { ret model.string(m, rd); }
    val at: usize = rd.at;
    for (rd.at < rd.end && rd.text[rd.at] != ',' && !read.blank(rd.text[rd.at])) {
        rd.at = rd.at + 1;
    }
    if (rd.at == at) { ret res[View, diagnostic.Diagnostic].err{read.refuse(rd, SECTION_NAME, at, 0)}; }
    ret res[View, diagnostic.Diagnostic].ok{read.span(rd, at, rd.at - at)};
}

# `, word, number` read when the dialect keeps sections of one name apart and its word is next, the number it opens
# the section apart with; none, with nothing read, otherwise
fun apart(m: *model.Assembler, rd: *syntax.Reader) res[opt[u64], diagnostic.Diagnostic] {
    val back: usize    = rd.at;
    val kw:   opt[str] = m.dialect.unique;
    if (sel kw.none) { ret res[opt[u64], diagnostic.Diagnostic].ok{opt[u64].none{}}; }
    read.skip(rd);
    if (!read.take(rd, ",")) {
        rd.at = back;
        ret res[opt[u64], diagnostic.Diagnostic].ok{opt[u64].none{}};
    }
    read.skip(rd);
    val n: usize = str_len(kw.some);
    if (read.token(rd, rd.at) != n || !read.starts(rd, rd.at, kw.some, n)) {
        rd.at = back;
        ret res[opt[u64], diagnostic.Diagnostic].ok{opt[u64].none{}};
    }
    rd.at = rd.at + n;
    read.skip(rd);
    if (!read.take(rd, ",")) { ret res[opt[u64], diagnostic.Diagnostic].err{read.refuse(rd, model.NOT_A_NUMBER, rd.at, 0)}; }
    read.skip(rd);
    val at:     usize                                 = rd.at;
    val number: res[expr.Expr, diagnostic.Diagnostic] = expr.parse(rd, operand.NO_FIXUP);
    if (sel number.err)          { ret res[opt[u64], diagnostic.Diagnostic].err{number.err}; }
    if (!sel number.ok.constant) { ret res[opt[u64], diagnostic.Diagnostic].err{read.refuse(rd, model.NOT_CONSTANT, at, rd.at - at)}; }
    if (number.ok.constant < 0)  { ret res[opt[u64], diagnostic.Diagnostic].err{read.refuse(rd, NEGATIVE, at, rd.at - at)}; }
    ret res[opt[u64], diagnostic.Diagnostic].ok{opt[u64].some{number.ok.constant:~u64}};
}

# `, comdat` read when it is next, answering whether it was, with nothing read when it is not
fun comdat(rd: *syntax.Reader) bool {
    val back: usize = rd.at;
    read.skip(rd);
    if (!read.take(rd, ",")) {
        rd.at = back;
        ret false;
    }
    read.skip(rd);
    if (read.token(rd, rd.at) != str_len(COMDAT) || !read.starts(rd, rd.at, COMDAT, str_len(COMDAT))) {
        rd.at = back;
        ret false;
    }
    rd.at = rd.at + str_len(COMDAT);
    ret true;
}

# the linkage word of a comdat group (gas manual, ".section", elf version)
pub val COMDAT: str = "comdat";

# `.section name[, "flags"[, @type[, entsize][, linked][, signature, comdat][, unique, number]]]` read and entered, after
# a push when `push`. the unique number, under the dialect's word for it, opens the section apart from every other of
# its name, a signature, which the flags' group letter calls for, puts it in the comdat group of that signature, and a
# symbol or section name it is linked to, which the flags' order letter calls for, orders it after the section that
# names (`model.linked`). each keeps it apart from every section of its name that differs in it, as llvm-mc 23.1.1 and
# the gnu assembler 2.47 keep them
fun section(m: *model.Assembler, args: *model.Args, push: bool) err[diagnostic.Diagnostic] {
    val rd:   *syntax.Reader                   = args.reader;
    val at:   usize                            = rd.at;
    val name: res[View, diagnostic.Diagnostic] = section_name(m, rd);
    if (sel name.err) { ret err[diagnostic.Diagnostic].err{name.err}; }
    var spec:   build.Spec = conventional(model.naming(m), name.ok);
    var stated: bool       = false;
    var unique: opt[u64]   = opt[u64].none{};
    var keys:   model.Keys = model.NO_KEYS;
    read.skip(rd);
    if (read.take(rd, ",")) {
        read.skip(rd);
        stated = true;
        # stated attributes replace the convention's, its element size with them
        spec.entsize = 0;
        val flags_at: usize                            = rd.at;
        val spelled:  res[View, diagnostic.Diagnostic] = model.string(m, rd);
        if (sel spelled.err) { ret err[diagnostic.Diagnostic].err{spelled.err}; }
        var grouped: bool                                           = false;
        var ordered: bool                                           = false;
        val flags:   res[mink_section.Flags, diagnostic.Diagnostic] = flags_of(args, rd, spelled.ok, flags_at, ?grouped, ?ordered);
        if (sel flags.err) { ret err[diagnostic.Diagnostic].err{flags.err}; }
        val merging: bool = (flags.ok & mink_section.MERGE) != 0;
        # the type the name's convention takes, bytes or none, until one is stated
        var t: *Type = ?TYPES[0];
        if (!mink_section.has(spec.kind, mink_section.BITS)) { t = ?TYPES[1]; }
        read.skip(rd);
        val typed: bool = read.take(rd, ",");
        if (grouped && !typed) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNTYPED_GROUP, flags_at, rd.at - flags_at)}; }
        if (ordered && !typed) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNTYPED_ORDER, flags_at, rd.at - flags_at)}; }
        if (typed) {
            read.skip(rd);
            val type_at: usize                                      = rd.at;
            val word:    res[model.Argument, diagnostic.Diagnostic] = model.read_item(m, rd, model.WORD);
            if (sel word.err)      { ret err[diagnostic.Diagnostic].err{word.err}; }
            if (!sel word.ok.word) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_TYPE, type_at, rd.at - type_at)}; }
            t = type_named(word.ok.word);
            if (t == nil) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_TYPE, type_at, rd.at - type_at)}; }
            val bare: res[opt[u64], diagnostic.Diagnostic] = apart(m, rd);
            if (sel bare.err) { ret err[diagnostic.Diagnostic].err{bare.err}; }
            unique = bare.ok;
            read.skip(rd);
            # the section linked to and a group's signature follow the type, or the element size of a section of
            # entries to merge
            if (sel unique.none && (merging || (!grouped && !ordered)) && read.take(rd, ",")) {
                read.skip(rd);
                val size_at: usize                                 = rd.at;
                val size:    res[expr.Expr, diagnostic.Diagnostic] = expr.parse(rd, operand.NO_FIXUP);
                if (sel size.err)          { ret err[diagnostic.Diagnostic].err{size.err}; }
                if (!sel size.ok.constant) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, model.NOT_CONSTANT, size_at, rd.at - size_at)}; }
                if (size.ok.constant < 0)  { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NEGATIVE, size_at, rd.at - size_at)}; }
                spec.entsize = size.ok.constant:~u64;
                val sized: res[opt[u64], diagnostic.Diagnostic] = apart(m, rd);
                if (sel sized.err) { ret err[diagnostic.Diagnostic].err{sized.err}; }
                unique = sized.ok;
            }
            if (ordered) {
                read.skip(rd);
                if (sel unique.some || !read.take(rd, ",")) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, LINKED, rd.at, 0)}; }
                read.skip(rd);
                val link_at: usize                            = rd.at;
                val link:    res[View, diagnostic.Diagnostic] = model.symbol_name(m, rd);
                if (sel link.err) { ret err[diagnostic.Diagnostic].err{link.err}; }
                val owner: opt[build.Section] = model.linked(m, link.ok);
                if (sel owner.none) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNLINKED, link_at, rd.at - link_at)}; }
                keys.owner = owner;
                if (!grouped) {
                    val after: res[opt[u64], diagnostic.Diagnostic] = apart(m, rd);
                    if (sel after.err) { ret err[diagnostic.Diagnostic].err{after.err}; }
                    unique = after.ok;
                }
            }
            if (grouped) {
                read.skip(rd);
                if (sel unique.some || !read.take(rd, ",")) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, SIGNATURE, rd.at, 0)}; }
                read.skip(rd);
                val sig_at:    usize                            = rd.at;
                val signature: res[View, diagnostic.Diagnostic] = section_name(m, rd);
                if (sel signature.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, SIGNATURE, sig_at, 0)}; }
                if (!comdat(rd))       { ret err[diagnostic.Diagnostic].err{read.refuse(rd, PLAIN_GROUP, sig_at, rd.at - sig_at)}; }
                keys.group = opt[View].some{signature.ok};
                val after: res[opt[u64], diagnostic.Diagnostic] = apart(m, rd);
                if (sel after.err) { ret err[diagnostic.Diagnostic].err{after.err}; }
                unique = after.ok;
            }
        }
        if (merging && spec.entsize == 0) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NO_ENTSIZE, flags_at, rd.at - flags_at)}; }
        val kind: opt[mink_section.Key] = stated_kind(model.naming(m), name.ok, t, flags.ok, spec.entsize);
        if (sel kind.none) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NO_KIND, flags_at, rd.at - flags_at)}; }
        spec.kind = kind.some.kind;
        if ((spec.kind.flags & flags.ok) != spec.kind.flags) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, FLAGS_KIND, flags_at, rd.at - flags_at)}; }
        spec.flags = flags.ok;
    }
    val rest: err[diagnostic.Diagnostic] = model.ended(rd);
    if (sel rest.err) { ret rest; }
    if (push) {
        val pushed: err[str] = model.push_section(m);
        if (sel pushed.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, pushed.err, at, 0)}; }
    }
    keys.unique = unique;
    val entered: err[str] = model.enter_kept(m, name.ok, spec, stated, keys);
    if (sel entered.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, entered.err, at, name.ok.len)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# the word of `words` that `v` spells, none when none does
fun word_of(words: dialect.Words, v: View) opt[str] {
    var i: u32 = 0;
    for (i < words.len) {
        if (same(v, words.at[i])) { ret opt[str].some{words.at[i]}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

# a word at the reader, refused as `why` when there is none
fun word_at(m: *model.Assembler, rd: *syntax.Reader, why: str) res[View, diagnostic.Diagnostic] {
    read.skip(rd);
    val at:   usize                                      = rd.at;
    val word: res[model.Argument, diagnostic.Diagnostic] = model.read_item(m, rd, model.WORD);
    if (sel word.err)      { ret res[View, diagnostic.Diagnostic].err{word.err}; }
    if (!sel word.ok.word) { ret res[View, diagnostic.Diagnostic].err{read.refuse(rd, why, at, rd.at - at)}; }
    ret res[View, diagnostic.Diagnostic].ok{word.ok.word};
}

# the width of a pointer of the object's architecture, which mach-o's literal pointers type states its entries in
fun pointer_width(m: *model.Assembler) u64 {
    val p: opt[arch.Pointer] = model.builder(m).arch.pointer;
    if (sel p.none) { ret 0; }
    ret p.some.bytes::u64;
}

# the key mach-o's naming gives a section named `name` of type word `word`, its flags those of a section the image
# loads, as every section a type word classifies is, and its literal pointers `pointer` bytes wide
fun macho_key(n: *contract.Naming, name: View, word: str, pointer: u64) opt[mink_section.Key] {
    val k: res[mink_section.Key, fail.Fail] = n.kind_for(store.Bytes{data: name.data, len: name.len}, word, mink_section.ALLOC, pointer);
    if (sel k.err) { ret opt[mink_section.Key].none{}; }
    ret opt[mink_section.Key].some{k.ok};
}

# `.section segment,section[, type[, attribute+attribute]]` read and entered, after a push when `push` (llvm
# DarwinAsmParser.cpp, parseDirectiveSection). with no type the name's convention opens it, and a type opens it as the
# format's naming classifies the name under that word. an attribute is read only where its meaning is the kind's, so it
# states nothing more, and a stub size is refused
fun macho_section(m: *model.Assembler, args: *model.Args, push: bool) err[diagnostic.Diagnostic] {
    val rd: *syntax.Reader    = args.reader;
    val d:  *dialect.Sections = m.dialect.sections;
    read.skip(rd);
    val at:     usize = rd.at;
    var commas: u32   = 0;
    for (rd.at < rd.end && !read.blank(rd.text[rd.at])) {
        if (rd.text[rd.at] == ',') {
            if (commas == 1) { brk; }
            commas = commas + 1;
        }
        rd.at = rd.at + 1;
    }
    if (commas != 1 || rd.text[rd.at - 1] == ',' || rd.text[at] == ',') { ret err[diagnostic.Diagnostic].err{read.refuse(rd, SEGMENTED, at, rd.at - at)}; }
    val name:   View       = read.span(rd, at, rd.at - at);
    var spec:   build.Spec = conventional(model.naming(m), name);
    var stated: bool       = false;
    read.skip(rd);
    if (read.take(rd, ",")) {
        val type_at: usize                            = rd.at;
        val word:    res[View, diagnostic.Diagnostic] = word_at(m, rd, UNKNOWN_TYPE);
        if (sel word.err) { ret err[diagnostic.Diagnostic].err{word.err}; }
        val spelled: opt[str] = word_of(d.types, word.ok);
        if (sel spelled.none) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_TYPE, type_at, rd.at - type_at)}; }
        read.skip(rd);
        if (read.take(rd, ",")) {
            for {
                val attr_at: usize                            = rd.at;
                val attr:    res[View, diagnostic.Diagnostic] = word_at(m, rd, UNKNOWN_ATTRIBUTE);
                if (sel attr.err) { ret err[diagnostic.Diagnostic].err{attr.err}; }
                val known: opt[str] = word_of(d.attributes, attr.ok);
                if (sel known.none) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_ATTRIBUTE, attr_at, rd.at - attr_at)}; }
                read.skip(rd);
                if (!read.take(rd, "+")) { brk; }
            }
            read.skip(rd);
            if (read.peek(rd) == ',') { ret err[diagnostic.Diagnostic].err{read.refuse(rd, STUBS, rd.at, rd.end - rd.at)}; }
        }
        val key: opt[mink_section.Key] = macho_key(model.naming(m), name, spelled.some, pointer_width(m));
        if (sel key.none) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NO_KIND, type_at, rd.at - type_at)}; }
        spec.kind    = key.some.kind;
        spec.flags   = key.some.kind.flags;
        spec.entsize = key.some.entsize;
        stated       = true;
    }
    val rest: err[diagnostic.Diagnostic] = model.ended(rd);
    if (sel rest.err) { ret rest; }
    if (push) {
        val pushed: err[str] = model.push_section(m);
        if (sel pushed.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, pushed.err, at, 0)}; }
    }
    val entered: err[str] = model.enter_kept(m, name, spec, stated, model.NO_KEYS);
    if (sel entered.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, entered.err, at, name.len)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# what a coff flag string states: the content word of its last content letter, nil for none, and the neutral flags of
# a section that starts allocated
# ---
# type:  the content word
# flags: the flags
# bad:   the index of a letter no row of the dialect reads, none when every one is
pub rec Lettered {
    type:  str;
    flags: mink_section.Flags;
    bad:   opt[usize];
}

# the flag string `spelled` read by the letters of the dialect's sections `d`
pub fun coff_letters(d: *dialect.Sections, spelled: View) Lettered {
    var out: Lettered = Lettered{type: nil, flags: mink_section.ALLOC, bad: opt[usize].none{}};
    var i:   usize    = 0;
    for (i < spelled.len) {
        var k: u32 = 0;
        for (k < d.letters.len && d.letters.at[k].letter != spelled.data[i]) {
            k = k + 1;
        }
        if (k == d.letters.len) {
            out.bad = opt[usize].some{i};
            ret out;
        }
        val l: *dialect.Letter = ?d.letters.at[k];
        if (l.type != nil) { out.type = l.type; }
        out.flags = (out.flags | l.sets) & ~l.clears;
        i         = i + 1;
    }
    ret out;
}

# the content word a flag string of none states, initialized data, as llvm-mc reads `.section name, "w"`
val INITIALIZED: str = "cnt_initialized_data";

# the key coff's naming gives a section named `name` of the flag string read as `l`, none when it gives none
fun coff_key(n: *contract.Naming, name: View, l: Lettered) opt[mink_section.Key] {
    var t: str = l.type;
    if (t == nil) { t = INITIALIZED; }
    val k: res[mink_section.Key, fail.Fail] = n.kind_for(store.Bytes{data: name.data, len: name.len}, t, l.flags, 0);
    if (sel k.err) { ret opt[mink_section.Key].none{}; }
    ret opt[mink_section.Key].some{k.ok};
}

# the selection of the dialect's sections `d` spelled `v`, none for none
fun selection_of(d: *dialect.Sections, v: View) opt[*dialect.Selection] {
    var i: u32 = 0;
    for (i < d.selections.len) {
        if (same(v, d.selections.at[i].word)) { ret opt[*dialect.Selection].some{?d.selections.at[i]}; }
        i = i + 1;
    }
    ret opt[*dialect.Selection].none{};
}

# `.section name[, "flags"[, selection, symbol]]` read and entered, after a push when `push` (llvm COFFAsmParser.cpp,
# ParseDirectiveSection). the flags' letters state the section's content word and its neutral flags, and a selection
# puts it in the comdat group the symbol signs, kept by the selection's rule, apart from every section of its name in
# another group
fun coff_section(m: *model.Assembler, args: *model.Args, push: bool) err[diagnostic.Diagnostic] {
    val rd:   *syntax.Reader                   = args.reader;
    val d:    *dialect.Sections                = m.dialect.sections;
    val at:   usize                            = rd.at;
    val name: res[View, diagnostic.Diagnostic] = section_name(m, rd);
    if (sel name.err) { ret err[diagnostic.Diagnostic].err{name.err}; }
    var spec:   build.Spec = conventional(model.naming(m), name.ok);
    var stated: bool       = false;
    var keys:   model.Keys = model.NO_KEYS;
    read.skip(rd);
    if (read.take(rd, ",")) {
        read.skip(rd);
        val flags_at: usize                            = rd.at;
        val spelled:  res[View, diagnostic.Diagnostic] = model.string(m, rd);
        if (sel spelled.err) { ret err[diagnostic.Diagnostic].err{spelled.err}; }
        val l: Lettered = coff_letters(d, spelled.ok);
        if (sel l.bad.some) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_FLAG, flags_at + 1 + l.bad.some, 1)}; }
        val key: opt[mink_section.Key] = coff_key(model.naming(m), name.ok, l);
        if (sel key.none)                                           { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NO_KIND, flags_at, rd.at - flags_at)}; }
        if ((key.some.kind.flags & l.flags) != key.some.kind.flags) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, FLAGS_KIND, flags_at, rd.at - flags_at)}; }
        spec.kind    = key.some.kind;
        spec.flags   = l.flags;
        spec.entsize = 0;
        stated       = true;
        read.skip(rd);
        if (read.take(rd, ",")) {
            val word_at_: usize                            = rd.at;
            val word:     res[View, diagnostic.Diagnostic] = word_at(m, rd, UNKNOWN_SELECTION);
            if (sel word.err) { ret err[diagnostic.Diagnostic].err{word.err}; }
            val chosen: opt[*dialect.Selection] = selection_of(d, word.ok);
            if (sel chosen.none) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_SELECTION, word_at_, rd.at - word_at_)}; }
            read.skip(rd);
            if (!read.take(rd, ",")) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, COMDAT_SYMBOL, rd.at, 0)}; }
            read.skip(rd);
            val sig_at:    usize                            = rd.at;
            val signature: res[View, diagnostic.Diagnostic] = model.symbol_name(m, rd);
            if (sel signature.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, COMDAT_SYMBOL, sig_at, 0)}; }
            keys.group = opt[View].some{signature.ok};
            keys.rule  = chosen.some.rule;
        }
    }
    val rest: err[diagnostic.Diagnostic] = model.ended(rd);
    if (sel rest.err) { ret rest; }
    if (push) {
        val pushed: err[str] = model.push_section(m);
        if (sel pushed.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, pushed.err, at, 0)}; }
    }
    val entered: err[str] = model.enter_kept(m, name.ok, spec, stated, keys);
    if (sel entered.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, entered.err, at, name.ok.len)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

fun put_text(out: *vector.Vector[u8], p: *u8, n: usize) bool {
    if (!held(vector.reserve[u8](out, n))) { ret false; }
    var i: usize = 0;
    for (i < n) {
        out.data[out.len] = p[i];
        out.len           = out.len + 1;
        i                 = i + 1;
    }
    ret true;
}

fun put_str(out: *vector.Vector[u8], s: str) bool {
    ret put_text(out, s, str_len(s));
}

fun held(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# whether `c` is a byte a section name or signature is written with unquoted
fun plain_byte(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '$';
}

# `v` bare when every byte is plain, else in quotes, false when it holds a byte no string takes or the output did not
# grow
fun put_named(out: *vector.Vector[u8], v: View) bool {
    var bare: bool  = v.len > 0;
    var i:    usize = 0;
    for (i < v.len) {
        val c: u8 = v.data[i];
        if (c == '"' || c == '\\' || c < 0x20) { ret false; }
        if (!plain_byte(c))                    { bare = false; }
        i = i + 1;
    }
    if (bare) { ret put_text(out, v.data, v.len); }
    ret put_str(out, "\"") && put_text(out, v.data, v.len) && put_str(out, "\"");
}

# the `.section` line that reads back, under mach-o's naming `n` and the dialect's sections `d`, to a section named
# `name` of `kind`, `flags` and entries of `entsize`, a literal pointer `pointer` bytes wide, appended to `out`: the name
# alone when its convention opens it so, else the name and the first type word that classifies it so, code marked
# `pure_instructions` as llvm-mc marks `__TEXT,__text`. a section in a group is refused, as mach-o holds none
pub fun macho_header(out: *vector.Vector[u8], n: *contract.Naming, d: *dialect.Sections, name: View, kind: *mink_section.Kind, flags: mink_section.Flags, entsize: u64, pointer: u64, grouped: bool) err[Unwritten] {
    if (grouped) { ret err[Unwritten].err{Unwritten.grouped{}}; }
    var commas: u32   = 0;
    var i:      usize = 0;
    for (i < name.len) {
        val c: u8 = name.data[i];
        if (c == ',')       { commas = commas + 1; }
        or (!plain_byte(c)) { ret err[Unwritten].err{Unwritten.quoted{}}; }
        i = i + 1;
    }
    if (commas != 1) { ret err[Unwritten].err{Unwritten.quoted{}}; }
    var word: str        = nil;
    val c:    build.Spec = conventional(n, name);
    if (c.kind != kind || c.flags != flags || c.entsize != entsize) {
        var k: u32 = 0;
        for (k < d.types.len && word == nil) {
            val key: opt[mink_section.Key] = macho_key(n, name, d.types.at[k], pointer);
            if (sel key.some) {
                if (key.some.kind == kind && key.some.kind.flags == flags && key.some.entsize == entsize) { word = d.types.at[k]; }
            }
            k = k + 1;
        }
        if (word == nil) { ret err[Unwritten].err{Unwritten.kind{}}; }
    }
    var ok: bool = put_str(out, "\t.section ") && put_text(out, name.data, name.len);
    if (ok && word != nil) {
        ok = put_str(out, ",") && put_str(out, word);
        if (ok && (flags & mink_section.EXEC) != 0) { ok = put_str(out, ",pure_instructions"); }
    }
    if (!ok || !put_str(out, "\n")) { ret err[Unwritten].err{Unwritten.memory{}}; }
    ret err[Unwritten].ok{};
}

# the coff flag string that reads back to `kind` and `flags` for a section named `name`, its content letter first, then
# `w` or `r` and `D` for a section the link drops, as clang writes `"xr"` and `"dw"`, into `out`, which holds four
# bytes. none when no content letter's string reads back to them
fun coff_string(n: *contract.Naming, d: *dialect.Sections, name: View, kind: *mink_section.Kind, flags: mink_section.Flags, out: *u8) opt[usize] {
    var k: u32 = 0;
    for (k < d.letters.len) {
        val l: *dialect.Letter = ?d.letters.at[k];
        k = k + 1;
        if (l.type == nil) { cnt; }
        var len: usize = 0;
        out[len] = l.letter;
        len      = len + 1;
        if ((flags & mink_section.WRITE) != 0) { out[len] = 'w'; }
        or                                     { out[len] = 'r'; }
        len = len + 1;
        if ((flags & mink_section.ALLOC) == 0 && (l.clears & mink_section.ALLOC) == 0) {
            out[len] = 'D';
            len      = len + 1;
        }
        val read_: Lettered = coff_letters(d, View{data: out, len: len});
        if (sel read_.bad.some || read_.flags != flags) { cnt; }
        val key: opt[mink_section.Key] = coff_key(n, name, read_);
        if (sel key.some) {
            if (key.some.kind == kind && key.some.entsize == 0) { ret opt[usize].some{len}; }
        }
    }
    ret opt[usize].none{};
}

# the `.section` line that reads back, under coff's naming `n` and the dialect's sections `d`, to a section named
# `name` of `kind`, `flags` and entries of `entsize`, in the comdat group `group` signs, kept by `rule`, appended to
# `out`. an element size, which no coff header states, is refused, and so is a rule no selection word states
pub fun coff_header(out: *vector.Vector[u8], n: *contract.Naming, d: *dialect.Sections, name: View, kind: *mink_section.Kind, flags: mink_section.Flags, entsize: u64, group: opt[View], rule: *mink_group.Rule) err[Unwritten] {
    if (entsize != 0) { ret err[Unwritten].err{Unwritten.kind{}}; }
    var letters: [4]u8;
    val spelled: opt[usize] = coff_string(n, d, name, kind, flags, ?letters[0]);
    if (sel spelled.none) { ret err[Unwritten].err{Unwritten.kind{}}; }
    var word: str = nil;
    if (sel group.some) {
        var k: u32 = 0;
        for (k < d.selections.len) {
            if (d.selections.at[k].rule == rule) { word = d.selections.at[k].word; }
            k = k + 1;
        }
        if (word == nil) { ret err[Unwritten].err{Unwritten.grouped{}}; }
    }
    if (!put_str(out, "\t.section ")) { ret err[Unwritten].err{Unwritten.memory{}}; }
    if (!put_named(out, name))        { ret err[Unwritten].err{Unwritten.quoted{}}; }
    var ok: bool = put_str(out, ", \"") && put_text(out, ?letters[0], spelled.some) && put_str(out, "\"");
    if (sel group.some) {
        ok = ok && put_str(out, ", ") && put_str(out, word) && put_str(out, ", ");
        if (ok && !put_named(out, group.some)) { ret err[Unwritten].err{Unwritten.quoted{}}; }
    }
    if (!ok || !put_str(out, "\n")) { ret err[Unwritten].err{Unwritten.memory{}}; }
    ret err[Unwritten].ok{};
}

fun failed(args: *model.Args, k: u32, e: err[str]) err[diagnostic.Diagnostic] {
    if (sel e.err) { ret err[diagnostic.Diagnostic].err{model.refuse(args, k, e.err)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

fun built(args: *model.Args, k: u32, e: err[build.Refusal]) err[diagnostic.Diagnostic] {
    if (sel e.err) { ret err[diagnostic.Diagnostic].err{model.refuse(args, k, e.err.message)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# the section the dialect's directive at the row's parameter enters by its own name, as `.text`, opened as that name's
# convention states
pub fun named_section(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val n:    *dialect.Named = ?m.dialect.sections.named.at[args.directive.param::u32];
    val name: View           = View{data: n.name, len: str_len(n.name)};
    ret failed(args, 0, model.enter(m, name, conventional(model.naming(m), name), false, opt[u64].none{}));
}

# `.section` read in the dialect's grammar, after a push when `push`
fun any_section(m: *model.Assembler, args: *model.Args, push: bool) err[diagnostic.Diagnostic] {
    val form: dialect.Form = m.dialect.sections.form;
    if (sel form.macho) { ret macho_section(m, args, push); }
    if (sel form.coff)  { ret coff_section(m, args, push); }
    ret section(m, args, push);
}

fun do_section(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    ret any_section(m, args, false);
}

fun do_pushsection(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    ret any_section(m, args, true);
}

fun do_popsection(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    ret failed(args, 0, model.pop_section(m));
}

fun do_previous(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    ret failed(args, 0, model.swap_previous(m));
}

# each named symbol given the binding the row's parameter indexes
val BINDINGS: [3]*symbol.Binding = [3]*symbol.Binding{?symbol.GLOBAL, ?symbol.LOCAL, ?symbol.WEAKLY};

fun do_binding(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    var k: u32 = 0;
    for (k < args.count) {
        val l: res[build.Label, diagnostic.Diagnostic] = model.symbol(m, args, k);
        if (sel l.err) { ret err[diagnostic.Diagnostic].err{l.err}; }
        val done: err[diagnostic.Diagnostic] = failed(args, k, model.declare_binding(m, l.ok, BINDINGS[args.directive.param]));
        if (sel done.err) { ret done; }
        k = k + 1;
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the directive that gives a symbol binding `b`, the first row that does, none when none does
pub fun binding_directive(b: *symbol.Binding) opt[str] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].handler == do_binding && BINDINGS[ROWS[i].param::usize] == b) { ret opt[str].some{ROWS[i].name}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

# each named symbol given the visibility the row's parameter indexes
val VISIBILITIES: [3]*symbol.Visibility = [3]*symbol.Visibility{?symbol.HIDDEN, ?symbol.PROTECTED, ?symbol.INTERNAL};

fun do_visibility(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    var k: u32 = 0;
    for (k < args.count) {
        val l: res[build.Label, diagnostic.Diagnostic] = model.symbol(m, args, k);
        if (sel l.err) { ret err[diagnostic.Diagnostic].err{l.err}; }
        val done: err[diagnostic.Diagnostic] = failed(args, k, model.declare_visibility(m, l.ok, VISIBILITIES[args.directive.param]));
        if (sel done.err) { ret done; }
        k = k + 1;
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the directive that gives a symbol visibility `v`, the first row that does, none when none does
pub fun visibility_directive(v: *symbol.Visibility) opt[str] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].handler == do_visibility && VISIBILITIES[ROWS[i].param::usize] == v) { ret opt[str].some{ROWS[i].name}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

# a `.type` spelling and the kind of symbol it names (gas manual, ".type", elf version)
rec Kind {
    name: str;
    kind: *symbol.Kind;
}

val KINDS: [12]Kind = [12]Kind{
    Kind{name: "function", kind: ?symbol.FUNCTION},
    Kind{name: "object", kind: ?symbol.DATA},
    Kind{name: "notype", kind: ?symbol.NOTYPE},
    Kind{name: "tls_object", kind: ?symbol.TLS},
    Kind{name: "common", kind: ?symbol.COMMONS},
    Kind{name: "gnu_indirect_function", kind: ?symbol.IFUNC},
    Kind{name: "STT_FUNC", kind: ?symbol.FUNCTION},
    Kind{name: "STT_OBJECT", kind: ?symbol.DATA},
    Kind{name: "STT_NOTYPE", kind: ?symbol.NOTYPE},
    Kind{name: "STT_TLS", kind: ?symbol.TLS},
    Kind{name: "STT_COMMON", kind: ?symbol.COMMONS},
    Kind{name: "STT_GNU_IFUNC", kind: ?symbol.IFUNC},
};

# the `.type` spelling of symbol kind `kind`, the first that names it, none when none does
pub fun type_spelling(kind: *symbol.Kind) opt[str] {
    var i: usize = 0;
    for (i < 12) {
        if (KINDS[i].kind == kind) { ret opt[str].some{KINDS[i].name}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

# a `.type` spelling that states a binding with the kind (gas manual, ".type", elf version), as `gnu_unique_object`
# names an object of the unique binding, which llvm-mc 23.1.1 reads alike (MCSA_ELF_TypeGnuUniqueObject)
rec Bound {
    name:    str;
    kind:    *symbol.Kind;
    binding: *symbol.Binding;
}

val BOUND_COUNT: usize              = 1;
val BOUND_KINDS: [BOUND_COUNT]Bound = [BOUND_COUNT]Bound{Bound{name: "gnu_unique_object", kind: ?symbol.DATA, binding: ?symbol.UNIQUELY}};

# the `.type` spelling that states binding `binding` with kind `kind`, for a binding no binding directive states, none
# when none does
pub fun bound_type(binding: *symbol.Binding, kind: *symbol.Kind) opt[str] {
    var i: usize = 0;
    for (i < BOUND_COUNT) {
        if (BOUND_KINDS[i].binding == binding && BOUND_KINDS[i].kind == kind) { ret opt[str].some{BOUND_KINDS[i].name}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

fun do_type(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val l: res[build.Label, diagnostic.Diagnostic] = model.symbol(m, args, 0);
    if (sel l.err) { ret err[diagnostic.Diagnostic].err{l.err}; }
    val w: model.Argument = args.items[1].value;
    if (!sel w.word) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 1, UNKNOWN_TYPE)}; }
    var i: usize = 0;
    for (i < 12) {
        if (same(w.word, KINDS[i].name)) { ret failed(args, 1, model.declare_kind(m, l.ok, KINDS[i].kind)); }
        i = i + 1;
    }
    i = 0;
    for (i < BOUND_COUNT) {
        if (same(w.word, BOUND_KINDS[i].name)) {
            val kinded: err[diagnostic.Diagnostic] = failed(args, 1, model.declare_kind(m, l.ok, BOUND_KINDS[i].kind));
            if (sel kinded.err) { ret kinded; }
            ret failed(args, 1, model.declare_bound(m, l.ok, BOUND_KINDS[i].binding));
        }
        i = i + 1;
    }
    ret err[diagnostic.Diagnostic].err{model.refuse(args, 1, UNKNOWN_TYPE)};
}

fun do_size(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val l: res[build.Label, diagnostic.Diagnostic] = model.symbol(m, args, 0);
    if (sel l.err) { ret err[diagnostic.Diagnostic].err{l.err}; }
    val v: model.Argument = args.items[1].value;
    if (!sel v.expression) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 1, model.NOT_CONSTANT)}; }
    var e: expr.Expr = v.expression;
    if (sel e.constant) {
        if (e.constant < 0) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 1, NEGATIVE)}; }
        ret failed(args, 1, model.declare_size(m, l.ok, build.Size.fixed{e.constant:~u64}));
    }
    if (!sel e.difference) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 1, model.NOT_CONSTANT)}; }
    val bound_: err[str] = model.bind(m, ?e, model.position(args, 1));
    if (sel bound_.err)    { ret failed(args, 1, bound_); }
    if (!sel e.difference) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 1, model.NOT_CONSTANT)}; }
    val d: build.Difference = build.Difference{plus: build.Label{id: e.difference.plus}, minus: build.Label{id: e.difference.minus}, addend: e.difference.addend};
    ret failed(args, 1, model.declare_size(m, l.ok, build.Size.measured{d}));
}

# each value of an integer data directive at the row's width, which the set states
pub fun integers(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    var k: u32 = 0;
    for (k < args.count) {
        val done: err[diagnostic.Diagnostic] = model.datum(m, args, k, args.directive.param);
        if (sel done.err) { ret done; }
        k = k + 1;
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# each string's bytes, a nul after each when the row's parameter is 1
fun do_strings(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    var k: u32 = 0;
    for (k < args.count) {
        val v: model.Argument = args.items[k].value;
        if (!sel v.string) { ret err[diagnostic.Diagnostic].err{model.refuse(args, k, model.NOT_A_STRING)}; }
        val bytes: err[diagnostic.Diagnostic] = built(args, k, build.data(model.builder(m), v.string.data, v.string.len));
        if (sel bytes.err) { ret bytes; }
        if (args.directive.param == 1) {
            val nul: err[diagnostic.Diagnostic] = built(args, k, build.integer(model.builder(m), 0, 1));
            if (sel nul.err) { ret nul; }
        }
        k = k + 1;
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# each constant as a leb128, signed when the row's parameter is 1
fun do_leb128(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    var k: u32 = 0;
    for (k < args.count) {
        val n: res[i64, diagnostic.Diagnostic] = model.constant(args, k);
        if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
        var bytes: [10]u8;
        var len:   usize = 0;
        if (args.directive.param == 1) { len = leb128.put_signed(?bytes[0], n.ok); }
        or                             { len = leb128.put_unsigned(?bytes[0], n.ok:~u64); }
        val done: err[diagnostic.Diagnostic] = built(args, k, build.data(model.builder(m), ?bytes[0], len));
        if (sel done.err) { ret done; }
        k = k + 1;
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the ieee 754 interchange format `bytes` wide, none for a width that names none
fun float_format(bytes: u64) opt[ieee.Format] {
    if (bytes == 2) { ret opt[ieee.Format].some{ieee.F16}; }
    if (bytes == 4) { ret opt[ieee.Format].some{ieee.F32}; }
    if (bytes == 8) { ret opt[ieee.Format].some{ieee.F64}; }
    ret opt[ieee.Format].none{};
}

# each literal rounded once to the ieee 754 format the row's parameter names the width of
fun do_floats(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val f: opt[ieee.Format] = float_format(args.directive.param);
    if (sel f.none) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, NO_FLOAT_FORMAT)}; }
    var k: u32 = 0;
    for (k < args.count) {
        val v: model.Argument = args.items[k].value;
        if (!sel v.float) { ret err[diagnostic.Diagnostic].err{model.refuse(args, k, model.NOT_A_NUMBER)}; }
        val bits: res[u128, number.ParseError] = model.float_bits(v.float, f.some);
        if (sel bits.err) { ret err[diagnostic.Diagnostic].err{model.refuse(args, k, model.NOT_A_NUMBER)}; }
        val done: err[diagnostic.Diagnostic] = built(args, k, build.integer(model.builder(m), bits.ok::u64, args.directive.param::u8));
        if (sel done.err) { ret done; }
        k = k + 1;
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# an alignment: its boundary in bytes, or as a power of two when `power`, then an optional fill byte and limit
fun aligned(m: *model.Assembler, args: *model.Args, power: bool) err[diagnostic.Diagnostic] {
    val n: res[i64, diagnostic.Diagnostic] = model.constant(args, 0);
    if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
    var boundary: u64 = n.ok:~u64;
    if (power) {
        if (n.ok < 0 || n.ok >= 64) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, model.RANGE)}; }
        boundary = 1::u64 << n.ok::u64;
    }
    or (n.ok <= 0) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, build.BOUNDARY)}; }
    var al: build.Align = build.Align{boundary: boundary, fill: opt[u8].none{}, max: opt[u64].none{}};
    if (model.given(args, 1)) {
        val fill: res[i64, diagnostic.Diagnostic] = model.constant(args, 1);
        if (sel fill.err)                    { ret err[diagnostic.Diagnostic].err{fill.err}; }
        if (fill.ok < -128 || fill.ok > 255) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 1, model.RANGE)}; }
        al.fill = opt[u8].some{(fill.ok & 0xFF)::u8};
    }
    if (model.given(args, 2)) {
        val max: res[i64, diagnostic.Diagnostic] = model.constant(args, 2);
        if (sel max.err) { ret err[diagnostic.Diagnostic].err{max.err}; }
        if (max.ok < 0)  { ret err[diagnostic.Diagnostic].err{model.refuse(args, 2, NEGATIVE)}; }
        al.max = opt[u64].some{max.ok:~u64};
    }
    ret built(args, 0, build.align(model.builder(m), al));
}

# `.align`, which reads its boundary as the set states
fun do_align(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    ret aligned(m, args, model.builder(m).set.source.align == source.ALIGN_POWER);
}

fun do_p2align(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    ret aligned(m, args, true);
}

fun do_balign(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    ret aligned(m, args, false);
}

# `count` copies of the `size` low bytes of `value` in the set's byte order, zeros as a zero fill
fun repeated(m: *model.Assembler, args: *model.Args, count: u64, size: u64, value: u64) err[diagnostic.Diagnostic] {
    if (count == 0 || size == 0) { ret err[diagnostic.Diagnostic].ok{}; }
    if (value == 0)              { ret built(args, 0, build.zero(model.builder(m), count * size)); }
    var pattern: [8]u8;
    build.ordered(model.builder(m), value, size::usize, ?pattern[0]);
    var bytes: vector.Vector[u8]   = vector.init[u8](m.a);
    val room:  res[usize, A.Error] = vector.reserve[u8](?bytes, (count * size)::usize);
    if (sel room.err) {
        vector.dnit[u8](?bytes);
        ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, field.MEMORY)};
    }
    var i: u64 = 0;
    for (i < count * size) {
        bytes.data[i::usize] = pattern[(i % size)::usize];
        i                    = i + 1;
    }
    val done: err[diagnostic.Diagnostic] = built(args, 0, build.data(model.builder(m), bytes.data, (count * size)::usize));
    vector.dnit[u8](?bytes);
    ret done;
}

# a count operand, refused when negative
fun count(args: *model.Args, k: u32, otherwise: i64) res[u64, diagnostic.Diagnostic] {
    val n: res[i64, diagnostic.Diagnostic] = model.constant_or(args, k, otherwise);
    if (sel n.err) { ret res[u64, diagnostic.Diagnostic].err{n.err}; }
    if (n.ok < 0)  { ret res[u64, diagnostic.Diagnostic].err{model.refuse(args, k, NEGATIVE)}; }
    ret res[u64, diagnostic.Diagnostic].ok{n.ok:~u64};
}

# `.skip size[, fill]`: size bytes of the fill byte
fun do_skip(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val n: res[u64, diagnostic.Diagnostic] = count(args, 0, 0);
    if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
    val fill: res[i64, diagnostic.Diagnostic] = model.constant_or(args, 1, 0);
    if (sel fill.err)                    { ret err[diagnostic.Diagnostic].err{fill.err}; }
    if (fill.ok < -128 || fill.ok > 255) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 1, model.RANGE)}; }
    ret repeated(m, args, n.ok, 1, (fill.ok & 0xFF):~u64);
}

# `.zero size`: size zero bytes
fun do_zero(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val n: res[u64, diagnostic.Diagnostic] = count(args, 0, 0);
    if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
    ret repeated(m, args, n.ok, 1, 0);
}

# `.fill repeat[, size[, value]]`: repeat copies of size bytes, of an eight byte number whose high four bytes are zero
# and whose low four are the value's (gas manual, ".fill")
fun do_fill(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val n: res[u64, diagnostic.Diagnostic] = count(args, 0, 0);
    if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
    val size: res[u64, diagnostic.Diagnostic] = count(args, 1, 1);
    if (sel size.err) { ret err[diagnostic.Diagnostic].err{size.err}; }
    if (size.ok > 8)  { ret err[diagnostic.Diagnostic].err{model.refuse(args, 1, model.RANGE)}; }
    val value: res[i64, diagnostic.Diagnostic] = model.constant_or(args, 2, 0);
    if (sel value.err) { ret err[diagnostic.Diagnostic].err{value.err}; }
    ret repeated(m, args, n.ok, size.ok, value.ok:~u64 & 0xFFFF_FFFF);
}

# `.set name, value` when the row's parameter is 0, which may redefine it, and `.equ` when 1, which may not
fun do_equate(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val l: res[build.Label, diagnostic.Diagnostic] = model.symbol(m, args, 0);
    if (sel l.err) { ret err[diagnostic.Diagnostic].err{l.err}; }
    val v: model.Argument = args.items[1].value;
    if (!sel v.expression) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 1, model.NOT_CONSTANT)}; }
    ret failed(args, 0, model.equate(m, l.ok, v.expression, args.directive.param == 1, model.position(args, 1)));
}

# the word after a symbol version that keeps no symbol of the unversioned name, as llvm-mc 23.1.1 reads it
pub val REMOVE: str = "remove";

pub val NOT_VERSIONED: str = "expected a symbol version, a name, `@`, `@@` or `@@@` and the version's name";
pub val NOT_REMOVE:    str = "expected `remove`";

# `.symver name, alias@version[, remove]` read: the alias name, its `@`, `@@` or `@@@` and the version (gas manual,
# ".symver"), the symbol of `name` renamed to it or given it as an alias beside its own. either name may be quoted
# (`masc.syntax.name`), a quoted alias holding its version
fun do_symver(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val rd:   *syntax.Reader                   = args.reader;
    val at:   usize                            = rd.at;
    val name: res[View, diagnostic.Diagnostic] = model.symbol_name(m, rd);
    if (sel name.err) { ret err[diagnostic.Diagnostic].err{name.err}; }
    val l: res[build.Label, str] = model.label_named(m, name.ok);
    if (sel l.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, l.err, at, rd.at - at)}; }
    read.skip(rd);
    if (!read.take(rd, ",")) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, model.EXPECTED_COMMA, rd.at, read.token(rd, rd.at))}; }
    read.skip(rd);
    val from:  usize = rd.at;
    var alias: View  = View{data: nil, len: 0};
    if (read.peek(rd) == '"') {
        # a quoted alias is its whole versioned name, as `"a b@V1"`
        val quoted: res[View, diagnostic.Diagnostic] = model.symbol_name(m, rd);
        if (sel quoted.err) { ret err[diagnostic.Diagnostic].err{quoted.err}; }
        alias = quoted.ok;
    }
    or {
        val stem: usize = read.name(rd);
        rd.at = from + stem;
        for (rd.at < rd.end && rd.text[rd.at] == '@') {
            rd.at = rd.at + 1;
        }
        val tail: usize = read.name(rd);
        rd.at = rd.at + tail;
        alias = read.span(rd, from, rd.at - from);
        if (stem == 0 || tail == 0) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NOT_VERSIONED, from, rd.at - from)}; }
    }
    if (build.versioned_at(alias) == 0) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NOT_VERSIONED, from, rd.at - from)}; }
    var keep: bool = true;
    read.skip(rd);
    if (read.take(rd, ",")) {
        read.skip(rd);
        val word: usize = rd.at;
        if (read.token(rd, word) != str_len(REMOVE) || !read.starts(rd, word, REMOVE, str_len(REMOVE))) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NOT_REMOVE, word, read.token(rd, word))}; }
        rd.at = word + str_len(REMOVE);
        keep  = false;
    }
    val rest: err[diagnostic.Diagnostic] = model.ended(rd);
    if (sel rest.err) { ret rest; }
    val stated: err[build.Refusal] = build.version(?m.b, l.ok, alias, keep);
    if (sel stated.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, stated.err.message, from, alias.len)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# a relocation of the gnu assembler's generic names (gas manual, ".reloc"), as one of mink's kinds every format and
# architecture pair shares
rec Generic {
    name: str;
    kind: *mink_reloc.Kind;
}

val GENERIC_COUNT: usize                  = 5;
val GENERICS:      [GENERIC_COUNT]Generic = [GENERIC_COUNT]Generic{
    Generic{name: "BFD_RELOC_NONE", kind: ?mink_reloc.NONE},
    Generic{name: "BFD_RELOC_8", kind: ?mink_reloc.ABS8},
    Generic{name: "BFD_RELOC_16", kind: ?mink_reloc.ABS16},
    Generic{name: "BFD_RELOC_32", kind: ?mink_reloc.ABS32},
    Generic{name: "BFD_RELOC_64", kind: ?mink_reloc.ABS64},
};

pub val UNKNOWN_RELOCATION: str = "relocation the object's format names no kind of for the architecture";
pub val RELOCATION_PLACE:   str = "relocation place that is neither an offset nor a label plus one";
pub val RELOCATION_TARGET:  str = "relocation target that is neither a label plus an addend nor a constant addend";

# the relocation kind `name` names: a row of the object's format for the architecture, or a generic one
fun relocation_kind(m: *model.Assembler, name: View) opt[*mink_reloc.Kind] {
    var i: usize = 0;
    for (i < GENERIC_COUNT) {
        if (same(name, GENERICS[i].name)) { ret opt[*mink_reloc.Kind].some{GENERICS[i].kind}; }
        i = i + 1;
    }
    ret build.relocation_named(?m.b, name);
}

# `.reloc offset, name[, target]` read (gas manual, ".reloc"): a relocation of the kind `name` names at `offset` of the
# current section, a number from its start or a label plus one, naming `target`, a label plus an addend, or nothing
# with a constant addend or none
fun do_reloc(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val rd:       *syntax.Reader                        = args.reader;
    val place_at: usize                                 = rd.at;
    var place:    res[expr.Expr, diagnostic.Diagnostic] = expr.parse(rd, operand.NO_FIXUP);
    if (sel place.err) { ret err[diagnostic.Diagnostic].err{place.err}; }
    val bound_: err[str] = model.bind(m, ?place.ok, read.refuse(rd, "", place_at, 0).span.start);
    if (sel bound_.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, bound_.err, place_at, rd.at - place_at)}; }
    var at:     opt[build.Label] = opt[build.Label].none{};
    var offset: i64              = 0;
    if (sel place.ok.constant) { offset = place.ok.constant; }
    or (sel place.ok.symbol) {
        if (place.ok.symbol.fixup != operand.NO_FIXUP) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, RELOCATION_PLACE, place_at, rd.at - place_at)}; }
        at     = opt[build.Label].some{build.Label{id: place.ok.symbol.id}};
        offset = place.ok.symbol.addend;
    }
    or              { ret err[diagnostic.Diagnostic].err{read.refuse(rd, RELOCATION_PLACE, place_at, rd.at - place_at)}; }
    if (offset < 0) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, RELOCATION_PLACE, place_at, rd.at - place_at)}; }
    read.skip(rd);
    if (!read.take(rd, ",")) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, model.EXPECTED_COMMA, rd.at, read.token(rd, rd.at))}; }
    read.skip(rd);
    val name_at: usize = rd.at;
    val len:     usize = read.name(rd);
    if (len == 0) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, model.NOT_A_NAME, name_at, read.token(rd, name_at))}; }
    rd.at = name_at + len;
    val kind: opt[*mink_reloc.Kind] = relocation_kind(m, read.span(rd, name_at, len));
    if (sel kind.none) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_RELOCATION, name_at, len)}; }
    var target: opt[build.Label] = opt[build.Label].none{};
    var addend: i64              = 0;
    read.skip(rd);
    if (read.take(rd, ",")) {
        read.skip(rd);
        val aim_at: usize                                 = rd.at;
        var aimed:  res[expr.Expr, diagnostic.Diagnostic] = expr.parse(rd, operand.NO_FIXUP);
        if (sel aimed.err) { ret err[diagnostic.Diagnostic].err{aimed.err}; }
        val named: err[str] = model.bind(m, ?aimed.ok, read.refuse(rd, "", aim_at, 0).span.start);
        if (sel named.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, named.err, aim_at, rd.at - aim_at)}; }
        # a constant is the addend of a relocation that names nothing
        if (sel aimed.ok.constant) { addend = aimed.ok.constant; }
        or (sel aimed.ok.symbol) {
            if (aimed.ok.symbol.fixup != operand.NO_FIXUP) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, RELOCATION_TARGET, aim_at, rd.at - aim_at)}; }
            target = opt[build.Label].some{build.Label{id: aimed.ok.symbol.id}};
            addend = aimed.ok.symbol.addend;
        }
        or { ret err[diagnostic.Diagnostic].err{read.refuse(rd, RELOCATION_TARGET, aim_at, rd.at - aim_at)}; }
    }
    val rest: err[diagnostic.Diagnostic] = model.ended(rd);
    if (sel rest.err) { ret rest; }
    val stated: err[build.Refusal] = build.relocate(?m.b, build.Direct{at: at, offset: offset:~u64, kind: kind.some, target: target, addend: addend});
    if (sel stated.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, stated.err.message, place_at, rd.at - place_at)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# the alignment storage of `size` bytes takes when none is stated: the largest power of two not above it, at most 16
fun natural(size: u64) u64 {
    var a: u64 = 1;
    for (a * 2 <= size && a < 16) {
        a = a * 2;
    }
    ret a;
}

# `size` bytes at a boundary of `align` reserved for label `l` in `.bss`, the sections as they were after
fun local_storage(m: *model.Assembler, args: *model.Args, l: build.Label, size: u64, align: u64) err[diagnostic.Diagnostic] {
    val b:        *build.Builder             = model.builder(m);
    val was:      opt[build.Section]         = build.current(b);
    val previous: opt[build.Section]         = model.previous_of(m);
    val name:     View                       = View{data: ".bss", len: 4};
    val entered:  err[diagnostic.Diagnostic] = failed(args, 0, model.enter(m, name, conventional(model.naming(m), name), false, opt[u64].none{}));
    if (sel entered.err) { ret entered; }
    val al: err[diagnostic.Diagnostic] = built(args, 2, build.align(b, build.Align{boundary: align, fill: opt[u8].none{}, max: opt[u64].none{}}));
    if (sel al.err) { ret al; }
    val placed: err[diagnostic.Diagnostic] = built(args, 0, build.define(b, l));
    if (sel placed.err) { ret placed; }
    val zeros: err[diagnostic.Diagnostic] = built(args, 1, build.zero(b, size));
    if (sel zeros.err) { ret zeros; }
    if (sel was.some) {
        val back: err[diagnostic.Diagnostic] = built(args, 0, build.switch(b, was.some));
        if (sel back.err) { ret back; }
    }
    model.restore_previous(m, previous);
    ret err[diagnostic.Diagnostic].ok{};
}

# `.comm name, size[, align]`, common storage, or local storage in `.bss` for a name declared local, as `.lcomm`
# always is when the row's parameter is 1
fun do_common(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val l: res[build.Label, diagnostic.Diagnostic] = model.symbol(m, args, 0);
    if (sel l.err) { ret err[diagnostic.Diagnostic].err{l.err}; }
    val size: res[u64, diagnostic.Diagnostic] = count(args, 1, 0);
    if (sel size.err) { ret err[diagnostic.Diagnostic].err{size.err}; }
    val align: res[u64, diagnostic.Diagnostic] = count(args, 2, natural(size.ok)::i64);
    if (sel align.err)                                     { ret err[diagnostic.Diagnostic].err{align.err}; }
    if (align.ok == 0 || (align.ok & (align.ok - 1)) != 0) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 2, build.BOUNDARY)}; }
    val binding: opt[*symbol.Binding] = model.binding_of(m, l.ok);
    var local:   bool                 = args.directive.param == 1;
    if (sel binding.some) { local = local || binding.some == ?symbol.LOCAL; }
    if (local)            { ret local_storage(m, args, l.ok, size.ok, align.ok); }
    if (sel binding.none) {
        val declared: err[diagnostic.Diagnostic] = failed(args, 0, model.declare_binding(m, l.ok, ?symbol.GLOBAL));
        if (sel declared.err) { ret declared; }
    }
    val kind: opt[*symbol.Kind] = model.kind_declared(m, l.ok);
    if (sel kind.none) {
        val typed: err[diagnostic.Diagnostic] = failed(args, 0, model.declare_kind(m, l.ok, ?symbol.DATA));
        if (sel typed.err) { ret typed; }
    }
    ret built(args, 0, build.common(model.builder(m), l.ok, size.ok, align.ok));
}

val TYPE_ITEMS:   [2]model.Item = [2]model.Item{model.NAME, model.WORD};
val NAMED_VALUE:  [2]model.Item = [2]model.Item{model.NAME, model.EXPRESSION};
val THREE_VALUES: [3]model.Item = [3]model.Item{model.EXPRESSION, model.EXPRESSION, model.EXPRESSION};
val STORAGE:      [3]model.Item = [3]model.Item{model.NAME, model.EXPRESSION, model.EXPRESSION};

val TYPED:  model.Shape = model.Shape{items: ?TYPE_ITEMS[0], len: 2, least: 2, repeat: false, text: false};
val VALUED: model.Shape = model.Shape{items: ?NAMED_VALUE[0], len: 2, least: 2, repeat: false, text: false};
val ALIGN:  model.Shape = model.Shape{items: ?THREE_VALUES[0], len: 3, least: 1, repeat: false, text: false};
val SKIP:   model.Shape = model.Shape{items: ?THREE_VALUES[0], len: 2, least: 1, repeat: false, text: false};
val ZERO:   model.Shape = model.Shape{items: ?THREE_VALUES[0], len: 1, least: 1, repeat: false, text: false};
val COMMON: model.Shape = model.Shape{items: ?STORAGE[0], len: 3, least: 2, repeat: false, text: false};

# the core rows (gas manual, "Assembler Directives")
val ROW_COUNT: usize = 32;

val ROWS: [ROW_COUNT]model.Directive = [ROW_COUNT]model.Directive{
    model.Directive{name: ".section", operands: model.TEXT, handler: do_section, param: 0},
    model.Directive{name: ".pushsection", operands: model.TEXT, handler: do_pushsection, param: 0},
    model.Directive{name: ".popsection", operands: model.NO_ITEMS, handler: do_popsection, param: 0},
    model.Directive{name: ".previous", operands: model.NO_ITEMS, handler: do_previous, param: 0},
    model.Directive{name: ".globl", operands: model.NAMES, handler: do_binding, param: 0},
    model.Directive{name: ".global", operands: model.NAMES, handler: do_binding, param: 0},
    model.Directive{name: ".local", operands: model.NAMES, handler: do_binding, param: 1},
    model.Directive{name: ".weak", operands: model.NAMES, handler: do_binding, param: 2},
    model.Directive{name: ".hidden", operands: model.NAMES, handler: do_visibility, param: 0},
    model.Directive{name: ".protected", operands: model.NAMES, handler: do_visibility, param: 1},
    model.Directive{name: ".internal", operands: model.NAMES, handler: do_visibility, param: 2},
    model.Directive{name: ".type", operands: TYPED, handler: do_type, param: 0},
    model.Directive{name: ".size", operands: VALUED, handler: do_size, param: 0},
    model.Directive{name: ".ascii", operands: model.STRINGS, handler: do_strings, param: 0},
    model.Directive{name: ".asciz", operands: model.STRINGS, handler: do_strings, param: 1},
    model.Directive{name: ".string", operands: model.STRINGS, handler: do_strings, param: 1},
    model.Directive{name: ".uleb128", operands: model.EXPRESSIONS, handler: do_leb128, param: 0},
    model.Directive{name: ".sleb128", operands: model.EXPRESSIONS, handler: do_leb128, param: 1},
    model.Directive{name: ".float", operands: model.FLOATS, handler: do_floats, param: 4},
    model.Directive{name: ".double", operands: model.FLOATS, handler: do_floats, param: 8},
    model.Directive{name: ".align", operands: ALIGN, handler: do_align, param: 0},
    model.Directive{name: ".p2align", operands: ALIGN, handler: do_p2align, param: 0},
    model.Directive{name: ".balign", operands: ALIGN, handler: do_balign, param: 0},
    model.Directive{name: ".skip", operands: SKIP, handler: do_skip, param: 0},
    model.Directive{name: ".zero", operands: ZERO, handler: do_zero, param: 0},
    model.Directive{name: ".fill", operands: ALIGN, handler: do_fill, param: 0},
    model.Directive{name: ".set", operands: VALUED, handler: do_equate, param: 0},
    model.Directive{name: ".equ", operands: VALUED, handler: do_equate, param: 1},
    model.Directive{name: ".comm", operands: COMMON, handler: do_common, param: 0},
    model.Directive{name: ".lcomm", operands: COMMON, handler: do_common, param: 1},
    model.Directive{name: ".symver", operands: model.TEXT, handler: do_symver, param: 0},
    model.Directive{name: ".reloc", operands: model.TEXT, handler: do_reloc, param: 0},
};

# the layer of the core rows
pub val LAYER: model.Layer = model.Layer{name: "core", directives: model.Directives{at: ?ROWS[0], len: ROW_COUNT::u32}, context: nil, finish: model.finished};

# the assembly started in the section the dialect starts in, as the gnu assembler starts in `.text` and llvm-mc on
# mach-o in `__TEXT,__text`, opened as its convention states when something is first written to it, a label is placed
# in it or a directive names it, so a source whose first statement is a `.section` holds no empty starting section
pub fun begin(m: *model.Assembler) err[str] {
    val start: str        = m.dialect.sections.start;
    val name:  View       = View{data: start, len: str_len(start)};
    var spec:  build.Spec = conventional(model.naming(m), name);
    spec.name = opt[str].some{start};
    val begun: err[build.Refusal] = build.begin(model.builder(m), spec);
    if (sel begun.err) { ret err[str].err{begun.err.message}; }
    ret err[str].ok{};
}

# the directive of the dialect's sections `d` that enters a nameless section of `kind`, `flags`, `disposition` and
# entries of `entsize` by its key alone under the object format's naming `n`: the first that enters a section by a
# name whose convention opens it so, none when none does. the section read back is named as the directive's row names
# it
pub fun kind_directive(n: *contract.Naming, d: *dialect.Sections, kind: *mink_section.Kind, flags: mink_section.Flags, disposition: *mink_section.Disposition, entsize: u64) opt[*dialect.Named] {
    var i: u32 = 0;
    for (i < d.named.len) {
        val row: *dialect.Named = ?d.named.at[i];
        i = i + 1;
        val c: build.Spec = conventional(n, View{data: row.name, len: str_len(row.name)});
        if (c.kind == kind && c.flags == flags && c.disposition == disposition && c.entsize == entsize) { ret opt[*dialect.Named].some{row}; }
    }
    ret opt[*dialect.Named].none{};
}
