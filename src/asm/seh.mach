# the windows unwind directives of llvm-mc 23.1.1, a layer of rows over the frame facts of `masc.emit.seh`
#
# `.seh_proc` begins a frame as `.cfi_startproc` does, naming the label placed
# where it starts, and `.seh_endproc` ends it. each code directive is a row of
# `masc.emit.seh.DIRECTIVES` for the object's architecture, read by its
# operands into the code it spells and stated as the call frame rules that
# code states, so mink lowers the frame to the same unwind data. a register is
# a register of the set, read by its syntax's names. `.seh_handler` names the
# personality routine, which mink's unwind data always states as both the
# exception and the termination handler, so both `@except` and `@unwind` are
# required. language data (`.seh_handlerdata`), epilogue marks and chained
# regions are no rows.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use masc.asm.model;
use masc.build.build;
use masc.core.diagnostic;
use masc.core.operand;
use core_syntax: masc.core.syntax;
use masc.emit.cfi;
use masc.emit.seh;
use masc.syntax.expr;
use masc.syntax.read;

pub val NEVER_ENDED:    str = "procedure never ended";
pub val NOT_A_REGISTER: str = "expected a register";
pub val NOT_HERE:    str = "procedure whose name is not the label placed where it starts";
pub val NO_PROC:     str = "unwind code outside a procedure";
pub val OTHER:       str = "unwind code of another architecture's windows unwind codes";
pub val UNFIT:       str = "operands no unwind code of the directive states";
pub val HANDLER:     str = "handler that is not both `@except` and `@unwind`, as mink's unwind data always states it";

# what the layer keeps
# ---
# site: where the open procedure was started, none when none is open
# proc: the open procedure's codes
pub rec Text {
    site: opt[diagnostic.Position];
    proc: seh.Proc;
}

fun built(args: *model.Args, e: err[build.Refusal]) err[diagnostic.Diagnostic] {
    if (sel e.err) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, e.err.message)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

fun ended(rd: *core_syntax.Reader) err[diagnostic.Diagnostic] {
    read.skip(rd);
    if (rd.at < rd.end) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, read.UNEXPECTED, rd.at, rd.end - rd.at)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

fun comma(rd: *core_syntax.Reader) err[diagnostic.Diagnostic] {
    read.skip(rd);
    if (read.peek(rd) != ',') { ret err[diagnostic.Diagnostic].err{read.refuse(rd, read.EXPECTED, rd.at, read.token(rd, rd.at))}; }
    rd.at = rd.at + 1;
    ret err[diagnostic.Diagnostic].ok{};
}

# the register at the reader by its dwarf number
fun register_at(m: *model.Assembler, rd: *core_syntax.Reader) res[u16, diagnostic.Diagnostic] {
    read.skip(rd);
    val at: usize                                       = rd.at;
    val v:  res[model.Argument, diagnostic.Diagnostic] = model.read_item(m, rd, model.REGISTER);
    if (sel v.err) { ret res[u16, diagnostic.Diagnostic].err{v.err}; }
    val got: model.Argument = v.ok;
    if (!sel got.register) { ret res[u16, diagnostic.Diagnostic].err{read.refuse(rd, NOT_A_REGISTER, at, rd.at - at)}; }
    val n: res[u16, build.Refusal] = cfi.number(model.builder(m), got.register);
    if (sel n.err) { ret res[u16, diagnostic.Diagnostic].err{read.refuse(rd, n.err.message, at, rd.at - at)}; }
    ret res[u16, diagnostic.Diagnostic].ok{n.ok};
}

# the constant number of bytes at the reader
fun bytes_at(rd: *core_syntax.Reader) res[i64, diagnostic.Diagnostic] {
    read.skip(rd);
    val at: usize                                 = rd.at;
    val e:  res[expr.Expr, diagnostic.Diagnostic] = expr.parse(rd, operand.NO_FIXUP);
    if (sel e.err)          { ret res[i64, diagnostic.Diagnostic].err{e.err}; }
    if (!sel e.ok.constant) { ret res[i64, diagnostic.Diagnostic].err{read.refuse(rd, model.NOT_CONSTANT, at, rd.at - at)}; }
    ret res[i64, diagnostic.Diagnostic].ok{e.ok.constant};
}

fun do_proc(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val rd: *core_syntax.Reader = args.reader;
    read.skip(rd);
    val name: res[View, diagnostic.Diagnostic] = model.symbol_name(m, rd);
    if (sel name.err) { ret err[diagnostic.Diagnostic].err{name.err}; }
    val e: err[diagnostic.Diagnostic] = ended(rd);
    if (sel e.err) { ret e; }
    val b:       *build.Builder        = model.builder(m);
    val machine: opt[seh.Machine]      = seh.machine_of(b.arch);
    if (sel machine.none) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, seh.NO_UNWIND)}; }
    val l: res[build.Label, str] = model.label_named(m, name.ok);
    if (sel l.err) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, l.err)}; }
    val here: opt[build.Label] = build.placed_here(b);
    if (sel here.none)             { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, NOT_HERE)}; }
    if (here.some.id != l.ok.id)   { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, NOT_HERE)}; }
    val done: err[diagnostic.Diagnostic] = built(args, cfi.start_proc(b, l.ok));
    if (sel done.err) { ret done; }
    val t: *Text = args.layer.context::*Text;
    t.site = opt[diagnostic.Position].some{args.statement.site};
    t.proc = seh.begin(machine.some);
    ret done;
}

fun do_endproc(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val done: err[diagnostic.Diagnostic] = built(args, cfi.end_proc(model.builder(m)));
    if (sel done.err) { ret done; }
    val t: *Text = args.layer.context::*Text;
    t.site = opt[diagnostic.Position].none{};
    ret done;
}

# `.seh_handler name, @except, @unwind`, the flags in either order
fun do_handler(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val rd: *core_syntax.Reader = args.reader;
    read.skip(rd);
    val name: res[View, diagnostic.Diagnostic] = model.symbol_name(m, rd);
    if (sel name.err) { ret err[diagnostic.Diagnostic].err{name.err}; }
    var except: bool = false;
    var unwind: bool = false;
    var n:      u32  = 0;
    for (n < 2) {
        val c: err[diagnostic.Diagnostic] = comma(rd);
        if (sel c.err) { ret c; }
        read.skip(rd);
        val at: usize = rd.at;
        if (!except && read.take(rd, "@except"))      { except = true; }
        or (!unwind && read.take(rd, "@unwind"))      { unwind = true; }
        or { ret err[diagnostic.Diagnostic].err{read.refuse(rd, HANDLER, at, read.token(rd, at))}; }
        n = n + 1;
    }
    val e: err[diagnostic.Diagnostic] = ended(rd);
    if (sel e.err) { ret e; }
    val l: res[build.Label, str] = model.label_named(m, name.ok);
    if (sel l.err) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, l.err)}; }
    ret built(args, cfi.personality(model.builder(m), l.ok, false));
}

# a code directive: the row of the procedure's machine of its name, read by its operands
fun do_code(m: *model.Assembler, args: *model.Args) err[diagnostic.Diagnostic] {
    val t: *Text = args.layer.context::*Text;
    if (sel t.site.none) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, NO_PROC)}; }
    val d: opt[*seh.Directive] = seh.named(t.proc.machine, args.directive.name);
    if (sel d.none) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, OTHER)}; }
    val rd:      *core_syntax.Reader = args.reader;
    var reg:     u16                 = seh.NONE;
    var n:       i64                 = 0;
    var at_code: bool                = false;
    val shape:   seh.Operands        = d.some.operands;
    if (sel shape.register || sel shape.both) {
        val r: res[u16, diagnostic.Diagnostic] = register_at(m, rd);
        if (sel r.err) { ret err[diagnostic.Diagnostic].err{r.err}; }
        reg = r.ok;
    }
    if (sel shape.both) {
        val c: err[diagnostic.Diagnostic] = comma(rd);
        if (sel c.err) { ret c; }
    }
    if (sel shape.bytes || sel shape.both) {
        val k: res[i64, diagnostic.Diagnostic] = bytes_at(rd);
        if (sel k.err) { ret err[diagnostic.Diagnostic].err{k.err}; }
        n = k.ok;
    }
    if (sel shape.code) {
        read.skip(rd);
        at_code = read.take(rd, "@code");
    }
    val e: err[diagnostic.Diagnostic] = ended(rd);
    if (sel e.err) { ret e; }
    val code: opt[seh.Code] = seh.code_of(d.some, reg, n, at_code);
    if (sel code.none) { ret err[diagnostic.Diagnostic].err{model.refuse(args, 0, UNFIT)}; }
    ret built(args, seh.state(model.builder(m), ?t.proc, code.some));
}

# the rows (llvm X86AsmParser.cpp and AArch64AsmParser.cpp), one per name of `masc.emit.seh.DIRECTIVES`
val ROW_COUNT: u32 = 25;
val ROWS: [25]model.Directive = [25]model.Directive{
    model.Directive{name: ".seh_proc", operands: model.TEXT, handler: do_proc, param: 0},
    model.Directive{name: ".seh_endproc", operands: model.NO_ITEMS, handler: do_endproc, param: 0},
    model.Directive{name: ".seh_handler", operands: model.TEXT, handler: do_handler, param: 0},
    model.Directive{name: ".seh_pushreg", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_stackalloc", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_setframe", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_savereg", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_savexmm", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_pushframe", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_endprologue", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_r19r20_x", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_fplr_x", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_fplr", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_lrpair", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_regp_x", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_regp", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_fregp_x", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_fregp", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_reg_x", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_reg", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_freg_x", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_save_freg", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_set_fp", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_add_fp", operands: model.TEXT, handler: do_code, param: 0},
    model.Directive{name: ".seh_nop", operands: model.TEXT, handler: do_code, param: 0},
};

fun finish(context: ptr, m: *model.Assembler) err[model.Refusal] {
    val t: *Text = context::*Text;
    if (sel t.site.none) { ret err[model.Refusal].ok{}; }
    val d: diagnostic.Span = diagnostic.Span{start: t.site.some, len: 0};
    ret err[model.Refusal].err{model.Refusal{message: NEVER_ENDED, span: d, site: t.site.some}};
}

# the state of a layer over an object, no procedure open
pub fun make() Text {
    ret Text{site: opt[diagnostic.Position].none{}, proc: seh.begin(seh.Machine.x64{})};
}

# the layer of the windows unwind rows over the state `t`, which the caller keeps as long as the assembler
pub fun layer(t: *Text) model.Layer {
    ret model.Layer{name: "seh", directives: model.Directives{at: ?ROWS[0], len: ROW_COUNT}, context: t::ptr, finish: finish};
}
