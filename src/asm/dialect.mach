# the assembly dialect of each object format, the one format fact masc owns
#
# masc builds mink's neutral object and never a format of its own, and a
# format's facts are mink's, but for one: the spelling that starts the names
# an assembler keeps out of the format's symbol table, as elf's `.L`, which is
# the assembly dialect's and not the format's. the assembler is given it, the
# builder listing reads it to name labels the assembler reads back alike, and
# the command line takes it from the format it writes.

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink;

# the assembly dialect of a format
# ---
# format:  the format
# private: the spelling that starts the names an assembler keeps out of its symbol table
pub rec Dialect {
    format:  *mink.format.Format;
    private: str;
}

# the gnu assembler's local symbol names (as manual, "Symbol Names"): `.L` on elf
val DIALECT_COUNT: usize                  = 1;
val DIALECTS:      [DIALECT_COUNT]Dialect = [DIALECT_COUNT]Dialect{
    Dialect{format: ?mink.format.ELF, private: ".L"},
};

# the private spelling of names in `f`, none for a format whose dialect masc does not state
pub fun private_of(f: *mink.format.Format) opt[str] {
    var i: usize = 0;
    for (i < DIALECT_COUNT) {
        if (DIALECTS[i].format == f) { ret opt[str].some{DIALECTS[i].private}; }
        i = i + 1;
    }
    ret opt[str].none{};
}
