# the assembly source model: statements read into a builder through a table of directives
#
# the assembler reads statements from a feed and writes them through one
# `masc.build` builder, which owns the sections, labels, layout and
# relocations. what it keeps of its own is what only the source states: the
# facts the directives declare of each symbol, indexed by the builder's
# label, the numbered labels by number, the section stack, and the
# directives by name. a label and an instruction are read here, and every
# directive is a row of a name, the syntax of its operands and a handler, in
# a layer of rows: the core rows, the set's own rows, and any the caller
# adds. the rows are indexed once, and a name two layers state is refused, so
# adding a directive is adding a row and never an edit here.
#
# the set's own rows are its integer data directives and one row per name
# of its dialect's directives (`masc.core.source`), which reads the word that
# chooses among the dialect's rows of that name and does what that row's edit
# states. the selection a restatement states, the narrowings and state in
# force over it, their stack and the views they make are the assembler's, and
# the builder is told the view and syntax each statement after them is
# written under, which the instructions are read under as well.
#
# a name in an expression resolves through the builder's labels: `.` is the
# place the operand is written, `1b` and `1f` are the nearest numbered label
# before and after, and a name `.set` or `.equ` equates stands for its value.
# a difference of labels is the builder's to measure. assembly stops at the
# first refusal, and the refusal is the assembler's result: nothing it read
# is handed on.
#
# at the end, every name the source holds becomes a symbol: with the binding
# a directive declared, local when it is defined, and another object's when
# it is only referred to. a name in the private spelling of the object's format, as elf's `.L`, stays out of
# the symbol table unless declared otherwise.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.map;
use std.collections.sort;
use std.collections.vector;

use mink.base.fail;
use mink.base.store;
use mink.catalog.arch;
use mink.catalog.trait;
use mink.format.contract;
use mink.format.registry;
use mink_group:  mink.model.group;
use mink_object: mink.model.object;
use mink_symbol: mink.model.symbol;

use masc.asm.source;
use masc.build.build;
use masc.codec.narrow;
use masc.core.diagnostic;
use masc.core.extension;
use masc.core.field;
use masc.core.fixup;
use masc.core.inst;
use masc.core.mode;
use masc.core.operand;
use masc.core.register;
use masc.core.relax;
use masc.core.requirement;
use masc.core.set;
use core_source: masc.core.source;
use masc.core.state;
use masc.core.syntax;
use masc.format.dialect;
use masc.syntax.expr;
use spell: masc.syntax.name;
use masc.syntax.parse;
use masc.syntax.read;

use std.math.ieee;
use number: std.text.parse;

pub val UNKNOWN_DIRECTIVE: str = "unknown directive";
pub val DUPLICATE:         str = "directive stated by two rows";
pub val NO_SYNTAX:         str = "no syntax of the set at this index";
pub val NOT_CONSTANT:      str = "expression is not a constant";
pub val SPECIFIED:         str = "a specifier has no meaning here";
pub val RANGE:             str = "value out of range of its width";
pub val TWO_BINDINGS:      str = "symbol given two bindings";
pub val TWO_VISIBILITIES:  str = "symbol given two visibilities";
pub val TWO_TYPES:         str = "symbol given two types";
pub val FIXED:             str = "symbol defined by .equ cannot be redefined";
pub val LABELLED:          str = "symbol already defined as a label";
pub val EQUATED:           str = "label already equated to a value";
pub val NO_BEFORE:         str = "numbered label not defined before this reference";
pub val NEVER_AFTER:       str = "numbered label never defined after this reference";
pub val LOCAL_UNDEFINED:   str = "local symbol never defined";
pub val LATE_DIFFERENCE:   str = "symbol referred to before it is equated to a difference of labels";
pub val SHOWN_DIFFERENCE:  str = "symbol equated to a difference of labels is not a symbol of the object";
pub val CHANGED:           str = "section given other attributes than it was opened with";
pub val EMPTY_STACK:       str = "section stack is empty";
pub val NO_PREVIOUS:       str = "no previous section";
pub val NOT_A_NAME:        str = "expected a symbol name";
pub val NOT_A_STRING:      str = "expected a string";
pub val NOT_A_NUMBER:      str = "expected a number";
pub val MODE_TWICE:        str = "assembler mode stated twice";
pub val UNKNOWN_FORM:      str = "the dialect states no such form";
pub val NOTHING_PUSHED:    str = "no narrowing pushed to pop";
pub val UNKNOWN_EXTENSION: str = "not an extension of the set";
pub val NOT_AN_EDIT:       str = "expected an extension after `+` or `-`";
pub val STILL_IMPLIED:     str = "another extension the selection holds implies it";
pub val CONFLICTING:       str = "holds two extensions that cannot be held together";
pub val EXPECTED_COMMA:    str = "expected a comma";
pub val UNKNOWN_TAG:       str = "not an attribute tag the object's format encodes an axis of the architecture as";
pub val TAG_VALUE:         str = "value the object's format maps to no setting of the attribute tag's trait";
pub val OTHER_SELECTION:   str = "names another selection than the object's, which owns it";
pub val LENGTH_MISMATCH:   str = "encoding whose low bits state another instruction length";
pub val RESERVED_LENGTH:   str = "encoding whose low bits state a length no raw form takes";
pub val UNMET_FULL:        str = "the refusal needs more extensions than it can name";
pub val STATE_STATED:      str = "states two values of one state axis, or one no axis takes";
pub val EMPTY_QUANTITY:    str = "bounds a quantity of the register file to no value";

# the handle `.` resolves to, which every operand binds to the place it is written before the builder sees it
pub val HERE: u32 = syntax.HERE;

# what one operand of a directive is
# ---
# NAME:       a symbol name
# EXPRESSION: an expression
# STRING:     a string in quotes, its escapes read
# REGISTER:   a register of the set, by its syntax's names
# WORD:       a name after any of the set's type prefixes, as `@function`
# FLOAT:      a floating point literal (`float_literal`)
pub def Item: u8;

pub val NAME:       Item = 0;
pub val EXPRESSION: Item = 1;
pub val STRING:     Item = 2;
pub val REGISTER:   Item = 3;
pub val WORD:       Item = 4;
pub val FLOAT:      Item = 5;

# the syntax of a directive's operands, items separated by commas
# ---
# items:  each operand's kind in order
# len:    how many kinds
# least:  how many operands must be present, those after them optional, and any of them empty when it is not one of these
# repeat: whether the last kind repeats, as a list of values
# text:   whether the handler reads its operands itself, from the reader, and the items say nothing
pub rec Shape {
    items:  *Item;
    len:    u32;
    least:  u32;
    repeat: bool;
    text:   bool;
}

# one operand read
# ---
# absent:     an empty operand
# name:       a name
# expression: an expression, its `.` still HERE
# string:     a string's bytes
# register:   a register
# word:       a word, its prefix left out
# float:      a floating point literal, rounded once its width is known
pub tag Argument: u8 {
    absent;
    name:       View;
    expression: expr.Expr;
    string:     View;
    register:   register.Id;
    word:       View;
    float:      Float;
}

# what a floating point literal spells
# ---
# decimal:  digits with an optional point and an optional `e` exponent
# hex:      a hexadecimal float, `0x` then hex digits with an optional point, then a `p` exponent
# infinity: `inf` or `infinity`, in any case
# nan:      `nan`, in any case
pub tag FloatForm: u8 {
    decimal;
    hex;
    infinity;
    nan;
}

# a floating point literal as read, its rounding left to the width the directive writes
# ---
# text:     the literal, its sign included and a decimal's exponent letter with no digits left out
# form:     what it spells
# negative: whether it is signed `-`
pub rec Float {
    text:     View;
    form:     FloatForm;
    negative: bool;
}

# an operand and the text it was read from
pub rec Operand {
    at:    usize;
    len:   usize;
    value: Argument;
}

# what a handler is handed
# ---
# directive: its row
# layer:     the layer of the row
# statement: the statement
# reader:    a reader over the operands, at their end once read or at their start for a row that reads them itself
# items:     the operands read
# count:     how many
pub rec Args {
    directive: *Directive;
    layer:     *Layer;
    statement: *source.Statement;
    reader:    *syntax.Reader;
    items:     *Operand;
    count:     u32;
}

# a directive's row
# ---
# name:     its name, its dot included, read without regard to ascii case
# operands: the syntax of its operands
# handler:  what it does, or the refusal of its operands at their column
# param:    a number the handler reads, as a data directive's width
pub rec Directive {
    name:     str;
    operands: Shape;
    handler:  fun(*Assembler, *Args) err[diagnostic.Diagnostic];
    param:    u64;
}

# directive rows as a pointer to rows and a count
pub rec Directives {
    at:  *Directive;
    len: u32;
}

# a layer of directives, as the core set, call frame information or line numbers
# ---
# name:       what it is
# directives: its rows
# context:    its state, which its handlers reach through their args
# finish:     what it writes once every statement is read, as a layer of call frame information writes its tables
pub rec Layer {
    name:       str;
    directives: Directives;
    context:    ptr;
    finish:     fun(ptr, *Assembler) err[Refusal];
}

# layers as a pointer to layer pointers and a count
pub rec Layers {
    at:  **Layer;
    len: u32;
}

# no layers beyond the assembler's own
pub val NO_LAYERS: Layers = Layers{at: nil, len: 0};

# the finish of a layer that writes nothing at the end
pub fun finished(context: ptr, a: *Assembler) err[Refusal] {
    ret err[Refusal].ok{};
}

# what the assembler is asked to make
# ---
# arch:    the architecture of the object
# formats: the format registry the object's format facts are read from, borrowed for the assembly
# syntax:  the index of the set's syntax the instructions are read in
# abi:     the architecture's abi row, the object's conventions, as `-mabi=lp64d` names riscv64's float abi, nil for an
#          architecture with none
# dialect: the assembly dialect of the object's format for the architecture, the format the object is built for, whose
#          private spelling starts the names the format keeps out of its symbol table, as elf's `.L`, and whose word keeps
#          a section apart from others of its name
# layers:  the directive layers beyond the core rows and the set's data rows
# modes:   the assembler modes the source starts at, as `--pic` states, each mode at most once and every other at its
#          initial value
pub rec Options {
    arch:    *arch.Arch;
    formats: *registry.Registry;
    syntax:  u32;
    abi:     *arch.Abi;
    dialect: *dialect.Dialect;
    layers:  Layers;
    modes:   mode.Settings;
}

# why assembly stopped, which outlives the assembler and so holds nothing of it
# ---
# message: the wording
# span:    the text refused
# site:    where the file being assembled states it, for a refusal in an expansion
# mode:    the architecture and what of its entry the object's context lacks, when it does not enter it
# unmet:   what the refused statement needed that the context in force where it was refused lacked
# cause:   mink's refusal, when the object or its format refused what the source stated, as a property note's bit no
#          trait row maps, which it names
pub rec Refusal {
    message: str;
    span:    diagnostic.Span;
    site:    diagnostic.Position;
    mode:    opt[build.Mismatch];
    unmet:   state.Unmet;
    cause:   opt[fail.Fail];
}

# what the source declared of one label
# ---
# binding:    the binding a directive declared
# visibility: the visibility a directive declared
# kind:       the type `.type` declared
# size:       the size `.size` declared
# equated:    the value `.set` or `.equ` gave it
# fixed:      whether `.equ` gave it, so nothing may redefine it
# used:       where a statement first referred to it by its handle
pub rec Facts {
    binding:    opt[*mink_symbol.Binding];
    visibility: opt[*mink_symbol.Visibility];
    kind:       opt[*mink_symbol.Kind];
    size:       build.Size;
    equated:    opt[expr.Expr];
    fixed:      bool;
    used:       opt[diagnostic.Position];
}

# a numbered label's state: the label `nb` names, and the label `nf` names until the next definition places it
rec Numbered {
    last: opt[build.Label];
    next: opt[build.Label];
}

# a saved section state of the section stack
rec Frame {
    current:  opt[build.Section];
    previous: opt[build.Section];
}

# a section opened apart from others of its name, re-entered by its name and its keys: the number it was opened with,
# the signature of the group it is in and the section it is ordered after, the last two the builder's
# ---
# unique: the number, none for a section only its group or owner keeps apart
rec Apart {
    unique:  opt[u64];
    section: build.Section;
}

# a directive by name
rec Entry {
    directive: *Directive;
    layer:     *Layer;
}

# what the dialect's push saves of the statement state, which its pop restores. a narrowing and a mode stay apart: a
# narrowing changes what the selection admits, a mode what the spellings and rows read
# ---
# basis:  the selection the narrowings narrow
# active: the narrowings in force
# values: the state in force
# modes:  the assembler modes
# syntax: the syntax statements are read in
rec Saved {
    basis:  *Basis;
    active: u64;
    values: state.Settings;
    modes:  mode.State;
    syntax: u32;
}

# the view of the narrowings `active` marks at the state `values`, made the first time they are in force, at the
# statement `site` the file being assembled states
rec Kept {
    active: u64;
    values: state.Settings;
    view:   *narrow.Narrowed;
    site:   diagnostic.Position;
}

# a selection the narrowings in force narrow: the object's, or one a restatement states. it is held on the heap, so a
# saved state names it by pointer
# ---
# selection: the selection
# object:    whether it is the object's, whose view with no narrowing in force at the object's state is the object's own
# kept:      the view of each mask of narrowings and state that has been in force over it, at most one each, so the
#            scan of them is bounded by what the dialect's narrowings and state directives combine to
rec Basis {
    selection: extension.Selection;
    object:    bool;
    kept:      vector.Vector[Kept];
}

# the assembler of one object
# ---
# a:        the allocator
# set:      the instruction set
# object:   the object's context, the caller's selection at the state its architecture starts it at
# syntax:   the syntax instructions are read in
# written:  its index among the set's syntaxes
# dialect:  the assembly dialect of the object's format
# b:        the builder everything is written through
# layers:   every layer, the core first
# rows:     the set's own rows, made from its widths and its dialect's directives
# own:      the layer of those rows
# basis:    the selection the narrowings in force narrow
# active:   the narrowings in force, one bit per row of the dialect's directives
# values:   the state in force, the object's until a state directive sets an axis
# pushed:   the statement states saved by the dialect's push, the last on top
# site:     where the file being assembled states the statement being read, the start before the first
# bases:    every selection a statement state has narrowed, the object's first, each with its views, which outlive
#           the builder
# index:    every row by name, in ascending order of folded name
# facts:    per label, label id less one, what the source declared of it
# numbered: the numbered labels by number
# stack:    the section stack
# apart:    the sections opened apart from others of their name, by the number they were opened with
# previous: the section `.previous` returns to
# items:    the operands of the directive being read
# strings:  the bytes of its strings
# spelled:  a name copied to be handed to the builder
# names:    the symbols the syntax resolves names through
# stores:   what a statement is read into, its operand values, literal bytes and the requirements a refused
#           instruction names, grown to what the largest statement takes
pub rec Assembler {
    a:        *A.Allocator;
    set:      *set.Set;
    object:   *state.Context;
    syntax:   *syntax.Syntax;
    written:  u32;
    dialect:  *dialect.Dialect;
    b:        build.Builder;
    layers:   vector.Vector[*Layer];
    rows:     vector.Vector[Directive];
    own:      vector.Vector[Layer];
    basis:    *Basis;
    active:   u64;
    values:   state.Settings;
    pushed:   vector.Vector[Saved];
    site:     diagnostic.Position;
    bases:    vector.Vector[*Basis];
    index:    vector.Vector[Entry];
    facts:    vector.Vector[Facts];
    numbered: map.Map[u64, Numbered];
    stack:    vector.Vector[Frame];
    apart:    vector.Vector[Apart];
    previous: opt[build.Section];
    items:    vector.Vector[Operand];
    strings:  vector.Vector[u8];
    spelled:  vector.Vector[u8];
    names:    syntax.Symbols;
    stores:   syntax.Stores;
}

# a refusal of `message` at no place of the text
pub fun nowhere(message: str) Refusal {
    ret Refusal{message: message, span: diagnostic.Span{start: diagnostic.START, len: 0}, site: diagnostic.START, mode: opt[build.Mismatch].none{}, unmet: state.nothing_unmet()};
}

# the builder's refusal `b`, with the modes it names when it refuses a selection
pub fun refused_build(b: build.Refusal) Refusal {
    var r: Refusal = nowhere(b.message);
    r.mode  = b.mode;
    r.cause = b.object;
    ret r;
}

fun at_position(message: str, p: diagnostic.Position, len: usize) diagnostic.Diagnostic {
    ret diagnostic.Diagnostic{message: message, span: diagnostic.Span{start: p, len: len}, requires: requirement.NO_ALTERNATIVES};
}

fun held(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# `c` in lower case when it is an ascii capital
fun lower(c: u8) u8 {
    ret syntax.lower(c);
}

# how name `a` orders against `b`, without regard to ascii case
fun order(a: View, b: View) i64 {
    var i: usize = 0;
    for (i < a.len && i < b.len) {
        val x: u8 = lower(a.data[i]);
        val y: u8 = lower(b.data[i]);
        if (x < y) { ret -1; }
        if (x > y) { ret 1; }
        i = i + 1;
    }
    if (a.len < b.len) { ret -1; }
    if (a.len > b.len) { ret 1; }
    ret 0;
}

fun named(s: str) View {
    ret View{data: s, len: str_len(s)};
}

fun by_name(x: *Entry, y: *Entry) i64 {
    ret order(named(x.directive.name), named(y.directive.name));
}

# how the object's format names sections, whose conventions a section the source opens takes
pub fun naming(m: *Assembler) *contract.Naming {
    ret build.naming(?m.b);
}

# an assembler of an object for `options.arch` over `s`, under the selection `available` views, reading the rows of
# `core`, a row per integer data directive of the set handled by `integers`, a row per directive of the dialect that
# enters a section by its own name handled by `entering`, its index in the dialect's the row's parameter, and the caller's
# layers
pub fun make(a: *A.Allocator, s: *set.Set, object: *state.Context, options: Options, core: *Layer, integers: fun(*Assembler, *Args) err[diagnostic.Diagnostic], entering: fun(*Assembler, *Args) err[diagnostic.Diagnostic]) res[Assembler, Refusal] {
    if (options.syntax >= s.syntaxes.len) { ret res[Assembler, Refusal].err{nowhere(NO_SYNTAX)}; }
    val built: res[build.Builder, build.Refusal] = build.make(a, options.formats, s, object, options.arch, options.dialect.format);
    if (sel built.err) { ret res[Assembler, Refusal].err{refused_build(built.err)}; }
    var b:     build.Builder      = built.ok;
    val named: err[build.Refusal] = build.traits(?b, options.abi);
    if (sel named.err) {
        build.release(?b);
        ret res[Assembler, Refusal].err{refused_build(named.err)};
    }
    var n: u32 = 0;
    for (n < options.modes.len) {
        var j: u32 = 0;
        for (j < n) {
            if (options.modes.at[j].mode == options.modes.at[n].mode) {
                build.release(?b);
                ret res[Assembler, Refusal].err{nowhere(MODE_TWICE)};
            }
            j = j + 1;
        }
        val started: err[build.Refusal] = build.set_mode(?b, options.modes.at[n]);
        if (sel started.err) {
            build.release(?b);
            ret res[Assembler, Refusal].err{refused_build(started.err)};
        }
        n = n + 1;
    }
    var m: Assembler = Assembler{
        a:        a,
        set:      s,
        object:   object,
        syntax:   ?s.syntaxes.at[options.syntax],
        written:  options.syntax,
        dialect:  options.dialect,
        b:        b,
        layers:   vector.init[*Layer](a),
        rows:     vector.init[Directive](a),
        own:      vector.init[Layer](a),
        basis:    nil,
        active:   0,
        values:   object.values,
        pushed:   vector.init[Saved](a),
        site:     diagnostic.START,
        bases:    vector.init[*Basis](a),
        index:    vector.init[Entry](a),
        facts:    vector.init[Facts](a),
        numbered: map.init[u64, Numbered](a),
        stack:    vector.init[Frame](a),
        apart:    vector.init[Apart](a),
        previous: opt[build.Section].none{},
        items:    vector.init[Operand](a),
        strings:  vector.init[u8](a),
        spelled:  vector.init[u8](a),
        names:    syntax.Symbols{context: nil, resolve: resolve, name: name_of},
        stores:   syntax.stores(a),
    };
    val widths:     core_source.Widths     = s.source.widths;
    val directives: core_source.Directives = s.source.directives;
    val sections:   *dialect.Sections      = options.dialect.sections;
    var ok:         bool                   = held(vector.reserve[Directive](?m.rows, widths.len::usize + directives.len::usize + sections.named.len::usize)) && held(vector.reserve[Layer](?m.own, 1));
    if (ok) {
        val copied: res[extension.Selection, A.Error] = extension.copy(a, object.selection);
        ok = false;
        if (sel copied.ok) {
            val object: res[*Basis, str] = based(?m, copied.ok, true);
            if (sel object.ok) {
                m.basis = object.ok;
                ok      = true;
            }
        }
    }
    var i: u32 = 0;
    for (ok && i < widths.len) {
        vector.push[Directive](?m.rows, Directive{name: widths.at[i].name, operands: EXPRESSIONS, handler: integers, param: widths.at[i].width::u64});
        i = i + 1;
    }
    i = 0;
    for (ok && i < sections.named.len) {
        vector.push[Directive](?m.rows, Directive{name: sections.named.at[i].directive, operands: NO_ITEMS, handler: entering, param: i::u64});
        i = i + 1;
    }
    i = 0;
    for (ok && i < directives.len) {
        if (first_of_name(directives, i)) { vector.push[Directive](?m.rows, Directive{name: directives.at[i].name, operands: TEXT, handler: dialect_directive, param: i::u64}); }
        i = i + 1;
    }
    if (ok) {
        vector.push[Layer](?m.own, Layer{name: "set", directives: Directives{at: m.rows.data, len: m.rows.len::u32}, context: nil, finish: finished});
        ok = held(vector.push[*Layer](?m.layers, core)) && held(vector.push[*Layer](?m.layers, ?m.own.data[0]));
    }
    i = 0;
    for (ok && i < options.layers.len) {
        ok = held(vector.push[*Layer](?m.layers, options.layers.at[i]));
        i  = i + 1;
    }
    var k: usize = 0;
    for (ok && k < m.layers.len) {
        val l: *Layer = m.layers.data[k];
        var j: u32    = 0;
        for (ok && j < l.directives.len) {
            ok = held(vector.push[Entry](?m.index, Entry{directive: ?l.directives.at[j], layer: l}));
            j  = j + 1;
        }
        k = k + 1;
    }
    if (!ok) {
        release(?m);
        ret res[Assembler, Refusal].err{nowhere(field.MEMORY)};
    }
    sort.sort_by[Entry](m.index.data, m.index.len, by_name);
    k = 1;
    for (k < m.index.len) {
        if (by_name(?m.index.data[k - 1], ?m.index.data[k]) == 0) {
            release(?m);
            ret res[Assembler, Refusal].err{nowhere(DUPLICATE)};
        }
        k = k + 1;
    }
    ret res[Assembler, Refusal].ok{m};
}

# give back everything the assembler owns, the builder with it and then the views it wrote under
pub fun release(m: *Assembler) {
    build.release(?m.b);
    var i: usize = 0;
    for (i < m.bases.len) {
        val basis: *Basis = m.bases.data[i];
        var k:     usize  = 0;
        for (k < basis.kept.len) {
            narrow.release(m.a, basis.kept.data[k].view);
            k = k + 1;
        }
        vector.dnit[Kept](?basis.kept);
        extension.release(?basis.selection);
        A.deallocate[Basis](m.a, basis, 1);
        i = i + 1;
    }
    vector.dnit[*Basis](?m.bases);
    vector.dnit[Saved](?m.pushed);
    vector.dnit[*Layer](?m.layers);
    vector.dnit[Directive](?m.rows);
    vector.dnit[Layer](?m.own);
    vector.dnit[Entry](?m.index);
    vector.dnit[Facts](?m.facts);
    map.dnit[u64, Numbered](?m.numbered);
    vector.dnit[Frame](?m.stack);
    vector.dnit[Apart](?m.apart);
    vector.dnit[Operand](?m.items);
    vector.dnit[u8](?m.strings);
    vector.dnit[u8](?m.spelled);
    syntax.release(?m.stores);
}

# the builder the assembler writes through, for a layer's handlers
pub fun builder(m: *Assembler) *build.Builder {
    ret ?m.b;
}

# the row named `name`, a binary search of the index, none when no row has it
fun find(m: *Assembler, name: View) opt[*Entry] {
    var lo: usize = 0;
    var hi: usize = m.index.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val c:   i64   = order(named(m.index.data[mid].directive.name), name);
        if (c == 0) { ret opt[*Entry].some{?m.index.data[mid]}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret opt[*Entry].none{};
}

# the facts of label `l`, the table grown to hold it
fun facts_of(m: *Assembler, l: build.Label) res[*Facts, Refusal] {
    val need: usize = l.id::usize;
    if (m.facts.len < need) {
        if (!held(vector.reserve[Facts](?m.facts, need - m.facts.len))) { ret res[*Facts, Refusal].err{nowhere(field.MEMORY)}; }
        for (m.facts.len < need) {
            m.facts.data[m.facts.len] = Facts{};
            vector.commit[Facts](?m.facts, 1);
        }
    }
    ret res[*Facts, Refusal].ok{?m.facts.data[need - 1]};
}

# what the source declared of label `l`, nothing when it declared nothing
fun declared(m: *Assembler, id: u32) Facts {
    if (id == operand.NO_SYMBOL || id::usize > m.facts.len) { ret Facts{}; }
    ret m.facts.data[id::usize - 1];
}

# `v` with a nul after it, as the builder takes a name
fun spelled(m: *Assembler, v: View) res[str, str] {
    vector.truncate[u8](?m.spelled, 0);
    if (!held(vector.reserve[u8](?m.spelled, v.len + 1))) { ret res[str, str].err{field.MEMORY}; }
    var i: usize = 0;
    for (i < v.len) {
        m.spelled.data[i] = v.data[i];
        i                 = i + 1;
    }
    m.spelled.data[v.len] = 0;
    vector.truncate[u8](?m.spelled, 0);
    vector.commit[u8](?m.spelled, v.len + 1);
    ret res[str, str].ok{m.spelled.data};
}

# the label named `v`, made when it is new
pub fun label_named(m: *Assembler, v: View) res[build.Label, str] {
    val text: res[str, str] = spelled(m, v);
    if (sel text.err) { ret res[build.Label, str].err{text.err}; }
    val l: res[build.Label, build.Refusal] = build.label(?m.b, text.ok);
    if (sel l.err) { ret res[build.Label, str].err{l.err.message}; }
    ret res[build.Label, str].ok{l.ok};
}

# whether the `len` bytes of `v` are a numbered label's reference, its number into `n` and whether it looks back into `back`
fun numbered_reference(v: View, n: *u64, back: *bool) bool {
    if (v.len < 2) { ret false; }
    val last: u8 = v.data[v.len - 1];
    if (last != 'b' && last != 'f') { ret false; }
    var value: u64   = 0;
    var i:     usize = 0;
    for (i < v.len - 1) {
        val c: u8 = v.data[i];
        if (c < '0' || c > '9')         { ret false; }
        if (value > (~0::u64 - 9) / 10) { ret false; }
        value = value * 10 + (c - '0')::u64;
        i     = i + 1;
    }
    @n    = value;
    @back = last == 'b';
    ret true;
}

# the number a numbered label's definition spells, none when `v` is not all digits
fun number_of(v: View) opt[u64] {
    var value: u64   = 0;
    var i:     usize = 0;
    for (i < v.len) {
        val c: u8 = v.data[i];
        if (c < '0' || c > '9')         { ret opt[u64].none{}; }
        if (value > (~0::u64 - 9) / 10) { ret opt[u64].none{}; }
        value = value * 10 + (c - '0')::u64;
        i     = i + 1;
    }
    ret opt[u64].some{value};
}

# the state of numbered label `n`, made when it is new
fun numbered_state(m: *Assembler, n: u64) res[*Numbered, str] {
    var key: u64            = n;
    val got: opt[*Numbered] = map.get[u64, Numbered](?m.numbered, ?key);
    if (sel got.some) { ret res[*Numbered, str].ok{got.some}; }
    val put: res[bool, A.Error] = map.insert[u64, Numbered](?m.numbered, n, Numbered{last: opt[build.Label].none{}, next: opt[build.Label].none{}});
    if (sel put.err) { ret res[*Numbered, str].err{field.MEMORY}; }
    val made: opt[*Numbered] = map.get[u64, Numbered](?m.numbered, ?key);
    if (sel made.none) { ret res[*Numbered, str].err{field.MEMORY}; }
    ret res[*Numbered, str].ok{made.some};
}

# what an equated value stands for in an expression
fun stands_for(e: expr.Expr) syntax.Resolved {
    if (sel e.constant)   { ret syntax.Resolved.constant{e.constant}; }
    if (sel e.symbol)     { ret syntax.Resolved.equated{syntax.Equated{plus: e.symbol.id, minus: operand.NO_SYMBOL, addend: e.symbol.addend}}; }
    if (sel e.difference) { ret syntax.Resolved.equated{syntax.Equated{plus: e.difference.plus, minus: e.difference.minus, addend: e.difference.addend}}; }
    ret syntax.Resolved.constant{0};
}

# a name in an operand: `.` or a numbered label's reference when it is bare, or else a label, standing for what `.set`
# equated it to. a quoted name is always the label of exactly its bytes
fun resolve(context: ptr, name: View, spelling: syntax.Spelling) res[syntax.Resolved, str] {
    val m:    *Assembler = context::*Assembler;
    val bare: bool       = sel spelling.bare;
    if (bare && name.len == 1 && name.data[0] == '.') { ret res[syntax.Resolved, str].ok{syntax.Resolved.symbol{HERE}}; }
    var n:    u64  = 0;
    var back: bool = false;
    if (bare && numbered_reference(name, ?n, ?back)) {
        val state: res[*Numbered, str] = numbered_state(m, n);
        if (sel state.err) { ret res[syntax.Resolved, str].err{state.err}; }
        val st: *Numbered = state.ok;
        if (back) {
            if (sel st.last.none) { ret res[syntax.Resolved, str].err{NO_BEFORE}; }
            ret res[syntax.Resolved, str].ok{syntax.Resolved.symbol{st.last.some.id}};
        }
        var ahead: u32 = operand.NO_SYMBOL;
        if (sel st.next.some)           { ahead = st.next.some.id; }
        if (ahead != operand.NO_SYMBOL) { ret res[syntax.Resolved, str].ok{syntax.Resolved.symbol{ahead}}; }
        val made: res[build.Label, build.Refusal] = build.anonymous(?m.b);
        if (sel made.err) { ret res[syntax.Resolved, str].err{made.err.message}; }
        st.next = opt[build.Label].some{made.ok};
        ret res[syntax.Resolved, str].ok{syntax.Resolved.symbol{made.ok.id}};
    }
    val l: res[build.Label, str] = label_named(m, name);
    if (sel l.err) { ret res[syntax.Resolved, str].err{l.err}; }
    val f: Facts = declared(m, l.ok.id);
    if (sel f.equated.some) { ret res[syntax.Resolved, str].ok{stands_for(f.equated.some)}; }
    ret res[syntax.Resolved, str].ok{syntax.Resolved.symbol{l.ok.id}};
}

fun name_of(context: ptr, id: u32) View {
    val m:   *Assembler = context::*Assembler;
    val own: opt[View]  = build.label_name(?m.b, build.Label{id: id});
    if (sel own.some) { ret own.some; }
    ret View{data: "", len: 0};
}

# a new label placed at the cursor, which `.` names where an operand is written
pub fun here(m: *Assembler) res[build.Label, str] {
    val made: res[build.Label, build.Refusal] = build.anonymous(?m.b);
    if (sel made.err) { ret res[build.Label, str].err{made.err.message}; }
    val placed: err[build.Refusal] = build.define(?m.b, made.ok);
    if (sel placed.err) { ret res[build.Label, str].err{placed.err.message}; }
    ret res[build.Label, str].ok{made.ok};
}

# label `id` noted as referred to at `at`, the first reference kept
fun note(m: *Assembler, id: u32, at: diagnostic.Position) err[str] {
    if (id == operand.NO_SYMBOL || id == HERE) { ret err[str].ok{}; }
    val f: res[*Facts, Refusal] = facts_of(m, build.Label{id: id});
    if (sel f.err) { ret err[str].err{field.MEMORY}; }
    val first: bool = sel f.ok.used.none;
    if (first) { f.ok.used = opt[diagnostic.Position].some{at}; }
    ret err[str].ok{};
}

# `id` with HERE bound to `here`, a label made at the cursor the first time it is needed
fun bound_here(m: *Assembler, id: u32, here_: *u32) res[u32, str] {
    if (id != HERE) { ret res[u32, str].ok{id}; }
    if (@here_ == operand.NO_SYMBOL) {
        val l: res[build.Label, str] = here(m);
        if (sel l.err) { ret res[u32, str].err{l.err}; }
        @here_ = l.ok.id;
    }
    ret res[u32, str].ok{@here_};
}

# the labels one statement's operands bind at its place, operand.NO_SYMBOL until one is needed
# ---
# here: the label `.` names
# own:  the label a sequence's part names at its first instruction, spelled by the syntax's own stem
rec Places {
    here: u32;
    own:  u32;
}

# `id` with HERE and syntax.OWN bound to labels at the cursor, each made the first time it is needed
fun bound_at(m: *Assembler, id: u32, p: *Places) res[u32, str] {
    if (id != syntax.OWN) { ret bound_here(m, id, ?p.here); }
    if (p.own == operand.NO_SYMBOL) {
        val made: res[build.Label, build.Refusal] = build.stemmed(?m.b, m.syntax.own);
        if (sel made.err) { ret res[u32, str].err{made.err.message}; }
        val placed: err[build.Refusal] = build.define(?m.b, made.ok);
        if (sel placed.err) { ret res[u32, str].err{placed.err.message}; }
        p.own = made.ok.id;
    }
    ret res[u32, str].ok{p.own};
}

# `e` with `.` bound to the cursor and its labels noted as referred to at `at`
pub fun bind(m: *Assembler, e: *expr.Expr, at: diagnostic.Position) err[str] {
    var here_: u32 = operand.NO_SYMBOL;
    if (sel e.symbol) {
        val id: res[u32, str] = bound_here(m, e.symbol.id, ?here_);
        if (sel id.err) { ret err[str].err{id.err}; }
        e.symbol.id = id.ok;
        ret note(m, id.ok, at);
    }
    if (sel e.difference) {
        val plus: res[u32, str] = bound_here(m, e.difference.plus, ?here_);
        if (sel plus.err) { ret err[str].err{plus.err}; }
        val minus: res[u32, str] = bound_here(m, e.difference.minus, ?here_);
        if (sel minus.err) { ret err[str].err{minus.err}; }
        e.difference.plus  = plus.ok;
        e.difference.minus = minus.ok;
        val noted: err[str] = note(m, plus.ok, at);
        if (sel noted.err) { ret noted; }
        ret note(m, minus.ok, at);
    }
    ret err[str].ok{};
}

# a refusal of `message` at operand `k` of `args`, or at the operands' start when there is no such operand
pub fun refuse(args: *Args, k: u32, message: str) diagnostic.Diagnostic {
    if (k < args.count) { ret read.refuse(args.reader, message, args.items[k].at, args.items[k].len); }
    ret read.refuse(args.reader, message, args.reader.start, 0);
}

# the position of operand `k` of `args`
pub fun position(args: *Args, k: u32) diagnostic.Position {
    ret refuse(args, k, "").span.start;
}

# whether operand `k` of `args` is given
pub fun given(args: *Args, k: u32) bool {
    ret k < args.count && !sel args.items[k].value.absent;
}

# operand `k` of `args` as a constant
pub fun constant(args: *Args, k: u32) res[i64, diagnostic.Diagnostic] {
    if (k >= args.count) { ret res[i64, diagnostic.Diagnostic].err{refuse(args, k, read.EXPECTED)}; }
    val v: Argument = args.items[k].value;
    if (sel v.expression) {
        if (sel v.expression.constant) { ret res[i64, diagnostic.Diagnostic].ok{v.expression.constant}; }
    }
    ret res[i64, diagnostic.Diagnostic].err{refuse(args, k, NOT_CONSTANT)};
}

# operand `k` of `args` as a constant, `otherwise` when it is not given
pub fun constant_or(args: *Args, k: u32, otherwise: i64) res[i64, diagnostic.Diagnostic] {
    if (!given(args, k)) { ret res[i64, diagnostic.Diagnostic].ok{otherwise}; }
    ret constant(args, k);
}

# whether `v` fits `width` bytes, read as signed or unsigned
fun fits(v: i64, width: u64) bool {
    if (width >= 8) { ret true; }
    val half: i64 = 1::i64 << (width * 8 - 1)::i64;
    ret v >= -half && v < half * 2;
}

# a builder refusal as a diagnostic at operand `k`
fun wrote(args: *Args, k: u32, e: err[build.Refusal]) err[diagnostic.Diagnostic] {
    if (sel e.err) { ret err[diagnostic.Diagnostic].err{refuse(args, k, e.err.message)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# operand `k` of `args` written as a datum of `width` bytes: a constant in the set's byte order, a symbol's address,
# or a difference of labels, each `.` the place it is written
pub fun datum(m: *Assembler, args: *Args, k: u32, width: u64) err[diagnostic.Diagnostic] {
    if (k >= args.count) { ret err[diagnostic.Diagnostic].err{refuse(args, k, read.EXPECTED)}; }
    val v: Argument = args.items[k].value;
    if (!sel v.expression) { ret err[diagnostic.Diagnostic].err{refuse(args, k, NOT_CONSTANT)}; }
    var e: expr.Expr = v.expression;
    if (sel e.constant) {
        if (!fits(e.constant, width)) { ret err[diagnostic.Diagnostic].err{refuse(args, k, RANGE)}; }
        ret wrote(args, k, build.integer(?m.b, e.constant:~u64, width::u8));
    }
    val bound_: err[str] = bind(m, ?e, position(args, k));
    if (sel bound_.err) { ret err[diagnostic.Diagnostic].err{refuse(args, k, bound_.err)}; }
    if (sel e.symbol) {
        if (e.symbol.fixup != operand.NO_FIXUP) { ret err[diagnostic.Diagnostic].err{refuse(args, k, SPECIFIED)}; }
        ret wrote(args, k, build.datum(?m.b, build.Reference{target: build.Label{id: e.symbol.id}, addend: e.symbol.addend, width: width::u8, basis: fixup.ABSOLUTE}));
    }
    if (sel e.difference) {
        val d: build.Difference = build.Difference{plus: build.Label{id: e.difference.plus}, minus: build.Label{id: e.difference.minus}, addend: e.difference.addend};
        ret wrote(args, k, build.difference(?m.b, d, width::u8));
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the label operand `k` of `args` names
pub fun symbol(m: *Assembler, args: *Args, k: u32) res[build.Label, diagnostic.Diagnostic] {
    if (k >= args.count) { ret res[build.Label, diagnostic.Diagnostic].err{refuse(args, k, NOT_A_NAME)}; }
    val v: Argument = args.items[k].value;
    if (!sel v.name) { ret res[build.Label, diagnostic.Diagnostic].err{refuse(args, k, NOT_A_NAME)}; }
    val l: res[build.Label, str] = label_named(m, v.name);
    if (sel l.err) { ret res[build.Label, diagnostic.Diagnostic].err{refuse(args, k, l.err)}; }
    ret res[build.Label, diagnostic.Diagnostic].ok{l.ok};
}

# label `l` declared to bind as `binding`, refused when another binding was declared
pub fun declare_binding(m: *Assembler, l: build.Label, binding: *mink_symbol.Binding) err[str] {
    val f: res[*Facts, Refusal] = facts_of(m, l);
    if (sel f.err)                                             { ret err[str].err{field.MEMORY}; }
    if (sel f.ok.binding.some && f.ok.binding.some != binding) { ret err[str].err{TWO_BINDINGS}; }
    f.ok.binding = opt[*mink_symbol.Binding].some{binding};
    ret err[str].ok{};
}

# label `l` declared to be visible as `visibility`, refused when another visibility was declared
pub fun declare_visibility(m: *Assembler, l: build.Label, visibility: *mink_symbol.Visibility) err[str] {
    val f: res[*Facts, Refusal] = facts_of(m, l);
    if (sel f.err)                                                      { ret err[str].err{field.MEMORY}; }
    if (sel f.ok.visibility.some && f.ok.visibility.some != visibility) { ret err[str].err{TWO_VISIBILITIES}; }
    f.ok.visibility = opt[*mink_symbol.Visibility].some{visibility};
    ret err[str].ok{};
}

# label `l` declared to name a `kind`, refused when another type was declared
pub fun declare_kind(m: *Assembler, l: build.Label, kind: *mink_symbol.Kind) err[str] {
    val f: res[*Facts, Refusal] = facts_of(m, l);
    if (sel f.err)                                    { ret err[str].err{field.MEMORY}; }
    if (sel f.ok.kind.some && f.ok.kind.some != kind) { ret err[str].err{TWO_TYPES}; }
    f.ok.kind = opt[*mink_symbol.Kind].some{kind};
    ret err[str].ok{};
}

# label `l` declared to be `size` bytes
pub fun declare_size(m: *Assembler, l: build.Label, size: build.Size) err[str] {
    val f: res[*Facts, Refusal] = facts_of(m, l);
    if (sel f.err) { ret err[str].err{field.MEMORY}; }
    f.ok.size = size;
    ret err[str].ok{};
}

# the type declared of label `l`, none when no directive declared one
pub fun kind_declared(m: *Assembler, l: build.Label) opt[*mink_symbol.Kind] {
    ret declared(m, l.id).kind;
}

# the binding declared of label `l`, none when no directive declared one
pub fun binding_of(m: *Assembler, l: build.Label) opt[*mink_symbol.Binding] {
    ret declared(m, l.id).binding;
}

# label `l` equated to `e`, its `.` bound to the cursor: `.set` when `fixed` is false, which may redefine it, and `.equ`
# when true, which may not, and neither may redefine a label placed
pub fun equate(m: *Assembler, l: build.Label, e: expr.Expr, fixed: bool, at: diagnostic.Position) err[str] {
    if (build.bound(?m.b, l)) { ret err[str].err{LABELLED}; }
    val f: res[*Facts, Refusal] = facts_of(m, l);
    if (sel f.err)                      { ret err[str].err{field.MEMORY}; }
    if (f.ok.fixed)                     { ret err[str].err{FIXED}; }
    if (fixed && sel f.ok.equated.some) { ret err[str].err{FIXED}; }
    var v: expr.Expr = e;
    if (sel v.symbol) {
        if (v.symbol.fixup != operand.NO_FIXUP) { ret err[str].err{SPECIFIED}; }
    }
    val bound_: err[str] = bind(m, ?v, at);
    if (sel bound_.err) { ret bound_; }
    # the table may have grown while `.` was bound
    val g: res[*Facts, Refusal] = facts_of(m, l);
    if (sel g.err) { ret err[str].err{field.MEMORY}; }
    g.ok.equated = opt[expr.Expr].some{v};
    g.ok.fixed   = fixed;
    ret err[str].ok{};
}

# what keeps a section apart from the others of its name, each none for a section it does not
# ---
# unique: the number it is opened apart with, as elf's `unique, 1`
# group:  the signature of the comdat group it is in
# rule:   the rule that group keeps a copy by, read only with `group`
# owner:  the section it is ordered after, as an elf link-order section
pub rec Keys {
    unique: opt[u64];
    group:  opt[View];
    rule:   *mink_group.Rule;
    owner:  opt[build.Section];
}

# keys that keep a section apart by nothing
pub val NO_KEYS: Keys = Keys{unique: opt[u64].none{}, group: opt[View].none{}, rule: ?mink_group.ANY, owner: opt[build.Section].none{}};

# whether any of `k` keeps a section apart
fun keeps(k: Keys) bool {
    ret sel k.unique.some || sel k.group.some || sel k.owner.some;
}

# the section opened apart as `name` under keys `k`, none when no section was
fun apart_of(m: *Assembler, name: View, k: Keys) opt[build.Section] {
    var i: usize = 0;
    for (i < m.apart.len) {
        val a: *Apart = ?m.apart.data[i];
        i = i + 1;
        val o: build.Opened = build.opened(?m.b, a.section);
        if (!same_number(a.unique, k.unique) || !same_name(o.name, opt[View].some{name})) { cnt; }
        if (!same_name(build.group_of(?m.b, a.section), k.group))                         { cnt; }
        if (same_section(build.owner_of(?m.b, a.section), k.owner))                       { ret opt[build.Section].some{a.section}; }
    }
    ret opt[build.Section].none{};
}

fun same_section(a: opt[build.Section], b: opt[build.Section]) bool {
    if (sel a.some) {
        if (sel b.some) { ret a.some.index == b.some.index; }
        ret false;
    }
    ret sel b.none;
}

fun same_number(a: opt[u64], b: opt[u64]) bool {
    if (sel a.some) {
        if (sel b.some) { ret a.some == b.some; }
        ret false;
    }
    ret sel b.none;
}

fun same_name(a: opt[View], b: opt[View]) bool {
    if (sel a.some) {
        if (sel b.some) { ret same_view(a.some, b.some); }
        ret false;
    }
    ret sel b.none;
}

fun same_view(a: View, b: View) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the section named `name`, opened as `spec` when it is new and refused when `stated` and it was opened otherwise, made
# current with the section before it the previous. with `unique` it is the section of that name opened apart with that
# number, never the one the name alone enters
pub fun enter(m: *Assembler, name: View, spec: build.Spec, stated: bool, unique: opt[u64]) err[str] {
    var k: Keys = NO_KEYS;
    k.unique = unique;
    ret enter_kept(m, name, spec, stated, k);
}

# the section `enter` enters under keys `k`: the section of that name, number, comdat group and owner, never one that
# differs in any of them. a section any key keeps apart is never the one the name alone enters
pub fun enter_kept(m: *Assembler, name: View, spec: build.Spec, stated: bool, k: Keys) err[str] {
    val kept:  bool               = keeps(k);
    var found: opt[build.Section] = opt[build.Section].none{};
    if (kept) { found = apart_of(m, name, k); }
    or        { found = build.section_named(?m.b, name); }
    var s: build.Section = build.Section{index: 0};
    if (sel found.some) {
        if (stated && !build.matches(?m.b, found.some, ?spec)) { ret err[str].err{CHANGED}; }
        s = found.some;
    }
    or {
        val text: res[str, str] = spelled(m, name);
        if (sel text.err) { ret err[str].err{text.err}; }
        var named_: build.Spec = spec;
        named_.name  = opt[str].some{text.ok};
        named_.apart = kept;
        if (kept && !held(vector.reserve[Apart](?m.apart, 1))) { ret err[str].err{field.MEMORY}; }
        val opened: res[build.Section, build.Refusal] = build.open(?m.b, named_);
        if (sel opened.err) { ret err[str].err{opened.err.message}; }
        s = opened.ok;
        if (sel k.group.some) {
            val joined: err[build.Refusal] = build.join_by(?m.b, s, k.group.some, k.rule);
            if (sel joined.err) { ret err[str].err{joined.err.message}; }
        }
        if (sel k.owner.some) {
            val ordered: err[build.Refusal] = build.order(?m.b, s, k.owner.some);
            if (sel ordered.err) { ret err[str].err{ordered.err.message}; }
        }
        if (kept) { vector.push[Apart](?m.apart, Apart{unique: k.unique, section: s}); }
    }
    ret switch_to(m, s);
}

# the section a link-order section names by `name` to be ordered after: the section of the label of that name placed so
# far, else the first section of that name not kept apart, a symbol read before a section's name. none when neither
# is, as no symbol placed later is read
pub fun linked(m: *Assembler, name: View) opt[build.Section] {
    val placed: opt[build.Section] = build.placed_in(?m.b, name);
    if (sel placed.some) { ret placed; }
    ret build.section_named(?m.b, name);
}

# section `s` made current, the current one becoming the previous
pub fun switch_to(m: *Assembler, s: build.Section) err[str] {
    val was:      opt[build.Section] = build.current(?m.b);
    val switched: err[build.Refusal] = build.switch(?m.b, s);
    if (sel switched.err) { ret err[str].err{switched.err.message}; }
    if (sel was.some) {
        if (was.some.index != s.index) { m.previous = was; }
    }
    ret err[str].ok{};
}

# the current and previous sections pushed onto the section stack
pub fun push_section(m: *Assembler) err[str] {
    if (!held(vector.push[Frame](?m.stack, Frame{current: build.current(?m.b), previous: m.previous}))) { ret err[str].err{field.MEMORY}; }
    ret err[str].ok{};
}

# the sections the last push saved made current and previous again
pub fun pop_section(m: *Assembler) err[str] {
    val top: opt[Frame] = vector.pop[Frame](?m.stack);
    if (sel top.none) { ret err[str].err{EMPTY_STACK}; }
    if (sel top.some.current.some) {
        val switched: err[build.Refusal] = build.switch(?m.b, top.some.current.some);
        if (sel switched.err) { ret err[str].err{switched.err.message}; }
    }
    m.previous = top.some.previous;
    ret err[str].ok{};
}

# the previous section and the current one swapped
pub fun swap_previous(m: *Assembler) err[str] {
    if (sel m.previous.none) { ret err[str].err{NO_PREVIOUS}; }
    ret switch_to(m, m.previous.some);
}

# the previous section, to restore after a directive that writes elsewhere
pub fun previous_of(m: *Assembler) opt[build.Section] {
    ret m.previous;
}

# the previous section set back to `p`
pub fun restore_previous(m: *Assembler, p: opt[build.Section]) {
    m.previous = p;
}

# whether `v` is spelled `s`, exactly, as an option's operand is read
fun spells(v: View, s: str) bool {
    if (s == nil || v.len != str_len(s)) { ret false; }
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a basis over `selection`, which it takes, kept by the assembler until it is released, the selection given back when
# it cannot be kept
fun based(m: *Assembler, selection: extension.Selection, object: bool) res[*Basis, str] {
    var taken: extension.Selection = selection;
    if (!held(vector.reserve[*Basis](?m.bases, 1))) {
        extension.release(?taken);
        ret res[*Basis, str].err{field.MEMORY};
    }
    val made: res[*Basis, A.Error] = A.allocate[Basis](m.a, 1);
    if (sel made.err) {
        extension.release(?taken);
        ret res[*Basis, str].err{field.MEMORY};
    }
    val basis: *Basis = made.ok;
    basis.selection = taken;
    basis.object    = object;
    basis.kept      = vector.init[Kept](m.a);
    vector.push[*Basis](?m.bases, basis);
    ret res[*Basis, str].ok{basis};
}

# whether two states hold one value on every axis
fun same_values(a: state.Settings, b: state.Settings) bool {
    var i: u32 = 0;
    for (i < state.MAX_AXES) {
        if (a.at[i] != b.at[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the narrowings `active` marks put in force over `basis` at the state `values`, the builder told the context that
# writes under them, made the first time they are in force over it. the object's basis with none in force at the
# object's state is the object's own context
fun in_force(m: *Assembler, basis: *Basis, active: u64, values: state.Settings) err[str] {
    var v: *state.Context = m.object;
    if (!basis.object || active != 0 || !same_values(values, m.object.values)) {
        var found: *narrow.Narrowed = nil;
        var i:     usize            = 0;
        for (i < basis.kept.len && found == nil) {
            val k: *Kept = ?basis.kept.data[i];
            if (k.active == active && same_values(k.values, values)) { found = k.view; }
            i = i + 1;
        }
        if (found == nil) {
            if (!held(vector.reserve[Kept](?basis.kept, 1))) { ret err[str].err{field.MEMORY}; }
            val made: res[*narrow.Narrowed, state.Opened] = narrow.from(m.a, m.object.view.file, ?basis.selection, m.object, values, m.set.source.directives, active);
            if (sel made.err) { ret err[str].err{opened(made.err)}; }
            vector.push[Kept](?basis.kept, Kept{active: active, values: values, view: made.ok, site: m.site});
            found = made.ok;
        }
        v = ?found.context;
    }
    val told: err[build.Refusal] = build.under(?m.b, v);
    if (sel told.err) { ret err[str].err{told.err.message}; }
    m.basis  = basis;
    m.active = active;
    m.values = values;
    ret err[str].ok{};
}

# the wording of a context not made for a statement
fun opened(e: state.Opened) str {
    if (sel e.state) { ret STATE_STATED; }
    val v: register.Error = e.view;
    if (sel v.empty) { ret EMPTY_QUANTITY; }
    ret field.MEMORY;
}

# every mode of `saved` put back through the builder, as a pop restores what its push saved
fun modes_back(m: *Assembler, saved: *mode.State) err[str] {
    var i: u32 = 0;
    for (i < saved.modes.len) {
        val back: err[build.Refusal] = build.set_mode(?m.b, mode.Setting{mode: saved.modes.at[i], value: saved.values[i]});
        if (sel back.err) { ret err[str].err{back.err.message}; }
        i = i + 1;
    }
    ret err[str].ok{};
}

# the refusal of a selection that could not be made, at the `len` bytes from `at`
fun unmade(rd: *syntax.Reader, e: extension.Error, at: usize, len: usize) diagnostic.Diagnostic {
    if (sel e.refused)  { ret e.refused; }
    if (sel e.conflict) { ret read.refuse(rd, CONFLICTING, at, len); }
    ret read.refuse(rd, field.MEMORY, at, len);
}

# whether the selection holds every extension of `ids`
fun holds_all(s: *extension.Selection, ids: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (!extension.has(s, ids.at[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the selection in force edited by the `+name` and `-name` list at the reader: an extension added with what it implies,
# or removed, refused while another it holds implies it. a name edits every extension it names
fun edited(m: *Assembler, rd: *syntax.Reader) res[extension.Selection, diagnostic.Diagnostic] {
    val copied: res[extension.Selection, A.Error] = extension.copy(m.a, build.view(?m.b).selection);
    if (sel copied.err) { ret res[extension.Selection, diagnostic.Diagnostic].err{read.refuse(rd, field.MEMORY, rd.at, 0)}; }
    var s: extension.Selection = copied.ok;
    for {
        val sign: u8 = read.peek(rd);
        if (sign != '+' && sign != '-') {
            extension.release(?s);
            ret res[extension.Selection, diagnostic.Diagnostic].err{read.refuse(rd, NOT_AN_EDIT, rd.at, read.token(rd, rd.at))};
        }
        rd.at = rd.at + 1;
        val at:  usize = rd.at;
        val len: usize = read.name(rd);
        if (len == 0) {
            extension.release(?s);
            ret res[extension.Selection, diagnostic.Diagnostic].err{read.refuse(rd, NOT_AN_EDIT, at, read.token(rd, at))};
        }
        rd.at = at + len;
        val found: opt[*extension.NameEntry] = extension.entry(s.catalog, View{data: ?rd.text[at], len: len}, false);
        var ids:   opt[requirement.Ids]      = opt[requirement.Ids].none{};
        if (sel found.some) { ids = extension.extensions_of(s.catalog, found.some); }
        if (sel ids.none) {
            extension.release(?s);
            ret res[extension.Selection, diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_EXTENSION, at, len)};
        }
        val rows: requirement.Ids = ids.some;
        if (sign == '+' && !holds_all(?s, rows)) {
            val grown: res[extension.Selection, extension.Error] = extension.added(m.a, ?s, rows);
            extension.release(?s);
            if (sel grown.err) { ret res[extension.Selection, diagnostic.Diagnostic].err{unmade(rd, grown.err, at, len)}; }
            s = grown.ok;
        }
        if (sign == '-') {
            var k: u32 = 0;
            for (k < rows.len) {
                if (extension.has(?s, rows.at[k]) && extension.implied_but(?s, rows.at[k], rows)) {
                    extension.release(?s);
                    ret res[extension.Selection, diagnostic.Diagnostic].err{read.refuse(rd, STILL_IMPLIED, at, len)};
                }
                k = k + 1;
            }
            k = 0;
            for (k < rows.len) {
                if (extension.has(?s, rows.at[k])) { extension.without(?s, rows.at[k]); }
                k = k + 1;
            }
        }
        read.skip(rd);
        if (!read.take(rd, ",")) { brk; }
        read.skip(rd);
    }
    ret res[extension.Selection, diagnostic.Diagnostic].ok{s};
}

# the length of the spelling at the reader, a selection or an extension's name: the run up to white space, a comma or
# the statement's end, as `armv9-a+sve2` or `rv64gc_zba`, 0 when no name starts there
fun spelling_run(rd: *syntax.Reader) usize {
    if (read.name(rd) == 0) { ret 0; }
    var i: usize = rd.at;
    for (i < rd.end && rd.text[i] != ' ' && rd.text[i] != '\t' && rd.text[i] != ',') { i = i + 1; }
    ret i - rd.at;
}

# the selection directive `d`, the dialect's restatement, states at the reader, after its comma when it has a word: a
# whole selection in the set's selection syntax, naming a level of the kinds `d` takes, or edits of the selection in
# force. it may hold what the object's does not, as the kernel's `.option arch, +zbb` stretches do, and never another
# value of a state the object does not switch, and it is in force from the next statement with no narrowing over it
fun restate(m: *Assembler, rd: *syntax.Reader, d: *core_source.Directive) err[diagnostic.Diagnostic] {
    read.skip(rd);
    if (d.operands.word != nil && d.operands.word[0] != 0) {
        if (!read.take(rd, ",")) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, EXPECTED_COMMA, rd.at, read.token(rd, rd.at))}; }
        read.skip(rd);
    }
    var kinds: extension.LevelKinds = 0;
    if (sel d.edit.restate) { kinds = d.edit.restate; }
    val from: usize = rd.at;
    var made: extension.Selection;
    val c:    u8    = read.peek(rd);
    if (c == '+' || c == '-') {
        val got: res[extension.Selection, diagnostic.Diagnostic] = edited(m, rd);
        if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
        made = got.ok;
    }
    or {
        val len: usize = spelling_run(rd);
        if (len == 0) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, read.EXPECTED, from, read.token(rd, from))}; }
        val text: res[str, str] = spelled(m, read.span(rd, from, len));
        if (sel text.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, text.err, from, len)}; }
        val origin: diagnostic.Position                       = read.refuse(rd, "", from, 0).span.start;
        val got:    res[extension.Selection, extension.Error] = extension.select_of(m.a, m.object.selection.catalog, text.ok, origin, kinds);
        if (sel got.err) { ret err[diagnostic.Diagnostic].err{unmade(rd, got.err, from, len)}; }
        made  = got.ok;
        rd.at = from + len;
    }
    ret restated(m, rd, made, from);
}

# selection `made`, read from `from`, put in force from the next statement with no narrowing over it
fun restated(m: *Assembler, rd: *syntax.Reader, made: extension.Selection, from: usize) err[diagnostic.Diagnostic] {
    val basis: res[*Basis, str] = based(m, made, false);
    if (sel basis.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, basis.err, from, rd.at - from)}; }
    val put: err[str] = in_force(m, basis.ok, 0, m.values);
    if (sel put.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, put.err, from, rd.at - from)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# the catalog's entry for the `len` bytes from `at`, its own spelling or else ignoring case
fun entry_at(c: *extension.Catalog, rd: *syntax.Reader, at: usize, len: usize) opt[*extension.NameEntry] {
    val exact: opt[*extension.NameEntry] = extension.entry(c, View{data: ?rd.text[at], len: len}, false);
    if (sel exact.some) { ret exact; }
    ret extension.entry(c, View{data: ?rd.text[at], len: len}, true);
}

# the selection in force with the extension at the reader added with what it implies, or, after `no`, removed with every
# extension that implies it, as aarch64's `.arch_extension sve` and `.arch_extension nosve`, put in
# force with no narrowing over it. a name of a level is no extension's
fun extend(m: *Assembler, rd: *syntax.Reader) err[diagnostic.Diagnostic] {
    read.skip(rd);
    val from: usize = rd.at;
    val len:  usize = spelling_run(rd);
    if (len == 0) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NOT_A_NAME, from, read.token(rd, from))}; }
    rd.at = from + len;
    val c:      *extension.Catalog        = m.object.selection.catalog;
    var adding: bool                      = true;
    var found:  opt[*extension.NameEntry] = entry_at(c, rd, from, len);
    if (sel found.none && len > 2 && rd.text[from] == 'n' && rd.text[from + 1] == 'o') {
        found  = entry_at(c, rd, from + 2, len - 2);
        adding = false;
    }
    var rows: requirement.Ids = requirement.NO_IDS;
    if (sel found.some) { rows = found.some.rows; }
    var k: u32 = 0;
    for (k < rows.len) {
        if (rows.at[k] >= c.count) { rows = requirement.NO_IDS; }
        k = k + 1;
    }
    if (rows.len == 0) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_EXTENSION, from, len)}; }
    val s:    *extension.Selection                    = build.view(?m.b).selection;
    val made: res[extension.Request, extension.Error] = extension.request(m.a, c, "", diagnostic.START);
    if (sel made.err) { ret err[diagnostic.Diagnostic].err{unmade(rd, made.err, from, len)}; }
    var r: extension.Request = made.ok;
    var i: u32               = 0;
    for (i < c.count) {
        if (extension.has(s, i)) { extension.request_add(?r, i); }
        i = i + 1;
    }
    i = 0;
    for (i < s.stated.len) {
        extension.request_add(?r, s.stated.at[i]);
        i = i + 1;
    }
    k = 0;
    for (k < rows.len) {
        if (adding) { extension.request_add(?r, rows.at[k]); }
        or          { extension.request_remove(?r, rows.at[k]); }
        k = k + 1;
    }
    val closed: res[extension.Selection, extension.Error] = extension.close(r);
    if (sel closed.err) { ret err[diagnostic.Diagnostic].err{unmade(rd, closed.err, from, len)}; }
    ret restated(m, rd, closed.ok, from);
}

# whether directive `i` of `ds` is the first of its name, which the assembler's one row of that name reads for
fun first_of_name(ds: core_source.Directives, i: u32) bool {
    var j: u32 = 0;
    for (j < i) {
        if (str_equals(ds.at[j].name, ds.at[i].name)) { ret false; }
        j = j + 1;
    }
    ret true;
}

# the dialect's directive of the name directive `first` has that the word at the reader chooses, or the one row of that
# name when its rows take no word, by its index
fun dialect_row(m: *Assembler, rd: *syntax.Reader, first: u32) res[u32, diagnostic.Diagnostic] {
    val ds: core_source.Directives = m.set.source.directives;
    val w:  str                    = ds.at[first].operands.word;
    if (w == nil || w[0] == 0) { ret res[u32, diagnostic.Diagnostic].ok{first}; }
    val at:  usize = rd.at;
    val len: usize = read.name(rd);
    if (len == 0) { ret res[u32, diagnostic.Diagnostic].err{read.refuse(rd, NOT_A_NAME, at, read.token(rd, at))}; }
    rd.at = at + len;
    val word: View = read.span(rd, at, len);
    var i:    u32  = first;
    for (i < ds.len) {
        if (str_equals(ds.at[i].name, ds.at[first].name) && spells(word, ds.at[i].operands.word)) { ret res[u32, diagnostic.Diagnostic].ok{i}; }
        i = i + 1;
    }
    ret res[u32, diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_FORM, at, len)};
}

# the statement state saved last put back: its selection, narrowings and state in force, its modes and its syntax
fun popped(m: *Assembler, rd: *syntax.Reader, at: usize, len: usize) err[diagnostic.Diagnostic] {
    if (m.pushed.len == 0) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NOTHING_PUSHED, at, len)}; }
    val saved: *Saved   = ?m.pushed.data[m.pushed.len - 1];
    val put:   err[str] = in_force(m, saved.basis, saved.active, saved.values);
    if (sel put.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, put.err, at, len)}; }
    val restored: err[str] = modes_back(m, ?saved.modes);
    if (sel restored.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, restored.err, at, len)}; }
    val back: err[str] = written_in(m, saved.syntax);
    if (sel back.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, back.err, at, len)}; }
    vector.truncate[Saved](?m.pushed, m.pushed.len - 1);
    ret err[diagnostic.Diagnostic].ok{};
}

# the statements after this one read and written in the set's syntax `k`
fun written_in(m: *Assembler, k: u32) err[str] {
    if (k >= m.set.syntaxes.len) { ret err[str].err{NO_SYNTAX}; }
    val told: err[build.Refusal] = build.in_syntax(?m.b, k);
    if (sel told.err) { ret err[str].err{told.err.message}; }
    m.syntax  = ?m.set.syntaxes.at[k];
    m.written = k;
    ret err[str].ok{};
}

# the selection `basis` holds with the narrowings `active` widened by `ids`, into both: a selection without them takes
# them, and every narrowing that would take one away is lifted, refused at the `len` bytes from
# `at` when the selection cannot be made
fun widen(m: *Assembler, rd: *syntax.Reader, ids: requirement.Ids, at: usize, len: usize, basis: **Basis, active: *u64) err[diagnostic.Diagnostic] {
    var b:    *Basis = @basis;
    var lack: bool   = false;
    var k:    u32    = 0;
    for (k < ids.len) {
        lack = lack || !extension.has(?b.selection, ids.at[k]);
        k    = k + 1;
    }
    if (lack) {
        val grown: res[extension.Selection, extension.Error] = extension.added(m.a, ?b.selection, ids);
        if (sel grown.err) { ret err[diagnostic.Diagnostic].err{unmade(rd, grown.err, at, len)}; }
        val kept: res[*Basis, str] = based(m, grown.ok, false);
        if (sel kept.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, kept.err, at, len)}; }
        b = kept.ok;
    }
    @basis  = b;
    @active = narrow.lifted(m.a, m.set.source.directives, @active, ?b.selection, ids);
    ret err[diagnostic.Diagnostic].ok{};
}

# the selection in force widened by what each instruction of `ex`, just written, widens it by, as a `widen` edit
# widens it, so the instructions after them are read and written under it, refused at the instruction's text
fun widened_by(m: *Assembler, rd: *syntax.Reader, ex: *relax.Expansion) err[diagnostic.Diagnostic] {
    if (m.set.source.widens == nil) { ret err[diagnostic.Diagnostic].ok{}; }
    var basis:  *Basis = m.basis;
    var active: u64    = m.active;
    var grown:  bool   = false;
    var i:      u32    = 0;
    for (i < ex.count) {
        var one: inst.Inst       = inst.Inst{row: ex.steps[i].row, values: ?ex.steps[i].values[0], count: ex.steps[i].row.operands.len, form: ex.steps[i].form};
        val ids: requirement.Ids = m.set.source.widens(?one);
        if (ids.len > 0) {
            val done: err[diagnostic.Diagnostic] = widen(m, rd, ids, rd.start, read.token(rd, rd.start), ?basis, ?active);
            if (sel done.err) { ret done; }
            grown = true;
        }
        i = i + 1;
    }
    if (!grown) { ret err[diagnostic.Diagnostic].ok{}; }
    val put: err[str] = in_force(m, basis, active, m.values);
    if (sel put.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, put.err, rd.start, read.token(rd, rd.start))}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# the place here marked for the linker by a relocation of fixup kind `kind` naming the symbol the reader names,
# refused for any other expression, as aarch64's `.tlsdesccall`
fun marked(m: *Assembler, rd: *syntax.Reader, kind: operand.FixupKind) err[diagnostic.Diagnostic] {
    read.skip(rd);
    val at:  usize                                 = rd.at;
    var got: res[expr.Expr, diagnostic.Diagnostic] = expr.parse(rd, operand.NO_FIXUP);
    if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
    val bound_: err[str] = bind(m, ?got.ok, read.refuse(rd, "", at, 0).span.start);
    if (sel bound_.err)                                                       { ret err[diagnostic.Diagnostic].err{read.refuse(rd, bound_.err, at, rd.at - at)}; }
    if (!sel got.ok.symbol)                                                   { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NOT_A_NAME, at, rd.at - at)}; }
    if (got.ok.symbol.addend != 0 || got.ok.symbol.fixup != operand.NO_FIXUP) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NOT_A_NAME, at, rd.at - at)}; }
    val rest: err[diagnostic.Diagnostic] = ended(rd);
    if (sel rest.err) { ret rest; }
    val made: err[build.Refusal] = build.mark(?m.b, kind, build.Label{id: got.ok.symbol.id});
    if (sel made.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, made.err.message, at, rd.at - at)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# a directive of the set's dialect, its operands read from the reader: the row its word chooses among the rows of its
# name does what its edit states. a narrowing puts itself in force, a widening adds what it names to the selection,
# the object's too, as `.option rvc` turns c on in an object built without it, and lifts every narrowing that would
# take it away, a restatement states the selection the narrowings narrow from then on, a state directive sets an axis
# the set switches within an object, a mode or syntax directive chooses its value, the push saves all of it and the
# pop restores it, the attribute and raw directives state a trait and an instruction, a mark directive marks its place
# for the linker, and a directive masc does not yet read is refused at its name
fun dialect_directive(m: *Assembler, args: *Args) err[diagnostic.Diagnostic] {
    val rd:     *syntax.Reader                  = args.reader;
    val at:     usize                           = rd.at;
    val chosen: res[u32, diagnostic.Diagnostic] = dialect_row(m, rd, args.directive.param::u32);
    if (sel chosen.err) { ret err[diagnostic.Diagnostic].err{chosen.err}; }
    val d:   *core_source.Directive = ?m.set.source.directives.at[chosen.ok];
    val len: usize                  = rd.at - at;
    if (sel d.edit.unsupported) { ret err[diagnostic.Diagnostic].err{at_position(d.edit.unsupported, args.statement.head.position, args.statement.head.len)}; }
    if (sel d.edit.attribute)   { ret attribute_directive(m, rd); }
    if (sel d.edit.raw)         { ret insn_directive(m, args, ?d.edit.raw); }
    if (sel d.edit.restate)     { ret restate(m, rd, d); }
    if (sel d.edit.extend)      { ret extend(m, rd); }
    if (sel d.edit.mark)        { ret marked(m, rd, d.edit.mark); }
    if (sel d.edit.pop)         { ret popped(m, rd, at, len); }
    if (sel d.edit.push) {
        if (!held(vector.push[Saved](?m.pushed, Saved{basis: m.basis, active: m.active, values: m.values, modes: @build.modes_of(?m.b), syntax: m.written}))) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, field.MEMORY, at, len)}; }
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (sel d.edit.mode) {
        val changed: err[build.Refusal] = build.set_mode(?m.b, d.edit.mode);
        if (sel changed.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, changed.err.message, at, len)}; }
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (sel d.edit.syntax) {
        val switched: err[str] = written_in(m, d.edit.syntax::u32);
        if (sel switched.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, switched.err, at, len)}; }
        ret err[diagnostic.Diagnostic].ok{};
    }
    var basis:  *Basis         = m.basis;
    var active: u64            = m.active;
    var values: state.Settings = m.values;
    if (sel d.edit.narrow) { active = active | core_source.bit(chosen.ok); }
    if (sel d.edit.widen) {
        val grown: err[diagnostic.Diagnostic] = widen(m, rd, d.edit.widen, at, len, ?basis, ?active);
        if (sel grown.err) { ret grown; }
    }
    if (sel d.edit.state) {
        val p: state.Placed = d.edit.state;
        values.at[p.axis] = p.value;
    }
    val put: err[str] = in_force(m, basis, active, values);
    if (sel put.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, put.err, at, len)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# the value of a selection tag at the reader, a string naming the object's selection, as the object's selection's own
# spelling in the set's syntax, into the assembler's spelled bytes
fun selection_value(m: *Assembler, rd: *syntax.Reader) res[View, diagnostic.Diagnostic] {
    val at:  usize                            = rd.at;
    val got: res[View, diagnostic.Diagnostic] = string(m, rd);
    if (sel got.err) { ret got; }
    val text: res[str, str] = spelled(m, got.ok);
    if (sel text.err) { ret res[View, diagnostic.Diagnostic].err{read.refuse(rd, text.err, at, rd.at - at)}; }
    val origin: diagnostic.Position                       = read.refuse(rd, "", at + 1, 0).span.start;
    var named:  res[extension.Selection, extension.Error] = extension.select(m.a, m.object.selection.catalog, text.ok, origin);
    if (sel named.err) { ret res[View, diagnostic.Diagnostic].err{unmade(rd, named.err, at, rd.at - at)}; }
    val same: bool = extension.within(?named.ok, m.object.selection) && extension.within(m.object.selection, ?named.ok);
    extension.release(?named.ok);
    if (!same) { ret res[View, diagnostic.Diagnostic].err{read.refuse(rd, OTHER_SELECTION, at, rd.at - at)}; }
    vector.truncate[u8](?m.spelled, 0);
    val written: err[A.Error] = extension.spell_versioned(m.object.selection, ?m.spelled);
    if (sel written.err) { ret res[View, diagnostic.Diagnostic].err{read.refuse(rd, field.MEMORY, at, rd.at - at)}; }
    ret res[View, diagnostic.Diagnostic].ok{View{data: m.spelled.data, len: m.spelled.len}};
}

# the dialect's attribute directive, its operands read from the reader: a tag by name or number, a comma and its value,
# a string for a text axis and a number otherwise, stated through the builder as the setting the object's format maps
# the value to on the axis it encodes as the tag's attribute. a tag of no axis, or a value no setting, is refused,
# never written another way
fun attribute_directive(m: *Assembler, rd: *syntax.Reader) err[diagnostic.Diagnostic] {
    val at:  usize        = rd.at;
    var tag: contract.Tag = contract.Tag.number{0};
    val len: usize        = read.name(rd);
    var bad: bool         = false;
    if (len > 0) {
        rd.at = at + len;
        val name: res[str, str] = spelled(m, read.span(rd, at, len));
        if (sel name.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, name.err, at, len)}; }
        tag = contract.Tag.name{name.ok};
    }
    or {
        val e: res[expr.Expr, diagnostic.Diagnostic] = expr.parse(rd, operand.NO_FIXUP);
        if (sel e.err)          { ret err[diagnostic.Diagnostic].err{e.err}; }
        if (!sel e.ok.constant) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NOT_CONSTANT, at, rd.at - at)}; }
        bad = e.ok.constant < 0;
        tag = contract.Tag.number{e.ok.constant:~u64};
    }
    val named: usize = rd.at - at;
    if (bad) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_TAG, at, named)}; }
    val found: res[opt[*trait.Axis], build.Refusal] = build.attribute(?m.b, tag);
    if (sel found.err)     { ret err[diagnostic.Diagnostic].err{read.refuse(rd, found.err.message, at, named)}; }
    if (sel found.ok.none) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_TAG, at, named)}; }
    val axis: *trait.Axis = found.ok.some;
    read.skip(rd);
    if (!read.take(rd, ",")) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, EXPECTED_COMMA, rd.at, read.token(rd, rd.at))}; }
    read.skip(rd);
    val from:    usize            = rd.at;
    var written: contract.Written = contract.Written.number{0};
    if (sel axis.value.text) {
        var text: View;
        if (build.spells_selection(?m.b, axis)) {
            val got: res[View, diagnostic.Diagnostic] = selection_value(m, rd);
            if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
            text = got.ok;
        }
        or {
            val got: res[View, diagnostic.Diagnostic] = string(m, rd);
            if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
            text = got.ok;
        }
        written = contract.Written.text{store.Bytes{data: text.data, len: text.len}};
    }
    or {
        val e: res[expr.Expr, diagnostic.Diagnostic] = expr.parse(rd, operand.NO_FIXUP);
        if (sel e.err)          { ret err[diagnostic.Diagnostic].err{e.err}; }
        if (!sel e.ok.constant) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, NOT_CONSTANT, from, rd.at - from)}; }
        if (e.ok.constant < 0)  { ret err[diagnostic.Diagnostic].err{read.refuse(rd, TAG_VALUE, from, rd.at - from)}; }
        written = contract.Written.number{e.ok.constant:~u64};
    }
    val setting: res[trait.Setting, build.Refusal] = build.setting(?m.b, axis, written);
    if (sel setting.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, TAG_VALUE, from, rd.at - from)}; }
    val stated: err[build.Refusal] = build.state_spelled(?m.b, trait.Trait{axis: axis, setting: setting.ok}, tag, written);
    if (sel stated.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, stated.err.message, at, rd.at - at)}; }
    ret err[diagnostic.Diagnostic].ok{};
}

# the instruction length the raw encoding `v` states by the set's length encoding, its bytes in the order the set writes
# them, an integer's least significant first and a literal's as it holds them. 0 for none a raw form takes
fun encoded_length(insns: *core_source.Insns, v: *operand.Value) usize {
    if (sel v.literal)    { ret insns.length(v.literal.at, v.literal.len::usize); }
    if (!sel v.immediate) { ret 0; }
    var bytes: [8]u8;
    var i:     usize = 0;
    for (i < 8) {
        bytes[i] = ((v.immediate:~u64 >> (i * 8)::u64) & 0xFF)::u8;
        i        = i + 1;
    }
    ret insns.length(?bytes[0], 8);
}

# the lone value from `from`, as risc-v's `.insn 0x13`, as the raw format of the length its low bits state: the first
# raw format that reads the text whole as its encoding and whose length the encoding states. none when no raw format
# reads it, and refused when the formats that read it state another length or one no raw form takes, or when the pool
# holds no slot for it
fun unlengthed(insns: *core_source.Insns, rd: *syntax.Reader, from: usize) opt[res[parse.Taken, diagnostic.Diagnostic]] {
    # the lone value is read into the pool's first slot, which a pool of none is noted short of
    if (rd.cap == 0) {
        read.pool_short(rd, 1);
        ret opt[res[parse.Taken, diagnostic.Diagnostic]].some{res[parse.Taken, diagnostic.Diagnostic].err{read.refuse(rd, field.STORAGE, from, 0)}};
    }
    val formats: core_source.Formats = insns.formats;
    val taken:   u32                 = rd.taken;
    var read_:   bool                = false;
    var states:  usize               = 0;
    var i:       u32                 = 0;
    for (i < formats.len) {
        val f: *core_source.Format = ?formats.at[i];
        i = i + 1;
        if (f.length == 0) { cnt; }
        rd.at    = from;
        rd.taken = taken;
        val got: err[diagnostic.Diagnostic] = parse.value(rd, ?f.row.operands.at[0], ?rd.pool[0]);
        if (sel got.err) { cnt; }
        read.skip(rd);
        if (rd.at != rd.end) { cnt; }
        read_  = true;
        states = encoded_length(insns, ?rd.pool[0]);
        if (states == f.length::usize) { ret opt[res[parse.Taken, diagnostic.Diagnostic]].some{res[parse.Taken, diagnostic.Diagnostic].ok{parse.Taken{format: f, inst: inst.Inst{row: f.row, values: rd.pool, count: 1}}}}; }
    }
    rd.taken = taken;
    if (!read_)      { ret opt[res[parse.Taken, diagnostic.Diagnostic]].none{}; }
    if (states == 0) { ret opt[res[parse.Taken, diagnostic.Diagnostic]].some{res[parse.Taken, diagnostic.Diagnostic].err{read.refuse(rd, RESERVED_LENGTH, from, rd.end - from)}}; }
    ret opt[res[parse.Taken, diagnostic.Diagnostic]].some{res[parse.Taken, diagnostic.Diagnostic].err{read.refuse(rd, LENGTH_MISMATCH, from, rd.end - from)}};
}

# the instruction directive, as risc-v's `.insn`: an instruction stated by its encoding, read by the first of the
# dialect's formats that takes the text whole, or a lone constant by the raw format of the length its low bits encode.
# a raw format's length is checked against the one the encoding's low bits state
fun insn_directive(m: *Assembler, args: *Args, insns: *core_source.Insns) err[diagnostic.Diagnostic] {
    if (!insns.listed) { ret insn_one(m, args, insns); }
    # a listed directive reads each instruction up to its comma as a statement of its own
    val rd:  *syntax.Reader = args.reader;
    val end: usize          = rd.end;
    for {
        read.skip(rd);
        var stop: usize = rd.at;
        for (stop < end && rd.text[stop] != ',') { stop = stop + 1; }
        rd.end = stop;
        val one: err[diagnostic.Diagnostic] = insn_one(m, args, insns);
        rd.end = end;
        if (sel one.err) { ret one; }
        if (stop >= end) { brk; }
        rd.at = stop + 1;
    }
    rd.at = end;
    ret err[diagnostic.Diagnostic].ok{};
}

# one instruction of the instruction directive, read from the reader to its end
fun insn_one(m: *Assembler, args: *Args, insns: *core_source.Insns) err[diagnostic.Diagnostic] {
    val rd:   *syntax.Reader = args.reader;
    val from: usize          = rd.at;
    # read again into stores grown to what the read found them short of, as an instruction statement is
    for {
        rd.at    = from;
        rd.start = from;
        val got: res[parse.Taken, diagnostic.Diagnostic]      = parse.format(rd, insns.formats);
        var raw: opt[res[parse.Taken, diagnostic.Diagnostic]] = opt[res[parse.Taken, diagnostic.Diagnostic]].none{};
        if (sel got.err) { raw = unlengthed(insns, rd, from); }
        val again: res[bool, A.Error] = syntax.regrown(rd, ?m.stores);
        if (sel again.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, field.MEMORY, from, rd.end - from)}; }
        if (again.ok) {
            syntax.over(rd, ?m.stores);
            cnt;
        }
        if (sel got.ok)       { ret encoded(m, args, from, got.ok, insns); }
        if (sel raw.none)     { ret err[diagnostic.Diagnostic].err{got.err}; }
        if (sel raw.some.err) { ret err[diagnostic.Diagnostic].err{raw.some.err}; }
        ret encoded(m, args, from, raw.some.ok, insns);
    }
}

# the instruction format `taken` read from `from` written, its symbols claimed and a raw format's length checked
fun encoded(m: *Assembler, args: *Args, from: usize, taken: parse.Taken, insns: *core_source.Insns) err[diagnostic.Diagnostic] {
    val rd:  *syntax.Reader      = args.reader;
    val f:   *core_source.Format = taken.format;
    val len: usize               = rd.at - from;
    if (f.length > 0 && encoded_length(insns, ?taken.inst.values[0]) != f.length::usize) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, LENGTH_MISMATCH, from, len)}; }
    var places: Places = Places{here: operand.NO_SYMBOL, own: operand.NO_SYMBOL};
    var k:      u32    = 0;
    for (k < taken.inst.count) {
        val claimed: err[str] = claim(m, ?taken.inst.values[k], args.statement.head.position, ?places);
        if (sel claimed.err) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, claimed.err, from, len)}; }
        k = k + 1;
    }
    val written: err[build.Refusal] = build.format(?m.b, f, taken.inst.values);
    if (sel written.err) {
        var d: diagnostic.Diagnostic = read.refuse(rd, written.err.message, from, len);
        if (sel written.err.encode.some) { d.requires = written.err.encode.some.requires; }
        ret err[diagnostic.Diagnostic].err{d};
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# a reader over `len` bytes of statement `st` from `at`, positioned at `origin`, into the assembler's stores
fun reader(m: *Assembler, st: *source.Statement, at: usize, len: usize, origin: diagnostic.Position) syntax.Reader {
    m.names.context = m::ptr;
    var rd: syntax.Reader = syntax.Reader{
        text:    st.text,
        start:   at,
        at:      at,
        end:     at + len,
        origin:  origin,
        codec:   m.set.codec,
        ctx:     build.view(?m.b),
        syntax:  m.syntax,
        modes:   build.modes_of(?m.b),
        symbols: ?m.names,
        context: nil,
        row:     nil,
        format:  m.b.format,
    };
    syntax.over(?rd, ?m.stores);
    ret rd;
}

# whether `c` is one of the set's type prefixes
fun prefix(m: *Assembler, c: u8) bool {
    val types: str   = m.set.source.types;
    var i:     usize = 0;
    for (types[i] != 0) {
        if (types[i] == c) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a string read at the reader's position, its escapes read into the assembler's strings, which hold room for the
# statement's every byte so a string read earlier does not move
pub fun string(m: *Assembler, rd: *syntax.Reader) res[View, diagnostic.Diagnostic] {
    val at: usize = rd.at;
    if (!read.take(rd, "\"")) { ret res[View, diagnostic.Diagnostic].err{read.refuse(rd, NOT_A_STRING, at, read.token(rd, at))}; }
    val start: usize = m.strings.len;
    for (read.peek(rd) != '"') {
        if (read.peek(rd) == 0) { ret res[View, diagnostic.Diagnostic].err{read.refuse(rd, source.UNCLOSED_STRING, at, 1)}; }
        var c: u8 = read.peek(rd);
        rd.at = rd.at + 1;
        if (c == '\\') {
            val e: u8 = read.peek(rd);
            rd.at = rd.at + 1;
            if (e == 'n') { c = '\n'; }
            or (e == 't') { c = '\t'; }
            or (e == 'r') { c = '\r'; }
            or (e == 'b') { c = 8; }
            or (e == 'f') { c = 12; }
            or (e == 'x' || e == 'X') {
                var v: u32 = 0;
                for (read.word(read.peek(rd)) && hexit(read.peek(rd)) < 16) {
                    v     = (v * 16 + hexit(read.peek(rd))) & 0xFF;
                    rd.at = rd.at + 1;
                }
                c = v::u8;
            }
            or (e >= '0' && e <= '7') {
                var v: u32 = (e - '0')::u32;
                var k: u32 = 1;
                for (k < 3 && read.peek(rd) >= '0' && read.peek(rd) <= '7') {
                    v     = v * 8 + (read.peek(rd) - '0')::u32;
                    rd.at = rd.at + 1;
                    k     = k + 1;
                }
                c = (v & 0xFF)::u8;
            }
            or { c = e; }
        }
        m.strings.data[m.strings.len] = c;
        vector.commit[u8](?m.strings, 1);
    }
    rd.at = rd.at + 1;
    ret res[View, diagnostic.Diagnostic].ok{View{data: ?m.strings.data[start], len: m.strings.len - start}};
}

# the name the `len` bytes between a quoted name's quotes at `text` spell (`masc.syntax.name`), read into the
# assembler's strings, which grow to hold it. ESCAPE for an escape the name may not hold
pub fun unquoted(m: *Assembler, text: *u8, len: usize) res[View, str] {
    if (!held(vector.reserve[u8](?m.strings, len))) { ret res[View, str].err{field.MEMORY}; }
    val start: usize      = m.strings.len;
    val n:     opt[usize] = spell.unquote(text, len, ?m.strings.data[start]);
    if (sel n.none) { ret res[View, str].err{expr.ESCAPE}; }
    vector.commit[u8](?m.strings, n.some);
    ret res[View, str].ok{View{data: ?m.strings.data[start], len: n.some}};
}

# a symbol name read at the reader's position, bare or in quotes (`masc.syntax.name`), a quoted one into the
# assembler's strings
pub fun symbol_name(m: *Assembler, rd: *syntax.Reader) res[View, diagnostic.Diagnostic] {
    val at: usize = rd.at;
    if (read.peek(rd) == '"') {
        val len: usize = spell.quoted(rd.text, at, rd.end);
        if (len == 0) { ret res[View, diagnostic.Diagnostic].err{read.refuse(rd, expr.UNQUOTED, at, rd.end - at)}; }
        val v: res[View, str] = unquoted(m, ?rd.text[at + 1], len - 2);
        if (sel v.err) { ret res[View, diagnostic.Diagnostic].err{read.refuse(rd, v.err, at, len)}; }
        rd.at = at + len;
        ret res[View, diagnostic.Diagnostic].ok{v.ok};
    }
    val len: usize = read.name(rd);
    if (len == 0) { ret res[View, diagnostic.Diagnostic].err{read.refuse(rd, NOT_A_NAME, at, read.token(rd, at))}; }
    rd.at = at + len;
    ret res[View, diagnostic.Diagnostic].ok{read.span(rd, at, len)};
}

fun hexit(c: u8) u32 {
    if (c >= '0' && c <= '9') { ret (c - '0')::u32; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::u32 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::u32 + 10; }
    ret 16;
}

fun digit(c: u8) bool {
    ret c >= '0' && c <= '9';
}

# whether the `len` bytes at `at` spell `word`, in any case
fun float_word(rd: *syntax.Reader, at: usize, len: usize, word: str) bool {
    if (len != str_len(word)) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (syntax.lower(rd.text[at + i]) != word[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the end of the digits from `at`, hex digits when `hex`, and a point among them when `point`; `at` when there are none
fun digits_end(rd: *syntax.Reader, at: usize, hex: bool, point: bool) usize {
    var i:    usize = at;
    var seen: bool  = false;
    var dot:  bool  = false;
    for (i < rd.end) {
        val c: u8 = rd.text[i];
        if (point && !dot && c == '.')          { dot = true; }
        or (digit(c) || (hex && hexit(c) < 16)) { seen = true; }
        or                                      { brk; }
        i = i + 1;
    }
    if (!seen) { ret at; }
    ret i;
}

# the end of a signed exponent after its letter at `at`, `at` when there is none
fun exponent_end(rd: *syntax.Reader, at: usize) usize {
    var i: usize = at + 1;
    if (i < rd.end && (rd.text[i] == '-' || rd.text[i] == '+')) { i = i + 1; }
    val end: usize = digits_end(rd, i, false, false);
    if (end == i) { ret at; }
    ret end;
}

# the floating point literal at `at`, its end at `consumed`: a sign, then a decimal, a hexadecimal
# float with its `p` exponent, `inf`, `infinity` or `nan`, none when there is none. a decimal's exponent letter and sign
# with no digits after them are read and stand for no exponent, so `1e` is 1
pub fun float_literal(rd: *syntax.Reader, at: usize, consumed: *usize) opt[Float] {
    var i: usize = at;
    if (i < rd.end && (rd.text[i] == '-' || rd.text[i] == '+')) { i = i + 1; }
    val negative: bool = i > at && rd.text[at] == '-';
    if (i >= rd.end) { ret opt[Float].none{}; }
    val c: u8 = rd.text[i];
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
        val len:  usize     = read.token(rd, i);
        var form: FloatForm = FloatForm.nan{};
        if (float_word(rd, i, len, "inf") || float_word(rd, i, len, "infinity")) { form = FloatForm.infinity{}; }
        or (!float_word(rd, i, len, "nan"))                                      { ret opt[Float].none{}; }
        @consumed = i + len;
        ret opt[Float].some{Float{text: read.span(rd, at, i + len - at), form: form, negative: negative}};
    }
    if (c == '0' && i + 1 < rd.end && (rd.text[i + 1] == 'x' || rd.text[i + 1] == 'X')) {
        val digits: usize = digits_end(rd, i + 2, true, true);
        if (digits == i + 2 || digits >= rd.end || (rd.text[digits] != 'p' && rd.text[digits] != 'P')) { ret opt[Float].none{}; }
        val end: usize = exponent_end(rd, digits);
        if (end == digits) { ret opt[Float].none{}; }
        @consumed = end;
        ret opt[Float].some{Float{text: read.span(rd, at, end - at), form: FloatForm.hex{}, negative: negative}};
    }
    var end: usize = digits_end(rd, i, false, true);
    if (end == i) { ret opt[Float].none{}; }
    @consumed = end;
    if (end < rd.end && (rd.text[end] == 'e' || rd.text[end] == 'E')) {
        var j: usize = end + 1;
        if (j < rd.end && (rd.text[j] == '-' || rd.text[j] == '+')) { j = j + 1; }
        val exp: usize = digits_end(rd, j, false, false);
        if (exp == j) { @consumed = j; }
        or {
            end       = exp;
            @consumed = exp;
        }
    }
    ret opt[Float].some{Float{text: read.span(rd, at, end - at), form: FloatForm.decimal{}, negative: negative}};
}

# the pattern of `v` in format `f`, low bits first: a number rounded once from its text to the nearest of `f`, ties
# to even, into the subnormals and to infinity, and a nan with every fraction bit set
pub fun float_bits(v: Float, f: ieee.Format) res[u128, number.ParseError] {
    var sign: u128 = 0;
    if (v.negative)          { sign = ieee.sign_bit(f); }
    if (sel v.form.infinity) { ret res[u128, number.ParseError].ok{sign | ieee.inf_bits(f)}; }
    if (sel v.form.nan)      { ret res[u128, number.ParseError].ok{sign | ieee.inf_bits(f) | (ieee.hidden(f) - 1)}; }
    var radix: number.Radix = number.Radix.decimal{};
    if (sel v.form.hex) { radix = number.Radix.hex{}; }
    # parse's work for the widest format a decimal rounds into, its four bignums of f64's limbs. a format wider than
    # f64 rounds only hex text, which never touches it
    # the size copies std's private one until std publishes it, the std need #411 names under Limits
    var work: [4 * ieee.F64_LIMBS]u32;
    ret number.parse_float(f, radix, v.text.data, v.text.len, true, ?work[0]);
}

# how a float encoding spends the patterns ieee 754 gives its exponent field of all ones
# ---
# IEEE:    infinities and nans, as ieee 754's interchange formats, bfloat16 and ocp float8 e5m2
# ONE_NAN: finite values, but for the one nan of every exponent and fraction bit set, and no infinity, as ocp float8
#          e4m3: a value that rounds past the largest finite one, and an infinity, is that nan
# FINITE:  finite values only, as the ocp mx fp6 and fp4 formats: a value that rounds past the largest finite one is
#          refused
pub def Specials: u8;

pub val IEEE:    Specials = 0;
pub val ONE_NAN: Specials = 1;
pub val FINITE:  Specials = 2;

# a float encoding: the fields of its format and how it spends their patterns of an exponent field of all ones
pub rec Encoding {
    format:   ieee.Format;
    specials: Specials;
}

# the encoding of an ieee 754 format
pub fun ieee_encoding(f: ieee.Format) Encoding {
    ret Encoding{format: f, specials: IEEE};
}

# the format of one more exponent bit and the same bias as `e`'s, which holds every finite value of `e` at the same
# fields, its exponent field of all ones too
pub fun extended(e: Encoding) ieee.Format {
    ret ieee.Format{mant_bits: e.format.mant_bits, exp_bits: e.format.exp_bits + 1, bias: e.format.bias};
}

# the one nan of a ONE_NAN encoding's format `f`, its sign clear
fun only_nan(f: ieee.Format) u128 {
    ret ieee.inf_bits(f) | (ieee.hidden(f) - 1);
}

# the pattern of `v` in encoding `e`, low bits first, rounded once as `float_bits` rounds: an ieee encoding's as
# `float_bits` makes it, and another's rounded into its extended format, where every finite value it holds sits at its
# own fields, then past its largest finite value its nan or a refusal as its specials state
pub fun encoded_bits(v: Float, e: Encoding) res[u128, number.ParseError] {
    if (e.specials == IEEE) { ret float_bits(v, e.format); }
    val f:    ieee.Format = e.format;
    var sign: u128        = 0;
    if (v.negative) { sign = ieee.sign_bit(f); }
    if (sel v.form.infinity || sel v.form.nan) {
        if (e.specials == ONE_NAN) { ret res[u128, number.ParseError].ok{sign | only_nan(f)}; }
        ret res[u128, number.ParseError].err{number.ParseError.overflow{0}};
    }
    val wide: ieee.Format                  = extended(e);
    val got:  res[u128, number.ParseError] = float_bits(v, wide);
    if (sel got.err) { ret got; }
    val p:   ieee.Fields = ieee.fields(wide, got.ok);
    val top: i64         = ieee.exp_field_max(f);
    if (p.field > top || (e.specials == ONE_NAN && p.field == top && p.frac == ieee.hidden(f) - 1)) {
        if (e.specials == ONE_NAN) { ret res[u128, number.ParseError].ok{sign | only_nan(f)}; }
        ret res[u128, number.ParseError].err{number.ParseError.overflow{0}};
    }
    ret res[u128, number.ParseError].ok{sign | (p.field::u128 << f.mant_bits::u128) | p.frac};
}

# a pattern of an encoding as the ieee format whose fields mean what its fields mean
# ---
# format: the format, the encoding's own for an ieee one, its extended format for another
# bits:   the pattern in that format, a ONE_NAN encoding's nan the extended format's nan of the same fraction
pub rec Read {
    format: ieee.Format;
    bits:   u128;
}

# the pattern `bits` of encoding `e` as the ieee format whose fields mean what its fields mean, so a printer of ieee
# formats writes it, and its text rounds back to it by `encoded_bits`
pub fun as_ieee(e: Encoding, bits: u128) Read {
    if (e.specials == IEEE) { ret Read{format: e.format, bits: bits}; }
    val f:    ieee.Format = e.format;
    val wide: ieee.Format = extended(e);
    val p:    ieee.Fields = ieee.fields(f, bits);
    var sign: u128        = 0;
    if (p.neg)                                                              { sign = ieee.sign_bit(wide); }
    if (e.specials == ONE_NAN && (bits & ~ieee.sign_bit(f)) == only_nan(f)) { ret Read{format: wide, bits: sign | ieee.inf_bits(wide) | p.frac}; }
    ret Read{format: wide, bits: sign | (p.field::u128 << f.mant_bits::u128) | p.frac};
}

# one operand of kind `kind` read at the reader's position, for a row that reads its operands itself
pub fun read_item(m: *Assembler, rd: *syntax.Reader, kind: Item) res[Argument, diagnostic.Diagnostic] {
    ret item(m, rd, kind);
}

# one operand of kind `kind` read at the reader's position
fun item(m: *Assembler, rd: *syntax.Reader, kind: Item) res[Argument, diagnostic.Diagnostic] {
    val at: usize = rd.at;
    if (kind == NAME) {
        val v: res[View, diagnostic.Diagnostic] = symbol_name(m, rd);
        if (sel v.err) { ret res[Argument, diagnostic.Diagnostic].err{v.err}; }
        ret res[Argument, diagnostic.Diagnostic].ok{Argument.name{v.ok}};
    }
    if (kind == EXPRESSION) {
        val e: res[expr.Expr, diagnostic.Diagnostic] = expr.parse(rd, operand.NO_FIXUP);
        if (sel e.err) { ret res[Argument, diagnostic.Diagnostic].err{e.err}; }
        ret res[Argument, diagnostic.Diagnostic].ok{Argument.expression{e.ok}};
    }
    if (kind == STRING) {
        val s: res[View, diagnostic.Diagnostic] = string(m, rd);
        if (sel s.err) { ret res[Argument, diagnostic.Diagnostic].err{s.err}; }
        ret res[Argument, diagnostic.Diagnostic].ok{Argument.string{s.ok}};
    }
    if (kind == REGISTER) {
        val r: res[register.Id, diagnostic.Diagnostic] = read.register_value(rd, true);
        if (sel r.err) { ret res[Argument, diagnostic.Diagnostic].err{r.err}; }
        ret res[Argument, diagnostic.Diagnostic].ok{Argument.register{r.ok}};
    }
    if (kind == WORD) {
        if (prefix(m, read.peek(rd))) { rd.at = rd.at + 1; }
        val from: usize = rd.at;
        val len:  usize = read.name(rd);
        if (len == 0) { ret res[Argument, diagnostic.Diagnostic].err{read.refuse(rd, NOT_A_NAME, at, read.token(rd, at))}; }
        rd.at = from + len;
        ret res[Argument, diagnostic.Diagnostic].ok{Argument.word{read.span(rd, from, len)}};
    }
    var end: usize      = at;
    val f:   opt[Float] = float_literal(rd, at, ?end);
    if (sel f.none) { ret res[Argument, diagnostic.Diagnostic].err{read.refuse(rd, NOT_A_NUMBER, at, read.token(rd, at))}; }
    rd.at = end;
    ret res[Argument, diagnostic.Diagnostic].ok{Argument.float{f.some}};
}

# the operands of `shape` read over the reader into the assembler's items, an empty one absent where it is optional
fun operands(m: *Assembler, rd: *syntax.Reader, shape: *Shape) err[diagnostic.Diagnostic] {
    vector.truncate[Operand](?m.items, 0);
    read.skip(rd);
    if (shape.text)     { ret err[diagnostic.Diagnostic].ok{}; }
    if (shape.len == 0) { ret ended(rd); }
    if (read.peek(rd) == 0) {
        if (shape.least > 0) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, read.EXPECTED, rd.at, 0)}; }
        ret err[diagnostic.Diagnostic].ok{};
    }
    var k: u32 = 0;
    for {
        var kind: Item = shape.items[shape.len - 1];
        if (k < shape.len) { kind = shape.items[k]; }
        val at:    usize    = rd.at;
        val c:     u8       = read.peek(rd);
        var item_: Argument = Argument.absent{};
        if (c == ',' || c == 0) {
            if (k < shape.least) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, read.EXPECTED, at, 0)}; }
        }
        or {
            val got: res[Argument, diagnostic.Diagnostic] = item(m, rd, kind);
            if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
            item_ = got.ok;
        }
        if (!held(vector.push[Operand](?m.items, Operand{at: at, len: rd.at - at, value: item_}))) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, field.MEMORY, at, 0)}; }
        k = k + 1;
        read.skip(rd);
        if (!shape.repeat && k >= shape.len) { brk; }
        if (!read.take(rd, ","))             { brk; }
        read.skip(rd);
    }
    if (m.items.len < shape.least::usize) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, read.EXPECTED, rd.at, 0)}; }
    ret ended(rd);
}

# the refusal of text left after a statement's operands, at its column
pub fun ended(rd: *syntax.Reader) err[diagnostic.Diagnostic] {
    read.skip(rd);
    if (rd.at < rd.end) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, read.UNEXPECTED, rd.at, read.token(rd, rd.at))}; }
    ret err[diagnostic.Diagnostic].ok{};
}

fun stop(st: *source.Statement, d: diagnostic.Diagnostic) err[diagnostic.Diagnostic] {
    ret err[diagnostic.Diagnostic].err{d};
}

fun stop_at(st: *source.Statement, message: str, t: source.Token) err[diagnostic.Diagnostic] {
    ret stop(st, at_position(message, t.position, t.len));
}

# a label statement: a numbered label placed as the next definition of its number, or a named one
fun label_statement(m: *Assembler, st: *source.Statement) err[diagnostic.Diagnostic] {
    var name: View = source.bytes(st, st.head);
    # a quoted name is the name it spells, never a numbered label
    if (name.len >= 2 && name.data[0] == '"') {
        vector.truncate[u8](?m.strings, 0);
        val v: res[View, str] = unquoted(m, ?name.data[1], name.len - 2);
        if (sel v.err) { ret stop_at(st, v.err, st.head); }
        ret placed_label(m, st, v.ok);
    }
    val number: opt[u64] = number_of(name);
    if (sel number.some) {
        val state: res[*Numbered, str] = numbered_state(m, number.some);
        if (sel state.err) { ret stop_at(st, state.err, st.head); }
        val n:    *Numbered   = state.ok;
        var next: build.Label = build.Label{id: operand.NO_SYMBOL};
        if (sel n.next.some) { next = n.next.some; }
        if (next.id == operand.NO_SYMBOL) {
            val made: res[build.Label, build.Refusal] = build.anonymous(?m.b);
            if (sel made.err) { ret stop_at(st, made.err.message, st.head); }
            next = made.ok;
        }
        val placed: err[build.Refusal] = build.define(?m.b, next);
        if (sel placed.err) { ret stop_at(st, placed.err.message, st.head); }
        n.last = opt[build.Label].some{next};
        n.next = opt[build.Label].none{};
        ret err[diagnostic.Diagnostic].ok{};
    }
    ret placed_label(m, st, name);
}

# the label named `name` placed at the cursor by label statement `st`
fun placed_label(m: *Assembler, st: *source.Statement, name: View) err[diagnostic.Diagnostic] {
    val l: res[build.Label, str] = label_named(m, name);
    if (sel l.err) { ret stop_at(st, l.err, st.head); }
    val f: Facts = declared(m, l.ok.id);
    if (sel f.equated.some) { ret stop_at(st, EQUATED, st.head); }
    val placed: err[build.Refusal] = build.define(?m.b, l.ok);
    if (sel placed.err) { ret stop_at(st, placed.err.message, st.head); }
    ret err[diagnostic.Diagnostic].ok{};
}

# a symbolic operand value, or one a list, group or enumerant params holds, with `.` and a sequence's own label bound to
# the instruction's place and its label noted
fun claim(m: *Assembler, v: *operand.Value, at: diagnostic.Position, places: *Places) err[str] {
    if (sel v.symbol) {
        val id: res[u32, str] = bound_at(m, v.symbol.id, places);
        if (sel id.err) { ret err[str].err{id.err}; }
        v.symbol.id = id.ok;
        ret note(m, id.ok, at);
    }
    if (sel v.memory) {
        if (v.memory.symbol.id != operand.NO_SYMBOL) {
            val id: res[u32, str] = bound_at(m, v.memory.symbol.id, places);
            if (sel id.err) { ret err[str].err{id.err}; }
            v.memory.symbol.id = id.ok;
            ret note(m, id.ok, at);
        }
    }
    val inner: operand.Values = operand.inner(v);
    var i:     u32            = 0;
    for (i < inner.len) {
        val done: err[str] = claim(m, ?inner.at[i], at, places);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    ret err[str].ok{};
}

# an instruction statement read in the set's syntax and written, its `.` the place it is written at, then the selection
# widened by what its instructions widen it by
fun instruction_statement(m: *Assembler, st: *source.Statement) err[diagnostic.Diagnostic] {
    var len: usize = st.head.len;
    if (st.body.len > 0) { len = st.body.at + st.body.len - st.head.at; }
    # a statement no head starts is one only the syntax's statement hook reads
    if (st.head.len == 0 && m.syntax.statement == nil) { ret stop(st, at_position(source.MALFORMED, st.head.position, 1)); }
    var rd: syntax.Reader;
    var ex: relax.Expansion;
    # read again into stores grown to what the read found them short of. a read resolves the names it meets to the
    # same labels, and the stream's ids and types, each time it reads them, so a read again has no further effect
    for {
        rd = reader(m, st, st.head.at, len, st.head.position);
        val got:   err[diagnostic.Diagnostic] = parse.statement(?rd, ?ex);
        val again: res[bool, A.Error]         = syntax.regrown(?rd, ?m.stores);
        if (sel again.err) { ret stop_at(st, field.MEMORY, st.head); }
        if (again.ok)      { cnt; }
        if (sel got.err)   { ret stop(st, got.err); }
        brk;
    }
    var places: Places = Places{here: operand.NO_SYMBOL, own: operand.NO_SYMBOL};
    var i:      u32    = 0;
    for (i < ex.count) {
        var k: u32 = 0;
        for (k < ex.steps[i].row.operands.len) {
            val claimed: err[str] = claim(m, ?ex.steps[i].values[k], st.head.position, ?places);
            if (sel claimed.err) { ret stop_at(st, claimed.err, st.head); }
            k = k + 1;
        }
        i = i + 1;
    }
    val written: err[build.Refusal] = build.expansion(?m.b, ?ex);
    if (sel written.err) {
        var d: diagnostic.Diagnostic = at_position(written.err.message, st.head.position, st.head.len);
        if (sel written.err.encode.some) { d.requires = written.err.encode.some.requires; }
        ret stop(st, d);
    }
    val grown: err[diagnostic.Diagnostic] = widened_by(m, ?rd, ?ex);
    if (sel grown.err) { ret stop(st, grown.err); }
    ret err[diagnostic.Diagnostic].ok{};
}

# a directive statement: its row found by name, its operands read by the row's syntax, and its handler run
fun directive_statement(m: *Assembler, st: *source.Statement) err[diagnostic.Diagnostic] {
    val found: opt[*Entry] = find(m, source.bytes(st, st.head));
    if (sel found.none) { ret stop_at(st, UNKNOWN_DIRECTIVE, st.head); }
    val row: *Directive = found.some.directive;
    vector.truncate[u8](?m.strings, 0);
    if (!held(vector.reserve[u8](?m.strings, st.body.len))) { ret stop_at(st, field.MEMORY, st.head); }
    # a quoted name's escapes read into the literal bytes, which never hold more than the body, so no read of a
    # directive's operands finds them short
    if (!held(vector.ensure[u8](?m.stores.bytes, st.body.len))) { ret stop_at(st, field.MEMORY, st.head); }
    var rd:    syntax.Reader              = reader(m, st, st.body.at, st.body.len, st.body.position);
    val read_: err[diagnostic.Diagnostic] = operands(m, ?rd, ?row.operands);
    if (sel read_.err) { ret stop(st, read_.err); }
    var args: Args                       = Args{directive: row, layer: found.some.layer, statement: st, reader: ?rd, items: m.items.data, count: m.items.len::u32};
    val done: err[diagnostic.Diagnostic] = row.handler(m, ?args);
    if (sel done.err) { ret stop(st, done.err); }
    if (row.operands.text) {
        val rest: err[diagnostic.Diagnostic] = ended(?rd);
        if (sel rest.err) { ret stop(st, rest.err); }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# one statement read and written, its refusal at the place the file being assembled states it, `st.site`
fun statement(m: *Assembler, st: *source.Statement) err[diagnostic.Diagnostic] {
    m.names.context = m::ptr;
    m.site          = st.site;
    if (st.kind == source.LABEL)     { ret label_statement(m, st); }
    if (st.kind == source.DIRECTIVE) { ret directive_statement(m, st); }
    ret instruction_statement(m, st);
}

# every statement of `feed` read and written, to its end or the first refusal
pub fun run(m: *Assembler, feed: *source.Feed) err[Refusal] {
    var st: source.Statement;
    for {
        val more: res[bool, diagnostic.Diagnostic] = feed.next(feed.context, ?st);
        if (sel more.err) { ret err[Refusal].err{resolved(m, more.err, more.err.span.start)}; }
        if (!more.ok)     { brk; }
        val done: err[diagnostic.Diagnostic] = statement(m, ?st);
        if (sel done.err) { ret err[Refusal].err{resolved(m, done.err, st.site)}; }
    }
    ret err[Refusal].ok{};
}

fun refused_at(message: str, f: Facts) Refusal {
    var p: diagnostic.Position = diagnostic.START;
    if (sel f.used.some) { p = f.used.some; }
    ret Refusal{message: message, span: diagnostic.Span{start: p, len: 0}, site: p, mode: opt[build.Mismatch].none{}, unmet: state.nothing_unmet()};
}

# the refusal of `d`, stated at `site`, with what it needed resolved against the view in force, which the assembler
# releases before its caller reads the refusal, and refused as `UNMET_FULL` when that is more than an unmet
# requirement holds
fun resolved(m: *Assembler, d: diagnostic.Diagnostic, site: diagnostic.Position) Refusal {
    ret diagnosed(d, site, build.view(?m.b));
}

# the refusal of `d`, stated at `site`, with what it needed resolved against the context `view`, and refused as
# `UNMET_FULL` when that is more than an unmet requirement holds
pub fun diagnosed(d: diagnostic.Diagnostic, site: diagnostic.Position, view: *state.Context) Refusal {
    var r: Refusal = Refusal{message: d.message, span: d.span, site: site, mode: opt[build.Mismatch].none{}, unmet: state.nothing_unmet()};
    if (d.requires.len == 0)                      { ret r; }
    if (!state.unmet(view, d.requires, ?r.unmet)) { r.message = UNMET_FULL; }
    ret r;
}

# whether `v` starts with `prefix`
fun starts_with(v: View, prefix: str) bool {
    val n: usize = str_len(prefix);
    if (n == 0 || v.len < n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# every label given its value and made a symbol
fun symbols(m: *Assembler) err[Refusal] {
    var it: map.Iter = map.iter[u64, Numbered](?m.numbered);
    var e:  map.Entry[u64, Numbered];
    for (map.next[u64, Numbered](?m.numbered, ?it, ?e)) {
        if (sel e.value.next.some) {
            val f: Facts = declared(m, e.value.next.some.id);
            if (sel f.used.some) { ret err[Refusal].err{refused_at(NEVER_AFTER, f)}; }
        }
    }
    val count: usize = m.b.labels.len;
    var id:    usize = 1;
    for (id <= count) {
        val l:     build.Label = build.Label{id: id::u32};
        val f:     Facts       = declared(m, l.id);
        val label: opt[View]   = build.label_name(?m.b, l);
        id = id + 1;
        if (sel f.equated.some) {
            val v: expr.Expr = f.equated.some;
            if (sel v.difference) {
                if (sel f.used.some)                                            { ret err[Refusal].err{refused_at(LATE_DIFFERENCE, f)}; }
                if (sel f.binding.some && f.binding.some != ?mink_symbol.LOCAL) { ret err[Refusal].err{refused_at(SHOWN_DIFFERENCE, f)}; }
                cnt;
            }
            var given_: err[build.Refusal] = err[build.Refusal].ok{};
            if (sel v.constant) { given_ = build.absolute(?m.b, l, v.constant:~u64); }
            if (sel v.symbol)   { given_ = build.equate(?m.b, l, build.Label{id: v.symbol.id}, v.symbol.addend); }
            if (sel given_.err) { ret err[Refusal].err{refused_at(given_.err.message, f)}; }
        }
        val bound_:  bool                 = build.bound(?m.b, l);
        var binding: *mink_symbol.Binding = ?mink_symbol.LOCAL;
        if (sel f.binding.some) { binding = f.binding.some; }
        or (!bound_) {
            # a name only referred to is another object's
            if (sel f.used.none) { cnt; }
            binding = ?mink_symbol.GLOBAL;
        }
        if (binding == ?mink_symbol.LOCAL) {
            if (!bound_) {
                if (sel f.used.some) { ret err[Refusal].err{refused_at(LOCAL_UNDEFINED, f)}; }
                cnt;
            }
            if (sel label.none)                             { cnt; }
            if (starts_with(label.some, m.dialect.private)) { cnt; }
        }
        var shown: build.Exposure = build.Exposure{binding: binding, visibility: ?mink_symbol.DEFAULT, kind: ?mink_symbol.NOTYPE, size: f.size};
        if (sel f.visibility.some) { shown.visibility = f.visibility.some; }
        if (sel f.kind.some)       { shown.kind = f.kind.some; }
        val exposed: err[build.Refusal] = build.expose(?m.b, l, shown);
        if (sel exposed.err) { ret err[Refusal].err{refused_at(exposed.err.message, f)}; }
    }
    ret err[Refusal].ok{};
}

# what every layer writes at the end, every label made a symbol, and mink's neutral object handed over, which the
# caller releases. a builder refusal about a label is placed where the source first referred to it, and one about a
# view at the statement that first put it in force
pub fun finish(m: *Assembler) res[mink_object.Object, Refusal] {
    m.names.context = m::ptr;
    var i: usize = 0;
    for (i < m.layers.len) {
        val l:    *Layer       = m.layers.data[i];
        val done: err[Refusal] = l.finish(l.context, m);
        if (sel done.err) { ret res[mink_object.Object, Refusal].err{done.err}; }
        i = i + 1;
    }
    val made: err[Refusal] = symbols(m);
    if (sel made.err) { ret res[mink_object.Object, Refusal].err{made.err}; }
    val o: res[mink_object.Object, build.Refusal] = build.finish(?m.b);
    if (sel o.err) {
        var r: Refusal = refused_at(o.err.message, declared(m, o.err.label));
        if (o.err.view != nil) {
            val p: diagnostic.Position = entered(m, o.err.view);
            r.span = diagnostic.Span{start: p, len: 0};
            r.site = p;
        }
        r.cause = o.err.object;
        ret res[mink_object.Object, Refusal].err{r};
    }
    ret res[mink_object.Object, Refusal].ok{o.ok};
}

# where the file being assembled states the statement that first put view `v` in force, the start for the object's own
fun entered(m: *Assembler, v: *state.Context) diagnostic.Position {
    var i: usize = 0;
    for (i < m.bases.len) {
        val kept: *vector.Vector[Kept] = ?m.bases.data[i].kept;
        var j:    usize                = 0;
        for (j < kept.len) {
            if (?kept.data[j].view.context == v) { ret kept.data[j].site; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret diagnostic.START;
}

# no operands
pub val NO_ITEMS: Shape = Shape{items: nil, len: 0, least: 0, repeat: false, text: false};

# one name, as `.option push`
pub val ONE: Shape = Shape{items: ?ONE_NAME[0], len: 1, least: 1, repeat: false, text: false};

# operands the handler reads itself
pub val TEXT: Shape = Shape{items: nil, len: 0, least: 0, repeat: false, text: true};

val ONE_NAME:       [1]Item = [1]Item{NAME};
val ONE_EXPRESSION: [1]Item = [1]Item{EXPRESSION};
val ONE_STRING:     [1]Item = [1]Item{STRING};
val ONE_FLOAT:      [1]Item = [1]Item{FLOAT};

# a list of names, as `.globl a, b`
pub val NAMES: Shape = Shape{items: ?ONE_NAME[0], len: 1, least: 1, repeat: true, text: false};

# a list of expressions, as `.long 1, x`
pub val EXPRESSIONS: Shape = Shape{items: ?ONE_EXPRESSION[0], len: 1, least: 1, repeat: true, text: false};

# a list of strings, as `.ascii "a", "b"`
pub val STRINGS: Shape = Shape{items: ?ONE_STRING[0], len: 1, least: 1, repeat: true, text: false};

# a list of floating point numbers, as `.double 1.5`
pub val FLOATS: Shape = Shape{items: ?ONE_FLOAT[0], len: 1, least: 1, repeat: true, text: false};
