# the source dialect of x86's gnu assembler, as llvm-mc 23.1.1 reads it
#
# a comment runs from `#` to the end of its line and `;` ends a statement. `.align` takes bytes, and `.word` is two
# bytes, as the gnu assembler has them on x86 (gas manual, "Machine Dependencies", i386 "Alignment" and ".word"). the
# code width is the width axis of the set's state, which `.code16`, `.code32` and `.code64` switch within an object
# (gas manual, i386 "16-bit Mode"), and `.intel_syntax` reads what follows in intel's syntax, the set's one syntax, as
# the established syntax llvm-mc 23.1.1 starts in is at&t's, which masc does not yet read, so `.att_syntax` is refused
#
# an x86 instruction's length is its encoding's, which no first byte states, so the parcel undecodable code is stepped
# over in is one byte, as the processor resumes at the next

use std.types.size.usize;
use std.types.string.str;

use masc.core.source;
use masc.core.state;

val WIDTHS: [6]source.Width = [6]source.Width{
    source.Width{name: ".byte", width: 1},
    source.Width{name: ".short", width: 2},
    source.Width{name: ".value", width: 2},
    source.Width{name: ".word", width: 2},
    source.Width{name: ".long", width: 4},
    source.Width{name: ".quad", width: 8},
};

# the width axis is the first, its values 16, 32 and 64 bits (masc.isa.x86.extension.AXES)
# the refusal of `.att_syntax`, which reads what follows in at&t's syntax
pub val ATT: str = "AT&T syntax is not yet supported, x86 is read in Intel syntax";

val DIRECTIVES: [5]source.Directive = [5]source.Directive{
    source.Directive{name: ".code16", operands: source.Shape{word: "", takes: source.TAKES_NOTHING}, edit: source.Edit.state{state.Placed{axis: 0, value: 0}}},
    source.Directive{name: ".code32", operands: source.Shape{word: "", takes: source.TAKES_NOTHING}, edit: source.Edit.state{state.Placed{axis: 0, value: 1}}},
    source.Directive{name: ".code64", operands: source.Shape{word: "", takes: source.TAKES_NOTHING}, edit: source.Edit.state{state.Placed{axis: 0, value: 2}}},
    source.Directive{name: ".intel_syntax", operands: source.Shape{word: "noprefix", takes: source.TAKES_NOTHING}, edit: source.Edit.syntax{0}},
    source.Directive{name: ".att_syntax", operands: source.Shape{word: "", takes: source.TAKES_NOTHING}, edit: source.Edit.unsupported{ATT}},
};

# the dialect of x86's gnu assembler. it states no mapping symbols
pub val SOURCE: source.Source = source.Source{comment: "#", separator: ';', types: "@%", align: source.ALIGN_BYTES, widths: source.Widths{at: ?WIDTHS[0], len: 6}, directives: source.Directives{at: ?DIRECTIVES[0], len: 5}, mapping: source.NO_MAPPING};

# the code at `at` as one byte
pub fun parcel(data: *u8, len: usize, at: usize) usize {
    if (at >= len) { ret 0; }
    ret 1;
}
