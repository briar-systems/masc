# the x86 encoding form: the choices among the encodings of one instruction that its values leave open
#
# a choice is bits of the instruction's form (masc.core.form), which decode
# writes where the bytes read are not the ones the zero form would write and
# encode reads, so every encoding a row decodes encodes back to its bytes.
# the zero form is the preference, the encoding llvm-mc 23.1.1 writes.
#
# the choices llvm-mc and the gnu assembler spell as pseudo-prefixes have their
# markers: {disp8} and {disp32}, the displacement's width where a shorter one
# would do, {rex} and {rex2}, a prefix no register needs, {load} and {store},
# the direction of a register-to-register form that has both, and {vex3},
# {evex} and {vex}, the vex prefix's long form and the encoding space. the
# rest have no marker, as no assembler spells them:
#   sib            a SIB byte the address does not need
#   address        an address-size override on an address no register states the size of, an absolute address,
#                  a rip-relative one or an a0 to a3 move's, which is then the other size the code width reaches
#   payload bits   the bits of a rex, rex2, vex or evex prefix that no operand decides, in the rex2 payload's order:
#                  b3, x3, r3, w, b4, x4 and r4, one form bit each from bit 8. a rex prefix holds the first four, and a
#                  vex or evex prefix holds any of them but b4, x4 and r4 free, as w of a row that ignores it
#   length         the vector length a vex or evex prefix holds where its row ignores it, as of a scalar operation
#                  or beside sae, two bits from bit 29
#   prefix slots   the legacy prefixes as read, three slots of four bits from bit 15, each 0 for none or the
#                  position of its byte in PREFIXES plus one, written in place of the canonical run when it is not
#                  the one the instruction's values give, as a repeated, ignored or reordered prefix. a longer run
#                  is refused when it is not the canonical one

use std.types.bool.false;

use masc.core.form;

pub val DISP:   u32 = 0x3;
pub val DISP8:  u32 = 0x1;
pub val DISP32: u32 = 0x2;

pub val REX:  u32 = 0x4;
pub val REX2: u32 = 0x8;

pub val DIRECTION: u32 = 0x30;
pub val LOAD:      u32 = 0x10;
pub val STORE:     u32 = 0x20;

pub val ENCODING: u32 = 0xC0;
pub val VEX3:     u32 = 0x40;
pub val EVEX:     u32 = 0x80;
pub val VEX:      u32 = 0xC0;

pub val SIB: u32 = 0x0800_0000;

pub val ADDRESS: u32 = 0x1000_0000;

pub val LENGTH:       u32 = 0x6000_0000;
pub val LENGTH_SHIFT: u32 = 29;

# the payload bits as form bits, and the shift from payload bit to form bit
pub val PAYLOAD:       u32 = 0x7F00;
pub val PAYLOAD_SHIFT: u32 = 8;

# the prefix slots, each SLOT_BITS wide from bit SLOTS_SHIFT
pub val SLOTS:       u32 = 0x07FF_8000;
pub val SLOTS_SHIFT: u32 = 15;
pub val SLOT_BITS:   u32 = 4;
pub val SLOT_COUNT:  u32 = 3;

# the legacy prefixes a slot names by position plus one
pub val PREFIXES: [11]u8 = [11]u8{0xF0, 0xF2, 0xF3, 0x2E, 0x36, 0x3E, 0x26, 0x64, 0x65, 0x66, 0x67};

pub val PREFIX_COUNT: u32 = 11;

# every choice, one row a value of a field
val ROWS: [54]form.FormField = [54]form.FormField{
    form.FormField{name: "disp8", mask: DISP, value: DISP8, marker: "{disp8}", suffix: false},
    form.FormField{name: "disp32", mask: DISP, value: DISP32, marker: "{disp32}", suffix: false},
    form.FormField{name: "rex", mask: REX, value: REX, marker: "{rex}", suffix: false},
    form.FormField{name: "rex2", mask: REX2, value: REX2, marker: "{rex2}", suffix: false},
    form.FormField{name: "load", mask: DIRECTION, value: LOAD, marker: "{load}", suffix: false},
    form.FormField{name: "store", mask: DIRECTION, value: STORE, marker: "{store}", suffix: false},
    form.FormField{name: "vex3", mask: ENCODING, value: VEX3, marker: "{vex3}", suffix: false},
    form.FormField{name: "evex", mask: ENCODING, value: EVEX, marker: "{evex}", suffix: false},
    form.FormField{name: "vex", mask: ENCODING, value: VEX, marker: "{vex}", suffix: false},
    form.FormField{name: "sib", mask: SIB, value: SIB, marker: nil, suffix: false},
    form.FormField{name: "address", mask: ADDRESS, value: ADDRESS, marker: nil, suffix: false},
    form.FormField{name: "payload bit 0", mask: 0x100, value: 0x100, marker: nil, suffix: false},
    form.FormField{name: "payload bit 1", mask: 0x200, value: 0x200, marker: nil, suffix: false},
    form.FormField{name: "payload bit 2", mask: 0x400, value: 0x400, marker: nil, suffix: false},
    form.FormField{name: "payload bit 3", mask: 0x800, value: 0x800, marker: nil, suffix: false},
    form.FormField{name: "payload bit 4", mask: 0x1000, value: 0x1000, marker: nil, suffix: false},
    form.FormField{name: "payload bit 5", mask: 0x2000, value: 0x2000, marker: nil, suffix: false},
    form.FormField{name: "payload bit 6", mask: 0x4000, value: 0x4000, marker: nil, suffix: false},
    form.FormField{name: "prefix 1 f0", mask: 0x78000, value: 0x8000, marker: nil, suffix: false},
    form.FormField{name: "prefix 1 f2", mask: 0x78000, value: 0x10000, marker: nil, suffix: false},
    form.FormField{name: "prefix 1 f3", mask: 0x78000, value: 0x18000, marker: nil, suffix: false},
    form.FormField{name: "prefix 1 2e", mask: 0x78000, value: 0x20000, marker: nil, suffix: false},
    form.FormField{name: "prefix 1 36", mask: 0x78000, value: 0x28000, marker: nil, suffix: false},
    form.FormField{name: "prefix 1 3e", mask: 0x78000, value: 0x30000, marker: nil, suffix: false},
    form.FormField{name: "prefix 1 26", mask: 0x78000, value: 0x38000, marker: nil, suffix: false},
    form.FormField{name: "prefix 1 64", mask: 0x78000, value: 0x40000, marker: nil, suffix: false},
    form.FormField{name: "prefix 1 65", mask: 0x78000, value: 0x48000, marker: nil, suffix: false},
    form.FormField{name: "prefix 1 66", mask: 0x78000, value: 0x50000, marker: nil, suffix: false},
    form.FormField{name: "prefix 1 67", mask: 0x78000, value: 0x58000, marker: nil, suffix: false},
    form.FormField{name: "prefix 2 f0", mask: 0x780000, value: 0x80000, marker: nil, suffix: false},
    form.FormField{name: "prefix 2 f2", mask: 0x780000, value: 0x100000, marker: nil, suffix: false},
    form.FormField{name: "prefix 2 f3", mask: 0x780000, value: 0x180000, marker: nil, suffix: false},
    form.FormField{name: "prefix 2 2e", mask: 0x780000, value: 0x200000, marker: nil, suffix: false},
    form.FormField{name: "prefix 2 36", mask: 0x780000, value: 0x280000, marker: nil, suffix: false},
    form.FormField{name: "prefix 2 3e", mask: 0x780000, value: 0x300000, marker: nil, suffix: false},
    form.FormField{name: "prefix 2 26", mask: 0x780000, value: 0x380000, marker: nil, suffix: false},
    form.FormField{name: "prefix 2 64", mask: 0x780000, value: 0x400000, marker: nil, suffix: false},
    form.FormField{name: "prefix 2 65", mask: 0x780000, value: 0x480000, marker: nil, suffix: false},
    form.FormField{name: "prefix 2 66", mask: 0x780000, value: 0x500000, marker: nil, suffix: false},
    form.FormField{name: "prefix 2 67", mask: 0x780000, value: 0x580000, marker: nil, suffix: false},
    form.FormField{name: "prefix 3 f0", mask: 0x7800000, value: 0x800000, marker: nil, suffix: false},
    form.FormField{name: "prefix 3 f2", mask: 0x7800000, value: 0x1000000, marker: nil, suffix: false},
    form.FormField{name: "prefix 3 f3", mask: 0x7800000, value: 0x1800000, marker: nil, suffix: false},
    form.FormField{name: "prefix 3 2e", mask: 0x7800000, value: 0x2000000, marker: nil, suffix: false},
    form.FormField{name: "prefix 3 36", mask: 0x7800000, value: 0x2800000, marker: nil, suffix: false},
    form.FormField{name: "prefix 3 3e", mask: 0x7800000, value: 0x3000000, marker: nil, suffix: false},
    form.FormField{name: "prefix 3 26", mask: 0x7800000, value: 0x3800000, marker: nil, suffix: false},
    form.FormField{name: "prefix 3 64", mask: 0x7800000, value: 0x4000000, marker: nil, suffix: false},
    form.FormField{name: "prefix 3 65", mask: 0x7800000, value: 0x4800000, marker: nil, suffix: false},
    form.FormField{name: "prefix 3 66", mask: 0x7800000, value: 0x5000000, marker: nil, suffix: false},
    form.FormField{name: "prefix 3 67", mask: 0x7800000, value: 0x5800000, marker: nil, suffix: false},
    form.FormField{name: "length 1", mask: LENGTH, value: 0x2000_0000, marker: nil, suffix: false},
    form.FormField{name: "length 2", mask: LENGTH, value: 0x4000_0000, marker: nil, suffix: false},
    form.FormField{name: "length 3", mask: LENGTH, value: 0x6000_0000, marker: nil, suffix: false},
};

pub val FIELDS: form.FormFields = form.FormFields{at: ?ROWS[0], len: 54};
