# the kinds, by their index in TABLE
pub val UNIT_KIND:   u16 = 0;
pub val HEAD_KIND:   u16 = 1;
pub val MODRM_KIND:  u16 = 2;
pub val MOFFS_KIND:  u16 = 3;
pub val STRING_KIND: u16 = 4;

pub val HIGH_BYTE:       str = "high byte register beside a rex prefix";
pub val REX_WIDTH:       str = "register or form needs a rex prefix, which only 64-bit code has";
pub val REX2_MAP:        str = "rex2 prefix reaches no map but 0 and 1";
pub val REX2_ROW:        str = "row admits no rex2 prefix";
pub val REX_FORM:        str = "form asks for a rex prefix where a register needs rex2";
pub val PCREL_WIDTH:     str = "rip-relative address outside 64-bit code";
pub val ADDRESS:         str = "address the code width's addressing cannot form";
pub val DISPLACEMENT:    str = "displacement out of the address size's range";
pub val NO_SCALE:        str = "scale given with no index";
pub val RUN:             str = "prefix run does not state the instruction's prefixes";
pub val LONG_RUN:        str = "prefix run longer than the form restates";
pub val IGNORED_REX:     str = "rex prefix the processor ignores";
pub val LONG:            str = "instruction longer than 15 bytes";
pub val OTHER_ROW:       str = "form selects another encoding of the instruction";
pub val OVERRIDE:        str = "address-size override the address's registers do not state";
pub val LOCK:            str = "lock prefix the row does not admit";
pub val REFINED:         str = "rex2 prefix with W set encodes another instruction";
pub val NO_RECORD:       str = "x86 field reads no opcode record";
pub val RECORD:          str = "x86 opcode record names an operand of the wrong shape, or a map, size or digit it cannot encode";
pub val VEX_REACH:       str = "register past 15, which a vex prefix cannot reach";
pub val REACH_WIDTH:     str = "register past 7, which only 64-bit code reaches";
pub val UNMASKED:        str = "zeroing masking with no mask";
pub val VEX_PREFIX:      str = "66, f0, f2 or f3 before a vex or evex prefix";
pub val UNREAD_BITS:     str = "vex or evex bits the row reads no operand from are set";
pub val ZEROING_STORE:   str = "zeroing masking on a store, whose destination is memory";
pub val ROUNDING_MEMORY: str = "embedded rounding on a memory form, where evex.b is a broadcast";
pub val BROADCAST_SPACE: str = "broadcast on a row of no evex encoding or no element";
pub val NO_INDEX:        str = "vector-indexed address with no index";
pub val STRING_SIZE:     str = "string memory of another address size than the row's";

# the longest instruction
pub val MAX_LENGTH: usize = 15;

# the segment prefixes, by segment register number: es, cs, ss, ds, fs and gs
pub val SEGMENTS: [6]u8 = [6]u8{0x26, 0x2E, 0x36, 0x3E, 0x64, 0x65};

# the number of ds among the segment registers
val DS_NUMBER: u64 = 3;

# the rex and rex2 payload bits, in the rex2 payload's order, a rex prefix holding the low four
pub val B3: u8 = 0x01;
pub val X3: u8 = 0x02;
pub val R3: u8 = 0x04;
pub val W:  u8 = 0x08;
pub val B4: u8 = 0x10;
pub val X4: u8 = 0x20;
pub val R4: u8 = 0x40;
pub val M0: u8 = 0x80;

# the code width of `ctx`: 16, 32 or 64
pub fun width(ctx: *state.Context) u8 {
    if (state.holds(ctx, x86_extension.id.WIDTH_64)) { ret 64; }
    if (state.holds(ctx, x86_extension.id.WIDTH_32)) { ret 32; }
    ret 16;
}

# the address size of code of width `w` with an address-size override or without
pub fun address_size(w: u8, overridden: bool) u8 {
    if (w == 64) {
        if (overridden) { ret 32; }
        ret 64;
    }
    if (w == 32) {
        if (overridden) { ret 16; }
        ret 32;
    }
    if (overridden) { ret 32; }
    ret 16;
}

# whether form `f` asks for an address-size override on an address no register states the size of
pub fun overridden(f: form.Form) bool {
    ret (f.bits & x86_form.ADDRESS) != 0;
}

# the prefixes of an instruction, as read from its start
# ---
# run:     its legacy prefixes in order
# count:   how many there are
# segment: the last segment prefix, 0 for none
# osz:     whether it holds 66
# asz:     whether it holds 67
# lock:    whether it holds f0
# rep:     the last of f2 and f3, 0 for neither
# rex:     whether it holds a rex prefix
# rex2:    whether it holds a rex2 prefix
# payload: the rex prefix's low four bits or the rex2 payload, as B3 to M0 name them, or the same bits of a vex or evex
#          prefix, uninverted: r, x, b and w, and evex's r', b4 and x4
# vex:     the vex, evex or xop prefix byte, c4, c5, 62 or 8f, 0 for none
# bytes:   its payload bytes
# space:   the encoding space
# map:     the opcode map, NOW_MAP for 3dnow's 0f 0f
# opcode:  the offset of the opcode byte, or of 3dnow's second 0f, whose opcode follows ModRM and its displacement
# vvvv:    the register number vex.vvvv, xop.vvvv, or evex.vvvv and v', hold, uninverted
# length:  vex.l or evex.l'l
# pp:      vex.pp or evex.pp
# aaa:     evex.aaa
# z:       evex.z
# b:       evex.b
pub rec Prefixes {
    run:     [15]u8;
    count:   u8;
    segment: u8;
    osz:     bool;
    asz:     bool;
    lock:    bool;
    rep:     u8;
    rex:     bool;
    rex2:    bool;
    payload: u8;
    vex:     u8;
    bytes:   [3]u8;
    space:   Space;
    map:     u8;
    opcode:  usize;
    vvvv:    u8;
    length:  u8;
    pp:      u8;
    aaa:     u8;
    z:       bool;
    b:       bool;
}

# whether `b` is a legacy prefix
pub fun legacy(b: u8) bool {
    var i: u32 = 0;
    for (i < x86_form.PREFIX_COUNT) {
        if (x86_form.PREFIXES[i] == b) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun byte_at(s: *field.Stream, at: usize) res[u8, field.Refusal] {
    val got: res[u64, field.Refusal] = field.read(s, at, 1);
    if (sel got.err) { ret res[u8, field.Refusal].err{got.err}; }
    ret res[u8, field.Refusal].ok{got.ok::u8};
}

fun refused[T](message: str, at: usize) res[T, field.Refusal] {
    ret res[T, field.Refusal].err{field.refusal(message, field.NO_OPERAND, at)};
}

# the prefixes of the instruction at `at` of `s` in code of width `w`
# ---
# ret: the prefixes, or a refusal: the stream ends, the prefixes run past the longest instruction, or a rex prefix is
#      one the processor ignores, followed by a legacy prefix, another rex or a rex2, vex, evex or xop prefix
pub fun scan(s: *field.Stream, at: usize, w: u8) res[Prefixes, field.Refusal] {
    var p: Prefixes;
    var i: usize = at;
    for {
        if (i - at >= MAX_LENGTH) { ret refused[Prefixes](LONG, i); }
        val got: res[u8, field.Refusal] = byte_at(s, i);
        if (sel got.err) { ret res[Prefixes, field.Refusal].err{got.err}; }
        val b: u8 = got.ok;
        if (legacy(b)) {
            if (p.rex) { ret refused[Prefixes](IGNORED_REX, i); }
            p.run[p.count] = b;
            p.count        = p.count + 1;
            if (b == 0x66)              { p.osz = true; }
            or (b == 0x67)              { p.asz = true; }
            or (b == 0xF0)              { p.lock = true; }
            or (b == 0xF2 || b == 0xF3) { p.rep = b; }
            or                          { p.segment = b; }
            i = i + 1;
            cnt;
        }
        if (w == 64 && b >= 0x40 && b <= 0x4F) {
            if (p.rex) { ret refused[Prefixes](IGNORED_REX, i); }
            p.rex     = true;
            p.payload = b & 0x0F;
            i         = i + 1;
            cnt;
        }
        brk;
    }
    val first: res[u8, field.Refusal] = byte_at(s, i);
    if (sel first.err) { ret res[Prefixes, field.Refusal].err{first.err}; }
    val b: u8 = first.ok;
    if (w == 64 && b == 0xD5) {
        if (p.rex) { ret refused[Prefixes](IGNORED_REX, i); }
        val payload: res[u8, field.Refusal] = byte_at(s, i + 1);
        if (sel payload.err) { ret res[Prefixes, field.Refusal].err{payload.err}; }
        p.rex2    = true;
        p.payload = payload.ok;
        p.map     = (payload.ok >> 7) & 1;
        p.opcode  = i + 2;
        ret res[Prefixes, field.Refusal].ok{p};
    }
    if (b == 0xC4 || b == 0xC5 || b == 0x62) {
        # outside 64-bit code these are les, lds and bound unless the next byte's top two bits are set
        val next: res[u8, field.Refusal] = byte_at(s, i + 1);
        if (sel next.err) { ret res[Prefixes, field.Refusal].err{next.err}; }
        if (w == 64 || (next.ok & 0xC0) == 0xC0) {
            if (p.rex) { ret refused[Prefixes](IGNORED_REX, i); }
            p.vex = b;
            var n: usize = 1;
            if (b == 0xC4) { n = 2; }
            if (b == 0x62) { n = 3; }
            var k: usize = 0;
            for (k < n) {
                val more: res[u8, field.Refusal] = byte_at(s, i + 1 + k);
                if (sel more.err) { ret res[Prefixes, field.Refusal].err{more.err}; }
                p.bytes[k] = more.ok;
                k          = k + 1;
            }
            unpack_vex(?p);
            p.opcode = i + 1 + n;
            ret res[Prefixes, field.Refusal].ok{p};
        }
    }
    if (b == 0x8F) {
        # 8f is pop's unless the next byte's map field is 8 or more, which a ModRM.reg of 0 never is (AMD APM 24594 Vol
        # 3 1.8.1)
        val next: res[u8, field.Refusal] = byte_at(s, i + 1);
        if (sel next.err) { ret res[Prefixes, field.Refusal].err{next.err}; }
        if ((next.ok & 0x1F) >= 8) {
            if (p.rex) { ret refused[Prefixes](IGNORED_REX, i); }
            val tail: res[u8, field.Refusal] = byte_at(s, i + 2);
            if (sel tail.err) { ret res[Prefixes, field.Refusal].err{tail.err}; }
            p.vex      = b;
            p.bytes[0] = next.ok;
            p.bytes[1] = tail.ok;
            unpack_vex(?p);
            p.opcode = i + 3;
            ret res[Prefixes, field.Refusal].ok{p};
        }
    }
    if (b != 0x0F) {
        p.opcode = i;
        ret res[Prefixes, field.Refusal].ok{p};
    }
    val second: res[u8, field.Refusal] = byte_at(s, i + 1);
    if (sel second.err) { ret res[Prefixes, field.Refusal].err{second.err}; }
    p.map    = 1;
    p.opcode = i + 1;
    if (second.ok == 0x38) {
        p.map    = 2;
        p.opcode = i + 2;
    }
    or (second.ok == 0x3A) {
        p.map    = 3;
        p.opcode = i + 2;
    }
    or (second.ok == 0x0F) { p.map = NOW_MAP; }
    ret res[Prefixes, field.Refusal].ok{p};
}

# payload bit `bit` when `set`
fun bit_if(set: bool, bit: u8) u8 {
    if (set) { ret bit; }
    ret 0;
}

# the space, map and fields of the vex, evex or xop prefix `p` holds, its inverted bits read uninverted (Intel SDM
# 325462-093US Vol 2A 2.3.5 and 2.7.1, Intel APX 355828-009US 3.1.2.3, AMD APM 24594 Vol 3 1.8)
fun unpack_vex(p: *Prefixes) {
    val first: u8 = p.bytes[0];
    p.space = VEX;
    p.map   = 1;
    if (p.vex == 0x8F) { p.space = XOP; }
    var tail: u8 = first;
    if (p.vex == 0xC5) { p.payload = bit_if((first & 0x80) == 0, R3); }
    or {
        p.payload = bit_if((first & 0x80) == 0, R3) | bit_if((first & 0x40) == 0, X3) | bit_if((first & 0x20) == 0, B3);
        tail      = p.bytes[1];
    }
    if (p.vex == 0xC4 || p.vex == 0x8F) { p.map = first & 0x1F; }
    if (p.vex == 0x62) {
        p.space   = EVEX;
        p.map     = first & 0x07;
        p.payload = p.payload | bit_if((first & 0x10) == 0, R4) | bit_if((first & 0x08) != 0, B4) | bit_if((tail & 0x04) == 0, X4);
    }
    # c5's first bit is r, and its w clear
    if (p.vex != 0xC5) { p.payload = p.payload | bit_if((tail & 0x80) != 0, W); }
    p.vvvv   = (~tail >> 3) & 0x0F;
    p.pp     = tail & 0x03;
    p.length = (tail >> 2) & 1;
    if (p.vex == 0x62) {
        val last: u8 = p.bytes[2];
        p.z      = (last & 0x80) != 0;
        p.length = (last >> 5) & 0x03;
        p.b      = (last & 0x10) != 0;
        p.aaa    = last & 0x07;
        if ((last & 0x08) == 0) { p.vvvv = p.vvvv | 0x10; }
    }
}

# the opcode record field `f` reads
pub fun opcode_of(f: *field.Field) *Opcode {
    ret f.data::*Opcode;
}

# the class of a register operand part, its class list's member at the position its class part holds
fun class_at(classes: operand.Classes, position: u64) u16 {
    if (position >= classes.len::u64) { ret 0xFFFF; }
    ret classes.at[position];
}

# the address size of a register class, 0 for one no address is formed of
fun class_size(class: u16) u8 {
    if (class == gen_register.GPR64_CLASS) { ret 64; }
    if (class == gen_register.GPR32_CLASS) { ret 32; }
    if (class == gen_register.GPR16_CLASS) { ret 16; }
    ret 0;
}

# whether `class` is a general register class, whose register numbers' fifth bit an evex prefix holds in b4 rather than x
fun general(class: u16) bool {
    ret class_size(class) != 0 || class == gen_register.GPR8_CLASS || class == gen_register.GPR8H_CLASS;
}

# whether `desc` is a register operand of a vector, mask or other class no general register is of
fun vector(desc: *operand.Operand) bool {
    if (!sel desc.shape.register) { ret false; }
    val classes: operand.Classes = desc.shape.register.classes;
    ret classes.len > 0 && !general(classes.at[0]);
}

# the general register class of addresses of `size` bits
fun size_class(size: u8) u16 {
    if (size == 64) { ret gen_register.GPR64_CLASS; }
    if (size == 32) { ret gen_register.GPR32_CLASS; }
    ret gen_register.GPR16_CLASS;
}

# whether memory operand `p` names a base or an index, whose class states its address size
fun registered(p: *field.Parts) bool {
    ret field.has(p, field.NUMBER) || field.has(p, field.INDEX);
}

# whether memory operand `m` is indexed by a vector register, VSIB's (Intel SDM 325462-093US Vol 2A 2.3.12)
pub fun vsib(m: *operand.Memory) bool {
    ret m.index.classes.len > 0 && class_size(m.index.classes.at[0]) == 0;
}

# the bits of address size `a`, as masc.isa.x86.opcode.Address numbers it, 0 for none
fun address_bits(a: x86_opcode.Address) u8 {
    if (a == x86_opcode.A16) { ret 16; }
    if (a == x86_opcode.A32) { ret 32; }
    if (a == x86_opcode.A64) { ret 64; }
    ret 0;
}

# the address size of memory operand `m` of row `op` holding `p` in code of width `w` under form `f`: the row's own
# where it states one, else its registers' width, a vector index stating none, or for an address of no general
# register the width's own, or the other size the width reaches where the form overrides it
fun memory_size(w: u8, op: *Opcode, m: *operand.Memory, p: *field.Parts, f: form.Form) res[u8, field.Refusal] {
    var size: u8 = 0;
    if (field.has(p, field.NUMBER)) { size = class_size(class_at(m.base.classes, p.bits[field.CLASS])); }
    if (field.has(p, field.INDEX) && !vsib(m)) {
        val index: u8 = class_size(class_at(m.index.classes, p.bits[field.INDEX_CLASS]));
        if (size != 0 && index != size) { ret refused[u8](ADDRESS, 0); }
        size = index;
    }
    val own: u8 = address_bits(op.address);
    if (own != 0) {
        if (overridden(f))            { ret refused[u8](OVERRIDE, 0); }
        if (size != 0 && size != own) { ret refused[u8](ADDRESS, 0); }
        size = own;
    }
    or (size == 0)                                                       { ret res[u8, field.Refusal].ok{address_size(w, overridden(f))}; }
    or (overridden(f))                                                   { ret refused[u8](OVERRIDE, 0); }
    if (size != address_size(w, false) && size != address_size(w, true)) { ret refused[u8](ADDRESS, 0); }
    ret res[u8, field.Refusal].ok{size};
}

# the displacement `p` holds as a number, its bits sign-extended from the operand's
fun displacement(m: *operand.Memory, p: *field.Parts) i64 {
    val bits: u8  = m.disp.bits;
    var raw:  u64 = p.bits[field.DISP] & field.ones(bits);
    if (bits < 64 && ((raw >> (bits - 1)::u64) & 1) != 0) { raw = raw | ~field.ones(bits); }
    ret raw:~i64;
}

fun fits(v: i64, bits: u8) bool {
    val half: i64 = 1::i64 << (bits - 1)::i64;
    ret v >= -half && v < half;
}

# how a memory operand is laid out in ModRM, SIB and displacement
# ---
# mod:   ModRM.mod
# rm:    ModRM.rm
# sib:   whether a SIB byte follows
# scale: the SIB byte, when one follows
# disp:  the displacement's bytes: 0, 1, 2 or 4
# base:  whether the encoding consults rex.b, which a base in ModRM.rm or SIB.base does
# value: the displacement, as encoded, a disp8 scaled down by its N
pub rec Layout {
    mod:   u8;
    rm:    u8;
    sib:   bool;
    scale: u8;
    disp:  u8;
    base:  bool;
    value: i64;
}

# whether `d` is a disp8 scaled by 2^`scale`: a multiple of it whose quotient fits a byte
fun compressible(d: i64, scale: u8) bool {
    if ((d:~u64 & field.ones(scale)) != 0) { ret false; }
    ret fits(d >> scale::i64, 8);
}

# the displacement width of `d`, its form, whether a ModRM of no displacement may hold it and the power of two a disp8
# is scaled by: 0, 1 or `wide` bytes
fun disp_width(d: i64, symbolic: bool, bare: bool, f: form.Form, wide: u8, scale: u8) u8 {
    val choice: u32 = f.bits & x86_form.DISP;
    if (symbolic || choice == x86_form.DISP32)      { ret wide; }
    if (d == 0 && bare && choice != x86_form.DISP8) { ret 0; }
    if (compressible(d, scale))                     { ret 1; }
    ret wide;
}

# the power of two the disp8 of row `op` scales by, its broadcast element's when `broadcast`, else its tuple's: evex
# disp8*N, which no other space has
pub fun scale_of(op: *Opcode, broadcast: bool) u8 {
    if (op.space != EVEX) { ret 0; }
    if (broadcast)        { ret op.element; }
    ret op.disp8;
}

fun mod_of(disp: u8) u8 {
    if (disp == 0) { ret 0; }
    if (disp == 1) { ret 1; }
    ret 2;
}

# the 16-bit ModRM.rm of base `b` and index `i`, 8 for a pair 16-bit addressing has no form of (Table 2-1)
fun rm16(b: i64, i: i64) u8 {
    if (b == 3 && i == 6)  { ret 0; }
    if (b == 3 && i == 7)  { ret 1; }
    if (b == 5 && i == 6)  { ret 2; }
    if (b == 5 && i == 7)  { ret 3; }
    if (b == 6 && i == -1) { ret 4; }
    if (b == 7 && i == -1) { ret 5; }
    if (b == 5 && i == -1) { ret 6; }
    if (b == 3 && i == -1) { ret 7; }
    ret 8;
}

# the SIB byte of scale part `scale`, index number `x` (-1 for none) and base low bits `low`
fun sib_of(scale: u64, x: i64, low: u8) u8 {
    if (x < 0) { ret (4 << 3) | low; }
    ret ((scale::u8 & 3) << 6) | ((x::u8 & 7) << 3) | low;
}

# the layout of memory operand `m` of row `op` holding `p` at address size `size` in code of width `w` under form `f`, a
# disp8 scaled by 2^`scale`. a vector index and a row whose memory is SIB's (SIBMEM) take a SIB byte, which 16-bit
# addressing has none of
pub fun layout(w: u8, size: u8, op: *Opcode, m: *operand.Memory, p: *field.Parts, f: form.Form, scale: u8) res[Layout, field.Refusal] {
    var l:        Layout;
    val d:        i64  = displacement(m, p);
    val based:    bool = field.has(p, field.NUMBER);
    val listed:   bool = field.has(p, field.INDEX);
    val vectored: bool = vsib(m);
    val sibmem:   bool = vectored || (op.flags & x86_opcode.SIBMEM) != 0;
    var b:        i64  = -1;
    var x:        i64  = -1;
    if (vectored && !listed)  { ret refused[Layout](NO_INDEX, 0); }
    if (sibmem && size == 16) { ret refused[Layout](ADDRESS, 0); }
    if (based)                { b = p.bits[field.NUMBER]:~i64; }
    if (listed)               { x = p.bits[field.INDEX]:~i64; }
    l.value = d;
    if (p.bits[field.MODE] == operand.RELATIVE_PC::u64) {
        if (w != 64) { ret refused[Layout](PCREL_WIDTH, 0); }
        if (sibmem)  { ret refused[Layout](ADDRESS, 0); }
        l.rm   = 5;
        l.disp = 4;
        ret res[Layout, field.Refusal].ok{l};
    }
    if (size == 16) {
        if (listed && p.bits[field.SCALE] != 0) { ret refused[Layout](ADDRESS, 0); }
        if (!based && !listed) {
            l.rm   = 6;
            l.disp = 2;
            ret res[Layout, field.Refusal].ok{l};
        }
        val rm: u8 = rm16(b, x);
        if (rm == 8) { ret refused[Layout](ADDRESS, 0); }
        l.rm   = rm;
        l.disp = disp_width(d, p.symbolic, rm != 6, f, 2, scale);
        l.mod  = mod_of(l.disp);
        if (l.disp == 1) { l.value = d >> scale::i64; }
        ret res[Layout, field.Refusal].ok{l};
    }
    val sib_form: bool = (f.bits & x86_form.SIB) != 0 || sibmem;
    if (!based) {
        # no base is disp32 alone, through a SIB byte where 64-bit code's rm 101 is rip-relative or an index is given
        l.disp = 4;
        if (listed || w == 64 || sib_form) {
            l.rm    = 4;
            l.sib   = true;
            l.scale = sib_of(p.bits[field.SCALE], x, 5);
            ret res[Layout, field.Refusal].ok{l};
        }
        l.rm = 5;
        ret res[Layout, field.Refusal].ok{l};
    }
    l.base = true;
    val low: u8 = b::u8 & 7;
    # rbp and r13 have no form of no displacement, which rm 101 is, and take a zero disp8
    l.disp = disp_width(d, p.symbolic, low != 5, f, 4, scale);
    l.mod  = mod_of(l.disp);
    if (l.disp == 1) { l.value = d >> scale::i64; }
    if (listed || low == 4 || sib_form) {
        # rsp and r12 are SIB.base's alone, rm 100 meaning a SIB byte follows
        l.rm    = 4;
        l.sib   = true;
        l.scale = sib_of(p.bits[field.SCALE], x, low);
        ret res[Layout, field.Refusal].ok{l};
    }
    l.rm = low;
    ret res[Layout, field.Refusal].ok{l};
}

# what the operands of a row need of its prefixes in code of width `w` under form `f`
# ---
# o66:       66 is written, for the operand size or as the mandatory prefix
# a67:       67 is written, for the address size
# segment:   the segment prefix written, 0 for none
# lock:      f0 is written
# rep:       the mandatory f2 or f3, 0 for none
# bits:      the payload bits the operands set
# decided:   the payload bits the encoding consults, which a decode reads back as operands
# byte:      spl, bpl, sil or dil is named, which a rex prefix tells from ah, ch, dh and bh
# high:      ah, ch, dh or bh is named, which no rex or rex2 prefix admits
# naming:    the operand that names it, which a refusal of the prefix names
# memory:    the row has a memory operand the address-size prefix applies to
# segmented: that operand takes a segment, so a segment prefix applies to it
# string:    that operand is a string's, at the one register of its address size
# reach:     one past the highest register number a register field holds, 0 for none
# vvvv:      the register number vex.vvvv, xop.vvvv or evex.vvvv and v' hold, 0 for none
# dfv:       the default flags apx's ccmp and ctest hold in evex.vvvv, uninverted, 0 for none
# vhigh:     a vector index's fifth bit, which evex.v' holds and a vex prefix cannot
# aaa:       the opmask number evex.aaa holds, 0 for none
# zeroing:   `{z}` is given
# rounded:   embedded rounding or SAE is given
# rounding:  which, as masc.isa.x86.opcode.RN_SAE to SAE number them
# broadcast: the memory operand broadcasts
# evex:      a mask, zeroing, rounding or broadcast is given, which only an evex prefix holds
pub rec Needs {
    o66:       bool;
    a67:       bool;
    segment:   u8;
    lock:      bool;
    rep:       u8;
    bits:      u8;
    decided:   u8;
    byte:      bool;
    high:      bool;
    naming:    u8;
    memory:    bool;
    segmented: bool;
    string:    bool;
    reach:     u8;
    vvvv:      u8;
    dfv:       u8;
    vhigh:     bool;
    aaa:       u8;
    zeroing:   bool;
    rounded:   bool;
    rounding:  u32;
    broadcast: bool;
    evex:      bool;
}

# the payload bits of register number `n` at the rex bit `low` and rex2 bit `high`
fun extension_bits(n: u64, low: u8, high: u8) u8 {
    var bits: u8 = 0;
    if (((n >> 3) & 1) != 0) { bits = bits | low; }
    if (((n >> 4) & 1) != 0) { bits = bits | high; }
    ret bits;
}

# the register number bits 3 and 4 the payload bits `low` and `high` of `payload` give
fun extension_of(payload: u8, low: u8, high: u8) u64 {
    var n: u64 = 0;
    if ((payload & low) != 0)  { n = n | 8; }
    if ((payload & high) != 0) { n = n | 16; }
    ret n;
}

# a register operand's class facts noted in `n`: a byte register a rex prefix tells apart, or a high byte one
fun note_register(n: *Needs, desc: *operand.Operand, p: *field.Parts, k: u8) {
    if (!sel desc.shape.register) { ret; }
    val class:  u16 = class_at(desc.shape.register.classes, p.bits[field.CLASS]);
    val number: u64 = p.bits[field.NUMBER];
    if (class == gen_register.GPR8H_CLASS) {
        n.high   = true;
        n.naming = k;
    }
    if (class == gen_register.GPR8_CLASS && number >= 4 && number <= 7) { n.byte = true; }
}

# whether operand `k` is one and a register operand
fun holds_register(operands: *operand.Operand, k: u8) bool {
    if (k == field.NO_OPERAND) { ret false; }
    val desc: *operand.Operand = ?operands[k];
    ret sel desc.shape.register;
}

# whether operand `k` is one and a memory operand
fun holds_memory(operands: *operand.Operand, k: u8) bool {
    if (k == field.NO_OPERAND) { ret false; }
    val desc: *operand.Operand = ?operands[k];
    ret sel desc.shape.memory;
}

# whether operand `k` is one and an enumerant operand, as apx's default flags in vvvv are
fun holds_enumerant(operands: *operand.Operand, k: u8) bool {
    if (k == field.NO_OPERAND) { ret false; }
    val desc: *operand.Operand = ?operands[k];
    ret sel desc.shape.enumerant;
}

# whether operand `k` is one and a memory operand of a vector index
fun holds_vsib(operands: *operand.Operand, k: u8) bool {
    if (k == field.NO_OPERAND) { ret false; }
    val desc: *operand.Operand = ?operands[k];
    if (!sel desc.shape.memory) { ret false; }
    ret vsib(?desc.shape.memory);
}

# register number `number` noted as one a register field holds
fun note_reach(n: *Needs, number: u64) {
    if (number + 1 > n.reach::u64) { n.reach = (number + 1)::u8; }
}

# the payload bits a register operand at rex bit `low` and rex2 bit `high` needs, noted in `n`
fun note_bits(n: *Needs, desc: *operand.Operand, p: *field.Parts, k: u8, low: u8, high: u8) {
    n.decided = n.decided | low | high;
    n.bits    = n.bits | extension_bits(p.bits[field.NUMBER], low, high);
    note_reach(n, p.bits[field.NUMBER]);
    note_register(n, desc, p, k);
}

# the bit of the payload the fifth bit of register rm operand `desc` of row `op` is in: an evex prefix holds a vector
# register's in x and a general register's in b4, as rex2 does (Intel APX 355828-009US Table 3.4)
fun rm_high(op: *Opcode, desc: *operand.Operand) u8 {
    if (op.space == EVEX && vector(desc)) { ret X3; }
    ret B4;
}

# the vex, evex and xop operands of row `op` noted in `n`: vvvv's register or default flags, the opmask, `{z}` and the
# rounding
fun note_vex(n: *Needs, op: *Opcode, operands: *operand.Operand, parts: *field.Parts) {
    if (holds_enumerant(operands, op.vvvv)) { n.dfv = parts[op.vvvv].bits[field.NUMBER]::u8; }
    or (op.vvvv != field.NO_OPERAND) {
        val p: *field.Parts = ?parts[op.vvvv];
        n.vvvv = p.bits[field.NUMBER]::u8;
        note_reach(n, p.bits[field.NUMBER]);
        note_register(n, ?operands[op.vvvv], p, op.vvvv);
    }
    if (op.mask != field.NO_OPERAND && field.has(?parts[op.mask], field.NUMBER)) {
        n.aaa  = parts[op.mask].bits[field.NUMBER]::u8;
        n.evex = true;
    }
    if (op.zeroing != field.NO_OPERAND && field.has(?parts[op.zeroing], field.NUMBER)) {
        n.zeroing = true;
        n.evex    = true;
    }
    if (op.rounding != field.NO_OPERAND && field.has(?parts[op.rounding], field.NUMBER)) {
        n.rounded  = true;
        n.rounding = parts[op.rounding].bits[field.NUMBER]::u32;
        n.evex     = true;
    }
}

# the needs of the row `op` reads, holding the operand parts `parts` of `operands`
pub fun needs(w: u8, op: *Opcode, operands: *operand.Operand, parts: *field.Parts, f: form.Form) res[Needs, field.Refusal] {
    var n: Needs;
    # a row immune to 66 is 32 bits in 16-bit code too, as XED's IMMUNE66() writes no 66 for it
    val immune: bool = (op.flags & IMMUNE_66) != 0;
    n.o66  = (!immune && ((op.size == O16 && w != 16) || (op.size == O32 && w == 16))) || op.simd == P66;
    n.lock = (op.flags & LOCKED) != 0;
    if (op.space != LEGACY) { n.o66 = op.size == O16 || op.simd == P66; }
    if (op.simd == PF3)     { n.rep = 0xF3; }
    if (op.simd == PF2)     { n.rep = 0xF2; }
    if (op.size != NO_SIZE && !(op.size == O64 && (op.flags & DEFAULT_64) != 0)) {
        n.decided = n.decided | W;
        if (op.size == O64) { n.bits = n.bits | W; }
    }
    # a vector row's w is an opcode bit, or ignored
    if (op.space != LEGACY && op.size == NO_SIZE) {
        if ((op.flags & WIG) == 0) { n.decided = n.decided | W; }
        if ((op.flags & W1) != 0)  { n.bits = n.bits | W; }
    }
    n.naming = field.NO_OPERAND;
    if (op.reg != field.NO_OPERAND)      { note_bits(?n, ?operands[op.reg], ?parts[op.reg], op.reg, R3, R4); }
    if (op.opreg != field.NO_OPERAND)    { note_bits(?n, ?operands[op.opreg], ?parts[op.opreg], op.opreg, B3, B4); }
    if (holds_register(operands, op.rm)) { note_bits(?n, ?operands[op.rm], ?parts[op.rm], op.rm, B3, rm_high(op, ?operands[op.rm])); }
    note_vex(?n, op, operands, parts);
    if (op.memory == field.NO_OPERAND) {
        if (overridden(f)) { ret refused[Needs](OVERRIDE, 0); }
        # a row of an address size and no memory operand, as jcxz's and loop's on cx, ecx or rcx, takes 67 for it
        val own: u8 = address_bits(op.address);
        if (own != 0) {
            if (own != address_size(w, false) && own != address_size(w, true)) { ret refused[Needs](ADDRESS, 0); }
            n.a67 = own != address_size(w, false);
        }
        ret res[Needs, field.Refusal].ok{n};
    }
    val desc: *operand.Operand = ?operands[op.memory];
    val p:    *field.Parts     = ?parts[op.memory];
    if (!sel desc.shape.memory) { ret refused[Needs](field.WRONG_KIND, 0); }
    val m:    *operand.Memory        = ?desc.shape.memory;
    val size: res[u8, field.Refusal] = memory_size(w, op, m, p, f);
    if (sel size.err) { ret res[Needs, field.Refusal].err{field.refusal(size.err.message, op.memory, 0)}; }
    n.memory = true;
    n.a67    = size.ok != address_size(w, false);
    n.string = m.base.count == 1 && m.base.classes.len == 1 && m.index.classes.len == 0 && m.disp.bits == 0;
    # a segment of one register, a string's es, takes no override
    n.segmented = m.segment.classes.len > 0 && m.segment.count != 1;
    n.broadcast = field.has(p, field.BROADCAST);
    if (n.broadcast) { n.evex = true; }
    if (n.segmented && field.has(p, field.SEGMENT)) {
        val s: u64 = p.bits[field.SEGMENT];
        # a string's ds is the segment it is at with no override, as llvm-mc writes `lodsb al, byte ptr ds:[rsi]` as ac
        if (s < 6 && !(n.string && s == DS_NUMBER)) { n.segment = SEGMENTS[s]; }
    }
    if (op.memory == op.rm) {
        val l: res[Layout, field.Refusal] = layout(w, size.ok, op, m, p, f, scale_of(op, n.broadcast));
        if (sel l.err) { ret res[Needs, field.Refusal].err{field.refusal(l.err.message, op.memory, 0)}; }
        if (size.ok != 16) {
            if (l.ok.base) {
                n.decided = n.decided | B3 | B4;
                n.bits    = n.bits | extension_bits(p.bits[field.NUMBER], B3, B4);
                note_reach(?n, p.bits[field.NUMBER]);
            }
            # a vector index's fifth bit is evex.v', and x4 is none of it (Intel SDM 325462-093US Vol 2A 2.7.9)
            if (l.ok.sib && vsib(m)) {
                n.decided = n.decided | X3;
                n.bits    = n.bits | extension_bits(p.bits[field.INDEX], X3, 0);
                n.vhigh   = ((p.bits[field.INDEX] >> 4) & 1) != 0;
                note_reach(?n, p.bits[field.INDEX]);
            }
            or (l.ok.sib) {
                n.decided = n.decided | X3 | X4;
                if (field.has(p, field.INDEX)) {
                    n.bits = n.bits | extension_bits(p.bits[field.INDEX], X3, X4);
                    note_reach(?n, p.bits[field.INDEX]);
                }
            }
        }
    }
    ret res[Needs, field.Refusal].ok{n};
}

# the canonical prefix run of `n` into `out`: the segment, 67, 66, f0, then f2 or f3, as llvm-mc writes them, and of a
# string's, f2 or f3, 67, the segment and 66, as llvm-mc writes `rep lodsw ax, word ptr fs:[esi]` as f3 67 64 66 ad
# ---
# ret: its length
pub fun canonical(n: *Needs, out: *u8) u8 {
    var k: u8 = 0;
    if (n.string) {
        if (n.rep != 0) {
            out[k] = n.rep;
            k      = k + 1;
        }
        if (n.a67) {
            out[k] = 0x67;
            k      = k + 1;
        }
        if (n.segment != 0) {
            out[k] = n.segment;
            k      = k + 1;
        }
        if (n.o66) {
            out[k] = 0x66;
            k      = k + 1;
        }
        ret k;
    }
    if (n.segment != 0) {
        out[k] = n.segment;
        k      = k + 1;
    }
    if (n.a67) {
        out[k] = 0x67;
        k      = k + 1;
    }
    if (n.o66) {
        out[k] = 0x66;
        k      = k + 1;
    }
    if (n.lock) {
        out[k] = 0xF0;
        k      = k + 1;
    }
    if (n.rep != 0) {
        out[k] = n.rep;
        k      = k + 1;
    }
    ret k;
}

# whether the prefix run `run` of `count` bytes means what `n` needs of the row `op`, with rex.w or rex2.w set when
# `wide`: the prefixes the row reads are there as it needs them, and any other is one it ignores, as 66 beside rex.w.
# before a vex or evex prefix, whose pp holds 66, f2 and f3, none of 66, f0, f2 and f3 is admitted
pub fun means(run: *u8, count: u8, n: *Needs, op: *Opcode, wide: bool) bool {
    var segment: u8   = 0;
    var a67:     bool = false;
    var o66:     bool = false;
    var lock:    bool = false;
    var rep:     u8   = 0;
    var i:       u8   = 0;
    for (i < count) {
        val b: u8 = run[i];
        if (b == 0x66)              { o66 = true; }
        or (b == 0x67)              { a67 = true; }
        or (b == 0xF0)              { lock = true; }
        or (b == 0xF2 || b == 0xF3) { rep = b; }
        or                          { segment = b; }
        i = i + 1;
    }
    if (op.space != LEGACY && (o66 || lock || rep != 0)) { ret false; }
    val sized: bool = op.size != NO_SIZE && (op.flags & IMMUNE_66) == 0 && !(op.size == O64 && wide);
    if (n.segmented && segment != n.segment)                { ret false; }
    if (n.memory && a67 != n.a67)                           { ret false; }
    if ((sized || op.simd == P66) && o66 != n.o66)          { ret false; }
    if (lock != n.lock)                                     { ret false; }
    if ((op.simd == PF2 || op.simd == PF3) && rep != n.rep) { ret false; }
    ret true;
}

# the prefix run the form's slots hold into `out`
# ---
# ret: its length, 0 when the form holds none
pub fun slots(f: form.Form, out: *u8) u8 {
    var k: u8  = 0;
    var i: u32 = 0;
    for (i < x86_form.SLOT_COUNT) {
        val code: u32 = (f.bits >> (x86_form.SLOTS_SHIFT + i * x86_form.SLOT_BITS)) & 0xF;
        if (code != 0 && code <= x86_form.PREFIX_COUNT) {
            out[k] = x86_form.PREFIXES[code - 1];
            k      = k + 1;
        }
        i = i + 1;
    }
    ret k;
}

# the form bits of the prefix run `run` of `count` bytes, none when the slots cannot hold it
fun slotted(run: *u8, count: u8) opt[u32] {
    if (count::u32 > x86_form.SLOT_COUNT) { ret opt[u32].none{}; }
    var bits: u32 = 0;
    var i:    u8  = 0;
    for (i < count) {
        var code: u32 = 0;
        var k:    u32 = 0;
        for (k < x86_form.PREFIX_COUNT) {
            if (x86_form.PREFIXES[k] == run[i]) { code = k + 1; }
            k = k + 1;
        }
        bits = bits | (code << (x86_form.SLOTS_SHIFT + i::u32 * x86_form.SLOT_BITS));
        i    = i + 1;
    }
    ret opt[u32].some{bits};
}

# the prefix bytes of a head: its legacy run, its rex or rex2 prefix and payload, or its vex or evex prefix
# ---
# run:     the legacy prefixes
# count:   how many there are
# rex:     a rex prefix is written
# rex2:    a rex2 prefix is written
# payload: its payload, rex2's whole or rex's low four bits
# vex:     the vex or evex prefix byte written, c4, c5 or 62, 0 for none
# bytes:   its payload bytes
# length:  how many there are
rec Plan {
    run:     [15]u8;
    count:   u8;
    rex:     bool;
    rex2:    bool;
    payload: u8;
    vex:     u8;
    bytes:   [3]u8;
    length:  u8;
}

fun field_refused(message: str, op: u8) err[field.Refusal] {
    ret err[field.Refusal].err{field.refusal(message, op, 0)};
}

# whether form bits `fm` name the encoding space of row `op`: {evex} an evex row's, {vex} and {vex3} a vex row's
fun named_space(fm: u32, op: *Opcode) bool {
    val space: u32 = fm & x86_form.ENCODING;
    if (op.space == EVEX) { ret space == x86_form.EVEX; }
    if (op.space == VEX)  { ret space == x86_form.VEX || space == x86_form.VEX3; }
    ret false;
}

# whether form bits `fm` select another row than `op`: the other direction, or another encoding space
fun other_row(fm: u32, op: *Opcode) bool {
    val dir: u32 = fm & x86_form.DIRECTION;
    if (dir == x86_form.LOAD && (op.flags & STORE) != 0) { ret true; }
    if (dir == x86_form.STORE && (op.flags & LOAD) != 0) { ret true; }
    ret (fm & x86_form.ENCODING) != 0 && !named_space(fm, op);
}

# whether row `op`, holding operands that need `n`, gives way to its twin: it has one, which reaches every register the
# operands name and holds all they give, and the form does not name the row's space
fun gives_way(fm: u32, op: *Opcode, n: *Needs) bool {
    if (op.twin == 0)               { ret false; }
    if (n.reach > op.twin)          { ret false; }
    if (n.evex && op.space == EVEX) { ret false; }
    ret !named_space(fm, op);
}

# the vex.pp and evex.pp of what `n` needs: 66 as 01, f3 as 10 and f2 as 11
fun pp_of(n: *Needs) u8 {
    if (n.rep == 0xF3) { ret 2; }
    if (n.rep == 0xF2) { ret 3; }
    if (n.o66)         { ret 1; }
    ret 0;
}

# the inverse of bit `bit` of `bits` at bit `at`
fun clear_at(bits: u8, bit: u8, at: u8) u8 {
    if ((bits & bit) == 0) { ret 1::u8 << at; }
    ret 0;
}

# bit `bit` of `bits` at bit `at`
fun set_at(bits: u8, bit: u8, at: u8) u8 {
    if ((bits & bit) != 0) { ret 1::u8 << at; }
    ret 0;
}

# the vex, evex or xop prefix of row `op` into `pl`, its operands needing `n` in code of width `w` under form bits
# `fm`: the payload bits, vvvv, the vector length or rounding, the opmask, zeroing and pp (Intel SDM 325462-093US Vol 2A
# 2.3.5, 2.7.1, Intel APX 355828-009US 3.1.2.3, AMD APM 24594 Vol 3 1.8). apx's ccmp and ctest hold their default flags
# in vvvv uninverted and their condition in aaa and v', its fourth bit uninverted (XED APX_CC_EVEX_BYTE3_ENC)
fun vex_plan(op: *Opcode, n: *Needs, w: u8, fm: u32, pl: *Plan) err[field.Refusal] {
    if ((fm & (x86_form.REX | x86_form.REX2)) != 0) { ret field_refused(OTHER_ROW, field.NO_OPERAND); }
    if (n.high)                                     { ret field_refused(HIGH_BYTE, n.naming); }
    val free: u8 = ((fm & x86_form.PAYLOAD) >> x86_form.PAYLOAD_SHIFT)::u8;
    if ((free & n.decided) != 0 || (free & (R4 | X4 | B4)) != 0) { ret field_refused(RUN, field.NO_OPERAND); }
    val bits: u8 = n.bits | free;
    if (op.space != EVEX && ((bits & (R4 | X4 | B4)) != 0 || n.vvvv >= 16 || n.vhigh)) { ret field_refused(VEX_REACH, field.NO_OPERAND); }
    if (w != 64 && ((bits & (R3 | X3 | B3 | R4 | X4 | B4)) != 0 || n.vvvv >= 8))       { ret field_refused(REACH_WIDTH, field.NO_OPERAND); }
    if (n.zeroing && n.aaa == 0)                                                       { ret field_refused(UNMASKED, op.zeroing); }
    var length:  u8   = op.length;
    var ignored: bool = op.length == LIG;
    var b:       bool = (op.flags & ND) != 0 || n.broadcast;
    if (n.rounded) {
        b = true;
        if (n.rounding <= x86_opcode.RZ_SAE) {
            length  = n.rounding::u8;
            ignored = false;
        }
        # sae leaves l'l to the row's length, which it ignores
        or { ignored = true; }
    }
    val chosen: u8 = ((fm & x86_form.LENGTH) >> x86_form.LENGTH_SHIFT)::u8;
    if (ignored)                        { length = chosen; }
    or (chosen != 0)                    { ret field_refused(RUN, field.NO_OPERAND); }
    if (op.space != EVEX && length > 1) { ret field_refused(RUN, field.NO_OPERAND); }
    val pp:   u8 = pp_of(n);
    var vvvv: u8 = (~n.vvvv & 0x0F) << 3;
    if (op.vvvv != field.NO_OPERAND && op.scc != x86_opcode.NO_SCC) { vvvv = (n.dfv & 0x0F) << 3; }
    if (op.space == XOP) {
        pl.vex      = 0x8F;
        pl.bytes[0] = clear_at(bits, R3, 7) | clear_at(bits, X3, 6) | clear_at(bits, B3, 5) | op.map;
        pl.bytes[1] = set_at(bits, W, 7) | vvvv | (length << 2) | pp;
        pl.length   = 2;
        ret err[field.Refusal].ok{};
    }
    if (op.space == VEX) {
        if (op.map == 1 && (bits & (W | X3 | B3)) == 0 && (fm & x86_form.ENCODING) != x86_form.VEX3) {
            pl.vex      = 0xC5;
            pl.bytes[0] = clear_at(bits, R3, 7) | vvvv | (length << 2) | pp;
            pl.length   = 1;
            ret err[field.Refusal].ok{};
        }
        pl.vex      = 0xC4;
        pl.bytes[0] = clear_at(bits, R3, 7) | clear_at(bits, X3, 6) | clear_at(bits, B3, 5) | op.map;
        pl.bytes[1] = set_at(bits, W, 7) | vvvv | (length << 2) | pp;
        pl.length   = 2;
        ret err[field.Refusal].ok{};
    }
    var aaa: u8 = n.aaa;
    if ((op.flags & NF) != 0)        { aaa = 0x04; }
    if (op.scc != x86_opcode.NO_SCC) { aaa = op.scc & 7; }
    pl.vex      = 0x62;
    pl.bytes[0] = clear_at(bits, R3, 7) | clear_at(bits, X3, 6) | clear_at(bits, B3, 5) | clear_at(bits, R4, 4) | set_at(bits, B4, 3) | op.map;
    pl.bytes[1] = set_at(bits, W, 7) | vvvv | clear_at(bits, X4, 2) | pp;
    pl.bytes[2] = (length << 5) | aaa;
    if (n.zeroing)                   { pl.bytes[2] = pl.bytes[2] | 0x80; }
    if (b)                           { pl.bytes[2] = pl.bytes[2] | 0x10; }
    if (op.scc != x86_opcode.NO_SCC) { pl.bytes[2] = pl.bytes[2] | ((op.scc >> 3) << 3); }
    or (n.vvvv < 16 && !n.vhigh)     { pl.bytes[2] = pl.bytes[2] | 0x08; }
    pl.length = 3;
    ret err[field.Refusal].ok{};
}

# what head field `f` writes for the encoder's instruction, or why the instruction has no encoding by its row
fun plan(enc: *field.Encoder, f: *field.Field) res[Plan, field.Refusal] {
    var pl: Plan;
    val op: *Opcode = opcode_of(f);
    val w:  u8      = width(enc.ctx);
    val fm: u32     = enc.form.bits;
    if (other_row(fm, op)) { ret refused[Plan](OTHER_ROW, 0); }
    val got: res[Needs, field.Refusal] = needs(w, op, enc.operands, enc.parts, @enc.form);
    if (sel got.err) { ret res[Plan, field.Refusal].err{got.err}; }
    var n: Needs = got.ok;
    if (gives_way(fm, op, ?n)) { ret refused[Plan](OTHER_ROW, 0); }
    if (op.space != LEGACY) {
        val built: err[field.Refusal] = vex_plan(op, ?n, w, fm, ?pl);
        if (sel built.err) { ret res[Plan, field.Refusal].err{built.err}; }
        # 66, f2 and f3 are pp's, so the run is the segment and 67
        n.o66  = false;
        n.rep  = 0;
        n.lock = false;
        var run:   [15]u8;
        val given: u8 = slots(@enc.form, ?run[0]);
        if (given > 0) {
            if (!means(?run[0], given, ?n, op, false)) { ret refused[Plan](RUN, 0); }
            pl.run   = run;
            pl.count = given;
        }
        or { pl.count = canonical(?n, ?pl.run[0]); }
        ret res[Plan, field.Refusal].ok{pl};
    }
    val free: u8 = ((fm & x86_form.PAYLOAD) >> x86_form.PAYLOAD_SHIFT)::u8;
    if ((free & n.decided) != 0) { ret refused[Plan](RUN, 0); }
    # a row whose encoding a rex2 prefix is part of, as jmpabs's, takes one whatever its registers reach
    val wide:  bool = (n.bits & (R4 | X4 | B4)) != 0 || (fm & x86_form.REX2) != 0 || (free & (R4 | X4 | B4)) != 0 || (op.flags & x86_opcode.REX2) != 0;
    val rexed: bool = wide || n.bits != 0 || n.byte || (fm & x86_form.REX) != 0 || free != 0;
    if (rexed) {
        if (w != 64)                                                { ret refused[Plan](REX_WIDTH, 0); }
        if (n.high)                                                 { ret res[Plan, field.Refusal].err{field.refusal(HIGH_BYTE, n.naming, 0)}; }
        if (wide && (fm & x86_form.REX) != 0)                       { ret refused[Plan](REX_FORM, 0); }
        if (wide && op.map > 1)                                     { ret refused[Plan](REX2_MAP, 0); }
        if (wide && (op.flags & NO_REX2) != 0)                      { ret refused[Plan](REX2_ROW, 0); }
        if (wide && (op.flags & REFINED_W) != 0 && (free & W) != 0) { ret refused[Plan](REFINED, 0); }
        pl.rex2    = wide;
        pl.rex     = !wide;
        pl.payload = n.bits | free;
        if (wide) { pl.payload = pl.payload | (op.map << 7); }
    }
    var run:   [15]u8;
    val given: u8 = slots(@enc.form, ?run[0]);
    if (given > 0) {
        if (!means(?run[0], given, ?n, op, ((pl.payload & W) != 0) && (pl.rex || pl.rex2))) { ret refused[Plan](RUN, 0); }
        pl.run   = run;
        pl.count = given;
    }
    or {
        pl.count = canonical(?n, ?pl.run[0]);
    }
    ret res[Plan, field.Refusal].ok{pl};
}

fun head_admit(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val got: res[Plan, field.Refusal] = plan(enc, f);
    if (sel got.err) { ret err[field.Refusal].err{got.err}; }
    ret err[field.Refusal].ok{};
}

fun head_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val got: res[Plan, field.Refusal] = plan(enc, f);
    if (sel got.err) { ret err[field.Refusal].err{got.err}; }
    val pl: Plan    = got.ok;
    val op: *Opcode = opcode_of(f);
    var i:  u8      = 0;
    for (i < pl.count) {
        val put: err[field.Refusal] = field.put(enc, pl.run[i]::u64, 1);
        if (sel put.err) { ret put; }
        i = i + 1;
    }
    if (pl.vex != 0) {
        val put: err[field.Refusal] = field.put(enc, pl.vex::u64, 1);
        if (sel put.err) { ret put; }
        var k: u8 = 0;
        for (k < pl.length) {
            val more: err[field.Refusal] = field.put(enc, pl.bytes[k]::u64, 1);
            if (sel more.err) { ret more; }
            k = k + 1;
        }
    }
    or (pl.rex2) {
        val put: err[field.Refusal] = field.put(enc, 0xD5 | (pl.payload::u64 << 8), 2);
        if (sel put.err) { ret put; }
    }
    or (pl.rex) {
        val put: err[field.Refusal] = field.put(enc, 0x40 | pl.payload::u64, 1);
        if (sel put.err) { ret put; }
    }
    # rex2's m0 is map 1's escape, and a vex or evex prefix holds its map
    if (pl.vex == 0 && !(pl.rex2 && op.map == 1)) {
        var escape: u64 = 0;
        var bytes:  u8  = 0;
        if (op.map == 1) {
            escape = 0x0F;
            bytes  = 1;
        }
        or (op.map == 2) {
            escape = 0x380F;
            bytes  = 2;
        }
        or (op.map == 3) {
            escape = 0x3A0F;
            bytes  = 2;
        }
        or (op.map == NOW_MAP) {
            escape = 0x0F0F;
            bytes  = 2;
        }
        if (bytes > 0) {
            val put: err[field.Refusal] = field.put(enc, escape, bytes);
            if (sel put.err) { ret put; }
        }
    }
    # 3dnow's opcode is a unit after ModRM and its displacement
    if (op.map == NOW_MAP) { ret err[field.Refusal].ok{}; }
    var b: u64 = op.byte::u64;
    if (op.opreg != field.NO_OPERAND) { b = b | (enc.parts[op.opreg].bits[field.NUMBER] & 7); }
    ret field.put(enc, b, 1);
}

# the instruction's length held to the longest an x86 instruction has
fun head_finish(enc: *field.Encoder, f: *field.Field, at: usize) err[field.Refusal] {
    if (enc.out.len - enc.start > MAX_LENGTH) { ret err[field.Refusal].err{field.refusal(LONG, field.NO_OPERAND, enc.start)}; }
    ret err[field.Refusal].ok{};
}

# the position of the class register number `n` of `desc` is in: a byte register numbered 4 to 7 is ah to bh with no
# rex or rex2 prefix and spl to dil with one, and any other operand has one class
fun pick(desc: *operand.Operand, n: u64, rexed: bool) u64 {
    if (!sel desc.shape.register) { ret 0; }
    val classes: operand.Classes = desc.shape.register.classes;
    val high:    i64             = operand.find(classes, gen_register.GPR8H_CLASS);
    val low:     i64             = operand.find(classes, gen_register.GPR8_CLASS);
    if (high < 0 || low < 0)        { ret 0; }
    if (!rexed && n >= 4 && n <= 7) { ret high::u64; }
    ret low::u64;
}

# whether the prefixes `s` of code of width `w` give the operand size the row `op` encodes
fun sized(w: u8, s: *Prefixes, op: *Opcode) bool {
    ret x86_opcode.sized(w, s.osz, (s.rex || s.rex2) && (s.payload & W) != 0, op);
}

fun head_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    val op:  *Opcode                      = opcode_of(f);
    val w:   u8                           = width(dec.ctx);
    val got: res[Prefixes, field.Refusal] = scan(?dec.in, dec.start, w);
    if (sel got.err) { ret err[field.Refusal].err{got.err}; }
    val s:        Prefixes      = got.ok;
    val mismatch: field.Refusal = field.refusal(field.MISMATCH, field.NO_OPERAND, s.opcode);
    if (s.space != op.space || s.map != op.map) { ret err[field.Refusal].err{mismatch}; }
    if (!x86_opcode.addressed(w, s.asz, op))    { ret err[field.Refusal].err{mismatch}; }
    val read: res[u8, field.Refusal] = byte_at(?dec.in, s.opcode);
    if (sel read.err) { ret err[field.Refusal].err{read.err}; }
    var mask: u8 = 0xFF;
    if (op.opreg != field.NO_OPERAND) { mask = 0xF8; }
    # 3dnow's opcode is its unit's, after ModRM
    if (op.map != NOW_MAP && (read.ok & mask) != op.byte) { ret err[field.Refusal].err{mismatch}; }
    if (op.space != LEGACY) {
        val done: err[field.Refusal] = vex_decode(dec, op, ?s, w, mismatch);
        if (sel done.err) { ret done; }
        dec.at = s.opcode + 1;
        ret err[field.Refusal].ok{};
    }
    if (op.simd == P66 && !s.osz)                                      { ret err[field.Refusal].err{mismatch}; }
    if (op.simd == PF3 && s.rep != 0xF3)                               { ret err[field.Refusal].err{mismatch}; }
    if (op.simd == PF2 && s.rep != 0xF2)                               { ret err[field.Refusal].err{mismatch}; }
    if ((op.flags & LOCKED) != 0 && !s.lock)                           { ret err[field.Refusal].err{mismatch}; }
    if (!sized(w, ?s, op))                                             { ret err[field.Refusal].err{mismatch}; }
    if ((op.flags & LOCKED) == 0 && s.lock)                            { ret err[field.Refusal].err{field.refusal(LOCK, field.NO_OPERAND, dec.start)}; }
    if (s.rex2 && (op.flags & NO_REX2) != 0)                           { ret err[field.Refusal].err{field.refusal(REX2_ROW, field.NO_OPERAND, dec.start)}; }
    if (!s.rex2 && (op.flags & x86_opcode.REX2) != 0)                  { ret err[field.Refusal].err{mismatch}; }
    if (s.rex2 && (op.flags & REFINED_W) != 0 && (s.payload & W) != 0) { ret err[field.Refusal].err{field.refusal(REFINED, field.NO_OPERAND, dec.start)}; }
    if (op.opreg != field.NO_OPERAND) {
        val rexed: bool = s.rex || s.rex2;
        var n:     u64  = (read.ok & 7)::u64;
        if (rexed) { n = n | extension_of(s.payload, B3, B4); }
        field.replace(dec, op.opreg, field.NUMBER, n);
        field.replace(dec, op.opreg, field.CLASS, pick(?dec.operands[op.opreg], n, rexed));
    }
    dec.at = s.opcode + 1;
    ret err[field.Refusal].ok{};
}

# the bytes a broadcast of row `op` repeats its element 2^n times to fill, as n: its vector length less its element
fun broadcast_of(op: *Opcode) u8 {
    ret 4 + op.length - op.element;
}

# the vex or evex prefix `s` read against row `op` in code of width `w`, depositing vvvv's register, the opmask, `{z}`,
# a broadcast and the rounding, `mismatch` refusing bytes of another row
fun vex_decode(dec: *field.Decoder, op: *Opcode, s: *Prefixes, w: u8, mismatch: field.Refusal) err[field.Refusal] {
    if (s.osz || s.lock || s.rep != 0) { ret err[field.Refusal].err{field.refusal(VEX_PREFIX, field.NO_OPERAND, dec.start)}; }
    var pp: u8 = op.simd;
    if (op.size == O16) { pp = 1; }
    val wide: bool = (s.payload & W) != 0;
    if (s.pp != pp || !x86_opcode.sized(w, s.pp == 1, wide, op))                       { ret err[field.Refusal].err{mismatch}; }
    if (op.size == NO_SIZE && (op.flags & WIG) == 0 && wide != ((op.flags & W1) != 0)) { ret err[field.Refusal].err{mismatch}; }
    # evex.v' is the fifth bit of a vector index, or the fourth of apx's condition, as it is
    var vhigh: u8 = 0;
    if (op.space == EVEX && (op.scc != x86_opcode.NO_SCC || holds_vsib(dec.operands, op.rm))) { vhigh = 0x10; }
    if (op.scc != x86_opcode.NO_SCC && ((s.vvvv & 0x10) == 0) != ((op.scc >> 3) != 0))        { ret err[field.Refusal].err{mismatch}; }
    if (holds_enumerant(dec.operands, op.vvvv))                                               { field.replace(dec, op.vvvv, field.NUMBER, (~s.vvvv & 0x0F)::u64); }
    or (op.vvvv != field.NO_OPERAND) {
        field.replace(dec, op.vvvv, field.NUMBER, s.vvvv::u64);
        field.replace(dec, op.vvvv, field.CLASS, pick(?dec.operands[op.vvvv], s.vvvv::u64, true));
    }
    or ((s.vvvv & ~vhigh) != 0) { ret err[field.Refusal].err{field.refusal(UNREAD_BITS, field.NO_OPERAND, dec.start)}; }
    var length: bool = true;
    if (op.space == EVEX) {
        var aaa: u8 = 0;
        if ((op.flags & NF) != 0)        { aaa = 0x04; }
        if (op.scc != x86_opcode.NO_SCC) { aaa = op.scc & 7; }
        if (op.mask != field.NO_OPERAND) {
            if (s.aaa != 0) { field.replace(dec, op.mask, field.NUMBER, s.aaa::u64); }
        }
        or (s.aaa != aaa) { ret err[field.Refusal].err{mismatch}; }
        if (s.z) {
            if (op.zeroing == field.NO_OPERAND) { ret err[field.Refusal].err{mismatch}; }
            if (s.aaa == 0)                     { ret err[field.Refusal].err{field.refusal(UNMASKED, op.zeroing, dec.start)}; }
            field.replace(dec, op.zeroing, field.NUMBER, x86_opcode.ZEROING::u64);
        }
        if ((op.flags & ND) != 0) {
            if (!s.b) { ret err[field.Refusal].err{mismatch}; }
        }
        or (s.b && holds_memory(dec.operands, op.rm)) {
            val desc: *operand.Operand = ?dec.operands[op.rm];
            val n:    u8               = broadcast_of(op);
            if (!sel desc.shape.memory)                                                                        { ret err[field.Refusal].err{mismatch}; }
            if (desc.shape.memory.broadcasts == 0 || n >= 8 || ((desc.shape.memory.broadcasts >> n) & 1) == 0) { ret err[field.Refusal].err{mismatch}; }
            field.replace(dec, op.rm, field.BROADCAST, n::u64);
        }
        or (s.b) {
            if (op.rounding == field.NO_OPERAND) { ret err[field.Refusal].err{mismatch}; }
            val e: *operand.Operand = ?dec.operands[op.rounding];
            if (!sel e.shape.enumerant) { ret err[field.Refusal].err{mismatch}; }
            if (operand.member(?e.shape.enumerant, s.length::u32)) {
                field.replace(dec, op.rounding, field.NUMBER, s.length::u64);
                length = false;
            }
            or (operand.member(?e.shape.enumerant, x86_opcode.SAE)) {
                field.replace(dec, op.rounding, field.NUMBER, x86_opcode.SAE::u64);
                # sae ignores l'l, so a length other than 0 is the form's
                length = false;
                if (s.length != 0) { dec.form.bits = dec.form.bits | (s.length::u32 << x86_form.LENGTH_SHIFT); }
            }
            or { ret err[field.Refusal].err{mismatch}; }
        }
        or (op.rounding != field.NO_OPERAND && dec.operands[op.rounding].quantity != operand.OPTIONAL) { ret err[field.Refusal].err{mismatch}; }
    }
    if (length) {
        if (op.length == LIG) {
            if (s.length != 0) { dec.form.bits = dec.form.bits | (s.length::u32 << x86_form.LENGTH_SHIFT); }
        }
        or (s.length != op.length) { ret err[field.Refusal].err{mismatch}; }
    }
    ret err[field.Refusal].ok{};
}

# the form bits of a vex or evex prefix's choices `s` that the operands needing `n` of row `op` do not make: the payload
# bits no operand decides, {vex3} where c5 would do, and the space of a row that gives way to its twin
fun vex_complete(dec: *field.Decoder, op: *Opcode, s: *Prefixes, n: *Needs) err[field.Refusal] {
    val payload: u8 = s.payload;
    if ((payload & n.decided) != n.bits) { ret err[field.Refusal].err{field.refusal(field.MISMATCH, field.NO_OPERAND, dec.start)}; }
    if (n.high)                          { ret err[field.Refusal].err{field.refusal(HIGH_BYTE, n.naming, dec.start)}; }
    val free: u8 = payload & ~n.decided;
    if ((free & (R4 | X4 | B4)) != 0) { ret err[field.Refusal].err{field.refusal(UNREAD_BITS, field.NO_OPERAND, dec.start)}; }
    dec.form.bits = dec.form.bits | (free::u32 << x86_form.PAYLOAD_SHIFT);
    if (s.vex == 0xC4 && op.map == 1 && (payload & (W | X3 | B3)) == 0) { dec.form.bits = dec.form.bits | x86_form.VEX3; }
    if (op.twin != 0 && n.reach <= op.twin && !(n.evex && op.space == EVEX)) {
        if (op.space == EVEX) { dec.form.bits = dec.form.bits | x86_form.EVEX; }
        or                    { dec.form.bits = dec.form.bits | x86_form.VEX; }
    }
    ret err[field.Refusal].ok{};
}

# the form bits of what the bytes chose that the operands do not: the prefix run when it is not the canonical one, a
# rex or rex2 prefix no register needs, the payload bits no operand decides and the reg-from-rm direction. and the
# instruction's length
fun head_complete(dec: *field.Decoder, f: *field.Field, at: usize) err[field.Refusal] {
    if (dec.at - dec.start > MAX_LENGTH) { ret err[field.Refusal].err{field.refusal(LONG, field.NO_OPERAND, dec.start)}; }
    val op:  *Opcode                      = opcode_of(f);
    val w:   u8                           = width(dec.ctx);
    val got: res[Prefixes, field.Refusal] = scan(?dec.in, dec.start, w);
    if (sel got.err) { ret err[field.Refusal].err{got.err}; }
    var s:    Prefixes                  = got.ok;
    val need: res[Needs, field.Refusal] = needs(w, op, dec.operands, dec.parts, @dec.form);
    if (sel need.err) {
        var refused: field.Refusal = need.err;
        refused.at = dec.start;
        ret err[field.Refusal].err{refused};
    }
    var n: Needs = need.ok;
    if (op.space != LEGACY) {
        val made: err[field.Refusal] = vex_complete(dec, op, ?s, ?n);
        if (sel made.err) { ret made; }
        n.o66  = false;
        n.rep  = 0;
        n.lock = false;
    }
    var canon: [15]u8;
    val count: u8   = canonical(?n, ?canon[0]);
    var same:  bool = count == s.count;
    var i:     u8   = 0;
    for (same && i < count) {
        if (canon[i] != s.run[i]) { same = false; }
        i = i + 1;
    }
    if (!same) {
        if (!means(?s.run[0], s.count, ?n, op, (s.rex || s.rex2) && (s.payload & W) != 0)) { ret err[field.Refusal].err{field.refusal(RUN, field.NO_OPERAND, dec.start)}; }
        val bits: opt[u32] = slotted(?s.run[0], s.count);
        if (sel bits.none) { ret err[field.Refusal].err{field.refusal(LONG_RUN, field.NO_OPERAND, dec.start)}; }
        dec.form.bits = dec.form.bits | bits.some;
    }
    if (op.space == LEGACY && (s.rex || s.rex2)) {
        val payload: u8 = s.payload & ~M0;
        if ((payload & n.decided) != n.bits) { ret err[field.Refusal].err{field.refusal(field.MISMATCH, field.NO_OPERAND, dec.start)}; }
        if (n.high)                          { ret err[field.Refusal].err{field.refusal(HIGH_BYTE, field.NO_OPERAND, dec.start)}; }
        val free: u8 = payload & ~n.decided;
        dec.form.bits = dec.form.bits | (free::u32 << x86_form.PAYLOAD_SHIFT);
        # a rex2 prefix its row's encoding holds, as jmpabs's, is no choice
        if (s.rex2 && (n.bits & (R4 | X4 | B4)) == 0 && (free & (R4 | X4 | B4)) == 0 && (op.flags & x86_opcode.REX2) == 0) { dec.form.bits = dec.form.bits | x86_form.REX2; }
        if (s.rex && n.bits == 0 && !n.byte && free == 0)                                                                  { dec.form.bits = dec.form.bits | x86_form.REX; }
    }
    if ((op.flags & YIELDS) != 0 && (op.flags & LOAD) != 0)  { dec.form.bits = dec.form.bits | x86_form.LOAD; }
    if ((op.flags & YIELDS) != 0 && (op.flags & STORE) != 0) { dec.form.bits = dec.form.bits | x86_form.STORE; }
    ret err[field.Refusal].ok{};
}

# whether operand `k` of `count` operands is field.NO_OPERAND or one of shape `want`: 1 register, 2 memory, 3 either
fun shaped(operands: *operand.Operand, count: u32, k: u8, want: u8) bool {
    if (k == field.NO_OPERAND) { ret true; }
    if (k::u32 >= count)       { ret false; }
    val sh: *operand.Shape = ?operands[k].shape;
    if (sel sh.register) {
        if ((want & 1) == 0) { ret false; }
        val r: *operand.Register = ?sh.register;
        if (r.first != 0)       { ret false; }
        if (r.classes.len == 1) { ret true; }
        ret r.classes.len == 2 && operand.find(r.classes, gen_register.GPR8_CLASS) >= 0 && operand.find(r.classes, gen_register.GPR8H_CLASS) >= 0;
    }
    if (sel sh.memory) { ret (want & 2) != 0; }
    ret false;
}

# whether operand `k` of `count` operands is field.NO_OPERAND or an enumerant one of `quantity`
fun enumerated(operands: *operand.Operand, count: u32, k: u8, quantity: operand.Quantity) bool {
    if (k == field.NO_OPERAND) { ret true; }
    if (k::u32 >= count)       { ret false; }
    ret sel operands[k].shape.enumerant && operands[k].quantity == quantity;
}

# what is wrong with the vex or evex facts of row `op` holding `count` operands, none when nothing is
fun vex_check(op: *Opcode, operands: *operand.Operand, count: u32) opt[str] {
    val vector:     Flags = W1 | WIG | ND | NF;
    val legacy:     Flags = DEFAULT_64 | IMMUNE_66 | NO_REX2 | REFINED_W | LOCKED | x86_opcode.REX2;
    val extra:      bool  = op.vvvv != field.NO_OPERAND || op.mask != field.NO_OPERAND || op.zeroing != field.NO_OPERAND || op.rounding != field.NO_OPERAND;
    val memory:     bool  = holds_memory(operands, op.rm);
    var broadcasts: u8    = 0;
    if (memory) {
        val desc: *operand.Operand = ?operands[op.rm];
        if (sel desc.shape.memory) { broadcasts = desc.shape.memory.broadcasts; }
    }
    if (op.twin != 0 && op.twin != 16 && op.twin != 32) { ret opt[str].some{RECORD}; }
    if (op.space == LEGACY) {
        if (extra || (op.flags & (W1 | ND | NF)) != 0 || op.length != LIG || op.disp8 != 0 || op.element != 0) { ret opt[str].some{RECORD}; }
        if (op.scc != x86_opcode.NO_SCC)                                                                       { ret opt[str].some{RECORD}; }
        if ((op.flags & x86_opcode.REX2) != 0 && ((op.flags & NO_REX2) != 0 || op.map > 1))                    { ret opt[str].some{RECORD}; }
        if (broadcasts != 0)                                                                                   { ret opt[str].some{BROADCAST_SPACE}; }
        ret opt[str].none{};
    }
    if ((op.flags & legacy) != 0 || op.opreg != field.NO_OPERAND || op.length > LIG || op.map == 0) { ret opt[str].some{RECORD}; }
    if (op.size == O16 && op.simd != NO_SIMD)                                                       { ret opt[str].some{RECORD}; }
    if (op.size != NO_SIZE && (op.flags & (W1 | WIG)) != 0)                                         { ret opt[str].some{RECORD}; }
    if ((op.flags & W1) != 0 && (op.flags & WIG) != 0)                                              { ret opt[str].some{RECORD}; }
    # apx's ccmp and ctest hold their condition in evex map 4 and their default flags in vvvv
    if (op.scc != x86_opcode.NO_SCC) {
        if (op.scc > 15 || op.space != EVEX || op.map != 4 || op.mask != field.NO_OPERAND) { ret opt[str].some{RECORD}; }
        if (!enumerated(operands, count, op.vvvv, operand.ONE))                            { ret opt[str].some{RECORD}; }
    }
    or (!shaped(operands, count, op.vvvv, 1)) { ret opt[str].some{RECORD}; }
    if (op.space == XOP) {
        if (op.map < 8 || op.map > 31 || op.mask != field.NO_OPERAND || op.zeroing != field.NO_OPERAND || op.rounding != field.NO_OPERAND) { ret opt[str].some{RECORD}; }
        if ((op.flags & (ND | NF)) != 0 || op.length == L512 || op.disp8 != 0 || op.element != 0 || op.twin != 0)                          { ret opt[str].some{RECORD}; }
        if (broadcasts != 0)                                                                                                               { ret opt[str].some{BROADCAST_SPACE}; }
        ret opt[str].none{};
    }
    if (op.space == VEX) {
        if (op.map > 31 || op.mask != field.NO_OPERAND || op.zeroing != field.NO_OPERAND || op.rounding != field.NO_OPERAND) { ret opt[str].some{RECORD}; }
        if ((op.flags & (ND | NF)) != 0 || op.length == L512 || op.disp8 != 0 || op.element != 0)                            { ret opt[str].some{RECORD}; }
        if (broadcasts != 0)                                                                                                 { ret opt[str].some{BROADCAST_SPACE}; }
        ret opt[str].none{};
    }
    if (op.map > 7 || op.disp8 > 6) { ret opt[str].some{RECORD}; }
    # an opmask is optional, its absence k0's no masking, or one of k1 to k7 a gather or scatter needs
    if (op.mask != field.NO_OPERAND) {
        if (!shaped(operands, count, op.mask, 1) || operands[op.mask].quantity == operand.VARIADIC) { ret opt[str].some{RECORD}; }
    }
    if (!enumerated(operands, count, op.zeroing, operand.OPTIONAL)) { ret opt[str].some{RECORD}; }
    if (op.zeroing != field.NO_OPERAND) {
        if (op.mask == field.NO_OPERAND)                           { ret opt[str].some{RECORD}; }
        if (memory && (operands[op.rm].role & operand.WRITE) != 0) { ret opt[str].some{ZEROING_STORE}; }
    }
    if (op.rounding != field.NO_OPERAND) {
        if (op.rounding::u32 >= count) { ret opt[str].some{RECORD}; }
        val desc: *operand.Operand = ?operands[op.rounding];
        if (!sel desc.shape.enumerant)             { ret opt[str].some{RECORD}; }
        if (memory)                                { ret opt[str].some{ROUNDING_MEMORY}; }
        if (op.length != L512 && op.length != LIG) { ret opt[str].some{RECORD}; }
    }
    if (broadcasts != 0 && (op.length == LIG || op.element > 4 + op.length)) { ret opt[str].some{BROADCAST_SPACE}; }
    # nd is map 4's, a new data destination, push2's and pop2's pair or setcc's zeroing of the rest, and nf map 4's and
    # the promoted vex instructions' of maps 2 and 3 (Intel APX 355828-009US 3.1.2.3)
    if ((op.flags & ND) != 0 && (op.map != 4 || (memory && broadcasts != 0))) { ret opt[str].some{RECORD}; }
    if ((op.flags & NF) != 0 && (op.map < 2 || op.map > 4))                   { ret opt[str].some{RECORD}; }
    ret opt[str].none{};
}

fun head_check(f: *field.Field, operands: *operand.Operand, count: u32) opt[str] {
    if (f.data == nil) { ret opt[str].some{NO_RECORD}; }
    val op: *Opcode = opcode_of(f);
    if (op.space > XOP || (op.space == LEGACY && op.map > 3 && op.map != NOW_MAP) || op.size > O64 || op.simd > PF2) { ret opt[str].some{RECORD}; }
    if (op.address > x86_opcode.A64)                                                                                 { ret opt[str].some{RECORD}; }
    if (op.map == NOW_MAP && op.reg == field.NO_OPERAND)                                                             { ret opt[str].some{RECORD}; }
    val vex: opt[str] = vex_check(op, operands, count);
    if (sel vex.some)                                                                 { ret vex; }
    if (op.digit != NO_DIGIT && (op.digit > 7 || op.reg != field.NO_OPERAND))         { ret opt[str].some{RECORD}; }
    if (!shaped(operands, count, op.reg, 1) || !shaped(operands, count, op.opreg, 1)) { ret opt[str].some{RECORD}; }
    if (!shaped(operands, count, op.rm, 3) || !shaped(operands, count, op.memory, 2)) { ret opt[str].some{RECORD}; }
    if (op.opreg != field.NO_OPERAND && (op.byte & 7) != 0)                           { ret opt[str].some{RECORD}; }
    if ((op.flags & LOAD) != 0 && (op.flags & STORE) != 0)                            { ret opt[str].some{RECORD}; }
    if (holds_memory(operands, op.rm) && op.memory != op.rm)                          { ret opt[str].some{RECORD}; }
    ret opt[str].none{};
}

fun modrm_check(f: *field.Field, operands: *operand.Operand, count: u32) opt[str] {
    if (f.data == nil) { ret opt[str].some{NO_RECORD}; }
    val op: *Opcode = opcode_of(f);
    if (op.reg == field.NO_OPERAND && op.digit == NO_DIGIT)      { ret opt[str].some{RECORD}; }
    if ((op.rm == field.NO_OPERAND) == (op.rmdigit == NO_DIGIT)) { ret opt[str].some{RECORD}; }
    if (op.rmdigit != NO_DIGIT && op.rmdigit > 7)                { ret opt[str].some{RECORD}; }
    ret opt[str].none{};
}

fun moffs_check(f: *field.Field, operands: *operand.Operand, count: u32) opt[str] {
    if (f.data == nil) { ret opt[str].some{NO_RECORD}; }
    val op: *Opcode = opcode_of(f);
    if (f.operand != op.memory || op.rm != field.NO_OPERAND || !shaped(operands, count, f.operand, 2)) { ret opt[str].some{RECORD}; }
    ret opt[str].none{};
}

# the ModRM.reg bits of the row `op` reads
fun reg_bits(enc: *field.Encoder, op: *Opcode) u64 {
    if (op.digit != NO_DIGIT) { ret op.digit::u64; }
    ret enc.parts[op.reg].bits[field.NUMBER] & 7;
}

# the fixup kind a symbolic displacement takes when its symbol states none: pc-relative for a rip-relative address,
# else absolute at the address size, a 32-bit one sign-extended in 64-bit code, under 32-bit addressing too, as llvm-mc
# 23.1.1 writes R_X86_64_32S for `[ebx + ext]`
fun disp_fixup(p: *field.Parts, w: u8, size: u8) {
    if (p.symbol.fixup != operand.NO_FIXUP) { ret; }
    if (p.bits[field.MODE] == operand.RELATIVE_PC::u64) {
        p.fixup = x86_fixup.PC32;
        ret;
    }
    if (size == 16) {
        p.fixup = x86_fixup.ABS16;
        ret;
    }
    p.fixup = x86_fixup.absolute(32, w == 64);
}

# the displacement of the memory value of operand `op` held to the address size's range
fun disp_admitted(enc: *field.Encoder, op: u8, size: u8) err[field.Refusal] {
    val v: *operand.Value = ?enc.values[op];
    if (!sel v.memory) { ret err[field.Refusal].ok{}; }
    val d:  i64  = v.memory.disp;
    var ok: bool = true;
    val pc: bool = v.memory.mode == operand.RELATIVE_PC;
    if (size == 64 || pc) { ok = fits(d, 32); }
    or {
        val half: i64 = 1::i64 << (size - 1)::i64;
        ok = d >= -half && d < (1::i64 << size::i64);
    }
    if (!ok) { ret field_refused(DISPLACEMENT, op); }
    ret err[field.Refusal].ok{};
}

fun modrm_admit(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val op: *Opcode = opcode_of(f);
    if (op.rm == field.NO_OPERAND) { ret err[field.Refusal].ok{}; }
    val desc: *operand.Operand = ?enc.operands[op.rm];
    if (!sel desc.shape.memory) { ret err[field.Refusal].ok{}; }
    val p:    *field.Parts           = ?enc.parts[op.rm];
    val w:    u8                     = width(enc.ctx);
    val size: res[u8, field.Refusal] = memory_size(w, op, ?desc.shape.memory, p, @enc.form);
    if (sel size.err) { ret field_refused(size.err.message, op.rm); }
    val l: res[Layout, field.Refusal] = layout(w, size.ok, op, ?desc.shape.memory, p, @enc.form, scale_of(op, field.has(p, field.BROADCAST)));
    if (sel l.err) { ret field_refused(l.err.message, op.rm); }
    ret disp_admitted(enc, op.rm, size.ok);
}

fun modrm_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val op:  *Opcode = opcode_of(f);
    val reg: u64     = reg_bits(enc, op);
    # an opcode extension in ModRM.rm is a register form's, mod 11
    if (op.rm == field.NO_OPERAND) { ret field.put(enc, 0xC0 | (reg << 3) | op.rmdigit::u64, 1); }
    val desc: *operand.Operand = ?enc.operands[op.rm];
    val p:    *field.Parts     = ?enc.parts[op.rm];
    if (sel desc.shape.register) { ret field.put(enc, 0xC0 | (reg << 3) | (p.bits[field.NUMBER] & 7), 1); }
    if (!sel desc.shape.memory)  { ret field_refused(field.WRONG_KIND, op.rm); }
    val w:    u8                     = width(enc.ctx);
    val size: res[u8, field.Refusal] = memory_size(w, op, ?desc.shape.memory, p, @enc.form);
    if (sel size.err) { ret field_refused(size.err.message, op.rm); }
    val got: res[Layout, field.Refusal] = layout(w, size.ok, op, ?desc.shape.memory, p, @enc.form, scale_of(op, field.has(p, field.BROADCAST)));
    if (sel got.err) { ret field_refused(got.err.message, op.rm); }
    val l:   Layout             = got.ok;
    val put: err[field.Refusal] = field.put(enc, ((l.mod::u64) << 6) | (reg << 3) | l.rm::u64, 1);
    if (sel put.err) { ret put; }
    if (l.sib) {
        val sib: err[field.Refusal] = field.put(enc, l.scale::u64, 1);
        if (sel sib.err) { ret sib; }
    }
    if (l.disp == 0) { ret err[field.Refusal].ok{}; }
    if (p.symbolic) {
        disp_fixup(p, w, size.ok);
        val noted: err[field.Refusal] = field.fixup(enc, op.rm, enc.out.len - enc.start);
        if (sel noted.err) { ret noted; }
    }
    ret field.put(enc, l.value:~u64 & field.ones(l.disp * 8), l.disp);
}

# the bits of `d` as the operand's displacement holds them
fun disp_bits(m: *operand.Memory, d: i64) u64 {
    ret d:~u64 & field.ones(m.disp.bits);
}

# `bytes` bytes read as a signed number
fun signed_get(dec: *field.Decoder, bytes: u8) res[i64, field.Refusal] {
    val got: res[u64, field.Refusal] = field.get(dec, bytes);
    if (sel got.err) { ret res[i64, field.Refusal].err{got.err}; }
    var raw:  u64 = got.ok;
    val bits: u8  = bytes * 8;
    if (bits < 64 && ((raw >> (bits - 1)::u64) & 1) != 0) { raw = raw | ~field.ones(bits); }
    ret res[i64, field.Refusal].ok{raw:~i64};
}

# the segment register number of segment prefix `b`
fun segment_number(b: u8) u64 {
    var i: u64 = 0;
    for (i < 6) {
        if (SEGMENTS[i] == b) { ret i; }
        i = i + 1;
    }
    ret 0;
}

# the segment of memory operand `op` of shape `m` from the prefixes `s`, where it takes one
fun decode_segment(dec: *field.Decoder, m: *operand.Memory, op: u8, s: *Prefixes) {
    if (s.segment != 0 && m.segment.classes.len > 0) { field.replace(dec, op, field.SEGMENT, segment_number(s.segment)); }
}

# memory operand `op` of row `row` of shape `m` decoded from ModRM bits `mod` and `rm` under prefixes `s`, a disp8
# scaled by 2^`shift`. a vector index's every number is a register, its fifth bit evex.v'
fun decode_address(dec: *field.Decoder, row: *Opcode, m: *operand.Memory, op: u8, mod: u8, rm: u8, s: *Prefixes, w: u8, shift: u8) err[field.Refusal] {
    val at:       usize = dec.at;
    val size:     u8    = address_size(w, s.asz);
    val vectored: bool  = vsib(m);
    val class:    i64   = operand.find(m.base.classes, size_class(size));
    var iclass:   i64   = operand.find(m.index.classes, size_class(size));
    if (vectored)                                                                      { iclass = 0; }
    if ((vectored || (row.flags & x86_opcode.SIBMEM) != 0) && (size == 16 || rm != 4)) { ret err[field.Refusal].err{field.refusal(field.MISMATCH, op, at)}; }
    var b:     i64  = -1;
    var x:     i64  = -1;
    var scale: u64  = 0;
    var wide:  u8   = 0;
    var mode:  u64  = operand.OFFSET::u64;
    var sib:   bool = false;
    val rexed: bool = s.rex || s.rex2 || s.space != LEGACY;
    if (size == 16) {
        if (mod == 0 && rm == 6) { wide = 2; }
        or {
            val bases:   [8]i64 = [8]i64{3, 3, 5, 5, 6, 7, 5, 3};
            val indexes: [8]i64 = [8]i64{6, 7, 6, 7, -1, -1, -1, -1};
            b = bases[rm];
            x = indexes[rm];
            if (mod == 1) { wide = 1; }
            if (mod == 2) { wide = 2; }
        }
    }
    or {
        if (mod == 1) { wide = 1; }
        if (mod == 2) { wide = 4; }
        if (rm == 4) {
            val got: res[u64, field.Refusal] = field.get(dec, 1);
            if (sel got.err) { ret err[field.Refusal].err{got.err}; }
            sib = true;
            val byte: u64 = got.ok;
            scale = byte >> 6;
            var index: u64 = (byte >> 3) & 7;
            if (vectored) {
                if (rexed)           { index = index | extension_of(s.payload, X3, 0); }
                if (s.space == EVEX) { index = index | (s.vvvv & 0x10)::u64; }
                x = index:~i64;
            }
            or {
                if (rexed)      { index = index | extension_of(s.payload, X3, X4); }
                if (index != 4) { x = index:~i64; }
                or (scale != 0) { ret err[field.Refusal].err{field.refusal(NO_SCALE, op, at)}; }
            }
            var base: u64 = byte & 7;
            if (base == 5 && mod == 0) { wide = 4; }
            or {
                if (rexed) { base = base | extension_of(s.payload, B3, B4); }
                b = base:~i64;
            }
        }
        or (rm == 5 && mod == 0) {
            wide = 4;
            if (w == 64) { mode = operand.RELATIVE_PC::u64; }
        }
        or {
            var base: u64 = rm::u64;
            if (rexed) { base = base | extension_of(s.payload, B3, B4); }
            b = base:~i64;
        }
    }
    if ((b >= 0 && class < 0) || (x >= 0 && iclass < 0)) { ret err[field.Refusal].err{field.refusal(ADDRESS, op, at)}; }
    var d: i64 = 0;
    if (wide > 0) {
        val got: res[i64, field.Refusal] = signed_get(dec, wide);
        if (sel got.err) { ret err[field.Refusal].err{got.err}; }
        d = got.ok;
        if (wide == 1) { d = d << shift::i64; }
    }
    if (b >= 0) {
        field.replace(dec, op, field.NUMBER, b:~u64);
        field.replace(dec, op, field.CLASS, class:~u64);
    }
    if (x >= 0) {
        field.replace(dec, op, field.INDEX, x:~u64);
        field.replace(dec, op, field.INDEX_CLASS, iclass:~u64);
        field.replace(dec, op, field.SCALE, scale);
    }
    decode_segment(dec, m, op, s);
    field.replace(dec, op, field.DISP, disp_bits(m, d));
    field.replace(dec, op, field.MODE, mode);
    # an address of no register states its size by the form alone, where the row states none
    if (b < 0 && x < 0 && s.asz && row.address == x86_opcode.NO_ADDRESS) { dec.form.bits = dec.form.bits | x86_form.ADDRESS; }
    # the zero form's layout of what was read, whose displacement width and SIB byte the form restates where they differ
    val preferred: res[Layout, field.Refusal] = layout(w, size, row, m, ?dec.parts[op], @dec.form, shift);
    if (sel preferred.err) {
        var refused: field.Refusal = preferred.err;
        refused.operand = op;
        refused.at      = at;
        ret err[field.Refusal].err{refused};
    }
    if (wide != preferred.ok.disp) {
        if (wide == 1) { dec.form.bits = dec.form.bits | x86_form.DISP8; }
        or             { dec.form.bits = dec.form.bits | x86_form.DISP32; }
    }
    if (sib && !preferred.ok.sib) { dec.form.bits = dec.form.bits | x86_form.SIB; }
    ret err[field.Refusal].ok{};
}

fun modrm_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    val op:  *Opcode                      = opcode_of(f);
    val w:   u8                           = width(dec.ctx);
    val got: res[Prefixes, field.Refusal] = scan(?dec.in, dec.start, w);
    if (sel got.err) { ret err[field.Refusal].err{got.err}; }
    var s:    Prefixes                = got.ok;
    val at:   usize                   = dec.at;
    val read: res[u64, field.Refusal] = field.get(dec, 1);
    if (sel read.err) { ret err[field.Refusal].err{read.err}; }
    val mod:   u8   = (read.ok >> 6)::u8;
    val reg:   u8   = ((read.ok >> 3) & 7)::u8;
    val rm:    u8   = (read.ok & 7)::u8;
    val rexed: bool = s.rex || s.rex2 || s.space != LEGACY;
    if (op.digit != NO_DIGIT) {
        if (reg != op.digit) { ret err[field.Refusal].err{field.refusal(field.MISMATCH, field.NO_OPERAND, at)}; }
    }
    or {
        var n: u64 = reg::u64;
        if (rexed) { n = n | extension_of(s.payload, R3, R4); }
        field.replace(dec, op.reg, field.NUMBER, n);
        field.replace(dec, op.reg, field.CLASS, pick(?dec.operands[op.reg], n, rexed));
    }
    if (op.rm == field.NO_OPERAND) {
        if (mod != 3 || rm != op.rmdigit) { ret err[field.Refusal].err{field.refusal(field.MISMATCH, field.NO_OPERAND, at)}; }
        ret err[field.Refusal].ok{};
    }
    val desc: *operand.Operand = ?dec.operands[op.rm];
    if (sel desc.shape.register) {
        if (mod != 3) { ret err[field.Refusal].err{field.refusal(field.MISMATCH, op.rm, at)}; }
        var n: u64 = rm::u64;
        if (rexed) { n = n | extension_of(s.payload, B3, rm_high(op, desc)); }
        field.replace(dec, op.rm, field.NUMBER, n);
        field.replace(dec, op.rm, field.CLASS, pick(desc, n, rexed));
        ret err[field.Refusal].ok{};
    }
    if (mod == 3)               { ret err[field.Refusal].err{field.refusal(field.MISMATCH, op.rm, at)}; }
    if (!sel desc.shape.memory) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, op.rm, at)}; }
    ret decode_address(dec, op, ?desc.shape.memory, op.rm, mod, rm, ?s, w, scale_of(op, s.b && s.space == EVEX && (op.flags & ND) == 0));
}

# the address size of an a0 to a3 move of row `op` in code of width `w` under form `f`: the row's own, else the width's
# or the other the form overrides it to
fun moffs_size(op: *Opcode, w: u8, f: form.Form) u8 {
    val own: u8 = address_bits(op.address);
    if (own != 0) { ret own; }
    ret address_size(w, overridden(f));
}

# an absolute address of an a0 to a3 move is as wide as the address size, any value of 64 bits and either reading of
# 32 or 16
fun moffs_admit(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val p: *field.Parts = ?enc.parts[f.operand];
    if (registered(p) || p.bits[field.MODE] != operand.OFFSET::u64) { ret field_refused(field.FORM, f.operand); }
    val size: u8             = moffs_size(opcode_of(f), width(enc.ctx), @enc.form);
    val v:    *operand.Value = ?enc.values[f.operand];
    if (size == 64)    { ret err[field.Refusal].ok{}; }
    if (!sel v.memory) { ret err[field.Refusal].ok{}; }
    val d:    i64 = v.memory.disp;
    val half: i64 = 1::i64 << (size - 1)::i64;
    if (d < -half || d >= (1::i64 << size::i64)) { ret field_refused(DISPLACEMENT, f.operand); }
    ret err[field.Refusal].ok{};
}

fun moffs_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val p:     *field.Parts = ?enc.parts[f.operand];
    val size:  u8           = moffs_size(opcode_of(f), width(enc.ctx), @enc.form);
    val bytes: u8           = size / 8;
    if (p.symbolic) {
        if (p.symbol.fixup == operand.NO_FIXUP) { p.fixup = x86_fixup.absolute(size, false); }
        val noted: err[field.Refusal] = field.fixup(enc, f.operand, enc.out.len - enc.start);
        if (sel noted.err) { ret noted; }
    }
    ret field.put(enc, p.bits[field.DISP] & field.ones(size), bytes);
}

fun moffs_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    val w:   u8                           = width(dec.ctx);
    val got: res[Prefixes, field.Refusal] = scan(?dec.in, dec.start, w);
    if (sel got.err) { ret err[field.Refusal].err{got.err}; }
    val desc: *operand.Operand = ?dec.operands[f.operand];
    if (!sel desc.shape.memory) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, dec.at)}; }
    val size: u8                      = address_size(w, got.ok.asz);
    val addr: res[u64, field.Refusal] = field.get(dec, size / 8);
    if (sel addr.err) { ret err[field.Refusal].err{addr.err}; }
    var s: Prefixes = got.ok;
    decode_segment(dec, ?desc.shape.memory, f.operand, ?s);
    field.replace(dec, f.operand, field.DISP, addr.ok & field.ones(desc.shape.memory.disp.bits));
    field.replace(dec, f.operand, field.MODE, operand.OFFSET::u64);
    if (got.ok.asz && opcode_of(f).address == x86_opcode.NO_ADDRESS) { dec.form.bits = dec.form.bits | x86_form.ADDRESS; }
    ret err[field.Refusal].ok{};
}

fun string_check(f: *field.Field, operands: *operand.Operand, count: u32) opt[str] {
    if (f.data == nil) { ret opt[str].some{NO_RECORD}; }
    val op: *Opcode = opcode_of(f);
    if (op.address == x86_opcode.NO_ADDRESS || !shaped(operands, count, f.operand, 2)) { ret opt[str].some{RECORD}; }
    val desc: *operand.Operand = ?operands[f.operand];
    if (!sel desc.shape.memory) { ret opt[str].some{RECORD}; }
    val m: *operand.Memory = ?desc.shape.memory;
    if (m.base.count != 1 || m.base.classes.len != 1 || m.index.classes.len != 0 || m.disp.bits != 0) { ret opt[str].some{RECORD}; }
    if (class_size(m.base.classes.at[0]) != address_bits(op.address))                                 { ret opt[str].some{RECORD}; }
    ret opt[str].none{};
}

# a string's memory is its one register, which no byte encodes and the row's address size states, in its segment or
# the one its prefix overrides it to where it takes one
fun string_admit(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val p: *field.Parts = ?enc.parts[f.operand];
    if (!field.has(p, field.NUMBER) || field.has(p, field.INDEX) || p.bits[field.MODE] != operand.OFFSET::u64 || p.symbolic) { ret field_refused(field.FORM, f.operand); }
    ret err[field.Refusal].ok{};
}

fun string_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    ret string_admit(enc, f);
}

fun string_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    val desc: *operand.Operand = ?dec.operands[f.operand];
    if (!sel desc.shape.memory) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, dec.at)}; }
    val got: res[Prefixes, field.Refusal] = scan(?dec.in, dec.start, width(dec.ctx));
    if (sel got.err) { ret err[field.Refusal].err{got.err}; }
    var s: Prefixes = got.ok;
    field.replace(dec, f.operand, field.NUMBER, 0);
    field.replace(dec, f.operand, field.CLASS, 0);
    field.replace(dec, f.operand, field.DISP, 0);
    field.replace(dec, f.operand, field.MODE, operand.OFFSET::u64);
    if (desc.shape.memory.segment.count != 1) { decode_segment(dec, ?desc.shape.memory, f.operand, ?s); }
    ret err[field.Refusal].ok{};
}

pub val HEAD:   field.Kind = field.Kind{name: "head", admit: head_admit, encode: head_encode, decode: head_decode, finish: head_finish, complete: head_complete, check: head_check};
pub val MODRM:  field.Kind = field.Kind{name: "modrm", admit: modrm_admit, encode: modrm_encode, decode: modrm_decode, finish: nil, complete: nil, check: modrm_check};
pub val MOFFS:  field.Kind = field.Kind{name: "moffs", admit: moffs_admit, encode: moffs_encode, decode: moffs_decode, finish: nil, complete: nil, check: moffs_check};
pub val STRING: field.Kind = field.Kind{name: "string", admit: string_admit, encode: string_encode, decode: string_decode, finish: nil, complete: nil, check: string_check};

val KINDS: [5]*field.Kind = [5]*field.Kind{?field.UNIT, ?HEAD, ?MODRM, ?MOFFS, ?STRING};

# the x86 field table: units are little-endian
pub val TABLE: field.Table = field.Table{kinds: ?KINDS[0], count: 5, order: field.LITTLE};

# the prefixes `bytes` scan to in code of width `w`
#[testing]
fun t_scan(bytes: *u8, len: usize, w: u8) res[Prefixes, field.Refusal] {
    var s: field.Stream = field.Stream{data: bytes, len: len, order: field.LITTLE};
    ret scan(?s, 0, w);
}

# 0x40 is inc eax's opcode in 32-bit code and a rex prefix in 64-bit code, and the last of f2 and f3 is the one that holds
test scan__a_prefix_byte_reads_by_the_code_width {
    val inc:    [3]u8                        = [3]u8{0x40, 0x01, 0xC0};
    val narrow: res[Prefixes, field.Refusal] = t_scan(?inc[0], 3, 32);
    if (sel narrow.err)                         { ret 1; }
    if (narrow.ok.opcode != 0 || narrow.ok.rex) { ret 1; }
    val wide: res[Prefixes, field.Refusal] = t_scan(?inc[0], 3, 64);
    if (sel wide.err)                                                { ret 2; }
    if (wide.ok.opcode != 1 || !wide.ok.rex || wide.ok.payload != 0) { ret 2; }
    val popcnt: [5]u8                        = [5]u8{0xF2, 0xF3, 0x0F, 0xB8, 0xC0};
    val p:      res[Prefixes, field.Refusal] = t_scan(?popcnt[0], 5, 64);
    if (sel p.err)                                                                { ret 3; }
    if (p.ok.rep != 0xF3 || p.ok.count != 2 || p.ok.map != 1 || p.ok.opcode != 3) { ret 3; }
    # a rex prefix a legacy prefix follows is ignored by the processor, and refused
    val ignored: [4]u8                        = [4]u8{0x48, 0x66, 0x89, 0xC0};
    val r:       res[Prefixes, field.Refusal] = t_scan(?ignored[0], 4, 64);
    if (!sel r.err)                   { ret 4; }
    if (r.err.message != IGNORED_REX) { ret 4; }
    # rex2's m0 is map 1 with no escape
    val rex2: [4]u8                        = [4]u8{0xD5, 0x80, 0xAF, 0xC0};
    val q:    res[Prefixes, field.Refusal] = t_scan(?rex2[0], 4, 64);
    if (sel q.err)                                       { ret 5; }
    if (!q.ok.rex2 || q.ok.map != 1 || q.ok.opcode != 2) { ret 5; }
    ret 0;
}
