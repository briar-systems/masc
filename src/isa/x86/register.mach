use x86_extension: masc.isa.x86.extension;

val XLEN_FIXES: [1]register.Fixing = [1]register.Fixing{
    register.Fixing{by: x86_extension.X64, multiplier: 2},
};

val SCALES: [1]register.Scale = [1]register.Scale{
    register.Scale{name: "xlen", max: 2, fixes: register.Fixings{at: ?XLEN_FIXES[0], len: 1}},
};

val CLASSES: [21]register.Class = [21]register.Class{
    register.Class{name: "gpr64", kind: register.GENERAL, width: register.Scaled{fixed: 64, per: 0, scale: 0}, count: 32},
    register.Class{name: "gpr32", kind: register.GENERAL, width: register.Scaled{fixed: 32, per: 0, scale: 0}, count: 32},
    register.Class{name: "gpr16", kind: register.GENERAL, width: register.Scaled{fixed: 16, per: 0, scale: 0}, count: 32},
    register.Class{name: "gpr8", kind: register.GENERAL, width: register.Scaled{fixed: 8, per: 0, scale: 0}, count: 32},
