# the x86-64 register file: the general registers at each width, the vector, opmask, x87, mmx and amx state, the segment, control and debug
# registers, the flags and the instruction pointer, their dwarf and codeview numbers, and what a write through each leaves
#
# the rows are generated, by gen x86 into gen_register from the register families under gen/data/x86/registers, where the sources of
# every number and write extension are cited, and each bank, offset and requirement is derived from them. this module is the file as the
# set reads it, and its tests state what the register queries answer on it
#
# a register of one width is a row of its own class, as the class holds one width, and the views of one physical register share its
# bank: al, ax, eax and rax are rows of one bank and ah is that bank at bit 8. the file has one scale, xlen, the width of the 64-bit
# registers cr, dr, rflags and rip, which the 64-bit mode fixes at 2, and 32-bit x86 fixes it at 1 once the catalog has the mode.
# the x87 registers share one bank. st(i) is named relative to the stack top, so it states the eight physical registers as its places
# and overlaps every st and mm row, lies within none and kills none. mm<n> is the low 64 bits of physical register n, and its write
# reaches only that register's exponent

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.view;

use std.allocator.testing;
use std.print;

use masc.check.check;
use check_register: masc.check.register;
use masc.core.constraint;
use masc.core.diagnostic;
use masc.core.dispatch;
use masc.core.effect;
use masc.core.extension;
use masc.core.index;
use masc.core.operand;
use masc.core.register;
use masc.core.row;
use S: masc.core.set;
use masc.core.state;
use x86_extension: masc.isa.x86.extension;

use masc.isa.x86.gen_register;

pub val FILE: register.File = gen_register.FILE;

val RIP_CLASS: u16 = gen_register.RIP_CLASS;

# the tests read the real file through the core queries

# the row named `name`, read from the rows so an unspelled one, which the name index leaves out, is found too
#[testing]
fun t_row(name: str) *register.Register {
    var i: u32 = 0;
    for (i < FILE.register_count) {
        if (str_equals(FILE.registers[i].name, name)) { ret ?FILE.registers[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether `part` lies in `whole` as one piece of `width` bits at bit `offset`
#[testing]
fun t_inside(part: str, whole: str, offset: u64, width: u64) bool {
    val p: *register.Register = t_row(part);
    val w: *register.Register = t_row(whole);
    if (p == nil || w == nil) { ret false; }
    val at: opt[register.Placement] = register.within(?FILE, p, w, 1);
    if (sel at.none) { ret false; }
    ret at.some.offset == offset && at.some.width == width && at.some.count == 1;
}

#[testing]
fun t_apart(part: str, whole: str) bool {
    val p: *register.Register = t_row(part);
    val w: *register.Register = t_row(whole);
    if (p == nil || w == nil) { ret false; }
    val at: opt[register.Placement] = register.within(?FILE, p, w, 1);
    ret sel at.none;
}

#[testing]
fun t_overlap(a: str, b: str) bool {
    val x: *register.Register = t_row(a);
    val y: *register.Register = t_row(b);
    if (x == nil || y == nil) { ret false; }
    ret register.overlap(?FILE, x, y) && register.overlap(?FILE, y, x);
}

# whether a write through `written` overwrites `other`, as its row states
#[testing]
fun t_kills(written: str, other: str) bool {
    val x: *register.Register = t_row(written);
    val y: *register.Register = t_row(other);
    if (x == nil || y == nil) { ret false; }
    ret register.overwrites(?FILE, x, y, opt[register.Extend].none{});
}

# the same where the instruction's encoding states that it zeroes the rest of the bank
#[testing]
fun t_kills_zeroing(written: str, other: str) bool {
    val x: *register.Register = t_row(written);
    val y: *register.Register = t_row(other);
    if (x == nil || y == nil) { ret false; }
    ret register.overwrites(?FILE, x, y, opt[register.Extend].some{register.ZEROES});
}

test within__a_sub_register_lies_at_its_offset_in_every_wider_view {
    if (!t_inside("al", "ax", 0, 8) || !t_inside("al", "eax", 0, 8) || !t_inside("al", "rax", 0, 8))                 { ret 1; }
    if (!t_inside("ah", "ax", 8, 8) || !t_inside("ah", "eax", 8, 8) || !t_inside("ah", "rax", 8, 8))                 { ret 2; }
    if (!t_inside("ax", "eax", 0, 16) || !t_inside("eax", "rax", 0, 32) || !t_inside("ax", "rax", 0, 16))            { ret 3; }
    if (!t_inside("bh", "rbx", 8, 8) || !t_inside("spl", "rsp", 0, 8) || !t_inside("dil", "edi", 0, 8))              { ret 4; }
    if (!t_inside("r8b", "r8w", 0, 8) || !t_inside("r8w", "r8d", 0, 16) || !t_inside("r8d", "r8", 0, 32))            { ret 5; }
    if (!t_inside("r16b", "r16", 0, 8) || !t_inside("r31d", "r31", 0, 32))                                           { ret 6; }
    if (!t_inside("xmm3", "ymm3", 0, 128) || !t_inside("ymm3", "zmm3", 0, 256) || !t_inside("xmm3", "zmm3", 0, 128)) { ret 7; }
    if (!t_inside("xmm31", "zmm31", 0, 128))                                                                         { ret 8; }
    if (!t_inside("rflags.cf", "rflags", 0, 1) || !t_inside("rflags.id", "rflags", 21, 1))                           { ret 9; }
    ret 0;
}

test within__a_wider_view_or_another_register_is_not_inside {
    if (!t_apart("ah", "al") || !t_apart("al", "ah") || !t_apart("eax", "ax") || !t_apart("rax", "eax"))      { ret 1; }
    if (!t_apart("ah", "spl") || !t_apart("bh", "rax") || !t_apart("al", "rsp"))                              { ret 2; }
    if (!t_apart("ymm0", "xmm0") || !t_apart("zmm0", "ymm0") || !t_apart("xmm0", "xmm1"))                     { ret 3; }
    if (!t_apart("rflags", "rflags.cf") || !t_apart("rflags.cf", "rflags.zf"))                                { ret 4; }
    if (!t_apart("st0", "st1") || !t_apart("st3", "mm3") || !t_apart("mm3", "st3") || !t_apart("st0", "st0")) { ret 5; }
    ret 0;
}

test overlap__registers_share_storage_exactly_where_their_footprints_meet {
    if (!t_overlap("ah", "ax") || !t_overlap("ah", "eax") || !t_overlap("ah", "rax") || !t_overlap("ch", "rcx"))      { ret 1; }
    if (t_overlap("ah", "al") || t_overlap("ah", "rcx") || t_overlap("ch", "rax") || t_overlap("ah", "spl"))          { ret 2; }
    if (t_overlap("rax", "rcx") || t_overlap("xmm0", "xmm1") || t_overlap("xmm0", "k0") || t_overlap("tmm0", "tmm1")) { ret 3; }
    if (!t_overlap("xmm9", "zmm9") || !t_overlap("ymm9", "zmm9") || !t_overlap("tmm3", "tmm3"))                       { ret 4; }
    if (!t_overlap("rflags", "rflags.df") || t_overlap("rflags.df", "rflags.cf"))                                     { ret 5; }
    # st(i) may be any physical x87 register
    if (!t_overlap("st0", "st1") || !t_overlap("st0", "st7") || !t_overlap("st0", "mm3") || !t_overlap("st5", "mm7")) { ret 6; }
    if (t_overlap("mm0", "mm1") || t_overlap("mm3", "mm4") || t_overlap("st0", "xmm0") || t_overlap("mm0", "xmm0"))   { ret 7; }
    ret 0;
}

test overwrites__a_write_overwrites_its_footprint_and_what_its_row_or_encoding_extends_through {
    if (!t_kills("eax", "rax") || !t_kills("eax", "ax") || !t_kills("eax", "ah") || !t_kills("r8d", "r8b") || !t_kills("r31d", "r31")) { ret 1; }
    if (t_kills("ax", "rax") || t_kills("ax", "eax") || !t_kills("ax", "al") || !t_kills("ax", "ah"))                                  { ret 2; }
    if (t_kills("al", "ah") || t_kills("ah", "al") || t_kills("al", "ax") || t_kills("rax", "rcx") || !t_kills("rax", "ah"))           { ret 3; }
    if (!t_kills_zeroing("ax", "rax") || !t_kills_zeroing("r16b", "r16"))                                                              { ret 4; }
    if (t_kills("xmm0", "ymm0") || t_kills("xmm0", "zmm0") || !t_kills_zeroing("xmm0", "zmm0") || !t_kills_zeroing("xmm9", "ymm9"))    { ret 5; }
    if (!t_kills("ymm0", "zmm0") || !t_kills("ymm0", "xmm0") || !t_kills("zmm0", "ymm0") || t_kills("zmm0", "zmm1"))                   { ret 6; }
    if (!t_kills("xmm16", "zmm16") || !t_kills("xmm31", "ymm31") || !t_kills("xmm16", "xmm16"))                                        { ret 7; }
    if (!t_kills("rflags", "rflags.cf") || t_kills("rflags.cf", "rflags") || t_kills("rflags.cf", "rflags.zf"))                        { ret 8; }
    # an mmx write sets the exponent of its own x87 register only, so it kills no other mm row and no st row, and no st write kills
    if (!t_kills("mm3", "mm3") || t_kills("mm3", "mm0") || t_kills("mm3", "mm4") || t_kills("mm3", "st0") || t_kills("mm3", "st3")) { ret 9; }
    if (t_kills_zeroing("mm3", "mm4") || t_kills("st0", "st1") || t_kills("st0", "mm0") || t_kills("st0", "st0"))                   { ret 10; }
    ret 0;
}

# legacy pcmpistrm writes xmm0 and keeps the rest of ymm0, and vex vpcmpistrm states that its write of xmm0 zeroes it, so
# only the vex effect's write kills ymm0 (#252)
test kills__an_implicit_write_extends_as_its_encoding_states {
    val xmm0: opt[u32]         = register.row_named(?FILE, view("xmm0", 4), false);
    val ymm0: opt[register.Id] = register.named(?FILE, view("ymm0", 4), false);
    if (!sel xmm0.some) { ret 1; }
    if (!sel ymm0.some) { ret 1; }
    val n: u32 = effect.words(?FILE);
    if (n > 8) { ret 2; }
    var words: [8]u64 = [8]u64{0, 0, 0, 0, 0, 0, 0, 0};
    words[xmm0.some / 64] = 1::u64 << (xmm0.some % 64)::u64;
    val written: effect.Touched = effect.Touched{read: effect.NO_WORDS, written: effect.Set{words: ?words[0], len: n}};
    var legacy:  effect.Effect;
    legacy.implicit = effect.Registers.ruled{effect.Ruled{otherwise: written, rules: effect.NO_REGISTER_RULES, may: written, must: written}};
    var vex:     effect.Effect           = legacy;
    val zeroing: [1]effect.ImplicitWrite = [1]effect.ImplicitWrite{effect.ImplicitWrite{row: xmm0.some, write: operand.Write{extend: opt[register.Extend].some{register.ZEROES}, result: 0, above: register.UNSTATED}}};
    vex.writes = effect.Writes{at: ?zeroing[0], len: 1};
    val none:  operand.Values      = operand.Values{at: nil, len: 0};
    val kept:  effect.Answer[bool] = constraint.kills(?FILE, nil, ?legacy, none, constraint.UNIT, ymm0.some);
    val freed: effect.Answer[bool] = constraint.kills(?FILE, nil, ?vex, none, constraint.UNIT, ymm0.some);
    if (!sel kept.decided)              { ret 3; }
    if (!sel freed.decided)             { ret 3; }
    if (kept.decided || !freed.decided) { ret 4; }
    ret 0;
}

test row__roles_and_widths {
    if (t_row("rsp").flags != register.STACK || t_row("esp").flags != 0 || t_row("rip").flags != register.PC) { ret 1; }
    if (t_row("rax") == nil || t_row("eax") == nil || t_row("rflags.of") == nil || t_row("fs") == nil)        { ret 2; }
    ret 0;
}

#[testing]
fun t_spelled(name: str) bool {
    val found: opt[register.Id] = register.named(?FILE, view(name, str_len(name)), false);
    ret sel found.some;
}

# the state no syntax spells is rows the name index leaves out, so the parser reads their names as unknown (#279)
test named__an_unspelled_register_is_a_row_no_name_finds {
    val unspelled: [8]str = [8]str{"rflags.cf", "rflags.id", "fcw", "fsw", "tilecfg", "fs.base", "gs.base", "ldtr"};
    var i:         u32    = 0;
    for (i < 8) {
        val r: *register.Register = t_row(unspelled[i]);
        if (r == nil || (r.flags & register.UNSPELLED) == 0) { ret 1; }
        if (t_spelled(unspelled[i]))                         { ret 2; }
        i = i + 1;
    }
    if (t_row("tr") == nil || t_spelled("tr"))                                     { ret 3; }
    if (!t_spelled("rflags") || (t_row("rflags").flags & register.UNSPELLED) != 0) { ret 4; }
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    var v: register.Available;
    if (!t_view(?t, "x87", 2, ?s, ?v)) { ret 5; }
    val fcw: res[register.Id, register.Absent] = register.lookup(?v, view("fcw", 3));
    val fs:  res[register.Id, register.Absent] = register.lookup(?v, view("fs", 2));
    if (!(sel fcw.err && sel fcw.err.unknown) || !sel fs.ok) { ret 6; }
    register.release(?v);
    extension.release(?s);
    ret 0;
}

# the view of the file through the selection `spelling` at code width `width`, an index of the width axis's values
#[testing]
fun t_view(t: *testing.Testing, spelling: str, width: u8, s: *extension.Selection, v: *register.Available) bool {
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(t), ?x86_extension.CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    @s = made.ok;
    var start: state.Settings = state.initial(?x86_extension.AXES);
    start.at[0] = width;
    val opened: res[state.Context, state.Opened] = state.open(testing.allocator_of(t), ?FILE, s, ?x86_extension.AXES, start, v);
    ret sel opened.ok;
}

# whether `name` is admitted by the file viewed through the selection `spelling` in 64-bit code, or in 32-bit code
# unless `wide`
#[testing]
fun t_available(spelling: str, wide: bool, name: str) bool {
    var t: testing.Testing;
    testing.make(?t);
    var width: u8 = 1;
    if (wide) { width = 2; }
    var s: extension.Selection;
    var v: register.Available;
    if (!t_view(?t, spelling, width, ?s, ?v)) { ret false; }
    val r:    *register.Register = t_row(name);
    var held: bool               = false;
    if (r != nil) {
        val admitted: err[register.Absent] = register.admitted(?v, register.id_of(r));
        held = sel admitted.ok;
    }
    register.release(?v);
    extension.release(?s);
    ret held;
}

# a register exists where the atoms it requires are held: the 64-bit registers in 64-bit code, the apx and amx
# registers only there
test select__a_register_exists_only_where_its_atoms_are_held {
    if (!t_available("", true, "rax") || !t_available("", true, "r15b") || !t_available("", true, "ah"))                                                                   { ret 1; }
    if (t_available("", true, "r16") || t_available("", true, "r16b") || t_available("", true, "xmm0"))                                                                    { ret 2; }
    if (!t_available("apx_f", true, "r16") || !t_available("apx_f", true, "r31b") || !t_available("apx_f", true, "rax"))                                                   { ret 3; }
    if (!t_available("sse", false, "xmm7") || !t_available("sse", false, "eax") || !t_available("sse", false, "ah"))                                                       { ret 4; }
    if (t_available("sse", false, "rax") || t_available("sse", false, "xmm8") || t_available("sse", false, "r8d") || t_available("sse", false, "spl"))                     { ret 5; }
    if (!t_available("sse", true, "xmm15") || t_available("sse", true, "xmm16") || t_available("sse", true, "ymm0"))                                                       { ret 6; }
    if (!t_available("avx", false, "ymm7") || t_available("avx", false, "ymm8") || t_available("avx", false, "zmm0") || t_available("avx", false, "k0"))                   { ret 7; }
    if (!t_available("avx512f", true, "zmm31") || !t_available("avx512f", true, "k7") || !t_available("avx512f", true, "xmm16") || !t_available("avx512f", true, "ymm31")) { ret 8; }
    if (!t_available("avx512f", false, "zmm7") || t_available("avx512f", false, "zmm8") || t_available("avx512f", false, "xmm16"))                                         { ret 9; }
    if (!t_available("amx_tile", true, "tmm7") || !t_available("amx_tile", true, "tilecfg") || t_available("amx_tile", false, "tmm0") || t_available("sse", true, "tmm0")) { ret 10; }
    if (!t_available("x87", false, "fcw") || !t_available("x87", false, "fsw") || t_available("sse", false, "fcw"))                                                        { ret 11; }
    if (!t_available("x87", false, "st7") || t_available("x87", false, "mm0") || !t_available("mmx", false, "mm7") || t_available("sse", false, "st0"))                    { ret 13; }
    if (!t_available("sse", false, "mxcsr") || t_available("avx512f", false, "tilecfg") || !t_available("sse", false, "rflags.zf") || !t_available("sse", false, "cs"))    { ret 12; }
    ret 0;
}

#[testing]
fun t_rip_width(width: u8, known: *bool, bits: *u64) bool {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    var v: register.Available;
    if (!t_view(?t, "sse", width, ?s, ?v)) { ret false; }
    val w:    res[opt[u64], register.Absent] = register.width(?v, register.make(RIP_CLASS, 0));
    var held: bool                           = false;
    if (sel w.ok) {
        held   = true;
        @known = sel w.ok.some;
        if (sel w.ok.some) { @bits = w.ok.some; }
    }
    register.release(?v);
    extension.release(?s);
    ret held;
}

# the code width binds xlen: rip is 64 bits in 64-bit code and 32 bits in 16-bit and 32-bit code, as eip
test width__the_wide_registers_resolve_where_the_code_width_bounds_xlen {
    var known: bool = false;
    var bits:  u64  = 0;
    if (!t_rip_width(2, ?known, ?bits) || !known || bits != 64) { ret 1; }
    if (!t_rip_width(1, ?known, ?bits) || !known || bits != 32) { ret 2; }
    if (!t_rip_width(0, ?known, ?bits) || !known || bits != 32) { ret 3; }
    ret 0;
}

# a context of no extension at code width `width`, an index of the width axis's values, which is all a debug column's
# flavour reads
#[testing]
fun t_number_at(width: u8, name: str, format: register.Format) opt[u32] {
    val r: *register.Register = t_row(name);
    if (r == nil) { ret opt[u32].none{}; }
    var words: [16]u64;
    var s:     extension.Selection;
    var start: state.Settings = state.initial(?x86_extension.AXES);
    start.at[0] = width;
    var ctx: state.Context = state.t_bare(?x86_extension.CATALOG, ?x86_extension.AXES, start, ?words[0], 16, ?s);
    ret state.debug_number(?FILE, register.id_of(r), format, ?ctx);
}

#[testing]
fun t_from(width: u8, number: u32, format: register.Format) opt[register.Id] {
    var words: [16]u64;
    var s:     extension.Selection;
    var start: state.Settings = state.initial(?x86_extension.AXES);
    start.at[0] = width;
    var ctx: state.Context = state.t_bare(?x86_extension.CATALOG, ?x86_extension.AXES, start, ?words[0], 16, ?s);
    ret state.from_debug_number(?FILE, number, format, ?ctx);
}

#[testing]
fun t_number(name: str, format: register.Format, want: u32) bool {
    val n: opt[u32] = t_number_at(2, name, format);
    ret sel n.some && n.some == want;
}

#[testing]
fun t_number32(name: str, want: u32) bool {
    val n: opt[u32] = t_number_at(1, name, register.DWARF);
    ret sel n.some && n.some == want;
}

#[testing]
fun t_unnumbered(name: str, format: register.Format) bool {
    if (t_row(name) == nil) { ret false; }
    val n: opt[u32] = t_number_at(2, name, format);
    ret sel n.none;
}

test debug_number__dwarf_follows_the_psabi_table_and_leaves_views_unnumbered {
    if (!t_number("rax", register.DWARF, 0) || !t_number("rdx", register.DWARF, 1) || !t_number("rcx", register.DWARF, 2) || !t_number("rbx", register.DWARF, 3))                                                        { ret 1; }
    if (!t_number("rsi", register.DWARF, 4) || !t_number("rdi", register.DWARF, 5) || !t_number("rbp", register.DWARF, 6) || !t_number("rsp", register.DWARF, 7))                                                        { ret 2; }
    if (!t_number("r8", register.DWARF, 8) || !t_number("r15", register.DWARF, 15))                                                                                                                                      { ret 3; }
    if (!t_number("xmm0", register.DWARF, 17) || !t_number("xmm7", register.DWARF, 24) || !t_number("xmm15", register.DWARF, 32))                                                                                        { ret 4; }
    if (!t_number("st0", register.DWARF, 33) || !t_number("st7", register.DWARF, 40) || !t_number("mm0", register.DWARF, 41) || !t_number("mm7", register.DWARF, 48))                                                    { ret 5; }
    if (!t_number("rflags", register.DWARF, 49) || !t_number("es", register.DWARF, 50) || !t_number("gs", register.DWARF, 55))                                                                                           { ret 6; }
    if (!t_number("mxcsr", register.DWARF, 64) || !t_number("fcw", register.DWARF, 65) || !t_number("fsw", register.DWARF, 66))                                                                                          { ret 7; }
    if (!t_number("xmm16", register.DWARF, 67) || !t_number("xmm31", register.DWARF, 82) || !t_number("k0", register.DWARF, 118) || !t_number("k7", register.DWARF, 125))                                                { ret 8; }
    if (!t_number("r16", register.DWARF, 130) || !t_number("r31", register.DWARF, 145) || !t_number("tmm0", register.DWARF, 146) || !t_number("tmm7", register.DWARF, 153) || !t_number("tilecfg", register.DWARF, 154)) { ret 9; }
    if (!t_unnumbered("eax", register.DWARF) || !t_unnumbered("al", register.DWARF) || !t_unnumbered("ymm0", register.DWARF) || !t_unnumbered("zmm0", register.DWARF))                                                   { ret 10; }
    if (!t_unnumbered("rip", register.DWARF) || !t_unnumbered("rflags.cf", register.DWARF) || !t_unnumbered("cr0", register.DWARF))                                                                                      { ret 11; }
    val ra: opt[register.Id] = t_from(2, 16, register.DWARF);
    val sp: opt[register.Id] = t_from(2, 7, register.DWARF);
    if (!sel ra.none || !(sel sp.some && sp.some == register.id_of(t_row("rsp"))))                                                                                            { ret 12; }
    if (!t_number("fs.base", register.DWARF, 58) || !t_number("gs.base", register.DWARF, 59) || !t_number("tr", register.DWARF, 62) || !t_number("ldtr", register.DWARF, 63)) { ret 13; }
    ret 0;
}

# 16 and 32-bit code read the i386 psabi's column, which numbers the 32-bit registers where 64-bit code numbers the 64-bit
# ones, and its return address column 8 numbers no register (#277)
test debug_number__32_bit_code_reads_the_i386_column {
    if (!t_number32("eax", 0) || !t_number32("ecx", 1) || !t_number32("esp", 4) || !t_number32("edi", 7) || !t_number32("rflags", 9))     { ret 1; }
    if (!t_number32("st0", 11) || !t_number32("xmm7", 28) || !t_number32("mm0", 29) || !t_number32("mxcsr", 39) || !t_number32("gs", 45)) { ret 2; }
    if (!t_number32("tr", 48) || !t_number32("ldtr", 49) || !t_number32("fs.base", 93) || !t_number32("gs.base", 94))                     { ret 3; }
    val rsp:  opt[u32]         = t_number_at(1, "rsp", register.DWARF);
    val k0:   opt[u32]         = t_number_at(1, "k0", register.DWARF);
    val ra:   opt[register.Id] = t_from(1, 8, register.DWARF);
    val sp:   opt[register.Id] = t_from(1, 4, register.DWARF);
    val wide: opt[register.Id] = t_from(2, 4, register.DWARF);
    if (!sel rsp.none || !sel k0.none || !sel ra.none)                                                                              { ret 4; }
    if (!(sel sp.some && sp.some == register.id_of(t_row("esp"))) || !(sel wide.some && wide.some == register.id_of(t_row("rsi")))) { ret 5; }
    val cv: opt[u32] = t_number_at(0, "eax", register.CODEVIEW);
    if (!(sel cv.some && cv.some == 17)) { ret 6; }
    ret 0;
}

test debug_number__codeview_follows_the_def_and_numbers_every_width_of_a_general_register {
    if (!t_number("al", register.CODEVIEW, 1) || !t_number("ah", register.CODEVIEW, 5) || !t_number("ax", register.CODEVIEW, 9) || !t_number("eax", register.CODEVIEW, 17))                                                                                                        { ret 1; }
    if (!t_number("rax", register.CODEVIEW, 328) || !t_number("rsp", register.CODEVIEW, 335) || !t_number("r8", register.CODEVIEW, 336) || !t_number("r15", register.CODEVIEW, 343))                                                                                               { ret 2; }
    if (!t_number("spl", register.CODEVIEW, 327) || !t_number("r8b", register.CODEVIEW, 344) || !t_number("r8w", register.CODEVIEW, 352) || !t_number("r8d", register.CODEVIEW, 360))                                                                                              { ret 3; }
    if (!t_number("r16", register.CODEVIEW, 856) || !t_number("r16b", register.CODEVIEW, 872) || !t_number("r16w", register.CODEVIEW, 888) || !t_number("r31d", register.CODEVIEW, 919))                                                                                           { ret 4; }
    if (!t_number("es", register.CODEVIEW, 25) || !t_number("gs", register.CODEVIEW, 30) || !t_number("cr0", register.CODEVIEW, 80) || !t_number("dr7", register.CODEVIEW, 97))                                                                                                    { ret 5; }
    if (!t_number("fcw", register.CODEVIEW, 136) || !t_number("fsw", register.CODEVIEW, 137) || !t_number("st0", register.CODEVIEW, 128) || !t_number("st7", register.CODEVIEW, 135))                                                                                              { ret 6; }
    if (!t_number("mm0", register.CODEVIEW, 146) || !t_number("mm7", register.CODEVIEW, 153))                                                                                                                                                                                      { ret 11; }
    if (!t_number("xmm0", register.CODEVIEW, 154) || !t_number("xmm8", register.CODEVIEW, 252) || !t_number("mxcsr", register.CODEVIEW, 211) || !t_number("ymm0", register.CODEVIEW, 368))                                                                                         { ret 7; }
    if (!t_number("xmm16", register.CODEVIEW, 694) || !t_number("ymm16", register.CODEVIEW, 710) || !t_number("zmm0", register.CODEVIEW, 726) || !t_number("zmm31", register.CODEVIEW, 757) || !t_number("k0", register.CODEVIEW, 758) || !t_number("k7", register.CODEVIEW, 765)) { ret 8; }
    if (!t_unnumbered("tmm0", register.CODEVIEW) || !t_unnumbered("rip", register.CODEVIEW) || !t_unnumbered("rflags", register.CODEVIEW) || !t_unnumbered("cr8", register.CODEVIEW))                                                                                              { ret 9; }
    val ah: opt[register.Id] = t_from(2, 5, register.CODEVIEW);
    if (!(sel ah.some && ah.some == register.id_of(t_row("ah")))) { ret 10; }
    ret 0;
}

# the file as the registry walk checks it, in a set that holds only the file and its extensions
#[testing]
val T_CODEC: dispatch.Codec = dispatch.Codec{fields: nil, registers: ?FILE, rows: row.Rows{at: nil, len: 0}, keys: index.NO_ENTRIES, dispatch: nil};

#[testing]
val T_SET: S.Set = S.Set{states: x86_extension.AXES, codec: ?T_CODEC, extensions: ?x86_extension.CATALOG};

test registers__the_registry_check_accepts_the_file {
    val checked: err[check.Refusal] = check_register.registers(?T_SET);
    if (sel checked.err) {
        print.eprintlnf("{} ({} {} {})", checked.err.message, checked.err.table, checked.err.index, checked.err.other);
        ret 1;
    }
    ret 0;
}
