    register.Class{name: "mm", kind: register.VECTOR, width: register.Scaled{fixed: 64, per: 0, scale: 0}, count: 8},
    register.Class{name: "tmm", kind: register.TILE, width: register.Scaled{fixed: 512, per: 0, scale: 0}, count: 8},
    register.Class{name: "sreg", kind: register.SYSTEM, width: register.Scaled{fixed: 16, per: 0, scale: 0}, count: 6},
    register.Class{name: "creg", kind: register.SYSTEM, width: register.Scaled{fixed: 0, per: 32, scale: 0}, count: 9},
    register.Class{name: "dreg", kind: register.SYSTEM, width: register.Scaled{fixed: 0, per: 32, scale: 0}, count: 8},
    register.Class{name: "rflags", kind: register.FLAGS, width: register.Scaled{fixed: 0, per: 32, scale: 0}, count: 1},
    register.Class{name: "flag", kind: register.FLAGS, width: register.Scaled{fixed: 1, per: 0, scale: 0}, count: 22},
    register.Class{name: "rip", kind: register.SYSTEM, width: register.Scaled{fixed: 0, per: 32, scale: 0}, count: 1},
    register.Class{name: "x87ctl", kind: register.SYSTEM, width: register.Scaled{fixed: 16, per: 0, scale: 0}, count: 2},
    register.Class{name: "mxcsr", kind: register.SYSTEM, width: register.Scaled{fixed: 32, per: 0, scale: 0}, count: 1},
    register.Class{name: "tilecfg", kind: register.SYSTEM, width: register.Scaled{fixed: 512, per: 0, scale: 0}, count: 1},
};

