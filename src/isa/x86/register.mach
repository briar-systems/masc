# what a selection must hold for a row to exist, each a single alternative of extensions held together
val ID_X64:  [1]requirement.Id  = [1]requirement.Id{x86_extension.X64};
val ALT_X64: [1]requirement.Ids = [1]requirement.Ids{requirement.Ids{at: ?ID_X64[0], len: 1}};

val ID_APX_F:  [1]requirement.Id  = [1]requirement.Id{x86_extension.APX_F};
val ALT_APX_F: [1]requirement.Ids = [1]requirement.Ids{requirement.Ids{at: ?ID_APX_F[0], len: 1}};

val ID_SSE:  [1]requirement.Id  = [1]requirement.Id{x86_extension.SSE};
val ALT_SSE: [1]requirement.Ids = [1]requirement.Ids{requirement.Ids{at: ?ID_SSE[0], len: 1}};

val ID_SSE_X64:  [2]requirement.Id  = [2]requirement.Id{x86_extension.SSE, x86_extension.X64};
