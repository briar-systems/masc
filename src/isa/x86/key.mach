# the readers of the x86 decode dispatch keys
#
# the match space is one word of what tells x86 rows apart: the code width,
# the encoding space and opcode map, the opcode byte, whether ModRM names a
# register, ModRM.reg and ModRM.rm, the prefixes a row's operand size, rex2
# admission and mandatory prefix read, f0 and 67, the vector length, evex.b,
# the rex bits of a register the opcode holds, and the evex payload apx's
# conditional and flagless forms read. its keys, their order and their bits are the keys
# topic of gen's x86 overlay (gen/data/x86/keys.txt), which the generator
# writes as gen_key, each key read here by the reader of its name. a reader
# reads its field from the stream under the context, through the prefix scan
# the kinds read (masc.isa.x86.field.scan), so a byte is a prefix or an opcode
# exactly as the code width makes it: 0x40 is inc eax's opcode at width 32
# and a rex prefix at width 64. a vex or evex prefix's pp and w are read as
# the legacy prefixes they stand for, 66, f3 and f2, and rex.w.

use std.types.bool.bool;
use std.types.result.res;
use std.types.size.usize;

use masc.core.field;
use masc.core.state;

use x86_field:  masc.isa.x86.field;
use x86_opcode: masc.isa.x86.opcode;

# the prefixes of the instruction at `at` of `s` under `ctx`
fun prefixes(ctx: *state.Context, s: *field.Stream, at: usize) res[x86_field.Prefixes, field.Refusal] {
    ret x86_field.scan(s, at, x86_field.width(ctx));
}

fun one(b: bool) u64 {
    if (b) { ret 1; }
    ret 0;
}

# the code width as the mode key holds it: 0 for 16, 1 for 32 and 2 for 64 bits
pub fun mode_of(w: u8) u64 {
    if (w == 64) { ret 2; }
    if (w == 32) { ret 1; }
    ret 0;
}

# the ModRM byte of the instruction at `at`
fun modrm(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err) { ret res[u64, field.Refusal].err{got.err}; }
    ret field.read(s, got.ok.opcode + 1, 1);
}

# the encoding space times 32 plus the opcode map, as vex's five bits of map reach 31, 3dnow's 0f 0f map 15 of the legacy
# space
pub fun map(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err) { ret res[u64, field.Refusal].err{got.err}; }
    ret res[u64, field.Refusal].ok{(got.ok.space::u64 << 5) | got.ok.map::u64};
}

# the opcode byte, or 3dnow's after ModRM, its SIB byte and displacement
pub fun opcode(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err)                      { ret res[u64, field.Refusal].err{got.err}; }
    if (got.ok.map != x86_opcode.NOW_MAP) { ret field.read(s, got.ok.opcode, 1); }
    val size: u8                      = x86_field.address_size(x86_field.width(ctx), got.ok.asz);
    val m:    res[u64, field.Refusal] = field.read(s, got.ok.opcode + 1, 1);
    if (sel m.err) { ret m; }
    val mod:  u64   = m.ok >> 6;
    val r:    u64   = m.ok & 7;
    var past: usize = 1;
    if (mod != 3 && size == 16) {
        if (mod == 1)                         { past = past + 1; }
        or (mod == 2 || (mod == 0 && r == 6)) { past = past + 2; }
    }
    or (mod != 3) {
        var base: u64 = r;
        if (r == 4) {
            val sib: res[u64, field.Refusal] = field.read(s, got.ok.opcode + 2, 1);
            if (sel sib.err) { ret sib; }
            base = sib.ok & 7;
            past = past + 1;
        }
        if (mod == 1)                            { past = past + 1; }
        or (mod == 2 || (mod == 0 && base == 5)) { past = past + 4; }
    }
    ret field.read(s, got.ok.opcode + 1 + past, 1);
}

# the code width
pub fun mode(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret res[u64, field.Refusal].ok{mode_of(x86_field.width(ctx))};
}

# 1 when ModRM.mod is 3
pub fun direct(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[u64, field.Refusal] = modrm(ctx, s, at);
    if (sel got.err) { ret got; }
    ret res[u64, field.Refusal].ok{one((got.ok >> 6) == 3)};
}

# ModRM.reg
pub fun reg(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[u64, field.Refusal] = modrm(ctx, s, at);
    if (sel got.err) { ret got; }
    ret res[u64, field.Refusal].ok{(got.ok >> 3) & 7};
}

# 1 when a 66 prefix is there, or a vex or evex pp of 01
pub fun osz(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err) { ret res[u64, field.Refusal].err{got.err}; }
    val p: x86_field.Prefixes = got.ok;
    if (p.vex != 0) { ret res[u64, field.Refusal].ok{one(p.pp == 1)}; }
    ret res[u64, field.Refusal].ok{one(p.osz)};
}

# the W bit of a rex, rex2, vex or evex prefix, 0 for none
pub fun w(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err) { ret res[u64, field.Refusal].err{got.err}; }
    val p: x86_field.Prefixes = got.ok;
    ret res[u64, field.Refusal].ok{one((p.rex || p.rex2 || p.vex != 0) && (p.payload & x86_field.W) != 0)};
}

# 1 when a rex2 prefix is there
pub fun rex2(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err) { ret res[u64, field.Refusal].err{got.err}; }
    ret res[u64, field.Refusal].ok{one(got.ok.rex2)};
}

# the last of f2 and f3, or the one a vex or evex pp of 11 or 10 stands for: 2 for f2, 3 for f3, 0 for neither
pub fun rep(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err) { ret res[u64, field.Refusal].err{got.err}; }
    if (got.ok.vex != 0) {
        if (got.ok.pp == 3) { ret res[u64, field.Refusal].ok{2}; }
        if (got.ok.pp == 2) { ret res[u64, field.Refusal].ok{3}; }
        ret res[u64, field.Refusal].ok{0};
    }
    var v: u64 = 0;
    if (got.ok.rep == 0xF2) { v = 2; }
    if (got.ok.rep == 0xF3) { v = 3; }
    ret res[u64, field.Refusal].ok{v};
}

# 1 when f0 is there
pub fun lock(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err) { ret res[u64, field.Refusal].err{got.err}; }
    ret res[u64, field.Refusal].ok{one(got.ok.lock)};
}

# 1 when 67 is there
pub fun asz(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err) { ret res[u64, field.Refusal].err{got.err}; }
    ret res[u64, field.Refusal].ok{one(got.ok.asz)};
}

# vex.l, xop.l or evex.l'l, 0 for a legacy instruction
pub fun vl(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err)     { ret res[u64, field.Refusal].err{got.err}; }
    if (got.ok.vex == 0) { ret res[u64, field.Refusal].ok{0}; }
    ret res[u64, field.Refusal].ok{got.ok.length::u64};
}

# evex.b, 0 outside the evex space
pub fun b(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err) { ret res[u64, field.Refusal].err{got.err}; }
    ret res[u64, field.Refusal].ok{one(got.ok.vex == 0x62 && got.ok.b)};
}

# ModRM.rm
pub fun rm(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[u64, field.Refusal] = modrm(ctx, s, at);
    if (sel got.err) { ret got; }
    ret res[u64, field.Refusal].ok{got.ok & 7};
}

# rex.b or rex2.b3, plus 2 for rex2.b4, 0 with neither prefix
pub fun rexb(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err) { ret res[u64, field.Refusal].err{got.err}; }
    val p: x86_field.Prefixes = got.ok;
    if (!p.rex && !p.rex2) { ret res[u64, field.Refusal].ok{0}; }
    ret res[u64, field.Refusal].ok{one((p.payload & x86_field.B3) != 0) | (one((p.payload & x86_field.B4) != 0) << 1)};
}

# evex.aaa, 0 outside the evex space
pub fun aaa(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err)        { ret res[u64, field.Refusal].err{got.err}; }
    if (got.ok.vex != 0x62) { ret res[u64, field.Refusal].ok{0}; }
    ret res[u64, field.Refusal].ok{got.ok.aaa::u64};
}

# evex.v' as the bits hold it, uninverted, 0 outside the evex space
pub fun v4(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[x86_field.Prefixes, field.Refusal] = prefixes(ctx, s, at);
    if (sel got.err)        { ret res[u64, field.Refusal].err{got.err}; }
    if (got.ok.vex != 0x62) { ret res[u64, field.Refusal].ok{0}; }
    ret res[u64, field.Refusal].ok{(got.ok.bytes[2] >> 3)::u64 & 1};
}
