# the call frame state x86 functions start in, which the set's architecture rows state
#
# a call pushes the return address, so a function starts with the canonical
# frame address one slot above the stack pointer and the return address
# saved just below it (x86-64 psabi, "DWARF Definition", and the i386 psabi):
# rsp+8 with the return address at cfa-8 in 64-bit code, esp+4 at cfa-4 in
# 32-bit code. code offsets are in bytes and data offsets in stack slots, as
# llvm-mc 23.1.1 writes an x86 cie. the return address column is mink's.

use std.types.option.opt;

use masc.core.register;
use S: masc.core.set;

# rsp and esp, each register.make of its class and number: rsp is number 4 of class 0, esp number 4 of class 1
pub val RSP: register.Id = 0x1_0004;
pub val ESP: register.Id = 0x2_0004;

# the frame state of 64-bit code
pub val X86_64: S.Frame = S.Frame{cfa_register: RSP, cfa_offset: 8, return_saved_at: opt[i64].some{-8}, code_align: 1, data_align: -8, initial: S.NO_RULES};

# the frame state of 32-bit code
pub val I386: S.Frame = S.Frame{cfa_register: ESP, cfa_offset: 4, return_saved_at: opt[i64].some{-4}, code_align: 1, data_align: -4, initial: S.NO_RULES};
