# the x86 encodings end to end: source assembled under the set and code decoded and encoded back, against the
# bytes llvm-mc 23.1.1 writes (`llvm-mc -triple x86_64 -show-encoding` under `.intel_syntax noprefix`)
#
# the vex, evex and apx encodings are tried on rows of their own, shaped as XED 0bcb623's records of vaddps, vmovaps
# and apx's add state them (datafiles/avx/avx-isa.txt, avx512f/avx512-foundation-isa.xed.txt, apx-f/apx-f-isa.xed.txt),
# until J3's catalog (#30) generates them. their effects and requirements are a register move's, which no test reads

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use mink.base.fail;
use mink.base.intern;
use mink.base.store;
use mink.base.table;
use arch_x86: mink.catalog.arch.x86;
use mink.format.registry;
use mink.model.object;

use masc.asm.asm;
use masc.asm.model;
use masc.build.build;
use masc.codec.walk;
use masc.core.diagnostic;
use masc.core.extension;
use masc.core.field;
use masc.core.form;
use masc.core.index;
use masc.core.inst;
use masc.core.operand;
use masc.core.register;
use masc.core.requirement;
use masc.core.row;
use masc.core.set;
use masc.core.state;
use masc.format.dialect;

use x86_extension: masc.isa.x86.extension;
use x86_field:     masc.isa.x86.field;
use x86_fixup:     masc.isa.x86.fixup;
use x86_form:      masc.isa.x86.form;
use x86_opcode:    masc.isa.x86.opcode;
use x86_set:       masc.isa.x86.set;
use x86_source:    masc.isa.x86.source;

use masc.isa.x86.gen_register;
use masc.isa.x86.gen_row;

# a test's allocator, formats, selection, register view and context
#[testing]
rec T {
    t:       testing.Testing;
    s:       extension.Selection;
    v:       register.Available;
    ctx:     state.Context;
    formats: registry.Registry;
}

# the test's context, opened for x86_64, whose code starts at width 64
#[testing]
fun t_make(t: *T) bool {
    ret t_make_with(t, "");
}

# the test's context, opened for x86_64 under the selection `spelling`
#[testing]
fun t_make_with(t: *T, spelling: str) bool {
    testing.make(?t.t);
    val a:       *A.Allocator                      = testing.allocator_of(?t.t);
    val formats: res[registry.Registry, fail.Fail] = registry.builtin(a);
    if (sel formats.err) { ret false; }
    t.formats = formats.ok;
    val made: res[extension.Selection, extension.Error] = extension.select(a, ?x86_extension.CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    val opened: res[state.Context, state.Opened] = set.open(a, ?x86_set.SET, ?x86_set.SET.arches.at[1], ?t.s, ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx = opened.ok;
    ret true;
}

#[testing]
fun t_assemble(t: *T, text: str) res[object.Object, model.Refusal] {
    ret t_assemble_in(t, ?dialect.ELF, text);
}

# `text` assembled for x86_64 into an object of the format and assembler dialect `d`
#[testing]
fun t_assemble_in(t: *T, d: *dialect.Dialect, text: str) res[object.Object, model.Refusal] {
    val options: model.Options = model.Options{arch: ?arch_x86.X86_64, formats: ?t.formats, syntax: 0, abi: nil, dialect: d, layers: model.NO_LAYERS};
    ret asm.assemble(testing.allocator_of(?t.t), ?x86_set.SET, ?t.ctx, options, text, str_len(text), diagnostic.START);
}

# whether `.text` of `o` holds exactly the `n` bytes at `want`
#[testing]
fun t_text(o: *object.Object, want: *u8, n: usize) bool {
    var i: usize = 0;
    for (i < o.sections.count) {
        val s:     *object.Section            = ?o.sections.items[i];
        val named: opt[table.Id[intern.Name]] = s.name;
        if (sel named.some) {
            val v: View = object.name_of(o, named.some);
            if (v.len == 5 && v.data[0] == '.' && v.data[1] == 't' && v.data[2] == 'e' && v.data[3] == 'x' && v.data[4] == 't') {
                val got: store.Bytes = object.bytes(o, ?s.contents);
                if (got.len != n) { ret false; }
                var k: usize = 0;
                for (k < n) {
                    if (got.data[k] != want[k]) { ret false; }
                    k = k + 1;
                }
                ret true;
            }
        }
        i = i + 1;
    }
    ret false;
}

# whether `text` assembles to exactly the `n` bytes at `want`
#[testing]
fun t_writes(text: str, want: *u8, n: usize) bool {
    ret t_writes_with("", text, want, n);
}

# whether `text` assembles under the selection `spelling` to exactly the `n` bytes at `want`
#[testing]
fun t_writes_with(spelling: str, text: str, want: *u8, n: usize) bool {
    var t: T;
    if (!t_make_with(?t, spelling)) { ret false; }
    var got: res[object.Object, model.Refusal] = t_assemble(?t, text);
    if (sel got.err) { ret false; }
    var o:  object.Object = got.ok;
    val ok: bool          = t_text(?o, want, n);
    object.release(?o);
    ret ok;
}

# whether `text` is refused with `message`
#[testing]
fun t_refuses(text: str, message: str) bool {
    var t: T;
    if (!t_make(?t)) { ret false; }
    var got: res[object.Object, model.Refusal] = t_assemble(?t, text);
    if (sel got.ok) {
        object.release(?got.ok);
        ret false;
    }
    ret str_equals(got.err.message, message);
}

# whether the `n` bytes at `code` decode at width 64 as one instruction of them all and encode back to them
#[testing]
fun t_round_trips(code: *u8, n: usize) bool {
    var t: T;
    if (!t_make(?t)) { ret false; }
    var store: [8]operand.Value;
    var room:  [8]requirement.Alternative;
    var alts:  field.Admissions                 = field.Admissions{at: ?room[0], cap: 8, used: 0};
    val got:   res[walk.Decoded, field.Refusal] = walk.decode(x86_set.SET.codec, ?t.ctx, code, n, 0, ?store[0], 8, ?alts);
    if (sel got.err)     { ret false; }
    if (got.ok.len != n) { ret false; }
    var out:    vector.Vector[u8]          = vector.init[u8](testing.allocator_of(?t.t));
    var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](testing.allocator_of(?t.t));
    var ins:    walk.Decoded               = got.ok;
    val wrote:  res[usize, field.Refusal]  = walk.encode(x86_set.SET.codec, ?t.ctx, ?ins.inst, ?out, ?fixups);
    if (sel wrote.err || out.len != n) { ret false; }
    var k: usize = 0;
    for (k < n) {
        if (out.data[k] != code[k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

# 0x40 is inc eax's opcode in 32-bit code and a rex prefix in 64-bit code, in one object
test encoding__0x40_is_inc_at_width_32_and_rex_at_width_64 {
    val want: [3]u8 = [3]u8{0x40, 0xFF, 0xC0};
    if (!t_writes(".intel_syntax noprefix\n.code32\ninc eax\n.code64\ninc eax\n", ?want[0], 3)) { ret 1; }
    val rex: [3]u8 = [3]u8{0x40, 0xFF, 0xC0};
    if (!t_round_trips(?rex[0], 3)) { ret 2; }
    ret 0;
}

# a relocation of a kind the object's format maps none of is refused where it is made, naming the kind and the format,
# as coff has no 8-bit absolute relocation for x86_64, and one of a kind it maps is written
test encoding__a_relocation_the_format_does_not_map_is_refused_naming_its_kind_and_format {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var wide: res[object.Object, model.Refusal] = t_assemble_in(?t, ?dialect.COFF_X86_64, "\t.globl ext\n\t.data\n\t.long ext\n");
    if (sel wide.err) { ret 2; }
    object.release(?wide.ok);
    var narrow: res[object.Object, model.Refusal] = t_assemble_in(?t, ?dialect.COFF_X86_64, "\t.globl ext\n\t.data\n\t.byte ext\n");
    if (sel narrow.ok) {
        object.release(?narrow.ok);
        ret 3;
    }
    if (!str_equals(narrow.err.message, build.NO_RELOCATION)) { ret 4; }
    val cause: opt[fail.Fail] = narrow.err.cause;
    if (sel cause.none)                                                                       { ret 5; }
    if (!str_equals(cause.some.subject, "abs8") || !str_equals(cause.some.at.record, "coff")) { ret 6; }
    ret 0;
}

# `.att_syntax` is refused at its name, on its line and column, naming at&t syntax as not yet supported
test encoding__att_syntax_is_refused_at_its_column {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var got: res[object.Object, model.Refusal] = t_assemble(?t, ".intel_syntax noprefix\ninc eax\n  .att_syntax prefix\n");
    if (sel got.ok) {
        object.release(?got.ok);
        ret 2;
    }
    if (!str_equals(got.err.message, x86_source.ATT))                   { ret 3; }
    if (got.err.span.start.line != 3 || got.err.span.start.column != 3) { ret 4; }
    if (got.err.span.len != 11)                                         { ret 5; }
    ret 0;
}

# a redundant prefix and a displacement wider than it needs to be decode to forms that encode back to their bytes
test encoding__a_redundant_prefix_and_a_wide_displacement_encode_back {
    val ds: [3]u8 = [3]u8{0x3E, 0x8B, 0x00};
    if (!t_round_trips(?ds[0], 3)) { ret 1; }
    val wide: [6]u8 = [6]u8{0x8B, 0x80, 0x00, 0x00, 0x00, 0x00};
    if (!t_round_trips(?wide[0], 6)) { ret 2; }
    val disp32: [6]u8 = [6]u8{0x8B, 0x80, 0x00, 0x00, 0x00, 0x00};
    if (!t_writes(".intel_syntax noprefix\n{disp32} mov eax, dword ptr [rax]\n", ?disp32[0], 6)) { ret 3; }
    ret 0;
}

# rbp and r13 as a base take a zero disp8, rsp and r12 a SIB byte (Intel SDM 325462-093US Vol 2A Table 2-2, 2-3)
test encoding__rbp_and_r13_take_a_zero_disp8_and_rsp_and_r12_a_sib {
    val rbp: [3]u8 = [3]u8{0x8B, 0x45, 0x00};
    if (!t_writes(".intel_syntax noprefix\nmov eax, dword ptr [rbp]\n", ?rbp[0], 3)) { ret 1; }
    val r13: [4]u8 = [4]u8{0x41, 0x8B, 0x45, 0x00};
    if (!t_writes(".intel_syntax noprefix\nmov eax, dword ptr [r13]\n", ?r13[0], 4)) { ret 2; }
    val rsp: [3]u8 = [3]u8{0x8B, 0x04, 0x24};
    if (!t_writes(".intel_syntax noprefix\nmov eax, dword ptr [rsp]\n", ?rsp[0], 3)) { ret 3; }
    val r12: [4]u8 = [4]u8{0x41, 0x8B, 0x04, 0x24};
    if (!t_writes(".intel_syntax noprefix\nmov eax, dword ptr [r12]\n", ?r12[0], 4)) { ret 4; }
    val sib: [4]u8 = [4]u8{0x8B, 0x44, 0x88, 0x10};
    if (!t_writes(".intel_syntax noprefix\nmov eax, dword ptr [rax + 4*rcx + 0x10]\n", ?sib[0], 4)) { ret 5; }
    ret 0;
}

# ah to bh have no encoding beside a rex prefix, which sil needs
test encoding__a_high_byte_register_is_refused_beside_rex {
    if (!t_refuses(".intel_syntax noprefix\nmov ah, sil\n", x86_field.HIGH_BYTE)) { ret 1; }
    ret 0;
}

# the legacy prefixes are written segment, 67, then 66, as llvm-mc writes them
test encoding__prefixes_are_written_in_the_canonical_order {
    val want: [5]u8 = [5]u8{0x64, 0x67, 0x66, 0x8B, 0x00};
    if (!t_writes(".intel_syntax noprefix\nmov ax, word ptr fs:[eax]\n", ?want[0], 5)) { ret 1; }
    ret 0;
}

# 16-bit code addresses through bx, bp, si and di, and 32-bit registers there take 67
test encoding__16_bit_code_addresses_by_its_own_forms {
    val want: [10]u8 = [10]u8{0x8B, 0x40, 0x04, 0x8B, 0x46, 0x00, 0x67, 0x66, 0x8B, 0x00};
    if (!t_writes(".intel_syntax noprefix\n.code16\nmov ax, word ptr [bx + si + 4]\nmov ax, word ptr [bp]\nmov eax, dword ptr [eax]\n", ?want[0], 10)) { ret 1; }
    ret 0;
}

# rip-relative addressing is 64-bit code's, so a row of another width admits no such form
test encoding__a_rip_relative_address_is_refused_outside_64_bit_code {
    if (!t_refuses(".intel_syntax noprefix\n.code32\nmov eax, dword ptr [rip + 0x10]\n", field.FORM)) { ret 1; }
    ret 0;
}

# a rex2 prefix reaches maps 0 and 1 only (Intel APX 355828-009US 3.1.2.1), so a {rex2} row of map 2, movzx's moved
# there, is refused
test encoding__rex2_with_an_unreachable_map_is_refused {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val base: *row.Row          = gen_row.MOVZX_GPR32_GPR8_0FB6_O32_W64;
    var op:   x86_opcode.Opcode = @x86_field.opcode_of(?base.encoding.at[0]);
    op.map = 2;
    var fields: [2]field.Field;
    var k:      u32 = 0;
    for (k < base.encoding.len) {
        fields[k]      = base.encoding.at[k];
        fields[k].data = ?op;
        k              = k + 1;
    }
    var moved: row.Row = @base;
    moved.encoding = field.Fields{at: ?fields[0], len: base.encoding.len};
    var values: [2]operand.Value;
    values[0] = operand.Value.register{register.make(gen_register.GPR32_CLASS, 0)};
    values[1] = operand.Value.register{register.make(gen_register.GPR8_CLASS, 1)};
    var out:    vector.Vector[u8]          = vector.init[u8](testing.allocator_of(?t.t));
    var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](testing.allocator_of(?t.t));
    var ins:    inst.Inst                  = inst.Inst{row: ?moved, values: ?values[0], count: 2, form: form.Form{bits: x86_form.REX2}};
    val wrote:  res[usize, field.Refusal]  = walk.encode(x86_set.SET.codec, ?t.ctx, ?ins, ?out, ?fixups);
    if (!(sel wrote.err && wrote.err.message == x86_field.REX2_MAP)) { ret 2; }
    ret 0;
}

#[testing]
val T_XMM: [1]u16 = [1]u16{gen_register.XMM_CLASS};

#[testing]
val T_ZMM: [1]u16 = [1]u16{gen_register.ZMM_CLASS};

#[testing]
val T_K: [1]u16 = [1]u16{gen_register.K_CLASS};

#[testing]
val T_GPR64: [1]u16 = [1]u16{gen_register.GPR64_CLASS};

#[testing]
val T_ADDRESS: [2]u16 = [2]u16{gen_register.GPR64_CLASS, gen_register.GPR32_CLASS};

#[testing]
val T_SEGMENT: [1]u16 = [1]u16{gen_register.SREG_CLASS};

# k0 is no mask, and rsp no index
#[testing]
val T_K0: [1]u32 = [1]u32{0};

#[testing]
val T_RSP: [1]u32 = [1]u32{4};

#[testing]
val T_ZEROING: [1]operand.Enumerant = [1]operand.Enumerant{operand.Enumerant{name: "z", value: x86_opcode.ZEROING}};

#[testing]
val T_ROUNDING: [4]operand.Enumerant = [4]operand.Enumerant{
    operand.Enumerant{name: "rn-sae", value: x86_opcode.RN_SAE},
    operand.Enumerant{name: "rd-sae", value: x86_opcode.RD_SAE},
    operand.Enumerant{name: "ru-sae", value: x86_opcode.RU_SAE},
    operand.Enumerant{name: "rz-sae", value: x86_opcode.RZ_SAE},
};

# a row of its own: its operands, its opcode record, its head and ModRM fields and the row
#[testing]
rec Fixture {
    operands: [6]operand.Operand;
    op:       x86_opcode.Opcode;
    fields:   [2]field.Field;
    row:      row.Row;
}

#[testing]
fun t_register(classes: *u16, role: operand.Role, width: u16) operand.Operand {
    ret operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: classes, len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}}, role: role, width: width, quantity: operand.ONE, write: operand.AS_ROW};
}

# the optional opmask operand, k1 to k7
#[testing]
fun t_mask() operand.Operand {
    var o: operand.Operand = t_register(?T_K[0], operand.READ, 64);
    o.shape    = operand.Shape.register{operand.Register{classes: operand.Classes{at: ?T_K[0], len: 1}, first: 0, count: 0, excluded: operand.Numbers{at: ?T_K0[0], len: 1}, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}};
    o.quantity = operand.OPTIONAL;
    ret o;
}

#[testing]
fun t_enumerant(members: *operand.Enumerant, count: u32) operand.Operand {
    ret operand.Operand{shape: operand.Shape.enumerant{operand.Enumeration{members: members, count: count, mask: false, names: index.NO_ENTRIES}}, role: operand.READ, width: 0, quantity: operand.OPTIONAL, write: operand.AS_ROW};
}

# a memory operand of `width` bits admitting the broadcasts `broadcasts`
#[testing]
fun t_memory(role: operand.Role, width: u16, broadcasts: u8) operand.Operand {
    val base:    operand.Register  = operand.Register{classes: operand.Classes{at: ?T_ADDRESS[0], len: 2}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}};
    var indexed: operand.Register  = base;
    val segment: operand.Register  = operand.Register{classes: operand.Classes{at: ?T_SEGMENT[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}};
    val disp:    operand.Immediate = operand.Immediate{bits: 32, sign: operand.SIGNED, extends: 32, scale: 0, bias: 0, fixup: x86_fixup.ABS32S, format: operand.INTEGER, excluded: operand.NO_INTEGERS};
    indexed.excluded = operand.Numbers{at: ?T_RSP[0], len: 1};
    val m: operand.Memory = operand.Memory{base: base, index: indexed, segment: segment, scales: 0xF, disp: disp, forms: operand.ABSOLUTE | operand.PCREL, anchor: operand.END, extends: operand.Enumeration{members: nil, count: 0, mask: false, names: index.NO_ENTRIES}, broadcasts: broadcasts};
    ret operand.Operand{shape: operand.Shape.memory{m}, role: role, width: width, quantity: operand.ONE, write: operand.AS_ROW};
}

# an opcode record of no operand, which a fixture places its operands in
#[testing]
fun t_opcode(space: x86_opcode.Space, map: u8, byte: u8, length: x86_opcode.Length) x86_opcode.Opcode {
    val none: u8 = field.NO_OPERAND;
    ret x86_opcode.Opcode{space: space, map: map, byte: byte, simd: x86_opcode.NO_SIMD, size: x86_opcode.NO_SIZE, flags: 0, reg: none, digit: x86_opcode.NO_DIGIT, rm: none, opreg: none, memory: none, vvvv: none, mask: none, zeroing: none, rounding: none, length: length, disp8: 0, element: 0, twin: 0};
}

# fixture `x` made a row of its first `count` operands and its opcode record, a head and a ModRM field
#[testing]
fun t_seal(x: *Fixture, key: str, count: u32) {
    var k: u32 = 0;
    for (k < 2) {
        x.fields[k] = field.Field{kind: x86_field.HEAD_KIND, width: 0, fixed: 0, mask: 0, slices: field.NO_SLICES, operand: field.NO_OPERAND, param: 0, data: ?x.op};
        k           = k + 1;
    }
    x.fields[1].kind = x86_field.MODRM_KIND;
    x.row            = @gen_row.MOV_GPR32_GPR32_89_O32_W64;
    x.row.key        = key;
    x.row.operands   = row.Operands{at: ?x.operands[0], len: count};
    x.row.encoding   = field.Fields{at: ?x.fields[0], len: 2};
}

# vaddps xmm, xmm, xmm/m128: VEX.128.0F.WIG 58 /r
#[testing]
fun t_vaddps_vex(x: *Fixture) {
    x.operands[0] = t_register(?T_XMM[0], operand.WRITE, 128);
    x.operands[1] = t_register(?T_XMM[0], operand.READ, 128);
    x.operands[2] = t_register(?T_XMM[0], operand.READ, 128);
    x.op          = t_opcode(x86_opcode.VEX, 1, 0x58, x86_opcode.L128);
    x.op.flags    = x86_opcode.WIG;
    x.op.reg      = 0;
    x.op.vvvv     = 1;
    x.op.rm       = 2;
    t_seal(x, "vaddps_xmm_xmm_xmm_vex", 3);
}

# vaddps xmm {k} {z}, xmm, xmm: EVEX.128.0F.W0 58 /r, which gives way to the vex row's 16 registers
#[testing]
fun t_vaddps_evex(x: *Fixture) {
    x.operands[0] = t_register(?T_XMM[0], operand.WRITE, 128);
    x.operands[1] = t_mask();
    x.operands[2] = t_enumerant(?T_ZEROING[0], 1);
    x.operands[3] = t_register(?T_XMM[0], operand.READ, 128);
    x.operands[4] = t_register(?T_XMM[0], operand.READ, 128);
    x.op          = t_opcode(x86_opcode.EVEX, 1, 0x58, x86_opcode.L128);
    x.op.reg      = 0;
    x.op.mask     = 1;
    x.op.zeroing  = 2;
    x.op.vvvv     = 3;
    x.op.rm       = 4;
    x.op.twin     = 16;
    t_seal(x, "vaddps_xmm_xmm_xmm_evex", 5);
}

# vaddps zmm {k} {z}, zmm, m512/m32bcst: EVEX.512.0F.W0 58 /r, tuple full: N 64, or 4 under broadcast
#[testing]
fun t_vaddps_memory(x: *Fixture) {
    x.operands[0] = t_register(?T_ZMM[0], operand.WRITE, 512);
    x.operands[1] = t_mask();
    x.operands[2] = t_enumerant(?T_ZEROING[0], 1);
    x.operands[3] = t_register(?T_ZMM[0], operand.READ, 512);
    x.operands[4] = t_memory(operand.READ, 512, 0x10);
    x.op          = t_opcode(x86_opcode.EVEX, 1, 0x58, x86_opcode.L512);
    x.op.reg      = 0;
    x.op.mask     = 1;
    x.op.zeroing  = 2;
    x.op.vvvv     = 3;
    x.op.rm       = 4;
    x.op.memory   = 4;
    x.op.disp8    = 6;
    x.op.element  = 2;
    t_seal(x, "vaddps_zmm_zmm_mem_evex", 5);
}

# vaddps zmm {k} {z}, zmm, zmm, {er}: EVEX.512.0F.W0 58 /r, its rounding optional
#[testing]
fun t_vaddps_rounding(x: *Fixture) {
    x.operands[0] = t_register(?T_ZMM[0], operand.WRITE, 512);
    x.operands[1] = t_mask();
    x.operands[2] = t_enumerant(?T_ZEROING[0], 1);
    x.operands[3] = t_register(?T_ZMM[0], operand.READ, 512);
    x.operands[4] = t_register(?T_ZMM[0], operand.READ, 512);
    x.operands[5] = t_enumerant(?T_ROUNDING[0], 4);
    x.op          = t_opcode(x86_opcode.EVEX, 1, 0x58, x86_opcode.L512);
    x.op.reg      = 0;
    x.op.mask     = 1;
    x.op.zeroing  = 2;
    x.op.vvvv     = 3;
    x.op.rm       = 4;
    x.op.rounding = 5;
    t_seal(x, "vaddps_zmm_zmm_zmm_evex", 6);
}

# vmovaps m512 {k}, zmm: EVEX.512.0F.W0 29 /r, tuple full mem: N 64, a store, which merges alone
#[testing]
fun t_vmovaps_store(x: *Fixture) {
    x.operands[0] = t_memory(operand.WRITE, 512, 0);
    x.operands[1] = t_mask();
    x.operands[2] = t_register(?T_ZMM[0], operand.READ, 512);
    x.op          = t_opcode(x86_opcode.EVEX, 1, 0x29, x86_opcode.L512);
    x.op.rm       = 0;
    x.op.memory   = 0;
    x.op.mask     = 1;
    x.op.reg      = 2;
    x.op.disp8    = 6;
    t_seal(x, "vmovaps_mem_zmm_evex", 3);
}

# add r64, r/m64, r64: EVEX.LLZ.NP.MAP4.W1 01 /r with nd set, the new data destination in vvvv
#[testing]
fun t_add_ndd(x: *Fixture) {
    x.operands[0] = t_register(?T_GPR64[0], operand.WRITE, 64);
    x.operands[1] = t_register(?T_GPR64[0], operand.READ, 64);
    x.operands[2] = t_register(?T_GPR64[0], operand.READ, 64);
    x.op          = t_opcode(x86_opcode.EVEX, 4, 0x01, x86_opcode.L128);
    x.op.size     = x86_opcode.O64;
    x.op.flags    = x86_opcode.ND;
    x.op.vvvv     = 0;
    x.op.rm       = 1;
    x.op.reg      = 2;
    t_seal(x, "add_gpr64_gpr64_gpr64_nd", 3);
}

#[testing]
fun t_xmm(n: u16) operand.Value {
    ret operand.Value.register{register.make(gen_register.XMM_CLASS, n)};
}

#[testing]
fun t_zmm(n: u16) operand.Value {
    ret operand.Value.register{register.make(gen_register.ZMM_CLASS, n)};
}

#[testing]
fun t_gpr64(n: u16) operand.Value {
    ret operand.Value.register{register.make(gen_register.GPR64_CLASS, n)};
}

# [rax + `disp`], its element repeated 2^`broadcast` times
#[testing]
fun t_at_rax(disp: i64, broadcast: u8) operand.Value {
    ret operand.Value.memory{operand.Address{base: register.make(gen_register.GPR64_CLASS, 0), index: register.NONE, scale: 0, disp: disp, segment: register.NONE, mode: operand.OFFSET, symbol: operand.Symbol{id: operand.NO_SYMBOL, addend: 0, fixup: operand.NO_FIXUP}, extend: 0, broadcast: broadcast}};
}

# the bytes row `r` holding the `count` values `values` encodes to under form bits `bits` into `out`
#[testing]
fun t_encode(t: *T, r: *row.Row, values: *operand.Value, count: u32, bits: u32, out: *vector.Vector[u8]) res[usize, field.Refusal] {
    var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](testing.allocator_of(?t.t));
    var ins:    inst.Inst                  = inst.Inst{row: r, values: values, count: count, form: form.Form{bits: bits}};
    ret walk.encode(x86_set.SET.codec, ?t.ctx, ?ins, out, ?fixups);
}

# whether row `r` holding `values` encodes under form bits `bits` to exactly the `n` bytes at `want`, and they decode by
# the row to the same values and form
#[testing]
fun t_row_writes(t: *T, r: *row.Row, values: *operand.Value, count: u32, bits: u32, want: *u8, n: usize) bool {
    var out:   vector.Vector[u8]         = vector.init[u8](testing.allocator_of(?t.t));
    val wrote: res[usize, field.Refusal] = t_encode(t, r, values, count, bits, ?out);
    if (sel wrote.err || out.len != n) { ret false; }
    var k: usize = 0;
    for (k < n) {
        if (out.data[k] != want[k]) { ret false; }
        k = k + 1;
    }
    var store: [8]operand.Value;
    val got:   res[walk.Decoded, field.Refusal] = walk.decode_row(x86_set.SET.codec, ?t.ctx, r, want, n, 0, ?store[0], 8);
    if (sel got.err)                                      { ret false; }
    if (got.ok.len != n || got.ok.inst.form.bits != bits) { ret false; }
    k = 0;
    for (k < count) {
        if (!operand.equal(?store[k], ?values[k])) { ret false; }
        k = k + 1;
    }
    ret true;
}

# the message row `r` holding `values` is refused with under form bits `bits`, nil when it encodes
#[testing]
fun t_row_refusal(t: *T, r: *row.Row, values: *operand.Value, count: u32, bits: u32) str {
    var out:   vector.Vector[u8]         = vector.init[u8](testing.allocator_of(?t.t));
    val wrote: res[usize, field.Refusal] = t_encode(t, r, values, count, bits, ?out);
    if (sel wrote.err) { ret wrote.err.message; }
    ret nil;
}

# the message the `n` bytes at `code` are refused with when decoded by row `r`, nil when they decode
#[testing]
fun t_undecodable(t: *T, r: *row.Row, code: *u8, n: usize) str {
    var store: [8]operand.Value;
    val got:   res[walk.Decoded, field.Refusal] = walk.decode_row(x86_set.SET.codec, ?t.ctx, r, code, n, 0, ?store[0], 8);
    if (sel got.err) { ret got.err.message; }
    ret nil;
}

# what the check of the head field of fixture `x`'s row finds wrong, nil when it holds
#[testing]
fun t_check(x: *Fixture) str {
    val got: opt[str] = x86_field.HEAD.check(?x.fields[0], ?x.operands[0], x.row.operands.len);
    if (sel got.some) { ret got.some; }
    ret nil;
}

#[testing]
val T_VECTOR: str = "avx512f,avx512vl,apx_f";

# evex compresses a disp8 by the tuple's N, 64 for a full zmm and the element's 4 under broadcast, and takes a disp32
# where the displacement is no multiple of it (Intel SDM 325462-093US Vol 2A 2.7.5)
test encoding__disp8_is_scaled_by_n_and_falls_back_to_disp32 {
    var t: T;
    if (!t_make_with(?t, T_VECTOR)) { ret 1; }
    var x: Fixture;
    t_vaddps_memory(?x);
    if (t_check(?x) != nil) { ret 2; }
    var v:      [5]operand.Value = [5]operand.Value{t_zmm(0), operand.Value.none{}, operand.Value.none{}, t_zmm(1), t_at_rax(64, 0)};
    val scaled: [7]u8            = [7]u8{0x62, 0xF1, 0x74, 0x48, 0x58, 0x40, 0x01};
    if (!t_row_writes(?t, ?x.row, ?v[0], 5, 0, ?scaled[0], 7)) { ret 3; }
    v[4] = t_at_rax(32, 0);
    val wide: [10]u8 = [10]u8{0x62, 0xF1, 0x74, 0x48, 0x58, 0x80, 0x20, 0x00, 0x00, 0x00};
    if (!t_row_writes(?t, ?x.row, ?v[0], 5, 0, ?wide[0], 10)) { ret 4; }
    v[4] = t_at_rax(8, 4);
    val broadcast: [7]u8 = [7]u8{0x62, 0xF1, 0x74, 0x58, 0x58, 0x40, 0x02};
    if (!t_row_writes(?t, ?x.row, ?v[0], 5, 0, ?broadcast[0], 7)) { ret 5; }
    ret 0;
}

# a broadcast is refused on a row whose memory operand admits none, whether given or read as evex.b, and a vex row
# states none
test encoding__a_broadcast_is_refused_where_the_row_admits_none {
    var t: T;
    if (!t_make_with(?t, T_VECTOR)) { ret 1; }
    var x: Fixture;
    t_vmovaps_store(?x);
    var v: [3]operand.Value = [3]operand.Value{t_at_rax(0, 4), operand.Value.none{}, t_zmm(0)};
    if (t_row_refusal(?t, ?x.row, ?v[0], 3, 0) != field.FORM) { ret 2; }
    val b: [6]u8 = [6]u8{0x62, 0xF1, 0x7C, 0x58, 0x29, 0x00};
    if (t_undecodable(?t, ?x.row, ?b[0], 6) != field.MISMATCH) { ret 3; }
    var y: Fixture;
    t_vaddps_vex(?y);
    y.operands[2] = t_memory(operand.READ, 128, 0x4);
    y.op.memory   = 2;
    if (t_check(?y) != x86_field.BROADCAST_SPACE) { ret 4; }
    ret 0;
}

# zeroing masking writes a register's cleared elements, so a store, whose destination is memory, takes none: XED
# states none for it, the check refuses a row that does, and evex.z on one does not decode. a register destination
# takes it beside a mask, and not alone
test encoding__zeroing_is_refused_on_a_store {
    var t: T;
    if (!t_make_with(?t, T_VECTOR)) { ret 1; }
    var x: Fixture;
    t_vmovaps_store(?x);
    if (t_check(?x) != nil) { ret 2; }
    var v:     [3]operand.Value = [3]operand.Value{t_at_rax(0, 0), operand.Value.register{register.make(gen_register.K_CLASS, 1)}, t_zmm(0)};
    val store: [6]u8            = [6]u8{0x62, 0xF1, 0x7C, 0x49, 0x29, 0x00};
    if (!t_row_writes(?t, ?x.row, ?v[0], 3, 0, ?store[0], 6)) { ret 3; }
    val zeroed: [6]u8 = [6]u8{0x62, 0xF1, 0x7C, 0xC9, 0x29, 0x00};
    if (t_undecodable(?t, ?x.row, ?zeroed[0], 6) != field.MISMATCH) { ret 4; }
    x.operands[3]      = t_enumerant(?T_ZEROING[0], 1);
    x.op.zeroing       = 3;
    x.row.operands.len = 4;
    if (t_check(?x) != x86_field.ZEROING_STORE) { ret 5; }
    var y: Fixture;
    t_vaddps_rounding(?y);
    var w:      [6]operand.Value = [6]operand.Value{t_zmm(0), operand.Value.register{register.make(gen_register.K_CLASS, 1)}, operand.enumerant(x86_opcode.ZEROING), t_zmm(1), t_zmm(2), operand.Value.none{}};
    val masked: [6]u8            = [6]u8{0x62, 0xF1, 0x74, 0xC9, 0x58, 0xC2};
    if (!t_row_writes(?t, ?y.row, ?w[0], 6, 0, ?masked[0], 6)) { ret 6; }
    w[1] = operand.Value.none{};
    if (t_row_refusal(?t, ?y.row, ?w[0], 6, 0) != x86_field.UNMASKED) { ret 7; }
    ret 0;
}

# embedded rounding is evex.b and l'l of a register form, so a memory form, whose evex.b is a broadcast, takes none
test encoding__embedded_rounding_is_refused_on_a_memory_form {
    var t: T;
    if (!t_make_with(?t, T_VECTOR)) { ret 1; }
    var x: Fixture;
    t_vaddps_rounding(?x);
    if (t_check(?x) != nil) { ret 2; }
    var v:  [6]operand.Value = [6]operand.Value{t_zmm(0), operand.Value.none{}, operand.Value.none{}, t_zmm(1), t_zmm(2), operand.enumerant(x86_opcode.RN_SAE)};
    val rn: [6]u8            = [6]u8{0x62, 0xF1, 0x74, 0x18, 0x58, 0xC2};
    if (!t_row_writes(?t, ?x.row, ?v[0], 6, 0, ?rn[0], 6)) { ret 3; }
    v[5] = operand.enumerant(x86_opcode.RZ_SAE);
    val rz: [6]u8 = [6]u8{0x62, 0xF1, 0x74, 0x78, 0x58, 0xC2};
    if (!t_row_writes(?t, ?x.row, ?v[0], 6, 0, ?rz[0], 6)) { ret 4; }
    v[5] = operand.Value.none{};
    val plain: [6]u8 = [6]u8{0x62, 0xF1, 0x74, 0x48, 0x58, 0xC2};
    if (!t_row_writes(?t, ?x.row, ?v[0], 6, 0, ?plain[0], 6)) { ret 5; }
    x.operands[4] = t_memory(operand.READ, 512, 0);
    x.op.memory   = 4;
    if (t_check(?x) != x86_field.ROUNDING_MEMORY) { ret 6; }
    ret 0;
}

# an instruction vex and evex both encode takes vex, as llvm-mc writes it, unless {evex} names evex, and either row
# refuses the other's form, so the choice does not hang on the order the rows are tried in
test encoding__vex_is_preferred_over_evex_and_evex_names_evex {
    var t: T;
    if (!t_make_with(?t, T_VECTOR)) { ret 1; }
    var vex:  Fixture;
    var evex: Fixture;
    t_vaddps_vex(?vex);
    t_vaddps_evex(?evex);
    if (t_check(?vex) != nil || t_check(?evex) != nil) { ret 2; }
    var three: [3]operand.Value = [3]operand.Value{t_xmm(0), t_xmm(1), t_xmm(2)};
    var five:  [5]operand.Value = [5]operand.Value{t_xmm(0), operand.Value.none{}, operand.Value.none{}, t_xmm(1), t_xmm(2)};
    val short: [4]u8            = [4]u8{0xC5, 0xF0, 0x58, 0xC2};
    if (!t_row_writes(?t, ?vex.row, ?three[0], 3, 0, ?short[0], 4))          { ret 3; }
    if (t_row_refusal(?t, ?evex.row, ?five[0], 5, 0) != x86_field.OTHER_ROW) { ret 4; }
    val long: [6]u8 = [6]u8{0x62, 0xF1, 0x74, 0x08, 0x58, 0xC2};
    if (!t_row_writes(?t, ?evex.row, ?five[0], 5, x86_form.EVEX, ?long[0], 6))           { ret 5; }
    if (t_row_refusal(?t, ?vex.row, ?three[0], 3, x86_form.EVEX) != x86_field.OTHER_ROW) { ret 6; }
    val vex3: [5]u8 = [5]u8{0xC4, 0xE1, 0x70, 0x58, 0xC2};
    if (!t_row_writes(?t, ?vex.row, ?three[0], 3, x86_form.VEX3, ?vex3[0], 5)) { ret 7; }
    ret 0;
}

# apx's new data destination is vvvv, which the instruction writes in place of its first source
test encoding__an_ndd_form_writes_its_new_destination {
    var t: T;
    if (!t_make_with(?t, T_VECTOR)) { ret 1; }
    var x: Fixture;
    t_add_ndd(?x);
    if (t_check(?x) != nil) { ret 2; }
    var v:   [3]operand.Value = [3]operand.Value{t_gpr64(0), t_gpr64(3), t_gpr64(1)};
    val ndd: [6]u8            = [6]u8{0x62, 0xF4, 0xFC, 0x18, 0x01, 0xCB};
    if (!t_row_writes(?t, ?x.row, ?v[0], 3, 0, ?ndd[0], 6)) { ret 3; }
    v[0] = t_gpr64(16);
    v[1] = t_gpr64(17);
    v[2] = t_gpr64(18);
    val high: [6]u8 = [6]u8{0x62, 0xEC, 0xFC, 0x10, 0x01, 0xD1};
    if (!t_row_writes(?t, ?x.row, ?v[0], 3, 0, ?high[0], 6)) { ret 4; }
    x.operands[0].role = operand.READ;
    if (t_check(?x) != x86_field.NDD_WRITE) { ret 5; }
    ret 0;
}

# a register past 15 is beyond rex and vex, so a legacy row takes rex2 and an instruction vex and evex both encode
# takes evex
test encoding__an_extended_register_forces_evex_or_rex2 {
    val rex2: [4]u8 = [4]u8{0xD5, 0x18, 0x01, 0xC0};
    if (!t_writes_with(T_VECTOR, ".intel_syntax noprefix\nadd r16, rax\n", ?rex2[0], 4)) { ret 1; }
    var t: T;
    if (!t_make_with(?t, T_VECTOR)) { ret 2; }
    var vex:  Fixture;
    var evex: Fixture;
    t_vaddps_vex(?vex);
    t_vaddps_evex(?evex);
    var three: [3]operand.Value = [3]operand.Value{t_xmm(16), t_xmm(1), t_xmm(2)};
    var five:  [5]operand.Value = [5]operand.Value{t_xmm(16), operand.Value.none{}, operand.Value.none{}, t_xmm(1), t_xmm(2)};
    if (t_row_refusal(?t, ?vex.row, ?three[0], 3, 0) != x86_field.VEX_REACH) { ret 3; }
    val wide: [6]u8 = [6]u8{0x62, 0xE1, 0x74, 0x08, 0x58, 0xC2};
    if (!t_row_writes(?t, ?evex.row, ?five[0], 5, 0, ?wide[0], 6)) { ret 4; }
    ret 0;
}
