# the x86 opcode record every field of a row reads, and the rules a row's operand and address sizes admit prefixes by
#
# a row states its opcode once (Opcode), and each field of the row points at
# it (masc.core.field.Field.data): its encoding space, map, opcode byte,
# mandatory prefix, operand and address sizes, flags, the places of its
# operands, the opcode extensions ModRM and apx's evex payload hold, and for a
# vex, evex or xop row its vector length, its displacement scale and the twin
# encoding of its instruction it gives way to. the kinds
# (masc.isa.x86.field) encode and decode by it, and the generator states each
# row's sizes and flags by the same rules (`admits`, `addressed`), held to
# every configuration of the prefixes XED's patterns give the row, so the
# rules a decoder reads prefixes by have one owner. the module reads no
# generated table, so the generator builds on it before the tables it writes.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

# the encoding space of an opcode
pub def Space: u8;

pub val LEGACY: Space = 0;
pub val VEX:    Space = 1;
pub val EVEX:   Space = 2;
pub val XOP:    Space = 3;

# the opcode map of 3dnow's 0f 0f, whose opcode byte is the suffix after ModRM and its displacement (AMD APM 24594 Vol 3
# Appendix A.3)
pub val NOW_MAP: u8 = 15;

# the map of the evex space whose pp of 01 is 66, the operand-size override of the legacy instructions apx promotes
# (Intel APX 355828-009US 3.1.4)
pub val APX_MAP: u8 = 4;

# the operand size a row encodes
# ---
# NO_SIZE: none: a byte operation, or one whose operands no operand size changes, which ignores 66 and rex.w
# O16:     16 bits, 66 in 32-bit and 64-bit code
# O32:     32 bits, 66 in 16-bit code
# O64:     64 bits, rex.w unless the row defaults to 64 bits
pub def Size: u8;

pub val NO_SIZE: Size = 0;
pub val O16:     Size = 1;
pub val O32:     Size = 2;
pub val O64:     Size = 3;

# the address size a row encodes, numbered as its operand size is
# ---
# NO_ADDRESS: none: the address size is the code width's or 67's, as its memory operand's registers state it
# A16:        16 bits, 67 in 32-bit code
# A32:        32 bits, 67 in 16-bit and 64-bit code
# A64:        64 bits, 64-bit code without 67
pub def Address: u8;

pub val NO_ADDRESS: Address = 0;
pub val A16:        Address = 1;
pub val A32:        Address = 2;
pub val A64:        Address = 3;

# the mandatory prefix of an opcode, numbered as vex.pp numbers it
pub def Simd: u8;

pub val NO_SIMD: Simd = 0;
pub val P66:     Simd = 1;
pub val PF3:     Simd = 2;
pub val PF2:     Simd = 3;

# what else a row states of its encoding, as bits
# ---
# DEFAULT_64: its operand size is 64 bits in 64-bit code without rex.w, as push and pop, so rex.w is no fact of it there
# IMMUNE_66:  66 does not change its operand size, as call and ret in 64-bit code (XED IMMUNE66_LOOP64), so 66 is no
#             fact of it
# NO_REX2:    a rex2 prefix is not admitted, as XED's norex2_prefix states
# REFINED_W:  a rex2 prefix with W set encodes another instruction, as pushp of push (XED norexw_prefix under rex2)
# LOAD:       it is the reg-from-rm form of an instruction whose rm-from-reg form is preferred, which {load} selects
#             and decode states
# STORE:      it is the rm-from-reg form of an instruction that has both directions, which {store} selects
# LOCKED:     f0 is part of its encoding
# W1:         w is set as part of the opcode, for a row of no operand size: rex.w, vex.w, evex.w or xop.w
# WIG:        w is ignored, written clear: of a row of no operand size, or of a legacy row whose rex.w gives 32 bits
#             rather than 64, as in's and out's (XED IMMUNE_REXW). a row of no operand size and neither flag needs w
#             clear
# ND:         evex.nd is set: apx's new data destination, which vvvv names, in map 4 (Intel APX 355828-009US 3.1.3)
# NF:         evex.nf is set: apx's form that writes no flags, in map 4
# MANDATORY:  66 is part of the opcode where the row's mandatory prefix is 66, and refused where it is not, so it never
#             changes the operand size, as XED's osz_refining_prefix and no_refining_prefix state
# SIBMEM:     its memory operand is encoded with a SIB byte, whose index is a register of its own, as amx's tile loads
#             (Intel SDM 325462-093US Vol 2A 2.1.5, XED RM=4)
# REX2:       a rex2 prefix is part of its encoding, as jmpabs's (Intel APX 355828-009US 3.1.2.1, XED
#             rex2_refining_prefix)
pub def Flags: u16;

pub val DEFAULT_64: Flags = 0x1;
pub val IMMUNE_66:  Flags = 0x2;
pub val NO_REX2:    Flags = 0x4;
pub val REFINED_W:  Flags = 0x8;
pub val LOAD:       Flags = 0x10;
pub val STORE:      Flags = 0x20;
pub val LOCKED:     Flags = 0x40;
pub val W1:         Flags = 0x80;
pub val WIG:        Flags = 0x100;
pub val ND:         Flags = 0x200;
pub val NF:         Flags = 0x400;
pub val MANDATORY:  Flags = 0x800;
pub val SIBMEM:     Flags = 0x1000;
pub val REX2:       Flags = 0x2000;

# the value of the condition field of a row of no condition
pub val NO_SCC: u8 = 0xFF;

# the vector length of a vex or evex opcode, as vex.l and evex.l'l number it, or LIG where it is ignored, as of a
# scalar operation or a legacy row, written 0
pub def Length: u8;

pub val L128: Length = 0;
pub val L256: Length = 1;
pub val L512: Length = 2;
pub val LIG:  Length = 3;

# the values of the enumerants of a rounding operand: the rounding control evex.l'l holds beside evex.b, or SAE, which
# suppresses exceptions and leaves the rounding as mxcsr states it
pub val RN_SAE: u32 = 0;
pub val RD_SAE: u32 = 1;
pub val RU_SAE: u32 = 2;
pub val RZ_SAE: u32 = 3;
pub val SAE:    u32 = 4;

# the value of the enumerant of a zeroing operand, `{z}`
pub val ZEROING: u32 = 1;

# the ModRM.reg value of an opcode extension, none for an opcode whose reg is an operand
pub val NO_DIGIT: u8 = 0xFF;

# what every field of one row reads: the facts of its opcode, stated once
# ---
# space:    its encoding space
# map:      its opcode map: 0 for one byte, 1 for 0f, 2 for 0f 38, 3 for 0f 3a, NOW_MAP for 3dnow's 0f 0f, and vex's,
#           evex's and xop's higher maps
# byte:     its opcode byte, the low three bits clear where they hold a register, or 3dnow's suffix
# simd:     its mandatory prefix, vex.pp, evex.pp and xop.pp in their spaces
# size:     the operand size it encodes
# address:  the address size it encodes
# flags:    what else it states
# reg:      the operand in ModRM.reg, field.NO_OPERAND when none is
# digit:    the opcode extension in ModRM.reg, NO_DIGIT when an operand is there or there is no ModRM
# rmdigit:  the opcode extension in ModRM.rm of a ModRM whose mod is 3, NO_DIGIT when an operand is there or none is
#           fixed
# scc:      the condition apx's ccmp and ctest hold in evex.aaa and v', NO_SCC for a row of none
# rm:       the operand in ModRM.rm, a register or memory, field.NO_OPERAND when there is no ModRM
# opreg:    the operand in the opcode byte's low three bits, field.NO_OPERAND when none is
# memory:   the memory operand the segment and address-size prefixes apply to, the rm operand or an a0 to a3 move's
#           address, field.NO_OPERAND when none
# vvvv:     the operand in vex.vvvv, xop.vvvv or evex.vvvv and v', a source register, apx's new data destination, or
#           the default flags of apx's ccmp and ctest as an enumerant in vvvv's low four bits, field.NO_OPERAND when none
# mask:     the opmask operand in evex.aaa, an optional register of k1 to k7 whose absence is k0's no masking,
#           field.NO_OPERAND when the row has none
# zeroing:  the optional enumerant operand `{z}` evex.z holds, zeroing the elements the mask clears,
#           field.NO_OPERAND when the row admits only merging
# rounding: the enumerant operand of embedded rounding or SAE, which evex.b and l'l hold on a register form,
#           field.NO_OPERAND when none
# length:   the vector length it encodes
# disp8:    the power of two a compressed disp8 is scaled by (evex disp8*N, Intel SDM 325462-093US Vol 2A 2.7.5), its
#           tuple type's N at the row's vector length and element size, 0 for a row of no scaling
# element:  the power of two of the bytes of the element a broadcast repeats, N under broadcast, 0 where the memory
#           operand admits none
# twin:     the register numbers the encoding of the instruction this row gives way to reaches, as a vex row's 16 or a
#           legacy row's 32 through rex2, 0 when this row is the instruction's preferred encoding. a row with a twin
#           is taken when its operands name a register past that reach or a mask, zeroing, broadcast or rounding the
#           twin has none of, or when the form names its encoding space
pub rec Opcode {
    space:    Space;
    map:      u8;
    byte:     u8;
    simd:     Simd;
    size:     Size;
    address:  Address;
    flags:    Flags;
    reg:      u8;
    digit:    u8;
    rmdigit:  u8;
    scc:      u8;
    rm:       u8;
    opreg:    u8;
    memory:   u8;
    vvvv:     u8;
    mask:     u8;
    zeroing:  u8;
    rounding: u8;
    length:   Length;
    disp8:    u8;
    element:  u8;
    twin:     u8;
}

# whether w admits row `op` of no operand size: either value where it is ignored, else the one the row states
fun w_admits(wide: bool, op: *Opcode) bool {
    if ((op.flags & WIG) != 0) { ret true; }
    ret wide == ((op.flags & W1) != 0);
}

# the operand size the prefixes 66 (`osz`) and rex.w or rex2.w (`wide`) give legacy row `op` in code of width `w`: 66
# is no fact of a row immune to it or whose mandatory prefix holds it, rex.w gives 64 bits in 64-bit code over 66, or
# 32 to a row that ignores it, as XED's IMMUNE_REXW(), and a row that defaults to 64 bits is 64 there without 66. a row
# immune to 66 is 32 bits in 16-bit code, as XED's IMMUNE66()
pub fun legacy_size(w: u8, osz: bool, wide: bool, op: *Opcode) Size {
    val o66: bool = osz && (op.flags & (IMMUNE_66 | MANDATORY)) == 0;
    if (w == 64) {
        if (wide && (op.flags & WIG) != 0)               { ret O32; }
        if (wide)                                        { ret O64; }
        if ((op.flags & DEFAULT_64) != 0 && !o66)        { ret O64; }
        if (o66)                                         { ret O16; }
        ret O32;
    }
    if ((op.flags & IMMUNE_66) != 0) { ret O32; }
    if ((w == 16) != o66)            { ret O16; }
    ret O32;
}

# whether the prefixes 66 (`osz`) and w (`wide`) in code of width `w` give the operand size row `op` encodes. in the
# legacy space 66 is the operand-size override unless the row's mandatory prefix holds it (MANDATORY), and rex.w no
# fact of a row of no size but as W1 and WIG state. in the vex, evex and xop spaces 66 is pp's 01, the row's mandatory
# prefix or its 16-bit operand size, and the width does not move the size: W gives 64 bits and no W 32
pub fun sized(w: u8, osz: bool, wide: bool, op: *Opcode) bool {
    if (op.space != LEGACY) {
        if (osz != (op.simd == P66 || op.size == O16)) { ret false; }
        if (op.size == NO_SIZE)                        { ret w_admits(wide, op); }
        ret wide == (op.size == O64);
    }
    if ((op.flags & MANDATORY) != 0 && osz != (op.simd == P66)) { ret false; }
    if (op.size == NO_SIZE)                                     { ret w_admits(wide, op); }
    ret legacy_size(w, osz, wide, op) == op.size;
}

# whether row `op` admits the prefixes 66 (`osz`), rex.w or rex2.w (`wide`) and a rex2 prefix (`rex2`) in code of width
# `w`: they give its operand size, and a rex2 prefix is one it takes, with W clear where W set is another instruction,
# and one it needs where it is part of its encoding
pub fun admits(w: u8, osz: bool, wide: bool, rex2: bool, op: *Opcode) bool {
    if (!sized(w, osz, wide, op))                    { ret false; }
    if (!rex2 && (op.flags & REX2) != 0)             { ret false; }
    if (rex2 && (op.flags & NO_REX2) != 0)           { ret false; }
    if (rex2 && wide && (op.flags & REFINED_W) != 0) { ret false; }
    ret true;
}

# the address size code of width `w` forms with an address-size override (`asz`) or without, as Address numbers it
pub fun address_of(w: u8, asz: bool) Address {
    if (w == 64) {
        if (asz) { ret A32; }
        ret A64;
    }
    if (w == 32) {
        if (asz) { ret A16; }
        ret A32;
    }
    if (asz) { ret A32; }
    ret A16;
}

# whether row `op` admits 67 (`asz`) in code of width `w`: any where it encodes no address size, else where the two
# give its own
pub fun addressed(w: u8, asz: bool, op: *Opcode) bool {
    if (op.address == NO_ADDRESS) { ret true; }
    ret address_of(w, asz) == op.address;
}
