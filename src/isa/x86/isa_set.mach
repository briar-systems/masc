# the ISA sets XED names, each as a requirement over the x86 catalog's rows
#
# an x86 instruction row states its ISA set as XED spells it, and the set answers what it needs
# of a selection: any one of its alternatives, each a conjunction of catalog rows. the table is
# generated by gen xed into gen_isa_set from XED's cpuid files, its rulings stated in
# gen/src/x86/isa_set.mach

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_compare;

use std.allocator.testing;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.index;
use masc.core.requirement;
use x86_extension: masc.isa.x86.extension;

use masc.isa.x86.gen_isa_set;

# the requirement of the ISA set `name`, spelled as XED spells it, or none when XED names no such set
pub fun requires(name: str) opt[requirement.Requirement] {
    val row: opt[u32] = index.find(?gen_isa_set.INDEX, name);
    if (sel row.none) { ret opt[requirement.Requirement].none{}; }
    ret opt[requirement.Requirement].some{gen_isa_set.REQUIRES[row.some]};
}

# whether the set `name` is admitted by the selection `spelling`
#[testing]
fun t_admits(spelling: str, name: str) bool {
    var t: testing.Testing;
    testing.make(?t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?x86_extension.CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    var s:     extension.Selection          = made.ok;
    val needs: opt[requirement.Requirement] = requires(name);
    var held:  bool                         = false;
    if (sel needs.some) { held = extension.admits(?s, needs.some); }
    extension.release(?s);
    ret held;
}

test requires__every_set_is_sorted_names_rows_and_is_admitted_by_its_rows_or_an_avx10_version {
    if (gen_isa_set.INDEX.len != gen_isa_set.COUNT) { ret 1; }
    var i: u32 = 0;
    for (i < gen_isa_set.COUNT) {
        if (gen_isa_set.INDEX.at[i].row != i)                                                        { ret 2; }
        if (i > 0 && str_compare(gen_isa_set.INDEX.at[i - 1].key, gen_isa_set.INDEX.at[i].key) >= 0) { ret 3; }
        val r: requirement.Requirement = gen_isa_set.REQUIRES[i];
        var a: u32                     = 0;
        for (a < r.len) {
            if (r.at[a].len == 0) { ret 4; }
            var k: u32 = 0;
            for (k < r.at[a].len) {
                if (r.at[a].at[k] >= x86_extension.COUNT) { ret 5; }
                k = k + 1;
            }
            a = a + 1;
        }
        i = i + 1;
    }
    if (!t_admits("avx512bw,avx512vl", "AVX512BW_128") || t_admits("avx512bw", "AVX512BW_128"))              { ret 6; }
    if (!t_admits("avx10_1", "AVX512BW_128") || t_admits("avx10_1", "AVX512_VNNI_INT8_128"))                 { ret 7; }
    if (!t_admits("avx10_2", "AVX512_VNNI_INT8_128") || !t_admits("avx10_vnni_int", "AVX512_VNNI_INT8_128")) { ret 8; }
    if (t_admits("avx10_1", "AVX512_VAES_128") || !t_admits("avx10_1,vaes,aes", "AVX512_VAES_128"))          { ret 9; }
    if (!t_admits("", "I86") || !t_admits("x86-64", "PAUSE") || t_admits("x86-64", "AVX"))                   { ret 10; }
    if (!t_admits("apx_f,bmi1", "APX_F_BMI1") || t_admits("apx_f", "APX_F_BMI1"))                            { ret 11; }
    if (!t_admits("x87,cmov", "FCMOV") || t_admits("x87", "FCMOV") || !t_admits("x86-64", "LONGMODE"))       { ret 12; }
    ret 0;
}
