# the ISA sets XED names, each as a requirement over the x86 catalog's rows
#
# an x86 instruction row states its ISA set as XED spells it, and the set answers what it needs
# of a selection and its state: any one of its alternatives, each a conjunction of atoms, rows of
# the catalog or state values as width=64, kept as XED states them. the table is generated by gen
# xed into gen_isa_set from XED's cpuid files and the cited facts of gen/data/x86, as
# gen/src/isa/x86/isa_set.mach states

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_compare;

use std.allocator.testing;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.index;
use masc.core.requirement;
use masc.core.state;
use x86_extension: masc.isa.x86.extension;

use masc.isa.x86.gen_isa_set;

# the requirement of the ISA set `name`, spelled as XED spells it, or none when XED names no such set
pub fun requires(name: str) opt[requirement.Requirement] {
    val row: opt[u32] = index.find(?gen_isa_set.INDEX, name);
    if (sel row.none) { ret opt[requirement.Requirement].none{}; }
    ret opt[requirement.Requirement].some{gen_isa_set.REQUIRES[row.some]};
}

# whether the set `name` is admitted by the selection `spelling` in code of the initial width, 64 bits unless the
# spelling states another
#[testing]
fun t_admits(spelling: str, name: str) bool {
    var t: testing.Testing;
    testing.make(?t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?x86_extension.CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    var s:     extension.Selection             = made.ok;
    val needs: opt[requirement.Requirement]    = requires(name);
    val ctx:   res[state.Context, state.Error] = state.make(?s, ?x86_extension.AXES, state.initial(?x86_extension.AXES));
    var held:  bool                            = false;
    if (sel needs.some) {
        if (sel ctx.ok) {
            var c: state.Context = ctx.ok;
            held = state.admits(?c, needs.some);
        }
    }
    extension.release(?s);
    ret held;
}

test requires__every_set_is_sorted_names_atoms_and_is_admitted_as_xed_and_the_overlay_state {
    if (gen_isa_set.INDEX.len != gen_isa_set.COUNT) { ret 1; }
    var i: u32 = 0;
    for (i < gen_isa_set.COUNT) {
        if (gen_isa_set.INDEX.at[i].row != i)                                                        { ret 2; }
        if (i > 0 && str_compare(gen_isa_set.INDEX.at[i - 1].key, gen_isa_set.INDEX.at[i].key) >= 0) { ret 3; }
        val r: requirement.Requirement = gen_isa_set.REQUIRES[i];
        var a: u32                     = 0;
        for (a < r.len) {
            if (r.at[a].all.len == 0 || r.at[a].none.len != 0) { ret 4; }
            var k: u32 = 0;
            for (k < r.at[a].all.len) {
                if (r.at[a].all.at[k] >= state.atom_count(?x86_extension.CATALOG, ?x86_extension.AXES)) { ret 5; }
                k = k + 1;
            }
            a = a + 1;
        }
        i = i + 1;
    }
    if (!t_admits("avx512bw,avx512vl", "AVX512BW_128") || t_admits("avx512bw", "AVX512BW_128"))            { ret 6; }
    if (!t_admits("avx10_1", "AVX512BW_128") || t_admits("avx10_1", "AVX512_VNNI_INT8_128"))               { ret 7; }
    if (!t_admits("avx10_2", "AVX512_VNNI_INT8_128") || !t_admits("avx10_v1_aux", "AVX512_VNNI_INT8_128")) { ret 8; }
    if (!t_admits("", "I86") || !t_admits("", "PAUSE") || t_admits("", "AVX"))                             { ret 9; }
    if (!t_admits("apx_f,bmi1", "APX_F_BMI1") || t_admits("apx_f", "APX_F_BMI1"))                          { ret 10; }
    if (!t_admits("", "LONGMODE") || t_admits("width=32", "LONGMODE"))                                     { ret 11; }
    if (!t_admits("3dnow", "3DNOW") || t_admits("", "3DNOW") || !t_admits("x87,cmov", "FCMOV"))            { ret 12; }
    val none: opt[requirement.Requirement] = requires("NO_SUCH_SET");
    if (sel none.some) { ret 13; }
    ret 0;
}
