# the x86 set's registration record
#
# one record for i386 and x86_64: each architecture enters its code width, which `.code16`, `.code32` and `.code64`
# switch, and the catalog's rows admit a width by their requirements. the record only names the pieces, each the owner
# of its own tables. a jump's 8-bit target relaxes to its instruction's wider one at the code width (gen_relax), and x86
# code is not compressed here

use std.types.bool.false;
use std.types.string.str;

use arch_x86:   mink.catalog.arch.x86;
use mink_trait: mink.catalog.trait;

use masc.core.compress;
use masc.core.ct;
use masc.core.fixup;
use masc.core.mode;
use masc.core.operand;
use masc.core.set;
use masc.core.syntax;
use masc.core.trait;

use x86_catalog:   masc.isa.x86.catalog;
use x86_extension: masc.isa.x86.extension;
use x86_fixup:     masc.isa.x86.fixup;
use x86_relax:     masc.isa.x86.gen_relax;
use x86_source:    masc.isa.x86.source;
use x86_syntax:    masc.isa.x86.syntax;

# the gnu property note's axes, the isa levels and features the code needs and uses, its indirect branch tracking,
# shadow stack and linear address masking (x86-64 psABI, "Program Property"): the compiler writes the note, never the
# assembler, so the set leaves each needed and used axis unstated and a source axis clear where the source states none
val NO_NOTE: str = "the compiler writes the GNU property note itself, so the assembler writes none whatever the selection or the code";

val OWNERS: [36]trait.Owned = [36]trait.Owned{
    trait.Owned{axis: ?arch_x86.X86_IBT, owner: trait.Owner.source{trait.Default{setting: mink_trait.Setting.flag{false}, cites: NO_NOTE}}},
    trait.Owned{axis: ?arch_x86.X86_SHSTK, owner: trait.Owner.source{trait.Default{setting: mink_trait.Setting.flag{false}, cites: NO_NOTE}}},
    trait.Owned{axis: ?arch_x86.X86_LAM_U48, owner: trait.Owner.source{trait.Default{setting: mink_trait.Setting.flag{false}, cites: NO_NOTE}}},
    trait.Owned{axis: ?arch_x86.X86_LAM_U57, owner: trait.Owner.source{trait.Default{setting: mink_trait.Setting.flag{false}, cites: NO_NOTE}}},
    trait.Owned{axis: ?arch_x86.X86_ISA_NEEDED_BASELINE, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_ISA_NEEDED_V2, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_ISA_NEEDED_V3, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_ISA_NEEDED_V4, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_ISA_USED_BASELINE, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_ISA_USED_V2, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_ISA_USED_V3, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_ISA_USED_V4, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_X86, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_X87, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_MMX, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_XMM, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_YMM, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_ZMM, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_FXSR, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_XSAVE, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_XSAVEOPT, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_XSAVEC, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_TMM, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_NEEDED_MASK, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_X86, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_X87, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_MMX, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_XMM, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_YMM, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_ZMM, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_FXSR, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_XSAVE, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_XSAVEOPT, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_XSAVEC, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_TMM, owner: trait.Owner.unwritten{NO_NOTE}},
    trait.Owned{axis: ?arch_x86.X86_FEATURE_USED_MASK, owner: trait.Owner.unwritten{NO_NOTE}},
};

# the registration of x86 at its widths
pub val SET: set.Set = set.Set{
    arches:      set.Arches{at: ?x86_extension.ARCHES[0], len: 2},
    states:      x86_extension.AXES,
    codec:       ?x86_catalog.CODEC,
    extensions:  ?x86_extension.CATALOG,
    bindings:    fixup.Bindings{at: ?x86_fixup.BINDINGS[0], len: x86_fixup.COUNT},
    locals:      fixup.NO_LOCALS,
    relax:       x86_relax.RELAXATIONS,
    compress:    compress.NO_COMPRESSIONS,
    fill:        ?x86_catalog.FILL,
    realign:     operand.NO_FIXUP,
    data:        fixup.Data{at: ?x86_fixup.DATA[0], len: x86_fixup.DATA_COUNT},
    spans:       fixup.NO_SPANS,
    syntaxes:    syntax.Syntaxes{at: ?x86_syntax.SYNTAX, len: 1},
    traits:      trait.Owners{at: ?OWNERS[0], len: 36},
    conventions: set.NO_CONVENTIONS,
    assembly:    mode.NO_MODES,
    pairs:       fixup.NO_PAIRS,
    source:      x86_source.SOURCE,
    parcel:      x86_source.parcel,
    config:      nil,
    ct:          ct.Timing.rows{},
    parts:       fixup.Parts{at: ?x86_fixup.PARTS[0], len: x86_fixup.PART_COUNT},
};
