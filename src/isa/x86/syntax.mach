# the x86 assembly syntax, intel's, as llvm-mc 23.1.1 reads it under `.intel_syntax noprefix` and llvm-objdump 23.1.1
# prints it under `-M intel`
#
# every row's template and the index by mnemonic are generated from XED (gen_syntax): the prefix words, the mnemonic
# and the operands comma separated, in XED's order but where the overlay's operands topic states llvm's, evex's opmask
# and `{z}` in braces after the operand they decorate, and a rounding control or `{sae}` after the last operand that is
# no immediate. what is written here is what the generator cannot state, the hooks of the operands the framework does
# not spell from a table:
#   immediates  the core's decimal expressions, a negative value as `-16`, as llvm-objdump prints them under
#               `--no-print-imm-hex`, so an immediate that decodes signed prints signed and one that decodes either way
#               prints unsigned, and a register's name is never read as a symbol
#   memory      `<size> ptr <segment>:[<base> + <scale>*<index> + <displacement>]{1to<n>}`, each part absent when the
#               address has none, the displacement subtracted when negative and dropped when zero beside a register.
#               the size is the word of the bits the operand accesses (byte, word, dword, fword, qword, tbyte, xmmword,
#               ymmword, zmmword, and read too float, long, double, mmword and xword), of one element under a broadcast, none for bits no word names or for an address
#               computed but never accessed, as lea's, or the word the template's hole format names, `-` for none,
#               where llvm's operand type is another than the access, as a prefetch's byte. memory written with no
#               size reads as the code width's for call, jmp, push and pop, and else as the one size the rows that
#               read the text take, refused where they take more than one, as llvm-mc reads `add eax, [rax]` and
#               refuses `add [rax], 1`. rip is the base of a rip-relative address, eip of one whose operand addresses
#               by 32-bit registers alone, as enqcmd's 67 row, and the segment a string operand fixes is written, as
#               es of `es:[di]`. the displacement may name a symbol and its addend, as `[rip + ext + 8]`, whose fixup
#               the ModRM kind chooses: pc-relative from the instruction's end for a rip-relative address, as llvm-mc
#               writes R_X86_64_PC32 ext-4, else absolute
# relative targets are the core's expression of their offset. registers are written by name, x87's as st(1), and read
# without regard to case.
#
# a symbol takes an elf relocation specifier after it, as llvm-mc 23.1.1 reads them under elf (X86MCAsmInfo's
# specifiers), after a quoted name too, as `call "f"@PLT`, and without regard to case: `@PLT` on a call's or a jump's
# target, and on a displacement or a 32-bit immediate the got, plt, tls and tlsdesc kinds, `@GOTPCREL`, `@GOT`,
# `@GOTOFF`, `@TPOFF`, `@DTPOFF`, `@GOTTPOFF`, `@TLSGD`, `@TLSLD`, `@TLSDESC` and `@TLSCALL`, and i386's `@NTPOFF`,
# `@INDNTPOFF`, `@GOTNTPOFF` and `@TLSLDM`, each bound on the architectures that relocate it
# (masc.isa.x86.fixup), and on a 64-bit immediate `@GOT`, `@GOTOFF`, `@PLTOFF`, `@TPOFF` and `@DTPOFF`. a
# displacement reads them whichever field holds it, a ModRM displacement or an a0 to a3 move's address, and its
# address chooses the relocation (PLACEMENTS). llvm-mc reads no `@GOTPCRELX` and no `@DTPMOD` on x86, so neither is
# read here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use mink_format: mink.catalog.format;

use masc.core.diagnostic;
use masc.core.field;
use masc.core.operand;
use masc.core.register;
use core_syntax: masc.core.syntax;
use masc.syntax.expr;
use masc.syntax.read;
use masc.syntax.write;

use x86_field: masc.isa.x86.field;
use x86_fixup: masc.isa.x86.fixup;
use masc.isa.x86.gen_syntax;

pub val NO_SIZE:      str = "memory operand states no size, or another than the instruction's";
pub val NOT_SCALE:    str = "index scale is none of 1, 2, 4 and 8";
pub val NO_ADDRESS:   str = "memory operand is no address the syntax reads";
pub val TWO_PARTS:    str = "memory operand names its base, index or displacement twice";
pub val NEGATED:      str = "memory operand subtracts a symbol";
pub val NO_BROADCAST: str = "memory operand broadcasts no element count it admits";

# a size word and the width it names
# ---
# word:    the word
# bits:    the width
# printed: whether the printer writes it, as llvm-objdump 23.1.1 does, else a further word llvm-mc 23.1.1 reads for
#          the width alone (llvm-project 7ddb67460b168b17ebb263dc99bf956b56d7e517
#          llvm/lib/Target/X86/AsmParser/X86AsmParser.cpp getIntelMemOperandSize), as float of dword
rec Size {
    word:    str;
    bits:    u16;
    printed: bool;
}

val SIZE_COUNT: u32 = 14;

val SIZES: [SIZE_COUNT]Size = [SIZE_COUNT]Size{
    Size{word: "byte", bits: 8, printed: true},
    Size{word: "word", bits: 16, printed: true},
    Size{word: "dword", bits: 32, printed: true},
    Size{word: "fword", bits: 48, printed: true},
    Size{word: "qword", bits: 64, printed: true},
    Size{word: "tbyte", bits: 80, printed: true},
    Size{word: "xmmword", bits: 128, printed: true},
    Size{word: "ymmword", bits: 256, printed: true},
    Size{word: "zmmword", bits: 512, printed: true},
    Size{word: "float", bits: 32, printed: false},
    Size{word: "long", bits: 32, printed: false},
    Size{word: "double", bits: 64, printed: false},
    Size{word: "mmword", bits: 64, printed: false},
    Size{word: "xword", bits: 80, printed: false},
};

fun size_word(bits: u16) str {
    var i: u32 = 0;
    for (i < SIZE_COUNT) {
        if (SIZES[i].printed && SIZES[i].bits == bits) { ret SIZES[i].word; }
        i = i + 1;
    }
    ret nil;
}

# whether `v` is `word`
fun spells(word: str, v: View) bool {
    if (str_len(word) != v.len) { ret false; }
    var i: usize = 0;
    for (i < v.len) {
        if (word[i] != v.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the bits the size word of a memory operand written under hole format `format` names, 0 for none: the format names
# the word, `-` names none, and no format the word of the bits the operand accesses, an element of them under a
# broadcast of 2^`broadcast` elements, none for bits no word names, as fxsave's 512 bytes, or for none, as lea's
fun sized(desc: *operand.Operand, format: View, broadcast: u8) u16 {
    if (format.len == 1 && format.data[0] == '-') { ret 0; }
    if (format.len > 0) {
        var i: u32 = 0;
        for (i < SIZE_COUNT) {
            if (spells(SIZES[i].word, format)) { ret SIZES[i].bits; }
            i = i + 1;
        }
        ret 0;
    }
    val bits: u16 = desc.width >> broadcast::u16;
    if (size_word(bits) == nil) { ret 0; }
    ret bits;
}

# a register's name is no symbol, as llvm-mc reserves them, so `mov ah, sil` is never a move of the address sil
fun immediate_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val at:  usize                                   = r.at;
    val reg: res[register.Id, diagnostic.Diagnostic] = read.register_value(r, false);
    r.at = at;
    if (sel reg.ok) { ret refused(r, read.EXPECTED, at); }
    ret expr.IMMEDIATE.parse(r, desc, format, out);
}

val IMMEDIATE: core_syntax.Hook = core_syntax.Hook{parse: immediate_parse, print: expr.IMMEDIATE.print};

# whether `reg` is the instruction pointer, which a rip-relative address names as its base
fun is_ip(file: *register.File, reg: register.Id) bool {
    val ip: opt[register.Id] = register.named(file, view("rip", 3), true);
    ret sel ip.some && ip.some == reg;
}

# whether memory operand `desc` addresses by 32-bit registers alone, a row's own 67 in 64-bit code, whose
# rip-relative address llvm-objdump 23.1.1 writes as eip's, as enqcmd's `[eip + 1]`
fun narrow_ip(file: *register.File, desc: *operand.Operand) bool {
    if (!sel desc.shape.memory) { ret false; }
    val classes: operand.Classes = desc.shape.memory.base.classes;
    val narrow:  opt[u16]        = register.class_named(file, "gpr32");
    if (classes.len == 0) { ret false; }
    if (sel narrow.some) {
        var i: u32 = 0;
        for (i < classes.len) {
            if (classes.at[i] != narrow.some) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    ret false;
}

# the one segment a string operand's shape fixes, as es of a string destination, which no prefix overrides, NONE for an
# operand whose segment is free
fun fixed_segment(desc: *operand.Operand) register.Id {
    if (!sel desc.shape.memory) { ret register.NONE; }
    val seg: operand.Register = desc.shape.memory.segment;
    if (seg.count != 1 || seg.classes.len != 1) { ret register.NONE; }
    ret register.make(seg.classes.at[0], seg.first::u16);
}

# the default fixup kind a memory operand's symbol reads and writes its specifiers under: a ModRM displacement's for
# any displacement, an a0 to a3 move's 64-bit address too, since the address and not the field chooses the
# relocation, and none for an operand of no displacement, as a string operand's
fun displaced(desc: *operand.Operand) operand.FixupKind {
    if (!sel desc.shape.memory)                       { ret operand.NO_FIXUP; }
    if (desc.shape.memory.disp.fixup == operand.NO_FIXUP) { ret operand.NO_FIXUP; }
    ret x86_fixup.ABS32;
}

fun memory_print(w: *core_syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (!sel value.memory) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    val a:    operand.Address = value.memory;
    val bits: u16             = sized(desc, format, a.broadcast);
    if (bits != 0) {
        val worded: err[field.Refusal] = write.text(w, size_word(bits));
        if (sel worded.err) { ret worded; }
        val ptr_word: err[field.Refusal] = write.text(w, " ptr ");
        if (sel ptr_word.err) { ret ptr_word; }
    }
    var segment: register.Id = a.segment;
    if (segment == register.NONE) { segment = fixed_segment(desc); }
    if (segment != register.NONE) {
        val seg: err[field.Refusal] = write.register_name(w, segment, field.NO_OPERAND);
        if (sel seg.err) { ret seg; }
        val colon: err[field.Refusal] = write.text(w, ":");
        if (sel colon.err) { ret colon; }
    }
    val open: err[field.Refusal] = write.text(w, "[");
    if (sel open.err) { ret open; }
    var plus: bool = false;
    if (a.mode == operand.RELATIVE_PC) {
        var named: str = "rip";
        if (narrow_ip(w.codec.registers, desc)) { named = "eip"; }
        val ip: err[field.Refusal] = write.text(w, named);
        if (sel ip.err) { ret ip; }
        plus = true;
    }
    or (a.base != register.NONE) {
        val base: err[field.Refusal] = write.register_name(w, a.base, field.NO_OPERAND);
        if (sel base.err) { ret base; }
        plus = true;
    }
    if (a.index != register.NONE) {
        if (plus) {
            val joined: err[field.Refusal] = write.text(w, " + ");
            if (sel joined.err) { ret joined; }
        }
        if (a.scale != 0) {
            val scaled: err[field.Refusal] = write.decimal(w, (1::i64 << a.scale::i64));
            if (sel scaled.err) { ret scaled; }
            val times: err[field.Refusal] = write.text(w, "*");
            if (sel times.err) { ret times; }
        }
        val index: err[field.Refusal] = write.register_name(w, a.index, field.NO_OPERAND);
        if (sel index.err) { ret index; }
        plus = true;
    }
    if (a.symbol.id != operand.NO_SYMBOL) {
        if (plus) {
            val joined: err[field.Refusal] = write.text(w, " + ");
            if (sel joined.err) { ret joined; }
        }
        val named: err[field.Refusal] = expr.print_symbol(w, a.symbol, displaced(desc), field.NO_OPERAND);
        if (sel named.err) { ret named; }
    }
    or (a.disp != 0 || !plus) {
        var d: i64 = a.disp;
        if (plus) {
            var joint: str = " + ";
            if (d < 0) {
                joint = " - ";
                d     = 0 - d;
            }
            val joined: err[field.Refusal] = write.text(w, joint);
            if (sel joined.err) { ret joined; }
        }
        val disp: err[field.Refusal] = write.decimal(w, d);
        if (sel disp.err) { ret disp; }
    }
    val close: err[field.Refusal] = write.text(w, "]");
    if (sel close.err || a.broadcast == 0) { ret close; }
    val to: err[field.Refusal] = write.text(w, "{1to");
    if (sel to.err) { ret to; }
    val count: err[field.Refusal] = write.decimal(w, 1::i64 << a.broadcast::i64);
    if (sel count.err) { ret count; }
    ret write.text(w, "}");
}

# the broadcast `{1to<n>}` after a memory operand, n's log into `out`, 0 when the text holds none there
fun broadcast_of(r: *core_syntax.Reader, out: *u8) err[diagnostic.Diagnostic] {
    @out = 0;
    val at: usize = r.at;
    if (!read.take(r, "{1to")) { ret err[diagnostic.Diagnostic].ok{}; }
    val n: res[i64, diagnostic.Diagnostic] = read.number(r);
    if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
    var log: u8 = 0;
    for (log < 7 && (1::i64 << log::i64) != n.ok) {
        log = log + 1;
    }
    if (log == 0 || log == 7 || !read.take(r, "}")) { ret refused(r, NO_BROADCAST, at); }
    @out = log;
    ret err[diagnostic.Diagnostic].ok{};
}

# the word at the reader's position read when it is `text`, ending at a word boundary
fun take_word(r: *core_syntax.Reader, text: str) bool {
    val at:  usize = r.at;
    val len: usize = str_len(text);
    if (!read.starts(r, at, text, len) || !read.bounded(r, at, len, text[len - 1])) { ret false; }
    r.at = at + len;
    ret true;
}

# the size word of the memory operand at the reader's position and its `ptr`, 0 when there is none
fun size_of(r: *core_syntax.Reader) u16 {
    val at: usize = r.at;
    var i:  u32   = 0;
    for (i < SIZE_COUNT) {
        if (take_word(r, SIZES[i].word)) {
            read.skip(r);
            if (take_word(r, "ptr")) {
                read.skip(r);
                ret SIZES[i].bits;
            }
            r.at = at;
        }
        i = i + 1;
    }
    ret 0;
}

fun refused(r: *core_syntax.Reader, message: str, at: usize) err[diagnostic.Diagnostic] {
    ret err[diagnostic.Diagnostic].err{read.refuse(r, message, at, read.token(r, at))};
}

# the log of scale `n`, none for a scale other than 1, 2, 4 and 8
fun scale_of(n: i64) opt[u8] {
    if (n == 1) { ret opt[u8].some{0}; }
    if (n == 2) { ret opt[u8].some{1}; }
    if (n == 4) { ret opt[u8].some{2}; }
    if (n == 8) { ret opt[u8].some{3}; }
    ret opt[u8].none{};
}

# a displacement term that is no number and no register, as `ext`: the expression's one term, a symbol whose addend
# the address's numbers add to once it is read, or a constant a name equates to, under the displacement's fixup kind
fun displacement(r: *core_syntax.Reader, a: *operand.Address, negative: bool, seen: *bool, fixup: operand.FixupKind) err[diagnostic.Diagnostic] {
    val at: usize                                 = r.at;
    val e:  res[expr.Expr, diagnostic.Diagnostic] = expr.unary(r, fixup);
    if (sel e.err) { ret err[diagnostic.Diagnostic].err{e.err}; }
    val got: expr.Expr = e.ok;
    if (sel got.difference) { ret err[diagnostic.Diagnostic].err{read.refuse(r, expr.DIFFERENCE, at, r.at - at)}; }
    if (sel got.symbol) {
        if (negative)                         { ret refused(r, NEGATED, at); }
        if (a.symbol.id != operand.NO_SYMBOL) { ret refused(r, TWO_PARTS, at); }
        a.symbol = got.symbol;
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (sel got.constant) {
        if (@seen) { ret refused(r, TWO_PARTS, at); }
        @seen = true;
        if (negative) { a.disp = 0 - got.constant; }
        or            { a.disp = got.constant; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# a term of the address: a register, a register times a scale, a scale times a register, a number, or a displacement
# naming a symbol, added or, for a number or a constant, subtracted
fun term(r: *core_syntax.Reader, a: *operand.Address, negative: bool, seen: *bool, fixup: operand.FixupKind, eip: bool) err[diagnostic.Diagnostic] {
    val at: usize = r.at;
    # eip names the instruction pointer of an operand that addresses by 32-bit registers alone
    if (eip && !negative && read.take(r, "eip")) {
        if (a.base != register.NONE || a.mode == operand.RELATIVE_PC) { ret refused(r, TWO_PARTS, at); }
        a.mode = operand.RELATIVE_PC;
        ret err[diagnostic.Diagnostic].ok{};
    }
    val c: u8 = read.peek(r);
    if (c >= '0' && c <= '9') {
        val n: res[i64, diagnostic.Diagnostic] = read.number(r);
        if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
        read.skip(r);
        if (read.take(r, "*")) {
            read.skip(r);
            val s: opt[u8] = scale_of(n.ok);
            if (sel s.none)                           { ret refused(r, NOT_SCALE, at); }
            if (negative || a.index != register.NONE) { ret refused(r, TWO_PARTS, at); }
            val reg: res[register.Id, diagnostic.Diagnostic] = read.register_value(r, true);
            if (sel reg.err) { ret err[diagnostic.Diagnostic].err{reg.err}; }
            a.index = reg.ok;
            a.scale = s.some;
            ret err[diagnostic.Diagnostic].ok{};
        }
        if (@seen) { ret refused(r, TWO_PARTS, at); }
        @seen = true;
        if (negative) { a.disp = 0 - n.ok; }
        or            { a.disp = n.ok; }
        ret err[diagnostic.Diagnostic].ok{};
    }
    val reg: res[register.Id, diagnostic.Diagnostic] = read.register_value(r, true);
    if (sel reg.err) {
        r.at = at;
        ret displacement(r, a, negative, seen, fixup);
    }
    if (negative) { ret refused(r, NO_ADDRESS, at); }
    read.skip(r);
    if (read.take(r, "*")) {
        read.skip(r);
        val n: res[i64, diagnostic.Diagnostic] = read.number(r);
        if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
        val s: opt[u8] = scale_of(n.ok);
        if (sel s.none)               { ret refused(r, NOT_SCALE, at); }
        if (a.index != register.NONE) { ret refused(r, TWO_PARTS, at); }
        a.index = reg.ok;
        a.scale = s.some;
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (is_ip(r.codec.registers, reg.ok)) {
        if (a.base != register.NONE || a.mode == operand.RELATIVE_PC) { ret refused(r, TWO_PARTS, at); }
        a.mode = operand.RELATIVE_PC;
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (a.base == register.NONE && a.mode != operand.RELATIVE_PC) { a.base = reg.ok; }
    or (a.index == register.NONE)                                 { a.index = reg.ok; }
    or                                                            { ret refused(r, TWO_PARTS, at); }
    ret err[diagnostic.Diagnostic].ok{};
}

fun memory_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val at:   usize           = r.at;
    val bits: u16             = size_of(r);
    var a:    operand.Address = operand.Address{base: register.NONE, index: register.NONE, scale: 0, disp: 0, segment: register.NONE, mode: operand.OFFSET, symbol: operand.Symbol{id: operand.NO_SYMBOL, addend: 0, fixup: operand.NO_FIXUP}, extend: 0, broadcast: 0};
    if (read.peek(r) != '[') {
        val seg: res[register.Id, diagnostic.Diagnostic] = read.register_value(r, true);
        if (sel seg.err) { ret err[diagnostic.Diagnostic].err{seg.err}; }
        read.skip(r);
        if (!read.take(r, ":")) { ret refused(r, NO_ADDRESS, r.at); }
        read.skip(r);
        # a string operand's fixed segment is the operand's own, as it decodes
        if (seg.ok != fixed_segment(desc)) { a.segment = seg.ok; }
    }
    if (!read.take(r, "[")) { ret refused(r, NO_ADDRESS, r.at); }
    read.skip(r);
    val fixup:    operand.FixupKind = displaced(desc);
    var seen:     bool = false;
    var negative: bool = false;
    val narrow:   bool = narrow_ip(r.codec.registers, desc);
    # an address of a displacement alone may be negative, as `[-1]`
    if (read.take(r, "-")) {
        negative = true;
        read.skip(r);
    }
    for {
        val got: err[diagnostic.Diagnostic] = term(r, ?a, negative, ?seen, fixup, narrow);
        if (sel got.err) { ret got; }
        read.skip(r);
        if (read.take(r, "]")) { brk; }
        if (read.take(r, "+")) { negative = false; }
        or (read.take(r, "-")) { negative = true; }
        or                     { ret refused(r, NO_ADDRESS, r.at); }
        read.skip(r);
    }
    var spread:      u8                         = 0;
    val spread_read: err[diagnostic.Diagnostic] = broadcast_of(r, ?spread);
    if (sel spread_read.err) { ret spread_read; }
    if (spread != 0) {
        var admitted: u8 = 0;
        if (sel desc.shape.memory)           { admitted = desc.shape.memory.broadcasts; }
        if (((admitted >> spread) & 1) == 0) { ret refused(r, NO_BROADCAST, at); }
        a.broadcast = spread;
    }
    val own: u16 = sized(desc, format, spread);
    if (bits == 0 && own != 0) {
        # call's, jmp's, push's and pop's memory of no size is the code width's, as llvm-mc reads `push [rax]` as
        # qword (llvm-project 7ddb67460b168b17ebb263dc99bf956b56d7e517
        # llvm/lib/Target/X86/AsmParser/X86AsmParser.cpp, PtrSizedInstrs), and any other's the one size the rows
        # that read the text take
        if (pointer_sized(r)) {
            if (own != x86_field.width(r.ctx)::u16) { ret refused(r, NO_SIZE, at); }
        }
        or { r.unsized = true; }
    }
    or (bits != own) { ret refused(r, NO_SIZE, at); }
    # a symbolic displacement carries the address's number as its addend
    if (a.symbol.id != operand.NO_SYMBOL) {
        a.symbol.addend = a.symbol.addend + a.disp;
        a.disp          = 0;
    }
    @out = operand.Value.memory{a};
    ret err[diagnostic.Diagnostic].ok{};
}

val MEMORY: core_syntax.Hook = core_syntax.Hook{parse: memory_parse, print: memory_print};

val POINTER_COUNT: u32 = 4;

val POINTER_SIZED: [POINTER_COUNT]str = [POINTER_COUNT]str{"call", "jmp", "push", "pop"};

# whether the row the reader reads is one whose memory of no size is the code width's
fun pointer_sized(r: *core_syntax.Reader) bool {
    if (r.row == nil) { ret false; }
    var i: u32 = 0;
    for (i < POINTER_COUNT) {
        if (str_equals(r.row.mnemonic, POINTER_SIZED[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the words that select rows of their own before a mnemonic, as llvm-mc 23.1.1 reads `lock add`, `rep movsb`, apx's
# `{nf} add` and `addr16 loop`, a 67 the operands do not show
val PREFIX_COUNT: u32 = 6;

val PREFIX_WORDS: [PREFIX_COUNT]str = [PREFIX_COUNT]str{"lock", "rep", "repne", "{nf}", "addr16", "addr32"};

# the formats whose dialect reads the elf specifiers
val ELF_ONLY: [1]*mink_format.Format = [1]*mink_format.Format{?mink_format.ELF};
val ELF:      core_syntax.Formats    = core_syntax.Formats{at: ?ELF_ONLY[0], len: 1};

val SPECIFIER_COUNT: u32 = 36;

# the elf specifiers: `@PLT` on a branch target, the 32-bit kinds on a displacement and on a 32-bit immediate, plain
# and sign-extended, and the 64-bit kinds on a 64-bit immediate
val SPECIFIERS: [SPECIFIER_COUNT]core_syntax.Specifier = [SPECIFIER_COUNT]core_syntax.Specifier{
    core_syntax.Specifier{template: "<0>@PLT", operand: x86_fixup.BRANCH32, fixup: x86_fixup.PLT, fold: nil, formats: ELF},
    core_syntax.Specifier{template: "<0>@PLT", operand: x86_fixup.ABS32, fixup: x86_fixup.PLT, fold: nil, formats: ELF},
    core_syntax.Specifier{template: "<0>@GOTPCREL", operand: x86_fixup.ABS32, fixup: x86_fixup.GOTPCREL, fold: nil, formats: ELF},
