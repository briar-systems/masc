    core_syntax.Specifier{template: "<0>@GOTTPOFF", operand: x86_fixup.ABS32, fixup: x86_fixup.GOTTPOFF, fold: nil, formats: ELF},
    core_syntax.Specifier{template: "<0>@TLSGD", operand: x86_fixup.ABS32, fixup: x86_fixup.TLSGD, fold: nil, formats: ELF},
    core_syntax.Specifier{template: "<0>@TLSLD", operand: x86_fixup.ABS32, fixup: x86_fixup.TLSLD, fold: nil, formats: ELF},
    core_syntax.Specifier{template: "<0>@TLSLDM", operand: x86_fixup.ABS32, fixup: x86_fixup.TLSLDM, fold: nil, formats: ELF},
    core_syntax.Specifier{template: "<0>@INDNTPOFF", operand: x86_fixup.ABS32, fixup: x86_fixup.INDNTPOFF, fold: nil, formats: ELF},
    core_syntax.Specifier{template: "<0>@GOTNTPOFF", operand: x86_fixup.ABS32, fixup: x86_fixup.GOTNTPOFF, fold: nil, formats: ELF},
