    core_syntax.Specifier{template: "<0>@PLT", operand: x86_fixup.ABS32S, fixup: x86_fixup.PLT, fold: nil, formats: ELF},
    core_syntax.Specifier{template: "<0>@GOTPCREL", operand: x86_fixup.ABS32S, fixup: x86_fixup.GOTPCREL, fold: nil, formats: ELF},
    core_syntax.Specifier{template: "<0>@GOT", operand: x86_fixup.ABS32S, fixup: x86_fixup.GOT, fold: nil, formats: ELF},
    core_syntax.Specifier{template: "<0>@GOTOFF", operand: x86_fixup.ABS32S, fixup: x86_fixup.GOTOFF, fold: nil, formats: ELF},
