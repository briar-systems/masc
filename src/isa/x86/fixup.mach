# the x86 fixup kinds and their binding to mink's relocation kinds
#
# a symbolic immediate, relative target, displacement or address takes one of
# these kinds by the width of its field and what it is measured from. a
# 32-bit field that 64-bit code sign-extends, as a displacement under 64-bit
# addressing or the immediate of an instruction of 64-bit operand size, is
# ABS32S, which only x86_64's formats relocate (R_X86_64_32S), and the 64-bit
# kinds are x86_64's alone as well: i386's formats have no 64-bit relocation.
# a branch's 32-bit displacement is BRANCH32, which a format may route through
# a stub, as R_X86_64_PLT32, where a rip-relative address stays PC32. elf
# routes only a branch to a bare symbol so, and writes one to `foo+8` as PC32.
# a displacement takes the kind of the address it is in, which the ModRM kind
# chooses (masc.isa.x86.field), and a symbol may state another.
#
# the kinds a symbol states by an elf specifier (masc.isa.x86.syntax) follow,
# each bound on the architectures whose psABI has it, to its relocation there:
# `@PLT` is R_X86_64_PLT32 on x86_64 and R_386_PLT32 on i386, `@TPOFF`
# R_X86_64_TPOFF32 and R_386_TLS_LE_32, and the i386 kinds are i386's alone
# (x86-64 psABI 1.0, 4.4 "Relocation Types", and i386 psABI 1.1, 2.6
# "Relocation Types", with the tls models of Drepper's "ELF Handling For
# Thread-Local Storage"). a displacement is written under the kind its address
# takes the stated one as (PLACEMENTS): a pc-relative kind only in a
# rip-relative address and an absolute one only outside one, the general
# dynamic, initial-exec and tlsdesc kinds of i386 under their own kinds, which
# x86_64 has none of. the encoder writes some as a kind that refines them by
# the instruction they are in: `@GOTPCREL` as
# R_X86_64_GOTPCRELX, REX_GOTPCRELX or CODE_4_GOTPCRELX in an instruction the
# linker may relax, `@GOTTPOFF` and `@TLSDESC` as their CODE_4 and CODE_6
# forms under rex2 and apx's evex, and i386's `@GOT` as R_386_GOT32X in a load
# from a base register. `@TLSCALL` marks the indirect call of a tlsdesc
# sequence, its relocation at the instruction's start.
#
# mach-o's and coff's kinds are their own: mach-o's `@GOTPCREL` is
# X86_64_RELOC_GOT, which the encoder writes as X86_64_RELOC_GOT_LOAD in a
# 64-bit mov load of no addend, and `@TLVP` X86_64_RELOC_TLV, both
# rip-relative alone (Apple's mach-o/x86_64/reloc.h), and coff's `@SECREL32`
# and `@IMGREL` IMAGE_REL_AMD64_SECREL and ADDR32NB and their i386 twins, both
# absolute alone (Microsoft PE format, "COFF Relocations"). each format writes
# only its own kinds, so an object of another refuses them. every kind is
# offered to a consumer that builds code (masc.emit), the general and local
# dynamic tls models included. a consumer states the kind a specifier spells,
# and the encoder writes its refinement: the refined kinds, GOTPCRELX and its
# CODE_4 and REX forms, the CODE_4 and CODE_6 forms of GOTTPOFF and TLSDESC,
# GOT32X, TLS_IE_32, TLS_GD, TLS_GOTDESC and GOT_LOAD_PC32, are the encoder's
# and a displacement refuses them stated.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;

use mink.catalog.arch;
use arch_x86:    mink.catalog.arch.x86;
use mink_format: mink.catalog.format;
use coff_kinds:  mink.format.coff.reloc.kinds;
use elf_kinds:   mink.format.elf.reloc.kinds;
use x86_kinds:   mink.format.elf.reloc.x86.kinds;
use macho_kinds: mink.format.macho.reloc.kinds;
use mink.model.reloc;

use masc.core.fixup;
use masc.core.operand;

pub val ABS8:     operand.FixupKind = 1;
pub val ABS16:    operand.FixupKind = 2;
pub val ABS32:    operand.FixupKind = 3;
pub val ABS32S:   operand.FixupKind = 4;
pub val ABS64:    operand.FixupKind = 5;
pub val PC8:      operand.FixupKind = 6;
pub val PC16:     operand.FixupKind = 7;
pub val PC32:     operand.FixupKind = 8;
pub val PC64:     operand.FixupKind = 9;
pub val BRANCH32: operand.FixupKind = 10;

pub val PLT:              operand.FixupKind = 11;
pub val GOTPCREL:         operand.FixupKind = 12;
pub val GOTPCRELX:        operand.FixupKind = 13;
pub val REX_GOTPCRELX:    operand.FixupKind = 14;
pub val CODE_4_GOTPCRELX: operand.FixupKind = 15;
pub val GOT:              operand.FixupKind = 16;
pub val GOT32X:           operand.FixupKind = 17;
pub val GOT64:            operand.FixupKind = 18;
pub val GOTOFF:           operand.FixupKind = 19;
pub val GOTOFF64:         operand.FixupKind = 20;
pub val PLTOFF64:         operand.FixupKind = 21;
pub val TPOFF:            operand.FixupKind = 22;
pub val TPOFF64:          operand.FixupKind = 23;
pub val NTPOFF:           operand.FixupKind = 24;
pub val DTPOFF:           operand.FixupKind = 25;
pub val DTPOFF64:         operand.FixupKind = 26;
pub val GOTTPOFF:         operand.FixupKind = 27;
pub val CODE_4_GOTTPOFF:  operand.FixupKind = 28;
pub val CODE_6_GOTTPOFF:  operand.FixupKind = 29;
pub val TLS_IE_32:        operand.FixupKind = 30;
pub val TLSGD:            operand.FixupKind = 31;
pub val TLS_GD:           operand.FixupKind = 32;
pub val TLSLD:            operand.FixupKind = 33;
pub val TLSLDM:           operand.FixupKind = 34;
pub val INDNTPOFF:        operand.FixupKind = 35;
pub val GOTNTPOFF:        operand.FixupKind = 36;
pub val TLSDESC:          operand.FixupKind = 37;
pub val CODE_4_TLSDESC:   operand.FixupKind = 38;
pub val TLS_GOTDESC:      operand.FixupKind = 39;
pub val TLSCALL:          operand.FixupKind = 40;
pub val GOT_PC32:         operand.FixupKind = 41;
pub val GOT_LOAD_PC32:    operand.FixupKind = 42;
pub val TLV_PC32:         operand.FixupKind = 43;
pub val SECREL32:         operand.FixupKind = 44;
pub val IMAGE32:          operand.FixupKind = 45;

# how many bindings BINDINGS holds
pub val COUNT: u32 = 51;

val ONLY_X86_64: [1]*arch.Arch = [1]*arch.Arch{?arch_x86.X86_64};
val ONLY_I386:   [1]*arch.Arch = [1]*arch.Arch{?arch_x86.X86};

val X86_64: fixup.Arches = fixup.Arches{at: ?ONLY_X86_64[0], len: 1};
val I386:   fixup.Arches = fixup.Arches{at: ?ONLY_I386[0], len: 1};

val ONLY_ELF: [1]*mink_format.Format = [1]*mink_format.Format{?mink_format.ELF};

# elf routes a branch through the plt only to a bare symbol, and one with an addend is pc-relative
val ELF_BRANCH: fixup.Added = fixup.Added{fixup: PC32, formats: fixup.Formats{at: ?ONLY_ELF[0], len: 1}};

# each kind and the neutral relocation it becomes, in ascending order of kind, a kind whose relocation differs by
# architecture once for each
pub val BINDINGS: [COUNT]fixup.Binding = [COUNT]fixup.Binding{
    fixup.Binding{fixup: ABS8, kind: ?reloc.ABS8, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ABS16, kind: ?reloc.ABS16, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ABS32, kind: ?reloc.ABS32, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ABS32S, kind: ?reloc.ABS32S, arches: X86_64},
    fixup.Binding{fixup: ABS64, kind: ?reloc.ABS64, arches: X86_64},
    fixup.Binding{fixup: PC8, kind: ?reloc.PC8, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: PC16, kind: ?reloc.PC16, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: PC32, kind: ?reloc.PC32, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: PC64, kind: ?reloc.PC64, arches: X86_64},
    fixup.Binding{fixup: BRANCH32, kind: ?reloc.BRANCH32, arches: fixup.EVERY_ARCH, added: ELF_BRANCH},
    fixup.Binding{fixup: PLT, kind: ?reloc.BRANCH32, arches: X86_64},
    fixup.Binding{fixup: PLT, kind: ?elf_kinds.PLT32, arches: I386},
    fixup.Binding{fixup: GOTPCREL, kind: ?elf_kinds.GOTPCREL32, arches: X86_64},
    fixup.Binding{fixup: GOTPCRELX, kind: ?x86_kinds.GOTPCREL32_RELAXABLE, arches: X86_64, refines: GOTPCREL},
    fixup.Binding{fixup: REX_GOTPCRELX, kind: ?x86_kinds.REX_GOTPCREL32_RELAXABLE, arches: X86_64, refines: GOTPCREL},
    fixup.Binding{fixup: CODE_4_GOTPCRELX, kind: ?x86_kinds.CODE_4_GOTPCREL32_RELAXABLE, arches: X86_64, refines: GOTPCREL},
    fixup.Binding{fixup: GOT, kind: ?x86_kinds.GOT32, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: GOT32X, kind: ?x86_kinds.GOT32_RELAXABLE, arches: I386, refines: GOT},
    fixup.Binding{fixup: GOT64, kind: ?x86_kinds.GOT64, arches: X86_64},
    fixup.Binding{fixup: GOTOFF, kind: ?x86_kinds.GOTOFF32, arches: I386},
    fixup.Binding{fixup: GOTOFF64, kind: ?x86_kinds.GOTOFF64, arches: X86_64},
    fixup.Binding{fixup: PLTOFF64, kind: ?x86_kinds.PLTOFF64, arches: X86_64},
    fixup.Binding{fixup: TPOFF, kind: ?x86_kinds.TPOFF32, arches: X86_64},
    fixup.Binding{fixup: TPOFF, kind: ?x86_kinds.TPOFF32_REV, arches: I386},
    fixup.Binding{fixup: TPOFF64, kind: ?elf_kinds.TPOFF64, arches: X86_64},
    fixup.Binding{fixup: NTPOFF, kind: ?x86_kinds.TPOFF32, arches: I386},
    fixup.Binding{fixup: DTPOFF, kind: ?x86_kinds.DTPOFF32, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: DTPOFF64, kind: ?elf_kinds.DTPOFF64, arches: X86_64},
    fixup.Binding{fixup: GOTTPOFF, kind: ?x86_kinds.GOTTPOFF32, arches: X86_64},
    fixup.Binding{fixup: GOTTPOFF, kind: ?x86_kinds.TLS_IE_32, arches: I386},
    fixup.Binding{fixup: CODE_4_GOTTPOFF, kind: ?x86_kinds.CODE_4_GOTTPOFF32, arches: X86_64, refines: GOTTPOFF},
    fixup.Binding{fixup: CODE_6_GOTTPOFF, kind: ?x86_kinds.CODE_6_GOTTPOFF32, arches: X86_64, refines: GOTTPOFF},
    fixup.Binding{fixup: TLS_IE_32, kind: ?x86_kinds.TLS_IE_32, arches: I386, refines: GOTTPOFF},
    fixup.Binding{fixup: TLSGD, kind: ?x86_kinds.TLSGD32, arches: X86_64},
    fixup.Binding{fixup: TLSGD, kind: ?x86_kinds.TLS_GD, arches: I386},
    fixup.Binding{fixup: TLS_GD, kind: ?x86_kinds.TLS_GD, arches: I386, refines: TLSGD},
    fixup.Binding{fixup: TLSLD, kind: ?x86_kinds.TLSLD32, arches: X86_64},
    fixup.Binding{fixup: TLSLDM, kind: ?x86_kinds.TLS_LDM, arches: I386},
    fixup.Binding{fixup: INDNTPOFF, kind: ?x86_kinds.TLS_IE, arches: I386},
    fixup.Binding{fixup: GOTNTPOFF, kind: ?x86_kinds.TLS_GOTIE, arches: I386},
    fixup.Binding{fixup: TLSDESC, kind: ?x86_kinds.GOTPC32_TLSDESC, arches: X86_64},
    fixup.Binding{fixup: TLSDESC, kind: ?x86_kinds.TLS_GOTDESC, arches: I386},
    fixup.Binding{fixup: CODE_4_TLSDESC, kind: ?x86_kinds.CODE_4_GOTPC32_TLSDESC, arches: X86_64, refines: TLSDESC},
    fixup.Binding{fixup: TLS_GOTDESC, kind: ?x86_kinds.TLS_GOTDESC, arches: I386, refines: TLSDESC},
    fixup.Binding{fixup: TLSCALL, kind: ?elf_kinds.TLSDESC_CALL, arches: X86_64},
    fixup.Binding{fixup: TLSCALL, kind: ?x86_kinds.TLS_DESC_CALL, arches: I386},
    fixup.Binding{fixup: GOT_PC32, kind: ?macho_kinds.GOT_PC32, arches: X86_64},
    fixup.Binding{fixup: GOT_LOAD_PC32, kind: ?macho_kinds.GOT_LOAD_PC32, arches: X86_64, refines: GOT_PC32},
    fixup.Binding{fixup: TLV_PC32, kind: ?macho_kinds.TLV_PC32, arches: X86_64},
    fixup.Binding{fixup: SECREL32, kind: ?coff_kinds.SECREL32, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: IMAGE32, kind: ?coff_kinds.IMAGE32, arches: fixup.EVERY_ARCH},
};

# the kind a displacement whose symbol states `fixup` is written as in a rip-relative address, in an absolute one and
# in the 64-bit absolute address of an a0 to a3 move, NO_FIXUP where the address takes no such relocation, as an
# absolute address takes no pc-relative kind
# ---
# fixup:    the stated kind
# relative: its kind in a rip-relative address
# absolute: its kind in a 32-bit absolute address
# wide:     its kind in a 64-bit absolute address
pub rec Placement {
    fixup:    operand.FixupKind;
    relative: operand.FixupKind;
    absolute: operand.FixupKind;
    wide:     operand.FixupKind;
}

# how many placements PLACEMENTS holds
pub val PLACEMENT_COUNT: u32 = 19;

# the placements of the 32-bit kinds a specifier states. x86_64's pc-relative kinds are rip-relative alone, i386's
# general dynamic, initial-exec and tlsdesc forms are its own absolute kinds, and a 64-bit address takes the 64-bit
# got, gotoff, tpoff and dtpoff kinds, as `movabs rax, [x@GOTOFF]`
pub val PLACEMENTS: [PLACEMENT_COUNT]Placement = [PLACEMENT_COUNT]Placement{
    Placement{fixup: PLT, relative: PLT, absolute: operand.NO_FIXUP, wide: operand.NO_FIXUP},
    Placement{fixup: GOTPCREL, relative: GOTPCREL, absolute: operand.NO_FIXUP, wide: operand.NO_FIXUP},
    Placement{fixup: GOT, relative: operand.NO_FIXUP, absolute: GOT, wide: GOT64},
    Placement{fixup: GOTOFF, relative: operand.NO_FIXUP, absolute: GOTOFF, wide: GOTOFF64},
    Placement{fixup: TPOFF, relative: operand.NO_FIXUP, absolute: TPOFF, wide: TPOFF64},
    Placement{fixup: NTPOFF, relative: operand.NO_FIXUP, absolute: NTPOFF, wide: operand.NO_FIXUP},
    Placement{fixup: DTPOFF, relative: operand.NO_FIXUP, absolute: DTPOFF, wide: DTPOFF64},
    Placement{fixup: GOTTPOFF, relative: GOTTPOFF, absolute: TLS_IE_32, wide: operand.NO_FIXUP},
    Placement{fixup: TLSGD, relative: TLSGD, absolute: TLS_GD, wide: operand.NO_FIXUP},
    Placement{fixup: TLSLD, relative: TLSLD, absolute: operand.NO_FIXUP, wide: operand.NO_FIXUP},
    Placement{fixup: TLSLDM, relative: operand.NO_FIXUP, absolute: TLSLDM, wide: operand.NO_FIXUP},
    Placement{fixup: INDNTPOFF, relative: operand.NO_FIXUP, absolute: INDNTPOFF, wide: operand.NO_FIXUP},
    Placement{fixup: GOTNTPOFF, relative: operand.NO_FIXUP, absolute: GOTNTPOFF, wide: operand.NO_FIXUP},
    Placement{fixup: TLSDESC, relative: TLSDESC, absolute: TLS_GOTDESC, wide: operand.NO_FIXUP},
    Placement{fixup: TLSCALL, relative: operand.NO_FIXUP, absolute: TLSCALL, wide: operand.NO_FIXUP},
    Placement{fixup: GOT_PC32, relative: GOT_PC32, absolute: operand.NO_FIXUP, wide: operand.NO_FIXUP},
    Placement{fixup: TLV_PC32, relative: TLV_PC32, absolute: operand.NO_FIXUP, wide: operand.NO_FIXUP},
    Placement{fixup: SECREL32, relative: operand.NO_FIXUP, absolute: SECREL32, wide: operand.NO_FIXUP},
    Placement{fixup: IMAGE32, relative: operand.NO_FIXUP, absolute: IMAGE32, wide: operand.NO_FIXUP},
};

# the placement of stated kind `fixup`, none for a kind no specifier states in a displacement
pub fun placement(fixup: operand.FixupKind) opt[*Placement] {
    var i: u32 = 0;
    for (i < PLACEMENT_COUNT) {
        if (PLACEMENTS[i].fixup == fixup) { ret opt[*Placement].some{?PLACEMENTS[i]}; }
        i = i + 1;
    }
    ret opt[*Placement].none{};
}

# the kind of each datum basis and width the builder relocates
pub val DATA: [8]fixup.Datum = [8]fixup.Datum{
    fixup.Datum{basis: fixup.ABSOLUTE, width: 1, fixup: ABS8},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 2, fixup: ABS16},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 4, fixup: ABS32},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 8, fixup: ABS64},
    fixup.Datum{basis: fixup.RELATIVE, width: 1, fixup: PC8},
    fixup.Datum{basis: fixup.RELATIVE, width: 2, fixup: PC16},
    fixup.Datum{basis: fixup.RELATIVE, width: 4, fixup: PC32},
    fixup.Datum{basis: fixup.RELATIVE, width: 8, fixup: PC64},
};

pub val DATA_COUNT: u32 = 8;

# the absolute kind of a field of `bits` bits, its 32-bit kind sign-extended when `extended`
pub fun absolute(bits: u8, extended: bool) operand.FixupKind {
    if (bits == 8)  { ret ABS8; }
    if (bits == 16) { ret ABS16; }
    if (bits == 64) { ret ABS64; }
    if (extended)   { ret ABS32S; }
    ret ABS32;
}

# the pc-relative kind of a field of `bits` bits
pub fun relative(bits: u8) operand.FixupKind {
    if (bits == 8)  { ret PC8; }
    if (bits == 16) { ret PC16; }
    if (bits == 64) { ret PC64; }
    ret PC32;
}

# whether `fixup` is a kind the encoder writes in place of a stated one (`fixup.Binding.refines`)
pub fun refinement(fixup: operand.FixupKind) bool {
    var i: u32 = 0;
    for (i < COUNT) {
        if (BINDINGS[i].fixup == fixup) { ret BINDINGS[i].refines != operand.NO_FIXUP; }
        i = i + 1;
    }
    ret false;
}
