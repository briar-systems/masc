# the x86 fixup kinds and their binding to mink's relocation kinds
#
# a symbolic immediate, relative target, displacement or address takes one of
# these kinds by the width of its field and what it is measured from. a
# 32-bit field that 64-bit code sign-extends, as a displacement under 64-bit
# addressing or the immediate of an instruction of 64-bit operand size, is
# ABS32S, which only x86_64's formats relocate (R_X86_64_32S), and the 64-bit
# kinds are x86_64's alone as well: i386's formats have no 64-bit relocation.
# a branch's 32-bit displacement is BRANCH32, which a format may route through
# a stub, as R_X86_64_PLT32, where a rip-relative address stays PC32.
# a displacement takes the kind of the address it is in, which the ModRM kind
# chooses (masc.isa.x86.field), and a symbol may state another.

use std.types.bool.bool;

use mink.catalog.arch;
use arch_x86: mink.catalog.arch.x86;
use mink.model.reloc;

use masc.core.fixup;
use masc.core.operand;

pub val ABS8:     operand.FixupKind = 1;
pub val ABS16:    operand.FixupKind = 2;
pub val ABS32:    operand.FixupKind = 3;
pub val ABS32S:   operand.FixupKind = 4;
pub val ABS64:    operand.FixupKind = 5;
pub val PC8:      operand.FixupKind = 6;
pub val PC16:     operand.FixupKind = 7;
pub val PC32:     operand.FixupKind = 8;
pub val PC64:     operand.FixupKind = 9;
pub val BRANCH32: operand.FixupKind = 10;

pub val COUNT: u32 = 10;

val ONLY_X86_64: [1]*arch.Arch = [1]*arch.Arch{?arch_x86.X86_64};

val X86_64: fixup.Arches = fixup.Arches{at: ?ONLY_X86_64[0], len: 1};

# each kind and the neutral relocation it becomes, in ascending order of kind
pub val BINDINGS: [10]fixup.Binding = [10]fixup.Binding{
    fixup.Binding{fixup: ABS8, kind: ?reloc.ABS8, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ABS16, kind: ?reloc.ABS16, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ABS32, kind: ?reloc.ABS32, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ABS32S, kind: ?reloc.ABS32S, arches: X86_64},
    fixup.Binding{fixup: ABS64, kind: ?reloc.ABS64, arches: X86_64},
    fixup.Binding{fixup: PC8, kind: ?reloc.PC8, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: PC16, kind: ?reloc.PC16, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: PC32, kind: ?reloc.PC32, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: PC64, kind: ?reloc.PC64, arches: X86_64},
    fixup.Binding{fixup: BRANCH32, kind: ?reloc.BRANCH32, arches: fixup.EVERY_ARCH},
};

# the kind of each datum basis and width the builder relocates
pub val DATA: [8]fixup.Datum = [8]fixup.Datum{
    fixup.Datum{basis: fixup.ABSOLUTE, width: 1, fixup: ABS8},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 2, fixup: ABS16},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 4, fixup: ABS32},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 8, fixup: ABS64},
    fixup.Datum{basis: fixup.RELATIVE, width: 1, fixup: PC8},
    fixup.Datum{basis: fixup.RELATIVE, width: 2, fixup: PC16},
    fixup.Datum{basis: fixup.RELATIVE, width: 4, fixup: PC32},
    fixup.Datum{basis: fixup.RELATIVE, width: 8, fixup: PC64},
};

pub val DATA_COUNT: u32 = 8;

# the absolute kind of a field of `bits` bits, its 32-bit kind sign-extended when `extended`
pub fun absolute(bits: u8, extended: bool) operand.FixupKind {
    if (bits == 8)  { ret ABS8; }
    if (bits == 16) { ret ABS16; }
    if (bits == 64) { ret ABS64; }
    if (extended)   { ret ABS32S; }
    ret ABS32;
}

# the pc-relative kind of a field of `bits` bits
pub fun relative(bits: u8) operand.FixupKind {
    if (bits == 8)  { ret PC8; }
    if (bits == 16) { ret PC16; }
    if (bits == 64) { ret PC64; }
    ret PC32;
}
