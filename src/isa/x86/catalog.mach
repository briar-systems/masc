# the x86 catalog
#
# the rows, their codec, decode dispatch and syntax are generated from XED by gen's xed generator (gen_row,
# gen_dispatch, gen_key, gen_syntax), the field kinds are masc.isa.x86.field, the fixup bindings masc.isa.x86.fixup,
# and the extension catalog and register file their own modules. code is filled with the one-byte nop, 0x90 (Intel
# SDM 325462-093US Vol 2B NOP), which every width admits. the tests walk the shipped rows: every row encodes and
# decodes back to itself under each alternative of its requirement, so at every width it is one at.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator.testing;
use std.collections.vector;
#[testing]
use std.print;

use masc.codec.walk;
use masc.core.diagnostic;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.fill;
use masc.core.inst;
use masc.core.operand;
use masc.core.register;
use masc.core.requirement;
use masc.core.row;
use masc.core.state;

#[testing]
use masc.core.form;
use x86_extension: masc.isa.x86.extension;
#[testing]
use x86_field:     masc.isa.x86.field;
#[testing]
use x86_form:      masc.isa.x86.form;
#[testing]
use x86_opcode:    masc.isa.x86.opcode;
use x86_register:  masc.isa.x86.register;

fwd masc.isa.x86.gen_row.CODEC;
fwd masc.isa.x86.fixup.BINDINGS;

use masc.isa.x86.gen_row;

val NOP: [1]u8 = [1]u8{0x90};

val FILL_PATTERNS: [1]fill.Pattern = [1]fill.Pattern{fill.Pattern{bytes: ?NOP[0], len: 1, requires: requirement.NO_ALTERNATIVES}};

# the code fill: the one-byte nop at every width, where an instruction starts at any byte
pub val FILL: fill.Fill = fill.Fill{patterns: ?FILL_PATTERNS[0], count: 1, order: fill.LONGEST_FIRST, unit: 1};

# a test's selection of one row's extensions and width, its register view, its context and output buffers
#[testing]
rec T {
    t:      testing.Testing;
    s:      extension.Selection;
    v:      register.Available;
    ctx:    state.Context;
    out:    vector.Vector[u8];
    fixups: vector.Vector[field.Fixup];
}

# the extensions a walk selects beyond its row's alternative, as the registers a row names or touches need, mmx's of
# cvtps2pi's mm or x87's of fxsave's control words
#[testing]
rec Extra {
    ids: [8]requirement.Id;
    len: u32;
}

# whether the extensions of the first alternative of `req` add one to `x`, the width it names being the walk's own
#[testing]
fun t_needs(x: *Extra, req: requirement.Requirement) bool {
    if (req.len == 0) { ret false; }
    val all:   requirement.Ids = req.at[0].all;
    var added: bool            = false;
    var i:     u32             = 0;
    for (i < all.len) {
        val id:   requirement.Id = all.at[i];
        var seen: bool           = id >= x86_extension.CATALOG.count;
        var k:    u32            = 0;
        for (k < x.len) {
            if (x.ids[k] == id) { seen = true; }
            k = k + 1;
        }
        if (!seen && x.len < 8) {
            x.ids[x.len] = id;
            x.len        = x.len + 1;
            added        = true;
        }
        i = i + 1;
    }
    ret added;
}

# a test over alternative `k` of `r`'s requirement, which names one of the row's widths, and the extensions of `x`
#[testing]
fun t_make_for(t: *T, r: *row.Row, k: u32, x: *Extra) bool {
    testing.make(?t.t);
    val made: res[extension.Request, extension.Error] = extension.request(testing.allocator_of(?t.t), ?x86_extension.CATALOG, "", diagnostic.START);
    if (sel made.err) { ret false; }
    var req: extension.Request = made.ok;
    if (k < r.requires.len) {
        val alt: requirement.Ids = r.requires.at[k].all;
        var i:   u32             = 0;
        for (i < alt.len) {
            extension.request_add(?req, alt.at[i]);
            i = i + 1;
        }
    }
    var e: u32 = 0;
    for (e < x.len) {
        extension.request_add(?req, x.ids[e]);
        e = e + 1;
    }
    val closed: res[extension.Selection, extension.Error] = extension.close(req);
    if (sel closed.err) { ret false; }
    t.s = closed.ok;
    val opened: res[state.Context, state.Opened] = state.open(testing.allocator_of(?t.t), ?x86_register.FILE, ?t.s, ?x86_extension.AXES, state.initial(?x86_extension.AXES), ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx    = opened.ok;
    t.out    = vector.init[u8](testing.allocator_of(?t.t));
    t.fixups = vector.init[field.Fixup](testing.allocator_of(?t.t));
    ret true;
}

#[testing]
fun t_encode(t: *T, r: u32, values: *operand.Value, count: u32) res[usize, field.Refusal] {
    var ins: inst.Inst = inst.Inst{row: ?CODEC.rows.at[r], values: values, count: count, form: form.PREFERRED};
    # a row that gives way to a twin is asked for by its space's name: an evex row that gives way to a vex or legacy
    # twin, and a vex row that gives way to an evex one
    val op: *x86_opcode.Opcode = x86_field.opcode_of(?CODEC.rows.at[r].encoding.at[0]);
    if (op.twin != 0 && op.space == x86_opcode.EVEX) { ins.form = form.Form{bits: x86_form.EVEX}; }
    if (op.twin != 0 && op.space == x86_opcode.VEX)  { ins.form = form.Form{bits: x86_form.VEX}; }
    ret walk.encode(?CODEC, ?t.ctx, ?ins, ?t.out, ?t.fixups);
}

# the largest value `imm` holds less `k`, as its sign reads it
#[testing]
fun t_immediate(imm: *operand.Immediate, k: u32) i64 {
    var top: i64 = field.ones(imm.bits)::i64;
    if (imm.sign == operand.SIGNED) { top = (1::i64 << (imm.bits - 1)::i64) - 1; }
    ret top - k::i64;
}

# register `k` of class `class` of `r` from the bottom, so the legacy registers come first
#[testing]
fun t_register(r: *operand.Register, k: u32) opt[operand.Value] {
    var left: u32 = k;
    var c:    u32 = 0;
    for (c < r.classes.len) {
        val class: u16 = r.classes.at[c];
        val count: u32 = register.count_most(?x86_register.FILE, class)::u32;
        val span:  u32 = operand.span(r, count);
        if (left < span) { ret opt[operand.Value].some{operand.Value.register{register.make(class, (r.first + left)::u16)}}; }
        left = left - span;
        c    = c + 1;
    }
    ret opt[operand.Value].none{};
}

# a memory value at try `k`: a displacement alone, then a base and a displacement, each base in turn, then an index
# alone, each index in turn, as a vector index needs. a memory operand of no displacement bits, a string's, takes none
#[testing]
fun t_memory(m: *operand.Memory, k: u32) opt[operand.Value] {
    var a: operand.Address = operand.Address{base: register.NONE, index: register.NONE, scale: 0, disp: 0x10, segment: register.NONE, mode: operand.OFFSET, symbol: operand.Symbol{id: operand.NO_SYMBOL, addend: 0, fixup: operand.NO_FIXUP}, extend: 0, broadcast: 0};
    if (m.disp.bits == 0) { a.disp = 0; }
    if (k == 0)           { ret opt[operand.Value].some{operand.Value.memory{a}}; }
    var left: u32 = k - 1;
    if (m.base.classes.len > 0) {
        val base: opt[operand.Value] = t_register(?m.base, left);
        if (sel base.some) {
            val v: operand.Value = base.some;
            if (!sel v.register) { ret opt[operand.Value].none{}; }
            a.base = v.register;
            ret opt[operand.Value].some{operand.Value.memory{a}};
        }
        left = left - t_count(?m.base);
    }
    if (m.index.classes.len == 0) { ret opt[operand.Value].none{}; }
    val index: opt[operand.Value] = t_register(?m.index, left);
    if (sel index.none) { ret opt[operand.Value].none{}; }
    val x: operand.Value = index.some;
    if (!sel x.register) { ret opt[operand.Value].none{}; }
    a.index = x.register;
    ret opt[operand.Value].some{operand.Value.memory{a}};
}

# how many registers `r` admits over its classes, as t_register counts them
#[testing]
fun t_count(r: *operand.Register) u32 {
    var n: u32 = 0;
    var c: u32 = 0;
    for (c < r.classes.len) {
        n = n + operand.span(r, register.count_most(?x86_register.FILE, r.classes.at[c])::u32);
        c = c + 1;
    }
    ret n;
}

# the value of operand `desc` at try `k`: an optional operand's absence first, then its values
#[testing]
fun t_value(desc: *operand.Operand, k: u32) opt[operand.Value] {
    val shape: *operand.Shape = ?desc.shape;
    var n:     u32            = k;
    if (desc.quantity == operand.OPTIONAL) {
        if (k == 0) { ret opt[operand.Value].some{operand.Value.none{}}; }
        n = k - 1;
    }
    if (sel shape.enumerant) {
        if (shape.enumerant.mask && n == 0) { ret opt[operand.Value].some{operand.enumerant(0)}; }
        if (shape.enumerant.mask)           { n = n - 1; }
        if (n >= shape.enumerant.count)     { ret opt[operand.Value].none{}; }
        ret opt[operand.Value].some{operand.enumerant(shape.enumerant.members[n].value)};
    }
    if (sel shape.register)  { ret t_register(?shape.register, n); }
    if (sel shape.immediate) { ret opt[operand.Value].some{operand.Value.immediate{t_immediate(?shape.immediate, n)}}; }
    if (sel shape.relative)  { ret opt[operand.Value].some{operand.Value.relative{t_immediate(?shape.relative.offset, n)}}; }
    if (sel shape.memory)    { ret t_memory(?shape.memory, n); }
    ret opt[operand.Value].none{};
}

# row `i` encoded into `t.out` with values it admits, found from each operand's first value by taking a refused
# operand's next value until every operand is admitted, 0 on success and the step that failed otherwise
#[testing]
fun t_admitted(t: *T, i: u32, values: *operand.Value, x: *Extra) i32 {
    val r:     *row.Row = ?CODEC.rows.at[i];
    var tries: [row.MAX_OPERANDS]u32;
    var k:     u32      = 0;
    for (k < r.operands.len) {
        tries[k] = 0;
        val fixed: opt[register.Id] = effect.fixed(CODEC.registers, r.effect, k::u8);
        if (sel fixed.some) { values[k] = operand.Value.register{fixed.some}; }
        or {
            val first: opt[operand.Value] = t_value(?r.operands.at[k], 0);
            if (sel first.none) { ret 2; }
            values[k] = first.some;
        }
        k = k + 1;
    }
    var wrote: res[usize, field.Refusal] = t_encode(t, i, values, r.operands.len);
    var left:  u32                       = 4096;
    for (sel wrote.err && left > 0) {
        var op:  u8  = field.NO_OPERAND;
        var why: str = nil;
        if (sel wrote.err) {
            op  = wrote.err.operand;
            why = wrote.err.message;
            val cause: field.Cause = wrote.err.cause;
            if (sel cause.unavailable) {
                if (t_needs(x, wrote.err.requires)) { ret 11; }
            }
        }
        if (op == field.NO_OPERAND || op::u32 >= r.operands.len) {
            print.eprintlnf("  {}", why);
            ret 3;
        }
        tries[op] = tries[op] + 1;
        val next: opt[operand.Value] = t_value(?r.operands.at[op], tries[op]);
        if (sel next.none) {
            print.eprintlnf("  {} {}", why, op);
            ret 4;
        }
        values[op] = next.some;
        t.out.len  = 0;
        wrote      = t_encode(t, i, values, r.operands.len);
        left       = left - 1;
    }
    if (sel wrote.err) {
        print.eprintlnf("  {}", wrote.err.message);
        ret 5;
    }
    ret 0;
}

# row `i` encoded and decoded back under alternative `alt` of its requirement, 0 when it is itself and the step that
# failed otherwise
#[testing]
fun t_walk(i: u32, alt: u32) i32 {
    val r: *row.Row = ?CODEC.rows.at[i];
    var t: T;
    var x: Extra;
    x.len = 0;
    var values:  [row.MAX_OPERANDS]operand.Value;
    var written: i32 = 11;
    var rounds:  u32 = 0;
    for (written == 11 && rounds < 4) {
        if (!t_make_for(?t, r, alt, ?x)) { ret 1; }
        written = t_admitted(?t, i, ?values[0], ?x);
        rounds  = rounds + 1;
    }
    if (written != 0) { ret written; }
    var store: [32]operand.Value;
    var room:  [8]requirement.Alternative;
    var alts:  field.Admissions                 = field.Admissions{at: ?room[0], cap: 8, used: 0};
    val got:   res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.ctx, t.out.data, t.out.len, 0, ?store[0], 32, ?alts);
    if (sel got.err) {
        print.eprintlnf("  {}", got.err.message);
        ret 6;
    }
    if (got.ok.inst.row != r) {
        print.eprintlnf("  {}", got.ok.inst.row.key);
        ret 7;
    }
    if (got.ok.len != t.out.len) { ret 8; }
    var k: u32 = 0;
    for (k < r.operands.len) {
        if (!operand.equal(?store[k], ?values[k])) { ret 9; }
        k = k + 1;
    }
    ret 0;
}

test walk__every_row_encodes_and_decodes_back_to_itself_at_every_width {
    var failed: u32 = 0;
    var i:      u32 = 0;
    for (i < CODEC.rows.len) {
        val r:   *row.Row = ?CODEC.rows.at[i];
        var alt: u32      = 0;
        for (alt < r.requires.len) {
            val step: i32 = t_walk(i, alt);
            if (step != 0) {
                print.eprintlnf("{} alternative {}: step {}", r.key, alt, step);
                failed = failed + 1;
            }
            alt = alt + 1;
        }
        i = i + 1;
    }
    if (failed != 0) { ret 1; }
    ret 0;
}
