# the x86 catalog
#
# the rows, their codec, decode dispatch and syntax are generated from XED by gen's xed generator (gen_row,
# gen_dispatch, gen_key, gen_syntax), the field kinds are masc.isa.x86.field, the fixup bindings masc.isa.x86.fixup,
# and the extension catalog and register file their own modules. code is filled with the one-byte nop, 0x90 (Intel
# SDM 325462-093US Vol 2B NOP), which every width admits. the tests walk the shipped rows: every row encodes and
# decodes back to itself under each alternative of its requirement, so at every width it is one at.

use masc.core.fill;
use masc.core.requirement;

use x86_extension: masc.isa.x86.extension;

fwd masc.isa.x86.gen_row.CODEC;
fwd masc.isa.x86.fixup.BINDINGS;

use masc.isa.x86.gen_row;

# the nops of each length, intel's of 1 to 9 bytes (Intel SDM 325462-093US Vol 2B NOP, Table 4-12) and llvm's of 10 to
# 15, which write 66 before the 10-byte one (llvm-project 7ddb67460b168b17ebb263dc99bf956b56d7e517
# llvm/lib/Target/X86/MCTargetDesc/X86AsmBackend.cpp, writeNopData)
val NOP_15: [15]u8 = [15]u8{0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x2E, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00};
val NOP_14: [14]u8 = [14]u8{0x66, 0x66, 0x66, 0x66, 0x66, 0x2E, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00};
val NOP_13: [13]u8 = [13]u8{0x66, 0x66, 0x66, 0x66, 0x2E, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00};
val NOP_12: [12]u8 = [12]u8{0x66, 0x66, 0x66, 0x2E, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00};
val NOP_11: [11]u8 = [11]u8{0x66, 0x66, 0x2E, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00};
val NOP_10: [10]u8 = [10]u8{0x66, 0x2E, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00};
val NOP_9:  [9]u8  = [9]u8{0x66, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00};
val NOP_8:  [8]u8  = [8]u8{0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00};
val NOP_7:  [7]u8  = [7]u8{0x0F, 0x1F, 0x80, 0x00, 0x00, 0x00, 0x00};
val NOP_6:  [6]u8  = [6]u8{0x66, 0x0F, 0x1F, 0x44, 0x00, 0x00};
val NOP_5:  [5]u8  = [5]u8{0x0F, 0x1F, 0x44, 0x00, 0x00};
val NOP_4:  [4]u8  = [4]u8{0x0F, 0x1F, 0x40, 0x00};
val NOP_3:  [3]u8  = [3]u8{0x0F, 0x1F, 0x00};
val NOP_2:  [2]u8  = [2]u8{0x66, 0x90};
val NOP_1:  [1]u8  = [1]u8{0x90};

val NOT_16: [1]requirement.Id = [1]requirement.Id{x86_extension.id.WIDTH_16};

# outside 16-bit code, whose 16-bit addressing reads the modrm of the nops of 5 bytes and more as a shorter address
val ADDRESSED: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.NO_IDS, none: requirement.Ids{at: ?NOT_16[0], len: 1}}};

val FILL_PATTERNS: [15]fill.Pattern = [15]fill.Pattern{
    fill.Pattern{bytes: ?NOP_15[0], len: 15, requires: requirement.Requirement{at: ?ADDRESSED[0], len: 1}},
    fill.Pattern{bytes: ?NOP_14[0], len: 14, requires: requirement.Requirement{at: ?ADDRESSED[0], len: 1}},
    fill.Pattern{bytes: ?NOP_13[0], len: 13, requires: requirement.Requirement{at: ?ADDRESSED[0], len: 1}},
    fill.Pattern{bytes: ?NOP_12[0], len: 12, requires: requirement.Requirement{at: ?ADDRESSED[0], len: 1}},
    fill.Pattern{bytes: ?NOP_11[0], len: 11, requires: requirement.Requirement{at: ?ADDRESSED[0], len: 1}},
    fill.Pattern{bytes: ?NOP_10[0], len: 10, requires: requirement.Requirement{at: ?ADDRESSED[0], len: 1}},
    fill.Pattern{bytes: ?NOP_9[0], len: 9, requires: requirement.Requirement{at: ?ADDRESSED[0], len: 1}},
    fill.Pattern{bytes: ?NOP_8[0], len: 8, requires: requirement.Requirement{at: ?ADDRESSED[0], len: 1}},
    fill.Pattern{bytes: ?NOP_7[0], len: 7, requires: requirement.Requirement{at: ?ADDRESSED[0], len: 1}},
    fill.Pattern{bytes: ?NOP_6[0], len: 6, requires: requirement.Requirement{at: ?ADDRESSED[0], len: 1}},
    fill.Pattern{bytes: ?NOP_5[0], len: 5, requires: requirement.Requirement{at: ?ADDRESSED[0], len: 1}},
    fill.Pattern{bytes: ?NOP_4[0], len: 4, requires: requirement.NO_ALTERNATIVES},
    fill.Pattern{bytes: ?NOP_3[0], len: 3, requires: requirement.NO_ALTERNATIVES},
    fill.Pattern{bytes: ?NOP_2[0], len: 2, requires: requirement.NO_ALTERNATIVES},
    fill.Pattern{bytes: ?NOP_1[0], len: 1, requires: requirement.NO_ALTERNATIVES},
};

# the code fill: the longest nop that fits, where an instruction starts at any byte
pub val FILL: fill.Fill = fill.Fill{patterns: ?FILL_PATTERNS[0], count: 15, order: fill.LONGEST_FIRST, unit: 1};
