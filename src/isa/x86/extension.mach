    index.Entry{key: "sce", row: SCE},
    index.Entry{key: "sep", row: SEP},
    index.Entry{key: "serialize", row: SERIALIZE},
    index.Entry{key: "sgx", row: SGX},
    index.Entry{key: "sha", row: SHA},
    index.Entry{key: "sha512", row: SHA512},
    index.Entry{key: "sm3", row: SM3},
    index.Entry{key: "sm4", row: SM4},
    index.Entry{key: "smap", row: SMAP},
    index.Entry{key: "smx", row: SMX},
    index.Entry{key: "snp", row: SNP},
    index.Entry{key: "sse", row: SSE},
    index.Entry{key: "sse2", row: SSE2},
    index.Entry{key: "sse3", row: SSE3},
    index.Entry{key: "sse41", row: SSE41},
    index.Entry{key: "sse42", row: SSE42},
    index.Entry{key: "sse4a", row: SSE4A},
    index.Entry{key: "ssse3", row: SSSE3},
    index.Entry{key: "svm", row: SVM},
    index.Entry{key: "tbm", row: TBM},
    index.Entry{key: "tdx", row: TDX},
    index.Entry{key: "tsx_ldtrk", row: TSX_LDTRK},
    index.Entry{key: "uintr", row: UINTR},
    index.Entry{key: "user_msr", row: USER_MSR},
    index.Entry{key: "vaes", row: VAES},
    index.Entry{key: "via_padlock_aes", row: VIA_PADLOCK_AES},
    index.Entry{key: "via_padlock_pmm", row: VIA_PADLOCK_PMM},
    index.Entry{key: "via_padlock_rng", row: VIA_PADLOCK_RNG},
    index.Entry{key: "via_padlock_sha", row: VIA_PADLOCK_SHA},
    index.Entry{key: "vmfunc", row: VMFUNC},
    index.Entry{key: "vmx", row: VMX},
    index.Entry{key: "vpclmulqdq", row: VPCLMULQDQ},
    index.Entry{key: "waitpkg", row: WAITPKG},
    index.Entry{key: "wbnoinvd", row: WBNOINVD},
    index.Entry{key: "wrmsrns", row: WRMSRNS},
    index.Entry{key: "x86-64-v2", row: COUNT + 0},
    index.Entry{key: "x86-64-v3", row: COUNT + 1},
    index.Entry{key: "x86-64-v4", row: COUNT + 2},
    index.Entry{key: "x87", row: X87},
    index.Entry{key: "xop", row: XOP},
    index.Entry{key: "xsave", row: XSAVE},
    index.Entry{key: "xsavec", row: XSAVEC},
    index.Entry{key: "xsaveopt", row: XSAVEOPT},
    index.Entry{key: "xsaves", row: XSAVES},
};

# the x86 catalog: its extensions, levels and combinations, selected as `name,name,...`
pub val CATALOG: extension.Catalog = extension.Catalog{
    extensions:        ?ROWS[0],
    count:             COUNT,
    levels:            ?LEVELS[0],
    level_count:       LEVEL_COUNT,
    names:             index.Index{at: ?NAMES[0], len: 145},
    conflicts:         nil,
    conflict_count:    0,
    combinations:      ?COMBINATIONS[0],
    combination_count: 1,
    syntax:            ?extension.LIST,
};

# the selection `spelling` makes in the x86 catalog, into `out`
#[testing]
fun t_select(a: *alloc.Allocator, spelling: str, out: *extension.Selection) bool {
    val made: res[extension.Selection, extension.Error] = extension.select(a, ?CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    @out = made.ok;
    ret true;
}

# whether the selection holds every row of `want` and no other
#[testing]
fun t_exactly(s: *extension.Selection, want: *requirement.Id, len: usize) bool {
    var held: usize = 0;
    var i:    u32   = 0;
    for (i < COUNT) {
        if (extension.has(s, i)) { held = held + 1; }
        i = i + 1;
    }
    if (held != len) { ret false; }
    var j: usize = 0;
    for (j < len) {
        if (!extension.has(s, want[j])) { ret false; }
        j = j + 1;
    }
    ret true;
}

# the members the psABI lists for x86-64-v3, its baseline and v2 included
#[testing]
val T_V3: [26]requirement.Id = [26]requirement.Id{
    CMOV, CX8, X87, FXSR, OSFXSR, MMX, SCE, SSE, SSE2,
    CX16, LAHF, POPCNT, SSE3, SSSE3, SSE41, SSE42,
    AVX, AVX2, BMI1, BMI2, F16C, FMA, LZCNT, MOVBE, XSAVE, OSXSAVE,
};

test select__x86_64_v3_closes_to_the_members_the_psabi_states {
    var t: testing.Testing;
    testing.make(?t);
    var v2: extension.Selection;
    var v3: extension.Selection;
    var v4: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "x86-64-v2", ?v2))                                    { ret 1; }
    if (!t_select(testing.allocator_of(?t), "x86-64-v3", ?v3))                                    { ret 2; }
    if (!t_select(testing.allocator_of(?t), "x86-64-v4", ?v4))                                    { ret 3; }
    if (!t_exactly(?v3, ?T_V3[0], 26))                                                            { ret 4; }
    if (!extension.within(?v2, ?v3) || !extension.within(?v3, ?v4) || extension.within(?v3, ?v2)) { ret 5; }
    if (extension.has(?v3, AVX512F) || !extension.has(?v4, AVX512VL) || !extension.has(?v4, FMA)) { ret 6; }
    extension.release(?v2);
    extension.release(?v3);
    extension.release(?v4);
    if (testing.live_count(?t) != 0) { ret 7; }
    ret 0;
}

test select__an_avx10_version_implies_its_predecessors_and_the_families_it_includes {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "avx10_2", ?s))                                             { ret 1; }
    if (!extension.has(?s, AVX10_1) || !extension.has(?s, AVX512BW) || !extension.has(?s, AVX512_FP16)) { ret 2; }
    if (!extension.has(?s, AVX2) || !extension.has(?s, SSE42) || !extension.has(?s, FMA))               { ret 3; }
    if (extension.has(?s, VAES) || extension.has(?s, GFNI) || extension.has(?s, VPCLMULQDQ))            { ret 4; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "avx10_1", ?s) || extension.has(?s, AVX10_2)) { ret 5; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "avx10_vnni_int", ?s))                                  { ret 6; }
    if (!extension.has(?s, AVX10_2) || !extension.has(?s, AVX10_1) || !extension.has(?s, AVX512VL)) { ret 7; }
    extension.release(?s);
    ret 0;
}

# the width is no extension, so a selection names none and the old mode rows are unknown names
test select__apx_brings_what_its_specification_states_and_no_width_is_an_extension {
    var t: testing.Testing;
    testing.make(?t);
    val modes:   res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?CATALOG, "x86-64", diagnostic.START);
    var refused: bool                                      = false;
    if (sel modes.err) {
        val e: extension.Error = modes.err;
        refused = sel e.refused;
    }
    if (!refused)                                                                                       { ret 1; }
    if (state.atom(?CATALOG, ?AXES, 0, 2) != WIDTH_64 || state.atom(?CATALOG, ?AXES, 1, 1) != DOITM_ON) { ret 2; }
    if (state.atom_count(?CATALOG, ?AXES) != DOITM_ON + 1)                                              { ret 3; }
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "apx_f", ?s))                                              { ret 4; }
    if (!extension.has(?s, OSXSAVE) || !extension.has(?s, APX_NCI_NDD_NF) || !extension.has(?s, CMOV)) { ret 5; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "apx_nci_ndd_nf", ?s) || extension.has(?s, CMOV)) { ret 6; }
    extension.release(?s);
    if (testing.live_count(?t) != 0) { ret 7; }
    ret 0;
}

test catalog__every_row_and_level_is_named_once_in_order_and_names_rows_of_the_catalog {
    if (CATALOG.names.len != COUNT + LEVEL_COUNT) { ret 1; }
    var i: u32 = 0;
    for (i < CATALOG.names.len) {
        val key: str = CATALOG.names.at[i].key;
        val row: u32 = CATALOG.names.at[i].row;
        var own: str = "";
        if (row < COUNT)                                                 { own = ROWS[row].name; }
        or                                                               { own = LEVELS[row - COUNT].name; }
        if (!str_equals(key, own))                                       { ret 2; }
        if (i > 0 && str_compare(CATALOG.names.at[i - 1].key, key) >= 0) { ret 3; }
        i = i + 1;
    }
    i = 0;
    for (i < COUNT) {
        var j: u32 = 0;
        for (j < ROWS[i].implies.len) {
            if (ROWS[i].implies.at[j] >= COUNT) { ret 4; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < LEVEL_COUNT) {
        var j: u32 = 0;
        for (j < LEVELS[i].members.len) {
            if (LEVELS[i].members.at[j] >= COUNT) { ret 5; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}
