# the x86 extensions the register file requires
#
# the ids and rows below are the ones src/isa/x86/register.mach names. the rest of the x86 catalog (every XED isa set, the
# psABI levels, the avx10 versions) is the work of masc-19, which keeps these names and takes over this file. a row states
# only an implication that holds whatever else the catalog holds: avx-512 foundation needs avx, which needs sse (Intel SDM
# 325462-093US, Vol. 1, 14.1 and 15.1), and apx and amx exist in 64-bit mode only (Intel APX Architecture Specification
# 355828-009US, 3.1.2.1, and Intel SDM Vol. 1, 19.1). x86-64 is the 64-bit mode, the extension a mode row of the set names

use masc.core.extension;
use masc.core.index;
use masc.core.requirement;

pub val X64:      requirement.Id = 0;
pub val SSE:      requirement.Id = X64 + 1;
pub val AVX:      requirement.Id = SSE + 1;
pub val AVX512F:  requirement.Id = AVX + 1;
pub val X87:      requirement.Id = AVX512F + 1;
pub val MMX:      requirement.Id = X87 + 1;
pub val AMX_TILE: requirement.Id = MMX + 1;
pub val APX_F:    requirement.Id = AMX_TILE + 1;

pub val COUNT: u32 = 8;

val IMPLIES_AVX:      [1]requirement.Id = [1]requirement.Id{SSE};
val IMPLIES_AVX512F:  [1]requirement.Id = [1]requirement.Id{AVX};
val IMPLIES_AMX_TILE: [1]requirement.Id = [1]requirement.Id{X64};
val IMPLIES_APX_F:    [1]requirement.Id = [1]requirement.Id{X64};

pub val ROWS: [8]extension.Extension = [8]extension.Extension{
    extension.Extension{name: "x86-64", implies: requirement.NO_IDS, revision: ""},
    extension.Extension{name: "sse", implies: requirement.NO_IDS, revision: ""},
    extension.Extension{name: "avx", implies: requirement.Ids{at: ?IMPLIES_AVX[0], len: 1}, revision: ""},
    extension.Extension{name: "avx512f", implies: requirement.Ids{at: ?IMPLIES_AVX512F[0], len: 1}, revision: ""},
    extension.Extension{name: "x87", implies: requirement.NO_IDS, revision: ""},
    extension.Extension{name: "mmx", implies: requirement.NO_IDS, revision: ""},
    extension.Extension{name: "amx_tile", implies: requirement.Ids{at: ?IMPLIES_AMX_TILE[0], len: 1}, revision: ""},
    extension.Extension{name: "apx_f", implies: requirement.Ids{at: ?IMPLIES_APX_F[0], len: 1}, revision: ""},
};

val NAMES: [8]index.Entry = [8]index.Entry{
    index.Entry{key: "amx_tile", row: AMX_TILE},
    index.Entry{key: "apx_f", row: APX_F},
    index.Entry{key: "avx", row: AVX},
    index.Entry{key: "avx512f", row: AVX512F},
    index.Entry{key: "mmx", row: MMX},
    index.Entry{key: "sse", row: SSE},
    index.Entry{key: "x86-64", row: X64},
    index.Entry{key: "x87", row: X87},
};

pub val CATALOG: extension.Catalog = extension.Catalog{
    extensions:        ?ROWS[0],
    count:             COUNT,
    levels:            nil,
    level_count:       0,
    names:             index.Index{at: ?NAMES[0], len: 8},
    conflicts:         nil,
    conflict_count:    0,
    combinations:      nil,
    combination_count: 0,
    syntax:            ?extension.LIST,
};
