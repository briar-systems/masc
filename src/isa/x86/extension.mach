# the x86 extension catalog, its levels and its selection
#
# the rows, their handles, implications and revisions, the levels, the combination and the name index are generated, by
# gen x86 into gen_extension, from the records of gen/data/x86/extensions, where a row is a feature a selection holds,
# each implication's source is cited, and the sources are named at their revisions. the handles are forwarded here as
# `id`, as `x86_extension.id.AVX2`, the state values' among them, as `x86_extension.id.WIDTH_64`.
#
# the code width is execution state, not a row: the axis width of 16, 32 and 64 bits, which code
# switches (`.code16`, `.code32`, `.code64`), so a register or instruction that exists at one width
# requires its state value, as rax requires width=64. doitm, the data operand independent timing
# mode of IA32_UARCH_MISC_CTL (SDM Volume 1, 18.1), is the other axis, which the operating system
# sets and code does not switch

use masc.core.extension;
use masc.core.index;
use masc.core.requirement;
use masc.core.set;
use masc.core.state;
use x86_frame: masc.isa.x86.frame;
use masc.isa.x86.gen_extension;

use arch_x86: mink.catalog.arch.x86;

# the ids of the rows and the state values, as `x86_extension.id.AVX2`
fwd id: masc.isa.x86.gen_extension;

# the execution state axes, in atom order: an axis's values number on from the extensions, axis by axis
# ---
# width: the code width, which `.code16`, `.code32` and `.code64` switch (SDM Volume 1, 3.1 "Modes of Operation")
# doitm: data operand independent timing (SDM Volume 1, 18.1), on while IA32_UARCH_MISC_CTL.DOITM is set, which only
#        the operating system writes
val WIDTH_VALUES: [3]state.Value = [3]state.Value{
    state.Value{name: "16", flag: nil, doc: "16-bit code"},
    state.Value{name: "32", flag: "--32", doc: "32-bit code"},
    state.Value{name: "64", flag: "--64", doc: "64-bit code"},
};

val DOITM_VALUES: [2]state.Value = [2]state.Value{
    state.Value{name: "off", flag: nil, doc: "timing may depend on data operands"},
    state.Value{name: "on", flag: nil, doc: "data operand independent timing"},
};

val AXIS_ROWS: [2]state.Axis = [2]state.Axis{
    state.Axis{name: "width", values: state.Values{at: ?WIDTH_VALUES[0], len: 3}, initial: 2, switchable: gen_extension.WIDTH_SWITCHED},
    state.Axis{name: "doitm", values: state.Values{at: ?DOITM_VALUES[0], len: 2}, initial: 0, switchable: gen_extension.DOITM_SWITCHED},
};

pub val AXES: state.Axes = state.Axes{at: ?AXIS_ROWS[0], len: 2};

# the widths each architecture's objects are entered at
val ENTERS_16: [1]requirement.Id = [1]requirement.Id{gen_extension.WIDTH_16};
val ENTERS_32: [1]requirement.Id = [1]requirement.Id{gen_extension.WIDTH_32};
val ENTERS_64: [1]requirement.Id = [1]requirement.Id{gen_extension.WIDTH_64};

val ENTERS: [3]requirement.Alternative = [3]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?ENTERS_32[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ENTERS_16[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ENTERS_64[0], len: 1}, none: requirement.NO_IDS},
};

# the architectures of x86 and the width code of each is entered at, which code may switch: i386's 32 bits, or 16 under
# i386's code16 environment, and x86_64's 64, so x86_64 code is entered at width=64 and
# `.code32` within it is width=32. width is the first axis
pub val ARCHES: [2]set.Arch = [2]set.Arch{
    set.Arch{arch: ?arch_x86.X86, enters: requirement.Requirement{at: ?ENTERS[0], len: 2}, initial: state.Settings{at: [state.MAX_AXES]u8{1, 0, 0, 0, 0, 0, 0, 0}}, frame: ?x86_frame.I386},
    set.Arch{arch: ?arch_x86.X86_64, enters: requirement.Requirement{at: ?ENTERS[2], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{2, 0, 0, 0, 0, 0, 0, 0}}, frame: ?x86_frame.X86_64},
};

# the x86 catalog: its extensions, levels and combinations, selected as `name,name,...`
pub val CATALOG: extension.Catalog = extension.Catalog{
    extensions:        ?gen_extension.ROWS[0],
    count:             gen_extension.COUNT,
    levels:            ?gen_extension.LEVELS[0],
    level_count:       gen_extension.LEVEL_COUNT,
    names:             extension.Names{at: ?gen_extension.NAMES[0], len: gen_extension.NAME_COUNT},
    conflicts:         gen_extension.CONFLICTS,
    conflict_count:    gen_extension.CONFLICT_COUNT,
    combinations:      gen_extension.COMBINATIONS,
    combination_count: gen_extension.COMBINATION_COUNT,
    syntax:            ?extension.LIST,
};
