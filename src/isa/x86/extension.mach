# amd
pub val THREEDNOW: requirement.Id = APX_NCI_NDD_NF + 1;
pub val SSE4A:     requirement.Id = THREEDNOW + 1;
pub val FMA4:      requirement.Id = SSE4A + 1;
pub val XOP:       requirement.Id = FMA4 + 1;
pub val TBM:       requirement.Id = XOP + 1;
pub val LWP:       requirement.Id = TBM + 1;
pub val SVM:       requirement.Id = LWP + 1;
pub val MONITORX:  requirement.Id = SVM + 1;
pub val MCOMMIT:   requirement.Id = MONITORX + 1;
pub val RDPRU:     requirement.Id = MCOMMIT + 1;
pub val SNP:       requirement.Id = RDPRU + 1;
pub val INVLPGB:   requirement.Id = SNP + 1;

# via padlock
pub val VIA_PADLOCK_RNG: requirement.Id = INVLPGB + 1;
pub val VIA_PADLOCK_AES: requirement.Id = VIA_PADLOCK_RNG + 1;
pub val VIA_PADLOCK_SHA: requirement.Id = VIA_PADLOCK_AES + 1;
pub val VIA_PADLOCK_PMM: requirement.Id = VIA_PADLOCK_SHA + 1;

pub val COUNT: u32 = VIA_PADLOCK_PMM + 1;

pub val LEVEL_COUNT: u32 = 3;

# the execution state axes, in atom order: an axis's values number on from the extensions, axis by axis
# ---
# width: the code width, which `.code16`, `.code32` and `.code64` switch (SDM Volume 1, 3.1 "Modes of Operation")
# doitm: data operand independent timing (SDM Volume 1, 18.1), on while IA32_UARCH_MISC_CTL.DOITM is set, which only
#        the operating system writes
val WIDTH_VALUES: [3]state.Value = [3]state.Value{
    state.Value{name: "16", flag: nil, doc: "16-bit code"},
    state.Value{name: "32", flag: "--32", doc: "32-bit code"},
    state.Value{name: "64", flag: "--64", doc: "64-bit code"},
};

val DOITM_VALUES: [2]state.Value = [2]state.Value{
    state.Value{name: "off", flag: nil, doc: "timing may depend on data operands"},
    state.Value{name: "on", flag: nil, doc: "data operand independent timing"},
};

val AXIS_ROWS: [2]state.Axis = [2]state.Axis{
    state.Axis{name: "width", values: state.Values{at: ?WIDTH_VALUES[0], len: 3}, initial: 2, switchable: true},
    state.Axis{name: "doitm", values: state.Values{at: ?DOITM_VALUES[0], len: 2}, initial: 0, switchable: false},
};

pub val AXES: state.Axes = state.Axes{at: ?AXIS_ROWS[0], len: 2};

# the state atoms, numbered on from the extensions in axis order
pub val WIDTH_16:  requirement.Id = COUNT;
pub val WIDTH_32:  requirement.Id = WIDTH_16 + 1;
pub val WIDTH_64:  requirement.Id = WIDTH_32 + 1;
pub val DOITM_OFF: requirement.Id = WIDTH_64 + 1;
pub val DOITM_ON:  requirement.Id = DOITM_OFF + 1;

# the width each architecture's objects are entered at
val ENTERS_32: [1]requirement.Id = [1]requirement.Id{WIDTH_32};
val ENTERS_64: [1]requirement.Id = [1]requirement.Id{WIDTH_64};

val ENTERS: [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?ENTERS_32[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ENTERS_64[0], len: 1}, none: requirement.NO_IDS},
};

# the architectures of x86 and the width code of each is entered at, which code may switch: i386's 32 bits and x86_64's
# 64, so x86_64 code is entered at width=64 and `.code32` within it is width=32. width is the first axis
pub val ARCHES: [2]set.Arch = [2]set.Arch{
    set.Arch{arch: ?mink.arch.X86, enters: requirement.Requirement{at: ?ENTERS[0], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{1, 0, 0, 0, 0, 0, 0, 0}}},
    set.Arch{arch: ?mink.arch.X86_64, enters: requirement.Requirement{at: ?ENTERS[1], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{2, 0, 0, 0, 0, 0, 0, 0}}},
};

# the implications of the rows that have any, each with its source as the header names it
val IMPLIES_SSE:                 [1]requirement.Id  = [1]requirement.Id{OSFXSR};
val IMPLIES_SSE2:                [1]requirement.Id  = [1]requirement.Id{SSE};
