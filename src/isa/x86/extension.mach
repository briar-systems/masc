val IMPLIES_AVX10_1:             [15]requirement.Id = [15]requirement.Id{AVX, AVX2, AVX512F, AVX512CD, AVX512BW, AVX512DQ, AVX512VL, AVX512IFMA, AVX512VBMI, AVX512_VBMI2, AVX512_VNNI, AVX512_BITALG, AVX512_VPOPCNTDQ, AVX512_BF16, AVX512_FP16};
val IMPLIES_AVX10_2:             [1]requirement.Id  = [1]requirement.Id{AVX10_1};
