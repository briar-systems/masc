# the x86 extension catalog, its levels and its selection
#
# the rows, their handles, implications and revisions, the levels, the combination and the name index are generated, by
# gen x86 into gen_extension, from the records of gen/data/x86-extensions, where a row is a feature a selection holds,
# each implication's source is cited, and the sources are named at their revisions. the handles are forwarded here as
# `id`, as `x86_extension.id.AVX2`, the state values' among them, as `x86_extension.id.WIDTH_64`.
#
# the code width is execution state, not a row: the axis width of 16, 32 and 64 bits, which code
# switches (`.code16`, `.code32`, `.code64`), so a register or instruction that exists at one width
# requires its state value, as rax requires width=64. doitm, the data operand independent timing
# mode of IA32_UARCH_MISC_CTL (SDM Volume 1, 18.1), is the other axis, which the operating system
# sets and code does not switch

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.view;

use alloc: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.index;
use masc.core.requirement;
use masc.core.set;
use masc.core.state;
use masc.isa.x86.gen_extension;

use mink;

# the ids of the rows and the state values, as `x86_extension.id.AVX2`
fwd id: masc.isa.x86.gen_extension;

# the execution state axes, in atom order: an axis's values number on from the extensions, axis by axis
# ---
# width: the code width, which `.code16`, `.code32` and `.code64` switch (SDM Volume 1, 3.1 "Modes of Operation")
# doitm: data operand independent timing (SDM Volume 1, 18.1), on while IA32_UARCH_MISC_CTL.DOITM is set, which only
#        the operating system writes
val WIDTH_VALUES: [3]state.Value = [3]state.Value{
    state.Value{name: "16", flag: nil, doc: "16-bit code"},
    state.Value{name: "32", flag: "--32", doc: "32-bit code"},
    state.Value{name: "64", flag: "--64", doc: "64-bit code"},
};

val DOITM_VALUES: [2]state.Value = [2]state.Value{
    state.Value{name: "off", flag: nil, doc: "timing may depend on data operands"},
    state.Value{name: "on", flag: nil, doc: "data operand independent timing"},
};

val AXIS_ROWS: [2]state.Axis = [2]state.Axis{
    state.Axis{name: "width", values: state.Values{at: ?WIDTH_VALUES[0], len: 3}, initial: 2, switchable: true},
    state.Axis{name: "doitm", values: state.Values{at: ?DOITM_VALUES[0], len: 2}, initial: 0, switchable: false},
};

pub val AXES: state.Axes = state.Axes{at: ?AXIS_ROWS[0], len: 2};

# the width each architecture's objects are entered at
val ENTERS_32: [1]requirement.Id = [1]requirement.Id{gen_extension.WIDTH_32};
val ENTERS_64: [1]requirement.Id = [1]requirement.Id{gen_extension.WIDTH_64};

val ENTERS: [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?ENTERS_32[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ENTERS_64[0], len: 1}, none: requirement.NO_IDS},
};

# the architectures of x86 and the width code of each is entered at, which code may switch: i386's 32 bits and x86_64's
# 64, so x86_64 code is entered at width=64 and `.code32` within it is width=32. width is the first axis
pub val ARCHES: [2]set.Arch = [2]set.Arch{
    set.Arch{arch: ?mink.arch.X86, enters: requirement.Requirement{at: ?ENTERS[0], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{1, 0, 0, 0, 0, 0, 0, 0}}},
    set.Arch{arch: ?mink.arch.X86_64, enters: requirement.Requirement{at: ?ENTERS[1], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{2, 0, 0, 0, 0, 0, 0, 0}}},
};

# the x86 catalog: its extensions, levels and combinations, selected as `name,name,...`
pub val CATALOG: extension.Catalog = extension.Catalog{
    extensions:        ?gen_extension.ROWS[0],
    count:             gen_extension.COUNT,
    levels:            ?gen_extension.LEVELS[0],
    level_count:       gen_extension.LEVEL_COUNT,
    names:             extension.Names{at: ?gen_extension.NAMES[0], len: gen_extension.NAME_COUNT},
    conflicts:         gen_extension.CONFLICTS,
    conflict_count:    gen_extension.CONFLICT_COUNT,
    combinations:      gen_extension.COMBINATIONS,
    combination_count: gen_extension.COMBINATION_COUNT,
    syntax:            ?extension.LIST,
};

# the selection `spelling` makes in the x86 catalog, into `out`
#[testing]
fun t_select(a: *alloc.Allocator, spelling: str, out: *extension.Selection) bool {
    val made: res[extension.Selection, extension.Error] = extension.select(a, ?CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    @out = made.ok;
    ret true;
}

# whether the selection holds every row of `want` and no other
#[testing]
fun t_exactly(s: *extension.Selection, want: *requirement.Id, len: usize) bool {
    var held: usize = 0;
    var i:    u32   = 0;
    for (i < gen_extension.COUNT) {
        if (extension.has(s, i)) { held = held + 1; }
        i = i + 1;
    }
    if (held != len) { ret false; }
    var j: usize = 0;
    for (j < len) {
        if (!extension.has(s, want[j])) { ret false; }
        j = j + 1;
    }
    ret true;
}

# the members the psABI lists for x86-64-v3, its baseline and v2 included
#[testing]
val T_V3: [26]requirement.Id = [26]requirement.Id{
    gen_extension.CMOV, gen_extension.CX8, gen_extension.X87, gen_extension.FXSR, gen_extension.OSFXSR, gen_extension.MMX, gen_extension.SCE, gen_extension.SSE, gen_extension.SSE2,
    gen_extension.CX16, gen_extension.LAHF, gen_extension.POPCNT, gen_extension.SSE3, gen_extension.SSSE3, gen_extension.SSE41, gen_extension.SSE42,
    gen_extension.AVX, gen_extension.AVX2, gen_extension.BMI1, gen_extension.BMI2, gen_extension.F16C, gen_extension.FMA, gen_extension.LZCNT, gen_extension.MOVBE, gen_extension.XSAVE, gen_extension.OSXSAVE,
};

test select__x86_64_v3_closes_to_the_members_the_psabi_states {
    var t: testing.Testing;
    testing.make(?t);
    var v2: extension.Selection;
    var v3: extension.Selection;
    var v4: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "x86-64-v2", ?v2))                                                                              { ret 1; }
    if (!t_select(testing.allocator_of(?t), "x86-64-v3", ?v3))                                                                              { ret 2; }
    if (!t_select(testing.allocator_of(?t), "x86-64-v4", ?v4))                                                                              { ret 3; }
    if (!t_exactly(?v3, ?T_V3[0], 26))                                                                                                      { ret 4; }
    if (!extension.within(?v2, ?v3) || !extension.within(?v3, ?v4) || extension.within(?v3, ?v2))                                           { ret 5; }
    if (extension.has(?v3, gen_extension.AVX512F) || !extension.has(?v4, gen_extension.AVX512VL) || !extension.has(?v4, gen_extension.FMA)) { ret 6; }
    extension.release(?v2);
    extension.release(?v3);
    extension.release(?v4);
    if (testing.live_count(?t) != 0) { ret 7; }
    ret 0;
}

test select__an_avx10_version_implies_its_predecessors_and_the_families_it_includes {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "avx10_2", ?s))                                                                                       { ret 1; }
    if (!extension.has(?s, gen_extension.AVX10_1) || !extension.has(?s, gen_extension.AVX512BW) || !extension.has(?s, gen_extension.AVX512_FP16)) { ret 2; }
    if (!extension.has(?s, gen_extension.AVX2) || !extension.has(?s, gen_extension.SSE42) || !extension.has(?s, gen_extension.FMA))               { ret 3; }
    if (extension.has(?s, gen_extension.VAES) || extension.has(?s, gen_extension.GFNI) || extension.has(?s, gen_extension.VPCLMULQDQ))            { ret 4; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "avx10_1", ?s) || extension.has(?s, gen_extension.AVX10_2)) { ret 5; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "avx10_vnni_int", ?s))                                                                            { ret 6; }
    if (!extension.has(?s, gen_extension.AVX10_2) || !extension.has(?s, gen_extension.AVX10_1) || !extension.has(?s, gen_extension.AVX512VL)) { ret 7; }
    extension.release(?s);
    ret 0;
}

# the width is no extension, so a selection names none and the old mode rows are unknown names
test select__apx_brings_what_its_specification_states_and_no_width_is_an_extension {
    var t: testing.Testing;
    testing.make(?t);
    val modes:   res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?CATALOG, "x86-64", diagnostic.START);
    var refused: bool                                      = false;
    if (sel modes.err) {
        val e: extension.Error = modes.err;
        refused = sel e.refused;
    }
    if (!refused)                                                                                                                   { ret 1; }
    if (state.atom(?CATALOG, ?AXES, 0, 2) != gen_extension.WIDTH_64 || state.atom(?CATALOG, ?AXES, 1, 1) != gen_extension.DOITM_ON) { ret 2; }
    if (state.atom_count(?CATALOG, ?AXES) != gen_extension.DOITM_ON + 1)                                                            { ret 3; }
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "apx_f", ?s))                                                                                        { ret 4; }
    if (!extension.has(?s, gen_extension.OSXSAVE) || !extension.has(?s, gen_extension.APX_NCI_NDD_NF) || !extension.has(?s, gen_extension.CMOV)) { ret 5; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "apx_nci_ndd_nf", ?s) || extension.has(?s, gen_extension.CMOV)) { ret 6; }
    extension.release(?s);
    if (testing.live_count(?t) != 0) { ret 7; }
    ret 0;
}

# clang's `-m<name>` and `-mno-<name>` read in order, each closing the request: an enable brings what the row implies
# and a disable takes the row and everything that needs it, and nothing else
#[testing]
fun t_flags(r: *extension.Request) err[extension.Error] {
    val text: str   = r.spelling;
    val len:  usize = str_len(text);
    var at:   usize = 0;
    for (at < len) {
        if (text[at] == ' ') {
            at = at + 1;
            cnt;
        }
        var end: usize = at;
        for (end < len && text[end] != ' ') { end = end + 1; }
        if (end - at < 3 || text[at] != '-' || text[at + 1] != 'm') { ret err[extension.Error].err{extension.refusal(r, "not a -m flag", at, end - at)}; }
        var from: usize = at + 2;
        val off:  bool  = end - from > 3 && text[from] == 'n' && text[from + 1] == 'o' && text[from + 2] == '-';
        if (off) { from = from + 3; }
        val found: opt[requirement.Id] = extension.lookup(r.catalog, text, from, end - from);
        if (sel found.none) { ret err[extension.Error].err{extension.refusal(r, "unknown extension", from, end - from)}; }
        if (off)            { extension.request_edit(r, extension.Edit.disable{found.some}); }
        or                  { extension.request_edit(r, extension.Edit.enable{found.some}); }
        at = end;
    }
    ret err[extension.Error].ok{};
}

#[testing]
fun t_spell(s: *extension.Selection, out: *vector.Vector[u8]) err[alloc.Error] {
    ret extension.LIST.spell(s, out);
}

#[testing]
val T_FLAGS: extension.Syntax = extension.Syntax{parse: t_flags, spell: t_spell, versioned: t_spell};

# whether the flags `flags` select the rows `names` does
#[testing]
fun t_same(a: *alloc.Allocator, flags: str, names: str) bool {
    var catalog: extension.Catalog = CATALOG;
    catalog.syntax = ?T_FLAGS;
    val got: res[extension.Selection, extension.Error] = extension.select(a, ?catalog, flags, diagnostic.START);
    if (sel got.err) { ret false; }
    var s:    extension.Selection = got.ok;
    var want: extension.Selection;
    if (!t_select(a, names, ?want)) { ret false; }
    var same: bool = true;
    var i:    u32  = 0;
    for (i < gen_extension.COUNT) {
        if (extension.has(?s, i) != extension.has(?want, i)) { same = false; }
        i = i + 1;
    }
    extension.release(?s);
    extension.release(?want);
    ret same;
}

# the sse and avx macros clang 23.1.1 defines for each order of flags (#282): `-mavx2 -mno-avx` leaves sse4.2,
# `-mno-avx -mavx2` avx2 and what it brings, and `-mavx512f -mno-avx2` avx, f16c, fma and sse4.2. the osxsave avx
# implies stays after -mno-avx, as a disable takes nothing the row implied
test request_edit__clangs_flags_select_in_order {
    var t: testing.Testing;
    testing.make(?t);
    if (!t_same(testing.allocator_of(?t), "-mavx2 -mno-avx", "sse42,osxsave")) { ret 1; }
    if (!t_same(testing.allocator_of(?t), "-mno-avx -mavx2", "avx2"))          { ret 2; }
    if (!t_same(testing.allocator_of(?t), "-mavx512f -mno-avx2", "f16c,fma"))  { ret 3; }
    if (testing.live_count(?t) != 0)                                           { ret 4; }
    ret 0;
}

# a psabi level sets the width it is defined for
test select__a_psabi_level_sets_64_bit_code {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "x86-64-v3", ?s))                                    { ret 1; }
    if (!extension.has(?s, gen_extension.WIDTH_64) || extension.has(?s, gen_extension.WIDTH_32)) { ret 2; }
    if (gen_extension.LEVELS[1].kind != extension.PSABI)                                         { ret 3; }
    extension.release(?s);
    ret 0;
}

# every row and level is found by its own name, alone
test names__every_row_and_level_is_found_by_its_own_name {
    var i: u32 = 0;
    for (i < gen_extension.COUNT + gen_extension.LEVEL_COUNT) {
        var own: str = "";
        if (i < gen_extension.COUNT) { own = gen_extension.ROWS[i].name; }
        or                           { own = gen_extension.LEVELS[i - gen_extension.COUNT].name; }
        val found: opt[*extension.NameEntry] = extension.entry(?CATALOG, view(own, str_len(own)), false);
        if (sel found.none) { ret 1; }
        val e: *extension.NameEntry = found.some;
        if (!e.canonical || e.rows.len != 1 || e.rows.at[0] != i) { ret 2; }
        i = i + 1;
    }
    if (CATALOG.names.len != gen_extension.COUNT + gen_extension.LEVEL_COUNT) { ret 3; }
    ret 0;
}
