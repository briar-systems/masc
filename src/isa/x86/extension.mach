pub val AVX512BW:            requirement.Id = AVX512CD + 1;
pub val AVX512DQ:            requirement.Id = AVX512BW + 1;
pub val AVX512VL:            requirement.Id = AVX512DQ + 1;
pub val AVX512IFMA:          requirement.Id = AVX512VL + 1;
pub val AVX512VBMI:          requirement.Id = AVX512IFMA + 1;
pub val AVX512_VBMI2:        requirement.Id = AVX512VBMI + 1;
pub val AVX512_VNNI:         requirement.Id = AVX512_VBMI2 + 1;
pub val AVX512_BITALG:       requirement.Id = AVX512_VNNI + 1;
pub val AVX512_VPOPCNTDQ:    requirement.Id = AVX512_BITALG + 1;
pub val AVX512_BF16:         requirement.Id = AVX512_VPOPCNTDQ + 1;
pub val AVX512_FP16:         requirement.Id = AVX512_BF16 + 1;
pub val AVX512_VP2INTERSECT: requirement.Id = AVX512_FP16 + 1;
pub val AVX512ER:            requirement.Id = AVX512_VP2INTERSECT + 1;
pub val AVX512PF:            requirement.Id = AVX512ER + 1;
pub val AVX512_4FMAPS:       requirement.Id = AVX512PF + 1;
pub val AVX512_4VNNIW:       requirement.Id = AVX512_4FMAPS + 1;

# avx10
pub val AVX10_1:        requirement.Id = AVX512_4VNNIW + 1;
pub val AVX10_2:        requirement.Id = AVX10_1 + 1;
pub val AVX10_VNNI_INT: requirement.Id = AVX10_2 + 1;
pub val AVX10_V2_AUX:   requirement.Id = AVX10_VNNI_INT + 1;

# amx
pub val AMX_TILE:    requirement.Id = AVX10_V2_AUX + 1;
pub val AMX_BF16:    requirement.Id = AMX_TILE + 1;
pub val AMX_INT8:    requirement.Id = AMX_BF16 + 1;
pub val AMX_FP16:    requirement.Id = AMX_INT8 + 1;
pub val AMX_COMPLEX: requirement.Id = AMX_FP16 + 1;
pub val AMX_FP8:     requirement.Id = AMX_COMPLEX + 1;
