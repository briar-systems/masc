pub val INDEX: index.Index = index.Index{at: ?NAMES[0], len: 285};

# the requirement of the ISA set `name`, spelled as XED spells it, or none when XED names no such set
pub fun requires(name: str) opt[requirement.Requirement] {
    val row: opt[u32] = index.find(?INDEX, name);
    if (sel row.none) { ret opt[requirement.Requirement].none{}; }
    ret opt[requirement.Requirement].some{SETS[row.some].requires};
}

# the selection `spelling` makes in the x86 catalog, into `out`
#[testing]
fun t_select(a: *alloc.Allocator, spelling: str, out: *extension.Selection) bool {
    val made: res[extension.Selection, extension.Error] = extension.select(a, ?x86_extension.CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    @out = made.ok;
    ret true;
}

# whether the set `name` is admitted by the selection `spelling`
#[testing]
fun t_admits(spelling: str, name: str) bool {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), spelling, ?s)) { ret false; }
    val needs: opt[requirement.Requirement] = requires(name);
    var held:  bool                         = false;
    if (sel needs.some) { held = extension.admits(?s, needs.some); }
    extension.release(?s);
    ret held;
}

test requires__a_set_is_admitted_by_the_rows_it_needs_or_by_an_avx10_version {
    if (!t_admits("avx512bw,avx512vl", "AVX512BW_128") || t_admits("avx512bw", "AVX512BW_128"))      { ret 1; }
    if (!t_admits("avx512bw", "AVX512BW_512") || !t_admits("avx512bw", "AVX512BW_KOPD"))             { ret 2; }
    if (!t_admits("avx10_1", "AVX512BW_128") || !t_admits("avx10_1", "AVX512_VNNI_256"))             { ret 3; }
    if (t_admits("avx10_1", "AVX512_VNNI_INT8_128") || !t_admits("avx10_2", "AVX512_VNNI_INT8_128")) { ret 4; }
    if (!t_admits("avx10_vnni_int", "AVX512_VNNI_INT8_128"))                                         { ret 5; }
    if (t_admits("avx10_1", "AVX512_VAES_128") || !t_admits("avx10_1,vaes,aes", "AVX512_VAES_128"))  { ret 6; }
    if (!t_admits("", "I86") || !t_admits("x86-64", "PAUSE") || t_admits("x86-64", "AVX"))           { ret 7; }
    if (!t_admits("apx_f,bmi1", "APX_F_BMI1") || t_admits("apx_f", "APX_F_BMI1"))                    { ret 8; }
    if (!t_admits("x87,cmov", "FCMOV") || t_admits("x87", "FCMOV"))                                  { ret 9; }
    ret 0;
}

test requires__the_table_is_sorted_by_name_and_names_rows_of_the_catalog {
    if (INDEX.len != COUNT) { ret 1; }
    var i: u32 = 0;
    for (i < COUNT) {
        if (INDEX.at[i].row != i || !str_equals(INDEX.at[i].key, SETS[i].name)) { ret 2; }
        if (i > 0 && str_compare(INDEX.at[i - 1].key, INDEX.at[i].key) >= 0)    { ret 3; }
        var a: u32 = 0;
        for (a < SETS[i].requires.len) {
            val alt: requirement.Ids = SETS[i].requires.at[a];
            if (alt.len == 0) { ret 4; }
            var k: u32 = 0;
            for (k < alt.len) {
                if (alt.at[k] >= x86_extension.COUNT) { ret 5; }
                k = k + 1;
            }
            a = a + 1;
        }
        i = i + 1;
    }
    ret 0;
}
