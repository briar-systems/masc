# the ISA sets XED names, each as a requirement over the x86 catalog's rows
#
# an instruction row of x86 states its ISA set as XED does, and the table answers what that set
# needs from a selection. XED gives a set's CPUID flags, and a set that needs more than one (a vector
# length variant needs its family and avx512vl, an apx set needs apx_f and the feature it extends) or
# that has an AVX10 form beside its AVX-512 one is an alternative of conjunctions, which is what a
# requirement is. a set whose flags are one row, such as avx2gather, answers that row
#
# the sets are the ones XED 0bcb6237345c5066726dcc08b3d87928df3b5b26 (2026-08-24) lists in the
# datafiles/**/cpuid*.txt tables and in the ISA_SET of its instruction files, and each answer is
# that table's flags read as rows of the catalog, with an alternative dropped when another is a
# part of it. the fourteen sets that table leaves without a flag are answered by hand:
#   i86, i186, i286real, i286protected, i386, i486, i486real, pentiumreal, ppro, pause,
#   prefetch_nop, rdpmc, fat_nop, ppro_ud0_long and ppro_ud0_short have none, as every x86
#   processor executes them
#   x87 needs x87, sse_prefetch needs sse (the prefetches arrived with it), amd needs sce (its
#   instructions are SYSCALL and SYSRET, Table D-1 of the AMD APM volume 3), 3dnow, fma4, xop, tbm,
#   svm and lwp need their own rows (AMD APM volume 3 Appendix D and the XED sets themselves),
#   amd_invlpgb needs invlpgb, tdx needs tdx, vmfunc needs vmfunc and sgx_enclv needs sgx
# a later generator reads the same tables and holds this one to them

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;

use alloc: std.allocator;
use std.allocator.testing;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.index;
use masc.core.requirement;

use x86_extension: masc.isa.x86.extension;

# one ISA set XED names
# ---
# name:     the set, spelled as XED's ISA_SET spells it
# requires: the catalog rows the set needs, as alternatives of conjunctions. no alternative means every selection admits it
pub rec Set {
    name:     str;
    requires: requirement.Requirement;
}

pub val COUNT: u32 = 285;

