# the registration of instruction sets, one module per set beside this one
#
# the registry lists every set's record, one line each, and is read by
# architecture through `masc.core.set.find`. it lives above the core because
# it names every set module, and each set module builds on the core.

use std.print;
use std.types.error.err;
use std.types.string.str_equals;

use mink;

use masc.check.check;
use check_set:   masc.check.set;
use check_trait: masc.check.trait;
use masc.core.set;
use masc.core.trait;

use riscv_set: masc.isa.riscv.set;

# every registered instruction set
val SETS: [1]*set.Set = [1]*set.Set{?riscv_set.SET};

pub val REGISTRY: set.Registry = set.Registry{sets: ?SETS[0], count: 1};

test registry__every_registered_set_checks_its_tables {
    val checked: err[check.Refusal] = check_set.every(?REGISTRY);
    if (sel checked.err) {
        print.eprintlnf("{} ({} {} {})", checked.err.message, checked.err.table, checked.err.index, checked.err.other);
        ret 1;
    }
    ret 0;
}

test registry__a_set_with_an_encoded_axis_no_owner_states_is_refused {
    var rows: [7]trait.Owned;
    var n:    u32 = 0;
    var i:    u32 = 0;
    for (i < riscv_set.SET.traits.len) {
        if (riscv_set.SET.traits.at[i].axis != ?mink.arch.RISCV_RVC) {
            rows[n] = riscv_set.SET.traits.at[i];
            n       = n + 1;
        }
        i = i + 1;
    }
    var s: set.Set = riscv_set.SET;
    s.traits = trait.Owners{at: ?rows[0], len: n};
    val checked: err[check.Refusal] = check_set.one(?s);
    if (!sel checked.err)                                           { ret 1; }
    if (!str_equals(checked.err.message, check_trait.UNOWNED_AXIS)) { ret 2; }
    # rvc is the second of risc-v's axes in mink's catalog
    if (checked.err.index != 1) { ret 3; }
    ret 0;
}
