# the registration of instruction sets, one module per set beside this one
#
# the registry lists every set's record, one line each, and is read by
# architecture through `masc.core.set.find`. it lives above the core because
# it names every set module, and each set module builds on the core.
#
# it also checks a target mink's catalog resolved against the set serving its
# architecture: mink checks the target's spelling and rows, and masc owns the
# extension names, conflicts and implications of its instruction set, so a
# tool runs `check` right after mink's `resolve`.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail;
use mink_target: mink.catalog.target;

use masc.core.extension;
use masc.core.set;

use aarch64_set: masc.isa.aarch64.set;
use riscv_set:   masc.isa.riscv.set;
use spirv_set:   masc.isa.spirv.set;
use wasm_set:    masc.isa.wasm.set;
use x86_set:     masc.isa.x86.set;

# every registered instruction set
val SETS: [5]*set.Set = [5]*set.Set{?riscv_set.SET, ?x86_set.SET, ?wasm_set.SET, ?spirv_set.SET, ?aarch64_set.SET};

pub val REGISTRY: set.Registry = set.Registry{sets: ?SETS[0], count: 5};

fun stated(s: str) bool {
    ret s != nil && s[0] != 0;
}

# the instruction set and extensions of the target `t`, as mink's catalog resolved it, checked against the selection
# of the registered set serving its architecture, its storage in `a` given back before it returns
# ---
# ret: ok, or mink's refusal: malformed for an `--isa` the set's syntax refuses, at the offset in it and about the
#      spelling, for an `--ext` the set's catalog does not name, about the name, and for extensions the selection's
#      closure holds that conflict, about one of them; unsupported for an `--isa` or `--ext` on an architecture no
#      registered set serves; refused when the allocator refuses the selection's storage
pub fun check(a: *A.Allocator, t: *mink_target.Target) err[fail.Fail] {
    val found: opt[*set.Set] = set.find(?REGISTRY, t.arch);
    if (sel found.none) {
        if (!stated(t.isa) && t.extension_count == 0) { ret err[fail.Fail].ok{}; }
        ret err[fail.Fail].err{fail.about(fail.unsupported("masc registers no instruction set for the architecture to take an isa or ext"), t.arch.name)};
    }

    var spelling: str = t.isa;
    if (spelling == nil) { spelling = ""; }
    val catalog: *extension.Catalog                            = found.some.extensions;
    val chosen:  res[extension.Selection, extension.Added] = extension.select_adding(a, catalog, spelling, t.extensions, t.extension_count::u32);
    if (sel chosen.ok) {
        var held:    extension.Selection = chosen.ok;
        val dropped: err[A.Error]        = extension.release(?held);
        ret err[fail.Fail].ok{};
    }

    val why: extension.Added = chosen.err;
    if (sel why.name) {
        ret err[fail.Fail].err{fail.about(fail.in_record(fail.malformed("masc's catalog of the architecture names no such extension"), "--ext"), t.extensions[why.name])};
    }

    val e: extension.Error = why.selection;
    if (sel e.refused) {
        ret err[fail.Fail].err{fail.at_offset(fail.about(fail.in_record(fail.malformed(e.refused.message), "--isa"), spelling), e.refused.span.start.offset::u64)};
    }
    if (sel e.conflict) {
        val clash: fail.Fail = fail.in_record(fail.malformed("the instruction set holds extensions that conflict"), "--isa");
        if (e.conflict.a < catalog.count) { ret err[fail.Fail].err{fail.about(clash, catalog.extensions[e.conflict.a].name)}; }
        ret err[fail.Fail].err{clash};
    }
    ret err[fail.Fail].err{fail.refused(e.memory)};
}
