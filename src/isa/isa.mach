# the registration of instruction sets, one module per set beside this one
#
# the registry lists every set's record, one line each, and is read by
# architecture through `masc.core.set.find`. it lives above the core because
# it names every set module, and each set module builds on the core.
#
# it also checks a target mink's catalog resolved against the set serving its
# architecture: mink checks the target's spelling and rows, and masc owns the
# extension names, conflicts and implications of its instruction set, so a
# tool runs `check` right after mink's `resolve` and reads its refusal as it
# reads one of `resolve`.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink_target: mink.catalog.target;

use masc.core.extension;
use masc.core.set;

use aarch64_set: masc.isa.aarch64.set;
use riscv_set:   masc.isa.riscv.set;
use spirv_set:   masc.isa.spirv.set;
use wasm_set:    masc.isa.wasm.set;
use x86_set:     masc.isa.x86.set;

# every registered instruction set
val SETS: [5]*set.Set = [5]*set.Set{?riscv_set.SET, ?x86_set.SET, ?wasm_set.SET, ?spirv_set.SET, ?aarch64_set.SET};

pub val REGISTRY: set.Registry = set.Registry{sets: ?SETS[0], count: 5};

# the names of `catalog`'s name index as what an unknown extension's refusal accepts, held in `a`, nothing when `a`
# refuses them
fun names_of(a: *A.Allocator, catalog: *extension.Catalog) mink_target.Accepted {
    val made: res[*str, A.Error] = A.allocate[str](a, catalog.names.len::usize);
    if (sel made.err) { ret mink_target.Accepted.nothing{}; }
    var i: u32 = 0;
    for (i < catalog.names.len) {
        made.ok[i] = catalog.names.at[i].key;
        i          = i + 1;
    }
    ret mink_target.Accepted.names{mink_target.Names{at: made.ok, count: catalog.names.len::usize}};
}

# the instruction set and extensions of the target `t`, as mink's catalog resolved it, checked against the selection
# of the registered set serving its architecture, the selection's storage in `a` given back before it returns. a tool
# runs it right after mink's `resolve`
# ---
# ret: ok, or a refusal in mink's shape: of part isa, for an isa the set's selection syntax refuses, or one the
#      architecture takes from no registered set, or a selection masc could not hold; of part extension, for an ext
#      the set's catalog does not name, accepting every name it does and held in `a`, an ext on an architecture no
#      registered set serves, or one the selection's closure holds that conflicts with another
pub fun check(a: *A.Allocator, t: *mink_target.Target) err[mink_target.Refusal] {
    val read:     res[str, mink_target.Refusal] = mink_target.isa(t);
    var spelling: str                           = "";
    if (sel read.err) {
        if (t.ext_count == 0) { ret err[mink_target.Refusal].ok{}; }
        ret err[mink_target.Refusal].err{read.err};
    }
    spelling = read.ok;

    val found: opt[*set.Set] = set.find(?REGISTRY, t.arch);
    if (sel found.none) {
        if (t.ext_count > 0)  { ret err[mink_target.Refusal].err{mink_target.refusal(mink_target.Part.extension{}, t.ext[0], "masc registers no instruction set for the architecture", mink_target.Accepted.nothing{})}; }
        if (sel t.isa.stated) { ret err[mink_target.Refusal].err{mink_target.refusal(mink_target.Part.isa{}, spelling, "masc registers no instruction set for the architecture", mink_target.Accepted.nothing{})}; }
        ret err[mink_target.Refusal].ok{};
    }

    val catalog: *extension.Catalog                        = found.some.extensions;
    val chosen:  res[extension.Selection, extension.Added] = extension.select_adding(a, catalog, spelling, t.ext, t.ext_count::u32);
    if (sel chosen.ok) {
        var held:    extension.Selection = chosen.ok;
        val dropped: err[A.Error]        = extension.release(?held);
        ret err[mink_target.Refusal].ok{};
    }

    val why: extension.Added = chosen.err;
    if (sel why.name) {
        ret err[mink_target.Refusal].err{mink_target.refusal(mink_target.Part.extension{}, t.ext[why.name], "masc's catalog of the architecture names no such extension", names_of(a, catalog))};
    }

    val e: extension.Error = why.selection;
    if (sel e.refused) { ret err[mink_target.Refusal].err{mink_target.refusal(mink_target.Part.isa{}, spelling, e.refused.message, mink_target.Accepted.nothing{})}; }
    if (sel e.conflict) {
        if (e.conflict.a < catalog.count) {
            ret err[mink_target.Refusal].err{mink_target.refusal(mink_target.Part.extension{}, catalog.extensions[e.conflict.a].name, "the extension conflicts with another the instruction set holds", mink_target.Accepted.nothing{})};
        }
        ret err[mink_target.Refusal].err{mink_target.refusal(mink_target.Part.isa{}, spelling, "the instruction set holds extensions that conflict", mink_target.Accepted.nothing{})};
    }
    ret err[mink_target.Refusal].err{mink_target.refusal(mink_target.Part.isa{}, spelling, "masc could not hold the selection", mink_target.Accepted.nothing{})};
}
