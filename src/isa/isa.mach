# the registration of instruction sets, one module per set beside this one
#
# the registry lists every set's record, one line each, and is read by
# architecture through `masc.core.set.find`. it lives above the core because
# it names every set module, and each set module builds on the core.

use std.allocator.testing;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str_equals;

use mink.base.fail;
use arch_riscv: mink.catalog.arch.riscv;
use mink_trait: mink.catalog.trait;
use mink.format.registry;

use masc.check.check;
use check_set:   masc.check.set;
use check_trait: masc.check.trait;
use masc.core.set;
use masc.core.trait;

use riscv_set: masc.isa.riscv.set;
use spirv_set: masc.isa.spirv.set;
use wasm_set:  masc.isa.wasm.set;
use x86_set:   masc.isa.x86.set;

# every registered instruction set
val SETS: [4]*set.Set = [4]*set.Set{?riscv_set.SET, ?x86_set.SET, ?wasm_set.SET, ?spirv_set.SET};

pub val REGISTRY: set.Registry = set.Registry{sets: ?SETS[0], count: 4};

# mink's built in format registry at `g`, its allocator `tt`'s, false when it cannot be built
#[testing]
fun t_formats(tt: *testing.Testing, g: *registry.Registry) bool {
    testing.make(tt);
    val made: res[registry.Registry, fail.Fail] = registry.builtin(testing.allocator_of(tt));
    if (sel made.err) { ret false; }
    @g = made.ok;
    ret true;
}

test registry__every_registered_set_checks_its_tables {
    var tt: testing.Testing;
    var g:  registry.Registry;
    if (!t_formats(?tt, ?g)) { ret 9; }
    var f:        check.Formats      = check.Formats{registry: ?g, alloc: testing.allocator_of(?tt)};
    val checked:  err[check.Refusal] = check_set.every(?REGISTRY, ?f);
    val released: err[fail.Fail]     = registry.release(?g);
    if (sel checked.err) {
        print.eprintlnf("{} ({} {} {})", checked.err.message, checked.err.table, checked.err.index, checked.err.other);
        ret 1;
    }
    ret 0;
}

# a row maps an axis of its own owner class: a convention is the caller's abi row's, so a source row of one is refused
test registry__a_set_row_of_another_class_than_its_axis_is_refused {
    var rows: [8]trait.Owned;
    var n:    u32 = 0;
    for (n < riscv_set.SET.traits.len) {
        rows[n] = riscv_set.SET.traits.at[n];
        n       = n + 1;
    }
    rows[n] = trait.Owned{axis: ?arch_riscv.RISCV_FLOAT_ABI, owner: trait.Owner.source{trait.Default{setting: mink_trait.Setting.choice{?arch_riscv.RISCV_DOUBLE}, cites: "a test"}}};
    var s: set.Set = riscv_set.SET;
    s.traits = trait.Owners{at: ?rows[0], len: n + 1};
    var tt: testing.Testing;
    var g:  registry.Registry;
    if (!t_formats(?tt, ?g)) { ret 9; }
    var f:        check.Formats      = check.Formats{registry: ?g, alloc: testing.allocator_of(?tt)};
    val checked:  err[check.Refusal] = check_set.one(?s, ?f);
    val released: err[fail.Fail]     = registry.release(?g);
    if (!sel checked.err)                                        { ret 1; }
    if (!str_equals(checked.err.message, check_trait.TRAIT_ROW)) { ret 2; }
    if (checked.err.index != n)                                  { ret 3; }
    ret 0;
}

# a set row may leave an axis of a class the set derives unstated, citing the reference that leaves it so
test registry__an_unwritten_row_needs_a_reference {
    var rows: [8]trait.Owned;
    var n:    u32 = 0;
    for (n < riscv_set.SET.traits.len) {
        rows[n] = riscv_set.SET.traits.at[n];
        n       = n + 1;
    }
    var s: set.Set = riscv_set.SET;
    s.traits = trait.Owners{at: ?rows[0], len: n};
    var tt: testing.Testing;
    var g:  registry.Registry;
    if (!t_formats(?tt, ?g)) { ret 9; }
    var f: check.Formats = check.Formats{registry: ?g, alloc: testing.allocator_of(?tt)};
    var k: u32           = 0;
    for (k < n) {
        if (rows[k].axis == ?arch_riscv.RISCV_CFI_SS) { rows[k].owner = trait.Owner.unwritten{"a test"}; }
        k = k + 1;
    }
    val cited: err[check.Refusal] = check_set.one(?s, ?f);
    k = 0;
    for (k < n) {
        if (rows[k].axis == ?arch_riscv.RISCV_CFI_SS) { rows[k].owner = trait.Owner.unwritten{""}; }
        k = k + 1;
    }
    val uncited:  err[check.Refusal] = check_set.one(?s, ?f);
    val released: err[fail.Fail]     = registry.release(?g);
    if (sel cited.err)                                           { ret 1; }
    if (!sel uncited.err)                                        { ret 2; }
    if (!str_equals(uncited.err.message, check_trait.TRAIT_ROW)) { ret 2; }
    ret 0;
}
