# the spir-v extension catalog and its selection
#
# the rows are generated, by gen spirv into gen_extension, from SPIRV-Headers' core grammar: the core versions, each
# implying the one before it, then every capability with the capabilities it depends on as its implications and its
# further names as aliases, then every extension an availability names. a consumer names a handle there, as
# `gen_extension.SHADER` or `gen_extension.SPV1_3`. a selection is a comma-separated list of their names,
# as `spv1.3,Shader`, which a module's own OpCapability and OpExtension instructions then widen.
#
# spir-v has no execution state a module switches: its addressing and memory models are an instruction of the module
# itself, so the set has no axes.

use masc.core.extension;
use masc.core.requirement;
use masc.core.state;

use masc.isa.spirv.gen_extension;

pub val AXES: state.Axes = state.NO_AXES;

# a capability spir-v took into its core at a version past 1.0 implies the one extension the grammar names it under
# below that version, the khronos one where the grammar names two, so a selection that names the capability for an
# earlier version declares the extension with it, and holds the version the extension needs. at its version the
# capability's requirement is met by the version alone and the extension is never declared
val BROUGHT:      [12]requirement.Id        = [12]requirement.Id{gen_extension.SPV_EXT_DEMOTE_TO_HELPER_INVOCATION, gen_extension.SPV_EXT_DESCRIPTOR_INDEXING, gen_extension.SPV_KHR_16BIT_STORAGE, gen_extension.SPV_KHR_8BIT_STORAGE, gen_extension.SPV_KHR_DEVICE_GROUP, gen_extension.SPV_KHR_FLOAT_CONTROLS, gen_extension.SPV_KHR_INTEGER_DOT_PRODUCT, gen_extension.SPV_KHR_MULTIVIEW, gen_extension.SPV_KHR_PHYSICAL_STORAGE_BUFFER, gen_extension.SPV_KHR_SHADER_DRAW_PARAMETERS, gen_extension.SPV_KHR_VARIABLE_POINTERS, gen_extension.SPV_KHR_VULKAN_MEMORY_MODEL};
val COMBINATIONS: [37]extension.Combination = [37]extension.Combination{
    extension.Combination{by: gen_extension.DRAWPARAMETERS, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[9], len: 1}},
    extension.Combination{by: gen_extension.STORAGEBUFFER16BITACCESS, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[2], len: 1}},
    extension.Combination{by: gen_extension.UNIFORMANDSTORAGEBUFFER16BITACCESS, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[2], len: 1}},
    extension.Combination{by: gen_extension.STORAGEPUSHCONSTANT16, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[2], len: 1}},
    extension.Combination{by: gen_extension.STORAGEINPUTOUTPUT16, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[2], len: 1}},
    extension.Combination{by: gen_extension.DEVICEGROUP, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[4], len: 1}},
    extension.Combination{by: gen_extension.MULTIVIEW, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[7], len: 1}},
    extension.Combination{by: gen_extension.VARIABLEPOINTERSSTORAGEBUFFER, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[10], len: 1}},
    extension.Combination{by: gen_extension.VARIABLEPOINTERS, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[10], len: 1}},
    extension.Combination{by: gen_extension.STORAGEBUFFER8BITACCESS, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[3], len: 1}},
    extension.Combination{by: gen_extension.UNIFORMANDSTORAGEBUFFER8BITACCESS, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[3], len: 1}},
    extension.Combination{by: gen_extension.STORAGEPUSHCONSTANT8, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[3], len: 1}},
    extension.Combination{by: gen_extension.DENORMPRESERVE, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[5], len: 1}},
    extension.Combination{by: gen_extension.DENORMFLUSHTOZERO, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[5], len: 1}},
    extension.Combination{by: gen_extension.SIGNEDZEROINFNANPRESERVE, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[5], len: 1}},
    extension.Combination{by: gen_extension.ROUNDINGMODERTE, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[5], len: 1}},
    extension.Combination{by: gen_extension.ROUNDINGMODERTZ, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[5], len: 1}},
    extension.Combination{by: gen_extension.SHADERNONUNIFORM, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.RUNTIMEDESCRIPTORARRAY, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.INPUTATTACHMENTARRAYDYNAMICINDEXING, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.UNIFORMTEXELBUFFERARRAYDYNAMICINDEXING, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.STORAGETEXELBUFFERARRAYDYNAMICINDEXING, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.UNIFORMBUFFERARRAYNONUNIFORMINDEXING, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.SAMPLEDIMAGEARRAYNONUNIFORMINDEXING, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.STORAGEBUFFERARRAYNONUNIFORMINDEXING, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.STORAGEIMAGEARRAYNONUNIFORMINDEXING, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.INPUTATTACHMENTARRAYNONUNIFORMINDEXING, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.UNIFORMTEXELBUFFERARRAYNONUNIFORMINDEXING, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.STORAGETEXELBUFFERARRAYNONUNIFORMINDEXING, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[1], len: 1}},
    extension.Combination{by: gen_extension.VULKANMEMORYMODEL, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[11], len: 1}},
    extension.Combination{by: gen_extension.VULKANMEMORYMODELDEVICESCOPE, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[11], len: 1}},
    extension.Combination{by: gen_extension.PHYSICALSTORAGEBUFFERADDRESSES, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[8], len: 1}},
    extension.Combination{by: gen_extension.DEMOTETOHELPERINVOCATION, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[0], len: 1}},
    extension.Combination{by: gen_extension.DOTPRODUCTINPUTALL, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[6], len: 1}},
    extension.Combination{by: gen_extension.DOTPRODUCTINPUT4X8BIT, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[6], len: 1}},
    extension.Combination{by: gen_extension.DOTPRODUCTINPUT4X8BITPACKED, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[6], len: 1}},
    extension.Combination{by: gen_extension.DOTPRODUCT, when: requirement.NO_IDS, implies: requirement.Ids{at: ?BROUGHT[6], len: 1}},
};

# the base selection, nothing added, no version nor capability, is named `none`, as spir-v's grammar and its tools name
# no such set
pub val CATALOG: extension.Catalog = extension.Catalog{
    extensions:        ?gen_extension.ROWS[0],
    count:             gen_extension.COUNT,
    levels:            gen_extension.LEVELS,
    level_count:       gen_extension.LEVEL_COUNT,
    names:             extension.Names{at: ?gen_extension.NAMES[0], len: gen_extension.NAME_COUNT},
    name_keys:         ?gen_extension.NAME_KEYS[0],
    conflicts:         gen_extension.CONFLICTS,
    conflict_count:    gen_extension.CONFLICT_COUNT,
    combinations:      ?COMBINATIONS[0],
    combination_count: 37,
    syntax:            ?extension.LIST,
    base:              "none",
};
