# the spir-v extension catalog and its selection
#
# the rows are generated, by gen spirv into gen_extension, from SPIRV-Headers' core grammar: the core versions, each
# implying the one before it, then every capability with the capabilities it depends on as its implications and its
# further names as aliases, then every extension an availability names. the handles are forwarded here as `id`, as
# `spirv_extension.id.SHADER` or `spirv_extension.id.SPV1_3`. a selection is a comma-separated list of their names,
# as `spv1.3,Shader`, which a module's own OpCapability and OpExtension instructions then widen.
#
# spir-v has no execution state a module switches: its addressing and memory models are an instruction of the module
# itself, so the set has no axes.

use masc.core.extension;
use masc.core.state;

use masc.isa.spirv.gen_extension;

# the ids of the rows, as `spirv_extension.id.SHADER`
fwd id: masc.isa.spirv.gen_extension;

pub val AXES: state.Axes = state.NO_AXES;

# the base selection, nothing added, no version nor capability, is named `none`, as spir-v's grammar and its tools name
# no such set
pub val CATALOG: extension.Catalog = extension.Catalog{
    extensions:        ?gen_extension.ROWS[0],
    count:             gen_extension.COUNT,
    levels:            gen_extension.LEVELS,
    level_count:       gen_extension.LEVEL_COUNT,
    names:             extension.Names{at: ?gen_extension.NAMES[0], len: gen_extension.NAME_COUNT},
    conflicts:         gen_extension.CONFLICTS,
    conflict_count:    gen_extension.CONFLICT_COUNT,
    combinations:      gen_extension.COMBINATIONS,
    combination_count: gen_extension.COMBINATION_COUNT,
    syntax:            ?extension.LIST,
    base:              "none",
};
