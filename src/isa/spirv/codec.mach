# the spir-v codec: the rows, their keys and dispatch, the field table and the stream
#
# the rows and their dispatch are generated (gen_row, gen_dispatch), and the codec that names them is written here, so
# the generated rows depend on the field kinds by index alone and the stream, which reads the rows, depends on no
# codec. spir-v names no register, so its file holds none, and an instruction's encoding states no form.

#[testing]
use std.types.bool.bool;
#[testing]
use std.types.bool.false;
#[testing]
use std.types.bool.true;
#[testing]
use std.types.error.err;
#[testing]
use std.types.result.res;
#[testing]
use std.types.size.usize;
#[testing]
use std.types.string.str;
#[testing]
use std.types.string.str_len;

#[testing]
use A: std.allocator;
#[testing]
use std.allocator.testing;
#[testing]
use std.collections.vector;

#[testing]
use masc.codec.walk;
#[testing]
use masc.core.diagnostic;
use masc.core.dispatch;
#[testing]
use masc.core.extension;
#[testing]
use masc.core.field;
use masc.core.form;
use masc.core.index;
#[testing]
use masc.core.inst;
#[testing]
use masc.core.operand;
use masc.core.quantity;
use masc.core.register;
#[testing]
use masc.core.requirement;
use masc.core.row;
#[testing]
use masc.core.state;

#[testing]
use spirv_extension: masc.isa.spirv.extension;
use spirv_field:     masc.isa.spirv.field;
#[testing]
use spirv_kind:      masc.isa.spirv.kind;
use spirv_stream:    masc.isa.spirv.stream;

use masc.isa.spirv.gen_dispatch;
use masc.isa.spirv.gen_row;
use masc.isa.spirv.gen_row_index;

# the register file of a set that names no register
pub val FILE: register.File = register.File{
    quantities:     quantity.NO_QUANTITIES,
    bindings:       quantity.NO_BINDINGS,
    slot_count:     0,
    classes:        nil,
    class_count:    0,
    class_names:    index.NO_ENTRIES,
    registers:      nil,
    register_count: 0,
    aliases:        nil,
    alias_count:    0,
    names:          index.NO_ENTRIES,
    columns:        nil,
    column_count:   0,
};

# spir-v's codec, whose file has no quantity an element width names
pub val CODEC: dispatch.Codec = dispatch.Codec{
    fields:    ?spirv_field.TABLE,
    registers: ?FILE,
    rows:      row.Rows{at: ?gen_row.ROWS[0], len: gen_row.COUNT},
    keys:      index.Index{at: ?gen_row.KEYS[0], len: gen_row.COUNT},
    dispatch:  ?gen_dispatch.DISPATCH,
    element:   0,
    forms:     form.NO_FORM_FIELDS,
    stream:    ?spirv_stream.HOOKS,
};

# a test's selection and context, its stream begun with %1 a 32-bit unsigned integer type and %2 to %4 the imports of
# GLSL.std.450, OpenCL.std and NonSemantic.Shader.DebugInfo.100, and its output
#[testing]
rec T {
    t:      testing.Testing;
    s:      extension.Selection;
    v:      register.Available;
    ctx:    state.Context;
    out:    vector.Vector[u8];
    fixups: vector.Vector[field.Fixup];
    pool:   [64]operand.Value;
    used:   u32;
}

#[testing]
fun t_text(s: str) operand.Value {
    ret operand.Value.literal{operand.Bytes{at: s, len: str_len(s)::u32}};
}

# what `r` defines with `values` added to the test's stream
#[testing]
fun t_define(t: *T, r: *row.Row, values: *operand.Value) bool {
    var ins:  inst.Inst          = inst.Inst{row: r, values: values, count: r.operands.len};
    val seen: err[field.Refusal] = spirv_stream.HOOKS.observe(t.ctx.stream, ?ins);
    ret sel seen.ok;
}

# a test over the selection of `ids`
#[testing]
fun t_make(t: *T, ids: requirement.Ids) bool {
    testing.make(?t.t);
    val a:    *A.Allocator                            = testing.allocator_of(?t.t);
    val made: res[extension.Request, extension.Error] = extension.request(a, ?spirv_extension.CATALOG, "", diagnostic.START);
    if (sel made.err) { ret false; }
    var req: extension.Request = made.ok;
    extension.request_add(?req, spirv_extension.id.SPV1_0);
    var i: u32 = 0;
    for (i < ids.len) {
        extension.request_add(?req, ids.at[i]);
        i = i + 1;
    }
    val closed: res[extension.Selection, extension.Error] = extension.close(req);
    if (sel closed.err) { ret false; }
    t.s = closed.ok;
    val opened: res[state.Context, state.Opened] = state.open(a, ?FILE, ?t.s, ?spirv_extension.AXES, state.initial(?spirv_extension.AXES), ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx    = opened.ok;
    t.out    = vector.init[u8](a);
    t.fixups = vector.init[field.Fixup](a);
    t.used   = 0;
    val stream: res[ptr, A.Error] = spirv_stream.HOOKS.make(a);
    if (sel stream.err) { ret false; }
    spirv_stream.HOOKS.begin(stream.ok);
    t.ctx.stream = stream.ok;
    var int: [3]operand.Value = [3]operand.Value{operand.Value.id{1}, operand.Value.immediate{32}, operand.Value.immediate{0}};
    if (!t_define(t, ?gen_row.ROWS[gen_row_index.OPTYPEINT], ?int[0])) { ret false; }
    val sets: [3]str = [3]str{"GLSL.std.450", "OpenCL.std", "NonSemantic.Shader.DebugInfo.100"};
    i = 0;
    for (i < 3) {
        var import: [2]operand.Value = [2]operand.Value{operand.Value.id{i + 2}, t_text(sets[i])};
        if (!t_define(t, ?gen_row.ROWS[gen_row_index.OPEXTINSTIMPORT], ?import[0])) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun t_release(t: *T) {
    spirv_stream.HOOKS.release(testing.allocator_of(?t.t), t.ctx.stream);
}

#[testing]
fun t_encode(t: *T, r: *row.Row, values: *operand.Value) res[usize, field.Refusal] {
    var ins: inst.Inst = inst.Inst{row: r, values: values, count: r.operands.len};
    ret walk.encode(?CODEC, ?t.ctx, ?ins, ?t.out, ?t.fixups);
}

#[testing]
fun t_encoded(t: *T, r: *row.Row, values: *operand.Value) bool {
    val wrote: res[usize, field.Refusal] = t_encode(t, r, values);
    ret sel wrote.ok;
}

# whether the output is exactly the `n` words at `want`
#[testing]
fun t_words(t: *T, want: *u32, n: usize) bool {
    if (t.out.len != n * 4) { ret false; }
    var i: usize = 0;
    for (i < n * 4) {
        if (t.out.data[i] != ((want[i / 4] >> ((i % 4) * 8)::u32) & 0xFF)::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a value of operand `desc` the test's context admits: the id of the 32-bit type, the import of set `set` for the set
# operand, a member the context admits with its params, a group of its members, a string or a word of the type's width,
# and one value of a variadic operand. none for an enumeration of no member the context admits
#[testing]
fun t_value(t: *T, desc: *operand.Operand, set: u64, out: *operand.Value) bool {
    if (desc.quantity == operand.VARIADIC) {
        if (t.used >= 64) { ret false; }
        val at: u32 = t.used;
        t.used = t.used + 1;
        var one: operand.Operand = @desc;
        one.quantity = operand.ONE;
        if (!t_value(t, ?one, set, ?t.pool[at])) { ret false; }
        @out = operand.Value.list{operand.Values{at: ?t.pool[at], len: 1}};
        ret true;
    }
    val shape: *operand.Shape = ?desc.shape;
    if (sel shape.id) {
        var id: u32 = 1;
        if (set != 0) { id = set::u32 + 1; }
        @out = operand.Value.id{id};
        ret true;
    }
    if (sel shape.immediate) {
        @out = operand.Value.immediate{7};
        ret true;
    }
    if (sel shape.literal) {
        if (shape.literal.content == operand.STRING) { @out = t_text("ab"); }
        or                                           { @out = t_text("\x07\x01\x02\x03"); }
        ret true;
    }
    if (sel shape.enumerant) {
        val e: *operand.Enumeration = ?shape.enumerant;
        var i: u32                  = 0;
        for (i < e.count && !state.admits(?t.ctx, e.members[i].requires)) { i = i + 1; }
        if (i == e.count) { ret false; }
        val m: *operand.Enumerant = ?e.members[i];
        val n: u32                = operand.param_count(e, m.value);
        if (t.used + n > 64) { ret false; }
        val at: u32 = t.used;
        t.used = t.used + n;
        var k: u32 = 0;
        for (k < n) {
            if (!t_value(t, operand.param(e, m.value, k), 0, ?t.pool[at + k])) { ret false; }
            k = k + 1;
        }
        var params: operand.Values = operand.Values{at: ?t.pool[at], len: n};
        if (n == 0) { params = operand.NO_VALUES; }
        @out = operand.Value.enumerant{operand.Chosen{value: m.value, params: params}};
        ret true;
    }
    if (sel shape.group) {
        val n: u32 = shape.group.len;
        if (t.used + n > 64) { ret false; }
        val at: u32 = t.used;
        t.used = t.used + n;
        var k: u32 = 0;
        for (k < n) {
            if (!t_value(t, ?shape.group.at[k], 0, ?t.pool[at + k])) { ret false; }
            k = k + 1;
        }
        @out = operand.Value.group{operand.Values{at: ?t.pool[at], len: n}};
        ret true;
    }
    ret false;
}

# the ids a selection must hold for `r` and the members of its enumerations: the first alternative of the row's
# requirement, and of an enumeration's first member where no member requires nothing
#[testing]
fun t_needs(r: *row.Row, out: *requirement.Id, cap: u32) u32 {
    var n: u32 = 0;
    if (r.requires.len > 0) {
        val alt: requirement.Ids = r.requires.at[0].all;
        var i:   u32             = 0;
        for (i < alt.len && n < cap) {
            out[n] = alt.at[i];
            n      = n + 1;
            i      = i + 1;
        }
    }
    var k: u32 = 0;
    for (k < r.operands.len) {
        val shape: *operand.Shape = ?r.operands.at[k].shape;
        if (sel shape.enumerant) {
            val e:    *operand.Enumeration = ?shape.enumerant;
            var free: bool                 = false;
            var i:    u32                  = 0;
            for (i < e.count) {
                if (e.members[i].requires.len == 0) { free = true; }
                i = i + 1;
            }
            if (!free && e.count > 0 && e.members[0].requires.len > 0) {
                val alt: requirement.Ids = e.members[0].requires.at[0].all;
                i = 0;
                for (i < alt.len && n < cap) {
                    out[n] = alt.at[i];
                    n      = n + 1;
                    i      = i + 1;
                }
            }
        }
        k = k + 1;
    }
    ret n;
}

# the import code of the set a row's set field names, 0 for a row of none
#[testing]
fun t_set(r: *row.Row, op: u32) u64 {
    var j: u32 = 0;
    for (j < r.encoding.len) {
        val f: *field.Field = ?r.encoding.at[j];
        if (f.kind == spirv_kind.EXTSET && f.operand::u32 == op) { ret f.param; }
        j = j + 1;
    }
    ret 0;
}

test walk__every_row_encodes_and_decodes_back_to_itself {
    var i: u32 = 0;
    for (i < CODEC.rows.len) {
        val r:     *row.Row = ?CODEC.rows.at[i];
        var needs: [16]requirement.Id;
        val n:     u32      = t_needs(r, ?needs[0], 16);
        var t:     T;
        if (!t_make(?t, requirement.Ids{at: ?needs[0], len: n})) { ret 1; }
        var values: [row.MAX_OPERANDS]operand.Value;
        var k:      u32 = 0;
        for (k < r.operands.len) {
            if (!t_value(?t, ?r.operands.at[k], t_set(r, k), ?values[k])) { ret 2; }
            k = k + 1;
        }
        val wrote: res[usize, field.Refusal] = t_encode(?t, r, ?values[0]);
        if (sel wrote.err) { ret 3; }
        var store: [64]operand.Value;
        var room:  [8]requirement.Alternative;
        var alts:  field.Admissions                 = field.Admissions{at: ?room[0], cap: 8, used: 0};
        val got:   res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.ctx, t.out.data, t.out.len, 0, ?store[0], 64, ?alts);
        if (sel got.err)             { ret 4; }
        if (got.ok.inst.row != r)    { ret 5; }
        if (got.ok.len != t.out.len) { ret 6; }
        k = 0;
        for (k < r.operands.len) {
            if (!operand.equal(?store[k], ?values[k])) { ret 7; }
            k = k + 1;
        }
        t_release(?t);
        i = i + 1;
    }
    ret 0;
}

# the lead word's high half is the instruction's word count, computed from its operands
test encode__the_word_count_is_computed_from_the_operands {
    var t: T;
    if (!t_make(?t, requirement.NO_IDS)) { ret 1; }
    var values: [3]operand.Value = [3]operand.Value{operand.Value.id{5}, operand.Value.immediate{64}, operand.Value.immediate{1}};
    if (!t_encoded(?t, ?gen_row.ROWS[gen_row_index.OPTYPEINT], ?values[0])) { ret 2; }
    val want: [4]u32 = [4]u32{0x0004_0015, 5, 64, 1};
    if (!t_words(?t, ?want[0], 4)) { ret 3; }
    t_release(?t);
    ret 0;
}

# a string takes its bytes and a nul, padded with nuls to a word, a whole word of them when it fills its last
test encode__a_string_pads_to_a_word {
    var t: T;
    if (!t_make(?t, requirement.NO_IDS)) { ret 1; }
    var named: [2]operand.Value = [2]operand.Value{operand.Value.id{1}, t_text("ab")};
    if (!t_encoded(?t, ?gen_row.ROWS[gen_row_index.OPNAME], ?named[0])) { ret 2; }
    val short: [3]u32 = [3]u32{0x0003_0005, 1, 0x0000_6261};
    if (!t_words(?t, ?short[0], 3)) { ret 3; }
    t.out.len = 0;
    var full: [2]operand.Value = [2]operand.Value{operand.Value.id{1}, t_text("abcd")};
    if (!t_encoded(?t, ?gen_row.ROWS[gen_row_index.OPNAME], ?full[0])) { ret 4; }
    val whole: [4]u32 = [4]u32{0x0004_0005, 1, 0x6463_6261, 0};
    if (!t_words(?t, ?whole[0], 4)) { ret 5; }
    t_release(?t);
    ret 0;
}

# an enumerant's params follow it in order, and decode reads them back as its params
test walk__an_enumerants_params_follow_it {
    var t: T;
    if (!t_make(?t, requirement.NO_IDS)) { ret 1; }
    var sizes:  [3]operand.Value = [3]operand.Value{operand.Value.immediate{8}, operand.Value.immediate{4}, operand.Value.immediate{2}};
    var values: [2]operand.Value = [2]operand.Value{operand.Value.id{3}, operand.Value.enumerant{operand.Chosen{value: 17, params: operand.Values{at: ?sizes[0], len: 3}}}};
    if (!t_encoded(?t, ?gen_row.ROWS[gen_row_index.OPEXECUTIONMODE], ?values[0])) { ret 2; }
    val want: [6]u32 = [6]u32{0x0006_0010, 3, 17, 8, 4, 2};
    if (!t_words(?t, ?want[0], 6)) { ret 3; }
    var store: [16]operand.Value;
    var room:  [8]requirement.Alternative;
    var alts:  field.Admissions                 = field.Admissions{at: ?room[0], cap: 8, used: 0};
    val got:   res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.ctx, t.out.data, t.out.len, 0, ?store[0], 16, ?alts);
    if (sel got.err)                                                     { ret 4; }
    if (got.ok.inst.row != ?gen_row.ROWS[gen_row_index.OPEXECUTIONMODE]) { ret 5; }
    if (!operand.equal(?store[1], ?values[1]))                           { ret 6; }
    t_release(?t);
    ret 0;
}

# a capability's selection holds the capabilities it depends on, as Shader's holds Matrix
test catalog__a_capability_implies_its_dependencies {
    var t:   T;
    val ids: [1]requirement.Id = [1]requirement.Id{spirv_extension.id.SHADER};
    if (!t_make(?t, requirement.Ids{at: ?ids[0], len: 1})) { ret 1; }
    if (!extension.has(?t.s, spirv_extension.id.MATRIX))   { ret 2; }
    if (extension.has(?t.s, spirv_extension.id.KERNEL))    { ret 3; }
    t_release(?t);
    ret 0;
}
