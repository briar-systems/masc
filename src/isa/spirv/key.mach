# the spir-v decode dispatch keys
#
# a key reads one word of an instruction without consuming it: the opcode in the lead word's low half, then for
# OpSpecConstantOp the operation its fourth word holds, and for an extended instruction the import code the stream
# names its set id by and the instruction number its fifth word holds. the generator splits its dispatch over the same
# four keys in this order (gen/src/isa/spirv.mach, KEYS), each a word of its own. a key past the instruction's word
# count is refused, so the dispatch never reads the next instruction's words as this one's.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use masc.core.dispatch;
use masc.core.field;
use masc.core.state;

use spirv_field:  masc.isa.spirv.field;
use spirv_kind:   masc.isa.spirv.kind;
use spirv_stream: masc.isa.spirv.stream;

# word `k` of the instruction at `at`, refused past its word count
fun word(s: *field.Stream, at: usize, k: usize) res[u64, field.Refusal] {
    val lead: res[u64, field.Refusal] = field.read(s, at, 4);
    if (sel lead.err)                { ret lead; }
    if ((lead.ok >> 16)::usize <= k) { ret res[u64, field.Refusal].err{field.refusal(field.LENGTH, field.NO_OPERAND, at)}; }
    ret field.read(s, at + k * 4, 4);
}

fun opcode(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val lead: res[u64, field.Refusal] = field.read(s, at, 4);
    if (sel lead.err) { ret lead; }
    ret res[u64, field.Refusal].ok{lead.ok & 0xFFFF};
}

fun operation(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret word(s, at, 3);
}

# the import code of the set the instruction's set id names in the stream
fun set(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val id: res[u64, field.Refusal] = word(s, at, 3);
    if (sel id.err)                      { ret id; }
    if (ctx == nil || ctx.stream == nil) { ret res[u64, field.Refusal].err{field.refusal(spirv_field.UNSTREAMED, field.NO_OPERAND, at)}; }
    val code: opt[u32] = spirv_stream.space(ctx.stream, spirv_kind.IMPORTS, id.ok::u32);
    if (sel code.none) { ret res[u64, field.Refusal].err{field.refusal(spirv_field.OTHER_SET, field.NO_OPERAND, at)}; }
    ret res[u64, field.Refusal].ok{code.some::u64};
}

fun instruction(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret word(s, at, 4);
}

# the runtime keys, in the generator's order
pub val KEYS: [4]dispatch.Key = [4]dispatch.Key{
    dispatch.Key{name: "opcode", extract: opcode},
    dispatch.Key{name: "operation", extract: operation},
    dispatch.Key{name: "set", extract: set},
    dispatch.Key{name: "instruction", extract: instruction},
};
