# the spir-v set's assembly source dialect, spirv-as's
#
# a statement is one line, `;` starts a comment, and the dialect has no directives: a module states its capabilities
# and extensions as instructions of its own. OpCapability adds its capability and OpExtension its extension to the
# selection the instructions after it are read under, so a module is read under what it declares. an extension masc's
# catalog does not name gates none of its rows, so it widens nothing.

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;
use std.types.view.View;

use masc.core.extension;
use masc.core.inst;
use masc.core.operand;
use masc.core.requirement;
use masc.core.source;

use spirv_extension: masc.isa.spirv.extension;
use spirv_kind:      masc.isa.spirv.kind;

use masc.isa.spirv.gen_operand;
use masc.isa.spirv.gen_row;

# the catalog atom of the capability of value `value`, a binary search of the atoms by value
fun capability(value: u32) requirement.Ids {
    var lo: u32 = 0;
    var hi: u32 = gen_operand.CAPABILITY_ATOM_COUNT;
    for (lo < hi) {
        val mid: u32              = lo + (hi - lo) / 2;
        val a:   *spirv_kind.Atom = ?gen_operand.CAPABILITY_ATOMS[mid];
        if (a.value == value) { ret requirement.Ids{at: ?a.id, len: 1}; }
        if (a.value < value)  { lo = mid + 1; }
        or                    { hi = mid; }
    }
    ret requirement.NO_IDS;
}

# the extension the literal `v` names, the empty list for one the catalog does not name
fun named(v: *operand.Value) requirement.Ids {
    if (!sel v.literal) { ret requirement.NO_IDS; }
    val bytes: operand.Bytes             = v.literal;
    val found: opt[*extension.NameEntry] = extension.entry(?spirv_extension.CATALOG, View{data: bytes.at, len: bytes.len::usize}, false);
    if (sel found.none) { ret requirement.NO_IDS; }
    ret found.some.rows;
}

# what `ins` widens the selection by: OpCapability its capability, OpExtension its extension
fun widens(ins: *inst.Inst) requirement.Ids {
    if (ins.count < 1) { ret requirement.NO_IDS; }
    if (ins.row == gen_row.OPCAPABILITY) {
        val v: *operand.Value = ?ins.values[0];
        if (sel v.enumerant) { ret capability(v.enumerant.value); }
        ret requirement.NO_IDS;
    }
    if (ins.row == gen_row.OPEXTENSION) { ret named(?ins.values[0]); }
    ret requirement.NO_IDS;
}

pub val SOURCE: source.Source = source.Source{
    comment:    ";",
    separator:  '\n',
    types:      "",
    align:      source.ALIGN_BYTES,
    widths:     source.Widths{at: nil, len: 0},
    directives: source.NO_DIRECTIVES,
    mapping:    source.NO_MAPPING,
    widens:     widens,
};

# the bytes of the instruction at `at`, its lead word's count of words, or the bytes left where they are fewer or the
# count is none
pub fun parcel(data: *u8, len: usize, at: usize) usize {
    val left: usize = len - at;
    if (left < 4) { ret left; }
    val count: usize = data[at + 2]::usize | (data[at + 3]::usize << 8);
    if (count == 0)       { ret 4; }
    if (count * 4 > left) { ret left; }
    ret count * 4;
}
