# the types a spir-v row operates on, which the grammar does not state, since it names every value an IdRef
#
# a typing holds a row's slots, its result and its own operands by their index among the row's operands, to forms: the
# number a slot's type is a scalar or vector of, its shape, its component count, width and widest width, how it relates to the
# type of another slot, and whether it must be a constant, up to which version, of what value and under which of the
# row's image Dims. a pointer slot's form holds the type it points to. a typed row states as well the types its data
# operand's pointee may be and the capability each needs, as the atomics do. the generator writes the typings of
# gen/data/spirv/typings.txt into gen_typing, sorted by row, and a row with no typing is checked by no form. a reader
# holds a declaration to the forms where it is declared and a call to the typed capabilities where the storage it
# reaches is known.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.string.str;

use masc.core.requirement;

# the number a slot's type is a scalar or a vector of
# ---
# ANY:      any type the slot's kind admits
# FLOAT:    floats
# INTEGER:  integers of either signedness
# SIGNED:   signed integers
# UNSIGNED: unsigned integers
# NUMBER:   integers or floats
# TRUTH:    a truth value, which the program holds as an integer of 1 or 0 and the instruction as spir-v's boolean
pub def Class: u8;
pub val ANY:      Class = 0;
pub val FLOAT:    Class = 1;
pub val INTEGER:  Class = 2;
pub val SIGNED:   Class = 3;
pub val UNSIGNED: Class = 4;
pub val NUMBER:   Class = 5;
pub val TRUTH:    Class = 6;

# whether a slot's type is a scalar, a vector, or either
pub def Shape: u8;
pub val EITHER: Shape = 0;
pub val SCALAR: Shape = 1;
pub val VECTOR: Shape = 2;

# how a slot's type relates to the type of the slot `to`, a pointer slot's being the type it points to
# ---
# NONE:      to no other slot
# SAME:      it is that type
# COMPONENT: it is that type's component, a scalar's being itself
# LANES:     it has as many components as that type
# TEXEL:     its component is the texel scalar of the image that slot is, a sampled image's being its image's
# FORMAT:    as TEXEL, with at least as many components as the image's format stores, any for an unknown format
# COMPOSED:  it is a sampled image whose image is that slot's type
pub def Relation: u8;
pub val NONE:      Relation = 0;
pub val SAME:      Relation = 1;
pub val COMPONENT: Relation = 2;
pub val LANES:     Relation = 3;
pub val TEXEL:     Relation = 4;
pub val FORMAT:    Relation = 5;
pub val COMPOSED:  Relation = 6;

# what a constant slot's value must be
# ---
# ANY_VALUE: any value
# ZERO:      zero in every component, as a SubpassData image's coordinate
# POWER:     a power of two, so at least 1, as a clustered operation's ClusterSize
pub def Value: u8;
pub val ANY_VALUE: Value = 0;
pub val ZERO:      Value = 1;
pub val POWER:     Value = 2;

# the slot of a row's result, which no operand index reaches
pub val RESULT: u8 = 0xFF;

# a slot no fact names
pub val ABSENT: u8 = 0xFE;

# the capability of a typed type every module holds
pub val NO_CAPABILITY: requirement.Id = 0xFFFF_FFFF;

# the version of a rule no version lifts
pub val NO_VERSION: requirement.Id = 0xFFFF_FFFF;

# what one slot's type must be
# ---
# slot:     the row operand it holds, RESULT for the result
# class:    the number its type is a scalar or vector of
# shape:    whether it is a scalar, a vector or either
# lanes:    its component count, 0 for any
# bits:     its component's width, 0 for any
# widest:   its component's widest width, 0 for any
# relation: how it relates to slot `to`
# to:       the row operand it relates to, RESULT for the result
# constant: whether it must be the id of a constant instruction
# until:    the version from which it need not be, NO_VERSION where every version holds it
# value:    what the constant's value must be
# dims:     the Dims of the row's image under which it must be a constant of that value, bit n for the Dim of value n,
#           0 for any
pub rec Form {
    slot:     u8;
    class:    Class;
    shape:    Shape;
    lanes:    u8;
    bits:     u8;
    widest:   u8;
    relation: Relation;
    to:       u8;
    constant: bool;
    until:    requirement.Id;
    value:    Value;
    dims:     u32;
}

# one type a typed row's data operand may point to, and what a use of it needs
# ---
# float:      whether it is a float, else an integer of either signedness
# bits:       its width
# capability: the capability it needs, NO_CAPABILITY for one every module holds
pub rec Typed {
    float:      bool;
    bits:       u8;
    capability: requirement.Id;
}

# an optional operand a call passes exactly when an enumerant operand holds one value, as a subgroup operation's
# ClusterSize follows its ClusteredReduce, which the grammar does not state, since the enumerant brings no params
# ---
# operand:  the optional operand, ABSENT for none
# when:     the enumerant operand
# value:    the value that brings it
# constant: whether it must be a constant
pub rec Presence {
    operand:  u8;
    when:     u8;
    value:    u32;
    constant: bool;
}

# what an image instruction holds its image and its Image Operands to, which spir-v's image instructions and the
# vulkan environment state and the grammar does not
# ---
# image:        the image or sampled image operand, ABSENT for a row that states none
# mask:         the Image Operands operand, ABSENT for a row that takes none
# admits:       the Image Operands bits a call may set
# one:          bits of which a call sets exactly one, 0 for none
# exclusive:    bits of which a call sets at most one
# paired:       bits a call sets only with a bit of `pairing`
# pairing:      the bits a `paired` bit needs
# sampled:      bits a call sets exactly where the image is multisampled
# uncubed:      bits a call never sets on a Cube image
# constants:    bits whose operands must be constants
# dims:         the Dims the image may have, bit n for the Dim of value n, 0 for any
# depth:        whether the image must be a depth image, its Depth not 0
# multisampled: whether the image must be multisampled (YES), must not be (NO), or either (EITHER_WAY)
# arrayed:      whether the image must be arrayed (YES), must not be (NO), or either (EITHER_WAY)
# levels:       whether the image must have levels of detail to choose, being single-sampled, sampled and of no
#               Buffer or Rect Dim (YES), must have none (NO), or either (EITHER_WAY)
# unformatted:  the capability a call needs where its image's format is Unknown and its Dim is not SubpassData,
#               NO_CAPABILITY for none
# formats:      the Image Formats the image may have, bit n for the format of value n, 0 for any
pub rec Imaged {
    image:        u8;
    mask:         u8;
    admits:       u32;
    one:          u32;
    exclusive:    u32;
    paired:       u32;
    pairing:      u32;
    sampled:      u32;
    uncubed:      u32;
    constants:    u32;
    dims:         u32;
    depth:        bool;
    multisampled: u8;
    arrayed:      u8;
    levels:       u8;
    unformatted:  requirement.Id;
    formats:      u64;
}

# the execution models an instruction executes in, which the specification states in its prose and the grammar does
# not, as the derivatives and the implicit-lod forms execute in Fragment
# ---
# models: the models, bit n for the ExecutionModel of value n, 0 for any
# names:  the models as the specification names them, for a refusal to quote
pub rec Executes {
    models: u32;
    names:  str;
}

# whether an image must hold a property, must not, or may either way
pub val EITHER_WAY: u8 = 0;
pub val YES:        u8 = 1;
pub val NO:         u8 = 2;

# the forms, typed types and image rules of one row
# ---
# row:       the row, by its index among the set's rows
# forms:     its forms, by slot
# count:     how many forms
# data:      the operand whose pointee the typed types are, ABSENT for an untyped row
# typed:     the types it may point to
# types:     how many types
# present:   its optional operand an enumerant value brings
# image:     what it holds its image and Image Operands to
# executes:  the execution models it executes in
# withdrawn: why no environment admits it, which a refusal quotes, nil where one may
pub rec Typing {
    row:       u32;
    forms:     *Form;
    count:     u32;
    data:      u8;
    typed:     *Typed;
    types:     u32;
    present:   Presence;
    image:     Imaged;
    executes:  Executes;
    withdrawn: str;
}

# the number an image format's texels are read as, which vulkan's image format and type matching states and the
# grammar does not: an image of the format reads and writes texels of that class and width, the format storing `lanes`
# of their components
# ---
# value: the format, by its Image Format value
# class: FLOAT, SIGNED or UNSIGNED
# bits:  the width of a texel's component as the instructions read it
# lanes: how many components the format stores
pub rec Format {
    value: u32;
    class: Class;
    bits:  u8;
    lanes: u8;
}

# the format of value `value` among `at`'s `len` formats, sorted by value, none for a format with none, as Unknown
pub fun format_of(at: *Format, len: u32, value: u32) opt[*Format] {
    var low:  u32 = 0;
    var high: u32 = len;
    for (low < high) {
        val mid: u32 = low + (high - low) / 2;
        if (at[mid].value == value) { ret opt[*Format].some{?at[mid]}; }
        if (at[mid].value < value)  { low = mid + 1; }
        or                          { high = mid; }
    }
    ret opt[*Format].none{};
}

# the typing of the row at `row` among `at`'s `len` typings, sorted by row, none for a row with none
pub fun of(at: *Typing, len: u32, row: u32) opt[*Typing] {
    var low:  u32 = 0;
    var high: u32 = len;
    for (low < high) {
        val mid: u32 = low + (high - low) / 2;
        if (at[mid].row == row) { ret opt[*Typing].some{?at[mid]}; }
        if (at[mid].row < row)  { low = mid + 1; }
        or                      { high = mid; }
    }
    ret opt[*Typing].none{};
}
