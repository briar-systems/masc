# the spir-v field kinds by their index in the set's field table, and its id spaces
#
# the generated rows name each field's kind and each id operand's space by these, and `masc.isa.spirv.field` holds
# the table the indices point into, so the rows depend on no kind's code.

use masc.core.requirement;

# the kind of the lead word: the opcode in its low half and the word count the instruction's length gives in its high
pub val LEAD: u16 = 0;

# the kind of one whole operand, every value of a variadic one and its params or members, read by its shape
pub val OPERAND: u16 = 1;

# the kind of an extended instruction's set operand, an id that must name an import of the row's set
pub val EXTSET: u16 = 2;

# the kind of a fixed word, as OpSpecConstantOp's operation and an extended instruction's number
pub val WORD: u16 = 3;

# the id space of every result id
pub val IDS: u16 = 0;

# the space of extended instruction set imports: an id OpExtInstImport defines names its set's import code there
pub val IMPORTS: u16 = 1;

# a catalog atom by the value a module states it by: a capability by its value, as OpCapability states it, and a core
# version by its header word
# ---
# value: the value
# id:    its catalog atom
pub rec Atom {
    value: u32;
    id:    requirement.Id;
}
