# a spir-v module as its text states it, its instruction stream
#
# the text is a module's instructions in module order, and states no section, no header and no id bound: the
# header's version is the target the selection states, its generator the tool that wrote the module, and its bound
# follows from the ids. masc's builder makes one section of the stream from that text, and mink builds the module
# from it, writing the capabilities, extensions and memory model from the object's facts and traits where the logical
# layout puts them, so the module mink builds from any object of the format is one section again: its instructions in
# order, those mink writes from the object among them, each word in the byte order the builder writes. the header's
# version is the object's version trait, which the text does not state.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.table;
use mink.catalog.arch.spirv;
use spirv_model: mink.format.spirv.model;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Object;
use mink.model.object.Section;
use mink.model.section;
use mink.model.target;

use masc.core.stream;

# the module `model`, mink's model of it, as the one section of its instruction stream, added to the empty object `o`
# with the spir-v target, answering the stream's offset in the module's bytes, past the header
fun streamed(model: ptr, o: *Object) res[u64, Fail] {
    val m:     *spirv_model.Module = model::*spirv_model.Module;
    var words: usize               = 0;
    var i:     usize               = 0;
    for (i < spirv_model.count(m)) {
        words = words + 1 + spirv_model.at(m, i).count;
        i     = i + 1;
    }
    val a:     *A.Allocator      = o.a;
    val bytes: usize             = words * spirv_model.WORD;
    val got:   res[*u8, A.Error] = A.allocate[u8](a, bytes + 1);
    if (sel got.err) { ret res[u64, Fail].err{fail.refused(got.err)}; }
    val out: *u8   = got.ok;
    var at:  usize = 0;
    i = 0;
    for (i < spirv_model.count(m)) {
        val ins:  *spirv_model.Instruction = spirv_model.at(m, i);
        val lead: res[u32, Fail]           = spirv_model.lead(ins.opcode, ins.count);
        if (sel lead.err) {
            val freed: err[A.Error] = A.deallocate[u8](a, out, bytes + 1);
            ret res[u64, Fail].err{lead.err};
        }
        put(out, at, lead.ok);
        at = at + spirv_model.WORD;
        val operands: *u32  = spirv_model.operands(m, ins);
        var k:        usize = 0;
        for (k < ins.count) {
            put(out, at, operands[k]);
            at = at + spirv_model.WORD;
            k  = k + 1;
        }
        i = i + 1;
    }
    val held:  res[Contents, Fail] = object.own(o, out, bytes);
    val freed: err[A.Error]        = A.deallocate[u8](a, out, bytes + 1);
    if (sel held.err) { ret res[u64, Fail].err{held.err}; }
    val added: res[table.Id[Section], Fail] = object.add_section(o, Section{
        name:        opt[table.Id[Name]].none{},
        kind:        ?section.TEXT,
        flags:       section.TEXT.flags,
        align:       spirv_model.WORD::u64,
        entsize:     0,
        contents:    held.ok,
        owner:       opt[table.Id[Section]].none{},
        group:       opt[table.Id[object.Group]].none{},
        disposition: ?section.WHOLE,
        priority:    opt[u32].none{},
    });
    if (sel added.err) { ret res[u64, Fail].err{added.err}; }
    o.target = target.of(?spirv.SPIRV);
    ret res[u64, Fail].ok{(spirv_model.HEADER_WORDS * spirv_model.WORD)::u64};
}

# `word` written little-endian at byte `at` of `out`, as the set's builder writes every word
fun put(out: *u8, at: usize, word: u32) {
    out[at]     = (word & 0xFF)::u8;
    out[at + 1] = ((word >> 8) & 0xFF)::u8;
    out[at + 2] = ((word >> 16) & 0xFF)::u8;
    out[at + 3] = ((word >> 24) & 0xFF)::u8;
}

# a spir-v module's text, its instruction stream
pub val MODULE: stream.Module = stream.Module.stream{streamed};
