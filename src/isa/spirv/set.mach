# the spir-v set's registration record
#
# one architecture, mink's spirv, whose code enters spir-v 1.0: a module's OpCapability and OpExtension instructions
# widen what it is read under from there, and a selection states the later version a module targets. spir-v has no
# registers, no relocations a set binds, no call frames mink states and no timing, so the record names none of them.
# its stream (`masc.isa.spirv.stream`) keeps the types and imports the instructions define, which its literals and
# extended instructions read.
#
# mink writes a module's capabilities, extensions, version, addressing model and memory model from the object, not
# from its sections (mink's `mink.format.spirv.rules` and `mink.format.spirv.traits`), so the builder reads
# OpCapability and OpExtension as the facts mink keys them by, and OpMemoryModel as the addressing and memory model
# traits, which a module states once (spir-v 1.6, 2.4 "Logical Layout of a Module"). the version is the highest core
# version the selection holds, as spirv-as's `--target-env` names it, unless the source states another.

use masc.core.compress;
use masc.core.ct;
use masc.core.fixup;
use masc.core.mode;
use masc.core.operand;
use masc.core.relax;
use masc.core.requirement;
use masc.core.set;
use masc.core.state;
use masc.core.stating;
use masc.core.syntax;
use masc.core.trait;

use mink.catalog.arch.spirv;
use mink_format: mink.catalog.format;
use spirv_rules: mink.format.spirv.rules;

use spirv_codec:     masc.isa.spirv.codec;
use spirv_extension: masc.isa.spirv.extension;
use spirv_source:    masc.isa.spirv.source;
use spirv_syntax:    masc.isa.spirv.syntax;

use masc.isa.spirv.gen_operand;
use masc.isa.spirv.gen_row;

val ENTERS_IDS: [1]requirement.Id = [1]requirement.Id{spirv_extension.id.SPV1_0};

val ENTERS: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?ENTERS_IDS[0], len: 1}, none: requirement.NO_IDS}};

# mink states no unwind facts for spir-v, so its functions start in no frame state
val ARCHES: [1]set.Arch = [1]set.Arch{
    set.Arch{arch: ?spirv.SPIRV, enters: requirement.Requirement{at: ?ENTERS[0], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{0, 0, 0, 0, 0, 0, 0, 0}}, frame: nil},
};

# the version a module states where its source states none
val OWNERS: [1]trait.Owned = [1]trait.Owned{
    trait.Owned{axis: ?spirv.SPIRV_VERSION, owner: trait.Owner.chosen{requirement.Atoms{at: ?gen_operand.VERSION_ATOMS[0], len: gen_operand.VERSION_ATOM_COUNT}}},
};

# the instructions mink writes from the object: a capability and an extension facts, the memory model two traits
val STATINGS: [4]stating.Stating = [4]stating.Stating{
    stating.Stating{row: gen_row.OPCAPABILITY, operand: 0, stated: stating.Stated.fact{stating.Fact{format: ?mink_format.SPIRV, key: spirv_rules.CAPABILITY}}},
    stating.Stating{row: gen_row.OPEXTENSION, operand: 0, stated: stating.Stated.fact{stating.Fact{format: ?mink_format.SPIRV, key: spirv_rules.EXTENSION}}},
    stating.Stating{row: gen_row.OPMEMORYMODEL, operand: 0, stated: stating.Stated.trait{?spirv.SPIRV_ADDRESSING_MODEL}},
    stating.Stating{row: gen_row.OPMEMORYMODEL, operand: 1, stated: stating.Stated.trait{?spirv.SPIRV_MEMORY_MODEL}},
};

# the registration of spir-v
pub val SET: set.Set = set.Set{
    arches:      set.Arches{at: ?ARCHES[0], len: 1},
    states:      spirv_extension.AXES,
    codec:       ?spirv_codec.CODEC,
    extensions:  ?spirv_extension.CATALOG,
    bindings:    fixup.NO_BINDINGS,
    relax:       relax.NO_RELAXATIONS,
    compress:    compress.NO_COMPRESSIONS,
    fill:        nil,
    realign:     operand.NO_FIXUP,
    data:        fixup.NO_DATA,
    spans:       fixup.NO_SPANS,
    syntaxes:    syntax.Syntaxes{at: ?spirv_syntax.SYNTAX, len: 1},
    traits:      trait.Owners{at: ?OWNERS[0], len: 1},
    statings:    stating.Statings{at: ?STATINGS[0], len: 4},
    conventions: set.NO_CONVENTIONS,
    assembly:    mode.NO_MODES,
    pairs:       fixup.NO_PAIRS,
    source:      spirv_source.SOURCE,
    parcel:      spirv_source.parcel,
    config:      nil,
    ct:          ct.Timing.none{},
};
