# the wasm codec: its field kinds, its rows and their dispatch, and the stream its instructions read through
#
# wasm has no register file, so its operands name none and its codec states none. an instruction is its opcode byte,
# a prefixed one's index after its prefix as a u32 LEB128, and its immediates, each a field of its own kind
# (`masc.isa.wasm.field`), so an instruction's length is what its fields read.

use masc.core.dispatch;
use masc.core.form;
use masc.core.index;
use masc.core.row;
use wasm_field: masc.isa.wasm.field;
use masc.isa.wasm.gen_dispatch;
use masc.isa.wasm.gen_row;
use wasm_stream: masc.isa.wasm.stream;

#[testing]
use masc.codec.walk;
#[testing]
use masc.core.diagnostic;
#[testing]
use masc.core.extension;
#[testing]
use masc.core.field;
#[testing]
use masc.core.inst;
#[testing]
use masc.core.operand;
#[testing]
use masc.core.register;
#[testing]
use masc.core.requirement;
#[testing]
use masc.core.state;
#[testing]
use wasm_extension: masc.isa.wasm.extension;
#[testing]
use masc.isa.wasm.gen_extension;
#[testing]
use masc.isa.wasm.gen_index;
#[testing]
use wasm_kind: masc.isa.wasm.kind;
#[testing]
use wasm_leb:  masc.isa.wasm.leb;
#[testing]
use A:         std.allocator;
#[testing]
use std.allocator.testing;
#[testing]
use std.collections.vector;
#[testing]
use std.print;
#[testing]
use std.types.bool.bool;
#[testing]
use std.types.bool.false;
#[testing]
use std.types.bool.true;
#[testing]
use std.types.error.err;
#[testing]
use std.types.option.opt;
#[testing]
use std.types.result.res;
#[testing]
use std.types.size.usize;
#[testing]
use std.types.string.str;
#[testing]
use std.types.view.View;

pub val CODEC: dispatch.Codec = dispatch.Codec{
    fields:    ?wasm_field.TABLE,
    registers: nil,
    rows:      row.Rows{at: ?gen_row.ROWS[0], len: gen_row.COUNT},
    keys:      index.Index{at: ?gen_row.KEYS[0], len: gen_row.COUNT},
    dispatch:  ?gen_dispatch.DISPATCH,
    element:   0,
    forms:     form.NO_FORM_FIELDS,
    stream:    ?wasm_stream.HOOKS,
};

# a test's selection of every extension, its context and a stream of one memory, and its output buffers
#[testing]
rec T {
    t:      testing.Testing;
    s:      extension.Selection;
    v:      register.Available;
    ctx:    state.Context;
    out:    vector.Vector[u8];
    fixups: vector.Vector[field.Fixup];
}

# a test under every extension, its stream holding one memory of address type `address`
#[testing]
fun t_make(t: *T, address: u32) bool {
    ret t_under(t, address, true);
}

# a test under every extension or under none of them, its stream holding one memory of address type `address`
#[testing]
fun t_under(t: *T, address: u32, every: bool) bool {
    testing.make(?t.t);
    val a:    *A.Allocator                            = testing.allocator_of(?t.t);
    val made: res[extension.Request, extension.Error] = extension.request(a, ?wasm_extension.CATALOG, "", diagnostic.START);
    if (sel made.err) { ret false; }
    var req: extension.Request = made.ok;
    var id:  u32               = 0;
    for (every && id < gen_extension.COUNT) {
        extension.request_add(?req, id::requirement.Id);
        id = id + 1;
    }
    val closed: res[extension.Selection, extension.Error] = extension.close(req);
    if (sel closed.err) { ret false; }
    t.s = closed.ok;
    val opened: res[state.Context, state.Opened] = state.open(a, nil, ?t.s, ?wasm_extension.AXES, state.initial(?wasm_extension.AXES), ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx = opened.ok;
    val stream: res[ptr, A.Error] = wasm_stream.HOOKS.make(a);
    if (sel stream.err) { ret false; }
    wasm_stream.HOOKS.begin(stream.ok);
    t.ctx.stream = stream.ok;
    val memory: res[u32, str] = wasm_stream.define(stream.ok, wasm_kind.MEMORIES, address, View{data: nil, len: 0});
    if (sel memory.err) { ret false; }
    t.out    = vector.init[u8](a);
    t.fixups = vector.init[field.Fixup](a);
    ret true;
}

#[testing]
fun t_drop(t: *T) {
    wasm_stream.HOOKS.release(testing.allocator_of(?t.t), t.ctx.stream);
    vector.dnit[u8](?t.out);
    vector.dnit[field.Fixup](?t.fixups);
    val released: err[A.Error] = extension.release(?t.s);
}

#[testing]
fun t_encode(t: *T, r: *row.Row, values: *operand.Value, count: u32) res[usize, field.Refusal] {
    t.out.len    = 0;
    t.fixups.len = 0;
    var ins: inst.Inst = inst.Inst{row: r, values: values, count: count};
    ret walk.encode(?CODEC, ?t.ctx, ?ins, ?t.out, ?t.fixups);
}

# a value of each operand the walk reads back as itself: an optional operand absent, an index 1, a signed integer -2,
# an unsigned one 3, a float 1.0, a literal its 16 bytes, labels 1 and 0, a value type i32 and a catch clause of tag 2
# and label 1, its members from `pool`
#[testing]
fun t_sample(desc: *operand.Operand, pool: *operand.Value, used: *u32, bytes: *u8) opt[operand.Value] {
    val shape: *operand.Shape = ?desc.shape;
    if (desc.quantity == operand.OPTIONAL) { ret opt[operand.Value].some{operand.Value.none{}}; }
    val at: u32 = @used;
    if (desc.quantity == operand.VARIADIC) {
        if (sel shape.id) {
            pool[at]     = operand.Value.id{1};
            pool[at + 1] = operand.Value.id{0};
            @used        = at + 2;
            ret opt[operand.Value].some{operand.Value.list{operand.Values{at: ?pool[at], len: 2}}};
        }
        if (sel shape.immediate) {
            pool[at] = operand.Value.immediate{0x7f};
            @used    = at + 1;
            ret opt[operand.Value].some{operand.Value.list{operand.Values{at: ?pool[at], len: 1}}};
        }
        if (sel shape.group) {
            pool[at + 1] = operand.enumerant(wasm_kind.CATCH);
            pool[at + 2] = operand.Value.id{2};
            pool[at + 3] = operand.Value.id{1};
            pool[at]     = operand.Value.group{operand.Values{at: ?pool[at + 1], len: 3}};
            @used        = at + 4;
            ret opt[operand.Value].some{operand.Value.list{operand.Values{at: ?pool[at], len: 1}}};
        }
        ret opt[operand.Value].none{};
    }
    if (sel shape.id) { ret opt[operand.Value].some{operand.Value.id{1}}; }
    if (sel shape.immediate) {
        val imm: *operand.Immediate = ?shape.immediate;
        if (imm.format == operand.FLOAT) {
            if (imm.bits == 32) { ret opt[operand.Value].some{operand.Value.immediate{0x3F80_0000}}; }
            ret opt[operand.Value].some{operand.Value.immediate{0x3FF0_0000_0000_0000}};
        }
        # a heap type's s33 is func's, an abstract one
        if (imm.bits == 33)             { ret opt[operand.Value].some{operand.Value.immediate{0x70 - 0x80}}; }
        if (imm.sign == operand.SIGNED) { ret opt[operand.Value].some{operand.Value.immediate{-2}}; }
        ret opt[operand.Value].some{operand.Value.immediate{3}};
    }
    if (sel shape.literal) {
        var i: u32 = 0;
        for (i < 16) {
            bytes[i] = i::u8;
            i        = i + 1;
        }
        ret opt[operand.Value].some{operand.Value.literal{operand.Bytes{at: bytes, len: 16}}};
    }
    ret opt[operand.Value].none{};
}

# the entry of the specification's index the opcode at the start of `t.out` names, as the row's key reads it
#[testing]
fun t_indexed(t: *T) bool {
    var prefix: u32 = 0;
    var code:   u32 = t.out.data[0]::u32;
    if (code >= 0xFB) {
        val read: res[wasm_leb.Read, field.Refusal] = wasm_leb.unsigned(t.out.data, t.out.len, 1, 32, 0);
        if (sel read.err) { ret false; }
        prefix = code;
        code   = read.ok.value::u32;
    }
    var i: u32 = 0;
    for (i < gen_index.INDEX_COUNT) {
        val e: wasm_kind.Indexed = gen_index.INDEX[i];
        if (e.prefix == prefix && e.code == code) { ret e.named; }
        i = i + 1;
    }
    i = 0;
    for (i < gen_index.UNINDEXED_COUNT) {
        if (gen_index.UNINDEXED[i] == prefix) { ret true; }
        i = i + 1;
    }
    ret false;
}

# every row encodes a value of each operand, decodes back to its own row, its values and its length, and its opcode is
# one the specification's index names
test walk__every_row_encodes_and_decodes_back_to_itself {
    var t: T;
    if (!t_make(?t, wasm_stream.I32)) { ret 1; }
    var i: u32 = 0;
    for (i < CODEC.rows.len) {
        val r:      *row.Row = ?CODEC.rows.at[i];
        var values: [row.MAX_OPERANDS]operand.Value;
        var pool:   [16]operand.Value;
        var bytes:  [16]u8;
        var used:   u32      = 0;
        var k:      u32      = 0;
        for (k < r.operands.len) {
            val got: opt[operand.Value] = t_sample(?r.operands.at[k], ?pool[0], ?used, ?bytes[0]);
            if (sel got.none) { ret 2; }
            values[k] = got.some;
            k         = k + 1;
        }
        val wrote: res[usize, field.Refusal] = t_encode(?t, r, ?values[0], r.operands.len);
        if (sel wrote.err) {
            print.eprintlnf("{}: {} (operand {})", r.mnemonic, wrote.err.message, wrote.err.operand);
            ret 3;
        }
        if (!t_indexed(?t)) { ret 4; }
        var store: [32]operand.Value;
        var room:  [8]requirement.Alternative;
        var alts:  field.Admissions                 = field.Admissions{at: ?room[0], cap: 8, used: 0};
        val got:   res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.ctx, t.out.data, t.out.len, 0, ?store[0], 32, ?alts);
        if (sel got.err) {
            print.eprintlnf("{}: {}", r.mnemonic, got.err.message);
            ret 5;
        }
        if (got.ok.inst.row != r)    { ret 6; }
        if (got.ok.len != t.out.len) { ret 7; }
        k = 0;
        for (k < r.operands.len) {
            if (!operand.equal(?store[k], ?values[k])) {
                print.eprintlnf("{}: operand {}", r.mnemonic, k);
                ret 8;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    t_drop(?t);
    ret 0;
}

# whether `t.out` holds exactly `want`
#[testing]
fun t_wrote(t: *T, want: *u8, len: usize) bool {
    if (t.out.len != len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (t.out.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a prefixed opcode is its prefix and its index as a LEB128, a memarg's offset is as wide as its memory's address type,
# and the decoded length is what the fields read
test walk__prefixed_opcodes_and_a_memarg_by_its_memory {
    var t: T;
    if (!t_make(?t, wasm_stream.I32)) { ret 1; }
    val none:  [2]operand.Value          = [2]operand.Value{operand.Value.none{}, operand.Value.none{}};
    val trunc: res[usize, field.Refusal] = t_encode(?t, gen_row.I32TRUNCSATF32S, ?none[0], 0);
    val sat:   [2]u8                     = [2]u8{0xFC, 0x00};
    if (sel trunc.err || !t_wrote(?t, ?sat[0], 2)) { ret 2; }
    val copy:   res[usize, field.Refusal] = t_encode(?t, gen_row.MEMORYCOPY, ?none[0], 2);
    val copied: [4]u8                     = [4]u8{0xFC, 0x0A, 0x00, 0x00};
    if (sel copy.err || !t_wrote(?t, ?copied[0], 4)) { ret 3; }
    val far:     [3]operand.Value          = [3]operand.Value{operand.Value.none{}, operand.Value.immediate{0x1_0000_0000}, operand.Value.none{}};
    val refused: res[usize, field.Refusal] = t_encode(?t, gen_row.I64LOAD, ?far[0], 3);
    if (!sel refused.err)                                                      { ret 4; }
    if (refused.err.message != field.OUT_OF_RANGE || refused.err.operand != 1) { ret 5; }
    t_drop(?t);
    var wide: T;
    if (!t_make(?wide, wasm_stream.I64)) { ret 6; }
    val load:   res[usize, field.Refusal] = t_encode(?wide, gen_row.I64LOAD, ?far[0], 3);
    val loaded: [7]u8                     = [7]u8{0x29, 0x03, 0x80, 0x80, 0x80, 0x80, 0x10};
    if (sel load.err || !t_wrote(?wide, ?loaded[0], 7)) { ret 7; }
    var store: [8]operand.Value;
    var room:  [8]requirement.Alternative;
    var alts:  field.Admissions                 = field.Admissions{at: ?room[0], cap: 8, used: 0};
    val back:  res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?wide.ctx, wide.out.data, wide.out.len, 0, ?store[0], 8, ?alts);
    if (sel back.err)                                             { ret 8; }
    if (back.ok.len != 7 || back.ok.inst.row != gen_row.I64LOAD)  { ret 9; }
    if (!operand.equal(?store[1], ?far[1]) || !sel store[2].none) { ret 10; }
    t_drop(?wide);
    ret 0;
}

# whether `r` is a refusal of admission whose requirement names extension `id`
#[testing]
fun t_needs(r: res[usize, field.Refusal], id: requirement.Id) bool {
    if (!sel r.err)                 { ret false; }
    if (!sel r.err.cause.admission) { ret false; }
    val need: requirement.Requirement = r.err.requires;
    if (need.len != 1 || need.at[0].all.len != 1) { ret false; }
    ret need.at[0].all.at[0] == id;
}

# a value type, a heap type or an index a feature adds needs the feature, on encode as the kinds admit it: v128 simd,
# funcref reference types, a table other than 0 reference types and a memory other than 0 multimemory
test walk__a_type_or_an_index_a_feature_adds_needs_it {
    var t: T;
    if (!t_under(?t, wasm_stream.I32, false)) { ret 1; }
    val i32:   [2]operand.Value          = [2]operand.Value{operand.Value.immediate{0x7F}, operand.Value.none{}};
    val v128:  [2]operand.Value          = [2]operand.Value{operand.Value.immediate{0x7B}, operand.Value.none{}};
    val func:  [2]operand.Value          = [2]operand.Value{operand.Value.immediate{0x70}, operand.Value.none{}};
    var typed: [1]operand.Value          = [1]operand.Value{operand.Value.group{operand.Values{at: ?i32[0], len: 2}}};
    val plain: res[usize, field.Refusal] = t_encode(?t, gen_row.BLOCK, ?typed[0], 1);
    if (sel plain.err) { ret 2; }
    typed[0] = operand.Value.group{operand.Values{at: ?v128[0], len: 2}};
    if (!t_needs(t_encode(?t, gen_row.BLOCK, ?typed[0], 1), wasm_extension.id.SIMD128)) { ret 3; }
    typed[0] = operand.Value.group{operand.Values{at: ?func[0], len: 2}};
    if (!t_needs(t_encode(?t, gen_row.BLOCK, ?typed[0], 1), wasm_extension.id.REFERENCE_TYPES)) { ret 4; }
    val first: [2]operand.Value          = [2]operand.Value{operand.Value.id{0}, operand.Value.id{0}};
    val other: [2]operand.Value          = [2]operand.Value{operand.Value.id{0}, operand.Value.id{1}};
    val zero:  res[usize, field.Refusal] = t_encode(?t, gen_row.CALLINDIRECT, ?first[0], 2);
    if (sel zero.err)                                                                                  { ret 5; }
    if (!t_needs(t_encode(?t, gen_row.CALLINDIRECT, ?other[0], 2), wasm_extension.id.REFERENCE_TYPES)) { ret 6; }
    val second: [1]operand.Value = [1]operand.Value{operand.Value.id{1}};
    if (!t_needs(t_encode(?t, gen_row.MEMORYSIZE, ?second[0], 1), wasm_extension.id.MULTIMEMORY)) { ret 7; }
    t_drop(?t);
    var every: T;
    if (!t_make(?every, wasm_stream.I32)) { ret 8; }
    typed[0] = operand.Value.group{operand.Values{at: ?v128[0], len: 2}};
    val simd: res[usize, field.Refusal] = t_encode(?every, gen_row.BLOCK, ?typed[0], 1);
    if (sel simd.err) { ret 9; }
    val table: res[usize, field.Refusal] = t_encode(?every, gen_row.CALLINDIRECT, ?other[0], 2);
    if (sel table.err) { ret 10; }
    t_drop(?every);
    ret 0;
}
