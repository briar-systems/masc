# the wasm codec: its field kinds, its rows and their dispatch, and the stream its instructions read through
#
# wasm has no register file, so its operands name none and its codec states none. an instruction is its opcode byte,
# a prefixed one's index after its prefix as a u32 LEB128, and its immediates, each a field of its own kind
# (`masc.isa.wasm.field`), so an instruction's length is what its fields read.

use masc.core.dispatch;
use masc.core.form;
use masc.core.index;
use masc.core.row;
use wasm_field: masc.isa.wasm.field;
use masc.isa.wasm.gen_dispatch;
use masc.isa.wasm.gen_row;
use wasm_stream: masc.isa.wasm.stream;

pub val CODEC: dispatch.Codec = dispatch.Codec{
    fields:    ?wasm_field.TABLE,
    registers: nil,
    rows:      row.Rows{at: ?gen_row.ROWS[0], len: gen_row.COUNT},
    keys:      index.Index{at: ?gen_row.KEYS[0], len: gen_row.COUNT},
    dispatch:  ?gen_dispatch.DISPATCH,
    element:   0,
    forms:     form.NO_FORM_FIELDS,
    stream:    ?wasm_stream.HOOKS,
};
