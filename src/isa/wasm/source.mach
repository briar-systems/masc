# the source facts of wasm's text format
#
# a module's text is its own reader's (`masc.isa.wasm.module`), which keeps a function body's instructions in the
# stream's order. what the shared source reader states of wasm is its line comment `;;`, and its
# text's reader passes its comments and strings for a reader of an inline block's braces. wasm has no statement
# separator within a line and no data directives, and its instructions widen nothing.

use masc.core.source;
use wasm_text: masc.isa.wasm.text;

pub val SOURCE: source.Source = source.Source{
    comment:    ";;",
    separator:  '\n',
    types:      "",
    align:      source.ALIGN_BYTES,
    widths:     source.Widths{at: nil, len: 0},
    directives: source.NO_DIRECTIVES,
    widens:     nil,
    skip:       wasm_text.skipped,
};
