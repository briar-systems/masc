# the source facts of wasm's text format
#
# a module's text is its own reader's (`masc.isa.wasm.module`), which keeps a function body's instructions in the
# stream's order. what the shared source reader states of wasm is its line comment `;;`. wasm has no statement
# separator within a line, no data directives and no mapping symbols, and its instructions widen nothing.

use masc.core.source;

pub val SOURCE: source.Source = source.Source{
    comment:    ";;",
    separator:  '\n',
    types:      "",
    align:      source.ALIGN_BYTES,
    widths:     source.Widths{at: nil, len: 0},
    directives: source.NO_DIRECTIVES,
    mapping:    source.NO_MAPPING,
    widens:     nil,
};
