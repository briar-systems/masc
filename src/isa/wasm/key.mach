# the wasm decode dispatch keys
#
# a key reads an instruction's opcode without consuming it: its first byte, then, after a prefix byte, the index its
# u32 holds. the generator splits its dispatch over the same two keys in this order (gen/src/isa/wasm.mach, KEYS). an
# index longer than a u32's five bytes, or with bits past 32, is refused, so no overlong opcode dispatches.

use std.types.result.res;
use std.types.size.usize;

use masc.core.dispatch;
use masc.core.field;
use masc.core.state;

use wasm_leb: masc.isa.wasm.leb;

fun opcode(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret field.read(s, at, 1);
}

fun index(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val got: res[wasm_leb.Read, field.Refusal] = wasm_leb.unsigned(s.data, s.len, at + 1, 32, field.NO_OPERAND);
    if (sel got.err) { ret res[u64, field.Refusal].err{got.err}; }
    ret res[u64, field.Refusal].ok{got.ok.value};
}

# the runtime keys, in the generator's order
pub val KEYS: [2]dispatch.Key = [2]dispatch.Key{
    dispatch.Key{name: "opcode", extract: opcode},
    dispatch.Key{name: "index", extract: index},
};
