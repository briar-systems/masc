# the wasm fixup kinds, the sites their relocations patch and their binding to mink's relocation kinds
#
# every relocation type the linking convention defines is one kind here, in the order of the type codes, bound to the
# kind of its row in `mink.format.wasm.reloc`, the neutral absolute or place-relative kind of its width for a memory
# address word, so the relocation numbers stay mink's. a row's symbolic operand takes one of the instruction kinds by
# default (`gen_row`), and a symbol states another, as a function's table index in an `i32.const` takes
# TABLE_INDEX_SLEB, a position-independent address MEMORY_ADDR_REL_SLEB and a thread-local one MEMORY_ADDR_TLS_SLEB.
#
# a kind's site is the field its relocation patches, as its row in mink states it: an unsigned or signed LEB128 padded
# to the field's bytes, five for 32 bits and ten for 64, or a little-endian word of its width. a symbolic operand is written as its site's
# zero, padded, so the link writes the value in place, and a resolved value with no relocation stays shortest. a field
# states its encoding and width, and a kind is moved to its form at that width, so `i64.const` of a data address takes
# MEMORY_ADDR_SLEB64 and a memarg's offset under a 64-bit memory MEMORY_ADDR_LEB64 whichever form the symbol named. a
# kind with no form at a field's width, or of another encoding, relocates no such field and is refused there
# (WebAssembly tool conventions, Linking, relocation sections).

use std.types.option.opt;
use std.types.size.usize;

use wasm_reloc: mink.format.wasm.reloc;
use mink.model.reloc;
use mink_row: mink.reloc.row;

use masc.core.fixup;
use masc.core.operand;

pub val FUNCTION_INDEX_LEB:     operand.FixupKind = 1;
pub val TABLE_INDEX_SLEB:       operand.FixupKind = 2;
pub val TABLE_INDEX_I32:        operand.FixupKind = 3;
pub val MEMORY_ADDR_LEB:        operand.FixupKind = 4;
pub val MEMORY_ADDR_SLEB:       operand.FixupKind = 5;
pub val MEMORY_ADDR_I32:        operand.FixupKind = 6;
pub val TYPE_INDEX_LEB:         operand.FixupKind = 7;
pub val GLOBAL_INDEX_LEB:       operand.FixupKind = 8;
pub val FUNCTION_OFFSET_I32:    operand.FixupKind = 9;
pub val SECTION_OFFSET_I32:     operand.FixupKind = 10;
pub val TAG_INDEX_LEB:          operand.FixupKind = 11;
pub val MEMORY_ADDR_REL_SLEB:   operand.FixupKind = 12;
pub val TABLE_INDEX_REL_SLEB:   operand.FixupKind = 13;
pub val GLOBAL_INDEX_I32:       operand.FixupKind = 14;
pub val MEMORY_ADDR_LEB64:      operand.FixupKind = 15;
pub val MEMORY_ADDR_SLEB64:     operand.FixupKind = 16;
pub val MEMORY_ADDR_I64:        operand.FixupKind = 17;
pub val MEMORY_ADDR_REL_SLEB64: operand.FixupKind = 18;
pub val TABLE_INDEX_SLEB64:     operand.FixupKind = 19;
pub val TABLE_INDEX_I64:        operand.FixupKind = 20;
pub val TABLE_NUMBER_LEB:       operand.FixupKind = 21;
pub val MEMORY_ADDR_TLS_SLEB:   operand.FixupKind = 22;
pub val FUNCTION_OFFSET_I64:    operand.FixupKind = 23;
pub val MEMORY_ADDR_LOCREL_I32: operand.FixupKind = 24;
pub val TABLE_INDEX_REL_SLEB64: operand.FixupKind = 25;
pub val MEMORY_ADDR_TLS_SLEB64: operand.FixupKind = 26;
pub val FUNCTION_INDEX_I32:     operand.FixupKind = 27;
pub val MEMORY_ADDR_LOCREL_I64: operand.FixupKind = 28;

# how many fixup kinds there are, which BINDINGS binds and SITES places
pub val COUNT: u32 = 28;

# each fixup kind and the neutral relocation kind it becomes, the same on wasm32 and wasm64, as the convention gives
# each width its own types
pub val BINDINGS: [COUNT]fixup.Binding = [COUNT]fixup.Binding{
    fixup.Binding{fixup: FUNCTION_INDEX_LEB, kind: ?wasm_reloc.FUNCTION_INDEX_LEB},
    fixup.Binding{fixup: TABLE_INDEX_SLEB, kind: ?wasm_reloc.TABLE_INDEX_SLEB},
    fixup.Binding{fixup: TABLE_INDEX_I32, kind: ?wasm_reloc.TABLE_INDEX_I32},
    fixup.Binding{fixup: MEMORY_ADDR_LEB, kind: ?wasm_reloc.MEMORY_ADDR_LEB},
    fixup.Binding{fixup: MEMORY_ADDR_SLEB, kind: ?wasm_reloc.MEMORY_ADDR_SLEB},
    fixup.Binding{fixup: MEMORY_ADDR_I32, kind: ?reloc.ABS32},
    fixup.Binding{fixup: TYPE_INDEX_LEB, kind: ?wasm_reloc.TYPE_INDEX_LEB},
    fixup.Binding{fixup: GLOBAL_INDEX_LEB, kind: ?wasm_reloc.GLOBAL_INDEX_LEB},
    fixup.Binding{fixup: FUNCTION_OFFSET_I32, kind: ?wasm_reloc.FUNCTION_OFFSET_I32},
    fixup.Binding{fixup: SECTION_OFFSET_I32, kind: ?wasm_reloc.SECTION_OFFSET_I32},
    fixup.Binding{fixup: TAG_INDEX_LEB, kind: ?wasm_reloc.TAG_INDEX_LEB},
    fixup.Binding{fixup: MEMORY_ADDR_REL_SLEB, kind: ?wasm_reloc.MEMORY_ADDR_REL_SLEB},
    fixup.Binding{fixup: TABLE_INDEX_REL_SLEB, kind: ?wasm_reloc.TABLE_INDEX_REL_SLEB},
    fixup.Binding{fixup: GLOBAL_INDEX_I32, kind: ?wasm_reloc.GLOBAL_INDEX_I32},
    fixup.Binding{fixup: MEMORY_ADDR_LEB64, kind: ?wasm_reloc.MEMORY_ADDR_LEB64},
    fixup.Binding{fixup: MEMORY_ADDR_SLEB64, kind: ?wasm_reloc.MEMORY_ADDR_SLEB64},
    fixup.Binding{fixup: MEMORY_ADDR_I64, kind: ?reloc.ABS64},
    fixup.Binding{fixup: MEMORY_ADDR_REL_SLEB64, kind: ?wasm_reloc.MEMORY_ADDR_REL_SLEB64},
    fixup.Binding{fixup: TABLE_INDEX_SLEB64, kind: ?wasm_reloc.TABLE_INDEX_SLEB64},
    fixup.Binding{fixup: TABLE_INDEX_I64, kind: ?wasm_reloc.TABLE_INDEX_I64},
    fixup.Binding{fixup: TABLE_NUMBER_LEB, kind: ?wasm_reloc.TABLE_NUMBER_LEB},
    fixup.Binding{fixup: MEMORY_ADDR_TLS_SLEB, kind: ?wasm_reloc.MEMORY_ADDR_TLS_SLEB},
    fixup.Binding{fixup: FUNCTION_OFFSET_I64, kind: ?wasm_reloc.FUNCTION_OFFSET_I64},
    fixup.Binding{fixup: MEMORY_ADDR_LOCREL_I32, kind: ?reloc.PC32},
    fixup.Binding{fixup: TABLE_INDEX_REL_SLEB64, kind: ?wasm_reloc.TABLE_INDEX_REL_SLEB64},
    fixup.Binding{fixup: MEMORY_ADDR_TLS_SLEB64, kind: ?wasm_reloc.MEMORY_ADDR_TLS_SLEB64},
    fixup.Binding{fixup: FUNCTION_INDEX_I32, kind: ?wasm_reloc.FUNCTION_INDEX_I32},
    fixup.Binding{fixup: MEMORY_ADDR_LOCREL_I64, kind: ?reloc.PC64},
};

# how a site's value is written
# ---
# ULEB: an unsigned LEB128, padded to its field's bytes
# SLEB: a signed LEB128, padded to its field's bytes
# WORD: a little-endian word of its field's bytes
pub def Encoding: u8;

pub val ULEB: Encoding = 0;
pub val SLEB: Encoding = 1;
pub val WORD: Encoding = 2;

# the field a fixup kind's relocation patches, whose encoding, width and bytes are its row's in mink, the one owner of
# them: a run of LEB128 bytes or a word, signed where its range is, of its range's bits
# ---
# fixup: the kind
# row:   the row of `mink.format.wasm.reloc` its binding names, of the type code one less than the kind
# other: the kind of the same relocation at the other width, as MEMORY_ADDR_LEB64 is MEMORY_ADDR_LEB's,
#        operand.NO_FIXUP for a kind with one width, as an index's
pub rec Site {
    fixup: operand.FixupKind;
    row:   *mink_row.Row;
    other: operand.FixupKind;
}

# each kind's site, in the order of the kinds
pub val SITES: [COUNT]Site = [COUNT]Site{
    Site{fixup: FUNCTION_INDEX_LEB, row: ?wasm_reloc.ROWS[0], other: operand.NO_FIXUP},
    Site{fixup: TABLE_INDEX_SLEB, row: ?wasm_reloc.ROWS[1], other: TABLE_INDEX_SLEB64},
    Site{fixup: TABLE_INDEX_I32, row: ?wasm_reloc.ROWS[2], other: TABLE_INDEX_I64},
    Site{fixup: MEMORY_ADDR_LEB, row: ?wasm_reloc.ROWS[3], other: MEMORY_ADDR_LEB64},
    Site{fixup: MEMORY_ADDR_SLEB, row: ?wasm_reloc.ROWS[4], other: MEMORY_ADDR_SLEB64},
    Site{fixup: MEMORY_ADDR_I32, row: ?wasm_reloc.ROWS[5], other: MEMORY_ADDR_I64},
    Site{fixup: TYPE_INDEX_LEB, row: ?wasm_reloc.ROWS[6], other: operand.NO_FIXUP},
    Site{fixup: GLOBAL_INDEX_LEB, row: ?wasm_reloc.ROWS[7], other: operand.NO_FIXUP},
    Site{fixup: FUNCTION_OFFSET_I32, row: ?wasm_reloc.ROWS[8], other: FUNCTION_OFFSET_I64},
    Site{fixup: SECTION_OFFSET_I32, row: ?wasm_reloc.ROWS[9], other: operand.NO_FIXUP},
    Site{fixup: TAG_INDEX_LEB, row: ?wasm_reloc.ROWS[10], other: operand.NO_FIXUP},
    Site{fixup: MEMORY_ADDR_REL_SLEB, row: ?wasm_reloc.ROWS[11], other: MEMORY_ADDR_REL_SLEB64},
    Site{fixup: TABLE_INDEX_REL_SLEB, row: ?wasm_reloc.ROWS[12], other: TABLE_INDEX_REL_SLEB64},
    Site{fixup: GLOBAL_INDEX_I32, row: ?wasm_reloc.ROWS[13], other: operand.NO_FIXUP},
    Site{fixup: MEMORY_ADDR_LEB64, row: ?wasm_reloc.ROWS[14], other: MEMORY_ADDR_LEB},
    Site{fixup: MEMORY_ADDR_SLEB64, row: ?wasm_reloc.ROWS[15], other: MEMORY_ADDR_SLEB},
    Site{fixup: MEMORY_ADDR_I64, row: ?wasm_reloc.ROWS[16], other: MEMORY_ADDR_I32},
    Site{fixup: MEMORY_ADDR_REL_SLEB64, row: ?wasm_reloc.ROWS[17], other: MEMORY_ADDR_REL_SLEB},
    Site{fixup: TABLE_INDEX_SLEB64, row: ?wasm_reloc.ROWS[18], other: TABLE_INDEX_SLEB},
    Site{fixup: TABLE_INDEX_I64, row: ?wasm_reloc.ROWS[19], other: TABLE_INDEX_I32},
    Site{fixup: TABLE_NUMBER_LEB, row: ?wasm_reloc.ROWS[20], other: operand.NO_FIXUP},
    Site{fixup: MEMORY_ADDR_TLS_SLEB, row: ?wasm_reloc.ROWS[21], other: MEMORY_ADDR_TLS_SLEB64},
    Site{fixup: FUNCTION_OFFSET_I64, row: ?wasm_reloc.ROWS[22], other: FUNCTION_OFFSET_I32},
    Site{fixup: MEMORY_ADDR_LOCREL_I32, row: ?wasm_reloc.ROWS[23], other: MEMORY_ADDR_LOCREL_I64},
    Site{fixup: TABLE_INDEX_REL_SLEB64, row: ?wasm_reloc.ROWS[24], other: TABLE_INDEX_REL_SLEB},
    Site{fixup: MEMORY_ADDR_TLS_SLEB64, row: ?wasm_reloc.ROWS[25], other: MEMORY_ADDR_TLS_SLEB},
    Site{fixup: FUNCTION_INDEX_I32, row: ?wasm_reloc.ROWS[26], other: operand.NO_FIXUP},
    Site{fixup: MEMORY_ADDR_LOCREL_I64, row: ?wasm_reloc.ROWS[27], other: MEMORY_ADDR_LOCREL_I32},
};

# the site of kind `kind`, none for no wasm kind
pub fun site_of(kind: operand.FixupKind) opt[*Site] {
    if (kind == operand.NO_FIXUP || kind::u32 > COUNT) { ret opt[*Site].none{}; }
    ret opt[*Site].some{?SITES[kind::usize - 1]};
}

# how site `s` is written, from its row's field and range
pub fun encoding_of(s: *Site) Encoding {
    if (!s.row.fields[0].field.run)   { ret WORD; }
    if (sel s.row.range.check.signed) { ret SLEB; }
    ret ULEB;
}

# the width of site `s` in bits, its row's range's
pub fun bits_of(s: *Site) u8 {
    ret s.row.range.bits;
}

# how many bytes site `s` takes, its row's field's
pub fun bytes_of(s: *Site) usize {
    ret s.row.fields[0].field.bytes::usize;
}

# the site of kind `kind` moved to its form at `bits`, of `encoding`, none where the kind relocates no such field
pub fun site_at(kind: operand.FixupKind, encoding: Encoding, bits: u8) opt[*Site] {
    val s: opt[*Site] = site_of(kind);
    if (sel s.none)                       { ret s; }
    if (encoding_of(s.some) != encoding)  { ret opt[*Site].none{}; }
    if (bits_of(s.some) == bits)          { ret s; }
    if (s.some.other == operand.NO_FIXUP) { ret opt[*Site].none{}; }
    ret site_of(s.some.other);
}

# how many data fixups there are
pub val DATA_COUNT: u32 = 4;

# the data the convention relocates: memory addresses and their distances from the place, as words and doublewords
pub val DATA: [DATA_COUNT]fixup.Datum = [DATA_COUNT]fixup.Datum{
    fixup.Datum{basis: fixup.ABSOLUTE, width: 4, fixup: MEMORY_ADDR_I32},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 8, fixup: MEMORY_ADDR_I64},
    fixup.Datum{basis: fixup.RELATIVE, width: 4, fixup: MEMORY_ADDR_LOCREL_I32},
    fixup.Datum{basis: fixup.RELATIVE, width: 8, fixup: MEMORY_ADDR_LOCREL_I64},
};
