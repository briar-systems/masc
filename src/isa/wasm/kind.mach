# the wasm field kinds by their index in the set's field table, its index spaces and its structure
#
# the generated rows name each field's kind, each index operand's space and each row's structure by these, and
# `masc.isa.wasm.field` holds the table the indices point into, so the rows depend on no kind's code.

use std.types.bool.bool;
use std.types.bool.false;

use masc.core.index;
use masc.core.operand;
use masc.core.requirement;

# the kind of the opcode: a byte, or a prefix byte (the field's param) and its index's u32 (the field's fixed bits)
pub val OPCODE: u16 = 0;

# the kind of an index, an unsigned LEB128 of the param's low byte of bits. the param's next byte is the operand of
# the other index of a pair plus one, 0 for none
pub val ULEB: u16 = 1;

# the kind of a signed LEB128 of the param's bits, an integer constant or a heap type's s33
pub val SLEB: u16 = 2;

# the kind of a memarg over three operands from the field's: the memory index, the offset and the alignment in bytes.
# the param is the log2 of the access's natural alignment
pub val MEMARG: u16 = 3;

# the kind of a block type, a group of a value type or a type index, the empty type none
pub val BLOCKTYPE: u16 = 4;

# the kind of br_table's targets, a vector of label indices and the default after them
pub val TARGETS: u16 = 5;

# the kind of a try_table's catch clauses, a vector of catches
pub val CATCHES: u16 = 6;

# the kind of select's value types, a vector of value types
pub val VALTYPES: u16 = 7;

# the kind of bytes written whole, as many as the param, as a v128 or a shuffle's lanes
pub val BYTES: u16 = 8;

# the kind of a fixed-width unit, a float's bits, a lane or a reserved byte
pub val UNIT: u16 = 9;

# the kind of a heap type, the s33 of an abstract one or a type index, as ref.null takes
pub val HEAPTYPE: u16 = 10;

# the index spaces, of a module's definitions and of a function's locals and labels
pub val TYPES:    u16 = 0;
pub val FUNCS:    u16 = 1;
pub val TABLES:   u16 = 2;
pub val MEMORIES: u16 = 3;
pub val GLOBALS:  u16 = 4;
pub val LOCALS:   u16 = 5;
pub val TAGS:     u16 = 6;
pub val DATAS:    u16 = 7;
pub val ELEMS:    u16 = 8;
pub val LABELS:   u16 = 9;

pub val SPACES: u16 = 10;

# what a row does to the block the stream holds open
# ---
# NONE:  nothing
# OPEN:  it opens a block, as block, loop, if and try_table
# ELSE:  it ends the first arm of an if and starts its second
# CLOSE: it closes the innermost block, or the function's body
pub val NONE:  u8 = 0;
pub val OPEN:  u8 = 1;
pub val ELSE:  u8 = 2;
pub val CLOSE: u8 = 3;

# an entry of the specification's index of instructions
# ---
# prefix: its prefix byte, 0 for a one-byte opcode
# code:   its opcode, or its index under its prefix
# named:  whether it names an instruction, false for an opcode the specification reserves
pub rec Indexed {
    prefix: u32;
    code:   u32;
    named:  bool;
}

# the kinds of a catch clause, by the byte the binary spells each by (WebAssembly Specification release 3.0, tag
# wg-3.0, 5.3-binary.instructions.spectec, Bcatch)
val CATCH_MEMBERS: [4]operand.Enumerant = [4]operand.Enumerant{
    operand.Enumerant{name: "catch", value: 0, requires: requirement.NO_ALTERNATIVES, params: operand.NO_GROUP},
    operand.Enumerant{name: "catch_ref", value: 1, requires: requirement.NO_ALTERNATIVES, params: operand.NO_GROUP},
    operand.Enumerant{name: "catch_all", value: 2, requires: requirement.NO_ALTERNATIVES, params: operand.NO_GROUP},
    operand.Enumerant{name: "catch_all_ref", value: 3, requires: requirement.NO_ALTERNATIVES, params: operand.NO_GROUP},
};

val CATCH_NAMES: [4]index.Entry = [4]index.Entry{
    index.Entry{key: "catch", row: 0},
    index.Entry{key: "catch_all", row: 2},
    index.Entry{key: "catch_all_ref", row: 3},
    index.Entry{key: "catch_ref", row: 1},
};

pub val CATCH:         u32 = 0;
pub val CATCH_REF:     u32 = 1;
pub val CATCH_ALL:     u32 = 2;
pub val CATCH_ALL_REF: u32 = 3;

pub val CATCH_KINDS: operand.Enumeration = operand.Enumeration{members: ?CATCH_MEMBERS[0], count: 4, mask: false, names: index.Index{at: ?CATCH_NAMES[0], len: 4}};

# whether a catch of kind `kind` names a tag
pub fun tagged(kind: u32) bool {
    ret kind == CATCH || kind == CATCH_REF;
}
