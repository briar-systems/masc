# the wasm set's registration record
#
# one record for wasm32 and wasm64, which differ in their memories' address type: wasm64 enters memory64, and a
# memarg's offset is as wide as its memory's address type, which the stream holds. wasm has no register file, no
# fixups, no relaxations, no fill and no call frames, and its timing is not guaranteed, as a later compiler
# schedules its code, so constant-time code of it compiles with a warning (`ct.Timing.unguaranteed`).

use mink_wasm: mink.catalog.arch.wasm;

use masc.core.compress;
use masc.core.ct;
use masc.core.fixup;
use masc.core.mode;
use masc.core.operand;
use masc.core.relax;
use masc.core.requirement;
use masc.core.set;
use masc.core.state;
use masc.core.syntax;
use masc.core.trait;

use wasm_codec:     masc.isa.wasm.codec;
use wasm_extension: masc.isa.wasm.extension;
use wasm_source:    masc.isa.wasm.source;
use wasm_syntax:    masc.isa.wasm.syntax;

val WASM64_IDS: [1]requirement.Id = [1]requirement.Id{wasm_extension.id.MEMORY64};

val WASM64_ENTERS: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?WASM64_IDS[0], len: 1}, none: requirement.NO_IDS}};

# wasm32 enters nothing, and wasm64 memory64, so a selection without it is refused for wasm64
val ARCHES: [2]set.Arch = [2]set.Arch{
    set.Arch{arch: ?mink_wasm.WASM32, enters: requirement.NO_ALTERNATIVES, initial: state.Settings{at: [state.MAX_AXES]u8{0, 0, 0, 0, 0, 0, 0, 0}}, frame: nil},
    set.Arch{arch: ?mink_wasm.WASM64, enters: requirement.Requirement{at: ?WASM64_ENTERS[0], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{0, 0, 0, 0, 0, 0, 0, 0}}, frame: nil},
};

# the registration of wasm at both address widths
pub val SET: set.Set = set.Set{
    arches:     set.Arches{at: ?ARCHES[0], len: 2},
    states:     wasm_extension.AXES,
    codec:      ?wasm_codec.CODEC,
    extensions: ?wasm_extension.CATALOG,
    bindings:   fixup.NO_BINDINGS,
    relax:      relax.NO_RELAXATIONS,
    compress:   compress.NO_COMPRESSIONS,
    fill:       nil,
    realign:    operand.NO_FIXUP,
    data:       fixup.NO_DATA,
    spans:      fixup.NO_SPANS,
    syntaxes:   syntax.Syntaxes{at: ?wasm_syntax.SYNTAX, len: 1},
    traits:     trait.NO_OWNERS,
    assembly:   mode.NO_MODES,
    pairs:      fixup.NO_PAIRS,
    source:     wasm_source.SOURCE,
    parcel:     nil,
    config:     nil,
    ct:         ct.Timing.unguaranteed{},
    folds:      fixup.NO_FOLDS,
};
