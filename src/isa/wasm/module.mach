# a wasm module read from its text
#
# a module's text is `(module $id? field*)`, or its fields alone (WebAssembly Specification release 3.0, tag wg-3.0,
# 6.4-text.modules). its identifiers name entries of index spaces every field fills, so a field may name what a later
# one defines: the reader takes the fields in passes. the type fields first, so a type is numbered in its field's
# order, then each definition, its index in its space and its type, a type use no type field states added after the
# last, once, then the exports in text order, an inline `(export "n")` as the export field it abbreviates, and the
# function bodies last, each read through the stream entered at its function.
#
# what the reader keeps is what the binary writes: the types the stream holds, each function's type, each memory's
# limits, the exports and each body's bytes, its locals and its code (`masc.isa.wasm.body`). a field this reader does
# not yet take is refused, never skipped.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.dispatch;
use masc.core.field;
use masc.core.operand;
use masc.core.state;
use core_syntax: masc.core.syntax;
use syntax_read: masc.syntax.read;

use wasm_body:   masc.isa.wasm.body;
use wasm_kind:   masc.isa.wasm.kind;
use wasm_leb:    masc.isa.wasm.leb;
use wasm_stream: masc.isa.wasm.stream;
use wasm_syntax: masc.isa.wasm.syntax;
use wasm_text:   masc.isa.wasm.text;

#[testing]
use masc.codec.walk;
#[testing]
use masc.core.extension;
#[testing]
use masc.core.inst;
#[testing]
use masc.core.mode;
#[testing]
use masc.core.register;
#[testing]
use masc.core.requirement;
#[testing]
use wasm_codec:     masc.isa.wasm.codec;
#[testing]
use wasm_extension: masc.isa.wasm.extension;
#[testing]
use masc.isa.wasm.gen_extension;
#[testing]
use wasm_set:     masc.isa.wasm.set;
#[testing]
use syntax_print: masc.syntax.print;
#[testing]
use ct_walk:      masc.walk.walk;
#[testing]
use std.allocator.testing;
#[testing]
use std.print;
#[testing]
use std.types.string.str_len;

pub val NOT_A_FIELD:   str = "expected a module field";
pub val UNREAD_FIELD:  str = "module field this reader does not take yet";
pub val NO_FUNC_TYPE:  str = "expected `(func` and its params and results";
pub val NOT_CLOSED:    str = "expected `)`";
pub val NO_STRING:     str = "expected a string";
pub val BAD_ESCAPE:    str = "malformed string escape";
pub val NO_LIMIT:      str = "expected a memory's minimum size";
pub val LIMIT_RANGE:   str = "memory size past its address type's pages";
pub val NO_EXTERN:     str = "expected `(func`, `(table`, `(memory`, `(global` or `(tag` and an index";
pub val WIDE_TYPE:     str = "value type wider than the one byte mink's wasm model holds a value type in";
pub val AFTER_MODULE:  str = "text after the module";
pub val TYPE_MISMATCH: str = "function's params or results differ from its type's";

# the external kinds an export names, by the byte the binary spells each by
pub val FUNC:   u8 = 0;
pub val TABLE:  u8 = 1;
pub val MEMORY: u8 = 2;
pub val GLOBAL: u8 = 3;
pub val TAG:    u8 = 4;

# a memory's limits: its address type's code, its minimum and its maximum in pages, and whether it is shared
pub rec Memory {
    address: u32;
    min:     u64;
    max:     opt[u64];
    shared:  bool;
}

# an export: its name's bytes, the kind it names and the index
pub rec Export {
    name:  vector.Vector[u8];
    kind:  u8;
    index: u32;
}

# a function: its type index and its body's bytes, its locals then its code
pub rec Function {
    type: u32;
    body: vector.Vector[u8];
}

# what a module's text defines, in the order its binary writes it. its types are the stream's
pub rec Module {
    functions: vector.Vector[Function];
    memories:  vector.Vector[Memory];
    exports:   vector.Vector[Export];
}

pub fun release(m: *Module) {
    var i: usize = 0;
    for (i < m.functions.len) {
        vector.dnit[u8](?m.functions.data[i].body);
        i = i + 1;
    }
    i = 0;
    for (i < m.exports.len) {
        vector.dnit[u8](?m.exports.data[i].name);
        i = i + 1;
    }
    vector.dnit[Function](?m.functions);
    vector.dnit[Memory](?m.memories);
    vector.dnit[Export](?m.exports);
}

# a module field: its keyword, the offset past it and the offset of the `)` closing it
rec Field {
    keyword: wasm_text.Token;
    at:      usize;
    end:     usize;
}

# a function's field and its index among the module's functions
rec Defined {
    field: u32;
    index: u32;
}

# what a read keeps while it reads
rec Job {
    a:      *A.Allocator;
    text:   *u8;
    origin: diagnostic.Position;
    ctx:    *state.Context;
    fields: vector.Vector[Field];
    funcs:  vector.Vector[Defined];
    out:    *Module;
}

fun refuse(j: *Job, message: str, at: usize, len: usize) err[diagnostic.Diagnostic] {
    ret err[diagnostic.Diagnostic].err{diagnostic.refusal(message, j.origin, j.text, at, len)};
}

fun at_token(j: *Job, message: str, t: wasm_text.Token) err[diagnostic.Diagnostic] {
    if (t.kind == wasm_text.BROKEN) { ret refuse(j, t.why, t.at, t.len); }
    ret refuse(j, message, t.at, t.len);
}

fun closed(j: *Job, l: *wasm_text.Lexer) err[diagnostic.Diagnostic] {
    val t: wasm_text.Token = wasm_text.next(l);
    if (t.kind != wasm_text.CLOSE) { ret at_token(j, NOT_CLOSED, t); }
    ret err[diagnostic.Diagnostic].ok{};
}

# a syntax reader over the text from the lexer's position to `end`, for the instruction syntax's value type and index
# readers
fun reader(j: *Job, l: *wasm_text.Lexer) core_syntax.Reader {
    ret core_syntax.Reader{
        text:    j.text,
        start:   l.at,
        at:      l.at,
        end:     l.end,
        origin:  diagnostic.advance(j.origin, j.text, l.at),
        codec:   nil,
        ctx:     j.ctx,
        syntax:  ?wasm_syntax.SYNTAX,
        modes:   nil,
        symbols: nil,
        context: nil,
        row:     nil,
        pool:    nil,
        cap:     0,
        used:    0,
        bytes:   nil,
        room:    0,
        taken:   0,
        refused: field.Admissions{at: nil, cap: 0, used: 0},
    };
}

# the value type at the lexer, by the instruction syntax's spelling, its code one byte
fun value_type(j: *Job, l: *wasm_text.Lexer) res[u32, diagnostic.Diagnostic] {
    var r: core_syntax.Reader = reader(j, l);
    syntax_read.skip(?r);
    val at:  usize                           = r.at;
    val got: res[i64, diagnostic.Diagnostic] = wasm_syntax.valtype_read(?r);
    if (sel got.err)                 { ret res[u32, diagnostic.Diagnostic].err{got.err}; }
    if (got.ok < 0 || got.ok > 0xFF) { ret res[u32, diagnostic.Diagnostic].err{diagnostic.refusal(WIDE_TYPE, j.origin, j.text, at, r.at - at)}; }
    l.at = r.at;
    ret res[u32, diagnostic.Diagnostic].ok{got.ok::u32};
}

# the index in space `space` the atom at the lexer names, a number or an identifier the stream holds
fun index(j: *Job, l: *wasm_text.Lexer, space: u16) res[u32, diagnostic.Diagnostic] {
    var r: core_syntax.Reader = reader(j, l);
    syntax_read.skip(?r);
    val got: res[u32, diagnostic.Diagnostic] = wasm_syntax.index_read(?r, space);
    if (sel got.err) { ret got; }
    l.at = r.at;
    ret got;
}

# the identifier at the lexer, passed, less its `$`, empty for none
fun identifier(j: *Job, l: *wasm_text.Lexer) View {
    val t: wasm_text.Token = wasm_text.ahead(l);
    if (!wasm_text.identifier(l, t)) { ret View{data: nil, len: 0}; }
    val passed: wasm_text.Token = wasm_text.next(l);
    ret View{data: ?j.text[t.at + 1], len: t.len - 1};
}

fun hex(c: u8) i32 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i32; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::i32 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::i32 + 10; }
    ret -1;
}

# the bytes of the string at the lexer onto `out`, its escapes decoded
fun string(j: *Job, l: *wasm_text.Lexer, out: *vector.Vector[u8]) err[diagnostic.Diagnostic] {
    val t: wasm_text.Token = wasm_text.next(l);
    if (t.kind != wasm_text.STRING) { ret at_token(j, NO_STRING, t); }
    var i:   usize = t.at + 1;
    val end: usize = t.at + t.len - 1;
    for (i < end) {
        var c: u8 = j.text[i];
        if (c == '\\') {
            if (i + 1 >= end) { ret refuse(j, BAD_ESCAPE, i, 1); }
            val e: u8 = j.text[i + 1];
            i = i + 2;
            if (e == 'n')                           { c = '\n'; }
            or (e == 't')                           { c = '\t'; }
            or (e == 'r')                           { c = '\r'; }
            or (e == '"' || e == '\'' || e == '\\') { c = e; }
            or (hex(e) >= 0 && i < end && hex(j.text[i]) >= 0) {
                c = (hex(e) * 16 + hex(j.text[i]))::u8;
                i = i + 1;
            }
            or { ret refuse(j, BAD_ESCAPE, i - 2, 2); }
        }
        or { i = i + 1; }
        val pushed: res[usize, A.Error] = vector.push[u8](out, c);
        if (sel pushed.err) { ret refuse(j, field.MEMORY, t.at, t.len); }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the module's fields, each by its keyword and its extent
fun fields(j: *Job, l: *wasm_text.Lexer) err[diagnostic.Diagnostic] {
    var wrapped: bool = false;
    if (wasm_text.opens(l, "module")) {
        wrapped = true;
        val named: View = identifier(j, l);
    }
    for {
        val t: wasm_text.Token = wasm_text.next(l);
        if (t.kind == wasm_text.CLOSE && wrapped) {
            val after: wasm_text.Token = wasm_text.next(l);
            if (after.kind != wasm_text.END) { ret at_token(j, AFTER_MODULE, after); }
            ret err[diagnostic.Diagnostic].ok{};
        }
        if (t.kind == wasm_text.END) {
            if (wrapped) { ret refuse(j, NOT_CLOSED, t.at, 0); }
            ret err[diagnostic.Diagnostic].ok{};
        }
        if (t.kind != wasm_text.OPEN) { ret at_token(j, NOT_A_FIELD, t); }
        val k: wasm_text.Token = wasm_text.next(l);
        if (k.kind != wasm_text.ATOM) { ret at_token(j, NOT_A_FIELD, k); }
        val at: usize = l.at;
        if (!wasm_text.skip(l)) { ret refuse(j, NOT_CLOSED, t.at, 1); }
        val pushed: res[usize, A.Error] = vector.push[Field](?j.fields, Field{keyword: k, at: at, end: l.at - 1});
        if (sel pushed.err) { ret refuse(j, field.MEMORY, t.at, 1); }
    }
}

fun lexer(j: *Job, f: *Field) wasm_text.Lexer {
    ret wasm_text.make(j.text, f.at, f.end + 1);
}

# the value types of `(param ...)` or `(result ...)` lists at the lexer onto `out`, a single param's name onto `names`
# when it is not nil, an unnamed one's as empty
fun lists(j: *Job, l: *wasm_text.Lexer, word: str, out: *vector.Vector[u32], names: *vector.Vector[View]) err[diagnostic.Diagnostic] {
    for (wasm_text.opens(l, word)) {
        val name: View = identifier(j, l);
        for {
            val t: wasm_text.Token = wasm_text.ahead(l);
            if (t.kind == wasm_text.CLOSE) { brk; }
            val got: res[u32, diagnostic.Diagnostic] = value_type(j, l);
            if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
            val pushed: res[usize, A.Error] = vector.push[u32](out, got.ok);
            if (sel pushed.err) { ret refuse(j, field.MEMORY, t.at, t.len); }
            if (names != nil) {
                val kept: res[usize, A.Error] = vector.push[View](names, name);
                if (sel kept.err) { ret refuse(j, field.MEMORY, t.at, t.len); }
            }
            if (name.len > 0) { brk; }
        }
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret shut; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# a type field, `$id? (func (param ...)* (result ...)*)`
fun type_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    if (!wasm_text.opens(?l, "func")) { ret at_token(j, NO_FUNC_TYPE, wasm_text.ahead(?l)); }
    var params:  vector.Vector[u32] = vector.init[u32](j.a);
    var results: vector.Vector[u32] = vector.init[u32](j.a);
    fin {
        vector.dnit[u32](?params);
        vector.dnit[u32](?results);
    }
    val p: err[diagnostic.Diagnostic] = lists(j, ?l, "param", ?params, nil);
    if (sel p.err) { ret p; }
    val q: err[diagnostic.Diagnostic] = lists(j, ?l, "result", ?results, nil);
    if (sel q.err) { ret q; }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val added: res[u32, str] = wasm_stream.add_type(j.ctx.stream, params.data, params.len::u32, results.data, results.len::u32, name);
    if (sel added.err) { ret refuse(j, added.err, f.keyword.at, f.keyword.len); }
    ret closed(j, ?l);
}

# the inline exports at the lexer, `(export "n")*`, each an export of kind `kind` and index `index`
fun inline_exports(j: *Job, l: *wasm_text.Lexer, kind: u8, index: u32) err[diagnostic.Diagnostic] {
    for (wasm_text.opens(l, "export")) {
        var e:     Export                     = Export{name: vector.init[u8](j.a), kind: kind, index: index};
        val named: err[diagnostic.Diagnostic] = string(j, l, ?e.name);
        if (sel named.err) {
            vector.dnit[u8](?e.name);
            ret named;
        }
        val pushed: res[usize, A.Error] = vector.push[Export](?j.out.exports, e);
        if (sel pushed.err) { ret refuse(j, field.MEMORY, l.at, 1); }
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret shut; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the lexer past a field's inline exports, which the export pass reads in text order
fun past_exports(l: *wasm_text.Lexer) {
    for (wasm_text.opens(l, "export")) { val shut: bool = wasm_text.skip(l); }
}

# a function's type use: `(type x)?` then its params and results, the type they state when no `(type x)` does, the
# first the stream holds or one added after the last, and params and results a `(type x)` states must be its own
fun type_use(j: *Job, l: *wasm_text.Lexer, names: *vector.Vector[View]) res[u32, diagnostic.Diagnostic] {
    val at: usize    = l.at;
    var x:  opt[u32] = opt[u32].none{};
    if (wasm_text.opens(l, "type")) {
        val got: res[u32, diagnostic.Diagnostic] = index(j, l, wasm_kind.TYPES);
        if (sel got.err) { ret got; }
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret res[u32, diagnostic.Diagnostic].err{shut.err}; }
        x = opt[u32].some{got.ok};
    }
    var params:  vector.Vector[u32] = vector.init[u32](j.a);
    var results: vector.Vector[u32] = vector.init[u32](j.a);
    fin {
        vector.dnit[u32](?params);
        vector.dnit[u32](?results);
    }
    val p: err[diagnostic.Diagnostic] = lists(j, l, "param", ?params, names);
    if (sel p.err) { ret res[u32, diagnostic.Diagnostic].err{p.err}; }
    val q: err[diagnostic.Diagnostic] = lists(j, l, "result", ?results, nil);
    if (sel q.err) { ret res[u32, diagnostic.Diagnostic].err{q.err}; }
    if (sel x.some) {
        val t: opt[*wasm_stream.FuncType] = wasm_stream.func_type(j.ctx.stream, x.some);
        if (sel t.none) { ret res[u32, diagnostic.Diagnostic].err{diagnostic.refusal(wasm_stream.NO_TYPE, j.origin, j.text, at, l.at - at)}; }
        val stated: bool = params.len > 0 || results.len > 0;
        if (stated && (!same(?t.some.params, ?params) || !same(?t.some.results, ?results))) { ret res[u32, diagnostic.Diagnostic].err{diagnostic.refusal(TYPE_MISMATCH, j.origin, j.text, at, l.at - at)}; }
        ret res[u32, diagnostic.Diagnostic].ok{x.some};
    }
    val found: opt[u32] = wasm_stream.find_type(j.ctx.stream, params.data, params.len::u32, results.data, results.len::u32);
    if (sel found.some) { ret res[u32, diagnostic.Diagnostic].ok{found.some}; }
    val added: res[u32, str] = wasm_stream.add_type(j.ctx.stream, params.data, params.len::u32, results.data, results.len::u32, View{data: nil, len: 0});
    if (sel added.err) { ret res[u32, diagnostic.Diagnostic].err{diagnostic.refusal(added.err, j.origin, j.text, at, l.at - at)}; }
    ret res[u32, diagnostic.Diagnostic].ok{added.ok};
}

fun same(a: *vector.Vector[u32], b: *vector.Vector[u32]) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a func field's definition: its index, named, and its type
fun func_field(j: *Job, f: *Field, k: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val typed: res[u32, diagnostic.Diagnostic] = type_use(j, ?l, nil);
    if (sel typed.err) { ret err[diagnostic.Diagnostic].err{typed.err}; }
    val defined: res[u32, str] = wasm_stream.define(j.ctx.stream, wasm_kind.FUNCS, typed.ok, name);
    if (sel defined.err) { ret refuse(j, defined.err, f.keyword.at, f.keyword.len); }
    val pushed: res[usize, A.Error] = vector.push[Function](?j.out.functions, Function{type: typed.ok, body: vector.init[u8](j.a)});
    if (sel pushed.err) { ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len); }
    val kept: res[usize, A.Error] = vector.push[Defined](?j.funcs, Defined{field: k, index: (j.out.functions.len - 1)::u32});
    if (sel kept.err) { ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len); }
    ret err[diagnostic.Diagnostic].ok{};
}

# a number of pages at the lexer, within an address type of `bits`
fun pages(j: *Job, l: *wasm_text.Lexer, bits: u32) res[u64, diagnostic.Diagnostic] {
    val t: wasm_text.Token = wasm_text.next(l);
    if (t.kind != wasm_text.ATOM || j.text[t.at] < '0' || j.text[t.at] > '9') { ret res[u64, diagnostic.Diagnostic].err{diagnostic.refusal(NO_LIMIT, j.origin, j.text, t.at, t.len)}; }
    var v:    u64   = 0;
    var i:    usize = 0;
    var base: u64   = 10;
    if (t.len > 2 && j.text[t.at] == '0' && j.text[t.at + 1] == 'x') {
        base = 16;
        i    = 2;
    }
    val most: u64 = 1::u64 << (bits - 16)::u64;
    for (i < t.len) {
        val c: u8 = j.text[t.at + i];
        if (c != '_') {
            val d: i32 = hex(c);
            if (d < 0 || d::u64 >= base) { ret res[u64, diagnostic.Diagnostic].err{diagnostic.refusal(NO_LIMIT, j.origin, j.text, t.at, t.len)}; }
            v = v * base + d::u64;
            if (v > most) { ret res[u64, diagnostic.Diagnostic].err{diagnostic.refusal(LIMIT_RANGE, j.origin, j.text, t.at, t.len)}; }
        }
        i = i + 1;
    }
    ret res[u64, diagnostic.Diagnostic].ok{v};
}

# a memory field: `$id? (export "n")* i32|i64? min max? shared?`, its index and limits
fun memory_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    var m:    Memory = Memory{address: wasm_stream.I32, min: 0, max: opt[u64].none{}, shared: false};
    var bits: u32    = 32;
    if (wasm_text.is(?l, wasm_text.ahead(?l), "i64")) {
        val passed: wasm_text.Token = wasm_text.next(?l);
        m.address = wasm_stream.I64;
        bits      = 64;
    }
    or (wasm_text.is(?l, wasm_text.ahead(?l), "i32")) { val passed: wasm_text.Token = wasm_text.next(?l); }
    val min: res[u64, diagnostic.Diagnostic] = pages(j, ?l, bits);
    if (sel min.err) { ret err[diagnostic.Diagnostic].err{min.err}; }
    m.min = min.ok;
    val more: wasm_text.Token = wasm_text.ahead(?l);
    if (more.kind == wasm_text.ATOM && j.text[more.at] >= '0' && j.text[more.at] <= '9') {
        val max: res[u64, diagnostic.Diagnostic] = pages(j, ?l, bits);
        if (sel max.err) { ret err[diagnostic.Diagnostic].err{max.err}; }
        m.max = opt[u64].some{max.ok};
    }
    if (wasm_text.is(?l, wasm_text.ahead(?l), "shared")) {
        val passed: wasm_text.Token = wasm_text.next(?l);
        m.shared = true;
    }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val defined: res[u32, str] = wasm_stream.define(j.ctx.stream, wasm_kind.MEMORIES, m.address, name);
    if (sel defined.err) { ret refuse(j, defined.err, f.keyword.at, f.keyword.len); }
    val pushed: res[usize, A.Error] = vector.push[Memory](?j.out.memories, m);
    if (sel pushed.err) { ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len); }
    ret err[diagnostic.Diagnostic].ok{};
}

# the space and kind an export's `(func x)` and its kin name
fun extern(j: *Job, l: *wasm_text.Lexer) res[Export, diagnostic.Diagnostic] {
    val words:  [5]str = [5]str{"func", "table", "memory", "global", "tag"};
    val spaces: [5]u16 = [5]u16{wasm_kind.FUNCS, wasm_kind.TABLES, wasm_kind.MEMORIES, wasm_kind.GLOBALS, wasm_kind.TAGS};
    val kinds:  [5]u8  = [5]u8{FUNC, TABLE, MEMORY, GLOBAL, TAG};
    var k:      usize  = 0;
    for (k < 5) {
        if (wasm_text.opens(l, words[k])) {
            val got: res[u32, diagnostic.Diagnostic] = index(j, l, spaces[k]);
            if (sel got.err) { ret res[Export, diagnostic.Diagnostic].err{got.err}; }
            val shut: err[diagnostic.Diagnostic] = closed(j, l);
            if (sel shut.err) { ret res[Export, diagnostic.Diagnostic].err{shut.err}; }
            ret res[Export, diagnostic.Diagnostic].ok{Export{name: vector.init[u8](j.a), kind: kinds[k], index: got.ok}};
        }
        k = k + 1;
    }
    val t: wasm_text.Token = wasm_text.ahead(l);
    ret res[Export, diagnostic.Diagnostic].err{diagnostic.refusal(NO_EXTERN, j.origin, j.text, t.at, t.len)};
}

# an export field, `"n" (func x)`
fun export_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:         wasm_text.Lexer            = lexer(j, f);
    var name:      vector.Vector[u8]          = vector.init[u8](j.a);
    val read_name: err[diagnostic.Diagnostic] = string(j, ?l, ?name);
    if (sel read_name.err) {
        vector.dnit[u8](?name);
        ret read_name;
    }
    val got: res[Export, diagnostic.Diagnostic] = extern(j, ?l);
    if (sel got.err) {
        vector.dnit[u8](?name);
        ret err[diagnostic.Diagnostic].err{got.err};
    }
    var e: Export = got.ok;
    e.name = name;
    val pushed: res[usize, A.Error] = vector.push[Export](?j.out.exports, e);
    if (sel pushed.err) { ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len); }
    ret closed(j, ?l);
}

# the exports of `f` in text order, an export field's, or a definition's inline ones at index `index` of `kind`
fun exports_of(j: *Job, f: *Field, kind: u8, index: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    ret inline_exports(j, ?l, kind, index);
}

# the locals at the lexer, `(local $id t)` or `(local t*)`, defined after the params, onto `types`
fun locals(j: *Job, l: *wasm_text.Lexer, types: *vector.Vector[u32]) err[diagnostic.Diagnostic] {
    for (wasm_text.opens(l, "local")) {
        val name: View = identifier(j, l);
        for {
            val t: wasm_text.Token = wasm_text.ahead(l);
            if (t.kind == wasm_text.CLOSE) { brk; }
            val got: res[u32, diagnostic.Diagnostic] = value_type(j, l);
            if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
            val defined: res[u32, str] = wasm_stream.define(j.ctx.stream, wasm_kind.LOCALS, got.ok, name);
            if (sel defined.err) { ret refuse(j, defined.err, t.at, t.len); }
            val pushed: res[usize, A.Error] = vector.push[u32](types, got.ok);
            if (sel pushed.err) { ret refuse(j, field.MEMORY, t.at, t.len); }
            if (name.len > 0)   { brk; }
        }
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret shut; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the locals vector of a body: each run of locals of one type as its count and its type
fun local_runs(out: *vector.Vector[u8], types: *vector.Vector[u32]) {
    var runs: u64   = 0;
    var i:    usize = 0;
    for (i < types.len) {
        if (i == 0 || types.data[i] != types.data[i - 1]) { runs = runs + 1; }
        i = i + 1;
    }
    wasm_leb.put_unsigned(out, runs);
    i = 0;
    for (i < types.len) {
        var n: usize = i;
        for (n < types.len && types.data[n] == types.data[i]) { n = n + 1; }
        wasm_leb.put_unsigned(out, (n - i)::u64);
        vector.push[u8](out, types.data[i]::u8);
        i = n;
    }
}

# function `d`'s body: the stream entered at its type, its params named, its locals and its code
fun body_of(j: *Job, b: *wasm_body.Reader, d: *Defined) err[diagnostic.Diagnostic] {
    val fn:   *Function       = ?j.out.functions.data[d.index];
    var l:    wasm_text.Lexer = lexer(j, ?j.fields.data[d.field]);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val entered: err[str] = wasm_stream.enter(j.ctx.stream, fn.type);
    if (sel entered.err) { ret refuse(j, entered.err, l.at, 1); }
    var names: vector.Vector[View] = vector.init[View](j.a);
    fin { vector.dnit[View](?names); }
    val typed: res[u32, diagnostic.Diagnostic] = type_use(j, ?l, ?names);
    if (sel typed.err) { ret err[diagnostic.Diagnostic].err{typed.err}; }
    var i: usize = 0;
    for (i < names.len) {
        val named: err[str] = wasm_stream.name_local(j.ctx.stream, i::u32, names.data[i]);
        if (sel named.err) { ret refuse(j, named.err, l.at, 1); }
        i = i + 1;
    }
    var types: vector.Vector[u32] = vector.init[u32](j.a);
    fin { vector.dnit[u32](?types); }
    val declared: err[diagnostic.Diagnostic] = locals(j, ?l, ?types);
    if (sel declared.err) { ret declared; }
    local_runs(?fn.body, ?types);
    val code: err[diagnostic.Diagnostic] = wasm_body.function(b, ?l, ?fn.body);
    if (sel code.err) { ret code; }
    ret closed(j, ?l);
}

fun is(j: *Job, f: *Field, word: str) bool {
    var l: wasm_text.Lexer = wasm_text.make(j.text, 0, 0);
    ret wasm_text.is(?l, f.keyword, word);
}

# the module the `len` bytes of `text` spell, read under `ctx`, whose stream it begins and fills
# ---
# origin: the position of the text's first byte
pub fun read(a: *A.Allocator, text: *u8, len: usize, origin: diagnostic.Position, codec: *dispatch.Codec, ctx: *state.Context, out: *Module) err[diagnostic.Diagnostic] {
    @out = Module{functions: vector.init[Function](a), memories: vector.init[Memory](a), exports: vector.init[Export](a)};
    wasm_stream.HOOKS.begin(ctx.stream);
    var j: Job = Job{a: a, text: text, origin: origin, ctx: ctx, fields: vector.init[Field](a), funcs: vector.init[Defined](a), out: out};
    fin {
        vector.dnit[Field](?j.fields);
        vector.dnit[Defined](?j.funcs);
    }
    var l:      wasm_text.Lexer            = wasm_text.make(text, 0, len);
    val listed: err[diagnostic.Diagnostic] = fields(?j, ?l);
    if (sel listed.err) { ret listed; }
    var k: usize = 0;
    for (k < j.fields.len) {
        val f: *Field = ?j.fields.data[k];
        if (is(?j, f, "type")) {
            val got: err[diagnostic.Diagnostic] = type_field(?j, f);
            if (sel got.err) { ret got; }
        }
        or (!is(?j, f, "func") && !is(?j, f, "memory") && !is(?j, f, "export")) { ret refuse(?j, UNREAD_FIELD, f.keyword.at, f.keyword.len); }
        k = k + 1;
    }
    k = 0;
    for (k < j.fields.len) {
        val f:   *Field                     = ?j.fields.data[k];
        var got: err[diagnostic.Diagnostic] = err[diagnostic.Diagnostic].ok{};
        if (is(?j, f, "func"))   { got = func_field(?j, f, k::u32); }
        if (is(?j, f, "memory")) { got = memory_field(?j, f); }
        if (sel got.err)         { ret got; }
        k = k + 1;
    }
    k = 0;
    var funcs:    u32 = 0;
    var memories: u32 = 0;
    for (k < j.fields.len) {
        val f:   *Field                     = ?j.fields.data[k];
        var got: err[diagnostic.Diagnostic] = err[diagnostic.Diagnostic].ok{};
        if (is(?j, f, "export")) { got = export_field(?j, f); }
        or (is(?j, f, "func")) {
            got   = exports_of(?j, f, FUNC, funcs);
            funcs = funcs + 1;
        }
        or (is(?j, f, "memory")) {
            got      = exports_of(?j, f, MEMORY, memories);
            memories = memories + 1;
        }
        if (sel got.err) { ret got; }
        k = k + 1;
    }
    var b: wasm_body.Reader = wasm_body.make(a, text, origin, codec, ctx);
    fin { wasm_body.release(?b); }
    k = 0;
    for (k < j.funcs.len) {
        val got: err[diagnostic.Diagnostic] = body_of(?j, ?b, ?j.funcs.data[k]);
        if (sel got.err) { ret got; }
        k = k + 1;
    }
    ret err[diagnostic.Diagnostic].ok{};
}

#[testing]
rec T {
    t:   testing.Testing;
    s:   extension.Selection;
    v:   register.Available;
    ctx: state.Context;
}

# a test under every extension, its stream not begun
#[testing]
fun t_make(t: *T) bool {
    testing.make(?t.t);
    val a:    *A.Allocator                            = testing.allocator_of(?t.t);
    val made: res[extension.Request, extension.Error] = extension.request(a, ?wasm_extension.CATALOG, "", diagnostic.START);
    if (sel made.err) { ret false; }
    var req: extension.Request = made.ok;
    var id:  u32               = 0;
    for (id < gen_extension.COUNT) {
        extension.request_add(?req, id::requirement.Id);
        id = id + 1;
    }
    val closed_: res[extension.Selection, extension.Error] = extension.close(req);
    if (sel closed_.err) { ret false; }
    t.s = closed_.ok;
    val opened: res[state.Context, state.Opened] = state.open(a, nil, ?t.s, ?wasm_extension.AXES, state.initial(?wasm_extension.AXES), ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx = opened.ok;
    val stream: res[ptr, A.Error] = wasm_stream.HOOKS.make(a);
    if (sel stream.err) { ret false; }
    t.ctx.stream = stream.ok;
    ret true;
}

#[testing]
fun t_drop(t: *T, m: *Module) {
    release(m);
    wasm_stream.HOOKS.release(testing.allocator_of(?t.t), t.ctx.stream);
    val released: err[A.Error] = extension.release(?t.s);
}

#[testing]
fun t_read(t: *T, text: str, m: *Module) err[diagnostic.Diagnostic] {
    ret read(testing.allocator_of(?t.t), text, str_len(text), diagnostic.START, ?wasm_codec.CODEC, ?t.ctx, m);
}

#[testing]
val T_GA4: str = "(module\n  (memory $m i64 1)\n  (func $f (export \"f\") (param $a i64) (param $k i32) (result i64)\n    (local $x i64)\n    (block $done (result i64)\n      (block $one\n        (block $zero\n          (br_table $zero $one (local.get $k)))\n        (br $done (i64.load offset=8 (local.get $a))))\n      (select (result i64) (local.get $a) (i64.const 0) (local.get $k)))))\n";

# wat2wasm 1.0.42's body of T_GA4: its one local, then block, br_table, an i64.load of memory64 and select t
#[testing]
val T_GA4_BODY: [35]u8 = [35]u8{0x01, 0x01, 0x7e, 0x02, 0x7e, 0x02, 0x40, 0x02, 0x40, 0x20, 0x01, 0x0e, 0x01, 0x00, 0x01, 0x0b, 0x20, 0x00, 0x29, 0x03, 0x08, 0x0c, 0x01, 0x0b, 0x20, 0x00, 0x42, 0x00, 0x20, 0x01, 0x1c, 0x01, 0x7e, 0x0b, 0x0b};

# GA4: a function of folded block, br_table, select t and an i64.load of a memory64 memory reads to wat2wasm's body,
# its inline type added once and its inline export expanded
test read__ga4_reads_to_wat2wasm_body {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var m:   Module;
    val got: err[diagnostic.Diagnostic] = t_read(?t, T_GA4, ?m);
    if (sel got.err) {
        print.eprintlnf("{} at {}:{}", got.err.message, got.err.span.start.line, got.err.span.start.column);
        ret 2;
    }
    if (m.functions.len != 1 || m.memories.len != 1 || m.exports.len != 1) { ret 3; }
    if (wasm_stream.count(t.ctx.stream, wasm_kind.TYPES) != 1)             { ret 4; }
    if (m.memories.data[0].address != wasm_stream.I64)                     { ret 5; }
    val e: *Export = ?m.exports.data[0];
    if (e.kind != FUNC || e.index != 0 || e.name.len != 1 || e.name.data[0] != 'f') { ret 6; }
    val body: *vector.Vector[u8] = ?m.functions.data[0].body;
    if (body.len != 35) {
        print.eprintlnf("body of {} bytes", body.len);
        ret 7;
    }
    var i: usize = 0;
    for (i < 35) {
        if (body.data[i] != T_GA4_BODY[i]) {
            print.eprintlnf("byte {}: {} for {}", i, body.data[i], T_GA4_BODY[i]);
            ret 8;
        }
        i = i + 1;
    }
    t_drop(?t, ?m);
    ret 0;
}

# whether function `k` of `m` has the body `want`, its `n` bytes
#[testing]
fun t_body(m: *Module, k: usize, want: *u8, n: usize) bool {
    if (k >= m.functions.len) { ret false; }
    val body: *vector.Vector[u8] = ?m.functions.data[k].body;
    if (body.len != n) {
        print.eprintlnf("body of {} bytes for {}", body.len, n);
        ret false;
    }
    var i: usize = 0;
    for (i < n) {
        if (body.data[i] != want[i]) {
            print.eprintlnf("byte {}: {} for {}", i, body.data[i], want[i]);
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

# the module `text` read, reported on refusal
#[testing]
fun t_reads(t: *T, text: str, m: *Module) bool {
    val got: err[diagnostic.Diagnostic] = t_read(t, text, m);
    if (sel got.err) {
        print.eprintlnf("{} at {}:{}", got.err.message, got.err.span.start.line, got.err.span.start.column);
        ret false;
    }
    ret true;
}

# a folded expression reads as its flat sequence, and a label by name resolves to its depth, a plain end repeating it
test read__folded_reads_as_flat_and_a_label_resolves_to_its_depth {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var m:    Module;
    val text: str = "(func (result i32) (i32.add (i32.const 1) (i32.const 2)))\n(func (result i32) i32.const 1 i32.const 2 i32.add)\n(func (block $a (block $b (br $a))))\n(func block $a block $b br $a end $b end $a)";
    if (!t_reads(?t, text, ?m)) { ret 2; }
    val sum:    [8]u8  = [8]u8{0x00, 0x41, 0x01, 0x41, 0x02, 0x6a, 0x0b, 0x00};
    val nested: [10]u8 = [10]u8{0x00, 0x02, 0x40, 0x02, 0x40, 0x0c, 0x01, 0x0b, 0x0b, 0x0b};
    if (!t_body(?m, 0, ?sum[0], 7) || !t_body(?m, 1, ?sum[0], 7))         { ret 3; }
    if (!t_body(?m, 2, ?nested[0], 10) || !t_body(?m, 3, ?nested[0], 10)) { ret 4; }
    if (wasm_stream.count(t.ctx.stream, wasm_kind.TYPES) != 2)            { ret 5; }
    t_drop(?t, ?m);
    var u: T;
    if (!t_make(?u)) { ret 6; }
    var other: Module;
    val wrong: err[diagnostic.Diagnostic] = t_read(?u, "(func block $a block $b end $a end)", ?other);
    if (!sel wrong.err)                             { ret 7; }
    if (wrong.err.message != wasm_body.OTHER_LABEL) { ret 8; }
    t_drop(?u, ?other);
    ret 0;
}

# a type use resolves its index, by `(type $t)` or by the params and results it states
test read__a_type_use_resolves_its_index {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var m:    Module;
    val text: str = "(type $n (func))\n(type $t (func (param i32) (result i32)))\n(func (param i32) (result i32) local.get 0 block (type $t) end)\n(func (type $t) local.get 0 block (param i32) (result i32) end)";
    if (!t_reads(?t, text, ?m)) { ret 2; }
    val body: [7]u8 = [7]u8{0x00, 0x20, 0x00, 0x02, 0x01, 0x0b, 0x0b};
    if (!t_body(?m, 0, ?body[0], 7) || !t_body(?m, 1, ?body[0], 7))     { ret 3; }
    if (m.functions.data[0].type != 1 || m.functions.data[1].type != 1) { ret 4; }
    if (wasm_stream.count(t.ctx.stream, wasm_kind.TYPES) != 2)          { ret 5; }
    t_drop(?t, ?m);
    ret 0;
}

# the text `want` the instruction the bytes `data` encode prints as
#[testing]
fun t_prints(t: *T, data: *u8, len: usize, want: str) bool {
    var store: [8]operand.Value;
    var room:  [8]requirement.Alternative;
    var alts:  field.Admissions                 = field.Admissions{at: ?room[0], cap: 8, used: 0};
    val got:   res[walk.Decoded, field.Refusal] = walk.decode(?wasm_codec.CODEC, ?t.ctx, data, len, 0, ?store[0], 8, ?alts);
    if (sel got.err) { ret false; }
    var out:   vector.Vector[u8]  = vector.init[u8](testing.allocator_of(?t.t));
    var modes: mode.State         = mode.initial(?mode.NO_MODES);
    var w:     core_syntax.Writer = core_syntax.Writer{out: ?out, codec: ?wasm_codec.CODEC, ctx: ?t.ctx, syntax: ?wasm_syntax.SYNTAX, modes: ?modes, symbols: nil, context: nil, row: got.ok.inst.row};
    var ins:   inst.Inst          = got.ok.inst;
    val wrote: err[field.Refusal] = syntax_print.instruction(?w, ?ins);
    if (sel wrote.err) { ret false; }
    val n:    usize = str_len(want);
    var same: bool  = out.len == n;
    var i:    usize = 0;
    for (same && i < n) {
        if (out.data[i] != want[i]) { same = false; }
        i = i + 1;
    }
    if (!same) {
        vector.push[u8](?out, 0);
        print.eprintlnf("printed {} for {}", out.data, want);
    }
    vector.dnit[u8](?out);
    ret same;
}

# a memarg's offset 0 and natural alignment are omitted when it is printed, and other ones written
test print__memarg_defaults_are_omitted {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var m: Module;
    if (!t_reads(?t, "(memory 1)", ?m)) { ret 2; }
    val plain:  [3]u8 = [3]u8{0x28, 0x02, 0x00};
    val offset: [3]u8 = [3]u8{0x28, 0x02, 0x08};
    val align:  [3]u8 = [3]u8{0x28, 0x01, 0x00};
    if (!t_prints(?t, ?plain[0], 3, "i32.load"))           { ret 3; }
    if (!t_prints(?t, ?offset[0], 3, "i32.load offset=8")) { ret 4; }
    if (!t_prints(?t, ?align[0], 3, "i32.load align=2"))   { ret 5; }
    t_drop(?t, ?m);
    ret 0;
}

# a wasm function walked for constant time answers unread today, never unguaranteed, as the walk does not follow its
# operand stack (masc#348)
test walk__a_wasm_function_answers_unread {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var m: Module;
    if (!t_reads(?t, T_GA4, ?m)) { ret 2; }
    val body:    *vector.Vector[u8]            = ?m.functions.data[0].body;
    var code:    ct_walk.Code                  = ct_walk.Code{set: ?wasm_set.SET, data: ?body.data[3], len: body.len - 3};
    var secrets: ct_walk.Secrets               = ct_walk.Secrets{at: nil, len: 0};
    val got:     res[ct_walk.Verdict, A.Error] = ct_walk.check(testing.allocator_of(?t.t), ?code, ?t.ctx, ?secrets);
    if (sel got.err)                              { ret 3; }
    if (!sel got.ok.unread)                       { ret 4; }
    if (got.ok.unread.message != ct_walk.STACKED) { ret 5; }
    t_drop(?t, ?m);
    ret 0;
}
