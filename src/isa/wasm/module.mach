use std.types.string.str_len;

pub val NOT_A_FIELD:  str = "expected a module field";
pub val UNREAD_FIELD: str = "module field the text format does not define";
pub val GC_TYPE:      str = "type of the gc proposal, which the set has no rows of";
pub val NO_FUNC_TYPE: str = "expected `(func` and its params and results";
pub val NOT_CLOSED:   str = "expected `)`";
pub val NO_STRING:    str = "expected a string";
pub val BAD_ESCAPE:   str = "malformed string escape";
pub val NO_LIMIT:     str = "expected a size";
pub val LIMIT_RANGE:  str = "size past its address type's range";
pub val NO_EXTERN:    str = "expected `(func`, `(table`, `(memory`, `(global` or `(tag` and an index";
pub val WIDE_TYPE:    str = "value type wider than the one byte the module reader holds a value type in";
pub val NO_REFTYPE:   str = "expected a reference type";
pub val AFTER_MODULE: str = "text after the module";
pub val TABLE_INIT:   str = "table initializer, which the module reader does not read";
pub val PAGE_SIZE:    str = "memory page size, which is no wasm 3.0 feature";
pub val TWO_STARTS:   str = "module with two start functions";
pub val NO_ITEM:      str = "expected an element segment's item";
pub val NOT_TEXT:     str = "module of binary or quoted text, which is no module text";
pub val FAILED:       str = "mink's wasm model refused the module";

# a module field: its keyword, the offset past it and the offset of the `)` closing it, and the kind and index of what
# it defines, which its inline exports name
rec Field {
    keyword: wasm_text.Token;
    at:      usize;
    end:     usize;
    kind:    u8;
    index:   u32;
    defines: bool;
}

# a defined function's field and its index among the module's functions
rec Defined {
    field: u32;
    index: u32;
}

# what a segment's items or a global's initializer is read from: its field, the offset its contents start at, and the
# table, memory or entry it is of. an inline segment is of its table's or its memory's field, and an inline element
# segment's items are of its table's reference type
rec Pending {
    field:  u32;
    at:     usize;
    of:     u32;
    inline: bool;
    type:   u8;
}

# what a read keeps while it reads
rec Job {
    a:        *A.Allocator;
    text:     *u8;
    origin:   diagnostic.Position;
    codec:    *dispatch.Codec;
    ctx:      *state.Context;
    fields:   vector.Vector[Field];
    funcs:    vector.Vector[Defined];
    globals:  vector.Vector[Pending];
    elements: vector.Vector[Pending];
    datas:    vector.Vector[Pending];
    start:    opt[u32];
    started:  bool;
    out:      *mink_model.Module;
}

fun refuse(j: *Job, message: str, at: usize, len: usize) err[diagnostic.Diagnostic] {
    ret err[diagnostic.Diagnostic].err{diagnostic.refusal(message, j.origin, j.text, at, len)};
}

fun at_token(j: *Job, message: str, t: wasm_text.Token) err[diagnostic.Diagnostic] {
    if (t.kind == wasm_text.BROKEN) { ret refuse(j, t.why, t.at, t.len); }
    ret refuse(j, message, t.at, t.len);
}

fun refused[T](j: *Job, message: str, at: usize, len: usize) res[T, diagnostic.Diagnostic] {
    ret res[T, diagnostic.Diagnostic].err{diagnostic.refusal(message, j.origin, j.text, at, len)};
}

# a refusal of mink's model at `at`
fun failure(j: *Job, f: Fail, at: usize) diagnostic.Diagnostic {
    var message: str = f.text;
    if (message == nil) { message = FAILED; }
    ret diagnostic.refusal(message, j.origin, j.text, at, 1);
}

fun failed(j: *Job, f: Fail, at: usize) err[diagnostic.Diagnostic] {
    ret err[diagnostic.Diagnostic].err{failure(j, f, at)};
}

fun kept[T](j: *Job, got: res[table.Id[T], Fail], at: usize) err[diagnostic.Diagnostic] {
    if (sel got.err) { ret failed(j, got.err, at); }
    ret err[diagnostic.Diagnostic].ok{};
}

fun closed(j: *Job, l: *wasm_text.Lexer) err[diagnostic.Diagnostic] {
    val t: wasm_text.Token = wasm_text.next(l);
    if (t.kind != wasm_text.CLOSE) { ret at_token(j, NOT_CLOSED, t); }
    ret err[diagnostic.Diagnostic].ok{};
}

# a syntax reader over the text from the lexer's position to its end, for the instruction syntax's readers
fun reader(j: *Job, l: *wasm_text.Lexer) core_syntax.Reader {
    ret core_syntax.Reader{
        text:    j.text,
        start:   l.at,
        at:      l.at,
        end:     l.end,
        origin:  diagnostic.advance(j.origin, j.text, l.at),
        codec:   nil,
        ctx:     j.ctx,
        syntax:  ?wasm_syntax.SYNTAX,
        modes:   nil,
        symbols: nil,
        context: nil,
        row:     nil,
        pool:    nil,
        cap:     0,
        used:    0,
        bytes:   nil,
        room:    0,
        taken:   0,
        refused: field.Admissions{at: nil, cap: 0, used: 0},
    };
}

# the value type at the lexer, by the instruction syntax's spelling, its code one byte
fun value_type(j: *Job, l: *wasm_text.Lexer) res[u32, diagnostic.Diagnostic] {
    var r: core_syntax.Reader = reader(j, l);
    syntax_read.skip(?r);
    val at:  usize                           = r.at;
    val got: res[i64, diagnostic.Diagnostic] = wasm_syntax.valtype_read(?r);
    if (sel got.err)     { ret res[u32, diagnostic.Diagnostic].err{got.err}; }
    if (!narrow(got.ok)) { ret refused[u32](j, WIDE_TYPE, at, r.at - at); }
    l.at = r.at;
    ret res[u32, diagnostic.Diagnostic].ok{got.ok::u32};
}

# whether the value type of code `code` is one byte, no reference to a heap type, as `(ref $t)`, whose heap type follows
# its byte
fun narrow(code: i64) bool {
    ret code >= 0 && code <= 0xFF && code != wasm_field.REF::i64 && code != wasm_field.REF_NULL::i64;
}

# whether a value type of code `code` is a reference type
fun reference(code: u32) bool {
    ret code != wasm_stream.I32 && code != wasm_stream.I64 && code != 0x7D && code != 0x7C && code != 0x7B;
}

# the reference type at the lexer, its code one byte
fun ref_type(j: *Job, l: *wasm_text.Lexer) res[u8, diagnostic.Diagnostic] {
    val t:   wasm_text.Token                 = wasm_text.ahead(l);
    val got: res[u32, diagnostic.Diagnostic] = value_type(j, l);
    if (sel got.err)        { ret res[u8, diagnostic.Diagnostic].err{got.err}; }
    if (!reference(got.ok)) { ret refused[u8](j, NO_REFTYPE, t.at, t.len); }
    ret res[u8, diagnostic.Diagnostic].ok{got.ok::u8};
}

# the index in space `space` the atom at the lexer names, a number or an identifier the stream holds
fun index(j: *Job, l: *wasm_text.Lexer, space: u16) res[u32, diagnostic.Diagnostic] {
    var r: core_syntax.Reader = reader(j, l);
    syntax_read.skip(?r);
    val got: res[u32, diagnostic.Diagnostic] = wasm_syntax.index_read(?r, space);
    if (sel got.err) { ret got; }
    l.at = r.at;
    ret got;
}

# whether an index, a number or an identifier, is at the lexer
fun indexed(j: *Job, l: *wasm_text.Lexer) bool {
    val t: wasm_text.Token = wasm_text.ahead(l);
    if (t.kind != wasm_text.ATOM) { ret false; }
    val c: u8 = j.text[t.at];
    ret c == '$' || (c >= '0' && c <= '9');
}

# a type use at the lexer, its type index, a type it implies added after the last, each param's name onto `names` when
# it is not nil
fun type_use(j: *Job, l: *wasm_text.Lexer, names: *vector.Vector[View]) res[u32, diagnostic.Diagnostic] {
    var r:   core_syntax.Reader                   = reader(j, l);
    val got: res[opt[u32], diagnostic.Diagnostic] = wasm_syntax.type_use(?r, false, true, names);
    if (sel got.err)     { ret res[u32, diagnostic.Diagnostic].err{got.err}; }
    if (sel got.ok.none) { ret refused[u32](j, NO_FUNC_TYPE, l.at, 1); }
    l.at = r.at;
    ret res[u32, diagnostic.Diagnostic].ok{got.ok.some};
}

# the identifier at the lexer, passed, less its `$`, empty for none
fun identifier(j: *Job, l: *wasm_text.Lexer) View {
    val t: wasm_text.Token = wasm_text.ahead(l);
    if (!wasm_text.identifier(l, t)) { ret View{data: nil, len: 0}; }
    val passed: wasm_text.Token = wasm_text.next(l);
    ret View{data: ?j.text[t.at + 1], len: t.len - 1};
}

fun hex(c: u8) i32 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i32; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::i32 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::i32 + 10; }
    ret -1;
}

# the bytes of the string at the lexer onto `out`, its escapes decoded (6.0-text.lexical.spectec, Tstring)
fun string(j: *Job, l: *wasm_text.Lexer, out: *vector.Vector[u8]) err[diagnostic.Diagnostic] {
    val t: wasm_text.Token = wasm_text.next(l);
    if (t.kind != wasm_text.STRING) { ret at_token(j, NO_STRING, t); }
    val got: wasm_text.Escape = wasm_text.unescape(j.text, t.at + 1, t.at + t.len - 1, out);
    if (sel got.bad)    { ret refuse(j, BAD_ESCAPE, got.bad, 2); }
    if (sel got.memory) { ret refuse(j, field.MEMORY, t.at, t.len); }
    ret err[diagnostic.Diagnostic].ok{};
}

# the strings at the lexer, joined onto `out`, as a data segment's are
fun strings(j: *Job, l: *wasm_text.Lexer, out: *vector.Vector[u8]) err[diagnostic.Diagnostic] {
    for (wasm_text.ahead(l).kind == wasm_text.STRING) {
        val got: err[diagnostic.Diagnostic] = string(j, l, out);
        if (sel got.err) { ret got; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the name of the string at the lexer, owned by the model
fun name_of(j: *Job, l: *wasm_text.Lexer) res[mink_model.Name, diagnostic.Diagnostic] {
    val at:    usize             = l.at;
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    val read_: err[diagnostic.Diagnostic] = string(j, l, ?bytes);
    if (sel read_.err) { ret res[mink_model.Name, diagnostic.Diagnostic].err{read_.err}; }
    val got: res[mink_model.Name, Fail] = wasm_container.name(j.out, bytes.data, bytes.len);
    if (sel got.err) { ret res[mink_model.Name, diagnostic.Diagnostic].err{failure(j, got.err, at)}; }
    ret res[mink_model.Name, diagnostic.Diagnostic].ok{got.ok};
}

# the module's fields, each by its keyword and its extent
fun fields(j: *Job, l: *wasm_text.Lexer) err[diagnostic.Diagnostic] {
    var wrapped: bool = false;
    if (wasm_text.opens(l, "module")) {
        wrapped = true;
        val named: View            = identifier(j, l);
        val after: wasm_text.Token = wasm_text.ahead(l);
        if (wasm_text.is(l, after, "binary") || wasm_text.is(l, after, "quote")) { ret at_token(j, NOT_TEXT, after); }
    }
    for {
        val t: wasm_text.Token = wasm_text.next(l);
        if (t.kind == wasm_text.CLOSE && wrapped) {
            val after: wasm_text.Token = wasm_text.next(l);
            if (after.kind != wasm_text.END) { ret at_token(j, AFTER_MODULE, after); }
            ret err[diagnostic.Diagnostic].ok{};
        }
        if (t.kind == wasm_text.END) {
            if (wrapped) { ret refuse(j, NOT_CLOSED, t.at, 0); }
            ret err[diagnostic.Diagnostic].ok{};
        }
        if (t.kind != wasm_text.OPEN) { ret at_token(j, NOT_A_FIELD, t); }
        val k: wasm_text.Token = wasm_text.next(l);
        if (k.kind != wasm_text.ATOM) { ret at_token(j, NOT_A_FIELD, k); }
        val at: usize = l.at;
        if (!wasm_text.skip(l)) { ret refuse(j, NOT_CLOSED, t.at, 1); }
        val pushed: res[usize, A.Error] = vector.push[Field](?j.fields, Field{keyword: k, at: at, end: l.at - 1, kind: 0, index: 0, defines: false});
        if (sel pushed.err) { ret refuse(j, field.MEMORY, t.at, 1); }
    }
}

fun lexer(j: *Job, f: *Field) wasm_text.Lexer {
    ret wasm_text.make(j.text, f.at, f.end + 1);
}

fun is(j: *Job, f: *Field, word: str) bool {
    var l: wasm_text.Lexer = wasm_text.make(j.text, 0, 0);
    ret wasm_text.is(?l, f.keyword, word);
}

# the value types of `(param ...)` or `(result ...)` lists at the lexer onto `out`
fun lists(j: *Job, l: *wasm_text.Lexer, word: str, out: *vector.Vector[u32]) err[diagnostic.Diagnostic] {
    for (wasm_text.opens(l, word)) {
        val name: View = identifier(j, l);
        for {
            val t: wasm_text.Token = wasm_text.ahead(l);
            if (t.kind == wasm_text.CLOSE) { brk; }
            val got: res[u32, diagnostic.Diagnostic] = value_type(j, l);
            if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
            val pushed: res[usize, A.Error] = vector.push[u32](out, got.ok);
            if (sel pushed.err) { ret refuse(j, field.MEMORY, t.at, t.len); }
            if (name.len > 0)   { brk; }
        }
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret shut; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# a type field, `$id? (func (param ...)* (result ...)*)`, a type of the gc proposal refused
fun type_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    if (!wasm_text.opens(?l, "func")) {
        val t: wasm_text.Token = wasm_text.ahead(?l);
        if (t.kind == wasm_text.OPEN) { ret refuse(j, GC_TYPE, t.at, 1); }
        ret at_token(j, NO_FUNC_TYPE, t);
    }
    var params:  vector.Vector[u32] = vector.init[u32](j.a);
    var results: vector.Vector[u32] = vector.init[u32](j.a);
    fin {
        vector.dnit[u32](?params);
        vector.dnit[u32](?results);
    }
    val p: err[diagnostic.Diagnostic] = lists(j, ?l, "param", ?params);
    if (sel p.err) { ret p; }
    val q: err[diagnostic.Diagnostic] = lists(j, ?l, "result", ?results);
    if (sel q.err) { ret q; }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val added: res[u32, str] = wasm_stream.add_type(j.ctx.stream, params.data, params.len::u32, results.data, results.len::u32, name);
    if (sel added.err) { ret refuse(j, added.err, f.keyword.at, f.keyword.len); }
    ret closed(j, ?l);
}

# the lexer past a field's inline exports, which the export pass reads in text order
fun past_exports(l: *wasm_text.Lexer) {
    for (wasm_text.opens(l, "export")) { val shut: bool = wasm_text.skip(l); }
}

# the number at the lexer, within `most`
fun number(j: *Job, l: *wasm_text.Lexer, most: u64) res[u64, diagnostic.Diagnostic] {
    val t: wasm_text.Token = wasm_text.next(l);
    if (t.kind != wasm_text.ATOM || j.text[t.at] < '0' || j.text[t.at] > '9') { ret refused[u64](j, NO_LIMIT, t.at, t.len); }
    var v:    u64   = 0;
    var i:    usize = 0;
    var base: u64   = 10;
    if (t.len > 2 && j.text[t.at] == '0' && j.text[t.at + 1] == 'x') {
        base = 16;
        i    = 2;
    }
    for (i < t.len) {
        val c: u8 = j.text[t.at + i];
        if (c != '_') {
            val d: i32 = hex(c);
            if (d < 0 || d::u64 >= base)    { ret refused[u64](j, NO_LIMIT, t.at, t.len); }
            if (v > (most - d::u64) / base) { ret refused[u64](j, LIMIT_RANGE, t.at, t.len); }
            v = v * base + d::u64;
        }
        i = i + 1;
    }
    ret res[u64, diagnostic.Diagnostic].ok{v};
}

fun numeric(j: *Job, l: *wasm_text.Lexer) bool {
    val t: wasm_text.Token = wasm_text.ahead(l);
    ret t.kind == wasm_text.ATOM && j.text[t.at] >= '0' && j.text[t.at] <= '9';
}

# an address type at the lexer, `i32` or `i64`, its code, i32 where none is stated
fun address(j: *Job, l: *wasm_text.Lexer) u32 {
    if (wasm_text.is(l, wasm_text.ahead(l), "i64")) {
        val passed: wasm_text.Token = wasm_text.next(l);
        ret wasm_stream.I64;
    }
    if (wasm_text.is(l, wasm_text.ahead(l), "i32")) { val passed: wasm_text.Token = wasm_text.next(l); }
    ret wasm_stream.I32;
}

# limits at the lexer, `min max?`, each within `most`, the 64-bit flag set for address type i64
fun limits(j: *Job, l: *wasm_text.Lexer, code: u32, most: u64) res[mink_model.Limits, diagnostic.Diagnostic] {
    val min: res[u64, diagnostic.Diagnostic] = number(j, l, most);
    if (sel min.err) { ret res[mink_model.Limits, diagnostic.Diagnostic].err{min.err}; }
    var out: mink_model.Limits = mink_model.Limits{flags: 0, min: wasm_container.leb(min.ok), max: wasm_container.leb(0), page: wasm_container.leb(0)};
    if (code == wasm_stream.I64) { out.flags = out.flags | mink_tables.WASM_LIMITS_FLAG_IS_64.value::u8; }
    if (numeric(j, l)) {
        val max: res[u64, diagnostic.Diagnostic] = number(j, l, most);
        if (sel max.err) { ret res[mink_model.Limits, diagnostic.Diagnostic].err{max.err}; }
        out.max   = wasm_container.leb(max.ok);
        out.flags = out.flags | mink_tables.WASM_LIMITS_FLAG_HAS_MAX.value::u8;
    }
    ret res[mink_model.Limits, diagnostic.Diagnostic].ok{out};
}

# the most pages a memory of address type `code` has, and the most entries a table has
fun most_pages(code: u32) u64 {
    if (code == wasm_stream.I64) { ret 1::u64 << 48; }
    ret 1::u64 << 16;
}

fun most_entries(code: u32) u64 {
    if (code == wasm_stream.I64) { ret ~0::u64; }
    ret 0xFFFF_FFFF;
}

# a memory type at the lexer, `addrtype? limits shared?`, a page size refused
fun memory_type(j: *Job, l: *wasm_text.Lexer, code: *u32) res[mink_model.Limits, diagnostic.Diagnostic] {
    @code = address(j, l);
    val got: res[mink_model.Limits, diagnostic.Diagnostic] = limits(j, l, @code, most_pages(@code));
    if (sel got.err) { ret got; }
    var out: mink_model.Limits = got.ok;
    if (wasm_text.is(l, wasm_text.ahead(l), "shared")) {
        val passed: wasm_text.Token = wasm_text.next(l);
        out.flags = out.flags | mink_tables.WASM_LIMITS_FLAG_IS_SHARED.value::u8;
    }
    if (wasm_text.ahead(l).kind == wasm_text.OPEN) { ret refused[mink_model.Limits](j, PAGE_SIZE, l.at, 1); }
    ret res[mink_model.Limits, diagnostic.Diagnostic].ok{out};
}

# a table type at the lexer, `addrtype? limits reftype`
fun table_type(j: *Job, l: *wasm_text.Lexer, code: *u32) res[mink_model.TableType, diagnostic.Diagnostic] {
    @code = address(j, l);
    val got: res[mink_model.Limits, diagnostic.Diagnostic] = limits(j, l, @code, most_entries(@code));
    if (sel got.err) { ret res[mink_model.TableType, diagnostic.Diagnostic].err{got.err}; }
    val rt: res[u8, diagnostic.Diagnostic] = ref_type(j, l);
    if (sel rt.err) { ret res[mink_model.TableType, diagnostic.Diagnostic].err{rt.err}; }
    ret res[mink_model.TableType, diagnostic.Diagnostic].ok{mink_model.TableType{elem: wasm_container.ref_type(rt.ok::i64), limits: got.ok}};
}

# a global type at the lexer, `valtype` or `(mut valtype)`
fun global_type(j: *Job, l: *wasm_text.Lexer) res[mink_model.GlobalType, diagnostic.Diagnostic] {
    var mutable: u8   = 0;
    val wrapped: bool = wasm_text.opens(l, "mut");
    if (wrapped) { mutable = 1; }
    val got: res[u32, diagnostic.Diagnostic] = value_type(j, l);
    if (sel got.err) { ret res[mink_model.GlobalType, diagnostic.Diagnostic].err{got.err}; }
    if (wrapped) {
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret res[mink_model.GlobalType, diagnostic.Diagnostic].err{shut.err}; }
    }
    ret res[mink_model.GlobalType, diagnostic.Diagnostic].ok{mink_model.GlobalType{valtype: wasm_container.valtype(got.ok::i64), mutable: mutable}};
}

# the space a kind of import or export names, by the byte the binary spells the kind by
fun space_of(kind: u8) u16 {
    if (kind == mink_tables.WASM_EXTERNAL_FUNCTION.value::u8) { ret wasm_kind.FUNCS; }
    if (kind == mink_tables.WASM_EXTERNAL_TABLE.value::u8)    { ret wasm_kind.TABLES; }
    if (kind == mink_tables.WASM_EXTERNAL_MEMORY.value::u8)   { ret wasm_kind.MEMORIES; }
    if (kind == mink_tables.WASM_EXTERNAL_GLOBAL.value::u8)   { ret wasm_kind.GLOBALS; }
    ret wasm_kind.TAGS;
}

val KIND_WORDS: [5]str = [5]str{"func", "table", "memory", "global", "tag"};

# what an import of kind `kind` brings in, read at the lexer, defined in its space named `name`
fun import_desc(j: *Job, l: *wasm_text.Lexer, kind: u8, name: View, at: usize) res[mink_model.Desc, diagnostic.Diagnostic] {
    var code: u32             = 0;
    var desc: mink_model.Desc = mink_model.Desc.function{wasm_container.leb(0)};
    if (kind == mink_tables.WASM_EXTERNAL_FUNCTION.value::u8 || kind == mink_tables.WASM_EXTERNAL_TAG.value::u8) {
        val typed: res[u32, diagnostic.Diagnostic] = type_use(j, l, nil);
        if (sel typed.err) { ret res[mink_model.Desc, diagnostic.Diagnostic].err{typed.err}; }
        code = typed.ok;
        if (kind == mink_tables.WASM_EXTERNAL_TAG.value::u8) { desc = mink_model.Desc.tag_type{mink_model.TagType{attribute: 0, type: wasm_container.leb(code::u64)}}; }
        or                                                   { desc = mink_model.Desc.function{wasm_container.leb(code::u64)}; }
    }
    or (kind == mink_tables.WASM_EXTERNAL_TABLE.value::u8) {
        val got: res[mink_model.TableType, diagnostic.Diagnostic] = table_type(j, l, ?code);
        if (sel got.err) { ret res[mink_model.Desc, diagnostic.Diagnostic].err{got.err}; }
        desc = mink_model.Desc.table{got.ok};
    }
    or (kind == mink_tables.WASM_EXTERNAL_MEMORY.value::u8) {
        val got: res[mink_model.Limits, diagnostic.Diagnostic] = memory_type(j, l, ?code);
        if (sel got.err) { ret res[mink_model.Desc, diagnostic.Diagnostic].err{got.err}; }
        desc = mink_model.Desc.memory{got.ok};
    }
    or {
        val got: res[mink_model.GlobalType, diagnostic.Diagnostic] = global_type(j, l);
        if (sel got.err) { ret res[mink_model.Desc, diagnostic.Diagnostic].err{got.err}; }
        code = wasm_container.code_of(?got.ok.valtype)::u32;
        desc = mink_model.Desc.global{got.ok};
    }
    val defined: res[u32, str] = wasm_stream.define(j.ctx.stream, space_of(kind), code, name);
    if (sel defined.err) { ret refused[mink_model.Desc](j, defined.err, at, 1); }
    ret res[mink_model.Desc, diagnostic.Diagnostic].ok{desc};
}

# an import of kind `kind` from module `module` field `field_`, read at the lexer, the field's index set
fun imported(j: *Job, f: *Field, l: *wasm_text.Lexer, module: mink_model.Name, field_: mink_model.Name, kind: u8, name: View) err[diagnostic.Diagnostic] {
    val desc: res[mink_model.Desc, diagnostic.Diagnostic] = import_desc(j, l, kind, name, f.keyword.at);
    if (sel desc.err) { ret err[diagnostic.Diagnostic].err{desc.err}; }
    f.kind    = kind;
    f.index   = wasm_stream.count(j.ctx.stream, space_of(kind)) - 1;
    f.defines = true;
    ret kept[mink_model.Import](j, table.push[mink_model.Import](?j.out.imports, mink_model.Import{module: module, field: field_, kind: kind, desc: desc.ok}), f.keyword.at);
}

# an import field, `"m" "n" (kind $id? desc)`
fun import_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:      wasm_text.Lexer                             = lexer(j, f);
    val module: res[mink_model.Name, diagnostic.Diagnostic] = name_of(j, ?l);
    if (sel module.err) { ret err[diagnostic.Diagnostic].err{module.err}; }
    val field_: res[mink_model.Name, diagnostic.Diagnostic] = name_of(j, ?l);
    if (sel field_.err) { ret err[diagnostic.Diagnostic].err{field_.err}; }
    var k: usize = 0;
    for (k < 5) {
        if (wasm_text.opens(?l, KIND_WORDS[k])) {
            val named: View                       = identifier(j, ?l);
            val got:   err[diagnostic.Diagnostic] = imported(j, f, ?l, module.ok, field_.ok, k::u8, named);
            if (sel got.err) { ret got; }
            val inner: err[diagnostic.Diagnostic] = closed(j, ?l);
            if (sel inner.err) { ret inner; }
            ret closed(j, ?l);
        }
        k = k + 1;
    }
    ret at_token(j, NO_EXTERN, wasm_text.ahead(?l));
}

# an inline `(import "m" "n")` at the lexer, the import of kind `kind` it abbreviates read and true, false for none
fun inline_import(j: *Job, f: *Field, l: *wasm_text.Lexer, kind: u8, name: View) res[bool, diagnostic.Diagnostic] {
    if (!wasm_text.opens(l, "import")) { ret res[bool, diagnostic.Diagnostic].ok{false}; }
    val module: res[mink_model.Name, diagnostic.Diagnostic] = name_of(j, l);
    if (sel module.err) { ret res[bool, diagnostic.Diagnostic].err{module.err}; }
    val field_: res[mink_model.Name, diagnostic.Diagnostic] = name_of(j, l);
    if (sel field_.err) { ret res[bool, diagnostic.Diagnostic].err{field_.err}; }
    val shut: err[diagnostic.Diagnostic] = closed(j, l);
    if (sel shut.err) { ret res[bool, diagnostic.Diagnostic].err{shut.err}; }
    val got: err[diagnostic.Diagnostic] = imported(j, f, l, module.ok, field_.ok, kind, name);
    if (sel got.err) { ret res[bool, diagnostic.Diagnostic].err{got.err}; }
    val done: err[diagnostic.Diagnostic] = closed(j, l);
    if (sel done.err) { ret res[bool, diagnostic.Diagnostic].err{done.err}; }
    ret res[bool, diagnostic.Diagnostic].ok{true};
}

# the definition `f` is, of kind `kind` and index `index`
fun defines(f: *Field, kind: u8, index: u32) {
    f.kind    = kind;
    f.index   = index;
    f.defines = true;
}

fun define(j: *Job, space: u16, code: u32, name: View, at: usize) res[u32, diagnostic.Diagnostic] {
    val got: res[u32, str] = wasm_stream.define(j.ctx.stream, space, code, name);
    if (sel got.err) { ret refused[u32](j, got.err, at, 1); }
    ret res[u32, diagnostic.Diagnostic].ok{got.ok};
}

# a func field: an import, or a definition of its index and type, and the types its body implies
fun func_field(j: *Job, b: *wasm_body.Reader, f: *Field, k: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val kind:   u8                               = mink_tables.WASM_EXTERNAL_FUNCTION.value::u8;
    val inline: res[bool, diagnostic.Diagnostic] = inline_import(j, f, ?l, kind, name);
    if (sel inline.err) { ret err[diagnostic.Diagnostic].err{inline.err}; }
    if (inline.ok)      { ret err[diagnostic.Diagnostic].ok{}; }
    val typed: res[u32, diagnostic.Diagnostic] = type_use(j, ?l, nil);
    if (sel typed.err) { ret err[diagnostic.Diagnostic].err{typed.err}; }
    val index: res[u32, diagnostic.Diagnostic] = define(j, wasm_kind.FUNCS, typed.ok, name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    defines(f, kind, index.ok);
    val own:    usize                      = table.count[mink_model.Leb](?j.out.functions);
    val pushed: err[diagnostic.Diagnostic] = kept[mink_model.Leb](j, table.push[mink_model.Leb](?j.out.functions, wasm_container.leb(typed.ok::u64)), f.keyword.at);
    if (sel pushed.err) { ret pushed; }
    val noted: res[usize, A.Error] = vector.push[Defined](?j.funcs, Defined{field: k, index: own::u32});
    if (sel noted.err) { ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len); }
    ret wasm_body.imply(b, ?l);
}

# a tag field: an import, or a definition of its type
fun tag_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val kind:   u8                               = mink_tables.WASM_EXTERNAL_TAG.value::u8;
    val inline: res[bool, diagnostic.Diagnostic] = inline_import(j, f, ?l, kind, name);
    if (sel inline.err) { ret err[diagnostic.Diagnostic].err{inline.err}; }
    if (inline.ok)      { ret err[diagnostic.Diagnostic].ok{}; }
    val typed: res[u32, diagnostic.Diagnostic] = type_use(j, ?l, nil);
    if (sel typed.err) { ret err[diagnostic.Diagnostic].err{typed.err}; }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val index: res[u32, diagnostic.Diagnostic] = define(j, wasm_kind.TAGS, typed.ok, name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    defines(f, kind, index.ok);
    ret kept[mink_model.Tag](j, table.push[mink_model.Tag](?j.out.tags, mink_model.Tag{attribute: 0, type: wasm_container.leb(typed.ok::u64)}), f.keyword.at);
}

# a global field: an import, or a definition of its type, its initializer read in its later pass
fun global_field(j: *Job, f: *Field, k: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val kind:   u8                               = mink_tables.WASM_EXTERNAL_GLOBAL.value::u8;
    val inline: res[bool, diagnostic.Diagnostic] = inline_import(j, f, ?l, kind, name);
    if (sel inline.err) { ret err[diagnostic.Diagnostic].err{inline.err}; }
    if (inline.ok)      { ret err[diagnostic.Diagnostic].ok{}; }
    val type: res[mink_model.GlobalType, diagnostic.Diagnostic] = global_type(j, ?l);
    if (sel type.err) { ret err[diagnostic.Diagnostic].err{type.err}; }
    val index: res[u32, diagnostic.Diagnostic] = define(j, wasm_kind.GLOBALS, wasm_container.code_of(?type.ok.valtype)::u32, name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    defines(f, kind, index.ok);
    val own:    usize                      = table.count[mink_model.Global](?j.out.globals);
    val none:   mink_model.Global          = mink_model.Global{type: type.ok, init: mink_model.Expr{bytes: Held.owned{store.Span{start: 0, len: 0}}}};
    val pushed: err[diagnostic.Diagnostic] = kept[mink_model.Global](j, table.push[mink_model.Global](?j.out.globals, none), f.keyword.at);
    if (sel pushed.err) { ret pushed; }
    val noted: res[usize, A.Error] = vector.push[Pending](?j.globals, Pending{field: k, at: l.at, of: own::u32, inline: false, type: 0});
    if (sel noted.err) { ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len); }
    ret err[diagnostic.Diagnostic].ok{};
}

# how many items an inline `(elem ...)` holds: a `func` list's indices, or a reference type's expressions
fun items_in(j: *Job, l: wasm_text.Lexer) u64 {
    var copy: wasm_text.Lexer = l;
    var n:    u64             = 0;
    if (wasm_text.is(?copy, wasm_text.ahead(?copy), "func")) {
        val passed: wasm_text.Token = wasm_text.next(?copy);
        for (indexed(j, ?copy)) {
            val one: wasm_text.Token = wasm_text.next(?copy);
            n = n + 1;
        }
        ret n;
    }
    if (indexed(j, ?copy)) {
        for (indexed(j, ?copy)) {
            val one: wasm_text.Token = wasm_text.next(?copy);
            n = n + 1;
        }
        ret n;
    }
    for {
        val t: wasm_text.Token = wasm_text.next(?copy);
        if (t.kind != wasm_text.OPEN && t.kind != wasm_text.ATOM) { brk; }
        if (t.kind == wasm_text.OPEN) {
            val passed: bool = wasm_text.skip(?copy);
            n = n + 1;
        }
    }
    ret n;
}

# a table field: an import, or a definition of its type, or the table and the active segment its inline `(elem ...)`
# abbreviates, whose items are read in their later pass
fun table_field(j: *Job, f: *Field, k: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val kind:   u8                               = mink_tables.WASM_EXTERNAL_TABLE.value::u8;
    val inline: res[bool, diagnostic.Diagnostic] = inline_import(j, f, ?l, kind, name);
    if (sel inline.err) { ret err[diagnostic.Diagnostic].err{inline.err}; }
    if (inline.ok)      { ret err[diagnostic.Diagnostic].ok{}; }
    var code: u32             = 0;
    var type: mink_model.TableType;
    var elem: bool            = false;
    var at:   usize           = 0;
    val back: wasm_text.Lexer = l;
    code = address(j, ?l);
    if (!numeric(j, ?l)) {
        val rt: res[u8, diagnostic.Diagnostic] = ref_type(j, ?l);
        if (sel rt.err)                   { ret err[diagnostic.Diagnostic].err{rt.err}; }
        if (!wasm_text.opens(?l, "elem")) { ret at_token(j, NOT_CLOSED, wasm_text.ahead(?l)); }
        at   = l.at;
        elem = true;
        val n:      u64               = items_in(j, l);
        var limits: mink_model.Limits = mink_model.Limits{flags: mink_tables.WASM_LIMITS_FLAG_HAS_MAX.value::u8, min: wasm_container.leb(n), max: wasm_container.leb(n), page: wasm_container.leb(0)};
        if (code == wasm_stream.I64) { limits.flags = limits.flags | mink_tables.WASM_LIMITS_FLAG_IS_64.value::u8; }
        type = mink_model.TableType{elem: wasm_container.ref_type(rt.ok::i64), limits: limits};
        val passed: bool = wasm_text.skip(?l);
    }
    or {
        l = back;
        val got: res[mink_model.TableType, diagnostic.Diagnostic] = table_type(j, ?l, ?code);
        if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
        type = got.ok;
    }
    val after: wasm_text.Token = wasm_text.ahead(?l);
    if (after.kind != wasm_text.CLOSE) { ret refuse(j, TABLE_INIT, after.at, after.len); }
    val index: res[u32, diagnostic.Diagnostic] = define(j, wasm_kind.TABLES, code, name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    defines(f, kind, index.ok);
    val def:    mink_model.TableDef        = mink_model.TableDef{type: type, init: opt[mink_model.Expr].none{}};
    val pushed: err[diagnostic.Diagnostic] = kept[mink_model.TableDef](j, table.push[mink_model.TableDef](?j.out.tables, def), f.keyword.at);
    if (sel pushed.err) { ret pushed; }
    if (!elem)          { ret err[diagnostic.Diagnostic].ok{}; }
    ret segment(j, ?j.elements, wasm_kind.ELEMS, f, k, at, index.ok, wasm_container.ref_code(?type.elem)::u8, View{data: nil, len: 0});
}

# a segment of the field `k` noted for its later pass and defined in `space`, its contents from `at`, of entry `of`
fun segment(j: *Job, into: *vector.Vector[Pending], space: u16, f: *Field, k: u32, at: usize, of: u32, type: u8, name: View) err[diagnostic.Diagnostic] {
    val index: res[u32, diagnostic.Diagnostic] = define(j, space, 0, name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    val noted: res[usize, A.Error] = vector.push[Pending](into, Pending{field: k, at: at, of: of, inline: !is(j, f, "elem") && !is(j, f, "data"), type: type});
    if (sel noted.err) { ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len); }
    ret err[diagnostic.Diagnostic].ok{};
}

# the bytes the strings at the lexer hold
fun data_length(j: *Job, l: wasm_text.Lexer) res[u64, diagnostic.Diagnostic] {
    var copy:  wasm_text.Lexer   = l;
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    val got: err[diagnostic.Diagnostic] = strings(j, ?copy, ?bytes);
    if (sel got.err) { ret res[u64, diagnostic.Diagnostic].err{got.err}; }
    ret res[u64, diagnostic.Diagnostic].ok{bytes.len::u64};
}

# a memory field: an import, or a definition of its limits, or the memory and the active segment its inline
# `(data ...)` abbreviates
fun memory_field(j: *Job, f: *Field, k: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val kind:   u8                               = mink_tables.WASM_EXTERNAL_MEMORY.value::u8;
    val inline: res[bool, diagnostic.Diagnostic] = inline_import(j, f, ?l, kind, name);
    if (sel inline.err) { ret err[diagnostic.Diagnostic].err{inline.err}; }
    if (inline.ok)      { ret err[diagnostic.Diagnostic].ok{}; }
    var code:   u32             = 0;
    var limits: mink_model.Limits;
    var data:   bool            = false;
    var at:     usize           = 0;
    val back:   wasm_text.Lexer = l;
    code = address(j, ?l);
    if (wasm_text.opens(?l, "data")) {
        at   = l.at;
        data = true;
        val n: res[u64, diagnostic.Diagnostic] = data_length(j, l);
        if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
        val pages: u64 = (n.ok + 0xFFFF) / 0x1_0000;
        limits = mink_model.Limits{flags: mink_tables.WASM_LIMITS_FLAG_HAS_MAX.value::u8, min: wasm_container.leb(pages), max: wasm_container.leb(pages), page: wasm_container.leb(0)};
        if (code == wasm_stream.I64) { limits.flags = limits.flags | mink_tables.WASM_LIMITS_FLAG_IS_64.value::u8; }
        val passed: bool = wasm_text.skip(?l);
    }
    or {
        l = back;
        val got: res[mink_model.Limits, diagnostic.Diagnostic] = memory_type(j, ?l, ?code);
        if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
        limits = got.ok;
    }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val index: res[u32, diagnostic.Diagnostic] = define(j, wasm_kind.MEMORIES, code, name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    defines(f, kind, index.ok);
    val pushed: err[diagnostic.Diagnostic] = kept[mink_model.Limits](j, table.push[mink_model.Limits](?j.out.memories, limits), f.keyword.at);
    if (sel pushed.err) { ret pushed; }
    if (!data)          { ret err[diagnostic.Diagnostic].ok{}; }
    ret segment(j, ?j.datas, wasm_kind.DATAS, f, k, at, index.ok, 0, View{data: nil, len: 0});
}

# an elem or a data field's index defined by its name, its contents read in their later pass
fun segment_field(j: *Job, f: *Field, k: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    if (is(j, f, "elem")) { ret segment(j, ?j.elements, wasm_kind.ELEMS, f, k, l.at, 0, 0, name); }
    ret segment(j, ?j.datas, wasm_kind.DATAS, f, k, l.at, 0, 0, name);
}

# the space and kind an export's `(func x)` and its kin name
fun extern(j: *Job, l: *wasm_text.Lexer) res[mink_model.Export, diagnostic.Diagnostic] {
    var k: usize = 0;
    for (k < 5) {
        if (wasm_text.opens(l, KIND_WORDS[k])) {
            val got: res[u32, diagnostic.Diagnostic] = index(j, l, space_of(k::u8));
            if (sel got.err) { ret res[mink_model.Export, diagnostic.Diagnostic].err{got.err}; }
            val shut: err[diagnostic.Diagnostic] = closed(j, l);
            if (sel shut.err) { ret res[mink_model.Export, diagnostic.Diagnostic].err{shut.err}; }
            ret res[mink_model.Export, diagnostic.Diagnostic].ok{mink_model.Export{name: mink_model.Name{bytes: Held.owned{store.Span{start: 0, len: 0}}, width: 0}, kind: k::u8, index: wasm_container.leb(got.ok::u64)}};
        }
        k = k + 1;
    }
    val t: wasm_text.Token = wasm_text.ahead(l);
    ret refused[mink_model.Export](j, NO_EXTERN, t.at, t.len);
}

# an export field, `"n" (func x)`
fun export_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:     wasm_text.Lexer                             = lexer(j, f);
    val named: res[mink_model.Name, diagnostic.Diagnostic] = name_of(j, ?l);
    if (sel named.err) { ret err[diagnostic.Diagnostic].err{named.err}; }
    val got: res[mink_model.Export, diagnostic.Diagnostic] = extern(j, ?l);
    if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
    var e: mink_model.Export = got.ok;
    e.name = named.ok;
    val pushed: err[diagnostic.Diagnostic] = kept[mink_model.Export](j, table.push[mink_model.Export](?j.out.exports, e), f.keyword.at);
    if (sel pushed.err) { ret pushed; }
    ret closed(j, ?l);
}

# a definition's inline exports, `(export "n")*`, each an export of what it defines
fun inline_exports(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    for (wasm_text.opens(?l, "export")) {
        val named: res[mink_model.Name, diagnostic.Diagnostic] = name_of(j, ?l);
        if (sel named.err) { ret err[diagnostic.Diagnostic].err{named.err}; }
        val e:      mink_model.Export          = mink_model.Export{name: named.ok, kind: f.kind, index: wasm_container.leb(f.index::u64)};
        val pushed: err[diagnostic.Diagnostic] = kept[mink_model.Export](j, table.push[mink_model.Export](?j.out.exports, e), f.keyword.at);
        if (sel pushed.err) { ret pushed; }
        val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
        if (sel shut.err) { ret shut; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# a start field, `x`, the module's one start function
fun start_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    if (j.started) { ret refuse(j, TWO_STARTS, f.keyword.at, f.keyword.len); }
    var l:   wasm_text.Lexer                 = lexer(j, f);
    val got: res[u32, diagnostic.Diagnostic] = index(j, ?l, wasm_kind.FUNCS);
    if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
    j.start   = opt[u32].some{got.ok};
    j.started = true;
    ret closed(j, ?l);
}

# the expression of the instructions at the lexer up to the `)` around them, owned by the model
fun expression(j: *Job, b: *wasm_body.Reader, l: *wasm_text.Lexer) res[mink_model.Expr, diagnostic.Diagnostic] {
    val at:    usize             = l.at;
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    val got: err[diagnostic.Diagnostic] = wasm_body.expression(b, l, ?bytes);
    if (sel got.err) { ret res[mink_model.Expr, diagnostic.Diagnostic].err{got.err}; }
    ret owned_expr(j, ?bytes, at);
}

fun owned_expr(j: *Job, bytes: *vector.Vector[u8], at: usize) res[mink_model.Expr, diagnostic.Diagnostic] {
    val held: res[Held, Fail] = wasm_container.held(j.out, bytes);
    if (sel held.err) { ret res[mink_model.Expr, diagnostic.Diagnostic].err{failure(j, held.err, at)}; }
    ret res[mink_model.Expr, diagnostic.Diagnostic].ok{mink_model.Expr{bytes: held.ok}};
}

# an offset at the lexer, `(offset instr*)` or one folded instruction, its expression
fun offset(j: *Job, b: *wasm_body.Reader, l: *wasm_text.Lexer) res[mink_model.Expr, diagnostic.Diagnostic] {
    if (wasm_text.opens(l, "offset")) {
        val got: res[mink_model.Expr, diagnostic.Diagnostic] = expression(j, b, l);
        if (sel got.err) { ret got; }
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret res[mink_model.Expr, diagnostic.Diagnostic].err{shut.err}; }
        ret got;
    }
    val at:    usize             = l.at;
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    val got: err[diagnostic.Diagnostic] = wasm_body.folded_expression(b, l, ?bytes);
    if (sel got.err) { ret res[mink_model.Expr, diagnostic.Diagnostic].err{got.err}; }
    ret owned_expr(j, ?bytes, at);
}

# the expression `0` of address type `code`, an inline segment's offset: its const and its end, encoded
fun zero(j: *Job, code: u32, at: usize) res[mink_model.Expr, diagnostic.Diagnostic] {
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    var value: [1]operand.Value = [1]operand.Value{operand.Value.immediate{0}};
    var ins:   inst.Inst        = inst.Inst{row: ?gen_row.ROWS[gen_row_index.I32CONST], values: ?value[0], count: 1, form: form.PREFERRED};
    if (code == wasm_stream.I64) { ins.row = ?gen_row.ROWS[gen_row_index.I64CONST]; }
    var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](j.a);
    fin { vector.dnit[field.Fixup](?fixups); }
    val wrote: res[usize, field.Refusal] = walk.encode(j.codec, j.ctx, ?ins, ?bytes, ?fixups);
    if (sel wrote.err) { ret refused[mink_model.Expr](j, wrote.err.message, at, 1); }
    var end:   inst.Inst                 = inst.Inst{row: ?gen_row.ROWS[gen_row_index.END], values: nil, count: 0, form: form.PREFERRED};
    val ended: res[usize, field.Refusal] = walk.encode(j.codec, j.ctx, ?end, ?bytes, ?fixups);
    if (sel ended.err) { ret refused[mink_model.Expr](j, ended.err.message, at, 1); }
    ret owned_expr(j, ?bytes, at);
}

# the address type of the table or memory `index` of space `space`
fun address_of(j: *Job, space: u16, index: u32) u32 {
    val got: opt[u32] = wasm_stream.space(j.ctx.stream, space, index);
    if (sel got.some) { ret got.some; }
    ret wasm_stream.I32;
}

# a global's initializer, read in its index order
fun global_init(j: *Job, b: *wasm_body.Reader, p: *Pending) err[diagnostic.Diagnostic] {
    val f:   *Field                                      = ?j.fields.data[p.field];
    var l:   wasm_text.Lexer                             = wasm_text.make(j.text, p.at, f.end + 1);
    val got: res[mink_model.Expr, diagnostic.Diagnostic] = expression(j, b, ?l);
    if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
    table.at[mink_model.Global](?j.out.globals, table.nth[mink_model.Global](p.of::usize)).init = got.ok;
    ret closed(j, ?l);
}

# the function index an expression of one `ref.func` names, none for any other expression
fun ref_func(j: *Job, bytes: *vector.Vector[u8]) opt[u32] {
    var store_: [4]operand.Value;
    var room:   [4]requirement.Alternative;
    var alts:   field.Admissions                 = field.Admissions{at: ?room[0], cap: 4, used: 0};
    val got:    res[walk.Decoded, field.Refusal] = walk.decode(j.codec, j.ctx, bytes.data, bytes.len, 0, ?store_[0], 4, ?alts);
    if (sel got.err)                                             { ret opt[u32].none{}; }
    if (got.ok.inst.row != ?gen_row.ROWS[gen_row_index.REFFUNC]) { ret opt[u32].none{}; }
    if (got.ok.len + 1 != bytes.len)                             { ret opt[u32].none{}; }
    if (!sel got.ok.inst.values[0].id)                           { ret opt[u32].none{}; }
    ret opt[u32].some{got.ok.inst.values[0].id};
}

# what an element segment's items are: function indices of a `(ref func)` segment, or expressions of a reference type
rec Items {
    funcs:   bool;
    type:    u8;
    indices: vector.Vector[u32];
    exprs:   vector.Vector[vector.Vector[u8]];
}

fun drop_items(it: *Items) {
    var i: usize = 0;
    for (i < it.exprs.len) {
        vector.dnit[u8](?it.exprs.data[i]);
        i = i + 1;
    }
    vector.dnit[vector.Vector[u8]](?it.exprs);
    vector.dnit[u32](?it.indices);
}

# the function indices at the lexer onto `out`
fun func_indices(j: *Job, l: *wasm_text.Lexer, out: *vector.Vector[u32]) err[diagnostic.Diagnostic] {
    for (indexed(j, l)) {
        val x: res[u32, diagnostic.Diagnostic] = index(j, l, wasm_kind.FUNCS);
        if (sel x.err) { ret err[diagnostic.Diagnostic].err{x.err}; }
        val pushed: res[usize, A.Error] = vector.push[u32](out, x.ok);
        if (sel pushed.err) { ret refuse(j, field.MEMORY, l.at, 1); }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the expression `ref.func x`, its end after it
fun ref_expr(j: *Job, x: u32, out: *vector.Vector[u8], at: usize) err[diagnostic.Diagnostic] {
    var value:  [1]operand.Value           = [1]operand.Value{operand.Value.id{x}};
    var ins:    inst.Inst                  = inst.Inst{row: ?gen_row.ROWS[gen_row_index.REFFUNC], values: ?value[0], count: 1, form: form.PREFERRED};
    var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](j.a);
    fin { vector.dnit[field.Fixup](?fixups); }
    val wrote: res[usize, field.Refusal] = walk.encode(j.codec, j.ctx, ?ins, out, ?fixups);
    if (sel wrote.err) { ret refuse(j, wrote.err.message, at, 1); }
    var end:   inst.Inst                 = inst.Inst{row: ?gen_row.ROWS[gen_row_index.END], values: nil, count: 0, form: form.PREFERRED};
    val ended: res[usize, field.Refusal] = walk.encode(j.codec, j.ctx, ?end, out, ?fixups);
    if (sel ended.err) { ret refuse(j, ended.err.message, at, 1); }
    ret err[diagnostic.Diagnostic].ok{};
}

# the reference type `(ref func)`, as the syntax holds it: its byte and its heap type above it
val REF_FUNC: i64 = (wasm_container.FUNCREF::i64 - 0x80) * 0x100 + wasm_field.REF::i64;

# an element segment's reference type at the lexer: `(ref func)` as `funcs`, or one byte
fun element_type(j: *Job, l: *wasm_text.Lexer, out: *Items) err[diagnostic.Diagnostic] {
    var r: core_syntax.Reader = reader(j, l);
    syntax_read.skip(?r);
    val at:  usize                           = r.at;
    val got: res[i64, diagnostic.Diagnostic] = wasm_syntax.valtype_read(?r);
    if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
    l.at = r.at;
    if (got.ok == REF_FUNC) {
        out.funcs = true;
        out.type  = wasm_container.FUNCREF;
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (!narrow(got.ok))         { ret refuse(j, WIDE_TYPE, at, r.at - at); }
    if (!reference(got.ok::u32)) { ret refuse(j, NO_REFTYPE, at, r.at - at); }
    out.type = got.ok::u8;
    ret err[diagnostic.Diagnostic].ok{};
}

# an element segment's items at the lexer: a `func` list's indices, or a reference type's `(item instr*)` or folded
# instructions. `bare` reads a list of function indices with no `func` before it, as an active segment's text may
# spell them, a `(ref func)` list. an inline segment's items are of its table's reference type `type`, a bare list of
# them each a `ref.func`
fun items(j: *Job, b: *wasm_body.Reader, l: *wasm_text.Lexer, bare: bool, type: opt[u8], out: *Items) err[diagnostic.Diagnostic] {
    if (sel type.some) {
        out.type = type.some;
        if (indexed(j, l) || wasm_text.ahead(l).kind == wasm_text.CLOSE) {
            var listed: vector.Vector[u32] = vector.init[u32](j.a);
            fin { vector.dnit[u32](?listed); }
            val got: err[diagnostic.Diagnostic] = func_indices(j, l, ?listed);
            if (sel got.err) { ret got; }
            var i: usize = 0;
            for (i < listed.len) {
                var bytes:  vector.Vector[u8]          = vector.init[u8](j.a);
                val wrote:  err[diagnostic.Diagnostic] = ref_expr(j, listed.data[i], ?bytes, l.at);
                val pushed: res[usize, A.Error]        = vector.push[vector.Vector[u8]](?out.exprs, bytes);
                if (sel wrote.err)  { ret wrote; }
                if (sel pushed.err) { ret refuse(j, field.MEMORY, l.at, 1); }
                i = i + 1;
            }
            ret err[diagnostic.Diagnostic].ok{};
        }
    }
    or (wasm_text.is(l, wasm_text.ahead(l), "func")) {
        val passed: wasm_text.Token = wasm_text.next(l);
        out.funcs = true;
        ret func_indices(j, l, ?out.indices);
    }
    or (bare && (indexed(j, l) || wasm_text.ahead(l).kind == wasm_text.CLOSE)) {
        out.funcs = true;
        ret func_indices(j, l, ?out.indices);
    }
    or {
        val typed: err[diagnostic.Diagnostic] = element_type(j, l, out);
        if (sel typed.err) { ret typed; }
    }
    for (wasm_text.ahead(l).kind == wasm_text.OPEN) {
        val at:    usize                      = l.at;
        var bytes: vector.Vector[u8]          = vector.init[u8](j.a);
        var got:   err[diagnostic.Diagnostic] = err[diagnostic.Diagnostic].ok{};
        if (wasm_text.opens(l, "item")) {
            got = wasm_body.expression(b, l, ?bytes);
            if (!sel got.err) { got = closed(j, l); }
        }
        or { got = wasm_body.folded_expression(b, l, ?bytes); }
        if (sel got.err) {
            vector.dnit[u8](?bytes);
            ret got;
        }
        if (out.funcs) {
            # a (ref func) segment's items are function indices, each an expression of one ref.func
            val x: opt[u32] = ref_func(j, ?bytes);
            vector.dnit[u8](?bytes);
            if (sel x.none) { ret refuse(j, NO_ITEM, at, 1); }
            val kept_: res[usize, A.Error] = vector.push[u32](?out.indices, x.some);
            if (sel kept_.err) { ret refuse(j, field.MEMORY, at, 1); }
            cnt;
        }
        val pushed: res[usize, A.Error] = vector.push[vector.Vector[u8]](?out.exprs, bytes);
        if (sel pushed.err) { ret refuse(j, field.MEMORY, at, 1); }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# whether an offset, `(offset ...)` or a folded instruction, is at the lexer
fun offset_ahead(j: *Job, b: *wasm_body.Reader, l: *wasm_text.Lexer) bool {
    var copy: wasm_text.Lexer = @l;
    if (wasm_text.next(?copy).kind != wasm_text.OPEN) { ret false; }
    val t: wasm_text.Token = wasm_text.next(?copy);
    ret wasm_text.is(l, t, "offset") || wasm_body.instruction(b, t);
}

# the element segment `p` notes, read in its index order: `declare`, or a table use and an offset for an active one,
# then its items, as the binary takes them under the flags `element_flags` chooses
fun element(j: *Job, b: *wasm_body.Reader, p: *Pending) err[diagnostic.Diagnostic] {
    val f:    *Field          = ?j.fields.data[p.field];
    var l:    wasm_text.Lexer = wasm_text.make(j.text, p.at, f.end + 1);
    var mode: u64             = wasm_container.PASSIVE;
    var tab:  u32             = p.of;
    var off:  mink_model.Expr = mink_model.Expr{bytes: Held.owned{store.Span{start: 0, len: 0}}};
    var type: opt[u8]         = opt[u8].none{};
    if (p.inline) {
        mode = wasm_container.ACTIVE;
        val z: res[mink_model.Expr, diagnostic.Diagnostic] = zero(j, address_of(j, wasm_kind.TABLES, tab), f.keyword.at);
        if (sel z.err) { ret err[diagnostic.Diagnostic].err{z.err}; }
        off  = z.ok;
        type = opt[u8].some{p.type};
    }
    or (wasm_text.is(?l, wasm_text.ahead(?l), "declare")) {
        val passed: wasm_text.Token = wasm_text.next(?l);
        mode = wasm_container.DECLARED;
    }
    or {
        var used: bool = false;
        if (wasm_text.opens(?l, "table")) {
            val x: res[u32, diagnostic.Diagnostic] = index(j, ?l, wasm_kind.TABLES);
            if (sel x.err) { ret err[diagnostic.Diagnostic].err{x.err}; }
            val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
            if (sel shut.err) { ret shut; }
            tab  = x.ok;
            used = true;
        }
        or (indexed(j, ?l)) {
            val x: res[u32, diagnostic.Diagnostic] = index(j, ?l, wasm_kind.TABLES);
            if (sel x.err) { ret err[diagnostic.Diagnostic].err{x.err}; }
            tab  = x.ok;
            used = true;
        }
        if (used || offset_ahead(j, b, ?l)) {
            val o: res[mink_model.Expr, diagnostic.Diagnostic] = offset(j, b, ?l);
            if (sel o.err) { ret err[diagnostic.Diagnostic].err{o.err}; }
            off  = o.ok;
            mode = wasm_container.ACTIVE;
        }
    }
    var it: Items = Items{funcs: false, type: 0, indices: vector.init[u32](j.a), exprs: vector.init[vector.Vector[u8]](j.a)};
    fin { drop_items(?it); }
    val got: err[diagnostic.Diagnostic] = items(j, b, ?l, mode == wasm_container.ACTIVE, type, ?it);
    if (sel got.err) { ret got; }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val flags: u64                = wasm_container.element_flags(mode, tab, it.funcs, it.type);
    var e:     mink_model.Element = mink_model.Element{flags: wasm_container.leb(flags), table: wasm_container.leb(tab::u64), offset: off, kind: 0, type: wasm_container.ref_type(wasm_container.FUNCREF::i64), items: mink_model.Items.indices{wasm_container.run(0, 0)}};
    var i:     usize              = 0;
    if (!it.funcs) {
        e.type = wasm_container.ref_type(it.type::i64);
        val first: usize = table.count[mink_model.Expr](?j.out.exprs);
        for (i < it.exprs.len) {
            val held: res[mink_model.Expr, diagnostic.Diagnostic] = owned_expr(j, ?it.exprs.data[i], f.keyword.at);
            if (sel held.err) { ret err[diagnostic.Diagnostic].err{held.err}; }
            val pushed: err[diagnostic.Diagnostic] = kept[mink_model.Expr](j, table.push[mink_model.Expr](?j.out.exprs, held.ok), f.keyword.at);
            if (sel pushed.err) { ret pushed; }
            i = i + 1;
        }
        e.items = mink_model.Items.exprs{wasm_container.run(first, it.exprs.len)};
        ret kept[mink_model.Element](j, table.push[mink_model.Element](?j.out.elements, e), f.keyword.at);
    }
    val first: usize = table.count[mink_model.Leb](?j.out.indices);
    for (i < it.indices.len) {
        val pushed: err[diagnostic.Diagnostic] = kept[mink_model.Leb](j, table.push[mink_model.Leb](?j.out.indices, wasm_container.leb(it.indices.data[i]::u64)), f.keyword.at);
        if (sel pushed.err) { ret pushed; }
        i = i + 1;
    }
    e.items = mink_model.Items.indices{wasm_container.run(first, it.indices.len)};
    ret kept[mink_model.Element](j, table.push[mink_model.Element](?j.out.elements, e), f.keyword.at);
}

# the data segment `p` notes, read in its index order: a memory use and an offset for an active one, then its strings
fun data(j: *Job, b: *wasm_body.Reader, p: *Pending) err[diagnostic.Diagnostic] {
    val f:    *Field          = ?j.fields.data[p.field];
    var l:    wasm_text.Lexer = wasm_text.make(j.text, p.at, f.end + 1);
    var mode: u64             = wasm_container.PASSIVE;
    var mem:  u32             = p.of;
    var off:  mink_model.Expr = mink_model.Expr{bytes: Held.owned{store.Span{start: 0, len: 0}}};
    if (p.inline) {
        mode = wasm_container.ACTIVE;
        val z: res[mink_model.Expr, diagnostic.Diagnostic] = zero(j, address_of(j, wasm_kind.MEMORIES, mem), f.keyword.at);
        if (sel z.err) { ret err[diagnostic.Diagnostic].err{z.err}; }
        off = z.ok;
    }
    or {
        var used: bool = false;
        if (wasm_text.opens(?l, "memory")) {
            val x: res[u32, diagnostic.Diagnostic] = index(j, ?l, wasm_kind.MEMORIES);
            if (sel x.err) { ret err[diagnostic.Diagnostic].err{x.err}; }
            val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
            if (sel shut.err) { ret shut; }
            mem  = x.ok;
            used = true;
        }
        or (indexed(j, ?l)) {
            val x: res[u32, diagnostic.Diagnostic] = index(j, ?l, wasm_kind.MEMORIES);
            if (sel x.err) { ret err[diagnostic.Diagnostic].err{x.err}; }
            mem  = x.ok;
            used = true;
        }
        if (used || offset_ahead(j, b, ?l)) {
            val o: res[mink_model.Expr, diagnostic.Diagnostic] = offset(j, b, ?l);
            if (sel o.err) { ret err[diagnostic.Diagnostic].err{o.err}; }
            off  = o.ok;
            mode = wasm_container.ACTIVE;
        }
    }
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    val got: err[diagnostic.Diagnostic] = strings(j, ?l, ?bytes);
    if (sel got.err) { ret got; }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val held: res[Held, Fail] = wasm_container.held(j.out, ?bytes);
    if (sel held.err) { ret failed(j, held.err, f.keyword.at); }
    val s: mink_model.Segment = mink_model.Segment{flags: wasm_container.leb(wasm_container.data_flags(mode, mem)), memory: wasm_container.leb(mem::u64), offset: off, width: mink_model.SHORTEST, data: held.ok};
    ret kept[mink_model.Segment](j, table.push[mink_model.Segment](?j.out.data, s), f.keyword.at);
}

# the locals at the lexer, `(local $id t)` or `(local t*)`, defined after the params, onto `types`
fun locals(j: *Job, l: *wasm_text.Lexer, types: *vector.Vector[u32]) err[diagnostic.Diagnostic] {
    for (wasm_text.opens(l, "local")) {
        val name: View = identifier(j, l);
        for {
            val t: wasm_text.Token = wasm_text.ahead(l);
            if (t.kind == wasm_text.CLOSE) { brk; }
            val got: res[u32, diagnostic.Diagnostic] = value_type(j, l);
            if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
            val defined: res[u32, str] = wasm_stream.define(j.ctx.stream, wasm_kind.LOCALS, got.ok, name);
            if (sel defined.err) { ret refuse(j, defined.err, t.at, t.len); }
            val pushed: res[usize, A.Error] = vector.push[u32](types, got.ok);
            if (sel pushed.err) { ret refuse(j, field.MEMORY, t.at, t.len); }
            if (name.len > 0)   { brk; }
        }
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret shut; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the locals vector of a body: each run of locals of one type as its count and its type
fun local_runs(out: *vector.Vector[u8], types: *vector.Vector[u32]) {
    var runs: u64   = 0;
    var i:    usize = 0;
    for (i < types.len) {
        if (i == 0 || types.data[i] != types.data[i - 1]) { runs = runs + 1; }
        i = i + 1;
    }
    wasm_leb.put_unsigned(out, runs);
    i = 0;
    for (i < types.len) {
        var n: usize = i;
        for (n < types.len && types.data[n] == types.data[i]) { n = n + 1; }
        wasm_leb.put_unsigned(out, (n - i)::u64);
        vector.push[u8](out, types.data[i]::u8);
        i = n;
    }
}

# function `d`'s body: the stream entered at its type, its params named, its locals and its code, onto the model's code
fun body_of(j: *Job, b: *wasm_body.Reader, d: *Defined) err[diagnostic.Diagnostic] {
    val type: u32             = table.at[mink_model.Leb](?j.out.functions, table.nth[mink_model.Leb](d.index::usize)).value::u32;
    val f:    *Field          = ?j.fields.data[d.field];
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val entered: err[str] = wasm_stream.enter(j.ctx.stream, type);
    if (sel entered.err) { ret refuse(j, entered.err, l.at, 1); }
    var names: vector.Vector[View] = vector.init[View](j.a);
    fin { vector.dnit[View](?names); }
    val typed: res[u32, diagnostic.Diagnostic] = type_use(j, ?l, ?names);
    if (sel typed.err) { ret err[diagnostic.Diagnostic].err{typed.err}; }
    var i: usize = 0;
    for (i < names.len) {
        val named: err[str] = wasm_stream.name_local(j.ctx.stream, i::u32, names.data[i]);
        if (sel named.err) { ret refuse(j, named.err, l.at, 1); }
        i = i + 1;
    }
    var types: vector.Vector[u32] = vector.init[u32](j.a);
    fin { vector.dnit[u32](?types); }
    val declared: err[diagnostic.Diagnostic] = locals(j, ?l, ?types);
    if (sel declared.err) { ret declared; }
    var body: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?body); }
    local_runs(?body, ?types);
    val code: err[diagnostic.Diagnostic] = wasm_body.function(b, ?l, ?body);
    if (sel code.err) { ret code; }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val held: res[Held, Fail] = wasm_container.held(j.out, ?body);
    if (sel held.err) { ret failed(j, held.err, f.keyword.at); }
    ret kept[mink_model.Function](j, table.push[mink_model.Function](?j.out.code, mink_model.Function{width: mink_model.SHORTEST, body: held.ok}), f.keyword.at);
}

# the module the `len` bytes of `source` spell, read under `ctx`, whose stream it begins and fills, into `out`, mink's
# model of it, which its caller releases whether or not the read is refused
# ---
# origin: the position of the text's first byte
pub fun read(a: *A.Allocator, source: *u8, len: usize, origin: diagnostic.Position, codec: *dispatch.Codec, ctx: *state.Context, out: *mink_model.Module) err[diagnostic.Diagnostic] {
    @out = mink_model.make(a);
    wasm_stream.HOOKS.begin(ctx.stream);
    # the fields are read from a copy whose comments are blanked, so the instruction syntax's readers pass them as
    # the white space they are
    val copied: res[*u8, A.Error] = wasm_text.blanked(a, source, len);
    if (sel copied.err) { ret err[diagnostic.Diagnostic].err{diagnostic.refusal(field.MEMORY, origin, source, 0, 0)}; }
    val text: *u8 = copied.ok;
    fin { val freed: err[A.Error] = A.deallocate[u8](a, text, len + 1); }
    var j: Job = Job{a: a, text: text, origin: origin, codec: codec, ctx: ctx, fields: vector.init[Field](a), funcs: vector.init[Defined](a), globals: vector.init[Pending](a), elements: vector.init[Pending](a), datas: vector.init[Pending](a), start: opt[u32].none{}, started: false, out: out};
    fin {
        vector.dnit[Field](?j.fields);
        vector.dnit[Defined](?j.funcs);
        vector.dnit[Pending](?j.globals);
        vector.dnit[Pending](?j.elements);
        vector.dnit[Pending](?j.datas);
    }
    var l:      wasm_text.Lexer            = wasm_text.make(text, 0, len);
    val listed: err[diagnostic.Diagnostic] = fields(?j, ?l);
    if (sel listed.err) { ret listed; }
    var b: wasm_body.Reader = wasm_body.make(a, text, origin, codec, ctx);
    fin { wasm_body.release(?b); }
    var k: usize = 0;
    for (k < j.fields.len) {
        val f: *Field = ?j.fields.data[k];
        if (is(?j, f, "type")) {
            val got: err[diagnostic.Diagnostic] = type_field(?j, f);
            if (sel got.err) { ret got; }
        }
        or (is(?j, f, "rec")) { ret refuse(?j, GC_TYPE, f.keyword.at, f.keyword.len); }
        k = k + 1;
    }
    k = 0;
    for (k < j.fields.len) {
        val f:   *Field                     = ?j.fields.data[k];
        var got: err[diagnostic.Diagnostic] = err[diagnostic.Diagnostic].ok{};
        if (is(?j, f, "import"))                                               { got = import_field(?j, f); }
        or (is(?j, f, "func"))                                                 { got = func_field(?j, ?b, f, k::u32); }
        or (is(?j, f, "table"))                                                { got = table_field(?j, f, k::u32); }
        or (is(?j, f, "memory"))                                               { got = memory_field(?j, f, k::u32); }
        or (is(?j, f, "global"))                                               { got = global_field(?j, f, k::u32); }
        or (is(?j, f, "tag"))                                                  { got = tag_field(?j, f); }
        or (is(?j, f, "elem") || is(?j, f, "data"))                            { got = segment_field(?j, f, k::u32); }
        or (!is(?j, f, "type") && !is(?j, f, "export") && !is(?j, f, "start")) { got = refuse(?j, UNREAD_FIELD, f.keyword.at, f.keyword.len); }
        if (sel got.err)                                                       { ret got; }
        k = k + 1;
    }
    k = 0;
    for (k < j.fields.len) {
        val f:   *Field                     = ?j.fields.data[k];
        var got: err[diagnostic.Diagnostic] = err[diagnostic.Diagnostic].ok{};
        if (is(?j, f, "export")) { got = export_field(?j, f); }
        or (is(?j, f, "start"))  { got = start_field(?j, f); }
        or (f.defines)           { got = inline_exports(?j, f); }
        if (sel got.err)         { ret got; }
        k = k + 1;
    }
    k = 0;
    for (k < j.globals.len) {
        val got: err[diagnostic.Diagnostic] = global_init(?j, ?b, ?j.globals.data[k]);
        if (sel got.err) { ret got; }
        k = k + 1;
    }
    k = 0;
    for (k < j.elements.len) {
        val got: err[diagnostic.Diagnostic] = element(?j, ?b, ?j.elements.data[k]);
        if (sel got.err) { ret got; }
        k = k + 1;
    }
    k = 0;
    for (k < j.datas.len) {
        val got: err[diagnostic.Diagnostic] = data(?j, ?b, ?j.datas.data[k]);
        if (sel got.err) { ret got; }
        k = k + 1;
    }
    k = 0;
    for (k < j.funcs.len) {
        val got: err[diagnostic.Diagnostic] = body_of(?j, ?b, ?j.funcs.data[k]);
        if (sel got.err) { ret got; }
        k = k + 1;
    }
    val shut: err[Fail] = wasm_container.close(out, ctx.stream, j.start, b.datas);
    if (sel shut.err) { ret failed(?j, shut.err, 0); }
    ret err[diagnostic.Diagnostic].ok{};
}

#[testing]
rec T {
    t:   testing.Testing;
    s:   extension.Selection;
    v:   register.Available;
    ctx: state.Context;
}

# a test under every extension, its stream not begun
#[testing]
fun t_make(t: *T) bool {
    testing.make(?t.t);
    val a:    *A.Allocator                            = testing.allocator_of(?t.t);
    val made: res[extension.Request, extension.Error] = extension.request(a, ?wasm_extension.CATALOG, "", diagnostic.START);
    if (sel made.err) { ret false; }
    var req: extension.Request = made.ok;
    var id:  u32               = 0;
    for (id < gen_extension.COUNT) {
        extension.request_add(?req, id::requirement.Id);
        id = id + 1;
    }
    val closed_: res[extension.Selection, extension.Error] = extension.close(req);
    if (sel closed_.err) { ret false; }
    t.s = closed_.ok;
    val opened: res[state.Context, state.Opened] = state.open(a, nil, ?t.s, ?wasm_extension.AXES, state.initial(?wasm_extension.AXES), ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx = opened.ok;
    val stream: res[ptr, A.Error] = wasm_stream.HOOKS.make(a);
    if (sel stream.err) { ret false; }
    t.ctx.stream = stream.ok;
    ret true;
}

#[testing]
fun t_drop(t: *T, m: *mink_model.Module) {
    val released: err[Fail] = mink_model.release(m);
    wasm_stream.HOOKS.release(testing.allocator_of(?t.t), t.ctx.stream);
    val dropped: err[A.Error] = extension.release(?t.s);
}

#[testing]
fun t_read(t: *T, text: str, m: *mink_model.Module) err[diagnostic.Diagnostic] {
    ret read(testing.allocator_of(?t.t), text, str_len(text), diagnostic.START, ?wasm_codec.CODEC, ?t.ctx, m);
}

# the module `text` read, reported on refusal
#[testing]
fun t_reads(t: *T, text: str, m: *mink_model.Module) bool {
    val got: err[diagnostic.Diagnostic] = t_read(t, text, m);
    if (sel got.err) {
        print.eprintlnf("{} at {}:{}", got.err.message, got.err.span.start.line, got.err.span.start.column);
        ret false;
    }
    ret true;
}

# whether the `n` bytes at `got` are the `n` bytes `want` names, the first difference reported
#[testing]
fun t_same(got: *u8, len: usize, want: *u8, n: usize) bool {
    if (len != n) {
        print.eprintlnf("{} bytes for {}", len, n);
        ret false;
    }
    var i: usize = 0;
    for (i < n) {
        if (got[i] != want[i]) {
            print.eprintlnf("byte {}: {} for {}", i, got[i], want[i]);
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

# whether the module `text` reads and mink writes it as the `n` bytes `want`
#[testing]
fun t_writes(t: *T, text: str, want: *u8, n: usize) bool {
    var m: mink_model.Module;
    if (!t_reads(t, text, ?m)) {
        t_drop(t, ?m);
        ret false;
    }
    val wrote: res[Sink, Fail] = mink_write.write(testing.allocator_of(?t.t), ?m);
    if (sel wrote.err) {
        print.eprintlnf("mink refused the module: {}", wrote.err.text);
        t_drop(t, ?m);
        ret false;
    }
    var out:  Sink      = wrote.ok;
    val same: bool      = t_same(sink.data(?out), sink.len(?out), want, n);
    val gone: err[Fail] = sink.release(?out);
    t_drop(t, ?m);
    ret same;
}

# function `k`'s body as the model holds it
#[testing]
fun t_code(m: *mink_model.Module, k: usize) store.Bytes {
    ret mink_model.bytes(m, ?table.at[mink_model.Function](?m.code, table.nth[mink_model.Function](k)).body);
}

#[testing]
fun t_body(m: *mink_model.Module, k: usize, want: *u8, n: usize) bool {
    if (k >= table.count[mink_model.Function](?m.code)) { ret false; }
    val b: store.Bytes = t_code(m, k);
    ret t_same(b.data, b.len, want, n);
}

#[testing]
val T_GA4: str = "(module\n  (memory $m i64 1)\n  (func $f (export \"f\") (param $a i64) (param $k i32) (result i64)\n    (local $x i64)\n    (block $done (result i64)\n      (block $one\n        (block $zero\n          (br_table $zero $one (local.get $k)))\n        (br $done (i64.load offset=8 (local.get $a))))\n      (select (result i64) (local.get $a) (i64.const 0) (local.get $k)))))\n";

# wat2wasm 1.0.42's module of T_GA4 (`--enable-threads --enable-function-references`, as the agreement asks it):
# its one type, its function, its memory64 memory, its export and its body of one local, block, br_table, an i64.load
# of memory64 and select t. wasm-validate 1.0.42 passes it
#[testing]
val T_GA4_WASM: [72]u8 = [72]u8{
    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x07, 0x01, 0x60, 0x02, 0x7e, 0x7f, 0x01, 0x7e, 0x03, 0x02, 0x01,
    0x00, 0x05, 0x03, 0x01, 0x04, 0x01, 0x07, 0x05, 0x01, 0x01, 0x66, 0x00, 0x00, 0x0a, 0x25, 0x01, 0x23, 0x01, 0x01, 0x7e,
    0x02, 0x7e, 0x02, 0x40, 0x02, 0x40, 0x20, 0x01, 0x0e, 0x01, 0x00, 0x01, 0x0b, 0x20, 0x00, 0x29, 0x03, 0x08, 0x0c, 0x01,
    0x0b, 0x20, 0x00, 0x42, 0x00, 0x20, 0x01, 0x1c, 0x01, 0x7e, 0x0b, 0x0b,
};

# GA4: a function of folded block, br_table, select t and an i64.load of a memory64 memory is written to mink's wasm
# container as wat2wasm writes it, its inline type added once and its inline export expanded, and mink reads the
# written module back to the same body
test read__ga4_writes_wat2wasm_module {
    var t: T;
    if (!t_make(?t))                              { ret 1; }
    if (!t_writes(?t, T_GA4, ?T_GA4_WASM[0], 72)) { ret 2; }
    var u: T;
    if (!t_make(?u)) { ret 3; }
    var m: mink_model.Module;
    if (!t_reads(?u, T_GA4, ?m)) { ret 4; }
    val wrote: res[Sink, Fail] = mink_write.write(testing.allocator_of(?u.t), ?m);
    if (sel wrote.err) { ret 5; }
    var out:   Sink                         = wrote.ok;
    var input: mink_contract.Input          = mink_contract.Input{file: "ga4", data: sink.data(?out), len: sink.len(?out)};
    var back:  res[mink_model.Module, Fail] = mink_read.read(testing.allocator_of(?u.t), ?input);
    if (sel back.err) { ret 6; }
    val ours:   store.Bytes = t_code(?m, 0);
    val theirs: store.Bytes = t_code(?back.ok, 0);
    if (!t_same(theirs.data, theirs.len, ours.data, ours.len)) { ret 7; }
    val gone:  err[Fail] = mink_model.release(?back.ok);
    val freed: err[Fail] = sink.release(?out);
    t_drop(?u, ?m);
    ret 0;
}

# a folded expression reads as its flat sequence, and a label by name resolves to its depth, a plain end repeating it
test read__folded_reads_as_flat_and_a_label_resolves_to_its_depth {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var m:    mink_model.Module;
    val text: str = "(func (result i32) (i32.add (i32.const 1) (i32.const 2)))\n(func (result i32) i32.const 1 i32.const 2 i32.add)\n(func (block $a (block $b (br $a))))\n(func block $a block $b br $a end $b end $a)";
    if (!t_reads(?t, text, ?m)) { ret 2; }
    val sum:    [7]u8  = [7]u8{0x00, 0x41, 0x01, 0x41, 0x02, 0x6a, 0x0b};
    val nested: [10]u8 = [10]u8{0x00, 0x02, 0x40, 0x02, 0x40, 0x0c, 0x01, 0x0b, 0x0b, 0x0b};
    if (!t_body(?m, 0, ?sum[0], 7) || !t_body(?m, 1, ?sum[0], 7))         { ret 3; }
    if (!t_body(?m, 2, ?nested[0], 10) || !t_body(?m, 3, ?nested[0], 10)) { ret 4; }
    if (table.count[mink_model.FuncType](?m.types) != 2)                  { ret 5; }
    t_drop(?t, ?m);
    var u: T;
    if (!t_make(?u)) { ret 6; }
    var other: mink_model.Module;
    val wrong: err[diagnostic.Diagnostic] = t_read(?u, "(func block $a block $b end $a end)", ?other);
    if (!sel wrong.err)                             { ret 7; }
    if (wrong.err.message != wasm_body.OTHER_LABEL) { ret 8; }
    t_drop(?u, ?other);
    ret 0;
}

# a type use resolves its index, by `(type $t)` or by the params and results it states, and one of params and results
# no type states adds its type where the text gives it: a function's before its body's, a body's before a later
# function's, as wat2wasm numbers them
test read__a_type_use_resolves_its_index {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var m:    mink_model.Module;
    val text: str = "(type $n (func))\n(type $t (func (param i32) (result i32)))\n(func (param i32) (result i32) local.get 0 block (type $t) end)\n(func (type $t) local.get 0 block (param i32) (result i32) end)";
    if (!t_reads(?t, text, ?m)) { ret 2; }
    val body: [7]u8 = [7]u8{0x00, 0x20, 0x00, 0x02, 0x01, 0x0b, 0x0b};
    if (!t_body(?m, 0, ?body[0], 7) || !t_body(?m, 1, ?body[0], 7)) { ret 3; }
    if (table.count[mink_model.FuncType](?m.types) != 2)            { ret 4; }
    t_drop(?t, ?m);
    # wat2wasm 1.0.42 of the text: types (param i32), (param i64) (result i64 i64), (param f32), each where it is used
    var u: T;
    if (!t_make(?u)) { ret 5; }
    val implied: str    = "(func (param i32) i64.const 0 block (param i64) (result i64 i64) unreachable end unreachable)\n(func (param f32) unreachable)";
    val want:    [47]u8 = [47]u8{
        0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x0f, 0x03, 0x60, 0x01, 0x7f, 0x00, 0x60, 0x01, 0x7e, 0x02, 0x7e,
        0x7e, 0x60, 0x01, 0x7d, 0x00, 0x03, 0x03, 0x02, 0x00, 0x02, 0x0a, 0x0f, 0x02, 0x09, 0x00, 0x42, 0x00, 0x02, 0x01, 0x00,
        0x0b, 0x00, 0x0b, 0x03, 0x00, 0x00, 0x0b,
    };
    if (!t_writes(?u, implied, ?want[0], 47)) { ret 6; }
    ret 0;
}

# an identifier resolves in its own index space: `$x` names a type, a function, a memory and a global apart, a quoted
# `$"x"` names what `$x` does, and a comment between a field's tokens is white space
test read__an_identifier_resolves_in_its_own_index_space {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    # wat2wasm 1.0.42 of the text
    val want: [46]u8 = [46]u8{
        0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x04, 0x01, 0x60, 0x00, 0x00, 0x03, 0x03, 0x02, 0x00, 0x00, 0x05,
        0x03, 0x01, 0x00, 0x01, 0x06, 0x06, 0x01, 0x7f, 0x00, 0x41, 0x07, 0x0b, 0x0a, 0x0c, 0x02, 0x02, 0x00, 0x0b, 0x07, 0x00,
        0x10, 0x00, 0x23, 0x00, 0x1a, 0x0b,
    };
    if (!t_writes(?t, "(module (type $x (func)) (func $\"x\" (type $x)) (memory $x 1) (global $x (; c ;) i32 (i32.const 7)) (func (call $x) (global.get $x) (drop)))", ?want[0], 46)) { ret 2; }
    ret 0;
}

# an inline export expands to the export field it abbreviates, in text order with the export fields, and an inline
# type use adds its type once for every function that states it
test read__an_inline_export_expands_and_an_inline_type_is_added_once {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    # wat2wasm 1.0.42 of the text: one type, exports a, b and c of function 0
    val want: [49]u8 = [49]u8{
        0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x06, 0x01, 0x60, 0x01, 0x7f, 0x01, 0x7f, 0x03, 0x03, 0x02, 0x00,
        0x00, 0x07, 0x0d, 0x03, 0x01, 0x61, 0x00, 0x00, 0x01, 0x62, 0x00, 0x00, 0x01, 0x63, 0x00, 0x00, 0x0a, 0x0b, 0x02, 0x04,
        0x00, 0x20, 0x00, 0x0b, 0x04, 0x00, 0x41, 0x01, 0x0b,
    };
    if (!t_writes(?t, "(module (func $a (export \"a\") (export \"b\") (param i32) (result i32) (local.get 0)) (func (param i32) (result i32) (i32.const 1)) (export \"c\" (func $a)))", ?want[0], 49)) { ret 2; }
    ret 0;
}

# an identifier given twice in one index space is refused, and the same in two spaces is not
test read__a_duplicate_identifier_is_refused {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var m:   mink_model.Module;
    val got: err[diagnostic.Diagnostic] = t_read(?t, "(module (func $f) (memory $m 1) (func $f))", ?m);
    if (!sel got.err)                               { ret 2; }
    if (got.err.message != wasm_stream.NAMED_TWICE) { ret 3; }
    t_drop(?t, ?m);
    ret 0;
}

#[testing]
val T_FIELDS: str = "(module\n  (import \"env\" \"f\" (func $imp (param i32)))\n  (import \"env\" \"g\" (global $gi i32))\n  (table $t 2 funcref)\n  (table $u funcref (elem $main $imp))\n  (memory $m 1 2)\n  (memory (data \"hi\" \"\\u{1F600}\"))\n  (tag $e (param i32))\n  (global $g (mut i64) (i64.const -1))\n  (global funcref (ref.func $main))\n  (func $main (export \"main\") (result i32)\n    (call $imp (global.get $gi))\n    (data.drop $d)\n    (i32.const 0))\n  (func $s)\n  (start $s)\n  (elem (table $t) (i32.const 0) func $main)\n  (elem $p funcref (ref.func $imp) (ref.null func))\n  (elem declare func $main)\n  (data $d \"x\")\n  (data (memory $m) (offset (i32.const 8)) \"yz\"))\n";

# wat2wasm 1.0.42's module of T_FIELDS (`--enable-threads --enable-function-references`): its imports, two tables,
# the second's inline segment as ref.func expressions, two memories, the second's inline data, a tag, two globals,
# an export, a start function, element segments active, passive and declared, the data count a data.drop needs, and
# three data segments. wasm-validate 1.0.42 passes it
#[testing]
val T_FIELDS_WASM: [178]u8 = [178]u8{
    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x0c, 0x03, 0x60, 0x01, 0x7f, 0x00, 0x60, 0x00, 0x01, 0x7f, 0x60,
    0x00, 0x00, 0x02, 0x12, 0x02, 0x03, 0x65, 0x6e, 0x76, 0x01, 0x66, 0x00, 0x00, 0x03, 0x65, 0x6e, 0x76, 0x01, 0x67, 0x03,
    0x7f, 0x00, 0x03, 0x03, 0x02, 0x01, 0x02, 0x04, 0x08, 0x02, 0x70, 0x00, 0x02, 0x70, 0x01, 0x02, 0x02, 0x05, 0x07, 0x02,
    0x01, 0x01, 0x02, 0x01, 0x01, 0x01, 0x0d, 0x03, 0x01, 0x00, 0x00, 0x06, 0x0b, 0x02, 0x7e, 0x01, 0x42, 0x7f, 0x0b, 0x70,
    0x00, 0xd2, 0x01, 0x0b, 0x07, 0x08, 0x01, 0x04, 0x6d, 0x61, 0x69, 0x6e, 0x00, 0x01, 0x08, 0x01, 0x02, 0x09, 0x21, 0x04,
    0x06, 0x01, 0x41, 0x00, 0x0b, 0x70, 0x02, 0xd2, 0x01, 0x0b, 0xd2, 0x00, 0x0b, 0x00, 0x41, 0x00, 0x0b, 0x01, 0x01, 0x05,
    0x70, 0x02, 0xd2, 0x00, 0x0b, 0xd0, 0x70, 0x0b, 0x03, 0x00, 0x01, 0x01, 0x0c, 0x01, 0x03, 0x0a, 0x10, 0x02, 0x0b, 0x00,
    0x23, 0x00, 0x10, 0x00, 0xfc, 0x09, 0x01, 0x41, 0x00, 0x0b, 0x02, 0x00, 0x0b, 0x0b, 0x17, 0x03, 0x02, 0x01, 0x41, 0x00,
    0x0b, 0x06, 0x68, 0x69, 0xf0, 0x9f, 0x98, 0x80, 0x01, 0x01, 0x78, 0x00, 0x41, 0x08, 0x0b, 0x02, 0x79, 0x7a,
