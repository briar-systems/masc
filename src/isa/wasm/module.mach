# a wasm module read from its text into mink's neutral object
#
# a module's text is `(module $id? field*)`, or its fields alone (WebAssembly Specification release 3.0, tag wg-3.0,
# 6.3-text.modules.spectec). its identifiers name entries of index spaces every field fills, so a field may name what
# a later one defines: the reader takes the fields in passes.
#   - the names of the type fields, so a type may name itself, then the type fields, so a type is numbered in its
#     field's order
#   - each definition and import in text order, its index in its space and its type, and the types its type uses
#     imply added after the last as the text gives them: a function's own, then those of its body's instructions
#     (`masc.isa.wasm.body.imply`)
#   - the exports in text order, an inline `(export "n")` as the export field it abbreviates, and the start function
#   - each global's and table's initializer and each segment's offset and items, in their index order
#   - the function bodies, each read through the stream entered at its function
# an inline `(import "m" "n")` is the import it abbreviates, a table's inline `(elem ...)` the table of as many
# entries and an active segment of them right after it, and a memory's inline `(data ...)` the memory of as many pages
# and an active segment of it.
#
# the module is stated through `masc.isa.wasm.object` as each entry is read, and finished into mink's neutral object,
# which mink writes as the module. where the binary leaves a choice the text does not make, the reader makes it: an
# active element segment writes its table's index for a table other than the first or for items of a type other than
# funcref, and its items as expressions unless they are a `(ref func)` list, and an active data segment writes its
# memory's index for a memory other than the first. a module writes its data count where a body names a data segment.
# what mink's facts cannot state is refused, never skipped: a type of the gc proposal, a memory's page size and a
# table's initializer.
#
# the text is the module's own form (`MODULE`): the printer (`masc.isa.wasm.print`) writes the fields of a module read
# as mink's neutral object, and this reader reads them back to one, which mink writes to the same bytes.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use mink.base.fail.Fail;
use mink.base.table.Id;
use mink_arch:    mink.catalog.arch;
use catalog_kind: mink.catalog.kind;
use mink.format.wasm.fact;
use mink_object: mink.model.object;

use masc.codec.walk;
use masc.core.diagnostic;
use masc.core.dispatch;
use masc.core.field;
use masc.core.form;
use masc.core.inst;
use masc.core.operand;
use masc.core.requirement;
use masc.core.state;
use masc.core.stream;
use core_syntax: masc.core.syntax;
use syntax_read: masc.syntax.read;

use wasm_body:    masc.isa.wasm.body;
use wasm_codec:   masc.isa.wasm.codec;
use wasm_field:   masc.isa.wasm.field;
use wasm_kind:    masc.isa.wasm.kind;
use wasm_leb:     masc.isa.wasm.leb;
use wasm_object:  masc.isa.wasm.object;
use wasm_print:   masc.isa.wasm.print;
use wasm_stream:  masc.isa.wasm.stream;
use wasm_syntax:  masc.isa.wasm.syntax;
use wasm_text:    masc.isa.wasm.text;
use wasm_valtype: masc.isa.wasm.valtype;

use masc.isa.wasm.gen_row;
use masc.isa.wasm.gen_row_index;

pub val NOT_A_FIELD:  str = "expected a module field";
pub val UNREAD_FIELD: str = "module field the text format does not define";
pub val GC_TYPE:      str = "type of the gc proposal, which the set has no rows of";
pub val NO_FUNC_TYPE: str = "expected `(func` and its params and results";
pub val NOT_CLOSED:   str = "expected `)`";
pub val NO_STRING:    str = "expected a string";
pub val BAD_ESCAPE:   str = "malformed string escape";
pub val NO_LIMIT:     str = "expected a size";
pub val LIMIT_RANGE:  str = "size past its address type's range";
pub val NO_EXTERN:    str = "expected `(func`, `(table`, `(memory`, `(global` or `(tag` and an index";
pub val TYPE_RANGE:   str = "type index past what the stream's code of a value type holds";
pub val NO_REFTYPE:   str = "expected a reference type";
pub val AFTER_MODULE: str = "text after the module";
pub val PAGE_SIZE:    str = "memory page size, which is no wasm 3.0 feature";
pub val TWO_STARTS:   str = "module with two start functions";
pub val NO_ITEM:      str = "expected an element segment's item";
pub val NOT_TEXT:     str = "module of binary or quoted text, which is no module text";
pub val TABLE_INIT:   str = "table initializer, which mink's wasm facts state no form of";
pub val FAILED:       str = "mink refused the module";

# the kinds of import and export, by the byte the binary spells each by (WebAssembly 3.0, 5.5.5 Import Section)
val FUNC:   u8 = 0;
val TABLE:  u8 = 1;
val MEMORY: u8 = 2;
val GLOBAL: u8 = 3;
val TAG:    u8 = 4;

# a module field: its keyword, the offset past it and the offset of the `)` closing it, and the kind and index of what
# it defines, which its inline exports name
rec Field {
    keyword: wasm_text.Token;
    at:      usize;
    end:     usize;
    kind:    u8;
    index:   u32;
    defines: bool;
}

# a defined function's field, its index among the functions the module defines, and its type
rec Defined {
    field: u32;
    index: u32;
    type:  u32;
}

# what a segment's items or a global's or a table's initializer is read from: its field, the offset its contents start
# at, and the table, memory or entry it is of. an inline segment is of its table's or its memory's field, and an inline
# element segment's items are of its table's reference type, by its stream code. a global's is of its value type, by
# masc's code, and its mutability
rec Pending {
    field:   u32;
    at:      usize;
    of:      u32;
    inline:  bool;
    type:    u32;
    value:   i64;
    mutable: bool;
}

# what a read keeps while it reads
rec Job {
    a:        *A.Allocator;
    text:     *u8;
    origin:   diagnostic.Position;
    codec:    *dispatch.Codec;
    ctx:      *state.Context;
    fields:   vector.Vector[Field];
    funcs:    vector.Vector[Defined];
    globals:  vector.Vector[Pending];
    tables:   vector.Vector[Pending];
    elements: vector.Vector[Pending];
    datas:    vector.Vector[Pending];
    start:    opt[u32];
    started:  bool;
    out:      *wasm_object.Module;
}

fun refuse(j: *Job, message: str, at: usize, len: usize) err[diagnostic.Diagnostic] {
    ret err[diagnostic.Diagnostic].err{diagnostic.refusal(message, j.origin, j.text, at, len)};
}

fun at_token(j: *Job, message: str, t: wasm_text.Token) err[diagnostic.Diagnostic] {
    if (t.kind == wasm_text.BROKEN) { ret refuse(j, t.why, t.at, t.len); }
    ret refuse(j, message, t.at, t.len);
}

fun refused[T](j: *Job, message: str, at: usize, len: usize) res[T, diagnostic.Diagnostic] {
    ret res[T, diagnostic.Diagnostic].err{diagnostic.refusal(message, j.origin, j.text, at, len)};
}

# a refusal of mink's at `at`
fun failure(j: *Job, f: Fail, at: usize) diagnostic.Diagnostic {
    var message: str = f.text;
    if (message == nil) { message = FAILED; }
    ret diagnostic.refusal(message, j.origin, j.text, at, 1);
}

fun failed(j: *Job, f: Fail, at: usize) err[diagnostic.Diagnostic] {
    ret err[diagnostic.Diagnostic].err{failure(j, f, at)};
}

fun appended(j: *Job, got: err[Fail], at: usize) err[diagnostic.Diagnostic] {
    if (sel got.err) { ret failed(j, got.err, at); }
    ret err[diagnostic.Diagnostic].ok{};
}

fun closed(j: *Job, l: *wasm_text.Lexer) err[diagnostic.Diagnostic] {
    val t: wasm_text.Token = wasm_text.next(l);
    if (t.kind != wasm_text.CLOSE) { ret at_token(j, NOT_CLOSED, t); }
    ret err[diagnostic.Diagnostic].ok{};
}

# a syntax reader over the text from the lexer's position to its end, for the instruction syntax's readers
fun reader(j: *Job, l: *wasm_text.Lexer) core_syntax.Reader {
    ret core_syntax.Reader{
        text:    j.text,
        start:   l.at,
        at:      l.at,
        end:     l.end,
        origin:  diagnostic.advance(j.origin, j.text, l.at),
        codec:   nil,
        ctx:     j.ctx,
        syntax:  ?wasm_syntax.SYNTAX,
        modes:   nil,
        symbols: nil,
        context: nil,
        row:     nil,
        pool:    nil,
        cap:     0,
        used:    0,
        bytes:   nil,
        room:    0,
        taken:   0,
        refused: field.Admissions{at: nil, cap: 0, used: 0},
    };
}

# the value type at the lexer, by the instruction syntax's spelling, its stream code
fun value_type(j: *Job, l: *wasm_text.Lexer) res[u32, diagnostic.Diagnostic] {
    var r: core_syntax.Reader = reader(j, l);
    syntax_read.skip(?r);
    val at:  usize                           = r.at;
    val got: res[i64, diagnostic.Diagnostic] = wasm_syntax.valtype_read(?r);
    if (sel got.err)                          { ret res[u32, diagnostic.Diagnostic].err{got.err}; }
    if (!wasm_valtype.held_by_stream(got.ok)) { ret refused[u32](j, TYPE_RANGE, at, r.at - at); }
    l.at = r.at;
    ret res[u32, diagnostic.Diagnostic].ok{wasm_valtype.stream_code(got.ok)};
}

# whether a value type of stream code `code` is a reference type
fun reference(code: u32) bool {
    ret code != wasm_stream.I32 && code != wasm_stream.I64 && code != 0x7D && code != 0x7C && code != 0x7B;
}

# the reference type at the lexer, its stream code
fun ref_type(j: *Job, l: *wasm_text.Lexer) res[u32, diagnostic.Diagnostic] {
    val t:   wasm_text.Token                 = wasm_text.ahead(l);
    val got: res[u32, diagnostic.Diagnostic] = value_type(j, l);
    if (sel got.err)        { ret got; }
    if (!reference(got.ok)) { ret refused[u32](j, NO_REFTYPE, t.at, t.len); }
    ret got;
}

# the index in space `space` the atom at the lexer names, a number or an identifier the stream holds
fun index(j: *Job, l: *wasm_text.Lexer, space: u16) res[u32, diagnostic.Diagnostic] {
    var r: core_syntax.Reader = reader(j, l);
    syntax_read.skip(?r);
    val got: res[u32, diagnostic.Diagnostic] = wasm_syntax.index_read(?r, space);
    if (sel got.err) { ret got; }
    l.at = r.at;
    ret got;
}

# whether an index, a number or an identifier, is at the lexer
fun indexed(j: *Job, l: *wasm_text.Lexer) bool {
    val t: wasm_text.Token = wasm_text.ahead(l);
    if (t.kind != wasm_text.ATOM) { ret false; }
    val c: u8 = j.text[t.at];
    ret c == '$' || (c >= '0' && c <= '9');
}

# a type use at the lexer, its type index, a type it implies added after the last, each param's name onto `names` when
# it is not nil
fun type_use(j: *Job, l: *wasm_text.Lexer, names: *vector.Vector[View]) res[u32, diagnostic.Diagnostic] {
    var r:   core_syntax.Reader                   = reader(j, l);
    val got: res[opt[u32], diagnostic.Diagnostic] = wasm_syntax.type_use(?r, false, true, names);
    if (sel got.err)     { ret res[u32, diagnostic.Diagnostic].err{got.err}; }
    if (sel got.ok.none) { ret refused[u32](j, NO_FUNC_TYPE, l.at, 1); }
    l.at = r.at;
    ret res[u32, diagnostic.Diagnostic].ok{got.ok.some};
}

# the identifier at the lexer, passed, less its `$`, empty for none
fun identifier(j: *Job, l: *wasm_text.Lexer) View {
    val t: wasm_text.Token = wasm_text.ahead(l);
    if (!wasm_text.identifier(l, t)) { ret View{data: nil, len: 0}; }
    val passed: wasm_text.Token = wasm_text.next(l);
    ret View{data: ?j.text[t.at + 1], len: t.len - 1};
}

fun hex(c: u8) i32 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i32; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::i32 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::i32 + 10; }
    ret -1;
}

# the bytes of the string at the lexer onto `out`, its escapes decoded (6.0-text.lexical.spectec, Tstring)
fun string(j: *Job, l: *wasm_text.Lexer, out: *vector.Vector[u8]) err[diagnostic.Diagnostic] {
    val t: wasm_text.Token = wasm_text.next(l);
    if (t.kind != wasm_text.STRING) { ret at_token(j, NO_STRING, t); }
    val got: wasm_text.Escape = wasm_text.unescape(j.text, t.at + 1, t.at + t.len - 1, out);
    if (sel got.bad)    { ret refuse(j, BAD_ESCAPE, got.bad, 2); }
    if (sel got.memory) { ret refuse(j, field.MEMORY, t.at, t.len); }
    ret err[diagnostic.Diagnostic].ok{};
}

# the strings at the lexer, joined onto `out`, as a data segment's are
fun strings(j: *Job, l: *wasm_text.Lexer, out: *vector.Vector[u8]) err[diagnostic.Diagnostic] {
    for (wasm_text.ahead(l).kind == wasm_text.STRING) {
        val got: err[diagnostic.Diagnostic] = string(j, l, out);
        if (sel got.err) { ret got; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the bytes of the string at the lexer, held by the module
fun name_of(j: *Job, l: *wasm_text.Lexer) res[wasm_object.Span, diagnostic.Diagnostic] {
    val at:    usize             = l.at;
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    val read_: err[diagnostic.Diagnostic] = string(j, l, ?bytes);
    if (sel read_.err) { ret res[wasm_object.Span, diagnostic.Diagnostic].err{read_.err}; }
    ret held(j, ?bytes, at);
}

# the bytes of `bytes` held by the module
fun held(j: *Job, bytes: *vector.Vector[u8], at: usize) res[wasm_object.Span, diagnostic.Diagnostic] {
    val got: res[wasm_object.Span, Fail] = wasm_object.hold(j.out, bytes.data, bytes.len);
    if (sel got.err) { ret res[wasm_object.Span, diagnostic.Diagnostic].err{failure(j, got.err, at)}; }
    ret res[wasm_object.Span, diagnostic.Diagnostic].ok{got.ok};
}

# the module's fields, each by its keyword and its extent
fun fields(j: *Job, l: *wasm_text.Lexer) err[diagnostic.Diagnostic] {
    var wrapped: bool = false;
    if (wasm_text.opens(l, "module")) {
        wrapped = true;
        val named: View            = identifier(j, l);
        val after: wasm_text.Token = wasm_text.ahead(l);
        if (wasm_text.is(l, after, "binary") || wasm_text.is(l, after, "quote")) { ret at_token(j, NOT_TEXT, after); }
    }
    for {
        val t: wasm_text.Token = wasm_text.next(l);
        if (t.kind == wasm_text.CLOSE && wrapped) {
            val after: wasm_text.Token = wasm_text.next(l);
            if (after.kind != wasm_text.END) { ret at_token(j, AFTER_MODULE, after); }
            ret err[diagnostic.Diagnostic].ok{};
        }
        if (t.kind == wasm_text.END) {
            if (wrapped) { ret refuse(j, NOT_CLOSED, t.at, 0); }
            ret err[diagnostic.Diagnostic].ok{};
        }
        if (t.kind != wasm_text.OPEN) { ret at_token(j, NOT_A_FIELD, t); }
        val k: wasm_text.Token = wasm_text.next(l);
        if (k.kind != wasm_text.ATOM) { ret at_token(j, NOT_A_FIELD, k); }
        val at: usize = l.at;
        if (!wasm_text.skip(l)) { ret refuse(j, NOT_CLOSED, t.at, 1); }
        val pushed: res[usize, A.Error] = vector.push[Field](?j.fields, Field{keyword: k, at: at, end: l.at - 1, kind: 0, index: 0, defines: false});
        if (sel pushed.err) { ret refuse(j, field.MEMORY, t.at, 1); }
    }
}

fun lexer(j: *Job, f: *Field) wasm_text.Lexer {
    ret wasm_text.make(j.text, f.at, f.end + 1);
}

fun is(j: *Job, f: *Field, word: str) bool {
    var l: wasm_text.Lexer = wasm_text.make(j.text, 0, 0);
    ret wasm_text.is(?l, f.keyword, word);
}

# the value types of `(param ...)` or `(result ...)` lists at the lexer onto `out`
fun lists(j: *Job, l: *wasm_text.Lexer, word: str, out: *vector.Vector[u32]) err[diagnostic.Diagnostic] {
    for (wasm_text.opens(l, word)) {
        val name: View = identifier(j, l);
        for {
            val t: wasm_text.Token = wasm_text.ahead(l);
            if (t.kind == wasm_text.CLOSE) { brk; }
            val got: res[u32, diagnostic.Diagnostic] = value_type(j, l);
            if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
            val pushed: res[usize, A.Error] = vector.push[u32](out, got.ok);
            if (sel pushed.err) { ret refuse(j, field.MEMORY, t.at, t.len); }
            if (name.len > 0)   { brk; }
        }
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret shut; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# a type field, `$id? (func (param ...)* (result ...)*)`, a type of the gc proposal refused
fun type_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:     wasm_text.Lexer = lexer(j, f);
    val named: View            = identifier(j, ?l);
    if (!wasm_text.opens(?l, "func")) {
        val t: wasm_text.Token = wasm_text.ahead(?l);
        if (t.kind == wasm_text.OPEN) { ret refuse(j, GC_TYPE, t.at, 1); }
        ret at_token(j, NO_FUNC_TYPE, t);
    }
    var params:  vector.Vector[u32] = vector.init[u32](j.a);
    var results: vector.Vector[u32] = vector.init[u32](j.a);
    fin {
        vector.dnit[u32](?params);
        vector.dnit[u32](?results);
    }
    val p: err[diagnostic.Diagnostic] = lists(j, ?l, "param", ?params);
    if (sel p.err) { ret p; }
    val q: err[diagnostic.Diagnostic] = lists(j, ?l, "result", ?results);
    if (sel q.err) { ret q; }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val added: res[u32, str] = wasm_stream.add_type(j.ctx.stream, params.data, params.len::u32, results.data, results.len::u32, View{data: nil, len: 0});
    if (sel added.err) { ret refuse(j, added.err, f.keyword.at, f.keyword.len); }
    ret closed(j, ?l);
}

# the lexer past a field's inline exports, which the export pass reads in text order
fun past_exports(l: *wasm_text.Lexer) {
    for (wasm_text.opens(l, "export")) { val shut: bool = wasm_text.skip(l); }
}

# the number at the lexer, within `most`
fun number(j: *Job, l: *wasm_text.Lexer, most: u64) res[u64, diagnostic.Diagnostic] {
    val t: wasm_text.Token = wasm_text.next(l);
    if (t.kind != wasm_text.ATOM || j.text[t.at] < '0' || j.text[t.at] > '9') { ret refused[u64](j, NO_LIMIT, t.at, t.len); }
    var v:    u64   = 0;
    var i:    usize = 0;
    var base: u64   = 10;
    if (t.len > 2 && j.text[t.at] == '0' && j.text[t.at + 1] == 'x') {
        base = 16;
        i    = 2;
    }
    for (i < t.len) {
        val c: u8 = j.text[t.at + i];
        if (c != '_') {
            val d: i32 = hex(c);
            if (d < 0 || d::u64 >= base)    { ret refused[u64](j, NO_LIMIT, t.at, t.len); }
            if (v > (most - d::u64) / base) { ret refused[u64](j, LIMIT_RANGE, t.at, t.len); }
            v = v * base + d::u64;
        }
        i = i + 1;
    }
    ret res[u64, diagnostic.Diagnostic].ok{v};
}

fun numeric(j: *Job, l: *wasm_text.Lexer) bool {
    val t: wasm_text.Token = wasm_text.ahead(l);
    ret t.kind == wasm_text.ATOM && j.text[t.at] >= '0' && j.text[t.at] <= '9';
}

# an address type at the lexer, `i32` or `i64`, its code, i32 where none is stated
fun address(j: *Job, l: *wasm_text.Lexer) u32 {
    if (wasm_text.is(l, wasm_text.ahead(l), "i64")) {
        val passed: wasm_text.Token = wasm_text.next(l);
        ret wasm_stream.I64;
    }
    if (wasm_text.is(l, wasm_text.ahead(l), "i32")) { val passed: wasm_text.Token = wasm_text.next(l); }
    ret wasm_stream.I32;
}

# limits at the lexer, `min max?`, each within `most`, of 64-bit indices for address type i64
fun limits(j: *Job, l: *wasm_text.Lexer, code: u32, most: u64) res[fact.Limits, diagnostic.Diagnostic] {
    val min: res[u64, diagnostic.Diagnostic] = number(j, l, most);
    if (sel min.err) { ret res[fact.Limits, diagnostic.Diagnostic].err{min.err}; }
    var out: fact.Limits = fact.Limits{min: min.ok, max: opt[u64].none{}, shared: false, wide: code == wasm_stream.I64};
    if (numeric(j, l)) {
        val max: res[u64, diagnostic.Diagnostic] = number(j, l, most);
        if (sel max.err) { ret res[fact.Limits, diagnostic.Diagnostic].err{max.err}; }
        out.max = opt[u64].some{max.ok};
    }
    ret res[fact.Limits, diagnostic.Diagnostic].ok{out};
}

# the limits of `n` entries or pages exactly, of 64-bit indices for address type i64, as an inline segment sizes its
# table or memory
fun exactly(n: u64, code: u32) fact.Limits {
    ret fact.Limits{min: n, max: opt[u64].some{n}, shared: false, wide: code == wasm_stream.I64};
}

# the most pages a memory of address type `code` has, and the most entries a table has
fun most_pages(code: u32) u64 {
    if (code == wasm_stream.I64) { ret 1::u64 << 48; }
    ret 1::u64 << 16;
}

fun most_entries(code: u32) u64 {
    if (code == wasm_stream.I64) { ret ~0::u64; }
    ret 0xFFFF_FFFF;
}

# a memory type at the lexer, `addrtype? limits shared?`, a page size refused
fun memory_type(j: *Job, l: *wasm_text.Lexer, code: *u32) res[fact.Limits, diagnostic.Diagnostic] {
    @code = address(j, l);
    val got: res[fact.Limits, diagnostic.Diagnostic] = limits(j, l, @code, most_pages(@code));
    if (sel got.err) { ret got; }
    var out: fact.Limits = got.ok;
    if (wasm_text.is(l, wasm_text.ahead(l), "shared")) {
        val passed: wasm_text.Token = wasm_text.next(l);
        out.shared = true;
    }
    if (wasm_text.ahead(l).kind == wasm_text.OPEN) { ret refused[fact.Limits](j, PAGE_SIZE, l.at, 1); }
    ret res[fact.Limits, diagnostic.Diagnostic].ok{out};
}

# a table type at the lexer, `addrtype? limits reftype`
fun table_type(j: *Job, l: *wasm_text.Lexer, code: *u32) res[wasm_object.TableType, diagnostic.Diagnostic] {
    @code = address(j, l);
    val got: res[fact.Limits, diagnostic.Diagnostic] = limits(j, l, @code, most_entries(@code));
    if (sel got.err) { ret res[wasm_object.TableType, diagnostic.Diagnostic].err{got.err}; }
    val rt: res[u32, diagnostic.Diagnostic] = ref_type(j, l);
    if (sel rt.err) { ret res[wasm_object.TableType, diagnostic.Diagnostic].err{rt.err}; }
    ret res[wasm_object.TableType, diagnostic.Diagnostic].ok{wasm_object.TableType{elem: wasm_valtype.widened(rt.ok), limits: got.ok}};
}

# a global type at the lexer, `valtype` or `(mut valtype)`, of no initializer
fun global_type(j: *Job, l: *wasm_text.Lexer) res[wasm_object.Global, diagnostic.Diagnostic] {
    val wrapped: bool                            = wasm_text.opens(l, "mut");
    val got:     res[u32, diagnostic.Diagnostic] = value_type(j, l);
    if (sel got.err) { ret res[wasm_object.Global, diagnostic.Diagnostic].err{got.err}; }
    if (wrapped) {
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret res[wasm_object.Global, diagnostic.Diagnostic].err{shut.err}; }
    }
    ret res[wasm_object.Global, diagnostic.Diagnostic].ok{wasm_object.Global{value: wasm_valtype.widened(got.ok), mutable: wrapped, init: opt[wasm_object.Span].none{}}};
}

# the space a kind of import or export names, by the byte the binary spells the kind by
fun space_of(kind: u8) u16 {
    if (kind == FUNC)   { ret wasm_kind.FUNCS; }
    if (kind == TABLE)  { ret wasm_kind.TABLES; }
    if (kind == MEMORY) { ret wasm_kind.MEMORIES; }
    if (kind == GLOBAL) { ret wasm_kind.GLOBALS; }
    ret wasm_kind.TAGS;
}

val KIND_WORDS: [5]str = [5]str{"func", "table", "memory", "global", "tag"};

# what an import of kind `kind` brings in, read at the lexer, defined in its space named `name`
fun import_desc(j: *Job, l: *wasm_text.Lexer, kind: u8, name: View, at: usize) res[wasm_object.Desc, diagnostic.Diagnostic] {
    var code: u32              = 0;
    var desc: wasm_object.Desc = wasm_object.Desc.function{0};
    if (kind == FUNC || kind == TAG) {
        val typed: res[u32, diagnostic.Diagnostic] = type_use(j, l, nil);
        if (sel typed.err) { ret res[wasm_object.Desc, diagnostic.Diagnostic].err{typed.err}; }
        code = typed.ok;
        if (kind == TAG) { desc = wasm_object.Desc.exception{code}; }
        or               { desc = wasm_object.Desc.function{code}; }
    }
    or (kind == TABLE) {
        val got: res[wasm_object.TableType, diagnostic.Diagnostic] = table_type(j, l, ?code);
        if (sel got.err) { ret res[wasm_object.Desc, diagnostic.Diagnostic].err{got.err}; }
        desc = wasm_object.Desc.table{got.ok};
    }
    or (kind == MEMORY) {
        val got: res[fact.Limits, diagnostic.Diagnostic] = memory_type(j, l, ?code);
        if (sel got.err) { ret res[wasm_object.Desc, diagnostic.Diagnostic].err{got.err}; }
        desc = wasm_object.Desc.memory{got.ok};
    }
    or {
        val got: res[wasm_object.Global, diagnostic.Diagnostic] = global_type(j, l);
        if (sel got.err) { ret res[wasm_object.Desc, diagnostic.Diagnostic].err{got.err}; }
        code = wasm_valtype.stream_code(got.ok.value);
        desc = wasm_object.Desc.global{got.ok};
    }
    val defined: res[u32, str] = wasm_stream.define(j.ctx.stream, space_of(kind), code, name);
    if (sel defined.err) { ret refused[wasm_object.Desc](j, defined.err, at, 1); }
    ret res[wasm_object.Desc, diagnostic.Diagnostic].ok{desc};
}

# an import of kind `kind` from module `module` field `field_`, read at the lexer, the field's index set
fun imported(j: *Job, f: *Field, l: *wasm_text.Lexer, module: wasm_object.Span, field_: wasm_object.Span, kind: u8, name: View) err[diagnostic.Diagnostic] {
    val desc: res[wasm_object.Desc, diagnostic.Diagnostic] = import_desc(j, l, kind, name, f.keyword.at);
    if (sel desc.err) { ret err[diagnostic.Diagnostic].err{desc.err}; }
    f.kind    = kind;
    f.index   = wasm_stream.count(j.ctx.stream, space_of(kind)) - 1;
    f.defines = true;
    ret appended(j, wasm_object.import(j.out, wasm_object.view(j.out, module), wasm_object.view(j.out, field_), desc.ok), f.keyword.at);
}

# an import field, `"m" "n" (kind $id? desc)`
fun import_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:      wasm_text.Lexer                              = lexer(j, f);
    val module: res[wasm_object.Span, diagnostic.Diagnostic] = name_of(j, ?l);
    if (sel module.err) { ret err[diagnostic.Diagnostic].err{module.err}; }
    val field_: res[wasm_object.Span, diagnostic.Diagnostic] = name_of(j, ?l);
    if (sel field_.err) { ret err[diagnostic.Diagnostic].err{field_.err}; }
    var k: usize = 0;
    for (k < 5) {
        if (wasm_text.opens(?l, KIND_WORDS[k])) {
            val named: View                       = identifier(j, ?l);
            val got:   err[diagnostic.Diagnostic] = imported(j, f, ?l, module.ok, field_.ok, k::u8, named);
            if (sel got.err) { ret got; }
            val inner: err[diagnostic.Diagnostic] = closed(j, ?l);
            if (sel inner.err) { ret inner; }
            ret closed(j, ?l);
        }
        k = k + 1;
    }
    ret at_token(j, NO_EXTERN, wasm_text.ahead(?l));
}

# an inline `(import "m" "n")` at the lexer, the import of kind `kind` it abbreviates read and true, false for none
fun inline_import(j: *Job, f: *Field, l: *wasm_text.Lexer, kind: u8, name: View) res[bool, diagnostic.Diagnostic] {
    if (!wasm_text.opens(l, "import")) { ret res[bool, diagnostic.Diagnostic].ok{false}; }
    val module: res[wasm_object.Span, diagnostic.Diagnostic] = name_of(j, l);
    if (sel module.err) { ret res[bool, diagnostic.Diagnostic].err{module.err}; }
    val field_: res[wasm_object.Span, diagnostic.Diagnostic] = name_of(j, l);
    if (sel field_.err) { ret res[bool, diagnostic.Diagnostic].err{field_.err}; }
    val shut: err[diagnostic.Diagnostic] = closed(j, l);
    if (sel shut.err) { ret res[bool, diagnostic.Diagnostic].err{shut.err}; }
    val got: err[diagnostic.Diagnostic] = imported(j, f, l, module.ok, field_.ok, kind, name);
    if (sel got.err) { ret res[bool, diagnostic.Diagnostic].err{got.err}; }
    val done: err[diagnostic.Diagnostic] = closed(j, l);
    if (sel done.err) { ret res[bool, diagnostic.Diagnostic].err{done.err}; }
    ret res[bool, diagnostic.Diagnostic].ok{true};
}

# the definition `f` is, of kind `kind` and index `index`
fun defines(f: *Field, kind: u8, index: u32) {
    f.kind    = kind;
    f.index   = index;
    f.defines = true;
}

fun define(j: *Job, space: u16, code: u32, name: View, at: usize) res[u32, diagnostic.Diagnostic] {
    val got: res[u32, str] = wasm_stream.define(j.ctx.stream, space, code, name);
    if (sel got.err) { ret refused[u32](j, got.err, at, 1); }
    ret res[u32, diagnostic.Diagnostic].ok{got.ok};
}

# a func field: an import, or a definition of its index and type, and the types its body implies
fun func_field(j: *Job, b: *wasm_body.Reader, f: *Field, k: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val kind:   u8                               = FUNC;
    val inline: res[bool, diagnostic.Diagnostic] = inline_import(j, f, ?l, kind, name);
    if (sel inline.err) { ret err[diagnostic.Diagnostic].err{inline.err}; }
    if (inline.ok)      { ret err[diagnostic.Diagnostic].ok{}; }
    val typed: res[u32, diagnostic.Diagnostic] = type_use(j, ?l, nil);
    if (sel typed.err) { ret err[diagnostic.Diagnostic].err{typed.err}; }
    val index: res[u32, diagnostic.Diagnostic] = define(j, wasm_kind.FUNCS, typed.ok, name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    defines(f, kind, index.ok);
    val own:    usize                      = j.funcs.len;
    val pushed: err[diagnostic.Diagnostic] = appended(j, wasm_object.define(j.out, wasm_object.Desc.function{typed.ok}), f.keyword.at);
    if (sel pushed.err) { ret pushed; }
    val noted: res[usize, A.Error] = vector.push[Defined](?j.funcs, Defined{field: k, index: own::u32, type: typed.ok});
    if (sel noted.err) { ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len); }
    ret wasm_body.imply(b, ?l);
}

# a tag field: an import, or a definition of its type
fun tag_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val kind:   u8                               = TAG;
    val inline: res[bool, diagnostic.Diagnostic] = inline_import(j, f, ?l, kind, name);
    if (sel inline.err) { ret err[diagnostic.Diagnostic].err{inline.err}; }
    if (inline.ok)      { ret err[diagnostic.Diagnostic].ok{}; }
    val typed: res[u32, diagnostic.Diagnostic] = type_use(j, ?l, nil);
    if (sel typed.err) { ret err[diagnostic.Diagnostic].err{typed.err}; }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val index: res[u32, diagnostic.Diagnostic] = define(j, wasm_kind.TAGS, typed.ok, name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    defines(f, kind, index.ok);
    ret appended(j, wasm_object.define(j.out, wasm_object.Desc.exception{typed.ok}), f.keyword.at);
}

# a global field: an import, or a definition of its type, its initializer read in its later pass
fun global_field(j: *Job, f: *Field, k: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val kind:   u8                               = GLOBAL;
    val inline: res[bool, diagnostic.Diagnostic] = inline_import(j, f, ?l, kind, name);
    if (sel inline.err) { ret err[diagnostic.Diagnostic].err{inline.err}; }
    if (inline.ok)      { ret err[diagnostic.Diagnostic].ok{}; }
    val type: res[wasm_object.Global, diagnostic.Diagnostic] = global_type(j, ?l);
    if (sel type.err) { ret err[diagnostic.Diagnostic].err{type.err}; }
    val index: res[u32, diagnostic.Diagnostic] = define(j, wasm_kind.GLOBALS, wasm_valtype.stream_code(type.ok.value), name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    defines(f, kind, index.ok);
    val noted: res[usize, A.Error] = vector.push[Pending](?j.globals, Pending{field: k, at: l.at, of: 0, inline: false, type: 0, value: type.ok.value, mutable: type.ok.mutable});
    if (sel noted.err) { ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len); }
    ret err[diagnostic.Diagnostic].ok{};
}

# how many items an inline `(elem ...)` holds: a `func` list's indices, or a reference type's expressions
fun items_in(j: *Job, l: wasm_text.Lexer) u64 {
    var copy: wasm_text.Lexer = l;
    var n:    u64             = 0;
    if (wasm_text.is(?copy, wasm_text.ahead(?copy), "func")) {
        val passed: wasm_text.Token = wasm_text.next(?copy);
        for (indexed(j, ?copy)) {
            val one: wasm_text.Token = wasm_text.next(?copy);
            n = n + 1;
        }
        ret n;
    }
    if (indexed(j, ?copy)) {
        for (indexed(j, ?copy)) {
            val one: wasm_text.Token = wasm_text.next(?copy);
            n = n + 1;
        }
        ret n;
    }
    for {
        val t: wasm_text.Token = wasm_text.next(?copy);
        if (t.kind != wasm_text.OPEN && t.kind != wasm_text.ATOM) { brk; }
        if (t.kind == wasm_text.OPEN) {
            val passed: bool = wasm_text.skip(?copy);
            n = n + 1;
        }
    }
    ret n;
}

# a table field: an import, or a definition of its type and its initializer where it has one, read in its later pass,
# or the table and the active segment its inline `(elem ...)` abbreviates, whose items are read in their later pass
fun table_field(j: *Job, f: *Field, k: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val kind:   u8                               = TABLE;
    val inline: res[bool, diagnostic.Diagnostic] = inline_import(j, f, ?l, kind, name);
    if (sel inline.err) { ret err[diagnostic.Diagnostic].err{inline.err}; }
    if (inline.ok)      { ret err[diagnostic.Diagnostic].ok{}; }
    var code: u32             = 0;
    var type: wasm_object.TableType;
    var elem: bool            = false;
    var at:   usize           = 0;
    val back: wasm_text.Lexer = l;
    code = address(j, ?l);
    if (!numeric(j, ?l)) {
        val rt: res[u32, diagnostic.Diagnostic] = ref_type(j, ?l);
        if (sel rt.err)                   { ret err[diagnostic.Diagnostic].err{rt.err}; }
        if (!wasm_text.opens(?l, "elem")) { ret at_token(j, NOT_CLOSED, wasm_text.ahead(?l)); }
        at   = l.at;
        elem = true;
        val n: u64 = items_in(j, l);
        type = wasm_object.TableType{elem: wasm_valtype.widened(rt.ok), limits: exactly(n, code)};
        val passed: bool = wasm_text.skip(?l);
    }
    or {
        l = back;
        val got: res[wasm_object.TableType, diagnostic.Diagnostic] = table_type(j, ?l, ?code);
        if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
        type = got.ok;
    }
    val index: res[u32, diagnostic.Diagnostic] = define(j, wasm_kind.TABLES, code, name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    defines(f, kind, index.ok);
    val pushed: err[diagnostic.Diagnostic] = appended(j, wasm_object.define(j.out, wasm_object.Desc.table{type}), f.keyword.at);
    if (sel pushed.err) { ret pushed; }
    if (!elem) {
        if (wasm_text.ahead(?l).kind == wasm_text.CLOSE) { ret err[diagnostic.Diagnostic].ok{}; }
        val noted: res[usize, A.Error] = vector.push[Pending](?j.tables, Pending{field: k, at: l.at, of: 0, inline: false, type: 0, value: 0, mutable: false});
        if (sel noted.err) { ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len); }
        ret err[diagnostic.Diagnostic].ok{};
    }
    ret segment(j, ?j.elements, wasm_kind.ELEMS, f, k, at, index.ok, wasm_valtype.stream_code(type.elem), View{data: nil, len: 0});
}

# a segment of the field `k` noted for its later pass and defined in `space`, its contents from `at`, of entry `of`
fun segment(j: *Job, into: *vector.Vector[Pending], space: u16, f: *Field, k: u32, at: usize, of: u32, type: u32, name: View) err[diagnostic.Diagnostic] {
    val index: res[u32, diagnostic.Diagnostic] = define(j, space, 0, name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    val noted: res[usize, A.Error] = vector.push[Pending](into, Pending{field: k, at: at, of: of, inline: !is(j, f, "elem") && !is(j, f, "data"), type: type, value: 0, mutable: false});
    if (sel noted.err) { ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len); }
    ret err[diagnostic.Diagnostic].ok{};
}

# the bytes the strings at the lexer hold
fun data_length(j: *Job, l: wasm_text.Lexer) res[u64, diagnostic.Diagnostic] {
    var copy:  wasm_text.Lexer   = l;
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    val got: err[diagnostic.Diagnostic] = strings(j, ?copy, ?bytes);
    if (sel got.err) { ret res[u64, diagnostic.Diagnostic].err{got.err}; }
    ret res[u64, diagnostic.Diagnostic].ok{bytes.len::u64};
}

# a memory field: an import, or a definition of its limits, or the memory and the active segment its inline
# `(data ...)` abbreviates
fun memory_field(j: *Job, f: *Field, k: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val kind:   u8                               = MEMORY;
    val inline: res[bool, diagnostic.Diagnostic] = inline_import(j, f, ?l, kind, name);
    if (sel inline.err) { ret err[diagnostic.Diagnostic].err{inline.err}; }
    if (inline.ok)      { ret err[diagnostic.Diagnostic].ok{}; }
    var code:   u32             = 0;
    var limits: fact.Limits;
    var data:   bool            = false;
    var at:     usize           = 0;
    val back:   wasm_text.Lexer = l;
    code = address(j, ?l);
    if (wasm_text.opens(?l, "data")) {
        at   = l.at;
        data = true;
        val n: res[u64, diagnostic.Diagnostic] = data_length(j, l);
        if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
        limits = exactly((n.ok + 0xFFFF) / 0x1_0000, code);
        val passed: bool = wasm_text.skip(?l);
    }
    or {
        l = back;
        val got: res[fact.Limits, diagnostic.Diagnostic] = memory_type(j, ?l, ?code);
        if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
        limits = got.ok;
    }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val index: res[u32, diagnostic.Diagnostic] = define(j, wasm_kind.MEMORIES, code, name, f.keyword.at);
    if (sel index.err) { ret err[diagnostic.Diagnostic].err{index.err}; }
    defines(f, kind, index.ok);
    val pushed: err[diagnostic.Diagnostic] = appended(j, wasm_object.define(j.out, wasm_object.Desc.memory{limits}), f.keyword.at);
    if (sel pushed.err) { ret pushed; }
    if (!data)          { ret err[diagnostic.Diagnostic].ok{}; }
    ret segment(j, ?j.datas, wasm_kind.DATAS, f, k, at, index.ok, 0, View{data: nil, len: 0});
}

# an elem or a data field's index defined by its name, its contents read in their later pass
fun segment_field(j: *Job, f: *Field, k: u32) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    if (is(j, f, "elem")) { ret segment(j, ?j.elements, wasm_kind.ELEMS, f, k, l.at, 0, 0, name); }
    ret segment(j, ?j.datas, wasm_kind.DATAS, f, k, l.at, 0, 0, name);
}

# what an export's `(func x)` and its kin name: the kind and the index in its space
rec Extern {
    kind:  u8;
    index: u32;
}

fun extern(j: *Job, l: *wasm_text.Lexer) res[Extern, diagnostic.Diagnostic] {
    var k: usize = 0;
    for (k < 5) {
        if (wasm_text.opens(l, KIND_WORDS[k])) {
            val got: res[u32, diagnostic.Diagnostic] = index(j, l, space_of(k::u8));
            if (sel got.err) { ret res[Extern, diagnostic.Diagnostic].err{got.err}; }
            val shut: err[diagnostic.Diagnostic] = closed(j, l);
            if (sel shut.err) { ret res[Extern, diagnostic.Diagnostic].err{shut.err}; }
            ret res[Extern, diagnostic.Diagnostic].ok{Extern{kind: k::u8, index: got.ok}};
        }
        k = k + 1;
    }
    val t: wasm_text.Token = wasm_text.ahead(l);
    ret refused[Extern](j, NO_EXTERN, t.at, t.len);
}

# an export field, `"n" (func x)`
fun export_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:     wasm_text.Lexer                              = lexer(j, f);
    val named: res[wasm_object.Span, diagnostic.Diagnostic] = name_of(j, ?l);
    if (sel named.err) { ret err[diagnostic.Diagnostic].err{named.err}; }
    val got: res[Extern, diagnostic.Diagnostic] = extern(j, ?l);
    if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
    val pushed: err[diagnostic.Diagnostic] = appended(j, wasm_object.export(j.out, wasm_object.view(j.out, named.ok), got.ok.kind, got.ok.index), f.keyword.at);
    if (sel pushed.err) { ret pushed; }
    ret closed(j, ?l);
}

# a definition's inline exports, `(export "n")*`, each an export of what it defines
fun inline_exports(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    for (wasm_text.opens(?l, "export")) {
        val named: res[wasm_object.Span, diagnostic.Diagnostic] = name_of(j, ?l);
        if (sel named.err) { ret err[diagnostic.Diagnostic].err{named.err}; }
        val pushed: err[diagnostic.Diagnostic] = appended(j, wasm_object.export(j.out, wasm_object.view(j.out, named.ok), f.kind, f.index), f.keyword.at);
        if (sel pushed.err) { ret pushed; }
        val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
        if (sel shut.err) { ret shut; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# a start field, `x`, the module's one start function
fun start_field(j: *Job, f: *Field) err[diagnostic.Diagnostic] {
    if (j.started) { ret refuse(j, TWO_STARTS, f.keyword.at, f.keyword.len); }
    var l:   wasm_text.Lexer                 = lexer(j, f);
    val got: res[u32, diagnostic.Diagnostic] = index(j, ?l, wasm_kind.FUNCS);
    if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
    j.start   = opt[u32].some{got.ok};
    j.started = true;
    ret closed(j, ?l);
}

# the expression of the instructions at the lexer up to the `)` around them, held by the module
fun expression(j: *Job, b: *wasm_body.Reader, l: *wasm_text.Lexer) res[wasm_object.Span, diagnostic.Diagnostic] {
    val at:    usize             = l.at;
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    val got: err[diagnostic.Diagnostic] = wasm_body.expression(b, l, ?bytes);
    if (sel got.err) { ret res[wasm_object.Span, diagnostic.Diagnostic].err{got.err}; }
    ret held(j, ?bytes, at);
}

# an offset at the lexer, `(offset instr*)` or one folded instruction, its expression
fun offset(j: *Job, b: *wasm_body.Reader, l: *wasm_text.Lexer) res[wasm_object.Span, diagnostic.Diagnostic] {
    if (wasm_text.opens(l, "offset")) {
        val got: res[wasm_object.Span, diagnostic.Diagnostic] = expression(j, b, l);
        if (sel got.err) { ret got; }
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret res[wasm_object.Span, diagnostic.Diagnostic].err{shut.err}; }
        ret got;
    }
    val at:    usize             = l.at;
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    val got: err[diagnostic.Diagnostic] = wasm_body.folded_expression(b, l, ?bytes);
    if (sel got.err) { ret res[wasm_object.Span, diagnostic.Diagnostic].err{got.err}; }
    ret held(j, ?bytes, at);
}

# the expression `0` of address type `code`, an inline segment's offset: its const and its end, encoded
fun zero(j: *Job, code: u32, at: usize) res[wasm_object.Span, diagnostic.Diagnostic] {
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    var value: [1]operand.Value = [1]operand.Value{operand.Value.immediate{0}};
    var ins:   inst.Inst        = inst.Inst{row: ?gen_row.ROWS[gen_row_index.I32CONST], values: ?value[0], count: 1, form: form.PREFERRED};
    if (code == wasm_stream.I64) { ins.row = ?gen_row.ROWS[gen_row_index.I64CONST]; }
    var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](j.a);
    fin { vector.dnit[field.Fixup](?fixups); }
    val wrote: res[usize, field.Refusal] = walk.encode(j.codec, j.ctx, ?ins, ?bytes, ?fixups);
    if (sel wrote.err) { ret refused[wasm_object.Span](j, wrote.err.message, at, 1); }
    var end:   inst.Inst                 = inst.Inst{row: ?gen_row.ROWS[gen_row_index.END], values: nil, count: 0, form: form.PREFERRED};
    val ended: res[usize, field.Refusal] = walk.encode(j.codec, j.ctx, ?end, ?bytes, ?fixups);
    if (sel ended.err) { ret refused[wasm_object.Span](j, ended.err.message, at, 1); }
    ret held(j, ?bytes, at);
}

# the address type of the table or memory `index` of space `space`
fun address_of(j: *Job, space: u16, index: u32) u32 {
    val got: opt[u32] = wasm_stream.space(j.ctx.stream, space, index);
    if (sel got.some) { ret got.some; }
    ret wasm_stream.I32;
}

# a global's initializer, read in its index order, the global defined with it
fun global_init(j: *Job, b: *wasm_body.Reader, p: *Pending) err[diagnostic.Diagnostic] {
    val f:   *Field                                       = ?j.fields.data[p.field];
    var l:   wasm_text.Lexer                              = wasm_text.make(j.text, p.at, f.end + 1);
    val got: res[wasm_object.Span, diagnostic.Diagnostic] = expression(j, b, ?l);
    if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
    val g:       wasm_object.Global         = wasm_object.Global{value: p.value, mutable: p.mutable, init: opt[wasm_object.Span].some{got.ok}};
    val defined: err[diagnostic.Diagnostic] = appended(j, wasm_object.define(j.out, wasm_object.Desc.global{g}), f.keyword.at);
    if (sel defined.err) { ret defined; }
    ret closed(j, ?l);
}

# the function index an expression of one `ref.func` names, none for any other expression
fun ref_func(j: *Job, bytes: *vector.Vector[u8]) opt[u32] {
    var store_: [4]operand.Value;
    var room:   [4]requirement.Alternative;
    var alts:   field.Admissions                 = field.Admissions{at: ?room[0], cap: 4, used: 0};
    val got:    res[walk.Decoded, field.Refusal] = walk.decode(j.codec, j.ctx, bytes.data, bytes.len, 0, ?store_[0], 4, ?alts);
    if (sel got.err)                                             { ret opt[u32].none{}; }
    if (got.ok.inst.row != ?gen_row.ROWS[gen_row_index.REFFUNC]) { ret opt[u32].none{}; }
    if (got.ok.len + 1 != bytes.len)                             { ret opt[u32].none{}; }
    if (!sel got.ok.inst.values[0].id)                           { ret opt[u32].none{}; }
    ret opt[u32].some{got.ok.inst.values[0].id};
}

# what an element segment's items are: function indices of a `(ref func)` segment, or expressions of a reference type
rec Items {
    funcs:   bool;
    type:    u32;
    indices: vector.Vector[u32];
    exprs:   vector.Vector[vector.Vector[u8]];
}

fun drop_items(it: *Items) {
    var i: usize = 0;
    for (i < it.exprs.len) {
        vector.dnit[u8](?it.exprs.data[i]);
        i = i + 1;
    }
    vector.dnit[vector.Vector[u8]](?it.exprs);
    vector.dnit[u32](?it.indices);
}

# the function indices at the lexer onto `out`
fun func_indices(j: *Job, l: *wasm_text.Lexer, out: *vector.Vector[u32]) err[diagnostic.Diagnostic] {
    for (indexed(j, l)) {
        val x: res[u32, diagnostic.Diagnostic] = index(j, l, wasm_kind.FUNCS);
        if (sel x.err) { ret err[diagnostic.Diagnostic].err{x.err}; }
        val pushed: res[usize, A.Error] = vector.push[u32](out, x.ok);
        if (sel pushed.err) { ret refuse(j, field.MEMORY, l.at, 1); }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# the expression `ref.func x`, its end after it
fun ref_expr(j: *Job, x: u32, out: *vector.Vector[u8], at: usize) err[diagnostic.Diagnostic] {
    var value:  [1]operand.Value           = [1]operand.Value{operand.Value.id{x}};
    var ins:    inst.Inst                  = inst.Inst{row: ?gen_row.ROWS[gen_row_index.REFFUNC], values: ?value[0], count: 1, form: form.PREFERRED};
    var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](j.a);
    fin { vector.dnit[field.Fixup](?fixups); }
    val wrote: res[usize, field.Refusal] = walk.encode(j.codec, j.ctx, ?ins, out, ?fixups);
    if (sel wrote.err) { ret refuse(j, wrote.err.message, at, 1); }
    var end:   inst.Inst                 = inst.Inst{row: ?gen_row.ROWS[gen_row_index.END], values: nil, count: 0, form: form.PREFERRED};
    val ended: res[usize, field.Refusal] = walk.encode(j.codec, j.ctx, ?end, out, ?fixups);
    if (sel ended.err) { ret refuse(j, ended.err.message, at, 1); }
    ret err[diagnostic.Diagnostic].ok{};
}

# the reference type `(ref func)`, as the syntax holds it: its byte and its heap type above it
val REF_FUNC: i64 = (wasm_valtype.FUNCREF::i64 - 0x80) * 0x100 + wasm_field.REF::i64;

# an element segment's reference type at the lexer: `(ref func)` as `funcs`, or its stream code
fun element_type(j: *Job, l: *wasm_text.Lexer, out: *Items) err[diagnostic.Diagnostic] {
    var r: core_syntax.Reader = reader(j, l);
    syntax_read.skip(?r);
    val at:  usize                           = r.at;
    val got: res[i64, diagnostic.Diagnostic] = wasm_syntax.valtype_read(?r);
    if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
    l.at = r.at;
    if (got.ok == REF_FUNC) {
        out.funcs = true;
        out.type  = wasm_valtype.FUNCREF::u32;
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (!wasm_valtype.held_by_stream(got.ok))         { ret refuse(j, TYPE_RANGE, at, r.at - at); }
    if (!reference(wasm_valtype.stream_code(got.ok))) { ret refuse(j, NO_REFTYPE, at, r.at - at); }
    out.type = wasm_valtype.stream_code(got.ok);
    ret err[diagnostic.Diagnostic].ok{};
}

# an element segment's items at the lexer: a `func` list's indices, or a reference type's `(item instr*)` or folded
# instructions. `bare` reads a list of function indices with no `func` before it, as an active segment's text may
# spell them, a `(ref func)` list. an inline segment's items are of its table's reference type `type`, a bare list of
# them each a `ref.func`
fun items(j: *Job, b: *wasm_body.Reader, l: *wasm_text.Lexer, bare: bool, type: opt[u32], out: *Items) err[diagnostic.Diagnostic] {
    if (sel type.some) {
        out.type = type.some;
        if (indexed(j, l) || wasm_text.ahead(l).kind == wasm_text.CLOSE) {
            var listed: vector.Vector[u32] = vector.init[u32](j.a);
            fin { vector.dnit[u32](?listed); }
            val got: err[diagnostic.Diagnostic] = func_indices(j, l, ?listed);
            if (sel got.err) { ret got; }
            var i: usize = 0;
            for (i < listed.len) {
                var bytes:  vector.Vector[u8]          = vector.init[u8](j.a);
                val wrote:  err[diagnostic.Diagnostic] = ref_expr(j, listed.data[i], ?bytes, l.at);
                val pushed: res[usize, A.Error]        = vector.push[vector.Vector[u8]](?out.exprs, bytes);
                if (sel wrote.err)  { ret wrote; }
                if (sel pushed.err) { ret refuse(j, field.MEMORY, l.at, 1); }
                i = i + 1;
            }
            ret err[diagnostic.Diagnostic].ok{};
        }
    }
    or (wasm_text.is(l, wasm_text.ahead(l), "func")) {
        val passed: wasm_text.Token = wasm_text.next(l);
        out.funcs = true;
        ret func_indices(j, l, ?out.indices);
    }
    or (bare && (indexed(j, l) || wasm_text.ahead(l).kind == wasm_text.CLOSE)) {
        out.funcs = true;
        ret func_indices(j, l, ?out.indices);
    }
    or {
        val typed: err[diagnostic.Diagnostic] = element_type(j, l, out);
        if (sel typed.err) { ret typed; }
    }
    for (wasm_text.ahead(l).kind == wasm_text.OPEN) {
        val at:    usize                      = l.at;
        var bytes: vector.Vector[u8]          = vector.init[u8](j.a);
        var got:   err[diagnostic.Diagnostic] = err[diagnostic.Diagnostic].ok{};
        if (wasm_text.opens(l, "item")) {
            got = wasm_body.expression(b, l, ?bytes);
            if (!sel got.err) { got = closed(j, l); }
        }
        or { got = wasm_body.folded_expression(b, l, ?bytes); }
        if (sel got.err) {
            vector.dnit[u8](?bytes);
            ret got;
        }
        if (out.funcs) {
            # a (ref func) segment's items are function indices, each an expression of one ref.func
            val x: opt[u32] = ref_func(j, ?bytes);
            vector.dnit[u8](?bytes);
            if (sel x.none) { ret refuse(j, NO_ITEM, at, 1); }
            val kept_: res[usize, A.Error] = vector.push[u32](?out.indices, x.some);
            if (sel kept_.err) { ret refuse(j, field.MEMORY, at, 1); }
            cnt;
        }
        val pushed: res[usize, A.Error] = vector.push[vector.Vector[u8]](?out.exprs, bytes);
        if (sel pushed.err) { ret refuse(j, field.MEMORY, at, 1); }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# whether an offset, `(offset ...)` or a folded instruction, is at the lexer
fun offset_ahead(j: *Job, b: *wasm_body.Reader, l: *wasm_text.Lexer) bool {
    var copy: wasm_text.Lexer = @l;
    if (wasm_text.next(?copy).kind != wasm_text.OPEN) { ret false; }
    val t: wasm_text.Token = wasm_text.next(?copy);
    ret wasm_text.is(l, t, "offset") || wasm_body.instruction(b, t);
}

# the segment modes a segment's text states
val PASSIVE:  u8 = 0;
val ACTIVE:   u8 = 1;
val DECLARED: u8 = 2;

# the element segment `p` notes, read in its index order: `declare`, or a table use and an offset for an active one,
# then its items. an active segment writes its table's index for a table other than the first or for items of a type
# other than funcref, and its items are expressions unless they are a `(ref func)` list
fun element(j: *Job, b: *wasm_body.Reader, p: *Pending) err[diagnostic.Diagnostic] {
    val f:    *Field           = ?j.fields.data[p.field];
    var l:    wasm_text.Lexer  = wasm_text.make(j.text, p.at, f.end + 1);
    var mode: u8               = PASSIVE;
    var tab:  u32              = p.of;
    var off:  wasm_object.Span = wasm_object.Span{at: 0, len: 0};
    var type: opt[u32]         = opt[u32].none{};
    if (p.inline) {
        mode = ACTIVE;
        val z: res[wasm_object.Span, diagnostic.Diagnostic] = zero(j, address_of(j, wasm_kind.TABLES, tab), f.keyword.at);
        if (sel z.err) { ret err[diagnostic.Diagnostic].err{z.err}; }
        off  = z.ok;
        type = opt[u32].some{p.type};
    }
    or (wasm_text.is(?l, wasm_text.ahead(?l), "declare")) {
        val passed: wasm_text.Token = wasm_text.next(?l);
        mode = DECLARED;
    }
    or {
        var used: bool = false;
        if (wasm_text.opens(?l, "table")) {
            val x: res[u32, diagnostic.Diagnostic] = index(j, ?l, wasm_kind.TABLES);
            if (sel x.err) { ret err[diagnostic.Diagnostic].err{x.err}; }
            val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
            if (sel shut.err) { ret shut; }
            tab  = x.ok;
            used = true;
        }
        or (indexed(j, ?l)) {
            val x: res[u32, diagnostic.Diagnostic] = index(j, ?l, wasm_kind.TABLES);
            if (sel x.err) { ret err[diagnostic.Diagnostic].err{x.err}; }
            tab  = x.ok;
            used = true;
        }
        if (used || offset_ahead(j, b, ?l)) {
            val o: res[wasm_object.Span, diagnostic.Diagnostic] = offset(j, b, ?l);
            if (sel o.err) { ret err[diagnostic.Diagnostic].err{o.err}; }
            off  = o.ok;
            mode = ACTIVE;
        }
    }
    var it: Items = Items{funcs: false, type: 0, indices: vector.init[u32](j.a), exprs: vector.init[vector.Vector[u8]](j.a)};
    fin { drop_items(?it); }
    val got: err[diagnostic.Diagnostic] = items(j, b, ?l, mode == ACTIVE, type, ?it);
    if (sel got.err) { ret got; }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    var stated: wasm_object.Element = wasm_object.Element{mode: wasm_object.Mode.passive{}, type: wasm_valtype.FUNCREF::i64, items: wasm_object.Items.functions{vector.init[u32](j.a)}};
    if (mode == DECLARED) { stated.mode = wasm_object.Mode.declarative{}; }
    or (mode == ACTIVE) {
        var index: opt[u32] = opt[u32].none{};
        if (tab != 0 || (!it.funcs && it.type != wasm_valtype.FUNCREF::u32)) { index = opt[u32].some{tab}; }
        stated.mode = wasm_object.Mode.active{wasm_object.At{index: index, offset: off}};
    }
    if (it.funcs) {
        stated.items = wasm_object.Items.functions{it.indices};
        it.indices   = vector.init[u32](j.a);
        ret appended(j, wasm_object.element(j.out, stated), f.keyword.at);
    }
    stated.type = wasm_valtype.widened(it.type);
    var spans: vector.Vector[wasm_object.Span] = vector.init[wasm_object.Span](j.a);
    var i:     usize                           = 0;
    for (i < it.exprs.len) {
        val x: res[wasm_object.Span, diagnostic.Diagnostic] = held(j, ?it.exprs.data[i], f.keyword.at);
        if (sel x.err) {
            vector.dnit[wasm_object.Span](?spans);
            ret err[diagnostic.Diagnostic].err{x.err};
        }
        val pushed: res[usize, A.Error] = vector.push[wasm_object.Span](?spans, x.ok);
        if (sel pushed.err) {
            vector.dnit[wasm_object.Span](?spans);
            ret refuse(j, field.MEMORY, f.keyword.at, f.keyword.len);
        }
        i = i + 1;
    }
    stated.items = wasm_object.Items.expressions{spans};
    ret appended(j, wasm_object.element(j.out, stated), f.keyword.at);
}

# the data segment `p` notes, read in its index order: a memory use and an offset for an active one, then its strings.
# an active segment writes its memory's index for a memory other than the first
fun data(j: *Job, b: *wasm_body.Reader, p: *Pending) err[diagnostic.Diagnostic] {
    val f:      *Field           = ?j.fields.data[p.field];
    var l:      wasm_text.Lexer  = wasm_text.make(j.text, p.at, f.end + 1);
    var active: bool             = false;
    var mem:    u32              = p.of;
    var off:    wasm_object.Span = wasm_object.Span{at: 0, len: 0};
    if (p.inline) {
        active = true;
        val z: res[wasm_object.Span, diagnostic.Diagnostic] = zero(j, address_of(j, wasm_kind.MEMORIES, mem), f.keyword.at);
        if (sel z.err) { ret err[diagnostic.Diagnostic].err{z.err}; }
        off = z.ok;
    }
    or {
        var used: bool = false;
        if (wasm_text.opens(?l, "memory")) {
            val x: res[u32, diagnostic.Diagnostic] = index(j, ?l, wasm_kind.MEMORIES);
            if (sel x.err) { ret err[diagnostic.Diagnostic].err{x.err}; }
            val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
            if (sel shut.err) { ret shut; }
            mem  = x.ok;
            used = true;
        }
        or (indexed(j, ?l)) {
            val x: res[u32, diagnostic.Diagnostic] = index(j, ?l, wasm_kind.MEMORIES);
            if (sel x.err) { ret err[diagnostic.Diagnostic].err{x.err}; }
            mem  = x.ok;
            used = true;
        }
        if (used || offset_ahead(j, b, ?l)) {
            val o: res[wasm_object.Span, diagnostic.Diagnostic] = offset(j, b, ?l);
            if (sel o.err) { ret err[diagnostic.Diagnostic].err{o.err}; }
            off    = o.ok;
            active = true;
        }
    }
    var bytes: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?bytes); }
    val got: err[diagnostic.Diagnostic] = strings(j, ?l, ?bytes);
    if (sel got.err) { ret got; }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    var head: wasm_object.Head = wasm_object.Head.passive{};
    if (active) {
        var index: opt[u32] = opt[u32].none{};
        if (mem != 0) { index = opt[u32].some{mem}; }
        head = wasm_object.Head.active{wasm_object.At{index: index, offset: off}};
    }
    val s: res[Id[mink_object.Section], Fail] = wasm_object.segment(j.out, head, wasm_object.PLAIN, bytes.data, bytes.len);
    if (sel s.err) { ret failed(j, s.err, f.keyword.at); }
    ret err[diagnostic.Diagnostic].ok{};
}

# the locals at the lexer, `(local $id t)` or `(local t*)`, defined after the params, onto `types`
fun locals(j: *Job, l: *wasm_text.Lexer, types: *vector.Vector[u32]) err[diagnostic.Diagnostic] {
    for (wasm_text.opens(l, "local")) {
        val name: View = identifier(j, l);
        for {
            val t: wasm_text.Token = wasm_text.ahead(l);
            if (t.kind == wasm_text.CLOSE) { brk; }
            val got: res[u32, diagnostic.Diagnostic] = value_type(j, l);
            if (sel got.err) { ret err[diagnostic.Diagnostic].err{got.err}; }
            val defined: res[u32, str] = wasm_stream.define(j.ctx.stream, wasm_kind.LOCALS, got.ok, name);
            if (sel defined.err) { ret refuse(j, defined.err, t.at, t.len); }
            val pushed: res[usize, A.Error] = vector.push[u32](types, got.ok);
            if (sel pushed.err) { ret refuse(j, field.MEMORY, t.at, t.len); }
            if (name.len > 0)   { brk; }
        }
        val shut: err[diagnostic.Diagnostic] = closed(j, l);
        if (sel shut.err) { ret shut; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# value type of stream code `code` onto `out`: its byte, and a typed reference's heap type as an s33 after it
fun put_value_type(out: *vector.Vector[u8], code: u32) {
    val whole: i64 = wasm_valtype.widened(code);
    val b:     u8  = (whole & 0xFF)::u8;
    vector.push[u8](out, b);
    if (b == wasm_field.REF || b == wasm_field.REF_NULL) { wasm_leb.put_signed(out, whole >> 8); }
}

# the locals vector of a body: each run of locals of one type as its count and its type
fun local_runs(out: *vector.Vector[u8], types: *vector.Vector[u32]) {
    var runs: u64   = 0;
    var i:    usize = 0;
    for (i < types.len) {
        if (i == 0 || types.data[i] != types.data[i - 1]) { runs = runs + 1; }
        i = i + 1;
    }
    wasm_leb.put_unsigned(out, runs);
    i = 0;
    for (i < types.len) {
        var n: usize = i;
        for (n < types.len && types.data[n] == types.data[i]) { n = n + 1; }
        wasm_leb.put_unsigned(out, (n - i)::u64);
        put_value_type(out, types.data[i]);
        i = n;
    }
}

# function `d`'s body: the stream entered at its type, its params named, its locals and its code, stated as its body
fun body_of(j: *Job, b: *wasm_body.Reader, d: *Defined) err[diagnostic.Diagnostic] {
    val type: u32             = d.type;
    val f:    *Field          = ?j.fields.data[d.field];
    var l:    wasm_text.Lexer = lexer(j, f);
    val name: View            = identifier(j, ?l);
    past_exports(?l);
    val entered: err[str] = wasm_stream.enter(j.ctx.stream, type);
    if (sel entered.err) { ret refuse(j, entered.err, l.at, 1); }
    var names: vector.Vector[View] = vector.init[View](j.a);
    fin { vector.dnit[View](?names); }
    val typed: res[u32, diagnostic.Diagnostic] = type_use(j, ?l, ?names);
    if (sel typed.err) { ret err[diagnostic.Diagnostic].err{typed.err}; }
    var i: usize = 0;
    for (i < names.len) {
        val named: err[str] = wasm_stream.name_local(j.ctx.stream, i::u32, names.data[i]);
        if (sel named.err) { ret refuse(j, named.err, l.at, 1); }
        i = i + 1;
    }
    var types: vector.Vector[u32] = vector.init[u32](j.a);
    fin { vector.dnit[u32](?types); }
    val declared: err[diagnostic.Diagnostic] = locals(j, ?l, ?types);
    if (sel declared.err) { ret declared; }
    var body: vector.Vector[u8] = vector.init[u8](j.a);
    fin { vector.dnit[u8](?body); }
    local_runs(?body, ?types);
    val code: err[diagnostic.Diagnostic] = wasm_body.function(b, ?l, ?body);
    if (sel code.err) { ret code; }
    val shut: err[diagnostic.Diagnostic] = closed(j, ?l);
    if (sel shut.err) { ret shut; }
    val stated: res[Id[mink_object.Section], Fail] = wasm_object.body(j.out, d.index::usize, body.data, body.len);
    if (sel stated.err) { ret failed(j, stated.err, f.keyword.at); }
    ret err[diagnostic.Diagnostic].ok{};
}

# the module the `len` bytes of `source` spell, read under `ctx`, whose stream it begins and fills, as mink's neutral
# object of a module for `arch`, which the caller releases
# ---
# origin: the position of the text's first byte
pub fun read(a: *A.Allocator, source: *u8, len: usize, origin: diagnostic.Position, ctx: *state.Context, arch: *mink_arch.Arch) res[mink_object.Object, diagnostic.Diagnostic] {
    var m: wasm_object.Module         = wasm_object.make(a, arch, ?catalog_kind.MODULE);
    val e: err[diagnostic.Diagnostic] = read_into(a, source, len, origin, ctx, ?m);
    if (sel e.err) {
        wasm_object.release(?m);
        ret res[mink_object.Object, diagnostic.Diagnostic].err{e.err};
    }
    val o: res[mink_object.Object, Fail] = wasm_object.finish(?m, ctx.stream);
    if (sel o.err) {
        var message: str = o.err.text;
        if (message == nil) { message = FAILED; }
        ret res[mink_object.Object, diagnostic.Diagnostic].err{diagnostic.refusal(message, origin, source, 0, 0)};
    }
    ret res[mink_object.Object, diagnostic.Diagnostic].ok{o.ok};
}

# the module the text spells stated on `out`
fun read_into(a: *A.Allocator, source: *u8, len: usize, origin: diagnostic.Position, ctx: *state.Context, out: *wasm_object.Module) err[diagnostic.Diagnostic] {
    val codec: *dispatch.Codec = ?wasm_codec.CODEC;
    wasm_stream.HOOKS.begin(ctx.stream);
    # the fields are read from a copy whose comments are blanked, so the instruction syntax's readers pass them as
    # the white space they are
    val copied: res[*u8, A.Error] = wasm_text.blanked(a, source, len);
    if (sel copied.err) { ret err[diagnostic.Diagnostic].err{diagnostic.refusal(field.MEMORY, origin, source, 0, 0)}; }
    val text: *u8 = copied.ok;
    fin { val freed: err[A.Error] = A.deallocate[u8](a, text, len + 1); }
    var j: Job = Job{a: a, text: text, origin: origin, codec: codec, ctx: ctx, fields: vector.init[Field](a), funcs: vector.init[Defined](a), globals: vector.init[Pending](a), tables: vector.init[Pending](a), elements: vector.init[Pending](a), datas: vector.init[Pending](a), start: opt[u32].none{}, started: false, out: out};
    fin {
        vector.dnit[Field](?j.fields);
        vector.dnit[Defined](?j.funcs);
        vector.dnit[Pending](?j.globals);
        vector.dnit[Pending](?j.tables);
        vector.dnit[Pending](?j.elements);
        vector.dnit[Pending](?j.datas);
    }
    var l:      wasm_text.Lexer            = wasm_text.make(text, 0, len);
    val listed: err[diagnostic.Diagnostic] = fields(?j, ?l);
    if (sel listed.err) { ret listed; }
    var b:    wasm_body.Reader           = wasm_body.make(a, text, origin, codec, ctx);
    val done: err[diagnostic.Diagnostic] = kept_requires(a, passes(?j, ?b));
    wasm_body.release(?b);
    ret done;
}

# `e` with what its refusal needed copied into `a`, as the reader's storage it lies in goes with the reader, and the
# refusal outlives it. a copy `a` refuses leaves the refusal naming none
fun kept_requires(a: *A.Allocator, e: err[diagnostic.Diagnostic]) err[diagnostic.Diagnostic] {
    if (!sel e.err)              { ret e; }
    if (e.err.requires.len == 0) { ret e; }
    var d:   diagnostic.Diagnostic                  = e.err;
    val got: res[*requirement.Alternative, A.Error] = A.allocate[requirement.Alternative](a, d.requires.len::usize);
    if (sel got.err) {
        d.requires = requirement.NO_ALTERNATIVES;
        ret err[diagnostic.Diagnostic].err{d};
    }
    var i: u32 = 0;
    for (i < d.requires.len) {
        got.ok[i] = d.requires.at[i];
        i         = i + 1;
    }
    d.requires = requirement.Requirement{at: got.ok, len: d.requires.len};
    ret err[diagnostic.Diagnostic].err{d};
}

# the type names, the fields in their passes and the sections
fun passes(j: *Job, b: *wasm_body.Reader) err[diagnostic.Diagnostic] {
    var k:     usize = 0;
    var types: u32   = 0;
    for (k < j.fields.len) {
        val f: *Field = ?j.fields.data[k];
        if (is(j, f, "type")) {
            var l:     wasm_text.Lexer = lexer(j, f);
            val named: err[str]        = wasm_stream.name_type(j.ctx.stream, types, identifier(j, ?l));
            if (sel named.err) { ret refuse(j, named.err, f.keyword.at, f.keyword.len); }
            types = types + 1;
        }
        k = k + 1;
    }
    k = 0;
    for (k < j.fields.len) {
        val f: *Field = ?j.fields.data[k];
        if (is(j, f, "type")) {
            val got: err[diagnostic.Diagnostic] = type_field(j, f);
            if (sel got.err) { ret got; }
        }
        or (is(j, f, "rec")) { ret refuse(j, GC_TYPE, f.keyword.at, f.keyword.len); }
        k = k + 1;
    }
    k = 0;
    for (k < j.fields.len) {
        val f:   *Field                     = ?j.fields.data[k];
        var got: err[diagnostic.Diagnostic] = err[diagnostic.Diagnostic].ok{};
        if (is(j, f, "import"))                                             { got = import_field(j, f); }
        or (is(j, f, "func"))                                               { got = func_field(j, b, f, k::u32); }
        or (is(j, f, "table"))                                              { got = table_field(j, f, k::u32); }
        or (is(j, f, "memory"))                                             { got = memory_field(j, f, k::u32); }
        or (is(j, f, "global"))                                             { got = global_field(j, f, k::u32); }
        or (is(j, f, "tag"))                                                { got = tag_field(j, f); }
        or (is(j, f, "elem") || is(j, f, "data"))                           { got = segment_field(j, f, k::u32); }
        or (!is(j, f, "type") && !is(j, f, "export") && !is(j, f, "start")) { got = refuse(j, UNREAD_FIELD, f.keyword.at, f.keyword.len); }
        if (sel got.err)                                                    { ret got; }
        k = k + 1;
    }
    k = 0;
    for (k < j.fields.len) {
        val f:   *Field                     = ?j.fields.data[k];
        var got: err[diagnostic.Diagnostic] = err[diagnostic.Diagnostic].ok{};
        if (is(j, f, "export")) { got = export_field(j, f); }
        or (is(j, f, "start"))  { got = start_field(j, f); }
        or (f.defines)          { got = inline_exports(j, f); }
        if (sel got.err)        { ret got; }
        k = k + 1;
    }
    k = 0;
    for (k < j.globals.len) {
        val got: err[diagnostic.Diagnostic] = global_init(j, b, ?j.globals.data[k]);
        if (sel got.err) { ret got; }
        k = k + 1;
    }
    if (j.tables.len > 0) {
        val f: *Field = ?j.fields.data[j.tables.data[0].field];
        ret refuse(j, TABLE_INIT, j.tables.data[0].at, f.end - j.tables.data[0].at);
    }
    k = 0;
    for (k < j.elements.len) {
        val got: err[diagnostic.Diagnostic] = element(j, b, ?j.elements.data[k]);
        if (sel got.err) { ret got; }
        k = k + 1;
    }
    k = 0;
    for (k < j.datas.len) {
        val got: err[diagnostic.Diagnostic] = data(j, b, ?j.datas.data[k]);
        if (sel got.err) { ret got; }
        k = k + 1;
    }
    k = 0;
    for (k < j.funcs.len) {
        val got: err[diagnostic.Diagnostic] = body_of(j, b, ?j.funcs.data[k]);
        if (sel got.err) { ret got; }
        k = k + 1;
    }
    if (sel j.start.some) { wasm_object.start(j.out, j.start.some); }
    if (b.datas)          { wasm_object.count_data(j.out); }
    ret err[diagnostic.Diagnostic].ok{};
}

# a module's text, its fields, read here and printed by `masc.isa.wasm.print`
pub val MODULE: stream.Module = stream.Module.printed{stream.Printed{print: wasm_print.module, read: read}};
