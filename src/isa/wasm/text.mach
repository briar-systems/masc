# the tokens of wasm's text format
#
# a module's text is parentheses, atoms and strings, between white space, line comments from `;;` and block comments
# `(;` to `;)`, which nest (WebAssembly Specification release 3.0, tag wg-3.0, 6.0-text.lexical). an atom is a run of
# the characters the format allows in a keyword, an identifier or a number: a keyword starts with a lower case
# letter, an identifier with `$` and a number with a digit or a sign. a string is `"` to `"`, `\` escaping one
# character or two hex digits.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.allocator.testing;

pub val UNCLOSED_COMMENT: str = "block comment not closed";
pub val UNCLOSED_STRING:  str = "string not closed";
pub val STRAY:            str = "character the text format allows in no token";

pub def Kind: u8;

pub val END:    Kind = 0;
pub val OPEN:   Kind = 1;
pub val CLOSE:  Kind = 2;
pub val ATOM:   Kind = 3;
pub val STRING: Kind = 4;
pub val BROKEN: Kind = 5;

# a token: its kind and its bytes, a string's quotes included, and for a broken one why
pub rec Token {
    kind: Kind;
    at:   usize;
    len:  usize;
    why:  str;
}

# a cursor over the bytes `text[at..end]`
pub rec Lexer {
    text: *u8;
    at:   usize;
    end:  usize;
}

pub fun make(text: *u8, at: usize, end: usize) Lexer {
    ret Lexer{text: text, at: at, end: end};
}

fun blank(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

# whether `c` may stand in an atom, the format's idchar
pub fun idchar(c: u8) bool {
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) { ret true; }
    val marks: str   = "!#$%&'*+-./:<=>?@\\^_`|~";
    var i:     usize = 0;
    for (marks[i] != 0) {
        if (c == marks[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun peek(l: *Lexer, k: usize) u8 {
    if (l.at + k >= l.end) { ret 0; }
    ret l.text[l.at + k];
}

# white space and comments passed, false for a block comment never closed
fun space(l: *Lexer) bool {
    for (l.at < l.end) {
        val c: u8 = l.text[l.at];
        if (blank(c)) { l.at = l.at + 1; }
        or (c == ';' && peek(l, 1) == ';') {
            for (l.at < l.end && l.text[l.at] != '\n') { l.at = l.at + 1; }
        }
        or (c == '(' && peek(l, 1) == ';') {
            var depth: usize = 0;
            for {
                if (l.at >= l.end) { ret false; }
                if (l.text[l.at] == '(' && peek(l, 1) == ';') {
                    depth = depth + 1;
                    l.at  = l.at + 2;
                }
                or (l.text[l.at] == ';' && peek(l, 1) == ')') {
                    depth = depth - 1;
                    l.at  = l.at + 2;
                    if (depth == 0) { brk; }
                }
                or { l.at = l.at + 1; }
            }
        }
        or { ret true; }
    }
    ret true;
}

# the next token, the lexer past it
pub fun next(l: *Lexer) Token {
    val start: usize = l.at;
    if (!space(l)) { ret Token{kind: BROKEN, at: start, len: l.at - start, why: UNCLOSED_COMMENT}; }
    val at: usize = l.at;
    if (at >= l.end) { ret Token{kind: END, at: at, len: 0, why: nil}; }
    val c: u8 = l.text[at];
    if (c == '(') {
        l.at = at + 1;
        ret Token{kind: OPEN, at: at, len: 1, why: nil};
    }
    if (c == ')') {
        l.at = at + 1;
        ret Token{kind: CLOSE, at: at, len: 1, why: nil};
    }
    if (c == '"') {
        var i: usize = at + 1;
        for (i < l.end && l.text[i] != '"') {
            if (l.text[i] == '\\') { i = i + 1; }
            i = i + 1;
        }
        if (i >= l.end) {
            l.at = l.end;
            ret Token{kind: BROKEN, at: at, len: l.end - at, why: UNCLOSED_STRING};
        }
        l.at = i + 1;
        ret Token{kind: STRING, at: at, len: i + 1 - at, why: nil};
    }
    if (!idchar(c)) {
        l.at = at + 1;
        ret Token{kind: BROKEN, at: at, len: 1, why: STRAY};
    }
    var i: usize = at;
    for (i < l.end && idchar(l.text[i])) { i = i + 1; }
    l.at = i;
    ret Token{kind: ATOM, at: at, len: i - at, why: nil};
}

# the token after the one the lexer is at, the lexer left where it was
pub fun ahead(l: *Lexer) Token {
    var copy: Lexer = @l;
    ret next(?copy);
}

# whether atom `t` is the keyword `word`
pub fun is(l: *Lexer, t: Token, word: str) bool {
    if (t.kind != ATOM || t.len != str_len(word)) { ret false; }
    var i: usize = 0;
    for (i < t.len) {
        if (l.text[t.at + i] != word[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether atom `t` is an identifier
pub fun identifier(l: *Lexer, t: Token) bool {
    ret t.kind == ATOM && t.len > 1 && l.text[t.at] == '$';
}

# whether `(` and the keyword `word` come next, passed when they do
pub fun opens(l: *Lexer, word: str) bool {
    var copy: Lexer = @l;
    if (next(?copy).kind != OPEN)  { ret false; }
    if (!is(l, next(?copy), word)) { ret false; }
    @l = copy;
    ret true;
}

# the lexer past the rest of the parenthesized form it is inside, its `)` included, false when the text ends first
pub fun skip(l: *Lexer) bool {
    var depth: usize = 1;
    for {
        val t: Token = next(l);
        if (t.kind == END || t.kind == BROKEN) { ret false; }
        if (t.kind == OPEN)                    { depth = depth + 1; }
        if (t.kind == CLOSE) {
            depth = depth - 1;
            if (depth == 0) { ret true; }
        }
    }
}

#[testing]
fun t_kinds(text: str, kinds: *Kind, n: usize) bool {
    var l: Lexer = make(text, 0, str_len(text));
    var i: usize = 0;
    for (i < n) {
        if (next(?l).kind != kinds[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# parentheses, atoms and strings read between white space and comments, nested block comments included, and an
# unclosed comment or string is broken
test text__tokens_between_comments {
    val want: [7]Kind = [7]Kind{OPEN, ATOM, ATOM, STRING, CLOSE, ATOM, END};
    if (!t_kinds("(func $f ;; a comment\n (; outer (; inner ;) ;) \"a\\\"b\") i32.add", ?want[0], 7)) { ret 1; }
    val open: [1]Kind = [1]Kind{BROKEN};
    if (!t_kinds("(; never closed", ?open[0], 1)) { ret 2; }
    if (!t_kinds("\"never closed", ?open[0], 1))  { ret 3; }
    var l: Lexer = make("(type $t) x", 0, 11);
    if (!opens(?l, "type") || !identifier(?l, next(?l)) || next(?l).kind != CLOSE || !is(?l, next(?l), "x")) { ret 4; }
    ret 0;
}
