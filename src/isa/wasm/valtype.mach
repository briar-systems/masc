# masc's codes of wasm value types, as its stream holds them and as mink's wasm facts state them
#
# masc names a value type by one code: a number or vector type by its byte, a nullable reference to an abstract heap
# type by its one-byte shorthand, and any other reference type by its low byte `ref` or `ref null` with its heap type
# above it, an abstract one less 0x80 and a type index as itself. the stream keeps the low 32 bits of the code, which
# hold every type whose heap type's index is below 2^23. mink's facts state a value type as a typed `fact.Value`, a
# heap type's index as the type entry of the object that index names, which is the entry of that position, as an
# object's types are its first entries.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use mink.base.table;
use mink.format.wasm.fact;
use mink.model.object.Entry;

use wasm_field: masc.isa.wasm.field;

# the byte of funcref, the element kind a segment of function indices writes as 0
pub val FUNCREF: u8 = 0x70;

# the bytes of the number and vector types
val I32:  u8 = 0x7F;
val I64:  u8 = 0x7E;
val F32:  u8 = 0x7D;
val F64:  u8 = 0x7C;
val V128: u8 = 0x7B;

# the stream's code of a value type, the low 32 bits of masc's code, widened back to it
pub fun widened(code: u32) i64 {
    ret code:~i32::i64;
}

# the stream's code of the value type of masc's code `code`
pub fun stream_code(code: i64) u32 {
    ret code:~u64::u32;
}

# whether the stream's code holds the value type of masc's code `code` whole, as it does a heap type's index below 2^23
pub fun held_by_stream(code: i64) bool {
    ret widened(stream_code(code)) == code;
}

# whether `b` is the byte of a number or vector type
fun number(b: u8) bool {
    ret b == I32 || b == I64 || b == F32 || b == F64 || b == V128;
}

# the value type masc's code `code` names, as mink's facts state it
pub fun value(code: i64) fact.Value {
    val b: u8 = (code & 0xFF)::u8;
    if (code == b::i64 && number(b)) { ret fact.Value.number{b}; }
    ret fact.Value.reference{reference(code)};
}

# the reference type masc's code `code` names, as mink's facts state it
pub fun reference(code: i64) fact.Reference {
    val b: u8 = (code & 0xFF)::u8;
    if (b != wasm_field.REF && b != wasm_field.REF_NULL) { ret fact.Reference{nullable: true, heap: fact.Heap.abstract{b}}; }
    val ht: i64 = code >> 8;
    if (ht < 0) { ret fact.Reference{nullable: b == wasm_field.REF_NULL, heap: fact.Heap.abstract{(ht + 0x80)::u8}}; }
    ret fact.Reference{nullable: b == wasm_field.REF_NULL, heap: fact.Heap.entry{table.nth[Entry](ht::usize)}};
}

# masc's code of the value type `v`, as `value` reads it back
pub fun code_of(v: *fact.Value) i64 {
    if (sel v.number) { ret v.number::i64; }
    ret reference_code(?v.reference);
}

# masc's code of the reference type `r`, as `reference` reads it back: a nullable reference to an abstract heap type
# by its shorthand, as mink's facts write it
pub fun reference_code(r: *fact.Reference) i64 {
    var ht: i64 = 0;
    if (sel r.heap.abstract) {
        if (r.nullable) { ret r.heap.abstract::i64; }
        ht = r.heap.abstract::i64 - 0x80;
    }
    or { ht = r.heap.entry.index::i64; }
    var b: u8 = wasm_field.REF;
    if (r.nullable) { b = wasm_field.REF_NULL; }
    ret (ht << 8) | b::i64;
}

# whether `r` is funcref
pub fun is_funcref(r: *fact.Reference) bool {
    if (!r.nullable)         { ret false; }
    if (sel r.heap.abstract) { ret r.heap.abstract == FUNCREF; }
    ret false;
}
