# wasm's LEB128 integers, as its binary format reads them
#
# an integer of N bits is at most ceil(N / 7) bytes, every byte but the last with its high bit set, and the bits of
# its last byte past N are zero for an unsigned one and the sign's copies for a signed one (WebAssembly Specification
# release 3.0, tag wg-3.0, 5.1-binary.values.spectec, BuN and BsN). a longer form, or one whose unused bits break
# that, is overlong and refused. a form of fewer bytes than the bound with redundant bytes inside it is admitted, and
# read as its value: masc writes the shortest form, so a read of one and a write of its value may differ in length,
# which no row keeps (limit, until mink#91 states a padded LEB).

use std.types.bool.bool;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator.testing;
use std.collections.vector;

use masc.core.field;

pub val OVERLONG: str = "LEB128 longer than its integer's bytes or with bits past its width";

# a value read and how many bytes it took
pub rec Read {
    value: u64;
    len:   usize;
}

# the unsigned integer of `bits` at `at` of the `len` bytes at `data`, refused for operand `op`
pub fun unsigned(data: *u8, len: usize, at: usize, bits: u32, op: u8) res[Read, field.Refusal] {
    val most:  usize = ((bits + 6) / 7)::usize;
    var v:     u64   = 0;
    var shift: u32   = 0;
    var i:     usize = 0;
    for {
        if (at + i >= len) { ret res[Read, field.Refusal].err{field.refusal(field.TRUNCATED, op, at)}; }
        if (i >= most)     { ret res[Read, field.Refusal].err{field.refusal(OVERLONG, op, at)}; }
        val b: u64 = data[at + i]::u64;
        i = i + 1;
        # the last byte a width allows holds only the bits left of it
        if (i == most && bits - shift < 7) {
            val spare: u64 = (b & 0x7F) >> (bits - shift)::u64;
            if ((b & 0x80) != 0 || spare != 0) { ret res[Read, field.Refusal].err{field.refusal(OVERLONG, op, at)}; }
        }
        v = v | ((b & 0x7F) << shift::u64);
        if ((b & 0x80) == 0) { brk; }
        shift = shift + 7;
    }
    ret res[Read, field.Refusal].ok{Read{value: v, len: i}};
}

# the signed integer of `bits` at `at`, its value's bits as a u64, refused for operand `op`
pub fun signed(data: *u8, len: usize, at: usize, bits: u32, op: u8) res[Read, field.Refusal] {
    val most:  usize = ((bits + 6) / 7)::usize;
    var v:     u64   = 0;
    var shift: u32   = 0;
    var i:     usize = 0;
    var b:     u64   = 0;
    for {
        if (at + i >= len) { ret res[Read, field.Refusal].err{field.refusal(field.TRUNCATED, op, at)}; }
        if (i >= most)     { ret res[Read, field.Refusal].err{field.refusal(OVERLONG, op, at)}; }
        b = data[at + i]::u64;
        i = i + 1;
        if (i == most && bits - shift < 7) {
            # the bits past the width, the sign bit among them, are all ones or all zeros
            val used:  u32 = bits - shift;
            val upper: u64 = (b & 0x7F) >> (used - 1)::u64;
            val all:   u64 = (1::u64 << (8 - used)::u64) - 1;
            if ((b & 0x80) != 0 || (upper != 0 && upper != all)) { ret res[Read, field.Refusal].err{field.refusal(OVERLONG, op, at)}; }
        }
        v     = v | ((b & 0x7F) << shift::u64);
        shift = shift + 7;
        if ((b & 0x80) == 0) { brk; }
    }
    if (shift < 64 && (b & 0x40) != 0) { v = v | (0xFFFF_FFFF_FFFF_FFFF << shift::u64); }
    ret res[Read, field.Refusal].ok{Read{value: v, len: i}};
}

# `v` written as the shortest unsigned LEB128
pub fun put_unsigned(out: *vector.Vector[u8], v: u64) {
    var m: u64 = v;
    for {
        var b: u8 = (m & 0x7F)::u8;
        m = m >> 7;
        if (m != 0) { b = b | 0x80; }
        vector.push[u8](out, b);
        if (m == 0) { brk; }
    }
}

# `v` written as the shortest signed LEB128
pub fun put_signed(out: *vector.Vector[u8], v: i64) {
    var m: i64 = v;
    for {
        val b: u8 = (m & 0x7F)::u8;
        m = m >> 7;
        val done: bool = (m == 0 && (b & 0x40) == 0) || (m == -1 && (b & 0x40) != 0);
        if (done) {
            vector.push[u8](out, b);
            brk;
        }
        vector.push[u8](out, b | 0x80);
    }
}

# the bytes of `n` written as one buffer
#[testing]
fun t_bytes(t: *testing.Testing, data: *u8, n: usize) vector.Vector[u8] {
    var v: vector.Vector[u8] = vector.init[u8](testing.allocator_of(t));
    var i: usize             = 0;
    for (i < n) {
        vector.push[u8](?v, data[i]);
        i = i + 1;
    }
    ret v;
}

# a u32's and an s33's boundary values write their shortest form and read back, and a form past the bound or with bits
# past the width is refused
test leb__boundaries_encode_and_overlong_is_refused {
    var t: testing.Testing;
    testing.make(?t);
    var out:    vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t));
    val values: [5]u64            = [5]u64{0, 127, 128, 0xFFFF_FFFF, 0x7FFF_FFFF};
    val lens:   [5]usize          = [5]usize{1, 1, 2, 5, 5};
    var i:      usize             = 0;
    for (i < 5) {
        out.len = 0;
        put_unsigned(?out, values[i]);
        if (out.len != lens[i]) { ret 1; }
        val back: res[Read, field.Refusal] = unsigned(out.data, out.len, 0, 32, 0);
        if (sel back.err)                                         { ret 2; }
        if (back.ok.value != values[i] || back.ok.len != lens[i]) { ret 3; }
        i = i + 1;
    }
    val signs: [4]i64   = [4]i64{-1, -64, -65, -2147483648};
    val slens: [4]usize = [4]usize{1, 1, 2, 5};
    i = 0;
    for (i < 4) {
        out.len = 0;
        put_signed(?out, signs[i]);
        if (out.len != slens[i]) { ret 4; }
        val back: res[Read, field.Refusal] = signed(out.data, out.len, 0, 32, 0);
        if (sel back.err)                   { ret 5; }
        if (back.ok.value::i64 != signs[i]) { ret 6; }
        i = i + 1;
    }
    # six bytes for a u32, and a fifth byte holding bits past 32
    val long:    [6]u8                    = [6]u8{0x80, 0x80, 0x80, 0x80, 0x80, 0x00};
    var a:       vector.Vector[u8]        = t_bytes(?t, ?long[0], 6);
    val refused: res[Read, field.Refusal] = unsigned(a.data, a.len, 0, 32, 0);
    if (!sel refused.err) { ret 7; }
    val wide: [5]u8                    = [5]u8{0xFF, 0xFF, 0xFF, 0xFF, 0x1F};
    var b:    vector.Vector[u8]        = t_bytes(?t, ?wide[0], 5);
    val past: res[Read, field.Refusal] = unsigned(b.data, b.len, 0, 32, 0);
    if (!sel past.err) { ret 8; }
    # a redundant byte within the bound reads as its value
    val padded: [2]u8                    = [2]u8{0x80, 0x00};
    var c:      vector.Vector[u8]        = t_bytes(?t, ?padded[0], 2);
    val zero:   res[Read, field.Refusal] = unsigned(c.data, c.len, 0, 32, 0);
    if (sel zero.err)                           { ret 9; }
    if (zero.ok.value != 0 || zero.ok.len != 2) { ret 10; }
    # an s33's fifth byte holds its sign's copies
    val badsign: [5]u8                    = [5]u8{0xFF, 0xFF, 0xFF, 0xFF, 0x4F};
    var d:       vector.Vector[u8]        = t_bytes(?t, ?badsign[0], 5);
    val broken:  res[Read, field.Refusal] = signed(d.data, d.len, 0, 33, 0);
    if (!sel broken.err) { ret 11; }
    ret 0;
}
