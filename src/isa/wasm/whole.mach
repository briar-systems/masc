# a wasm module as its text states it, its fields
#
# the text is one module of fields, which states no section: mink's writer lays the module's sections out in the
# order the specification fixes. the module printer (`masc.isa.wasm.print`) writes the fields of mink's model of a
# module, and the module reader (`masc.isa.wasm.module`) reads them back into it, so a module's text is read back
# whole and held to the bytes mink writes of the module.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;

use mink.base.fail.Fail;
use mink.bytes.sink.Sink;
use mink_model: mink.format.wasm.model;
use mink_write: mink.format.wasm.write;

use masc.core.diagnostic;
use masc.core.state;
use masc.core.stream;

use wasm_codec:  masc.isa.wasm.codec;
use wasm_module: masc.isa.wasm.module;
use wasm_print:  masc.isa.wasm.print;

# the fields of the module `model`, mink's model of it, onto `out`
fun printed(model: ptr, ctx: *state.Context, out: *vector.Vector[u8]) err[str] {
    ret wasm_print.module(model::*mink_model.Module, ?wasm_codec.CODEC, ctx, out);
}

# the bytes mink writes of the module the `len` bytes of `text`, whose first byte is at `origin`, read back to, the
# model the reader fills given back whether or not it is refused
fun read(a: *A.Allocator, text: *u8, len: usize, origin: diagnostic.Position, ctx: *state.Context) res[Sink, stream.Unread] {
    var m:    mink_model.Module;
    val got:  err[diagnostic.Diagnostic] = wasm_module.read(a, text, len, origin, ?wasm_codec.CODEC, ctx, ?m);
    var back: res[Sink, stream.Unread];
    if (sel got.err) { back = res[Sink, stream.Unread].err{stream.Unread.text{got.err}}; }
    or (sel got.ok) {
        val wrote: res[Sink, Fail] = mink_write.write(a, ?m);
        if (sel wrote.ok)  { back = res[Sink, stream.Unread].ok{wrote.ok}; }
        or (sel wrote.err) { back = res[Sink, stream.Unread].err{stream.Unread.written{wrote.err}}; }
    }
    val released: err[Fail] = mink_model.release(?m);
    ret back;
}

# a wasm module's text, its fields
pub val MODULE: stream.Module = stream.Module.printed{stream.Printed{print: printed, read: read}};
