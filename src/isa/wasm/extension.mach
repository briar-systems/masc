# the wasm feature catalog and its selection
#
# the rows are generated, by gen wasm's catalog generator into gen_extension, from masc's own catalog under
# gen/data/wasm/features: every feature of the WebAssembly Specification release 3.0 and the threads proposal, by
# its feature name, with the implications a source states, and the levels wasm1, wasm2 and wasm3. a consumer names a handle there, as `gen_extension.SIMD128`. a
# selection is a comma-separated list of their names, as `wasm2,tail-call`.
#
# wasm has no execution state code switches: the width of an address is a memory's own type, so the set has no axes.

use masc.core.extension;
use masc.core.state;

use masc.isa.wasm.gen_extension;

pub val AXES: state.Axes = state.NO_AXES;

# the base selection, nothing added, is named by the processor `mvp`, a level of no members
pub val CATALOG: extension.Catalog = extension.Catalog{
    extensions:        ?gen_extension.ROWS[0],
    count:             gen_extension.COUNT,
    levels:            ?gen_extension.LEVELS[0],
    level_count:       gen_extension.LEVEL_COUNT,
    names:             extension.Names{at: ?gen_extension.NAMES[0], len: gen_extension.NAME_COUNT},
    name_keys:         ?gen_extension.NAME_KEYS[0],
    conflicts:         gen_extension.CONFLICTS,
    conflict_count:    gen_extension.CONFLICT_COUNT,
    combinations:      gen_extension.COMBINATIONS,
    combination_count: gen_extension.COMBINATION_COUNT,
    syntax:            ?extension.LIST,
    base:              "mvp",
};
