# a wasm module read as mink's neutral object, printed as its text
#
# the module is read through mink's facts (`mink.format.wasm.fact`): each type, import and definition by its entry,
# a function's body and a data segment's bytes by the section its entry names, and the element segments, exports and
# start function by the module's own facts. every field is written in the form the module reader
# (`masc.isa.wasm.module`) reads back to the same object: each index by its number, each function's type by
# `(type x)`, its locals and its instructions flat, one per line, each by the set's syntax under the stream the
# module's index spaces fill, and each segment in its full form, so the reader makes the choices of its encoding the
# module holds. a string is written by its printable bytes and `\hh` escapes. an instruction or a field the set
# cannot print, or that mink's facts give no typed form of, is refused.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.catalog.format;
use mink.format.wasm.fact;
use mink.model.object;
use mink.model.object.Entry;
use mink.model.object.Fact;
use mink.model.object.Object;
use mink.model.space;
use mink.model.space.Space;

use masc.codec.walk;
use masc.core.dispatch;
use masc.core.field;
use masc.core.inst;
use masc.core.mode;
use masc.core.operand;
use masc.core.requirement;
use masc.core.state;
use core_syntax:  masc.core.syntax;
use syntax_print: masc.syntax.print;

use wasm_codec:   masc.isa.wasm.codec;
use wasm_field:   masc.isa.wasm.field;
use wasm_kind:    masc.isa.wasm.kind;
use wasm_leb:     masc.isa.wasm.leb;
use wasm_stream:  masc.isa.wasm.stream;
use wasm_syntax:  masc.isa.wasm.syntax;
use wasm_valtype: masc.isa.wasm.valtype;

use masc.isa.wasm.gen_row;
use masc.isa.wasm.gen_row_index;

pub val MEMORY:   str = "out of memory";
pub val NO_SPACE: str = "the stream refused a module's index space";
pub val UNENDED:  str = "an expression or a body runs past its bytes with no end";
pub val NO_FORM:  str = "a module entry the text format has no form of";
pub val REFUSED:  str = "mink refused a fact of the module";

# what a print writes with: the object, the index of its entries, its codec and context, the text so far, and the
# stores each instruction is decoded into, grown to the operands and the alternatives the largest holds
rec Job {
    o:     *Object;
    ix:    *fact.Index;
    codec: *dispatch.Codec;
    ctx:   *state.Context;
    out:   *vector.Vector[u8];
    modes: mode.State;
    store: vector.Vector[operand.Value];
    alts:  vector.Vector[requirement.Alternative];
}

fun put(j: *Job, s: str) err[str] {
    var i: usize = 0;
    for (s[i] != 0) {
        val pushed: res[usize, A.Error] = vector.push[u8](j.out, s[i]);
        if (sel pushed.err) { ret err[str].err{MEMORY}; }
        i = i + 1;
    }
    ret err[str].ok{};
}

fun number(j: *Job, v: u64) err[str] {
    var digits: [20]u8;
    var n:      usize = 0;
    var x:      u64   = v;
    for {
        digits[n] = ('0'::u64 + x % 10)::u8;
        n         = n + 1;
        x         = x / 10;
        if (x == 0) { brk; }
    }
    for (n > 0) {
        n = n - 1;
        val pushed: res[usize, A.Error] = vector.push[u8](j.out, digits[n]);
        if (sel pushed.err) { ret err[str].err{MEMORY}; }
    }
    ret err[str].ok{};
}

val HEX: str = "0123456789abcdef";

# the `len` bytes at `data` as a string, its printable bytes as they are and every other as `\hh`, nil `data` standing
# for zeros
fun string(j: *Job, data: *u8, len: usize) err[str] {
    var e: err[str] = put(j, "\"");
    var i: usize    = 0;
    for (i < len && !bad(e)) {
        var c: u8 = 0;
        if (data != nil) { c = data[i]; }
        if (c >= 0x20 && c < 0x7F && c != '"' && c != '\\') {
            val pushed: res[usize, A.Error] = vector.push[u8](j.out, c);
            if (sel pushed.err) { ret err[str].err{MEMORY}; }
        }
        or {
            val esc: [4]u8 = [4]u8{'\\', HEX[c >> 4], HEX[c & 0xF], 0};
            e = put(j, ?esc[0]);
        }
        i = i + 1;
    }
    if (bad(e)) { ret e; }
    ret put(j, "\"");
}

# the value type of code `code`, by the syntax's spelling
fun value_type(j: *Job, code: i64) err[str] {
    var w:     core_syntax.Writer = core_syntax.Writer{out: j.out, codec: j.codec, ctx: j.ctx, syntax: ?wasm_syntax.SYNTAX, modes: ?j.modes, symbols: nil, context: nil, row: nil};
    val wrote: err[field.Refusal] = wasm_syntax.valtype_write(?w, code);
    if (sel wrote.err) { ret err[str].err{wrote.err.message}; }
    ret err[str].ok{};
}

# the wording of mink's refusal `f`
fun refused(f: Fail) str {
    if (f.text == nil) { ret REFUSED; }
    ret f.text;
}

fun failed(f: Fail) err[str] {
    ret err[str].err{refused(f)};
}

fun entry_at(j: *Job, e: Id[Entry]) *Entry {
    ret table.at[Entry](?j.o.entries, e);
}

# the index the entry `e` takes in its space
fun index_of(j: *Job, e: Id[Entry]) u64 {
    ret @table.at[u64](?j.ix.within, table.nth[u64](e.index::usize));
}

fun bad(e: err[str]) bool {
    ret sel e.err;
}

fun kept(first: err[str], next: err[str]) err[str] {
    if (sel first.err) { ret first; }
    ret next;
}

fun value_types(j: *Job, word: str, t: *Table[fact.Value]) err[str] {
    val n: usize = table.count[fact.Value](t);
    if (n == 0) { ret err[str].ok{}; }
    var e: err[str] = put(j, " (");
    e = kept(e, put(j, word));
    var i: usize = 0;
    for (i < n && !bad(e)) {
        e = kept(e, put(j, " "));
        e = kept(e, value_type(j, wasm_valtype.code_of(table.at[fact.Value](t, table.nth[fact.Value](i)))));
        i = i + 1;
    }
    ret kept(e, put(j, ")"));
}

fun limits(j: *Job, l: *fact.Limits) err[str] {
    var e: err[str] = err[str].ok{};
    if (l.wide) { e = put(j, " i64"); }
    e = kept(e, put(j, " "));
    e = kept(e, number(j, l.min));
    if (sel l.max.some) {
        e = kept(e, put(j, " "));
        e = kept(e, number(j, l.max.some));
    }
    ret e;
}

fun memory_type(j: *Job, l: *fact.Limits) err[str] {
    var e: err[str] = limits(j, l);
    if (l.shared) { e = kept(e, put(j, " shared")); }
    ret e;
}

fun table_type(j: *Job, t: *fact.TableType) err[str] {
    var e: err[str] = limits(j, ?t.limits);
    e = kept(e, put(j, " "));
    ret kept(e, value_type(j, wasm_valtype.reference_code(?t.elem)));
}

fun global_type(j: *Job, g: *fact.GlobalType) err[str] {
    if (!g.mutable) { ret value_type(j, wasm_valtype.code_of(?g.value)); }
    var e: err[str] = put(j, "(mut ");
    e = kept(e, value_type(j, wasm_valtype.code_of(?g.value)));
    ret kept(e, put(j, ")"));
}

fun type_use(j: *Job, x: u64) err[str] {
    var e: err[str] = put(j, " (type ");
    e = kept(e, number(j, x));
    ret kept(e, put(j, ")"));
}

# the instructions of the `len` bytes at `data` from `at`, one per line after `indent`, up to the `end` that closes
# them, which is not written
fun instructions(j: *Job, data: *u8, len: usize, at: usize, indent: str) err[str] {
    var i: usize = at;
    for (i < len) {
        val got: res[walk.Decoded, field.Refusal] = walk.decode_grown(j.codec, j.ctx, data, len, i, ?j.store, ?j.alts);
        if (sel got.err) { ret err[str].err{got.err.message}; }
        var ins:  inst.Inst          = got.ok.inst;
        val seen: err[field.Refusal] = wasm_stream.HOOKS.observe(j.ctx.stream, ?ins);
        if (sel seen.err) { ret err[str].err{seen.err.message}; }
        i = i + got.ok.len;
        if (ins.row == ?gen_row.ROWS[gen_row_index.END] && wasm_stream.count(j.ctx.stream, wasm_kind.LABELS) == 0) { ret err[str].ok{}; }
        var e: err[str] = put(j, "\n");
        e = kept(e, put(j, indent));
        if (bad(e)) { ret e; }
        var w:     core_syntax.Writer = core_syntax.Writer{out: j.out, codec: j.codec, ctx: j.ctx, syntax: ?wasm_syntax.SYNTAX, modes: ?j.modes, symbols: nil, context: nil, row: ins.row};
        val wrote: err[field.Refusal] = syntax_print.instruction(?w, ?ins);
        if (sel wrote.err) { ret err[str].err{wrote.err.message}; }
    }
    ret err[str].err{UNENDED};
}

# a constant expression, its instructions in its own block
fun expression(j: *Job, x: View) err[str] {
    val entered: err[str] = wasm_stream.enter_expression(j.ctx.stream);
    if (sel entered.err) { ret entered; }
    ret instructions(j, x.data, x.len, 0, "    ");
}

# a run of locals' value type in a body: its code, and the bytes it takes
rec Local {
    code: i64;
    len:  usize;
}

# the value type at `at` of the body `b`: its byte, and a typed reference's heap type as an s33 after it
fun local_type(b: Bytes, at: usize) res[Local, field.Refusal] {
    if (at >= b.len) { ret res[Local, field.Refusal].err{field.refusal(UNENDED, field.NO_OPERAND, at)}; }
    val byte: u8 = b.data[at];
    if (byte != wasm_field.REF && byte != wasm_field.REF_NULL) { ret res[Local, field.Refusal].ok{Local{code: byte::i64, len: 1}}; }
    val heap: res[wasm_leb.Read, field.Refusal] = wasm_leb.signed(b.data, b.len, at + 1, 33, field.NO_OPERAND);
    if (sel heap.err) { ret res[Local, field.Refusal].err{heap.err}; }
    ret res[Local, field.Refusal].ok{Local{code: (heap.ok.value:~i64 << 8) | byte::i64, len: 1 + heap.ok.len}};
}

# the bytes of the section the entry `e` names as its body, refused for a zero fill
fun body_bytes(j: *Job, e: *Entry) res[Bytes, str] {
    if (sel e.body.none) { ret res[Bytes, str].err{NO_FORM}; }
    val s: *object.Section = object.section_at(j.o, e.body.some.section);
    if (sel s.contents.zero) { ret res[Bytes, str].err{NO_FORM}; }
    ret res[Bytes, str].ok{object.bytes(j.o, ?s.contents)};
}

# the locals and instructions of the function the entry `e` defines, its body entered at its type `type`
fun body(j: *Job, e: *Entry, type: u64) err[str] {
    val got: res[Bytes, str] = body_bytes(j, e);
    if (sel got.err) { ret err[str].err{got.err}; }
    val b:       Bytes    = got.ok;
    val entered: err[str] = wasm_stream.enter(j.ctx.stream, type::u32);
    if (sel entered.err) { ret entered; }
    val runs: res[wasm_leb.Read, field.Refusal] = wasm_leb.unsigned(b.data, b.len, 0, 32, field.NO_OPERAND);
    if (sel runs.err) { ret err[str].err{runs.err.message}; }
    var at: usize    = runs.ok.len;
    var e2: err[str] = err[str].ok{};
    var r:  u64      = 0;
    for (r < runs.ok.value && !bad(e2)) {
        val n: res[wasm_leb.Read, field.Refusal] = wasm_leb.unsigned(b.data, b.len, at, 32, field.NO_OPERAND);
        if (sel n.err) { ret err[str].err{n.err.message}; }
        at = at + n.ok.len;
        val code: res[Local, field.Refusal] = local_type(b, at);
        if (sel code.err) { ret err[str].err{code.err.message}; }
        at = at + code.ok.len;
        e2 = put(j, " (local");
        var i: u64 = 0;
        for (i < n.ok.value && !bad(e2)) {
            e2 = kept(e2, put(j, " "));
            e2 = kept(e2, value_type(j, code.ok.code));
            val defined: res[u32, str] = wasm_stream.define(j.ctx.stream, wasm_kind.LOCALS, wasm_valtype.stream_code(code.ok.code), View{data: nil, len: 0});
            if (sel defined.err) { ret err[str].err{defined.err}; }
            i = i + 1;
        }
        e2 = kept(e2, put(j, ")"));
        r  = r + 1;
    }
    if (bad(e2)) { ret e2; }
    ret instructions(j, b.data, b.len, at, "    ");
}

fun define(j: *Job, space: u16, code: u32) err[str] {
    val got: res[u32, str] = wasm_stream.define(j.ctx.stream, space, code, View{data: nil, len: 0});
    if (sel got.err) { ret err[str].err{NO_SPACE}; }
    ret err[str].ok{};
}

# the address type code of limits `l`
fun address(l: *fact.Limits) u32 {
    if (l.wide) { ret wasm_stream.I64; }
    ret wasm_stream.I32;
}

# the type index of the function the entry `e` is
fun function_type(j: *Job, e: *Entry) res[u64, str] {
    if (sel e.signature.none) { ret res[u64, str].err{NO_FORM}; }
    ret res[u64, str].ok{index_of(j, e.signature.some)};
}

# the stream code of what the entry `id` holds in its space: a function's or a tag's type index, a table's or a
# memory's address type, a global's value type
fun code_of(j: *Job, id: Id[Entry]) res[u32, str] {
    val e: *Entry = entry_at(j, id);
    if (e.space == ?space.FUNCTIONS) {
        val t: res[u64, str] = function_type(j, e);
        if (sel t.err) { ret res[u32, str].err{t.err}; }
        ret res[u32, str].ok{t.ok::u32};
    }
    if (e.space == ?space.TABLES) {
        val t: res[fact.TableType, Fail] = fact.table_type_of(j.o, j.ix, id);
        if (sel t.err) { ret res[u32, str].err{refused(t.err)}; }
        ret res[u32, str].ok{address(?t.ok.limits)};
    }
    if (e.space == ?space.MEMORIES) {
        val l: res[fact.Limits, Fail] = fact.memory_type_of(j.o, j.ix, id);
        if (sel l.err) { ret res[u32, str].err{refused(l.err)}; }
        ret res[u32, str].ok{address(?l.ok)};
    }
    if (e.space == ?space.GLOBALS) {
        val g: res[fact.GlobalType, Fail] = fact.global_type_of(j.o, j.ix, id);
        if (sel g.err) { ret res[u32, str].err{refused(g.err)}; }
        ret res[u32, str].ok{wasm_valtype.stream_code(wasm_valtype.code_of(?g.ok.value))};
    }
    val t: res[Id[Entry], Fail] = fact.tag_type_of(j.o, j.ix, id);
    if (sel t.err) { ret res[u32, str].err{refused(t.err)}; }
    ret res[u32, str].ok{index_of(j, t.ok)::u32};
}

# the stream space of the index space `sp`
fun stream_space(sp: *Space) u16 {
    if (sp == ?space.FUNCTIONS) { ret wasm_kind.FUNCS; }
    if (sp == ?space.TABLES)    { ret wasm_kind.TABLES; }
    if (sp == ?space.MEMORIES)  { ret wasm_kind.MEMORIES; }
    if (sp == ?space.GLOBALS)   { ret wasm_kind.GLOBALS; }
    ret wasm_kind.TAGS;
}

# the entries of `list` defined in the stream's space of `sp`, imports first as a module numbers them
fun defined_all(j: *Job, list: *Table[Id[Entry]], sp: *Space) err[str] {
    var i: usize = 0;
    for (i < table.count[Id[Entry]](list)) {
        val code: res[u32, str] = code_of(j, @table.at[Id[Entry]](list, table.nth[Id[Entry]](i)));
        if (sel code.err) { ret err[str].err{code.err}; }
        val e: err[str] = define(j, stream_space(sp), code.ok);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    ret err[str].ok{};
}

# how many facts of `key` the object states
fun facts_of(j: *Job, key: u32) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < table.count[Fact](?j.o.facts)) {
        val f: *Fact = table.at[Fact](?j.o.facts, table.nth[Fact](i));
        if (f.key == key && f.format == ?format.WASM) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# how many data segments the object holds
fun segment_count(j: *Job) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < table.count[Entry](?j.o.entries)) {
        if (entry_at(j, table.nth[Entry](i)).space == ?space.SEGMENTS) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the module's index spaces and types defined in the stream, so its instructions decode as the module's
fun spaces(j: *Job) err[str] {
    wasm_stream.HOOKS.begin(j.ctx.stream);
    var params:  vector.Vector[u32] = vector.init[u32](j.out.a);
    var results: vector.Vector[u32] = vector.init[u32](j.out.a);
    fin {
        vector.dnit[u32](?params);
        vector.dnit[u32](?results);
    }
    var i: usize = 0;
    for (i < table.count[Id[Entry]](?j.ix.types)) {
        val got: res[fact.Signature, Fail] = fact.signature_of(j.o, j.ix, @table.at[Id[Entry]](?j.ix.types, table.nth[Id[Entry]](i)));
        if (sel got.err) { ret failed(got.err); }
        var sig: fact.Signature = got.ok;
        vector.truncate[u32](?params, 0);
        vector.truncate[u32](?results, 0);
        var k: usize = 0;
        for (k < table.count[fact.Value](?sig.params)) {
            vector.push[u32](?params, wasm_valtype.stream_code(wasm_valtype.code_of(table.at[fact.Value](?sig.params, table.nth[fact.Value](k)))));
            k = k + 1;
        }
        k = 0;
        for (k < table.count[fact.Value](?sig.results)) {
            vector.push[u32](?results, wasm_valtype.stream_code(wasm_valtype.code_of(table.at[fact.Value](?sig.results, table.nth[fact.Value](k)))));
            k = k + 1;
        }
        val gone:  err[Fail]     = fact.release_signature(?sig);
        val added: res[u32, str] = wasm_stream.add_type(j.ctx.stream, params.data, params.len::u32, results.data, results.len::u32, View{data: nil, len: 0});
        if (sel added.err) { ret err[str].err{added.err}; }
        i = i + 1;
    }
    var e: err[str] = defined_all(j, ?j.ix.functions, ?space.FUNCTIONS);
    e = kept(e, defined_all(j, ?j.ix.tables, ?space.TABLES));
    e = kept(e, defined_all(j, ?j.ix.memories, ?space.MEMORIES));
    e = kept(e, defined_all(j, ?j.ix.globals, ?space.GLOBALS));
    e = kept(e, defined_all(j, ?j.ix.tags, ?space.TAGS));
    var n: usize = segment_count(j);
    i = 0;
    for (i < n && !bad(e)) {
        e = define(j, wasm_kind.DATAS, 0);
        i = i + 1;
    }
    n = facts_of(j, fact.ELEMENT);
    i = 0;
    for (i < n && !bad(e)) {
        e = define(j, wasm_kind.ELEMS, 0);
        i = i + 1;
    }
    ret e;
}

val KIND_WORDS: [5]str = [5]str{"func", "table", "memory", "global", "tag"};

# the word of the kind of the space `sp`
fun kind_word(sp: *Space) res[str, str] {
    val k: opt[u8] = fact.kind_of_space(sp);
    if (sel k.none)         { ret res[str, str].err{NO_FORM}; }
    if (k.some::usize >= 5) { ret res[str, str].err{NO_FORM}; }
    ret res[str, str].ok{KIND_WORDS[k.some]};
}

fun import(j: *Job, id: Id[Entry]) err[str] {
    val en: *Entry = entry_at(j, id);
    if (sel en.import.none) { ret err[str].err{NO_FORM}; }
    val imp:  *object.Import = ?en.import.some;
    val word: res[str, str]  = kind_word(en.space);
    if (sel word.err) { ret err[str].err{word.err}; }
    val module: View     = object.name_of(j.o, imp.module);
    val field_: View     = object.name_of(j.o, imp.field);
    var e:      err[str] = put(j, "\n  (import ");
    e = kept(e, string(j, module.data, module.len));
    e = kept(e, put(j, " "));
    e = kept(e, string(j, field_.data, field_.len));
    e = kept(e, put(j, " ("));
    e = kept(e, put(j, word.ok));
    if (bad(e)) { ret e; }
    if (en.space == ?space.FUNCTIONS) {
        val t: res[u64, str] = function_type(j, en);
        if (sel t.err) { ret err[str].err{t.err}; }
        e = type_use(j, t.ok);
    }
    or (en.space == ?space.TABLES) {
        val t: res[fact.TableType, Fail] = fact.table_type_of(j.o, j.ix, id);
        if (sel t.err) { ret failed(t.err); }
        var tt: fact.TableType = t.ok;
        e = table_type(j, ?tt);
    }
    or (en.space == ?space.MEMORIES) {
        val l: res[fact.Limits, Fail] = fact.memory_type_of(j.o, j.ix, id);
        if (sel l.err) { ret failed(l.err); }
        var ll: fact.Limits = l.ok;
        e = memory_type(j, ?ll);
    }
    or (en.space == ?space.GLOBALS) {
        val g: res[fact.GlobalType, Fail] = fact.global_type_of(j.o, j.ix, id);
        if (sel g.err) { ret failed(g.err); }
        var gg: fact.GlobalType = g.ok;
        e = put(j, " ");
        e = kept(e, global_type(j, ?gg));
    }
    or {
        val t: res[Id[Entry], Fail] = fact.tag_type_of(j.o, j.ix, id);
        if (sel t.err) { ret failed(t.err); }
        e = type_use(j, index_of(j, t.ok));
    }
    ret kept(e, put(j, "))"));
}

fun element(j: *Job, el: *fact.Element) err[str] {
    var e: err[str] = put(j, "\n  (elem");
    if (sel el.mode.declarative) { e = kept(e, put(j, " declare")); }
    or (sel el.mode.active) {
        var tab: u64 = 0;
        if (sel el.mode.active.table.some) { tab = index_of(j, el.mode.active.table.some); }
        e = kept(e, put(j, " (table "));
        e = kept(e, number(j, tab));
        e = kept(e, put(j, ") (offset"));
        e = kept(e, expression(j, el.mode.active.offset));
        e = kept(e, put(j, ")"));
    }
    if (sel el.items.functions) {
        e = kept(e, put(j, " func"));
        var i: usize = 0;
        for (i < table.count[Id[Entry]](?el.items.functions)) {
            e = kept(e, put(j, " "));
            e = kept(e, number(j, index_of(j, @table.at[Id[Entry]](?el.items.functions, table.nth[Id[Entry]](i)))));
            i = i + 1;
        }
    }
    or (sel el.items.expressions) {
        e = kept(e, put(j, " "));
        e = kept(e, value_type(j, wasm_valtype.reference_code(?el.type)));
        var i: usize = 0;
        for (i < table.count[View](?el.items.expressions)) {
            e = kept(e, put(j, " (item"));
            e = kept(e, expression(j, @table.at[View](?el.items.expressions, table.nth[View](i))));
            e = kept(e, put(j, ")"));
            i = i + 1;
        }
    }
    ret kept(e, put(j, ")"));
}

fun segment(j: *Job, id: Id[Entry]) err[str] {
    val head: res[opt[fact.SegmentHead], Fail] = fact.segment_head_of(j.o, j.ix, id);
    if (sel head.err)     { ret failed(head.err); }
    if (sel head.ok.none) { ret err[str].err{NO_FORM}; }
    val en: *Entry = entry_at(j, id);
    if (sel en.body.none) { ret err[str].err{NO_FORM}; }
    val s: *object.Section  = object.section_at(j.o, en.body.some.section);
    val h: fact.SegmentHead = head.ok.some;
    var e: err[str]         = put(j, "\n  (data");
    if (sel h.active) {
        var mem: u64 = 0;
        if (sel h.active.memory.some) { mem = index_of(j, h.active.memory.some); }
        e = kept(e, put(j, " (memory "));
        e = kept(e, number(j, mem));
        e = kept(e, put(j, ") (offset"));
        e = kept(e, expression(j, h.active.offset));
        e = kept(e, put(j, ")"));
    }
    e = kept(e, put(j, " "));
    if (sel s.contents.zero) { e = kept(e, string(j, nil, s.contents.zero::usize)); }
    or {
        val b: Bytes = object.bytes(j.o, ?s.contents);
        e = kept(e, string(j, b.data, b.len));
    }
    ret kept(e, put(j, ")"));
}

# the text of the module `o` states onto `out`, mink's neutral object of it, its instructions decoded under `ctx`, whose
# stream it begins and fills
pub fun module(o: *Object, ctx: *state.Context, out: *vector.Vector[u8]) err[str] {
    val ix: res[fact.Index, Fail] = fact.indexed(o);
    if (sel ix.err) { ret failed(ix.err); }
    var index: fact.Index   = ix.ok;
    var j:     Job          = Job{o: o, ix: ?index, codec: ?wasm_codec.CODEC, ctx: ctx, out: out, modes: mode.initial(?mode.NO_MODES), store: vector.init[operand.Value](out.a), alts: vector.init[requirement.Alternative](out.a)};
    val done:  err[str]     = written(?j);
    val freed: err[A.Error] = vector.dnit[operand.Value](?j.store);
    val gone:  err[A.Error] = vector.dnit[requirement.Alternative](?j.alts);
    val left:  err[Fail]    = fact.release_index(?index);
    ret done;
}

# each entry of `list` the object defines, written by `each`
fun definitions(j: *Job, list: *Table[Id[Entry]], each: fun(*Job, Id[Entry]) err[str]) err[str] {
    var e: err[str] = err[str].ok{};
    var i: usize    = 0;
    for (i < table.count[Id[Entry]](list) && !bad(e)) {
        val id: Id[Entry] = @table.at[Id[Entry]](list, table.nth[Id[Entry]](i));
        val en: *Entry    = entry_at(j, id);
        if (sel en.import.none) { e = each(j, id); }
        i = i + 1;
    }
    ret e;
}

fun function(j: *Job, id: Id[Entry]) err[str] {
    val en: *Entry        = entry_at(j, id);
    val t:  res[u64, str] = function_type(j, en);
    if (sel t.err) { ret err[str].err{t.err}; }
    var e: err[str] = put(j, "\n  (func");
    e = kept(e, type_use(j, t.ok));
    e = kept(e, body(j, en, t.ok));
    ret kept(e, put(j, ")"));
}

fun table_def(j: *Job, id: Id[Entry]) err[str] {
    val t: res[fact.TableType, Fail] = fact.table_type_of(j.o, j.ix, id);
    if (sel t.err) { ret failed(t.err); }
    var tt: fact.TableType = t.ok;
    var e:  err[str]       = put(j, "\n  (table");
    e = kept(e, table_type(j, ?tt));
    if (sel tt.init.some) { e = kept(e, expression(j, tt.init.some)); }
    ret kept(e, put(j, ")"));
}

fun memory_def(j: *Job, id: Id[Entry]) err[str] {
    val l: res[fact.Limits, Fail] = fact.memory_type_of(j.o, j.ix, id);
    if (sel l.err) { ret failed(l.err); }
    var ll: fact.Limits = l.ok;
    var e:  err[str]    = put(j, "\n  (memory");
    e = kept(e, memory_type(j, ?ll));
    ret kept(e, put(j, ")"));
}

fun tag_def(j: *Job, id: Id[Entry]) err[str] {
    val t: res[Id[Entry], Fail] = fact.tag_type_of(j.o, j.ix, id);
    if (sel t.err) { ret failed(t.err); }
    var e: err[str] = put(j, "\n  (tag");
    e = kept(e, type_use(j, index_of(j, t.ok)));
    ret kept(e, put(j, ")"));
}

fun global_def(j: *Job, id: Id[Entry]) err[str] {
    val g: res[fact.GlobalType, Fail] = fact.global_type_of(j.o, j.ix, id);
    if (sel g.err) { ret failed(g.err); }
    var gg: fact.GlobalType = g.ok;
    if (sel gg.init.none) { ret err[str].err{NO_FORM}; }
    var e: err[str] = put(j, "\n  (global ");
    e = kept(e, global_type(j, ?gg));
    e = kept(e, expression(j, gg.init.some));
    ret kept(e, put(j, ")"));
}

fun exports(j: *Job) err[str] {
    val got: res[opt[Table[fact.Export]], Fail] = fact.exports_of(j.o, j.ix);
    if (sel got.err)     { ret failed(got.err); }
    if (sel got.ok.none) { ret err[str].ok{}; }
    var t: Table[fact.Export] = got.ok.some;
    var e: err[str]           = err[str].ok{};
    var i: usize              = 0;
    for (i < table.count[fact.Export](?t) && !bad(e)) {
        val x:    *fact.Export  = table.at[fact.Export](?t, table.nth[fact.Export](i));
        val word: res[str, str] = kind_word(entry_at(j, x.entry).space);
        if (sel word.err) { e = err[str].err{word.err}; }
        or {
            e = put(j, "\n  (export ");
            e = kept(e, string(j, x.name.data, x.name.len));
            e = kept(e, put(j, " ("));
            e = kept(e, put(j, word.ok));
            e = kept(e, put(j, " "));
            e = kept(e, number(j, index_of(j, x.entry)));
            e = kept(e, put(j, "))"));
        }
        i = i + 1;
    }
    val gone: err[Fail] = table.release[fact.Export](?t);
    ret e;
}

fun elements(j: *Job) err[str] {
    var e: err[str] = err[str].ok{};
    var i: usize    = 0;
    for (i < table.count[Fact](?j.o.facts) && !bad(e)) {
        val f: *Fact = table.at[Fact](?j.o.facts, table.nth[Fact](i));
        i = i + 1;
        if (f.format != ?format.WASM || f.key != fact.ELEMENT) { cnt; }
        val got: res[fact.Element, Fail] = fact.element_of(j.o, j.ix, f);
        if (sel got.err) { ret failed(got.err); }
        var el: fact.Element = got.ok;
        e = element(j, ?el);
        val gone: err[Fail] = fact.release_element(?el);
    }
    ret e;
}

fun written(j: *Job) err[str] {
    var e: err[str] = spaces(j);
    if (bad(e)) { ret e; }
    e = put(j, "(module");
    var i: usize = 0;
    for (i < table.count[Id[Entry]](?j.ix.types) && !bad(e)) {
        val got: res[fact.Signature, Fail] = fact.signature_of(j.o, j.ix, @table.at[Id[Entry]](?j.ix.types, table.nth[Id[Entry]](i)));
        if (sel got.err) { ret failed(got.err); }
        var sig: fact.Signature = got.ok;
        e = kept(e, put(j, "\n  (type (func"));
        e = kept(e, value_types(j, "param", ?sig.params));
        e = kept(e, value_types(j, "result", ?sig.results));
        e = kept(e, put(j, "))"));
        val gone: err[Fail] = fact.release_signature(?sig);
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Entry](?j.o.entries) && !bad(e)) {
        val id: Id[Entry] = table.nth[Entry](i);
        val en: *Entry    = entry_at(j, id);
        if (sel en.import.some) { e = import(j, id); }
        i = i + 1;
    }
    if (!bad(e)) { e = definitions(j, ?j.ix.functions, function); }
    if (!bad(e)) { e = definitions(j, ?j.ix.tables, table_def); }
    if (!bad(e)) { e = definitions(j, ?j.ix.memories, memory_def); }
    if (!bad(e)) { e = definitions(j, ?j.ix.tags, tag_def); }
    if (!bad(e)) { e = definitions(j, ?j.ix.globals, global_def); }
    if (!bad(e)) { e = exports(j); }
    if (!bad(e)) {
        val start: res[opt[Id[Entry]], Fail] = fact.start_of(j.o, j.ix);
        if (sel start.err) { ret failed(start.err); }
        if (sel start.ok.some) {
            e = put(j, "\n  (start ");
            e = kept(e, number(j, index_of(j, start.ok.some)));
            e = kept(e, put(j, ")"));
        }
    }
    if (!bad(e)) { e = elements(j); }
    i = 0;
    for (i < table.count[Entry](?j.o.entries) && !bad(e)) {
        val id: Id[Entry] = table.nth[Entry](i);
        if (entry_at(j, id).space == ?space.SEGMENTS) { e = segment(j, id); }
        i = i + 1;
    }
    if (bad(e)) { ret e; }
    ret put(j, ")\n");
}
