# a module of mink's wasm container printed as its text
#
# every field is written in the form the module reader (`masc.isa.wasm.module`) reads back to the same entries: each
# index by its number, each function's type by `(type x)`, its locals and its instructions flat, one per line, each by
# the set's syntax under the stream the module's index spaces fill, and each segment in its full form, so its flags
# are the ones the reader's container chooses for it. a string is written by its printable bytes and `\hh` escapes. an
# instruction or a field the set cannot print is refused.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use mink.base.store.Bytes;
use mink.base.table;
use mink_model:  mink.format.wasm.model;
use mink_tables: mink.format.wasm.tables;

use masc.codec.walk;
use masc.core.dispatch;
use masc.core.field;
use masc.core.inst;
use masc.core.mode;
use masc.core.operand;
use masc.core.requirement;
use masc.core.state;
use core_syntax:  masc.core.syntax;
use syntax_print: masc.syntax.print;

use wasm_container: masc.isa.wasm.container;
use wasm_kind:      masc.isa.wasm.kind;
use wasm_leb:       masc.isa.wasm.leb;
use wasm_stream:    masc.isa.wasm.stream;
use wasm_syntax:    masc.isa.wasm.syntax;

use masc.isa.wasm.gen_row;
use masc.isa.wasm.gen_row_index;

#[testing]
use masc.core.diagnostic;
#[testing]
use masc.core.extension;
#[testing]
use masc.core.register;
#[testing]
use wasm_codec:     masc.isa.wasm.codec;
#[testing]
use wasm_extension: masc.isa.wasm.extension;
#[testing]
use masc.isa.wasm.gen_extension;
#[testing]
use wasm_module: masc.isa.wasm.module;
#[testing]
use mink.base.fail.Fail;
#[testing]
use mink.bytes.sink;
#[testing]
use mink.bytes.sink.Sink;
#[testing]
use mink_write: mink.format.wasm.write;
#[testing]
use std.allocator.testing;
#[testing]
use std.print;

pub val MEMORY:   str = "out of memory";
pub val NO_SPACE: str = "the stream refused a module's index space";
pub val UNENDED:  str = "an expression or a body runs past its bytes with no end";
pub val NO_FORM:  str = "a module entry the text format has no form of";

# what a print writes with: the module, its codec and context, the text so far, and the stores each instruction is
# decoded into, grown to the operands and the alternatives the largest holds
rec Job {
    m:     *mink_model.Module;
    codec: *dispatch.Codec;
    ctx:   *state.Context;
    out:   *vector.Vector[u8];
    modes: mode.State;
    store: vector.Vector[operand.Value];
    alts:  vector.Vector[requirement.Alternative];
}

fun put(j: *Job, s: str) err[str] {
    var i: usize = 0;
    for (s[i] != 0) {
        val pushed: res[usize, A.Error] = vector.push[u8](j.out, s[i]);
        if (sel pushed.err) { ret err[str].err{MEMORY}; }
        i = i + 1;
    }
    ret err[str].ok{};
}

fun number(j: *Job, v: u64) err[str] {
    var digits: [20]u8;
    var n:      usize = 0;
    var x:      u64   = v;
    for {
        digits[n] = ('0'::u64 + x % 10)::u8;
        n         = n + 1;
        x         = x / 10;
        if (x == 0) { brk; }
    }
    for (n > 0) {
        n = n - 1;
        val pushed: res[usize, A.Error] = vector.push[u8](j.out, digits[n]);
        if (sel pushed.err) { ret err[str].err{MEMORY}; }
    }
    ret err[str].ok{};
}

val HEX: str = "0123456789abcdef";

# the bytes of `b` as a string, its printable bytes as they are and every other as `\hh`
fun string(j: *Job, b: Bytes) err[str] {
    var e: err[str] = put(j, "\"");
    var i: usize    = 0;
    for (i < b.len && !bad(e)) {
        val c: u8 = b.data[i];
        if (c >= 0x20 && c < 0x7F && c != '"' && c != '\\') {
            val pushed: res[usize, A.Error] = vector.push[u8](j.out, c);
            if (sel pushed.err) { ret err[str].err{MEMORY}; }
        }
        or {
            val esc: [4]u8 = [4]u8{'\\', HEX[c >> 4], HEX[c & 0xF], 0};
            e = put(j, ?esc[0]);
        }
        i = i + 1;
    }
    if (bad(e)) { ret e; }
    ret put(j, "\"");
}

# the value type of code `code`, by the syntax's spelling, a typed reference given none
fun value_type(j: *Job, code: i64) err[str] {
    var i: u32 = 0;
    for (i < gen_row.TYPE_NAMES_COUNT) {
        if (gen_row.TYPE_NAMES[i].code::i64 == code) { ret put(j, gen_row.TYPE_NAMES[i].name); }
        i = i + 1;
    }
    ret err[str].err{NO_FORM};
}

fun value_types(j: *Job, word: str, r: mink_model.Run) err[str] {
    if (r.count == 0) { ret err[str].ok{}; }
    var e: err[str] = put(j, " (");
    e = kept(e, put(j, word));
    var i: usize = 0;
    for (i < r.count && !bad(e)) {
        e = kept(e, put(j, " "));
        e = kept(e, value_type(j, wasm_container.code_of(table.at[mink_model.ValType](?j.m.valtypes, table.nth[mink_model.ValType](r.first + i)))));
        i = i + 1;
    }
    ret kept(e, put(j, ")"));
}

fun bad(e: err[str]) bool {
    ret sel e.err;
}

fun kept(first: err[str], next: err[str]) err[str] {
    if (sel first.err) { ret first; }
    ret next;
}

fun limits(j: *Job, l: *mink_model.Limits) err[str] {
    var e: err[str] = err[str].ok{};
    if ((l.flags & mink_tables.WASM_LIMITS_FLAG_HAS_PAGE_SIZE.value::u8) != 0) { ret err[str].err{NO_FORM}; }
    if ((l.flags & mink_tables.WASM_LIMITS_FLAG_IS_64.value::u8) != 0)         { e = put(j, " i64"); }
    e = kept(e, put(j, " "));
    e = kept(e, number(j, l.min.value));
    if ((l.flags & mink_tables.WASM_LIMITS_FLAG_HAS_MAX.value::u8) != 0) {
        e = kept(e, put(j, " "));
        e = kept(e, number(j, l.max.value));
    }
    ret e;
}

fun memory_type(j: *Job, l: *mink_model.Limits) err[str] {
    var e: err[str] = limits(j, l);
    if ((l.flags & mink_tables.WASM_LIMITS_FLAG_IS_SHARED.value::u8) != 0) { e = kept(e, put(j, " shared")); }
    ret e;
}

fun table_type(j: *Job, t: *mink_model.TableType) err[str] {
    var e: err[str] = limits(j, ?t.limits);
    e = kept(e, put(j, " "));
    ret kept(e, value_type(j, wasm_container.ref_code(?t.elem)));
}

fun global_type(j: *Job, g: *mink_model.GlobalType) err[str] {
    if (g.mutable == 0) { ret value_type(j, wasm_container.code_of(?g.valtype)); }
    var e: err[str] = put(j, "(mut ");
    e = kept(e, value_type(j, wasm_container.code_of(?g.valtype)));
    ret kept(e, put(j, ")"));
}

fun type_use(j: *Job, x: u64) err[str] {
    var e: err[str] = put(j, " (type ");
    e = kept(e, number(j, x));
    ret kept(e, put(j, ")"));
}

# the instructions of the `len` bytes at `data` from `at`, one per line after `indent`, up to the `end` that closes
# them, which is not written
fun instructions(j: *Job, data: *u8, len: usize, at: usize, indent: str) err[str] {
    var i: usize = at;
    for (i < len) {
        val got: res[walk.Decoded, field.Refusal] = walk.decode_grown(j.codec, j.ctx, data, len, i, ?j.store, ?j.alts);
        if (sel got.err) { ret err[str].err{got.err.message}; }
        var ins:  inst.Inst          = got.ok.inst;
        val seen: err[field.Refusal] = wasm_stream.HOOKS.observe(j.ctx.stream, ?ins);
        if (sel seen.err) { ret err[str].err{seen.err.message}; }
        i = i + got.ok.len;
        if (ins.row == ?gen_row.ROWS[gen_row_index.END] && wasm_stream.count(j.ctx.stream, wasm_kind.LABELS) == 0) { ret err[str].ok{}; }
        var e: err[str] = put(j, "\n");
        e = kept(e, put(j, indent));
        if (bad(e)) { ret e; }
        var w:     core_syntax.Writer = core_syntax.Writer{out: j.out, codec: j.codec, ctx: j.ctx, syntax: ?wasm_syntax.SYNTAX, modes: ?j.modes, symbols: nil, context: nil, row: ins.row};
        val wrote: err[field.Refusal] = syntax_print.instruction(?w, ?ins);
        if (sel wrote.err) { ret err[str].err{wrote.err.message}; }
    }
    ret err[str].err{UNENDED};
}

# a constant expression, its instructions in its own block
fun expression(j: *Job, e: *mink_model.Expr) err[str] {
    val b:       Bytes    = mink_model.bytes(j.m, ?e.bytes);
    val entered: err[str] = wasm_stream.enter_expression(j.ctx.stream);
    if (sel entered.err) { ret entered; }
    ret instructions(j, b.data, b.len, 0, "    ");
}

# function `k`'s locals and instructions, its body entered at its type `type`
fun body(j: *Job, k: usize, type: u64) err[str] {
    val f:       *mink_model.Function = table.at[mink_model.Function](?j.m.code, table.nth[mink_model.Function](k));
    val b:       Bytes                = mink_model.bytes(j.m, ?f.body);
    val entered: err[str]             = wasm_stream.enter(j.ctx.stream, type::u32);
    if (sel entered.err) { ret entered; }
    val runs: res[wasm_leb.Read, field.Refusal] = wasm_leb.unsigned(b.data, b.len, 0, 32, field.NO_OPERAND);
    if (sel runs.err) { ret err[str].err{runs.err.message}; }
    var at: usize    = runs.ok.len;
    var e:  err[str] = err[str].ok{};
    var r:  u64      = 0;
    for (r < runs.ok.value && !bad(e)) {
        val n: res[wasm_leb.Read, field.Refusal] = wasm_leb.unsigned(b.data, b.len, at, 32, field.NO_OPERAND);
        if (sel n.err)              { ret err[str].err{n.err.message}; }
        if (at + n.ok.len >= b.len) { ret err[str].err{UNENDED}; }
        val code: u8 = b.data[at + n.ok.len];
        at = at + n.ok.len + 1;
        e  = put(j, " (local");
        var i: u64 = 0;
        for (i < n.ok.value && !bad(e)) {
            e = kept(e, put(j, " "));
            e = kept(e, value_type(j, code::i64));
            val defined: res[u32, str] = wasm_stream.define(j.ctx.stream, wasm_kind.LOCALS, code::u32, View{data: nil, len: 0});
            if (sel defined.err) { ret err[str].err{defined.err}; }
            i = i + 1;
        }
        e = kept(e, put(j, ")"));
        r = r + 1;
    }
    if (bad(e)) { ret e; }
    ret instructions(j, b.data, b.len, at, "    ");
}

fun define(j: *Job, space: u16, code: u32) err[str] {
    val got: res[u32, str] = wasm_stream.define(j.ctx.stream, space, code, View{data: nil, len: 0});
    if (sel got.err) { ret err[str].err{NO_SPACE}; }
    ret err[str].ok{};
}

# the address type code of limits `l`
fun address(l: *mink_model.Limits) u32 {
    if ((l.flags & mink_tables.WASM_LIMITS_FLAG_IS_64.value::u8) != 0) { ret wasm_stream.I64; }
    ret wasm_stream.I32;
}

# the module's index spaces and types defined in the stream, so its instructions decode as the module's
fun spaces(j: *Job) err[str] {
    wasm_stream.HOOKS.begin(j.ctx.stream);
    var params:  vector.Vector[u32] = vector.init[u32](j.m.a);
    var results: vector.Vector[u32] = vector.init[u32](j.m.a);
    fin {
        vector.dnit[u32](?params);
        vector.dnit[u32](?results);
    }
    var i: usize = 0;
    for (i < table.count[mink_model.FuncType](?j.m.types)) {
        val t: *mink_model.FuncType = table.at[mink_model.FuncType](?j.m.types, table.nth[mink_model.FuncType](i));
        params.len  = 0;
        results.len = 0;
        var k: usize = 0;
        for (k < t.params.count) {
            vector.push[u32](?params, wasm_container.code_of(table.at[mink_model.ValType](?j.m.valtypes, table.nth[mink_model.ValType](t.params.first + k))):~u64::u32);
            k = k + 1;
        }
        k = 0;
        for (k < t.results.count) {
            vector.push[u32](?results, wasm_container.code_of(table.at[mink_model.ValType](?j.m.valtypes, table.nth[mink_model.ValType](t.results.first + k))):~u64::u32);
            k = k + 1;
        }
        val added: res[u32, str] = wasm_stream.add_type(j.ctx.stream, params.data, params.len::u32, results.data, results.len::u32, View{data: nil, len: 0});
        if (sel added.err) { ret err[str].err{added.err}; }
        i = i + 1;
    }
    var e: err[str] = err[str].ok{};
    i = 0;
    for (i < table.count[mink_model.Import](?j.m.imports) && !bad(e)) {
        val imp: *mink_model.Import = table.at[mink_model.Import](?j.m.imports, table.nth[mink_model.Import](i));
        if (sel imp.desc.function) { e = define(j, wasm_kind.FUNCS, imp.desc.function.value::u32); }
        or (sel imp.desc.table)    { e = define(j, wasm_kind.TABLES, address(?imp.desc.table.limits)); }
        or (sel imp.desc.memory)   { e = define(j, wasm_kind.MEMORIES, address(?imp.desc.memory)); }
        or (sel imp.desc.global)   { e = define(j, wasm_kind.GLOBALS, wasm_container.code_of(?imp.desc.global.valtype):~u64::u32); }
        or (sel imp.desc.tag_type) { e = define(j, wasm_kind.TAGS, imp.desc.tag_type.type.value::u32); }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Leb](?j.m.functions) && !bad(e)) {
        e = define(j, wasm_kind.FUNCS, table.at[mink_model.Leb](?j.m.functions, table.nth[mink_model.Leb](i)).value::u32);
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.TableDef](?j.m.tables) && !bad(e)) {
        e = define(j, wasm_kind.TABLES, address(?table.at[mink_model.TableDef](?j.m.tables, table.nth[mink_model.TableDef](i)).type.limits));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Limits](?j.m.memories) && !bad(e)) {
        e = define(j, wasm_kind.MEMORIES, address(table.at[mink_model.Limits](?j.m.memories, table.nth[mink_model.Limits](i))));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Global](?j.m.globals) && !bad(e)) {
        e = define(j, wasm_kind.GLOBALS, wasm_container.code_of(?table.at[mink_model.Global](?j.m.globals, table.nth[mink_model.Global](i)).type.valtype):~u64::u32);
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Tag](?j.m.tags) && !bad(e)) {
        e = define(j, wasm_kind.TAGS, table.at[mink_model.Tag](?j.m.tags, table.nth[mink_model.Tag](i)).type.value::u32);
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Segment](?j.m.data) && !bad(e)) {
        e = define(j, wasm_kind.DATAS, 0);
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Element](?j.m.elements) && !bad(e)) {
        e = define(j, wasm_kind.ELEMS, 0);
        i = i + 1;
    }
    ret e;
}

val KIND_WORDS: [5]str = [5]str{"func", "table", "memory", "global", "tag"};

fun import(j: *Job, imp: *mink_model.Import) err[str] {
    var e: err[str] = put(j, "\n  (import ");
    e = kept(e, string(j, mink_model.name_bytes(j.m, ?imp.module)));
    e = kept(e, put(j, " "));
    e = kept(e, string(j, mink_model.name_bytes(j.m, ?imp.field)));
    if (imp.kind::usize >= 5) { ret err[str].err{NO_FORM}; }
    e = kept(e, put(j, " ("));
    e = kept(e, put(j, KIND_WORDS[imp.kind]));
    if (sel imp.desc.function) { e = kept(e, type_use(j, imp.desc.function.value)); }
    or (sel imp.desc.table)    { e = kept(e, table_type(j, ?imp.desc.table)); }
    or (sel imp.desc.memory)   { e = kept(e, memory_type(j, ?imp.desc.memory)); }
    or (sel imp.desc.global) {
        e = kept(e, put(j, " "));
        e = kept(e, global_type(j, ?imp.desc.global));
    }
    or (sel imp.desc.tag_type) { e = kept(e, type_use(j, imp.desc.tag_type.type.value)); }
    ret kept(e, put(j, "))"));
}

fun element(j: *Job, el: *mink_model.Element) err[str] {
    val f:       u64  = el.flags.value;
    val passive: bool = (f & mink_tables.WASM_ELEM_SEGMENT_IS_PASSIVE.value) != 0;
    val other:   bool = (f & mink_tables.WASM_ELEM_SEGMENT_HAS_TABLE_NUMBER.value) != 0;
    val exprs:   bool = (f & mink_tables.WASM_ELEM_SEGMENT_HAS_INIT_EXPRS.value) != 0;
    # an active segment of no table number states no kind, its flags 0 or 4, and its elements are funcref
    var kind: i64 = wasm_container.FUNCREF::i64;
    if ((f & mink_model.ELEM_DESC_MASK) != 0 && exprs) { kind = wasm_container.ref_code(?el.type); }
    or ((f & mink_model.ELEM_DESC_MASK) != 0)          { kind = el.kind::i64; }
    var e: err[str] = put(j, "\n  (elem");
    if (passive && other) { e = kept(e, put(j, " declare")); }
    if (!passive) {
        var tab: u64 = 0;
        if (other) { tab = el.table.value; }
        e = kept(e, put(j, " (table "));
        e = kept(e, number(j, tab));
        e = kept(e, put(j, ") (offset"));
        e = kept(e, expression(j, ?el.offset));
        e = kept(e, put(j, ")"));
    }
    if (sel el.items.indices) {
        if (exprs) { ret err[str].err{NO_FORM}; }
        e = kept(e, put(j, " func"));
        var i: usize = 0;
        for (i < el.items.indices.count) {
            e = kept(e, put(j, " "));
            e = kept(e, number(j, table.at[mink_model.Leb](?j.m.indices, table.nth[mink_model.Leb](el.items.indices.first + i)).value));
            i = i + 1;
        }
    }
    or (sel el.items.exprs) {
        if (!exprs) { ret err[str].err{NO_FORM}; }
        e = kept(e, put(j, " "));
        e = kept(e, value_type(j, kind));
        var i: usize = 0;
        for (i < el.items.exprs.count) {
            e = kept(e, put(j, " (item"));
            e = kept(e, expression(j, table.at[mink_model.Expr](?j.m.exprs, table.nth[mink_model.Expr](el.items.exprs.first + i))));
            e = kept(e, put(j, ")"));
            i = i + 1;
        }
    }
    ret kept(e, put(j, ")"));
}

fun segment(j: *Job, s: *mink_model.Segment) err[str] {
    val f: u64      = s.flags.value;
    var e: err[str] = put(j, "\n  (data");
    if ((f & mink_tables.WASM_DATA_SEGMENT_IS_PASSIVE.value) == 0) {
        var mem: u64 = 0;
        if ((f & mink_tables.WASM_DATA_SEGMENT_HAS_MEMINDEX.value) != 0) { mem = s.memory.value; }
        e = kept(e, put(j, " (memory "));
        e = kept(e, number(j, mem));
        e = kept(e, put(j, ") (offset"));
        e = kept(e, expression(j, ?s.offset));
        e = kept(e, put(j, ")"));
    }
    e = kept(e, put(j, " "));
    e = kept(e, string(j, mink_model.bytes(j.m, ?s.data)));
    ret kept(e, put(j, ")"));
}

# the type of the function at index `index` of the function space
fun function_type(j: *Job, index: usize) u64 {
    ret table.at[mink_model.Leb](?j.m.functions, table.nth[mink_model.Leb](index)).value;
}

# the text of module `m` onto `out`, its instructions decoded under `ctx`, whose stream it begins and fills
pub fun module(m: *mink_model.Module, codec: *dispatch.Codec, ctx: *state.Context, out: *vector.Vector[u8]) err[str] {
    var j:     Job          = Job{m: m, codec: codec, ctx: ctx, out: out, modes: mode.initial(?mode.NO_MODES), store: vector.init[operand.Value](out.a), alts: vector.init[requirement.Alternative](out.a)};
    val done:  err[str]     = written(?j);
    val freed: err[A.Error] = vector.dnit[operand.Value](?j.store);
    val gone:  err[A.Error] = vector.dnit[requirement.Alternative](?j.alts);
    ret done;
}

fun written(j: *Job) err[str] {
    val m: *mink_model.Module = j.m;
    var e: err[str]           = spaces(j);
    if (bad(e)) { ret e; }
    e = put(j, "(module");
    var i: usize = 0;
    for (i < table.count[mink_model.FuncType](?m.types) && !bad(e)) {
        val t: *mink_model.FuncType = table.at[mink_model.FuncType](?m.types, table.nth[mink_model.FuncType](i));
        e = kept(e, put(j, "\n  (type (func"));
        e = kept(e, value_types(j, "param", t.params));
        e = kept(e, value_types(j, "result", t.results));
        e = kept(e, put(j, "))"));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Import](?m.imports) && !bad(e)) {
        e = import(j, table.at[mink_model.Import](?m.imports, table.nth[mink_model.Import](i)));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Leb](?m.functions) && !bad(e)) {
        e = kept(e, put(j, "\n  (func"));
        e = kept(e, type_use(j, function_type(j, i)));
        e = kept(e, body(j, i, function_type(j, i)));
        e = kept(e, put(j, ")"));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.TableDef](?m.tables) && !bad(e)) {
        val def: *mink_model.TableDef = table.at[mink_model.TableDef](?m.tables, table.nth[mink_model.TableDef](i));
        if (sel def.init.some) { ret err[str].err{NO_FORM}; }
        e = put(j, "\n  (table");
        e = kept(e, table_type(j, ?def.type));
        e = kept(e, put(j, ")"));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Limits](?m.memories) && !bad(e)) {
        e = put(j, "\n  (memory");
        e = kept(e, memory_type(j, table.at[mink_model.Limits](?m.memories, table.nth[mink_model.Limits](i))));
        e = kept(e, put(j, ")"));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Tag](?m.tags) && !bad(e)) {
        e = put(j, "\n  (tag");
        e = kept(e, type_use(j, table.at[mink_model.Tag](?m.tags, table.nth[mink_model.Tag](i)).type.value));
        e = kept(e, put(j, ")"));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Global](?m.globals) && !bad(e)) {
        val g: *mink_model.Global = table.at[mink_model.Global](?m.globals, table.nth[mink_model.Global](i));
        e = put(j, "\n  (global ");
        e = kept(e, global_type(j, ?g.type));
        e = kept(e, expression(j, ?g.init));
        e = kept(e, put(j, ")"));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Export](?m.exports) && !bad(e)) {
        val x: *mink_model.Export = table.at[mink_model.Export](?m.exports, table.nth[mink_model.Export](i));
        if (x.kind::usize >= 5) { ret err[str].err{NO_FORM}; }
        e = put(j, "\n  (export ");
        e = kept(e, string(j, mink_model.name_bytes(m, ?x.name)));
        e = kept(e, put(j, " ("));
        e = kept(e, put(j, KIND_WORDS[x.kind]));
        e = kept(e, put(j, " "));
        e = kept(e, number(j, x.index.value));
        e = kept(e, put(j, "))"));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Section](?m.sections) && !bad(e)) {
        val s: *mink_model.Section = table.at[mink_model.Section](?m.sections, table.nth[mink_model.Section](i));
        if (sel s.body.start) {
            e = put(j, "\n  (start ");
            e = kept(e, number(j, s.body.start.value));
            e = kept(e, put(j, ")"));
        }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Element](?m.elements) && !bad(e)) {
        e = element(j, table.at[mink_model.Element](?m.elements, table.nth[mink_model.Element](i)));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[mink_model.Segment](?m.data) && !bad(e)) {
        e = segment(j, table.at[mink_model.Segment](?m.data, table.nth[mink_model.Segment](i)));
        i = i + 1;
    }
    if (bad(e)) { ret e; }
    ret put(j, ")\n");
}

#[testing]
rec T {
    t:   testing.Testing;
    s:   extension.Selection;
    v:   register.Available;
    ctx: state.Context;
}

#[testing]
fun t_make(t: *T) bool {
    testing.make(?t.t);
    val a:    *A.Allocator                            = testing.allocator_of(?t.t);
    val made: res[extension.Request, extension.Error] = extension.request(a, ?wasm_extension.CATALOG, "", diagnostic.START);
    if (sel made.err) { ret false; }
    var req: extension.Request = made.ok;
    var id:  u32               = 0;
    for (id < gen_extension.COUNT) {
        extension.request_add(?req, id::requirement.Id);
        id = id + 1;
    }
    val closed: res[extension.Selection, extension.Error] = extension.close(req);
    if (sel closed.err) { ret false; }
    t.s = closed.ok;
    val opened: res[state.Context, state.Opened] = state.open(a, nil, ?t.s, ?wasm_extension.AXES, state.initial(?wasm_extension.AXES), ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx = opened.ok;
    val stream: res[ptr, A.Error] = wasm_stream.HOOKS.make(a);
    if (sel stream.err) { ret false; }
    t.ctx.stream = stream.ok;
    ret true;
}

# the module `text` read and written by mink onto `out`
#[testing]
fun t_written(t: *T, text: *u8, len: usize, out: *vector.Vector[u8]) bool {
    val a:   *A.Allocator               = testing.allocator_of(?t.t);
    var m:   mink_model.Module;
    val got: err[diagnostic.Diagnostic] = wasm_module.read(a, text, len, diagnostic.START, ?wasm_codec.CODEC, ?t.ctx, ?m);
    if (sel got.err) {
        print.eprintlnf("{} at {}:{}", got.err.message, got.err.span.start.line, got.err.span.start.column);
        val dropped: err[Fail] = mink_model.release(?m);
        ret false;
    }
    val wrote:   res[Sink, Fail] = mink_write.write(a, ?m);
    val dropped: err[Fail]       = mink_model.release(?m);
    if (sel wrote.err) { ret false; }
    var sunk: Sink  = wrote.ok;
    var i:    usize = 0;
    for (i < sink.len(?sunk)) {
        vector.push[u8](out, sink.data(?sunk)[i]);
        i = i + 1;
    }
    val freed: err[Fail] = sink.release(?sunk);
    ret true;
}

#[testing]
val T_MODULE: str = "(module\n  (import \"env\" \"f\" (func $imp (param i32)))\n  (import \"env\" \"t\" (table 1 funcref))\n  (table $u funcref (elem $main $imp))\n  (memory $m i64 1 2)\n  (memory (data \"hi\\00\"))\n  (tag $e (param i32))\n  (global $g (mut i64) (i64.const -1))\n  (global funcref (ref.func $main))\n  (func $main (export \"main\") (param $k i32) (result i32) (local f32 f32 i64)\n    (block $b (result i32)\n      (br_table $b $b (local.get $k) (local.get $k)))\n    (drop)\n    (try_table (catch $e 0) (throw $e (i32.const 1)))\n    (i64.store $m offset=8 (i64.const 0) (i64.const 1))\n    (data.drop $d)\n    (i32.const 0))\n  (func $s)\n  (start $s)\n  (elem (table 0) (i32.const 0) func $main)\n  (elem funcref (ref.func $imp) (ref.null func))\n  (elem declare func $main)\n  (data $d \"x\")\n  (data (memory $m) (offset (i64.const 8)) \"yz\"))\n";

# 0 when the module `text` prints and reads back to the same module: the bytes mink writes of it and of its printing
# are the same
#[testing]
fun t_reads_back(t: *T, source: *u8, len: usize) i32 {
    val a:     *A.Allocator      = testing.allocator_of(?t.t);
    var first: vector.Vector[u8] = vector.init[u8](a);
    if (!t_written(t, source, len, ?first)) { ret 2; }
    var m:    mink_model.Module;
    val read: err[diagnostic.Diagnostic] = wasm_module.read(a, source, len, diagnostic.START, ?wasm_codec.CODEC, ?t.ctx, ?m);
    if (sel read.err) { ret 3; }
    var text:    vector.Vector[u8] = vector.init[u8](a);
    val printed: err[str]          = module(?m, ?wasm_codec.CODEC, ?t.ctx, ?text);
    val dropped: err[Fail]         = mink_model.release(?m);
    if (sel printed.err) {
        print.eprintlnf("printing refused: {}", printed.err);
        ret 4;
    }
    var again: vector.Vector[u8] = vector.init[u8](a);
    if (!t_written(t, text.data, text.len, ?again)) {
        vector.push[u8](?text, 0);
        print.eprintln(text.data);
        ret 5;
    }
    if (first.len != again.len) { ret 6; }
    var i: usize = 0;
    for (i < first.len) {
        if (first.data[i] != again.data[i]) { ret 7; }
        i = i + 1;
    }
    vector.dnit[u8](?first);
    vector.dnit[u8](?again);
    vector.dnit[u8](?text);
    ret 0;
}

#[testing]
fun t_done(t: *T) {
    wasm_stream.HOOKS.release(testing.allocator_of(?t.t), t.ctx.stream);
    val gone: err[A.Error] = extension.release(?t.s);
}

# a module prints and reads back to the same module
test print__a_module_prints_and_reads_back_to_itself {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val got: i32 = t_reads_back(?t, T_MODULE, str_len(T_MODULE));
    t_done(?t);
    ret got;
}

# a br_table of more targets than any fixed operand store held prints and reads back, its store grown to them
test print__a_br_table_of_a_hundred_targets_prints_and_reads_back {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val a:    *A.Allocator      = testing.allocator_of(?t.t);
    var text: vector.Vector[u8] = vector.init[u8](a);
    val head: str               = "(module\n  (func\n    (block $b\n      (br_table";
    val tail: str               = " (i32.const 0)))))\n";
    var i:    usize             = 0;
    for (head[i] != 0) {
        vector.push[u8](?text, head[i]);
        i = i + 1;
    }
    var n: u32 = 0;
    for (n < 100) {
        vector.push[u8](?text, ' ');
        vector.push[u8](?text, '0');
        n = n + 1;
    }
    i = 0;
    for (tail[i] != 0) {
        vector.push[u8](?text, tail[i]);
        i = i + 1;
    }
    val got: i32 = t_reads_back(?t, text.data, text.len);
    vector.dnit[u8](?text);
    t_done(?t);
    ret got;
}
