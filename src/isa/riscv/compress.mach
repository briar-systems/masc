# the risc-v compression policy: a base instruction is written in its compressed form when the selection admits one
#
# the vendor tools do the same when the compressed extensions are on: llvm's
# compress pass and gas's rvc rewrite `addi a0, a0, 1` as `c.addi a0, 1`. the
# shapes are generated from the reviewed compressions of the dialect
# (gen_compress) and the generic walk is the core's, so the policy is the
# table and the selection: with no C or Zca no compressed row is admitted and
# the base instruction is written as it is. a symbolic operand is compressed
# only as the target of a branch or jump whose compressed row the
# relaxations grow back, as llvm-mc compresses `beq a0, zero, label` and lets
# the layout grow it when the label is out of reach.

use std.types.bool.bool;

use masc.core.compress;
use masc.core.inst;
use masc.core.relax;
use masc.core.state;

use riscv_catalog: masc.isa.riscv.catalog;

use masc.isa.riscv.gen_compress;
use masc.isa.riscv.gen_relax;

# the compressions of the vendor tools
pub val COMPRESSIONS: compress.Compressions = compress.Compressions{at: ?gen_compress.COMPRESSION_ROWS[0], len: gen_compress.COMPRESSION_COUNT};

# the compressed form of `ins` under the selection, in `out`, and whether there is one
pub fun shorter(ctx: *state.Context, ins: *inst.Inst, out: *relax.Emitted) bool {
    ret compress.compress(?riscv_catalog.CODEC, COMPRESSIONS, gen_relax.RELAXATIONS, ctx, ins, out);
}
