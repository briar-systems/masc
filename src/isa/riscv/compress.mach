# the risc-v compression policy: a base instruction is written in its compressed form when the selection admits one
#
# the vendor tools do the same when the compressed extensions are on: llvm's
# compress pass and gas's rvc rewrite `addi a0, a0, 1` as `c.addi a0, 1`. the
# shapes are generated from the reviewed compressions of the dialect
# (gen_compress) and the generic walk is the core's, so the policy is the
# table and the selection: with no C or Zca no compressed row is admitted and
# the base instruction is written as it is. a symbolic operand is never
# compressed, since its size is the relaxation's.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use std.allocator.testing;

use masc.core.compress;
use masc.core.diagnostic;
use masc.core.extension;
use masc.core.inst;
use masc.core.operand;
use masc.core.register;
use masc.core.relax;
use masc.core.row;

use riscv_catalog:   masc.isa.riscv.catalog;
use riscv_extension: masc.isa.riscv.extension;
use riscv_register:  masc.isa.riscv.register;

use masc.isa.riscv.gen_compress;

# the compressions of the vendor tools
pub val COMPRESSIONS: compress.Compressions = compress.Compressions{at: ?gen_compress.COMPRESSION_ROWS[0], len: gen_compress.COMPRESSION_COUNT};

# the compressed form of `ins` under the selection, in `out`, and whether there is one
pub fun shorter(available: *register.Available, ins: *inst.Inst, out: *relax.Emitted) bool {
    ret compress.compress(?riscv_catalog.CODEC, COMPRESSIONS, available, ins, out);
}

# a test's selection and its register view
#[testing]
rec T {
    t: testing.Testing;
    s: extension.Selection;
    v: register.Available;
}

#[testing]
fun t_make(t: *T, isa: str) bool {
    testing.make(?t.t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t.t), ?riscv_extension.CATALOG, isa, diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    val viewed: res[register.Available, register.Error] = register.select(testing.allocator_of(?t.t), ?riscv_register.FILE, ?t.s);
    if (sel viewed.err) { ret false; }
    t.v = viewed.ok;
    ret true;
}

# the first row spelled `mnemonic`
#[testing]
fun t_row(mnemonic: str) *row.Row {
    var i: u32 = 0;
    for (i < riscv_catalog.CODEC.rows.len) {
        if (str_equals(riscv_catalog.CODEC.rows.at[i].mnemonic, mnemonic)) { ret ?riscv_catalog.CODEC.rows.at[i]; }
        i = i + 1;
    }
    ret nil;
}

test shorter__a_compressible_instruction_is_compressed_only_when_the_selection_admits_it {
    var values: [3]operand.Value = [3]operand.Value{operand.Value.register{register.make(0, 10)}, operand.Value.register{register.make(0, 10)}, operand.Value.immediate{1}};
    var ins:    inst.Inst        = inst.Inst{row: t_row("addi"), values: ?values[0], count: 3};
    var out:    relax.Emitted;
    var plain:  T;
    if (!t_make(?plain, "rv64i"))      { ret 1; }
    if (shorter(?plain.v, ?ins, ?out)) { ret 2; }
    var packed: T;
    if (!t_make(?packed, "rv64ic"))              { ret 3; }
    if (!shorter(?packed.v, ?ins, ?out))         { ret 4; }
    if (!str_equals(out.row.mnemonic, "c.addi")) { ret 5; }
    # Zca alone admits it as well, and a value the short form cannot hold stays as it is
    var zca: T;
    if (!t_make(?zca, "rv64i_zca"))   { ret 6; }
    if (!shorter(?zca.v, ?ins, ?out)) { ret 7; }
    values[2] = operand.Value.immediate{100};
    if (shorter(?zca.v, ?ins, ?out)) { ret 8; }
    ret 0;
}

test shorter__a_symbolic_operand_is_never_compressed {
    var values: [3]operand.Value = [3]operand.Value{operand.Value.register{register.make(0, 10)}, operand.Value.register{register.make(0, 10)}, operand.Value.symbol{operand.Symbol{id: 1, addend: 0, fixup: operand.NO_FIXUP}}};
    var ins:    inst.Inst        = inst.Inst{row: t_row("addi"), values: ?values[0], count: 3};
    var out:    relax.Emitted;
    var packed: T;
    if (!t_make(?packed, "rv64ic"))     { ret 1; }
    if (shorter(?packed.v, ?ins, ?out)) { ret 2; }
    ret 0;
}
