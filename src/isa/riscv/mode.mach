# the risc-v assembler modes
#
# pic: whether the source is position independent code, which decides what
# `la` loads (riscv-asm-manual, "Pseudoinstructions" and ".option"). nopic
# is the start.
#
# relax: whether the linker may relax the code, so a relocation of a kind the
# psabi lets the linker relax carries R_RISCV_RELAX beside it, and that
# instruction is one the linker may resize (psabi, "Linker Relaxation").
# norelax is the start.

use masc.core.mode;

pub val NOPIC: mode.Value = mode.Value{name: "nopic", flag: "--no-pic", doc: "read the source as code that is not position independent, the default"};
pub val PIC:   mode.Value = mode.Value{name: "pic", flag: "--pic", doc: "read the source as position independent code, so la loads from the global offset table"};

pub val NORELAX: mode.Value = mode.Value{name: "norelax", flag: "--no-relax", doc: "write no relaxation markers, so the linker never resizes the code, the default"};
pub val RELAX:   mode.Value = mode.Value{name: "relax", flag: "--relax", doc: "mark each relocation the linker may relax"};

val PIC_VALUES:   [2]*mode.Value = [2]*mode.Value{?NOPIC, ?PIC};
val RELAX_VALUES: [2]*mode.Value = [2]*mode.Value{?NORELAX, ?RELAX};

pub val POSITION: mode.Mode = mode.Mode{name: "pic", values: mode.Values{at: ?PIC_VALUES[0], len: 2}, initial: ?NOPIC};
pub val RELAXING: mode.Mode = mode.Mode{name: "relax", values: mode.Values{at: ?RELAX_VALUES[0], len: 2}, initial: ?NORELAX};

val ALL: [2]*mode.Mode = [2]*mode.Mode{?POSITION, ?RELAXING};

pub val MODES: mode.Modes = mode.Modes{at: ?ALL[0], len: 2};

val RELAXED_SETTINGS: [1]mode.Setting = [1]mode.Setting{mode.Setting{mode: ?RELAXING, value: ?RELAX}};

# what holds while the source is relaxed
pub val RELAXED: mode.Settings = mode.Settings{at: ?RELAXED_SETTINGS[0], len: 1};
