# the risc-v aliases whose base values are computed from the alias's, which no source states
#
# the vector spec encodes no vmslt.vi or vmsltu.vi, and notes that each is
# vmsle{u}.vi with the immediate less one (src/unpriv/vector-common.adoc,
# "Vector Integer Compare Instructions"), and vmsltu.vi with 0, which no
# unsigned value is below, is vmsne.vv of a register with itself. each is
# read only: the printer writes the base. an immediate whose decrement leaves the base's simm5 is
# refused by the base, so the alias reads -15 to 16. the dialect topic names
# each derivation an alias row takes (gen/data/riscv/dialect.txt, `derive`).

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use masc.core.index;
use masc.core.operand;
use masc.core.row;
use masc.core.syntax;

use riscv_field: masc.isa.riscv.field;
use masc.isa.riscv.gen_register;

val V: [1]u16 = [1]u16{gen_register.V_CLASS};

# vd, vs2, the immediate before its decrement and the mask, as the alias writes them
val OPERANDS: [4]operand.Operand = [4]operand.Operand{
    operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?V[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.fixed{1}, span: operand.Span.packed{}}}, role: operand.WRITE, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?V[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.state{0}, span: operand.Span.scaled{}}}, role: operand.READ, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 5, sign: operand.SIGNED, scale: 0, bias: 1, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.enumerant{operand.Enumeration{members: ?riscv_field.MASK_MEMBERS[0], count: 2, mask: false, names: index.Index{at: ?riscv_field.MASK_NAMES[0], len: 2}}}, role: operand.READ, width: 0, quantity: operand.ONE},
};

# an alias read only, which the printer never writes
fun never(base: *operand.Value, alias: *operand.Value) bool {
    ret false;
}

# vmsle{u}.vi's values from vmslt{u}.vi's: the immediate less one
fun less_one(alias: *operand.Value, base: *operand.Value) bool {
    if (!sel alias[2].immediate) { ret false; }
    base[0] = alias[0];
    base[1] = alias[1];
    base[2] = operand.Value.immediate{alias[2].immediate - 1};
    base[3] = alias[3];
    ret true;
}

# vmsleu.vi's values from vmsltu.vi's, whose 0 is vmsne.vv's instead
fun less_one_unsigned(alias: *operand.Value, base: *operand.Value) bool {
    if (!sel alias[2].immediate) { ret false; }
    if (alias[2].immediate == 0) { ret false; }
    ret less_one(alias, base);
}

# vmsne.vv's values from vmsltu.vi with 0: vs2 compared with itself, which no element differs from
fun none_below(alias: *operand.Value, base: *operand.Value) bool {
    if (!sel alias[2].immediate) { ret false; }
    if (alias[2].immediate != 0) { ret false; }
    base[0] = alias[0];
    base[1] = alias[1];
    base[2] = alias[1];
    base[3] = alias[3];
    ret true;
}

# vmslt.vi over vmsle.vi
pub val LESS_ONE: syntax.Derive = syntax.Derive{operands: row.Operands{at: ?OPERANDS[0], len: 4}, base: less_one, alias: never};

# vmsltu.vi over vmsleu.vi, but for 0
pub val LESS_ONE_UNSIGNED: syntax.Derive = syntax.Derive{operands: row.Operands{at: ?OPERANDS[0], len: 4}, base: less_one_unsigned, alias: never};

# vmsltu.vi with 0 over vmsne.vv
pub val NONE_BELOW: syntax.Derive = syntax.Derive{operands: row.Operands{at: ?OPERANDS[0], len: 4}, base: none_below, alias: never};
