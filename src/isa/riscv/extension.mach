    extension.Combination{by: C, when: extension.Ids{at: ?WHEN_1[0], len: 2}, implies: extension.Ids{at: ?THEN_1[0], len: 1}},
    extension.Combination{by: ZCE, when: extension.Ids{at: ?WHEN_2[0], len: 2}, implies: extension.Ids{at: ?THEN_2[0], len: 1}},
};

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

fun digit(c: u8) bool {
    ret c >= '0' && c <= '9';
}

# whether s[at..at + len] spells `name`, ignoring case
fun spells(s: str, at: usize, len: usize, name: str) bool {
    if (str_len(name) != len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (lower(s[at + i]) != name[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the end of the token at s[at..], which runs to the next underscore
fun token_end(s: str, len: usize, at: usize) usize {
    var end: usize = at;
    for (end < len && s[end] != '_') { end = end + 1; }
    ret end;
}

# a version, digits then optionally `p` and digits, read at s[at..end] into major and minor
# ---
# ret: where it ends, at when there is none
fun read_version(s: str, at: usize, end: usize, major: *u32, minor: *u32) usize {
    if (at >= end || !digit(s[at])) { ret at; }
    var i: usize = at;
    var m: u32   = 0;
    for (i < end && digit(s[i])) {
        if (m < 100000) { m = m * 10 + (s[i] - '0')::u32; }
        i = i + 1;
    }
    @major = m;
    @minor = 0;
    if (i + 1 < end && lower(s[i]) == 'p' && digit(s[i + 1])) {
        var n: u32 = 0;
        i = i + 1;
        for (i < end && digit(s[i])) {
            if (n < 100000) { n = n * 10 + (s[i] - '0')::u32; }
            i = i + 1;
        }
        @minor = n;
    }
    ret i;
}

# whether the version spelled at s[at..end] is the one the row ratified, an absent minor meaning zero
fun version_is(row: *extension.Extension, major: u32, minor: u32) bool {
    if (str_len(row.revision) == 0) { ret false; }
    var want_major: u32 = 0;
    var want_minor: u32 = 0;
    read_version(row.revision, 0, str_len(row.revision), ?want_major, ?want_minor);
    ret major == want_major && minor == want_minor;
}

# the version at s[at..end] read and checked against the row, or the refusal of its token
# ---
# ret: where the version ends
fun check_version(row: *extension.Extension, s: str, at: usize, end: usize, from: usize) res[usize, extension.Error] {
    var major: u32   = 0;
    var minor: u32   = 0;
    val ends:  usize = read_version(s, at, end, ?major, ?minor);
    if (ends == at)                     { ret res[usize, extension.Error].ok{at}; }
    if (!version_is(row, major, minor)) { ret res[usize, extension.Error].err{extension.refusal("unsupported extension version", from, ends - from)}; }
    ret res[usize, extension.Error].ok{ends};
}

# the single-letter extension `c` names
fun letter(catalog: *extension.Catalog, c: u8) opt[extension.Id] {
    var i: u32 = 0;
    for (i < catalog.count) {
        val name: str = catalog.extensions[i].name;
        if (str_len(name) == 1 && name[0] == lower(c)) { ret opt[extension.Id].some{i}; }
        i = i + 1;
    }
    ret opt[extension.Id].none{};
}

# the multi-letter extension whose name, then a version or nothing, is the token s[at..end]. the longest name wins
fun named(catalog: *extension.Catalog, s: str, at: usize, end: usize) opt[extension.Id] {
    var best:  opt[extension.Id] = opt[extension.Id].none{};
    var width: usize             = 0;
    var i:     u32               = 0;
    for (i < catalog.count) {
        val name:   str   = catalog.extensions[i].name;
        val length: usize = str_len(name);
        if (length > 1 && length > width && length <= end - at && spells(s, at, length, name)) {
            var major: u32 = 0;
            var minor: u32 = 0;
            if (read_version(s, at + length, end, ?major, ?minor) == end) {
                best  = opt[extension.Id].some{i};
                width = length;
            }
        }
        i = i + 1;
    }
    ret best;
}

# the level whose name is s[at..at + len], ignoring case
fun level_of(catalog: *extension.Catalog, s: str, at: usize, len: usize) opt[*extension.Level] {
    var i: u32 = 0;
    for (i < catalog.level_count) {
        if (spells(s, at, len, catalog.levels[i].name)) { ret opt[*extension.Level].some{?catalog.levels[i]}; }
        i = i + 1;
    }
    ret opt[*extension.Level].none{};
}

# the extensions and levels after the base: single letters and then multi-letter tokens, each after the one before it
fun tail(s: str, len: usize, from: usize, first: i64, r: *extension.Request) err[extension.Error] {
    var at:   usize = from;
    var last: i64   = first;
    for (at < len) {
        if (s[at] == '_')              { at = at + 1; }
        if (at >= len || s[at] == '_') { ret err[extension.Error].err{extension.refusal("empty extension name", at, 0)}; }
        val start: usize        = at;
        var id:    extension.Id = 0;
        val c:     u8           = lower(s[at]);
        if (c == 'z' || c == 's' || c == 'x') {
            val end:   usize             = token_end(s, len, at);
            val found: opt[extension.Id] = named(r.catalog, s, at, end);
            if (sel found.none) { ret err[extension.Error].err{extension.refusal("unknown extension", at, end - at)}; }
            id = found.some;
            val row:    *extension.Extension        = ?r.catalog.extensions[id];
            val ranked: res[usize, extension.Error] = check_version(row, s, at + str_len(row.name), end, at);
            if (sel ranked.err) { ret err[extension.Error].err{ranked.err}; }
            at = end;
        }
        or {
            val found: opt[extension.Id] = letter(r.catalog, c);
            if (sel found.none) { ret err[extension.Error].err{extension.refusal("unknown extension", at, 1)}; }
            id = found.some;
            val row:    *extension.Extension        = ?r.catalog.extensions[id];
            val ranked: res[usize, extension.Error] = check_version(row, s, at + 1, len, at);
            if (sel ranked.err) { ret err[extension.Error].err{ranked.err}; }
            at = ranked.ok;
        }
        if (id::i64 <= last) { ret err[extension.Error].err{extension.refusal("extension out of canonical order or repeated", start, at - start)}; }
        last = id::i64;
        extension.request_add(r, id);
    }
    ret err[extension.Error].ok{};
}

# `rv32` or `rv64`, a base of i, e or g, then extensions in canonical order, or a level's name and then extensions
fun parse(s: str, r: *extension.Request) err[extension.Error] {
    val len: usize = str_len(s);
    if (len == 0) { ret err[extension.Error].err{extension.refusal("empty ISA string", 0, 0)}; }
    val wide: bool = len >= 4 && lower(s[0]) == 'r' && lower(s[1]) == 'v' && ((s[2] == '3' && s[3] == '2') || (s[2] == '6' && s[3] == '4'));
    if (!wide) {
        val end:   usize                 = token_end(s, len, 0);
        val found: opt[*extension.Level] = level_of(r.catalog, s, 0, end);
        if (sel found.none) { ret err[extension.Error].err{extension.refusal("not an ISA string or a profile", 0, end)}; }
        val level: *extension.Level = found.some;
        var i:     u32              = 0;
        for (i < level.members.len) {
            extension.request_add(r, level.members.at[i]);
            i = i + 1;
        }
        val rest: err[extension.Error] = tail(s, len, end, -1, r);
        if (sel rest.err) { ret rest; }
        ret err[extension.Error].ok{};
    }
    if (s[2] == '3') { extension.request_add(r, RV32); }
    or               { extension.request_add(r, RV64); }
    if (len == 4)    { ret err[extension.Error].err{extension.refusal("missing base ISA", 4, 0)}; }
    val base: u8    = lower(s[4]);
    var last: i64   = -1;
    var at:   usize = 5;
    if (base == 'g') {
        extension.request_add(r, I);
        extension.request_add(r, M);
        extension.request_add(r, A);
        extension.request_add(r, F);
        extension.request_add(r, D);
        extension.request_add(r, ZICSR);
        extension.request_add(r, ZIFENCEI);
        last = D::i64;
    }
    or (base == 'i' || base == 'e') {
        var id: extension.Id = I;
        if (base == 'e') { id = E; }
        val row:    *extension.Extension        = ?r.catalog.extensions[id];
        val ranked: res[usize, extension.Error] = check_version(row, s, 5, len, 4);
        if (sel ranked.err) { ret err[extension.Error].err{ranked.err}; }
        extension.request_add(r, id);
        last = id::i64;
        at   = ranked.ok;
    }
    or {
        ret err[extension.Error].err{extension.refusal("unknown base ISA", 4, 1)};
    }
    val rest: err[extension.Error] = tail(s, len, at, last, r);
    if (sel rest.err) { ret rest; }
    ret err[extension.Error].ok{};
}

# `text` appended to `out`, after an underscore when `joined`
fun put(out: *vector.Vector[u8], text: str, joined: bool) err[alloc.Error] {
    if (joined) {
        val pushed: res[usize, alloc.Error] = vector.push[u8](out, '_');
        if (sel pushed.err) { ret err[alloc.Error].err{pushed.err}; }
    }
    ret extension.append(out, text);
}

# the selection as `rv32` or `rv64`, its base, its single letters and then each multi-letter extension after an underscore
fun spell(s: *extension.Selection, out: *vector.Vector[u8]) err[alloc.Error] {
    var heads: [3]str = [3]str{"", "", ""};
    if (extension.has(s, RV64)) { heads[0] = "rv64"; }
    or (extension.has(s, RV32)) { heads[0] = "rv32"; }
    if (extension.has(s, I))    { heads[1] = "i"; }
    or (extension.has(s, E))    { heads[1] = "e"; }
    var h: u32 = 0;
    for (h < 2) {
        val head: err[alloc.Error] = put(out, heads[h], false);
        if (sel head.err) { ret head; }
        h = h + 1;
    }
    var i: u32 = 0;
    for (i < s.catalog.count) {
        val name: str = s.catalog.extensions[i].name;
        if (extension.has(s, i) && str_len(name) == 1 && i != I && i != E) {
            val letter: err[alloc.Error] = put(out, name, false);
            if (sel letter.err) { ret letter; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < s.catalog.count) {
        val name: str = s.catalog.extensions[i].name;
        if (extension.has(s, i) && str_len(name) > 1 && i != RV32 && i != RV64) {
            val long: err[alloc.Error] = put(out, name, true);
            if (sel long.err) { ret long; }
        }
        i = i + 1;
    }
    ret err[alloc.Error].ok{};
}

# how riscv selections are spelled
pub val SYNTAX: extension.Syntax = extension.Syntax{parse: parse, spell: spell};

# the riscv catalog: its extensions, levels, conflicts and isa string syntax
pub val CATALOG: extension.Catalog = extension.Catalog{
    extensions:        ?ROWS[0],
    count:             COUNT,
    levels:            ?LEVELS[0],
    level_count:       LEVEL_COUNT,
    conflicts:         ?CONFLICTS[0],
    conflict_count:    CONFLICT_COUNT,
    combinations:      ?COMBINATIONS[0],
    combination_count: COMBINATION_COUNT,
    syntax:            ?SYNTAX,
};

# the selection `spelling` makes in the riscv catalog, into `out`
#[testing]
fun t_select(a: *alloc.Allocator, spelling: str, out: *extension.Selection) bool {
    val made: res[extension.Selection, extension.Error] = extension.select(a, ?CATALOG, spelling);
    if (sel made.err) { ret false; }
    @out = made.ok;
    ret true;
}

# whether the selection spells exactly as `want`
#[testing]
fun t_spells(a: *alloc.Allocator, s: *extension.Selection, want: str) bool {
    var out:     vector.Vector[u8] = vector.init[u8](a);
    val spelled: err[alloc.Error]  = extension.spell(s, ?out);
    var same:    bool              = !(sel spelled.err) && out.len == str_len(want);
    var i:       usize             = 0;
    for (same && i < out.len) {
        if (out.data[i] != want[i]) { same = false; }
        i = i + 1;
    }
    vector.dnit[u8](?out);
    ret same;
}

test select__versions_and_underscores_select_their_extensions {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "RV64I2p1_M2_A2p1_F2p2_D2p2_C_Zicsr2p0_Zifencei_Zba1p0", ?s))      { ret 1; }
    if (!extension.has(?s, RV64) || !extension.has(?s, I) || !extension.has(?s, M) || !extension.has(?s, ZBA)) { ret 2; }
    if (extension.has(?s, RV32) || extension.has(?s, ZBB))                                                     { ret 3; }
    extension.release(?s);
    val stale: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?CATALOG, "rv64i2p0");
    if (sel stale.ok)                { ret 4; }
    if (testing.live_count(?t) != 0) { ret 5; }
    ret 0;
}

test select__a_misordered_string_is_refused {
    var t: testing.Testing;
    testing.make(?t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?CATALOG, "rv64im_zifencei_zicsr");
    if (sel made.ok)                                                                         { ret 1; }
    if (!(sel made.err.refused && (made.err.refused.at == 16 && made.err.refused.len == 5))) { ret 2; }
    val letters: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?CATALOG, "rv64icm");
    if (sel letters.ok)              { ret 3; }
    if (testing.live_count(?t) != 0) { ret 4; }
    ret 0;
}

test select__an_implied_extension_appears_after_closure {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "rv32if", ?s))       { ret 1; }
    if (!t_spells(testing.allocator_of(?t), ?s, "rv32if_zicsr")) { ret 2; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "rv64gc", ?s))                                               { ret 3; }
    if (!t_spells(testing.allocator_of(?t), ?s, "rv64imafdc_zicsr_zifencei_zmmul_zaamo_zalrsc_zca_zcd")) { ret 4; }
    extension.release(?s);
    ret 0;
}

test select__a_profile_name_expands_to_its_members {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "RVA22U64", ?s))                                                            { ret 1; }
    if (!extension.has(?s, RV64) || !extension.has(?s, ZBB) || !extension.has(?s, ZIC64B) || !extension.has(?s, ZIHPM)) { ret 2; }
    if (extension.has(?s, V) || extension.has(?s, ZIFENCEI))                                                            { ret 3; }
    extension.release(?s);
    ret 0;
}
