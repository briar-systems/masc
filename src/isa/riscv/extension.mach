# how many extensions there are
pub val COUNT: u32 = 156;

# the execution state axes, in atom order: an axis's values number on from the extensions, axis by axis
# ---
# xlen: the width of an x register, 32 or 64 bits (src/unpriv/rv32.adoc and src/unpriv/rv64.adoc), which code never
#       switches, so an architecture enters one and a selection may only restate it
# base: the base integer instruction set, i or e (src/unpriv/rv32e.adoc): e has x0 to x15 alone and is entered only
#       by an architecture of the e base, as mink's riscv32e and riscv64e
val XLEN_VALUES: [2]state.Value = [2]state.Value{
    state.Value{name: "32", flag: nil, doc: "32-bit x registers, rv32"},
    state.Value{name: "64", flag: nil, doc: "64-bit x registers, rv64"},
};

val BASE_VALUES: [2]state.Value = [2]state.Value{
    state.Value{name: "i", flag: nil, doc: "the i base, 32 x registers"},
    state.Value{name: "e", flag: nil, doc: "the e base, x0 to x15"},
};

val AXIS_ROWS: [2]state.Axis = [2]state.Axis{
    state.Axis{name: "xlen", values: state.Values{at: ?XLEN_VALUES[0], len: 2}, initial: 0, switchable: false},
    state.Axis{name: "base", values: state.Values{at: ?BASE_VALUES[0], len: 2}, initial: 0, switchable: false},
};

pub val AXES: state.Axes = state.Axes{at: ?AXIS_ROWS[0], len: 2};

# the state atoms, numbered on from the extensions in axis order, which `atoms__number_on_from_the_extensions` holds
pub val XLEN_32: requirement.Id = COUNT;
pub val XLEN_64: requirement.Id = XLEN_32 + 1;
pub val BASE_I:  requirement.Id = XLEN_64 + 1;
pub val BASE_E:  requirement.Id = BASE_I + 1;

# the revision of the e base, which no catalog row carries (src/unpriv/rv32e.adoc, "RV32E and RV64E Base Integer
# Instruction Sets, Version 2.0")
val E_REVISION: str = "2p0";

