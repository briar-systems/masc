# the riscv catalog: its extensions, levels, conflicts and isa string syntax
pub val CATALOG: extension.Catalog = extension.Catalog{
    extensions:        ?ROWS[0],
    count:             COUNT,
    levels:            ?LEVELS[0],
    level_count:       LEVEL_COUNT,
    names:             index.Index{at: ?NAMES[0], len: 167},
    conflicts:         ?CONFLICTS[0],
    conflict_count:    CONFLICT_COUNT,
    combinations:      ?COMBINATIONS[0],
    combination_count: COMBINATION_COUNT,
    syntax:            ?SYNTAX,
};

# the selection `spelling` makes in the riscv catalog, into `out`
#[testing]
fun t_select(a: *alloc.Allocator, spelling: str, out: *extension.Selection) bool {
    val made: res[extension.Selection, extension.Error] = extension.select(a, ?CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    @out = made.ok;
    ret true;
}

# whether the selection spells exactly as `want`
#[testing]
fun t_spells(a: *alloc.Allocator, s: *extension.Selection, want: str) bool {
    var out:     vector.Vector[u8] = vector.init[u8](a);
    val spelled: err[alloc.Error]  = extension.spell(s, ?out);
    var same:    bool              = !(sel spelled.err) && out.len == str_len(want);
    var i:       usize             = 0;
    for (same && i < out.len) {
        if (out.data[i] != want[i]) { same = false; }
        i = i + 1;
    }
    vector.dnit[u8](?out);
    ret same;
}

test select__versions_and_underscores_select_their_extensions {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "RV64I2p1_M2_A2p1_F2p2_D2p2_C_Zicsr2p0_Zifencei_Zba1p0", ?s))         { ret 1; }
    if (!extension.has(?s, XLEN_64) || !extension.has(?s, I) || !extension.has(?s, M) || !extension.has(?s, ZBA)) { ret 2; }
    if (extension.has(?s, XLEN_32) || extension.has(?s, ZBB))                                                     { ret 3; }
    extension.release(?s);
    val stale: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?CATALOG, "rv64i2p0", diagnostic.START);
    if (sel stale.ok)                { ret 4; }
    if (testing.live_count(?t) != 0) { ret 5; }
    ret 0;
}

test select__a_misordered_string_is_refused {
    var t: testing.Testing;
    testing.make(?t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?CATALOG, "rv64im_zifencei_zicsr", diagnostic.START);
    if (sel made.ok)                                                                                             { ret 1; }
    if (!(sel made.err.refused && (made.err.refused.span.start.offset == 16 && made.err.refused.span.len == 5))) { ret 2; }
    val letters: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?CATALOG, "rv64icm", diagnostic.START);
    if (sel letters.ok)              { ret 3; }
    if (testing.live_count(?t) != 0) { ret 4; }
    ret 0;
}

test select__an_implied_extension_appears_after_closure {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "rv32if", ?s))       { ret 1; }
    if (!t_spells(testing.allocator_of(?t), ?s, "rv32if_zicsr")) { ret 2; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "rv64gc", ?s))                                               { ret 3; }
    if (!t_spells(testing.allocator_of(?t), ?s, "rv64imafdc_zicsr_zifencei_zmmul_zaamo_zalrsc_zca_zcd")) { ret 4; }
    extension.release(?s);
    ret 0;
}

# the e base is a base value in the place of i, which it states instead, so a selection of it spells rv32e or rv64e
test select__an_e_base_selection_spells_its_base_in_the_place_of_i {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "rv32e", ?s))                                                                                    { ret 1; }
    if (!t_spells(testing.allocator_of(?t), ?s, "rv32e") || extension.has(?s, I) || extension.has(?s, BASE_I) || !extension.has(?s, BASE_E)) { ret 2; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "rv64emc", ?s))           { ret 3; }
    if (!t_spells(testing.allocator_of(?t), ?s, "rv64emc_zmmul_zca")) { ret 4; }
    extension.release(?s);
    val both: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?CATALOG, "rv32i_e", diagnostic.START);
    if (sel both.ok)                 { ret 5; }
    if (testing.live_count(?t) != 0) { ret 6; }
    ret 0;
}

test select__a_profile_name_expands_to_its_members {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "RVA22U64", ?s))                                                               { ret 1; }
    if (!extension.has(?s, XLEN_64) || !extension.has(?s, ZBB) || !extension.has(?s, ZIC64B) || !extension.has(?s, ZIHPM)) { ret 2; }
    if (extension.has(?s, V) || extension.has(?s, ZIFENCEI))                                                               { ret 3; }
    extension.release(?s);
    ret 0;
}

test spelled__every_name_is_lower_case_so_a_case_folded_search_finds_it {
    var i: u32 = 0;
    for (i < CATALOG.names.len) {
        val key: str   = CATALOG.names.at[i].key;
        var at:  usize = 0;
        for (at < str_len(key)) {
            if (lower(key[at]) != key[at]) { ret 1; }
            at = at + 1;
        }
        val found: opt[u32] = spelled(?CATALOG, key, 0, str_len(key));
        if (!(sel found.some && found.some == CATALOG.names.at[i].row)) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

# the named atoms are the ones the axes number: xlen's values first, then base's
test atoms__number_on_from_the_extensions {
    if (state.atom(?CATALOG, ?AXES, 0, 0) != XLEN_32 || state.atom(?CATALOG, ?AXES, 0, 1) != XLEN_64) { ret 1; }
    if (state.atom(?CATALOG, ?AXES, 1, 0) != BASE_I || state.atom(?CATALOG, ?AXES, 1, 1) != BASE_E)   { ret 2; }
    if (state.atom_count(?CATALOG, ?AXES) != BASE_E + 1)                                              { ret 3; }
    ret 0;
}
