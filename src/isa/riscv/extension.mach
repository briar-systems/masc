pub val ROWS: [156]extension.Extension = [156]extension.Extension{
    extension.Extension{name: "i", implies: requirement.NO_IDS, revision: "2p1"},
    extension.Extension{name: "m", implies: requirement.Ids{at: ?IMPLIES_M[0], len: 1}, revision: "2p0"},
    extension.Extension{name: "a", implies: requirement.Ids{at: ?IMPLIES_A[0], len: 2}, revision: "2p1"},
    extension.Extension{name: "f", implies: requirement.Ids{at: ?IMPLIES_F[0], len: 1}, revision: "2p2"},
    extension.Extension{name: "d", implies: requirement.Ids{at: ?IMPLIES_D[0], len: 1}, revision: "2p2"},
