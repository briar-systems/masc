    extension.Extension{name: "b", implies: requirement.Ids{at: ?IMPLIES_B[0], len: 3}, revision: "1p0"},
    extension.Extension{name: "v", implies: requirement.Ids{at: ?IMPLIES_V[0], len: 2}, revision: "1p0"},
    extension.Extension{name: "h", implies: requirement.NO_IDS, revision: "1p0"},
    extension.Extension{name: "zic64b", implies: requirement.NO_IDS, revision: "1p0"},
    extension.Extension{name: "zicbom", implies: requirement.NO_IDS, revision: "1p0"},
    extension.Extension{name: "zicbop", implies: requirement.NO_IDS, revision: "1p0"},
