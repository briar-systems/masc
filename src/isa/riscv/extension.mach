# the riscv extension catalog and its isa string syntax
#
# the rows, their handles, implications and revisions, the levels, the conflicts, the combinations and the name index
# are generated, by gen riscv into gen_extension, from the records of gen/data/riscv/extensions, where each source is
# cited. the handles are forwarded here as `id`, as `riscv_extension.id.ZBA`, the state values' among them, as
# `riscv_extension.id.XLEN_64`.
#
# one set serves rv32 and rv64 and both bases: the width and the base are
# execution state, the axes xlen and base, not extensions. an isa string
# states both, `rv32` or `rv64` its xlen and `i` or `e` its base, and a row
# that exists at one width requires the width's state value. the e base holds
# the i row's instructions on x0 to x15 alone, so it is a base value and no
# catalog row: `e` names no extension, and the e base's instructions are the
# i rows less the registers base=e does not have.
#
# an isa string is read and spelled in the canonical order of mink's grammar of
# it (src/unpriv/naming.adoc): the single letters in the grammar's order, then
# the multi-letter extensions by their prefix, a z extension by the rank of
# its second letter and then by name. the grammar is the one mink's riscv
# family holds.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_len;
use std.types.view.view;

use alloc: std.allocator;
use std.collections.vector;

use masc.core.extension;
use masc.core.index;
use masc.core.requirement;
use masc.core.state;
use masc.isa.riscv.gen_extension;

use arch_riscv: mink.catalog.arch.riscv;
use mink.catalog.isa;

# the ids of the rows and the state values, as `riscv_extension.id.ZBA`
fwd id: masc.isa.riscv.gen_extension;

# the grammar of an isa string, mink's riscv family's, which every family of an isa string holds
fun grammar() *isa.Grammar {
    val g: opt[*isa.Grammar] = arch_riscv.RISCV_FAMILY.grammar;
    if (sel g.none) { ret nil; }
    ret g.some;
}

# the execution state axes, in atom order: an axis's values number on from the extensions, axis by axis
# ---
# xlen: the width of an x register, 32 or 64 bits (src/unpriv/rv32.adoc and src/unpriv/rv64.adoc), which code never
#       switches, so an architecture enters one and a selection may only restate it
# base: the base integer instruction set, i or e (src/unpriv/rv32e.adoc): e has x0 to x15 alone and is entered only
#       by an architecture of the e base, as mink's riscv32e and riscv64e
val XLEN_VALUES: [2]state.Value = [2]state.Value{
    state.Value{name: "32", flag: nil, doc: "32-bit x registers, rv32"},
    state.Value{name: "64", flag: nil, doc: "64-bit x registers, rv64"},
};

val BASE_VALUES: [2]state.Value = [2]state.Value{
    state.Value{name: "i", flag: nil, doc: "the i base, 32 x registers"},
    state.Value{name: "e", flag: nil, doc: "the e base, x0 to x15"},
};

val AXIS_ROWS: [2]state.Axis = [2]state.Axis{
    state.Axis{name: "xlen", values: state.Values{at: ?XLEN_VALUES[0], len: 2}, initial: 0, switchable: gen_extension.XLEN_SWITCHED},
    state.Axis{name: "base", values: state.Values{at: ?BASE_VALUES[0], len: 2}, initial: 0, switchable: gen_extension.BASE_SWITCHED},
};

pub val AXES: state.Axes = state.Axes{at: ?AXIS_ROWS[0], len: 2};

# the revision of the e base, which no catalog row carries (src/unpriv/rv32e.adoc, "RV32E and RV64E Base Integer
# Instruction Sets, Version 2.0")
val E_REVISION: str = "2p0";

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

fun digit(c: u8) bool {
    ret c >= '0' && c <= '9';
}

# the end of the token at s[at..], which runs to the next underscore
fun token_end(s: str, len: usize, at: usize) usize {
    var end: usize = at;
    for (end < len && s[end] != '_') { end = end + 1; }
    ret end;
}

# a version, digits then optionally `p` and digits, read at s[at..end] into major and minor
# ---
# ret: where it ends, at when there is none
fun read_version(s: str, at: usize, end: usize, major: *u32, minor: *u32) usize {
    if (at >= end || !digit(s[at])) { ret at; }
    var i: usize = at;
    var m: u32   = 0;
    for (i < end && digit(s[i])) {
        if (m < 100000) { m = m * 10 + (s[i] - '0')::u32; }
        i = i + 1;
    }
    @major = m;
    @minor = 0;
    if (i + 1 < end && lower(s[i]) == 'p' && digit(s[i + 1])) {
        var n: u32 = 0;
        i = i + 1;
        for (i < end && digit(s[i])) {
            if (n < 100000) { n = n * 10 + (s[i] - '0')::u32; }
            i = i + 1;
        }
        @minor = n;
    }
    ret i;
}

# whether the version spelled is the ratified `revision`, an absent minor meaning zero
fun version_is(revision: str, major: u32, minor: u32) bool {
    if (str_len(revision) == 0) { ret false; }
    var want_major: u32 = 0;
    var want_minor: u32 = 0;
    read_version(revision, 0, str_len(revision), ?want_major, ?want_minor);
    ret major == want_major && minor == want_minor;
}

# the version at s[at..end] read and checked against the ratified `revision`, or the refusal of its token
# ---
# ret: where the version ends
fun check_version(r: *extension.Request, revision: str, s: str, at: usize, end: usize, from: usize) res[usize, extension.Error] {
    var major: u32   = 0;
    var minor: u32   = 0;
    val ends:  usize = read_version(s, at, end, ?major, ?minor);
    if (ends == at)                          { ret res[usize, extension.Error].ok{at}; }
    if (!version_is(revision, major, minor)) { ret res[usize, extension.Error].err{extension.refusal(r, "unsupported extension version", from, ends - from)}; }
    ret res[usize, extension.Error].ok{ends};
}

# the entry of the catalog's name index that s[at..at + len] spells, ignoring case. every name of the catalog is lower case
fun spelled(catalog: *extension.Catalog, s: str, at: usize, len: usize) opt[*extension.NameEntry] {
    ret extension.entry(catalog, view(?s[at], len), true);
}

# the one extension the entry `e` enables, as a spelling's name with its version: a name of several rows or of a level
# is none, since the version reads against one extension
fun one_named(catalog: *extension.Catalog, e: *extension.NameEntry) opt[requirement.Id] {
    val ids: opt[requirement.Ids] = extension.extensions_of(catalog, e);
    if (sel ids.none) { ret opt[requirement.Id].none{}; }
    val rows: requirement.Ids = ids.some;
    if (rows.len != 1) { ret opt[requirement.Id].none{}; }
    ret opt[requirement.Id].some{rows.at[0]};
}

# the single-letter extension s[at] names
fun letter(catalog: *extension.Catalog, s: str, at: usize) opt[requirement.Id] {
    val found: opt[*extension.NameEntry] = spelled(catalog, s, at, 1);
    if (sel found.none) { ret opt[requirement.Id].none{}; }
    ret one_named(catalog, found.some);
}

# the multi-letter extension whose name, then a version or nothing, is the token s[at..end]. the longest name wins
fun named(catalog: *extension.Catalog, s: str, at: usize, end: usize) opt[requirement.Id] {
    var length: usize = end - at;
    for (length > 1) {
        val found: opt[*extension.NameEntry] = spelled(catalog, s, at, length);
        if (sel found.some) {
            var major: u32                 = 0;
            var minor: u32                 = 0;
            val id:    opt[requirement.Id] = one_named(catalog, found.some);
            if (sel id.some && read_version(s, at + length, end, ?major, ?minor) == end) { ret id; }
        }
        length = length - 1;
    }
    ret opt[requirement.Id].none{};
}

# the level whose name is s[at..at + len], ignoring case
fun level_of(catalog: *extension.Catalog, s: str, at: usize, len: usize) opt[*extension.Level] {
    val found: opt[*extension.NameEntry] = spelled(catalog, s, at, len);
    if (sel found.none) { ret opt[*extension.Level].none{}; }
    ret extension.only_level(catalog, found.some);
}

# whether `c` is the letter of a base the grammar names after its prefix and width, as `i` of `rv64i`
fun based(c: u8) bool {
    val at: usize = str_len(grammar().prefix) + 2;
    var i:  usize = 0;
    for (i < grammar().base_count) {
        val b: str = grammar().bases[i].spelling;
        if (str_len(b) > at && b[at] == c) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the place of `c` in `s`, `s`'s length when it does not hold it
fun place(s: str, c: u8) u64 {
    var i: usize = 0;
    for (s[i] != 0 && s[i] != c) { i = i + 1; }
    ret i::u64;
}

# the canonical rank of the single letter `c`: its place among the grammar's single letters, else after every one of
# them by the alphabet
fun single_rank(g: *isa.Grammar, c: u8) u64 {
    val at:  u64 = place(g.single, c);
    val len: u64 = str_len(g.single)::u64;
    if (at < len) { ret at; }
    ret len + (c - 'a')::u64;
}

# the canonical rank of the extension named `name`, which orders before its name does: a single letter's own, and a
# multi-letter name's past every single letter by its prefix's place among the grammar's, then by its second letter's
# rank where the prefix is a ranked one
fun rank(g: *isa.Grammar, name: str) u64 {
    if (str_len(name) == 1) { ret single_rank(g, name[0]); }
    var r: u64 = (place(g.multi, name[0]) + 1) << 8;
    if (place(g.ranked, name[0]) < str_len(g.ranked)::u64) { r = r + single_rank(g, name[1]); }
    ret r;
}

# whether the extension named `a` comes before the one named `b` in canonical order: by rank, then by name
fun before(g: *isa.Grammar, a: str, b: str) bool {
    val ra: u64 = rank(g, a);
    val rb: u64 = rank(g, b);
    if (ra != rb) { ret ra < rb; }
    ret str_compare(a, b) < 0;
}

# whether s[at] begins a multi-letter extension, as the grammar's prefixes do
fun multi(c: u8) bool {
    ret place(grammar().multi, c) < str_len(grammar().multi)::u64;
}

# the extensions and levels after the base: single letters and then multi-letter tokens, each after the one named
# `first` before it, nil for none, in canonical order
fun tail(s: str, len: usize, from: usize, first: str, r: *extension.Request) err[extension.Error] {
    var at:   usize = from;
    var last: str   = first;
    for (at < len) {
        if (s[at] == '_')              { at = at + 1; }
        if (at >= len || s[at] == '_') { ret err[extension.Error].err{extension.refusal(r, "empty extension name", at, 0)}; }
        val start: usize          = at;
        var id:    requirement.Id = 0;
        val c:     u8             = lower(s[at]);
        if (multi(c)) {
            val end:   usize               = token_end(s, len, at);
            val found: opt[requirement.Id] = named(r.catalog, s, at, end);
            if (sel found.none) { ret err[extension.Error].err{extension.refusal(r, "unknown extension", at, end - at)}; }
            id = found.some;
            val row:    *extension.Extension        = ?r.catalog.extensions[id];
            val ranked: res[usize, extension.Error] = check_version(r, row.revision, s, at + str_len(row.name), end, at);
            if (sel ranked.err) { ret err[extension.Error].err{ranked.err}; }
            at = end;
        }
        or {
            val found: opt[requirement.Id] = letter(r.catalog, s, at);
            if (sel found.none) { ret err[extension.Error].err{extension.refusal(r, "unknown extension", at, 1)}; }
            id = found.some;
            val row:    *extension.Extension        = ?r.catalog.extensions[id];
            val ranked: res[usize, extension.Error] = check_version(r, row.revision, s, at + 1, len, at);
            if (sel ranked.err) { ret err[extension.Error].err{ranked.err}; }
            at = ranked.ok;
        }
        val name: str = r.catalog.extensions[id].name;
        if (last != nil && !before(grammar(), last, name)) { ret err[extension.Error].err{extension.refusal(r, "extension out of canonical order or repeated", start, at - start)}; }
        last = name;
        extension.request_add(r, id);
    }
    ret err[extension.Error].ok{};
}

# `rv32` or `rv64`, which states xlen, a base of i, e or g, which states the base, then extensions in canonical order,
# or a level's name, which states both, and then extensions
fun parse(r: *extension.Request) err[extension.Error] {
    val s:   str   = r.spelling;
    val len: usize = str_len(s);
    if (len == 0) { ret err[extension.Error].err{extension.refusal(r, "empty ISA string", 0, 0)}; }
    val wide: bool = len >= 4 && lower(s[0]) == grammar().prefix[0] && lower(s[1]) == grammar().prefix[1] && ((s[2] == '3' && s[3] == '2') || (s[2] == '6' && s[3] == '4'));
    if (!wide) {
        val end:   usize                     = token_end(s, len, 0);
        val found: opt[*extension.NameEntry] = spelled(r.catalog, s, 0, end);
        var level: opt[*extension.Level]     = opt[*extension.Level].none{};
        if (sel found.some) { level = extension.only_level(r.catalog, found.some); }
        if (sel level.none) { ret err[extension.Error].err{extension.refusal(r, "not an ISA string or a profile", 0, end)}; }
        if (sel found.some) { extension.request_entry(r, found.some); }
        val rest: err[extension.Error] = tail(s, len, end, nil, r);
        if (sel rest.err) { ret rest; }
        ret err[extension.Error].ok{};
    }
    if (s[2] == '3') { extension.request_add(r, gen_extension.XLEN_32); }
    or               { extension.request_add(r, gen_extension.XLEN_64); }
    if (len == 4)    { ret err[extension.Error].err{extension.refusal(r, "missing base ISA", 4, 0)}; }
    val base: u8    = lower(s[4]);
    var last: str   = nil;
    var at:   usize = 5;
    if (base == 'g') {
        extension.request_add(r, gen_extension.BASE_I);
        extension.request_add(r, gen_extension.I);
        extension.request_add(r, gen_extension.M);
        extension.request_add(r, gen_extension.A);
        extension.request_add(r, gen_extension.F);
        extension.request_add(r, gen_extension.D);
        extension.request_add(r, gen_extension.ZICSR);
        extension.request_add(r, gen_extension.ZIFENCEI);
        last = "d";
    }
    or (based(base)) {
        # the e base names no row, and the extensions after it rank after its letter
        var revision: str = r.catalog.extensions[gen_extension.I].revision;
        if (base == 'e') { revision = E_REVISION; }
        val ranked: res[usize, extension.Error] = check_version(r, revision, s, 5, len, 4);
        if (sel ranked.err) { ret err[extension.Error].err{ranked.err}; }
        if (base == 'e')    { extension.request_add(r, gen_extension.BASE_E); }
        or {
            extension.request_add(r, gen_extension.BASE_I);
            extension.request_add(r, gen_extension.I);
        }
        last = "i";
        if (base == 'e') { last = "e"; }
        at = ranked.ok;
    }
    or {
        ret err[extension.Error].err{extension.refusal(r, "unknown base ISA", 4, 1)};
    }
    val rest: err[extension.Error] = tail(s, len, at, last, r);
    if (sel rest.err) { ret rest; }
    ret err[extension.Error].ok{};
}

# `text` appended to `out`, after an underscore when `joined`
fun put(out: *vector.Vector[u8], text: str, joined: bool) err[alloc.Error] {
    if (joined) {
        val pushed: res[usize, alloc.Error] = vector.push[u8](out, '_');
        if (sel pushed.err) { ret err[alloc.Error].err{pushed.err}; }
    }
    ret extension.append(out, text);
}

# extension `id`'s name appended to `out`, after an underscore when `joined`, and its revision when `versioned`
fun member(out: *vector.Vector[u8], catalog: *extension.Catalog, id: u32, joined: bool, versioned: bool) err[alloc.Error] {
    val row:  *extension.Extension = ?catalog.extensions[id];
    val name: err[alloc.Error]     = put(out, row.name, joined);
    if (sel name.err || !versioned || row.revision == nil) { ret name; }
    ret extension.append(out, row.revision);
}

# the selection as `rv32` or `rv64`, its base, its single letters and then each multi-letter extension after an
# underscore, and with `versioned` each member's revision after it and an underscore before every member past the base,
# as the psabi's Tag_RISCV_arch spells it
fun spelling(s: *extension.Selection, out: *vector.Vector[u8], versioned: bool) err[alloc.Error] {
    var width: str = "";
    if (extension.has(s, gen_extension.XLEN_64)) { width = "rv64"; }
    or (extension.has(s, gen_extension.XLEN_32)) { width = "rv32"; }
    val head: err[alloc.Error] = put(out, width, false);
    if (sel head.err) { ret head; }
    if (extension.has(s, gen_extension.BASE_E)) {
        val base: err[alloc.Error] = put(out, "e", false);
        if (sel base.err) { ret base; }
        if (versioned) {
            val revision: err[alloc.Error] = extension.append(out, E_REVISION);
            if (sel revision.err) { ret revision; }
        }
    }
    or (extension.has(s, gen_extension.I)) {
        val base: err[alloc.Error] = member(out, s.catalog, gen_extension.I, false, versioned);
        if (sel base.err) { ret base; }
    }
    var after: str = s.catalog.extensions[gen_extension.I].name;
    var next:  u32 = following(s, after);
    for (next < s.catalog.count) {
        val name:  str              = s.catalog.extensions[next].name;
        val wrote: err[alloc.Error] = member(out, s.catalog, next, versioned || str_len(name) > 1, versioned);
        if (sel wrote.err) { ret wrote; }
        after = name;
        next  = following(s, after);
    }
    ret err[alloc.Error].ok{};
}

# the member of `s` that comes first in canonical order after the one named `after`, the catalog's count past the last
fun following(s: *extension.Selection, after: str) u32 {
    var best: u32 = s.catalog.count;
    var i:    u32 = 0;
    for (i < s.catalog.count) {
        val name: str = s.catalog.extensions[i].name;
        if (extension.has(s, i) && before(grammar(), after, name)) {
            if (best == s.catalog.count || before(grammar(), name, s.catalog.extensions[best].name)) { best = i; }
        }
        i = i + 1;
    }
    ret best;
}

fun spell(s: *extension.Selection, out: *vector.Vector[u8]) err[alloc.Error] {
    ret spelling(s, out, false);
}

fun versioned(s: *extension.Selection, out: *vector.Vector[u8]) err[alloc.Error] {
    ret spelling(s, out, true);
}

# how riscv selections are spelled
pub val SYNTAX: extension.Syntax = extension.Syntax{parse: parse, spell: spell, versioned: versioned};

# the riscv catalog: its extensions, levels, conflicts and isa string syntax
# the base selection, nothing added, no xlen nor base, is named `none`, as no isa string names an empty set
pub val CATALOG: extension.Catalog = extension.Catalog{
    extensions:        ?gen_extension.ROWS[0],
    count:             gen_extension.COUNT,
    levels:            ?gen_extension.LEVELS[0],
    level_count:       gen_extension.LEVEL_COUNT,
    names:             extension.Names{at: ?gen_extension.NAMES[0], len: gen_extension.NAME_COUNT},
    conflicts:         gen_extension.CONFLICTS,
    conflict_count:    gen_extension.CONFLICT_COUNT,
    combinations:      gen_extension.COMBINATIONS,
    combination_count: gen_extension.COMBINATION_COUNT,
    syntax:            ?SYNTAX,
    base:              "none",
};
