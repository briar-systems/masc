# an s register is x8, x9 or x18 to x23. its operand ranges over x8 to x23 and excludes x10 to x17, so its number
# less x8 is 0, 1 or 10 to 15, coded 0 to 7
fun sreg_code(n: u64) u64 {
    if (n < 2) { ret n; }
    ret n - 8;
}

fun sreg_number(code: u64) u64 {
    if (code < 2) { ret code; }
    ret code + 8;
}

# a sregs field's param, as the generator writes it: the operand coded at SREG7's bits in bits 0 to 7, and the one
# coded at SREG2's in bits 8 to 15
fun sreg_operand(param: u64, which: u64) u32 {
    ret ((param >> (which * 8)) & 0xFF)::u32;
}

fun sregs_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val first:  u32 = sreg_operand(f.param, 0);
    val second: u32 = sreg_operand(f.param, 1);
    if (first >= enc.count || second >= enc.count) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, field.NO_OPERAND, enc.out.len)}; }
    val unit: res[u64, field.Refusal] = field.pack(enc, f);
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    val coded: u64 = unit.ok | (sreg_code(enc.parts[first].bits[field.NUMBER]) << SREG7.at::u64) | (sreg_code(enc.parts[second].bits[field.NUMBER]) << SREG2.at::u64);
    ret field.put(enc, coded, f.width / 8);
}

fun sregs_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    val first:  u32 = sreg_operand(f.param, 0);
    val second: u32 = sreg_operand(f.param, 1);
    if (first >= dec.count || second >= dec.count) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, field.NO_OPERAND, dec.at)}; }
    val at:   usize                   = dec.at;
    val unit: res[u64, field.Refusal] = field.get(dec, f.width / 8);
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    val unpacked: err[field.Refusal] = field.unpack(dec, f, unit.ok, at);
    if (sel unpacked.err) { ret unpacked; }
    field.deposit(dec, first::u8, field.NUMBER, sreg_number((unit.ok >> SREG7.at::u64) & field.ones(SREG7.len)), 0);
    field.deposit(dec, second::u8, field.NUMBER, sreg_number((unit.ok >> SREG2.at::u64) & field.ones(SREG2.len)), 0);
    ret err[field.Refusal].ok{};
}

# a unit that codes two s registers in three bits each, at the bits of SREG7 and SREG2, with no slices
pub val SREGS: field.Kind = field.Kind{name: "sregs", admit: nil, encode: sregs_encode, decode: sregs_decode, finish: nil, complete: nil};

# the stack adjustment base of each register list in bytes, 0 for the lists zcmp reserves
val BASE32: [16]u8 = [16]u8{0, 0, 0, 0, 16, 16, 16, 16, 32, 32, 32, 32, 48, 48, 48, 64};
val BASE64: [16]u8 = [16]u8{0, 0, 0, 0, 16, 16, 32, 32, 48, 48, 64, 64, 80, 80, 96, 112};

# a stack field's param, as the generator writes it: the index of the register list operand in bits 0 to 7, bit 8 set
# at rv64 and bit 9 set when the adjustment is written negative, as cm.push does. the field's operand is the
# adjustment, an immediate whose bits hold the largest adjustment with its sign
fun stack_base(list: u64, wide: bool) u64 {
    if (list >= 16) { ret 0; }
    if (wide)       { ret BASE64[list]::u64; }
    ret BASE32[list]::u64;
}

# the bits of the adjustment operand's immediate, its sign the top one when written negative, 0 when it is not an immediate
fun adjustment_bits(desc: *operand.Operand) u8 {
    if (sel desc.shape.immediate) { ret desc.shape.immediate.bits; }
    ret 0;
}

# the two bits of the adjustment for the values `enc` holds, refused at stream offset `at` when the list is one zcmp
# reserves or the adjustment is not the list's base plus 0, 16, 32 or 48
fun stack_step(enc: *field.Encoder, f: *field.Field, at: usize) res[u64, field.Refusal] {
    val list: u32 = (f.param & 0xFF)::u32;
    if (list >= enc.count) { ret res[u64, field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, at)}; }
    val base: u64 = stack_base(enc.parts[list].bits[field.NUMBER], (f.param & 0x100) != 0);
    if (base == 0) { ret res[u64, field.Refusal].err{field.refusal(field.NOT_A_MEMBER, list::u8, at)}; }
    val bits: u8 = adjustment_bits(?enc.operands[f.operand]);
    if (bits == 0 || bits >= 64) { ret res[u64, field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, at)}; }
    var adjust: i64 = (enc.parts[f.operand].bits[field.NUMBER] & field.ones(bits))::i64;
    if ((f.param & 0x200) != 0) {
        if (adjust >= (1::i64 << (bits - 1)::i64)) { adjust = adjust - (1::i64 << bits::i64); }
        adjust = 0 - adjust;
    }
    val step: i64 = adjust - base::i64;
    if (step < 0 || step > 48) { ret res[u64, field.Refusal].err{field.refusal(field.OUT_OF_RANGE, f.operand, at)}; }
    ret res[u64, field.Refusal].ok{(step / 16)::u64};
}

fun stack_admit(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val step: res[u64, field.Refusal] = stack_step(enc, f, 0);
    if (sel step.err) { ret err[field.Refusal].err{step.err}; }
    ret err[field.Refusal].ok{};
}

fun stack_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val step: res[u64, field.Refusal] = stack_step(enc, f, enc.out.len);
    if (sel step.err) { ret err[field.Refusal].err{step.err}; }
    val unit: res[u64, field.Refusal] = field.pack(enc, f);
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    ret field.put(enc, unit.ok | (step.ok << 2), f.width / 8);
}

fun stack_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    val at:   usize                   = dec.at;
    val unit: res[u64, field.Refusal] = field.get(dec, f.width / 8);
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    val unpacked: err[field.Refusal] = field.unpack(dec, f, unit.ok, at);
    if (sel unpacked.err) { ret unpacked; }
    val list: u32 = (f.param & 0xFF)::u32;
    if (list >= dec.count) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, at)}; }
    val base: u64 = stack_base(dec.parts[list].bits[field.NUMBER], (f.param & 0x100) != 0);
    if (base == 0) { ret err[field.Refusal].err{field.refusal(field.NOT_A_MEMBER, list::u8, at)}; }
    val bits: u8 = adjustment_bits(?dec.operands[f.operand]);
    if (bits == 0 || bits >= 64) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, at)}; }
    var adjust: u64 = base + ((unit.ok >> 2) & 3) * 16;
    if ((f.param & 0x200) != 0) { adjust = (0 - adjust::i64)::u64 & field.ones(bits); }
    field.deposit(dec, f.operand, field.NUMBER, adjust, 0);
    ret err[field.Refusal].ok{};
}

# zcmp's stack adjustment: the register list's base plus sixteen times two bits
pub val STACK: field.Kind = field.Kind{name: "stack", admit: stack_admit, encode: stack_encode, decode: stack_decode, finish: nil, complete: nil};

val KINDS: [3]*field.Kind = [3]*field.Kind{?field.UNIT, ?SREGS, ?STACK};

# the riscv field table, its units little-endian
pub val TABLE: field.Table = field.Table{kinds: ?KINDS[0], count: 3, order: field.LITTLE};

# the riscv form choices: only the core's exact form, which no marker spells, so an instruction a sequence writes full
# length that would compress alone has no statement of its own (#224). gnu as and llvm-mc spell none
val FORM_ROWS: [1]core_form.FormField = [1]core_form.FormField{core_form.FormField{name: "exact", mask: core_form.EXACT, value: core_form.EXACT, marker: nil, suffix: false}};

pub val FORMS: core_form.FormFields = core_form.FormFields{at: ?FORM_ROWS[0], len: 1};

#[testing]
val T_EFFECT: effect.Effect = effect.Effect{
    implicit: effect.Registers.ruled{effect.Ruled{otherwise: effect.NO_TOUCHED, rules: effect.NO_REGISTER_RULES, may: effect.NO_TOUCHED, must: effect.NO_TOUCHED}},
    flags:    effect.Flags{read: effect.NO_WORDS, written: effect.NO_WORDS, undefined: effect.NO_WORDS, kept: effect.NO_WORDS},
    memory:   effect.NO_ACCESSES,
    control:  effect.Control{transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, operand: field.NO_OPERAND, rules: effect.NO_RULES},
    stack:    effect.Stack.none{},
    latency:  effect.ONE,
    fixed:    effect.NO_FIXEDS,
};

# a test's selection, its register view and output buffers
#[testing]
rec T {
    t:      testing.Testing;
    s:      extension.Selection;
    v:      register.Available;
    ctx:    state.Context;
    out:    vector.Vector[u8];
    fixups: vector.Vector[field.Fixup];
}

#[testing]
fun t_make(t: *T, spelling: str) bool {
    testing.make(?t.t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t.t), ?riscv.CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    val opened: res[state.Context, state.Opened] = state.open(testing.allocator_of(?t.t), nil, ?t.s, ?riscv.AXES, state.initial(?riscv.AXES), ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx    = opened.ok;
    t.out    = vector.init[u8](testing.allocator_of(?t.t));
    t.fixups = vector.init[field.Fixup](testing.allocator_of(?t.t));
    ret true;
}

# a one-operand row of layout `l` under opcode `opcode` that requires `req`, encoding `value`
#[testing]
fun t_encode_imm(t: *T, l: *layout.Layout, opcode: u64, req: requirement.Ids, value: i64) res[usize, field.Refusal] {
    var operands: [1]operand.Operand         = [1]operand.Operand{operand.Operand{shape: operand.Shape.immediate{l.value}, role: operand.READ, width: 32, quantity: operand.ONE}};
    var pieces:   [8]field.Slice;
    val alt:      [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: req, none: requirement.NO_IDS}};
    val count:    u32                        = layout.slices(l.pieces, 0, field.NUMBER, ?pieces[0]);
    var fields:   [1]field.Field             = [1]field.Field{field.Field{kind: UNIT_KIND, width: l.unit, fixed: opcode, mask: 0x7F, slices: field.Slices{at: ?pieces[0], len: count}, operand: field.NO_OPERAND, param: 0}};
    var rows:     [1]row.Row                 = [1]row.Row{row.Row{key: "t", mnemonic: "t", operands: row.Operands{at: ?operands[0], len: 1}, encoding: field.Fields{at: ?fields[0], len: 1}, requires: requirement.Requirement{at: ?alt[0], len: 1}, effect: ?T_EFFECT, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0}};
    val codec:    dispatch.Codec             = dispatch.Codec{fields: ?TABLE, registers: nil, rows: row.Rows{at: ?rows[0], len: 1}, keys: index.NO_ENTRIES, dispatch: nil, element: 0};
    var values:   [1]operand.Value           = [1]operand.Value{operand.Value.immediate{value}};
    var ins:      inst.Inst                  = inst.Inst{row: ?rows[0], values: ?values[0], count: 1};
    ret walk.encode(?codec, ?t.ctx, ?ins, ?t.out, ?t.fixups);
}

#[testing]
fun t_wrote(t: *T, a: u8, b: u8, c: u8, d: u8) bool {
    ret t.out.len == 4 && t.out.data[0] == a && t.out.data[1] == b && t.out.data[2] == c && t.out.data[3] == d;
}

test encode__the_split_b_and_j_immediates_encode_their_bit_order {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val none:  requirement.Ids           = requirement.NO_IDS;
    val wrote: res[usize, field.Refusal] = t_encode_imm(?t, ?B13, 0x63, none, -2732);
    if (!(sel wrote.ok && t_wrote(?t, 0x63, 0x0A, 0x00, 0xD4))) { ret 2; }
    t.out.len = 0;
    val jumped: res[usize, field.Refusal] = t_encode_imm(?t, ?J21, 0x6F, none, -370094);
    if (!(sel jumped.ok && t_wrote(?t, 0x6F, 0x50, 0x3A, 0xA5))) { ret 3; }
    ret 0;
}

test encode__a_shift_amount_wider_than_xlen_allows_is_refused {
    val at32: [1]requirement.Id = [1]requirement.Id{riscv.id.XLEN_32};
    val at64: [1]requirement.Id = [1]requirement.Id{riscv.id.XLEN_64};
    var t:    T;
    if (!t_make(?t, "rv32i")) { ret 1; }
    val narrow: requirement.Ids           = requirement.Ids{at: ?at32[0], len: 1};
    val wide:   requirement.Ids           = requirement.Ids{at: ?at64[0], len: 1};
    val fits:   res[usize, field.Refusal] = t_encode_imm(?t, ?SHAMTW, 0x13, narrow, 31);
    if (!(sel fits.ok)) { ret 2; }
    val over: res[usize, field.Refusal] = t_encode_imm(?t, ?SHAMTW, 0x13, narrow, 32);
    if (!(sel over.err && over.err.message == field.OUT_OF_RANGE)) { ret 3; }
    val other: res[usize, field.Refusal] = t_encode_imm(?t, ?SHAMTD, 0x13, wide, 1);
    if (!(sel other.err && other.err.requires.len != 0)) { ret 4; }
    var u: T;
    if (!t_make(?u, "rv64i")) { ret 5; }
    val six: res[usize, field.Refusal] = t_encode_imm(?u, ?SHAMTD, 0x13, wide, 63);
    if (!(sel six.ok)) { ret 6; }
    val past: res[usize, field.Refusal] = t_encode_imm(?u, ?SHAMTD, 0x13, wide, 64);
    if (!(sel past.err && past.err.message == field.OUT_OF_RANGE)) { ret 7; }
    ret 0;
}

test table__each_kind_index_the_generator_writes_names_its_kind {
    if (TABLE.kinds[UNIT_KIND] != ?field.UNIT) { ret 1; }
    if (TABLE.kinds[SREGS_KIND] != ?SREGS)     { ret 2; }
    if (TABLE.kinds[STACK_KIND] != ?STACK)     { ret 3; }
    ret 0;
}

# an encoder over two parts and a decoder over the bytes it wrote, for the kinds alone
#[testing]
rec K {
    t:      testing.Testing;
    parts:  [2]field.Parts;
    out:    vector.Vector[u8];
    fixups: vector.Vector[field.Fixup];
}

#[testing]
fun k_encoder(k: *K) field.Encoder {
    testing.make(?k.t);
    k.out    = vector.init[u8](testing.allocator_of(?k.t));
    k.fixups = vector.init[field.Fixup](testing.allocator_of(?k.t));
    ret field.Encoder{table: ?TABLE, operands: nil, values: nil, parts: ?k.parts[0], count: 2, out: ?k.out, fixups: ?k.fixups, start: 0, field: 0};
}

#[testing]
fun k_set(k: *K, op: u32, bits: u64) {
    k.parts[op].bits[field.NUMBER] = bits;
    k.parts[op].present            = 1;
}

#[testing]
fun k_decoder(k: *K, data: *u8) field.Decoder {
    var d: field.Decoder;
    d.table = ?TABLE;
    d.parts = ?k.parts[0];
    d.count = 2;
    d.in    = field.Stream{data: data, len: 2, order: field.LITTLE};
    d.end   = 2;
    ret d;
}

test sregs__the_s_registers_code_in_three_bits_and_decode_back {
    var k:     K;
    var enc:   field.Encoder = k_encoder(?k);
    val sregs: field.Field   = field.Field{kind: SREGS_KIND, width: 16, fixed: 0xAC22, mask: 0xFC63, slices: field.NO_SLICES, operand: field.NO_OPERAND, param: 0x100};
    k_set(?k, 0, 10);
    k_set(?k, 1, 1);
    val first: err[field.Refusal] = sregs_encode(?enc, ?sregs);
    if (sel first.err) { ret 1; }
    val want: [2]u8 = [2]u8{0x26, 0xAD};
    if (k.out.len != 2 || k.out.data[0] != want[0] || k.out.data[1] != want[1]) { ret 2; }
    if (k.parts[0].bits[field.NUMBER] != 10)                                    { ret 3; }
    var back: field.Decoder = k_decoder(?k, k.out.data);
    k.parts[0].bits[field.NUMBER] = 0;
    k.parts[1].bits[field.NUMBER] = 0;
    val decoded: err[field.Refusal] = sregs_decode(?back, ?sregs);
    if (sel decoded.err)                                                           { ret 4; }
    if (k.parts[0].bits[field.NUMBER] != 10 || k.parts[1].bits[field.NUMBER] != 1) { ret 5; }
    ret 0;
}

test stack__the_adjustment_codes_two_bits_from_the_list_and_the_width {
    var k:        K;
    var enc:      field.Encoder      = k_encoder(?k);
    var operands: [2]operand.Operand = [2]operand.Operand{
        operand.Operand{shape: operand.Shape.enumerant{CRLIST.values}, role: operand.READ, width: 0, quantity: operand.ONE},
        operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 9, sign: operand.SIGNED, scale: 4, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE},
    };
    enc.operands = ?operands[0];
    var slice: [1]field.Slice = [1]field.Slice{field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 4, at: 4, invert: false}};
    val push:  field.Field    = field.Field{kind: STACK_KIND, width: 16, fixed: 0xB802, mask: 0xFF03, slices: field.Slices{at: ?slice[0], len: 1}, operand: 1, param: 0x300};
    k_set(?k, 0, 7);
    k_set(?k, 1, 0x1D0);
    val pushed: err[field.Refusal] = stack_encode(?enc, ?push);
    if (sel pushed.err)                                                   { ret 1; }
    if (k.out.len != 2 || k.out.data[0] != 0x76 || k.out.data[1] != 0xB8) { ret 2; }
    var back: field.Decoder = k_decoder(?k, k.out.data);
    back.operands                 = ?operands[0];
    k.parts[0].bits[field.NUMBER] = 0;
    k.parts[1].bits[field.NUMBER] = 0;
    val popped: err[field.Refusal] = stack_decode(?back, ?push);
    if (sel popped.err)                                                               { ret 3; }
    if (k.parts[0].bits[field.NUMBER] != 7 || k.parts[1].bits[field.NUMBER] != 0x1D0) { ret 4; }
    k_set(?k, 1, 0x1F0);
    k.out.len = 0;
    val below: err[field.Refusal] = stack_encode(?enc, ?push);
    if (!(sel below.err && (below.err.message == field.OUT_OF_RANGE && below.err.operand == 1))) { ret 5; }
    ret 0;
}
