pub val ACQUIRE_MEMBERS: [2]operand.Enumerant  = [2]operand.Enumerant{operand.Enumerant{name: ".rl", value: 0}, operand.Enumerant{name: ".aqrl", value: 1}};
pub val RELEASE_MEMBERS: [2]operand.Enumerant  = [2]operand.Enumerant{operand.Enumerant{name: ".aq", value: 0}, operand.Enumerant{name: ".aqrl", value: 1}};
pub val MASK_MEMBERS:    [2]operand.Enumerant  = [2]operand.Enumerant{operand.Enumerant{name: ", v0.t", value: MASKED}, operand.Enumerant{name: "", value: UNMASKED}};
# the constants zfa's fli loads, by their index in the rs1 field (riscv-isa-manual, "Zfa", table of fli constants)
