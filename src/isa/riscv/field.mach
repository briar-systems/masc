# rl
pub val RL: Choice = Choice{name: "rl", unit: 32, pieces: Pieces{at: ?RL_PIECES[0], len: 1}, values: operand.Enumeration{members: ?RELEASE_MEMBERS[0], count: 2, mask: false, names: index.Index{at: ?RELEASE_NAMES[0], len: 2}}};
# vm
pub val VM: Choice = Choice{name: "vm", unit: 32, pieces: Pieces{at: ?VM_PIECES[0], len: 1}, values: operand.Enumeration{members: ?MASK_MEMBERS[0], count: 2, mask: false, names: index.Index{at: ?MASK_NAMES[0], len: 2}}};
# c_rlist
