pub val CLH1: Layout = Layout{name: "clh1", unit: 16, pieces: Pieces{at: ?CLH1_PIECES[0], len: 1}, value: operand.Immediate{bits: 2, signed: false, scale: 1, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.Integers{at: nil, len: 0}}};
# c_index
pub val CINDEX8: Layout = Layout{name: "cindex8", unit: 16, pieces: Pieces{at: ?CINDEX8_PIECES[0], len: 1}, value: operand.Immediate{bits: 8, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.Integers{at: nil, len: 0}}};

val RM_MEMBERS:      [6]operand.Enumerant  = [6]operand.Enumerant{operand.Enumerant{name: "rne", value: 0}, operand.Enumerant{name: "rtz", value: 1}, operand.Enumerant{name: "rdn", value: 2}, operand.Enumerant{name: "rup", value: 3}, operand.Enumerant{name: "rmm", value: 4}, operand.Enumerant{name: "dyn", value: 7}};
val FENCE_MEMBERS:   [4]operand.Enumerant  = [4]operand.Enumerant{operand.Enumerant{name: "i", value: 8}, operand.Enumerant{name: "o", value: 4}, operand.Enumerant{name: "r", value: 2}, operand.Enumerant{name: "w", value: 1}};
val ORDER_MEMBERS:   [2]operand.Enumerant  = [2]operand.Enumerant{operand.Enumerant{name: "aq", value: 2}, operand.Enumerant{name: "rl", value: 1}};
val ACQUIRE_MEMBERS: [1]operand.Enumerant  = [1]operand.Enumerant{operand.Enumerant{name: "aq", value: 1}};
val RELEASE_MEMBERS: [1]operand.Enumerant  = [1]operand.Enumerant{operand.Enumerant{name: "rl", value: 1}};
val MASK_MEMBERS:    [2]operand.Enumerant  = [2]operand.Enumerant{operand.Enumerant{name: "v0.t", value: 0}, operand.Enumerant{name: "", value: 1}};
val RLIST_MEMBERS:   [12]operand.Enumerant = [12]operand.Enumerant{operand.Enumerant{name: "{ra}", value: 4}, operand.Enumerant{name: "{ra, s0}", value: 5}, operand.Enumerant{name: "{ra, s0-s1}", value: 6}, operand.Enumerant{name: "{ra, s0-s2}", value: 7}, operand.Enumerant{name: "{ra, s0-s3}", value: 8}, operand.Enumerant{name: "{ra, s0-s4}", value: 9}, operand.Enumerant{name: "{ra, s0-s5}", value: 10}, operand.Enumerant{name: "{ra, s0-s6}", value: 11}, operand.Enumerant{name: "{ra, s0-s7}", value: 12}, operand.Enumerant{name: "{ra, s0-s8}", value: 13}, operand.Enumerant{name: "{ra, s0-s9}", value: 14}, operand.Enumerant{name: "{ra, s0-s11}", value: 15}};

val RM_PIECES:     [1]Piece = [1]Piece{Piece{lo: 0, len: 3, at: 12}};
val PRED_PIECES:   [1]Piece = [1]Piece{Piece{lo: 0, len: 4, at: 24}};
val SUCC_PIECES:   [1]Piece = [1]Piece{Piece{lo: 0, len: 4, at: 20}};
val AQRL_PIECES:   [1]Piece = [1]Piece{Piece{lo: 0, len: 2, at: 25}};
val AQ_PIECES:     [1]Piece = [1]Piece{Piece{lo: 0, len: 1, at: 26}};
val RL_PIECES:     [1]Piece = [1]Piece{Piece{lo: 0, len: 1, at: 25}};
val VM_PIECES:     [1]Piece = [1]Piece{Piece{lo: 0, len: 1, at: 25}};
val CRLIST_PIECES: [1]Piece = [1]Piece{Piece{lo: 0, len: 4, at: 4}};

# rm
pub val RM: Choice = Choice{name: "rm", unit: 32, pieces: Pieces{at: ?RM_PIECES[0], len: 1}, values: operand.Enumeration{members: ?RM_MEMBERS[0], count: 6, mask: false}};
# pred
pub val PRED: Choice = Choice{name: "pred", unit: 32, pieces: Pieces{at: ?PRED_PIECES[0], len: 1}, values: operand.Enumeration{members: ?FENCE_MEMBERS[0], count: 4, mask: true}};
# succ
pub val SUCC: Choice = Choice{name: "succ", unit: 32, pieces: Pieces{at: ?SUCC_PIECES[0], len: 1}, values: operand.Enumeration{members: ?FENCE_MEMBERS[0], count: 4, mask: true}};
# aqrl
