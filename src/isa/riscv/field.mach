# the riscv field kinds and the operand layouts rows are built from
#
# almost every riscv field is a slice of an operand's number: the split b, j,
# s and compressed immediates are pieces of one encoded number, with the
# implied zero low bit stated as the immediate's scale, and the register-prime
# fields are a register range of x8 to x15 in three bits. those go through the
# core's unit kind. a layout states the pieces and the operand shape once. the
# operand's index and part are the row's, so a piece becomes a slice in
# `slices` when a row is written, and the generator emits those slices as
# static rows.
#
# a kind exists only where slices cannot express the encoding:
#   sregs       a unit that maps the s-register numbers of zcmp's
#               cm.mva01s onto three bits
#   stack       zcmp's stack adjustment, whose two bits depend on the
#               register list and the width
#
# values a field's operand never admits, as the nonzero immediates and the
# `_n0` and `_n2` registers of the c extension, are exclusions on the operand,
# stated in the layouts and positions below
#
# the shift amount is five bits at rv32 and for the w forms, and six bits for
# the rv64 forms. width is a catalog extension, so the two forms are two rows
# that require rv32 or rv64 and use `SHAMTW` or `SHAMTD`, which is how
# riscv-opcodes states them too. no kind reads the width
#
# the vector mask `vm` is the enumerant `VM`, whose unmasked spelling is empty
# because the bit is one when no mask is written. csr numbers are twelve bit
# immediates and the csr table's names are the parser's. rounding mode, the
# fence sets and the acquire and release bits are enumerants, the last two
# kinds of them a union of members. the arguments each layout covers are named
# above it as riscv-opcodes (5783cf3bea312a48d28e3e2c8a2fcb55603e4bed) spells
# them. not covered: the rv128 `shamtq`, the quad compressed `c_uimm9`,
# `c_uimm10` and their stack forms, the e-base `_e` arguments (the register
# file's availability narrows those), and the unratified p extension and
# zvt arguments

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use alloc: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.core.ct;
use masc.core.diagnostic;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.inst;
use masc.core.operand;
use masc.core.register;
use masc.core.row;
use masc.core.walk;

use riscv: masc.isa.riscv.extension;

# `len` bits of the encoded number from bit `lo` land at bit `at` of the unit
pub rec Piece {
    lo:  u8;
    len: u8;
    at:  u8;
}

# pieces as a pointer to static pieces and a count
pub rec Pieces {
    at:  *Piece;
    len: u32;
}

# an immediate operand and where its bits lie
# ---
# name:   the name diagnostics and generators spell
# unit:   the bits of the unit it lies in
# pieces: where the encoded number lands
# value:  the operand shape
pub rec Layout {
    name:   str;
    unit:   u8;
    pieces: Pieces;
    value:  operand.Immediate;
}

# an enumerant operand and where its bits lie
pub rec Choice {
    name:   str;
    unit:   u8;
    pieces: Pieces;
    values: operand.Enumeration;
}

# a register operand's position, its range and where its number lies
# ---
# first:    the lowest register number it admits
# count:    how many numbers it admits from first, 0 for every number
# at:       the bit of the unit the number starts at
# len:      how many bits the number takes
# excluded: the numbers it never admits
pub rec Position {
    name:     str;
    unit:     u8;
    first:    u32;
    count:    u32;
    at:       u8;
    len:      u8;
    excluded: operand.Numbers;
}

# the pieces of a layout as slices of operand `op`'s `part`, written to `out`
# ---
# ret: how many slices were written
pub fun slices(pieces: Pieces, op: u8, part: field.Part, out: *field.Slice) u32 {
    var i: u32 = 0;
    for (i < pieces.len) {
        val p: Piece = pieces.at[i];
        out[i] = field.Slice{operand: op, part: part, lo: p.lo, len: p.len, at: p.at, invert: false};
        i      = i + 1;
    }
    ret pieces.len;
}

# a register position as the slice of operand `op`
pub fun slice_of(p: *Position, op: u8) field.Slice {
    ret field.Slice{operand: op, part: field.NUMBER, lo: 0, len: p.len, at: p.at, invert: false};
}

