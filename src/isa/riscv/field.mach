# rm
pub val RM: Choice = Choice{name: "rm", unit: 32, pieces: Pieces{at: ?RM_PIECES[0], len: 1}, values: operand.Enumeration{members: ?RM_MEMBERS[0], count: 7, mask: false, names: index.Index{at: ?RM_NAMES[0], len: 7}}};
# pred
