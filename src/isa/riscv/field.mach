pub val CLBU2: Layout = Layout{name: "clbu2", unit: 16, pieces: Pieces{at: ?CLBU2_PIECES[0], len: 2}, value: operand.Immediate{bits: 2, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# c_uimm1
pub val CLH1: Layout = Layout{name: "clh1", unit: 16, pieces: Pieces{at: ?CLH1_PIECES[0], len: 1}, value: operand.Immediate{bits: 2, signed: false, scale: 1, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# c_index
pub val CINDEX8: Layout = Layout{name: "cindex8", unit: 16, pieces: Pieces{at: ?CINDEX8_PIECES[0], len: 1}, value: operand.Immediate{bits: 8, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# c_index of cm.jalt, whose indices below 32 are cm.jt
pub val CINDEX_JALT: Layout = Layout{name: "cindex_jalt", unit: 16, pieces: Pieces{at: ?CINDEX8_PIECES[0], len: 1}, value: operand.Immediate{bits: 8, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.Integers{at: ?JT_EXCLUDED[0], len: 32}}};
# c_index of cm.jt, the indices below 32, the higher three bits of the field fixed at zero
pub val CINDEX5: Layout = Layout{name: "cindex5", unit: 16, pieces: Pieces{at: ?CINDEX5_PIECES[0], len: 1}, value: operand.Immediate{bits: 5, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# mop_r_t_30, mop_r_t_27_26, mop_r_t_21_20
pub val MOPR5: Layout = Layout{name: "mopr5", unit: 32, pieces: Pieces{at: ?MOPR5_PIECES[0], len: 3}, value: operand.Immediate{bits: 5, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# mop_rr_t_30, mop_rr_t_27_26
pub val MOPRR3: Layout = Layout{name: "moprr3", unit: 32, pieces: Pieces{at: ?MOPRR3_PIECES[0], len: 2}, value: operand.Immediate{bits: 3, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# c_mop_t, the odd n of c.mop.n held as (n - 1) / 2
pub val CMOP4: Layout = Layout{name: "cmop4", unit: 16, pieces: Pieces{at: ?CMOP4_PIECES[0], len: 1}, value: operand.Immediate{bits: 4, signed: false, scale: 1, bias: 1, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};

# the values of vm, the mask operand of a vector instruction: v0.t masks it by v0, and no mask leaves it unmasked
# (src/unpriv/vector-common.adoc, "Mask Encoding")
pub val MASKED:   u32 = 0;
pub val UNMASKED: u32 = 1;

pub val RM_MEMBERS:      [7]operand.Enumerant  = [7]operand.Enumerant{operand.Enumerant{name: ", rne", value: 0}, operand.Enumerant{name: ", rtz", value: 1}, operand.Enumerant{name: ", rdn", value: 2}, operand.Enumerant{name: ", rup", value: 3}, operand.Enumerant{name: ", rmm", value: 4}, operand.Enumerant{name: "", value: 7}, operand.Enumerant{name: ", dyn", value: 7}};
