# the risc-v control and status registers as an id space
#
# a csr instruction names its register by a twelve bit number, and any number
# encodes, named or not, so the operand is an id of this space rather than an
# enumeration, which would refuse the unnamed ones. the generated table holds
# every csr riscv-opcodes names, sorted by name for the parser, and an index
# of them sorted by number for the printer. a csr that exists only at rv32,
# as the high halves of the counters, requires rv32.

use std.types.option.opt;
use std.types.string.str;

use masc.core.extension;
use masc.core.register;
use masc.core.requirement;
use riscv_register: masc.isa.riscv.register;

# the id space a csr operand names
pub val SPACE: u16 = 0;

# the register row that states the csr numbered `number`, none when no row of the file does. the state rows of the register file's
# csr class are the one owner of those numbers, so a csr operand and an instruction's implicit effect reach the same row
pub fun state(file: *register.File, number: u32) opt[u32] {
    if (number >= riscv_register.CSR.count) { ret opt[u32].none{}; }
    ret register.row_index(file, register.make(riscv_register.CSR_CLASS, number::u16));
}

# one named csr
# ---
# name:     its name
# number:   its twelve bit number
# requires: the extensions under which it exists
pub rec Csr {
    name:     str;
    number:   u32;
    requires: requirement.Requirement;
}

# csrs as a pointer to static csrs and a count
pub rec Csrs {
    at:  *Csr;
    len: u32;
}
