# the risc-v assembly syntax, the vendor dialect
#
# every row's template, the respelling aliases and the index by mnemonic are
# generated from riscv-opcodes and the reviewed dialect (gen_syntax). what is
# written here is what the generator cannot state: the specifiers that give a
# symbol its fixup kind, and the hooks for the operands the framework does not
# spell from a table, immediates, which also read a vector type as its fields
# and c.lui's immediate as the bits lui loads, and csrs, which are names of the
# csr id space, and the pseudo instructions of several instructions, call,
# tail, lla and la, which riscv-opcodes does not hold.
#
# registers are written by their abi names and read by those or their x, f
# and v names. mnemonics, names and specifiers read without regard to case.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;
use std.types.view.view_eq_str;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.field;
use masc.core.mode;
use masc.core.operand;
use masc.core.row;
use masc.core.spelling;
use masc.syntax.expr;
use masc.syntax.read;
use masc.syntax.write;

use riscv_csr:      masc.isa.riscv.csr;
use riscv_fixup:    masc.isa.riscv.fixup;
use riscv_mode:     masc.isa.riscv.mode;
use riscv_register: masc.isa.riscv.register;

use masc.isa.riscv.gen_csr;
use masc.isa.riscv.gen_register;
use masc.isa.riscv.gen_row;
use masc.isa.riscv.gen_syntax;

# the high twenty bits of `v` that `lui` holds, rounded so the low twelve bits add as signed
fun fold_hi(v: i64) i64 {
    ret ((v + 0x800) >> 12) & 0xFFFFF;
}

# the low twelve bits of `v` as the signed offset an I or S type instruction adds
fun fold_lo(v: i64) i64 {
    ret ((v & 0xFFF) ^ 0x800) - 0x800;
}

# the specifiers, from the psABI's assembly notation for relocations (riscv-elf.adoc, "Relocation Operators"). %tprel_add and %tlsdesc_call mark an
# instruction that holds no symbol of its own, so no operand takes them
val SPECIFIERS: [15]spelling.Specifier = [15]spelling.Specifier{
    spelling.Specifier{template: "%hi(<0>)", operand: riscv_fixup.HI20, fixup: riscv_fixup.HI20, fold: fold_hi},
    spelling.Specifier{template: "%lo(<0>)", operand: riscv_fixup.LO12_I, fixup: riscv_fixup.LO12_I, fold: fold_lo},
    spelling.Specifier{template: "%lo(<0>)", operand: riscv_fixup.LO12_S, fixup: riscv_fixup.LO12_S, fold: fold_lo},
    spelling.Specifier{template: "%pcrel_hi(<0>)", operand: riscv_fixup.PCREL_HI20, fixup: riscv_fixup.PCREL_HI20, fold: nil},
    spelling.Specifier{template: "%pcrel_lo(<0>)", operand: riscv_fixup.LO12_I, fixup: riscv_fixup.PCREL_LO12_I, fold: nil},
    spelling.Specifier{template: "%pcrel_lo(<0>)", operand: riscv_fixup.LO12_S, fixup: riscv_fixup.PCREL_LO12_S, fold: nil},
    spelling.Specifier{template: "%got_pcrel_hi(<0>)", operand: riscv_fixup.PCREL_HI20, fixup: riscv_fixup.GOT_PCREL_HI20, fold: nil},
    spelling.Specifier{template: "%tprel_hi(<0>)", operand: riscv_fixup.HI20, fixup: riscv_fixup.TPREL_HI20, fold: nil},
    spelling.Specifier{template: "%tprel_lo(<0>)", operand: riscv_fixup.LO12_I, fixup: riscv_fixup.TPREL_LO12_I, fold: nil},
    spelling.Specifier{template: "%tprel_lo(<0>)", operand: riscv_fixup.LO12_S, fixup: riscv_fixup.TPREL_LO12_S, fold: nil},
    spelling.Specifier{template: "%tls_ie_pcrel_hi(<0>)", operand: riscv_fixup.PCREL_HI20, fixup: riscv_fixup.TLS_GOT_PCREL_HI20, fold: nil},
    spelling.Specifier{template: "%tls_gd_pcrel_hi(<0>)", operand: riscv_fixup.PCREL_HI20, fixup: riscv_fixup.TLS_GD_PCREL_HI20, fold: nil},
    spelling.Specifier{template: "%tlsdesc_hi(<0>)", operand: riscv_fixup.PCREL_HI20, fixup: riscv_fixup.TLSDESC_HI20, fold: nil},
    spelling.Specifier{template: "%tlsdesc_load_lo(<0>)", operand: riscv_fixup.LO12_I, fixup: riscv_fixup.TLSDESC_PCREL_LOAD_LO12, fold: nil},
    spelling.Specifier{template: "%tlsdesc_add_lo(<0>)", operand: riscv_fixup.LO12_I, fixup: riscv_fixup.TLSDESC_PCREL_ADD_LO12, fold: nil},
};

# the fields of a vector type, as vsetvli and vsetivli write them: the element width, and the length multiplier by its code
val SEWS:  [4]str = [4]str{"e8", "e16", "e32", "e64"};
val LMULS: [8]str = [8]str{"m1", "m2", "m4", "m8", "", "mf8", "mf4", "mf2"};

# the index of the name among `names` that the reader's word is, -1 when none, an empty name never being one
fun word_in(r: *spelling.Reader, names: *str, count: u32) i64 {
    val len: usize = read.token(r, r.at);
    val w:   View  = read.span(r, r.at, len);
    var i:   u32   = 0;
    for (i < count) {
        if (names[i][0] != 0 && view_eq_str(w, names[i])) {
            r.at = r.at + len;
            ret i::i64;
        }
        i = i + 1;
    }
    ret -1;
}

# `, ` read between the fields of a vector type
fun comma(r: *spelling.Reader) bool {
    val back: usize = r.at;
    read.skip(r);
    if (!read.take(r, ",")) {
        r.at = back;
        ret false;
    }
    read.skip(r);
    ret true;
}

# a vector type: a number, or `e32, m2, ta, ma` with every field after the element width optional
fun vtype_parse(r: *spelling.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val c: u8 = read.peek(r);
    if (c >= '0' && c <= '9') { ret expr.IMMEDIATE.parse(r, desc, format, out); }
    val at:  usize = r.at;
    val sew: i64   = word_in(r, ?SEWS[0], 4);
    if (sew < 0) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.NOT_A_MEMBER, at, read.token(r, at))}; }
    var lmul: u64   = 0;
    var ta:   u64   = 0;
    var ma:   u64   = 0;
    var back: usize = r.at;
    if (comma(r)) {
        val found: i64 = word_in(r, ?LMULS[0], 8);
        if (found >= 0) {
            lmul = found::u64;
            back = r.at;
        }
        or { r.at = back; }
    }
    if (comma(r)) {
        if (read.take(r, "ta")) {
            ta   = 1;
            back = r.at;
        }
        or (read.take(r, "tu")) { back = r.at; }
        or                      { r.at = back; }
    }
    if (comma(r)) {
        if (read.take(r, "ma")) {
            ma   = 1;
            back = r.at;
        }
        or (read.take(r, "mu")) { back = r.at; }
        or                      { r.at = back; }
    }
    @out = operand.Value.immediate{(lmul | (sew::u64 << 3) | (ta << 6) | (ma << 7))::i64};
    ret err[diagnostic.Diagnostic].ok{};
}

# five pieces of text written in turn
fun texts(w: *spelling.Writer, a: str, b: str, c: str, d: str, e: str) err[field.Refusal] {
    val pieces: [5]str = [5]str{a, b, c, d, e};
    var i:      u32    = 0;
    for (i < 5) {
        val done: err[field.Refusal] = write.text(w, pieces[i]);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    ret err[field.Refusal].ok{};
}

# a vector type as its fields, or as a number when it holds bits or a multiplier no field names
fun vtype_print(w: *spelling.Writer, value: *operand.Value) err[field.Refusal] {
    if (!sel value.immediate) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    val v:    u64 = value.immediate:~u64;
    val lmul: u64 = v & 7;
    if ((v >> 8) != 0 || lmul == 4) { ret write.decimal(w, value.immediate); }
    var tail: str = ", tu, ";
    if (((v >> 6) & 1) != 0) { tail = ", ta, "; }
    var mask: str = "mu";
    if (((v >> 7) & 1) != 0) { mask = "ma"; }
    ret texts(w, SEWS[(v >> 3) & 3], ", ", LMULS[lmul], tail, mask);
}

# the bits lui loads, which c.lui writes its immediate as, the vendor tools reading and printing it so: twenty, the
# value being their sign extension
val LUI_BITS: i64 = 20;

pub val NOT_LUI: str = "not the twenty bits lui loads";

# an immediate written as the twenty bits lui loads, from 0 to 0xfffff, read as their sign extension, so c.lui's -1 is
# written 0xfffff
fun lui_parse(r: *spelling.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val at:  usize                      = r.at;
    val got: err[diagnostic.Diagnostic] = expr.IMMEDIATE.parse(r, desc, format, out);
    if (sel got.err)        { ret got; }
    if (!sel out.immediate) { ret got; }
    val v: i64 = out.immediate;
    if (v < 0 || v >= (1::i64 << LUI_BITS)) { ret err[diagnostic.Diagnostic].err{read.refuse(r, NOT_LUI, at, r.at - at)}; }
    if (v >= (1::i64 << (LUI_BITS - 1)))    { @out = operand.Value.immediate{v - (1::i64 << LUI_BITS)}; }
    ret got;
}

fun lui_print(w: *spelling.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (!sel value.immediate) { ret expr.IMMEDIATE.print(w, desc, format, value); }
    ret write.decimal(w, value.immediate & ((1::i64 << LUI_BITS) - 1));
}

fun immediate_parse(r: *spelling.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (view_eq_str(format, "vtype")) { ret vtype_parse(r, desc, format, out); }
    if (view_eq_str(format, "lui"))   { ret lui_parse(r, desc, format, out); }
    ret expr.IMMEDIATE.parse(r, desc, format, out);
}

fun immediate_print(w: *spelling.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (view_eq_str(format, "vtype")) { ret vtype_print(w, value); }
    if (view_eq_str(format, "lui"))   { ret lui_print(w, desc, format, value); }
    ret expr.IMMEDIATE.print(w, desc, format, value);
}

val IMMEDIATE: spelling.Hook = spelling.Hook{parse: immediate_parse, print: immediate_print};

# the csr named `name`, or none: a binary search of the table sorted by name
fun csr_named(syntax: *spelling.Syntax, name: View) opt[*riscv_csr.Csr] {
    var lo: u32 = 0;
    var hi: u32 = gen_csr.TABLE.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        val at:  str = gen_csr.TABLE.at[mid].name;
        val c:   i64 = spelling.compare(syntax, view(at, str_len(at)), name);
        if (c == 0) { ret opt[*riscv_csr.Csr].some{?gen_csr.TABLE.at[mid]}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret opt[*riscv_csr.Csr].none{};
}

# the first csr of number `n` the selection admits, in the index sorted by number, none when no csr it admits has it.
# a nil selection holds no extension, so it admits only the csrs that require none
fun csr_numbered(selection: *extension.Selection, n: u32) opt[*riscv_csr.Csr] {
    var lo: u32 = 0;
    var hi: u32 = gen_csr.TABLE.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (gen_csr.TABLE.at[gen_csr.BY_NUMBER[mid]].number < n) { lo = mid + 1; }
        or                                                       { hi = mid; }
    }
    for (lo < gen_csr.TABLE.len) {
        val c: *riscv_csr.Csr = ?gen_csr.TABLE.at[gen_csr.BY_NUMBER[lo]];
        if (c.number != n)                                                                        { ret opt[*riscv_csr.Csr].none{}; }
        if (c.requires.len == 0 || (selection != nil && extension.admits(selection, c.requires))) { ret opt[*riscv_csr.Csr].some{c}; }
        lo = lo + 1;
    }
    ret opt[*riscv_csr.Csr].none{};
}

# a csr by its name, or by its number
fun id_parse(r: *spelling.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (!sel desc.shape.id)                     { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))}; }
    if (desc.shape.id.space != riscv_csr.SPACE) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))}; }
    val c: u8 = read.peek(r);
    if (c >= '0' && c <= '9') {
        val n: res[i64, diagnostic.Diagnostic] = read.number(r);
        if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
        @out = operand.Value.id{n.ok::u32};
        ret err[diagnostic.Diagnostic].ok{};
    }
    val at:  usize = r.at;
    val len: usize = read.name(r);
    if (len == 0) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, at, read.token(r, at))}; }
    val found: opt[*riscv_csr.Csr] = csr_named(r.syntax, read.span(r, at, len));
    if (sel found.none)                                                { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.NOT_A_MEMBER, at, len)}; }
    if (!extension.admits(r.available.selection, found.some.requires)) { ret err[diagnostic.Diagnostic].err{read.refuse_unmet(r, found.some.requires, at, len)}; }
    r.at = at + len;
    @out = operand.Value.id{found.some.number};
    ret err[diagnostic.Diagnostic].ok{};
}

# a csr by its first name the selection admits, so the parser reads it back, or by its number when it has none
fun id_print(w: *spelling.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (!sel value.id) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    val found: opt[*riscv_csr.Csr] = csr_numbered(w.selection, value.id);
    if (sel found.none) { ret write.decimal(w, value.id::i64); }
    ret write.text(w, found.some.name);
}

val ID: spelling.Hook = spelling.Hook{parse: id_parse, print: id_print};

# the operands of the sequences: for call and tail the target, a symbol the pair's relocation takes, and a register it
# links to. for lla and la the register built and the symbol whose address it is, which the high part's relocation takes
val SEQUENCE_OPERANDS: [7]operand.Operand = [7]operand.Operand{
    operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 32, signed: true, scale: 0, bias: 0, fixup: riscv_fixup.CALL_PLT_PAIR, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?riscv_register.GENERAL[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1}}, role: operand.WRITE, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 32, signed: true, scale: 0, bias: 0, fixup: riscv_fixup.CALL_PLT_PAIR, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?riscv_register.GENERAL[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1}}, role: operand.WRITE, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 32, signed: true, scale: 0, bias: 0, fixup: riscv_fixup.PCREL_HI20, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?riscv_register.GENERAL[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1}}, role: operand.WRITE, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 32, signed: true, scale: 0, bias: 0, fixup: riscv_fixup.GOT_PCREL_HI20, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE},
};

# each step's operands: `call target` through ra, `call rd, target` through rd, `tail target` through t1 linking
# nowhere, the pc relative address of `lla`, and the global offset table load of `la` under pic, whose low part names
# the label of its high part
val SEQUENCE_PARTS: [25]spelling.Part = [25]spelling.Part{
    spelling.Part.register{gen_register.X1},
    spelling.Part.symbol{spelling.Relocation{operand: 0, fixup: riscv_fixup.CALL_PLT_PAIR}},
    spelling.Part.register{gen_register.X1},
    spelling.Part.register{gen_register.X1},
    spelling.Part.value{operand.Value.immediate{0}},
    spelling.Part.operand{0},
    spelling.Part.symbol{spelling.Relocation{operand: 1, fixup: riscv_fixup.CALL_PLT_PAIR}},
    spelling.Part.operand{0},
    spelling.Part.operand{0},
    spelling.Part.value{operand.Value.immediate{0}},
    spelling.Part.register{gen_register.X6},
    spelling.Part.symbol{spelling.Relocation{operand: 0, fixup: riscv_fixup.CALL_PLT_PAIR}},
    spelling.Part.register{gen_register.X0},
    spelling.Part.register{gen_register.X6},
    spelling.Part.value{operand.Value.immediate{0}},
    spelling.Part.operand{0},
    spelling.Part.symbol{spelling.Relocation{operand: 1, fixup: riscv_fixup.PCREL_HI20}},
    spelling.Part.operand{0},
    spelling.Part.operand{0},
    spelling.Part.here{riscv_fixup.PCREL_LO12_I},
    spelling.Part.operand{0},
    spelling.Part.symbol{spelling.Relocation{operand: 1, fixup: riscv_fixup.GOT_PCREL_HI20}},
    spelling.Part.operand{0},
    spelling.Part.operand{0},
    spelling.Part.here{riscv_fixup.PCREL_LO12_I},
};

# the auipc and jalr of each call sequence, the pair the psabi's `call` and `tail` write (riscv-asm.md, "Function
# Calls"), the auipc and addi of `lla`, and the auipc and the load of the xlen, ld or lw, of `la` under pic
# (riscv-asm.md, "Pseudoinstructions")
val SEQUENCE_STEPS: [12]spelling.Step = [12]spelling.Step{
    spelling.Step{row: gen_row.AUIPC, parts: spelling.Parts{at: ?SEQUENCE_PARTS[0], len: 2}},
    spelling.Step{row: gen_row.JALR, parts: spelling.Parts{at: ?SEQUENCE_PARTS[2], len: 3}},
    spelling.Step{row: gen_row.AUIPC, parts: spelling.Parts{at: ?SEQUENCE_PARTS[5], len: 2}},
    spelling.Step{row: gen_row.JALR, parts: spelling.Parts{at: ?SEQUENCE_PARTS[7], len: 3}},
    spelling.Step{row: gen_row.AUIPC, parts: spelling.Parts{at: ?SEQUENCE_PARTS[10], len: 2}},
    spelling.Step{row: gen_row.JALR, parts: spelling.Parts{at: ?SEQUENCE_PARTS[12], len: 3}},
    spelling.Step{row: gen_row.AUIPC, parts: spelling.Parts{at: ?SEQUENCE_PARTS[15], len: 2}},
    spelling.Step{row: gen_row.ADDI, parts: spelling.Parts{at: ?SEQUENCE_PARTS[17], len: 3}},
    spelling.Step{row: gen_row.AUIPC, parts: spelling.Parts{at: ?SEQUENCE_PARTS[20], len: 2}},
    spelling.Step{row: gen_row.LD, parts: spelling.Parts{at: ?SEQUENCE_PARTS[22], len: 3}},
    spelling.Step{row: gen_row.AUIPC, parts: spelling.Parts{at: ?SEQUENCE_PARTS[20], len: 2}},
    spelling.Step{row: gen_row.LW, parts: spelling.Parts{at: ?SEQUENCE_PARTS[22], len: 3}},
};

# `la` is `lla` without pic and a load from the global offset table with it (riscv-asm.md, "Pseudoinstructions")
val UNDER_NOPIC: [1]mode.Setting = [1]mode.Setting{mode.Setting{mode: ?riscv_mode.POSITION, value: ?riscv_mode.NOPIC}};
val UNDER_PIC:   [1]mode.Setting = [1]mode.Setting{mode.Setting{mode: ?riscv_mode.POSITION, value: ?riscv_mode.PIC}};

# the pseudo instructions of several instructions, every one's first an auipc, in the printer's preference: `call
# target` before `call rd, target` so a call through ra prints the short form, and `lla` before the `la` it is without
# pic. `la` under pic loads by the xlen, the selection admitting ld at rv64 and only lw at rv32
pub val SEQUENCES: [7]spelling.Sequence = [7]spelling.Sequence{
    spelling.Sequence{template: "call <0>", operands: row.Operands{at: ?SEQUENCE_OPERANDS[0], len: 1}, steps: spelling.Steps{at: ?SEQUENCE_STEPS[0], len: 2}, when: mode.NONE},
    spelling.Sequence{template: "call <0>, <1>", operands: row.Operands{at: ?SEQUENCE_OPERANDS[1], len: 2}, steps: spelling.Steps{at: ?SEQUENCE_STEPS[2], len: 2}, when: mode.NONE},
    spelling.Sequence{template: "tail <0>", operands: row.Operands{at: ?SEQUENCE_OPERANDS[0], len: 1}, steps: spelling.Steps{at: ?SEQUENCE_STEPS[4], len: 2}, when: mode.NONE},
    spelling.Sequence{template: "lla <0>, <1>", operands: row.Operands{at: ?SEQUENCE_OPERANDS[3], len: 2}, steps: spelling.Steps{at: ?SEQUENCE_STEPS[6], len: 2}, when: mode.NONE},
    spelling.Sequence{template: "la <0>, <1>", operands: row.Operands{at: ?SEQUENCE_OPERANDS[3], len: 2}, steps: spelling.Steps{at: ?SEQUENCE_STEPS[6], len: 2}, when: mode.Settings{at: ?UNDER_NOPIC[0], len: 1}},
    spelling.Sequence{template: "la <0>, <1>", operands: row.Operands{at: ?SEQUENCE_OPERANDS[5], len: 2}, steps: spelling.Steps{at: ?SEQUENCE_STEPS[8], len: 2}, when: mode.Settings{at: ?UNDER_PIC[0], len: 1}},
    spelling.Sequence{template: "la <0>, <1>", operands: row.Operands{at: ?SEQUENCE_OPERANDS[5], len: 2}, steps: spelling.Steps{at: ?SEQUENCE_STEPS[10], len: 2}, when: mode.Settings{at: ?UNDER_PIC[0], len: 1}},
};

# the sequences in mnemonic order
val SEQUENCES_NAMED: [7]u32 = [7]u32{0, 1, 4, 5, 6, 3, 2};

# where each sequence is in SEQUENCES, so a pseudo instruction expands by the one table the printer and the parser read.
# LA is the first `la`, the others following it
pub val CALL:        u32 = 0;
pub val CALL_LINKED: u32 = 1;
pub val TAIL:        u32 = 2;
pub val LLA:         u32 = 3;
pub val LA:          u32 = 4;
pub val LA_COUNT:    u32 = 3;

# the vendor syntax
pub val SYNTAX: spelling.Syntax = spelling.Syntax{
    name:       "riscv",
    forms:      spelling.Forms{at: ?gen_syntax.FORM_TEXT[0], len: gen_syntax.FORM_COUNT},
    aliases:    spelling.Aliases{at: ?gen_syntax.ALIAS_ROWS[0], len: gen_syntax.ALIAS_COUNT},
    index:      spelling.Index{at: ?gen_syntax.ENTRIES[0], len: gen_syntax.ENTRY_COUNT, candidates: ?gen_syntax.CANDIDATES[0], count: gen_syntax.CANDIDATE_COUNT},
    specifiers: spelling.Specifiers{at: ?SPECIFIERS[0], len: 15},
    sequences:  spelling.Sequences{at: ?SEQUENCES[0], len: 7, named: ?SEQUENCES_NAMED[0]},
    hooks:      spelling.Hooks{immediate: ?IMMEDIATE, memory: nil, list: nil, id: ?ID, literal: nil},
    register:   "",
    aliased:    true,
    join:       "",
    variadic:   ", ",
    fold:       true,
    anonymous:  ".Ltmp",
};
