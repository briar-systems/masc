# the risc-v assembly syntax, the vendor dialect
#
# every row's template, the respelling aliases and the index by mnemonic are
# generated from riscv-opcodes and the reviewed dialect (gen_syntax). what is
# written here is what the generator cannot state: the specifiers that give a
# symbol its fixup kind, and the hooks for the operands the framework does not
# spell from a table, immediates, which also read a vector type as its fields
# and c.lui's immediate as the bits lui loads, and csrs, which are names of the
# csr id space. the pseudo instructions of several instructions, call, tail,
# lla and la, which riscv-opcodes does not hold, are the overlay's sequences
# topic, generated as gen_sequence.
#
# registers are written by their abi names and read by those or their x, f
# and v names. mnemonics, names and specifiers read without regard to case.

use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;
use std.types.view.view_eq_str;

use masc.core.diagnostic;
use masc.core.field;
use masc.core.operand;
use masc.core.state;
use core_syntax: masc.core.syntax;
use masc.syntax.expr;
use masc.syntax.read;
use masc.syntax.write;

use riscv_csr:   masc.isa.riscv.csr;
use riscv_fixup: masc.isa.riscv.fixup;
use riscv_vtype: masc.isa.riscv.vtype;

use masc.isa.riscv.gen_csr;
use masc.isa.riscv.gen_sequence;
use masc.isa.riscv.gen_syntax;

# the high twenty bits of `v` that `lui` holds, rounded so the low twelve bits add as signed
fun fold_hi(v: i64) i64 {
    ret ((v + 0x800) >> 12) & 0xFFFFF;
}

# the low twelve bits of `v` as the signed offset an I or S type instruction adds
fun fold_lo(v: i64) i64 {
    ret ((v & 0xFFF) ^ 0x800) - 0x800;
}

# the specifiers, from the psABI's assembly notation for relocations (riscv-elf.adoc, "Relocation Operators"). %tprel_add and %tlsdesc_call mark an
# instruction that holds no symbol of its own, so they apply to a marker operand, which takes no kind by default
val SPECIFIERS: [17]core_syntax.Specifier = [17]core_syntax.Specifier{
    core_syntax.Specifier{template: "%hi(<0>)", operand: riscv_fixup.HI20, fixup: riscv_fixup.HI20, fold: fold_hi},
    core_syntax.Specifier{template: "%lo(<0>)", operand: riscv_fixup.LO12_I, fixup: riscv_fixup.LO12_I, fold: fold_lo},
    core_syntax.Specifier{template: "%lo(<0>)", operand: riscv_fixup.LO12_S, fixup: riscv_fixup.LO12_S, fold: fold_lo},
    core_syntax.Specifier{template: "%pcrel_hi(<0>)", operand: riscv_fixup.PCREL_HI20, fixup: riscv_fixup.PCREL_HI20, fold: nil},
    core_syntax.Specifier{template: "%pcrel_lo(<0>)", operand: riscv_fixup.LO12_I, fixup: riscv_fixup.PCREL_LO12_I, fold: nil},
    core_syntax.Specifier{template: "%pcrel_lo(<0>)", operand: riscv_fixup.LO12_S, fixup: riscv_fixup.PCREL_LO12_S, fold: nil},
    core_syntax.Specifier{template: "%got_pcrel_hi(<0>)", operand: riscv_fixup.PCREL_HI20, fixup: riscv_fixup.GOT_PCREL_HI20, fold: nil},
    core_syntax.Specifier{template: "%tprel_hi(<0>)", operand: riscv_fixup.HI20, fixup: riscv_fixup.TPREL_HI20, fold: nil},
    core_syntax.Specifier{template: "%tprel_lo(<0>)", operand: riscv_fixup.LO12_I, fixup: riscv_fixup.TPREL_LO12_I, fold: nil},
    core_syntax.Specifier{template: "%tprel_lo(<0>)", operand: riscv_fixup.LO12_S, fixup: riscv_fixup.TPREL_LO12_S, fold: nil},
    core_syntax.Specifier{template: "%tls_ie_pcrel_hi(<0>)", operand: riscv_fixup.PCREL_HI20, fixup: riscv_fixup.TLS_GOT_PCREL_HI20, fold: nil},
    core_syntax.Specifier{template: "%tls_gd_pcrel_hi(<0>)", operand: riscv_fixup.PCREL_HI20, fixup: riscv_fixup.TLS_GD_PCREL_HI20, fold: nil},
    core_syntax.Specifier{template: "%tlsdesc_hi(<0>)", operand: riscv_fixup.PCREL_HI20, fixup: riscv_fixup.TLSDESC_HI20, fold: nil},
    core_syntax.Specifier{template: "%tlsdesc_load_lo(<0>)", operand: riscv_fixup.LO12_I, fixup: riscv_fixup.TLSDESC_PCREL_LOAD_LO12, fold: nil},
    core_syntax.Specifier{template: "%tlsdesc_add_lo(<0>)", operand: riscv_fixup.LO12_I, fixup: riscv_fixup.TLSDESC_PCREL_ADD_LO12, fold: nil},
    core_syntax.Specifier{template: "%tprel_add(<0>)", operand: operand.NO_FIXUP, fixup: riscv_fixup.TPREL_ADD, fold: nil},
    core_syntax.Specifier{template: "%tlsdesc_call(<0>)", operand: operand.NO_FIXUP, fixup: riscv_fixup.TLSDESC_PCREL_CALL, fold: nil},
};

# a vector type: a number, or its fields as riscv_vtype reads them
fun vtype_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val c: u8 = read.peek(r);
    if (c >= '0' && c <= '9') { ret expr.IMMEDIATE.parse(r, desc, format, out); }
    val got: opt[riscv_vtype.Read] = riscv_vtype.read(View{data: ?r.text[r.at], len: r.end - r.at});
    if (sel got.none) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.NOT_A_MEMBER, r.at, read.token(r, r.at))}; }
    val bits: opt[u64] = riscv_vtype.encode(got.some.vtype);
    if (sel bits.none) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.NOT_A_MEMBER, r.at, got.some.len)}; }
    r.at = r.at + got.some.len;
    @out = operand.Value.immediate{bits.some::i64};
    ret err[diagnostic.Diagnostic].ok{};
}

# five pieces of text written in turn
fun texts(w: *core_syntax.Writer, a: str, b: str, c: str, d: str, e: str) err[field.Refusal] {
    val pieces: [5]str = [5]str{a, b, c, d, e};
    var i:      u32    = 0;
    for (i < 5) {
        val done: err[field.Refusal] = write.text(w, pieces[i]);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    ret err[field.Refusal].ok{};
}

# a vector type as its fields, or as a number when its bits are no vector type's
fun vtype_print(w: *core_syntax.Writer, value: *operand.Value) err[field.Refusal] {
    if (!sel value.immediate) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    val got: opt[riscv_vtype.Vtype] = riscv_vtype.decode(value.immediate:~u64);
    if (sel got.none) { ret write.decimal(w, value.immediate); }
    val v:    riscv_vtype.Vtype = got.some;
    val bits: u64               = value.immediate:~u64;
    var tail: str               = ", tu, ";
    if (v.ta) { tail = ", ta, "; }
    var mask: str = "mu";
    if (v.ma) { mask = "ma"; }
    ret texts(w, riscv_vtype.SEW_NAMES[(bits >> 3) & 7], ", ", riscv_vtype.LMUL_NAMES[bits & 7], tail, mask);
}

# the bits lui loads, which c.lui writes its immediate as, the vendor tools reading and printing it so: twenty, the
# value being their sign extension
val LUI_BITS: i64 = 20;

pub val NOT_LUI: str = "not the twenty bits lui loads";

# an immediate written as the twenty bits lui loads, from 0 to 0xfffff, read as their sign extension, so c.lui's -1 is
# written 0xfffff
fun lui_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val at:  usize                      = r.at;
    val got: err[diagnostic.Diagnostic] = expr.IMMEDIATE.parse(r, desc, format, out);
    if (sel got.err)        { ret got; }
    if (!sel out.immediate) { ret got; }
    val v: i64 = out.immediate;
    if (v < 0 || v >= (1::i64 << LUI_BITS)) { ret err[diagnostic.Diagnostic].err{read.refuse(r, NOT_LUI, at, r.at - at)}; }
    if (v >= (1::i64 << (LUI_BITS - 1)))    { @out = operand.Value.immediate{v - (1::i64 << LUI_BITS)}; }
    ret got;
}

fun lui_print(w: *core_syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (!sel value.immediate) { ret expr.IMMEDIATE.print(w, desc, format, value); }
    ret write.decimal(w, value.immediate & ((1::i64 << LUI_BITS) - 1));
}

fun immediate_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (view_eq_str(format, "vtype")) { ret vtype_parse(r, desc, format, out); }
    if (view_eq_str(format, "lui"))   { ret lui_parse(r, desc, format, out); }
    ret expr.IMMEDIATE.parse(r, desc, format, out);
}

fun immediate_print(w: *core_syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (view_eq_str(format, "vtype")) { ret vtype_print(w, value); }
    if (view_eq_str(format, "lui"))   { ret lui_print(w, desc, format, value); }
    ret expr.IMMEDIATE.print(w, desc, format, value);
}

val IMMEDIATE: core_syntax.Hook = core_syntax.Hook{parse: immediate_parse, print: immediate_print};

# the csr named `name`, or none: a binary search of the table sorted by name
fun csr_named(syntax: *core_syntax.Syntax, name: View) opt[*riscv_csr.Csr] {
    var lo: u32 = 0;
    var hi: u32 = gen_csr.TABLE.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        val at:  str = gen_csr.TABLE.at[mid].name;
        val c:   i64 = core_syntax.compare(syntax, view(at, str_len(at)), name);
        if (c == 0) { ret opt[*riscv_csr.Csr].some{?gen_csr.TABLE.at[mid]}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret opt[*riscv_csr.Csr].none{};
}

# the first csr of number `n` the context admits, in the index sorted by number, none when no csr it admits has it.
# a nil context holds nothing, so it admits only the csrs that require nothing
fun csr_numbered(ctx: *state.Context, n: u32) opt[*riscv_csr.Csr] {
    var lo: u32 = 0;
    var hi: u32 = gen_csr.TABLE.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (gen_csr.TABLE.at[gen_csr.BY_NUMBER[mid]].number < n) { lo = mid + 1; }
        or                                                       { hi = mid; }
    }
    for (lo < gen_csr.TABLE.len) {
        val c: *riscv_csr.Csr = ?gen_csr.TABLE.at[gen_csr.BY_NUMBER[lo]];
        if (c.number != n)                                                        { ret opt[*riscv_csr.Csr].none{}; }
        if (c.requires.len == 0 || (ctx != nil && state.admits(ctx, c.requires))) { ret opt[*riscv_csr.Csr].some{c}; }
        lo = lo + 1;
    }
    ret opt[*riscv_csr.Csr].none{};
}

# a csr by its name, or by its number
fun id_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (!sel desc.shape.id)                     { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))}; }
    if (desc.shape.id.space != riscv_csr.SPACE) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))}; }
    val c: u8 = read.peek(r);
    if (c >= '0' && c <= '9') {
        val n: res[i64, diagnostic.Diagnostic] = read.number(r);
        if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
        @out = operand.Value.id{n.ok::u32};
        ret err[diagnostic.Diagnostic].ok{};
    }
    val at:  usize = r.at;
    val len: usize = read.name(r);
    if (len == 0) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, at, read.token(r, at))}; }
    val found: opt[*riscv_csr.Csr] = csr_named(r.syntax, read.span(r, at, len));
    if (sel found.none)                            { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.NOT_A_MEMBER, at, len)}; }
    if (!state.admits(r.ctx, found.some.requires)) { ret err[diagnostic.Diagnostic].err{read.refuse_unmet(r, found.some.requires, at, len)}; }
    r.at = at + len;
    @out = operand.Value.id{found.some.number};
    ret err[diagnostic.Diagnostic].ok{};
}

# a csr by its first name the context admits, so the parser reads it back, or by its number when it has none
fun id_print(w: *core_syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (!sel value.id) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    val found: opt[*riscv_csr.Csr] = csr_numbered(w.ctx, value.id);
    if (sel found.none) { ret write.decimal(w, value.id::i64); }
    ret write.text(w, found.some.name);
}

val ID: core_syntax.Hook = core_syntax.Hook{parse: id_parse, print: id_print};

# the pseudo instructions of several instructions, generated from the sequences topic of the overlay (gen_sequence),
# every one's first an auipc, in the printer's preference: `call target` before `call rd, target` so a call through ra
# prints the short form, and `lla` before the `la` it is without pic. the two got loads of `la` hold at one width each
fwd masc.isa.riscv.gen_sequence.SEQUENCES;

# where each sequence is in SEQUENCES, so a pseudo instruction expands by the one table the printer and the parser read.
# LA is the first `la`, the others following it
fwd masc.isa.riscv.gen_sequence.CALL;
fwd masc.isa.riscv.gen_sequence.CALL_LINKED;
fwd masc.isa.riscv.gen_sequence.TAIL;
fwd masc.isa.riscv.gen_sequence.LLA;
fwd masc.isa.riscv.gen_sequence.LA;
fwd masc.isa.riscv.gen_sequence.LA_COUNT;

# the vendor syntax
pub val SYNTAX: core_syntax.Syntax = core_syntax.Syntax{
    name:       "riscv",
    forms:      core_syntax.Forms{at: ?gen_syntax.FORM_TEXT[0], len: gen_syntax.FORM_COUNT},
    aliases:    core_syntax.Aliases{at: ?gen_syntax.ALIAS_ROWS[0], len: gen_syntax.ALIAS_COUNT},
    index:      core_syntax.Index{at: ?gen_syntax.ENTRIES[0], len: gen_syntax.ENTRY_COUNT, candidates: ?gen_syntax.CANDIDATES[0], count: gen_syntax.CANDIDATE_COUNT},
    specifiers: core_syntax.Specifiers{at: ?SPECIFIERS[0], len: 17},
    sequences:  core_syntax.Sequences{at: ?gen_sequence.SEQUENCES[0], len: $length_of(gen_sequence.SEQUENCES)::u32, named: ?gen_sequence.SEQUENCES_NAMED[0]},
    hooks:      core_syntax.Hooks{immediate: ?IMMEDIATE, memory: nil, list: nil, id: ?ID, literal: nil},
    register:   "",
    aliased:    true,
    join:       "",
    variadic:   ", ",
    fold:       true,
    anonymous:  ".Ltmp",
    own:        ".Lpcrel_hi",
};
