# the risc-v vector type, as vsetvli and vsetivli set it and the vtype csr holds it
#
# a consumer that chooses a vector type states it as a `Vtype` and asks
# `grouping` how many registers each operand of a row covers under it and a
# context, which constraint.violated reads. the context's view resolves the
# implementation bounds the grouping needs: ELEN, the narrowest element width
# and VLEN, as the register file's quantities. the encoding is "csr:vtype[] encoding" in the
# riscv-isa-manual at 36fdac54a526 (src/unpriv/vector-common.adoc): vlmul in
# bits 2 to 0, vsew in bits 5 to 3, vta in bit 6 and vma in bit 7. the text
# is the vendor syntax's, `e32, m2, ta, ma`, every field after the element
# width optional.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;
use std.types.view.view_eq_str;

use masc.core.constraint;
use masc.core.quantity;
use masc.core.register;
use masc.core.row;
use masc.core.state;
use riscv_register: masc.isa.riscv.register;
use syntax_read:    masc.syntax.read;

# a vector type
# ---
# sew:  the selected element width in bits, 8, 16, 32 or 64
# lmul: the register group multiplier as a power of two exponent, -3 for 1/8 to 3 for 8
# ta:   whether tail elements are agnostic, undisturbed otherwise
# ma:   whether inactive elements are agnostic, undisturbed otherwise
pub rec Vtype {
    sew:  u16;
    lmul: i8;
    ta:   bool;
    ma:   bool;
}

# a vector type read from text, and the bytes of the text it covers
pub rec Read {
    vtype: Vtype;
    len:   usize;
}

# the names of the element widths by vsew, and of the multipliers by vlmul, the reserved vlmul 4 empty
pub val SEW_NAMES:  [4]str = [4]str{"e8", "e16", "e32", "e64"};
pub val LMUL_NAMES: [8]str = [8]str{"m1", "m2", "m4", "m8", "", "mf8", "mf4", "mf2"};

# the most a group's multiplier may be, 8 registers, from "Vector Operands" (emul_rsv) and "Vector Load/Store Width
# Encoding" (vector_ls_emul_rsv, EMUL past 8 reserved), which no implementation bound changes. the least is
# SEW_MIN/ELEN (vtype_lmul_fval) and the element widths run from SEW_MIN to ELEN, read from the context
val MOST: i8 = 3;

# the multiplier encodings a vector type may name, whatever the implementation
val LEAST_ENCODED: i8 = -3;

# the bits of `v`'s encoding, none when it names a width or multiplier no encoding has
pub fun encode(v: Vtype) opt[u64] {
    var sew: u64 = 0;
    for (sew < 4 && (8::u64 << sew) != v.sew::u64) {
        sew = sew + 1;
    }
    if (sew == 4 || v.lmul < LEAST_ENCODED || v.lmul > MOST) { ret opt[u64].none{}; }
    val lmul: u64 = (v.lmul::i64 & 7):~u64;
    var bits: u64 = lmul | (sew << 3);
    if (v.ta) { bits = bits | 0x40; }
    if (v.ma) { bits = bits | 0x80; }
    ret opt[u64].some{bits};
}

# the vector type encoded as `bits`, none for a reserved encoding: vlmul 4, vsew 4 to 7, or any bit past vma
pub fun decode(bits: u64) opt[Vtype] {
    val lmul: u64 = bits & 7;
    val sew:  u64 = (bits >> 3) & 7;
    if ((bits >> 8) != 0 || lmul == 4 || sew >= 4) { ret opt[Vtype].none{}; }
    var e: i8 = lmul::i8;
    if (lmul > 4) { e = e - 8; }
    ret opt[Vtype].some{Vtype{sew: (8::u64 << sew)::u16, lmul: e, ta: ((bits >> 6) & 1) != 0, ma: ((bits >> 7) & 1) != 0}};
}

# the length of the word `text` holds from `at`
fun word_at(text: View, at: usize) usize {
    var i: usize = at;
    for (i < text.len && (syntax_read.word(text.data[i]) || text.data[i] == '.' || text.data[i] == '$')) {
        i = i + 1;
    }
    ret i - at;
}

# the index of the name among `count` names `names` that is the word of `text` at `at`, -1 when none, an empty name never being one
fun named(text: View, at: usize, names: *str, count: u32) i64 {
    val w: View = View{data: ?text.data[at], len: word_at(text, at)};
    var i: u32  = 0;
    for (i < count) {
        if (names[i][0] != 0 && view_eq_str(w, names[i])) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

# the position past `, ` read at `at` in `text`, at itself when no comma is there
fun comma(text: View, at: usize) usize {
    var i: usize = at;
    for (i < text.len && syntax_read.blank(text.data[i])) {
        i = i + 1;
    }
    if (i >= text.len || text.data[i] != ',') { ret at; }
    i = i + 1;
    for (i < text.len && syntax_read.blank(text.data[i])) {
        i = i + 1;
    }
    ret i;
}

# the vector type `text` starts with, written `e32, m2, ta, ma` with every field after the element width optional, an
# absent field m1, tu or mu. none when it starts with no element width
pub fun read(text: View) opt[Read] {
    if (text.len == 0) { ret opt[Read].none{}; }
    val sew: i64 = named(text, 0, ?SEW_NAMES[0], 4);
    if (sew < 0) { ret opt[Read].none{}; }
    var v:    Vtype = Vtype{sew: (8::u64 << sew::u64)::u16, lmul: 0, ta: false, ma: false};
    var done: usize = word_at(text, 0);
    var at:   usize = comma(text, done);
    if (at != done) {
        val lmul: i64 = named(text, at, ?LMUL_NAMES[0], 8);
        if (lmul >= 0) {
            v.lmul = lmul::i8;
            if (lmul > 4) { v.lmul = v.lmul - 8; }
            done = at + word_at(text, at);
            at   = comma(text, done);
        }
    }
    val tails: [2]str = [2]str{"tu", "ta"};
    if (at != done) {
        val tail: i64 = named(text, at, ?tails[0], 2);
        if (tail >= 0) {
            v.ta = tail == 1;
            done = at + word_at(text, at);
            at   = comma(text, done);
        }
    }
    val masks: [2]str = [2]str{"mu", "ma"};
    if (at != done) {
        val mask: i64 = named(text, at, ?masks[0], 2);
        if (mask >= 0) {
            v.ma = mask == 1;
            done = at + word_at(text, at);
        }
    }
    ret opt[Read].some{Read{vtype: v, len: done}};
}

# the bits quantity `q` of the risc-v file is at its least under the view
fun least_bits(v: *register.Available, q: u8) u32 {
    ret riscv_register.FILE.quantities.at[q].unit * register.range(v, q).least;
}

# the bits quantity `q` of the risc-v file is at its most under the view
fun most_bits(v: *register.Available, q: u8) u32 {
    ret riscv_register.FILE.quantities.at[q].unit * register.range(v, q).most;
}

# the exponent of n, a power of two
fun log2(n: u32) i8 {
    var e: i8 = 0;
    for ((1::u32 << e::u32) < n) {
        e = e + 1;
    }
    ret e;
}

# the implementation bounds of a vector state under `ctx`, the vector type's element width and multiplier unset: element
# widths of SEW_MIN to ELEN, multipliers of SEW_MIN/ELEN to 8, and the least VLEN the context's view admits. ELEN is its
# most where the selection fixes none
pub fun bounds(ctx: *state.Context) constraint.State {
    val widest:    u32 = most_bits(ctx.view, riscv_register.ELEN);
    val narrowest: u32 = least_bits(ctx.view, riscv_register.SEW_MIN);
    ret constraint.State{element: 0, multiplier: 0, least: log2(narrowest) - log2(widest), most: MOST, narrowest: narrowest::u16, widest: widest::u16, length: least_bits(ctx.view, riscv_register.VLEN)};
}

# how many registers each operand of row `r` covers under `v` and the context `ctx`: constraint.Grouped.state when `v`
# has no encoding or sets a width or multiplier the context's implementation bounds reserve, and the first operand whose
# groups `v` reserves when one has
pub fun grouping(r: *row.Row, v: Vtype, ctx: *state.Context) constraint.Grouped {
    val bits: opt[u64] = encode(v);
    if (sel bits.none) { ret constraint.Grouped.state{}; }
    var s: constraint.State = bounds(ctx);
    s.element    = v.sew;
    s.multiplier = v.lmul;
    ret constraint.grouping(r.operands.at, r.operands.len, opt[constraint.State].some{s});
}
