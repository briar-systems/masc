val COLUMNS: [1]register.Column = [1]register.Column{
    register.Column{format: register.DWARF, numbers: ?NUMBERS[0], len: 105, numbered: index.Numbers{at: ?DWARF_NUMBERED[0], len: 105}},
};

# every row of the file as a register set, one bit per row, for what may read and write any register, as an instruction
# a source states by its encoding
pub val EVERY: [2]u64 = [2]u64{0xFFFF_FFFF_FFFF_FFFF, 0x1FF_FFFF_FFFF};

pub val FILE: register.File = register.File{
    quantities:  quantity.Quantities{at: ?QUANTITIES[0], len: 5},
    bindings:    quantity.Bindings{at: ?BINDINGS[0], len: 3},
    slot_count:  3,
    classes:     ?CLASSES[0], class_count: 4,
    class_names: index.Index{at: ?CLASS_NAMES[0], len: 4},
    registers:   ?REGISTERS[0], register_count: 105,
    aliases:     ?ALIASES[0], alias_count: 65,
    names:       index.Index{at: ?NAMES[0], len: 170},
    columns:     ?COLUMNS[0], column_count: 1,
};

#[testing]
fun t_names(name: str, id: register.Id) bool {
    val found: opt[register.Id] = register.named(?FILE, view(name, str_len(name)), false);
    if (sel found.none) { ret false; }
    ret found.some == id;
}

test every__the_set_of_every_row_holds_each_row_of_the_file_and_no_other {
    var held: u32 = 0;
    var i:    u32 = 0;
    for (i < 128) {
        if (((EVERY[i / 64] >> (i % 64)::u64) & 1) != 0) {
            if (i >= FILE.register_count) { ret 1; }
            held = held + 1;
        }
        i = i + 1;
    }
    if (held != FILE.register_count) { ret 2; }
    ret 0;
}

test identities__generated_handles_are_the_rows_they_name {
    if (!t_names("zero", gen_register.X0) || !t_names("ra", gen_register.X1) || !t_names("t1", gen_register.X6)) { ret 1; }
    if (!t_names("ft0", gen_register.F0) || !t_names("v1", gen_register.V1))                                     { ret 2; }
    if (?FILE.classes[gen_register.X_CLASS] != X)                                                                { ret 3; }
    ret 0;
}
