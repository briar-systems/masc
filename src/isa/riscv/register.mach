    register.Register{name: "x21", class: 0, number: 21, bank: 21, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.Requirement{at: ?BASE_I_ALT[0], len: 1}, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x22", class: 0, number: 22, bank: 22, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.Requirement{at: ?BASE_I_ALT[0], len: 1}, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x23", class: 0, number: 23, bank: 23, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.Requirement{at: ?BASE_I_ALT[0], len: 1}, extend: register.KEEP, reach: register.Reach.bank{}},
