# the risc-v register file: the integer, floating-point and vector registers,
# the control and status state floating-point and vector instructions read and
# write, their abi names, and their dwarf numbers
#
# sources, read as published:
#   riscv-elf-psabi-doc 48969b7: register convention (riscv-cc.adoc) and dwarf numbering (riscv-dwarf.adoc)
#   riscv-isa-manual 36fdac54a526: the csr numbers and fields (src/unpriv/f-st-ext.adoc, src/unpriv/vector-common.adoc), and
#     what a write leaves in the rest of its register (src/unpriv/rv64.adoc, src/unpriv/d-st-ext.adoc)
#   mach dev f6feee5: src/lang/target/isa/riscv/register.mach, the names the target already uses

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.view;

use masc.core.extension;
use masc.core.index;
use masc.core.quantity;
use masc.core.register;
use masc.core.requirement;
use riscv_extension: masc.isa.riscv.extension;

use masc.isa.riscv.gen_register;

# the quantities the file scales by, each bounded where the selection and the state fix it
# ---
# xlen:    an x register's width, 32 bits under xlen=32 and 64 under xlen=64 (src/unpriv/rv32.adoc, src/unpriv/rv64.adoc),
#          its domain reaching rv128's 128 bits, which no axis value states
# flen:    an f register's width, the widest format the selection holds (src/unpriv/d-st-ext.adoc and q-st-ext.adoc,
#          "NaN Boxing of Narrower Values"), f's 32 bits, d's 64 and q's 128, unfixed without f
# vlen:    a v register's width, at least what the widest zvl*b the selection holds states (src/unpriv/vector-common.adoc,
#          "Zvl*: Minimum Vector Length Standard Extensions"), up to the 65536 bits the vector chapter allows, the
#          implementation's choice within it
# elen:    the widest element a vector instruction may operate on, 32 bits with zve32x and 64 with zve64x
#          ("Zve*: Vector Extensions for Embedded Processors")
# sew_min: the narrowest element width vtype may set, 8 bits ("Vector Type Register, vtype")
val XLEN_32_ID:  [1]requirement.Id = [1]requirement.Id{riscv_extension.XLEN_32};
val XLEN_64_ID:  [1]requirement.Id = [1]requirement.Id{riscv_extension.XLEN_64};
val D_ID:        [1]requirement.Id = [1]requirement.Id{riscv_extension.D};
val Q_ID:        [1]requirement.Id = [1]requirement.Id{riscv_extension.Q};
val ZVE32X_ONE:  [1]requirement.Id = [1]requirement.Id{riscv_extension.ZVE32X};
val ZVE64X_ID:   [1]requirement.Id = [1]requirement.Id{riscv_extension.ZVE64X};
val ZVL32B_ID:   [1]requirement.Id = [1]requirement.Id{riscv_extension.ZVL32B};
val ZVL64B_ID:   [1]requirement.Id = [1]requirement.Id{riscv_extension.ZVL64B};
val ZVL128B_ID:  [1]requirement.Id = [1]requirement.Id{riscv_extension.ZVL128B};
val ZVL256B_ID:  [1]requirement.Id = [1]requirement.Id{riscv_extension.ZVL256B};
val ZVL512B_ID:  [1]requirement.Id = [1]requirement.Id{riscv_extension.ZVL512B};
val ZVL1024B_ID: [1]requirement.Id = [1]requirement.Id{riscv_extension.ZVL1024B};

val QUANTITY_WHEN: [13]requirement.Alternative = [13]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?XLEN_32_ID[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?XLEN_64_ID[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?F_ID[0], len: 1}, none: requirement.Ids{at: ?D_ID[0], len: 1}},
    requirement.Alternative{all: requirement.Ids{at: ?D_ID[0], len: 1}, none: requirement.Ids{at: ?Q_ID[0], len: 1}},
    requirement.Alternative{all: requirement.Ids{at: ?Q_ID[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ZVL32B_ID[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ZVL64B_ID[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ZVL128B_ID[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ZVL256B_ID[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ZVL512B_ID[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ZVL1024B_ID[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ZVE32X_ONE[0], len: 1}, none: requirement.Ids{at: ?ZVE64X_ID[0], len: 1}},
    requirement.Alternative{all: requirement.Ids{at: ?ZVE64X_ID[0], len: 1}, none: requirement.NO_IDS},
};

val XLEN_BOUNDS: [2]quantity.Bound = [2]quantity.Bound{
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[0], len: 1}, least: 1, most: 1},
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[1], len: 1}, least: 2, most: 2},
};

val FLEN_BOUNDS: [3]quantity.Bound = [3]quantity.Bound{
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[2], len: 1}, least: 1, most: 1},
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[3], len: 1}, least: 2, most: 2},
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[4], len: 1}, least: 4, most: 4},
};

val VLEN_BOUNDS: [6]quantity.Bound = [6]quantity.Bound{
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[5], len: 1}, least: 1, most: 2048},
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[6], len: 1}, least: 2, most: 2048},
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[7], len: 1}, least: 4, most: 2048},
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[8], len: 1}, least: 8, most: 2048},
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[9], len: 1}, least: 16, most: 2048},
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[10], len: 1}, least: 32, most: 2048},
};

val ELEN_BOUNDS: [2]quantity.Bound = [2]quantity.Bound{
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[11], len: 1}, least: 1, most: 1},
    quantity.Bound{when: requirement.Requirement{at: ?QUANTITY_WHEN[12], len: 1}, least: 2, most: 2},
};

# the quantities by index, so no consumer holds a position
pub val XLEN:    u8 = 0;
pub val FLEN:    u8 = 1;
pub val VLEN:    u8 = 2;
pub val ELEN:    u8 = 3;
pub val SEW_MIN: u8 = 4;

val QUANTITIES: [5]quantity.Quantity = [5]quantity.Quantity{
    quantity.Quantity{name: "xlen", unit: 32, domain: quantity.Domain.powers{quantity.Range{least: 1, most: 4}}, bounds: quantity.Bounds{at: ?XLEN_BOUNDS[0], len: 2}, register: quantity.NO_ROW},
    quantity.Quantity{name: "flen", unit: 32, domain: quantity.Domain.powers{quantity.Range{least: 1, most: 4}}, bounds: quantity.Bounds{at: ?FLEN_BOUNDS[0], len: 3}, register: quantity.NO_ROW},
    quantity.Quantity{name: "vlen", unit: 32, domain: quantity.Domain.powers{quantity.Range{least: 1, most: 2048}}, bounds: quantity.Bounds{at: ?VLEN_BOUNDS[0], len: 6}, register: quantity.NO_ROW},
    quantity.Quantity{name: "elen", unit: 32, domain: quantity.Domain.powers{quantity.Range{least: 1, most: 2}}, bounds: quantity.Bounds{at: ?ELEN_BOUNDS[0], len: 2}, register: quantity.NO_ROW},
    quantity.Quantity{name: "sew_min", unit: 8, domain: quantity.Domain.powers{quantity.Range{least: 1, most: 1}}, bounds: quantity.NO_BOUNDS, register: quantity.NO_ROW},
};

# each class's width names a slot, and each slot binds its quantity under every state: x by xlen, f by flen, v by vlen
val BINDINGS: [3]quantity.Binding = [3]quantity.Binding{
    quantity.Binding{slot: 0, when: requirement.NO_ALTERNATIVES, quantity: XLEN},
    quantity.Binding{slot: 1, when: requirement.NO_ALTERNATIVES, quantity: FLEN},
    quantity.Binding{slot: 2, when: requirement.NO_ALTERNATIVES, quantity: VLEN},
};

val CLASSES: [4]register.Class = [4]register.Class{
    register.Class{name: "x", kind: register.GENERAL, width: quantity.Scaled{fixed: 0, per: 32, scale: 0}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    register.Class{name: "f", kind: register.FLOAT, width: quantity.Scaled{fixed: 0, per: 32, scale: 1}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    register.Class{name: "v", kind: register.VECTOR, width: quantity.Scaled{fixed: 0, per: 32, scale: 2}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    register.Class{name: "csr", kind: register.SYSTEM, width: quantity.Scaled{fixed: 1, per: 0, scale: 0}, count: quantity.Scaled{fixed: 4096, per: 0, scale: 0}},
};

# the classes by name, so no consumer holds a position
pub val X: *register.Class = ?CLASSES[0];
pub val F: *register.Class = ?CLASSES[1];
pub val V: *register.Class = ?CLASSES[2];

# the classes of an operand of any general register, the general class being gen_register's X_CLASS
pub val GENERAL: [1]u16 = [1]u16{gen_register.X_CLASS};

# the control and status class. a csr is a row whose number is its twelve bit csr number, and a row is the run of bits the csr defines,
# each a piece of the class's one bit, so a field csr (fflags, frm, vxrm, vxsat) and the csr that holds it (fcsr, vcsr) share a bank
# and overlap exactly where their bits do
pub val CSR: *register.Class = ?CLASSES[3];

# the csr numbers of the state rows, the one place each is stated: the rows, the csr table and the debug numbers all read these.
# floating-point state is src/unpriv/f-st-ext.adoc, section "Floating-Point Control and Status Register", and vector state is
# src/unpriv/vector-common.adoc, sections "Vector Length", "Vector Start Index", and the fixed-point rounding and saturation registers.
# fflags and vxsat are flagged ACCRUED, since an instruction sets their bits and clears none ("Accrued Exception Flags" and "Vector
# Fixed-Point Saturation Flag"), and vl is flagged LENGTH, since the elements past it are the tail, which an instruction may leave
# undisturbed under either tail policy ("Vector Tail Agnostic and Vector Mask Agnostic")
pub val FFLAGS: u16 = 0x001;
pub val FRM:    u16 = 0x002;
pub val FCSR:   u16 = 0x003;
pub val VSTART: u16 = 0x008;
pub val VXSAT:  u16 = 0x009;
pub val VXRM:   u16 = 0x00A;
pub val VCSR:   u16 = 0x00F;
pub val VL:     u16 = 0xC20;
pub val VTYPE:  u16 = 0xC21;

# a csr's dwarf number is its csr number plus this, riscv-dwarf.adoc, section "DWARF Register Numbers": 4096 - 8191 are the csrs
val DWARF_CSR: u32 = 4096;

val CLASS_NAMES: [4]index.Entry = [4]index.Entry{
    index.Entry{key: "csr", row: 3},
    index.Entry{key: "f", row: 1},
    index.Entry{key: "v", row: 2},
    index.Entry{key: "x", row: 0},
};

# x16 to x31 exist under the i base alone (src/unpriv/rv32e.adoc)
val BASE_I_ID:  [1]requirement.Id          = [1]requirement.Id{riscv_extension.BASE_I};
val BASE_I_ALT: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?BASE_I_ID[0], len: 1}, none: requirement.NO_IDS}};

val F_ID:     [1]requirement.Id          = [1]requirement.Id{riscv_extension.F};
val F_ID_ALT: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?F_ID[0], len: 1}, none: requirement.NO_IDS}};

# the floating-point state exists with f or zfinx, whose restated rows have the semantics of the f rows and so round by
# frm and raise fflags (src/unpriv/zfinx.adoc, norm:Zfinx_x_regs), and whose fcsr accesses mstatus.fs no longer traps
# (norm:Zfinx_mstatus_fs_zero). zdinx, zhinx and zhinxmin imply zfinx
val ZFINX_ID:        [1]requirement.Id          = [1]requirement.Id{riscv_extension.ZFINX};
val FLOAT_STATE_ALT: [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?F_ID[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?ZFINX_ID[0], len: 1}, none: requirement.NO_IDS},
};

val ZVE32X_ID:     [1]requirement.Id          = [1]requirement.Id{riscv_extension.ZVE32X};
val ZVE32X_ID_ALT: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?ZVE32X_ID[0], len: 1}, none: requirement.NO_IDS}};

# what a write leaves in the rest of its bank. an x, f and v register is its whole bank, so a write through it has no
# rest and keeps, the one fact check admits there. under rv64 an x register is 64 bits wide and the w instructions
# sign-extend their 32-bit results through it (src/unpriv/rv64.adoc, "Register State" and "Integer Computational
# Instructions"), and a write of a narrower format into an f register nan-boxes it, writing all ones above the result
# (src/unpriv/d-st-ext.adoc, "NaN Boxing of Narrower Values"), so either write covers its whole register. a field
# csr is written through its own address alone and keeps the rest of the csr that holds it: frm and fflags within
# fcsr (src/unpriv/f-st-ext.adoc, "Floating-Point Control and Status Register"), and vxrm and vxsat within vcsr
# (src/unpriv/vector-common.adoc, "Vector Fixed-Point Rounding Mode (vxrm) Register" and "Vector Control and Status
# (vcsr) Register")
val REGISTERS: [105]register.Register = [105]register.Register{
    register.Register{name: "x0", class: 0, number: 0, bank: 0, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: register.ZERO, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x1", class: 0, number: 1, bank: 1, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x2", class: 0, number: 2, bank: 2, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: register.STACK, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x3", class: 0, number: 3, bank: 3, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x4", class: 0, number: 4, bank: 4, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x5", class: 0, number: 5, bank: 5, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x6", class: 0, number: 6, bank: 6, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x7", class: 0, number: 7, bank: 7, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x8", class: 0, number: 8, bank: 8, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x9", class: 0, number: 9, bank: 9, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x10", class: 0, number: 10, bank: 10, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x11", class: 0, number: 11, bank: 11, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x12", class: 0, number: 12, bank: 12, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x13", class: 0, number: 13, bank: 13, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x14", class: 0, number: 14, bank: 14, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x15", class: 0, number: 15, bank: 15, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x16", class: 0, number: 16, bank: 16, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.Requirement{at: ?BASE_I_ALT[0], len: 1}, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x17", class: 0, number: 17, bank: 17, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.Requirement{at: ?BASE_I_ALT[0], len: 1}, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x18", class: 0, number: 18, bank: 18, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.Requirement{at: ?BASE_I_ALT[0], len: 1}, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "x19", class: 0, number: 19, bank: 19, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.Requirement{at: ?BASE_I_ALT[0], len: 1}, extend: register.KEEP, reach: register.Reach.bank{}},
