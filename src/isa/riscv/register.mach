# the risc-v register file: the integer, floating-point and vector registers,
# the control and status state floating-point and vector instructions read and
# write, their abi names, and their dwarf numbers
#
# the generator reads the file from the registers topic of its riscv overlay
# (gen/data/riscv/registers.txt), each line citing where it is read from: the
# riscv-elf-psabi-doc for the register convention and the dwarf numbers, and
# the riscv-isa-manual for the widths, the csr numbers and fields, and what a
# write leaves in the rest of its register. it builds the file in memory, maps
# its rows against it, and writes it as gen_register, which this module
# forwards under the names it had.

# the quantities by index, so no consumer holds a position
fwd masc.isa.riscv.gen_register.XLEN;
fwd masc.isa.riscv.gen_register.FLEN;
fwd masc.isa.riscv.gen_register.VLEN;
fwd masc.isa.riscv.gen_register.ELEN;
fwd masc.isa.riscv.gen_register.SEW_MIN;

# the classes by name, so no consumer holds a position
fwd masc.isa.riscv.gen_register.X;
fwd masc.isa.riscv.gen_register.F;
fwd masc.isa.riscv.gen_register.V;

# the classes of an operand of any general register
fwd masc.isa.riscv.gen_register.GENERAL;

# the control and status class. a csr is a row whose number is its twelve bit csr number, and a row is the run of bits
# the csr defines, each a piece of the class's one bit, so a field csr (fflags, frm, vxrm, vxsat) and the csr that holds
# it (fcsr, vcsr) share a bank and overlap exactly where their bits do
fwd masc.isa.riscv.gen_register.CSR;

# the csr numbers of the state rows, the one place each is stated: the rows, the csr table and the debug numbers all
# read these
fwd FFLAGS: masc.isa.riscv.gen_register.FFLAGS_NUMBER;
fwd FRM:    masc.isa.riscv.gen_register.FRM_NUMBER;
fwd FCSR:   masc.isa.riscv.gen_register.FCSR_NUMBER;
fwd VSTART: masc.isa.riscv.gen_register.VSTART_NUMBER;
fwd VXSAT:  masc.isa.riscv.gen_register.VXSAT_NUMBER;
fwd VXRM:   masc.isa.riscv.gen_register.VXRM_NUMBER;
fwd VCSR:   masc.isa.riscv.gen_register.VCSR_NUMBER;
fwd VL:     masc.isa.riscv.gen_register.VL_NUMBER;
fwd VTYPE:  masc.isa.riscv.gen_register.VTYPE_NUMBER;
fwd VLENB:  masc.isa.riscv.gen_register.VLENB_NUMBER;

# every row of the file as a register set, one bit per row, for what may read and write any register, as an instruction
# a source states by its encoding
fwd masc.isa.riscv.gen_register.EVERY;

fwd masc.isa.riscv.gen_register.FILE;
