# the risc-v register file: the integer, floating-point and vector registers,
# their abi names, and their dwarf numbers
#
# sources, read as published:
#   riscv-elf-psabi-doc 48969b7: register convention (riscv-cc.adoc) and dwarf numbering (riscv-dwarf.adoc)
#   mach dev f6feee5: src/lang/target/isa/riscv/register.mach, the names the target already uses

use masc.core.extension;
use masc.core.index;
use masc.core.register;
use masc.core.requirement;
use riscv_extension: masc.isa.riscv.extension;

val XLEN_FIXES: [2]register.Fixing = [2]register.Fixing{
    register.Fixing{by: riscv_extension.RV32, multiplier: 1},
    register.Fixing{by: riscv_extension.RV64, multiplier: 2},
};

val FLEN_FIXES: [3]register.Fixing = [3]register.Fixing{
    register.Fixing{by: riscv_extension.F, multiplier: 1},
    register.Fixing{by: riscv_extension.D, multiplier: 2},
    register.Fixing{by: riscv_extension.Q, multiplier: 4},
};

val SCALES: [3]register.Scale = [3]register.Scale{
    register.Scale{name: "xlen", max: 4, fixes: register.Fixings{at: ?XLEN_FIXES[0], len: 2}},
    register.Scale{name: "flen", max: 4, fixes: register.Fixings{at: ?FLEN_FIXES[0], len: 3}},
    register.Scale{name: "vlen", max: 2048, fixes: register.Fixings{at: nil, len: 0}},
};

val CLASSES: [3]register.Class = [3]register.Class{
    register.Class{name: "x", kind: register.GENERAL, width: register.Scaled{fixed: 0, per: 32, scale: 0}, count: 32},
    register.Class{name: "f", kind: register.FLOAT, width: register.Scaled{fixed: 0, per: 32, scale: 1}, count: 32},
    register.Class{name: "v", kind: register.VECTOR, width: register.Scaled{fixed: 0, per: 32, scale: 2}, count: 32},
};

# the classes by name, so no consumer holds a position
pub val X: *register.Class = ?CLASSES[0];
pub val F: *register.Class = ?CLASSES[1];
pub val V: *register.Class = ?CLASSES[2];

val CLASS_NAMES: [3]index.Entry = [3]index.Entry{
    index.Entry{key: "f", row: 1},
    index.Entry{key: "v", row: 2},
    index.Entry{key: "x", row: 0},
};

val I_ID:     [1]requirement.Id  = [1]requirement.Id{riscv_extension.I};
val I_ID_ALT: [1]requirement.Ids = [1]requirement.Ids{requirement.Ids{at: ?I_ID[0], len: 1}};

val F_ID:     [1]requirement.Id  = [1]requirement.Id{riscv_extension.F};
val F_ID_ALT: [1]requirement.Ids = [1]requirement.Ids{requirement.Ids{at: ?F_ID[0], len: 1}};

val ZVE32X_ID:     [1]requirement.Id  = [1]requirement.Id{riscv_extension.ZVE32X};
val ZVE32X_ID_ALT: [1]requirement.Ids = [1]requirement.Ids{requirement.Ids{at: ?ZVE32X_ID[0], len: 1}};

