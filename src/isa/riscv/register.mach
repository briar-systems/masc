val COLUMNS: [1]register.Column = [1]register.Column{
    register.Column{format: register.DWARF, numbers: ?NUMBERS[0], len: 96, numbered: index.Index{at: ?DWARF_NUMBERED[0], len: 96}},
};

pub val FILE: register.File = register.File{
    scales:      ?SCALES[0], scale_count: 3,
    classes:     ?CLASSES[0], class_count: 3,
    class_names: index.Index{at: ?CLASS_NAMES[0], len: 3},
    registers:   ?REGISTERS[0], register_count: 96,
    ids:         index.Index{at: ?IDS[0], len: 96},
    aliases:     ?ALIASES[0], alias_count: 65,
    names:       index.Index{at: ?NAMES[0], len: 161},
    columns:     ?COLUMNS[0], column_count: 1,
};
