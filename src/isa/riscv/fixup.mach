# the risc-v fixup kinds and their binding to mink's relocation kinds
#
# a row's symbolic operand takes one of these kinds by default, and a
# specifier gives it another. each kind is bound to the neutral relocation
# kind it becomes, so the relocation numbers stay mink's. the kinds are those
# an instruction's operand can carry, TPREL_ADD and TLSDESC_PCREL_CALL being
# the markers an add and a jalr of a tls sequence carry as operands, RELAX, the marker that rides beside a
# call pair's relocation and lets the linker relax it, ALIGN, the marker of
# code alignment the linker realigns after relaxing, and the kinds of the data
# a builder relocates, with the pairs that relocate a difference of labels.

use std.types.bool.bool;

use riscv_kinds: mink.format.elf.reloc.riscv.kinds;
use mink.model.reloc;

use masc.core.fixup;
use masc.core.operand;

use riscv_mode: masc.isa.riscv.mode;

pub val HI20:                    operand.FixupKind = 1;
pub val LO12_I:                  operand.FixupKind = 2;
pub val LO12_S:                  operand.FixupKind = 3;
pub val PCREL_HI20:              operand.FixupKind = 4;
pub val PCREL_LO12_I:            operand.FixupKind = 5;
pub val PCREL_LO12_S:            operand.FixupKind = 6;
pub val GOT_PCREL_HI20:          operand.FixupKind = 7;
pub val TPREL_HI20:              operand.FixupKind = 8;
pub val TPREL_LO12_I:            operand.FixupKind = 9;
pub val TPREL_LO12_S:            operand.FixupKind = 10;
pub val TPREL_ADD:               operand.FixupKind = 11;
pub val TLS_GOT_PCREL_HI20:      operand.FixupKind = 12;
pub val TLS_GD_PCREL_HI20:       operand.FixupKind = 13;
pub val TLSDESC_HI20:            operand.FixupKind = 14;
pub val TLSDESC_PCREL_LOAD_LO12: operand.FixupKind = 15;
pub val TLSDESC_PCREL_ADD_LO12:  operand.FixupKind = 16;
pub val TLSDESC_PCREL_CALL:      operand.FixupKind = 17;
pub val BRANCH12:                operand.FixupKind = 18;
pub val JAL20:                   operand.FixupKind = 19;
pub val CALL_PAIR:               operand.FixupKind = 20;
pub val CALL_PLT_PAIR:           operand.FixupKind = 21;
pub val RVC_BRANCH:              operand.FixupKind = 22;
pub val RVC_JUMP:                operand.FixupKind = 23;
pub val RELAX:                   operand.FixupKind = 24;
pub val ALIGN:                   operand.FixupKind = 25;
pub val DATA32:                  operand.FixupKind = 26;
pub val DATA64:                  operand.FixupKind = 27;
pub val DATA32_PCREL:            operand.FixupKind = 28;
pub val ADD8:                    operand.FixupKind = 29;
pub val ADD16:                   operand.FixupKind = 30;
pub val ADD32:                   operand.FixupKind = 31;
pub val ADD64:                   operand.FixupKind = 32;
pub val SUB8:                    operand.FixupKind = 33;
pub val SUB16:                   operand.FixupKind = 34;
pub val SUB32:                   operand.FixupKind = 35;
pub val SUB64:                   operand.FixupKind = 36;
pub val SET_ULEB128:             operand.FixupKind = 37;
pub val SUB_ULEB128:             operand.FixupKind = 38;

# how many fixup kinds there are, which BINDINGS binds
pub val COUNT: u32 = 38;

# each fixup kind and the neutral relocation kind it becomes
pub val BINDINGS: [COUNT]fixup.Binding = [COUNT]fixup.Binding{
    fixup.Binding{fixup: HI20, kind: ?riscv_kinds.HI20},
    fixup.Binding{fixup: LO12_I, kind: ?riscv_kinds.LO12_I},
    fixup.Binding{fixup: LO12_S, kind: ?riscv_kinds.LO12_S},
    fixup.Binding{fixup: PCREL_HI20, kind: ?riscv_kinds.PCREL_HI20},
    fixup.Binding{fixup: PCREL_LO12_I, kind: ?riscv_kinds.PCREL_LO12_I},
    fixup.Binding{fixup: PCREL_LO12_S, kind: ?riscv_kinds.PCREL_LO12_S},
    fixup.Binding{fixup: GOT_PCREL_HI20, kind: ?riscv_kinds.GOT_PCREL_HI20},
    fixup.Binding{fixup: TPREL_HI20, kind: ?riscv_kinds.TPREL_HI20},
    fixup.Binding{fixup: TPREL_LO12_I, kind: ?riscv_kinds.TPREL_LO12_I},
    fixup.Binding{fixup: TPREL_LO12_S, kind: ?riscv_kinds.TPREL_LO12_S},
    fixup.Binding{fixup: TPREL_ADD, kind: ?riscv_kinds.TPREL_ADD},
    fixup.Binding{fixup: TLS_GOT_PCREL_HI20, kind: ?riscv_kinds.TLS_GOT_PCREL_HI20},
    fixup.Binding{fixup: TLS_GD_PCREL_HI20, kind: ?riscv_kinds.TLS_GD_PCREL_HI20},
    fixup.Binding{fixup: TLSDESC_HI20, kind: ?riscv_kinds.TLSDESC_HI20},
    fixup.Binding{fixup: TLSDESC_PCREL_LOAD_LO12, kind: ?riscv_kinds.TLSDESC_PCREL_LOAD_LO12},
    fixup.Binding{fixup: TLSDESC_PCREL_ADD_LO12, kind: ?riscv_kinds.TLSDESC_PCREL_ADD_LO12},
    fixup.Binding{fixup: TLSDESC_PCREL_CALL, kind: ?riscv_kinds.TLSDESC_PCREL_CALL},
    fixup.Binding{fixup: BRANCH12, kind: ?riscv_kinds.BRANCH12},
    fixup.Binding{fixup: JAL20, kind: ?riscv_kinds.JAL20},
    fixup.Binding{fixup: CALL_PAIR, kind: ?riscv_kinds.CALL_PAIR},
    fixup.Binding{fixup: CALL_PLT_PAIR, kind: ?riscv_kinds.CALL_PLT_PAIR},
    fixup.Binding{fixup: RVC_BRANCH, kind: ?riscv_kinds.RVC_BRANCH},
    fixup.Binding{fixup: RVC_JUMP, kind: ?riscv_kinds.RVC_JUMP},
    fixup.Binding{fixup: RELAX, kind: ?riscv_kinds.RELAX},
    fixup.Binding{fixup: ALIGN, kind: ?riscv_kinds.ALIGN},
    fixup.Binding{fixup: DATA32, kind: ?reloc.ABS32},
    fixup.Binding{fixup: DATA64, kind: ?reloc.ABS64},
    fixup.Binding{fixup: DATA32_PCREL, kind: ?reloc.PC32},
    fixup.Binding{fixup: ADD8, kind: ?riscv_kinds.ADD8},
    fixup.Binding{fixup: ADD16, kind: ?riscv_kinds.ADD16},
    fixup.Binding{fixup: ADD32, kind: ?riscv_kinds.ADD32},
    fixup.Binding{fixup: ADD64, kind: ?riscv_kinds.ADD64},
    fixup.Binding{fixup: SUB8, kind: ?riscv_kinds.SUB8},
    fixup.Binding{fixup: SUB16, kind: ?riscv_kinds.SUB16},
    fixup.Binding{fixup: SUB32, kind: ?riscv_kinds.SUB32},
    fixup.Binding{fixup: SUB64, kind: ?riscv_kinds.SUB64},
    fixup.Binding{fixup: SET_ULEB128, kind: ?riscv_kinds.SET_ULEB128},
    fixup.Binding{fixup: SUB_ULEB128, kind: ?riscv_kinds.SUB_ULEB128},
};

# whether a row field of fixup kind `kind` takes a symbol by a specifier alone, as it holds part of the symbol's value:
# an i or s type instruction's low twelve bits by `%lo`, `%pcrel_lo`, `%tprel_lo` or a tlsdesc low specifier, and a u
# type's high twenty by `%hi`, `%pcrel_hi` or a tprel, got, tls or tlsdesc high specifier. a bare symbol there is
# refused, and a register name is never read as one, as `addi a0, a1, a2`
pub fun specified(kind: operand.FixupKind) bool {
    ret kind == LO12_I || kind == LO12_S || kind == HI20 || kind == PCREL_HI20;
}

# how many fixup kinds cover a sequence or carry a marker
pub val SPAN_COUNT: u32 = 15;

# the relax policy: while the source is relaxed, R_RISCV_RELAX rides beside exactly these kinds, the ones the linker
# relaxes (psabi, "Linker Relaxation"), and nothing else, as no tls got or gd hi20, tlsdesc load, add or
# call, branch or compressed kind. the call and tail pairs' relocation patches the auipc and the jalr after it (psabi,
# R_RISCV_CALL_PLT and R_RISCV_RELAX)
pub val SPANS: [SPAN_COUNT]fixup.Span = [SPAN_COUNT]fixup.Span{
    fixup.Span{fixup: HI20, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: LO12_I, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: LO12_S, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: PCREL_HI20, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: PCREL_LO12_I, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: PCREL_LO12_S, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: GOT_PCREL_HI20, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: TPREL_HI20, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: TPREL_LO12_I, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: TPREL_LO12_S, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: TPREL_ADD, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: TLSDESC_HI20, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: JAL20, count: 1, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: CALL_PAIR, count: 2, marker: RELAX, when: riscv_mode.RELAXED},
    fixup.Span{fixup: CALL_PLT_PAIR, count: 2, marker: RELAX, when: riscv_mode.RELAXED},
};

# the high part of distance `d` an auipc holds, rounded so the low part's sign extension takes it back (psabi,
# R_RISCV_PCREL_HI20 "%pcrel_hi")
fun high(d: i64) i64 {
    ret ((d + 0x800) >> 12) & 0xfffff;
}

# the low part of distance `d`, sign extended from twelve bits (psabi, R_RISCV_PCREL_LO12_I and _S "%pcrel_lo")
fun low(d: i64) i64 {
    ret ((d & 0xfff) ^ 0x800) - 0x800;
}

# how many folds there are
pub val FOLD_COUNT: u32 = 3;

# the pc-relative pair to a label the assembler can measure, as `lla` to a local label, folds into its numbers when the
# source is not relaxed: the auipc's %pcrel_hi the high part of the distance from it, and the low
# part the instruction its %pcrel_lo names takes of that same distance
pub val FOLDS: [FOLD_COUNT]fixup.Fold = [FOLD_COUNT]fixup.Fold{
    fixup.Fold{fixup: PCREL_HI20, measure: fixup.SELF, anchor: operand.START, value: high},
    fixup.Fold{fixup: PCREL_LO12_I, measure: fixup.PARTNER, anchor: operand.START, value: low},
    fixup.Fold{fixup: PCREL_LO12_S, measure: fixup.PARTNER, anchor: operand.START, value: low},
};

# how many data fixups there are
pub val DATA_COUNT: u32 = 3;

# the data the psabi relocates: absolute words and doublewords, and pc-relative words
pub val DATA: [DATA_COUNT]fixup.Datum = [DATA_COUNT]fixup.Datum{
    fixup.Datum{basis: fixup.ABSOLUTE, width: 4, fixup: DATA32},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 8, fixup: DATA64},
    fixup.Datum{basis: fixup.RELATIVE, width: 4, fixup: DATA32_PCREL},
};

# how many difference pairs there are
pub val PAIR_COUNT: u32 = 5;

# the psabi's pairs for a difference of labels across code the linker relaxes, R_RISCV_ADD8 to R_RISCV_SUB64, and
# R_RISCV_SET_ULEB128 with R_RISCV_SUB_ULEB128 for an unsigned leb128. a signed leb128 takes none, so one across code
# the linker relaxes is refused
pub val PAIRS: [PAIR_COUNT]fixup.Pair = [PAIR_COUNT]fixup.Pair{
    fixup.Pair{width: 1, add: ADD8, sub: SUB8},
    fixup.Pair{width: 2, add: ADD16, sub: SUB16},
    fixup.Pair{width: 4, add: ADD32, sub: SUB32},
    fixup.Pair{width: 8, add: ADD64, sub: SUB64},
    fixup.Pair{width: 0, add: SET_ULEB128, sub: SUB_ULEB128, encoding: fixup.ULEB},
};

# how many parts there are
pub val PART_COUNT: u32 = 7;

# the parts of an address the psabi's address kinds hold: lui's and auipc's high twenty bits, the got slot's through
# got_pcrel_hi20, and the low twelve an i or s type instruction adds, a pcrel_lo12 naming the auipc of its high part
pub val PARTS: [PART_COUNT]fixup.Part = [PART_COUNT]fixup.Part{
    fixup.Part{fixup: HI20, piece: fixup.HIGH},
    fixup.Part{fixup: LO12_I, piece: fixup.LOW},
    fixup.Part{fixup: LO12_S, piece: fixup.LOW},
    fixup.Part{fixup: PCREL_HI20, piece: fixup.HIGH},
    fixup.Part{fixup: PCREL_LO12_I, piece: fixup.LOW},
    fixup.Part{fixup: PCREL_LO12_S, piece: fixup.LOW},
    fixup.Part{fixup: GOT_PCREL_HI20, piece: fixup.HIGH},
};
