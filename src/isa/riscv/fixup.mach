# the risc-v fixup kinds and their binding to mink's relocation kinds
#
# a row's symbolic operand takes one of these kinds by default, and a
# specifier gives it another. each kind is bound to the neutral relocation
# kind it becomes, so the relocation numbers stay mink's. the kinds are those
# an instruction's operand can carry, TPREL_ADD and TLSDESC_PCREL_CALL being
# the markers an add and a jalr of a tls sequence carry as operands, RELAX, the marker that rides beside a
# call pair's relocation and lets the linker relax it, ALIGN, the marker of
# code alignment the linker realigns after relaxing, and the kinds of the data
# a builder relocates, with the pairs that relocate a difference of labels.

use mink;

use masc.core.fixup;
use masc.core.operand;

pub val HI20:                    operand.FixupKind = 1;
pub val LO12_I:                  operand.FixupKind = 2;
pub val LO12_S:                  operand.FixupKind = 3;
pub val PCREL_HI20:              operand.FixupKind = 4;
pub val PCREL_LO12_I:            operand.FixupKind = 5;
pub val PCREL_LO12_S:            operand.FixupKind = 6;
pub val GOT_PCREL_HI20:          operand.FixupKind = 7;
pub val TPREL_HI20:              operand.FixupKind = 8;
pub val TPREL_LO12_I:            operand.FixupKind = 9;
pub val TPREL_LO12_S:            operand.FixupKind = 10;
pub val TPREL_ADD:               operand.FixupKind = 11;
pub val TLS_GOT_PCREL_HI20:      operand.FixupKind = 12;
pub val TLS_GD_PCREL_HI20:       operand.FixupKind = 13;
pub val TLSDESC_HI20:            operand.FixupKind = 14;
pub val TLSDESC_PCREL_LOAD_LO12: operand.FixupKind = 15;
pub val TLSDESC_PCREL_ADD_LO12:  operand.FixupKind = 16;
pub val TLSDESC_PCREL_CALL:      operand.FixupKind = 17;
pub val BRANCH12:                operand.FixupKind = 18;
pub val JAL20:                   operand.FixupKind = 19;
pub val CALL_PAIR:               operand.FixupKind = 20;
pub val CALL_PLT_PAIR:           operand.FixupKind = 21;
pub val RVC_BRANCH:              operand.FixupKind = 22;
pub val RVC_JUMP:                operand.FixupKind = 23;
pub val RELAX:                   operand.FixupKind = 24;
pub val ALIGN:                   operand.FixupKind = 25;
pub val DATA32:                  operand.FixupKind = 26;
pub val DATA64:                  operand.FixupKind = 27;
pub val DATA32_PCREL:            operand.FixupKind = 28;
pub val ADD8:                    operand.FixupKind = 29;
pub val ADD16:                   operand.FixupKind = 30;
pub val ADD32:                   operand.FixupKind = 31;
pub val ADD64:                   operand.FixupKind = 32;
pub val SUB8:                    operand.FixupKind = 33;
pub val SUB16:                   operand.FixupKind = 34;
pub val SUB32:                   operand.FixupKind = 35;
pub val SUB64:                   operand.FixupKind = 36;

# how many fixup kinds there are, which BINDINGS binds
pub val COUNT: u32 = 36;

# each fixup kind and the neutral relocation kind it becomes
pub val BINDINGS: [COUNT]fixup.Binding = [COUNT]fixup.Binding{
    fixup.Binding{fixup: HI20, kind: ?mink.reloc.HI20},
    fixup.Binding{fixup: LO12_I, kind: ?mink.reloc.LO12_I},
    fixup.Binding{fixup: LO12_S, kind: ?mink.reloc.LO12_S},
    fixup.Binding{fixup: PCREL_HI20, kind: ?mink.reloc.PCREL_HI20},
    fixup.Binding{fixup: PCREL_LO12_I, kind: ?mink.reloc.PCREL_LO12_I},
    fixup.Binding{fixup: PCREL_LO12_S, kind: ?mink.reloc.PCREL_LO12_S},
    fixup.Binding{fixup: GOT_PCREL_HI20, kind: ?mink.reloc.GOT_PCREL_HI20},
    fixup.Binding{fixup: TPREL_HI20, kind: ?mink.reloc.TPREL_HI20},
    fixup.Binding{fixup: TPREL_LO12_I, kind: ?mink.reloc.TPREL_LO12_I},
    fixup.Binding{fixup: TPREL_LO12_S, kind: ?mink.reloc.TPREL_LO12_S},
    fixup.Binding{fixup: TPREL_ADD, kind: ?mink.reloc.TPREL_ADD},
    fixup.Binding{fixup: TLS_GOT_PCREL_HI20, kind: ?mink.reloc.TLS_GOT_PCREL_HI20},
    fixup.Binding{fixup: TLS_GD_PCREL_HI20, kind: ?mink.reloc.TLS_GD_PCREL_HI20},
    fixup.Binding{fixup: TLSDESC_HI20, kind: ?mink.reloc.TLSDESC_HI20},
    fixup.Binding{fixup: TLSDESC_PCREL_LOAD_LO12, kind: ?mink.reloc.TLSDESC_PCREL_LOAD_LO12},
    fixup.Binding{fixup: TLSDESC_PCREL_ADD_LO12, kind: ?mink.reloc.TLSDESC_PCREL_ADD_LO12},
    fixup.Binding{fixup: TLSDESC_PCREL_CALL, kind: ?mink.reloc.TLSDESC_PCREL_CALL},
    fixup.Binding{fixup: BRANCH12, kind: ?mink.reloc.BRANCH12},
    fixup.Binding{fixup: JAL20, kind: ?mink.reloc.JAL20},
    fixup.Binding{fixup: CALL_PAIR, kind: ?mink.reloc.CALL_PAIR},
    fixup.Binding{fixup: CALL_PLT_PAIR, kind: ?mink.reloc.CALL_PLT_PAIR},
    fixup.Binding{fixup: RVC_BRANCH, kind: ?mink.reloc.RVC_BRANCH},
    fixup.Binding{fixup: RVC_JUMP, kind: ?mink.reloc.RVC_JUMP},
    fixup.Binding{fixup: RELAX, kind: ?mink.reloc.RELAX},
    fixup.Binding{fixup: ALIGN, kind: ?mink.reloc.ALIGN},
    fixup.Binding{fixup: DATA32, kind: ?mink.reloc.ABS32},
    fixup.Binding{fixup: DATA64, kind: ?mink.reloc.ABS64},
    fixup.Binding{fixup: DATA32_PCREL, kind: ?mink.reloc.PC32},
    fixup.Binding{fixup: ADD8, kind: ?mink.reloc.ADD8},
    fixup.Binding{fixup: ADD16, kind: ?mink.reloc.ADD16},
    fixup.Binding{fixup: ADD32, kind: ?mink.reloc.ADD32},
    fixup.Binding{fixup: ADD64, kind: ?mink.reloc.ADD64},
    fixup.Binding{fixup: SUB8, kind: ?mink.reloc.SUB8},
    fixup.Binding{fixup: SUB16, kind: ?mink.reloc.SUB16},
    fixup.Binding{fixup: SUB32, kind: ?mink.reloc.SUB32},
    fixup.Binding{fixup: SUB64, kind: ?mink.reloc.SUB64},
};

# how many fixup kinds cover a sequence
pub val SPAN_COUNT: u32 = 2;

# the call and tail pairs, whose relocation patches the auipc and the jalr after it, with the marker that lets the
# linker relax the pair (psabi, R_RISCV_CALL_PLT and R_RISCV_RELAX)
pub val SPANS: [SPAN_COUNT]fixup.Span = [SPAN_COUNT]fixup.Span{
    fixup.Span{fixup: CALL_PAIR, count: 2, marker: RELAX},
    fixup.Span{fixup: CALL_PLT_PAIR, count: 2, marker: RELAX},
};

# how many data fixups there are
pub val DATA_COUNT: u32 = 3;

# the data the psabi relocates: absolute words and doublewords, and pc-relative words
pub val DATA: [DATA_COUNT]fixup.Datum = [DATA_COUNT]fixup.Datum{
    fixup.Datum{basis: fixup.ABSOLUTE, width: 4, fixup: DATA32},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 8, fixup: DATA64},
    fixup.Datum{basis: fixup.RELATIVE, width: 4, fixup: DATA32_PCREL},
};

# how many difference pairs there are
pub val PAIR_COUNT: u32 = 4;

# the psabi's pairs for a difference of labels across code the linker relaxes, R_RISCV_ADD8 to R_RISCV_SUB64
pub val PAIRS: [PAIR_COUNT]fixup.Pair = [PAIR_COUNT]fixup.Pair{
    fixup.Pair{width: 1, add: ADD8, sub: SUB8},
    fixup.Pair{width: 2, add: ADD16, sub: SUB16},
    fixup.Pair{width: 4, add: ADD32, sub: SUB32},
    fixup.Pair{width: 8, add: ADD64, sub: SUB64},
};
