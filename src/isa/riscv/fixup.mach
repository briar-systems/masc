# the risc-v fixup kinds and their binding to mink's relocation kinds
#
# a row's symbolic operand takes one of these kinds by default, and a
# specifier gives it another. each kind is bound to the neutral relocation
# kind it becomes, so the relocation numbers stay mink's. the kinds are those
# an instruction's operand can carry, RELAX, the marker that rides beside a
# call pair's relocation and lets the linker relax it, ALIGN, the marker of
# code alignment the linker realigns after relaxing, and the kinds of the data
# a builder relocates.

use mink;

use masc.core.operand;
use masc.core.set;

pub val HI20:                    operand.FixupKind = 1;
pub val LO12_I:                  operand.FixupKind = 2;
pub val LO12_S:                  operand.FixupKind = 3;
pub val PCREL_HI20:              operand.FixupKind = 4;
pub val PCREL_LO12_I:            operand.FixupKind = 5;
pub val PCREL_LO12_S:            operand.FixupKind = 6;
pub val GOT_PCREL_HI20:          operand.FixupKind = 7;
pub val TPREL_HI20:              operand.FixupKind = 8;
pub val TPREL_LO12_I:            operand.FixupKind = 9;
pub val TPREL_LO12_S:            operand.FixupKind = 10;
pub val TPREL_ADD:               operand.FixupKind = 11;
pub val TLS_GOT_PCREL_HI20:      operand.FixupKind = 12;
pub val TLS_GD_PCREL_HI20:       operand.FixupKind = 13;
pub val TLSDESC_HI20:            operand.FixupKind = 14;
pub val TLSDESC_PCREL_LOAD_LO12: operand.FixupKind = 15;
pub val TLSDESC_PCREL_ADD_LO12:  operand.FixupKind = 16;
pub val TLSDESC_CALL:            operand.FixupKind = 17;
pub val BRANCH12:                operand.FixupKind = 18;
pub val JAL20:                   operand.FixupKind = 19;
pub val CALL_PAIR:               operand.FixupKind = 20;
pub val CALL_PLT_PAIR:           operand.FixupKind = 21;
pub val RVC_BRANCH:              operand.FixupKind = 22;
pub val RVC_JUMP:                operand.FixupKind = 23;
pub val RELAX:                   operand.FixupKind = 24;
pub val ALIGN:                   operand.FixupKind = 25;
pub val DATA32:                  operand.FixupKind = 26;
pub val DATA64:                  operand.FixupKind = 27;
pub val DATA32_PCREL:            operand.FixupKind = 28;

# how many fixup kinds there are, which BINDINGS binds
pub val COUNT: u32 = 28;

# each fixup kind and the neutral relocation kind it becomes
pub val BINDINGS: [COUNT]set.Binding = [COUNT]set.Binding{
    set.Binding{fixup: HI20, kind: ?mink.reloc.HI20},
    set.Binding{fixup: LO12_I, kind: ?mink.reloc.LO12_I},
    set.Binding{fixup: LO12_S, kind: ?mink.reloc.LO12_S},
    set.Binding{fixup: PCREL_HI20, kind: ?mink.reloc.PCREL_HI20},
    set.Binding{fixup: PCREL_LO12_I, kind: ?mink.reloc.PCREL_LO12_I},
    set.Binding{fixup: PCREL_LO12_S, kind: ?mink.reloc.PCREL_LO12_S},
    set.Binding{fixup: GOT_PCREL_HI20, kind: ?mink.reloc.GOT_PCREL_HI20},
    set.Binding{fixup: TPREL_HI20, kind: ?mink.reloc.TPREL_HI20},
    set.Binding{fixup: TPREL_LO12_I, kind: ?mink.reloc.TPREL_LO12_I},
    set.Binding{fixup: TPREL_LO12_S, kind: ?mink.reloc.TPREL_LO12_S},
    set.Binding{fixup: TPREL_ADD, kind: ?mink.reloc.TPREL_ADD},
    set.Binding{fixup: TLS_GOT_PCREL_HI20, kind: ?mink.reloc.TLS_GOT_PCREL_HI20},
    set.Binding{fixup: TLS_GD_PCREL_HI20, kind: ?mink.reloc.TLS_GD_PCREL_HI20},
    set.Binding{fixup: TLSDESC_HI20, kind: ?mink.reloc.TLSDESC_HI20},
    set.Binding{fixup: TLSDESC_PCREL_LOAD_LO12, kind: ?mink.reloc.TLSDESC_PCREL_LOAD_LO12},
    set.Binding{fixup: TLSDESC_PCREL_ADD_LO12, kind: ?mink.reloc.TLSDESC_PCREL_ADD_LO12},
    set.Binding{fixup: TLSDESC_CALL, kind: ?mink.reloc.TLSDESC_CALL},
    set.Binding{fixup: BRANCH12, kind: ?mink.reloc.BRANCH12},
    set.Binding{fixup: JAL20, kind: ?mink.reloc.JAL20},
    set.Binding{fixup: CALL_PAIR, kind: ?mink.reloc.CALL_PAIR},
    set.Binding{fixup: CALL_PLT_PAIR, kind: ?mink.reloc.CALL_PLT_PAIR},
    set.Binding{fixup: RVC_BRANCH, kind: ?mink.reloc.RVC_BRANCH},
    set.Binding{fixup: RVC_JUMP, kind: ?mink.reloc.RVC_JUMP},
    set.Binding{fixup: RELAX, kind: ?mink.reloc.RELAX},
    set.Binding{fixup: ALIGN, kind: ?mink.reloc.ALIGN},
    set.Binding{fixup: DATA32, kind: ?mink.reloc.ABS32},
    set.Binding{fixup: DATA64, kind: ?mink.reloc.ABS64},
    set.Binding{fixup: DATA32_PCREL, kind: ?mink.reloc.PC32},
};

# how many data fixups there are
pub val DATA_COUNT: u32 = 3;

# the data the psabi relocates: absolute words and doublewords, and pc-relative words
pub val DATA: [DATA_COUNT]set.Datum = [DATA_COUNT]set.Datum{
    set.Datum{basis: set.ABSOLUTE, width: 4, fixup: DATA32},
    set.Datum{basis: set.ABSOLUTE, width: 8, fixup: DATA64},
    set.Datum{basis: set.RELATIVE, width: 4, fixup: DATA32_PCREL},
};
