# the risc-v configuration state: the vector type vsetvli, vsetivli and vsetvl set
#
# the state's bits are the vtype csr's encoding (`masc.isa.riscv.vtype`), so
# it is read and printed in the vendor syntax, `e32, m2, ta, ma`, and a vector
# row's operands cover the register groups its sew and lmul make under the
# implementation bounds the context's view states. vsetvli and vsetivli set
# the vtype their immediate encodes, and vsetvl the one its rs2 holds, which
# no operand value states before run time.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.core.config;
use masc.core.constraint;
use masc.core.diagnostic;
use masc.core.effect;
use masc.core.extension;
use masc.core.footprint;
use masc.core.operand;
use masc.core.register;
use masc.core.row;
use masc.core.state;

use riscv_extension: masc.isa.riscv.extension;
use masc.isa.riscv.gen_register;
use masc.isa.riscv.gen_row;
use riscv_register: masc.isa.riscv.register;
use riscv_vtype:    masc.isa.riscv.vtype;

# the operand of vsetvli, vsetivli and vsetvl that states the vector type
val VTYPE_OPERAND: u8 = 2;

fun parse(text: View) opt[config.Parsed] {
    val got: opt[riscv_vtype.Read] = riscv_vtype.read(text);
    if (sel got.none) { ret opt[config.Parsed].none{}; }
    val bits: opt[u64] = riscv_vtype.encode(got.some.vtype);
    if (sel bits.none) { ret opt[config.Parsed].none{}; }
    ret opt[config.Parsed].some{config.Parsed{state: config.State{bits: bits.some}, len: got.some.len}};
}

fun append(out: *vector.Vector[u8], s: str) err[A.Error] {
    ret extension.append(out, s);
}

fun print(s: config.State, out: *vector.Vector[u8]) err[A.Error] {
    val got: opt[riscv_vtype.Vtype] = riscv_vtype.decode(s.bits);
    if (sel got.none) { ret append(out, "vill"); }
    var tail: str = ", tu, ";
    if (got.some.ta) { tail = ", ta, "; }
    var mask: str = "mu";
    if (got.some.ma) { mask = "ma"; }
    val pieces: [5]str = [5]str{riscv_vtype.SEW_NAMES[(s.bits >> 3) & 7], ", ", riscv_vtype.LMUL_NAMES[s.bits & 7], tail, mask};
    var i:      u32    = 0;
    for (i < 5) {
        val done: err[A.Error] = append(out, pieces[i]);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

fun grouping(s: config.State, r: *row.Row, ctx: *state.Context) constraint.Grouped {
    val got: opt[riscv_vtype.Vtype] = riscv_vtype.decode(s.bits);
    if (sel got.none) { ret constraint.Grouped.state{}; }
    ret riscv_vtype.grouping(r, got.some, ctx);
}

fun establish(r: *row.Row, values: operand.Values) config.Established {
    if (r != gen_row.VSETVLI && r != gen_row.VSETIVLI && r != gen_row.VSETVL) { ret config.Established.keeps{}; }
    val open: effect.Undecided = effect.Undecided.open{effect.Pending{rule: 0, operand: VTYPE_OPERAND}};
    if (r == gen_row.VSETVL || VTYPE_OPERAND::u32 >= values.len) { ret config.Established.undecided{open}; }
    val v: operand.Value = values.at[VTYPE_OPERAND];
    if (!sel v.immediate) { ret config.Established.undecided{open}; }
    ret config.Established.sets{config.State{bits: v.immediate:~u64}};
}

# the vector type as risc-v's configuration state
pub val HOOKS: config.Hooks = config.Hooks{name: "vtype", parse: parse, print: print, grouping: grouping, establish: establish};

#[testing]
fun t_reg(id: register.Id) operand.Value {
    ret operand.Value.register{id};
}

#[testing]
fun t_holds(fp: *footprint.Footprint, words: *vector.Vector[u64], id: register.Id) bool {
    ret register.bit(fp.file, words.data, words.len::u32, id);
}

# a vector add's groups follow the vtype in force: undecided with none, the registers e32, m2 forms under one, and
# vsetvli establishes the vtype its immediate encodes while vsetvl's is undecided
test footprint__a_vector_add_covers_the_groups_the_vtype_in_force_forms {
    var t: testing.Testing;
    testing.make(?t);
    val a:      *A.Allocator                              = testing.allocator_of(?t);
    val chosen: res[extension.Selection, extension.Error] = extension.select(a, ?riscv_extension.CATALOG, "rv64gcv", diagnostic.START);
    if (sel chosen.err) { ret 1; }
    var selection: extension.Selection              = chosen.ok;
    var view:      register.Available;
    val opened:    res[state.Context, state.Opened] = state.open(a, ?riscv_register.FILE, ?selection, ?riscv_extension.AXES, state.Settings{at: [state.MAX_AXES]u8{1, 0, 0, 0, 0, 0, 0, 0}}, ?view);
    if (sel opened.err) { ret 2; }
    var ctx:  state.Context                     = opened.ok;
    val made: res[footprint.Footprint, A.Error] = footprint.make(a, ?riscv_register.FILE);
    if (sel made.err) { ret 3; }
    var fp:    footprint.Footprint = made.ok;
    val e32m2: opt[config.Parsed]  = parse(View{data: "e32, m2, ta, ma", len: 15});
    if (sel e32m2.none) { ret 4; }
    var values: [4]operand.Value                                  = [4]operand.Value{t_reg(gen_register.V2), t_reg(gen_register.V4), t_reg(gen_register.V6), operand.enumerant(1)};
    val given:  operand.Values                                    = operand.Values{at: ?values[0], len: gen_row.VADD_VV.operands.len};
    val none:   res[effect.Answer[*footprint.Footprint], A.Error] = footprint.of(?fp, gen_row.VADD_VV, given, ?ctx, config.Configured{hooks: ?HOOKS, state: opt[config.State].none{}});
    if (sel none.err)           { ret 5; }
    if (!sel none.ok.undecided) { ret 6; }
    val why: effect.Undecided = none.ok.undecided;
    if (!sel why.configured) { ret 7; }
    val under: res[effect.Answer[*footprint.Footprint], A.Error] = footprint.of(?fp, gen_row.VADD_VV, given, ?ctx, config.Configured{hooks: ?HOOKS, state: opt[config.State].some{e32m2.some.state}});
    if (sel under.err)                                                                             { ret 8; }
    if (!sel under.ok.decided)                                                                     { ret 9; }
    if (!t_holds(?fp, ?fp.reads, gen_register.V5) || !t_holds(?fp, ?fp.reads, gen_register.V7))    { ret 10; }
    if (!t_holds(?fp, ?fp.written, gen_register.V3) || t_holds(?fp, ?fp.written, gen_register.V4)) { ret 11; }
    if (!footprint.kills(?fp, gen_register.V3) || footprint.kills(?fp, gen_register.V8))           { ret 12; }
    var out:     vector.Vector[u8] = vector.init[u8](a);
    val printed: err[A.Error]      = print(e32m2.some.state, ?out);
    if (sel printed.err || !extension.t_spelled(?out, "e32, m2, ta, ma")) { ret 13; }
    var set_values: [3]operand.Value   = [3]operand.Value{t_reg(gen_register.X10), t_reg(gen_register.X11), operand.Value.immediate{e32m2.some.state.bits:~i64}};
    val sets:       config.Established = establish(gen_row.VSETVLI, operand.Values{at: ?set_values[0], len: 3});
    if (!(sel sets.sets && sets.sets.bits == e32m2.some.state.bits)) { ret 14; }
    set_values[2] = t_reg(gen_register.X12);
    val by_register: config.Established = establish(gen_row.VSETVL, operand.Values{at: ?set_values[0], len: 3});
    val kept:        config.Established = establish(gen_row.VADD_VV, given);
    if (!sel by_register.undecided || !sel kept.keeps) { ret 15; }
    vector.dnit[u8](?out);
    footprint.release(?fp);
    val released: err[A.Error] = register.release(?view);
    extension.release(?selection);
    ret 0;
}
