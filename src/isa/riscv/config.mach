# the risc-v configuration state: the vector type and the vector length that
# vsetvli, vsetivli and vsetvl set
#
# the state's low eight bits are the vtype csr's encoding (`masc.isa.riscv.vtype`)
# and the bits above them the vector length, 0 for vlmax. it is read and
# printed in the vendor syntax, `e32, m2, ta, ma`, followed by `, vl 4` where
# the length is a count, and a vector row's operands cover the register groups
# its sew and lmul make under the implementation bounds the context's view
# states. vsetivli sets the vtype and the count its immediates encode, vsetvli
# with x0 as its requested length and another destination sets vlmax (rvv 1.0,
# section 6.2, "avl encoding"), and any other vsetvli and vsetvl set a length
# or a vtype a register holds, which no operand value states before run time.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use masc.core.config;
use masc.core.constraint;
use masc.core.extension;
use masc.core.operand;
use masc.core.row;
use masc.core.state;

use masc.core.query;
use masc.isa.riscv.gen_register;
use masc.isa.riscv.gen_row;
use masc.isa.riscv.gen_row_index;
use riscv_vtype: masc.isa.riscv.vtype;

# the operand of each row that states the vector type: vsetvli's third and
# vsetvl's third, a register, and vsetivli's second, as its row orders its
# operands by its encoding's fields, zimm10 before uimm, where its syntax
# writes the avl first
fun vtype_operand(r: *row.Row) u8 {
    if (r == ?gen_row.ROWS[gen_row_index.VSETIVLI]) { ret 1; }
    ret 2;
}

# the bits of the vtype in a state, below its length
val VTYPE: u64 = 0xff;

# the bits a state's length starts at
val LENGTH: u64 = 8;

# the vector length a state holds, 0 for vlmax
pub fun length(s: config.State) u64 {
    ret s.bits >> LENGTH;
}

# the vtype csr's encoding a state holds
pub fun vtype(s: config.State) u64 {
    ret s.bits & VTYPE;
}

# the state of a vtype's encoding and a vector length, 0 for vlmax
pub fun configured(vt: u64, vl: u64) config.State {
    ret config.State{bits: (vt & VTYPE) | (vl << LENGTH)};
}

fun digits(text: View, at: usize) usize {
    var i: usize = at;
    for (i < text.len && text.data[i] >= '0' && text.data[i] <= '9') {
        i = i + 1;
    }
    ret i - at;
}

fun parse(text: View) opt[config.Parsed] {
    val opt_read: opt[riscv_vtype.Read] = riscv_vtype.read(text);
    if (sel opt_read.none) { ret opt[config.Parsed].none{}; }
    val opt_bits: opt[u64] = riscv_vtype.encode(opt_read.some.vtype);
    if (sel opt_bits.none) { ret opt[config.Parsed].none{}; }
    val done: usize = opt_read.some.len;
    val at:   usize = done + 5;
    if (at < text.len && text.data[done] == ',' && text.data[done + 1] == ' ' && text.data[done + 2] == 'v' && text.data[done + 3] == 'l' && text.data[done + 4] == ' ') {
        val n: usize = digits(text, at);
        if (n > 0 && n < 10) {
            var vl: u64   = 0;
            var i:  usize = at;
            for (i < at + n) {
                vl = vl * 10 + (text.data[i] - '0')::u64;
                i  = i + 1;
            }
            if (vl != 0) { ret opt[config.Parsed].some{config.Parsed{state: configured(opt_bits.some, vl), len: at + n}}; }
        }
    }
    ret opt[config.Parsed].some{config.Parsed{state: configured(opt_bits.some, 0), len: done}};
}

fun append(out: *vector.Vector[u8], s: str) err[A.Error] {
    ret extension.append(out, s);
}

fun print(s: config.State, out: *vector.Vector[u8]) err[A.Error] {
    val opt_decode: opt[riscv_vtype.Vtype] = riscv_vtype.decode(vtype(s));
    if (sel opt_decode.none) { ret append(out, "vill"); }
    var tail: str = ", tu, ";
    if (opt_decode.some.ta) { tail = ", ta, "; }
    var mask: str = "mu";
    if (opt_decode.some.ma) { mask = "ma"; }
    val pieces: [5]str = [5]str{riscv_vtype.SEW_NAMES[(s.bits >> 3) & 7], ", ", riscv_vtype.LMUL_NAMES[s.bits & 7], tail, mask};
    var i:      u32    = 0;
    for (i < 5) {
        val err_done: err[A.Error] = append(out, pieces[i]);
        if (sel err_done.err) { ret err_done; }
        i = i + 1;
    }
    val vl: u64 = length(s);
    if (vl == 0) { ret err[A.Error].ok{}; }
    val err_named: err[A.Error] = append(out, ", vl ");
    if (sel err_named.err) { ret err_named; }
    var text: [20]u8;
    var n:    usize = 0;
    var left: u64   = vl;
    for (left != 0) {
        text[n] = ('0'::u64 + left % 10)::u8;
        left    = left / 10;
        n       = n + 1;
    }
    for (n > 0) {
        n = n - 1;
        val res_digit: res[usize, A.Error] = vector.push[u8](out, text[n]);
        if (sel res_digit.err) { ret err[A.Error].err{res_digit.err}; }
    }
    ret err[A.Error].ok{};
}

fun grouping(s: config.State, r: *row.Row, ctx: *state.Context) constraint.Grouped {
    val opt_decode: opt[riscv_vtype.Vtype] = riscv_vtype.decode(vtype(s));
    if (sel opt_decode.none) { ret constraint.Grouped.state{}; }
    ret riscv_vtype.grouping(r, opt_decode.some, ctx);
}

fun establish(r: *row.Row, values: operand.Values) config.Established {
    if (r != ?gen_row.ROWS[gen_row_index.VSETVLI] && r != ?gen_row.ROWS[gen_row_index.VSETIVLI] && r != ?gen_row.ROWS[gen_row_index.VSETVL]) { ret config.Established.keeps{}; }
    val at:   u8              = vtype_operand(r);
    val open: query.Undecided = query.Undecided.open{query.Pending{rule: 0, operand: at}};
    if (r == ?gen_row.ROWS[gen_row_index.VSETVL] || at::u32 >= values.len) { ret config.Established.undecided{open}; }
    val v: operand.Value = values.at[at];
    if (!sel v.immediate) { ret config.Established.undecided{open}; }
    val vt: u64 = v.immediate:~u64;
    if (r == ?gen_row.ROWS[gen_row_index.VSETIVLI]) {
        val n: operand.Value = values.at[2];
        if (!sel n.immediate) { ret config.Established.undecided{open}; }
        if (n.immediate == 0) { ret config.Established.undecided{open}; }
        ret config.Established.sets{configured(vt, n.immediate:~u64)};
    }
    # vsetvli rd, rs1, vtype: vlmax where rs1 is x0 and rd is not
    val rd:  operand.Value = values.at[0];
    val rs1: operand.Value = values.at[1];
    if (!sel rd.register)                { ret config.Established.undecided{open}; }
    if (!sel rs1.register)               { ret config.Established.undecided{open}; }
    if (rs1.register != gen_register.X0) { ret config.Established.undecided{open}; }
    if (rd.register == gen_register.X0)  { ret config.Established.undecided{open}; }
    ret config.Established.sets{configured(vt, 0)};
}

# the vector type as risc-v's configuration state
pub val HOOKS: config.Hooks = config.Hooks{name: "vtype", parse: parse, print: print, grouping: grouping, establish: establish};
