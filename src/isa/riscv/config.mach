# the risc-v configuration state: the vector type vsetvli, vsetivli and vsetvl set
#
# the state's bits are the vtype csr's encoding (`masc.isa.riscv.vtype`), so
# it is read and printed in the vendor syntax, `e32, m2, ta, ma`, and a vector
# row's operands cover the register groups its sew and lmul make under the
# implementation bounds the context's view states. vsetvli and vsetivli set
# the vtype their immediate encodes, and vsetvl the one its rs2 holds, which
# no operand value states before run time.

use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use masc.core.config;
use masc.core.constraint;
use masc.core.extension;
use masc.core.operand;
use masc.core.row;
use masc.core.state;

use masc.core.query;
use masc.isa.riscv.gen_row;
use masc.isa.riscv.gen_row_index;
use riscv_vtype: masc.isa.riscv.vtype;

# the operand of each row that states the vector type: vsetvli's third and
# vsetvl's third, a register, and vsetivli's second, as its row orders its
# operands by its encoding's fields, zimm10 before uimm, where its syntax
# writes the avl first
fun vtype_operand(r: *row.Row) u8 {
    if (r == ?gen_row.ROWS[gen_row_index.VSETIVLI]) { ret 1; }
    ret 2;
}

fun parse(text: View) opt[config.Parsed] {
    val opt_read: opt[riscv_vtype.Read] = riscv_vtype.read(text);
    if (sel opt_read.none) { ret opt[config.Parsed].none{}; }
    val opt_bits: opt[u64] = riscv_vtype.encode(opt_read.some.vtype);
    if (sel opt_bits.none) { ret opt[config.Parsed].none{}; }
    ret opt[config.Parsed].some{config.Parsed{state: config.State{bits: opt_bits.some}, len: opt_read.some.len}};
}

fun append(out: *vector.Vector[u8], s: str) err[A.Error] {
    ret extension.append(out, s);
}

fun print(s: config.State, out: *vector.Vector[u8]) err[A.Error] {
    val opt_decode: opt[riscv_vtype.Vtype] = riscv_vtype.decode(s.bits);
    if (sel opt_decode.none) { ret append(out, "vill"); }
    var tail: str = ", tu, ";
    if (opt_decode.some.ta) { tail = ", ta, "; }
    var mask: str = "mu";
    if (opt_decode.some.ma) { mask = "ma"; }
    val pieces: [5]str = [5]str{riscv_vtype.SEW_NAMES[(s.bits >> 3) & 7], ", ", riscv_vtype.LMUL_NAMES[s.bits & 7], tail, mask};
    var i:      u32    = 0;
    for (i < 5) {
        val err_done: err[A.Error] = append(out, pieces[i]);
        if (sel err_done.err) { ret err_done; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

fun grouping(s: config.State, r: *row.Row, ctx: *state.Context) constraint.Grouped {
    val opt_decode: opt[riscv_vtype.Vtype] = riscv_vtype.decode(s.bits);
    if (sel opt_decode.none) { ret constraint.Grouped.state{}; }
    ret riscv_vtype.grouping(r, opt_decode.some, ctx);
}

fun establish(r: *row.Row, values: operand.Values) config.Established {
    if (r != ?gen_row.ROWS[gen_row_index.VSETVLI] && r != ?gen_row.ROWS[gen_row_index.VSETIVLI] && r != ?gen_row.ROWS[gen_row_index.VSETVL]) { ret config.Established.keeps{}; }
    val at:   u8              = vtype_operand(r);
    val open: query.Undecided = query.Undecided.open{query.Pending{rule: 0, operand: at}};
    if (r == ?gen_row.ROWS[gen_row_index.VSETVL] || at::u32 >= values.len) { ret config.Established.undecided{open}; }
    val v: operand.Value = values.at[at];
    if (!sel v.immediate) { ret config.Established.undecided{open}; }
    ret config.Established.sets{config.State{bits: v.immediate:~u64}};
}

# the vector type as risc-v's configuration state
pub val HOOKS: config.Hooks = config.Hooks{name: "vtype", parse: parse, print: print, grouping: grouping, establish: establish};
