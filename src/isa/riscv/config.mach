# the risc-v configuration state: the vector type and the vector length that
# vsetvli, vsetivli and vsetvl set
#
# the state's low eight bits are the vtype csr's encoding (`masc.isa.riscv.vtype`)
# and the bits above them the vector length, 0 for vlmax and UNSTATED for one no
# operand value states. it is read and printed in the vendor syntax, `e32, m2,
# ta, ma`, followed by `, vl 4` where the length is a count and `, vl unstated`
# where it is unstated, and a vector row's operands cover the register groups
# its sew and lmul make under the implementation bounds the context's view
# states. vsetivli sets the vtype and the count its immediates encode, vsetvli
# with x0 as its requested length and another destination sets vlmax (rvv 1.0,
# section 6.2, "avl encoding"), and any other vsetvli and vsetvl set a length
# or a vtype a register holds, which no operand value states before run time.
# any other row the tables state writing vl, as a fault-only-first load, keeps
# the vtype and leaves the length unstated ("unit-stride fault-only-first loads").

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view_eq_str;

use A: std.allocator;
use std.collections.vector;

use masc.core.config;
use masc.core.constraint;
use masc.core.effect;
use masc.core.extension;
use masc.core.operand;
use masc.core.row;
use masc.core.state;

use masc.core.query;
use masc.isa.riscv.gen_field;
use masc.isa.riscv.gen_register;
use masc.isa.riscv.gen_row;
use masc.isa.riscv.gen_row_index;
use riscv_vtype: masc.isa.riscv.vtype;

# the operand of each row that states the vector type: vsetvli's third and
# vsetvl's third, a register, and vsetivli's second, as its row orders its
# operands by its encoding's fields, zimm10 before uimm, where its syntax
# writes the avl first
fun vtype_operand(r: *row.Row) u8 {
    if (r == ?gen_row.ROWS[gen_row_index.VSETIVLI]) { ret 1; }
    ret 2;
}

# the text a state's unstated length is spelled with
val UNSTATED_NAME: str = "unstated";

# the bits of the vtype in a state, below its length
val VTYPE: u64 = 0xff;

# the bits a state's length starts at
val LENGTH: u64 = 8;

# the length of a state whose vl no operand value states, every bit above the vtype set
pub val UNSTATED: u64 = 0x00FF_FFFF_FFFF_FFFF;

# the vector length a state holds, 0 for vlmax and UNSTATED for one no operand value states
pub fun length(s: config.State) u64 {
    ret s.bits >> LENGTH;
}

# the vtype csr's encoding a state holds
pub fun vtype(s: config.State) u64 {
    ret s.bits & VTYPE;
}

# the state of a vtype's encoding and a vector length, 0 for vlmax
pub fun configured(vt: u64, vl: u64) config.State {
    ret config.State{bits: (vt & VTYPE) | (vl << LENGTH)};
}

fun digits(text: View, at: usize) usize {
    var i: usize = at;
    for (i < text.len && text.data[i] >= '0' && text.data[i] <= '9') {
        i = i + 1;
    }
    ret i - at;
}

fun parse(text: View) opt[config.Parsed] {
    val opt_read: opt[riscv_vtype.Read] = riscv_vtype.read(text);
    if (sel opt_read.none) { ret opt[config.Parsed].none{}; }
    val opt_bits: opt[u64] = riscv_vtype.encode(opt_read.some.vtype);
    if (sel opt_bits.none) { ret opt[config.Parsed].none{}; }
    val done: usize = opt_read.some.len;
    val at:   usize = done + 5;
    if (at < text.len && text.data[done] == ',' && text.data[done + 1] == ' ' && text.data[done + 2] == 'v' && text.data[done + 3] == 'l' && text.data[done + 4] == ' ') {
        val named: usize = str_len(UNSTATED_NAME);
        if (text.len - at >= named && view_eq_str(View{data: ?text.data[at], len: named}, UNSTATED_NAME)) { ret opt[config.Parsed].some{config.Parsed{state: configured(opt_bits.some, UNSTATED), len: at + named}}; }
        val n: usize = digits(text, at);
        if (n > 0 && n < 10) {
            var vl: u64   = 0;
            var i:  usize = at;
            for (i < at + n) {
                vl = vl * 10 + (text.data[i] - '0')::u64;
                i  = i + 1;
            }
            if (vl != 0) { ret opt[config.Parsed].some{config.Parsed{state: configured(opt_bits.some, vl), len: at + n}}; }
        }
    }
    ret opt[config.Parsed].some{config.Parsed{state: configured(opt_bits.some, 0), len: done}};
}

fun append(out: *vector.Vector[u8], s: str) err[A.Error] {
    ret extension.append(out, s);
}

fun print(s: config.State, out: *vector.Vector[u8]) err[A.Error] {
    val opt_decode: opt[riscv_vtype.Vtype] = riscv_vtype.decode(vtype(s));
    if (sel opt_decode.none) { ret append(out, "vill"); }
    var tail: str = ", tu, ";
    if (opt_decode.some.ta) { tail = ", ta, "; }
    var mask: str = "mu";
    if (opt_decode.some.ma) { mask = "ma"; }
    val pieces: [5]str = [5]str{riscv_vtype.SEW_NAMES[(s.bits >> 3) & 7], ", ", riscv_vtype.LMUL_NAMES[s.bits & 7], tail, mask};
    var i:      u32    = 0;
    for (i < 5) {
        val err_done: err[A.Error] = append(out, pieces[i]);
        if (sel err_done.err) { ret err_done; }
        i = i + 1;
    }
    val vl: u64 = length(s);
    if (vl == 0) { ret err[A.Error].ok{}; }
    val err_named: err[A.Error] = append(out, ", vl ");
    if (sel err_named.err) { ret err_named; }
    if (vl == UNSTATED)    { ret append(out, UNSTATED_NAME); }
    var text: [20]u8;
    var n:    usize = 0;
    var left: u64   = vl;
    for (left != 0) {
        text[n] = ('0'::u64 + left % 10)::u8;
        left    = left / 10;
        n       = n + 1;
    }
    for (n > 0) {
        n = n - 1;
        val res_digit: res[usize, A.Error] = vector.push[u8](out, text[n]);
        if (sel res_digit.err) { ret err[A.Error].err{res_digit.err}; }
    }
    ret err[A.Error].ok{};
}

fun grouping(s: config.State, r: *row.Row, ctx: *state.Context) constraint.Grouped {
    val opt_decode: opt[riscv_vtype.Vtype] = riscv_vtype.decode(vtype(s));
    if (sel opt_decode.none) { ret constraint.Grouped.state{}; }
    ret riscv_vtype.grouping(r, opt_decode.some, ctx);
}

# whether row `r` may write vl, as its tables state
fun writes_length(r: *row.Row) bool {
    val e: *effect.Effect = r.effect;
    if (e == nil) { ret false; }
    val regs: effect.Registers = e.implicit;
    if (sel regs.ruled)  { ret effect.has(?gen_register.FILE, regs.ruled.may.written, gen_register.VL); }
    if (sel regs.opaque) { ret effect.has(?gen_register.FILE, regs.opaque.may.written, gen_register.VL); }
    ret false;
}

fun establish(r: *row.Row, values: operand.Values, held: opt[config.State]) config.Established {
    if (r != ?gen_row.ROWS[gen_row_index.VSETVLI] && r != ?gen_row.ROWS[gen_row_index.VSETIVLI] && r != ?gen_row.ROWS[gen_row_index.VSETVL]) {
        if (!writes_length(r)) { ret config.Established.keeps{}; }
        if (sel held.some)     { ret config.Established.sets{configured(vtype(held.some), UNSTATED)}; }
        ret config.Established.keeps{};
    }
    val at:   u8              = vtype_operand(r);
    val open: query.Undecided = query.Undecided.open{query.Pending{rule: 0, operand: at}};
    if (r == ?gen_row.ROWS[gen_row_index.VSETVL] || at::u32 >= values.len) { ret config.Established.undecided{open}; }
    val v: operand.Value = values.at[at];
    if (!sel v.immediate) { ret config.Established.undecided{open}; }
    val vt: u64 = v.immediate:~u64;
    if (r == ?gen_row.ROWS[gen_row_index.VSETIVLI]) {
        val n: operand.Value = values.at[2];
        if (!sel n.immediate) { ret config.Established.undecided{open}; }
        if (n.immediate == 0) { ret config.Established.undecided{open}; }
        ret config.Established.sets{configured(vt, n.immediate:~u64)};
    }
    # vsetvli rd, rs1, vtype: vlmax where rs1 is x0 and rd is not
    val rd:  operand.Value = values.at[0];
    val rs1: operand.Value = values.at[1];
    if (!sel rd.register)                { ret config.Established.undecided{open}; }
    if (!sel rs1.register)               { ret config.Established.undecided{open}; }
    if (rs1.register != gen_register.X0) { ret config.Established.undecided{open}; }
    if (rd.register == gen_register.X0)  { ret config.Established.undecided{open}; }
    ret config.Established.sets{configured(vt, 0)};
}

# the unit-stride loads and stores, each of vl elements of its own width from its address up, which no other row is: a
# strided, indexed, segment, mask, whole register or fault-only-first access touches another count
val UNIT_STRIDE: [8]u32 = [8]u32{gen_row_index.VLE8_V, gen_row_index.VLE16_V, gen_row_index.VLE32_V, gen_row_index.VLE64_V, gen_row_index.VSE8_V, gen_row_index.VSE16_V, gen_row_index.VSE32_V, gen_row_index.VSE64_V};

# the operand of a unit-stride row that is its vm, after its data register and its address
val VM: u32 = 2;

# the elements a unit-stride load or store covers under `s`: vl, which vsetivli set to its count n where n is at most
# the least vlmax, the least VLEN the context admits times lmul over sew, since an avl at most vlmax is vl itself (rvv
# 1.0 "constraints on setting vl"), and only unmasked, so every element up to vl is touched. none for a masked one, for
# any other row, for vlmax, whose count the implementation decides, and for a length no operand value states
fun counted(s: config.State, r: *row.Row, values: operand.Values, ctx: *state.Context) opt[u64] {
    var unit: bool = false;
    var i:    u32  = 0;
    for (i < 8) {
        if (r == ?gen_row.ROWS[UNIT_STRIDE[i]]) { unit = true; }
        i = i + 1;
    }
    if (!unit || VM >= values.len) { ret opt[u64].none{}; }
    val vm: operand.Value = values.at[VM];
    if (!sel vm.enumerant)                        { ret opt[u64].none{}; }
    if (vm.enumerant.value != gen_field.UNMASKED) { ret opt[u64].none{}; }
    val n: u64 = length(s);
    if (n == 0 || n == UNSTATED) { ret opt[u64].none{}; }
    val opt_decode: opt[riscv_vtype.Vtype] = riscv_vtype.decode(vtype(s));
    if (sel opt_decode.none) { ret opt[u64].none{}; }
    val v:    riscv_vtype.Vtype = opt_decode.some;
    var room: u64               = riscv_vtype.bounds(ctx).length::u64;
    var bits: u64               = n * v.sew::u64;
    if (v.lmul >= 0) { room = room << v.lmul::u64; }
    or               { bits = bits << (0 - v.lmul)::u64; }
    if (bits > room) { ret opt[u64].none{}; }
    ret opt[u64].some{n};
}

# the vector type as risc-v's configuration state
pub val HOOKS: config.Hooks = config.Hooks{name: "vtype", parse: parse, print: print, grouping: grouping, establish: establish, counted: counted};
