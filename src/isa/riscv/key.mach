# the risc-v decode dispatch keys
#
# a key is a range of an instruction's bits, read without consuming them. the
# generator reads the keys from the keys topic of its riscv overlay
# (gen/data/riscv/keys.txt), each citing the format field it is, builds the
# dispatch over them, and writes their positions and names as gen_key, which
# this module forwards. the runtime keys read the same positions. a key within
# the low sixteen bits reads two bytes, so a compressed instruction at the end
# of a stream is never read past, and any other key reads four. no key reads
# the context: risc-v's encodings mean one thing under every state, and a row
# the context does not hold is refused by its requirement

use std.types.result.res;
use std.types.size.usize;

use masc.core.dispatch;
use masc.core.field;
use masc.core.state;

fwd masc.isa.riscv.bits.Position;
fwd masc.isa.riscv.gen_key.POSITIONS;

use masc.isa.riscv.gen_key;

# the value of key `k` of the instruction at `at`
fun read(k: u32, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val p:     Position = POSITIONS[k];
    var bytes: u8       = 4;
    if (p.lo + p.len <= 16) { bytes = 2; }
    val unit: res[u64, field.Refusal] = field.read(s, at, bytes);
    if (sel unit.err) { ret unit; }
    ret res[u64, field.Refusal].ok{(unit.ok >> p.lo::u64) & field.ones(p.len)};
}

fun key0(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(0, s, at);
}

fun key1(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(1, s, at);
}

fun key2(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(2, s, at);
}

fun key3(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(3, s, at);
}

fun key4(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(4, s, at);
}

fun key5(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(5, s, at);
}

fun key6(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(6, s, at);
}

fun key7(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(7, s, at);
}

fun key8(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(8, s, at);
}

fun key9(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(9, s, at);
}

fun key10(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(10, s, at);
}

fun key11(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(11, s, at);
}

fun key12(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(12, s, at);
}

fun key13(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(13, s, at);
}

fun key14(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(14, s, at);
}

# the runtime keys, one per position and in its order, under the names the generator writes
pub val KEYS: [15]dispatch.Key = [15]dispatch.Key{
    dispatch.Key{name: gen_key.NAMES[0], extract: key0},
    dispatch.Key{name: gen_key.NAMES[1], extract: key1},
    dispatch.Key{name: gen_key.NAMES[2], extract: key2},
    dispatch.Key{name: gen_key.NAMES[3], extract: key3},
    dispatch.Key{name: gen_key.NAMES[4], extract: key4},
    dispatch.Key{name: gen_key.NAMES[5], extract: key5},
    dispatch.Key{name: gen_key.NAMES[6], extract: key6},
    dispatch.Key{name: gen_key.NAMES[7], extract: key7},
    dispatch.Key{name: gen_key.NAMES[8], extract: key8},
    dispatch.Key{name: gen_key.NAMES[9], extract: key9},
    dispatch.Key{name: gen_key.NAMES[10], extract: key10},
    dispatch.Key{name: gen_key.NAMES[11], extract: key11},
    dispatch.Key{name: gen_key.NAMES[12], extract: key12},
    dispatch.Key{name: gen_key.NAMES[13], extract: key13},
    dispatch.Key{name: gen_key.NAMES[14], extract: key14},
};

test keys__one_runtime_key_reads_each_position_under_its_name {
    if ($length_of(KEYS) != $length_of(gen_key.POSITIONS) || $length_of(KEYS) != $length_of(gen_key.NAMES)) { ret 1; }
    if (KEYS[2].name[0] != 'o' || POSITIONS[2].lo != 2 || POSITIONS[2].len != 5)                            { ret 2; }
    ret 0;
}
