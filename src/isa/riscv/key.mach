# the risc-v decode dispatch keys
#
# a key is a range of an instruction's bits, read without consuming them.
# the positions below are the one statement of each key: the runtime keys read
# them, and the generator builds the dispatch over the same positions. a key
# within the low sixteen bits reads two bytes, so a compressed instruction at
# the end of a stream is never read past, and any other key reads four.

use std.types.result.res;
use std.types.size.usize;

use masc.core.dispatch;
use masc.core.field;

# bits `lo` to `lo + len - 1` of an instruction
pub rec Position {
    lo:  u8;
    len: u8;
}

# the keys in the order the dispatch prefers them: the length class, then the
# major opcode and the function fields of each length
pub val POSITIONS: [15]Position = [15]Position{
    Position{lo: 0, len: 2},
    Position{lo: 13, len: 3},
    Position{lo: 2, len: 5},
    Position{lo: 12, len: 3},
    Position{lo: 25, len: 7},
    Position{lo: 20, len: 5},
    Position{lo: 15, len: 5},
    Position{lo: 7, len: 5},
    Position{lo: 12, len: 1},
    Position{lo: 10, len: 2},
    Position{lo: 5, len: 2},
    Position{lo: 7, len: 5},
    Position{lo: 2, len: 5},
    Position{lo: 8, len: 5},
    Position{lo: 10, len: 3},
};

# the value of key `k` of the instruction at `at`
fun read(k: u32, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val p:     Position = POSITIONS[k];
    var bytes: u8       = 4;
    if (p.lo + p.len <= 16) { bytes = 2; }
    val unit: res[u64, field.Refusal] = field.read(s, at, bytes);
    if (sel unit.err) { ret unit; }
    ret res[u64, field.Refusal].ok{(unit.ok >> p.lo::u64) & field.ones(p.len)};
}

fun key0(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(0, s, at);
}

fun key1(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(1, s, at);
}

fun key2(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(2, s, at);
}

fun key3(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(3, s, at);
}

fun key4(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(4, s, at);
}

fun key5(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(5, s, at);
}

fun key6(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(6, s, at);
}

fun key7(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(7, s, at);
}

fun key8(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(8, s, at);
}

fun key9(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(9, s, at);
}

fun key10(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(10, s, at);
}

fun key11(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(11, s, at);
}

fun key12(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(12, s, at);
}

fun key13(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(13, s, at);
}

fun key14(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(14, s, at);
}

# the runtime keys and their names, one per position and in its order
pub val KEYS: [15]dispatch.Key = [15]dispatch.Key{
    dispatch.Key{name: "length", extract: key0},
    dispatch.Key{name: "c.funct3", extract: key1},
    dispatch.Key{name: "opcode", extract: key2},
    dispatch.Key{name: "funct3", extract: key3},
    dispatch.Key{name: "funct7", extract: key4},
    dispatch.Key{name: "rs2", extract: key5},
    dispatch.Key{name: "rs1", extract: key6},
    dispatch.Key{name: "rd", extract: key7},
    dispatch.Key{name: "c.12", extract: key8},
    dispatch.Key{name: "c.11..10", extract: key9},
    dispatch.Key{name: "c.6..5", extract: key10},
    dispatch.Key{name: "c.11..7", extract: key11},
    dispatch.Key{name: "c.6..2", extract: key12},
    dispatch.Key{name: "c.12..8", extract: key13},
    dispatch.Key{name: "c.12..10", extract: key14},
};
