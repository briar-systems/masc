# the risc-v set's registration record
#
# one record for both widths: the catalog's rows admit a width by their
# requirements, and the register file scales by the selection. the record
# only names the pieces, each the owner of its own tables.

use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use mink;

use masc.core.operand;
use masc.core.relax;
use masc.core.requirement;
use masc.core.set;
use masc.core.spelling;

use riscv_catalog:   masc.isa.riscv.catalog;
use riscv_compress:  masc.isa.riscv.compress;
use riscv_extension: masc.isa.riscv.extension;
use riscv_fixup:     masc.isa.riscv.fixup;
use riscv_insn:      masc.isa.riscv.insn;
use riscv_mode:      masc.isa.riscv.mode;
use riscv_syntax:    masc.isa.riscv.syntax;

use masc.isa.riscv.gen_relax;

val RVC_C:    [1]requirement.Id = [1]requirement.Id{riscv_extension.C};
val RVC_ZCA:  [1]requirement.Id = [1]requirement.Id{riscv_extension.ZCA};
val RVE_E:    [1]requirement.Id = [1]requirement.Id{riscv_extension.E};
val TSO_ZTSO: [1]requirement.Id = [1]requirement.Id{riscv_extension.ZTSO};

# compressed code is on with c or zca
val RVC_ALTERNATIVES: [2]requirement.Ids = [2]requirement.Ids{
    requirement.Ids{at: ?RVC_C[0], len: 1},
    requirement.Ids{at: ?RVC_ZCA[0], len: 1},
};

val RVE_ALTERNATIVES: [1]requirement.Ids = [1]requirement.Ids{requirement.Ids{at: ?RVE_E[0], len: 1}};
val TSO_ALTERNATIVES: [1]requirement.Ids = [1]requirement.Ids{requirement.Ids{at: ?TSO_ZTSO[0], len: 1}};

# the control-flow integrity properties claim that every indirect target of the object's code has a landing pad or that
# it keeps a shadow stack, which the selection holding zicfilp or zicfiss does not make so
val NO_CFI: str = "llvm-mc 23.1.1 writes no GNU property note whatever the selection, and a compiler writes the note itself";

# who states each axis the riscv elf psabi encodes in e_flags and the GNU property note (riscv-elf.adoc, "e_flags",
# "GNU Program Properties"), as llvm-mc 23.1.1 sets rvc with c or zca, rve with e and tso with ztso
val OWNERS: [7]set.Owned = [7]set.Owned{
    set.Owned{axis: ?mink.arch.RISCV_FLOAT_ABI, owner: set.Owner.caller{}},
    set.Owned{axis: ?mink.arch.RISCV_RVC, owner: set.Owner.selection{requirement.Requirement{at: ?RVC_ALTERNATIVES[0], len: 2}}},
    set.Owned{axis: ?mink.arch.RISCV_RVE, owner: set.Owner.selection{requirement.Requirement{at: ?RVE_ALTERNATIVES[0], len: 1}}},
    set.Owned{axis: ?mink.arch.RISCV_TSO, owner: set.Owner.selection{requirement.Requirement{at: ?TSO_ALTERNATIVES[0], len: 1}}},
    set.Owned{axis: ?mink.arch.RISCV_CFI_LP_UNLABELED, owner: set.Owner.fixed{set.Fixed{setting: mink.trait.Setting.flag{false}, cites: NO_CFI}}},
    set.Owned{axis: ?mink.arch.RISCV_CFI_SS, owner: set.Owner.fixed{set.Fixed{setting: mink.trait.Setting.flag{false}, cites: NO_CFI}}},
    set.Owned{axis: ?mink.arch.RISCV_CFI_LP_FUNC_SIG, owner: set.Owner.fixed{set.Fixed{setting: mink.trait.Setting.flag{false}, cites: NO_CFI}}},
};

val ARCHES: [2]*mink.arch.Arch = [2]*mink.arch.Arch{?mink.arch.RISCV64, ?mink.arch.RISCV32};

# the mode extension each architecture stands for
val MODES: [2]set.Mode = [2]set.Mode{
    set.Mode{arch: ?mink.arch.RISCV64, extension: riscv_extension.RV64},
    set.Mode{arch: ?mink.arch.RISCV32, extension: riscv_extension.RV32},
};

# the float abi each `-mabi` spelling states (gcc's riscv options, "-mabi"), its xlen being the selection's
val OPTIONS: [6]set.Stated = [6]set.Stated{
    set.Stated{option: "-mabi", value: "ilp32", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SOFT}}},
    set.Stated{option: "-mabi", value: "ilp32f", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SINGLE}}},
    set.Stated{option: "-mabi", value: "ilp32d", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_DOUBLE}}},
    set.Stated{option: "-mabi", value: "lp64", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SOFT}}},
    set.Stated{option: "-mabi", value: "lp64f", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SINGLE}}},
    set.Stated{option: "-mabi", value: "lp64d", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_DOUBLE}}},
};

# the integer data directives at their gnu assembler widths on risc-v
val WIDTHS: [5]set.Width = [5]set.Width{
    set.Width{name: ".byte", width: 1},
    set.Width{name: ".short", width: 2},
    set.Width{name: ".word", width: 4},
    set.Width{name: ".long", width: 4},
    set.Width{name: ".quad", width: 8},
};

val NO_RVC: [1]requirement.Id = [1]requirement.Id{riscv_extension.ZCA};

# `.option norvc` keeps the statements after it full length and refuses compressed instructions, and `.option rvc`
# lifts it (gas manual, "RISC-V Directives", `.option`). removing zca takes c and every zc* that implies it, so the
# selection stays closed and refuses every compressed instruction, as llvm-mc does after it
val NARROWINGS: [1]set.Narrowing = [1]set.Narrowing{
    set.Narrowing{narrow: "norvc", lift: "rvc", removes: requirement.Ids{at: ?NO_RVC[0], len: 1}, lifted: riscv_extension.C},
};

# the form directive, its stack saved by `push` and restored by `pop`, and `arch` restating the selection by an isa
# string or `+` and `-` edits of it (riscv-asm-manual, ".option")
val FORMS: set.Forms = set.Forms{directive: ".option", push: "push", pop: "pop", narrowings: set.Narrowings{at: ?NARROWINGS[0], len: 1}, restates: "arch"};

# the tags of `.attribute` (risc-v psabi, "RISC-V ELF Attributes", and gas manual, "RISC-V Directives"), each with
# the trait mink's object model states it by. atomic_abi and x3_reg_usage have no axis in mink yet
val TAGS: [8]set.Tag = [8]set.Tag{
    set.Tag{name: "stack_align", number: 4, axis: ?mink.arch.RISCV_STACK_ALIGN, selection: false},
    set.Tag{name: "arch", number: 5, axis: ?mink.arch.RISCV_ARCH, selection: true},
    set.Tag{name: "unaligned_access", number: 6, axis: ?mink.arch.RISCV_UNALIGNED_ACCESS, selection: false},
    set.Tag{name: "priv_spec", number: 8, axis: ?mink.arch.RISCV_PRIV_SPEC, selection: false},
    set.Tag{name: "priv_spec_minor", number: 10, axis: ?mink.arch.RISCV_PRIV_SPEC_MINOR, selection: false},
    set.Tag{name: "priv_spec_revision", number: 12, axis: ?mink.arch.RISCV_PRIV_SPEC_REVISION, selection: false},
    set.Tag{name: "atomic_abi", number: 14, axis: nil, selection: false},
    set.Tag{name: "x3_reg_usage", number: 16, axis: nil, selection: false},
};

val ATTRIBUTES: set.Attributes = set.Attributes{directive: ".attribute", tags: set.Tags{at: ?TAGS[0], len: 8}};

# the length the low bits `low` of a parcel encode (unprivileged spec, "Expanded Instruction-Length Encoding"): 16 bits
# unless the low two are set, 32 unless bits 2 to 4 are too, then 48 and 64, and 0 for a reserved longer encoding
fun encoded(low: u8) usize {
    if ((low & 0x03) != 0x03) { ret 2; }
    if ((low & 0x1c) != 0x1c) { ret 4; }
    if ((low & 0x3f) == 0x1f) { ret 6; }
    if ((low & 0x7f) == 0x3f) { ret 8; }
    ret 0;
}

# the code at `at` by its length encoding, a reserved longer encoding a parcel at a time, the bytes left when fewer
fun parcel(data: *u8, len: usize, at: usize) usize {
    val left: usize = len - at;
    if (left < 2) { ret left; }
    var n: usize = encoded(data[at]);
    if (n == 0)   { n = 2; }
    if (n > left) { ret left; }
    ret n;
}

# the length the encoding at `data` states, 0 for a reserved longer one, which no raw form of `.insn` takes
fun stated(data: *u8, len: usize) usize {
    if (len == 0) { ret 0; }
    ret encoded(data[0]);
}

# the instruction directive, its formats those of the gnu assembler as llvm-mc reads them
val INSNS: set.Insns = set.Insns{directive: ".insn", formats: riscv_insn.ALL, length: stated};

# the registration of risc-v at both widths
pub val SET: set.Set = set.Set{
    arches:     set.Arches{at: ?ARCHES[0], len: 2},
    modes:      set.Modes{at: ?MODES[0], len: 2},
    codec:      ?riscv_catalog.CODEC,
    extensions: ?riscv_extension.CATALOG,
    bindings:   set.Bindings{at: ?riscv_fixup.BINDINGS[0], len: riscv_fixup.COUNT},
    relax:      gen_relax.RELAXATIONS,
    compress:   riscv_compress.COMPRESSIONS,
    fill:       ?riscv_catalog.FILL,
    realign:    riscv_fixup.ALIGN,
    data:       set.Data{at: ?riscv_fixup.DATA[0], len: riscv_fixup.DATA_COUNT},
    spans:      set.Spans{at: ?riscv_fixup.SPANS[0], len: riscv_fixup.SPAN_COUNT},
    syntaxes:   spelling.Syntaxes{at: ?riscv_syntax.SYNTAX, len: 1},
    traits:     set.Owners{at: ?OWNERS[0], len: 7},
    options:    set.Spellings{at: ?OPTIONS[0], len: 6},
    assembly:   riscv_mode.MODES,
    pairs:      set.Pairs{at: ?riscv_fixup.PAIRS[0], len: riscv_fixup.PAIR_COUNT},
    source:     set.Source{comment: "#", separator: ';', types: "@%", align: set.ALIGN_POWER, widths: set.Widths{at: ?WIDTHS[0], len: 5}, forms: FORMS, attributes: ATTRIBUTES, insns: INSNS},
    parcel:     parcel,
};
