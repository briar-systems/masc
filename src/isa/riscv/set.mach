# the risc-v set's registration record
#
# one record for both widths: the catalog's rows admit a width by their
# requirements, and the register file scales by the selection. the record
# only names the pieces, each the owner of its own tables.

use mink;

use masc.core.operand;
use masc.core.relax;
use masc.core.requirement;
use masc.core.set;
use masc.core.spelling;

use riscv_catalog:   masc.isa.riscv.catalog;
use riscv_compress:  masc.isa.riscv.compress;
use riscv_extension: masc.isa.riscv.extension;
use riscv_fixup:     masc.isa.riscv.fixup;
use riscv_syntax:    masc.isa.riscv.syntax;

use masc.isa.riscv.gen_relax;

val SUPPLIED: [1]*mink.trait.Axis = [1]*mink.trait.Axis{?mink.arch.RISCV_FLOAT_ABI};

val RVC_C:   [1]requirement.Id = [1]requirement.Id{riscv_extension.C};
val RVC_ZCA: [1]requirement.Id = [1]requirement.Id{riscv_extension.ZCA};

# compressed code is on with c or zca
val RVC_ALTERNATIVES: [2]requirement.Ids = [2]requirement.Ids{
    requirement.Ids{at: ?RVC_C[0], len: 1},
    requirement.Ids{at: ?RVC_ZCA[0], len: 1},
};

val DERIVED: [1]set.Derivation = [1]set.Derivation{
    set.Derivation{axis: ?mink.arch.RISCV_RVC, requires: requirement.Requirement{at: ?RVC_ALTERNATIVES[0], len: 2}},
};

val ARCHES: [2]*mink.arch.Arch = [2]*mink.arch.Arch{?mink.arch.RISCV64, ?mink.arch.RISCV32};

# the float abi each `-mabi` spelling states (gcc's riscv options, "-mabi"), its xlen being the selection's
val OPTIONS: [6]set.Stated = [6]set.Stated{
    set.Stated{option: "-mabi", value: "ilp32", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SOFT}}},
    set.Stated{option: "-mabi", value: "ilp32f", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SINGLE}}},
    set.Stated{option: "-mabi", value: "ilp32d", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_DOUBLE}}},
    set.Stated{option: "-mabi", value: "lp64", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SOFT}}},
    set.Stated{option: "-mabi", value: "lp64f", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SINGLE}}},
    set.Stated{option: "-mabi", value: "lp64d", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_DOUBLE}}},
};

# the integer data directives at their gnu assembler widths on risc-v
val WIDTHS: [5]set.Width = [5]set.Width{
    set.Width{name: ".byte", width: 1},
    set.Width{name: ".short", width: 2},
    set.Width{name: ".word", width: 4},
    set.Width{name: ".long", width: 4},
    set.Width{name: ".quad", width: 8},
};

# the registration of risc-v at both widths
pub val SET: set.Set = set.Set{
    arches:     set.Arches{at: ?ARCHES[0], len: 2},
    codec:      ?riscv_catalog.CODEC,
    extensions: ?riscv_extension.CATALOG,
    bindings:   set.Bindings{at: ?riscv_fixup.BINDINGS[0], len: riscv_fixup.COUNT},
    relax:      relax.Relaxations{at: ?gen_relax.RELAXATION_ROWS[0], len: gen_relax.RELAXATION_COUNT},
    compress:   riscv_compress.COMPRESSIONS,
    fill:       ?riscv_catalog.FILL,
    realign:    riscv_fixup.ALIGN,
    data:       set.Data{at: ?riscv_fixup.DATA[0], len: riscv_fixup.DATA_COUNT},
    spans:      set.Spans{at: ?riscv_fixup.SPANS[0], len: riscv_fixup.SPAN_COUNT},
    syntaxes:   spelling.Syntaxes{at: ?riscv_syntax.SYNTAX, len: 1},
    supplied:   set.Axes{at: ?SUPPLIED[0], len: 1},
    derived:    set.Derivations{at: ?DERIVED[0], len: 1},
    options:    set.Spellings{at: ?OPTIONS[0], len: 6},
    pairs:      set.Pairs{at: ?riscv_fixup.PAIRS[0], len: riscv_fixup.PAIR_COUNT},
    source:     set.Source{comment: "#", separator: ';', types: "@%", align: set.ALIGN_POWER, widths: set.Widths{at: ?WIDTHS[0], len: 5}},
};
