# the risc-v set's registration record
#
# one record for both widths and both bases: each architecture enters its xlen and base, the
# catalog's rows admit a width by their requirements, and the register file
# scales by the context. the record only names the pieces, each the owner of
# its own tables.

use std.types.bool.false;
use std.types.string.str;

use mink;

use masc.core.fixup;
use masc.core.requirement;
use masc.core.set;
use masc.core.state;
use masc.core.syntax;
use masc.core.trait;

use riscv_catalog:   masc.isa.riscv.catalog;
use riscv_compress:  masc.isa.riscv.compress;
use riscv_extension: masc.isa.riscv.extension;
use riscv_fixup:     masc.isa.riscv.fixup;
use riscv_mode:      masc.isa.riscv.mode;
use riscv_source:    masc.isa.riscv.source;
use riscv_syntax:    masc.isa.riscv.syntax;

use masc.isa.riscv.gen_relax;

val RVC_C:    [1]requirement.Id = [1]requirement.Id{riscv_extension.id.C};
val RVC_ZCA:  [1]requirement.Id = [1]requirement.Id{riscv_extension.id.ZCA};
val TSO_ZTSO: [1]requirement.Id = [1]requirement.Id{riscv_extension.id.ZTSO};

# compressed code is on with c or zca, in any view the object's code is written under
val RVC_ALTERNATIVES: [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?RVC_C[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?RVC_ZCA[0], len: 1}, none: requirement.NO_IDS},
};

val TSO_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?TSO_ZTSO[0], len: 1}, none: requirement.NO_IDS}};

# the control-flow integrity properties claim that every indirect target of the object's code has a landing pad or that
# it keeps a shadow stack, which the selection holding zicfilp or zicfiss does not make so
val NO_CFI: str = "llvm-mc 23.1.1 writes no GNU property note whatever the selection, and a compiler writes the note itself";

# who states each axis the riscv elf psabi encodes in e_flags and the GNU property note (riscv-elf.adoc, "e_flags",
# "GNU Program Properties"), as llvm-mc 23.1.1 sets rvc with c or zca, including where `.option arch` turns either on
# for a stretch of code, and tso with ztso. rve has no owner: it is the e base's, and each of mink's architecture rows
# fixes it, set on riscv32e and riscv64e and clear on riscv32 and riscv64
val OWNERS: [6]trait.Owned = [6]trait.Owned{
    trait.Owned{axis: ?mink.arch_riscv.RISCV_FLOAT_ABI, owner: trait.Owner.caller{}},
    trait.Owned{axis: ?mink.arch_riscv.RISCV_RVC, owner: trait.Owner.derived{requirement.Requirement{at: ?RVC_ALTERNATIVES[0], len: 2}}},
    trait.Owned{axis: ?mink.arch_riscv.RISCV_TSO, owner: trait.Owner.selection{requirement.Requirement{at: ?TSO_ALTERNATIVES[0], len: 1}}},
    trait.Owned{axis: ?mink.arch_riscv.RISCV_CFI_LP_UNLABELED, owner: trait.Owner.fixed{trait.Fixed{setting: mink.trait.Setting.flag{false}, cites: NO_CFI}}},
    trait.Owned{axis: ?mink.arch_riscv.RISCV_CFI_SS, owner: trait.Owner.fixed{trait.Fixed{setting: mink.trait.Setting.flag{false}, cites: NO_CFI}}},
    trait.Owned{axis: ?mink.arch_riscv.RISCV_CFI_LP_FUNC_SIG, owner: trait.Owner.fixed{trait.Fixed{setting: mink.trait.Setting.flag{false}, cites: NO_CFI}}},
};

val RV64_ENTERS_IDS:  [2]requirement.Id = [2]requirement.Id{riscv_extension.id.XLEN_64, riscv_extension.id.BASE_I};
val RV32_ENTERS_IDS:  [2]requirement.Id = [2]requirement.Id{riscv_extension.id.XLEN_32, riscv_extension.id.BASE_I};
val RV64E_ENTERS_IDS: [2]requirement.Id = [2]requirement.Id{riscv_extension.id.XLEN_64, riscv_extension.id.BASE_E};
val RV32E_ENTERS_IDS: [2]requirement.Id = [2]requirement.Id{riscv_extension.id.XLEN_32, riscv_extension.id.BASE_E};

val ENTERS: [4]requirement.Alternative = [4]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?RV64_ENTERS_IDS[0], len: 2}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?RV32_ENTERS_IDS[0], len: 2}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?RV64E_ENTERS_IDS[0], len: 2}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?RV32E_ENTERS_IDS[0], len: 2}, none: requirement.NO_IDS},
};

# each architecture enters its xlen on its base, the i base for riscv64 and riscv32 and the e base for riscv64e and
# riscv32e (src/unpriv/rv32e.adoc), so a selection of the other width or base is refused for it. xlen is the first axis
# and base the second
val ARCHES: [4]set.Arch = [4]set.Arch{
    set.Arch{arch: ?mink.arch_riscv.RISCV64, enters: requirement.Requirement{at: ?ENTERS[0], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{1, 0, 0, 0, 0, 0, 0, 0}}},
    set.Arch{arch: ?mink.arch_riscv.RISCV32, enters: requirement.Requirement{at: ?ENTERS[1], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{0, 0, 0, 0, 0, 0, 0, 0}}},
    set.Arch{arch: ?mink.arch_riscv.RISCV64E, enters: requirement.Requirement{at: ?ENTERS[2], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{1, 1, 0, 0, 0, 0, 0, 0}}},
    set.Arch{arch: ?mink.arch_riscv.RISCV32E, enters: requirement.Requirement{at: ?ENTERS[3], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{0, 1, 0, 0, 0, 0, 0, 0}}},
};

# the float abi each `-mabi` spelling states (gcc's riscv options, "-mabi"), its xlen being the selection's
val OPTIONS: [6]trait.Stated = [6]trait.Stated{
    trait.Stated{option: "-mabi", value: "ilp32", trait: mink.trait.Trait{axis: ?mink.arch_riscv.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch_riscv.RISCV_SOFT}}},
    trait.Stated{option: "-mabi", value: "ilp32f", trait: mink.trait.Trait{axis: ?mink.arch_riscv.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch_riscv.RISCV_SINGLE}}},
    trait.Stated{option: "-mabi", value: "ilp32d", trait: mink.trait.Trait{axis: ?mink.arch_riscv.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch_riscv.RISCV_DOUBLE}}},
    trait.Stated{option: "-mabi", value: "lp64", trait: mink.trait.Trait{axis: ?mink.arch_riscv.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch_riscv.RISCV_SOFT}}},
    trait.Stated{option: "-mabi", value: "lp64f", trait: mink.trait.Trait{axis: ?mink.arch_riscv.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch_riscv.RISCV_SINGLE}}},
    trait.Stated{option: "-mabi", value: "lp64d", trait: mink.trait.Trait{axis: ?mink.arch_riscv.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch_riscv.RISCV_DOUBLE}}},
};

# the registration of risc-v at both widths, on the i base and the e base
pub val SET: set.Set = set.Set{
    arches:     set.Arches{at: ?ARCHES[0], len: 4},
    states:     riscv_extension.AXES,
    codec:      ?riscv_catalog.CODEC,
    extensions: ?riscv_extension.CATALOG,
    bindings:   fixup.Bindings{at: ?riscv_fixup.BINDINGS[0], len: riscv_fixup.COUNT},
    relax:      gen_relax.RELAXATIONS,
    compress:   riscv_compress.COMPRESSIONS,
    fill:       ?riscv_catalog.FILL,
    realign:    riscv_fixup.ALIGN,
    data:       fixup.Data{at: ?riscv_fixup.DATA[0], len: riscv_fixup.DATA_COUNT},
    spans:      fixup.Spans{at: ?riscv_fixup.SPANS[0], len: riscv_fixup.SPAN_COUNT},
    syntaxes:   syntax.Syntaxes{at: ?riscv_syntax.SYNTAX, len: 1},
    traits:     trait.Owners{at: ?OWNERS[0], len: 6},
    options:    trait.Spellings{at: ?OPTIONS[0], len: 6},
    assembly:   riscv_mode.MODES,
    pairs:      fixup.Pairs{at: ?riscv_fixup.PAIRS[0], len: riscv_fixup.PAIR_COUNT},
    source:     riscv_source.SOURCE,
    parcel:     riscv_source.parcel,
};
