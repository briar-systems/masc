# the risc-v set's registration record
#
# one record for both widths: the catalog's rows admit a width by their
# requirements, and the register file scales by the selection. the record
# only names the pieces, each the owner of its own tables.

use mink;

use masc.core.operand;
use masc.core.relax;
use masc.core.set;
use masc.core.spelling;

use riscv_catalog:   masc.isa.riscv.catalog;
use riscv_compress:  masc.isa.riscv.compress;
use riscv_extension: masc.isa.riscv.extension;
use riscv_fixup:     masc.isa.riscv.fixup;
use riscv_syntax:    masc.isa.riscv.syntax;

use masc.isa.riscv.gen_relax;

val ARCHES: [2]*mink.arch.Arch = [2]*mink.arch.Arch{?mink.arch.RISCV64, ?mink.arch.RISCV32};

# the registration of risc-v at both widths
pub val SET: set.Set = set.Set{
    arches:     set.Arches{at: ?ARCHES[0], len: 2},
    codec:      ?riscv_catalog.CODEC,
    extensions: ?riscv_extension.CATALOG,
    bindings:   set.Bindings{at: ?riscv_fixup.BINDINGS[0], len: riscv_fixup.COUNT},
    relax:      relax.Relaxations{at: ?gen_relax.RELAXATION_ROWS[0], len: gen_relax.RELAXATION_COUNT},
    compress:   riscv_compress.COMPRESSIONS,
    fill:       ?riscv_catalog.FILL,
    realign:    riscv_fixup.ALIGN,
    data:       set.Data{at: ?riscv_fixup.DATA[0], len: riscv_fixup.DATA_COUNT},
    spans:      set.Spans{at: ?riscv_fixup.SPANS[0], len: riscv_fixup.SPAN_COUNT},
    syntaxes:   spelling.Syntaxes{at: ?riscv_syntax.SYNTAX, len: 1},
};
