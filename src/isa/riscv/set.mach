# the risc-v set's registration record
#
# one record for both widths: each architecture enters its xlen and base, the
# catalog's rows admit a width by their requirements, and the register file
# scales by the context. the record only names the pieces, each the owner of
# its own tables.

use std.types.bool.false;
use std.types.string.str;

use mink;

use masc.core.fixup;
use masc.core.requirement;
use masc.core.set;
use masc.core.state;
use masc.core.syntax;
use masc.core.trait;

use riscv_catalog:   masc.isa.riscv.catalog;
use riscv_compress:  masc.isa.riscv.compress;
use riscv_extension: masc.isa.riscv.extension;
use riscv_fixup:     masc.isa.riscv.fixup;
use riscv_mode:      masc.isa.riscv.mode;
use riscv_source:    masc.isa.riscv.source;
use riscv_syntax:    masc.isa.riscv.syntax;

use masc.isa.riscv.gen_relax;

val RVC_C:    [1]requirement.Id = [1]requirement.Id{riscv_extension.C};
val RVC_ZCA:  [1]requirement.Id = [1]requirement.Id{riscv_extension.ZCA};
val TSO_ZTSO: [1]requirement.Id = [1]requirement.Id{riscv_extension.ZTSO};

# compressed code is on with c or zca, in any view the object's code is written under
val RVC_ALTERNATIVES: [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?RVC_C[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?RVC_ZCA[0], len: 1}, none: requirement.NO_IDS},
};

val TSO_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?TSO_ZTSO[0], len: 1}, none: requirement.NO_IDS}};

# the e base is the base an architecture enters, and the architectures that enter it are mink's riscv32e and riscv64e,
# whose rows state rve of their objects. the set serves neither yet, so no object it builds is of the e base
val RVE_ARCH: str = "rve is the e base's, which only mink's riscv32e and riscv64e architectures enter, and the set serves neither";

# the control-flow integrity properties claim that every indirect target of the object's code has a landing pad or that
# it keeps a shadow stack, which the selection holding zicfilp or zicfiss does not make so
val NO_CFI: str = "llvm-mc 23.1.1 writes no GNU property note whatever the selection, and a compiler writes the note itself";

# who states each axis the riscv elf psabi encodes in e_flags and the GNU property note (riscv-elf.adoc, "e_flags",
# "GNU Program Properties"), as llvm-mc 23.1.1 sets rvc with c or zca, including where `.option arch` turns either on
# for a stretch of code, and tso with ztso
val OWNERS: [7]trait.Owned = [7]trait.Owned{
    trait.Owned{axis: ?mink.arch.RISCV_FLOAT_ABI, owner: trait.Owner.caller{}},
    trait.Owned{axis: ?mink.arch.RISCV_RVC, owner: trait.Owner.derived{requirement.Requirement{at: ?RVC_ALTERNATIVES[0], len: 2}}},
    trait.Owned{axis: ?mink.arch.RISCV_RVE, owner: trait.Owner.fixed{trait.Fixed{setting: mink.trait.Setting.flag{false}, cites: RVE_ARCH}}},
    trait.Owned{axis: ?mink.arch.RISCV_TSO, owner: trait.Owner.selection{requirement.Requirement{at: ?TSO_ALTERNATIVES[0], len: 1}}},
    trait.Owned{axis: ?mink.arch.RISCV_CFI_LP_UNLABELED, owner: trait.Owner.fixed{trait.Fixed{setting: mink.trait.Setting.flag{false}, cites: NO_CFI}}},
    trait.Owned{axis: ?mink.arch.RISCV_CFI_SS, owner: trait.Owner.fixed{trait.Fixed{setting: mink.trait.Setting.flag{false}, cites: NO_CFI}}},
    trait.Owned{axis: ?mink.arch.RISCV_CFI_LP_FUNC_SIG, owner: trait.Owner.fixed{trait.Fixed{setting: mink.trait.Setting.flag{false}, cites: NO_CFI}}},
};

val RV64_ENTERS_IDS: [2]requirement.Id = [2]requirement.Id{riscv_extension.XLEN_64, riscv_extension.BASE_I};
val RV32_ENTERS_IDS: [2]requirement.Id = [2]requirement.Id{riscv_extension.XLEN_32, riscv_extension.BASE_I};

val ENTERS: [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?RV64_ENTERS_IDS[0], len: 2}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?RV32_ENTERS_IDS[0], len: 2}, none: requirement.NO_IDS},
};

# each architecture enters its xlen on the i base, so a selection of the other width, or of the e base, is refused for
# it. xlen is the first axis and base the second
val ARCHES: [2]set.Arch = [2]set.Arch{
    set.Arch{arch: ?mink.arch.RISCV64, enters: requirement.Requirement{at: ?ENTERS[0], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{1, 0, 0, 0, 0, 0, 0, 0}}},
    set.Arch{arch: ?mink.arch.RISCV32, enters: requirement.Requirement{at: ?ENTERS[1], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{0, 0, 0, 0, 0, 0, 0, 0}}},
};

# the float abi each `-mabi` spelling states (gcc's riscv options, "-mabi"), its xlen being the selection's
val OPTIONS: [6]trait.Stated = [6]trait.Stated{
    trait.Stated{option: "-mabi", value: "ilp32", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SOFT}}},
    trait.Stated{option: "-mabi", value: "ilp32f", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SINGLE}}},
    trait.Stated{option: "-mabi", value: "ilp32d", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_DOUBLE}}},
    trait.Stated{option: "-mabi", value: "lp64", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SOFT}}},
    trait.Stated{option: "-mabi", value: "lp64f", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_SINGLE}}},
    trait.Stated{option: "-mabi", value: "lp64d", trait: mink.trait.Trait{axis: ?mink.arch.RISCV_FLOAT_ABI, setting: mink.trait.Setting.choice{?mink.arch.RISCV_DOUBLE}}},
};

# the registration of risc-v at both widths
pub val SET: set.Set = set.Set{
    arches:     set.Arches{at: ?ARCHES[0], len: 2},
    states:     riscv_extension.AXES,
    codec:      ?riscv_catalog.CODEC,
    extensions: ?riscv_extension.CATALOG,
    bindings:   fixup.Bindings{at: ?riscv_fixup.BINDINGS[0], len: riscv_fixup.COUNT},
    relax:      gen_relax.RELAXATIONS,
    compress:   riscv_compress.COMPRESSIONS,
    fill:       ?riscv_catalog.FILL,
    realign:    riscv_fixup.ALIGN,
    data:       fixup.Data{at: ?riscv_fixup.DATA[0], len: riscv_fixup.DATA_COUNT},
    spans:      fixup.Spans{at: ?riscv_fixup.SPANS[0], len: riscv_fixup.SPAN_COUNT},
    syntaxes:   syntax.Syntaxes{at: ?riscv_syntax.SYNTAX, len: 1},
    traits:     trait.Owners{at: ?OWNERS[0], len: 7},
    options:    trait.Spellings{at: ?OPTIONS[0], len: 6},
    assembly:   riscv_mode.MODES,
    pairs:      fixup.Pairs{at: ?riscv_fixup.PAIRS[0], len: riscv_fixup.PAIR_COUNT},
    source:     riscv_source.SOURCE,
    parcel:     riscv_source.parcel,
};
