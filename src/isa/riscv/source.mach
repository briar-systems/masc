val ROWS: [27]row.Row = [27]row.Row{
    row.Row{key: "insn.r", mnemonic: ".insn", operands: row.Operands{at: ?R_OPERANDS[0], len: 6}, encoding: field.Fields{at: ?FIELDS[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.r4", mnemonic: ".insn", operands: row.Operands{at: ?R4_OPERANDS[0], len: 7}, encoding: field.Fields{at: ?FIELDS[1], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.i", mnemonic: ".insn", operands: row.Operands{at: ?I_OPERANDS[0], len: 5}, encoding: field.Fields{at: ?FIELDS[2], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
