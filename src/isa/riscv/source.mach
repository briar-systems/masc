    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CIW_SLICES[0], len: 4}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CSS_SLICES[0], len: 4}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CL_SLICES[0], len: 6}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CA_SLICES[0], len: 5}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CB_SLICES[0], len: 8}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CJ_SLICES[0], len: 10}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?RAW16_SLICES[0], len: 1}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 32, fixed: 0, mask: 0, slices: field.Slices{at: ?RAW32_SLICES[0], len: 1}, operand: field.NO_OPERAND, param: 0},
};

val WIDE: [9]field.Field = [9]field.Field{
    field.Field{kind: UNIT, width: 48, fixed: 0, mask: 0, slices: field.Slices{at: ?RAW48_SLICES[0], len: 1}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 64, fixed: 0, mask: 0, slices: field.Slices{at: ?RAW64_SLICES[0], len: 1}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: riscv_field.RAW_KIND, width: 80, fixed: 0, mask: 0, slices: field.NO_SLICES, operand: 0, param: 0},
    field.Field{kind: riscv_field.RAW_KIND, width: 96, fixed: 0, mask: 0, slices: field.NO_SLICES, operand: 0, param: 0},
    field.Field{kind: riscv_field.RAW_KIND, width: 112, fixed: 0, mask: 0, slices: field.NO_SLICES, operand: 0, param: 0},
    field.Field{kind: riscv_field.RAW_KIND, width: 128, fixed: 0, mask: 0, slices: field.NO_SLICES, operand: 0, param: 0},
    field.Field{kind: riscv_field.RAW_KIND, width: 144, fixed: 0, mask: 0, slices: field.NO_SLICES, operand: 0, param: 0},
    field.Field{kind: riscv_field.RAW_KIND, width: 160, fixed: 0, mask: 0, slices: field.NO_SLICES, operand: 0, param: 0},
    field.Field{kind: riscv_field.RAW_KIND, width: 176, fixed: 0, mask: 0, slices: field.NO_SLICES, operand: 0, param: 0},
