# the risc-v set's assembly source dialect, as the gnu assembler reads it
#
# the widths of its data directives, the `.option` forms that narrow or
# restate the selection a statement is written under, the tags `.attribute`
# states, and `.insn`, which states an instruction by its encoding, with the
# length encoding a raw form of it and the disassembler read.
#
# each format of `.insn` is a row of its own over the catalog's unit field kind, never a
# row of the catalog, and its template is its text after `.insn`. the formats,
# their operand order and the ranges of their fields are the gnu assembler's
# (gas manual, "RISC-V Instruction Formats") as llvm-mc 23.1.1 reads them
# (llvm/lib/Target/RISCV/RISCVInstrFormats.td and RISCVInstrFormatsC.td, the
# DirectiveInsn classes). a compressed format's immediate is the raw field in
# bit order, as both lay it out, and a branch or jump target takes the layout
# and relocation of the catalog's own branch or jump of that format. the raw
# forms state the whole encoding as one value, of a length the set's length
# encoding must agree with, and a 2 byte one, like every compressed format,
# needs c or zca.
#
# a register is any of the x, f and v registers, or x8 to x15 and f8 to f15
# where a compressed field has three bits, whatever the view: llvm-mc 23.1.1
# reads them as AnyReg and AnyRegC (RISCVInstrInfo.td, "AnyReg"), so
# `.insn r 0x53, 0, 0, fa0, fa1, fa2` assembles under rv64i, and the format's
# register operand states it as `unviewed`. nothing states what an encoding does, so every format's effect is the
# opaque one: it may read and write every register, read and write memory,
# and jump anywhere or fall through, and it surely touches no register, so the
# walks hold it to no register the selection lacks.

use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use mink;

use masc.core.constraint;
use masc.core.ct;
use masc.core.effect;
use masc.core.field;
use masc.core.operand;
use masc.core.quantity;
use masc.core.requirement;
use masc.core.row;
use masc.core.source;

use riscv_extension: masc.isa.riscv.extension;
use riscv_fixup:     masc.isa.riscv.fixup;
use masc.isa.riscv.gen_register;
use riscv_register: masc.isa.riscv.register;

val EVERY: effect.Set = effect.Set{words: ?riscv_register.EVERY[0], len: 2};

# every register it may read and write: what an encoding does is unknown, so a reader takes every register as live into
# it and clobbered by it, and a write that may keep the old value is a read as well. it surely touches none
val TOUCHED: effect.Touched = effect.Touched{read: EVERY, written: EVERY};

val ANYWHERE: [1]effect.Access = [1]effect.Access{
    effect.Access{role: operand.READ_WRITE, operand: field.NO_OPERAND, base: effect.NO_ROW, forming: operand.NO_POSITIONS, width: effect.Width{element: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: effect.Count.unstated{}}, governor: field.NO_OPERAND},
};

# what an encoding no row states does: anything, its registers opaque, since no operand value decides them
pub val OPAQUE: effect.Effect = effect.Effect{
    implicit: effect.Registers.opaque{effect.Opaque{may: TOUCHED, must: effect.NO_TOUCHED}},
    flags:    effect.Flags{read: effect.NO_WORDS, written: effect.NO_WORDS, undefined: effect.NO_WORDS, kept: effect.NO_WORDS},
    memory:   effect.Accesses{at: ?ANYWHERE[0], len: 1},
    control:  effect.Control{transfer: effect.JUMP, target: effect.INDIRECT, conditional: true, operand: field.NO_OPERAND, rules: effect.NO_RULES},
    stack:    effect.Stack.opaque{},
    latency:  effect.SERIAL,
    fixed:    effect.NO_FIXEDS,
};

val RVC_C:   [1]requirement.Id = [1]requirement.Id{riscv_extension.id.C};
val RVC_ZCA: [1]requirement.Id = [1]requirement.Id{riscv_extension.id.ZCA};

# a compressed encoding needs c or zca
val COMPRESSED: [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?RVC_C[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?RVC_ZCA[0], len: 1}, none: requirement.NO_IDS},
};

val RVC: requirement.Requirement = requirement.Requirement{at: ?COMPRESSED[0], len: 2};

val ANY:     [3]u16 = [3]u16{gen_register.X_CLASS, gen_register.F_CLASS, gen_register.V_CLASS};
val ANY_RVC: [2]u16 = [2]u16{gen_register.X_CLASS, gen_register.F_CLASS};

# a compressed opcode of 3 is no compressed encoding
val NOT_RVC: [1]i64 = [1]i64{3};

val OPCODE:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 7, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val OPCODE2: operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 2, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.Integers{at: ?NOT_RVC[0], len: 1}}}, role: operand.READ, width: 0, quantity: operand.ONE};
val FUNCT2:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 2, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val FUNCT3:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 3, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val FUNCT4:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 4, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val FUNCT6:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 6, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val FUNCT7:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 7, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};

# a register operand is read and written, since nothing states which an encoding does
val REG:  operand.Operand = operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?ANY[0], len: 3}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}, unviewed: true}}, role: operand.READ_WRITE, width: 0, quantity: operand.ONE};
val REGC: operand.Operand = operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?ANY_RVC[0], len: 2}, first: 8, count: 8, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}, unviewed: true}}, role: operand.READ_WRITE, width: 0, quantity: operand.ONE};

val IMM12:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 12, signed: true, scale: 0, bias: 0, fixup: riscv_fixup.LO12_I, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val IMM12S: operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 12, signed: true, scale: 0, bias: 0, fixup: riscv_fixup.LO12_S, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val IMM20:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 20, signed: false, scale: 0, bias: 0, fixup: riscv_fixup.HI20, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val SIMM6:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 6, signed: true, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val UIMM5:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 5, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val UIMM6:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 6, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val UIMM8:  operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 8, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};

val BRANCH:     operand.Operand = operand.Operand{shape: operand.Shape.relative{operand.Relative{offset: operand.Immediate{bits: 13, signed: true, scale: 1, bias: 0, fixup: riscv_fixup.BRANCH12, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, anchor: operand.START}}, role: operand.READ, width: 0, quantity: operand.ONE};
val JUMP:       operand.Operand = operand.Operand{shape: operand.Shape.relative{operand.Relative{offset: operand.Immediate{bits: 21, signed: true, scale: 1, bias: 0, fixup: riscv_fixup.JAL20, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, anchor: operand.START}}, role: operand.READ, width: 0, quantity: operand.ONE};
val RVC_BRANCH: operand.Operand = operand.Operand{shape: operand.Shape.relative{operand.Relative{offset: operand.Immediate{bits: 9, signed: true, scale: 1, bias: 0, fixup: riscv_fixup.RVC_BRANCH, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, anchor: operand.START}}, role: operand.READ, width: 0, quantity: operand.ONE};
val RVC_JUMP:   operand.Operand = operand.Operand{shape: operand.Shape.relative{operand.Relative{offset: operand.Immediate{bits: 12, signed: true, scale: 1, bias: 0, fixup: riscv_fixup.RVC_JUMP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, anchor: operand.START}}, role: operand.READ, width: 0, quantity: operand.ONE};

val RAW16: operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 16, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val RAW32: operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 32, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val RAW48: operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 48, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};
val RAW64: operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 64, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE};

val R_OPERANDS:   [6]operand.Operand = [6]operand.Operand{OPCODE, FUNCT3, FUNCT7, REG, REG, REG};
val R4_OPERANDS:  [7]operand.Operand = [7]operand.Operand{OPCODE, FUNCT3, FUNCT2, REG, REG, REG, REG};
val I_OPERANDS:   [5]operand.Operand = [5]operand.Operand{OPCODE, FUNCT3, REG, REG, IMM12};
val S_OPERANDS:   [5]operand.Operand = [5]operand.Operand{OPCODE, FUNCT3, REG, REG, IMM12S};
val B_OPERANDS:   [5]operand.Operand = [5]operand.Operand{OPCODE, FUNCT3, REG, REG, BRANCH};
val U_OPERANDS:   [3]operand.Operand = [3]operand.Operand{OPCODE, REG, IMM20};
val J_OPERANDS:   [3]operand.Operand = [3]operand.Operand{OPCODE, REG, JUMP};
val CR_OPERANDS:  [4]operand.Operand = [4]operand.Operand{OPCODE2, FUNCT4, REG, REG};
val CI_OPERANDS:  [4]operand.Operand = [4]operand.Operand{OPCODE2, FUNCT3, REG, SIMM6};
val CIW_OPERANDS: [4]operand.Operand = [4]operand.Operand{OPCODE2, FUNCT3, REGC, UIMM8};
val CSS_OPERANDS: [4]operand.Operand = [4]operand.Operand{OPCODE2, FUNCT3, REG, UIMM6};
val CL_OPERANDS:  [5]operand.Operand = [5]operand.Operand{OPCODE2, FUNCT3, REGC, REGC, UIMM5};
val CS_OPERANDS:  [5]operand.Operand = [5]operand.Operand{OPCODE2, FUNCT3, REGC, REGC, UIMM5};
val CA_OPERANDS:  [5]operand.Operand = [5]operand.Operand{OPCODE2, FUNCT6, FUNCT2, REGC, REGC};
val CB_OPERANDS:  [4]operand.Operand = [4]operand.Operand{OPCODE2, FUNCT3, REGC, RVC_BRANCH};
val CJ_OPERANDS:  [3]operand.Operand = [3]operand.Operand{OPCODE2, FUNCT3, RVC_JUMP};

val RAW16_OPERANDS: [1]operand.Operand = [1]operand.Operand{RAW16};
val RAW32_OPERANDS: [1]operand.Operand = [1]operand.Operand{RAW32};
val RAW48_OPERANDS: [1]operand.Operand = [1]operand.Operand{RAW48};
val RAW64_OPERANDS: [1]operand.Operand = [1]operand.Operand{RAW64};

# opcode 6:0, funct3 14:12, funct7 31:25, rd 11:7, rs1 19:15, rs2 24:20
val R_SLICES: [6]field.Slice = [6]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 7, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 3, at: 12, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 7, at: 25, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 0, len: 5, at: 7, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 0, len: 5, at: 15, invert: false},
    field.Slice{operand: 5, part: field.NUMBER, lo: 0, len: 5, at: 20, invert: false},
};

# funct2 26:25 and rs3 31:27 in place of funct7
val R4_SLICES: [7]field.Slice = [7]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 7, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 3, at: 12, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 2, at: 25, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 0, len: 5, at: 7, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 0, len: 5, at: 15, invert: false},
    field.Slice{operand: 5, part: field.NUMBER, lo: 0, len: 5, at: 20, invert: false},
    field.Slice{operand: 6, part: field.NUMBER, lo: 0, len: 5, at: 27, invert: false},
};

# imm[11:0] 31:20
val I_SLICES: [5]field.Slice = [5]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 7, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 3, at: 12, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 5, at: 7, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 0, len: 5, at: 15, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 0, len: 12, at: 20, invert: false},
};

# rs2 24:20, rs1 19:15, imm[4:0] 11:7 and imm[11:5] 31:25
val S_SLICES: [6]field.Slice = [6]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 7, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 3, at: 12, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 5, at: 20, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 0, len: 5, at: 15, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 0, len: 5, at: 7, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 5, len: 7, at: 25, invert: false},
};

# rs1 19:15, rs2 24:20, and the target as beq lays it: [4:1] 11:8, [10:5] 30:25, [11] 7, [12] 31
val B_SLICES: [8]field.Slice = [8]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 7, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 3, at: 12, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 5, at: 15, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 0, len: 5, at: 20, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 1, len: 4, at: 8, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 5, len: 6, at: 25, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 11, len: 1, at: 7, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 12, len: 1, at: 31, invert: false},
};

# imm[19:0] 31:12
val U_SLICES: [3]field.Slice = [3]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 7, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 5, at: 7, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 20, at: 12, invert: false},
};

# the target as jal lays it: [10:1] 30:21, [11] 20, [19:12] 19:12, [20] 31
val J_SLICES: [6]field.Slice = [6]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 7, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 5, at: 7, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 1, len: 10, at: 21, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 11, len: 1, at: 20, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 12, len: 8, at: 12, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 20, len: 1, at: 31, invert: false},
};

# opcode 1:0, funct4 15:12, rd 11:7, rs2 6:2
val CR_SLICES: [4]field.Slice = [4]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 2, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 4, at: 12, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 5, at: 7, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 0, len: 5, at: 2, invert: false},
};

# funct3 15:13, rd 11:7, imm[5] 12 and imm[4:0] 6:2
val CI_SLICES: [5]field.Slice = [5]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 2, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 3, at: 13, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 5, at: 7, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 5, len: 1, at: 12, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 0, len: 5, at: 2, invert: false},
};

# rd' 4:2, imm[7:0] 12:5
val CIW_SLICES: [4]field.Slice = [4]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 2, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 3, at: 13, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 3, at: 2, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 0, len: 8, at: 5, invert: false},
};

# rs2 6:2, imm[5:0] 12:7
val CSS_SLICES: [4]field.Slice = [4]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 2, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 3, at: 13, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 5, at: 2, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 0, len: 6, at: 7, invert: false},
};

# rd' or rs2' 4:2, rs1' 9:7, imm[4:2] 12:10 and imm[1:0] 6:5
val CL_SLICES: [6]field.Slice = [6]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 2, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 3, at: 13, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 3, at: 2, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 0, len: 3, at: 7, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 2, len: 3, at: 10, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 0, len: 2, at: 5, invert: false},
};

# funct6 15:10, funct2 6:5, rd' 9:7, rs2' 4:2
val CA_SLICES: [5]field.Slice = [5]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 2, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 6, at: 10, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 2, at: 5, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 0, len: 3, at: 7, invert: false},
    field.Slice{operand: 4, part: field.NUMBER, lo: 0, len: 3, at: 2, invert: false},
};

# rs1' 9:7, and the target as c.beqz lays it: [8] 12, [4:3] 11:10, [7:6] 6:5, [2:1] 4:3, [5] 2
val CB_SLICES: [8]field.Slice = [8]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 2, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 3, at: 13, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 0, len: 3, at: 7, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 8, len: 1, at: 12, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 3, len: 2, at: 10, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 6, len: 2, at: 5, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 1, len: 2, at: 3, invert: false},
    field.Slice{operand: 3, part: field.NUMBER, lo: 5, len: 1, at: 2, invert: false},
};

# the target as c.j lays it: [11] 12, [4] 11, [9:8] 10:9, [10] 8, [6] 7, [7] 6, [3:1] 5:3, [5] 2
val CJ_SLICES: [10]field.Slice = [10]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 2, at: 0, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 3, at: 13, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 11, len: 1, at: 12, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 4, len: 1, at: 11, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 8, len: 2, at: 9, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 10, len: 1, at: 8, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 6, len: 1, at: 7, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 7, len: 1, at: 6, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 1, len: 3, at: 3, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 5, len: 1, at: 2, invert: false},
};

val RAW16_SLICES: [1]field.Slice = [1]field.Slice{field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 16, at: 0, invert: false}};
val RAW32_SLICES: [1]field.Slice = [1]field.Slice{field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 32, at: 0, invert: false}};
val RAW48_SLICES: [1]field.Slice = [1]field.Slice{field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 48, at: 0, invert: false}};
val RAW64_SLICES: [1]field.Slice = [1]field.Slice{field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 64, at: 0, invert: false}};

# the catalog's unit field kind, every slice placed in one unit of the format's width
val UNIT: u16 = 0;

val FIELDS: [17]field.Field = [17]field.Field{
    field.Field{kind: UNIT, width: 32, fixed: 0, mask: 0, slices: field.Slices{at: ?R_SLICES[0], len: 6}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 32, fixed: 0, mask: 0, slices: field.Slices{at: ?R4_SLICES[0], len: 7}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 32, fixed: 0, mask: 0, slices: field.Slices{at: ?I_SLICES[0], len: 5}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 32, fixed: 0, mask: 0, slices: field.Slices{at: ?S_SLICES[0], len: 6}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 32, fixed: 0, mask: 0, slices: field.Slices{at: ?B_SLICES[0], len: 8}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 32, fixed: 0, mask: 0, slices: field.Slices{at: ?U_SLICES[0], len: 3}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 32, fixed: 0, mask: 0, slices: field.Slices{at: ?J_SLICES[0], len: 6}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CR_SLICES[0], len: 4}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CI_SLICES[0], len: 5}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CIW_SLICES[0], len: 4}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CSS_SLICES[0], len: 4}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CL_SLICES[0], len: 6}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CA_SLICES[0], len: 5}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CB_SLICES[0], len: 8}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?CJ_SLICES[0], len: 10}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?RAW16_SLICES[0], len: 1}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 32, fixed: 0, mask: 0, slices: field.Slices{at: ?RAW32_SLICES[0], len: 1}, operand: field.NO_OPERAND, param: 0},
};

val WIDE: [2]field.Field = [2]field.Field{
    field.Field{kind: UNIT, width: 48, fixed: 0, mask: 0, slices: field.Slices{at: ?RAW48_SLICES[0], len: 1}, operand: field.NO_OPERAND, param: 0},
    field.Field{kind: UNIT, width: 64, fixed: 0, mask: 0, slices: field.Slices{at: ?RAW64_SLICES[0], len: 1}, operand: field.NO_OPERAND, param: 0},
};

val ROWS: [20]row.Row = [20]row.Row{
    row.Row{key: "insn.r", mnemonic: ".insn", operands: row.Operands{at: ?R_OPERANDS[0], len: 6}, encoding: field.Fields{at: ?FIELDS[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.r4", mnemonic: ".insn", operands: row.Operands{at: ?R4_OPERANDS[0], len: 7}, encoding: field.Fields{at: ?FIELDS[1], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.i", mnemonic: ".insn", operands: row.Operands{at: ?I_OPERANDS[0], len: 5}, encoding: field.Fields{at: ?FIELDS[2], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.s", mnemonic: ".insn", operands: row.Operands{at: ?S_OPERANDS[0], len: 5}, encoding: field.Fields{at: ?FIELDS[3], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.b", mnemonic: ".insn", operands: row.Operands{at: ?B_OPERANDS[0], len: 5}, encoding: field.Fields{at: ?FIELDS[4], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.u", mnemonic: ".insn", operands: row.Operands{at: ?U_OPERANDS[0], len: 3}, encoding: field.Fields{at: ?FIELDS[5], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.j", mnemonic: ".insn", operands: row.Operands{at: ?J_OPERANDS[0], len: 3}, encoding: field.Fields{at: ?FIELDS[6], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.cr", mnemonic: ".insn", operands: row.Operands{at: ?CR_OPERANDS[0], len: 4}, encoding: field.Fields{at: ?FIELDS[7], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.ci", mnemonic: ".insn", operands: row.Operands{at: ?CI_OPERANDS[0], len: 4}, encoding: field.Fields{at: ?FIELDS[8], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.ciw", mnemonic: ".insn", operands: row.Operands{at: ?CIW_OPERANDS[0], len: 4}, encoding: field.Fields{at: ?FIELDS[9], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.css", mnemonic: ".insn", operands: row.Operands{at: ?CSS_OPERANDS[0], len: 4}, encoding: field.Fields{at: ?FIELDS[10], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.cl", mnemonic: ".insn", operands: row.Operands{at: ?CL_OPERANDS[0], len: 5}, encoding: field.Fields{at: ?FIELDS[11], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.cs", mnemonic: ".insn", operands: row.Operands{at: ?CS_OPERANDS[0], len: 5}, encoding: field.Fields{at: ?FIELDS[11], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.ca", mnemonic: ".insn", operands: row.Operands{at: ?CA_OPERANDS[0], len: 5}, encoding: field.Fields{at: ?FIELDS[12], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.cb", mnemonic: ".insn", operands: row.Operands{at: ?CB_OPERANDS[0], len: 4}, encoding: field.Fields{at: ?FIELDS[13], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.cj", mnemonic: ".insn", operands: row.Operands{at: ?CJ_OPERANDS[0], len: 3}, encoding: field.Fields{at: ?FIELDS[14], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw16", mnemonic: ".insn", operands: row.Operands{at: ?RAW16_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?FIELDS[15], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw32", mnemonic: ".insn", operands: row.Operands{at: ?RAW32_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?FIELDS[16], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw48", mnemonic: ".insn", operands: row.Operands{at: ?RAW48_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?WIDE[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw64", mnemonic: ".insn", operands: row.Operands{at: ?RAW64_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?WIDE[1], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
};

# every format by its text after `.insn`: `sb` and `uj` are b and j by their older names, an r with four registers is
# r4, and i reads a register or a load's offset and base
val FORMAT_COUNT: u32                         = 24;
val FORMATS:      [FORMAT_COUNT]source.Format = [FORMAT_COUNT]source.Format{
    source.Format{template: "r <0>, <1>, <2>, <3>, <4>, <5>", row: ?ROWS[0], length: 0},
    source.Format{template: "r <0>, <1>, <2>, <3>, <4>, <5>, <6>", row: ?ROWS[1], length: 0},
    source.Format{template: "r4 <0>, <1>, <2>, <3>, <4>, <5>, <6>", row: ?ROWS[1], length: 0},
    source.Format{template: "i <0>, <1>, <2>, <3>, <4>", row: ?ROWS[2], length: 0},
    source.Format{template: "i <0>, <1>, <2>, <4>(<3>)", row: ?ROWS[2], length: 0},
    source.Format{template: "s <0>, <1>, <2>, <4>(<3>)", row: ?ROWS[3], length: 0},
    source.Format{template: "b <0>, <1>, <2>, <3>, <4>", row: ?ROWS[4], length: 0},
    source.Format{template: "sb <0>, <1>, <2>, <3>, <4>", row: ?ROWS[4], length: 0},
    source.Format{template: "u <0>, <1>, <2>", row: ?ROWS[5], length: 0},
    source.Format{template: "j <0>, <1>, <2>", row: ?ROWS[6], length: 0},
    source.Format{template: "uj <0>, <1>, <2>", row: ?ROWS[6], length: 0},
    source.Format{template: "cr <0>, <1>, <2>, <3>", row: ?ROWS[7], length: 0},
    source.Format{template: "ci <0>, <1>, <2>, <3>", row: ?ROWS[8], length: 0},
    source.Format{template: "ciw <0>, <1>, <2>, <3>", row: ?ROWS[9], length: 0},
    source.Format{template: "css <0>, <1>, <2>, <3>", row: ?ROWS[10], length: 0},
    source.Format{template: "cl <0>, <1>, <2>, <4>(<3>)", row: ?ROWS[11], length: 0},
    source.Format{template: "cs <0>, <1>, <2>, <4>(<3>)", row: ?ROWS[12], length: 0},
    source.Format{template: "ca <0>, <1>, <2>, <3>, <4>", row: ?ROWS[13], length: 0},
    source.Format{template: "cb <0>, <1>, <2>, <3>", row: ?ROWS[14], length: 0},
    source.Format{template: "cj <0>, <1>, <2>", row: ?ROWS[15], length: 0},
    source.Format{template: "2, <0>", row: ?ROWS[16], length: 2},
    source.Format{template: "4, <0>", row: ?ROWS[17], length: 4},
    source.Format{template: "6, <0>", row: ?ROWS[18], length: 6},
    source.Format{template: "8, <0>", row: ?ROWS[19], length: 8},
};

# the formats of risc-v's instruction directive
pub val ALL: source.Formats = source.Formats{at: ?FORMATS[0], len: FORMAT_COUNT};

# the integer data directives at their gnu assembler widths on risc-v
val WIDTHS: [5]source.Width = [5]source.Width{
    source.Width{name: ".byte", width: 1},
    source.Width{name: ".short", width: 2},
    source.Width{name: ".word", width: 4},
    source.Width{name: ".long", width: 4},
    source.Width{name: ".quad", width: 8},
};

val NO_RVC: [1]requirement.Id = [1]requirement.Id{riscv_extension.id.ZCA};

# `.option norvc` keeps the statements after it full length and refuses compressed instructions, and `.option rvc`
# lifts it (gas manual, "RISC-V Directives", `.option`). removing zca takes c and every zc* that implies it, so the
# selection stays closed and refuses every compressed instruction, as llvm-mc does after it
val NARROWINGS: [1]source.Narrowing = [1]source.Narrowing{
    source.Narrowing{narrow: "norvc", lift: "rvc", removes: requirement.Ids{at: ?NO_RVC[0], len: 1}, lifted: riscv_extension.id.C},
};

# the form directive, its stack saved by `push` and restored by `pop`, and `arch` restating the selection by an isa
# string or `+` and `-` edits of it (riscv-asm-manual, ".option")
val FORMS: source.Forms = source.Forms{directive: ".option", push: "push", pop: "pop", narrowings: source.Narrowings{at: ?NARROWINGS[0], len: 1}, restates: "arch"};

# the tags of `.attribute` (risc-v psabi, "RISC-V ELF Attributes", and gas manual, "RISC-V Directives"), each with
# the trait mink's object model states it by. atomic_abi and x3_reg_usage have no axis in mink yet
val TAGS: [8]source.Tag = [8]source.Tag{
    source.Tag{name: "stack_align", number: 4, axis: ?mink.arch.RISCV_STACK_ALIGN, selection: false},
    source.Tag{name: "arch", number: 5, axis: ?mink.arch.RISCV_ARCH, selection: true},
    source.Tag{name: "unaligned_access", number: 6, axis: ?mink.arch.RISCV_UNALIGNED_ACCESS, selection: false},
    source.Tag{name: "priv_spec", number: 8, axis: ?mink.arch.RISCV_PRIV_SPEC, selection: false},
    source.Tag{name: "priv_spec_minor", number: 10, axis: ?mink.arch.RISCV_PRIV_SPEC_MINOR, selection: false},
    source.Tag{name: "priv_spec_revision", number: 12, axis: ?mink.arch.RISCV_PRIV_SPEC_REVISION, selection: false},
    source.Tag{name: "atomic_abi", number: 14, axis: nil, selection: false},
    source.Tag{name: "x3_reg_usage", number: 16, axis: nil, selection: false},
};

val ATTRIBUTES: source.Attributes = source.Attributes{directive: ".attribute", tags: source.Tags{at: ?TAGS[0], len: 8}};

# the length the low bits `low` of a parcel encode (unprivileged spec, "Expanded Instruction-Length Encoding"): 16 bits
# unless the low two are set, 32 unless bits 2 to 4 are too, then 48 and 64, and 0 for a reserved longer encoding
fun encoded(low: u8) usize {
    if ((low & 0x03) != 0x03) { ret 2; }
    if ((low & 0x1c) != 0x1c) { ret 4; }
    if ((low & 0x3f) == 0x1f) { ret 6; }
    if ((low & 0x7f) == 0x3f) { ret 8; }
    ret 0;
}

# the code at `at` by its length encoding, a reserved longer encoding a parcel at a time, the bytes left when fewer
pub fun parcel(data: *u8, len: usize, at: usize) usize {
    val left: usize = len - at;
    if (left < 2) { ret left; }
    var n: usize = encoded(data[at]);
    if (n == 0)   { n = 2; }
    if (n > left) { ret left; }
    ret n;
}

# the length the encoding at `data` states, 0 for a reserved longer one, which no raw form of `.insn` takes
fun stated(data: *u8, len: usize) usize {
    if (len == 0) { ret 0; }
    ret encoded(data[0]);
}

# the instruction directive, its formats those of the gnu assembler as llvm-mc reads them
val INSNS: source.Insns = source.Insns{directive: ".insn", formats: ALL, length: stated};

# the dialect of risc-v's gnu assembler
pub val SOURCE: source.Source = source.Source{comment: "#", separator: ';', types: "@%", align: source.ALIGN_POWER, widths: source.Widths{at: ?WIDTHS[0], len: 5}, forms: FORMS, attributes: ATTRIBUTES, insns: INSNS};
