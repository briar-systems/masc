    row.Row{key: "insn.b", mnemonic: ".insn", operands: row.Operands{at: ?B_OPERANDS[0], len: 5}, encoding: field.Fields{at: ?FIELDS[4], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.u", mnemonic: ".insn", operands: row.Operands{at: ?U_OPERANDS[0], len: 3}, encoding: field.Fields{at: ?FIELDS[5], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.j", mnemonic: ".insn", operands: row.Operands{at: ?J_OPERANDS[0], len: 3}, encoding: field.Fields{at: ?FIELDS[6], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.cr", mnemonic: ".insn", operands: row.Operands{at: ?CR_OPERANDS[0], len: 4}, encoding: field.Fields{at: ?FIELDS[7], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.ci", mnemonic: ".insn", operands: row.Operands{at: ?CI_OPERANDS[0], len: 4}, encoding: field.Fields{at: ?FIELDS[8], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.ciw", mnemonic: ".insn", operands: row.Operands{at: ?CIW_OPERANDS[0], len: 4}, encoding: field.Fields{at: ?FIELDS[9], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.css", mnemonic: ".insn", operands: row.Operands{at: ?CSS_OPERANDS[0], len: 4}, encoding: field.Fields{at: ?FIELDS[10], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.cl", mnemonic: ".insn", operands: row.Operands{at: ?CL_OPERANDS[0], len: 5}, encoding: field.Fields{at: ?FIELDS[11], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.cs", mnemonic: ".insn", operands: row.Operands{at: ?CS_OPERANDS[0], len: 5}, encoding: field.Fields{at: ?FIELDS[11], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.ca", mnemonic: ".insn", operands: row.Operands{at: ?CA_OPERANDS[0], len: 5}, encoding: field.Fields{at: ?FIELDS[12], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.cb", mnemonic: ".insn", operands: row.Operands{at: ?CB_OPERANDS[0], len: 4}, encoding: field.Fields{at: ?FIELDS[13], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.cj", mnemonic: ".insn", operands: row.Operands{at: ?CJ_OPERANDS[0], len: 3}, encoding: field.Fields{at: ?FIELDS[14], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw16", mnemonic: ".insn", operands: row.Operands{at: ?RAW16_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?FIELDS[15], len: 1}, requires: RVC, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw32", mnemonic: ".insn", operands: row.Operands{at: ?RAW32_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?FIELDS[16], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw48", mnemonic: ".insn", operands: row.Operands{at: ?RAW48_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?WIDE[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw64", mnemonic: ".insn", operands: row.Operands{at: ?RAW64_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?WIDE[1], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0}, row.Row{key: "insn.raw80", mnemonic: ".insn", operands: row.Operands{at: ?RAW80_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?WIDE[2], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw96", mnemonic: ".insn", operands: row.Operands{at: ?RAW96_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?WIDE[3], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw112", mnemonic: ".insn", operands: row.Operands{at: ?RAW112_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?WIDE[4], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw128", mnemonic: ".insn", operands: row.Operands{at: ?RAW128_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?WIDE[5], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw144", mnemonic: ".insn", operands: row.Operands{at: ?RAW144_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?WIDE[6], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw160", mnemonic: ".insn", operands: row.Operands{at: ?RAW160_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?WIDE[7], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
    row.Row{key: "insn.raw176", mnemonic: ".insn", operands: row.Operands{at: ?RAW176_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?WIDE[8], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
};

# a name `.insn` reads an opcode operand by, and the opcode it names
# ---
# name:  the name, read without regard to case
# value: the opcode
pub rec Opcode {
    name:  str;
    value: i64;
}

# opcodes as a pointer to static rows and a count
pub rec Opcodes {
    at:  *Opcode;
    len: u32;
}

# the major opcodes of the 32-bit encodings by the names the vendor tools read in a format's opcode operand (unprivileged
# spec, "RISC-V base opcode map", as gas 2.47 and llvm-mc 23.1.1 name them, RISCVInstrInfo.td "RISCVOpcode")
val OPCODE_ROWS: [26]Opcode = [26]Opcode{
    Opcode{name: "LOAD", value: 0x03},
    Opcode{name: "LOAD_FP", value: 0x07},
    Opcode{name: "CUSTOM_0", value: 0x0b},
    Opcode{name: "MISC_MEM", value: 0x0f},
    Opcode{name: "OP_IMM", value: 0x13},
    Opcode{name: "AUIPC", value: 0x17},
    Opcode{name: "OP_IMM_32", value: 0x1b},
    Opcode{name: "STORE", value: 0x23},
    Opcode{name: "STORE_FP", value: 0x27},
    Opcode{name: "CUSTOM_1", value: 0x2b},
    Opcode{name: "AMO", value: 0x2f},
    Opcode{name: "OP", value: 0x33},
    Opcode{name: "LUI", value: 0x37},
    Opcode{name: "OP_32", value: 0x3b},
    Opcode{name: "MADD", value: 0x43},
    Opcode{name: "MSUB", value: 0x47},
    Opcode{name: "NMSUB", value: 0x4b},
    Opcode{name: "NMADD", value: 0x4f},
    Opcode{name: "OP_FP", value: 0x53},
    Opcode{name: "OP_V", value: 0x57},
    Opcode{name: "CUSTOM_2", value: 0x5b},
    Opcode{name: "BRANCH", value: 0x63},
    Opcode{name: "JALR", value: 0x67},
    Opcode{name: "JAL", value: 0x6f},
    Opcode{name: "SYSTEM", value: 0x73},
    Opcode{name: "CUSTOM_3", value: 0x7b},
};

pub val OPCODES: Opcodes = Opcodes{at: ?OPCODE_ROWS[0], len: 26};

# the quadrants of the compressed encodings by name, which a compressed format's opcode operand reads (unprivileged spec,
# "RVC opcode map", quadrants 0 to 2)
val QUADRANT_ROWS: [3]Opcode = [3]Opcode{
    Opcode{name: "C0", value: 0},
    Opcode{name: "C1", value: 1},
    Opcode{name: "C2", value: 2},
};

pub val QUADRANTS: Opcodes = Opcodes{at: ?QUADRANT_ROWS[0], len: 3};

# every format by its text after `.insn`: `sb` and `uj` are b and j by their older names, an r with four registers is
# r4, and i reads a register or a load's offset and base. a format's opcode is a number or a name of OPCODES, and a
# compressed format's a number or a name of QUADRANTS, which the syntax's immediate hook reads
val FORMAT_COUNT: u32                         = 31;
val FORMATS:      [FORMAT_COUNT]source.Format = [FORMAT_COUNT]source.Format{
    source.Format{template: "r <0:opcode>, <1>, <2>, <3>, <4>, <5>", row: ?ROWS[0], length: 0},
    source.Format{template: "r <0:opcode>, <1>, <2>, <3>, <4>, <5>, <6>", row: ?ROWS[1], length: 0},
    source.Format{template: "r4 <0:opcode>, <1>, <2>, <3>, <4>, <5>, <6>", row: ?ROWS[1], length: 0},
    source.Format{template: "i <0:opcode>, <1>, <2>, <3>, <4>", row: ?ROWS[2], length: 0},
    source.Format{template: "i <0:opcode>, <1>, <2>, <4>(<3>)", row: ?ROWS[2], length: 0},
    source.Format{template: "s <0:opcode>, <1>, <2>, <4>(<3>)", row: ?ROWS[3], length: 0},
    source.Format{template: "b <0:opcode>, <1>, <2>, <3>, <4>", row: ?ROWS[4], length: 0},
    source.Format{template: "sb <0:opcode>, <1>, <2>, <3>, <4>", row: ?ROWS[4], length: 0},
    source.Format{template: "u <0:opcode>, <1>, <2>", row: ?ROWS[5], length: 0},
    source.Format{template: "j <0:opcode>, <1>, <2>", row: ?ROWS[6], length: 0},
    source.Format{template: "uj <0:opcode>, <1>, <2>", row: ?ROWS[6], length: 0},
    source.Format{template: "cr <0:quadrant>, <1>, <2>, <3>", row: ?ROWS[7], length: 0},
    source.Format{template: "ci <0:quadrant>, <1>, <2>, <3>", row: ?ROWS[8], length: 0},
    source.Format{template: "ciw <0:quadrant>, <1>, <2>, <3>", row: ?ROWS[9], length: 0},
    source.Format{template: "css <0:quadrant>, <1>, <2>, <3>", row: ?ROWS[10], length: 0},
    source.Format{template: "cl <0:quadrant>, <1>, <2>, <4>(<3>)", row: ?ROWS[11], length: 0},
    source.Format{template: "cs <0:quadrant>, <1>, <2>, <4>(<3>)", row: ?ROWS[12], length: 0},
    source.Format{template: "ca <0:quadrant>, <1>, <2>, <3>, <4>", row: ?ROWS[13], length: 0},
    source.Format{template: "cb <0:quadrant>, <1>, <2>, <3>", row: ?ROWS[14], length: 0},
    source.Format{template: "cj <0:quadrant>, <1>, <2>", row: ?ROWS[15], length: 0},
    source.Format{template: "2, <0>", row: ?ROWS[16], length: 2},
    source.Format{template: "4, <0>", row: ?ROWS[17], length: 4},
    source.Format{template: "6, <0>", row: ?ROWS[18], length: 6},
    source.Format{template: "8, <0>", row: ?ROWS[19], length: 8},
    source.Format{template: "10, <0>", row: ?ROWS[20], length: 10},
    source.Format{template: "12, <0>", row: ?ROWS[21], length: 12},
    source.Format{template: "14, <0>", row: ?ROWS[22], length: 14},
    source.Format{template: "16, <0>", row: ?ROWS[23], length: 16},
    source.Format{template: "18, <0>", row: ?ROWS[24], length: 18},
    source.Format{template: "20, <0>", row: ?ROWS[25], length: 20},
    source.Format{template: "22, <0>", row: ?ROWS[26], length: 22},
};

# the formats of risc-v's instruction directive
pub val ALL: source.Formats = source.Formats{at: ?FORMATS[0], len: FORMAT_COUNT};

# the integer data directives at their gnu assembler widths on risc-v
val WIDTHS: [5]source.Width = [5]source.Width{
    source.Width{name: ".byte", width: 1},
    source.Width{name: ".short", width: 2},
    source.Width{name: ".word", width: 4},
    source.Width{name: ".long", width: 4},
    source.Width{name: ".quad", width: 8},
};

# the length the first two bytes of an encoding state (unprivileged spec, "Expanded Instruction-Length Encoding"): 16
# bits unless the low two bits are set, 32 unless bits 2 to 4 are too, then 48 and 64, then 80 plus 16 for each step of
# bits 14 to 12 up to 176, as gas 2.47 reads them (include/opcode/riscv.h, riscv_insn_length), and 0 for the reserved
# encodings of 192 bits and more, which bits 14 to 12 all set state
fun encoded(low: u8, high: u8) usize {
    if ((low & 0x03) != 0x03)  { ret 2; }
    if ((low & 0x1c) != 0x1c)  { ret 4; }
    if ((low & 0x3f) == 0x1f)  { ret 6; }
    if ((low & 0x7f) == 0x3f)  { ret 8; }
    if ((high & 0x70) == 0x70) { ret 0; }
    ret 10 + 2 * ((high >> 4) & 7)::usize;
}

# the code at `at` by its length encoding, a reserved longer encoding a parcel at a time, the bytes left when fewer
pub fun parcel(data: *u8, len: usize, at: usize) usize {
    val left: usize = len - at;
    if (left < 2) { ret left; }
    var n: usize = encoded(data[at], data[at + 1]);
    if (n == 0)   { n = 2; }
    if (n > left) { ret left; }
    ret n;
}

# the length the encoding at `data` states, 0 for a reserved longer one, which no raw form of `.insn` takes
fun stated(data: *u8, len: usize) usize {
    if (len == 0) { ret 0; }
    if (len == 1) { ret encoded(data[0], 0); }
    ret encoded(data[0], data[1]);
}

# the instructions `.insn` states, its formats those of the gnu assembler as llvm-mc reads them
val INSNS: source.Insns = source.Insns{formats: ALL, length: stated, listed: false};

val NO_RVC: [1]requirement.Id = [1]requirement.Id{riscv_extension.id.ZCA};

# the directives of risc-v's dialect (riscv-asm-manual, ".option", gas manual, "RISC-V Directives"). `.option norvc`
# keeps the statements after it full length: removing zca takes c and every zc* that implies it, so the selection stays
# closed and refuses every compressed instruction, as llvm-mc does after it, and `.option rvc` adds c back, lifting it,
# as llvm-mc 23.1.1 adds c to a selection that lacks it. `.option arch` restates the selection by an isa string or `+`
# and `-` edits of it, `push` and `pop` save and restore what is in force, `pic` and `nopic` choose the position mode, `relax` and `norelax` the relax mode,
# `.attribute` states the psabi's attributes ("RISC-V ELF Attributes") by the tags the object format names, and `.insn`
# states an instruction by its encoding
val DIRECTIVES: [11]source.Directive = [11]source.Directive{
    source.Directive{name: ".option", operands: source.Shape{word: "rvc", takes: source.TAKES_NOTHING}, edit: source.Edit.widen{requirement.Ids{at: ?RVC_C[0], len: 1}}},
    source.Directive{name: ".option", operands: source.Shape{word: "norvc", takes: source.TAKES_NOTHING}, edit: source.Edit.narrow{requirement.Ids{at: ?NO_RVC[0], len: 1}}},
    source.Directive{name: ".option", operands: source.Shape{word: "arch", takes: source.TAKES_SELECTION}, edit: source.Edit.restate{extension.EVERY_KIND}},
    source.Directive{name: ".option", operands: source.Shape{word: "push", takes: source.TAKES_NOTHING}, edit: source.Edit.push{}},
    source.Directive{name: ".option", operands: source.Shape{word: "pop", takes: source.TAKES_NOTHING}, edit: source.Edit.pop{}},
    source.Directive{name: ".option", operands: source.Shape{word: "pic", takes: source.TAKES_NOTHING}, edit: source.Edit.mode{mode.Setting{mode: ?riscv_mode.POSITION, value: ?riscv_mode.PIC}}},
    source.Directive{name: ".option", operands: source.Shape{word: "nopic", takes: source.TAKES_NOTHING}, edit: source.Edit.mode{mode.Setting{mode: ?riscv_mode.POSITION, value: ?riscv_mode.NOPIC}}},
    source.Directive{name: ".option", operands: source.Shape{word: "relax", takes: source.TAKES_NOTHING}, edit: source.Edit.mode{mode.Setting{mode: ?riscv_mode.RELAXING, value: ?riscv_mode.RELAX}}},
    source.Directive{name: ".option", operands: source.Shape{word: "norelax", takes: source.TAKES_NOTHING}, edit: source.Edit.mode{mode.Setting{mode: ?riscv_mode.RELAXING, value: ?riscv_mode.NORELAX}}},
    source.Directive{name: ".attribute", operands: source.Shape{word: "", takes: source.TAKES_ATTRIBUTE}, edit: source.Edit.attribute{}},
    source.Directive{name: ".insn", operands: source.Shape{word: "", takes: source.TAKES_ENCODING}, edit: source.Edit.raw{INSNS}},
};

# the mapping symbols of risc-v (psabi, "Mapping Symbol"): `$x` where code starts, followed by the isa string of the
# selection it is written under, as llvm-mc 23.1.1 writes `$xrv64i2p1_c2p0_zca1p0`, and `$d` where data starts
val MAPPING: source.Mapping = source.Mapping{code: "$x", data: "$d", per_view: true};

# the dialect of risc-v's gnu assembler
pub val SOURCE: source.Source = source.Source{comment: "#", separator: ';', types: "@%", align: source.ALIGN_POWER, widths: source.Widths{at: ?WIDTHS[0], len: 5}, directives: source.Directives{at: ?DIRECTIVES[0], len: 11}, mapping: MAPPING};
