# the risc-v catalog
#
# the rows, their codec and decode dispatch, the csr id space, the relaxation
# rows and the code fill are generated from riscv-opcodes by gen's riscv
# generator, the fixup bindings are masc.isa.riscv.fixup, and the field
# kinds, extension catalog and register file are their own modules. the
# tests here walk the shipped rows: every row encodes and decodes back to
# itself, every row's effect agrees with its fields, and the encode and
# decode walks of the core refuse what they must on real rows.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.core.constraint;
use masc.core.diagnostic;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.inst;
use masc.core.operand;
use masc.core.register;
use masc.core.relax;
use masc.core.requirement;
use masc.core.row;
use masc.core.walk;

use riscv_csr:       masc.isa.riscv.csr;
use riscv_extension: masc.isa.riscv.extension;
use riscv_field:     masc.isa.riscv.field;
use riscv_register:  masc.isa.riscv.register;
use riscv_vtype:     masc.isa.riscv.vtype;

fwd masc.isa.riscv.gen_csr.TABLE;
fwd masc.isa.riscv.gen_relax.FILL;
fwd masc.isa.riscv.gen_relax.RELAXATIONS;
fwd masc.isa.riscv.gen_row.CODEC;
fwd masc.isa.riscv.fixup.BINDINGS;

use masc.isa.riscv.gen_csr;
use masc.isa.riscv.gen_register;
use masc.isa.riscv.gen_relax;
use masc.isa.riscv.gen_row;

# a test's selection of one row's extensions, its register view and output buffers
#[testing]
rec T {
    t:      testing.Testing;
    s:      extension.Selection;
    v:      register.Available;
    out:    vector.Vector[u8];
    fixups: vector.Vector[field.Fixup];
}

#[testing]
fun t_view(t: *T) bool {
    val viewed: res[register.Available, register.Error] = register.select(testing.allocator_of(?t.t), ?riscv_register.FILE, ?t.s);
    if (sel viewed.err) { ret false; }
    t.v      = viewed.ok;
    t.out    = vector.init[u8](testing.allocator_of(?t.t));
    t.fixups = vector.init[field.Fixup](testing.allocator_of(?t.t));
    ret true;
}

# a test over the selection `spelling` makes
#[testing]
fun t_make(t: *T, spelling: str) bool {
    testing.make(?t.t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t.t), ?riscv_extension.CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    ret t_view(t);
}

# a test over the first alternative of `r`'s requirement, the i base and a width: rv32 when the alternative names it, else rv64
#[testing]
fun t_make_for(t: *T, r: *row.Row) bool {
    testing.make(?t.t);
    val made: res[extension.Request, extension.Error] = extension.request(testing.allocator_of(?t.t), ?riscv_extension.CATALOG, "", diagnostic.START);
    if (sel made.err) { ret false; }
    var req:   extension.Request = made.ok;
    var width: requirement.Id    = riscv_extension.RV64;
    if (r.requires.len > 0) {
        val alt: requirement.Ids = r.requires.at[0];
        var i:   u32             = 0;
        for (i < alt.len) {
            extension.request_add(?req, alt.at[i]);
            if (alt.at[i] == riscv_extension.RV32) { width = riscv_extension.RV32; }
            i = i + 1;
        }
    }
    extension.request_add(?req, width);
    extension.request_add(?req, riscv_extension.I);
    val closed: res[extension.Selection, extension.Error] = extension.close(req);
    if (sel closed.err) { ret false; }
    t.s = closed.ok;
    ret t_view(t);
}

# the index of the first row spelled `mnemonic`
#[testing]
fun t_row(mnemonic: str) u32 {
    var i: u32 = 0;
    for (i < CODEC.rows.len) {
        if (str_equals(CODEC.rows.at[i].mnemonic, mnemonic)) { ret i; }
        i = i + 1;
    }
    ret CODEC.rows.len;
}

#[testing]
fun t_encode(t: *T, r: u32, values: *operand.Value, count: u32) res[usize, field.Refusal] {
    var ins: inst.Inst = inst.Inst{row: ?CODEC.rows.at[r], values: values, count: count};
    ret walk.encode(?CODEC, ?t.v, ?ins, ?t.out, ?t.fixups);
}

#[testing]
fun t_refused(got: res[usize, field.Refusal], message: str, op: u8) bool {
    ret sel got.err && (got.err.message == message && got.err.operand == op);
}

# whether the output is exactly `want`
#[testing]
fun t_wrote(t: *T, want: *u8, len: usize) bool {
    if (t.out.len != len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (t.out.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun t_x(n: u16) operand.Value {
    ret operand.Value.register{register.make(0, n)};
}

# the largest value `imm` holds, its scale's multiple, less `k` steps of the scale
#[testing]
fun t_immediate(imm: *operand.Immediate, k: u32) i64 {
    var top: i64 = field.ones(imm.bits)::i64;
    if (imm.signed) { top = (1::i64 << (imm.bits - 1)::i64) - 1; }
    val step: i64 = 1::i64 << imm.scale::i64;
    top = top - (top % step);
    ret top - k::i64 * step + imm.bias;
}

# the value of operand `desc` at try `k`: registers from the top of the range down,
# immediates from the largest down by their scale, enumerants from the last member, a mask from all of them
#[testing]
fun t_value(desc: *operand.Operand, k: u32) opt[operand.Value] {
    val shape: *operand.Shape = ?desc.shape;
    if (sel shape.register) {
        val r:     *operand.Register = ?shape.register;
        val class: u16               = r.classes.at[0];
        val count: u32               = riscv_register.FILE.classes[class].count;
        val span:  u32               = operand.span(r, count);
        if (k >= span) { ret opt[operand.Value].none{}; }
        ret opt[operand.Value].some{operand.Value.register{register.make(class, (r.first + span - 1 - k)::u16)}};
    }
    if (sel shape.immediate) { ret opt[operand.Value].some{operand.Value.immediate{t_immediate(?shape.immediate, k)}}; }
    if (sel shape.relative)  { ret opt[operand.Value].some{operand.Value.relative{t_immediate(?shape.relative.offset, k)}}; }
    if (sel shape.id)        { ret opt[operand.Value].some{operand.Value.id{(field.ones(shape.id.bits)::u32 - k)}}; }
    if (sel shape.enumerant) {
        val e: *operand.Enumeration = ?shape.enumerant;
        if (e.mask) {
            if (k == 0) {
                var all: u32 = 0;
                var i:   u32 = 0;
                for (i < e.count) {
                    all = all | e.members[i].value;
                    i   = i + 1;
                }
                ret opt[operand.Value].some{operand.Value.enumerant{all}};
            }
            if (k > e.count) { ret opt[operand.Value].none{}; }
            ret opt[operand.Value].some{operand.Value.enumerant{e.members[e.count - k].value}};
        }
        if (k >= e.count) { ret opt[operand.Value].none{}; }
        ret opt[operand.Value].some{operand.Value.enumerant{e.members[e.count - 1 - k].value}};
    }
    ret opt[operand.Value].none{};
}

# row `i` encoded into `t.out` with values it admits, found from each operand's first value by taking a refused operand's next
# value until every operand is admitted, 0 on success and the step that failed otherwise
#[testing]
fun t_admitted(t: *T, i: u32, values: *operand.Value) i32 {
    val r:     *row.Row = ?CODEC.rows.at[i];
    var tries: [row.MAX_OPERANDS]u32;
    var k:     u32      = 0;
    for (k < r.operands.len) {
        tries[k] = 0;
        val fixed: opt[register.Id] = effect.fixed(CODEC.registers, r.effect, k::u8);
        if (sel fixed.some) { values[k] = operand.Value.register{fixed.some}; }
        or {
            val first: opt[operand.Value] = t_value(?r.operands.at[k], 0);
            if (sel first.none) { ret 2; }
            values[k] = first.some;
        }
        k = k + 1;
    }
    var wrote: res[usize, field.Refusal] = t_encode(t, i, values, r.operands.len);
    var left:  u32                       = 4096;
    for (sel wrote.err && left > 0) {
        val op: u8 = t_operand_refused(wrote);
        if (op == field.NO_OPERAND || op::u32 >= r.operands.len) { ret 3; }
        tries[op] = tries[op] + 1;
        val next: opt[operand.Value] = t_value(?r.operands.at[op], tries[op]);
        if (sel next.none) { ret 4; }
        values[op] = next.some;
        wrote      = t_encode(t, i, values, r.operands.len);
        left       = left - 1;
    }
    if (sel wrote.err) { ret 5; }
    ret 0;
}

test walk__every_row_encodes_and_decodes_back_to_itself {
    var i: u32 = 0;
    for (i < CODEC.rows.len) {
        val r: *row.Row = ?CODEC.rows.at[i];
        var t: T;
        if (!t_make_for(?t, r)) { ret 1; }
        var values:  [row.MAX_OPERANDS]operand.Value;
        val written: i32 = t_admitted(?t, i, ?values[0]);
        if (written != 0) { ret written; }
        var store: [32]operand.Value;
        var room1: [8]requirement.Ids;
        var alts1: field.Admissions                 = field.Admissions{at: ?room1[0], cap: 8, used: 0};
        val got:   res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.v, t.out.data, t.out.len, 0, ?store[0], 32, ?alts1);
        if (sel got.err)             { ret 6; }
        if (got.ok.inst.row != r)    { ret 7; }
        if (got.ok.len != t.out.len) { ret 8; }
        var k: u32 = 0;
        for (k < r.operands.len) {
            if (!operand.equal(?store[k], ?values[k])) { ret 9; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}

# a hint row is carved out of a parent row's encodings: a selection admitting it decodes its bits as the hint, though the
# parent matches them too, and one without its extension decodes them as the parent or refuses them where the parent excludes them
test walk__each_hint_row_is_selected_over_its_parent {
    var hints: u32 = 0;
    var i:     u32 = 0;
    for (i < CODEC.rows.len) {
        val r: *row.Row = ?CODEC.rows.at[i];
        if ((r.flags & row.HINT) == 0) {
            i = i + 1;
            cnt;
        }
        hints = hints + 1;
        var t: T;
        if (!t_make_for(?t, r)) { ret 1; }
        var values:  [row.MAX_OPERANDS]operand.Value;
        val written: i32 = t_admitted(?t, i, ?values[0]);
        if (written != 0) { ret 10 + written; }
        var store: [32]operand.Value;
        var room1: [8]requirement.Ids;
        var alts1: field.Admissions                 = field.Admissions{at: ?room1[0], cap: 8, used: 0};
        val got:   res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.v, t.out.data, t.out.len, 0, ?store[0], 32, ?alts1);
        if (!(sel got.ok && got.ok.inst.row == r)) { ret 20; }
        var k: u32 = 0;
        for (k < r.operands.len) {
            if (!operand.equal(?store[k], ?values[k])) { ret 21; }
            k = k + 1;
        }
        var base: T;
        if (!t_make(?base, "rv64ic")) { ret 22; }
        var room2:  [8]requirement.Ids;
        var alts2:  field.Admissions                 = field.Admissions{at: ?room2[0], cap: 8, used: 0};
        val parent: res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?base.v, t.out.data, t.out.len, 0, ?store[0], 32, ?alts2);
        if (sel parent.ok && (parent.ok.inst.row == r || parent.ok.len != t.out.len)) { ret 23; }
        i = i + 1;
    }
    if (hints == 0) { ret 24; }
    ret 0;
}

# whether operand `op` of `r` is encoded: a slice of its field takes it, its field's kind takes it whole, or it is fixed
#[testing]
fun t_encoded(r: *row.Row, op: u8) bool {
    var f: u32 = 0;
    for (f < r.encoding.len) {
        val fl: *field.Field = ?r.encoding.at[f];
        if (fl.operand == op)                                                                                           { ret true; }
        if (fl.kind == riscv_field.SREGS_KIND && ((fl.param & 0xFF) == op::u64 || ((fl.param >> 8) & 0xFF) == op::u64)) { ret true; }
        var s: u32 = 0;
        for (s < fl.slices.len) {
            if (fl.slices.at[s].operand == op) { ret true; }
            s = s + 1;
        }
        f = f + 1;
    }
    ret false;
}

# the operand a refusal names, field.NO_OPERAND for none
#[testing]
fun t_operand_refused(got: res[usize, field.Refusal]) u8 {
    if (sel got.err) { ret got.err.operand; }
    ret field.NO_OPERAND;
}

# whether operand `op` of `r` is relative, an enumerant, or an immediate
#[testing]
fun t_relative(r: *row.Row, op: u8) bool {
    if (op::u32 >= r.operands.len) { ret false; }
    val d: *operand.Operand = ?r.operands.at[op];
    ret sel d.shape.relative;
}

#[testing]
fun t_enumerant(r: *row.Row, op: u8) bool {
    if (op::u32 >= r.operands.len) { ret false; }
    val d: *operand.Operand = ?r.operands.at[op];
    ret sel d.shape.enumerant;
}

#[testing]
fun t_immediate_shape(r: *row.Row, op: u8) bool {
    if (op::u32 >= r.operands.len) { ret false; }
    val d: *operand.Operand = ?r.operands.at[op];
    ret sel d.shape.immediate;
}

#[testing]
fun t_reads(r: *row.Row, op: u8) bool {
    ret op::u32 < r.operands.len && (r.operands.at[op].role & operand.READ) != 0;
}

#[testing]
fun t_register(r: *row.Row, op: u8) bool {
    if (op::u32 >= r.operands.len) { ret false; }
    val d: *operand.Operand = ?r.operands.at[op];
    ret sel d.shape.register;
}

test index__every_row_key_and_class_name_looks_up_back_to_its_own_row {
    var i: u32 = 0;
    for (i < CODEC.rows.len) {
        val found: opt[*row.Row] = walk.row_keyed(?CODEC, CODEC.rows.at[i].key);
        if (!(sel found.some && found.some == ?CODEC.rows.at[i])) { ret 1; }
        i = i + 1;
    }
    val a: opt[*row.Row] = walk.row_keyed(?CODEC, "add");
    val z: opt[*row.Row] = walk.row_keyed(?CODEC, "zext.h.rv32");
    val s: opt[*row.Row] = walk.row_keyed(?CODEC, "cm.push.rv64");
    if (!(sel a.some && a.some == gen_row.ADD))          { ret 3; }
    if (!(sel z.some && z.some == gen_row.ZEXT_H_RV32))  { ret 4; }
    if (!(sel s.some && s.some == gen_row.CM_PUSH_RV64)) { ret 5; }
    val file: *register.File = CODEC.registers;
    if (riscv_register.X != ?file.classes[0] || riscv_register.F != ?file.classes[1] || riscv_register.V != ?file.classes[2]) { ret 6; }
    i = 0;
    for (i < file.class_count) {
        val found: opt[u16] = register.class_named(file, file.classes[i].name);
        if (!(sel found.some && found.some::u32 == i)) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

# the register that states csr `number`, none when none does
#[testing]
fun t_csr(number: u16) register.Id {
    val at: opt[register.Id] = riscv_csr.state(CODEC.registers, number::u32);
    if (sel at.none) { ret register.NONE; }
    ret at.some;
}

# whether `t` reads (or writes) the state of csr `number`
#[testing]
fun t_in(t: effect.Touched, number: u16, written: bool) bool {
    if (written) { ret effect.has(CODEC.registers, t.written, t_csr(number)); }
    ret effect.has(CODEC.registers, t.read, t_csr(number));
}

# whether some instruction of row `mnemonic` reads (or writes) the state of csr `number` without an operand naming it
#[testing]
fun t_touches(mnemonic: str, number: u16, written: bool) bool {
    ret t_in(effect.may(CODEC.rows.at[t_row(mnemonic)].effect), number, written);
}

# whether every instruction of row `mnemonic` reads (or writes) the state of csr `number` without an operand naming it
#[testing]
fun t_always(mnemonic: str, number: u16, written: bool) bool {
    ret t_in(effect.must(CODEC.rows.at[t_row(mnemonic)].effect), number, written);
}

# whether row `mnemonic`, its rounding mode `rm` and every other operand its first value, reads the state of csr `number`
# without an operand naming it
#[testing]
fun t_rounds(mnemonic: str, rm: u32, number: u16) bool {
    val r:      *row.Row = ?CODEC.rows.at[t_row(mnemonic)];
    var values: [row.MAX_OPERANDS]operand.Value;
    var k:      u32      = 0;
    for (k < r.operands.len) {
        val v: opt[operand.Value] = t_value(?r.operands.at[k], 0);
        if (sel v.some)            { values[k] = v.some; }
        if (t_enumerant(r, k::u8)) { values[k] = operand.Value.enumerant{rm}; }
        k = k + 1;
    }
    val walked: effect.Touched = effect.implicit(CODEC.registers, r.effect, operand.Values{at: ?values[0], len: r.operands.len});
    ret effect.has(CODEC.registers, walked.read, t_csr(number));
}

#[testing]
fun t_overlaps(a: u16, b: u16) bool {
    val file: *register.File          = CODEC.registers;
    val x:    opt[*register.Register] = register.row_of(file, t_csr(a));
    val y:    opt[*register.Register] = register.row_of(file, t_csr(b));
    if (!sel x.some) { ret false; }
    if (!sel y.some) { ret false; }
    ret register.overlap(file, x.some, y.some);
}

# the csr state rows: the csr operand, the csr table and the implicit effects reach one row each, and the rows overlap where their bits do
#[testing]
fun t_state() i32 {
    val file: *register.File = CODEC.registers;
    var i:    u32            = 0;
    for (i < file.register_count) {
        val r: *register.Register = ?file.registers[i];
        if (r.class == gen_register.CSR_CLASS) {
            if (t_csr(r.number) != register.id_of(r)) { ret 1; }
            val dwarf: opt[u32] = register.debug_number(file, register.id_of(r), register.DWARF);
            if (!(sel dwarf.some && dwarf.some == 4096 + r.number::u32)) { ret 2; }
            var k: u32 = 0;
            for (k < gen_csr.TABLE.len) {
                if (str_equals(gen_csr.TABLE.at[k].name, r.name) && gen_csr.TABLE.at[k].number != r.number::u32) { ret 3; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    if (t_csr(0x0FFF) != register.NONE || t_csr(0x1000) != register.NONE)                                                { ret 4; }
    if (!t_overlaps(riscv_register.FCSR, riscv_register.FFLAGS) || !t_overlaps(riscv_register.FCSR, riscv_register.FRM)) { ret 5; }
    if (t_overlaps(riscv_register.FFLAGS, riscv_register.FRM))                                                           { ret 6; }
    if (!t_overlaps(riscv_register.VCSR, riscv_register.VXRM) || !t_overlaps(riscv_register.VCSR, riscv_register.VXSAT)) { ret 7; }
    if (t_overlaps(riscv_register.VXRM, riscv_register.VXSAT) || t_overlaps(riscv_register.FCSR, riscv_register.VCSR))   { ret 8; }
    if (t_overlaps(riscv_register.VL, riscv_register.VTYPE) || t_overlaps(riscv_register.VL, riscv_register.VSTART))     { ret 9; }
    # floating point rounds by frm only under the dynamic rounding mode and accrues into fflags under any, and the moves
    # and sign injections touch neither
    if (t_rounds("fadd.s", riscv_field.RTZ, riscv_register.FRM) || !t_rounds("fadd.s", riscv_field.DYN, riscv_register.FRM))        { ret 10; }
    if (!t_rounds("fadd.s", riscv_field.RTZ, riscv_register.FFLAGS) || !t_rounds("fadd.s", riscv_field.DYN, riscv_register.FFLAGS)) { ret 22; }
    if (!t_touches("fadd.s", riscv_register.FFLAGS, true))                                                                          { ret 23; }
    # with no values, frm is read by some fadd.s and not by every one, and fflags is written by every one
    if (!t_touches("fadd.s", riscv_register.FRM, false) || t_always("fadd.s", riscv_register.FRM, false) || !t_always("fadd.s", riscv_register.FFLAGS, true)) { ret 24; }
    if (t_touches("fsgnj.s", riscv_register.FFLAGS, true) || t_touches("fmv.x.w", riscv_register.FRM, false))                                                 { ret 11; }
    if (!t_touches("feq.s", riscv_register.FFLAGS, true) || t_touches("feq.s", riscv_register.FRM, false))                                                    { ret 12; }
    # vector instructions depend on vl, vtype and vstart, and the whole register forms on vstart alone
    if (!t_touches("vadd.vv", riscv_register.VL, false) || !t_touches("vadd.vv", riscv_register.VTYPE, false))     { ret 13; }
    if (!t_touches("vadd.vv", riscv_register.VSTART, false) || !t_touches("vadd.vv", riscv_register.VSTART, true)) { ret 14; }
    if (t_touches("vl1re8.v", riscv_register.VL, false) || t_touches("vl1re8.v", riscv_register.VTYPE, false))     { ret 15; }
    if (!t_touches("vsetvli", riscv_register.VL, true) || !t_touches("vsetvli", riscv_register.VTYPE, true))       { ret 16; }
    if (!t_touches("vle8ff.v", riscv_register.VL, true))                                                           { ret 17; }
    if (!t_touches("vfadd.vv", riscv_register.FRM, false) || !t_touches("vfadd.vv", riscv_register.FFLAGS, true))  { ret 18; }
    if (!t_touches("vaadd.vv", riscv_register.VXRM, false) || !t_touches("vsadd.vv", riscv_register.VXSAT, true))  { ret 19; }
    if (t_touches("vadd.vv", riscv_register.VXRM, false) || t_touches("vsadd.vv", riscv_register.VXRM, false))     { ret 20; }
    # a vector instruction reads its destination under the undisturbed policies, and one that writes every element does not
    val add: *row.Row = ?CODEC.rows.at[t_row("vadd.vv")];
    val mv:  *row.Row = ?CODEC.rows.at[t_row("vmv1r.v")];
    if (add.operands.at[0].role != operand.READ_WRITE || mv.operands.at[0].role != operand.WRITE) { ret 21; }
    ret 0;
}

test effect__every_row_states_roles_its_fields_agree_with {
    var i: u32 = 0;
    for (i < CODEC.rows.len) {
        val r: *row.Row       = ?CODEC.rows.at[i];
        val e: *effect.Effect = r.effect;
        # every operand is used, and encoded by its field or fixed and so held in no field
        var k: u32 = 0;
        for (k < r.operands.len) {
            if (r.operands.at[k].role == operand.NONE) { ret 1; }
            val fixed: opt[register.Id] = effect.fixed(CODEC.registers, e, k::u8);
            if (t_encoded(r, k::u8) == sel fixed.some)   { ret 2; }
            if (sel fixed.some && !t_register(r, k::u8)) { ret 3; }
            k = k + 1;
        }
        # an access reads its address register and the operands that form the address
        var a: u32 = 0;
        for (a < e.memory.len) {
            val acc: *effect.Access = ?e.memory.at[a];
            if (acc.operand != field.NO_OPERAND && !(t_register(r, acc.operand) && t_reads(r, acc.operand))) { ret 4; }
            if (acc.operand == field.NO_OPERAND && acc.base == effect.NO_ROW)                                { ret 5; }
            k = 0;
            for (k < r.operands.len) {
                if (((acc.forming >> k) & 1) != 0 && !t_reads(r, k::u8)) { ret 6; }
                k = k + 1;
            }
            if (acc.governor != field.NO_OPERAND && !t_enumerant(r, acc.governor)) { ret 7; }
            a = a + 1;
        }
        # a transfer's target operand is read, a direct one is relative, and an indirect one is a register
        val c: effect.Control = e.control;
        if (c.operand != field.NO_OPERAND) {
            if (!t_reads(r, c.operand))                                  { ret 8; }
            if (c.target == effect.DIRECT && !t_relative(r, c.operand))  { ret 9; }
            if (c.target == effect.INDIRECT && t_relative(r, c.operand)) { ret 10; }
        }
        or (c.transfer == effect.JUMP || c.transfer == effect.CALL) {
            ret 11;
        }
        # a relative operand is a transfer's target
        k = 0;
        for (k < r.operands.len) {
            if (t_relative(r, k::u8) && c.operand != k::u8) { ret 12; }
            k = k + 1;
        }
        val st: effect.Stack = e.stack;
        if (sel st.delta && !t_immediate_shape(r, st.delta.operand)) { ret 13; }
        i = i + 1;
    }
    val state: i32 = t_state();
    if (state != 0) { ret 100 + state; }
    ret 0;
}

# the transfer of row `mnemonic` over the operand values given
#[testing]
fun t_transfer(mnemonic: str, values: *operand.Value, count: u32) effect.Control {
    val r: *row.Row = ?CODEC.rows.at[t_row(mnemonic)];
    ret effect.control(?riscv_register.FILE, r.effect, operand.Values{at: values, len: count});
}

test effect__jal_and_jalr_transfer_by_the_registers_they_name {
    val zero: operand.Value = t_x(0);
    val ra:   operand.Value = t_x(1);
    val t0:   operand.Value = t_x(5);
    val a0:   operand.Value = t_x(10);
    val off:  operand.Value = operand.Value.relative{0};
    val imm:  operand.Value = operand.Value.immediate{0};
    # jal links through rd, and only a link register makes it a call
    var jal: [2]operand.Value = [2]operand.Value{zero, off};
    if (t_transfer("jal", ?jal[0], 2).transfer != effect.JUMP) { ret 1; }
    jal[0] = ra;
    var c: effect.Control = t_transfer("jal", ?jal[0], 2);
    if (c.transfer != effect.CALL || c.target != effect.DIRECT || c.operand != 1) { ret 2; }
    jal[0] = t0;
    if (t_transfer("jal", ?jal[0], 2).transfer != effect.CALL) { ret 3; }
    jal[0] = a0;
    if (t_transfer("jal", ?jal[0], 2).transfer != effect.JUMP) { ret 4; }
    # jalr reads rs1 and links through rd
    var jalr: [3]operand.Value = [3]operand.Value{zero, a0, imm};
    c = t_transfer("jalr", ?jalr[0], 3);
    if (c.transfer != effect.JUMP || c.target != effect.INDIRECT || c.operand != 1) { ret 5; }
    jalr[1] = ra;
    c       = t_transfer("jalr", ?jalr[0], 3);
    if (c.transfer != effect.RETURN || c.target != effect.UNTARGETED || c.operand != field.NO_OPERAND) { ret 6; }
    jalr[1] = t0;
    if (t_transfer("jalr", ?jalr[0], 3).transfer != effect.RETURN) { ret 7; }
    jalr[0] = ra;
    jalr[1] = a0;
    c       = t_transfer("jalr", ?jalr[0], 3);
    if (c.transfer != effect.CALL || c.target != effect.INDIRECT || c.operand != 1) { ret 8; }
    jalr[1] = ra;
    if (t_transfer("jalr", ?jalr[0], 3).transfer != effect.CALL) { ret 9; }
    # a coroutine swap, rd and rs1 both links and different, still links
    jalr[0] = t0;
    if (t_transfer("jalr", ?jalr[0], 3).transfer != effect.CALL) { ret 10; }
    # reading a link into a register that is not one only hints a pop
    jalr[0] = a0;
    if (t_transfer("jalr", ?jalr[0], 3).transfer != effect.JUMP) { ret 11; }
    # c.jr is jalr with rd x0
    var cjr: [1]operand.Value = [1]operand.Value{ra};
    if (t_transfer("c.jr", ?cjr[0], 1).transfer != effect.RETURN) { ret 12; }
    cjr[0] = a0;
    if (t_transfer("c.jr", ?cjr[0], 1).transfer != effect.JUMP) { ret 13; }
    # a row with no rules keeps its fixed kind
    var beq: [3]operand.Value = [3]operand.Value{ra, ra, off};
    c = t_transfer("beq", ?beq[0], 3);
    if (c.transfer != effect.JUMP || !c.conditional || c.operand != 2) { ret 14; }
    ret 0;
}

test encode__an_immediate_out_of_range_is_refused {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val addi:   u32              = t_row("addi");
    var values: [3]operand.Value = [3]operand.Value{t_x(1), t_x(2), operand.Value.immediate{2048}};
    if (!t_refused(t_encode(?t, addi, ?values[0], 3), field.OUT_OF_RANGE, 2)) { ret 2; }
    values[2] = operand.Value.immediate{-2049};
    if (!t_refused(t_encode(?t, addi, ?values[0], 3), field.OUT_OF_RANGE, 2)) { ret 3; }
    if (t.out.len != 0)                                                       { ret 4; }
    ret 0;
}

test encode__a_misaligned_scaled_immediate_is_refused {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val values: [3]operand.Value = [3]operand.Value{t_x(1), t_x(2), operand.Value.relative{3}};
    if (!t_refused(t_encode(?t, t_row("beq"), ?values[0], 3), field.MISALIGNED, 2)) { ret 2; }
    ret 0;
}

test encode__a_register_of_the_wrong_class_is_refused {
    var t: T;
    if (!t_make(?t, "rv64if")) { ret 1; }
    val values: [3]operand.Value = [3]operand.Value{operand.Value.register{register.make(1, 1)}, t_x(2), operand.Value.immediate{0}};
    if (!t_refused(t_encode(?t, t_row("addi"), ?values[0], 3), field.WRONG_CLASS, 0)) { ret 2; }
    ret 0;
}

test walk__a_register_range_refuses_outside_it_and_round_trips_inside_it {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    val cand:   u32              = t_row("c.and");
    var values: [2]operand.Value = [2]operand.Value{t_x(7), t_x(9)};
    if (!t_refused(t_encode(?t, cand, ?values[0], 2), field.OUTSIDE_RANGE, 0)) { ret 2; }
    values[0] = t_x(16);
    if (!t_refused(t_encode(?t, cand, ?values[0], 2), field.OUTSIDE_RANGE, 0)) { ret 3; }
    values[0] = t_x(9);
    val wrote: res[usize, field.Refusal] = t_encode(?t, cand, ?values[0], 2);
    val want:  [2]u8                     = [2]u8{0xE5, 0x8C};
    if (!(sel wrote.ok && t_wrote(?t, ?want[0], 2))) { ret 4; }
    var store: [2]operand.Value;
    val got:   res[walk.Decoded, field.Refusal] = walk.decode_row(?CODEC, ?t.v, ?CODEC.rows.at[cand], t.out.data, t.out.len, 0, ?store[0], 2);
    if (sel got.err)                                                          { ret 5; }
    if (!(sel store[0].register && store[0].register == register.make(0, 9))) { ret 6; }
    ret 0;
}

test walk__signed_boundary_values_encode_and_decode {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val addi:   u32    = t_row("addi");
    val bounds: [2]i64 = [2]i64{-2048, 2047};
    val want:   [8]u8  = [8]u8{0x93, 0x00, 0x01, 0x80, 0x93, 0x00, 0xF1, 0x7F};
    var i:      u32    = 0;
    for (i < 2) {
        val values: [3]operand.Value          = [3]operand.Value{t_x(1), t_x(2), operand.Value.immediate{bounds[i]}};
        val wrote:  res[usize, field.Refusal] = t_encode(?t, addi, ?values[0], 3);
        if (!(sel wrote.ok && wrote.ok == 4)) { ret 2; }
        i = i + 1;
    }
    if (!t_wrote(?t, ?want[0], 8)) { ret 3; }
    var store: [3]operand.Value;
    i = 0;
    for (i < 2) {
        val got: res[walk.Decoded, field.Refusal] = walk.decode_row(?CODEC, ?t.v, ?CODEC.rows.at[addi], t.out.data, t.out.len, i::usize * 4, ?store[0], 3);
        if (sel got.err)                                                  { ret 4; }
        if (!(sel store[2].immediate && store[2].immediate == bounds[i])) { ret 5; }
        i = i + 1;
    }
    ret 0;
}

#[testing]
fun t_v(n: u16) operand.Value {
    ret operand.Value.register{register.make(gen_register.V_CLASS, n)};
}

test walk__register_constraints_refuse_the_forms_they_reserve {
    var t: T;
    if (!t_make(?t, "rv64iv")) { ret 1; }
    val unmasked: operand.Value = operand.Value.enumerant{riscv_field.UNMASKED};
    # vrgather's destination overlaps no source, in encode and in decode
    val gather: [4]operand.Value = [4]operand.Value{t_v(2), t_v(2), t_v(4), unmasked};
    if (!t_refused(t_encode(?t, t_row("vrgather.vv"), ?gather[0], 4), field.SHARED, 0)) { ret 2; }
    if (t.out.len != 0 || t.fixups.len != 0)                                            { ret 3; }
    val bytes: [4]u8                            = [4]u8{0x57, 0x01, 0x22, 0x32};
    var store: [4]operand.Value;
    val got:   res[walk.Decoded, field.Refusal] = walk.decode_row(?CODEC, ?t.v, ?CODEC.rows.at[t_row("vrgather.vv")], ?bytes[0], 4, 0, ?store[0], 4);
    if (!(sel got.err && got.err.message == field.SHARED)) { ret 4; }
    # a widening destination may overlap a single-width source in its highest register, never its lowest
    val high: [4]operand.Value          = [4]operand.Value{t_v(2), t_v(3), t_v(4), unmasked};
    val wide: res[usize, field.Refusal] = t_encode(?t, t_row("vwadd.vv"), ?high[0], 4);
    if (sel wide.err) { ret 5; }
    val low: [4]operand.Value = [4]operand.Value{t_v(2), t_v(2), t_v(4), unmasked};
    if (!t_refused(t_encode(?t, t_row("vwadd.vv"), ?low[0], 4), field.SHARED, 0)) { ret 6; }
    # an extension's destination overlaps no source under the unit grouping
    val same: [3]operand.Value = [3]operand.Value{t_v(2), t_v(2), unmasked};
    if (!t_refused(t_encode(?t, t_row("vzext.vf2"), ?same[0], 3), field.SHARED, 0)) { ret 7; }
    val apart:  [3]operand.Value          = [3]operand.Value{t_v(2), t_v(3), unmasked};
    val extend: res[usize, field.Refusal] = t_encode(?t, t_row("vzext.vf2"), ?apart[0], 3);
    if (sel extend.err) { ret 8; }
    # a masked instruction reads no source from the mask register v0
    val masked: [4]operand.Value = [4]operand.Value{t_v(1), t_v(0), t_v(2), operand.Value.enumerant{riscv_field.MASKED}};
    if (!t_refused(t_encode(?t, t_row("vadd.vv"), ?masked[0], 4), field.SHARED, 1)) { ret 9; }
    ret 0;
}

# what constraint.violated finds of row `r` holding the `count` values `values` under `g`
#[testing]
fun t_verdict(r: u32, values: *operand.Value, count: u32, g: constraint.Grouping) constraint.Verdict {
    val at: *row.Row = ?CODEC.rows.at[r];
    ret constraint.violated(CODEC.registers, at.constraints, at.operands.at, at.effect, operand.Values{at: values, len: count}, g);
}

# whether `v` answers clear
#[testing]
fun t_clear(v: constraint.Verdict) bool {
    ret sel v.clear;
}

# the grouping of row `r` under the vector type of element width `sew` and multiplier `lmul`, UNIT when it reserves one
#[testing]
fun t_grouping(r: u32, sew: u16, lmul: i8) constraint.Grouping {
    val got: constraint.Grouped = riscv_vtype.grouping(?CODEC.rows.at[r], riscv_vtype.Vtype{sew: sew, lmul: lmul, ta: true, ma: true});
    if (sel got.grouping) { ret got.grouping; }
    ret constraint.UNIT;
}

test violated__a_rule_the_state_decides_answers_inexact_and_a_group_past_the_file_outside {
    var t: T;
    if (!t_make(?t, "rv64iv")) { ret 1; }
    val unmasked: operand.Value = operand.Value.enumerant{riscv_field.UNMASKED};
    # vrgatherei16 reading one register at 16 and at SEW is reserved but at e16, which UNIT does not state
    val gather: u32                = t_row("vrgatherei16.vv");
    val shared: [4]operand.Value   = [4]operand.Value{t_v(2), t_v(4), t_v(4), unmasked};
    val unit:   constraint.Verdict = t_verdict(gather, ?shared[0], 4, constraint.UNIT);
    if (!(sel unit.inexact && unit.inexact.permit == constraint.SAME_WIDTH))   { ret 2; }
    if (!t_clear(t_verdict(gather, ?shared[0], 4, t_grouping(gather, 16, 0)))) { ret 3; }
    val wider: constraint.Verdict = t_verdict(gather, ?shared[0], 4, t_grouping(gather, 32, 0));
    if (!sel wider.broken) { ret 4; }
    # the walks admit it, as e16 allows it
    val wrote: res[usize, field.Refusal] = t_encode(?t, gather, ?shared[0], 4);
    if (sel wrote.err) { ret 5; }
    # four fields of one register from v30 run past v31 under a stated grouping, and the walks state none
    val segment: u32                = t_row("vlseg4e8.v");
    val high:    [3]operand.Value   = [3]operand.Value{t_v(30), t_x(10), unmasked};
    val past:    constraint.Verdict = t_verdict(segment, ?high[0], 3, t_grouping(segment, 8, 0));
    if (!(sel past.outside && past.outside == 0))                   { ret 6; }
    if (!t_clear(t_verdict(segment, ?high[0], 3, constraint.UNIT))) { ret 7; }
    val low: [3]operand.Value = [3]operand.Value{t_v(28), t_x(10), unmasked};
    if (!t_clear(t_verdict(segment, ?low[0], 3, t_grouping(segment, 8, 0)))) { ret 8; }
    ret 0;
}

test grouping__a_vector_type_sizes_each_operand_by_its_element_width {
    var t: T;
    if (!t_make(?t, "rv64iv")) { ret 1; }
    val unmasked: operand.Value = operand.Value.enumerant{riscv_field.UNMASKED};
    # vwadd.vv at e32 m2: vd of 2*SEW covers four registers, each source two
    val wadd: u32                 = t_row("vwadd.vv");
    val wide: constraint.Grouping = t_grouping(wadd, 32, 1);
    if (wide.len != 4 || wide.lengths[0] != 2 || wide.lengths[1] != 1 || wide.lengths[2] != 1) { ret 2; }
    # and at m8 vd would cover sixteen, which the type reserves
    val past: constraint.Grouped = riscv_vtype.grouping(?CODEC.rows.at[wadd], riscv_vtype.Vtype{sew: 32, lmul: 3, ta: true, ma: true});
    if (!(sel past.reserved && past.reserved == 0)) { ret 3; }
    # vzext.vf4 at e32 m4: vs2 of SEW/4 covers one register, which may end vd's four but not start them
    val zext: u32                 = t_row("vzext.vf4");
    val four: constraint.Grouping = t_grouping(zext, 32, 2);
    if (four.lengths[0] != 2 || four.lengths[1] != 0) { ret 4; }
    val top: [3]operand.Value = [3]operand.Value{t_v(4), t_v(7), unmasked};
    if (!t_clear(t_verdict(zext, ?top[0], 3, four))) { ret 5; }
    val bottom: [3]operand.Value   = [3]operand.Value{t_v(4), t_v(4), unmasked};
    val low:    constraint.Verdict = t_verdict(zext, ?bottom[0], 3, four);
    if (!sel low.broken) { ret 6; }
    # at e32 m1 its source is a quarter of one register, which overlaps vd nowhere legally
    val one: constraint.Grouping = t_grouping(zext, 32, 0);
    if (one.lengths[1] != -2) { ret 7; }
    val inside: [3]operand.Value   = [3]operand.Value{t_v(4), t_v(4), unmasked};
    val part:   constraint.Verdict = t_verdict(zext, ?inside[0], 3, one);
    if (!sel part.broken) { ret 8; }
    # at e16 its source would be of 4 bits, a width no setting supports
    val narrow: constraint.Grouped = riscv_vtype.grouping(?CODEC.rows.at[zext], riscv_vtype.Vtype{sew: 16, lmul: 0, ta: true, ma: true});
    if (!(sel narrow.reserved && narrow.reserved == 1)) { ret 9; }
    ret 0;
}

test walk__a_split_immediate_reassembles {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val beq:     u32    = t_row("beq");
    val offsets: [2]i64 = [2]i64{2730, -4096};
    val want:    [8]u8  = [8]u8{0xE3, 0x85, 0x20, 0x2A, 0x63, 0x80, 0x20, 0x80};
    var i:       u32    = 0;
    for (i < 2) {
        val values: [3]operand.Value          = [3]operand.Value{t_x(1), t_x(2), operand.Value.relative{offsets[i]}};
        val wrote:  res[usize, field.Refusal] = t_encode(?t, beq, ?values[0], 3);
        if (sel wrote.err) { ret 2; }
        i = i + 1;
    }
    if (!t_wrote(?t, ?want[0], 8)) { ret 3; }
    var store: [3]operand.Value;
    i = 0;
    for (i < 2) {
        val got: res[walk.Decoded, field.Refusal] = walk.decode_row(?CODEC, ?t.v, ?CODEC.rows.at[beq], t.out.data, t.out.len, i::usize * 4, ?store[0], 3);
        if (sel got.err)                                                 { ret 4; }
        if (!(sel store[2].relative && store[2].relative == offsets[i])) { ret 5; }
        i = i + 1;
    }
    ret 0;
}

test decode_row__fixed_bits_that_do_not_match_refuse {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val beq:   [4]u8                            = [4]u8{0xE3, 0x85, 0x20, 0x2A};
    var store: [3]operand.Value;
    val got:   res[walk.Decoded, field.Refusal] = walk.decode_row(?CODEC, ?t.v, ?CODEC.rows.at[t_row("addi")], ?beq[0], 4, 0, ?store[0], 3);
    if (!(sel got.err && got.err.message == field.MISMATCH)) { ret 2; }
    ret 0;
}

test decode__a_truncated_stream_is_refused {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val addi:  [3]u8                            = [3]u8{0x93, 0x00, 0x01};
    var store: [3]operand.Value;
    var room2: [8]requirement.Ids;
    var alts2: field.Admissions                 = field.Admissions{at: ?room2[0], cap: 8, used: 0};
    val got:   res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.v, ?addi[0], 3, 0, ?store[0], 3, ?alts2);
    if (!(sel got.err && got.err.message == field.TRUNCATED)) { ret 2; }
    val one: res[walk.Decoded, field.Refusal] = walk.decode_row(?CODEC, ?t.v, ?CODEC.rows.at[t_row("addi")], ?addi[0], 3, 0, ?store[0], 3);
    if (!(sel one.err && one.err.message == field.TRUNCATED)) { ret 3; }
    ret 0;
}

test decode__dispatch_selects_the_row_whose_fixed_bits_match {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    # c.li a0, -1, then addi x1, x2, 2047, then beq x1, x2, 2730
    val stream: [10]u8 = [10]u8{0x7D, 0x55, 0x93, 0x00, 0xF1, 0x7F, 0xE3, 0x85, 0x20, 0x2A};
    val rows:   [3]u32 = [3]u32{t_row("c.li"), t_row("addi"), t_row("beq")};
    var store:  [3]operand.Value;
    var at:     usize  = 0;
    var i:      u32    = 0;
    for (i < 3) {
        var room3: [8]requirement.Ids;
        var alts3: field.Admissions                 = field.Admissions{at: ?room3[0], cap: 8, used: 0};
        val got:   res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.v, ?stream[0], 10, at, ?store[0], 3, ?alts3);
        if (sel got.err)                                { ret 2; }
        if (got.ok.inst.row != ?CODEC.rows.at[rows[i]]) { ret 3; }
        at = at + got.ok.len;
        i  = i + 1;
    }
    if (at != 10)                                                             { ret 4; }
    if (!(sel store[0].register && store[0].register == register.make(0, 1))) { ret 5; }
    ret 0;
}

test encode__a_fixed_operand_refuses_any_other_register {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    val spadd:  u32              = t_row("c.addi16sp");
    var values: [2]operand.Value = [2]operand.Value{t_x(3), operand.Value.immediate{32}};
    if (!t_refused(t_encode(?t, spadd, ?values[0], 2), field.NOT_FIXED, 0)) { ret 2; }
    values[0] = t_x(2);
    val wrote: res[usize, field.Refusal] = t_encode(?t, spadd, ?values[0], 2);
    if (!(sel wrote.ok && wrote.ok == 2)) { ret 3; }
    var store: [2]operand.Value;
    val got:   res[walk.Decoded, field.Refusal] = walk.decode_row(?CODEC, ?t.v, ?CODEC.rows.at[spadd], t.out.data, t.out.len, 0, ?store[0], 2);
    if (sel got.err)                                                          { ret 4; }
    if (!(sel store[0].register && store[0].register == register.make(0, 2))) { ret 5; }
    ret 0;
}

test walk__a_register_is_excluded_by_a_selection_lacking_its_condition_and_admitted_by_one_meeting_it {
    var with_i: T;
    var with_e: T;
    if (!t_make(?with_i, "rv64i") || !t_make(?with_e, "rv64e")) { ret 1; }
    val addi:   u32                       = t_row("addi");
    val values: [3]operand.Value          = [3]operand.Value{t_x(16), t_x(1), operand.Value.immediate{0}};
    val wrote:  res[usize, field.Refusal] = t_encode(?with_i, addi, ?values[0], 3);
    if (!(sel wrote.ok && wrote.ok == 4))                                         { ret 2; }
    if (!t_refused(t_encode(?with_e, addi, ?values[0], 3), field.UNAVAILABLE, 0)) { ret 3; }
    var store: [3]operand.Value;
    val got:   res[walk.Decoded, field.Refusal] = walk.decode_row(?CODEC, ?with_e.v, ?CODEC.rows.at[addi], with_i.out.data, with_i.out.len, 0, ?store[0], 3);
    if (!(sel got.err && (got.err.message == field.UNAVAILABLE && got.err.operand == 0))) { ret 4; }
    ret 0;
}

test walk__an_excluded_value_is_refused_and_decode_tries_the_next_candidate {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    val lui:    u32              = t_row("c.lui");
    var values: [2]operand.Value = [2]operand.Value{t_x(0), operand.Value.immediate{1}};
    if (!t_refused(t_encode(?t, lui, ?values[0], 2), field.EXCLUDED, 0)) { ret 2; }
    values[0] = t_x(2);
    if (!t_refused(t_encode(?t, lui, ?values[0], 2), field.EXCLUDED, 0)) { ret 3; }
    values[0] = t_x(8);
    values[1] = operand.Value.immediate{0};
    if (!t_refused(t_encode(?t, lui, ?values[0], 2), field.EXCLUDED, 1)) { ret 4; }
    if (t.out.len != 0)                                                  { ret 5; }
    # c.lui's rd of x2 is c.addi16sp, and its rd of x8 is itself
    val spadd: [2]u8                            = [2]u8{0x05, 0x61};
    val own:   [2]u8                            = [2]u8{0x05, 0x64};
    val zero:  [2]u8                            = [2]u8{0x01, 0x64};
    var store: [2]operand.Value;
    var room4: [8]requirement.Ids;
    var alts4: field.Admissions                 = field.Admissions{at: ?room4[0], cap: 8, used: 0};
    val got:   res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.v, ?spadd[0], 2, 0, ?store[0], 2, ?alts4);
    if (!(sel got.ok && got.ok.inst.row == ?CODEC.rows.at[t_row("c.addi16sp")])) { ret 6; }
    if (!(sel store[1].immediate && store[1].immediate == 32))                   { ret 7; }
    var room5:   [8]requirement.Ids;
    var alts5:   field.Admissions                 = field.Admissions{at: ?room5[0], cap: 8, used: 0};
    val got_own: res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.v, ?own[0], 2, 0, ?store[0], 2, ?alts5);
    if (!(sel got_own.ok && got_own.ok.inst.row == ?CODEC.rows.at[lui])) { ret 8; }
    # c.lui x8, 0 is excluded and no other candidate holds it
    var room6: [8]requirement.Ids;
    var alts6: field.Admissions                 = field.Admissions{at: ?room6[0], cap: 8, used: 0};
    val none:  res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.v, ?zero[0], 2, 0, ?store[0], 2, ?alts6);
    if (!sel none.err) { ret 9; }
    val row: res[walk.Decoded, field.Refusal] = walk.decode_row(?CODEC, ?t.v, ?CODEC.rows.at[lui], ?zero[0], 2, 0, ?store[0], 2);
    if (!(sel row.err && (row.err.message == field.EXCLUDED && row.err.operand == 1))) { ret 10; }
    ret 0;
}

# the length of the encoding of `ins`, the buffers left empty
#[testing]
fun t_length(t: *T, ins: *inst.Inst) usize {
    val done: res[usize, field.Refusal] = walk.encode(?CODEC, ?t.v, ins, ?t.out, ?t.fixups);
    t.out.len    = 0;
    t.fixups.len = 0;
    if (sel done.err) { ret 0; }
    ret done.ok;
}

test relax__an_out_of_range_branch_becomes_the_inverted_branch_over_a_jal {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val beq: *row.Row               = ?CODEC.rows.at[t_row("beq")];
    val rx:  opt[*relax.Relaxation] = relax.find(gen_relax.RELAXATIONS, beq);
    if (!sel rx.some) { ret 2; }
    var values: [3]operand.Value = [3]operand.Value{t_x(10), t_x(11), operand.Value.relative{0}};
    var ins:    inst.Inst        = inst.Inst{row: beq, values: ?values[0], count: 3};
    val len:    usize            = t_length(?t, ?ins);
    if (len != 4) { ret 16; }
    # the range of a branch is plus or minus four kilobytes
    if (relax.far(?CODEC, rx.some, 4094, len))   { ret 3; }
    if (!relax.far(?CODEC, rx.some, 4096, len))  { ret 4; }
    if (relax.far(?CODEC, rx.some, -4096, len))  { ret 5; }
    if (!relax.far(?CODEC, rx.some, -4098, len)) { ret 6; }
    var out: relax.Expansion;
    if (!relax.expand(?CODEC, ?t.v, rx.some, ?ins, 5000, ?out, ?t.out, ?t.fixups)) { ret 7; }
    if (out.count != 2)                                                            { ret 8; }
    # bne a0, a1 over the jal, whose target is measured from the jal
    if (!str_equals(out.steps[0].row.mnemonic, "bne") || !str_equals(out.steps[1].row.mnemonic, "jal")) { ret 9; }
    val first: operand.Value = out.steps[0].values[2];
    if (!(sel first.relative && first.relative == 8))                                                               { ret 10; }
    if (!operand.equal(?out.steps[0].values[0], ?values[0]) || !operand.equal(?out.steps[0].values[1], ?values[1])) { ret 11; }
    val link: operand.Value = out.steps[1].values[0];
    val far:  operand.Value = out.steps[1].values[1];
    if (!(sel link.register && link.register == register.make(0, 0))) { ret 12; }
    if (!(sel far.relative && far.relative == 4996))                  { ret 13; }
    # the expansion leaves the buffers it measured in as it found them, and both steps encode
    if (t.out.len != 0 || t.fixups.len != 0) { ret 17; }
    var total: usize = 0;
    var i:     u32   = 0;
    for (i < out.count) {
        var step: inst.Inst                 = inst.Inst{row: out.steps[i].row, values: ?out.steps[i].values[0], count: out.steps[i].row.operands.len};
        val done: res[usize, field.Refusal] = walk.encode(?CODEC, ?t.v, ?step, ?t.out, ?t.fixups);
        if (sel done.err) { ret 14; }
        total = total + done.ok;
        i     = i + 1;
    }
    if (total != 8) { ret 15; }
    ret 0;
}

test relax__a_compressed_branch_becomes_the_full_branch_against_zero {
    var t: T;
    if (!t_make(?t, "rv64ic")) { ret 1; }
    val beqz: *row.Row               = ?CODEC.rows.at[t_row("c.beqz")];
    val rx:   opt[*relax.Relaxation] = relax.find(gen_relax.RELAXATIONS, beqz);
    if (!sel rx.some) { ret 2; }
    var values: [2]operand.Value = [2]operand.Value{t_x(8), operand.Value.relative{0}};
    var ins:    inst.Inst        = inst.Inst{row: beqz, values: ?values[0], count: 2};
    val len:    usize            = t_length(?t, ?ins);
    if (len != 2)                              { ret 10; }
    if (relax.far(?CODEC, rx.some, 254, len))  { ret 3; }
    if (!relax.far(?CODEC, rx.some, 300, len)) { ret 4; }
    var out: relax.Expansion;
    if (!relax.expand(?CODEC, ?t.v, rx.some, ?ins, 300, ?out, ?t.out, ?t.fixups)) { ret 5; }
    if (out.count != 1 || !str_equals(out.steps[0].row.mnemonic, "beq"))          { ret 6; }
    val zero: operand.Value = out.steps[0].values[1];
    val to:   operand.Value = out.steps[0].values[2];
    if (!(sel zero.register && zero.register == register.make(0, 0))) { ret 7; }
    if (!(sel to.relative && to.relative == 300))                     { ret 8; }
    # a row with no relaxation has none to find
    val none: opt[*relax.Relaxation] = relax.find(gen_relax.RELAXATIONS, ?CODEC.rows.at[t_row("add")]);
    if (!sel none.none) { ret 9; }
    ret 0;
}
