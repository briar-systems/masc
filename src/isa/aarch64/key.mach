    dispatch.Key{name: gen_key.NAMES[38], extract: key38},
};

test keys__one_runtime_key_reads_each_position_under_its_name {
    if ($length_of(KEYS) != $length_of(gen_key.POSITIONS) || $length_of(KEYS) != $length_of(gen_key.NAMES)) { ret 1; }
    if (KEYS[0].name[0] != '2' || POSITIONS[0].lo != 25 || POSITIONS[0].len != 4)                           { ret 2; }
    if (POSITIONS[7].lo != 31 || POSITIONS[7].len != 1 || POSITIONS[38].lo != 0)                            { ret 3; }
    ret 0;
}
