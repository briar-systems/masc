# the aarch64 decode dispatch keys
#
# a key is a range of an instruction's bits, read without consuming them. the
# generator reads the keys from the keys topic of its aarch64 overlay
# (gen/data/aarch64/keys.txt): the fields the manual's decode tables branch on
# first, then every single bit, so the dispatch can split any two encodings the
# fields leave together. it builds the dispatch over them and writes their
# positions and names as gen_key, which this module forwards. every a64
# instruction is one 32-bit unit, so every key reads four bytes. no key reads
# the context: a64's encodings mean one thing under every state, and a row the
# context does not hold is refused by its requirement

use std.types.result.res;
use std.types.size.usize;

use masc.core.dispatch;
use masc.core.field;
use masc.core.state;

fwd masc.isa.aarch64.bits.Position;
fwd masc.isa.aarch64.gen_key.POSITIONS;

use masc.isa.aarch64.gen_key;

# the value of key `k` of the instruction at `at`
fun read(k: u32, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val p:    Position                = POSITIONS[k];
    val unit: res[u64, field.Refusal] = field.read(s, at, 4);
    if (sel unit.err) { ret unit; }
    ret res[u64, field.Refusal].ok{(unit.ok >> p.lo::u64) & field.ones(p.len)};
}

fun key0(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(0, s, at);
}

fun key1(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    ret read(1, s, at);
}

