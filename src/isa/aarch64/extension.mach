# the aarch64 extension catalog and its +ext/-ext selection syntax
#
# a row is an architecture version or a FEAT_* feature of the Arm Architecture Reference Manual for
# A-profile, each named as the manual's feature model names it. the versions v8Ap0 to v9Ap7 are rows so
# that a constraint the manual conditions on a version, as "an Armv8.1 implementation with FEAT_AdvSIMD
# has FEAT_RDM", is a combination like any other. a level armv8-a to armv9.7-a selects its version,
# which closes to every feature the version makes mandatory: its plain implications are the features it
# makes mandatory outright, and its combinations the ones it makes mandatory with others held.
#
# sources, read at the revisions named:
#   Arm Architecture Reference Manual for A-profile, machine-readable feature model, AARCHMRS release
#     AARCHMRS_OPENSOURCE_A_profile_FAT-2026-03 (git.kernel.org/pub/scm/linux/kernel/git/maz/AARCHMRS.git
#     47b5446cf08ef6a46c86147c7deb0d56caf99d93), Features.json: every row, implication, combination and
#     conflict, and each feature's revision
#   llvm-project 7ddb67460b168b17ebb263dc99bf956b56d7e517, llvm/lib/Target/AArch64/AArch64Features.td: the
#     names -mattr and -march give the features and versions, and nothing else
#   llvm-mc 23.1.1: -mattr and .arch read back as the syntax below reads them
#
# from Features.json, read as the manual's constraints:
#   `A ==> B && C` is A implying B and C, and `A && B ==> C` a combination carried by A, or by the version
#   when a version is a condition, so removing C drops the version and keeps the features it brought
#   `A && !B ==> !C` is the combination `A && C ==> B`, and `A ==> !B` a conflict
#   `FEAT_X ==> vNApM`, the version a feature is permitted from, is its revision and no implication, so a
#   feature selects at any level as llvm-mc admits +sve at armv8-a
#   `FEAT_AA64EL1 ==> (FEAT_X <=> UInt(REG.F) >= k)` ties features to an ID register field, and the higher
#   of two values of one field implies the lower: FEAT_FP16 implies FEAT_FP and FEAT_AdvSIMD,
#   and the twelve such implications nothing else states are in the rows below
#   `FEAT_MPAMv2_MSC_MON_SEC <=> FEAT_MPAMv2_MSC && FEAT_RME` is its implication and its combination
#   a disjunction, as `FEAT_LUT ==> FEAT_AdvSIMD || FEAT_SVE2 || FEAT_SME2`, requires one of several and
#   implies none, so only the literals every alternative shares are kept. the other identification
#   constraints, over ID register fields, are no selection's
#   the features the manual permits only from the future architecture version vFATAp0 (FEAT_MOPS_GO,
#   FEAT_MTEFGT, FEAT_S1POE2, FEAT_TEV, FEAT_TPS, FEAT_TPSP, FEAT_VMTE, FEAT_VMTEE, FEAT_VMTETC,
#   FEAT_VMTETCE, FEAT_VMTETCL) and the version itself are absent, with the constraints that name them
#
# the levels close to what the manual makes mandatory, which is less than llvm's -march: no version makes
# FEAT_FP or FEAT_AdvSIMD mandatory, nor FEAT_SVE or FEAT_SVE2 at armv9-a, so `armv8-a` admits no
# floating-point instruction and `armv8-a+fp+simd` the ones llvm-mc's default target does
#
# the ids SVE, SME, FP and SIMD come first, as the register file names them, then the versions in order,
# then every other feature by name

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.view;

use alloc: std.allocator;
use std.allocator.testing;
use std.collections.bitset;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.index;
use masc.core.requirement;

# a name llvm gives extensions, as -mattr and -march spell it
# ---
# name:  the name, in lower case
# ids:   the extensions it names, as `sha2` names FEAT_SHA1 and FEAT_SHA256
# march: whether -march and .arch take it, which take a feature's user-visible name, as -mattr takes its
#        target feature name: `simd` and `neon`
pub rec Spelling {
    name:  str;
    ids:   requirement.Ids;
    march: bool;
}

pub val SVE:                 requirement.Id = 0;
pub val SME:                 requirement.Id = SVE + 1;
pub val FP:                  requirement.Id = SME + 1;
