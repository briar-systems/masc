val SPELLING_INDEX: index.Index = index.Index{at: ?SPELLING_NAMES[0], len: SPELLING_COUNT};

# where the token from `at` ends: the next `+` or `,`, or the spelling's end
fun token_end(s: str, len: usize, at: usize) usize {
    var end: usize = at;
    for (end < len && s[end] != '+' && s[end] != ',') { end = end + 1; }
    ret end;
}

# extension `id` added to the request, or removed with what needs it
fun apply(r: *extension.Request, id: requirement.Id, adding: bool) {
    if (adding) { extension.request_add(r, id); }
    or          { extension.request_remove(r, id); }
}

# the extensions r.spelling[at..at + len] names added to the request, or removed: an llvm name, ignoring
# case, or an extension's own name
# ---
# ret: whether the token names any
fun change(r: *extension.Request, at: usize, len: usize, adding: bool) bool {
    val spelt: opt[u32] = index.find_view(?SPELLING_INDEX, view(?r.spelling[at], len), true);
    if (sel spelt.some) {
        val ids: requirement.Ids = SPELLINGS[spelt.some].ids;
        var i:   u32             = 0;
        for (i < ids.len) {
            apply(r, ids.at[i], adding);
            i = i + 1;
        }
        ret true;
    }
    val own: opt[requirement.Id] = extension.lookup(r.catalog, r.spelling, at, len);
    if (sel own.none) { ret false; }
    apply(r, own.some, adding);
    ret true;
}

# a level, then modifiers in order, each `+name` or `-name` and `+noname` to remove, after an optional comma:
# `armv9.2-a+sve2+nolse` as -march and .arch spell it, `+v9.2a,-lse` as -mattr does
fun parse(r: *extension.Request) err[extension.Error] {
    val s:   str   = r.spelling;
    val len: usize = str_len(s);
    if (len == 0) { ret err[extension.Error].err{extension.refusal(r, "empty architecture", 0, 0)}; }
    var at: usize = 0;
    if (s[0] != '+' && s[0] != '-') {
        val end:   usize    = token_end(s, len, 0);
        val found: opt[u32] = index.find_view(?r.catalog.names, view(?s[0], end), false);
        if (!(sel found.some && found.some >= r.catalog.count)) { ret err[extension.Error].err{extension.refusal(r, "unknown architecture", 0, end)}; }
        val level: err[extension.Error] = extension.request_name(r, 0, end);
        if (sel level.err) { ret level; }
        at = end;
    }
    for (at < len) {
        if (s[at] == ',') { at = at + 1; }
        if (at >= len)    { ret err[extension.Error].err{extension.refusal(r, "empty extension name", at, 0)}; }
        val sign: u8 = s[at];
        if (sign != '+' && sign != '-') { ret err[extension.Error].err{extension.refusal(r, "expected + or - before an extension", at, 1)}; }
        val start: usize = at + 1;
        val end:   usize = token_end(s, len, start);
        if (end == start) { ret err[extension.Error].err{extension.refusal(r, "empty extension name", start, 0)}; }
        if (!change(r, start, end - start, sign == '+')) {
            val negated: bool = sign == '+' && end - start > 2 && s[start] == 'n' && s[start + 1] == 'o';
            if (!negated || !change(r, start + 2, end - start - 2, false)) { ret err[extension.Error].err{extension.refusal(r, "unknown extension", start, end - start)}; }
        }
        at = end;
    }
    ret err[extension.Error].ok{};
}

# the name extension `id` spells with: its first -march name that names it alone, else its own
fun printed(catalog: *extension.Catalog, id: requirement.Id) str {
    var i: u32 = 0;
    for (i < SPELLING_COUNT) {
        val sp: *Spelling = ?SPELLINGS[i];
        if (sp.march && sp.ids.len == 1 && sp.ids.at[0] == id) { ret sp.name; }
        i = i + 1;
    }
    ret catalog.extensions[id].name;
}

# the level of the latest version held, then `+name` for every member that level's closure does not hold,
# which reads back to the same selection
fun spell(s: *extension.Selection, out: *vector.Vector[u8]) err[alloc.Error] {
    val made: res[bitset.Bitset, alloc.Error] = bitset.init(s.members.alloc, s.catalog.count::usize);
    if (sel made.err) { ret err[alloc.Error].err{made.err}; }
    var base: bitset.Bitset = made.ok;
    var v:    u32           = 0;
    var top:  u32           = s.catalog.level_count;
    for (v < s.catalog.level_count) {
        if (extension.has(s, s.catalog.levels[v].members.at[0])) { top = v; }
        v = v + 1;
    }
    var wrote: err[alloc.Error] = err[alloc.Error].ok{};
    if (top < s.catalog.level_count) {
        bitset.set(?base, s.catalog.levels[top].members.at[0]::usize);
        extension.grow(s.catalog, ?base);
        wrote = extension.append(out, s.catalog.levels[top].name);
    }
    var i: u32 = 0;
    for (!(sel wrote.err) && i < s.catalog.count) {
        if (extension.has(s, i) && !bitset.get(?base, i::usize)) {
            wrote = extension.append(out, "+");
            if (!(sel wrote.err)) { wrote = extension.append(out, printed(s.catalog, i)); }
        }
        i = i + 1;
    }
    bitset.dnit(?base);
    ret wrote;
}

# how aarch64 selections are spelled
pub val SYNTAX: extension.Syntax = extension.Syntax{parse: parse, spell: spell};

# the aarch64 catalog: its features, versions, levels, conflicts and +ext/-ext syntax
pub val CATALOG: extension.Catalog = extension.Catalog{
    extensions:        ?ROWS[0],
    count:             COUNT,
    levels:            ?LEVELS[0],
    level_count:       LEVEL_COUNT,
    names:             index.Index{at: ?NAMES[0], len: COUNT + LEVEL_COUNT},
    conflicts:         ?CONFLICTS[0],
    conflict_count:    CONFLICT_COUNT,
    combinations:      ?COMBINATIONS[0],
    combination_count: COMBINATION_COUNT,
    syntax:            ?SYNTAX,
};

# the selection `spelling` makes in the aarch64 catalog, into `out`
#[testing]
fun t_select(a: *alloc.Allocator, spelling: str, out: *extension.Selection) bool {
    val made: res[extension.Selection, extension.Error] = extension.select(a, ?CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    @out = made.ok;
    ret true;
}

# how many members the selection holds
#[testing]
fun t_count(s: *extension.Selection) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < s.catalog.count) {
        if (extension.has(s, i)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# whether every id of `ids` is held
#[testing]
fun t_all(s: *extension.Selection, ids: *requirement.Id, len: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        if (!extension.has(s, ids[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether no id of `ids` is held
#[testing]
fun t_none(s: *extension.Selection, ids: *requirement.Id, len: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        if (extension.has(s, ids[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the 55 members of armv9.2-a as Features.json closes v9Ap2: the versions it implies, the features they
# make mandatory outright and I8MM with them, and none of the ones they make mandatory with AdvSIMD or FP
test select__armv9_2_a_closes_to_its_members {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "armv9.2-a", ?s)) { ret 1; }
    val held:   [17]requirement.Id = [17]requirement.Id{V8_0, V8_1, V8_5, V8_6, V8_7, V9_0, V9_1, V9_2, CRC32, LSE, LSE2, PAUTH, BTI, I8MM, WFXT, XS, AA64EL1};
    val absent: [10]requirement.Id = [10]requirement.Id{V8_8, V9_3, SVE, SVE2, SME, FP, SIMD, RDM, BF16, AA32EL1};
    if (t_count(?s) != 55 || !t_all(?s, ?held[0], 17) || !t_none(?s, ?absent[0], 10)) { ret 2; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "armv9.2-a+simd", ?s)) { ret 3; }
    val vector: [9]requirement.Id = [9]requirement.Id{SIMD, FP, RDM, DOTPROD, FP16, FHM, FCMA, JSCVT, BF16};
    if (t_count(?s) != 67 || !t_all(?s, ?vector[0], 9)) { ret 4; }
    extension.release(?s);
    if (testing.live_count(?t) != 0) { ret 5; }
    ret 0;
}

# whether the selection spells exactly as `want`
#[testing]
fun t_spells(a: *alloc.Allocator, s: *extension.Selection, want: str) bool {
    var out:     vector.Vector[u8] = vector.init[u8](a);
    val spelled: err[alloc.Error]  = extension.spell(s, ?out);
    val same:    bool              = !(sel spelled.err) && extension.t_spelled(?out, want);
    vector.dnit[u8](?out);
    ret same;
}

# whether the selection `spelling` makes spells to one that selects the same members
#[testing]
fun t_reads_back(a: *alloc.Allocator, spelling: str) bool {
    var s: extension.Selection;
    if (!t_select(a, spelling, ?s)) { ret false; }
    var out:     vector.Vector[u8] = vector.init[u8](a);
    val spelled: err[alloc.Error]  = extension.spell(?s, ?out);
    var same:    bool              = !(sel spelled.err);
    if (same) {
        val pushed: res[usize, alloc.Error] = vector.push[u8](?out, 0);
        same = !(sel pushed.err);
    }
    var back: extension.Selection;
    if (same) {
        same = t_select(a, out.data::str, ?back);
        if (same) {
            same = extension.within(?s, ?back) && extension.within(?back, ?s);
            extension.release(?back);
        }
    }
    vector.dnit[u8](?out);
    extension.release(?s);
    ret same;
}

test select__modifiers_add_and_remove_in_order_and_spell_back {
    var t: testing.Testing;
    testing.make(?t);
    var s: extension.Selection;
    if (!t_select(testing.allocator_of(?t), "armv8.1-a+nolse", ?s)) { ret 1; }
    val kept: [3]requirement.Id = [3]requirement.Id{V8_0, CRC32, PAN};
    val gone: [2]requirement.Id = [2]requirement.Id{LSE, V8_1};
    if (!t_all(?s, ?kept[0], 3) || !t_none(?s, ?gone[0], 2)) { ret 2; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "+v8.1a,-lse,+lse", ?s) || !extension.has(?s, LSE) || extension.has(?s, V8_1)) { ret 3; }
    extension.release(?s);
    if (!t_select(testing.allocator_of(?t), "armv8-a+fp+simd+sve2", ?s) || !t_spells(testing.allocator_of(?t), ?s, "armv8-a+sve+fp+simd+sve2")) { ret 4; }
    extension.release(?s);
    if (!t_reads_back(testing.allocator_of(?t), "armv8.1-a+nolse") || !t_reads_back(testing.allocator_of(?t), "armv8-a+fp+simd+sve2-aes")) { ret 5; }
    if (!t_select(testing.allocator_of(?t), "armv8-a+fp+nosimd", ?s) || extension.has(?s, FP) || extension.has(?s, SIMD))                  { ret 6; }
    extension.release(?s);
    val unknown: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?CATALOG, "armv9-a+sve+frob", diagnostic.START);
    if (sel unknown.ok)                                                                                                   { ret 7; }
    if (!(sel unknown.err.refused && (unknown.err.refused.span.start.offset == 12 && unknown.err.refused.span.len == 4))) { ret 7; }
    var l: u32 = 0;
    for (l < LEVEL_COUNT) {
        if (!t_select(testing.allocator_of(?t), LEVELS[l].name, ?s)) { ret 8; }
        var out:     vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t));
        val spelled: err[alloc.Error]  = extension.spell(?s, ?out);
        if (sel spelled.err || !extension.t_spelled(?out, LEVELS[l].name)) { ret 9; }
        vector.dnit[u8](?out);
        extension.release(?s);
        l = l + 1;
    }
    if (testing.live_count(?t) != 0) { ret 10; }
    ret 0;
}

# whether `key` is exactly `name`
#[testing]
fun t_same(key: str, name: str) bool {
    if (str_len(key) != str_len(name)) { ret false; }
    var i: usize = 0;
    for (i < str_len(key)) {
        if (key[i] != name[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `a` sorts bytewise before `b`
#[testing]
fun t_before(a: str, b: str) bool {
    var i: usize = 0;
    for (i < str_len(a) && i < str_len(b)) {
        if (a[i] != b[i]) { ret a[i] < b[i]; }
        i = i + 1;
    }
    ret str_len(a) < str_len(b);
}

# the name indexes ascend, name their rows' own names, and llvm's names are lower case, as the folded search needs
test names__the_indexes_ascend_and_name_their_rows {
    var i: u32 = 0;
    for (i < CATALOG.names.len) {
        val e:   index.Entry = CATALOG.names.at[i];
        var own: str         = "";
        if (e.row < COUNT)                                          { own = ROWS[e.row].name; }
        or                                                          { own = LEVELS[e.row - COUNT].name; }
        if (!t_same(e.key, own))                                    { ret 1; }
        if (i > 0 && !t_before(CATALOG.names.at[i - 1].key, e.key)) { ret 2; }
        i = i + 1;
    }
    i = 0;
    for (i < SPELLING_COUNT) {
        val key: str = SPELLING_NAMES[i].key;
        if (SPELLING_NAMES[i].row != i || !t_same(key, SPELLINGS[i].name)) { ret 3; }
        if (i > 0 && !t_before(SPELLING_NAMES[i - 1].key, key))            { ret 4; }
        var at: usize = 0;
        for (at < str_len(key)) {
            if (index.lower(key[at]) != key[at]) { ret 5; }
            at = at + 1;
        }
        i = i + 1;
    }
    ret 0;
}
