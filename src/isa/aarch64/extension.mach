# the aarch64 extension ids the register file requires
#
# the ids are rows of the catalog that masc-26 (#35) writes, and a row's id is its place in that
# catalog. the catalog keeps these two at these ids and adds the rest after them, so the register file
# names an extension by the id it will have

use masc.core.requirement;

# FEAT_SVE, the scalable vector extension, whose z, p and ffr registers a selection without it lacks
pub val SVE: requirement.Id = 0;

# FEAT_SME, the scalable matrix extension, whose za tiles a selection without it lacks and whose streaming mode gives z and p registers without FEAT_SVE
pub val SME: requirement.Id = SVE + 1;
