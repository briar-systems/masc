pub val EXTEND_EXCLUDED: [3]i64 = [3]i64{5, 6, 7};

# ADD and SUB (immediate), imm12
pub val IMM12: layout.Layout = layout.Layout{name: "imm12", unit: 32, pieces: layout.Pieces{at: ?IMM12_PIECES[0], len: 1}, value: operand.Immediate{bits: 12, sign: operand.UNSIGNED, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# MOVZ, MOVN and MOVK, imm16
