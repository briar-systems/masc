};

# the shift types of the shifted register forms, `ror` the logical instructions' alone
pub val SHIFT_MEMBERS:    [4]operand.Enumerant = [4]operand.Enumerant{operand.Enumerant{name: "lsl", value: 0}, operand.Enumerant{name: "lsr", value: 1}, operand.Enumerant{name: "asr", value: 2}, operand.Enumerant{name: "ror", value: 3}};
pub val SHIFT_NAMES:      [4]index.Entry       = [4]index.Entry{index.Entry{key: "asr", row: 2}, index.Entry{key: "lsl", row: 0}, index.Entry{key: "lsr", row: 1}, index.Entry{key: "ror", row: 3}};
pub val ARITHMETIC_NAMES: [3]index.Entry       = [3]index.Entry{index.Entry{key: "asr", row: 2}, index.Entry{key: "lsl", row: 0}, index.Entry{key: "lsr", row: 1}};

# the extend options of the extended register forms
pub val EXTEND_MEMBERS: [8]operand.Enumerant = [8]operand.Enumerant{
    operand.Enumerant{name: "uxtb", value: 0},
    operand.Enumerant{name: "uxth", value: 1},
    operand.Enumerant{name: "uxtw", value: 2},
    operand.Enumerant{name: "uxtx", value: 3},
