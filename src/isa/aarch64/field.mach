pub val BRANCH26: layout.Layout = layout.Layout{name: "branch26", unit: 32, pieces: layout.Pieces{at: ?BRANCH26_PIECES[0], len: 1}, value: operand.Immediate{bits: 28, sign: operand.SIGNED, scale: 2, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
