pub val AMOUNT5: layout.Layout = layout.Layout{name: "amount5", unit: 32, pieces: layout.Pieces{at: ?AMOUNT6_PIECES[0], len: 1}, value: operand.Immediate{bits: 5, sign: operand.UNSIGNED, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
