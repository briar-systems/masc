pub val ADRP: layout.Layout = layout.Layout{name: "adrp", unit: 32, pieces: layout.Pieces{at: ?ADRP_PIECES[0], len: 2}, value: operand.Immediate{bits: 33, signed: true, scale: 12, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# TBZ and TBNZ, b5:b40, the bit tested
pub val BIT6: layout.Layout = layout.Layout{name: "bit6", unit: 32, pieces: layout.Pieces{at: ?BIT6_PIECES[0], len: 2}, value: operand.Immediate{bits: 6, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# the shifted register forms' imm6 shift amount, of a 64-bit register
pub val AMOUNT6: layout.Layout = layout.Layout{name: "amount6", unit: 32, pieces: layout.Pieces{at: ?AMOUNT6_PIECES[0], len: 1}, value: operand.Immediate{bits: 6, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# the shifted register forms' imm6 shift amount, of a 32-bit register, whose top bit the row fixes at zero
pub val AMOUNT5: layout.Layout = layout.Layout{name: "amount5", unit: 32, pieces: layout.Pieces{at: ?AMOUNT6_PIECES[0], len: 1}, value: operand.Immediate{bits: 5, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# ADD and SUB (extended register), imm3, a left shift of 0 to 4
pub val EXTEND_AMOUNT: layout.Layout = layout.Layout{name: "extend_amount", unit: 32, pieces: layout.Pieces{at: ?AMOUNT3_PIECES[0], len: 1}, value: operand.Immediate{bits: 3, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.Integers{at: ?EXTEND_EXCLUDED[0], len: 3}}};
