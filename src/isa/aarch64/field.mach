pub val CONDITION_NAMES: [18]index.Entry = [18]index.Entry{
    index.Entry{key: "al", row: 16},
    index.Entry{key: "cc", row: 4},
    index.Entry{key: "cs", row: 2},
    index.Entry{key: "eq", row: 0},
    index.Entry{key: "ge", row: 12},
    index.Entry{key: "gt", row: 14},
