# the aarch64 field kinds and the operand layouts rows are built from
#
# every a64 instruction is one 32-bit little-endian unit, and almost every field
# of it is a slice of an operand's number: a split or scaled immediate is pieces
# of one encoded number with its zero low bits stated as the immediate's scale,
# a register is five bits of its number, and a condition, shift, extend,
# arrangement size or tile direction is bits holding an enumerant's value. those
# go through the core's unit kind, stated once here as core layout records. a
# kind exists only where slices cannot express the encoding:
#   bitmask  the N:immr:imms logical immediate, a rotated run of ones repeated
#            across the register, which no slice of the value's bits encodes
#
# sources, read as published:
#   Arm Architecture Reference Manual for A-profile, machine-readable instruction model, AARCHMRS
#     AARCHMRS_OPENSOURCE_A_profile_FAT-2026-03 (git.kernel.org/pub/scm/linux/kernel/git/maz/AARCHMRS.git
#     47b5446cf08ef6a46c86147c7deb0d56caf99d93), Instructions.json: the bit positions of every field below,
#     by the encoding it names, and the shared pseudocode DecodeBitMasks, which `decode_bitmask` follows
#   Arm Architecture Reference Manual for A-profile (DDI 0487), C1.2.4 "Condition code": the condition
#     encodings, and the advanced simd and sve chapters: the arrangement and element size specifiers
#   llvm-mc 23.1.1: every expected encoding in the tests below
#
# an enumerant member's name is the operand's own text with no separator, as `eq`, `lsl` or `8b`, and an
# operand the text may leave out names its default member by the empty name, as the add shift's `lsl #12`
# or nothing. the syntax places the commas and the `#`
#
# not covered here: the floating-point 8-bit immediate of fmov (an operand.FLOAT a row's kind narrows),
# the sve and sme immediates particular to one instruction family (index, shifts by element size, the
# `mul vl` offsets), the predicate qualifiers `/z` and `/m`, whose bit differs by family, and the sme2
# multi-vector groups. each is a row's layout of the catalog that states it

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.view;

use alloc: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.codec.walk;
use masc.core.constraint;
use masc.core.ct;
use masc.core.diagnostic;
use masc.core.dispatch;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.index;
use masc.core.inst;
use masc.core.layout;
use masc.core.operand;
use masc.core.register;
use masc.core.requirement;
use masc.core.row;
use masc.core.state;

use aarch64: masc.isa.aarch64.extension;

pub val UNIT_KIND:    u16 = 0;
pub val BITMASK_KIND: u16 = 1;

pub val NO_BITMASK: str = "value is not a bitmask immediate";
pub val RESERVED:   str = "reserved bitmask immediate encoding";
pub val WIDER:      str = "bitmask immediate repeats wider than the operand's element";

# `value`'s low `width` bits repeated across `domain` bits, both powers of two
pub fun replicate(value: u64, width: u32, domain: u32) u64 {
    var v: u64 = value & field.ones(width::u8);
    var w: u32 = width;
    for (w < domain) {
        v = v | (v << w::u64);
        w = w * 2;
    }
    ret v;
}

# the low `e` bits of `x` rotated right by `r`
fun ror(x: u64, r: u32, e: u32) u64 {
    if (r == 0) { ret x; }
    ret ((x >> r::u64) | (x << (e - r)::u64)) & field.ones(e::u8);
}

# the N:immr:imms code of the `domain`-bit value, `domain` 32 or 64: an element of 2 to `domain` bits
# that is a run of ones rotated right by immr, repeated across the value
# ---
# ret: the 13-bit code, N in bit 12, immr in bits 6 to 11 and imms in bits 0 to 5, or none for a value
#      no element repeats to, which every value of all zeros or all ones is
pub fun encode_bitmask(value: u64, domain: u32) opt[u64] {
    val all: u64 = field.ones(domain::u8);
    val v:   u64 = value & all;
    if (v == 0 || v == all) { ret opt[u64].none{}; }
    var size: u32 = domain;
    for (size > 2) {
        val half: u32 = size / 2;
        val low:  u64 = field.ones(half::u8);
        if ((v & low) != ((v >> half::u64) & low)) { brk; }
        size = half;
    }
    val mask: u64 = field.ones(size::u8);
    val elt:  u64 = v & mask;
    var r:    u32 = 0;
    for (r < size) {
        var run: u64 = elt;
        if (r != 0) { run = ((elt << r::u64) | (elt >> (size - r)::u64)) & mask; }
        if ((run & (run + 1)) == 0) {
            var ones: u32 = 0;
            for (((run >> ones::u64) & 1) != 0) { ones = ones + 1; }
            var n: u64 = 0;
            if (size == 64) { n = 1; }
            val imms: u64 = ((((~(size - 1)) << 1) | (ones - 1)) & 0x3F)::u64;
            ret opt[u64].some{(n << 12) | (r::u64 << 6) | imms};
        }
        r = r + 1;
    }
    ret opt[u64].none{};
}

# the `domain`-bit value the 13-bit N:immr:imms `code` encodes, as DecodeBitMasks gives it
# ---
# ret: the value, or none for an encoding the architecture reserves: no element size, an element wider
#      than `domain`, or an element of all ones
pub fun decode_bitmask(code: u64, domain: u32) opt[u64] {
    val n:        u64 = (code >> 12) & 1;
    val immr:     u32 = ((code >> 6) & 0x3F)::u32;
    val imms:     u32 = (code & 0x3F)::u32;
    val combined: u32 = (n::u32 << 6) | (~imms & 0x3F);
    if (combined == 0) { ret opt[u64].none{}; }
    var len: u32 = 6;
    for (((combined >> len) & 1) == 0) { len = len - 1; }
    if (len < 1) { ret opt[u64].none{}; }
    val esize: u32 = 1::u32 << len;
    if (esize > domain) { ret opt[u64].none{}; }
    val levels: u32 = esize - 1;
    val s:      u32 = imms & levels;
    if (s == levels) { ret opt[u64].none{}; }
    val element: u64 = ror(field.ones((s + 1)::u8), immr & levels, esize);
    ret opt[u64].some{replicate(element, esize, domain)};
}

# a bitmask field's param: the operand value's width in bits 0 to 7, the width the code decodes to in bits
# 8 to 15, and the bit the 13-bit code starts at in bits 16 to 23. a64's and, orr, eor and tst take the
# register's width for both and the code at bit 10, and sve's take the element's width, 64 and bit 5
pub fun bitmask_param(width: u8, domain: u8, at: u8) u64 {
    ret width::u64 | (domain::u64 << 8) | (at::u64 << 16);
}

fun param_width(p: u64) u32 {
    ret (p & 0xFF)::u32;
}

fun param_domain(p: u64) u32 {
    ret ((p >> 8) & 0xFF)::u32;
}

fun param_at(p: u64) u64 {
    ret (p >> 16) & 0xFF;
}

# the code of the field operand's value, refused at stream offset `at` when it has none
fun bitmask_code(enc: *field.Encoder, f: *field.Field, at: usize) res[u64, field.Refusal] {
    if (f.operand::u32 >= enc.count) { ret res[u64, field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, at)}; }
    val width:  u32      = param_width(f.param);
    val domain: u32      = param_domain(f.param);
    val code:   opt[u64] = encode_bitmask(replicate(enc.parts[f.operand].bits[field.NUMBER], width, domain), domain);
    if (sel code.none) { ret res[u64, field.Refusal].err{field.refusal(NO_BITMASK, f.operand, at)}; }
    ret res[u64, field.Refusal].ok{code.some};
}

fun bitmask_admit(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val code: res[u64, field.Refusal] = bitmask_code(enc, f, 0);
    if (sel code.err) { ret err[field.Refusal].err{code.err}; }
    ret err[field.Refusal].ok{};
}

fun bitmask_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val code: res[u64, field.Refusal] = bitmask_code(enc, f, enc.out.len);
    if (sel code.err) { ret err[field.Refusal].err{code.err}; }
    val unit: res[u64, field.Refusal] = field.pack(enc, f);
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    ret field.put(enc, unit.ok | (code.ok << param_at(f.param)), f.width / 8);
}

fun bitmask_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    if (f.operand::u32 >= dec.count) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, dec.at)}; }
    val at:   usize                   = dec.at;
    val unit: res[u64, field.Refusal] = field.get(dec, f.width / 8);
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    val unpacked: err[field.Refusal] = field.unpack(dec, f, unit.ok, at);
    if (sel unpacked.err) { ret unpacked; }
    val width:  u32      = param_width(f.param);
    val domain: u32      = param_domain(f.param);
    val value:  opt[u64] = decode_bitmask((unit.ok >> param_at(f.param)) & 0x1FFF, domain);
    if (sel value.none)                                     { ret err[field.Refusal].err{field.refusal(RESERVED, f.operand, at)}; }
    if (replicate(value.some, width, domain) != value.some) { ret err[field.Refusal].err{field.refusal(WIDER, f.operand, at)}; }
    field.deposit(dec, f.operand, field.NUMBER, value.some & field.ones(width::u8), 0);
    ret err[field.Refusal].ok{};
}

# the logical immediate: the field operand's value as its N:immr:imms code, the rest of the unit fixed bits and slices
pub val BITMASK: field.Kind = field.Kind{name: "bitmask", admit: bitmask_admit, encode: bitmask_encode, decode: bitmask_decode, finish: nil};

val KINDS: [2]*field.Kind = [2]*field.Kind{?field.UNIT, ?BITMASK};

# the aarch64 field table, its units little-endian
pub val TABLE: field.Table = field.Table{kinds: ?KINDS[0], count: 2, order: field.LITTLE};

# the value a bitmask field's operand holds: the register's bits for a64, the element's for sve
pub val BITMASK_32: operand.Immediate = operand.Immediate{bits: 32, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS};
pub val BITMASK_64: operand.Immediate = operand.Immediate{bits: 64, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS};
pub val BITMASK_8:  operand.Immediate = operand.Immediate{bits: 8, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS};
pub val BITMASK_16: operand.Immediate = operand.Immediate{bits: 16, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS};

val IMM12_PIECES:    [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 12, at: 10}};
val IMM16_PIECES:    [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 16, at: 5}};
val UOFF1_PIECES:    [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 12, at: 10}};
val UOFF2_PIECES:    [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 1, len: 12, at: 10}};
val UOFF4_PIECES:    [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 2, len: 12, at: 10}};
val UOFF8_PIECES:    [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 3, len: 12, at: 10}};
val UOFF16_PIECES:   [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 4, len: 12, at: 10}};
val SIMM9_PIECES:    [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 9, at: 12}};
val PAIR4_PIECES:    [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 2, len: 7, at: 15}};
val PAIR8_PIECES:    [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 3, len: 7, at: 15}};
val PAIR16_PIECES:   [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 4, len: 7, at: 15}};
val BRANCH26_PIECES: [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 2, len: 26, at: 0}};
val BRANCH19_PIECES: [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 2, len: 19, at: 5}};
val BRANCH14_PIECES: [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 2, len: 14, at: 5}};
val ADR_PIECES:      [2]layout.Piece = [2]layout.Piece{layout.Piece{lo: 0, len: 2, at: 29}, layout.Piece{lo: 2, len: 19, at: 5}};
val ADRP_PIECES:     [2]layout.Piece = [2]layout.Piece{layout.Piece{lo: 12, len: 2, at: 29}, layout.Piece{lo: 14, len: 19, at: 5}};
val BIT6_PIECES:     [2]layout.Piece = [2]layout.Piece{layout.Piece{lo: 0, len: 5, at: 19}, layout.Piece{lo: 5, len: 1, at: 31}};
val AMOUNT6_PIECES:  [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 6, at: 10}};
val AMOUNT3_PIECES:  [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 3, at: 10}};
val CCMP5_PIECES:    [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 5, at: 16}};
val NZCV_PIECES:     [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 4, at: 0}};

pub val EXTEND_EXCLUDED: [3]i64 = [3]i64{5, 6, 7};

# ADD and SUB (immediate), imm12
pub val IMM12: layout.Layout = layout.Layout{name: "imm12", unit: 32, pieces: layout.Pieces{at: ?IMM12_PIECES[0], len: 1}, value: operand.Immediate{bits: 12, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# MOVZ, MOVN and MOVK, imm16
pub val IMM16: layout.Layout = layout.Layout{name: "imm16", unit: 32, pieces: layout.Pieces{at: ?IMM16_PIECES[0], len: 1}, value: operand.Immediate{bits: 16, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# LDR and STR (immediate) unsigned offset, imm12 scaled by the access's bytes: a byte, a halfword, a word, a doubleword, a quadword
pub val UOFF1:  layout.Layout = layout.Layout{name: "uoff1", unit: 32, pieces: layout.Pieces{at: ?UOFF1_PIECES[0], len: 1}, value: operand.Immediate{bits: 12, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
pub val UOFF2:  layout.Layout = layout.Layout{name: "uoff2", unit: 32, pieces: layout.Pieces{at: ?UOFF2_PIECES[0], len: 1}, value: operand.Immediate{bits: 13, signed: false, scale: 1, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
pub val UOFF4:  layout.Layout = layout.Layout{name: "uoff4", unit: 32, pieces: layout.Pieces{at: ?UOFF4_PIECES[0], len: 1}, value: operand.Immediate{bits: 14, signed: false, scale: 2, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
pub val UOFF8:  layout.Layout = layout.Layout{name: "uoff8", unit: 32, pieces: layout.Pieces{at: ?UOFF8_PIECES[0], len: 1}, value: operand.Immediate{bits: 15, signed: false, scale: 3, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
pub val UOFF16: layout.Layout = layout.Layout{name: "uoff16", unit: 32, pieces: layout.Pieces{at: ?UOFF16_PIECES[0], len: 1}, value: operand.Immediate{bits: 16, signed: false, scale: 4, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# LDUR and STUR, and LDR and STR (immediate) pre-index and post-index, imm9 unscaled
pub val SIMM9: layout.Layout = layout.Layout{name: "simm9", unit: 32, pieces: layout.Pieces{at: ?SIMM9_PIECES[0], len: 1}, value: operand.Immediate{bits: 9, signed: true, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# LDP and STP, imm7 scaled by the access's bytes: a word pair, a doubleword pair, a quadword pair
pub val PAIR4:  layout.Layout = layout.Layout{name: "pair4", unit: 32, pieces: layout.Pieces{at: ?PAIR4_PIECES[0], len: 1}, value: operand.Immediate{bits: 9, signed: true, scale: 2, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
pub val PAIR8:  layout.Layout = layout.Layout{name: "pair8", unit: 32, pieces: layout.Pieces{at: ?PAIR8_PIECES[0], len: 1}, value: operand.Immediate{bits: 10, signed: true, scale: 3, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
pub val PAIR16: layout.Layout = layout.Layout{name: "pair16", unit: 32, pieces: layout.Pieces{at: ?PAIR16_PIECES[0], len: 1}, value: operand.Immediate{bits: 11, signed: true, scale: 4, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# B and BL, imm26 in words
pub val BRANCH26: layout.Layout = layout.Layout{name: "branch26", unit: 32, pieces: layout.Pieces{at: ?BRANCH26_PIECES[0], len: 1}, value: operand.Immediate{bits: 28, signed: true, scale: 2, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# B.cond, BC.cond, CBZ, CBNZ and LDR (literal), imm19 in words
pub val BRANCH19: layout.Layout = layout.Layout{name: "branch19", unit: 32, pieces: layout.Pieces{at: ?BRANCH19_PIECES[0], len: 1}, value: operand.Immediate{bits: 21, signed: true, scale: 2, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# TBZ and TBNZ, imm14 in words
pub val BRANCH14: layout.Layout = layout.Layout{name: "branch14", unit: 32, pieces: layout.Pieces{at: ?BRANCH14_PIECES[0], len: 1}, value: operand.Immediate{bits: 16, signed: true, scale: 2, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
# ADR, immhi:immlo in bytes
pub val ADR: layout.Layout = layout.Layout{name: "adr", unit: 32, pieces: layout.Pieces{at: ?ADR_PIECES[0], len: 2}, value: operand.Immediate{bits: 21, signed: true, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}};
