# the aarch64 field kinds and the operand layouts rows are built from
#
# every a64 instruction is one 32-bit little-endian unit, and almost every field
# of it is a slice of an operand's number: a split or scaled immediate is pieces
# of one encoded number with its zero low bits stated as the immediate's scale,
# a register is five bits of its number, and a condition, shift, extend,
# arrangement size or tile direction is bits holding an enumerant's value. those
# go through the word kind, the core's unit with the bits a symbol's fixup kind
# fixes beyond its field, stated once here as core layout records. a kind
# exists only where slices cannot express the encoding:
#   bitmask  the N:immr:imms logical immediate, a rotated run of ones repeated
#            across the register, which no slice of the value's bits encodes
#   float8   fmov's 8-bit floating-point immediate, VFPExpandImm
#   multiple an odd multiple of a number of its bits, as ld3's `#-24, mul vl`
#   bytemask movi's 64-bit immediate, each byte all ones or all zeros by one
#            bit of a:b:c:d:e:f:g:h
#
# sources, read as published:
#   Arm Architecture Reference Manual for A-profile, machine-readable instruction model, AARCHMRS
#     AARCHMRS_OPENSOURCE_A_profile_FAT-2026-03 (git.kernel.org/pub/scm/linux/kernel/git/maz/AARCHMRS.git
#     47b5446cf08ef6a46c86147c7deb0d56caf99d93), Instructions.json: the bit positions of every field below,
#     by the encoding it names, and the shared pseudocode DecodeBitMasks, which `decode_bitmask` follows
#   Arm Architecture Reference Manual for A-profile (DDI 0487), C1.2.4 "Condition code": the condition
#     encodings, and the advanced simd and sve chapters: the arrangement and element size specifiers
#   llvm-mc 23.1.1: every expected encoding in the tests below
#
# an enumerant member's name is the operand's own text with no separator, as `eq`, `lsl` or `8b`, and an
# operand the text may leave out names its default member by the empty name, as the add shift's `lsl #12`
# or nothing. the syntax places the commas and the `#`
#
# the sve and sme immediates particular to one instruction family, the predicate qualifiers `/z` and
# `/m` and the sme2 multi-vector groups are each a row's slices of the catalog that states it

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.view;

use alloc: std.allocator;

use masc.core.field;
use masc.core.index;
use masc.core.layout;
use masc.core.operand;
use masc.core.register;
use masc.core.row;

use aarch64_fixup: masc.isa.aarch64.fixup;

pub val UNIT_KIND:     u16 = 0;
pub val BITMASK_KIND:  u16 = 1;
pub val FLOAT8_KIND:   u16 = 2;
pub val MULTIPLE_KIND: u16 = 3;
pub val BYTEMASK_KIND: u16 = 4;

pub val NO_BITMASK: str = "value is not a bitmask immediate";
pub val RESERVED:   str = "reserved bitmask immediate encoding";
pub val WIDER:      str = "bitmask immediate repeats wider than the operand's element";
pub val NARROWER:   str = "bitmask immediate repeats at an element size its row does not encode";

# `value`'s low `width` bits repeated across `domain` bits, both powers of two
pub fun replicate(value: u64, width: u32, domain: u32) u64 {
    var v: u64 = value & field.ones(width::u8);
    var w: u32 = width;
    for (w < domain) {
        v = v | (v << w::u64);
        w = w * 2;
    }
    ret v;
}

# the low `e` bits of `x` rotated right by `r`
fun ror(x: u64, r: u32, e: u32) u64 {
    if (r == 0) { ret x; }
    ret ((x >> r::u64) | (x << (e - r)::u64)) & field.ones(e::u8);
}

# the N:immr:imms code of the `domain`-bit value, `domain` 32 or 64: an element of 2 to `domain` bits
# that is a run of ones rotated right by immr, repeated across the value
# ---
# ret: the 13-bit code, N in bit 12, immr in bits 6 to 11 and imms in bits 0 to 5, or none for a value
#      no element repeats to, which every value of all zeros or all ones is
pub fun encode_bitmask(value: u64, domain: u32) opt[u64] {
    val all: u64 = field.ones(domain::u8);
    val v:   u64 = value & all;
    if (v == 0 || v == all) { ret opt[u64].none{}; }
    var size: u32 = domain;
    for (size > 2) {
        val half: u32 = size / 2;
        val low:  u64 = field.ones(half::u8);
        if ((v & low) != ((v >> half::u64) & low)) { brk; }
        size = half;
    }
    val mask: u64 = field.ones(size::u8);
    val elt:  u64 = v & mask;
    var r:    u32 = 0;
    for (r < size) {
        var run: u64 = elt;
        if (r != 0) { run = ((elt << r::u64) | (elt >> (size - r)::u64)) & mask; }
        if ((run & (run + 1)) == 0) {
            var ones: u32 = 0;
            for (((run >> ones::u64) & 1) != 0) { ones = ones + 1; }
            var n: u64 = 0;
            if (size == 64) { n = 1; }
            val imms: u64 = ((((~(size - 1)) << 1) | (ones - 1)) & 0x3F)::u64;
            ret opt[u64].some{(n << 12) | (r::u64 << 6) | imms};
        }
        r = r + 1;
    }
    ret opt[u64].none{};
}

# the `domain`-bit value the 13-bit N:immr:imms `code` encodes, as DecodeBitMasks gives it
# ---
# ret: the value, or none for an encoding the architecture reserves: no element size, an element wider
#      than `domain`, or an element of all ones
pub fun decode_bitmask(code: u64, domain: u32) opt[u64] {
    val n:        u64 = (code >> 12) & 1;
    val immr:     u32 = ((code >> 6) & 0x3F)::u32;
    val imms:     u32 = (code & 0x3F)::u32;
    val combined: u32 = (n::u32 << 6) | (~imms & 0x3F);
    if (combined == 0) { ret opt[u64].none{}; }
    var len: u32 = 6;
    for (((combined >> len) & 1) == 0) { len = len - 1; }
    if (len < 1) { ret opt[u64].none{}; }
    val esize: u32 = 1::u32 << len;
    if (esize > domain) { ret opt[u64].none{}; }
    val levels: u32 = esize - 1;
    val s:      u32 = imms & levels;
    if (s == levels) { ret opt[u64].none{}; }
    val element: u64 = ror(field.ones((s + 1)::u8), immr & levels, esize);
    ret opt[u64].some{replicate(element, esize, domain)};
}

# a bitmask field's param: the operand value's width in bits 0 to 7, the width the code decodes to in bits
# 8 to 15, and the bit the 13-bit code starts at in bits 16 to 23. a64's and, orr, eor and tst take the
# register's width for both and the code at bit 10, and sve's take the element's width, 64 and bit 5
pub fun bitmask_param(width: u8, domain: u8, at: u8) u64 {
    ret width::u64 | (domain::u64 << 8) | (at::u64 << 16);
}

fun param_width(p: u64) u32 {
    ret (p & 0xFF)::u32;
}

fun param_domain(p: u64) u32 {
    ret ((p >> 8) & 0xFF)::u32;
}

fun param_at(p: u64) u64 {
    ret (p >> 16) & 0xFF;
}

# the code of the field operand's value, refused at stream offset `at` when it has none
fun bitmask_code(enc: *field.Encoder, f: *field.Field, at: usize) res[u64, field.Refusal] {
    if (f.operand::u32 >= enc.count) { ret res[u64, field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, at)}; }
    val width:  u32      = param_width(f.param);
    val domain: u32      = param_domain(f.param);
    val code:   opt[u64] = encode_bitmask(replicate(enc.parts[f.operand].bits[field.NUMBER], width, domain), domain);
    if (sel code.none) { ret res[u64, field.Refusal].err{field.refusal(NO_BITMASK, f.operand, at)}; }
    # a row of one element size fixes the code's bits that state it, as sve's .d fixes N, so a value repeating at a
    # smaller element is its row's, never written over the fixed bits
    val held: u64 = (0x1FFF::u64 << param_at(f.param)) & f.mask;
    if (((code.some << param_at(f.param)) & held) != (f.fixed & held)) { ret res[u64, field.Refusal].err{field.refusal(NARROWER, f.operand, at)}; }
    ret res[u64, field.Refusal].ok{code.some};
}

fun bitmask_admit(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val code: res[u64, field.Refusal] = bitmask_code(enc, f, 0);
    if (sel code.err) { ret err[field.Refusal].err{code.err}; }
    ret err[field.Refusal].ok{};
}

fun bitmask_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val code: res[u64, field.Refusal] = bitmask_code(enc, f, enc.out.len);
    if (sel code.err) { ret err[field.Refusal].err{code.err}; }
    val unit: res[u64, field.Refusal] = field.pack(enc, f);
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    ret field.put(enc, unit.ok | (code.ok << param_at(f.param)), f.width / 8);
}

fun bitmask_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    if (f.operand::u32 >= dec.count) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, dec.at)}; }
    val at:   usize                   = dec.at;
    val unit: res[u64, field.Refusal] = field.get(dec, f.width / 8);
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    val unpacked: err[field.Refusal] = field.unpack(dec, f, unit.ok, at);
    if (sel unpacked.err) { ret unpacked; }
    val width:  u32      = param_width(f.param);
    val domain: u32      = param_domain(f.param);
    val value:  opt[u64] = decode_bitmask((unit.ok >> param_at(f.param)) & 0x1FFF, domain);
    if (sel value.none)                                     { ret err[field.Refusal].err{field.refusal(RESERVED, f.operand, at)}; }
    if (replicate(value.some, width, domain) != value.some) { ret err[field.Refusal].err{field.refusal(WIDER, f.operand, at)}; }
    field.deposit(dec, f.operand, field.NUMBER, value.some & field.ones(width::u8), 0);
    ret err[field.Refusal].ok{};
}

# the logical immediate: the field operand's value as its N:immr:imms code, the rest of the unit fixed bits and slices
pub val BITMASK: field.Kind = field.Kind{name: "bitmask", admit: bitmask_admit, encode: bitmask_encode, decode: bitmask_decode, finish: nil, complete: nil, check: nil};

# the exponent bits of an ieee 754 binary float of `width` bits, 0 for a width aarch64 has no 8-bit immediate of
fun exponent_bits(width: u32) u32 {
    if (width == 16) { ret 5; }
    if (width == 32) { ret 8; }
    if (width == 64) { ret 11; }
    ret 0;
}

# the 8-bit immediate a:b:c:d:e:f:g:h of the `width`-bit float `v`, as VFPExpandImm reads it back: the sign a, an
# exponent of NOT(b), b repeated and c:d, and a fraction of e:f:g:h and zeros. none for a value it cannot hold
pub fun encode_float8(v: u64, width: u32) opt[u64] {
    val e: u32 = exponent_bits(width);
    if (e == 0) { ret opt[u64].none{}; }
    val f:    u32 = width - e - 1;
    val sign: u64 = (v >> (width - 1)::u64) & 1;
    val exp:  u64 = (v >> f::u64) & field.ones(e::u8);
    val frac: u64 = v & field.ones(f::u8);
    if ((frac & field.ones((f - 4)::u8)) != 0) { ret opt[u64].none{}; }
    val b:    u64 = (exp >> (e - 2)::u64) & 1;
    val top:  u64 = (exp >> (e - 1)::u64) & 1;
    val reps: u64 = (exp >> 2) & field.ones((e - 3)::u8);
    if (top == b)                                                             { ret opt[u64].none{}; }
    if ((b == 1 && reps != field.ones((e - 3)::u8)) || (b == 0 && reps != 0)) { ret opt[u64].none{}; }
    ret opt[u64].some{(sign << 7) | (b << 6) | ((exp & 3) << 4) | (frac >> (f - 4)::u64)};
}

# the `width`-bit float the 8-bit immediate `imm8` expands to, VFPExpandImm
pub fun decode_float8(imm8: u64, width: u32) u64 {
    val e:    u32 = exponent_bits(width);
    val f:    u32 = width - e - 1;
    val sign: u64 = (imm8 >> 7) & 1;
    val b:    u64 = (imm8 >> 6) & 1;
    var exp:  u64 = ((b ^ 1) << (e - 1)::u64) | ((imm8 >> 4) & 3);
    if (b == 1) { exp = exp | (field.ones((e - 3)::u8) << 2); }
    ret (sign << (width - 1)::u64) | (exp << f::u64) | ((imm8 & 0xF) << (f - 4)::u64);
}

# part NUMBER of the field operand set to `bits` while the field's unit is packed, and put
fun put_number(enc: *field.Encoder, f: *field.Field, bits: u64) err[field.Refusal] {
    val p:    *field.Parts = ?enc.parts[f.operand];
    val kept: u64          = p.bits[field.NUMBER];
    p.bits[field.NUMBER] = bits;
    val unit: res[u64, field.Refusal] = field.pack(enc, f);
    p.bits[field.NUMBER] = kept;
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    ret field.put(enc, unit.ok, f.width / 8);
}

# the unit of the field read and its slices deposited, its offset into `at`
fun got_unit(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    if (f.operand::u32 >= dec.count) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, dec.at)}; }
    val at:   usize                   = dec.at;
    val unit: res[u64, field.Refusal] = field.get(dec, f.width / 8);
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    ret field.unpack(dec, f, unit.ok, at);
}

pub val NO_FLOAT8: str = "value is not a floating-point number of an 8-bit immediate";

fun float8_code(enc: *field.Encoder, f: *field.Field, at: usize) res[u64, field.Refusal] {
    if (f.operand::u32 >= enc.count) { ret res[u64, field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, at)}; }
    val code: opt[u64] = encode_float8(enc.parts[f.operand].bits[field.NUMBER], f.param::u32);
    if (sel code.none) { ret res[u64, field.Refusal].err{field.refusal(NO_FLOAT8, f.operand, at)}; }
    ret res[u64, field.Refusal].ok{code.some};
}

fun float8_admit(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val code: res[u64, field.Refusal] = float8_code(enc, f, 0);
    if (sel code.err) { ret err[field.Refusal].err{code.err}; }
    ret err[field.Refusal].ok{};
}

fun float8_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val code: res[u64, field.Refusal] = float8_code(enc, f, enc.out.len);
    if (sel code.err) { ret err[field.Refusal].err{code.err}; }
    ret put_number(enc, f, code.ok);
}

fun float8_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    val got: err[field.Refusal] = got_unit(dec, f);
    if (sel got.err) { ret got; }
    field.replace(dec, f.operand, field.NUMBER, decode_float8(dec.parts[f.operand].bits[field.NUMBER] & 0xFF, f.param::u32));
    ret err[field.Refusal].ok{};
}

# fmov's floating-point immediate: the field operand's value, a float of the param's width, as the 8-bit immediate its
# slices place
pub val FLOAT8: field.Kind = field.Kind{name: "float8", admit: float8_admit, encode: float8_encode, decode: float8_decode, finish: nil, complete: nil, check: nil};

# a multiple field's param: the odd multiplier in bits 0 to 7, the bits of the multiplied number in bits 8 to 15, and
# whether it is signed in bit 16
pub fun multiple_param(by: u8, bits: u8, signed: bool) u64 {
    var s: u64 = 0;
    if (signed) { s = 1; }
    ret by::u64 | (bits::u64 << 8) | (s << 16);
}

# `raw`'s low `bits` bits as a number, two's complement when `signed`
fun extend_bits(raw: u64, bits: u32, signed: bool) i64 {
    var v: u64 = raw & field.ones(bits::u8);
    if (signed && bits > 0 && bits < 64 && ((v >> (bits - 1)::u64) & 1) != 0) { v = v | ~field.ones(bits::u8); }
    ret v:~i64;
}

# the bits of the field operand's immediate, the width its encoded number is masked to
fun operand_bits(operands: *operand.Operand, op: u8) u32 {
    val shape: *operand.Shape = ?operands[op].shape;
    if (sel shape.immediate) { ret shape.immediate.bits::u32 - shape.immediate.scale::u32; }
    ret 64;
}

pub val NOT_MULTIPLE: str = "value is not a multiple of its field's multiplier within its bits";

fun multiple_number(enc: *field.Encoder, f: *field.Field, at: usize) res[u64, field.Refusal] {
    if (f.operand::u32 >= enc.count) { ret res[u64, field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, at)}; }
    val by:     i64  = (f.param & 0xFF):~i64;
    val bits:   u32  = ((f.param >> 8) & 0xFF)::u32;
    val signed: bool = ((f.param >> 16) & 1) != 0;
    val d:      i64  = extend_bits(enc.parts[f.operand].bits[field.NUMBER], operand_bits(enc.operands, f.operand), signed);
    if (by == 0 || d % by != 0) { ret res[u64, field.Refusal].err{field.refusal(NOT_MULTIPLE, f.operand, at)}; }
    val n: i64 = d / by;
    if (extend_bits(n:~u64, bits, signed) != n) { ret res[u64, field.Refusal].err{field.refusal(NOT_MULTIPLE, f.operand, at)}; }
    ret res[u64, field.Refusal].ok{n:~u64 & field.ones(bits::u8)};
}

fun multiple_admit(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val n: res[u64, field.Refusal] = multiple_number(enc, f, 0);
    if (sel n.err) { ret err[field.Refusal].err{n.err}; }
    ret err[field.Refusal].ok{};
}

fun multiple_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val n: res[u64, field.Refusal] = multiple_number(enc, f, enc.out.len);
    if (sel n.err) { ret err[field.Refusal].err{n.err}; }
    ret put_number(enc, f, n.ok);
}

fun multiple_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    val got: err[field.Refusal] = got_unit(dec, f);
    if (sel got.err) { ret got; }
    val by:     i64  = (f.param & 0xFF):~i64;
    val bits:   u32  = ((f.param >> 8) & 0xFF)::u32;
    val signed: bool = ((f.param >> 16) & 1) != 0;
    val n:      i64  = extend_bits(dec.parts[f.operand].bits[field.NUMBER], bits, signed);
    field.replace(dec, f.operand, field.NUMBER, (n * by):~u64 & field.ones(operand_bits(dec.operands, f.operand)::u8));
    ret err[field.Refusal].ok{};
}

# an immediate an odd number times a number of its bits, as ld3's `#-24, mul vl` three times imm4: the field operand's
# encoded number divided by the multiplier its slices place
pub val MULTIPLE: field.Kind = field.Kind{name: "multiple", admit: multiple_admit, encode: multiple_encode, decode: multiple_decode, finish: nil, complete: nil, check: nil};

pub val NO_BYTEMASK: str = "value is not bytes each all ones or all zeros";

# the 8 bits of `v`, a bit per byte, each byte of `v` all ones or all zeros, none where one is neither
pub fun encode_bytemask(v: u64) opt[u64] {
    var code: u64 = 0;
    var i:    u64 = 0;
    for (i < 8) {
        val b: u64 = (v >> (i * 8)) & 0xFF;
        if (b == 0xFF) { code = code | (1::u64 << i); }
        or (b != 0)    { ret opt[u64].none{}; }
        i = i + 1;
    }
    ret opt[u64].some{code};
}

# the 64 bits whose byte i is all ones where bit i of `code` is set, AdvSIMDExpandImm's op 1 cmode 1110
pub fun decode_bytemask(code: u64) u64 {
    var v: u64 = 0;
    var i: u64 = 0;
    for (i < 8) {
        if (((code >> i) & 1) != 0) { v = v | (0xFF::u64 << (i * 8)); }
        i = i + 1;
    }
    ret v;
}

fun bytemask_code(enc: *field.Encoder, f: *field.Field, at: usize) res[u64, field.Refusal] {
    if (f.operand::u32 >= enc.count) { ret res[u64, field.Refusal].err{field.refusal(field.WRONG_KIND, f.operand, at)}; }
    val code: opt[u64] = encode_bytemask(enc.parts[f.operand].bits[field.NUMBER]);
    if (sel code.none) { ret res[u64, field.Refusal].err{field.refusal(NO_BYTEMASK, f.operand, at)}; }
    ret res[u64, field.Refusal].ok{code.some};
}

fun bytemask_admit(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val code: res[u64, field.Refusal] = bytemask_code(enc, f, 0);
    if (sel code.err) { ret err[field.Refusal].err{code.err}; }
    ret err[field.Refusal].ok{};
}

fun bytemask_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val code: res[u64, field.Refusal] = bytemask_code(enc, f, enc.out.len);
    if (sel code.err) { ret err[field.Refusal].err{code.err}; }
    ret put_number(enc, f, code.ok);
}

fun bytemask_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    val got: err[field.Refusal] = got_unit(dec, f);
    if (sel got.err) { ret got; }
    field.replace(dec, f.operand, field.NUMBER, decode_bytemask(dec.parts[f.operand].bits[field.NUMBER] & 0xFF));
    ret err[field.Refusal].ok{};
}

# movi's 64-bit immediate: the field operand's value, a byte per bit of the 8-bit immediate its slices place
pub val BYTEMASK: field.Kind = field.Kind{name: "bytemask", admit: bytemask_admit, encode: bytemask_encode, decode: bytemask_decode, finish: nil, complete: nil, check: nil};

pub val WIDE_GROUP: str = "move wide group past the register's width, or under another shift than its own";

# a move wide's hw, its two bits of shift
val HW_AT:   u64 = 21;
val HW_BITS: u64 = 3::u64 << 21;

# a movz's fixed bits, and the bit that makes it a movn
val MOVZ_MASK: u64 = 0x7F80_0000;
val MOVZ:      u64 = 0x5280_0000;
val MOVZ_BIT:  u64 = 1::u64 << 30;

# the bit that shifts an add's twelve bits by twelve
val HIGH_BIT: u64 = 1::u64 << 22;

# the bits of `f`'s operand slices over its fixed bits, as `field.pack` places them, without recording a fixup
fun composed(enc: *field.Encoder, f: *field.Field) u64 {
    var unit: u64 = f.fixed & f.mask;
    var i:    u32 = 0;
    for (i < f.slices.len) {
        val s:    *field.Slice = ?f.slices.at[i];
        var bits: u64          = (enc.parts[s.operand].bits[s.part] >> s.lo) & field.ones(s.len);
        if (s.invert) { bits = bits ^ field.ones(s.len); }
        unit = unit | (bits << s.at);
        i    = i + 1;
    }
    ret unit;
}

# word `unit` of `f` with the bits its symbolic operands' fixup kinds fix beyond their own field, as llvm-mc 23.1.1
# encodes them (AArch64MCCodeEmitter): a move wide group's hw, a movz of a signed group written as a movn (fixMOVZ), and
# the shift of an add's high twelve bits (getAddSubImmOpValue). a group past a w register's two halfwords, or under a
# shift the text states otherwise, is refused
fun implied(enc: *field.Encoder, f: *field.Field, unit: u64, at: usize) res[u64, field.Refusal] {
    var word: u64 = unit;
    var i:    u32 = 0;
    for (i < f.slices.len) {
        val op: u8           = f.slices.at[i].operand;
        val p:  *field.Parts = ?enc.parts[op];
        i = i + 1;
        if (!p.symbolic)                 { cnt; }
        if (aarch64_fixup.high(p.fixup)) { word = word | HIGH_BIT; }
        val g: opt[*aarch64_fixup.Group] = aarch64_fixup.group_of(p.fixup);
        if (sel g.none) { cnt; }
        val hw:     u64 = g.some.hw::u64;
        val stated: u64 = (word & HW_BITS) >> HW_AT;
        if ((hw > 1 && (word >> 31) == 0) || (stated != 0 && stated != hw)) { ret res[u64, field.Refusal].err{field.refusal(WIDE_GROUP, op, at)}; }
        word = (word & ~HW_BITS) | (hw << HW_AT);
        if (g.some.signed && (f.fixed & MOVZ_MASK) == MOVZ) { word = word & ~MOVZ_BIT; }
    }
    ret res[u64, field.Refusal].ok{word};
}

fun word_admit(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val word: res[u64, field.Refusal] = implied(enc, f, composed(enc, f), 0);
    if (sel word.err) { ret err[field.Refusal].err{word.err}; }
    ret err[field.Refusal].ok{};
}

fun word_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    val unit: res[u64, field.Refusal] = field.pack(enc, f);
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    val word: res[u64, field.Refusal] = implied(enc, f, unit.ok, enc.out.len);
    if (sel word.err) { ret err[field.Refusal].err{word.err}; }
    ret field.put(enc, word.ok, f.width / 8);
}

fun word_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    val at:   usize                   = dec.at;
    val unit: res[u64, field.Refusal] = field.get(dec, f.width / 8);
    if (sel unit.err) { ret err[field.Refusal].err{unit.err}; }
    ret field.unpack(dec, f, unit.ok, at);
}

# the core's unit, its fixed bits and slices, with the bits a symbol's fixup kind fixes beyond its field, which decode
# reads back as the slices they are
pub val WORD: field.Kind = field.Kind{name: "unit", admit: word_admit, encode: word_encode, decode: word_decode, finish: nil, complete: nil, check: nil};

val KINDS: [5]*field.Kind = [5]*field.Kind{?WORD, ?BITMASK, ?FLOAT8, ?MULTIPLE, ?BYTEMASK};

# the aarch64 field table, its units little-endian
pub val TABLE: field.Table = field.Table{kinds: ?KINDS[0], count: 5, order: field.LITTLE};

# the value a bitmask field's operand holds: the register's bits for a64, the element's for sve
pub val BITMASK_32: operand.Immediate = operand.Immediate{bits: 32, sign: operand.UNSIGNED, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS};
pub val BITMASK_64: operand.Immediate = operand.Immediate{bits: 64, sign: operand.UNSIGNED, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS};
pub val BITMASK_8:  operand.Immediate = operand.Immediate{bits: 8, sign: operand.UNSIGNED, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS};
pub val BITMASK_16: operand.Immediate = operand.Immediate{bits: 16, sign: operand.UNSIGNED, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS};

