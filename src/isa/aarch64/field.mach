# ADD and SUB (immediate)'s sh, left out for no shift
pub val SHIFT12_MEMBERS: [2]operand.Enumerant = [2]operand.Enumerant{operand.Enumerant{name: "", value: 0}, operand.Enumerant{name: "lsl #12", value: 1}};
pub val SHIFT12_NAMES:   [2]index.Entry       = [2]index.Entry{index.Entry{key: "", row: 0}, index.Entry{key: "lsl #12", row: 1}};

# MOVZ, MOVN and MOVK's hw, left out for no shift, of which a 32-bit register takes the first two
pub val HW_MEMBERS: [4]operand.Enumerant = [4]operand.Enumerant{operand.Enumerant{name: "", value: 0}, operand.Enumerant{name: "lsl #16", value: 1}, operand.Enumerant{name: "lsl #32", value: 2}, operand.Enumerant{name: "lsl #48", value: 3}};
pub val HW_NAMES:   [4]index.Entry       = [4]index.Entry{index.Entry{key: "", row: 0}, index.Entry{key: "lsl #16", row: 1}, index.Entry{key: "lsl #32", row: 2}, index.Entry{key: "lsl #48", row: 3}};

# the sve element size specifiers, each the size field's value: the element's bytes as a power of two
pub val SIZE_MEMBERS: [4]operand.Enumerant = [4]operand.Enumerant{operand.Enumerant{name: "b", value: 0}, operand.Enumerant{name: "h", value: 1}, operand.Enumerant{name: "s", value: 2}, operand.Enumerant{name: "d", value: 3}};
pub val SIZE_NAMES:   [4]index.Entry       = [4]index.Entry{index.Entry{key: "b", row: 0}, index.Entry{key: "d", row: 3}, index.Entry{key: "h", row: 1}, index.Entry{key: "s", row: 2}};

# the direction of an sme tile slice: a horizontal slice is a row of the tile, a vertical one a column
pub val DIRECTION_MEMBERS: [2]operand.Enumerant = [2]operand.Enumerant{operand.Enumerant{name: "h", value: 0}, operand.Enumerant{name: "v", value: 1}};
pub val DIRECTION_NAMES:   [2]index.Entry       = [2]index.Entry{index.Entry{key: "h", row: 0}, index.Entry{key: "v", row: 1}};

val COND_PIECES:      [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 4, at: 12}};
val COND_LOW_PIECES:  [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 4, at: 0}};
val SHIFT_PIECES:     [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 2, at: 22}};
val EXTEND_PIECES:    [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 3, at: 13}};
val SH_PIECES:        [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 1, at: 22}};
val HW_PIECES:        [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 2, at: 21}};
val SIZE_PIECES:      [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 2, at: 22}};
val DIRECTION_PIECES: [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 1, at: 15}};

# CSEL, CSINC, CSINV, CSNEG, CCMP and CCMN, cond
pub val COND: layout.Choice = layout.Choice{name: "cond", unit: 32, pieces: layout.Pieces{at: ?COND_PIECES[0], len: 1}, values: operand.Enumeration{members: ?CONDITION_MEMBERS[0], count: 18, mask: false, names: index.Index{at: ?CONDITION_NAMES[0], len: 18}}};
# B.cond and BC.cond, cond
pub val COND_BRANCH: layout.Choice = layout.Choice{name: "cond_branch", unit: 32, pieces: layout.Pieces{at: ?COND_LOW_PIECES[0], len: 1}, values: operand.Enumeration{members: ?CONDITION_MEMBERS[0], count: 18, mask: false, names: index.Index{at: ?CONDITION_NAMES[0], len: 18}}};
# the logical (shifted register) instructions' shift
pub val SHIFT: layout.Choice = layout.Choice{name: "shift", unit: 32, pieces: layout.Pieces{at: ?SHIFT_PIECES[0], len: 1}, values: operand.Enumeration{members: ?SHIFT_MEMBERS[0], count: 4, mask: false, names: index.Index{at: ?SHIFT_NAMES[0], len: 4}}};
# ADD and SUB (shifted register)'s shift, which reserves ror's value
pub val ARITHMETIC_SHIFT: layout.Choice = layout.Choice{name: "arithmetic_shift", unit: 32, pieces: layout.Pieces{at: ?SHIFT_PIECES[0], len: 1}, values: operand.Enumeration{members: ?SHIFT_MEMBERS[0], count: 3, mask: false, names: index.Index{at: ?ARITHMETIC_NAMES[0], len: 3}}};
# ADD and SUB (extended register), option
pub val EXTEND: layout.Choice = layout.Choice{name: "extend", unit: 32, pieces: layout.Pieces{at: ?EXTEND_PIECES[0], len: 1}, values: operand.Enumeration{members: ?EXTEND_MEMBERS[0], count: 8, mask: false, names: index.Index{at: ?EXTEND_NAMES[0], len: 8}}};
# ADD and SUB (immediate), sh
pub val SHIFT12: layout.Choice = layout.Choice{name: "shift12", unit: 32, pieces: layout.Pieces{at: ?SH_PIECES[0], len: 1}, values: operand.Enumeration{members: ?SHIFT12_MEMBERS[0], count: 2, mask: false, names: index.Index{at: ?SHIFT12_NAMES[0], len: 2}}};
# MOVZ, MOVN and MOVK of a 32-bit register, hw
pub val HW32: layout.Choice = layout.Choice{name: "hw32", unit: 32, pieces: layout.Pieces{at: ?HW_PIECES[0], len: 1}, values: operand.Enumeration{members: ?HW_MEMBERS[0], count: 2, mask: false, names: index.Index{at: ?HW_NAMES[0], len: 2}}};
# MOVZ, MOVN and MOVK of a 64-bit register, hw
pub val HW64: layout.Choice = layout.Choice{name: "hw64", unit: 32, pieces: layout.Pieces{at: ?HW_PIECES[0], len: 1}, values: operand.Enumeration{members: ?HW_MEMBERS[0], count: 4, mask: false, names: index.Index{at: ?HW_NAMES[0], len: 4}}};
# an sve instruction's size, the element size its z and p operands share
pub val SIZE: layout.Choice = layout.Choice{name: "size", unit: 32, pieces: layout.Pieces{at: ?SIZE_PIECES[0], len: 1}, values: operand.Enumeration{members: ?SIZE_MEMBERS[0], count: 4, mask: false, names: index.Index{at: ?SIZE_NAMES[0], len: 4}}};
# MOVA's V, the direction of its tile slice
pub val DIRECTION: layout.Choice = layout.Choice{name: "direction", unit: 32, pieces: layout.Pieces{at: ?DIRECTION_PIECES[0], len: 1}, values: operand.Enumeration{members: ?DIRECTION_MEMBERS[0], count: 2, mask: false, names: index.Index{at: ?DIRECTION_NAMES[0], len: 2}}};

# the element width of a z or p register operand whose element size the enumerant operand `size` names, a
# SIZE value: 8 bits shifted by it
pub fun sized(size: u8) operand.Element {
    ret operand.Element.chosen{operand.Chosen{operand: size, scale: 0}};
}

# Rd, Rt, Zd, Zt and Vd
pub val RD: layout.Position = layout.Position{name: "rd", unit: 32, first: 0, count: 0, at: 0, len: 5, excluded: operand.NO_NUMBERS, group: 0};
# Rn, Zn and Vn
pub val RN: layout.Position = layout.Position{name: "rn", unit: 32, first: 0, count: 0, at: 5, len: 5, excluded: operand.NO_NUMBERS, group: 0};
# Rt2, Ra and Rs of the three-source and pair forms
pub val RA: layout.Position = layout.Position{name: "ra", unit: 32, first: 0, count: 0, at: 10, len: 5, excluded: operand.NO_NUMBERS, group: 0};
# Rm, Rs, Zm and Vm
pub val RM: layout.Position = layout.Position{name: "rm", unit: 32, first: 0, count: 0, at: 16, len: 5, excluded: operand.NO_NUMBERS, group: 0};
# an sve governing predicate of p0 to p7, Pg
pub val PG: layout.Position = layout.Position{name: "pg", unit: 32, first: 0, count: 8, at: 10, len: 3, excluded: operand.NO_NUMBERS, group: 0};
# an sve governing predicate of p0 to p15, Pg
pub val PG4: layout.Position = layout.Position{name: "pg4", unit: 32, first: 0, count: 0, at: 10, len: 4, excluded: operand.NO_NUMBERS, group: 0};
# an sve predicate destination, Pd
pub val PD: layout.Position = layout.Position{name: "pd", unit: 32, first: 0, count: 0, at: 0, len: 4, excluded: operand.NO_NUMBERS, group: 0};
# an sve predicate source, Pn
pub val PN: layout.Position = layout.Position{name: "pn", unit: 32, first: 0, count: 0, at: 5, len: 4, excluded: operand.NO_NUMBERS, group: 0};
# an sve predicate source, Pm
pub val PM: layout.Position = layout.Position{name: "pm", unit: 32, first: 0, count: 0, at: 16, len: 4, excluded: operand.NO_NUMBERS, group: 0};
# an sme tile slice's index register of w12 to w15, Rs and Rv
pub val SLICE_W12: layout.Position = layout.Position{name: "slice_w12", unit: 32, first: 12, count: 4, at: 13, len: 2, excluded: operand.NO_NUMBERS, group: 0};
# an sme2 za array vector's index register of w8 to w11, Rv
pub val SLICE_W8: layout.Position = layout.Position{name: "slice_w8", unit: 32, first: 8, count: 4, at: 13, len: 2, excluded: operand.NO_NUMBERS, group: 0};

# an advanced simd arrangement specifier: how many elements of what width a v register operand holds
# ---
# name:    the specifier, as `8b`
# element: the bits of each element
# lanes:   how many elements, 0 for an element specifier with no count, as an indexed element's `s`
# coded:   whether Q and size encode it, as they do the eight whole-register arrangements
# q:       Q, 1 for the 128-bit register and 0 for its low 64 bits
# size:    size, the element's bytes as a power of two
pub rec Arrangement {
    name:    str;
    element: u16;
    lanes:   u8;
    coded:   bool;
    q:       u8;
    size:    u8;
}

# the arrangements: the eight Q and size encode, the dot products' `4b` and `2h` groups of an indexed element, the
# polynomial multiply's `1q`, and the element specifiers of an indexed element or a scalar
pub val ARRANGEMENTS: [16]Arrangement = [16]Arrangement{
    Arrangement{name: "8b", element: 8, lanes: 8, coded: true, q: 0, size: 0},
    Arrangement{name: "16b", element: 8, lanes: 16, coded: true, q: 1, size: 0},
    Arrangement{name: "4h", element: 16, lanes: 4, coded: true, q: 0, size: 1},
    Arrangement{name: "8h", element: 16, lanes: 8, coded: true, q: 1, size: 1},
    Arrangement{name: "2s", element: 32, lanes: 2, coded: true, q: 0, size: 2},
    Arrangement{name: "4s", element: 32, lanes: 4, coded: true, q: 1, size: 2},
    Arrangement{name: "1d", element: 64, lanes: 1, coded: true, q: 0, size: 3},
    Arrangement{name: "2d", element: 64, lanes: 2, coded: true, q: 1, size: 3},
    Arrangement{name: "4b", element: 8, lanes: 4, coded: false, q: 0, size: 0},
    Arrangement{name: "2h", element: 16, lanes: 2, coded: false, q: 0, size: 1},
    Arrangement{name: "1q", element: 128, lanes: 1, coded: false, q: 0, size: 4},
    Arrangement{name: "b", element: 8, lanes: 0, coded: false, q: 0, size: 0},
    Arrangement{name: "h", element: 16, lanes: 0, coded: false, q: 0, size: 1},
    Arrangement{name: "s", element: 32, lanes: 0, coded: false, q: 0, size: 2},
    Arrangement{name: "d", element: 64, lanes: 0, coded: false, q: 0, size: 3},
    Arrangement{name: "q", element: 128, lanes: 0, coded: false, q: 0, size: 4},
};

pub val ARRANGEMENT_COUNT: u32 = 16;

# the arrangements by specifier
pub val ARRANGEMENT_NAMES: [16]index.Entry = [16]index.Entry{
    index.Entry{key: "16b", row: 1},
    index.Entry{key: "1d", row: 6},
    index.Entry{key: "1q", row: 10},
    index.Entry{key: "2d", row: 7},
    index.Entry{key: "2h", row: 9},
    index.Entry{key: "2s", row: 4},
    index.Entry{key: "4b", row: 8},
    index.Entry{key: "4h", row: 2},
    index.Entry{key: "4s", row: 5},
    index.Entry{key: "8b", row: 0},
    index.Entry{key: "8h", row: 3},
    index.Entry{key: "b", row: 11},
    index.Entry{key: "d", row: 14},
    index.Entry{key: "h", row: 12},
    index.Entry{key: "q", row: 15},
    index.Entry{key: "s", row: 13},
};

pub val ARRANGEMENT_INDEX: index.Index = index.Index{at: ?ARRANGEMENT_NAMES[0], len: ARRANGEMENT_COUNT};

# the arrangement `spelling` names, ignoring case
pub fun arrangement(spelling: str) opt[*Arrangement] {
    val found: opt[u32] = index.find_view(?ARRANGEMENT_INDEX, view(spelling, str_len(spelling)), true);
    if (sel found.none) { ret opt[*Arrangement].none{}; }
    ret opt[*Arrangement].some{?ARRANGEMENTS[found.some]};
}

# the element width a register operand of arrangement `a` holds, which the rules over element widths read
pub fun element(a: *Arrangement) operand.Element {
    ret operand.Element.fixed{a.element};
}

# where Q and size lie, the bits a row of a coded arrangement fixes
pub val ARRANGEMENT_MASK: u64 = (1::u64 << 30) | (3::u64 << 22);

# the bits Q and size hold for a coded arrangement, under ARRANGEMENT_MASK
pub fun arrangement_bits(a: *Arrangement) u64 {
    ret (a.q::u64 << 30) | (a.size::u64 << 22);
}

# an sme tile slice's tile and offset, which share the four bits of ZAd:imm or ZAn:imm: the tile takes as many
# high bits as the element's bytes have a power of two, so za0.b has one tile and sixteen offsets and the
# quadword tiles za0.q to za15.q none
# ---
# tile:   the tile's number among the tiles of its element size
# offset: the slice's offset from the index register
pub rec TileSlice {
    tile:   layout.Position;
    offset: layout.Layout;
}

val OFFSET4_LOW:  [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 4, at: 0}};
val OFFSET3_LOW:  [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 3, at: 0}};
val OFFSET2_LOW:  [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 2, at: 0}};
val OFFSET1_LOW:  [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 1, at: 0}};
val OFFSET4_HIGH: [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 4, at: 5}};
val OFFSET3_HIGH: [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 3, at: 5}};
val OFFSET2_HIGH: [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 2, at: 5}};
val OFFSET1_HIGH: [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 0, len: 1, at: 5}};

# the tile slices whose ZAd:imm or ZAt:imm lies in bits 3 to 0, as MOVA (vector to tile) and LD1B (scalar plus
# scalar, tile slice), by the element's bytes as a power of two
pub val TILE_SLICES_LOW: [5]TileSlice = [5]TileSlice{
    TileSlice{tile: layout.Position{name: "zab", unit: 32, first: 0, count: 1, at: 4, len: 0, excluded: operand.NO_NUMBERS, group: 0}, offset: layout.Layout{name: "offset_b", unit: 32, pieces: layout.Pieces{at: ?OFFSET4_LOW[0], len: 1}, value: operand.Immediate{bits: 4, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}},
    TileSlice{tile: layout.Position{name: "zah", unit: 32, first: 0, count: 2, at: 3, len: 1, excluded: operand.NO_NUMBERS, group: 0}, offset: layout.Layout{name: "offset_h", unit: 32, pieces: layout.Pieces{at: ?OFFSET3_LOW[0], len: 1}, value: operand.Immediate{bits: 3, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}},
    TileSlice{tile: layout.Position{name: "zas", unit: 32, first: 0, count: 4, at: 2, len: 2, excluded: operand.NO_NUMBERS, group: 0}, offset: layout.Layout{name: "offset_s", unit: 32, pieces: layout.Pieces{at: ?OFFSET2_LOW[0], len: 1}, value: operand.Immediate{bits: 2, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}},
    TileSlice{tile: layout.Position{name: "zad", unit: 32, first: 0, count: 8, at: 1, len: 3, excluded: operand.NO_NUMBERS, group: 0}, offset: layout.Layout{name: "offset_d", unit: 32, pieces: layout.Pieces{at: ?OFFSET1_LOW[0], len: 1}, value: operand.Immediate{bits: 1, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}},
    TileSlice{tile: layout.Position{name: "zaq", unit: 32, first: 0, count: 16, at: 0, len: 4, excluded: operand.NO_NUMBERS, group: 0}, offset: layout.Layout{name: "offset_q", unit: 32, pieces: layout.NO_PIECES, value: operand.Immediate{bits: 0, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}},
};

# the tile slices whose ZAn:imm lies in bits 8 to 5, as MOVA (tile to vector)
pub val TILE_SLICES_HIGH: [5]TileSlice = [5]TileSlice{
    TileSlice{tile: layout.Position{name: "zab", unit: 32, first: 0, count: 1, at: 9, len: 0, excluded: operand.NO_NUMBERS, group: 0}, offset: layout.Layout{name: "offset_b", unit: 32, pieces: layout.Pieces{at: ?OFFSET4_HIGH[0], len: 1}, value: operand.Immediate{bits: 4, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}},
    TileSlice{tile: layout.Position{name: "zah", unit: 32, first: 0, count: 2, at: 8, len: 1, excluded: operand.NO_NUMBERS, group: 0}, offset: layout.Layout{name: "offset_h", unit: 32, pieces: layout.Pieces{at: ?OFFSET3_HIGH[0], len: 1}, value: operand.Immediate{bits: 3, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}},
    TileSlice{tile: layout.Position{name: "zas", unit: 32, first: 0, count: 4, at: 7, len: 2, excluded: operand.NO_NUMBERS, group: 0}, offset: layout.Layout{name: "offset_s", unit: 32, pieces: layout.Pieces{at: ?OFFSET2_HIGH[0], len: 1}, value: operand.Immediate{bits: 2, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}},
    TileSlice{tile: layout.Position{name: "zad", unit: 32, first: 0, count: 8, at: 6, len: 3, excluded: operand.NO_NUMBERS, group: 0}, offset: layout.Layout{name: "offset_d", unit: 32, pieces: layout.Pieces{at: ?OFFSET1_HIGH[0], len: 1}, value: operand.Immediate{bits: 1, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}},
    TileSlice{tile: layout.Position{name: "zaq", unit: 32, first: 0, count: 16, at: 5, len: 4, excluded: operand.NO_NUMBERS, group: 0}, offset: layout.Layout{name: "offset_q", unit: 32, pieces: layout.NO_PIECES, value: operand.Immediate{bits: 0, signed: false, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}},
};

#[testing]
val T_EFFECT: effect.Effect = effect.Effect{
    implicit: effect.Registers.ruled{effect.Ruled{otherwise: effect.NO_TOUCHED, rules: effect.NO_REGISTER_RULES, may: effect.NO_TOUCHED, must: effect.NO_TOUCHED}},
    flags:    effect.Flags{read: effect.NO_WORDS, written: effect.NO_WORDS, undefined: effect.NO_WORDS, kept: effect.NO_WORDS},
    memory:   effect.NO_ACCESSES,
    control:  effect.Control{transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, operand: field.NO_OPERAND, rules: effect.NO_RULES},
    stack:    effect.Stack.none{},
    latency:  effect.ONE,
    fixed:    effect.NO_FIXEDS,
};

# a test's selection, its register view, its output buffers and the last refusal's message
#[testing]
rec T {
    t:       testing.Testing;
    s:       extension.Selection;
    v:       register.Available;
    ctx:     state.Context;
    out:     vector.Vector[u8];
    fixups:  vector.Vector[field.Fixup];
    refused: str;
}

#[testing]
fun t_make(t: *T) bool {
    testing.make(?t.t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t.t), ?aarch64.CATALOG, "armv8-a", diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    val opened: res[state.Context, state.Opened] = state.open(testing.allocator_of(?t.t), nil, ?t.s, ?aarch64.AXES, state.initial(?aarch64.AXES), ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx     = opened.ok;
    t.out     = vector.init[u8](testing.allocator_of(?t.t));
    t.fixups  = vector.init[field.Fixup](testing.allocator_of(?t.t));
    t.refused = "";
    ret true;
}

# `value` encoded by a one-operand row of field kind `kind` over immediate `imm`, fixing `fixed` under `mask`, its
# operand sliced by `pieces`, and decoded back
# ---
# ret: 0 when it encodes as the word `want` and decodes to `value`, 1 when refused, with the refusal's message kept
#[testing]
fun t_word(t: *T, imm: operand.Immediate, kind: u16, pieces: layout.Pieces, fixed: u64, mask: u64, param: u64, value: i64, want: u32) u32 {
    var operands: [1]operand.Operand = [1]operand.Operand{operand.Operand{shape: operand.Shape.immediate{imm}, role: operand.READ, width: 64, quantity: operand.ONE}};
    var slices:   [4]field.Slice;
    val count:    u32                = layout.slices(pieces, 0, field.NUMBER, ?slices[0]);
    var fields:   [1]field.Field     = [1]field.Field{field.Field{kind: kind, width: 32, fixed: fixed, mask: mask, slices: field.Slices{at: ?slices[0], len: count}, operand: 0, param: param}};
    var rows:     [1]row.Row         = [1]row.Row{row.Row{key: "t", mnemonic: "t", operands: row.Operands{at: ?operands[0], len: 1}, encoding: field.Fields{at: ?fields[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?T_EFFECT, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0}};
    val codec:    dispatch.Codec     = dispatch.Codec{fields: ?TABLE, registers: nil, rows: row.Rows{at: ?rows[0], len: 1}, keys: index.NO_ENTRIES, dispatch: nil};
    var values:   [1]operand.Value   = [1]operand.Value{operand.Value.immediate{value}};
    var ins:      inst.Inst          = inst.Inst{row: ?rows[0], values: ?values[0], count: 1};
    t.out.len = 0;
    val wrote: res[usize, field.Refusal] = walk.encode(?codec, ?t.ctx, ?ins, ?t.out, ?t.fixups);
    if (sel wrote.err) {
        t.refused = wrote.err.message;
        ret 1;
    }
    if (t.out.len != 4) { ret 2; }
    val word: u32 = t.out.data[0]::u32 | (t.out.data[1]::u32 << 8) | (t.out.data[2]::u32 << 16) | (t.out.data[3]::u32 << 24);
    if (word != want) { ret 3; }
    var store: [4]operand.Value;
    val back:  res[walk.Decoded, field.Refusal] = walk.decode_row(?codec, ?t.ctx, ?rows[0], t.out.data, 4, 0, ?store[0], 4);
    if (sel back.err) { ret 4; }
    val got: operand.Value = back.ok.inst.values[0];
    if (!(sel got.immediate && got.immediate == value)) { ret 5; }
    ret 0;
}

#[testing]
val T_NO_PIECES: layout.Pieces = layout.NO_PIECES;

# the a64 logical immediate's 13 bits at 22 to 10, and sve's at 17 to 5
#[testing]
val T_A64: u64 = 0xFF80_03FF;
#[testing]
val T_SVE: u64 = 0xFFFC_001F;

# and x0, x1, #0x5555555555555555; orr w2, w3, #0xff00ff00; and x6, x7, #0x8000000000000001; and z0.h, z0.h, #0x3c;
# and z1.b, z1.b, #0x81, as llvm-mc encodes them
test bitmask__a_bitmask_immediate_encodes_and_decodes {
    var t: T;
    if (!t_make(?t))                                                                                                                                         { ret 1; }
    if (t_word(?t, BITMASK_64, BITMASK_KIND, T_NO_PIECES, 0x9200_0020, T_A64, bitmask_param(64, 64, 10), 0x5555_5555_5555_5555, 0x9200_F020) != 0)           { ret 2; }
    if (t_word(?t, BITMASK_32, BITMASK_KIND, T_NO_PIECES, 0x3200_0062, T_A64, bitmask_param(32, 32, 10), 0xFF00_FF00, 0x3208_9C62) != 0)                     { ret 3; }
    if (t_word(?t, BITMASK_64, BITMASK_KIND, T_NO_PIECES, 0x9200_00E6, T_A64, bitmask_param(64, 64, 10), 0x8000_0000_0000_0001::u64:~i64, 0x9241_04E6) != 0) { ret 4; }
    if (t_word(?t, BITMASK_16, BITMASK_KIND, T_NO_PIECES, 0x0580_0000, T_SVE, bitmask_param(16, 64, 5), 0x3C, 0x0580_7460) != 0)                             { ret 5; }
    if (t_word(?t, BITMASK_8, BITMASK_KIND, T_NO_PIECES, 0x0580_0001, T_SVE, bitmask_param(8, 64, 5), 0x81, 0x0580_0E21) != 0)                               { ret 6; }
    ret 0;
}

test bitmask__a_value_with_no_bitmask_encoding_is_refused {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val values: [3]i64 = [3]i64{0, -1, 5};
    var i:      u32    = 0;
    for (i < 3) {
        if (t_word(?t, BITMASK_64, BITMASK_KIND, T_NO_PIECES, 0x9200_0020, T_A64, bitmask_param(64, 64, 10), values[i], 0) != 1 || t.refused != NO_BITMASK) { ret 2; }
        i = i + 1;
    }
    if (t_word(?t, BITMASK_32, BITMASK_KIND, T_NO_PIECES, 0x1200_0020, T_A64, bitmask_param(32, 32, 10), 0xFFFF_FFFF, 0) != 1 || t.refused != NO_BITMASK) { ret 3; }
    val wide:  opt[u64] = decode_bitmask(0x1000, 32);
    val whole: opt[u64] = decode_bitmask(0x003F, 64);
    if (sel wide.some || sel whole.some) { ret 4; }
    ret 0;
}

# ldr x0, [x1, #32760] and ldp x8, x9, [x10, #-512] as llvm-mc encodes them, and offsets off their scale
test offset__a_scaled_offset_refuses_a_misaligned_value {
    var t: T;
    if (!t_make(?t))                                                                                                                  { ret 1; }
    if (t_word(?t, UOFF8.value, UNIT_KIND, UOFF8.pieces, 0xF940_0020, 0xFFC0_03FF, 0, 32760, 0xF97F_FC20) != 0)                       { ret 2; }
    if (t_word(?t, UOFF8.value, UNIT_KIND, UOFF8.pieces, 0xF940_0020, 0xFFC0_03FF, 0, 12, 0) != 1 || t.refused != field.MISALIGNED)   { ret 3; }
    if (t_word(?t, PAIR8.value, UNIT_KIND, PAIR8.pieces, 0xA940_2548, 0xFFC0_7FFF, 0, -512, 0xA960_2548) != 0)                        { ret 4; }
    if (t_word(?t, PAIR8.value, UNIT_KIND, PAIR8.pieces, 0xA940_2548, 0xFFC0_7FFF, 0, -500, 0) != 1 || t.refused != field.MISALIGNED) { ret 5; }
    ret 0;
}

# add v0.8h, v1.8h, v2.8h and add v0.2d, v1.2d, v2.2d as llvm-mc encodes them
test arrangement__an_arrangement_fixes_the_element_size {
    val words: [2]u32 = [2]u32{0x4E62_8420, 0x4EE2_8420};
    val names: [2]str = [2]str{"8h", "2D"};
    val bits:  [2]u16 = [2]u16{16, 64};
    var i:     u32    = 0;
    for (i < 2) {
        val found: opt[*Arrangement] = arrangement(names[i]);
        if (sel found.none) { ret 1; }
        val e: operand.Element = element(found.some);
        if (!(sel e.fixed && e.fixed == bits[i]))                                                    { ret 2; }
        if (!found.some.coded || (words[i]::u64 & ARRANGEMENT_MASK) != arrangement_bits(found.some)) { ret 3; }
        i = i + 1;
    }
    val dot: opt[*Arrangement] = arrangement("4b");
    if (sel dot.none)                                                   { ret 4; }
    if (dot.some.element != 8 || dot.some.lanes != 4 || dot.some.coded) { ret 5; }
    val none: opt[*Arrangement] = arrangement("3s");
    if (sel none.some) { ret 6; }
    ret 0;
}

# mov z0.s, p1/m, za3v.s[w13, 2] as llvm-mc encodes it: za3 and offset 2 share ZAn:imm, w13 is 1 past w12
test tile_slice__the_tile_and_offset_share_four_bits {
    val s:    *TileSlice = ?TILE_SLICES_HIGH[2];
    val word: u64        = 0xC082_0000 | (3::u64 << s.tile.at) | (2::u64 << s.offset.pieces.at[0].at) | (1::u64 << DIRECTION.pieces.at[0].at) | ((13 - SLICE_W12.first)::u64 << SLICE_W12.at) | (1::u64 << PG.at);
    if (word != 0xC082_A5C0 || s.tile.len + s.offset.value.bits != 4) { ret 1; }
    ret 0;
}
