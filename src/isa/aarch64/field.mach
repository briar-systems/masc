val BRANCH19_PIECES: [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 2, len: 19, at: 5}};
val BRANCH14_PIECES: [1]layout.Piece = [1]layout.Piece{layout.Piece{lo: 2, len: 14, at: 5}};
val ADR_PIECES:      [2]layout.Piece = [2]layout.Piece{layout.Piece{lo: 0, len: 2, at: 29}, layout.Piece{lo: 2, len: 19, at: 5}};
val ADRP_PIECES:     [2]layout.Piece = [2]layout.Piece{layout.Piece{lo: 12, len: 2, at: 29}, layout.Piece{lo: 14, len: 19, at: 5}};
