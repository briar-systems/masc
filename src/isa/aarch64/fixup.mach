# the aarch64 fixup kinds and their binding to mink's relocation kinds
#
# a row's symbolic operand takes one of these kinds by default, as the aarch64
# overlay's fixups topic states it per operand rule (gen/data/aarch64/fixups.txt),
# and a specifier gives it another: `:lo12:` the low twelve bits an add or a
# load or store of each access size takes, `:got:` the page of the symbol's got
# entry and `:got_lo12:` its low bits. each kind is bound to the neutral or
# aarch64 relocation kind it becomes, so the relocation numbers stay mink's
# (ELF for the Arm 64-bit Architecture, aaelf64, "Static AArch64 relocations"),
# and the data a builder relocates take the absolute and pc-relative kinds of
# their width.

use std.types.bool.bool;

use aarch64_kinds: mink.format.elf.reloc.aarch64.kinds;
use mink.model.reloc;

use masc.core.fixup;
use masc.core.operand;

pub val JUMP26:           operand.FixupKind = 1;
pub val CALL26:           operand.FixupKind = 2;
pub val CONDBR19:         operand.FixupKind = 3;
pub val TSTBR14:          operand.FixupKind = 4;
pub val LD_PREL_LO19:     operand.FixupKind = 5;
pub val ADR_PREL_LO21:    operand.FixupKind = 6;
pub val ADR_PREL_PG_HI21: operand.FixupKind = 7;
pub val ADD_ABS_LO12_NC:  operand.FixupKind = 8;
pub val LDST8_LO12_NC:    operand.FixupKind = 9;
pub val LDST16_LO12_NC:   operand.FixupKind = 10;
pub val LDST32_LO12_NC:   operand.FixupKind = 11;
pub val LDST64_LO12_NC:   operand.FixupKind = 12;
pub val LDST128_LO12_NC:  operand.FixupKind = 13;
pub val ADR_GOT_PAGE:     operand.FixupKind = 14;
pub val LD64_GOT_LO12_NC: operand.FixupKind = 15;
pub val ABS16:            operand.FixupKind = 16;
pub val ABS32:            operand.FixupKind = 17;
pub val ABS64:            operand.FixupKind = 18;
pub val PREL16:           operand.FixupKind = 19;
pub val PREL32:           operand.FixupKind = 20;
pub val PREL64:           operand.FixupKind = 21;

# how many fixup kinds there are, which BINDINGS binds
pub val COUNT: u32 = 21;

# each fixup kind and the relocation kind it becomes, in ascending order of kind
pub val BINDINGS: [COUNT]fixup.Binding = [COUNT]fixup.Binding{
    fixup.Binding{fixup: JUMP26, kind: ?aarch64_kinds.JUMP26, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: CALL26, kind: ?aarch64_kinds.CALL26, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: CONDBR19, kind: ?aarch64_kinds.BRANCH19, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TSTBR14, kind: ?aarch64_kinds.BRANCH14, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: LD_PREL_LO19, kind: ?aarch64_kinds.LD_PREL_LO19, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ADR_PREL_LO21, kind: ?aarch64_kinds.ADR_PREL_LO21, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ADR_PREL_PG_HI21, kind: ?aarch64_kinds.PAGE21, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ADD_ABS_LO12_NC, kind: ?aarch64_kinds.LO12_ADD, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: LDST8_LO12_NC, kind: ?aarch64_kinds.LO12_LDST8, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: LDST16_LO12_NC, kind: ?aarch64_kinds.LO12_LDST16, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: LDST32_LO12_NC, kind: ?aarch64_kinds.LO12_LDST32, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: LDST64_LO12_NC, kind: ?aarch64_kinds.LO12_LDST64, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: LDST128_LO12_NC, kind: ?aarch64_kinds.LO12_LDST128, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ADR_GOT_PAGE, kind: ?aarch64_kinds.GOT_PAGE21, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: LD64_GOT_LO12_NC, kind: ?aarch64_kinds.GOT_LO12, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ABS16, kind: ?reloc.ABS16, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ABS32, kind: ?reloc.ABS32, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: ABS64, kind: ?reloc.ABS64, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: PREL16, kind: ?reloc.PC16, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: PREL32, kind: ?reloc.PC32, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: PREL64, kind: ?reloc.PC64, arches: fixup.EVERY_ARCH},
};

# whether a symbol takes fixup kind `kind` by a specifier alone, as an add's and a load's or store's twelve bits take
# theirs by `:lo12:`, so a bare symbol there is refused as llvm-mc 23.1.1 refuses it, and a register name is never read
# as one, as `add x0, x1, x2`
pub fun specified(kind: operand.FixupKind) bool {
    ret kind >= ADD_ABS_LO12_NC && kind <= LDST128_LO12_NC;
}

# how many data fixups there are
pub val DATA_COUNT: u32 = 6;

# the data aaelf64 relocates: absolute and pc-relative halfwords, words and doublewords, R_AARCH64_ABS16 to ABS64 and
# R_AARCH64_PREL16 to PREL64
pub val DATA: [DATA_COUNT]fixup.Datum = [DATA_COUNT]fixup.Datum{
    fixup.Datum{basis: fixup.ABSOLUTE, width: 2, fixup: ABS16},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 4, fixup: ABS32},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 8, fixup: ABS64},
    fixup.Datum{basis: fixup.RELATIVE, width: 2, fixup: PREL16},
    fixup.Datum{basis: fixup.RELATIVE, width: 4, fixup: PREL32},
    fixup.Datum{basis: fixup.RELATIVE, width: 8, fixup: PREL64},
};
