# the aarch64 fixup kinds and their binding to mink's relocation kinds
#
# a row's symbolic operand takes one of these kinds by default, as the aarch64
# overlay's fixups topic states it per operand rule (gen/data/aarch64/fixups.txt),
# and a specifier gives it another: `:lo12:` the low twelve bits an add or a
# load or store of each access size takes, `:got:` the page of the symbol's got
# entry and `:got_lo12:` its low bits, and the thread-local specifiers the kinds
# of each tls model: tlsdesc's page, low bits and call, initial-exec's got entry
# page and low bits, and local-exec's tprel and local-dynamic's dtprel parts of
# an add, a load or store and a move wide. each kind is bound to the neutral or
# aarch64 relocation kind it becomes, so the relocation numbers stay mink's
# (ELF for the Arm 64-bit Architecture, aaelf64, "Static AArch64 relocations"
# and "Thread-local storage relocations"), and the data a builder relocates take
# the absolute and pc-relative kinds of their width. the kinds of fields aaelf64
# gives no relocation are local, written only as a distance the builder knows.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use aarch64_kinds: mink.format.elf.reloc.aarch64.kinds;
use elf_kinds:     mink.format.elf.reloc.kinds;
use mink.model.reloc;

use masc.core.fixup;
use masc.core.operand;

pub val JUMP26:                       operand.FixupKind = 1;
pub val CALL26:                       operand.FixupKind = 2;
