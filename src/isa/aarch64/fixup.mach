    fixup.Binding{fixup: TLSLD_LDST32_DTPREL_LO12, kind: ?aarch64_kinds.TLSLD_LDST32_DTPREL_LO12, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLD_LDST32_DTPREL_LO12_NC, kind: ?aarch64_kinds.TLSLD_LDST32_DTPREL_LO12_NC, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLD_LDST64_DTPREL_LO12, kind: ?aarch64_kinds.TLSLD_LDST64_DTPREL_LO12, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLD_LDST64_DTPREL_LO12_NC, kind: ?aarch64_kinds.TLSLD_LDST64_DTPREL_LO12_NC, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLD_LDST128_DTPREL_LO12, kind: ?aarch64_kinds.TLSLD_LDST128_DTPREL_LO12, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLD_LDST128_DTPREL_LO12_NC, kind: ?aarch64_kinds.TLSLD_LDST128_DTPREL_LO12_NC, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLD_MOVW_DTPREL_G2, kind: ?aarch64_kinds.TLSLD_MOVW_DTPREL_G2, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLD_MOVW_DTPREL_G1, kind: ?aarch64_kinds.TLSLD_MOVW_DTPREL_G1, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLD_MOVW_DTPREL_G1_NC, kind: ?aarch64_kinds.TLSLD_MOVW_DTPREL_G1_NC, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLD_MOVW_DTPREL_G0, kind: ?aarch64_kinds.TLSLD_MOVW_DTPREL_G0, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLD_MOVW_DTPREL_G0_NC, kind: ?aarch64_kinds.TLSLD_MOVW_DTPREL_G0_NC, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: MOVW_UABS_G0_NC, kind: ?aarch64_kinds.MOVW_UABS_G0_NC, arches: fixup.EVERY_ARCH},
};

# how many local fixup kinds there are
pub val LOCAL_COUNT: u32 = 2;

# the kinds aaelf64 gives no relocation, which llvm-mc 23.1.1 resolves to a label of the section and refuses otherwise:
# cb<cc>'s imm9 ("relocation of compare-and-branch instructions not supported") and autiasppc's imm16 ("relocation of
# PAC/AUT instructions is not supported")
pub val LOCALS: [LOCAL_COUNT]operand.FixupKind = [LOCAL_COUNT]operand.FixupKind{CMPBR9, PAUTH16};

# whether a symbol takes fixup kind `kind` by a specifier alone, as an add's and a load's or store's twelve bits take
# theirs by `:lo12:`, so a bare symbol there is refused as llvm-mc 23.1.1 refuses it, and a register name is never read
# as one, as `add x0, x1, x2`
pub fun specified(kind: operand.FixupKind) bool {
    ret (kind >= ADD_ABS_LO12_NC && kind <= LDST128_LO12_NC) || kind == MOVW_UABS_G0_NC;
}

# the group of a move wide's value a fixup kind of its sixteen bits takes, which fixes the instruction's bits beyond
# them as llvm-mc 23.1.1 encodes them: its hw the group's place, and for a signed group a movz written as a movn, which
# the linker turns back into a movz where the value is not negative (aaelf64, "Group relocations")
# ---
# fixup:  the fixup kind
# hw:     the halfword the group is, its value shifted left by 16 times it, as `:tprel_g1:` is 1
# signed: whether the group is checked as a signed value, so the linker chooses between movz and movn
pub rec Group {
    fixup:  operand.FixupKind;
    hw:     u8;
    signed: bool;
}

# how many groups there are
pub val GROUP_COUNT: u32 = 11;

# the groups, in ascending order of fixup kind: tprel's and dtprel's g2, g1 and g0 checked signed and their g1_nc and
# g0_nc not, and the absolute g0_nc a move wide's symbol takes by default
pub val GROUPS: [GROUP_COUNT]Group = [GROUP_COUNT]Group{
    Group{fixup: TLSLE_MOVW_TPREL_G2, hw: 2, signed: true},
    Group{fixup: TLSLE_MOVW_TPREL_G1, hw: 1, signed: true},
    Group{fixup: TLSLE_MOVW_TPREL_G1_NC, hw: 1, signed: false},
    Group{fixup: TLSLE_MOVW_TPREL_G0, hw: 0, signed: true},
    Group{fixup: TLSLE_MOVW_TPREL_G0_NC, hw: 0, signed: false},
    Group{fixup: TLSLD_MOVW_DTPREL_G2, hw: 2, signed: true},
    Group{fixup: TLSLD_MOVW_DTPREL_G1, hw: 1, signed: true},
    Group{fixup: TLSLD_MOVW_DTPREL_G1_NC, hw: 1, signed: false},
    Group{fixup: TLSLD_MOVW_DTPREL_G0, hw: 0, signed: true},
    Group{fixup: TLSLD_MOVW_DTPREL_G0_NC, hw: 0, signed: false},
    Group{fixup: MOVW_UABS_G0_NC, hw: 0, signed: false},
};

# the group fixup kind `kind` takes, none for a kind of no move wide
pub fun group_of(kind: operand.FixupKind) opt[*Group] {
    var i: u32 = 0;
    for (i < GROUP_COUNT) {
        if (GROUPS[i].fixup == kind) { ret opt[*Group].some{?GROUPS[i]}; }
        i = i + 1;
    }
    ret opt[*Group].none{};
}

# whether fixup kind `kind` of an add's twelve bits takes the high twelve of a value, `:tprel_hi12:` and
# `:dtprel_hi12:`, which shift the add's immediate by twelve as llvm-mc 23.1.1 encodes it (AArch64MCCodeEmitter,
# getAddSubImmOpValue)
pub fun high(kind: operand.FixupKind) bool {
    ret kind == TLSLE_ADD_TPREL_HI12 || kind == TLSLD_ADD_DTPREL_HI12;
}

# how many data fixups there are
pub val DATA_COUNT: u32 = 6;

# the data aaelf64 relocates: absolute and pc-relative halfwords, words and doublewords, R_AARCH64_ABS16 to ABS64 and
# R_AARCH64_PREL16 to PREL64
pub val DATA: [DATA_COUNT]fixup.Datum = [DATA_COUNT]fixup.Datum{
    fixup.Datum{basis: fixup.ABSOLUTE, width: 2, fixup: ABS16},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 4, fixup: ABS32},
    fixup.Datum{basis: fixup.ABSOLUTE, width: 8, fixup: ABS64},
    fixup.Datum{basis: fixup.RELATIVE, width: 2, fixup: PREL16},
    fixup.Datum{basis: fixup.RELATIVE, width: 4, fixup: PREL32},
    fixup.Datum{basis: fixup.RELATIVE, width: 8, fixup: PREL64},
};
