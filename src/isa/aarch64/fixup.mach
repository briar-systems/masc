    fixup.Binding{fixup: TLSDESC_ADR_PAGE21, kind: ?aarch64_kinds.TLSDESC_ADR_PAGE21, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSDESC_LD64_LO12, kind: ?aarch64_kinds.TLSDESC_LD64_LO12, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSDESC_ADD_LO12, kind: ?aarch64_kinds.TLSDESC_ADD_LO12, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSDESC_CALL, kind: ?elf_kinds.TLSDESC_CALL, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSIE_ADR_GOTTPREL_PAGE21, kind: ?aarch64_kinds.TLSIE_ADR_GOTTPREL_PAGE21, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSIE_LD64_GOTTPREL_LO12_NC, kind: ?aarch64_kinds.TLSIE_LD64_GOTTPREL_LO12_NC, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLE_ADD_TPREL_HI12, kind: ?aarch64_kinds.TLSLE_ADD_TPREL_HI12, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLE_ADD_TPREL_LO12, kind: ?aarch64_kinds.TLSLE_ADD_TPREL_LO12, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLE_ADD_TPREL_LO12_NC, kind: ?aarch64_kinds.TLSLE_ADD_TPREL_LO12_NC, arches: fixup.EVERY_ARCH},
    fixup.Binding{fixup: TLSLE_LDST8_TPREL_LO12, kind: ?aarch64_kinds.TLSLE_LDST8_TPREL_LO12, arches: fixup.EVERY_ARCH},
