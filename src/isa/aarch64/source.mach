# the aarch64 set's assembly source dialect
#
# its comments run from `//`, `;` ends a statement, `.align` takes a power of two, and its data directives are
# `.hword` two bytes, `.word` four and `.xword` and `.dword` eight, with the other widths below. its directives:
# `.arch` restates the selection by an architecture and its modifiers, `.cpu` by a processor and its modifiers, each a
# level of the catalog of that kind, `.arch_extension` adds an extension, or after `no` removes it with every extension
# that implies it, and `.inst` states instructions by their encodings, one after each comma, each a word of the four
# bytes every A64 instruction has. nothing states what such an encoding does, so its effect is the opaque one, which
# may read and write every register and memory and jump anywhere or fall through, and surely touches no register.
# `.tlsdesccall` marks the blr after it with R_AARCH64_TLSDESC_CALL naming its symbol (aaelf64, "Thread-local storage
# descriptors"). its mapping symbols are mink's, per format (`mink.format.pair.Mapping`).

use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use masc.core.constraint;
use masc.core.ct;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.operand;
use masc.core.quantity;
use masc.core.requirement;
use masc.core.row;
use masc.core.source;
use aarch64_field: masc.isa.aarch64.field;
use aarch64_fixup: masc.isa.aarch64.fixup;
use masc.isa.aarch64.gen_register;

val EVERY: effect.Set = effect.Set{words: ?gen_register.EVERY[0], len: gen_register.EVERY_WORDS};

# every register it may read and write: what an encoding does is unknown, so a reader takes every register as live into
# it and clobbered by it, and a write that may keep the old value is a read as well. it surely touches none
val TOUCHED: effect.Touched = effect.Touched{read: EVERY, written: EVERY};

val ANYWHERE: [1]effect.Access = [1]effect.Access{
    effect.Access{role: operand.READ_WRITE, operand: field.NO_OPERAND, base: effect.NO_ROW, forming: operand.NO_POSITIONS, width: effect.Width{element: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: effect.Count.unstated{}}, governor: field.NO_OPERAND},
};

# what an encoding no row states does: anything, its registers opaque, since no operand value decides them
pub val OPAQUE: effect.Effect = effect.Effect{
    implicit:  effect.Registers.opaque{effect.Opaque{may: TOUCHED, must: effect.NO_TOUCHED}},
    flags:     effect.Flags{read: effect.NO_WORDS, written: effect.NO_WORDS, undefined: effect.NO_WORDS, kept: effect.NO_WORDS},
    memory:    effect.Accesses{at: ?ANYWHERE[0], len: 1},
    control:   effect.Control{transfer: effect.JUMP, target: effect.INDIRECT, conditional: true, operand: field.NO_OPERAND, rules: effect.NO_RULES},
    stack:     effect.Stack.opaque{},
    latency:   effect.SERIAL,
    fixed:     effect.NO_FIXEDS,
    relations: effect.NO_RELATIONS,
};

# the encoding, the whole word
val RAW32: operand.Operand = operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 32, sign: operand.UNSIGNED, extends: 0, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE, write: operand.AS_ROW};

val RAW32_OPERANDS: [1]operand.Operand = [1]operand.Operand{RAW32};

val RAW32_SLICES: [1]field.Slice = [1]field.Slice{field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 32, at: 0, invert: false}};

val FIELDS: [1]field.Field = [1]field.Field{
    field.Field{kind: aarch64_field.UNIT_KIND, width: 32, fixed: 0, mask: 0, slices: field.Slices{at: ?RAW32_SLICES[0], len: 1}, operand: field.NO_OPERAND, param: 0},
};

val ROWS: [1]row.Row = [1]row.Row{
    row.Row{key: "inst.raw32", mnemonic: ".inst", operands: row.Operands{at: ?RAW32_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?FIELDS[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?OPAQUE, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
};

val FORMATS: [1]source.Format = [1]source.Format{source.Format{template: "<0>", row: ?ROWS[0], length: 4}};

# every A64 encoding is four bytes, whatever its bits
fun stated(data: *u8, len: usize) usize {
    ret 4;
}

# the instructions `.inst` states, as many as its commas part
val INSNS: source.Insns = source.Insns{formats: source.Formats{at: ?FORMATS[0], len: 1}, length: stated, listed: true};

# the integer data directives and their widths on aarch64
val WIDTHS: [12]source.Width = [12]source.Width{
    source.Width{name: ".byte", width: 1},
    source.Width{name: ".hword", width: 2},
    source.Width{name: ".short", width: 2},
    source.Width{name: ".2byte", width: 2},
    source.Width{name: ".word", width: 4},
    source.Width{name: ".long", width: 4},
    source.Width{name: ".int", width: 4},
    source.Width{name: ".4byte", width: 4},
    source.Width{name: ".xword", width: 8},
    source.Width{name: ".dword", width: 8},
    source.Width{name: ".quad", width: 8},
    source.Width{name: ".8byte", width: 8},
};

val DIRECTIVES: [5]source.Directive = [5]source.Directive{
    source.Directive{name: ".arch", operands: source.Shape{word: "", takes: source.TAKES_SELECTION}, edit: source.Edit.restate{extension.ARCH_KIND}},
    source.Directive{name: ".cpu", operands: source.Shape{word: "", takes: source.TAKES_SELECTION}, edit: source.Edit.restate{extension.CPU_KIND}},
    source.Directive{name: ".arch_extension", operands: source.Shape{word: "", takes: source.TAKES_EXTENSION}, edit: source.Edit.extend{}},
    source.Directive{name: ".inst", operands: source.Shape{word: "", takes: source.TAKES_ENCODING}, edit: source.Edit.raw{INSNS}},
    source.Directive{name: ".tlsdesccall", operands: source.Shape{word: "", takes: source.TAKES_SYMBOL}, edit: source.Edit.mark{aarch64_fixup.TLSDESC_CALL}},
};

# the dialect of aarch64's assemblers
pub val SOURCE: source.Source = source.Source{comment: "//", separator: ';', types: "@%", align: source.ALIGN_POWER, widths: source.Widths{at: ?WIDTHS[0], len: 12}, directives: source.Directives{at: ?DIRECTIVES[0], len: 5}, widens: nil};

# the code at `at`, four bytes at a time, the bytes left when fewer
pub fun parcel(data: *u8, len: usize, at: usize) usize {
    val left: usize = len - at;
    if (left < 4) { ret left; }
    ret 4;
}
