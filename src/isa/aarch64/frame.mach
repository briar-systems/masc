# the call frame state aarch64 functions start in, which the set's architecture row states
#
# a call leaves the return address in x30, so a function starts with the
# canonical frame address at sp and nothing saved (aapcs64, "DWARF Register
# Names"). code offsets are in bytes and data offsets in 4 byte units in
# its cie. the return address column is mink's.

use std.types.option.opt;

use masc.core.register;
use S: masc.core.set;

# sp, register.make of its class and number: number 31 of class 4
pub val SP: register.Id = 0x5_001F;

# the frame state of aarch64 code
pub val FRAME: S.Frame = S.Frame{cfa_register: SP, cfa_offset: 0, return_saved_at: opt[i64].none{}, code_align: 1, data_align: -4, initial: S.NO_RULES};
