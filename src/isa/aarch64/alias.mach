}

pub fun invert_64_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret inverted(base, alias, 1, 64);
}

# the 64 bits of the `width`-bit element `v` repeated
fun replicated(v: u64, width: u32) u64 {
    if (width >= 64) { ret v; }
    val e:   u64 = v & ones_of(width);
    var out: u64 = 0;
    var at:  u32 = 0;
    for (at < 64) {
        out = out | (e << at::u64);
        at  = at + width;
    }
    ret out;
}

fun field_of(v: u64, hi: u32, lo: u32) u64 {
    ret (v >> lo::u64) & ones_of(hi - lo + 1);
}

fun zero_or_ones(v: u64, hi: u32, lo: u32) bool {
    val f: u64 = field_of(v, hi, lo);
    ret f == 0 || f == ones_of(hi - lo + 1);
}

# SVEMoveMaskPreferred of the 64-bit value: no dup of an 8-bit immediate, shifted by 8 or not, at any element size
# writes it
fun mask_preferred(imm: u64) bool {
    val halves:   bool = field_of(imm, 63, 32) == field_of(imm, 31, 0);
    val quarters: bool = halves && field_of(imm, 31, 16) == field_of(imm, 15, 0);
    if (field_of(imm, 7, 0) != 0) {
        if (zero_or_ones(imm, 63, 7))                                { ret false; }
        if (halves && zero_or_ones(imm, 31, 7))                      { ret false; }
        if (quarters && zero_or_ones(imm, 15, 7))                    { ret false; }
        if (quarters && field_of(imm, 15, 8) == field_of(imm, 7, 0)) { ret false; }
        ret true;
    }
    if (zero_or_ones(imm, 63, 15))           { ret false; }
    if (halves && zero_or_ones(imm, 31, 15)) { ret false; }
    if (quarters)                            { ret false; }
    ret true;
}

# dupm's mov of a `width`-bit element, where the immediate of `values` is SVEMoveMaskPreferred
fun mask_mov(values: *operand.Value, width: u32) bool {
    var v: i64 = 0;
    if (!int(?values[1], ?v)) { ret false; }
    ret mask_preferred(replicated(v:~u64, width));
}

pub fun dupm_mov_16_base(alias: *operand.Value, base: *operand.Value) bool {
    ret mask_mov(alias, 16);
}

pub fun dupm_mov_16_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret mask_mov(base, 16);
}

pub fun dupm_mov_32_base(alias: *operand.Value, base: *operand.Value) bool {
    ret mask_mov(alias, 32);
}

pub fun dupm_mov_32_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret mask_mov(base, 32);
}

pub fun dupm_mov_64_base(alias: *operand.Value, base: *operand.Value) bool {
    ret mask_mov(alias, 64);
}

pub fun dupm_mov_64_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret mask_mov(base, 64);
}

# dup's mov of element 0 as the scalar register of the element's size: zn of the scalar's number, index 0
fun scalar_base(alias: *operand.Value, base: *operand.Value) bool {
    base[1] = reregistered(?alias[1], "z", nil);
    base[2] = imm(0);
    ret !sel base[1].none;
}

# the scalar register of class `name` dup's element 0 is, where the index is 0
fun scalar_alias(base: *operand.Value, alias: *operand.Value, name: str) bool {
    var index: i64 = 0;
    if (!int(?base[2], ?index) || index != 0) { ret false; }
    alias[1] = reregistered(?base[1], name, nil);
    ret !sel alias[1].none;
}

pub fun dup_scalar_b_base(alias: *operand.Value, base: *operand.Value) bool {
    ret scalar_base(alias, base);
}

pub fun dup_scalar_b_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret scalar_alias(base, alias, "b");
}

pub fun dup_scalar_h_base(alias: *operand.Value, base: *operand.Value) bool {
    ret scalar_base(alias, base);
}

pub fun dup_scalar_h_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret scalar_alias(base, alias, "h");
}

pub fun dup_scalar_s_base(alias: *operand.Value, base: *operand.Value) bool {
    ret scalar_base(alias, base);
}

pub fun dup_scalar_s_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret scalar_alias(base, alias, "s");
}

pub fun dup_scalar_d_base(alias: *operand.Value, base: *operand.Value) bool {
    ret scalar_base(alias, base);
}

pub fun dup_scalar_d_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret scalar_alias(base, alias, "d");
}

pub fun dup_scalar_q_base(alias: *operand.Value, base: *operand.Value) bool {
    ret scalar_base(alias, base);
}

pub fun dup_scalar_q_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret scalar_alias(base, alias, "q");
}

# dup's mov of an element past 0, which the scalar spelling writes otherwise
pub fun dup_indexed_base(alias: *operand.Value, base: *operand.Value) bool {
    ret true;
}

pub fun dup_indexed_alias(base: *operand.Value, alias: *operand.Value) bool {
    var index: i64 = 0;
    if (!int(?base[2], ?index)) { ret false; }
    ret index != 0;
}

# sxtl and uxtl: the shift is 0
pub fun lengthen_base(alias: *operand.Value, base: *operand.Value) bool {
    base[2] = imm(0);
    ret true;
}

pub fun lengthen_alias(base: *operand.Value, alias: *operand.Value) bool {
    var shift: i64 = 0;
    if (!int(?base[2], ?shift)) { ret false; }
    ret shift == 0;
}
