# the aarch64 aliases whose base values are computed from the alias's, or whose preference is a function of the base's
#
# the instruction model states each alias's assembly, the condition under which it is an alias and the one under which
# it is the preferred disassembly, and for these the page states the base's operands as expressions of the alias's,
# as bfi's `BFM <Wd>, <Wn>, #(-<lsb> MOD 32), #(<width>-1)`, which no source spells. the aliases topic
# (gen/data/aarch64/aliases.txt) names the derivation each of them takes, a pair of functions here:
#   <name>_base:  the base's values from the alias's, false where they have no base form, as a bitfield past the
#                 register's width, or where another spelling reads them, as a mov that movz encodes is no movn's
#   <name>_alias: the alias's values from the base's, false where the model does not prefer the alias
# every value a source gives is already in place, so each function fills only the values the generated sources mark
# derived. the preferences follow the pages' pseudocode: BFXPreferred, MoveWidePreferred and SVEMoveMaskPreferred of
# the shared pseudocode library, as AARCHMRS_OPENSOURCE_A_profile_FAT-2026-09 states them.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_equals;

use masc.core.operand;
use masc.core.register;

use masc.isa.aarch64.gen_register;

# the immediate `v` holds into `out`, false for another value
fun int(v: *operand.Value, out: *i64) bool {
    if (sel v.immediate) {
        @out = v.immediate;
        ret true;
    }
    ret false;
}

fun imm(v: i64) operand.Value {
    ret operand.Value.immediate{v};
}

# the low `bits` bits of `v` read as a signed number
fun signed(v: u64, bits: u32) i64 {
    if (bits >= 64) { ret v:~i64; }
    val m: u64 = (1::u64 << bits::u64) - 1;
    val x: u64 = v & m;
    if (((x >> (bits - 1)::u64) & 1) != 0) { ret (x | ~m):~i64; }
    ret x:~i64;
}

# the `bits`-bit pattern immediate `v` names, read signed or unsigned, none for one past both readings
fun pattern(v: i64, bits: u32) opt[u64] {
    if (bits >= 64) { ret opt[u64].some{v:~u64}; }
    val span: i64 = 1::i64 << bits::i64;
    if (v < 0 - span / 2 || v >= span) { ret opt[u64].none{}; }
    ret opt[u64].some{v:~u64 & (span:~u64 - 1)};
}

# the register numbered as `reg` in the class named `name`, of the zero register's class `zero` where `reg` is one
fun renamed(reg: register.Id, name: str, zero: str) register.Id {
    var to:   str                  = name;
    val from: opt[*register.Class] = register.class_row(?gen_register.FILE, reg);
    if (sel from.some) {
        if (zero != nil && (str_equals(from.some.name, "wzr") || str_equals(from.some.name, "xzr"))) { to = zero; }
    }
    val class: opt[u16] = register.class_named(?gen_register.FILE, to);
    if (sel class.none) { ret register.NONE; }
    ret register.make(class.some, register.number_of(reg));
}

# `v`, a register, renamed into the class `name`, none for another value
fun reregistered(v: *operand.Value, name: str, zero: str) operand.Value {
    if (!sel v.register) { ret operand.Value.none{}; }
    val r: register.Id = renamed(v.register, name, zero);
    if (r == register.NONE) { ret operand.Value.none{}; }
    ret operand.Value.register{r};
}

# insert, as bfi, sbfiz, ubfiz and bfc: immr = -lsb MOD d, imms = width - 1, from the alias's lsb and width at `at`
fun insert_base(alias: *operand.Value, base: *operand.Value, at: u32, d: i64) bool {
    var lsb:   i64 = 0;
    var width: i64 = 0;
    if (!int(?alias[at], ?lsb) || !int(?alias[at + 1], ?width)) { ret false; }
    if (lsb < 0 || lsb >= d || width < 1 || lsb + width > d)    { ret false; }
    base[2] = imm((d - lsb) % d);
    base[3] = imm(width - 1);
    ret true;
}

# the alias's lsb and width at `at` of an insert, preferred where imms < immr
fun insert_alias(base: *operand.Value, alias: *operand.Value, at: u32, d: i64) bool {
    var immr: i64 = 0;
    var imms: i64 = 0;
    if (!int(?base[2], ?immr) || !int(?base[3], ?imms) || imms >= immr) { ret false; }
    alias[at]     = imm((d - immr) % d);
    alias[at + 1] = imm(imms + 1);
    ret true;
}

# extract, as bfxil, sbfx and ubfx: immr = lsb, which a source gives, imms = lsb + width - 1
fun extract_base(alias: *operand.Value, base: *operand.Value, d: i64) bool {
    var lsb:   i64 = 0;
    var width: i64 = 0;
    if (!int(?alias[2], ?lsb) || !int(?alias[3], ?width)) { ret false; }
    if (lsb < 0 || width < 1 || lsb + width > d)          { ret false; }
    base[3] = imm(lsb + width - 1);
    ret true;
}

# the alias's width of an extract, the lsb a source gives, where imms >= immr
fun extract_alias(base: *operand.Value, alias: *operand.Value) bool {
    var immr: i64 = 0;
    var imms: i64 = 0;
    if (!int(?base[2], ?immr) || !int(?base[3], ?imms) || imms < immr) { ret false; }
    alias[3] = imm(imms - immr + 1);
    ret true;
}

# BFXPreferred(sf, uns, imms, immr): an extract that no ubfiz, sbfiz, lsr, asr, lsl, uxt or sxt alias spells
fun bfx_preferred(base: *operand.Value, wide: bool, uns: bool) bool {
    var immr: i64 = 0;
    var imms: i64 = 0;
    if (!int(?base[2], ?immr) || !int(?base[3], ?imms)) { ret false; }
    if (imms < immr)                                    { ret false; }
    if ((wide && imms == 63) || (!wide && imms == 31))  { ret false; }
    if (immr == 0) {
        if (!wide && (imms == 7 || imms == 15))                      { ret false; }
        if (wide && !uns && (imms == 7 || imms == 15 || imms == 31)) { ret false; }
    }
    ret true;
}

pub fun bfc_32_base(alias: *operand.Value, base: *operand.Value) bool {
    ret insert_base(alias, base, 1, 32);
}

pub fun bfc_32_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret insert_alias(base, alias, 1, 32);
}

pub fun bfc_64_base(alias: *operand.Value, base: *operand.Value) bool {
