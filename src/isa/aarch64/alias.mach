    ret extract_alias(base, alias);
}

pub fun sbfx_32_base(alias: *operand.Value, base: *operand.Value) bool {
    ret extract_base(alias, base, 32);
}

pub fun sbfx_32_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret bfx_preferred(base, false, false) && extract_alias(base, alias);
}

pub fun sbfx_64_base(alias: *operand.Value, base: *operand.Value) bool {
    ret extract_base(alias, base, 64);
}

pub fun sbfx_64_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret bfx_preferred(base, true, false) && extract_alias(base, alias);
}

pub fun ubfx_32_base(alias: *operand.Value, base: *operand.Value) bool {
    ret extract_base(alias, base, 32);
}

pub fun ubfx_32_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret bfx_preferred(base, false, true) && extract_alias(base, alias);
}

pub fun ubfx_64_base(alias: *operand.Value, base: *operand.Value) bool {
    ret extract_base(alias, base, 64);
}

pub fun ubfx_64_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret bfx_preferred(base, true, true) && extract_alias(base, alias);
}

# lsl: immr = -shift MOD d, imms = d - 1 - shift
fun lsl_base(alias: *operand.Value, base: *operand.Value, d: i64) bool {
    var shift: i64 = 0;
    if (!int(?alias[2], ?shift) || shift < 0 || shift >= d) { ret false; }
    base[2] = imm((d - shift) % d);
    base[3] = imm(d - 1 - shift);
    ret true;
}

# the shift of an lsl, preferred where imms + 1 == immr
fun lsl_alias(base: *operand.Value, alias: *operand.Value, d: i64) bool {
    var immr: i64 = 0;
    var imms: i64 = 0;
    if (!int(?base[2], ?immr) || !int(?base[3], ?imms) || imms + 1 != immr) { ret false; }
    alias[2] = imm(d - 1 - imms);
    ret true;
}

pub fun lsl_32_base(alias: *operand.Value, base: *operand.Value) bool {
    ret lsl_base(alias, base, 32);
}

pub fun lsl_32_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret lsl_alias(base, alias, 32);
}

pub fun lsl_64_base(alias: *operand.Value, base: *operand.Value) bool {
    ret lsl_base(alias, base, 64);
}

pub fun lsl_64_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret lsl_alias(base, alias, 64);
}

# sxtb, sxth and sxtw of a 64-bit sbfm: the source register is the x register of the alias's w one
pub fun sign_extend_base(alias: *operand.Value, base: *operand.Value) bool {
    base[1] = reregistered(?alias[1], "x", "xzr");
    ret !sel base[1].none;
}

pub fun sign_extend_alias(base: *operand.Value, alias: *operand.Value) bool {
    alias[1] = reregistered(?base[1], "w", "wzr");
    ret !sel alias[1].none;
}

# a value at `at` one more or one less than the base's: cbge's #<imm> is cbgt's #<imm>-1
fun shifted(from: *operand.Value, to: *operand.Value, at: u32, by: i64) bool {
    var v: i64 = 0;
    if (!int(?from[at], ?v)) { ret false; }
    to[at] = imm(v + by);
    ret true;
}

pub fun cb_plus_one_base(alias: *operand.Value, base: *operand.Value) bool {
    ret shifted(alias, base, 1, -1);
}

pub fun cb_plus_one_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret shifted(base, alias, 1, 1);
}

pub fun cb_minus_one_base(alias: *operand.Value, base: *operand.Value) bool {
    ret shifted(alias, base, 1, 1);
}

pub fun cb_minus_one_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret shifted(base, alias, 1, -1);
}

pub fun cflt_plus_one_base(alias: *operand.Value, base: *operand.Value) bool {
    ret shifted(alias, base, 2, -1);
}

pub fun cflt_plus_one_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret shifted(base, alias, 2, 1);
}

pub fun cflt_minus_one_base(alias: *operand.Value, base: *operand.Value) bool {
    ret shifted(alias, base, 2, 1);
}

pub fun cflt_minus_one_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret shifted(base, alias, 2, -1);
}

# the hw shift, 0 to `bits` - 16 in steps of 16, whose 16-bit chunk holds every set bit of `v`, -1 for none
fun chunk(v: u64, bits: u32) i64 {
    if (v == 0) { ret 0; }
    var hw: u32 = 0;
    for (hw + 16 <= bits) {
        if ((v & ~(0xFFFF::u64 << hw::u64)) == 0) { ret hw::i64; }
        hw = hw + 16;
    }
    ret -1;
}

fun ones_of(bits: u32) u64 {
    if (bits >= 64) { ret 0xFFFF_FFFF_FFFF_FFFF; }
    ret (1::u64 << bits::u64) - 1;
}

# MoveWidePreferred of the value: one movz or movn encodes it
fun wide(v: u64, bits: u32) bool {
    ret chunk(v, bits) >= 0 || chunk(~v & ones_of(bits), bits) >= 0;
}

# movz's imm16 and shift of the alias's value, refused where it is no movz's
fun movz_base(alias: *operand.Value, base: *operand.Value, bits: u32) bool {
    var v: i64 = 0;
    if (!int(?alias[1], ?v)) { ret false; }
    val p: opt[u64] = pattern(v, bits);
    if (sel p.none) { ret false; }
    val hw: i64 = chunk(p.some, bits);
    if (hw < 0) { ret false; }
    base[1] = imm((p.some >> hw:~u64)::i64);
    base[2] = imm(hw);
    ret true;
}

# the value movz writes, preferred but where imm16 is zero and shifted
fun movz_alias(base: *operand.Value, alias: *operand.Value, bits: u32) bool {
    var n:  i64 = 0;
    var hw: i64 = 0;
    if (!int(?base[1], ?n) || !int(?base[2], ?hw) || (n == 0 && hw != 0)) { ret false; }
    alias[1] = imm(signed(n:~u64 << hw:~u64, bits));
    ret true;
}

# movn's imm16 and shift of the alias's value, refused where it is movz's
fun movn_base(alias: *operand.Value, base: *operand.Value, bits: u32) bool {
    var v: i64 = 0;
    if (!int(?alias[1], ?v)) { ret false; }
    val p: opt[u64] = pattern(v, bits);
    if (sel p.none)               { ret false; }
    if (chunk(p.some, bits) >= 0) { ret false; }
    val inverse: u64 = ~p.some & ones_of(bits);
    val hw:      i64 = chunk(inverse, bits);
    if (hw < 0) { ret false; }
    base[1] = imm((inverse >> hw:~u64)::i64);
    base[2] = imm(hw);
    ret true;
}

# the value movn writes, preferred but where imm16 is zero and shifted, or, for a 32-bit one, all ones
fun movn_alias(base: *operand.Value, alias: *operand.Value, bits: u32) bool {
    var n:  i64 = 0;
    var hw: i64 = 0;
    if (!int(?base[1], ?n) || !int(?base[2], ?hw) || (n == 0 && hw != 0) || (bits == 32 && n == 0xFFFF)) { ret false; }
    alias[1] = imm(signed(~(n:~u64 << hw:~u64) & ones_of(bits), bits));
    ret true;
}

pub fun movz_32_base(alias: *operand.Value, base: *operand.Value) bool {
    ret movz_base(alias, base, 32);
}

pub fun movz_32_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret movz_alias(base, alias, 32);
}

pub fun movz_64_base(alias: *operand.Value, base: *operand.Value) bool {
    ret movz_base(alias, base, 64);
}

pub fun movz_64_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret movz_alias(base, alias, 64);
}

pub fun movn_32_base(alias: *operand.Value, base: *operand.Value) bool {
    ret movn_base(alias, base, 32);
}

pub fun movn_32_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret movn_alias(base, alias, 32);
}

pub fun movn_64_base(alias: *operand.Value, base: *operand.Value) bool {
    ret movn_base(alias, base, 64);
}

pub fun movn_64_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret movn_alias(base, alias, 64);
}

# orr's mov of a bitmask immediate no movz or movn encodes, the value at `at` of `values`
fun bitmask_mov(values: *operand.Value, at: u32, bits: u32) bool {
    var v: i64 = 0;
    if (!int(?values[at], ?v)) { ret false; }
    val p: opt[u64] = pattern(v, bits);
    if (sel p.none) { ret false; }
    ret !wide(p.some, bits);
}

pub fun orr_mov_32_base(alias: *operand.Value, base: *operand.Value) bool {
    ret bitmask_mov(alias, 1, 32);
}

pub fun orr_mov_32_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret bitmask_mov(base, 2, 32);
}

pub fun orr_mov_64_base(alias: *operand.Value, base: *operand.Value) bool {
    ret bitmask_mov(alias, 1, 64);
}

pub fun orr_mov_64_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret bitmask_mov(base, 2, 64);
}

# the immediate at `at` of `from` into `to` with each of its `width` bits inverted, as orn's constant is orr's
fun inverted(from: *operand.Value, to: *operand.Value, at: u32, width: u32) bool {
    var v: i64 = 0;
    if (!int(?from[at], ?v)) { ret false; }
    if (width >= 64)         { to[at] = imm(~v); }
    or                       { to[at] = imm(((~v:~u64) & ones_of(width))::i64); }
    ret true;
}

pub fun invert_8_base(alias: *operand.Value, base: *operand.Value) bool {
    ret inverted(alias, base, 1, 8);
}

pub fun invert_8_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret inverted(base, alias, 1, 8);
}

pub fun invert_16_base(alias: *operand.Value, base: *operand.Value) bool {
    ret inverted(alias, base, 1, 16);
}

pub fun invert_16_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret inverted(base, alias, 1, 16);
}

pub fun invert_32_base(alias: *operand.Value, base: *operand.Value) bool {
    ret inverted(alias, base, 1, 32);
}

pub fun invert_32_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret inverted(base, alias, 1, 32);
}

pub fun invert_64_base(alias: *operand.Value, base: *operand.Value) bool {
