pub fun bfxil_32_base(alias: *operand.Value, base: *operand.Value) bool {
    ret extract_base(alias, base, 32);
}

pub fun bfxil_32_alias(base: *operand.Value, alias: *operand.Value) bool {
    ret extract_alias(base, alias);
}

pub fun bfxil_64_base(alias: *operand.Value, base: *operand.Value) bool {
    ret extract_base(alias, base, 64);
}

