# the aarch64 register file: the general, zero, stack, scalar floating-point, advanced simd, sve and sme
# registers, their views of one another, their dwarf and codeview numbers, and what a write through each leaves
#
# sources, read as published:
#   Arm DWARF for the Arm 64-bit Architecture (aadwarf64), ARM-software/abi-aa bd017eeca341c06915b9a02ae111b480416d248f,
#     aadwarf64/aadwarf64.rst, section "DWARF register names": the dwarf numbers. a register the table does not
#     number has none here, and the elr, ra_sign_state and thread id registers of that table are system registers
#     (masc-27, #36)
#   llvm-project 7ddb67460b168b17ebb263dc99bf956b56d7e517, llvm/include/llvm/DebugInfo/CodeView/CodeViewRegisters.def,
#     the CV_REGISTERS_ARM64 block: the codeview numbers, the CV_ARM64_* values of cvconst.h. fpsr and fpcr are
#     system registers and wsp, the v, z and p registers, ffr, vg, pc and za have no codeview number
#   Arm Architecture Reference Manual for A-profile (DDI 0487), pseudocode functions X[], W[], SP[], V[], Z[], P[], FFR[]
#     and the register chapters of its "Application Level Programmers' Model": a write of w<n> is zero-extended to
#     x<n>, a write of a scalar floating-point or advanced simd register (b, h, s, d, q, v) clears every bit of the
#     z register above it, wzr and xzr read zero and ignore a write, and z<n> bits 127:0 are v<n>. the same facts as
#     Linux Documentation/arch/arm64/sve.rst, section A.1, read at torvalds/linux master on 2026-10-09
#   Arm Architecture Reference Manual for A-profile (DDI 0487), "The SME architecture" ZA storage: za is svl / 8 rows
#     of svl bits, and a tile of element size e is the rows n, n + t, n + 2t and so on of the array, t being e / 8
#     tiles, so za0.d is the rows 0, 8, 16 and za0.s is the rows 0, 4, 8, which holds za0.d and za4.d
#   llvm-mc at 7ddb674: the dwarf numbers of x0, x30, sp, vg, ffr, v0, v31, z0 and z31 read back through
#     `.cfi_offset <number>` and llvm-dwarfdump --eh-frame as W0, W30, WSP, VG, FFR, B0, B31, Z0 and Z31
#
# register number 31 is sp or the zero register by the operand that holds it, so each of them is a class of its
# own whose only row has number 31 and an operand admits the classes it takes, as x with xzr or x with sp. the
# vector length of z, p and ffr is a scale of its own, apart from the streaming vector length of the za tiles,
# since the two differ on an implementation and one register file serves both modes. slices of a tile are not
# rows: a slice is named by a tile, a direction, a w12 to w15 register and an immediate, which no row states, and
# the tile bounds what any slice writes

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.view;

use masc.core.index;
use masc.core.register;
use masc.core.requirement;
use aarch64_extension: masc.isa.aarch64.extension;

# the vector length and the streaming vector length, each 128 bits times a power of two to 2048 bits, an
# implementation's choice that no extension fixes
val SCALES: [2]register.Scale = [2]register.Scale{
    register.Scale{name: "vl", max: 16, fixes: register.NO_FIXINGS},
    register.Scale{name: "svl", max: 16, fixes: register.NO_FIXINGS},
};

val NO:  register.Scaled = register.Scaled{fixed: 0, per: 0, scale: 0};
val ONE: register.Scaled = register.Scaled{fixed: 1, per: 0, scale: 0};

# nzcv is the four condition flags n, z, c and v, and a tile class is the rows of one tile, each svl bits

val CLASSES: [23]register.Class = [23]register.Class{
    register.Class{name: "x", kind: register.GENERAL, width: register.Scaled{fixed: 64, per: 0, scale: 0}, count: 31},
    register.Class{name: "w", kind: register.GENERAL, width: register.Scaled{fixed: 32, per: 0, scale: 0}, count: 31},
    register.Class{name: "xzr", kind: register.GENERAL, width: register.Scaled{fixed: 64, per: 0, scale: 0}, count: 32},
    register.Class{name: "wzr", kind: register.GENERAL, width: register.Scaled{fixed: 32, per: 0, scale: 0}, count: 32},
    register.Class{name: "sp", kind: register.GENERAL, width: register.Scaled{fixed: 64, per: 0, scale: 0}, count: 32},
    register.Class{name: "wsp", kind: register.GENERAL, width: register.Scaled{fixed: 32, per: 0, scale: 0}, count: 32},
    register.Class{name: "b", kind: register.FLOAT, width: register.Scaled{fixed: 8, per: 0, scale: 0}, count: 32},
    register.Class{name: "h", kind: register.FLOAT, width: register.Scaled{fixed: 16, per: 0, scale: 0}, count: 32},
    register.Class{name: "s", kind: register.FLOAT, width: register.Scaled{fixed: 32, per: 0, scale: 0}, count: 32},
    register.Class{name: "d", kind: register.FLOAT, width: register.Scaled{fixed: 64, per: 0, scale: 0}, count: 32},
    register.Class{name: "q", kind: register.FLOAT, width: register.Scaled{fixed: 128, per: 0, scale: 0}, count: 32},
    register.Class{name: "v", kind: register.VECTOR, width: register.Scaled{fixed: 128, per: 0, scale: 0}, count: 32},
    register.Class{name: "z", kind: register.VECTOR, width: register.Scaled{fixed: 0, per: 128, scale: 0}, count: 32},
    register.Class{name: "p", kind: register.PREDICATE, width: register.Scaled{fixed: 0, per: 16, scale: 0}, count: 16},
    register.Class{name: "ffr", kind: register.PREDICATE, width: register.Scaled{fixed: 0, per: 16, scale: 0}, count: 1},
    register.Class{name: "vg", kind: register.SYSTEM, width: register.Scaled{fixed: 64, per: 0, scale: 0}, count: 1},
    register.Class{name: "pc", kind: register.SYSTEM, width: register.Scaled{fixed: 64, per: 0, scale: 0}, count: 1},
    register.Class{name: "nzcv", kind: register.FLAGS, width: register.Scaled{fixed: 4, per: 0, scale: 0}, count: 1},
    register.Class{name: "zab", kind: register.TILE, width: register.Scaled{fixed: 0, per: 128, scale: 1}, count: 1},
    register.Class{name: "zah", kind: register.TILE, width: register.Scaled{fixed: 0, per: 128, scale: 1}, count: 2},
    register.Class{name: "zas", kind: register.TILE, width: register.Scaled{fixed: 0, per: 128, scale: 1}, count: 4},
    register.Class{name: "zad", kind: register.TILE, width: register.Scaled{fixed: 0, per: 128, scale: 1}, count: 8},
    register.Class{name: "zaq", kind: register.TILE, width: register.Scaled{fixed: 0, per: 128, scale: 1}, count: 16},
};

val CLASS_NAMES: [23]index.Entry = [23]index.Entry{
    index.Entry{key: "b", row: 6},
    index.Entry{key: "d", row: 9},
    index.Entry{key: "ffr", row: 14},
    index.Entry{key: "h", row: 7},
    index.Entry{key: "nzcv", row: 17},
    index.Entry{key: "p", row: 13},
    index.Entry{key: "pc", row: 16},
    index.Entry{key: "q", row: 10},
    index.Entry{key: "s", row: 8},
    index.Entry{key: "sp", row: 4},
    index.Entry{key: "v", row: 11},
    index.Entry{key: "vg", row: 15},
    index.Entry{key: "w", row: 1},
    index.Entry{key: "wsp", row: 5},
    index.Entry{key: "wzr", row: 3},
    index.Entry{key: "x", row: 0},
    index.Entry{key: "xzr", row: 2},
    index.Entry{key: "z", row: 12},
    index.Entry{key: "zab", row: 18},
    index.Entry{key: "zad", row: 21},
    index.Entry{key: "zah", row: 19},
    index.Entry{key: "zaq", row: 22},
    index.Entry{key: "zas", row: 20},
};

val SVE_ID:  [1]requirement.Id  = [1]requirement.Id{aarch64_extension.SVE};
val SME_ID:  [1]requirement.Id  = [1]requirement.Id{aarch64_extension.SME};
val SVE_ALT: [1]requirement.Ids = [1]requirement.Ids{requirement.Ids{at: ?SVE_ID[0], len: 1}};
val SME_ALT: [1]requirement.Ids = [1]requirement.Ids{requirement.Ids{at: ?SME_ID[0], len: 1}};

# z, p and vg exist under sve or under sme, whose streaming mode has them, and ffr only under sve
val VECTOR_ALTS: [2]requirement.Ids = [2]requirement.Ids{
    requirement.Ids{at: ?SVE_ID[0], len: 1},
    requirement.Ids{at: ?SME_ID[0], len: 1},
};

# banks: x0 to x30 are banks 0 to 30, the zero registers 31, sp and wsp 32, pc 33, nzcv 34, vg 35, the vector
# registers v, z and the scalar views 36 to 67 by number, p0 to p15 68 to 83, ffr 84 and the tiles, one array, 85.
# a view is the low bits of its bank and a write through w, wsp or a scalar floating-point, advanced simd view
# clears the rest of its bank, while x, sp, z, p, ffr and the tiles are written whole or by their own rows
# and keep the rest. xzr and wzr discard a write, so they overwrite nothing. a tile of element size e holds
# every (e / 8)th row of the array from its number, so its pieces are one row each at that stride

val REGISTERS: [341]register.Register = [341]register.Register{
    register.Register{name: "x0", class: 0, number: 0, bank: 0, offset: NO, stride: NO, count: ONE, flags: 0, requires: requirement.NONE, extend: register.KEEP},
