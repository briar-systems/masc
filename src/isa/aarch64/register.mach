# the aarch64 register file: the general, zero, stack, scalar floating-point, advanced simd, sve and sme registers, their
# views of one another, their dwarf and codeview numbers, and what a write through each leaves
#
# the rows are generated, by gen aarch64 into gen_register from the register families under gen/data/aarch64/registers, where
# the sources of every number and write extension are cited, and each class and bank is derived from them. this module is the
# file as the set reads it, and its tests state what the register queries answer on it
#
# register number 31 is sp or the zero register by the operand that holds it, so each of them is a class of its own whose only
# row has number 31, and an operand admits the classes it takes, as x with xzr or x with sp. z, p and ffr are as wide as the slot
# zlen, which binds the vector length vl outside streaming mode and the streaming vector length svl in it, the two quantities an
# implementation may make differ, and the za tiles and their slices are as wide as svl in either mode. the horizontal and
# vertical slices of the 32-bit tiles are rows, svl / 8 of them in each direction, so a view fixing a smaller svl admits fewer

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.view;

use masc.core.register;

fwd masc.isa.aarch64.gen_register.FILE;

fun t_row(name: str) *register.Register {
    val at: opt[u32] = register.row_named(?FILE, view(name, str_len(name)), false);
    if (sel at.none) { ret nil; }
    ret ?FILE.registers[at.some];
}

fun t_id(name: str) register.Id {
    val at: opt[register.Id] = register.named(?FILE, view(name, str_len(name)), false);
    if (sel at.none) { ret register.NONE; }
    ret at.some;
}

# whether `part` lies within `whole` at every multiplier, and the two overlap, as the file states them
fun t_within(part: str, whole: str) bool {
    val p: *register.Register = t_row(part);
    val w: *register.Register = t_row(whole);
    if (p == nil || w == nil) { ret false; }
    var m: u64 = 1;
    for (m <= 16) {
        val at: opt[register.Placement] = register.within(?FILE, p, w, m);
        if (sel at.none) { ret false; }
        m = m * 2;
    }
    ret register.overlap(?FILE, p, w);
}

fun t_overlap(a: str, b: str) bool {
    val x: *register.Register = t_row(a);
    val y: *register.Register = t_row(b);
    if (x == nil || y == nil) { ret false; }
    ret register.overlap(?FILE, x, y);
}

fun t_kills(written: str, other: str) bool {
    val x: *register.Register = t_row(written);
    val y: *register.Register = t_row(other);
    if (x == nil || y == nil) { ret false; }
    ret register.overwrites(?FILE, x, y, opt[register.Extend].none{});
}
