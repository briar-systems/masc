# the aarch64 register file: the general, zero, stack, scalar floating-point, advanced simd, sve and sme registers, their
# views of one another, their dwarf and codeview numbers, and what a write through each leaves
#
# the rows are generated, by gen aarch64 into gen_register from the register families under gen/data/aarch64/registers, where
# the sources of every number and write extension are cited, and each class and bank is derived from them. this module is the
# file as the set reads it, and its tests state what the register queries answer on it
#
# register number 31 is sp or the zero register by the operand that holds it, so each of them is a class of its own whose only
# row has number 31, and an operand admits the classes it takes, as x with xzr or x with sp. z, p and ffr are as wide as the slot
# zlen, which binds the vector length vl outside streaming mode and the streaming vector length svl in it, the two quantities an
# implementation may make differ, and the za tiles and their slices are as wide as svl in either mode. the horizontal and
# vertical slices of the 32-bit tiles are rows, svl / 8 of them in each direction, so a view fixing a smaller svl admits fewer

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.view;

use std.allocator.testing;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.quantity;
use masc.core.register;
use masc.core.requirement;
use masc.core.state;
use aarch64_extension: masc.isa.aarch64.extension;
use masc.isa.aarch64.gen_extension;

use masc.isa.aarch64.gen_register;

pub val FILE: register.File = gen_register.FILE;

fun t_row(name: str) *register.Register {
    val at: opt[u32] = register.row_named(?FILE, view(name, str_len(name)), false);
    if (sel at.none) { ret nil; }
    ret ?FILE.registers[at.some];
}

fun t_id(name: str) register.Id {
    val at: opt[register.Id] = register.named(?FILE, view(name, str_len(name)), false);
    if (sel at.none) { ret register.NONE; }
    ret at.some;
}

# whether `part` lies within `whole` at every multiplier, and the two overlap, as the file states them
fun t_within(part: str, whole: str) bool {
    val p: *register.Register = t_row(part);
    val w: *register.Register = t_row(whole);
    if (p == nil || w == nil) { ret false; }
    var m: u64 = 1;
    for (m <= 16) {
        val at: opt[register.Placement] = register.within(?FILE, p, w, m);
        if (sel at.none) { ret false; }
        m = m * 2;
    }
    ret register.overlap(?FILE, p, w);
}

fun t_overlap(a: str, b: str) bool {
    val x: *register.Register = t_row(a);
    val y: *register.Register = t_row(b);
    if (x == nil || y == nil) { ret false; }
    ret register.overlap(?FILE, x, y);
}

fun t_kills(written: str, other: str) bool {
    val x: *register.Register = t_row(written);
    val y: *register.Register = t_row(other);
    if (x == nil || y == nil) { ret false; }
    ret register.overwrites(?FILE, x, y, opt[register.Extend].none{});
}

test within__the_views_of_a_general_register_and_of_a_vector_register_lie_in_their_containers {
    if (!t_within("w5", "x5") || t_within("x5", "w5") || t_overlap("w5", "x6"))   { ret 1; }
    if (!t_within("wsp", "sp") || !t_within("wzr", "xzr"))                        { ret 2; }
    if (!t_within("b3", "h3") || !t_within("h3", "s3") || !t_within("s3", "d3"))  { ret 3; }
    if (!t_within("d3", "q3") || !t_within("q3", "v3") || !t_within("v3", "z3"))  { ret 4; }
    if (!t_within("b3", "z3") || t_within("z3", "v3") || t_overlap("v3", "v4"))   { ret 5; }
    if (t_overlap("p0", "p1") || t_overlap("p0", "ffr") || t_overlap("z0", "p0")) { ret 6; }
    ret 0;
}

test within__a_tile_lies_in_the_tiles_of_a_narrower_element_that_hold_its_rows {
    if (!t_within("za1.d", "za0.b") || !t_within("za0.d", "za0.s") || !t_within("za4.d", "za0.s"))  { ret 1; }
    if (!t_within("za0.s", "za0.h") || !t_within("za1.h", "za0.b") || !t_within("za15.q", "za3.s")) { ret 2; }
    if (t_overlap("za0.d", "za1.d") || t_overlap("za0.d", "za1.s") || t_overlap("za0.s", "za3.s"))  { ret 3; }
    if (t_within("za0.s", "za0.d") || !t_overlap("za0.s", "za4.d"))                                 { ret 4; }
    if (t_overlap("za0.d", "z0"))                                                                   { ret 5; }
    ret 0;
}

test overwrites__a_write_clears_the_rest_of_its_bank_only_where_the_architecture_does {
    if (!t_kills("w0", "x0") || !t_kills("x0", "w0") || t_kills("x0", "x1"))                  { ret 1; }
    if (!t_kills("s0", "z0") || !t_kills("v0", "z0") || !t_kills("b0", "v0"))                 { ret 2; }
    if (!t_kills("z0", "v0") || t_kills("z0", "z1") || t_kills("p0", "p1"))                   { ret 3; }
    if (t_kills("wzr", "xzr") || t_kills("xzr", "wzr") || !t_kills("wsp", "sp"))              { ret 4; }
    if (t_kills("za0.d", "za1.d") || !t_kills("za0.s", "za0.d") || t_kills("za0.d", "za0.s")) { ret 5; }
    if (!t_kills("za0.b", "za15.q") || t_kills("za15.q", "za0.b"))                            { ret 6; }
    ret 0;
}

test write__every_row_states_an_extension_the_architecture_gives_it {
    var i: u32 = 0;
    for (i < FILE.register_count) {
        val r: *register.Register = ?FILE.registers[i];
        if (r.extend == register.UNSTATED) { ret 1; }
        val widened: bool = FILE.classes[r.class].kind == register.GENERAL && FILE.classes[r.class].width.fixed == 32;
        val scalar:  bool = FILE.classes[r.class].kind == register.FLOAT || r.class == 11;
        if ((widened || scalar) != (r.extend == register.ZEROES)) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

test requires__the_registers_a_selection_may_lack_name_their_extension {
    val z: *register.Register = t_row("z31");
    val p: *register.Register = t_row("p15");
    val f: *register.Register = t_row("ffr");
    val t: *register.Register = t_row("za0.b");
    val v: *register.Register = t_row("v0");
    val s: *register.Register = t_row("s0");
    val x: *register.Register = t_row("x0");
    if (z == nil || p == nil || f == nil || t == nil || v == nil || s == nil || x == nil)                                                                              { ret 1; }
    if (z.requires.len != 2 || p.requires.len != 2 || f.requires.len != 1 || t.requires.len != 1 || v.requires.len != 1 || s.requires.len != 1 || x.requires.len != 0) { ret 2; }
    if (v.requires.at[0].all.at[0] != gen_extension.SIMD || s.requires.at[0].all.at[0] != gen_extension.FP)                                                            { ret 5; }
    if (f.requires.at[0].all.at[0] != gen_extension.SVE || t.requires.at[0].all.at[0] != gen_extension.SME)                                                            { ret 3; }
    if (z.requires.at[0].all.at[0] != gen_extension.SVE || z.requires.at[1].all.at[0] != gen_extension.SME)                                                            { ret 4; }
    ret 0;
}

#[testing]
fun t_number(name: str, format: register.Format) u32 {
    var words: [16]u64;
    var s:     extension.Selection;
    var ctx:   state.Context = state.t_bare(?aarch64_extension.CATALOG, ?aarch64_extension.AXES, state.initial(?aarch64_extension.AXES), ?words[0], 16, ?s);
    val n:     opt[u32]      = state.debug_number(?FILE, t_id(name), format, ?ctx);
    if (sel n.none) { ret register.UNNUMBERED; }
    ret n.some;
}

#[testing]
fun t_from(number: u32, format: register.Format) register.Id {
    var words: [16]u64;
    var s:     extension.Selection;
    var ctx:   state.Context    = state.t_bare(?aarch64_extension.CATALOG, ?aarch64_extension.AXES, state.initial(?aarch64_extension.AXES), ?words[0], 16, ?s);
    val id:    opt[register.Id] = state.from_debug_number(?FILE, number, format, ?ctx);
    if (sel id.none) { ret register.NONE; }
    ret id.some;
}

test debug__the_dwarf_and_codeview_numbers_are_the_ones_the_formats_publish {
    val names: [9]str = [9]str{"x0", "x30", "sp", "pc", "vg", "ffr", "p0", "v0", "z31"};
    val nums:  [9]u32 = [9]u32{0, 30, 31, 32, 46, 47, 48, 64, 127};
    var i:     u32    = 0;
    for (i < 9) {
        if (t_number(names[i], register.DWARF) != nums[i])     { ret 1; }
        if (t_from(nums[i], register.DWARF) != t_id(names[i])) { ret 2; }
        i = i + 1;
    }
    if (t_number("w0", register.DWARF) != register.UNNUMBERED || t_number("q0", register.DWARF) != register.UNNUMBERED) { ret 3; }
    val cv:  [8]str = [8]str{"w0", "wzr", "x0", "fp", "lr", "sp", "xzr", "nzcv"};
    val cvn: [8]u32 = [8]u32{10, 41, 50, 79, 80, 81, 82, 90};
    i = 0;
    for (i < 8) {
        if (t_number(cv[i], register.CODEVIEW) != cvn[i])     { ret 4; }
        if (t_from(cvn[i], register.CODEVIEW) != t_id(cv[i])) { ret 5; }
        i = i + 1;
    }
    if (t_number("b31", register.CODEVIEW) != 261 || t_number("h0", register.CODEVIEW) != 270 || t_number("q0", register.CODEVIEW) != 180) { ret 6; }
    if (t_number("wsp", register.CODEVIEW) != register.UNNUMBERED || t_number("v0", register.CODEVIEW) != register.UNNUMBERED)             { ret 7; }
    ret 0;
}

test named__an_alias_and_the_array_name_spell_their_registers {
    if (t_id("fp") != t_id("x29") || t_id("lr") != t_id("x30") || t_id("za") != t_id("za0.b")) { ret 1; }
    if (t_id("x31") != register.NONE || t_id("w29") == t_id("x29"))                            { ret 2; }
    ret 0;
}

# whether the view of a copy of the file whose vl is fixed at multiplier 2 and whose svl at `svl`, under armv9-a+sme at
# streaming value `streaming`, gives `name` the width `bits` and admits the slice `slice` when `held`
#[testing]
fun t_streamed(streaming: u8, svl: u32, name: str, bits: u64, slice: str, held: bool) bool {
    var t: testing.Testing;
    testing.make(?t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?aarch64_extension.CATALOG, "armv9-a+sme", diagnostic.START);
    if (sel made.err) { ret false; }
    var s:  extension.Selection  = made.ok;
    var vl: [1]quantity.Bound    = [1]quantity.Bound{quantity.Bound{when: requirement.NO_ALTERNATIVES, least: 2, most: 2}};
    var sv: [1]quantity.Bound    = [1]quantity.Bound{quantity.Bound{when: requirement.NO_ALTERNATIVES, least: svl, most: svl}};
    var qs: [2]quantity.Quantity = [2]quantity.Quantity{FILE.quantities.at[0], FILE.quantities.at[1]};
    qs[0].bounds = quantity.Bounds{at: ?vl[0], len: 1};
    qs[1].bounds = quantity.Bounds{at: ?sv[0], len: 1};
    var f: register.File = FILE;
    f.quantities = quantity.Quantities{at: ?qs[0], len: 2};
    var start: state.Settings = state.initial(?aarch64_extension.AXES);
    start.at[0] = streaming;
    var v:      register.Available;
    val opened: res[state.Context, state.Opened] = state.open(testing.allocator_of(?t), ?f, ?s, ?aarch64_extension.AXES, start, ?v);
    if (sel opened.err) { ret false; }
    val width: res[opt[u64], register.Absent]    = register.width(?v, t_id(name));
    var fine:  bool                              = sel width.ok && (sel width.ok.some && width.ok.some == bits);
    val found: res[register.Id, register.Absent] = register.lookup(?v, view(slice, str_len(slice)));
    if ((sel found.ok) != held) { fine = false; }
    register.release(?v);
    extension.release(?s);
    ret fine && testing.live_count(?t) == 0;
}

# a z register is as wide as vl outside streaming mode and as svl in it, the width of every za row in both (#271), and a
# view fixing svl admits the slices of that svl alone, svl / 8 in each direction (#270)
test streaming__z_takes_svl_in_streaming_mode_and_svl_bounds_the_slices {
    if (!t_streamed(0, 4, "z0", 256, "zas.h63", true) || !t_streamed(1, 4, "z0", 512, "zas.v63", true))       { ret 1; }
    if (!t_streamed(0, 4, "za0.s", 512, "zas.h64", false) || !t_streamed(1, 4, "za0.s", 512, "zas.v0", true)) { ret 2; }
    if (!t_streamed(1, 1, "z0", 128, "zas.h15", true) || !t_streamed(1, 1, "z0", 128, "zas.h16", false))      { ret 3; }
    if (!t_streamed(1, 1, "p0", 16, "zas.v16", false))                                                        { ret 4; }
    ret 0;
}

# a slice lies in its tile and in the array, a horizontal slice is a row of one tile and a vertical one a column of one
# tile's elements, so a row and a column cross where they share a tile and are apart where they do not
test within__a_slice_lies_in_its_tile_and_the_array {
    if (!t_within("zas.h0", "za0.s") || !t_within("zas.h1", "za1.s") || !t_within("zas.h5", "za1.s"))      { ret 1; }
    if (!t_within("zas.v0", "za0.s") || !t_within("zas.v5", "za1.s") || !t_within("zas.h0", "za0.b"))      { ret 2; }
    if (t_overlap("zas.h0", "za1.s") || t_overlap("zas.v0", "za1.s") || t_overlap("zas.h0", "zas.h1"))     { ret 3; }
    if (!t_overlap("zas.h0", "zas.v0") || !t_overlap("zas.h4", "zas.v0") || t_overlap("zas.h1", "zas.v0")) { ret 4; }
    if (t_overlap("zas.v0", "zas.v4") || !t_within("zas.v4", "za0.s") || t_overlap("zas.h0", "z0"))        { ret 5; }
    ret 0;
}
