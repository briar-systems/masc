# the aarch64 catalog
#
# the rows, their codec and decode dispatch are generated by gen aarch64 from
# the instruction model (Instructions.json of the AARCHMRS release vendored
# under gen/vendor/aarchmrs), which states every encoding's bits, assembly
# symbols and feature conditions, and the overlay under gen/data/aarch64, which
# states what the model leaves out: what each symbol is as an operand, under
# which value of streaming each group exists, and which rows are data
# independent time. the field kinds, extension catalog and register file are
# their own modules. the tests here walk the shipped rows: every row encodes and
# decodes back to itself, and the rows of sve, sme and dit read the state the
# way the manual states it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.codec.walk;
use masc.core.ct;
use masc.core.diagnostic;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.inst;
use masc.core.operand;
use masc.core.quantity;
use masc.core.register;
use masc.core.requirement;
use masc.core.row;
use masc.core.state;

use aarch64_extension: masc.isa.aarch64.extension;
use aarch64_register:  masc.isa.aarch64.register;

fwd masc.isa.aarch64.gen_row.CODEC;

use masc.isa.aarch64.gen_extension;
use masc.isa.aarch64.gen_row;

# a test's selection, its register view over a file whose vl and svl may be fixed, its context and output buffers
#[testing]
rec T {
    t:      testing.Testing;
    s:      extension.Selection;
    v:      register.Available;
    ctx:    state.Context;
    file:   register.File;
    qs:     [2]quantity.Quantity;
    vl:     [1]quantity.Bound;
    svl:    [1]quantity.Bound;
    out:    vector.Vector[u8];
    fixups: vector.Vector[field.Fixup];
    lists:  [T_LIST_ROOM]operand.Value;
}

# the most members of a list the walk test holds, per operand
#[testing]
val T_MEMBERS: u32 = 4;

#[testing]
val T_LIST_ROOM: u32 = 64;

# a test over the extensions `ids` holds and the axis values `start`, with vl fixed at multiplier `vl` and svl at `svl`
# of 128 bits, either left free at 0
#[testing]
fun t_open(t: *T, ids: requirement.Ids, start: state.Settings, vl: u32, svl: u32) bool {
    testing.make(?t.t);
    val made: res[extension.Request, extension.Error] = extension.request(testing.allocator_of(?t.t), ?aarch64_extension.CATALOG, "", diagnostic.START);
    if (sel made.err) { ret false; }
    var req: extension.Request = made.ok;
    var i:   u32               = 0;
    for (i < ids.len) {
        if (ids.at[i] < gen_extension.COUNT) { extension.request_add(?req, ids.at[i]); }
        i = i + 1;
    }
    val closed: res[extension.Selection, extension.Error] = extension.close(req);
    if (sel closed.err) { ret false; }
    t.s     = closed.ok;
    t.file  = aarch64_register.FILE;
    t.qs[0] = aarch64_register.FILE.quantities.at[0];
    t.qs[1] = aarch64_register.FILE.quantities.at[1];
    if (vl != 0) {
        t.vl[0]        = quantity.Bound{when: requirement.NO_ALTERNATIVES, least: vl, most: vl};
        t.qs[0].bounds = quantity.Bounds{at: ?t.vl[0], len: 1};
    }
    if (svl != 0) {
        t.svl[0]       = quantity.Bound{when: requirement.NO_ALTERNATIVES, least: svl, most: svl};
        t.qs[1].bounds = quantity.Bounds{at: ?t.svl[0], len: 1};
    }
    t.file.quantities = quantity.Quantities{at: ?t.qs[0], len: 2};
    val opened: res[state.Context, state.Opened] = state.open(testing.allocator_of(?t.t), ?t.file, ?t.s, ?aarch64_extension.AXES, start, ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx    = opened.ok;
    t.out    = vector.init[u8](testing.allocator_of(?t.t));
    t.fixups = vector.init[field.Fixup](testing.allocator_of(?t.t));
    ret true;
}

# a test over the extensions and axis values of alternative `alt` of a requirement, vl and svl free
#[testing]
fun t_make_for(t: *T, alt: requirement.Alternative) bool {
    var start: state.Settings = state.initial(?aarch64_extension.AXES);
    var i:     u32            = 0;
    for (i < alt.all.len) {
        val placed: opt[state.Placed] = state.place(?aarch64_extension.CATALOG, ?aarch64_extension.AXES, alt.all.at[i]);
        if (sel placed.some) { start.at[placed.some.axis] = placed.some.value; }
        i = i + 1;
    }
    ret t_open(t, alt.all, start, 0, 0);
}

# the most extensions a row's test selection names
#[testing]
val T_IDS: u32 = 32;

# a test over alternative `alt` of row `r`'s requirement and what the first class of each of its register operands
# requires where the alternative does not bring it, as sha1c's v registers need simd beside sha1, which arm's feature
# model does not imply
#[testing]
fun t_make_row(t: *T, r: *row.Row, alt: requirement.Alternative) bool {
    if (!t_make_for(t, alt)) { ret false; }
    var ids:   [T_IDS]requirement.Id;
    var count: u32 = 0;
    for (count < alt.all.len) {
        if (count >= T_IDS) { ret false; }
        ids[count] = alt.all.at[count];
        count      = count + 1;
    }
    val given: u32 = count;
    var k:     u32 = 0;
    for (k < r.operands.len) {
        val shape: *operand.Shape    = ?r.operands.at[k].shape;
        var reg:   *operand.Register = nil;
        if (sel shape.register) { reg = ?shape.register; }
        if (sel shape.list)     { reg = ?shape.list.member; }
        if (reg != nil) {
            val held: err[register.Absent] = register.admitted(?t.v, register.make(reg.classes.at[0], reg.first::u16));
            if (sel held.err) {
                if (sel held.err.unavailable) {
                    val needs: requirement.Requirement = held.err.unavailable.requires;
                    if (needs.len == 0) { ret false; }
                    var i: u32 = 0;
                    for (i < needs.at[0].all.len) {
                        if (count >= T_IDS) { ret false; }
                        ids[count] = needs.at[0].all.at[i];
                        count      = count + 1;
                        i          = i + 1;
                    }
                }
            }
        }
        k = k + 1;
    }
    if (count == given) { ret true; }
    ret t_make_for(t, requirement.Alternative{all: requirement.Ids{at: ?ids[0], len: count}, none: alt.none});
}

# a test over armv9-a with `features`, streaming at `streaming` and dit at `dit`, vl at multiplier 2 and svl at `svl`
#[testing]
fun t_make(t: *T, features: *requirement.Id, count: u32, streaming: u8, dit: u8, svl: u32) bool {
    var start: state.Settings = state.initial(?aarch64_extension.AXES);
    start.at[0] = streaming;
    start.at[1] = dit;
    ret t_open(t, requirement.Ids{at: features, len: count}, start, 2, svl);
}

#[testing]
fun t_encode(t: *T, r: *row.Row, values: *operand.Value) res[usize, field.Refusal] {
    var ins: inst.Inst = inst.Inst{row: r, values: values, count: r.operands.len};
    t.out.len = 0;
    ret walk.encode(?CODEC, ?t.ctx, ?ins, ?t.out, ?t.fixups);
}

#[testing]
fun t_operand_refused(got: res[usize, field.Refusal]) u8 {
    if (sel got.err) { ret got.err.operand; }
    ret field.NO_OPERAND;
}

# the largest value `imm` holds, its scale's multiple, less `k` steps of the scale
#[testing]
fun t_immediate(imm: *operand.Immediate, k: u32) i64 {
    var top: i64 = field.ones(imm.bits)::i64;
    if (imm.sign == operand.SIGNED) { top = (1::i64 << (imm.bits - 1)::i64) - 1; }
    val step: i64 = 1::i64 << imm.scale::i64;
    top = top - (top % step);
    ret top - k::i64 * step + imm.bias;
}

# the value of operand `desc` at try `k`: registers from the top of the range down, immediates from the largest down by
# their scale, enumerants from the last member
#[testing]
fun t_value(desc: *operand.Operand, k: u32, room: *operand.Value) opt[operand.Value] {
    val shape: *operand.Shape = ?desc.shape;
    if (sel shape.register) {
        val r:     *operand.Register = ?shape.register;
        val class: u16               = r.classes.at[0];
        val count: u32               = register.count_most(?aarch64_register.FILE, class)::u32;
        val span:  u32               = operand.span(r, count);
        if (k >= span) { ret opt[operand.Value].none{}; }
        ret opt[operand.Value].some{operand.Value.register{register.make(class, (r.first + span - 1 - k)::u16)}};
    }
    if (sel shape.immediate) {
        # a float from 1.0 up by sixteenths, which every 8-bit float immediate holds
        if (shape.immediate.format == operand.FLOAT) {
            if (k >= 16) { ret opt[operand.Value].none{}; }
            var one:  u64 = 0x3FF0000000000000;
            var step: u64 = 48;
            if (shape.immediate.bits == 32) {
                one  = 0x3F800000;
                step = 19;
            }
            or (shape.immediate.bits == 16) {
                one  = 0x3C00;
                step = 6;
            }
            ret opt[operand.Value].some{operand.Value.immediate{(one | (k::u64 << step))::i64}};
        }
        ret opt[operand.Value].some{operand.Value.immediate{t_immediate(?shape.immediate, k)}};
    }
    if (sel shape.relative) { ret opt[operand.Value].some{operand.Value.relative{t_immediate(?shape.relative.offset, k)}}; }
    if (sel shape.list) {
        # a list from the k-th register of its member range, each member a stride after the one before
        val l:     *operand.List = ?shape.list;
        val class: u16           = l.member.classes.at[0];
        val count: u32           = register.count_most(?aarch64_register.FILE, class)::u32;
        val span:  u32           = operand.span(?l.member, count);
        if (k >= span || l.max::u32 > T_MEMBERS) { ret opt[operand.Value].none{}; }
        var i: u32 = 0;
        for (i < l.max::u32) {
            val n: u32 = l.member.first + (k + i * operand.step(l)::u32) % span;
            room[i] = operand.Value.register{register.make(class, n::u16)};
            i       = i + 1;
        }
        ret opt[operand.Value].some{operand.Value.list{operand.Values{at: room, len: l.max::u32}}};
    }
    if (sel shape.enumerant) {
        val e: *operand.Enumeration = ?shape.enumerant;
        if (k >= e.count) { ret opt[operand.Value].none{}; }
        ret opt[operand.Value].some{operand.Value.enumerant{operand.Chosen{value: e.members[e.count - 1 - k].value, params: operand.NO_VALUES}}};
    }
    ret opt[operand.Value].none{};
}

# row `r` encoded into `t.out` with values it admits, found from each operand's first value by taking a refused operand's
# next value until every operand is admitted, 0 on success and the step that failed otherwise
#[testing]
fun t_admitted(t: *T, r: *row.Row, values: *operand.Value) i32 {
    var tries: [row.MAX_OPERANDS]u32;
    var k:     u32 = 0;
    for (k < r.operands.len) {
        tries[k] = 0;
        val first: opt[operand.Value] = t_value(?r.operands.at[k], 0, ?t.lists[k * T_MEMBERS]);
        if (sel first.none) { ret 2; }
        values[k] = first.some;
        k         = k + 1;
    }
    var wrote: res[usize, field.Refusal] = t_encode(t, r, values);
    var left:  u32                       = 4096;
    for (sel wrote.err && left > 0) {
        val op: u8 = t_operand_refused(wrote);
        if (op == field.NO_OPERAND || op::u32 >= r.operands.len) { ret 3; }
        tries[op] = tries[op] + 1;
        val next: opt[operand.Value] = t_value(?r.operands.at[op], tries[op], ?t.lists[op::u32 * T_MEMBERS]);
        if (sel next.none) { ret 4; }
        values[op] = next.some;
        wrote      = t_encode(t, r, values);
        left       = left - 1;
    }
    if (sel wrote.err) { ret 5; }
    ret 0;
}

# every row, under each alternative of its requirement and what its registers need beside it, encodes values it admits
# and decodes back to itself and them
test walk__every_row_encodes_and_decodes_back_to_itself {
    var i: u32 = 0;
    for (i < CODEC.rows.len) {
        val r: *row.Row = ?CODEC.rows.at[i];
        var a: u32      = 0;
        for (a < r.requires.len) {
            var t: T;
            if (!t_make_row(?t, r, r.requires.at[a])) { ret 1; }
            var values:  [row.MAX_OPERANDS]operand.Value;
            val written: i32 = t_admitted(?t, r, ?values[0]);
            if (written != 0) { ret written; }
            var store: [32]operand.Value;
            var room:  [8]requirement.Alternative;
            var alts:  field.Admissions                 = field.Admissions{at: ?room[0], cap: 8, used: 0};
            val got:   res[walk.Decoded, field.Refusal] = walk.decode(?CODEC, ?t.ctx, t.out.data, t.out.len, 0, ?store[0], 32, ?alts);
            if (sel got.err)             { ret 6; }
            if (got.ok.inst.row != r)    { ret 7; }
            if (got.ok.len != t.out.len) { ret 8; }
            var k: u32 = 0;
            for (k < r.operands.len) {
                if (!operand.equal(?store[k], ?values[k])) { ret 9; }
                k = k + 1;
            }
            a = a + 1;
        }
        i = i + 1;
    }
    ret 0;
}

# the class named `name`
#[testing]
fun t_class(name: str) u16 {
    val got: opt[u16] = register.class_named(?aarch64_register.FILE, name);
    if (sel got.none) { ret 0xFFFF; }
    ret got.some;
}

# register `n` of the class named `class`
#[testing]
fun t_id(class: str, n: u16) register.Id {
    ret register.make(t_class(class), n);
}

# register `n` of the class named `class` as an operand's value
#[testing]
fun t_reg(class: str, n: u16) operand.Value {
    ret operand.Value.register{t_id(class, n)};
}

# whether row `r` with `values` is refused under `t`
#[testing]
fun t_refused(t: *T, r: *row.Row, values: *operand.Value) bool {
    val got: res[usize, field.Refusal] = t_encode(t, r, values);
    ret sel got.err;
}

# whether `t.out` holds exactly the four bytes `b0` to `b3`
#[testing]
fun t_wrote(t: *T, b0: u8, b1: u8, b2: u8, b3: u8) bool {
    ret t.out.len == 4 && (t.out.data[0] == b0 && t.out.data[1] == b1 && t.out.data[2] == b2 && t.out.data[3] == b3);
}

# whether row `r` with `values` encodes to the four bytes `b0` to `b3` under `t`
#[testing]
fun t_encodes(t: *T, r: *row.Row, values: *operand.Value, b0: u8, b1: u8, b2: u8, b3: u8) bool {
    val got: res[usize, field.Refusal] = t_encode(t, r, values);
    ret sel got.ok && t_wrote(t, b0, b1, b2, b3);
}

# the width of register `reg` in the test's view, 0 when the view leaves it free or does not hold it
#[testing]
fun t_width(t: *T, reg: register.Id) u64 {
    val w: res[opt[u64], register.Absent] = register.width(?t.v, reg);
    if (sel w.err)     { ret 0; }
    if (sel w.ok.none) { ret 0; }
    ret w.ok.some;
}

# a z register of an sve row is as wide as vl outside streaming mode and as svl in it: `add z0.s, z1.s, z2.s` encodes as
# llvm-mc 23.1.1 writes it under sve outside streaming mode and under sme in it, and is refused in streaming mode
# without sme and outside it without sve
test streaming__an_sve_row_takes_vl_outside_streaming_mode_and_svl_in_it {
    var sve:    [1]requirement.Id = [1]requirement.Id{gen_extension.SVE};
    var sme:    [1]requirement.Id = [1]requirement.Id{gen_extension.SME};
    var values: [3]operand.Value  = [3]operand.Value{t_reg("z", 0), t_reg("z", 1), t_reg("z", 2)};
    var t:      T;
    if (!t_make(?t, ?sve[0], 1, 0, 0, 4))                                        { ret 1; }
    if (!t_encodes(?t, gen_row.ADD_Z_ZZ__S, ?values[0], 0x20, 0x00, 0xa2, 0x04)) { ret 2; }
    if (t_width(?t, t_id("z", 0)) != 256)                                        { ret 3; }
    if (!t_make(?t, ?sme[0], 1, 1, 0, 4))                                        { ret 4; }
    if (!t_encodes(?t, gen_row.ADD_Z_ZZ__S, ?values[0], 0x20, 0x00, 0xa2, 0x04)) { ret 5; }
    if (t_width(?t, t_id("z", 0)) != 512)                                        { ret 6; }
    if (!t_make(?t, ?sme[0], 1, 0, 0, 4))                                        { ret 7; }
    if (!t_refused(?t, gen_row.ADD_Z_ZZ__S, ?values[0]))                         { ret 8; }
    if (!t_make(?t, ?sve[0], 1, 1, 0, 4))                                        { ret 9; }
    if (!t_refused(?t, gen_row.ADD_Z_ZZ__S, ?values[0]))                         { ret 10; }
    ret 0;
}

# the move of a z register into a za tile slice exists only in streaming mode, and its tile is as wide as svl, whose
# slices number with it: `mova za1v.s[w13, 3], p1/m, z2.s` and `mova za0h.s[w12, 0], p0/m, z0.s` encode as llvm-mc
# 23.1.1 writes their `mov` alias, under an svl of 128 bits and of 512, where za.s has 16 and then 64 slices each way
test streaming__a_za_slice_move_exists_in_streaming_mode_and_its_slices_scale_with_svl {
    var sme:   [1]requirement.Id = [1]requirement.Id{gen_extension.SME};
    var v:     [6]operand.Value  = [6]operand.Value{t_reg("zas", 1), operand.Value.enumerant{operand.Chosen{value: 1, params: operand.NO_VALUES}}, t_reg("w", 13), operand.Value.immediate{3}, t_reg("p", 1), t_reg("z", 2)};
    var h:     [6]operand.Value  = [6]operand.Value{t_reg("zas", 0), operand.Value.enumerant{operand.Chosen{value: 0, params: operand.NO_VALUES}}, t_reg("w", 12), operand.Value.immediate{0}, t_reg("p", 0), t_reg("z", 0)};
    val sizes: [2]u32            = [2]u32{1, 4};
    var i:     u32               = 0;
    for (i < 2) {
        var t: T;
        if (!t_make(?t, ?sme[0], 1, 1, 0, sizes[i]))                               { ret 1; }
        if (!t_encodes(?t, gen_row.MOVA_ZA_P_RZ_W, ?v[0], 0x47, 0xa4, 0x80, 0xc0)) { ret 2; }
        if (!t_encodes(?t, gen_row.MOVA_ZA_P_RZ_W, ?h[0], 0x00, 0x00, 0x80, 0xc0)) { ret 3; }
        if (t_width(?t, t_id("zas", 1)) != 128 * sizes[i]::u64)                    { ret 4; }
        if (register.members(?t.v, t_class("zash")) != 16 * sizes[i]::u64)         { ret 5; }
        if (register.members(?t.v, t_class("zasv")) != 16 * sizes[i]::u64)         { ret 6; }
        if (!t_make(?t, ?sme[0], 1, 0, 0, sizes[i]))                               { ret 7; }
        if (!t_refused(?t, gen_row.MOVA_ZA_P_RZ_W, ?v[0]))                         { ret 8; }
        i = i + 1;
    }
    ret 0;
}

# a data independent time row depends on no input only under dit=on, and `msr dit, #1`, which turns it on, encodes as
# llvm-mc 23.1.1 writes it, as does `msr dit, #0`
test ct__a_dit_row_is_independent_only_under_dit_on {
    var held: [3]requirement.Id = [3]requirement.Id{gen_extension.SVE, gen_extension.SME, gen_extension.DIT};
    var on:   operand.Value     = operand.Value.immediate{1};
    var off:  operand.Value     = operand.Value.immediate{0};
    var t:    T;
    if (!t_make(?t, ?held[0], 3, 0, 0, 1))                                       { ret 1; }
    if (ct.independent(gen_row.ADD_Z_ZZ__S.ct, ?t.ctx))                          { ret 2; }
    if (!t_encodes(?t, gen_row.MSR_SI_PSTATE_DIT, ?on, 0x5f, 0x41, 0x03, 0xd5))  { ret 3; }
    if (!t_encodes(?t, gen_row.MSR_SI_PSTATE_DIT, ?off, 0x5f, 0x40, 0x03, 0xd5)) { ret 4; }
    if (!t_make(?t, ?held[0], 3, 0, 1, 1))                                       { ret 5; }
    if (!ct.independent(gen_row.ADD_Z_ZZ__S.ct, ?t.ctx))                         { ret 6; }
    if (ct.independent(gen_row.MSR_SI_PSTATE_DIT.ct, ?t.ctx))                    { ret 7; }
    if (!t_make(?t, ?held[0], 3, 1, 1, 1))                                       { ret 8; }
    if (!ct.independent(gen_row.MOVA_ZA_P_RZ_W.ct, ?t.ctx))                      { ret 9; }
    ret 0;
}
