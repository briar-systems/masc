# the aarch64 set's registration record
#
# one record for aarch64, arm64e and arm64ec: each architecture enters outside streaming mode with dit clear, the catalog's rows admit a
# selection by their requirements, and the register file scales z and p by the streaming state. the record only names
# the pieces, each the owner of its own tables.

use std.types.bool.false;
use std.types.string.str;

use arch_aarch64: mink.catalog.arch.aarch64;
use mink_trait:   mink.catalog.trait;

use masc.core.compress;
use masc.core.ct;
use masc.core.fixup;
use masc.core.mode;
use masc.core.operand;
use masc.core.set;
use masc.core.syntax;
use masc.core.trait;

use aarch64_catalog:   masc.isa.aarch64.catalog;
use aarch64_extension: masc.isa.aarch64.extension;
use aarch64_fixup:     masc.isa.aarch64.fixup;
use aarch64_source:    masc.isa.aarch64.source;
use aarch64_syntax:    masc.isa.aarch64.syntax;

use masc.isa.aarch64.gen_relax;

# the gnu property note's bti, pac and gcs bits claim that every indirect target of the object's code has a landing pad,
# that its returns are signed and that it keeps a guarded control stack, which the selection holding the features does
# not make so
val NO_NOTE: str = "the compiler writes the GNU property note itself, so the assembler writes none whatever the selection";

# the source owns the gnu property bits (aaelf64, "GNU Program Property"), off unless the source states the note. the
# pointer authentication platform and version are the caller's abi convention, never the set's
val OWNERS: [3]trait.Owned = [3]trait.Owned{
    trait.Owned{axis: ?arch_aarch64.AARCH64_BTI, owner: trait.Owner.source{trait.Default{setting: mink_trait.Setting.flag{false}, cites: NO_NOTE}}},
    trait.Owned{axis: ?arch_aarch64.AARCH64_PAC, owner: trait.Owner.source{trait.Default{setting: mink_trait.Setting.flag{false}, cites: NO_NOTE}}},
    trait.Owned{axis: ?arch_aarch64.AARCH64_GCS, owner: trait.Owner.source{trait.Default{setting: mink_trait.Setting.flag{false}, cites: NO_NOTE}}},
};

# the registration of aarch64
pub val SET: set.Set = set.Set{
    arches:      set.Arches{at: ?aarch64_extension.ARCHES[0], len: aarch64_extension.ARCH_COUNT},
    states:      aarch64_extension.AXES,
    codec:       ?aarch64_catalog.CODEC,
    extensions:  ?aarch64_extension.CATALOG,
    bindings:    fixup.Bindings{at: ?aarch64_fixup.BINDINGS[0], len: aarch64_fixup.COUNT},
    locals:      fixup.Locals{at: ?aarch64_fixup.LOCALS[0], len: aarch64_fixup.LOCAL_COUNT},
    relax:       gen_relax.RELAXATIONS,
    compress:    compress.NO_COMPRESSIONS,
    fill:        ?gen_relax.FILL,
    realign:     operand.NO_FIXUP,
    data:        fixup.Data{at: ?aarch64_fixup.DATA[0], len: aarch64_fixup.DATA_COUNT},
    spans:       fixup.NO_SPANS,
    syntaxes:    syntax.Syntaxes{at: ?aarch64_syntax.SYNTAX, len: 1},
    traits:      trait.Owners{at: ?OWNERS[0], len: 3},
    conventions: set.NO_CONVENTIONS,
    assembly:    mode.NO_MODES,
    pairs:       fixup.NO_PAIRS,
    source:      aarch64_source.SOURCE,
    parcel:      aarch64_source.parcel,
    config:      nil,
    ct:          ct.Timing.rows{},
    folds:       fixup.NO_FOLDS,
    parts:       fixup.Parts{at: ?aarch64_fixup.PARTS[0], len: aarch64_fixup.PART_COUNT},
};
