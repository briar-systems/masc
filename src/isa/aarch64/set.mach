# the aarch64 set's registration record
#
# one record for aarch64: the architecture enters outside streaming mode with dit clear, the catalog's rows admit a
# selection by their requirements, and the register file scales z and p by the streaming state. the record only names
# the pieces, each the owner of its own tables.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.testing;

use mink.base.fail;
use mink.base.store;
use arch_aarch64: mink.catalog.arch.aarch64;
use mink_trait:   mink.catalog.trait;
use mink.format.registry;
use mink_object: mink.model.object;
use mink.model.reloc;

use masc.asm.asm;
use masc.asm.model;
use masc.core.compress;
use masc.core.ct;
use masc.core.diagnostic;
use masc.core.extension;
use masc.core.field;
use masc.core.fixup;
use masc.core.mode;
use masc.core.operand;
use masc.core.register;
use masc.core.set;
use masc.core.state;
use masc.core.syntax;
use masc.core.trait;
use masc.format.dialect;

use aarch64_catalog:   masc.isa.aarch64.catalog;
use aarch64_extension: masc.isa.aarch64.extension;
use aarch64_fixup:     masc.isa.aarch64.fixup;
use aarch64_source:    masc.isa.aarch64.source;
use aarch64_syntax:    masc.isa.aarch64.syntax;

use masc.isa.aarch64.gen_relax;

# the gnu property note's bti, pac and gcs bits claim that every indirect target of the object's code has a landing pad,
# that its returns are signed and that it keeps a guarded control stack, which the selection holding the features does
# not make so
val NO_NOTE: str = "llvm-mc 23.1.1 writes no GNU property note whatever the selection, and a compiler writes the note itself";

# the source owns the gnu property bits (aaelf64, "GNU Program Property"), off unless the source states the note. the
# pointer authentication platform and version are the caller's abi convention, never the set's
val OWNERS: [3]trait.Owned = [3]trait.Owned{
    trait.Owned{axis: ?arch_aarch64.AARCH64_BTI, owner: trait.Owner.source{trait.Default{setting: mink_trait.Setting.flag{false}, cites: NO_NOTE}}},
    trait.Owned{axis: ?arch_aarch64.AARCH64_PAC, owner: trait.Owner.source{trait.Default{setting: mink_trait.Setting.flag{false}, cites: NO_NOTE}}},
    trait.Owned{axis: ?arch_aarch64.AARCH64_GCS, owner: trait.Owner.source{trait.Default{setting: mink_trait.Setting.flag{false}, cites: NO_NOTE}}},
};

# the registration of aarch64
pub val SET: set.Set = set.Set{
    arches:      set.Arches{at: ?aarch64_extension.ARCHES[0], len: 1},
    states:      aarch64_extension.AXES,
    codec:       ?aarch64_catalog.CODEC,
    extensions:  ?aarch64_extension.CATALOG,
    bindings:    fixup.Bindings{at: ?aarch64_fixup.BINDINGS[0], len: aarch64_fixup.COUNT},
    locals:      fixup.Locals{at: ?aarch64_fixup.LOCALS[0], len: aarch64_fixup.LOCAL_COUNT},
    relax:       gen_relax.RELAXATIONS,
    compress:    compress.NO_COMPRESSIONS,
    fill:        ?gen_relax.FILL,
    realign:     operand.NO_FIXUP,
    data:        fixup.Data{at: ?aarch64_fixup.DATA[0], len: aarch64_fixup.DATA_COUNT},
    spans:       fixup.NO_SPANS,
    syntaxes:    syntax.Syntaxes{at: ?aarch64_syntax.SYNTAX, len: 1},
    traits:      trait.Owners{at: ?OWNERS[0], len: 3},
    conventions: set.NO_CONVENTIONS,
    assembly:    mode.NO_MODES,
    pairs:       fixup.NO_PAIRS,
    source:      aarch64_source.SOURCE,
    parcel:      aarch64_source.parcel,
    config:      nil,
    ct:          ct.Timing.rows{},
    folds:       fixup.NO_FOLDS,
};

# a test's allocator, selection, register view, context and object formats
#[testing]
rec T {
    t:       testing.Testing;
    s:       extension.Selection;
    v:       register.Available;
    ctx:     state.Context;
    formats: registry.Registry;
}

# the test's context of the selection `isa` spells
#[testing]
fun t_make(t: *T, isa: str) bool {
    testing.make(?t.t);
    val a:       *A.Allocator                      = testing.allocator_of(?t.t);
    val formats: res[registry.Registry, fail.Fail] = registry.builtin(a);
    if (sel formats.err) { ret false; }
    t.formats = formats.ok;
    val made: res[extension.Selection, extension.Error] = extension.select(a, ?aarch64_extension.CATALOG, isa, diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    val opened: res[state.Context, state.Opened] = set.open(a, ?SET, ?SET.arches.at[0], ?t.s, ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx = opened.ok;
    ret true;
}

# `text` assembled for aarch64 under aapcs64, whose row moves no encoding or trait
#[testing]
fun t_assemble(t: *T, text: str) res[mink_object.Object, model.Refusal] {
    val options: model.Options = model.Options{arch: ?arch_aarch64.AARCH64, formats: ?t.formats, syntax: 0, abi: ?arch_aarch64.AARCH64_AAPCS64, dialect: ?dialect.ELF, layers: model.NO_LAYERS, modes: mode.NO_SETTINGS};
    ret asm.assemble(testing.allocator_of(?t.t), ?SET, ?t.ctx, options, text, str_len(text), diagnostic.START);
}

# everything the test made given back, and whether nothing is left live
#[testing]
fun t_release(t: *T) bool {
    register.release(?t.v);
    extension.release(?t.s);
    val released: err[fail.Fail] = registry.release(?t.formats);
    ret !sel released.err && testing.live_count(?t.t) == 0;
}

# whether `.text` of `o` is `len` bytes long, its first `n` the bytes at `want`
#[testing]
fun t_begins(o: *mink_object.Object, want: *u8, n: usize, len: usize) bool {
    var i: usize = 0;
    for (i < o.sections.count) {
        val got: store.Bytes = mink_object.bytes(o, ?o.sections.items[i].contents);
        if (got.len == len) {
            var k:    usize = 0;
            var same: bool  = true;
            for (k < n) {
                if (got.data[k] != want[k]) { same = false; }
                k = k + 1;
            }
            if (same) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# whether `o` relocates `offset` by kind `kind`
#[testing]
fun t_relocates(o: *mink_object.Object, offset: u64, kind: *reloc.Kind) bool {
    var i: usize = 0;
    for (i < o.relocs.count) {
        if (o.relocs.items[i].offset == offset && o.relocs.items[i].kind == kind) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `got` was refused at `line`, with `message` unless it is nil, an object it made released
#[testing]
fun t_refused(got: *res[mink_object.Object, model.Refusal], message: str, line: u32) bool {
    if (sel got.ok) {
        mink_object.release(?got.ok);
        ret false;
    }
    ret (message == nil || str_equals(got.err.message, message)) && got.err.span.start.line == line;
}

# a symbol's page and its low bits for an add and a load of each size, and the page and low bits of its got entry,
# record the relocations llvm-mc 23.1.1 writes for them. the low bits take a symbol by the specifier alone, so a
# register name there is the register, and a bare symbol is refused
test fixup__lo12_and_got_specifiers_record_their_fixups_as_llvm_mc {
    var t: T;
    if (!t_make(?t, "armv8-a")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, "adrp x0, sym\nadd x0, x0, :lo12:sym\nldr x1, [x0, :lo12:sym]\nadrp x2, :got:sym\nldr x2, [x2, :got_lo12:sym]\nldrb w3, [x0, :lo12:sym]\n");
    if (sel got.err) { ret 2; }
    var o:    mink_object.Object = got.ok;
    val want: [24]u8             = [24]u8{0x00, 0x00, 0x00, 0x90, 0x00, 0x00, 0x00, 0x91, 0x01, 0x00, 0x40, 0xf9, 0x02, 0x00, 0x00, 0x90, 0x42, 0x00, 0x40, 0xf9, 0x03, 0x00, 0x40, 0x39};
    if (!t_begins(?o, ?want[0], 24, 24))                                                    { ret 3; }
    if (!t_relocates(?o, 0, ?reloc.PAGE21) || !t_relocates(?o, 4, ?reloc.LO12_ADD))         { ret 4; }
    if (!t_relocates(?o, 8, ?reloc.LO12_LDST64) || !t_relocates(?o, 12, ?reloc.GOT_PAGE21)) { ret 5; }
    if (!t_relocates(?o, 16, ?reloc.GOT_LO12) || !t_relocates(?o, 20, ?reloc.LO12_LDST8))   { ret 6; }
    mink_object.release(?o);
    var regs: res[mink_object.Object, model.Refusal] = t_assemble(?t, "add x1, x2, x3\n");
    if (sel regs.err) { ret 7; }
    val add: [4]u8 = [4]u8{0x41, 0x00, 0x03, 0x8b};
    if (!t_begins(?regs.ok, ?add[0], 4, 4) || regs.ok.relocs.count != 0) { ret 8; }
    mink_object.release(?regs.ok);
    var bare: res[mink_object.Object, model.Refusal] = t_assemble(?t, "nop\nadd x0, x0, sym\n");
    if (!t_refused(?bare, nil, 2)) { ret 9; }
    if (!t_release(?t))            { ret 10; }
    ret 0;
}

# a tbz whose target is past its 32KB becomes the inverted tbnz past a b to the target, and one that reaches stays
test relax__an_out_of_range_tbz_relaxes_to_an_inverted_pair {
    var t: T;
    if (!t_make(?t, "armv8-a")) { ret 1; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, "tbz x0, #3, far\n.skip 40000\nfar:\nnop\n");
    if (sel got.err) { ret 2; }
    var o: mink_object.Object = got.ok;
    # tbnz w0, #3, .+8 and b .+40004, as llvm-mc 23.1.1 encodes them
    val want: [8]u8 = [8]u8{0x40, 0x00, 0x18, 0x37, 0x11, 0x27, 0x00, 0x14};
    if (!t_begins(?o, ?want[0], 8, 40012)) { ret 3; }
    mink_object.release(?o);
    var near: res[mink_object.Object, model.Refusal] = t_assemble(?t, "tbz x0, #3, there\nthere:\nnop\n");
    if (sel near.err) { ret 4; }
    var p:    mink_object.Object = near.ok;
    val kept: [4]u8              = [4]u8{0x20, 0x00, 0x18, 0x36};
    if (!t_begins(?p, ?kept[0], 4, 8)) { ret 5; }
    mink_object.release(?p);
    # b.al has no inverse, so out of range it is refused
    var always: res[mink_object.Object, model.Refusal] = t_assemble(?t, "b.al far\n.skip 0x100004\nfar:\n");
    if (sel always.ok) {
        mink_object.release(?always.ok);
        ret 6;
    }
    if (!t_release(?t)) { ret 7; }
    ret 0;
}

# `.arch_extension` admits a row the selection did not, and `no` takes it away again with what needs it, `.arch` and
# `.cpu` restate the selection by an architecture and a processor, and `.inst` states words, as llvm-mc 23.1.1 reads them
test source__the_directives_edit_the_selection_and_state_encodings_as_llvm_mc {
    var t: T;
    if (!t_make(?t, "armv8-a+fp+simd")) { ret 1; }
    var before: res[mink_object.Object, model.Refusal] = t_assemble(?t, "add z0.s, z1.s, z2.s\n");
    if (!t_refused(?before, nil, 1)) { ret 2; }
    var after: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".arch_extension sve2\nsqabs z0.s, p0/m, z1.s\n.arch_extension nosve\nadd z0.s, z1.s, z2.s\n");
    if (!t_refused(?after, nil, 4)) { ret 3; }
    var unknown: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".arch_extension armv9-a\n");
    if (!t_refused(?unknown, model.UNKNOWN_EXTENSION, 1)) { ret 4; }
    var cpu: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".cpu generic+crc\ncrc32b w0, w1, w2\nldaprb w0, [x1]\n");
    if (!t_refused(?cpu, field.NOT_ADMITTED, 3)) { ret 5; }
    var arch: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".arch cortex-a76\n");
    if (!t_refused(?arch, extension.OTHER_KIND, 1)) { ret 6; }
    var got: res[mink_object.Object, model.Refusal] = t_assemble(?t, ".arch_extension sve\nadd z0.s, z1.s, z2.s\n.cpu cortex-a76\nldaprb w0, [x1]\n.arch armv8.3-a\nldaprb w0, [x1]\n.inst 0xd503201f, 0x8b020020\n");
    if (sel got.err) { ret 7; }
    var o:    mink_object.Object = got.ok;
    val want: [20]u8             = [20]u8{0x20, 0x00, 0xa2, 0x04, 0x20, 0xc0, 0xbf, 0x38, 0x20, 0xc0, 0xbf, 0x38, 0x1f, 0x20, 0x03, 0xd5, 0x20, 0x00, 0x02, 0x8b};
    if (!t_begins(?o, ?want[0], 20, 20)) { ret 8; }
    mink_object.release(?o);
    if (!t_release(?t)) { ret 9; }
    ret 0;
}
