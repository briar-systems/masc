    core_syntax.Specifier{template: "<0>@TLVPPAGEOFF", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.TLVP_LOAD_PAGEOFF12, fold: nil, formats: MACHO},
    core_syntax.Specifier{template: "<0>@TLVPPAGEOFF", operand: aarch64_fixup.ADD_ABS_LO12_NC, fixup: aarch64_fixup.TLVP_LOAD_PAGEOFF12_ADD, fold: nil, formats: MACHO},
};

pub val SYNTAX: core_syntax.Syntax = core_syntax.Syntax{
    name:       "aarch64",
    forms:      core_syntax.Forms{at: ?gen_syntax.FORM_TEXT[0], len: gen_syntax.FORM_COUNT},
    aliases:    core_syntax.Aliases{at: ?gen_syntax.ALIAS_ROWS[0], len: gen_syntax.ALIAS_COUNT},
    index:      core_syntax.Index{at: ?gen_syntax.ENTRIES[0], len: gen_syntax.ENTRY_COUNT, candidates: ?gen_syntax.CANDIDATES[0], count: gen_syntax.CANDIDATE_COUNT},
    specifiers: core_syntax.Specifiers{at: ?SPECIFIERS[0], len: 62},
    sequences:  core_syntax.NO_SEQUENCES,
    hooks:      core_syntax.Hooks{immediate: ?IMMEDIATE, memory: nil, list: ?LIST, id: nil, literal: nil, register: ?SYSTEM},
    register:   "",
    aliased:    false,
    join:       "",
    variadic:   ", ",
    fold:       true,
    anonymous:  ".Ltmp",
    own:        nil,
    statement:  nil,
    number:     "#",
};

pub val LIST_ELEMENT: str = "register list member spelled without its list's element";
pub val LIST_RANGE:   str = "register list range ends in another class than it starts";
pub val LIST_LENGTH:  str = "register list holds more members than the operand admits";
pub val NOT_FLOAT:    str = "not a decimal float";
pub val INEXACT:      str = "float not exact at the operand's width";

# the most fraction digits a float is written with, whose value then has at most this many binary places
val PLACES_MOST: u32 = 60;

# the fraction digits every float is written with
val PLACES: u32 = 8;

# the fields of a system register's encoding from its highest, the letter before each, 0 for none, and the most each
# holds, op0 from the 2 of the first system register (DDI 0487, MRS: op0 is 2 + o0)
val SYSTEM_LETTERS: [5]u8  = [5]u8{'s', 0, 'c', 'c', 0};
val SYSTEM_LEAST:   [5]u32 = [5]u32{2, 0, 0, 0, 0};
val SYSTEM_MOST:    [5]u32 = [5]u32{3, 7, 15, 15, 7};
val SYSTEM_BITS:    [5]u32 = [5]u32{1, 3, 4, 4, 3};

# the system register the text at the reader's position spells by its encoding, s<op0>_<op1>_c<n>_c<m>_<op2> without
# regard to case, the reader past it, or none with the reader where it was
fun system_read(r: *core_syntax.Reader) opt[register.Id] {
    var at:     usize = r.at;
    var number: u32   = 0;
    var k:      u32   = 0;
    for (k < 5) {
        if (k > 0) {
            if (at >= r.end || r.text[at] != '_') { ret opt[register.Id].none{}; }
            at = at + 1;
        }
        val letter: u8 = SYSTEM_LETTERS[k];
        if (letter != 0) {
            if (at >= r.end || (r.text[at] | 0x20) != letter) { ret opt[register.Id].none{}; }
            at = at + 1;
        }
        var n:      u32   = 0;
        val digits: usize = at;
        for (at < r.end && r.text[at] >= '0' && r.text[at] <= '9' && n <= SYSTEM_MOST[k]) {
            n  = n * 10 + (r.text[at] - '0')::u32;
            at = at + 1;
        }
        if (at == digits || n < SYSTEM_LEAST[k] || n > SYSTEM_MOST[k]) { ret opt[register.Id].none{}; }
        number = (number << SYSTEM_BITS[k]) | (n - SYSTEM_LEAST[k]);
        k      = k + 1;
    }
    if (at < r.end && read.word(r.text[at])) { ret opt[register.Id].none{}; }
    r.at = at;
    ret opt[register.Id].some{register.make(gen_register.SYSREG_CLASS, number::u16)};
}

# system register `reg`, which no row names, written by its encoding, any other register refused at operand `op`
fun system_write(w: *core_syntax.Writer, reg: register.Id, op: u8) err[field.Refusal] {
    if (register.class_of(reg) != gen_register.SYSREG_CLASS) { ret write.refuse(w, write.NO_SPELLING, op); }
    var number: u32 = register.number_of(reg)::u32;
    var fields: [5]u32;
    var k:      i64 = 4;
    for (k >= 0) {
        fields[k] = (number & ((1::u32 << SYSTEM_BITS[k]) - 1)) + SYSTEM_LEAST[k];
        number    = number >> SYSTEM_BITS[k];
        k         = k - 1;
    }
    var text: [32]u8;
    var at:   usize = 0;
    var j:    u32   = 0;
    for (j < 5) {
        if (j > 0) {
            text[at] = '_';
            at       = at + 1;
        }
        if (SYSTEM_LETTERS[j] != 0) {
            text[at] = SYSTEM_LETTERS[j];
            at       = at + 1;
        }
        if (fields[j] >= 10) {
            text[at] = '1';
            at       = at + 1;
        }
        text[at] = '0' + (fields[j] % 10)::u8;
        at       = at + 1;
        j        = j + 1;
    }
    ret write.bytes(w, ?text[0], at);
}

# the system registers no row names, by their encoding
pub val SYSTEM: core_syntax.RegisterHook = core_syntax.RegisterHook{read: system_read, write: system_write};

# a member of the list at the position, the element `format` after its name
fun member(r: *core_syntax.Reader, format: View, viewed: bool) res[register.Id, diagnostic.Diagnostic] {
    val at:  usize                                   = r.at;
    val reg: res[register.Id, diagnostic.Diagnostic] = read.register_value(r, viewed);
    if (sel reg.err)     { ret reg; }
    if (format.len == 0) { ret reg; }
    if (!read.starts(r, r.at, format.data, format.len) || !read.bounded(r, r.at, format.len, format.data[format.len - 1])) {
        ret res[register.Id, diagnostic.Diagnostic].err{read.refuse(r, LIST_ELEMENT, at, read.token(r, at))};
    }
    r.at = r.at + format.len;
    ret reg;
}

# the members of `last`'s class from the one after `first` up to `last`, which may wrap past the class's last register
fun range(r: *core_syntax.Reader, list: *operand.List, first: register.Id, last: register.Id, at: usize, viewed: bool) err[diagnostic.Diagnostic] {
    val class: u16 = register.class_of(first);
    if (register.class_of(last) != class) { ret err[diagnostic.Diagnostic].err{read.refuse(r, LIST_RANGE, at, r.at - at)}; }
    val n:     u64 = register.count_most(r.codec.registers, class);
    val from:  u64 = register.number_of(first)::u64;
    val count: u64 = (register.number_of(last)::u64 + n - from) % n + 1;
    if (count > list.max::u64) { ret err[diagnostic.Diagnostic].err{read.refuse(r, LIST_LENGTH, at, r.at - at)}; }
    var k: u64 = 1;
    for (k < count) {
        val id: register.Id = register.make(class, ((from + k) % n)::u16);
        if (viewed) {
            val held: err[register.Absent] = register.admitted(r.ctx.view, id);
            if (sel held.err) {
                var refused: diagnostic.Diagnostic = read.refuse(r, field.UNAVAILABLE, at, r.at - at);
                if (sel held.err.unavailable) { refused.requires = held.err.unavailable.requires; }
                ret err[diagnostic.Diagnostic].err{refused};
            }
        }
        val pushed: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, operand.Value.register{id});
        if (sel pushed.err) { ret err[diagnostic.Diagnostic].err{pushed.err}; }
        k = k + 1;
    }
    ret err[diagnostic.Diagnostic].ok{};
}

fun list_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (sel desc.shape.list) { ret listed(r, ?desc.shape.list, format, out); }
    ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))};
}

fun listed(r: *core_syntax.Reader, list: *operand.List, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val viewed: bool                                    = !list.member.unviewed;
    val start:  usize                                   = r.at;
    val first:  res[register.Id, diagnostic.Diagnostic] = member(r, format, viewed);
    if (sel first.err) { ret err[diagnostic.Diagnostic].err{first.err}; }
    val base:   u32                                        = r.used;
    val pushed: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, operand.Value.register{first.ok});
    if (sel pushed.err) { ret err[diagnostic.Diagnostic].err{pushed.err}; }
    var len: u32 = 1;
    for {
        val past: usize = r.at;
        read.skip(r);
        val c: u8 = read.peek(r);
        if (c == '-' && len == 1) {
            r.at = r.at + 1;
            read.skip(r);
            val last: res[register.Id, diagnostic.Diagnostic] = member(r, format, viewed);
            if (sel last.err) { ret err[diagnostic.Diagnostic].err{last.err}; }
            val ranged: err[diagnostic.Diagnostic] = range(r, list, first.ok, last.ok, start, viewed);
            if (sel ranged.err) { ret ranged; }
            len = r.used - base;
            brk;
        }
        if (c != ',') {
            r.at = past;
            brk;
        }
        r.at = r.at + 1;
        read.skip(r);
        if (len >= list.max::u32) { ret err[diagnostic.Diagnostic].err{read.refuse(r, LIST_LENGTH, start, r.at - start)}; }
        val next: res[register.Id, diagnostic.Diagnostic] = member(r, format, viewed);
        if (sel next.err) { ret err[diagnostic.Diagnostic].err{next.err}; }
        val kept: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, operand.Value.register{next.ok});
        if (sel kept.err) { ret err[diagnostic.Diagnostic].err{kept.err}; }
        len = len + 1;
    }
    @out = operand.Value.list{operand.Values{at: pushed.ok, len: len}};
    ret err[diagnostic.Diagnostic].ok{};
}

# whether `members` are three or more registers of one scalable class whose numbers run up by one without wrapping
fun ranged(file: *register.File, members: operand.Values) bool {
    if (members.len < 3 || file == nil) { ret false; }
    val first: *operand.Value = ?members.at[0];
    if (!sel first.register) { ret false; }
    val class: opt[*register.Class] = register.class_row(file, first.register);
    if (sel class.none)            { ret false; }
    if (class.some.width.per == 0) { ret false; }
    var i: u32 = 1;
    for (i < members.len) {
        val m: *operand.Value = ?members.at[i];
        if (!sel m.register)                                                                    { ret false; }
        if (register.class_of(m.register) != register.class_of(first.register))                 { ret false; }
        if (register.number_of(m.register)::u32 != register.number_of(first.register)::u32 + i) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun list_print(w: *core_syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (!sel value.list) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    val members: operand.Values = value.list;
    if (members.len == 0) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    val run: bool = ranged(w.codec.registers, members);
    var i:   u32  = 0;
    for (i < members.len) {
        if (run && i > 0) { i = members.len - 1; }
        val m: *operand.Value = ?members.at[i];
        if (!sel m.register) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
        if (i > 0) {
            var between: str = ", ";
            if (run) { between = " - "; }
            val joined: err[field.Refusal] = write.text(w, between);
            if (sel joined.err) { ret joined; }
        }
        val named: err[field.Refusal] = write.register_name(w, m.register, field.NO_OPERAND);
        if (sel named.err) { ret named; }
        val element: err[field.Refusal] = write.view(w, format);
        if (sel element.err) { ret element; }
        i = i + 1;
    }
    ret err[field.Refusal].ok{};
}

# register lists, comma-separated or as a range
pub val LIST: core_syntax.Hook = core_syntax.Hook{parse: list_parse, print: list_print};

# the bit pattern of `bits`, a binary64 float, at an ieee 754 width of `width` bits, none when it is not exact there
fun narrowed(bits: u64, width: u8) opt[u64] {
    if (width == 64) { ret opt[u64].some{bits}; }
    var exponent: u64 = 5;
    var fraction: u64 = 10;
    if (width == 32) {
        exponent = 8;
        fraction = 23;
    }
    or (width != 16) { ret opt[u64].none{}; }
    val sign:   u64 = (bits >> 63) << (width::u64 - 1);
    val biased: u64 = (bits >> 52) & 0x7FF;
    val low:    u64 = bits & 0xFFFFFFFFFFFFF;
    val top:    u64 = (1::u64 << exponent) - 1;
    if (biased == 0x7FF) {
        if (low != 0) { ret opt[u64].none{}; }
        ret opt[u64].some{sign | (top << fraction)};
    }
    if (biased == 0 && low == 0) { ret opt[u64].some{sign}; }
    if (biased == 0)             { ret opt[u64].none{}; }
    val bias: i64 = (top >> 1)::i64;
    val e:    i64 = biased::i64 - 1023;
    if (e > bias) { ret opt[u64].none{}; }
    val drop: u64 = 52 - fraction;
    if (e >= 1 - bias) {
        if ((low & ((1::u64 << drop) - 1)) != 0) { ret opt[u64].none{}; }
        ret opt[u64].some{sign | ((e + bias)::u64 << fraction) | (low >> drop)};
    }
    # a subnormal at the width: the significand shifted past the width's least exponent
    val shift: u64 = drop + (1 - bias - e)::u64;
    if (shift > 53) { ret opt[u64].none{}; }
    val significand: u64 = low | (1::u64 << 52);
    if ((significand & ((1::u64 << shift) - 1)) != 0) { ret opt[u64].none{}; }
    ret opt[u64].some{sign | (significand >> shift)};
}

# the length of a decimal float at `at`: a sign, digits with an optional point, and an optional exponent
fun float_len(r: *core_syntax.Reader, at: usize) usize {
    var i: usize = at;
    if (i < r.end && (r.text[i] == '-' || r.text[i] == '+')) { i = i + 1; }
    val digits: usize = i;
    for (i < r.end && ((r.text[i] >= '0' && r.text[i] <= '9') || r.text[i] == '.')) {
        i = i + 1;
    }
    if (i == digits) { ret 0; }
    if (i < r.end && (r.text[i] == 'e' || r.text[i] == 'E')) {
        var j: usize = i + 1;
        if (j < r.end && (r.text[j] == '-' || r.text[j] == '+')) { j = j + 1; }
        val exp: usize = j;
        for (j < r.end && r.text[j] >= '0' && r.text[j] <= '9') {
            j = j + 1;
        }
        if (j > exp) { i = j; }
    }
    ret i - at;
}

fun float_parse(r: *core_syntax.Reader, imm: *operand.Immediate, out: *operand.Value) err[diagnostic.Diagnostic] {
    val at:  usize = r.at;
    val len: usize = float_len(r, at);
    if (len == 0 || (at + len < r.end && read.word(r.text[at + len]))) {
        ret err[diagnostic.Diagnostic].err{read.refuse(r, NOT_FLOAT, at, read.token(r, at))};
    }
    val f: res[f64, number.ParseError] = number.parse_f64_len(?r.text[at], len);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{read.refuse(r, NOT_FLOAT, at, len)}; }
    var bits: u64;
    var got:  f64 = f.ok;
    memory.raw_copy(?bits, ?got, 8);
    val exact: opt[u64] = narrowed(bits, imm.bits);
    if (sel exact.none) { ret err[diagnostic.Diagnostic].err{read.refuse(r, INEXACT, at, len)}; }
    r.at = at + len;
    @out = operand.Value.immediate{exact.some:~i64};
    ret err[diagnostic.Diagnostic].ok{};
}

# the float of `width` bits `bits` as its sign, a significand and a binary exponent, none for an infinity or a nan
rec Binary {
    negative:    bool;
    significand: u64;
    exponent:    i64;
}

fun binary(bits: u64, width: u8) opt[Binary] {
    var exponent: u64 = 11;
    var fraction: u64 = 52;
    if (width == 32) {
        exponent = 8;
        fraction = 23;
    }
    or (width == 16) {
        exponent = 5;
        fraction = 10;
    }
    or (width != 64) { ret opt[Binary].none{}; }
    val top:    u64 = (1::u64 << exponent) - 1;
    val biased: u64 = (bits >> fraction) & top;
    val low:    u64 = bits & ((1::u64 << fraction) - 1);
    if (biased == top) { ret opt[Binary].none{}; }
    val bias: i64    = (top >> 1)::i64;
    var b:    Binary = Binary{negative: ((bits >> (width::u64 - 1)) & 1) != 0, significand: low, exponent: 1 - bias - fraction::i64};
    if (biased != 0) {
        b.significand = low | (1::u64 << fraction);
        b.exponent    = biased::i64 - bias - fraction::i64;
    }
    ret opt[Binary].some{b};
}

fun float_print(w: *core_syntax.Writer, imm: *operand.Immediate, value: i64) err[field.Refusal] {
    val got: opt[Binary] = binary(value:~u64, imm.bits);
    if (sel got.none) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    var b: Binary = got.some;
    # the significand shifted to a whole part and a fraction of `places` binary places
    var places: u64 = 0;
    for (b.significand != 0 && (b.significand & 1) == 0 && b.exponent < 0) {
        b.significand = b.significand >> 1;
        b.exponent    = b.exponent + 1;
    }
    if (b.exponent < 0)            { places = (0 - b.exponent)::u64; }
    if (places > PLACES_MOST::u64) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    var whole: u64 = b.significand >> places;
    if (b.exponent > 0) {
        if (b.exponent > 62 || (b.significand >> (63 - b.exponent::u64)) != 0) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
        whole = b.significand << b.exponent::u64;
    }
    var rest: u64 = b.significand & ((1::u64 << places) - 1);
    if (b.negative) {
        val sign: err[field.Refusal] = write.text(w, "-");
        if (sel sign.err) { ret sign; }
    }
    val wrote: err[field.Refusal] = write.decimal(w, whole::i64);
    if (sel wrote.err) { ret wrote; }
    var digits: [60]u8;
    var count:  u32 = 0;
    for (count < PLACES || rest != 0) {
        rest          = rest * 10;
        digits[count] = '0' + (rest >> places)::u8;
        rest          = rest & ((1::u64 << places) - 1);
        count         = count + 1;
    }
    val point: err[field.Refusal] = write.text(w, ".");
    if (sel point.err) { ret point; }
    ret write.bytes(w, ?digits[0], count::usize);
}

# a symbol of an operand whose kind a specifier alone gives, written bare
pub val UNSPECIFIED: str = "symbol here takes a specifier, as `:lo12:`";

fun immediate_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (sel desc.shape.immediate) {
        if (desc.shape.immediate.format == operand.FLOAT) { ret float_parse(r, ?desc.shape.immediate, out); }
    }
    val at: usize = r.at;
    r.specified = false;
    val read_: err[diagnostic.Diagnostic] = expr.IMMEDIATE.parse(r, desc, format, out);
    if (sel read_.err) { ret read_; }
    val v: operand.Value = @out;
    if (!sel v.symbol || !aarch64_fixup.specified(operand.default_fixup(desc))) { ret read_; }
    if (!r.specified)                                                           { ret err[diagnostic.Diagnostic].err{read.refuse(r, UNSPECIFIED, at, r.at - at)}; }
    ret read_;
}

fun immediate_print(w: *core_syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (sel desc.shape.immediate) {
        if (desc.shape.immediate.format == operand.FLOAT) {
            if (!sel value.immediate) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
            ret float_print(w, ?desc.shape.immediate, value.immediate);
        }
    }
    ret expr.IMMEDIATE.print(w, desc, format, value);
}

# immediates and relative targets as the shared expressions, and a float immediate as a decimal number
pub val IMMEDIATE: core_syntax.Hook = core_syntax.Hook{parse: immediate_parse, print: immediate_print};
