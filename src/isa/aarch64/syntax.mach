# the aarch64 assembly syntax, the vendor dialect
#
# every row's template and the index by mnemonic are generated from the
# instruction model's assembly symbols (gen_syntax): the template is the
# model's text in lower case, each symbol the overlay states as an operand a
# hole, and an optional `#` before an immediate a group with no operand. a za
# tile slice spells its tile by its number beside the slice's direction, as
# `za1v.s`, through the `number` format of a register hole.
#
# registers are written by their own names, x29 rather than fp, and read by
# those and their aliases, and mnemonics and names read without regard to case,
# as llvm-mc 23.1.1 reads and writes them.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use check_syntax: masc.check.syntax;

use masc.codec.walk;
use masc.core.diagnostic;
use masc.core.extension;
use masc.core.field;
use masc.core.inst;
use masc.core.mode;
use masc.core.operand;
use masc.core.register;
use masc.core.requirement;
use masc.core.row;
use masc.core.state;
use core_syntax: masc.core.syntax;
use masc.syntax.expr;
use masc.syntax.parse;
use masc.syntax.print;

use aarch64_catalog:   masc.isa.aarch64.catalog;
use aarch64_extension: masc.isa.aarch64.extension;
use aarch64_register:  masc.isa.aarch64.register;

use masc.isa.aarch64.gen_row;
use masc.isa.aarch64.gen_syntax;

# the aarch64 syntax
pub val SYNTAX: core_syntax.Syntax = core_syntax.Syntax{
    name:       "aarch64",
    forms:      core_syntax.Forms{at: ?gen_syntax.FORM_TEXT[0], len: gen_syntax.FORM_COUNT},
    aliases:    core_syntax.NO_ALIASES,
    index:      core_syntax.Index{at: ?gen_syntax.ENTRIES[0], len: gen_syntax.ENTRY_COUNT, candidates: ?gen_syntax.CANDIDATES[0], count: gen_syntax.CANDIDATE_COUNT},
    specifiers: core_syntax.NO_SPECIFIERS,
    sequences:  core_syntax.NO_SEQUENCES,
    hooks:      core_syntax.Hooks{immediate: ?expr.IMMEDIATE, memory: nil, list: nil, id: nil, literal: nil, register: nil},
    register:   "",
    aliased:    false,
    join:       "",
    variadic:   ", ",
    fold:       true,
    anonymous:  ".Ltmp",
    own:        nil,
    statement:  nil,
};

# the parser's and printer's storage over a context of armv9-a with sve, sme and dit
#[testing]
rec T {
    t:          testing.Testing;
    s:          extension.Selection;
    v:          register.Available;
    ctx:        state.Context;
    modes:      mode.State;
    store:      [16]operand.Value;
    admissions: [8]requirement.Alternative;
    out:        vector.Vector[u8];
    fixups:     vector.Vector[field.Fixup];
}

# a test at streaming value `streaming`
#[testing]
fun t_make(t: *T, streaming: u8) bool {
    testing.make(?t.t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t.t), ?aarch64_extension.CATALOG, "armv9-a+sve+sme+dit", diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    var start: state.Settings = state.initial(?aarch64_extension.AXES);
    start.at[0] = streaming;
    val opened: res[state.Context, state.Opened] = state.open(testing.allocator_of(?t.t), ?aarch64_register.FILE, ?t.s, ?aarch64_extension.AXES, start, ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx    = opened.ok;
    t.modes  = mode.initial(?mode.NO_MODES);
    t.out    = vector.init[u8](testing.allocator_of(?t.t));
    t.fixups = vector.init[field.Fixup](testing.allocator_of(?t.t));
    ret true;
}

#[testing]
fun t_resolve(context: ptr, name: View) res[core_syntax.Resolved, str] {
    ret res[core_syntax.Resolved, str].err{"no symbols"};
}

#[testing]
fun t_name(context: ptr, id: u32) View {
    ret view("", 0);
}

#[testing]
val T_SYMBOLS: core_syntax.Symbols = core_syntax.Symbols{context: nil, resolve: t_resolve, name: t_name};

# `text` read in the aarch64 syntax
#[testing]
fun t_parse(t: *T, text: str) res[inst.Inst, diagnostic.Diagnostic] {
    var rd: core_syntax.Reader = core_syntax.Reader{
        text:    text,
        start:   0,
        at:      0,
        end:     str_len(text),
        origin:  diagnostic.START,
        codec:   ?aarch64_catalog.CODEC,
        ctx:     ?t.ctx,
        syntax:  ?SYNTAX,
        modes:   ?t.modes,
        symbols: ?T_SYMBOLS,
        context: nil,
        row:     nil,
        pool:    ?t.store[0],
        cap:     16,
        used:    0,
        bytes:   nil,
        room:    0,
        taken:   0,
        refused: field.Admissions{at: ?t.admissions[0], cap: 8, used: 0},
    };
    ret parse.instruction(?rd);
}

#[testing]
fun t_fits(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# whether `text` reads, encodes as the four bytes `b0` to `b3` and prints back as `want`
#[testing]
fun t_agrees(t: *T, text: str, b0: u8, b1: u8, b2: u8, b3: u8, want: str) bool {
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(t, text);
    if (sel got.err) { ret false; }
    var ins: inst.Inst = got.ok;
    t.out.len = 0;
    val wrote: res[usize, field.Refusal] = walk.encode(?aarch64_catalog.CODEC, ?t.ctx, ?ins, ?t.out, ?t.fixups);
    if (sel wrote.err)                                                                                              { ret false; }
    if (t.out.len != 4 || t.out.data[0] != b0 || t.out.data[1] != b1 || t.out.data[2] != b2 || t.out.data[3] != b3) { ret false; }
    t.out.len = 0;
    var w:       core_syntax.Writer = core_syntax.Writer{out: ?t.out, codec: ?aarch64_catalog.CODEC, ctx: ?t.ctx, syntax: ?SYNTAX, modes: ?t.modes, symbols: ?T_SYMBOLS, context: nil, row: nil};
    val printed: err[field.Refusal] = print.instruction(?w, ?ins);
    if (sel printed.err)                     { ret false; }
    if (!t_fits(vector.push[u8](?t.out, 0))) { ret false; }
    ret str_equals(t.out.data, want);
}

# the GA2 instructions read, encode and print as llvm-mc 23.1.1 assembles them, which spells `mova` by its preferred
# alias `mov` and the pstate field in capitals
test instruction__the_sve_sme_and_dit_rows_agree_with_llvm_mc {
    var t: T;
    if (!t_make(?t, 0))                                                                                              { ret 1; }
    if (!t_agrees(?t, "add z0.s, z1.s, z2.s", 0x20, 0x00, 0xa2, 0x04, "add z0.s, z1.s, z2.s"))                       { ret 2; }
    if (!t_agrees(?t, "msr DIT, #1", 0x5f, 0x41, 0x03, 0xd5, "msr dit, #1"))                                         { ret 3; }
    if (!t_agrees(?t, "msr dit, 0", 0x5f, 0x40, 0x03, 0xd5, "msr dit, #0"))                                          { ret 4; }
    if (!t_make(?t, 1))                                                                                              { ret 5; }
    if (!t_agrees(?t, "mova za1v.s[w13, 3], p1/m, z2.s", 0x47, 0xa4, 0x80, 0xc0, "mova za1v.s[w13, 3], p1/m, z2.s")) { ret 6; }
    if (!t_agrees(?t, "MOVA ZA0H.S[W12, 0], P0/M, Z0.S", 0x00, 0x00, 0x80, 0xc0, "mova za0h.s[w12, 0], p0/m, z0.s")) { ret 7; }
    val refused: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "mova za4v.s[w13, 3], p1/m, z2.s");
    if (!sel refused.err) { ret 8; }
    ret 0;
}

# the template defect of row `r` under form `form`
#[testing]
fun t_defect(r: *row.Row, form: str) opt[str] {
    var descs: [row.MAX_OPERANDS]*operand.Operand;
    var i:     u32 = 0;
    for (i < r.operands.len) {
        descs[i] = ?r.operands.at[i];
        i        = i + 1;
    }
    ret check_syntax.template_defect(?SYNTAX, form, ?descs[0], r.operands.len, 0);
}

# every form writes each operand once, and a tile's number is the one register hole of another format than its name
test forms__every_form_passes_the_template_check_and_a_tile_hole_takes_only_number {
    var i: u32 = 0;
    for (i < SYNTAX.forms.len) {
        val found: opt[str] = t_defect(?aarch64_catalog.CODEC.rows.at[i], SYNTAX.forms.at[i]);
        if (sel found.some) { ret 1; }
        i = i + 1;
    }
    val mova:  *row.Row = gen_row.MOVA_ZA_P_RZ_W;
    val other: opt[str] = t_defect(mova, "mova za<0:digits><1>.s[<2>, <3>], <4>/m, <5>.s");
    if (!(sel other.some && str_equals(other.some, check_syntax.REGISTER_FORMAT))) { ret 2; }
    ret 0;
}
