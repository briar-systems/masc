# the aarch64 assembly syntax, the vendor dialect
#
# every row's template and the index by mnemonic are generated from the
# instruction model's assembly symbols (gen_syntax): the template is the
# model's text in lower case, each symbol the overlay states as an operand a
# hole, and an optional `#` before an immediate a group with no operand. a za
# tile slice spells its tile by its number beside the slice's direction, as
# `za1v.s`, through the `number` format of a register hole.
#
# registers are written by their own names, x29 rather than fp, and read by
# those and their aliases, and mnemonics and names read without regard to case.
#
# a register list hole's format is the element every member carries, as `.16b`,
# empty where its members carry none, as luti4's table pair `{ z16, z17 }`.
# its members read comma-separated or as a range `z0.b - z3.b` of consecutive
# numbers, which may wrap past the class's last register. they are written
# comma-separated, and as a range when the class is scalable and three or more
# members run up without wrapping, as `{ z0.b - z3.b }` and
# `{ v0.16b, v1.16b, v2.16b }`.
#
# a float immediate reads as a decimal number, as `#-1.25` or `#2`, and writes
# with eight places, more when its value needs them, as `#-1.25000000`.
#
# a system register reads by its name, or by its encoding as
# `s3_0_c15_c2_0`, op0, op1, CRn, CRm and op2, which Arm's register model
# gives as the spelling of the implementation defined space, read for any
# encoding. one no row names writes that way.
#
# an operand the page spells by name or by number, as `dsb ish` or `dsb #12`,
# reads either way and writes by name where one names its value, by `#` and
# its decimal number otherwise, as `dsb #12`.

use std.memory;
use number: std.text.parse;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use mink_format: mink.catalog.format;

use masc.core.diagnostic;
use masc.core.field;
use masc.core.operand;
use masc.core.register;
use core_syntax: masc.core.syntax;
use masc.syntax.expr;
use masc.syntax.parse;
use masc.syntax.print;
use masc.syntax.read;
use masc.syntax.write;

use aarch64_fixup: masc.isa.aarch64.fixup;

use masc.isa.aarch64.gen_register;
use masc.isa.aarch64.gen_syntax;

# the aarch64 syntax
# the low twelve bits of a constant, as `:lo12:` takes them from a symbol's address
fun fold_lo12(v: i64) i64 {
    ret v & 0xfff;
}

# the formats whose dialect alone reads the darwin spellings
val MACHO_ONLY: [1]*mink_format.Format = [1]*mink_format.Format{?mink_format.MACHO};
val MACHO:      core_syntax.Formats    = core_syntax.Formats{at: ?MACHO_ONLY[0], len: 1};

# the specifiers read on an add's or a load's or store's twelve bits, on adrp's page and on a move
# wide's sixteen bits (aaelf64, "Static AArch64 relocations" and "Thread-local storage relocations"): `:lo12:`, the
# low bits of the address at each access size, `:got:` the page of the symbol's got entry and `:got_lo12:` its low
# bits, which only a 64-bit load takes, tlsdesc's `:tlsdesc:` page and `:tlsdesc_lo12:` low bits of an add or a 64-bit
# load, initial-exec's `:gottprel:` page and `:gottprel_lo12:` low bits of a 64-bit load, local-exec's tprel and
# local-dynamic's dtprel high and low twelve bits of an add, low twelve of a load or store of each access size, each
# checked or `_nc`, and their move wide groups, and `:abs_g0_nc:`, the absolute low sixteen bits a move wide's symbol
# takes by default. under mach-o its own spellings are read too: `@PAGE` and
# `@PAGEOFF` of every access size, `@GOTPAGE` and `@GOTPAGEOFF` of a 64-bit load, and `@TLVPPAGE` and `@TLVPPAGEOFF`
# of a 64-bit load or an add, in place of a bare page and `:lo12:`. no `@GOTPAGEOFF` is read on an add, so the add form of mach-o's GOT_LOAD_PAGEOFF12 a read object holds has no spelling
val SPECIFIERS: [62]core_syntax.Specifier = [62]core_syntax.Specifier{
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.ADD_ABS_LO12_NC, fixup: aarch64_fixup.ADD_ABS_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.LDST8_LO12_NC, fixup: aarch64_fixup.LDST8_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.LDST16_LO12_NC, fixup: aarch64_fixup.LDST16_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.LDST32_LO12_NC, fixup: aarch64_fixup.LDST32_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.LDST64_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.LDST128_LO12_NC, fixup: aarch64_fixup.LDST128_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":got:<0>", operand: aarch64_fixup.ADR_PREL_PG_HI21, fixup: aarch64_fixup.ADR_GOT_PAGE, fold: nil},
    core_syntax.Specifier{template: ":got_lo12:<0>", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.LD64_GOT_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":tlsdesc:<0>", operand: aarch64_fixup.ADR_PREL_PG_HI21, fixup: aarch64_fixup.TLSDESC_ADR_PAGE21, fold: nil},
    core_syntax.Specifier{template: ":tlsdesc_lo12:<0>", operand: aarch64_fixup.ADD_ABS_LO12_NC, fixup: aarch64_fixup.TLSDESC_ADD_LO12, fold: nil},
    core_syntax.Specifier{template: ":tlsdesc_lo12:<0>", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.TLSDESC_LD64_LO12, fold: nil},
    core_syntax.Specifier{template: ":gottprel:<0>", operand: aarch64_fixup.ADR_PREL_PG_HI21, fixup: aarch64_fixup.TLSIE_ADR_GOTTPREL_PAGE21, fold: nil},
    core_syntax.Specifier{template: ":gottprel_lo12:<0>", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.TLSIE_LD64_GOTTPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":tprel_hi12:<0>", operand: aarch64_fixup.ADD_ABS_LO12_NC, fixup: aarch64_fixup.TLSLE_ADD_TPREL_HI12, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12:<0>", operand: aarch64_fixup.ADD_ABS_LO12_NC, fixup: aarch64_fixup.TLSLE_ADD_TPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12:<0>", operand: aarch64_fixup.LDST8_LO12_NC, fixup: aarch64_fixup.TLSLE_LDST8_TPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12:<0>", operand: aarch64_fixup.LDST16_LO12_NC, fixup: aarch64_fixup.TLSLE_LDST16_TPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12:<0>", operand: aarch64_fixup.LDST32_LO12_NC, fixup: aarch64_fixup.TLSLE_LDST32_TPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12:<0>", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.TLSLE_LDST64_TPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12:<0>", operand: aarch64_fixup.LDST128_LO12_NC, fixup: aarch64_fixup.TLSLE_LDST128_TPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12_nc:<0>", operand: aarch64_fixup.ADD_ABS_LO12_NC, fixup: aarch64_fixup.TLSLE_ADD_TPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12_nc:<0>", operand: aarch64_fixup.LDST8_LO12_NC, fixup: aarch64_fixup.TLSLE_LDST8_TPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12_nc:<0>", operand: aarch64_fixup.LDST16_LO12_NC, fixup: aarch64_fixup.TLSLE_LDST16_TPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12_nc:<0>", operand: aarch64_fixup.LDST32_LO12_NC, fixup: aarch64_fixup.TLSLE_LDST32_TPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12_nc:<0>", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.TLSLE_LDST64_TPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":tprel_lo12_nc:<0>", operand: aarch64_fixup.LDST128_LO12_NC, fixup: aarch64_fixup.TLSLE_LDST128_TPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":tprel_g2:<0>", operand: aarch64_fixup.MOVW_UABS_G0_NC, fixup: aarch64_fixup.TLSLE_MOVW_TPREL_G2, fold: nil},
    core_syntax.Specifier{template: ":tprel_g1:<0>", operand: aarch64_fixup.MOVW_UABS_G0_NC, fixup: aarch64_fixup.TLSLE_MOVW_TPREL_G1, fold: nil},
    core_syntax.Specifier{template: ":tprel_g1_nc:<0>", operand: aarch64_fixup.MOVW_UABS_G0_NC, fixup: aarch64_fixup.TLSLE_MOVW_TPREL_G1_NC, fold: nil},
    core_syntax.Specifier{template: ":tprel_g0:<0>", operand: aarch64_fixup.MOVW_UABS_G0_NC, fixup: aarch64_fixup.TLSLE_MOVW_TPREL_G0, fold: nil},
    core_syntax.Specifier{template: ":tprel_g0_nc:<0>", operand: aarch64_fixup.MOVW_UABS_G0_NC, fixup: aarch64_fixup.TLSLE_MOVW_TPREL_G0_NC, fold: nil},
    core_syntax.Specifier{template: ":dtprel_hi12:<0>", operand: aarch64_fixup.ADD_ABS_LO12_NC, fixup: aarch64_fixup.TLSLD_ADD_DTPREL_HI12, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12:<0>", operand: aarch64_fixup.ADD_ABS_LO12_NC, fixup: aarch64_fixup.TLSLD_ADD_DTPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12:<0>", operand: aarch64_fixup.LDST8_LO12_NC, fixup: aarch64_fixup.TLSLD_LDST8_DTPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12:<0>", operand: aarch64_fixup.LDST16_LO12_NC, fixup: aarch64_fixup.TLSLD_LDST16_DTPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12:<0>", operand: aarch64_fixup.LDST32_LO12_NC, fixup: aarch64_fixup.TLSLD_LDST32_DTPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12:<0>", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.TLSLD_LDST64_DTPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12:<0>", operand: aarch64_fixup.LDST128_LO12_NC, fixup: aarch64_fixup.TLSLD_LDST128_DTPREL_LO12, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12_nc:<0>", operand: aarch64_fixup.ADD_ABS_LO12_NC, fixup: aarch64_fixup.TLSLD_ADD_DTPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12_nc:<0>", operand: aarch64_fixup.LDST8_LO12_NC, fixup: aarch64_fixup.TLSLD_LDST8_DTPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12_nc:<0>", operand: aarch64_fixup.LDST16_LO12_NC, fixup: aarch64_fixup.TLSLD_LDST16_DTPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12_nc:<0>", operand: aarch64_fixup.LDST32_LO12_NC, fixup: aarch64_fixup.TLSLD_LDST32_DTPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12_nc:<0>", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.TLSLD_LDST64_DTPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":dtprel_lo12_nc:<0>", operand: aarch64_fixup.LDST128_LO12_NC, fixup: aarch64_fixup.TLSLD_LDST128_DTPREL_LO12_NC, fold: nil},
    core_syntax.Specifier{template: ":dtprel_g2:<0>", operand: aarch64_fixup.MOVW_UABS_G0_NC, fixup: aarch64_fixup.TLSLD_MOVW_DTPREL_G2, fold: nil},
    core_syntax.Specifier{template: ":dtprel_g1:<0>", operand: aarch64_fixup.MOVW_UABS_G0_NC, fixup: aarch64_fixup.TLSLD_MOVW_DTPREL_G1, fold: nil},
    core_syntax.Specifier{template: ":dtprel_g1_nc:<0>", operand: aarch64_fixup.MOVW_UABS_G0_NC, fixup: aarch64_fixup.TLSLD_MOVW_DTPREL_G1_NC, fold: nil},
