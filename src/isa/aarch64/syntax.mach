# the aarch64 syntax
# the low twelve bits of a constant, as `:lo12:` takes them from a symbol's address
fun fold_lo12(v: i64) i64 {
    ret v & 0xfff;
}

# the specifiers llvm-mc 23.1.1 reads on an add's or a load's or store's twelve bits and on adrp's page: `:lo12:`, the
# low bits of the address at each access size, `:got:` the page of the symbol's got entry and `:got_lo12:` its low
# bits, which only a 64-bit load takes (aaelf64, "Static AArch64 relocations")
val SPECIFIERS: [8]core_syntax.Specifier = [8]core_syntax.Specifier{
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.ADD_ABS_LO12_NC, fixup: aarch64_fixup.ADD_ABS_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.LDST8_LO12_NC, fixup: aarch64_fixup.LDST8_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.LDST16_LO12_NC, fixup: aarch64_fixup.LDST16_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.LDST32_LO12_NC, fixup: aarch64_fixup.LDST32_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.LDST64_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":lo12:<0>", operand: aarch64_fixup.LDST128_LO12_NC, fixup: aarch64_fixup.LDST128_LO12_NC, fold: fold_lo12},
    core_syntax.Specifier{template: ":got:<0>", operand: aarch64_fixup.ADR_PREL_PG_HI21, fixup: aarch64_fixup.ADR_GOT_PAGE, fold: nil},
    core_syntax.Specifier{template: ":got_lo12:<0>", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.LD64_GOT_LO12_NC, fold: nil},
};

pub val SYNTAX: core_syntax.Syntax = core_syntax.Syntax{
    name:       "aarch64",
    forms:      core_syntax.Forms{at: ?gen_syntax.FORM_TEXT[0], len: gen_syntax.FORM_COUNT},
    aliases:    core_syntax.Aliases{at: ?gen_syntax.ALIAS_ROWS[0], len: gen_syntax.ALIAS_COUNT},
    index:      core_syntax.Index{at: ?gen_syntax.ENTRIES[0], len: gen_syntax.ENTRY_COUNT, candidates: ?gen_syntax.CANDIDATES[0], count: gen_syntax.CANDIDATE_COUNT},
    specifiers: core_syntax.Specifiers{at: ?SPECIFIERS[0], len: 8},
    sequences:  core_syntax.NO_SEQUENCES,
    hooks:      core_syntax.Hooks{immediate: ?IMMEDIATE, memory: nil, list: ?LIST, id: nil, literal: nil, register: ?SYSTEM},
    register:   "",
    aliased:    false,
    join:       "",
    variadic:   ", ",
    fold:       true,
    anonymous:  ".Ltmp",
    own:        nil,
    statement:  nil,
    number:     "#",
};

pub val LIST_ELEMENT: str = "register list member spelled without its list's element";
pub val LIST_RANGE:   str = "register list range ends in another class than it starts";
pub val LIST_LENGTH:  str = "register list holds more members than the operand admits";
pub val NOT_FLOAT:    str = "not a decimal float";
pub val INEXACT:      str = "float not exact at the operand's width";

# the most fraction digits a float is written with, whose value then has at most this many binary places
val PLACES_MOST: u32 = 60;

# the fraction digits every float is written with, as llvm-mc writes them
val PLACES: u32 = 8;

# the fields of a system register's encoding from its highest, the letter before each, 0 for none, and the most each
# holds, op0 from the 2 of the first system register (DDI 0487, MRS: op0 is 2 + o0)
val SYSTEM_LETTERS: [5]u8  = [5]u8{'s', 0, 'c', 'c', 0};
val SYSTEM_LEAST:   [5]u32 = [5]u32{2, 0, 0, 0, 0};
val SYSTEM_MOST:    [5]u32 = [5]u32{3, 7, 15, 15, 7};
val SYSTEM_BITS:    [5]u32 = [5]u32{1, 3, 4, 4, 3};

# the system register the text at the reader's position spells by its encoding, s<op0>_<op1>_c<n>_c<m>_<op2> without
# regard to case, the reader past it, or none with the reader where it was
fun system_read(r: *core_syntax.Reader) opt[register.Id] {
    var at:     usize = r.at;
    var number: u32   = 0;
    var k:      u32   = 0;
    for (k < 5) {
        if (k > 0) {
            if (at >= r.end || r.text[at] != '_') { ret opt[register.Id].none{}; }
            at = at + 1;
        }
        val letter: u8 = SYSTEM_LETTERS[k];
        if (letter != 0) {
            if (at >= r.end || (r.text[at] | 0x20) != letter) { ret opt[register.Id].none{}; }
            at = at + 1;
        }
        var n:      u32   = 0;
        val digits: usize = at;
        for (at < r.end && r.text[at] >= '0' && r.text[at] <= '9' && n <= SYSTEM_MOST[k]) {
            n  = n * 10 + (r.text[at] - '0')::u32;
            at = at + 1;
        }
        if (at == digits || n < SYSTEM_LEAST[k] || n > SYSTEM_MOST[k]) { ret opt[register.Id].none{}; }
        number = (number << SYSTEM_BITS[k]) | (n - SYSTEM_LEAST[k]);
        k      = k + 1;
    }
    if (at < r.end && read.word(r.text[at])) { ret opt[register.Id].none{}; }
    r.at = at;
    ret opt[register.Id].some{register.make(gen_register.SYSREG_CLASS, number::u16)};
}

# system register `reg`, which no row names, written by its encoding, any other register refused at operand `op`
fun system_write(w: *core_syntax.Writer, reg: register.Id, op: u8) err[field.Refusal] {
    if (register.class_of(reg) != gen_register.SYSREG_CLASS) { ret write.refuse(w, write.NO_SPELLING, op); }
    var number: u32 = register.number_of(reg)::u32;
    var fields: [5]u32;
    var k:      i64 = 4;
    for (k >= 0) {
        fields[k] = (number & ((1::u32 << SYSTEM_BITS[k]) - 1)) + SYSTEM_LEAST[k];
        number    = number >> SYSTEM_BITS[k];
        k         = k - 1;
    }
    var text: [32]u8;
    var at:   usize = 0;
    var j:    u32   = 0;
    for (j < 5) {
        if (j > 0) {
            text[at] = '_';
            at       = at + 1;
        }
        if (SYSTEM_LETTERS[j] != 0) {
            text[at] = SYSTEM_LETTERS[j];
            at       = at + 1;
        }
        if (fields[j] >= 10) {
            text[at] = '1';
            at       = at + 1;
        }
        text[at] = '0' + (fields[j] % 10)::u8;
        at       = at + 1;
        j        = j + 1;
    }
    ret write.bytes(w, ?text[0], at);
}

# the system registers no row names, by their encoding
pub val SYSTEM: core_syntax.RegisterHook = core_syntax.RegisterHook{read: system_read, write: system_write};

# a member of the list at the position, the element `format` after its name
fun member(r: *core_syntax.Reader, format: View, viewed: bool) res[register.Id, diagnostic.Diagnostic] {
    val at:  usize                                   = r.at;
    val reg: res[register.Id, diagnostic.Diagnostic] = read.register_value(r, viewed);
    if (sel reg.err)     { ret reg; }
    if (format.len == 0) { ret reg; }
    if (!read.starts(r, r.at, format.data, format.len) || !read.bounded(r, r.at, format.len, format.data[format.len - 1])) {
        ret res[register.Id, diagnostic.Diagnostic].err{read.refuse(r, LIST_ELEMENT, at, read.token(r, at))};
    }
    r.at = r.at + format.len;
    ret reg;
}

# the members of `last`'s class from the one after `first` up to `last`, which may wrap past the class's last register
fun range(r: *core_syntax.Reader, list: *operand.List, first: register.Id, last: register.Id, at: usize, viewed: bool) err[diagnostic.Diagnostic] {
    val class: u16 = register.class_of(first);
    if (register.class_of(last) != class) { ret err[diagnostic.Diagnostic].err{read.refuse(r, LIST_RANGE, at, r.at - at)}; }
    val n:     u64 = register.count_most(r.codec.registers, class);
    val from:  u64 = register.number_of(first)::u64;
    val count: u64 = (register.number_of(last)::u64 + n - from) % n + 1;
    if (count > list.max::u64) { ret err[diagnostic.Diagnostic].err{read.refuse(r, LIST_LENGTH, at, r.at - at)}; }
    var k: u64 = 1;
    for (k < count) {
        val id: register.Id = register.make(class, ((from + k) % n)::u16);
        if (viewed) {
            val held: err[register.Absent] = register.admitted(r.ctx.view, id);
            if (sel held.err) {
                var refused: diagnostic.Diagnostic = read.refuse(r, field.UNAVAILABLE, at, r.at - at);
                if (sel held.err.unavailable) { refused.requires = held.err.unavailable.requires; }
                ret err[diagnostic.Diagnostic].err{refused};
            }
        }
        val pushed: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, operand.Value.register{id});
        if (sel pushed.err) { ret err[diagnostic.Diagnostic].err{pushed.err}; }
        k = k + 1;
    }
    ret err[diagnostic.Diagnostic].ok{};
}

fun list_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (sel desc.shape.list) { ret listed(r, ?desc.shape.list, format, out); }
    ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))};
}

fun listed(r: *core_syntax.Reader, list: *operand.List, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val viewed: bool                                    = !list.member.unviewed;
    val start:  usize                                   = r.at;
    val first:  res[register.Id, diagnostic.Diagnostic] = member(r, format, viewed);
    if (sel first.err) { ret err[diagnostic.Diagnostic].err{first.err}; }
    val base:   u32                                        = r.used;
    val pushed: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, operand.Value.register{first.ok});
    if (sel pushed.err) { ret err[diagnostic.Diagnostic].err{pushed.err}; }
    var len: u32 = 1;
    for {
        val past: usize = r.at;
        read.skip(r);
        val c: u8 = read.peek(r);
        if (c == '-' && len == 1) {
            r.at = r.at + 1;
            read.skip(r);
            val last: res[register.Id, diagnostic.Diagnostic] = member(r, format, viewed);
            if (sel last.err) { ret err[diagnostic.Diagnostic].err{last.err}; }
            val ranged: err[diagnostic.Diagnostic] = range(r, list, first.ok, last.ok, start, viewed);
            if (sel ranged.err) { ret ranged; }
            len = r.used - base;
            brk;
        }
        if (c != ',') {
            r.at = past;
            brk;
        }
        r.at = r.at + 1;
        read.skip(r);
        if (len >= list.max::u32) { ret err[diagnostic.Diagnostic].err{read.refuse(r, LIST_LENGTH, start, r.at - start)}; }
        val next: res[register.Id, diagnostic.Diagnostic] = member(r, format, viewed);
        if (sel next.err) { ret err[diagnostic.Diagnostic].err{next.err}; }
        val kept: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, operand.Value.register{next.ok});
        if (sel kept.err) { ret err[diagnostic.Diagnostic].err{kept.err}; }
        len = len + 1;
    }
    @out = operand.Value.list{operand.Values{at: pushed.ok, len: len}};
    ret err[diagnostic.Diagnostic].ok{};
}

# whether `members` are three or more registers of one scalable class whose numbers run up by one without wrapping
fun ranged(file: *register.File, members: operand.Values) bool {
    if (members.len < 3 || file == nil) { ret false; }
    val first: *operand.Value = ?members.at[0];
    if (!sel first.register) { ret false; }
    val class: opt[*register.Class] = register.class_row(file, first.register);
    if (sel class.none)            { ret false; }
    if (class.some.width.per == 0) { ret false; }
    var i: u32 = 1;
    for (i < members.len) {
        val m: *operand.Value = ?members.at[i];
        if (!sel m.register)                                                                    { ret false; }
        if (register.class_of(m.register) != register.class_of(first.register))                 { ret false; }
        if (register.number_of(m.register)::u32 != register.number_of(first.register)::u32 + i) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun list_print(w: *core_syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (!sel value.list) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    val members: operand.Values = value.list;
    if (members.len == 0) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    val run: bool = ranged(w.codec.registers, members);
    var i:   u32  = 0;
    for (i < members.len) {
        if (run && i > 0) { i = members.len - 1; }
        val m: *operand.Value = ?members.at[i];
        if (!sel m.register) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
        if (i > 0) {
            var between: str = ", ";
            if (run) { between = " - "; }
            val joined: err[field.Refusal] = write.text(w, between);
            if (sel joined.err) { ret joined; }
        }
        val named: err[field.Refusal] = write.register_name(w, m.register, field.NO_OPERAND);
        if (sel named.err) { ret named; }
        val element: err[field.Refusal] = write.view(w, format);
        if (sel element.err) { ret element; }
        i = i + 1;
    }
    ret err[field.Refusal].ok{};
}

# register lists, comma-separated or as a range
pub val LIST: core_syntax.Hook = core_syntax.Hook{parse: list_parse, print: list_print};

# the bit pattern of `bits`, a binary64 float, at an ieee 754 width of `width` bits, none when it is not exact there
fun narrowed(bits: u64, width: u8) opt[u64] {
    if (width == 64) { ret opt[u64].some{bits}; }
    var exponent: u64 = 5;
    var fraction: u64 = 10;
    if (width == 32) {
        exponent = 8;
        fraction = 23;
    }
    or (width != 16) { ret opt[u64].none{}; }
    val sign:   u64 = (bits >> 63) << (width::u64 - 1);
    val biased: u64 = (bits >> 52) & 0x7FF;
    val low:    u64 = bits & 0xFFFFFFFFFFFFF;
    val top:    u64 = (1::u64 << exponent) - 1;
    if (biased == 0x7FF) {
        if (low != 0) { ret opt[u64].none{}; }
        ret opt[u64].some{sign | (top << fraction)};
    }
    if (biased == 0 && low == 0) { ret opt[u64].some{sign}; }
    if (biased == 0)             { ret opt[u64].none{}; }
    val bias: i64 = (top >> 1)::i64;
    val e:    i64 = biased::i64 - 1023;
    if (e > bias) { ret opt[u64].none{}; }
    val drop: u64 = 52 - fraction;
    if (e >= 1 - bias) {
        if ((low & ((1::u64 << drop) - 1)) != 0) { ret opt[u64].none{}; }
        ret opt[u64].some{sign | ((e + bias)::u64 << fraction) | (low >> drop)};
    }
    # a subnormal at the width: the significand shifted past the width's least exponent
    val shift: u64 = drop + (1 - bias - e)::u64;
    if (shift > 53) { ret opt[u64].none{}; }
    val significand: u64 = low | (1::u64 << 52);
    if ((significand & ((1::u64 << shift) - 1)) != 0) { ret opt[u64].none{}; }
    ret opt[u64].some{sign | (significand >> shift)};
}

# the length of a decimal float at `at`: a sign, digits with an optional point, and an optional exponent
fun float_len(r: *core_syntax.Reader, at: usize) usize {
    var i: usize = at;
    if (i < r.end && (r.text[i] == '-' || r.text[i] == '+')) { i = i + 1; }
    val digits: usize = i;
    for (i < r.end && ((r.text[i] >= '0' && r.text[i] <= '9') || r.text[i] == '.')) {
        i = i + 1;
    }
    if (i == digits) { ret 0; }
    if (i < r.end && (r.text[i] == 'e' || r.text[i] == 'E')) {
        var j: usize = i + 1;
        if (j < r.end && (r.text[j] == '-' || r.text[j] == '+')) { j = j + 1; }
        val exp: usize = j;
        for (j < r.end && r.text[j] >= '0' && r.text[j] <= '9') {
            j = j + 1;
        }
        if (j > exp) { i = j; }
    }
    ret i - at;
}

fun float_parse(r: *core_syntax.Reader, imm: *operand.Immediate, out: *operand.Value) err[diagnostic.Diagnostic] {
    val at:  usize = r.at;
    val len: usize = float_len(r, at);
    if (len == 0 || (at + len < r.end && read.word(r.text[at + len]))) {
        ret err[diagnostic.Diagnostic].err{read.refuse(r, NOT_FLOAT, at, read.token(r, at))};
    }
    val f: res[f64, number.ParseError] = number.parse_f64_len(?r.text[at], len);
    if (sel f.err) { ret err[diagnostic.Diagnostic].err{read.refuse(r, NOT_FLOAT, at, len)}; }
    var bits: u64;
    var got:  f64 = f.ok;
    memory.raw_copy(?bits, ?got, 8);
    val exact: opt[u64] = narrowed(bits, imm.bits);
    if (sel exact.none) { ret err[diagnostic.Diagnostic].err{read.refuse(r, INEXACT, at, len)}; }
    r.at = at + len;
    @out = operand.Value.immediate{exact.some:~i64};
    ret err[diagnostic.Diagnostic].ok{};
}

# the float of `width` bits `bits` as its sign, a significand and a binary exponent, none for an infinity or a nan
rec Binary {
    negative:    bool;
    significand: u64;
    exponent:    i64;
}

fun binary(bits: u64, width: u8) opt[Binary] {
    var exponent: u64 = 11;
    var fraction: u64 = 52;
    if (width == 32) {
        exponent = 8;
        fraction = 23;
    }
    or (width == 16) {
        exponent = 5;
        fraction = 10;
    }
    or (width != 64) { ret opt[Binary].none{}; }
    val top:    u64 = (1::u64 << exponent) - 1;
    val biased: u64 = (bits >> fraction) & top;
    val low:    u64 = bits & ((1::u64 << fraction) - 1);
    if (biased == top) { ret opt[Binary].none{}; }
    val bias: i64    = (top >> 1)::i64;
    var b:    Binary = Binary{negative: ((bits >> (width::u64 - 1)) & 1) != 0, significand: low, exponent: 1 - bias - fraction::i64};
    if (biased != 0) {
        b.significand = low | (1::u64 << fraction);
        b.exponent    = biased::i64 - bias - fraction::i64;
    }
    ret opt[Binary].some{b};
}

fun float_print(w: *core_syntax.Writer, imm: *operand.Immediate, value: i64) err[field.Refusal] {
    val got: opt[Binary] = binary(value:~u64, imm.bits);
    if (sel got.none) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    var b: Binary = got.some;
    # the significand shifted to a whole part and a fraction of `places` binary places
    var places: u64 = 0;
    for (b.significand != 0 && (b.significand & 1) == 0 && b.exponent < 0) {
        b.significand = b.significand >> 1;
        b.exponent    = b.exponent + 1;
    }
    if (b.exponent < 0)            { places = (0 - b.exponent)::u64; }
    if (places > PLACES_MOST::u64) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    var whole: u64 = b.significand >> places;
    if (b.exponent > 0) {
        if (b.exponent > 62 || (b.significand >> (63 - b.exponent::u64)) != 0) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
        whole = b.significand << b.exponent::u64;
    }
    var rest: u64 = b.significand & ((1::u64 << places) - 1);
    if (b.negative) {
        val sign: err[field.Refusal] = write.text(w, "-");
        if (sel sign.err) { ret sign; }
    }
    val wrote: err[field.Refusal] = write.decimal(w, whole::i64);
    if (sel wrote.err) { ret wrote; }
    var digits: [60]u8;
    var count:  u32 = 0;
    for (count < PLACES || rest != 0) {
        rest          = rest * 10;
        digits[count] = '0' + (rest >> places)::u8;
        rest          = rest & ((1::u64 << places) - 1);
        count         = count + 1;
    }
    val point: err[field.Refusal] = write.text(w, ".");
    if (sel point.err) { ret point; }
    ret write.bytes(w, ?digits[0], count::usize);
}

# a symbol of an operand whose kind a specifier alone gives, written bare
pub val UNSPECIFIED: str = "symbol here takes a specifier, as `:lo12:`";

fun immediate_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (sel desc.shape.immediate) {
        if (desc.shape.immediate.format == operand.FLOAT) { ret float_parse(r, ?desc.shape.immediate, out); }
    }
    val at:    usize                      = r.at;
    val read_: err[diagnostic.Diagnostic] = expr.IMMEDIATE.parse(r, desc, format, out);
    if (sel read_.err) { ret read_; }
    val v: operand.Value = @out;
    if (!sel v.symbol || !aarch64_fixup.specified(operand.default_fixup(desc))) { ret read_; }
    if (!expr.wrapped(r, at))                                                   { ret err[diagnostic.Diagnostic].err{read.refuse(r, UNSPECIFIED, at, r.at - at)}; }
    ret read_;
}

fun immediate_print(w: *core_syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (sel desc.shape.immediate) {
        if (desc.shape.immediate.format == operand.FLOAT) {
            if (!sel value.immediate) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
            ret float_print(w, ?desc.shape.immediate, value.immediate);
        }
    }
    ret expr.IMMEDIATE.print(w, desc, format, value);
}

# immediates and relative targets as the shared expressions, and a float immediate as a decimal number
pub val IMMEDIATE: core_syntax.Hook = core_syntax.Hook{parse: immediate_parse, print: immediate_print};

# the parser's and printer's storage over a context of armv9-a with sve, sme and dit
#[testing]
rec T {
    t:          testing.Testing;
    s:          extension.Selection;
    v:          register.Available;
    ctx:        state.Context;
    modes:      mode.State;
    store:      [16]operand.Value;
    admissions: [8]requirement.Alternative;
    out:        vector.Vector[u8];
    fixups:     vector.Vector[field.Fixup];
}

# a test at streaming value `streaming`
#[testing]
fun t_make(t: *T, streaming: u8) bool {
    testing.make(?t.t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t.t), ?aarch64_extension.CATALOG, "armv9-a+sve+sme+dit+FEAT_PRFMSLC+FEAT_SYSINSTR128", diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    var start: state.Settings = state.initial(?aarch64_extension.AXES);
    start.at[0] = streaming;
    val opened: res[state.Context, state.Opened] = state.open(testing.allocator_of(?t.t), ?aarch64_register.FILE, ?t.s, ?aarch64_extension.AXES, start, ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx    = opened.ok;
    t.modes  = mode.initial(?mode.NO_MODES);
    t.out    = vector.init[u8](testing.allocator_of(?t.t));
    t.fixups = vector.init[field.Fixup](testing.allocator_of(?t.t));
    ret true;
}

#[testing]
fun t_resolve(context: ptr, name: View) res[core_syntax.Resolved, str] {
    ret res[core_syntax.Resolved, str].err{"no symbols"};
}

#[testing]
fun t_name(context: ptr, id: u32) View {
    ret view("", 0);
}

#[testing]
val T_SYMBOLS: core_syntax.Symbols = core_syntax.Symbols{context: nil, resolve: t_resolve, name: t_name};

# `text` read in the aarch64 syntax
#[testing]
fun t_parse(t: *T, text: str) res[inst.Inst, diagnostic.Diagnostic] {
    var rd: core_syntax.Reader = core_syntax.Reader{
        text:    text,
        start:   0,
        at:      0,
        end:     str_len(text),
        origin:  diagnostic.START,
        codec:   ?aarch64_catalog.CODEC,
        ctx:     ?t.ctx,
        syntax:  ?SYNTAX,
        modes:   ?t.modes,
        symbols: ?T_SYMBOLS,
        context: nil,
        row:     nil,
        pool:    ?t.store[0],
        cap:     16,
        used:    0,
        bytes:   nil,
        room:    0,
        taken:   0,
        refused: field.Admissions{at: ?t.admissions[0], cap: 8, used: 0},
    };
    ret parse.instruction(?rd);
}

#[testing]
fun t_fits(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# whether `text` reads, encodes as the four bytes `b0` to `b3` and prints back as `want`
#[testing]
fun t_agrees(t: *T, text: str, b0: u8, b1: u8, b2: u8, b3: u8, want: str) bool {
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(t, text);
    if (sel got.err) { ret false; }
    var ins: inst.Inst = got.ok;
    t.out.len = 0;
    val wrote: res[usize, field.Refusal] = walk.encode(?aarch64_catalog.CODEC, ?t.ctx, ?ins, ?t.out, ?t.fixups);
    if (sel wrote.err)                                                                                              { ret false; }
    if (t.out.len != 4 || t.out.data[0] != b0 || t.out.data[1] != b1 || t.out.data[2] != b2 || t.out.data[3] != b3) { ret false; }
    t.out.len = 0;
    var w:       core_syntax.Writer = core_syntax.Writer{out: ?t.out, codec: ?aarch64_catalog.CODEC, ctx: ?t.ctx, syntax: ?SYNTAX, modes: ?t.modes, symbols: ?T_SYMBOLS, context: nil, row: nil};
    val printed: err[field.Refusal] = print.instruction(?w, ?ins);
    if (sel printed.err)                     { ret false; }
    if (!t_fits(vector.push[u8](?t.out, 0))) { ret false; }
    ret str_equals(t.out.data, want);
}

# the GA2 instructions read, encode and print as llvm-mc 23.1.1 assembles them, which spells `mova` by its preferred
# alias `mov` and the pstate field in capitals
test instruction__the_sve_sme_and_dit_rows_agree_with_llvm_mc {
    var t: T;
    if (!t_make(?t, 0))                                                                                             { ret 1; }
    if (!t_agrees(?t, "add z0.s, z1.s, z2.s", 0x20, 0x00, 0xa2, 0x04, "add z0.s, z1.s, z2.s"))                      { ret 2; }
    if (!t_agrees(?t, "msr DIT, #1", 0x5f, 0x41, 0x03, 0xd5, "msr dit, #1"))                                        { ret 3; }
    if (!t_agrees(?t, "msr dit, 0", 0x5f, 0x40, 0x03, 0xd5, "msr dit, #0"))                                         { ret 4; }
    if (!t_make(?t, 1))                                                                                             { ret 5; }
    if (!t_agrees(?t, "mova za1v.s[w13, 3], p1/m, z2.s", 0x47, 0xa4, 0x80, 0xc0, "mov za1v.s[w13, 3], p1/m, z2.s")) { ret 6; }
    if (!t_agrees(?t, "MOVA ZA0H.S[W12, 0], P0/M, Z0.S", 0x00, 0x00, 0x80, 0xc0, "mov za0h.s[w12, 0], p0/m, z0.s")) { ret 7; }
    val refused: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "mova za4v.s[w13, 3], p1/m, z2.s");
    if (!sel refused.err) { ret 8; }
    ret 0;
}

# a list reads comma-separated or as a range and prints as llvm-mc 23.1.1 prints it, and a float reads as a decimal and
# prints with eight places
test lists__a_list_reads_either_form_and_a_float_reads_and_prints_as_llvm_mc {
    var t: T;
    if (!t_make(?t, 0))                                                                                                                          { ret 1; }
    if (!t_agrees(?t, "ld4 {v0.16b, v1.16b, v2.16b, v3.16b}, [x0]", 0x00, 0x00, 0x40, 0x4c, "ld4 { v0.16b, v1.16b, v2.16b, v3.16b }, [x0]"))     { ret 2; }
    if (!t_agrees(?t, "ld3 {v31.4s-v1.4s}, [x0]", 0x1f, 0x48, 0x40, 0x4c, "ld3 { v31.4s, v0.4s, v1.4s }, [x0]"))                                 { ret 3; }
    if (!t_agrees(?t, "ld4b {z0.b, z1.b, z2.b, z3.b}, p0/z, [x0]", 0x00, 0xe0, 0x60, 0xa4, "ld4b { z0.b - z3.b }, p0/z, [x0]"))                  { ret 4; }
    if (!t_agrees(?t, "ld4b { z30.b - z1.b }, p0/z, [x0]", 0x1e, 0xe0, 0x60, 0xa4, "ld4b { z30.b, z31.b, z0.b, z1.b }, p0/z, [x0]"))             { ret 5; }
    if (!t_agrees(?t, "ld2b {z0.b - z1.b}, p0/z, [x0]", 0x00, 0xe0, 0x20, 0xa4, "ld2b { z0.b, z1.b }, p0/z, [x0]"))                              { ret 6; }
    if (!t_agrees(?t, "tbl v0.16b, {v1.16b, v2.16b, v3.16b}, v4.16b", 0x20, 0x40, 0x04, 0x4e, "tbl v0.16b, { v1.16b, v2.16b, v3.16b }, v4.16b")) { ret 7; }
    if (!t_agrees(?t, "fmov d0, #1", 0x00, 0x10, 0x6e, 0x1e, "fmov d0, #1.00000000"))                                                            { ret 8; }
    if (!t_agrees(?t, "fmov d0, #-0.125", 0x00, 0x10, 0x78, 0x1e, "fmov d0, #-0.12500000"))                                                      { ret 9; }
    if (!t_agrees(?t, "fmov s0, #31.0", 0x00, 0xf0, 0x27, 0x1e, "fmov s0, #31.00000000"))                                                        { ret 10; }
    val element: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "ld2b {z0.h, z1.h}, p0/z, [x0]");
    val inexact: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "fmov d0, #0.1");
    if (!sel element.err || !sel inexact.err) { ret 11; }
    ret 0;
}

# a system register reads by its name or by its encoding, and writes by its name where a row names it, by its encoding
# otherwise, and a system pair's zero register pairs with itself, as llvm-mc 23.1.1 encodes them
test system__a_system_register_reads_by_name_or_encoding_and_writes_by_name_where_one_names_it {
    var t: T;
    if (!t_make(?t, 0))                                                                          { ret 1; }
    if (!t_agrees(?t, "mrs x1, sctlr_el1", 0x01, 0x10, 0x38, 0xd5, "mrs x1, sctlr_el1"))         { ret 2; }
    if (!t_agrees(?t, "mrs x2, S3_0_C1_C0_0", 0x02, 0x10, 0x38, 0xd5, "mrs x2, sctlr_el1"))      { ret 3; }
    if (!t_agrees(?t, "mrs x0, s3_0_c15_c2_0", 0x00, 0xf2, 0x38, 0xd5, "mrs x0, s3_0_c15_c2_0")) { ret 4; }
    if (!t_agrees(?t, "msr FPSR, x3", 0x23, 0x44, 0x1b, 0xd5, "msr fpsr, x3"))                   { ret 5; }
    if (!t_agrees(?t, "msr s2_3_c0_c5_0, x1", 0x01, 0x05, 0x13, 0xd5, "msr dbgdtrrx_el0, x1"))   { ret 6; }
    # sysp's xzr pairs with itself, and the pair it is prints as none
    if (!t_agrees(?t, "sysp #0, c8, c1, #0, xzr, xzr", 0x1f, 0x81, 0x48, 0xd5, "sysp #0, c8, c1, #0")) { ret 8; }
    val op0: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "mrs x0, s4_0_c0_c0_0");
    val crn: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "mrs x0, s3_0_c16_c0_0");
    if (!sel op0.err || !sel crn.err) { ret 7; }
    ret 0;
}

# the template defect of row `r` under form `form`
#[testing]
fun t_defect(r: *row.Row, form: str) opt[str] {
    var descs: [row.MAX_OPERANDS]*operand.Operand;
    var i:     u32 = 0;
    for (i < r.operands.len) {
        descs[i] = ?r.operands.at[i];
        i        = i + 1;
    }
    ret check_syntax.template_defect(?SYNTAX, ?aarch64_register.FILE, form, ?descs[0], r.operands.len, 0);
}

# every form writes each operand once, and a tile's number is the one register hole of another format than its name
test forms__every_form_passes_the_template_check_and_a_tile_hole_takes_only_number {
    var i: u32 = 0;
    for (i < SYNTAX.forms.len) {
        val found: opt[str] = t_defect(?aarch64_catalog.CODEC.rows.at[i], SYNTAX.forms.at[i]);
        if (sel found.some) { ret 1; }
        i = i + 1;
    }
    val mova:  *row.Row = gen_row.MOVA_ZA_P_RZ_W;
    val other: opt[str] = t_defect(mova, "mova za<0:digits><1>.s[<2>, <3>], <4>/m, <5>.s");
    if (!(sel other.some && str_equals(other.some, check_syntax.REGISTER_FORMAT))) { ret 2; }
    ret 0;
}

# a test of alias `a` over its row `r`'s first requirement alternative, which the catalog's test selection closes over
# with what `a` requires beside it, its context held by `c`
#[testing]
fun t_make_alias(t: *T, c: *aarch64_catalog.T, r: *row.Row, a: *core_syntax.Alias) bool {
    var ids:   [T_IDS]requirement.Id;
    var count: u32                     = 0;
    var alt:   requirement.Alternative = requirement.Alternative{all: requirement.NO_IDS, none: requirement.NO_IDS};
    if (r.requires.len > 0) { alt = r.requires.at[0]; }
    var k: u32 = 0;
    for (k < alt.all.len) {
        if (count >= T_IDS) { ret false; }
        ids[count] = alt.all.at[k];
        count      = count + 1;
        k          = k + 1;
    }
    if (a.requires.len > 0) {
        k = 0;
        for (k < a.requires.at[0].all.len) {
            if (count >= T_IDS) { ret false; }
            ids[count] = a.requires.at[0].all.at[k];
            count      = count + 1;
            k          = k + 1;
        }
    }
    # each member of the alias's own operands admitted, as tlbi's operations by their features
    var o: u8 = 0;
    for (o < a.count) {
        val d: *operand.Operand = core_syntax.alias_operand(a, r, o);
        if (d != nil) {
            if (sel d.shape.enumerant) {
                val e: *operand.Enumeration = ?d.shape.enumerant;
                var m: u32                  = 0;
                for (m < e.count) {
                    val needs: requirement.Requirement = e.members[m].requires;
                    if (needs.len > 0) {
                        k = 0;
                        for (k < needs.at[0].all.len) {
                            if (!aarch64_catalog.t_listed(?ids[0], count, needs.at[0].all.at[k])) {
                                if (count >= T_IDS) { ret false; }
                                ids[count] = needs.at[0].all.at[k];
                                count      = count + 1;
                            }
                            k = k + 1;
                        }
                    }
                    m = m + 1;
                }
            }
        }
        o = o + 1;
    }
    alt.all = requirement.Ids{at: ?ids[0], len: count};
    if (!aarch64_catalog.t_make_row(c, r, alt)) { ret false; }
    t.ctx    = c.ctx;
    t.modes  = mode.initial(?mode.NO_MODES);
    t.out    = vector.init[u8](testing.allocator_of(?c.t));
    t.fixups = vector.init[field.Fixup](testing.allocator_of(?c.t));
    ret true;
}

# the most extensions an alias test's selection names
#[testing]
val T_IDS: u32 = 32;

# the bytes `ins` encodes as into `out`, false where it is refused or is not one instruction word
#[testing]
fun t_word(t: *T, ins: *inst.Inst, out: *u32) bool {
    t.out.len = 0;
    val wrote: res[usize, field.Refusal] = walk.encode(?aarch64_catalog.CODEC, ?t.ctx, ins, ?t.out, ?t.fixups);
    if (sel wrote.err || t.out.len != 4) { ret false; }
    @out = t.out.data[0]::u32 | (t.out.data[1]::u32 << 8) | (t.out.data[2]::u32 << 16) | (t.out.data[3]::u32 << 24);
    ret true;
}

# a value `d` admits that operand `k` of alias `a` does not exclude, as the shared sample takes it, a list or a float as
# the catalog's walk takes its `nth`, a list's members in `room`, and past the shared samples an integer of a pattern of
# runs a logical immediate holds, which no move of a wide immediate does
#[testing]
fun t_sample(c: *aarch64_catalog.T, d: *operand.Operand, a: *core_syntax.Alias, k: u8, nth: u32, out: *operand.Value, room: *operand.Value) bool {
    var float: bool = false;
    if (sel d.shape.immediate) {
        val imm: *operand.Immediate = ?d.shape.immediate;
        float = imm.format == operand.FLOAT;
        if (!float && nth >= T_SHARED && nth - T_SHARED < T_PATTERN_COUNT) {
            var v: i64 = T_PATTERNS[nth - T_SHARED]:~i64;
            if (imm.bits < 64) { v = (T_PATTERNS[nth - T_SHARED] & field.ones(imm.bits)):~i64; }
            var held: operand.Value = operand.Value.immediate{v};
            val bad:  opt[str]      = walk.unrepresentable(imm, v);
            if (sel bad.none && !operand.excludes_value(imm, v) && !alias.excludes(a, k, ?held)) {
                @out = held;
                ret true;
            }
        }
    }
    if (!sel d.shape.list && !float) { ret parse.t_sample(?c.v, d, a, k, nth, out); }
    var n: u32 = nth;
    for (n < nth + 64) {
        val got: opt[operand.Value] = aarch64_catalog.t_value(d, n, room);
        if (sel got.none) { ret false; }
        var v: operand.Value = got.some;
        if (!alias.excludes(a, k, ?v)) {
            @out = v;
            ret true;
        }
        n = n + 1;
    }
    ret false;
}

# the shared samples an alias test takes before its patterns
#[testing]
val T_SHARED: u32 = 4;

#[testing]
val T_PATTERN_COUNT: u32 = 6;

# bitmasks of elements of 2, 16, 8, 4, 32 and 64 bits, so a row of each element size has one
#[testing]
val T_PATTERNS: [6]u64 = [6]u64{0x5555555555555555, 0x00ff00ff00ff00ff, 0x0f0f0f0f0f0f0f0f, 0x3333333333333333, 0x0000ffff0000ffff, 0x00000000ffffffff};

# the most members of a list an alias test samples, and the room for every operand's
#[testing]
val T_MEMBERS: u32 = 4;

#[testing]
val T_LIST_ROOM: u32 = 32;

# the failure of alias `i` of the table, named on the error stream
#[testing]
fun t_failed(i: u32, why: str) i32 {
    std_print.eprintlnf("alias {} {} ({}): {}", i, SYNTAX.aliases.at[i].template, aarch64_catalog.CODEC.rows.at[SYNTAX.aliases.at[i].row].key, why);
    ret 1;
}

# alias `i` of the table, over values of its own operands, assembled as its row, printed as itself and read back to
# the bytes it assembled, nil where it is, why not otherwise
#[testing]
fun t_walk(i: u32) str {
    val a: *core_syntax.Alias = ?SYNTAX.aliases.at[i];
    val r: *row.Row           = ?aarch64_catalog.CODEC.rows.at[a.row];
    var c: aarch64_catalog.T;
    var t: T;
    if (!t_make_alias(?t, ?c, r, a)) { ret "selection"; }
    var sample: [row.MAX_OPERANDS]operand.Value;
    var lists:  [T_LIST_ROOM]operand.Value;
    var base:   [row.MAX_OPERANDS]operand.Value;
    var nth:    u32  = 0;
    var formed: bool = false;
    var more:   bool = true;
    var word:   u32  = 0;
    var ins:    inst.Inst;
    # a derivation may take only some of its operands' values, as bfc's width within its lsb's room, so later samples
    # are tried while every operand has one
    for (!formed && more && nth < T_SHARED + T_PATTERN_COUNT) {
        var k: u8 = 0;
        for (k < a.count && more) {
            val d: *operand.Operand = core_syntax.alias_operand(a, r, k);
            more = d != nil && t_sample(?c, d, a, k, nth, ?sample[k], ?lists[k::u32 * T_MEMBERS]);
            k    = k + 1;
        }
        if (!more && nth == 0) { ret "no sample value"; }
        if (more && alias.resolve(?aarch64_catalog.CODEC, a, ?sample[0], ?base[0])) {
            ins    = inst.Inst{row: r, values: ?base[0], count: r.operands.len};
            formed = t_word(?t, ?ins, ?word);
        }
        nth = nth + 1;
    }
    if (!formed) { ret "no base form"; }
    t.out.len = 0;
    var w: core_syntax.Writer = core_syntax.Writer{out: ?t.out, codec: ?aarch64_catalog.CODEC, ctx: ?t.ctx, syntax: ?SYNTAX, modes: ?t.modes, symbols: ?T_SYMBOLS, context: nil, row: nil};
    # an alias only read whose values are derived has no inverse, and one preferred only for some values, as bfi beside
    # bfxil, need not be for the sample, so either is written by its own values
    var printed: err[field.Refusal] = err[field.Refusal].err{field.refusal(write.NO_SPELLING, field.NO_OPERAND, 0)};
    if (a.derive == nil || a.preference != 0) { printed = print.as_alias(?w, a, ?ins); }
    if (sel printed.err && a.derive != nil) {
        t.out.len = 0;
        printed   = print.respelled(?w, a, ?ins, ?sample[0]);
    }
    if (sel printed.err) { ret "does not print"; }
    var text: [128]u8;
    var n:    usize = 0;
    for (n < t.out.len && n < 127) {
        text[n] = t.out.data[n];
        n       = n + 1;
    }
    text[n] = 0;
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, ?text[0]);
    if (sel got.err) {
        std_print.eprintlnf("  {}: {}", ?text[0], got.err.message);
        ret "does not parse";
    }
    var back:  inst.Inst = got.ok;
    var again: u32       = 0;
    if (!t_word(?t, ?back, ?again) || again != word) {
        std_print.eprintlnf("  {}: {} read back as {}", ?text[0], word, again);
        ret "reads back to other bytes";
    }
    ret nil;
}

# every alias, over values of its own operands, assembles as its row, prints as itself and reads back to the bytes it
# assembled
test alias__a_walk_over_the_alias_table_prints_each_and_reads_it_back_to_its_bytes {
    var failed: i32 = 0;
    var i:      u32 = 0;
    for (i < SYNTAX.aliases.len) {
        val why: str = t_walk(i);
        if (why != nil) { failed = failed + t_failed(i, why); }
        i = i + 1;
    }
    ret failed;
}

# an alias prints where its condition holds and its row's own form where it does not, as llvm-mc 23.1.1 assembles and
# prints them: mov over orr only from the zero register, lsl and ubfx by ubfm's fields, mov of a wide immediate only
# where no movz or movn writes it, a system instruction by its operation, smstart by the pstate field, an unnamed
# barrier by number and the speculation barriers by name, and a prefetch operation by name where the selection holds
# its feature
test alias__an_alias_prints_where_its_condition_holds_as_llvm_mc {
    var t: T;
    if (!t_make(?t, 0))                                                                                 { ret 1; }
    if (!t_agrees(?t, "orr x0, xzr, x1", 0xe0, 0x03, 0x01, 0xaa, "mov x0, x1"))                         { ret 2; }
    if (!t_agrees(?t, "orr x0, x2, x1", 0x40, 0x00, 0x01, 0xaa, "orr x0, x2, x1"))                      { ret 3; }
    if (!t_agrees(?t, "subs xzr, x1, x2", 0x3f, 0x00, 0x02, 0xeb, "cmp x1, x2"))                        { ret 4; }
    if (!t_agrees(?t, "ubfm w0, w1, #28, #27", 0x20, 0x6c, 0x1c, 0x53, "lsl w0, w1, #4"))               { ret 5; }
    if (!t_agrees(?t, "ubfm x0, x1, #4, #11", 0x20, 0x2c, 0x44, 0xd3, "ubfx x0, x1, #4, #8"))           { ret 6; }
    if (!t_agrees(?t, "ubfm w0, w1, #0, #7", 0x20, 0x1c, 0x00, 0x53, "uxtb w0, w1"))                    { ret 7; }
    if (!t_agrees(?t, "sbfm x0, x1, #0, #31", 0x20, 0x7c, 0x40, 0x93, "sxtw x0, w1"))                   { ret 8; }
    if (!t_agrees(?t, "bfm w0, wzr, #28, #3", 0xe0, 0x0f, 0x1c, 0x33, "bfc w0, #4, #4"))                { ret 9; }
    if (!t_agrees(?t, "movz w0, #0xffff, lsl #16", 0xe0, 0xff, 0xbf, 0x52, "mov w0, #-65536"))          { ret 10; }
    if (!t_agrees(?t, "movn w0, #0x1234", 0x80, 0x46, 0x82, 0x12, "mov w0, #-4661"))                    { ret 11; }
    if (!t_agrees(?t, "orr w0, wzr, #0xff00ff", 0xe0, 0x9f, 0x00, 0x32, "mov w0, #16711935"))           { ret 12; }
    if (!t_agrees(?t, "mov w0, #-1", 0x00, 0x00, 0x80, 0x12, "mov w0, #-1"))                            { ret 13; }
    if (!t_agrees(?t, "csinc w0, w1, w1, ne", 0x20, 0x14, 0x81, 0x1a, "cinc w0, w1, eq"))               { ret 14; }
    if (!t_agrees(?t, "csinc w0, wzr, wzr, ne", 0xe0, 0x17, 0x9f, 0x1a, "cset w0, eq"))                 { ret 15; }
    if (!t_agrees(?t, "extr w0, w1, w1, #3", 0x20, 0x0c, 0x81, 0x13, "ror w0, w1, #3"))                 { ret 16; }
    if (!t_agrees(?t, "add x0, sp, #0", 0xe0, 0x03, 0x00, 0x91, "mov x0, sp"))                          { ret 17; }
    if (!t_agrees(?t, "sys #3, c7, c11, #1, x0", 0x20, 0x7b, 0x0b, 0xd5, "dc cvau, x0"))                { ret 18; }
    if (!t_agrees(?t, "sys #0, c8, c3, #0, xzr", 0x1f, 0x83, 0x08, 0xd5, "tlbi vmalle1is"))             { ret 19; }
    if (!t_agrees(?t, "msr svcrsmza, #1", 0x7f, 0x47, 0x03, 0xd5, "smstart"))                           { ret 20; }
    if (!t_agrees(?t, "msr svcrsm, #0", 0x7f, 0x42, 0x03, 0xd5, "smstop sm"))                           { ret 21; }
    if (!t_agrees(?t, "dsb #0", 0x9f, 0x30, 0x03, 0xd5, "ssbb"))                                        { ret 22; }
    if (!t_agrees(?t, "dsb #4", 0x9f, 0x34, 0x03, 0xd5, "pssbb"))                                       { ret 23; }
    if (!t_agrees(?t, "dsb #12", 0x9f, 0x3c, 0x03, 0xd5, "dsb #12"))                                    { ret 24; }
    if (!t_agrees(?t, "dmb #3", 0xbf, 0x33, 0x03, 0xd5, "dmb osh"))                                     { ret 25; }
    if (!t_agrees(?t, "isb #15", 0xdf, 0x3f, 0x03, 0xd5, "isb"))                                        { ret 26; }
    if (!t_agrees(?t, "prfm #6, [x0]", 0x06, 0x00, 0x80, 0xf9, "prfm pldslckeep, [x0]"))                { ret 27; }
    if (!t_agrees(?t, "prfm #25, [x0]", 0x19, 0x00, 0x80, 0xf9, "prfm #25, [x0]"))                      { ret 28; }
    if (!t_agrees(?t, "dup z0.b, z1.b[0]", 0x20, 0x20, 0x21, 0x05, "mov z0.b, b1"))                     { ret 29; }
    if (!t_agrees(?t, "dup z0.s, z1.s[2]", 0x20, 0x20, 0x34, 0x05, "mov z0.s, z1.s[2]"))                { ret 30; }
    if (!t_agrees(?t, "dup z0.b, w1", 0x20, 0x38, 0x20, 0x05, "mov z0.b, w1"))                          { ret 31; }
    if (!t_agrees(?t, "fcpy z0.h, p0/m, #1.0", 0x00, 0xce, 0x50, 0x05, "fmov z0.h, p0/m, #1.00000000")) { ret 32; }
    # a general register is no scalar of dup's indexed form, and prfm's register form leaves rprfm's numbers
    val general: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "mov z0.b, w1");
    val wide:    res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "prfm #24, [x0, x1]");
    if (sel general.err)                                   { ret 33; }
    if (!str_equals(general.ok.row.key, "dup_z_r_bhs_.b")) { ret 34; }
    if (!sel wide.err)                                     { ret 35; }
    ret 0;
}
