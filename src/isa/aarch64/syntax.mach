    core_syntax.Specifier{template: "<0>@PAGEOFF", operand: aarch64_fixup.LDST64_LO12_NC, fixup: aarch64_fixup.LDST64_LO12_NC, fold: nil, formats: MACHO},
    core_syntax.Specifier{template: "<0>@PAGEOFF", operand: aarch64_fixup.LDST128_LO12_NC, fixup: aarch64_fixup.LDST128_LO12_NC, fold: nil, formats: MACHO},
