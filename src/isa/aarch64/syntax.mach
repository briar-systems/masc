    core_syntax.Specifier{template: ":abs_g0_nc:<0>", operand: aarch64_fixup.MOVW_UABS_G0_NC, fixup: aarch64_fixup.MOVW_UABS_G0_NC, fold: nil},
    core_syntax.Specifier{template: "<0>@PAGE", operand: aarch64_fixup.ADR_PREL_PG_HI21, fixup: aarch64_fixup.ADR_PREL_PG_HI21, fold: nil, formats: MACHO},
