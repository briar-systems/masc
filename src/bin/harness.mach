# the oracle harness program
#
# usage: harness agree <set> [--full] [--work <dir>] [--out <report>]. it runs
# the set's agreement over every row at every variant and writes the report,
# by default to out/harness/agree-<set>.txt with the tools' files under
# out/harness/agree/<set>, and `-full` added to both under --full. it prints
# the summary, and exits 0 when no row fails, 1 when one does, and 2 when it
# cannot run.
#
# usage: harness wast <dir>... [--work <dir>] [--out <report>]. it sweeps every
# valid module of each directory's .wast scripts (`masc.harness.wast.sweep`)
# and writes the report, by default to out/harness/wast.txt with the tools'
# files under out/harness/wast. it exits as agree does, a failing module as a
# failing row.

use std.print;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.arena;
use std.allocator.page;

use masc.harness.agree.agreement;
use masc.harness.agree.registry;
use masc.harness.agree.report;
use masc.harness.agree.run;
use masc.harness.wast.sweep;
use masc.tool.text;

use std.collections.vector;

fun usage() i64 {
    print.eprintln("usage: harness agree <set> [--full] [--work <dir>] [--out <report>]");
    print.eprintln("       harness wast <dir>... [--work <dir>] [--out <report>]");
    ret 2;
}

# the testsuite sweep over the directories `argv[2..]` names
fun wast(argc: i64, argv: **u8) i64 {
    var back: A.Allocator;
    page.make(?back);
    var ar:   arena.Arena;
    var a:    A.Allocator;
    var sr:   arena.Arena;
    var s:    A.Allocator;
    val made: err[A.Error] = arena.init(?ar, ?back, 1 << 26);
    if (sel made.err) {
        print.eprintln("harness: out of memory");
        ret 2;
    }
    arena.make(?a, ?ar);
    fin { arena.dnit(?ar); }
    val scratch: err[A.Error] = arena.init(?sr, ?back, 1 << 26);
    if (sel scratch.err) {
        print.eprintln("harness: out of memory");
        ret 2;
    }
    arena.make(?s, ?sr);
    fin { arena.dnit(?sr); }
    var work: str                = "out/harness/wast";
    var out:  str                = "out/harness/wast.txt";
    var dirs: vector.Vector[str] = vector.init[str](?a);
    var i:    i64                = 2;
    for (i < argc) {
        val arg: str = argv[i]::str;
        if (str_equals(arg, "--work") && i + 1 < argc) {
            work = argv[i + 1]::str;
            i    = i + 1;
        }
        or (str_equals(arg, "--out") && i + 1 < argc) {
            out = argv[i + 1]::str;
            i   = i + 1;
        }
        or { vector.push[str](?dirs, arg); }
        i = i + 1;
    }
    if (dirs.len == 0) { ret usage(); }
    var result: sweep.Result;
    val ran:    err[str] = sweep.sweep(?a, ?s, ?sr, dirs.data, dirs.len, work, ?result);
    if (sel ran.err) {
        print.eprintlnf("harness: {}", ran.err);
        ret 2;
    }
    val wrote: err[str] = sweep.report(?a, ?result, out);
    if (sel wrote.err) {
        print.eprintlnf("harness: {}", wrote.err);
        ret 2;
    }
    var t: text.Text = text.make(?a);
    sweep.summary(?t, ?result);
    val shown: opt[str] = text.copy(?t, ?a);
    if (sel shown.some) { print.print(shown.some); }
    print.printlnf("  failing {}, report {}", result.failures, out);
    if (result.failures > 0) { ret 1; }
    ret 0;
}

# `head`, the set's name, `-full` under --full, and `tail`, joined
fun path(a: *A.Allocator, head: str, name: str, full: bool, tail: str) opt[str] {
    var t: text.Text = text.make(a);
    text.put(?t, head);
    text.put(?t, name);
    if (full) { text.put(?t, "-full"); }
    text.put(?t, tail);
    ret text.copy(?t, a);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc >= 3 && str_equals(argv[1]::str, "wast"))  { ret wast(argc, argv); }
    if (argc < 3 || !str_equals(argv[1]::str, "agree")) { ret usage(); }
    val name: str  = argv[2]::str;
    var full: bool = false;
    var work: str  = nil;
    var out:  str  = nil;
    var i:    i64  = 3;
    for (i < argc) {
        val arg: str = argv[i]::str;
        if (str_equals(arg, "--full")) { full = true; }
        or (str_equals(arg, "--work") && i + 1 < argc) {
            work = argv[i + 1]::str;
            i    = i + 1;
        }
        or (str_equals(arg, "--out") && i + 1 < argc) {
            out = argv[i + 1]::str;
            i   = i + 1;
        }
        or { ret usage(); }
        i = i + 1;
    }
    val found: opt[*agreement.Agreement] = registry.find(name);
    if (sel found.none) {
        print.eprintlnf("harness: no set registers an agreement named {}", name);
        ret 2;
    }
    var back: A.Allocator;
    page.make(?back);
    var ar:   arena.Arena;
    var a:    A.Allocator;
    val made: err[A.Error] = arena.init(?ar, ?back, 1 << 26);
    if (sel made.err) {
        print.eprintln("harness: out of memory");
        ret 2;
    }
    arena.make(?a, ?ar);
    fin { arena.dnit(?ar); }
    if (work == nil) {
        val made_work: opt[str] = path(?a, "out/harness/agree/", name, full, "");
        if (sel made_work.none) {
            print.eprintln("harness: out of memory");
            ret 2;
        }
        work = made_work.some;
    }
    if (out == nil) {
        val made_out: opt[str] = path(?a, "out/harness/agree-", name, full, ".txt");
        if (sel made_out.none) {
            print.eprintln("harness: out of memory");
            ret 2;
        }
        out = made_out.some;
    }
    var result: run.Result;
    val ran:    err[str] = run.agree(?a, found.some, run.Options{work: work, full: full}, ?result);
    if (sel ran.err) {
        print.eprintlnf("harness: {}", ran.err);
        ret 2;
    }
    val wrote: err[str] = report.write(?a, ?result, out);
    if (sel wrote.err) {
        print.eprintlnf("harness: {}", wrote.err);
        ret 2;
    }
    var t: text.Text = text.make(?a);
    report.summary(?t, ?result);
    val shown: opt[str] = text.copy(?t, ?a);
    if (sel shown.some) { print.print(shown.some); }
    print.printlnf("  failing {}, report {}", result.failures, out);
    if (result.failures > 0) { ret 1; }
    ret 0;
}
