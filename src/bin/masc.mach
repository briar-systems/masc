# the masc command line over the library

use std.runtime;
use std.types.error.err;
use std.types.size.usize;

use A: std.allocator;
use std.allocator.heap;
use std.args;

use masc.cli.cli;

# every allocation lives in the heap, which is given back whole when the command ends
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret 2; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret 2; }
    val code: i64          = cli.run(?a, args.of(argc::usize, argv));
    val d:    err[A.Error] = heap.dnit(?h);
    if (sel d.err) { ret 2; }
    ret code;
}
