# the aarch64 agreement: A64 against llvm-mc, decoded against llvm-objdump
#
# every selection holds armv8-a's version, and llvm is asked for it as
# `-mattr`: `+` and each attribute llvm 23.1.1 names (AArch64Features.td)
# that enables a row the selection holds, an architecture version by its own
# attribute, as `+v9.2a`, and a feature by the one attribute llvm folds it
# into, as d128 for FEAT_SYSINSTR128. llvm's attributes imply what its own
# -march levels hold, so llvm admits a superset of masc's selection, as fp and
# simd at armv8-a, and a vector is never refused by llvm that masc admits.
# llvm-objdump applies the aliases it prefers, and masc's printing is compared
# with its own preferred aliases applied. no gnu
# assembler is asked: binutils 2.47 relaxes no branch either and its aarch64
# assembler is not among the pinned tools. relative targets are numbers,
# `#8` from the instruction, as llvm-mc reads them. the tools are pinned at
# llvm 23.1.1, which the exception table was written against.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;

use arch_aarch64: mink.catalog.arch.aarch64;
use mink_format:  mink.catalog.format;

use masc.core.extension;
use masc.core.field;
use masc.core.operand;
use masc.core.requirement;
use masc.core.row;
use core_syntax: masc.core.syntax;

use aarch64_extension: masc.isa.aarch64.extension;
use aarch64_field:     masc.isa.aarch64.field;
use masc.isa.aarch64.gen_extension;
use aarch64_set: masc.isa.aarch64.set;

use masc.harness.agree.agreement;
use masc.harness.agree.vectors;
use masc.tool.text;

val BASE: [1]requirement.Id = [1]requirement.Id{aarch64_extension.id.V8_0};

val VARIANTS: [1]agreement.Variant = [1]agreement.Variant{
    agreement.Variant{name: "a64", arch: ?arch_aarch64.AARCH64, base: requirement.Ids{at: ?BASE[0], len: 1}, abi: nil},
};

val LLVM_MC_PROGRAMS:      [1]str = [1]str{"llvm-mc"};
val LLVM_OBJDUMP_PROGRAMS: [1]str = [1]str{"llvm-objdump"};

val LLVM_MC:      agreement.Tool = agreement.Tool{name: "llvm-mc", programs: agreement.Programs{at: ?LLVM_MC_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};
val LLVM_OBJDUMP: agreement.Tool = agreement.Tool{name: "llvm-objdump", programs: agreement.Programs{at: ?LLVM_OBJDUMP_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};

# whether `s` holds a row attribute `e` enables
fun covered(s: *extension.Selection, e: *extension.NameEntry) bool {
    var i: u32 = 0;
    for (i < e.rows.len) {
        if (extension.has(s, e.rows.at[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# `head` and the selection as llvm attributes, `+` and each attribute it holds, comma separated, as one argument
fun attribute_arg(job: *agreement.Job, args: *agreement.Args, head: str) {
    var t:     text.Text = text.make(args.a);
    var first: bool      = true;
    text.put(?t, head);
    var i: u32 = 0;
    for (i < gen_extension.ATTRIBUTE_COUNT) {
        val e: *extension.NameEntry = ?gen_extension.ATTRIBUTES[i];
        if (covered(job.selection, e)) {
            if (!first) { text.byte(?t, ','); }
            text.byte(?t, '+');
            text.put(?t, e.key);
            first = false;
        }
        i = i + 1;
    }
    agreement.arg_text(args, ?t);
}

fun llvm_mc(job: *agreement.Job, args: *agreement.Args) {
    agreement.arg(args, "-triple=aarch64");
    attribute_arg(job, args, "-mattr=");
    agreement.arg(args, "-filetype=obj");
    agreement.arg(args, "-o");
    agreement.arg(args, job.object);
    agreement.arg(args, job.source);
}

fun llvm_objdump(job: *agreement.Job, args: *agreement.Args) {
    agreement.arg(args, "-d");
    agreement.arg(args, "--no-print-imm-hex");
    agreement.arg(args, "--no-show-raw-insn");
    attribute_arg(job, args, "--mattr=");
    agreement.arg(args, job.object);
}

val ASSEMBLERS: [1]agreement.Assembler = [1]agreement.Assembler{agreement.Assembler{tool: ?LLVM_MC, spell: llvm_mc, layout: nil}};

# the aarch64 operands' kinds state every value they take beyond their edges
fun hook(g: *vectors.Generation) {}

# the row operand alias operand `k` gives its value to as it is or through the alias's derivation: the one its source
# names, else, for an alias operand no source names, the one row operand the derivation computes, as orr's mov
# computes the bitmask from its own. none for neither
fun row_operand(g: *vectors.Generation, k: u32) opt[u32] {
    if (g.alias == nil) { ret opt[u32].some{k}; }
    val sources: core_syntax.Sources = g.alias.sources;
    var derived: opt[u32]            = opt[u32].none{};
    var count:   u32                 = 0;
    var j:       u32                 = 0;
    for (j < sources.len) {
        val src: core_syntax.Source = sources.at[j];
        if (sel src.operand && src.operand::u32 == k) { ret opt[u32].some{j}; }
        if (sel src.derived) {
            derived = opt[u32].some{j};
            count   = count + 1;
        }
        j = j + 1;
    }
    if (count != 1) { ret opt[u32].none{}; }
    ret derived;
}

# the field of `g`'s row that encodes operand `k` of what the vectors are generated over whole, nil for none
fun field_of(g: *vectors.Generation, k: u32) *field.Field {
    val at: opt[u32] = row_operand(g, k);
    if (sel at.none) { ret nil; }
    val r: *row.Row = g.row;
    var j: u32      = 0;
    for (j < r.encoding.len) {
        val f: *field.Field = ?r.encoding.at[j];
        if (f.operand != field.NO_OPERAND && f.operand::u32 == at.some) { ret f; }
        j = j + 1;
    }
    ret nil;
}

fun push(g: *vectors.Generation, out: *vector.Vector[operand.Value], v: u64) {
    var i: usize = 0;
    for (i < out.len) {
        val held: operand.Value = out.data[i];
        if (sel held.immediate && held.immediate == v:~i64) { ret; }
        i = i + 1;
    }
    val pushed: res[usize, A.Error] = vector.push[operand.Value](out, operand.Value.immediate{v:~i64});
    if (sel pushed.err) { g.failed = true; }
}

# the 8-bit codes a float8 field's edges decode from: 1.0 first, then the ends of each half of the code space
val FLOAT8_CODES: [5]u64 = [5]u64{0x70, 0x00, 0x7F, 0x80, 0xFF};

# the 8-bit codes a bytemask field's edges decode from: one byte of ones, then the ends and an alternation
val BYTEMASK_CODES: [5]u64 = [5]u64{0x01, 0x00, 0xFF, 0x80, 0x55};

# a bitmask field's edges at value width `width` over `domain` bits: for each element of `width` bits down to 2, a
# single one, a run of half the element and the longest run rotated by one, as `mov x0, #0x5555555555555555`, which no
# movz or movn writes, and dupm's `mov z0.h, #0xff`, which no dup does
fun bitmask_edges(g: *vectors.Generation, width: u32, domain: u32, out: *vector.Vector[operand.Value]) {
    var e: u32 = width;
    for (e >= 2) {
        val runs: [3]u64 = [3]u64{1, ones_of(e / 2), ones_of(e) - 1};
        var i:    usize  = 0;
        for (i < 3) {
            val v:    u64      = aarch64_field.replicate(runs[i], e, domain);
            val code: opt[u64] = aarch64_field.encode_bitmask(v, domain);
            if (sel code.some) { push(g, out, v & ones_of(width)); }
            i = i + 1;
        }
        e = e / 2;
    }
}

fun ones_of(width: u32) u64 {
    if (width >= 64) { ret 0xFFFF_FFFF_FFFF_FFFF; }
    ret (1::u64 << width::u64) - 1;
}

# the edges of an immediate a kind encodes whole, which the kind's own code space gives, as no step of an integer
# range lands on a bitmask, a float8 or a bytemask value. any other operand takes its kind's edges
fun edges(g: *vectors.Generation, k: u32, desc: *operand.Operand, out: *vector.Vector[operand.Value]) bool {
    if (!sel desc.shape.immediate) { ret false; }
    val f: *field.Field = field_of(g, k);
    if (f == nil) { ret false; }
    if (f.kind == aarch64_field.FLOAT8_KIND) {
        var i: usize = 0;
        for (i < 5) {
            push(g, out, aarch64_field.decode_float8(FLOAT8_CODES[i], f.param::u32));
            i = i + 1;
        }
        ret true;
    }
    if (f.kind == aarch64_field.BYTEMASK_KIND) {
        var i: usize = 0;
        for (i < 5) {
            push(g, out, aarch64_field.decode_bytemask(BYTEMASK_CODES[i]));
            i = i + 1;
        }
        ret true;
    }
    if (f.kind == aarch64_field.BITMASK_KIND) {
        bitmask_edges(g, (f.param & 0xFF)::u32, ((f.param >> 8) & 0xFF)::u32, out);
        ret true;
    }
    ret false;
}

# why each exception holds, every one checked against llvm-mc and llvm-objdump 23.1.1 alone, the refused vectors under
# -mattr=+all and masc's printing of the others read back by llvm-mc to the same bytes
val UNKNOWN:        str = "llvm-mc 23.1.1 knows no such mnemonic under every attribute it has (-mattr=+all): the 2026 features of flt, cflt, tflt, srls, slbnd, ldapro, stlro, lda64b and stl64b";
val SYS_REGISTER:   str = "llvm-mc 23.1.1 takes a register exactly for the tlbi, ic and gic operations that use one, where the alias pages write `{, <Xt>}` optional for every operation, so masc leaves out an xzr the operation does not use";
val TLBIP_PAIR:     str = "llvm-mc 23.1.1 requires tlbip's register pair, which tlbip_sysp.xml writes `{, <Xt1>, <Xt2>}` optional";
val TLBIP_XZR:      str = "llvm-objdump 23.1.1 writes tlbip's pair of xzr, which masc leaves out as tlbip_sysp.xml's optional `{, <Xt1>, <Xt2>}` defaulting to xzr";
val CAS_ZERO:       str = "llvm-mc 23.1.1 refuses the optional `#0` offset cas.xml and casp.xml write after the base register, `[<Xn|SP>{,#0}]`";
val MOVI_LSL:       str = "llvm-mc 23.1.1 refuses the optional `, lsl #0` movi.xml writes after the 8-bit arrangements' immediate";
val SHIFTED:        str = "llvm-objdump 23.1.1 writes an sve 8-bit immediate shifted by 8 as its value, `#256`, where masc writes the page's `#1, lsl #8`, which llvm-mc reads to the same bytes";
val INDEX_ZERO:     str = "llvm-objdump 23.1.1 writes pmov's portion index 0, which pmov_p_zi.xml and pmov_z_pi.xml write optional `{[<imm>]}` defaulting to 0 and masc leaves out";
val HS:             str = "llvm-objdump 23.1.1 writes conditions 0010 and 0011 as hs and lo, where masc writes the first names of the manual's `CS or HS` and `CC or LO` (DDI 0487, C1.2.4), which llvm-mc reads alike";
val CAPITALS:       str = "llvm-objdump 23.1.1 writes system register and PSTATE field names in capitals, which masc writes in lower case and llvm-mc reads alike";
val BFC:            str = "llvm-objdump 23.1.1 prefers bfc wherever the source is the zero register, where bfc_bfm.xml prefers it only where UInt(imms) < UInt(immr) and masc writes bfxil";
val BTI_R:          str = "llvm-objdump 23.1.1 writes bti with no target as `bti r`, a target bti.xml's <targets> does not name, and llvm-mc reads masc's `bti` to the same bytes";
val WRITEBACK_ZERO: str = "llvm-objdump 23.1.1 writes the `#0` of ldraa's and ldrab's writeback form, which ldra.xml writes optional `{, #<simm>}` defaulting to 0 and masc leaves out";
val CMPP:           str = "llvm-objdump 23.1.1 writes subps xzr, which cmpp_subps.xml prefers as cmpp";
val MOVI_ZERO:      str = "llvm-objdump 23.1.1 writes movi's 64-bit zero as `#0000000000000000`, where masc writes `#0`, which llvm-mc reads to the same bytes";
val XTL:            str = "llvm-objdump 23.1.1 writes sshll and ushll of shift 0, which sxtl_sshll.xml and uxtl_ushll.xml prefer as sxtl and uxtl where BitCount(immh) == 1";
val MOV_SIGNED:     str = "llvm-objdump 23.1.1 writes orr's mov immediate signed, where masc writes the unsigned value of the 64-bit bitmask, which llvm-mc reads to the same bytes";
val RELAXED:        str = "masc relaxes an external b.cond, cbz and tbz to the inverted branch over a b, since only the linker knows the target, where llvm-mc 23.1.1 writes the short form's relocation";

