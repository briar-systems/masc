# the aarch64 agreement: A64 against llvm-mc, decoded against llvm-objdump
#
# every selection holds armv8-a's version, and llvm is asked for it as
# `-mattr`: `+` and each attribute llvm 23.1.1 names (AArch64Features.td)
# that enables a row the selection holds, an architecture version by its own
# attribute, as `+v9.2a`, and a feature by the one attribute llvm folds it
# into, as d128 for FEAT_SYSINSTR128. llvm's attributes imply what its own
# -march levels hold, so llvm admits a superset of masc's selection, as fp and
# simd at armv8-a, and a vector is never refused by llvm that masc admits.
# llvm-objdump applies the aliases it prefers, and masc's printing is compared
# with its own preferred aliases applied. no gnu
# assembler is asked: binutils 2.47 relaxes no branch either and its aarch64
# assembler is not among the pinned tools. relative targets are numbers,
# `#8` from the instruction, as llvm-mc reads them. the tools are pinned at
# llvm 23.1.1, which the exception table was written against.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use arch_aarch64: mink.catalog.arch.aarch64;
use mink_format:  mink.catalog.format;

use masc.core.extension;
use masc.core.requirement;

use aarch64_extension: masc.isa.aarch64.extension;
use masc.isa.aarch64.gen_extension;
use aarch64_set: masc.isa.aarch64.set;

use masc.harness.agree.agreement;
use masc.harness.agree.vectors;
use masc.tool.text;

val BASE: [1]requirement.Id = [1]requirement.Id{aarch64_extension.id.V8_0};

val VARIANTS: [1]agreement.Variant = [1]agreement.Variant{
    agreement.Variant{name: "a64", arch: ?arch_aarch64.AARCH64, base: requirement.Ids{at: ?BASE[0], len: 1}, abi: nil},
};

val LLVM_MC_PROGRAMS:      [1]str = [1]str{"llvm-mc"};
val LLVM_OBJDUMP_PROGRAMS: [1]str = [1]str{"llvm-objdump"};

val LLVM_MC:      agreement.Tool = agreement.Tool{name: "llvm-mc", programs: agreement.Programs{at: ?LLVM_MC_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};
val LLVM_OBJDUMP: agreement.Tool = agreement.Tool{name: "llvm-objdump", programs: agreement.Programs{at: ?LLVM_OBJDUMP_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};

# whether `s` holds a row attribute `e` enables
fun covered(s: *extension.Selection, e: *extension.NameEntry) bool {
    var i: u32 = 0;
    for (i < e.rows.len) {
        if (extension.has(s, e.rows.at[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# `head` and the selection as llvm attributes, `+` and each attribute it holds, comma separated, as one argument
fun attribute_arg(job: *agreement.Job, args: *agreement.Args, head: str) {
    var t:     text.Text = text.make(args.a);
    var first: bool      = true;
    text.put(?t, head);
    var i: u32 = 0;
    for (i < gen_extension.ATTRIBUTE_COUNT) {
        val e: *extension.NameEntry = ?gen_extension.ATTRIBUTES[i];
        if (covered(job.selection, e)) {
            if (!first) { text.byte(?t, ','); }
            text.byte(?t, '+');
            text.put(?t, e.key);
            first = false;
        }
        i = i + 1;
    }
    agreement.arg_text(args, ?t);
}

fun llvm_mc(job: *agreement.Job, args: *agreement.Args) {
    agreement.arg(args, "-triple=aarch64");
    attribute_arg(job, args, "-mattr=");
    agreement.arg(args, "-filetype=obj");
    agreement.arg(args, "-o");
    agreement.arg(args, job.object);
    agreement.arg(args, job.source);
}

fun llvm_objdump(job: *agreement.Job, args: *agreement.Args) {
    agreement.arg(args, "-d");
    agreement.arg(args, "--no-print-imm-hex");
    agreement.arg(args, "--no-show-raw-insn");
    attribute_arg(job, args, "--mattr=");
    agreement.arg(args, job.object);
}

val ASSEMBLERS: [1]agreement.Assembler = [1]agreement.Assembler{agreement.Assembler{tool: ?LLVM_MC, spell: llvm_mc, layout: nil}};

# the aarch64 operands' kinds state every value they take
fun hook(g: *vectors.Generation) {}

# the rows and statements the tools disagree on by their own limits, against llvm 23.1.1
pub val EXCEPTIONS_COUNT: u32 = 0;

val EXCEPTIONS: [1]agreement.Exception = [1]agreement.Exception{
    agreement.Exception{subject: agreement.Subject.statement{""}, variant: "", checks: 0, unless: "", when: "", reason: ""},
};

# the directives, specifiers and relaxation the rows' vectors do not reach, each leaving the selection as it found it
pub val STATEMENTS_COUNT: u32 = 12;

val STATEMENTS: [STATEMENTS_COUNT]agreement.Statement = [STATEMENTS_COUNT]agreement.Statement{
    agreement.Statement{text: ".inst 0xd503201f", of: ".inst"},
    agreement.Statement{text: ".inst 0xd503201f, 0x8b020020", of: ".inst"},
    agreement.Statement{text: ".arch_extension sve; add z0.s, z1.s, z2.s; .arch_extension nosve", of: ".arch_extension"},
    agreement.Statement{text: ".arch_extension crc; crc32b w0, w1, w2; .arch_extension nocrc", of: ".arch_extension"},
    agreement.Statement{text: ".arch armv8.3-a+fp+simd; ldaprb w0, [x1]; .arch armv8-a+fp+simd", of: ".arch"},
    agreement.Statement{text: ".cpu cortex-a76; ldaprb w0, [x1]; .arch armv8-a+fp+simd", of: ".cpu"},
    agreement.Statement{text: ".cpu generic+crc; crc32b w0, w1, w2; .arch armv8-a+fp+simd", of: ".cpu"},
    agreement.Statement{text: "adrp x0, sym; add x0, x0, :lo12:sym", of: "specifier"},
    agreement.Statement{text: "ldr x1, [x0, :lo12:sym]; ldrb w2, [x0, :lo12:sym]; ldr q3, [x0, :lo12:sym]", of: "specifier"},
    agreement.Statement{text: "adrp x2, :got:sym; ldr x2, [x2, :got_lo12:sym]", of: "specifier"},
    agreement.Statement{text: "bl sym; b sym; b.eq sym; cbz x0, sym; tbz x0, #3, sym; adr x0, sym; ldr x0, sym", of: "relocation"},
    agreement.Statement{text: "tbz x0, #3, .Lnear1; nop; .Lnear1: b.ne .Lnear1; cbnz w0, .Lnear1", of: "relaxation"},
};

# what the statements hold beside the base: the floating-point and simd registers llvm's armv8-a holds
val STATEMENT_REQUIRES: [2]requirement.Id = [2]requirement.Id{aarch64_extension.id.FP, aarch64_extension.id.SIMD};

# the aarch64 agreement
pub val AGREEMENT: agreement.Agreement = agreement.Agreement{
    name:         "aarch64",
    set:          ?aarch64_set.SET,
    syntax:       0,
    format:       ?mink_format.ELF,
    variants:     agreement.Variants{at: ?VARIANTS[0], len: 1},
    assemblers:   agreement.Assemblers{at: ?ASSEMBLERS[0], len: 1},
    disassembler: agreement.Disassembler{tool: ?LLVM_OBJDUMP, spell: llvm_objdump, comment: "//", aliased: true, listed: nil, named: nil, target: "#", immediate: "#"},
    statements:   agreement.Statements{at: ?STATEMENTS[0], len: STATEMENTS_COUNT, requires: requirement.Ids{at: ?STATEMENT_REQUIRES[0], len: 2}},
    exceptions:   agreement.Exceptions{at: ?EXCEPTIONS[0], len: EXCEPTIONS_COUNT},
    hook:         hook,
    targets:      agreement.NUMBER,
    edges:        nil,
    stream:       nil,
};
