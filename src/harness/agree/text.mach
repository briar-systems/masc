# text the harness builds: a growing buffer whose first refused growth sticks
#
# the report, tool arguments and source files are written piece by piece. a
# piece the allocator refuses marks the text failed and every later piece is
# dropped, so a writer checks `failed` once, when the text is done, rather
# than after every piece.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

# a text being built
# ---
# out:    the bytes so far, never holding a terminator until `done`
# failed: whether a growth was refused, after which nothing more is written
pub rec Text {
    out:    vector.Vector[u8];
    failed: bool;
}

# an empty text over `a`
pub fun make(a: *A.Allocator) Text {
    ret Text{out: vector.init[u8](a), failed: false};
}

# the text emptied for reuse, its failure kept
pub fun clear(t: *Text) {
    t.out.len = 0;
}

# one byte appended
pub fun byte(t: *Text, c: u8) {
    if (t.failed) { ret; }
    val pushed: res[usize, A.Error] = vector.push[u8](?t.out, c);
    if (sel pushed.err) { t.failed = true; }
}

# `len` bytes at `p` appended
pub fun bytes(t: *Text, p: *u8, len: usize) {
    var i: usize = 0;
    for (i < len && !t.failed) {
        byte(t, p[i]);
        i = i + 1;
    }
}

# `s` appended
pub fun put(t: *Text, s: str) {
    bytes(t, s, str_len(s));
}

# the view `v` appended
pub fun view(t: *Text, v: View) {
    bytes(t, v.data, v.len);
}

# `n` appended in decimal, signed
pub fun decimal(t: *Text, n: i64) {
    var digits: [20]u8;
    var m:      u64 = n:~u64;
    var at:     u32 = 20;
    if (n < 0) {
        byte(t, '-');
        m = ~m + 1;
    }
    for {
        at         = at - 1;
        digits[at] = '0' + (m % 10)::u8;
        m          = m / 10;
        if (m == 0) { brk; }
    }
    bytes(t, ?digits[at], (20 - at)::usize);
}

# `b` appended as two lowercase hexadecimal digits
pub fun hex(t: *Text, b: u8) {
    byte(t, "0123456789abcdef"[(b >> 4)::usize]);
    byte(t, "0123456789abcdef"[(b & 15)::usize]);
}

# `s` appended and then spaces up to `width` bytes, at least one
pub fun column(t: *Text, s: str, width: usize) {
    put(t, s);
    var n: usize = str_len(s);
    byte(t, ' ');
    n = n + 1;
    for (n < width) {
        byte(t, ' ');
        n = n + 1;
    }
}

# a copy of the text so far as a terminated string `a` owns, none when the copy or any growth was refused
pub fun copy(t: *Text, a: *A.Allocator) opt[str] {
    if (t.failed) { ret opt[str].none{}; }
    val got: res[*u8, A.Error] = A.allocate[u8](a, t.out.len + 1);
    if (sel got.err) { ret opt[str].none{}; }
    var i: usize = 0;
    for (i < t.out.len) {
        got.ok[i] = t.out.data[i];
        i         = i + 1;
    }
    got.ok[t.out.len] = 0;
    ret opt[str].some{got.ok::str};
}
