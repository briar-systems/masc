# the report of an agreement run: the tools and their versions, a summary per variant, the tools' notes, and a line
# per row at each variant, with every vector of a row that disagrees laid out under it
#
# a disagreeing vector shows masc's printing of it, which every assembler
# read, the checks it fails, then what each tool made of it: the bytes of masc and of each
# assembler, masc's and the disassembler's printing of the reference bytes,
# and masc's printing of its own bytes with what it assembles back to.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;
use fs: std.filesystem;

use masc.core.operand;

use masc.harness.agree.agreement;
use masc.harness.agree.run;
use masc.harness.agree.tool;
use masc.tool.text;

# the width of the name column of a vector's facts
val FACT: usize = 16;

fun bytes(t: *text.Text, b: operand.Bytes) {
    var i: u32 = 0;
    for (i < b.len) {
        if (i > 0) { text.byte(t, ' '); }
        text.hex(t, b.at[i]);
        i = i + 1;
    }
    if (b.len == 0) { text.put(t, "no bytes"); }
}

fun outcome(t: *text.Text, name: str, o: *run.Outcome) {
    text.put(t, "        ");
    text.column(t, name, FACT);
    if (sel o.bytes) { bytes(t, o.bytes); }
    or (sel o.refused) {
        text.put(t, "refused: ");
        text.put(t, o.refused);
    }
    or { text.put(t, "not run"); }
    text.byte(t, '\n');
}

fun printed(t: *text.Text, name: str, p: *run.Printed) {
    text.put(t, "        ");
    text.column(t, name, FACT);
    if (sel p.text) { text.put(t, p.text); }
    or (sel p.refused) {
        text.put(t, "none: ");
        text.put(t, p.refused);
    }
    or { text.put(t, "not printed"); }
    text.byte(t, '\n');
}

# the checks of `mask` by name, comma separated
fun checks(t: *text.Text, mask: agreement.Checks) {
    val names: [3]str = [3]str{"bytes", "decode", "trip"};
    var first: bool   = true;
    var i:     u32    = 0;
    for (i < 3) {
        if ((mask & (1::u8 << i::u8)) != 0) {
            if (!first) { text.put(t, ", "); }
            text.put(t, names[i]);
            first = false;
        }
        i = i + 1;
    }
}

# the facts of one vector
fun case_of(t: *text.Text, result: *run.Result, c: *run.Case) {
    text.put(t, "    ");
    if (c.text != nil) { text.put(t, c.text); }
    or                 { text.put(t, "(no printing)"); }
    text.byte(t, '\n');
    text.put(t, "        ");
    text.column(t, "fails", FACT);
    checks(t, run.failed(result, c));
    text.byte(t, '\n');
    outcome(t, "masc", ?c.masc);
    var j: usize = 0;
    for (j < result.assemblers.len) {
        outcome(t, result.assemblers.data[j].tool.name, ?c.tools[j]);
        j = j + 1;
    }
    printed(t, "masc reads", ?c.decoded);
    printed(t, result.disassembler.tool.name, ?c.listed);
    printed(t, "masc prints", ?c.printed);
    outcome(t, "assembled back", ?c.trip);
}

fun found(t: *text.Text, f: *tool.Found) {
    text.put(t, "  ");
    text.column(t, f.tool.name, FACT);
    if (f.path == nil) { text.put(t, "not installed"); }
    or {
        text.put(t, f.path);
        text.put(t, ", ");
        text.put(t, f.version);
        if (!f.pinned) { text.put(t, ", not at its pin, not run"); }
    }
    text.put(t, " (pinned at \"");
    text.put(t, f.tool.pin);
    text.put(t, "\")\n");
}

# each variant's counts of rows by state and of vectors
pub fun summary(t: *text.Text, result: *run.Result) {
    var k: usize = 0;
    for (k < result.widths.len) {
        val w:       *run.Width = ?result.widths.data[k];
        var counts:  [7]u32;
        var vectors: u32        = 0;
        var i:       usize      = 0;
        for (i < w.verdicts.len) {
            val v: *run.Verdict = ?w.verdicts.data[i];
            counts[v.state] = counts[v.state] + 1;
            vectors         = vectors + v.count;
            i               = i + 1;
        }
        text.put(t, "  ");
        text.put(t, w.variant.name);
        text.put(t, "  rows ");
        text.decimal(t, w.verdicts.len::i64);
        text.put(t, "  vectors ");
        text.decimal(t, vectors::i64);
        var s: u32 = 0;
        for (s < run.STATE_COUNT) {
            text.put(t, "  ");
            text.put(t, run.STATE_NAMES[s]);
            text.byte(t, ' ');
            text.decimal(t, counts[s]::i64);
            s = s + 1;
        }
        text.byte(t, '\n');
        k = k + 1;
    }
}

# the whole report of `result` written to `path`
# ---
# ret: ok, or why it was not written
pub fun write(a: *A.Allocator, result: *run.Result, path: str) err[str] {
    var t: text.Text = text.make(a);
    text.put(?t, "masc agreement report: ");
    text.put(?t, result.agreement.name);
    text.put(?t, "\n\nselection: each row under its variant's base and the first alternative of its requirement that closes with it");
    if (result.options.full) { text.put(?t, ", widened by every extension of the catalog, in order, that keeps it closed"); }
    text.put(?t, "\n\ntools\n");
    var j: usize = 0;
    for (j < result.assemblers.len) {
        found(?t, ?result.assemblers.data[j]);
        j = j + 1;
    }
    found(?t, ?result.disassembler);
    text.put(?t, "\nsummary\n");
    summary(?t, result);
    text.put(?t, "  failing ");
    text.decimal(?t, result.failures::i64);
    text.put(?t, "\n\nnotes\n");
    var n: usize = 0;
    for (n < result.notes.len) {
        text.put(?t, "  ");
        text.put(?t, result.notes.data[n]);
        text.byte(?t, '\n');
        n = n + 1;
    }
    if (result.notes.len == 0) { text.put(?t, "  none\n"); }
    text.put(?t, "\nrows\n");
    var k: usize = 0;
    for (k < result.widths.len) {
        val w: *run.Width = ?result.widths.data[k];
        var i: usize      = 0;
        for (i < w.verdicts.len) {
            val v: *run.Verdict = ?w.verdicts.data[i];
            text.put(?t, w.variant.name);
            text.byte(?t, ' ');
            text.column(?t, v.row.key, 24);
            text.column(?t, run.STATE_NAMES[v.state], 12);
            text.decimal(?t, v.count::i64);
            if (v.group != nil) {
                text.byte(?t, ' ');
                text.put(?t, v.group.spelled);
            }
            if (v.exception != nil) {
                text.put(?t, " (excuses ");
                checks(?t, v.exception.checks);
                text.put(?t, ": ");
                text.put(?t, v.exception.reason);
                text.byte(?t, ')');
            }
            text.byte(?t, '\n');
            if (v.state == run.DISAGREE || v.state == run.EXCEPTED) {
                var c: u32 = 0;
                for (c < v.count) {
                    val one: *run.Case = ?v.group.cases.data[v.first + c];
                    if (run.fails(result, one)) { case_of(?t, result, one); }
                    c = c + 1;
                }
            }
            i = i + 1;
        }
        k = k + 1;
    }
    if (t.failed) { ret err[str].err{"out of memory"}; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, t.out.data, t.out.len, 0o644);
    if (sel wrote.err) { ret err[str].err{"the report cannot be written"}; }
    ret err[str].ok{};
}
