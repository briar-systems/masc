# the contract every set's agreement implements
#
# a set's agreement is one static record: the widths or modes the set is
# checked at, the external tools that assemble and disassemble it, at the
# version each is pinned to, how each is asked, the source lines it states
# beyond what the rows' vectors reach, as a directive that states an
# instruction itself, the rows, spellings and lines whose disagreement is
# understood and why, and the hook that offers vectors beyond what the
# operand kinds give. the framework owns the vectors, running the tools,
# reading their objects through mink, every comparison and the report.
#
# a set of a typed stream reads each vector under what its stream holds, so
# its agreement states a stream record: how a need its edges hook names is
# provided to masc's stream, and how a vector takes the resources of its own
# slot in a file, as spir-v's distinct result ids. each of its tools states
# how a job's vectors are laid out in one source, inside the frame the needs
# make, and found again in what the tool wrote, and its disassembler how its
# listing is read back to one text per vector. masc reads and encodes each
# vector under the job's stream, as its assembler would read the source.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;

use mink.catalog.arch;
use mink.catalog.format;
use mink.format.registry;

use masc.core.dispatch;
use masc.core.extension;
use masc.core.inst;
use masc.core.operand;
use masc.core.requirement;
use masc.core.set;
use masc.core.state;

use masc.harness.agree.vectors;
use masc.tool.text;

# one width or mode a set is checked at, as risc-v's rv32 and rv64
# ---
# name:     the name the report gives it
# arch:     the architecture its objects are for
# base:     the extensions every selection of it holds, as rv64 and i
# abi:      the architecture's abi row every assembler is given, masc as the row and an external one as its name in
#           its option, as risc-v's `-mabi=lp64`, nil for an architecture whose encodings no abi row moves, as x86's
#           and spir-v's
# excludes: the extensions no selection of it holds, as risc-v's d, which the ilp32e abi must not be used with
pub rec Variant {
    name:     str;
    arch:     *arch.Arch;
    base:     requirement.Ids;
    abi:      *arch.Abi;
    excludes: requirement.Ids;
}

# variants as a pointer to static rows and a count
pub rec Variants {
    at:  *Variant;
    len: u32;
}

# program names as a pointer to static names and a count
pub rec Programs {
    at:  *str;
    len: u32;
}

# an external tool at its pinned version
# ---
# name:     the name the report gives it
# programs: the program names it is found by on the path, tried in order
# pin:      the text its `--version` output holds at the version the exceptions were written against
pub rec Tool {
    name:     str;
    programs: Programs;
    pin:      str;
}

# what one run of a tool is asked
# ---
# variant:   the variant
# selection: the selection the vectors are generated under
# source:    the source file an assembler reads
# object:    the object an assembler writes and a disassembler reads
# needs:     what the job's vectors need the stream to hold, which a layout's source defines, none for a set of no
#            stream
pub rec Job {
    variant:   *Variant;
    selection: *extension.Selection;
    source:    str;
    object:    str;
    needs:     vectors.Needs;
}

# the arguments of a run after the program's name, whose first refused growth sticks
# ---
# a:      the allocator of the arguments
# list:   the arguments in order
# failed: whether the allocator refused
pub rec Args {
    a:      *A.Allocator;
    list:   vector.Vector[str];
    failed: bool;
}

# `s`, which outlives the run, appended as one argument
pub fun arg(args: *Args, s: str) {
    if (args.failed) { ret; }
    val pushed: res[usize, A.Error] = vector.push[str](?args.list, s);
    if (sel pushed.err) { args.failed = true; }
}

# the text `t` so far appended as one argument, copied
pub fun arg_text(args: *Args, t: *text.Text) {
    val copied: opt[str] = text.copy(t, args.a);
    if (sel copied.none) {
        args.failed = true;
        ret;
    }
    arg(args, copied.some);
}

# how a set asks a tool for one run: its arguments for the job appended
pub def Spell: fun(*Job, *Args);

# what a layout's split reads a tool's file with
# ---
# a:       the allocator of what it gives back, which outlives the run
# job:     the job
# codec:   the set's codec
# ctx:     the job's context, whose stream holds the job's needs, so a split may decode
# formats: mink's format registry, through which a split may read the file
# vectors: the vectors the file holds, in slot order
# count:   how many
pub rec Split {
    a:       *A.Allocator;
    job:     *Job;
    codec:   *dispatch.Codec;
    ctx:     *state.Context;
    formats: *registry.Registry;
    vectors: *inst.Inst;
    count:   u32;
}

# how one assembler of a set of a typed stream reads a job's vectors as one source, and where each vector's bytes are
# in what it writes
# ---
# open:   the text before the vectors: what the job's needs define, spelled for the tool, and the frame they sit in
# vector: one vector's text, its printing by masc given with its instruction, and any frame of its own, as the blocks
#         a branch's depth needs, which is not compared
# close:  the text after the vectors, which closes the frame
# split:  each vector's bytes out of the file the tool wrote, in slot order, its own frame left out, refused when the
#         file does not hold the split's vectors
pub rec Layout {
    open:   fun(*Job, *text.Text);
    vector: fun(*Job, *inst.Inst, str, *text.Text);
    close:  fun(*Job, *text.Text);
    split:  fun(*Split, operand.Bytes, *vector.Vector[operand.Bytes]) err[str];
}

# an external assembler
# ---
# tool:   the tool
# spell:  its arguments, which assemble the job's source into its object
# layout: how it reads a job's vectors as one source, nil for one section of an elf object per vector
pub rec Assembler {
    tool:   *Tool;
    spell:  Spell;
    layout: *Layout;
}

# assemblers as a pointer to static rows and a count
pub rec Assemblers {
    at:  *Assembler;
    len: u32;
}

# how a disassembler's listing is read back: each vector's printing, in slot order, from the standard output `out`
# of a run over a file of `count` vectors, their frames left out, each allocated from the vector's own allocator,
# refused when it holds no printing of them
pub def Listed: fun(*Job, str, u32, *vector.Vector[str]) err[str];

# an external disassembler
# ---
# tool:    the tool
# spell:   its arguments, which list the job's object on its standard output, each instruction by its own form with no
#          alias applied where the tool can be told to
# comment: the text it opens an annotation of a listed instruction with, which runs to the line's end and is no part
#          of the instruction, as llvm-objdump's x86 `# 0x25 <.text.4+0x25>` after a rip-relative address, nil for
#          a disassembler that writes none
# aliased: whether its listing applies aliases whatever it is told, as llvm-objdump 23.1.1 lists x86's `cmpps` with
#          predicate 1 as `cmpltps`, so the decode check compares masc's printing by the alias it prefers. false for a
#          listing of each instruction by its own form, as llvm-objdump's `-M no-aliases` gives risc-v's
# listed:  how its listing is read back, nil for an objdump listing of one section per vector
# named:   the vector, by its place among a file's `count`, that a failed run's standard error names, none when it names
#          none. that vector is left out and the reference file listed again without it, as an assembler's refusal at a
#          line is. nil for a disassembler that names none
pub rec Disassembler {
    tool:    *Tool;
    spell:   Spell;
    comment: str;
    aliased: bool;
    listed:  Listed;
    named:   fun(*Job, str, u32) opt[u32];
}

# how a set of a typed stream's vectors are read: the stream each job's vectors read under, which masc's own reading
# and every tool's source share
# ---
# provide: what a need defines added to the stream state, refused for a need the set does not define
# place:   the vector given the resources of its own slot in a job's file, as spir-v's result id, which no other vector
#          of the file may define
pub rec Stream {
    provide: vectors.Provide;
    place:   fun(*inst.Inst, u32);
}

# how the external assemblers read a relative target
# ---
# NUMBER: as the number the instruction holds, as masc's syntax writes it
# LABEL:  only as an expression of a symbol, as llvm-mc's intel syntax reads one: each vector's section opens with a
#         label of its own, and a target is written as that label plus its offset from the vector's start, the one
#         masc's assembly of the vector reaches
# DOT:    as `.` and the target's distance from the instruction's start, as `.+8`, which every risc-v assembler reads as
#         that distance where the gnu assembler reads a bare number as an address. masc's printing of its own bytes
#         for the trip check is spelled so too, since masc reads the two spellings to the same value but compresses
#         only the number
pub def Targets: u8;

pub val NUMBER: Targets = 0;
pub val LABEL:  Targets = 1;
pub val DOT:    Targets = 2;

# the checks a vector is held to, as a mask, which an exception names the ones of it excuses
pub def Checks: u8;

# masc and every assembler run give the same bytes, none refusing
pub val BYTES: Checks = 1;
# masc's printing of the reference bytes is the disassembler's
pub val DECODE: Checks = 2;
# masc's printing of its own bytes assembles back to them
pub val TRIP: Checks = 4;

# a further spelling of a row, an alias the syntax reads it by
# ---
# row:      the row's key
# template: the spelling's template, as the syntax's alias table states it
pub rec Spelling {
    row:      str;
    template: str;
}

# what an exception names
# ---
# row:       a row, by its key, whose own form's vectors it excuses
# spelling:  a further spelling of a row, whose vectors it excuses
# statement: a source line the agreement states, by its text
pub tag Subject: u8 {
    row:       str;
    spelling:  Spelling;
    statement: str;
}

# a row, a spelling or a statement whose disagreement is understood
# ---
# subject: what it names
# variant: the variant it disagrees at, empty for every variant. a subject is named once at each, and one named at a
#          variant is taken there over one named at every variant
# checks:  the checks it excuses, every other one still held of the vectors it names
# unless:  the extensions whose absence it excuses, comma separated, as a tool decoding an extension the selection
#          lacks: it applies only under a selection that lacks one of them. empty for every selection
# when:    the extensions it applies with, comma separated, as a tool bug in an operand only an extension admits: it
#          applies only under a selection that holds every one of them. empty for every selection
# reason:  why, as an extension a tool does not support or a documented tool bug
pub rec Exception {
    subject: Subject;
    variant: str;
    checks:  Checks;
    unless:  str;
    when:    str;
    reason:  str;
}

# exceptions as a pointer to static rows and a count
pub rec Exceptions {
    at:  *Exception;
    len: u32;
}

# the exceptions of a set with none
pub val NO_EXCEPTIONS: Exceptions = Exceptions{at: nil, len: 0};

# a source line every assembler reads, which no row's vector reaches, as risc-v's `.insn` or a sequence to a symbol.
# it is held to the bytes check alone: masc and every assembler give it the same bytes and relocations, or all refuse it
# ---
# text: the line, its statements apart by the dialect's separator, leaving the modes and the selection as it found them
# of:   what it covers, which the report counts it under, as `.insn`
pub rec Statement {
    text: str;
    of:   str;
}

# statements as a pointer to static rows and a count, and the extensions each variant's selection of them holds beside
# its base
pub rec Statements {
    at:       *Statement;
    len:      u32;
    requires: requirement.Ids;
}

# the statements of an agreement that states none
pub val NO_STATEMENTS: Statements = Statements{at: nil, len: 0, requires: requirement.Ids{at: nil, len: 0}};

# the agreement of one set
# ---
# name:         the name it is run by, as `riscv`
# set:          the set
# syntax:       the index of the set's syntax the vectors are written in, which every tool reads
# format:       the object format every assembler writes, whose dialect masc's assembler reads
# variants:     the widths or modes it is checked at
# assemblers:   the external assemblers, the reference first: the reference must be installed at its pin, and its
#               object is the one the disassembler reads. every other one runs where it is installed at its pin
# disassembler: the disassembler, which must be installed at its pin
# statements:   the source lines it states beyond the rows' vectors
# exceptions:   the rows, spellings and statements whose disagreement is understood
# hook:         the values the set's operands take beyond their kind's edges
# targets:      how the external assemblers read a relative target
# edges:        the edges of the values the set chooses itself, nil for a set whose kinds choose every value
# stream:       how the vectors of a set of a typed stream are read, nil for a set of none, whose tools write elf
pub rec Agreement {
    name:         str;
    set:          *set.Set;
    syntax:       u32;
    format:       *format.Format;
    variants:     Variants;
    assemblers:   Assemblers;
    disassembler: Disassembler;
    statements:   Statements;
    exceptions:   Exceptions;
    hook:         vectors.Hook;
    targets:      Targets;
    edges:        vectors.Edges;
    stream:       *Stream;
}

# agreements as a pointer to static records and a count
pub rec Agreements {
    at:  **Agreement;
    len: u32;
}
