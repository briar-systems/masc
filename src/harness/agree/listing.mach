# the disassembler's listing read per vector, and the one normalisation two printings are compared under
#
# llvm-objdump writes each section under a `Disassembly of section` line and
# each instruction as its address, a colon and its text. asked for decimal
# immediates, it still writes a branch target as the address it reaches, in
# hexadecimal and followed by the symbol and offset it falls at, as
# `0x10 <.text.3+0x10>`, where masc's syntax writes the offset the
# instruction encodes. with every vector at address 0 of its own section, a
# hexadecimal number in the listing is such an address, so it is read back to
# that offset from the instruction's own address, written after the text the
# syntax writes before a target, as aarch64's `#`, and the symbol after it is
# dropped. the one other hexadecimal number is an immediate objdump writes in
# hexadecimal however it is asked, after the text the disassembler writes
# before an immediate, as aarch64's `svc #0x1` and its logical masks, read as
# its decimal value. the symbol and offset objdump writes after any other
# operand that reaches an address, as jalr's `1(zero) <.text.3+0x1>`, is
# dropped as well.
# this is the one reading of the listing beyond its whitespace: it turns
# objdump's presentation of the target and of the immediate into the number
# the instruction holds, and compares nothing less. an annotation the
# disassembler opens with its comment text, as x86's `# 0x25 <.text.4+0x25>`
# after a rip-relative address, is dropped with the rest of its line.
#
# two printings are compared with their whitespace normalised only: a run of
# white space between two characters of words is one space, and any other is
# none, so `add a0,a1` and `add\ta0, a1` compare equal and `ad d` does not
# equal `add`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;

use masc.harness.agree.object;
use masc.tool.text;

# what the listing holds of one vector
# ---
# vector: the vector's number in its source file
# text:   its instructions in order, joined by `; `, their targets read back to offsets
pub rec Listed {
    vector: u32;
    text:   str;
}

# the header of each section's listing
val SECTION: str = "Disassembly of section ";

# the separator of two instructions of one vector
pub val JOIN: str = "; ";

fun blank(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\r' || c == '\n';
}

fun word(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '$';
}

fun hexit(c: u8) i64 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i64; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a' + 10)::i64; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A' + 10)::i64; }
    ret -1;
}

# the text of one listed instruction at `address` from `s[at..end]` appended to `t`, each hexadecimal target read
# back to its offset from `address`, wrapped to an address of `bytes` bytes, after `target` unless it is nil, and
# each hexadecimal number after `immediate` read as its decimal value
fun resolved(t: *text.Text, s: str, at: usize, end: usize, address: u64, bytes: u8, target: str, immediate: str) {
    var i: usize = at;
    for (i < end) {
        val starts: bool = s[i] == '0' && i + 2 < end && (s[i + 1] == 'x' || s[i + 1] == 'X') && hexit(s[i + 2]) >= 0;
        if (starts && (i == at || !word(s[i - 1]))) {
            var v: u64   = 0;
            var j: usize = i + 2;
            for (j < end && hexit(s[j]) >= 0) {
                v = (v << 4) | hexit(s[j])::u64;
                j = j + 1;
            }
            if (after(s, at, i, immediate)) {
                unsigned(t, v);
                i = j;
                cnt;
            }
            if (j + 1 < end && s[j] == ' ' && s[j + 1] == '<') {
                var k: usize = j + 1;
                for (k < end && s[k] != '>') { k = k + 1; }
                if (k < end) { j = k + 1; }
            }
            var offset: u64 = v - address;
            if (bytes < 8) {
                val bits: u64 = bytes::u64 * 8;
                offset = offset & ((1::u64 << bits) - 1);
                if ((offset >> (bits - 1)) != 0) { offset = offset | ~((1::u64 << bits) - 1); }
            }
            if (target != nil) { text.put(t, target); }
            text.decimal(t, offset:~i64);
            i = j;
            cnt;
        }
        text.byte(t, s[i]);
        i = i + 1;
    }
}

# whether `s[at..i]` ends with `text`, or with it and a minus, false when `text` is nil
fun after(s: str, at: usize, i: usize, text: str) bool {
    if (text == nil) { ret false; }
    var e: usize = i;
    if (e > at && s[e - 1] == '-') { e = e - 1; }
    val n: usize = str_len(text);
    if (e < at + n) { ret false; }
    var k: usize = 0;
    for (k < n && s[e - n + k] == text[k]) { k = k + 1; }
    ret k == n;
}

# `v` appended to `t` in decimal
fun unsigned(t: *text.Text, v: u64) {
    if (v >= 10) { unsigned(t, v / 10); }
    text.byte(t, '0' + (v % 10)::u8);
}

# the end of the listed instruction in `s[at..end]` before the symbol and offset objdump writes after its last
# operand, as ` <.text.3+0x1>`, or `end` when it writes none
fun unannotated(s: str, at: usize, end: usize) usize {
    var e: usize = end;
    for (e > at && blank(s[e - 1])) { e = e - 1; }
    if (e == at || s[e - 1] != '>') { ret end; }
    var k: usize = e - 1;
    for (k > at && s[k] != '<') { k = k - 1; }
    if (s[k] != '<' || k == at || s[k - 1] != ' ') { ret end; }
    ret k - 1;
}

# the end of the listed instruction in `s[at..end]` before the annotation `comment` opens, or `end` when there is none
fun uncommented(s: str, at: usize, end: usize, comment: str) usize {
    if (comment == nil) { ret end; }
    val n: usize = str_len(comment);
    var i: usize = at;
    for (i + n <= end) {
        var k: usize = 0;
        for (k < n && s[i + k] == comment[k]) { k = k + 1; }
        if (k == n) { ret i; }
        i = i + 1;
    }
    ret end;
}

# the listing `s` read into `out`, a vector per section the source file gave it, its addresses `bytes` bytes wide
# ---
# a:         the allocator of each vector's text
# scratch:   the allocator the texts are built in
# comment:   the text the disassembler opens an annotation with, nil for none
# target:    the text the syntax writes before a target's number, nil for none
# immediate: the text the disassembler writes before an immediate it may write in hexadecimal, nil for none
# ret:       ok, or why the listing cannot be read
pub fun read(a: *A.Allocator, scratch: *A.Allocator, s: str, bytes: u8, comment: str, target: str, immediate: str, out: *vector.Vector[Listed]) err[str] {
    var t:       text.Text = text.make(scratch);
    var current: opt[u32]  = opt[u32].none{};
    var count:   u32       = 0;
    var at:      usize     = 0;
    var n:       usize     = str_len(SECTION);
    for {
        var end: usize = at;
        for (s[end] != 0 && s[end] != '\n') { end = end + 1; }
        var header: bool  = end - at > n;
        var k:      usize = 0;
        for (header && k < n) {
            header = s[at + k] == SECTION[k];
            k      = k + 1;
        }
        if (header || s[end] == 0) {
            if (sel current.some) {
                val copied: opt[str] = text.copy(?t, a);
                if (sel copied.none) { ret err[str].err{"out of memory"}; }
                val pushed: res[usize, A.Error] = vector.push[Listed](out, Listed{vector: current.some, text: copied.some});
                if (sel pushed.err) { ret err[str].err{"out of memory"}; }
            }
            text.clear(?t);
            count   = 0;
            current = opt[u32].none{};
            if (header) {
                var close: usize = end;
                for (close > at + n && s[close - 1] != ':') { close = close - 1; }
                if (close > at + n) { current = object.numbered(?s[at + n], close - 1 - (at + n)); }
            }
        }
        or (sel current.some) {
            var i: usize = at;
            for (i < end && blank(s[i])) { i = i + 1; }
            var address: u64   = 0;
            val first:   usize = i;
            for (i < end && hexit(s[i]) >= 0) {
                address = (address << 4) | hexit(s[i])::u64;
                i       = i + 1;
            }
            if (i > first && i < end && s[i] == ':') {
                if (count > 0) { text.put(?t, JOIN); }
                val stop: usize = uncommented(s, i + 1, end, comment);
                resolved(?t, s, i + 1, unannotated(s, i + 1, stop), address, bytes, target, immediate);
                count = count + 1;
            }
        }
        if (s[end] == 0) { brk; }
        at = end + 1;
    }
    if (t.failed) { ret err[str].err{"out of memory"}; }
    ret err[str].ok{};
}

# `s` with its whitespace normalised, copied into `a`, none when it refuses
pub fun normal(a: *A.Allocator, s: str) opt[str] {
    var t: text.Text = text.make(a);
    var i: usize     = 0;
    for (blank(s[i])) { i = i + 1; }
    for (s[i] != 0) {
        if (blank(s[i])) {
            var j: usize = i;
            for (blank(s[j])) { j = j + 1; }
            if (s[j] != 0 && t.out.len > 0 && word(t.out.data[t.out.len - 1]) && word(s[j])) { text.byte(?t, ' '); }
            i = j;
            cnt;
        }
        text.byte(?t, s[i]);
        i = i + 1;
    }
    ret text.copy(?t, a);
}
