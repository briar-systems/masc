# the spir-v agreement: every row against spirv-as, decoded against spirv-dis
#
# spir-v is a typed stream, so a job's vectors are one module whose prelude
# defines what they need: the 32-bit unsigned integer type a typed literal's
# width and an OpSwitch selector's value take, the float type of each width a
# typed float literal takes, and the import of each set an extended
# instruction names. each vector is one line after it, and its result
# is an id of its own, FIRST_RESULT on from its slot. spirv-as is asked for the
# highest core version the selection holds as its target and keeps the ids as
# written, and the bytes of each vector are the module's last instructions,
# one per vector, after its five word header. spirv-dis lists every
# instruction on a line of its own by raw id, so the last lines are the
# vectors'. spirv-as reads no capability the module does not state, so the
# prelude declares none, and spirv-val is not asked: a vector is one
# instruction, not a valid module.
#
# the edges hook chooses what the kinds cannot: a defined result is a
# placeholder each vector's slot replaces, an id a literal's width turns on is
# the prelude's type or a value of it, a set operand is the prelude's import of
# the row's set, any other id is the first and last id a word holds, and a
# typed literal is a word at its edges. a string is one that fills its last
# word to its end, one that leaves room for its terminator and one that
# spills it to a word of its own, and an import's is every set masc has rows
# of: the longest string a kind admits makes an instruction longer than its
# word count holds once its other operands are there, which both refuse.
#
# a float is at its edges, zero, the least subnormal, the largest finite
# value, infinity and the quiet nan, each a bit pattern of its format: a float
# immediate a binary32 one, and a typed literal one of each float type of the
# prelude, the binary16, binary32 and binary64 its type operand names, which
# the hook offers with that type, since the literal's edges turn on it. each
# is a value both tools write exactly, as spirv-as rounds a float other than
# masc does, toward zero.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;
use std.math.ieee;

use mink.catalog.arch.spirv;
use mink_format: mink.catalog.format;

use masc.core.extension;
use masc.core.field;
use masc.core.inst;
use masc.core.operand;
use masc.core.requirement;
use masc.core.row;

use spirv_extension: masc.isa.spirv.extension;
use masc.isa.spirv.gen_operand;
use masc.isa.spirv.gen_row;
use masc.isa.spirv.gen_row_index;
use spirv_kind:   masc.isa.spirv.kind;
use spirv_set:    masc.isa.spirv.set;
use spirv_stream: masc.isa.spirv.stream;

use masc.harness.agree.agreement;
use masc.harness.agree.object;
use masc.harness.agree.vectors;
use masc.tool.text;

# the prelude's 32-bit unsigned integer type and the value of it an OpSwitch selector takes
val TYPE_ID:  u32 = 1;
val VALUE_ID: u32 = 2;

# the id the import of set code c takes, IMPORT_BASE + c
val IMPORT_BASE: u32 = 2;

# the result of the vector in slot k is FIRST_RESULT + k, past every id the prelude defines
val FIRST_RESULT: u32 = 100;

# what a need of the id space is, in the agreement's own codes, a float type's FLOAT_TYPE and its width
val INTEGER_TYPE:  u32 = 1;
val INTEGER_VALUE: u32 = 2;
val FLOAT_TYPE:    u32 = 0x1_0000;

# the widths of the prelude's float types, each the id of its own type
val FLOAT_WIDTHS: [3]u32 = [3]u32{16, 32, 64};

# the edges of a float of each format, its bit patterns
val FLOAT_EDGES: u32 = 5;

# the largest id a word holds
val LAST_ID: u32 = 0xFFFF_FFFF;

# the header a module's words start with
val MAGIC:        u32 = 0x0723_0203;
val HEADER_WORDS: u32 = 5;

val BASE: [1]requirement.Id = [1]requirement.Id{spirv_extension.id.SPV1_0};

val VARIANTS: [1]agreement.Variant = [1]agreement.Variant{
    agreement.Variant{name: "spirv", arch: ?spirv.SPIRV, base: requirement.Ids{at: ?BASE[0], len: 1}, abi: nil},
};

val SPIRV_AS_PROGRAMS:  [1]str = [1]str{"spirv-as"};
val SPIRV_DIS_PROGRAMS: [1]str = [1]str{"spirv-dis"};

val SPIRV_AS:  agreement.Tool = agreement.Tool{name: "spirv-as", programs: agreement.Programs{at: ?SPIRV_AS_PROGRAMS[0], len: 1}, pin: "SPIRV-Tools v2026.4"};
val SPIRV_DIS: agreement.Tool = agreement.Tool{name: "spirv-dis", programs: agreement.Programs{at: ?SPIRV_DIS_PROGRAMS[0], len: 1}, pin: "SPIRV-Tools v2026.4"};

# the minor of the highest core version the selection holds, 0 for spir-v 1.0
fun minor(s: *extension.Selection) u32 {
    var best: u32 = 0;
    var i:    u32 = 0;
    for (i < gen_operand.VERSION_ATOM_COUNT) {
        val a: *spirv_kind.Atom = ?gen_operand.VERSION_ATOMS[i];
        val m: u32              = (a.value >> 8) & 0xFF;
        if (extension.has(s, a.id) && m > best) { best = m; }
        i = i + 1;
    }
    ret best;
}

fun spirv_as(job: *agreement.Job, args: *agreement.Args) {
    agreement.arg(args, "--preserve-numeric-ids");
    agreement.arg(args, "--target-env");
    var t: text.Text = text.make(args.a);
    text.put(?t, "spv1.");
    text.decimal(?t, minor(job.selection)::i64);
    agreement.arg_text(args, ?t);
    agreement.arg(args, job.source);
    agreement.arg(args, "-o");
    agreement.arg(args, job.object);
}

fun spirv_dis(job: *agreement.Job, args: *agreement.Args) {
    agreement.arg(args, "--raw-id");
    agreement.arg(args, "--no-header");
    agreement.arg(args, "--no-indent");
    agreement.arg(args, "--no-color");
    agreement.arg(args, job.object);
}

# the name the set of import code `code` is imported by, nil for a code masc has no rows of
fun import_name(code: u32) str {
    var i: u32 = 0;
    for (i < gen_operand.IMPORT_COUNT) {
        if (gen_operand.IMPORTS[i].row == code) { ret gen_operand.IMPORTS[i].key; }
        i = i + 1;
    }
    ret nil;
}

# the line that defines `n`
fun define(t: *text.Text, n: *vectors.Need) {
    text.byte(t, '%');
    text.decimal(t, n.index::i64);
    text.put(t, " = ");
    if (n.space == spirv_kind.IMPORTS) {
        text.put(t, "OpExtInstImport \"");
        text.put(t, import_name(n.code));
        text.put(t, "\"\n");
        ret;
    }
    if (n.code == INTEGER_TYPE) {
        text.put(t, "OpTypeInt 32 0\n");
        ret;
    }
    if (n.code > FLOAT_TYPE) {
        text.put(t, "OpTypeFloat ");
        text.decimal(t, (n.code - FLOAT_TYPE)::i64);
        text.byte(t, '\n');
        ret;
    }
    text.put(t, "OpUndef %");
    text.decimal(t, TYPE_ID::i64);
    text.put(t, "\n");
}

fun prelude(job: *agreement.Job, t: *text.Text) {
    var i: u32 = 0;
    for (i < job.needs.len) {
        define(t, ?job.needs.at[i]);
        i = i + 1;
    }
}

fun line_of(job: *agreement.Job, ins: *inst.Inst, line: str, t: *text.Text) {
    text.put(t, line);
    text.byte(t, '\n');
}

fun closing(job: *agreement.Job, t: *text.Text) {}

# the word at word `w` of `b`, little endian
fun word(b: operand.Bytes, w: u32) u32 {
    val at: u32 = w * 4;
    ret b.at[at]::u32 | (b.at[at + 1]::u32 << 8) | (b.at[at + 2]::u32 << 16) | (b.at[at + 3]::u32 << 24);
}

# the module's last `count` instructions, each its own bytes
fun split(sp: *agreement.Split, file: operand.Bytes, out: *vector.Vector[operand.Bytes]) err[str] {
    if (file.len % 4 != 0 || file.len < HEADER_WORDS * 4) { ret err[str].err{"spirv-as wrote no spir-v module"}; }
    if (word(file, 0) != MAGIC)                           { ret err[str].err{"spirv-as wrote no spir-v module of little endian words"}; }
    val words:  u32                = file.len / 4;
    var starts: vector.Vector[u32] = vector.init[u32](sp.a);
    fin { vector.dnit[u32](?starts); }
    var w: u32 = HEADER_WORDS;
    for (w < words) {
        val count: u32 = word(file, w) >> 16;
        if (count == 0 || w + count > words) { ret err[str].err{"spirv-as wrote an instruction its module does not hold whole"}; }
        val pushed: res[usize, A.Error] = vector.push[u32](?starts, w);
        if (sel pushed.err) { ret err[str].err{"out of memory"}; }
        w = w + count;
    }
    if (starts.len < sp.count::usize) { ret err[str].err{"spirv-as wrote fewer instructions than the module's vectors"}; }
    var i: usize = starts.len - sp.count::usize;
    for (i < starts.len) {
        val from: u32 = starts.data[i];
        var to:   u32 = words;
        if (i + 1 < starts.len) { to = starts.data[i + 1]; }
        val owned: opt[operand.Bytes] = object.own(sp.a, ?file.at[from * 4], ((to - from) * 4)::usize);
        if (sel owned.none) { ret err[str].err{"out of memory"}; }
        val pushed: res[usize, A.Error] = vector.push[operand.Bytes](out, owned.some);
        if (sel pushed.err) { ret err[str].err{"out of memory"}; }
        i = i + 1;
    }
    ret err[str].ok{};
}

val LAYOUT: agreement.Layout = agreement.Layout{open: prelude, vector: line_of, close: closing, split: split};

val ASSEMBLERS: [1]agreement.Assembler = [1]agreement.Assembler{
    agreement.Assembler{tool: ?SPIRV_AS, spell: spirv_as, layout: ?LAYOUT},
};

# the last `count` lines spirv-dis listed, one per instruction, the vectors' after the prelude's
fun listed(job: *agreement.Job, out: str, count: u32, texts: *vector.Vector[str]) err[str] {
    var starts: vector.Vector[usize] = vector.init[usize](texts.a);
    fin { vector.dnit[usize](?starts); }
    var at: usize = 0;
    for (out[at] != 0) {
        var end: usize = at;
        for (out[end] != 0 && out[end] != '\n') { end = end + 1; }
        if (end > at) {
            val pushed: res[usize, A.Error] = vector.push[usize](?starts, at);
            if (sel pushed.err) { ret err[str].err{"out of memory"}; }
        }
        at = end;
        if (out[at] == '\n') { at = at + 1; }
    }
    if (starts.len < count::usize) { ret err[str].err{"spirv-dis listed fewer lines than the module's vectors"}; }
    var i: usize = starts.len - count::usize;
    for (i < starts.len) {
        val from: usize = starts.data[i];
        var end:  usize = from;
        for (out[end] != 0 && out[end] != '\n') { end = end + 1; }
        var t: text.Text = text.make(texts.a);
        text.bytes(?t, ?out[from], end - from);
        val kept: opt[str] = text.copy(?t, texts.a);
        if (sel kept.none) { ret err[str].err{"out of memory"}; }
        val pushed: res[usize, A.Error] = vector.push[str](texts, kept.some);
        if (sel pushed.err) { ret err[str].err{"out of memory"}; }
        i = i + 1;
    }
    ret err[str].ok{};
}

# the vector a failed spirv-dis run names: its error is at an instruction of the module by its number from 1, the
# prelude's before the vectors'
fun named(job: *agreement.Job, err: str, count: u32) opt[u32] {
    val head: str   = "error: ";
    var i:    usize = 0;
    for (i < str_len(head)) {
        if (err[i] != head[i]) { ret opt[u32].none{}; }
        i = i + 1;
    }
    var n:      u32  = 0;
    var digits: bool = false;
    for (err[i] >= '0' && err[i] <= '9') {
        n      = n * 10 + (err[i] - '0')::u32;
        digits = true;
        i      = i + 1;
    }
    if (!digits || err[i] != ':' || n <= job.needs.len) { ret opt[u32].none{}; }
    val k: u32 = n - 1 - job.needs.len;
    if (k >= count) { ret opt[u32].none{}; }
    ret opt[u32].some{k};
}

# the instruction of `r` over `values` added to the stream `state`
fun observed(state: ptr, r: *row.Row, values: *operand.Value) err[str] {
    var ins:  inst.Inst          = inst.Inst{row: r, values: values, count: r.operands.len};
    val seen: err[field.Refusal] = spirv_stream.HOOKS.observe(state, ?ins);
    if (sel seen.err) { ret err[str].err{seen.err.message}; }
    ret err[str].ok{};
}

fun provide(state: ptr, n: *vectors.Need) err[str] {
    if (n.space == spirv_kind.IMPORTS) {
        val name: str = import_name(n.code);
        if (name == nil) { ret err[str].err{"a need of an import of a set masc has no rows of"}; }
        var import: [2]operand.Value = [2]operand.Value{operand.Value.id{n.index}, operand.Value.literal{operand.Bytes{at: name, len: str_len(name)::u32}}};
        ret observed(state, ?gen_row.ROWS[gen_row_index.OPEXTINSTIMPORT], ?import[0]);
    }
    if (n.space != spirv_kind.IDS) { ret err[str].err{"a need of an id space spir-v has not"}; }
    if (n.code == INTEGER_TYPE) {
        var int: [3]operand.Value = [3]operand.Value{operand.Value.id{n.index}, operand.Value.immediate{32}, operand.Value.immediate{0}};
        ret observed(state, ?gen_row.ROWS[gen_row_index.OPTYPEINT], ?int[0]);
    }
    if (n.code == INTEGER_VALUE) {
        var undef: [2]operand.Value = [2]operand.Value{operand.Value.id{TYPE_ID}, operand.Value.id{n.index}};
        ret observed(state, ?gen_row.ROWS[gen_row_index.OPUNDEF], ?undef[0]);
    }
    if (n.code > FLOAT_TYPE) {
        var float: [3]operand.Value = [3]operand.Value{operand.Value.id{n.index}, operand.Value.immediate{(n.code - FLOAT_TYPE)::i64}, operand.Value.none{}};
        ret observed(state, ?gen_row.ROWS[gen_row_index.OPTYPEFLOAT], ?float[0]);
    }
    ret err[str].err{"a need of an id the agreement defines nothing for"};
}

fun place(ins: *inst.Inst, slot: u32) {
    val v: u8 = ins.row.effect.values.defines;
    if (v == 0 || v::u32 > ins.count) { ret; }
    ins.values[v - 1] = operand.Value.id{FIRST_RESULT + slot};
}

val STREAM: agreement.Stream = agreement.Stream{provide: provide, place: place};

# the import code of the set operand `k` of `r` must import, 0 for an operand no set field encodes
fun set_of(r: *row.Row, k: u32) u32 {
    var j: u32 = 0;
    for (j < r.encoding.len) {
        val f: *field.Field = ?r.encoding.at[j];
        if (f.kind == spirv_kind.EXTSET && f.operand::u32 == k) { ret f.param::u32; }
        j = j + 1;
    }
    ret 0;
}

# whether a literal of `desc`, or of a member of it, takes its width from operand `k`
fun sizes(desc: *operand.Operand, k: u32) bool {
    val shape: *operand.Shape = ?desc.shape;
    if (sel shape.literal) { ret shape.literal.width_of::u32 == k + 1; }
    if (sel shape.group) {
        var i: u32 = 0;
        for (i < shape.group.len) {
            if (sizes(?shape.group.at[i], k)) { ret true; }
            i = i + 1;
        }
    }
    ret false;
}

# whether a literal of `r` takes its width from operand `k`
fun sized(r: *row.Row, k: u32) bool {
    var i: u32 = 0;
    for (i < r.operands.len) {
        if (sizes(?r.operands.at[i], k)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun push(g: *vectors.Generation, out: *vector.Vector[operand.Value], v: operand.Value) {
    val pushed: res[usize, A.Error] = vector.push[operand.Value](out, v);
    if (sel pushed.err) { g.failed = true; }
}

# a literal of `value` in `bytes` bytes, whole words little endian
fun literal_words(g: *vectors.Generation, value: u64, bytes: u32) opt[operand.Value] {
    val got: res[*u8, A.Error] = A.allocate[u8](g.a, bytes::usize);
    if (sel got.err) {
        g.failed = true;
        ret opt[operand.Value].none{};
    }
    var i: u32 = 0;
    for (i < bytes) {
        got.ok[i] = ((value >> (i * 8)::u64) & 0xFF)::u8;
        i         = i + 1;
    }
    ret opt[operand.Value].some{operand.Value.literal{operand.Bytes{at: got.ok, len: bytes}}};
}

# a word literal of `value`
fun literal_word(g: *vectors.Generation, out: *vector.Vector[operand.Value], value: u32) {
    val v: opt[operand.Value] = literal_words(g, value::u64, 4);
    if (sel v.some) { push(g, out, v.some); }
}

# the ieee 754 format of a float of `bits` bits, binary16, binary32 or binary64
fun format_of(bits: u32) ieee.Format {
    if (bits == 16) { ret ieee.F16; }
    if (bits == 32) { ret ieee.F32; }
    ret ieee.F64;
}

# edge `i` of a float of format `f`: zero, the least subnormal, the largest finite value, infinity and the quiet nan
fun float_edge(f: ieee.Format, i: u32) u64 {
    val inf: u128 = ieee.inf_bits(f);
    if (i == 1) { ret 1; }
    if (i == 2) { ret (inf - 1)::u64; }
    if (i == 3) { ret inf::u64; }
    if (i == 4) { ret (inf | (ieee.hidden(f) >> 1))::u64; }
    ret 0;
}

# the vectors of an enumerant of operand `k` that takes a float immediate, the enumerant at each of its edges with that
# param moved to each of its format's edges past the first, which its other params' first edges hold to
fun float_params(g: *vectors.Generation, k: u32) {
    val edges: *vector.Vector[operand.Value] = ?g.edges[k];
    var i:     usize                         = 0;
    for (i < edges.len && !g.failed) {
        val c: operand.Value = edges.data[i];
        if (sel c.enumerant) {
            val e: *operand.Shape = ?g.row.operands.at[k].shape;
            if (sel e.enumerant) {
                val n: u32 = c.enumerant.params.len;
                var j: u32 = 0;
                for (j < n) {
                    val p:     *operand.Shape = ?operand.param(?e.enumerant, c.enumerant.value, j).shape;
                    var float: u32            = 0;
                    if (sel p.immediate) {
                        if (p.immediate.format == operand.FLOAT) { float = p.immediate.bits::u32; }
                    }
                    if (float != 0) {
                        val f:  ieee.Format = format_of(float);
                        var ed: u32         = 1;
                        for (ed < FLOAT_EDGES) {
                            val at: res[*operand.Value, A.Error] = A.allocate[operand.Value](g.a, n::usize);
                            if (sel at.err) {
                                g.failed = true;
                                ret;
                            }
                            var m: u32 = 0;
                            for (m < n) {
                                at.ok[m] = c.enumerant.params.at[m];
                                m        = m + 1;
                            }
                            at.ok[j] = operand.Value.immediate{float_edge(f, ed):~i64};
                            vectors.offer(g, k, operand.Value.enumerant{operand.Chosen{value: c.enumerant.value, params: operand.Values{at: at.ok, len: n}}});
                            ed = ed + 1;
                        }
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
}

# the float vectors of a row past its operands' edges: each float param of an enumerant at each of its edges, and,
# where its result type sizes a literal, the type operand moved to each float type of the prelude and the literal to
# each of that format's edges together, offered whole since the literal's edges turn on the type
fun typed_floats(g: *vectors.Generation) {
    val r: *row.Row = g.row;
    var k: u32      = 0;
    for (k < r.operands.len) {
        float_params(g, k);
        k = k + 1;
    }
    val t: u32 = r.effect.values.type::u32;
    if (t == 0 || t > r.operands.len) { ret; }
    k = 0;
    for (k < r.operands.len) {
        val shape: *operand.Shape = ?r.operands.at[k].shape;
        var typed: bool           = false;
        if (sel shape.literal) { typed = shape.literal.content != operand.STRING && shape.literal.width_of::u32 == t; }
        if (typed) {
            var w: u32 = 0;
            for (w < 3 && !g.failed) {
                val bits: u32 = FLOAT_WIDTHS[w];
                if (vectors.need(g, vectors.Need{space: spirv_kind.IDS, index: bits, code: FLOAT_TYPE + bits})) {
                    var bytes: u32 = 4;
                    if (bits > 32) { bytes = 8; }
                    var e: u32 = 0;
                    for (e < FLOAT_EDGES) {
                        val v: opt[operand.Value] = literal_words(g, float_edge(format_of(bits), e), bytes);
                        if (sel v.some) {
                            var held: [row.MAX_OPERANDS]operand.Value = g.base;
                            held[t - 1] = operand.Value.id{bits};
                            held[k]     = v.some;
                            vectors.offer_together(g, ?held[0]);
                        }
                        e = e + 1;
                    }
                }
                w = w + 1;
            }
        }
        k = k + 1;
    }
}

# the strings that pad to a word at their edges, or every set an import names
val PADDED: [3]str = [3]str{"a", "abc", "abcd"};

fun strings(g: *vectors.Generation, out: *vector.Vector[operand.Value]) {
    if (g.row == ?gen_row.ROWS[gen_row_index.OPEXTINSTIMPORT]) {
        var i: u32 = 0;
        for (i < gen_operand.IMPORT_COUNT) {
            val name: str = gen_operand.IMPORTS[i].key;
            push(g, out, operand.Value.literal{operand.Bytes{at: name, len: str_len(name)::u32}});
            i = i + 1;
        }
        ret;
    }
    var i: u32 = 0;
    for (i < 3) {
        push(g, out, operand.Value.literal{operand.Bytes{at: PADDED[i], len: str_len(PADDED[i])::u32}});
        i = i + 1;
    }
}

# the edges of the ids and literals of a spir-v row, as the agreement's header says
fun edges(g: *vectors.Generation, k: u32, desc: *operand.Operand, out: *vector.Vector[operand.Value]) bool {
    val r:     *row.Row       = g.row;
    val own:   bool           = k < r.operands.len && desc == ?r.operands.at[k];
    val shape: *operand.Shape = ?desc.shape;
    if (sel shape.id) {
        if (own && k + 1 == r.effect.values.defines::u32) {
            push(g, out, operand.Value.id{FIRST_RESULT});
            ret true;
        }
        val set: u32 = set_of(r, k);
        if (own && set != 0) {
            if (vectors.need(g, vectors.Need{space: spirv_kind.IMPORTS, index: IMPORT_BASE + set, code: set})) { push(g, out, operand.Value.id{IMPORT_BASE + set}); }
            ret true;
        }
        if (own && sized(r, k)) {
            if (!vectors.need(g, vectors.Need{space: spirv_kind.IDS, index: TYPE_ID, code: INTEGER_TYPE})) { ret true; }
            if (k + 1 == r.effect.values.type::u32) {
                push(g, out, operand.Value.id{TYPE_ID});
                ret true;
            }
            if (vectors.need(g, vectors.Need{space: spirv_kind.IDS, index: VALUE_ID, code: INTEGER_VALUE})) { push(g, out, operand.Value.id{VALUE_ID}); }
            ret true;
        }
        push(g, out, operand.Value.id{1});
        push(g, out, operand.Value.id{LAST_ID});
        ret true;
    }
    if (sel shape.immediate) {
        if (shape.immediate.format != operand.FLOAT) { ret false; }
        val f: ieee.Format = format_of(shape.immediate.bits::u32);
        var e: u32         = 0;
        for (e < FLOAT_EDGES) {
            push(g, out, operand.Value.immediate{float_edge(f, e):~i64});
            e = e + 1;
        }
        ret true;
    }
    if (sel shape.literal) {
        if (shape.literal.content == operand.STRING) {
            strings(g, out);
            ret true;
        }
        if (shape.literal.width_of == 0) { ret false; }
        literal_word(g, out, 0);
        literal_word(g, out, 1);
        literal_word(g, out, 0x7FFF_FFFF);
        literal_word(g, out, 0xFFFF_FFFF);
        ret true;
    }
    ret false;
}

# the rows spirv-as reads short of the grammar, against SPIRV-Tools v2026.4 and SPIRV-Headers v1.202609.0
pub val EXCEPTIONS_COUNT: u32 = 9;

val UNLISTED: str = "spirv-dis aborts on an InitModeALTERA decoration's InitializationModeQualifier operand, `Internal error: Unhandled operand type: 81`, which spirv-as assembles";
val FPGA:     str = "GlobalVariableFPGADecorationsALTERA";

val JOINED: str = "spirv-as reads a memory access mask of more than one member only where the grammar makes the operand optional, and this row's is not";

pub val EXCEPTIONS: [EXCEPTIONS_COUNT]agreement.Exception = [EXCEPTIONS_COUNT]agreement.Exception{
    agreement.Exception{subject: agreement.Subject.row{"OpCooperativeMatrixLoadTensorNV"}, variant: "", checks: agreement.BYTES, unless: "", when: "", reason: JOINED},
    agreement.Exception{subject: agreement.Subject.row{"OpCooperativeMatrixStoreTensorNV"}, variant: "", checks: agreement.BYTES, unless: "", when: "", reason: JOINED},
    agreement.Exception{subject: agreement.Subject.row{"OpDecorate"}, variant: "", checks: agreement.DECODE, unless: "", when: FPGA, reason: UNLISTED},
    agreement.Exception{subject: agreement.Subject.row{"OpDecorateId"}, variant: "", checks: agreement.DECODE, unless: "", when: FPGA, reason: UNLISTED},
    agreement.Exception{subject: agreement.Subject.row{"OpDecorateString"}, variant: "", checks: agreement.DECODE, unless: "", when: FPGA, reason: UNLISTED},
    agreement.Exception{subject: agreement.Subject.row{"OpMemberDecorate"}, variant: "", checks: agreement.DECODE, unless: "", when: FPGA, reason: UNLISTED},
    agreement.Exception{subject: agreement.Subject.row{"OpMemberDecorateIdEXT"}, variant: "", checks: agreement.DECODE, unless: "", when: FPGA, reason: UNLISTED},
    agreement.Exception{subject: agreement.Subject.row{"OpMemberDecorateString"}, variant: "", checks: agreement.DECODE, unless: "", when: FPGA, reason: UNLISTED},
    agreement.Exception{subject: agreement.Subject.row{"OpTypeFloat"}, variant: "", checks: agreement.BYTES, unless: "", when: "", reason: "spirv-as refuses a width other than 16 for the BFloat16KHR encoding, a rule of the encoding's extension that the grammar does not state"},
};

# the spir-v agreement
pub val AGREEMENT: agreement.Agreement = agreement.Agreement{
    name:         "spirv",
    set:          ?spirv_set.SET,
    syntax:       0,
    format:       ?mink_format.SPIRV,
    variants:     agreement.Variants{at: ?VARIANTS[0], len: 1},
    assemblers:   agreement.Assemblers{at: ?ASSEMBLERS[0], len: 1},
    disassembler: agreement.Disassembler{tool: ?SPIRV_DIS, spell: spirv_dis, listed: listed, named: named},
    statements:   agreement.NO_STATEMENTS,
    exceptions:   agreement.Exceptions{at: ?EXCEPTIONS[0], len: EXCEPTIONS_COUNT},
    hook:         typed_floats,
    edges:        edges,
    stream:       ?STREAM,
};
