# the wasm tools every wasm oracle runs, at their pin, and the features they are asked for
#
# wabt 1.0.42's wat2wasm, wasm2wat and wasm-validate. a sweep of whole modules asks for wasm 3.0's features less gc
# and with threads, the set's catalog: threads and typed function references enabled, every other 3.0 feature on by
# wabt's default. gc is not, as the set has no rows of it, and neither is wabt's `--enable-all`, which turns on
# compact imports and gc and so changes the bytes wat2wasm writes. the agreement asks for a selection's features
# alone, each wabt feature the selection holds no row of turned off, so wabt refuses what masc refuses under it, but
# for the features wabt holds another to need (wabt 1.0.42, src/feature.cc, UpdateDependencies): wabt turns reference
# types off without bulk memory, and exceptions and typed function references off without reference types, where the
# specification holds every feature apart, so each feature a held one needs is turned on with it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use masc.core.extension;
use masc.core.requirement;

use masc.isa.wasm.gen_extension;

use masc.harness.agree.agreement;
use masc.tool.text;

val WAT2WASM_PROGRAMS: [1]str = [1]str{"wat2wasm"};
val WASM2WAT_PROGRAMS: [1]str = [1]str{"wasm2wat"};
val VALIDATE_PROGRAMS: [1]str = [1]str{"wasm-validate"};

pub val WAT2WASM: agreement.Tool = agreement.Tool{name: "wat2wasm", programs: agreement.Programs{at: ?WAT2WASM_PROGRAMS[0], len: 1}, pin: "1.0.42"};
pub val WASM2WAT: agreement.Tool = agreement.Tool{name: "wasm2wat", programs: agreement.Programs{at: ?WASM2WAT_PROGRAMS[0], len: 1}, pin: "1.0.42"};
pub val VALIDATE: agreement.Tool = agreement.Tool{name: "wasm-validate", programs: agreement.Programs{at: ?VALIDATE_PROGRAMS[0], len: 1}, pin: "1.0.42"};

# the features every wabt tool is asked for in a sweep of whole modules
pub fun features(args: *agreement.Args) {
    agreement.arg(args, "--enable-threads");
    agreement.arg(args, "--enable-function-references");
}

# a wabt feature (wabt 1.0.42, include/wabt/feature.def) and the catalog rows that hold it
# ---
# name:  its flag's name, as `multi-value` of `--disable-multi-value`
# on:    whether wabt enables it by default
# rows:  the rows any of which a selection holds it by
# needs: the index in FEATURES of the feature wabt turns it off without, NONE for none
rec Feature {
    name:  str;
    on:    bool;
    rows:  requirement.Ids;
    needs: u32;
}

val NONE: u32 = 0xFFFF_FFFF;

val BULK:      [2]requirement.Id = [2]requirement.Id{gen_extension.BULK_MEMORY, gen_extension.BULK_MEMORY_OPT};
val GLOBALS:   [1]requirement.Id = [1]requirement.Id{gen_extension.MUTABLE_GLOBALS};
val SIGN:      [1]requirement.Id = [1]requirement.Id{gen_extension.SIGN_EXT};
val SATURATE:  [1]requirement.Id = [1]requirement.Id{gen_extension.NONTRAPPING_FPTOINT};
val MULTI:     [1]requirement.Id = [1]requirement.Id{gen_extension.MULTIVALUE};
val REFS:      [2]requirement.Id = [2]requirement.Id{gen_extension.REFERENCE_TYPES, gen_extension.CALL_INDIRECT_OVERLONG};
val SIMD:      [1]requirement.Id = [1]requirement.Id{gen_extension.SIMD128};
val TAIL:      [1]requirement.Id = [1]requirement.Id{gen_extension.TAIL_CALL};
val EXTENDED:  [1]requirement.Id = [1]requirement.Id{gen_extension.EXTENDED_CONST};
val MEMORIES:  [1]requirement.Id = [1]requirement.Id{gen_extension.MULTIMEMORY};
val WIDE:      [1]requirement.Id = [1]requirement.Id{gen_extension.MEMORY64};
val EXCEPTION: [1]requirement.Id = [1]requirement.Id{gen_extension.EXCEPTION_HANDLING};
val RELAXED:   [1]requirement.Id = [1]requirement.Id{gen_extension.RELAXED_SIMD};
val TYPED:     [1]requirement.Id = [1]requirement.Id{gen_extension.FUNCTION_REFERENCES};
val COLLECTED: [1]requirement.Id = [1]requirement.Id{gen_extension.GC};
val ATOMIC:    [1]requirement.Id = [1]requirement.Id{gen_extension.ATOMICS};

val FEATURE_COUNT: u32 = 16;

val FEATURES: [FEATURE_COUNT]Feature = [FEATURE_COUNT]Feature{
    Feature{name: "exceptions", on: true, rows: requirement.Ids{at: ?EXCEPTION[0], len: 1}, needs: 10},
    Feature{name: "mutable-globals", on: true, rows: requirement.Ids{at: ?GLOBALS[0], len: 1}, needs: NONE},
    Feature{name: "saturating-float-to-int", on: true, rows: requirement.Ids{at: ?SATURATE[0], len: 1}, needs: NONE},
    Feature{name: "sign-extension", on: true, rows: requirement.Ids{at: ?SIGN[0], len: 1}, needs: NONE},
    Feature{name: "simd", on: true, rows: requirement.Ids{at: ?SIMD[0], len: 1}, needs: NONE},
    Feature{name: "threads", on: false, rows: requirement.Ids{at: ?ATOMIC[0], len: 1}, needs: NONE},
    Feature{name: "function-references", on: false, rows: requirement.Ids{at: ?TYPED[0], len: 1}, needs: 10},
    Feature{name: "multi-value", on: true, rows: requirement.Ids{at: ?MULTI[0], len: 1}, needs: NONE},
    Feature{name: "tail-call", on: true, rows: requirement.Ids{at: ?TAIL[0], len: 1}, needs: NONE},
    Feature{name: "bulk-memory", on: true, rows: requirement.Ids{at: ?BULK[0], len: 2}, needs: NONE},
    Feature{name: "reference-types", on: true, rows: requirement.Ids{at: ?REFS[0], len: 2}, needs: 9},
    Feature{name: "gc", on: false, rows: requirement.Ids{at: ?COLLECTED[0], len: 1}, needs: 6},
    Feature{name: "memory64", on: true, rows: requirement.Ids{at: ?WIDE[0], len: 1}, needs: NONE},
    Feature{name: "multi-memory", on: true, rows: requirement.Ids{at: ?MEMORIES[0], len: 1}, needs: NONE},
    Feature{name: "extended-const", on: true, rows: requirement.Ids{at: ?EXTENDED[0], len: 1}, needs: NONE},
    Feature{name: "relaxed-simd", on: true, rows: requirement.Ids{at: ?RELAXED[0], len: 1}, needs: NONE},
};

fun held(s: *extension.Selection, rows: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < rows.len) {
        if (extension.has(s, rows.at[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the features of selection `s` every wabt tool is asked for: each wabt feature `s` holds a row of on, every other off
pub fun selected(args: *agreement.Args, s: *extension.Selection) {
    var in: [FEATURE_COUNT]bool;
    var i:  u32 = 0;
    for (i < FEATURE_COUNT) {
        in[i] = held(s, FEATURES[i].rows);
        i     = i + 1;
    }
    # a need's need is turned on by the pass after its own, and no chain is longer than the features
    var pass: u32 = 0;
    for (pass < FEATURE_COUNT) {
        i = 0;
        for (i < FEATURE_COUNT) {
            if (in[i] && FEATURES[i].needs != NONE) { in[FEATURES[i].needs] = true; }
            i = i + 1;
        }
        pass = pass + 1;
    }
    i = 0;
    for (i < FEATURE_COUNT) {
        val f: *Feature = ?FEATURES[i];
        if (in[i] != f.on) {
            var t: text.Text = text.make(args.a);
            if (in[i]) { text.put(?t, "--enable-"); }
            or         { text.put(?t, "--disable-"); }
            text.put(?t, f.name);
            agreement.arg_text(args, ?t);
        }
        i = i + 1;
    }
}
