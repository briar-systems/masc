# the x86 agreement: 16-, 32- and 64-bit code against llvm-mc and the gnu assembler, decoded against llvm-objdump
#
# each width's selections hold its width, the state value `.code16`, `.code32`
# and `.code64` switch. llvm-mc is told it by the triple: x86_64 and i386 for
# an object's own width, and i386's code16 environment for 16-bit code, which
# llvm-mc 23.1.1 reads as `.code16`. the gnu assembler is told `--64` or
# `--32`, and 16-bit code by a `.code16` its source opens with. llvm-objdump
# 23.1.1 decodes an i386 elf object as 32-bit code whatever triple it is told,
# so 16-bit code's decode check is excepted. the vectors are written in intel
# syntax (`-x86-asm-syntax=intel`, `-msyntax=intel -mnaked-reg`, objdump's
# `-M intel`), whose relative targets llvm-mc reads only as a symbol's
# expression, so the framework labels each vector (`agreement.LABEL`), and
# objdump lists immediates in decimal, as masc's syntax writes them, so a
# hexadecimal number it lists is a target. objdump applies x86's aliases
# whatever it is told, as `cmpltps` of cmpps with predicate 1, so the decode
# check compares masc's printing by the alias it prefers. llvm's tools are told
# the selection as llvm attributes, `-mattr` and objdump's `--mattr`, each
# extension the feature or features llvm 23.1.1 names it by (X86.td), and none
# for an extension llvm names no feature for, as osfxsr, 3dnow or padlock, whose
# instructions it assembles whatever it is told. the gnu assembler assembles
# every extension it knows unless told an -march, and writes elf alone, so the
# statements in coff are llvm-mc's. the tools are pinned at llvm 23.1.1 and
# binutils 2.47, which the exception table was written against.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use arch_x86:    mink.catalog.arch.x86;
use mink_format: mink.catalog.format;

use masc.core.requirement;

use x86_extension: masc.isa.x86.extension;
use x86_set:       masc.isa.x86.set;

use masc.core.extension;
use masc.harness.agree.agreement;
use masc.harness.agree.vectors;
use masc.tool.text;

val W16: [1]requirement.Id = [1]requirement.Id{x86_extension.id.WIDTH_16};
val W32: [1]requirement.Id = [1]requirement.Id{x86_extension.id.WIDTH_32};
val W64: [1]requirement.Id = [1]requirement.Id{x86_extension.id.WIDTH_64};

val VARIANTS: [3]agreement.Variant = [3]agreement.Variant{
    agreement.Variant{name: "w16", arch: ?arch_x86.X86, base: requirement.Ids{at: ?W16[0], len: 1}, abi: ?arch_x86.X86_SYSV32},
    agreement.Variant{name: "w32", arch: ?arch_x86.X86, base: requirement.Ids{at: ?W32[0], len: 1}, abi: ?arch_x86.X86_SYSV32},
    agreement.Variant{name: "w64", arch: ?arch_x86.X86_64, base: requirement.Ids{at: ?W64[0], len: 1}, abi: ?arch_x86.X86_64_SYSV64},
};

val LLVM_MC_PROGRAMS:      [1]str = [1]str{"llvm-mc"};
val LLVM_OBJDUMP_PROGRAMS: [1]str = [1]str{"llvm-objdump"};
val GNU_AS_PROGRAMS:       [2]str = [2]str{"x86_64-linux-gnu-as", "as"};

val LLVM_MC:      agreement.Tool = agreement.Tool{name: "llvm-mc", programs: agreement.Programs{at: ?LLVM_MC_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};
val LLVM_OBJDUMP: agreement.Tool = agreement.Tool{name: "llvm-objdump", programs: agreement.Programs{at: ?LLVM_OBJDUMP_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};
val GNU_AS:       agreement.Tool = agreement.Tool{name: "gnu-as", programs: agreement.Programs{at: ?GNU_AS_PROGRAMS[0], len: 2}, pin: "GNU assembler (GNU Binutils) 2.47"};

# whether the job's code is 16-bit
fun code16(job: *agreement.Job) bool {
    ret extension.has(job.selection, x86_extension.id.WIDTH_16);
}

# an extension of masc's catalog and the llvm 23.1.1 features that name it, comma separated
rec Feature {
    extension: str;
    llvm:      str;
}

val FEATURE_COUNT: u32 = 105;

