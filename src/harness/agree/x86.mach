    agreement.Exception{subject: agreement.Subject.row{"push_ss_16_o32_w32"}, variant: "", checks: agreement.BYTES, unless: "", when: "", reason: SEGMENT_STACK},
    agreement.Exception{subject: agreement.Subject.row{"ret_near_c3_o16_w16"}, variant: "", checks: agreement.BYTES, unless: "", when: "", reason: CODE16_NEAR},
    agreement.Exception{subject: agreement.Subject.row{"ret_near_c3_o32_w16"}, variant: "", checks: agreement.BYTES, unless: "", when: "", reason: CODE16_NEAR},
    agreement.Exception{subject: agreement.Subject.row{"ret_near_imm16_c2_o16_w16"}, variant: "", checks: agreement.BYTES, unless: "", when: "", reason: CODE16_NEAR},
    agreement.Exception{subject: agreement.Subject.row{"ret_near_imm16_c2_o32_w16"}, variant: "", checks: agreement.BYTES, unless: "", when: "", reason: CODE16_NEAR},
};

pub val STATEMENTS_COUNT: u32 = 9;

# addresses naming a symbol, which no row's vector holds: rip-relative from the instruction's end, as llvm-mc 23.1.1
# writes R_X86_64_PC32 ext-4, past an addend and past an immediate, and absolute alone or beside a base. a register
# the width lacks is refused by masc and llvm-mc alike
pub val STATEMENTS: [STATEMENTS_COUNT]agreement.Statement = [STATEMENTS_COUNT]agreement.Statement{
    agreement.Statement{text: "mov eax, dword ptr [rip + ext]", of: "symbolic address"},
    agreement.Statement{text: "mov eax, dword ptr [rip + ext + 8]", of: "symbolic address"},
    agreement.Statement{text: "mov eax, dword ptr [rip + ext - 4]", of: "symbolic address"},
    agreement.Statement{text: "lea rax, [rip + ext]", of: "symbolic address"},
    agreement.Statement{text: "mov dword ptr [rip + ext], 1", of: "symbolic address"},
    agreement.Statement{text: "cmp byte ptr [rip + ext], 0", of: "symbolic address"},
    agreement.Statement{text: "mov ecx, dword ptr [ext]", of: "symbolic address"},
    agreement.Statement{text: "mov ecx, dword ptr [rbx + ext]", of: "symbolic address"},
    agreement.Statement{text: "mov ecx, dword ptr [ebx + ext + 8]", of: "symbolic address"},
};

# the x86 agreement
pub val AGREEMENT: agreement.Agreement = agreement.Agreement{
    name:         "x86",
    set:          ?x86_set.SET,
    syntax:       0,
    format:       ?mink_format.ELF,
    variants:     agreement.Variants{at: ?VARIANTS[0], len: 3},
    assemblers:   agreement.Assemblers{at: ?ASSEMBLERS[0], len: 1},
    disassembler: agreement.Disassembler{tool: ?LLVM_OBJDUMP, spell: llvm_objdump, comment: "#", aliased: true},
    statements:   agreement.Statements{at: ?STATEMENTS[0], len: STATEMENTS_COUNT, requires: requirement.NO_IDS},
    exceptions:   agreement.Exceptions{at: ?EXCEPTIONS[0], len: EXCEPTIONS_COUNT},
    hook:         hook,
    targets:      agreement.LABEL,
};
