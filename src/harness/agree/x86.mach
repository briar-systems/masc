# the llvm features of extension `name`, nil for none
fun features_of(name: str) str {
    var i: u32 = 0;
    for (i < FEATURE_COUNT) {
        if (str_equals(FEATURES[i].extension, name)) { ret FEATURES[i].llvm; }
        i = i + 1;
    }
    ret nil;
}

# `head` and the selection as llvm attributes, `+` before each feature, comma separated, nothing for a selection of
# no extension llvm names
fun attribute_arg(job: *agreement.Job, args: *agreement.Args, head: str) {
    val catalog: *extension.Catalog = job.selection.catalog;
    var t:       text.Text          = text.make(args.a);
    var first:   bool               = true;
    text.put(?t, head);
    var i: u32 = 0;
    for (i < catalog.count) {
        val named: str = features_of(catalog.extensions[i].name);
        if (extension.has(job.selection, i) && named != nil) {
            var k:     usize = 0;
            var start: bool  = true;
            val n:     usize = str_len(named);
            for (k < n) {
                if (start) {
                    if (!first) { text.byte(?t, ','); }
                    text.byte(?t, '+');
                    first = false;
                    start = false;
                }
                if (named[k] == ',') { start = true; }
                or                   { text.byte(?t, named[k]); }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    if (!first) { agreement.arg_text(args, ?t); }
}

fun llvm_mc(job: *agreement.Job, args: *agreement.Args) {
    val wide: bool = extension.has(job.selection, x86_extension.id.WIDTH_64);
    if (job.format == ?mink_format.COFF && wide) { agreement.arg(args, "-triple=x86_64-pc-windows-msvc"); }
    or (job.format == ?mink_format.COFF)         { agreement.arg(args, "-triple=i686-pc-windows-msvc"); }
    or (wide)                                    { agreement.arg(args, "-triple=x86_64"); }
    or (code16(job))                             { agreement.arg(args, "-triple=i386-unknown-unknown-code16"); }
    or                                           { agreement.arg(args, "-triple=i386"); }
    attribute_arg(job, args, "-mattr=");
    agreement.arg(args, "-x86-asm-syntax=intel");
    agreement.arg(args, "-filetype=obj");
    agreement.arg(args, "-o");
    agreement.arg(args, job.object);
    agreement.arg(args, job.source);
}

fun llvm_objdump(job: *agreement.Job, args: *agreement.Args) {
    agreement.arg(args, "-d");
    agreement.arg(args, "-M");
    agreement.arg(args, "intel");
    agreement.arg(args, "--no-print-imm-hex");
    agreement.arg(args, "--no-show-raw-insn");
    if (code16(job)) { agreement.arg(args, "--triple=i386-unknown-unknown-code16"); }
    attribute_arg(job, args, "--mattr=");
    agreement.arg(args, job.object);
}

# the gnu assembler of an x86_64 elf host, told 64- or 32-bit code by its option and 16-bit code by `.code16`, which no
# option states. it assembles every extension but mpx unless told an -march, so the selection is masc's to refuse, and
# mpx is added to its default where the selection holds it (binutils 2.47 gas/config/tc-i386.c, `-march=+mpx`)
fun gnu_as(job: *agreement.Job, args: *agreement.Args) {
    if (extension.has(job.selection, x86_extension.id.WIDTH_64)) { agreement.arg(args, "--64"); }
    or                                                           { agreement.arg(args, "--32"); }
    if (extension.has(job.selection, x86_extension.id.MPX))      { agreement.arg(args, "-march=+mpx"); }
    agreement.arg(args, "-msyntax=intel");
    agreement.arg(args, "-mnaked-reg");
    agreement.arg(args, "-o");
    agreement.arg(args, job.object);
    agreement.arg(args, job.source);
}

# the gnu assembler's source opens in 16-bit code for a job of it
fun gnu_prelude(job: *agreement.Job, t: *text.Text) {
    if (code16(job)) { text.put(t, ".code16\n"); }
}

val ASSEMBLERS: [2]agreement.Assembler = [2]agreement.Assembler{
    agreement.Assembler{tool: ?LLVM_MC, spell: llvm_mc, layout: nil, prelude: nil, only: nil},
    agreement.Assembler{tool: ?GNU_AS, spell: gnu_as, layout: nil, prelude: gnu_prelude, only: ?mink_format.ELF},
};

# the x86 operands' kinds state every value they take
fun hook(g: *vectors.Generation) {}

# the rows the tools disagree on by their own limits, against llvm 23.1.1, binutils 2.47, XED and the intel sdm
# volume 2, each of the one tool it names or of every tool. llvm's intel parser sizes an unsized segment push or pop, a
# near ret or call in 16-bit code and a 16-bit code push of an immediate at its own size, where masc writes the default
# operand size the manual names. the gnu assembler drops a redundant ds, refuses a negative immediate of an unsigned
# field and orders and chooses prefixes and forms its own way, and llvm-objdump reads no 16-bit code
pub val EXCEPTIONS_COUNT: u32 = 208;

val SEGMENT_STACK:       str = "llvm-mc's intel parser assembles push and pop of a segment register as the 16-bit form, writing 66 outside 16-bit code, where masc writes the default operand size (sdm vol 2b PUSH, POP)";
val SEGMENT_LOAD:        str = "llvm-mc writes 66 before mov to a segment register from a 16-bit register, which the manual names redundant (sdm vol 2b MOV)";
val SEGMENT_STORE:       str = "llvm-mc writes mov from a segment register to a register without the 66 that names its width, as the manual allows (sdm vol 2b MOV), so its bytes write the other width's register";
val MOVZX_WORD:          str = "llvm-mc refuses movzx with a 16-bit destination and source, which the manual encodes as 0f b7 at operand size 16 (sdm vol 2b MOVZX)";
val CODE16_NEAR:         str = "llvm-mc assembles an unsized near ret or call in 16-bit code as its 32-bit form, writing 66 and a 32-bit displacement, where masc writes the default operand size";
val CODE16_REL32:        str = "llvm-mc in 16-bit code reaches a 32-bit jcc target only by a 16-bit displacement, refusing one past it";
val CODE16_PUSH:         str = "llvm-mc in 16-bit code assembles push of an immediate past 16 bits as push imm16, truncating the immediate without a diagnostic, and the row's immediates that sign-extend from 8 bits assemble as push imm8, whose printing is the default operand size's";
val SIGN_EXTENDED:       str = "intel syntax spells push of a sign-extended 8-bit immediate the same at 16- and 32-bit operand size, as llvm-objdump prints it, so the 32-bit form in 16-bit code prints as the default one";
val OBJDUMP_CODE16:      str = "llvm-objdump 23.1.1 decodes an i386 elf object as 32-bit code whatever triple it is told, so it reads no 16-bit code";
val NO_ACE:              str = "neither llvm 23.1.1 nor binutils 2.47 implements ace, whose rows XED's ace-1 datafiles alone state";
val NO_AVX10_AUX:        str = "neither llvm 23.1.1 nor binutils 2.47 implements the avx10 auxiliary conversions XED states, as vcvtbiasps2bf8 and vpmovssdb";
val LLVM_NO_MPX:         str = "llvm 23.1.1 implements no mpx, whose instructions it refuses as unknown mnemonics";
val LLVM_NO_MCOMMIT:     str = "llvm-mc 23.1.1 reads no mcommit, which binutils 2.47 assembles as f3 0f 01 fa";
val LLVM_NO_AVX512PF:    str = "llvm 23.1.1 implements no avx512pf, so its intel parser reads none of the prefetches' operands";
val XED_NAME:            str = "the mnemonic is XED's name for an encoding the Intel SDM reserves, which neither assembler reads";
val LLVM_NO_INT1:        str = "llvm-mc 23.1.1 reads no int1, the SDM's name for f1, which binutils 2.47 assembles";
val LLVM_NO_UD0:         str = "llvm-mc 23.1.1 reads no ud0 with operands, the SDM's 0f ff /r, which binutils 2.47 assembles";
val LLVM_NO_UDB:         str = "llvm-mc 23.1.1 reads no udb, XED's name for d6, which binutils 2.47 assembles";
val NO_VCMPBF16_ALIAS:   str = "neither assembler reads the predicate mnemonics of vcmpbf16 that llvm-objdump 23.1.1 prints, as vcmpeqbf16";
val GNU_DS:              str = "binutils 2.47 drops a ds override where ds is the address's default segment, which masc and llvm-mc write as the text states";
val GNU_NEGATIVE:        str = "binutils 2.47 refuses a negative immediate of a field it reads as unsigned, as int -1, which masc and llvm-mc write as its two's complement";
val CODE16_FAR_RET:      str = "llvm-mc 23.1.1 assembles an unsized far ret in 16-bit code as its 32-bit form, writing 66, where masc and binutils 2.47 write the default operand size";
val LLVM_APX_SETCC_DISP: str = "llvm-mc 23.1.1 writes the displacement of an apx setcc's memory in 32 bits where 8 hold it, which masc and binutils 2.47 write in 8";
val LLVM_MOVSX_WORD:     str = "llvm-mc 23.1.1 refuses movsx with a 16-bit destination and source, which the SDM encodes as 0f bf at operand size 16 and binutils 2.47 assembles";
val MOVSXD_WORD:         str = "neither assembler reads movsxd with a 16-bit destination, which the SDM encodes as 63 at operand size 16";
val LLVM_MOVSXD_DWORD:   str = "llvm-mc 23.1.1 refuses movsxd with a 32-bit destination, which the SDM encodes as 63 without rex.w and binutils 2.47 assembles";
val LLVM_ADDR32_CODE16:  str = "llvm-mc 23.1.1 refuses addr32 in 16-bit code, or writes the 16-bit address form after its 67, which binutils 2.47 assembles as the SDM encodes it";
val LLVM_MOFFS_A32:      str = "llvm-mc 23.1.1 assembles addr32 mov of a moffs in 64-bit code as the modrm form, where masc and binutils 2.47 write a0 to a3";
val LLVM_MOFFS_A16:      str = "llvm-mc 23.1.1 writes a 32-bit moffs after the 67 of addr16 mov in 32-bit code, where masc and binutils 2.47 write 16 bits";
val LLVM_URDMSR:         str = "llvm 23.1.1 swaps urdmsr's and uwrmsr's register operands between modrm.reg and modrm.rm, as XED and binutils 2.47 do not";
val X87_ST0_TWICE:       str = "the x87 arithmetic of dc c0+i at i 0 spells as d8 c0+i at i 0 does, which both assemblers read as d8";
val BSWAP_WORD:          str = "neither assembler reads bswap of a 16-bit register, whose result the SDM leaves undefined and XED encodes";
val SAE_UNROUNDED:       str = "neither assembler reads {sae} on a conversion that never rounds or raises, which XED encodes under evex.b";
val PREFETCHI_64:        str = "neither assembler reads prefetchit0 or prefetchit1 outside 64-bit code, where XED encodes them as the reserved nops of 0f 18";
val GNU_ZMMWORD:         str = "binutils 2.47 refuses the zmmword ptr of the 64-byte operand of enqcmd, enqcmds and movdir64b, which llvm-mc reads";
val CODE16_REL32_BOTH:   str = "both assemblers in 16-bit code reach a 32-bit target only within 16 bits, refusing or truncating one past it";
val FAR_UNSPELLED:       str = "neither assembler's intel syntax spells a far jump or call through a 32- or 80-bit pointer, reading the unsized form as the 48-bit one";
val OBJDUMP_FAR:         str = "llvm-objdump 23.1.1 prints a far jump or call through memory as the near mnemonic with no size, as `call [1]`";
val PADLOCK_A64:         str = "XED states the padlock instructions at 16- and 32-bit addressing alone, so masc writes 67 in 64-bit code where both assemblers write none";
val XED_FIXED32:         str = "XED names the registers of ud0, ud1, encodekey128 and encodekey256 32-bit at every operand size, which an assembler of 16-bit code writes 66 for";
val OBJDUMP_SELECTOR:    str = "llvm-objdump 23.1.1 prints the selector register of lar and lsl as 16-bit, where the SDM and binutils 2.47's objdump name it at the operand size";
val OBJDUMP_REX2:        str = "llvm-objdump 23.1.1 misreads these rex2 encodings, as xchg eax, r16d printed as nop and movq xmm8, r24 as movq mm0, r24";
val OBJDUMP_EVEX_W:      str = "llvm-objdump 23.1.1 reads evex.w as 0 for these instructions outside 64-bit code, printing vmovdqa64 as vmovdqa32, where binutils 2.47's objdump reads it";
val GNU_SWAPPED:         str = "binutils 2.47 writes xchg of two byte registers with its operands the other way between modrm.reg and modrm.rm";
val GNU_PREFIX_ORDER:    str = "binutils 2.47 writes 67 before a repeat prefix, where masc and llvm-mc write it after";
val GNU_PUSH16:          str = "binutils 2.47 assembles push of a sign-extended 8-bit immediate in 16-bit code at the default operand size";
val GNU_DWORD_FAR:       str = "binutils 2.47 reads a dword ptr jump or call through memory in 16-bit code as far";
val GNU_FLAGS_WORD:      str = "binutils 2.47 reads pushf, popf and iret at the default operand size, where the SDM and masc name the 16-bit form";
val GNU_OTHER_FORM:      str = "binutils 2.47 writes these with the other encoding of the same operands, as cfcmov's register form without nf and movbe's 60 for 61";
val GNU_REX_W:           str = "binutils 2.47 drops rex.w where a 64-bit destination of a selector or segment register loses nothing without it";
val GNU_APX_ONE:         str = "binutils 2.47 reads an apx shift or rotate by one only with its 1 written, as rol r16b, 1, which masc and llvm-objdump leave out";
val LLVM_APX_ONE:        str = "llvm-mc 23.1.1 refuses an 8-bit apx shift or rotate by one into a new destination unless its 1 is written";
val GNU_DISTINCT:        str = "binutils 2.47 refuses a complex fp16 multiply whose destination is a source, as the SDM raises #UD, where llvm-mc only warns";
val GNU_DISTINCT_TILE:   str = "binutils 2.47 refuses an amx-fp8 tile dot product naming one tile twice, which llvm-mc and XED do not";
val GNU_ABSOLUTE_MASK:   str = "binutils 2.47 refuses an opmask after an absolute address with no segment, as [1] {k1}";
val GNU_NO_EVEX:         str = "binutils 2.47 has no evex form of vmpsadbw";
val GNU_BOUND:           str = "binutils 2.47 reads bound only with a memory operand of twice the register's size";
val GNU_NO_IBHF:         str = "binutils 2.47 reads no ibhf";
val GNU_AMBIGUOUS:       str = "binutils 2.47 refuses an unsized sysret or sysexit as ambiguous";
val GNU_IMULZU:          str = "binutils 2.47 reads no imulzu";
val LLVM_NF_IMULZU:      str = "llvm-mc 23.1.1 reads no {nf} imulzu";
val IMM32_UNSIGNED:      str = "both assemblers read the 32-bit control of tbm's bextr as signed, refusing one past 2147483647, which XED states unsigned";
val LLVM_MSR_IMM:        str = "llvm-mc 23.1.1 reads the 32-bit msr index of the immediate forms as signed, refusing one past 2147483647";
val GNU_IMM32:           str = "binutils 2.47 reads the 32-bit immediate of lwpins and lwpval as signed, refusing one past 2147483647";
val LLVM_EVEX_ADDR16:    str = "llvm-mc 23.1.1 writes an evex instruction's 16-bit address displacement as disp8 unscaled by the tuple, so its bytes address another place";
val OBJDUMP_PTWRITE:     str = "llvm-objdump 23.1.1 decodes no ptwrite outside 64-bit code";
val GNU_MPX_ADDR32:      str = "binutils 2.47 refuses 32-bit addressing in an mpx instruction in 64-bit code";
val GNU_SHADOW_TOKEN:    str = "masc prints the shadow-stack token of clrssbsy and rstorssp as dword ptr as llvm-objdump 23.1.1 does, which binutils 2.47 refuses for the 64-bit token";
val GNU_FAR_POINTER:     str = "binutils 2.47 refuses an unsized 80-bit far pointer load";
val GNU_PUSHAL:          str = "binutils 2.47 reads no pushal or popal in intel syntax, which llvm-mc reads";
val SVM_ADDR_ALIAS:      str = "neither assembler reads an address-size word beside the address register of vmrun, vmload, vmsave or invlpga that already states it";
val LLVM_SVM_OPERANDS:   str = "llvm-mc 23.1.1 reads these instructions' implicit registers only in the widths it fixes them at, refusing the spelling that names them otherwise";
val GNU_PVALIDATE16:     str = "binutils 2.47 reads pvalidate's eax in 16-bit code as a 32-bit address, writing 67";
val GNU_ABS32_A32:       str = "binutils 2.47 writes R_X86_64_32 for the displacement of a 32-bit address in 64-bit code, where masc and llvm-mc 23.1.1 write R_X86_64_32S";
val GNU_XBEGIN_BRANCH:   str = "binutils 2.47 writes xbegin's fallback address to a symbol as a branch relocation, where masc and llvm-mc 23.1.1 write R_X86_64_PC32, xbegin being no branch";
val OBJDUMP_MOFFS_ASIZE: str = "llvm-objdump 23.1.1 prints a moffs mov under 67 with no address-size word, so its text reassembles at the default address size";
val OBJDUMP_VPCMP_EQ:    str = "llvm-objdump 23.1.1 prints vpcmpb, vpcmpw, vpcmpd and vpcmpq of predicate 0 as vpcmpeq, which names the instruction of evex 74 to 76 and 0f 38 29";

