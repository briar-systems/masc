# the llvm features of extension `name`, nil for none
fun features_of(name: str) str {
    var i: u32 = 0;
    for (i < FEATURE_COUNT) {
        if (str_equals(FEATURES[i].extension, name)) { ret FEATURES[i].llvm; }
        i = i + 1;
    }
    ret nil;
}

# `head` and the selection as llvm attributes, `+` before each feature, comma separated, nothing for a selection of
# no extension llvm names
fun attribute_arg(job: *agreement.Job, args: *agreement.Args, head: str) {
    val catalog: *extension.Catalog = job.selection.catalog;
    var t:       text.Text          = text.make(args.a);
    var first:   bool               = true;
    text.put(?t, head);
    var i: u32 = 0;
    for (i < catalog.count) {
        val named: str = features_of(catalog.extensions[i].name);
        if (extension.has(job.selection, i) && named != nil) {
            var k:     usize = 0;
            var start: bool  = true;
            val n:     usize = str_len(named);
            for (k < n) {
                if (start) {
                    if (!first) { text.byte(?t, ','); }
                    text.byte(?t, '+');
                    first = false;
                    start = false;
                }
                if (named[k] == ',') { start = true; }
                or                   { text.byte(?t, named[k]); }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    if (!first) { agreement.arg_text(args, ?t); }
}

fun llvm_mc(job: *agreement.Job, args: *agreement.Args) {
    if (extension.has(job.selection, x86_extension.id.WIDTH_64)) { agreement.arg(args, "-triple=x86_64"); }
    or (code16(job))                                             { agreement.arg(args, "-triple=i386-unknown-unknown-code16"); }
    or                                                           { agreement.arg(args, "-triple=i386"); }
    attribute_arg(job, args, "-mattr=");
    agreement.arg(args, "-x86-asm-syntax=intel");
    agreement.arg(args, "-filetype=obj");
    agreement.arg(args, "-o");
    agreement.arg(args, job.object);
    agreement.arg(args, job.source);
}

fun llvm_objdump(job: *agreement.Job, args: *agreement.Args) {
    agreement.arg(args, "-d");
    agreement.arg(args, "-M");
    agreement.arg(args, "intel");
    agreement.arg(args, "--no-print-imm-hex");
    agreement.arg(args, "--no-show-raw-insn");
    if (code16(job)) { agreement.arg(args, "--triple=i386-unknown-unknown-code16"); }
    attribute_arg(job, args, "--mattr=");
    agreement.arg(args, job.object);
}

val ASSEMBLERS: [1]agreement.Assembler = [1]agreement.Assembler{agreement.Assembler{tool: ?LLVM_MC, spell: llvm_mc}};

# the x86 operands' kinds state every value they take
fun hook(g: *vectors.Generation) {}

# the rows the tools disagree on by their own limits, against llvm 23.1.1 and the intel sdm volume 2.
# llvm's intel parser sizes an unsized segment push or pop, a near ret or call in 16-bit code and
# a 16-bit code push of an immediate at its own size, where masc writes the default operand size the manual names
pub val EXCEPTIONS_COUNT: u32 = 61;

val SEGMENT_STACK: str = "llvm-mc's intel parser assembles push and pop of a segment register as the 16-bit form, writing 66 outside 16-bit code, where masc writes the default operand size (sdm vol 2b PUSH, POP)";
val SEGMENT_LOAD:  str = "llvm-mc writes 66 before mov to a segment register from a 16-bit register, which the manual names redundant (sdm vol 2b MOV)";
val SEGMENT_STORE: str = "llvm-mc writes mov from a segment register to a register without the 66 that names its width, as the manual allows (sdm vol 2b MOV), so its bytes write the other width's register";
val MOVZX_WORD:    str = "llvm-mc refuses movzx with a 16-bit destination and source, which the manual encodes as 0f b7 at operand size 16 (sdm vol 2b MOVZX)";
val CODE16_NEAR:   str = "llvm-mc assembles an unsized near ret or call in 16-bit code as its 32-bit form, writing 66 and a 32-bit displacement, where masc writes the default operand size";
val CODE16_REL32:  str = "llvm-mc in 16-bit code reaches a 32-bit jcc target only by a 16-bit displacement, refusing one past it";
val CODE16_PUSH:   str = "llvm-mc in 16-bit code assembles push of an immediate past 16 bits as push imm16, truncating the immediate without a diagnostic, and the row's immediates that sign-extend from 8 bits assemble as push imm8, whose printing is the default operand size's";
val SIGN_EXTENDED: str = "intel syntax spells push of a sign-extended 8-bit immediate the same at 16- and 32-bit operand size, as llvm-objdump prints it, so the 32-bit form in 16-bit code prints as the default one";

