# the x86 agreement: 16-, 32- and 64-bit code against llvm-mc, decoded against llvm-objdump
#
# each width's selections hold its width, the state value `.code16`, `.code32`
# and `.code64` switch, and the tools are told it by the triple: x86_64 and
# i386 for an object's own width, and i386's code16 environment for 16-bit
# code, which llvm-mc 23.1.1 and llvm-objdump 23.1.1 read as `.code16`. the
# vectors are written in intel syntax (`-x86-asm-syntax=intel`, objdump's
# `-M intel`), whose relative targets llvm-mc reads only as a symbol's expression,
# so the framework labels each vector (`agreement.LABEL`), and objdump lists
# immediates in decimal, as masc's syntax writes them, so a hexadecimal number
# it lists is a target. objdump applies x86's aliases whatever it is told, as
# `cmpltps` of cmpps with predicate 1, so the decode check compares masc's
# printing by the alias it prefers. both are told the selection as llvm
# attributes, `-mattr` and objdump's `--mattr`, each extension the feature or
# features llvm 23.1.1 names it by (X86.td), and none for an extension llvm
# names no feature for, as osfxsr, 3dnow or padlock, whose instructions it
# assembles whatever it is told. the tools are pinned at llvm 23.1.1, which
# the exception table was written against.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use arch_x86:    mink.catalog.arch.x86;
use mink_format: mink.catalog.format;

use masc.core.requirement;

use x86_extension: masc.isa.x86.extension;
use x86_set:       masc.isa.x86.set;

use masc.core.extension;
use masc.harness.agree.agreement;
use masc.harness.agree.vectors;
use masc.tool.text;

val W16: [1]requirement.Id = [1]requirement.Id{x86_extension.id.WIDTH_16};
val W32: [1]requirement.Id = [1]requirement.Id{x86_extension.id.WIDTH_32};
val W64: [1]requirement.Id = [1]requirement.Id{x86_extension.id.WIDTH_64};

val VARIANTS: [3]agreement.Variant = [3]agreement.Variant{
    agreement.Variant{name: "w16", arch: ?arch_x86.X86, base: requirement.Ids{at: ?W16[0], len: 1}, abi: nil, excludes: requirement.NO_IDS},
    agreement.Variant{name: "w32", arch: ?arch_x86.X86, base: requirement.Ids{at: ?W32[0], len: 1}, abi: nil, excludes: requirement.NO_IDS},
    agreement.Variant{name: "w64", arch: ?arch_x86.X86_64, base: requirement.Ids{at: ?W64[0], len: 1}, abi: nil, excludes: requirement.NO_IDS},
};

val LLVM_MC_PROGRAMS:      [1]str = [1]str{"llvm-mc"};
val LLVM_OBJDUMP_PROGRAMS: [1]str = [1]str{"llvm-objdump"};

val LLVM_MC:      agreement.Tool = agreement.Tool{name: "llvm-mc", programs: agreement.Programs{at: ?LLVM_MC_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};
val LLVM_OBJDUMP: agreement.Tool = agreement.Tool{name: "llvm-objdump", programs: agreement.Programs{at: ?LLVM_OBJDUMP_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};

# whether the job's code is 16-bit
fun code16(job: *agreement.Job) bool {
    ret extension.has(job.selection, x86_extension.id.WIDTH_16);
}

# an extension of masc's catalog and the llvm 23.1.1 features that name it, comma separated
rec Feature {
    extension: str;
    llvm:      str;
}

val FEATURE_COUNT: u32 = 105;

