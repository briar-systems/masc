pub val STATEMENTS_COUNT: u32 = 21;

# what no row's vector holds, assembled as source lines: addresses naming a symbol, rip-relative from the
# instruction's end, as llvm-mc 23.1.1 writes R_X86_64_PC32 ext-4, past an addend and past an immediate, and absolute
# alone or beside a base, a register the width lacks refused by masc and llvm-mc alike. a call's, jcc's and jmp's
# 32-bit target to a symbol, which llvm-mc writes as R_X86_64_PLT32 in elf for x86_64, R_386_PC32 for i386 and REL32
# in coff, its jcc and jmp relaxed to the longer form a symbol's target needs, xbegin's fallback address, which llvm-mc
# writes as R_X86_64_PC32 for x86_64, being no branch, and absolute and pc-relative data. a jump or call through
# memory written with no size is near at the code width, and fword ptr names its far form, as llvm-mc reads them. each
# is checked in elf at every width and in coff at 32 and 64 bits. then a datum in a comdat group whose signature no
# label exposes, which llvm-mc and the gnu assembler 2.47 sign with a local symbol of their own defined in the group,
# checked in elf alone (#391)
pub val STATEMENTS: [STATEMENTS_COUNT]agreement.Statement = [STATEMENTS_COUNT]agreement.Statement{
    agreement.Statement{text: "mov eax, dword ptr [rip + ext]", of: "symbolic address"},
    agreement.Statement{text: "mov eax, dword ptr [rip + ext + 8]", of: "symbolic address"},
    agreement.Statement{text: "mov eax, dword ptr [rip + ext - 4]", of: "symbolic address"},
    agreement.Statement{text: "lea rax, [rip + ext]", of: "symbolic address"},
    agreement.Statement{text: "mov dword ptr [rip + ext], 1", of: "symbolic address"},
    agreement.Statement{text: "cmp byte ptr [rip + ext], 0", of: "symbolic address"},
    agreement.Statement{text: "mov ecx, dword ptr [ext]", of: "symbolic address"},
    agreement.Statement{text: "mov ecx, dword ptr [rbx + ext]", of: "symbolic address"},
    agreement.Statement{text: "mov ecx, dword ptr [ebx + ext + 8]", of: "symbolic address"},
    agreement.Statement{text: "call ext", of: "symbolic target"},
    agreement.Statement{text: "je ext", of: "symbolic target"},
    agreement.Statement{text: "jmp ext", of: "symbolic target"},
    agreement.Statement{text: "xbegin ext", of: "symbolic target"},
    agreement.Statement{text: "jmp [ebx]", of: "memory target"},
    agreement.Statement{text: "call [ebx]", of: "memory target"},
    agreement.Statement{text: "jmp fword ptr [ebx]", of: "memory target"},
    agreement.Statement{text: "call fword ptr [ebx]", of: "memory target"},
    agreement.Statement{text: ".long ext", of: "symbolic datum"},
    agreement.Statement{text: ".long ext - .", of: "symbolic datum"},
    agreement.Statement{text: ".quad ext + 8", of: "symbolic datum"},
    agreement.Statement{text: ".byte 1", of: "comdat group", group: "sig"},
};

# the extensions the statements need beside each width, rtm for xbegin
val STATEMENT_REQUIRES: [1]requirement.Id = [1]requirement.Id{x86_extension.id.RTM};

# the statements written into coff at 32 and 64 bits, as llvm-mc 23.1.1 writes i686-pc-windows-msvc and
# x86_64-pc-windows-msvc objects
val FURTHER: [1]agreement.Further = [1]agreement.Further{agreement.Further{format: ?mink_format.COFF, variants: agreement.Variants{at: ?VARIANTS[1], len: 2}}};

# the x86 agreement
pub val AGREEMENT: agreement.Agreement = agreement.Agreement{
    name:         "x86",
    set:          ?x86_set.SET,
    syntax:       0,
    format:       ?mink_format.ELF,
    variants:     agreement.Variants{at: ?VARIANTS[0], len: 3},
    assemblers:   agreement.Assemblers{at: ?ASSEMBLERS[0], len: 2},
    disassembler: agreement.Disassembler{tool: ?LLVM_OBJDUMP, spell: llvm_objdump, comment: "#", aliased: true, unmarked: true},
    statements:   agreement.Statements{at: ?STATEMENTS[0], len: STATEMENTS_COUNT, requires: requirement.Ids{at: ?STATEMENT_REQUIRES[0], len: 1}},
    further:      agreement.Furthers{at: ?FURTHER[0], len: 1},
    exceptions:   agreement.Exceptions{at: ?EXCEPTIONS[0], len: EXCEPTIONS_COUNT},
    hook:         hook,
    targets:      agreement.LABEL,
};
