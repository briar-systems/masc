# the x86 agreement: 16-, 32- and 64-bit code against llvm-mc, decoded against llvm-objdump
#
# each width's selections hold its width, the state value `.code16`, `.code32`
# and `.code64` switch, and the tools are told it by the triple: x86_64 and
# i386 for an object's own width, and i386's code16 environment for 16-bit
# code, which llvm-mc 23.1.1 and llvm-objdump 23.1.1 read as `.code16`. the
# vectors are written in intel syntax (`-x86-asm-syntax=intel`, objdump's
# `-M intel`), whose relative targets llvm-mc reads only as a symbol's expression,
# so the framework labels each vector (`agreement.LABEL`), and objdump lists
# immediates in decimal, as masc's syntax writes them, so a hexadecimal number
# it lists is a target. objdump applies x86's aliases whatever it is told, as
# `cmpltps` of cmpps with predicate 1, so the decode check compares masc's
# printing by the alias it prefers. the slice's rows need no extension beyond
# their width, so no attribute is passed: J3's catalog (#30) spells a
# selection as llvm attributes and adds the gnu assembler. the tools are
# pinned at llvm 23.1.1, which the exception table was written against.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.string.str;

use arch_x86:    mink.catalog.arch.x86;
use mink_format: mink.catalog.format;

use masc.core.requirement;

use x86_extension: masc.isa.x86.extension;
use x86_set:       masc.isa.x86.set;

use masc.core.extension;
use masc.harness.agree.agreement;
use masc.harness.agree.vectors;

val W16: [1]requirement.Id = [1]requirement.Id{x86_extension.id.WIDTH_16};
val W32: [1]requirement.Id = [1]requirement.Id{x86_extension.id.WIDTH_32};
val W64: [1]requirement.Id = [1]requirement.Id{x86_extension.id.WIDTH_64};

val VARIANTS: [3]agreement.Variant = [3]agreement.Variant{
    agreement.Variant{name: "w16", arch: ?arch_x86.X86, base: requirement.Ids{at: ?W16[0], len: 1}, abi: nil},
    agreement.Variant{name: "w32", arch: ?arch_x86.X86, base: requirement.Ids{at: ?W32[0], len: 1}, abi: nil},
    agreement.Variant{name: "w64", arch: ?arch_x86.X86_64, base: requirement.Ids{at: ?W64[0], len: 1}, abi: nil},
};

val LLVM_MC_PROGRAMS:      [1]str = [1]str{"llvm-mc"};
val LLVM_OBJDUMP_PROGRAMS: [1]str = [1]str{"llvm-objdump"};

val LLVM_MC:      agreement.Tool = agreement.Tool{name: "llvm-mc", programs: agreement.Programs{at: ?LLVM_MC_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};
val LLVM_OBJDUMP: agreement.Tool = agreement.Tool{name: "llvm-objdump", programs: agreement.Programs{at: ?LLVM_OBJDUMP_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};

# whether the job's code is 16-bit
fun code16(job: *agreement.Job) bool {
    ret extension.has(job.selection, x86_extension.id.WIDTH_16);
}

fun llvm_mc(job: *agreement.Job, args: *agreement.Args) {
    val wide: bool = extension.has(job.selection, x86_extension.id.WIDTH_64);
    if (job.format == ?mink_format.COFF && wide) { agreement.arg(args, "-triple=x86_64-pc-windows-msvc"); }
    or (job.format == ?mink_format.COFF)         { agreement.arg(args, "-triple=i686-pc-windows-msvc"); }
    or (wide)                                    { agreement.arg(args, "-triple=x86_64"); }
    or (code16(job))                             { agreement.arg(args, "-triple=i386-unknown-unknown-code16"); }
    or                                           { agreement.arg(args, "-triple=i386"); }
    agreement.arg(args, "-x86-asm-syntax=intel");
    agreement.arg(args, "-filetype=obj");
    agreement.arg(args, "-o");
    agreement.arg(args, job.object);
    agreement.arg(args, job.source);
}

fun llvm_objdump(job: *agreement.Job, args: *agreement.Args) {
    agreement.arg(args, "-d");
    agreement.arg(args, "-M");
    agreement.arg(args, "intel");
    agreement.arg(args, "--no-print-imm-hex");
    agreement.arg(args, "--no-show-raw-insn");
    if (code16(job)) { agreement.arg(args, "--triple=i386-unknown-unknown-code16"); }
    agreement.arg(args, job.object);
}

val ASSEMBLERS: [1]agreement.Assembler = [1]agreement.Assembler{agreement.Assembler{tool: ?LLVM_MC, spell: llvm_mc}};

# the x86 operands' kinds state every value they take
fun hook(g: *vectors.Generation) {}

# the rows the tools disagree on by their own limits, against llvm 23.1.1 and the intel sdm volume 2.
# llvm's intel parser sizes an unsized segment push or pop, a near ret or call in 16-bit code and
# a 16-bit code push of an immediate at its own size, where masc writes the default operand size the manual names
pub val EXCEPTIONS_COUNT: u32 = 66;

val SEGMENT_STACK: str = "llvm-mc's intel parser assembles push and pop of a segment register as the 16-bit form, writing 66 outside 16-bit code, where masc writes the default operand size (sdm vol 2b PUSH, POP)";
val SEGMENT_LOAD:  str = "llvm-mc writes 66 before mov to a segment register from a 16-bit register, which the manual names redundant (sdm vol 2b MOV)";
val SEGMENT_STORE: str = "llvm-mc writes mov from a segment register to a register without the 66 that names its width, as the manual allows (sdm vol 2b MOV), so its bytes write the other width's register";
val MOVZX_WORD:    str = "llvm-mc refuses movzx with a 16-bit destination and source, which the manual encodes as 0f b7 at operand size 16 (sdm vol 2b MOVZX)";
val CODE16_NEAR:   str = "llvm-mc assembles an unsized near ret or call in 16-bit code as its 32-bit form, writing 66 and a 32-bit displacement, where masc writes the default operand size";
val CODE16_REL32:  str = "llvm-mc in 16-bit code reaches a 32-bit jcc target only by a 16-bit displacement, refusing one past it";
val CODE16_PUSH:   str = "llvm-mc in 16-bit code assembles push of an immediate past 16 bits as push imm16, truncating the immediate without a diagnostic, and the row's immediates that sign-extend from 8 bits assemble as push imm8, whose printing is the default operand size's";
val SIGN_EXTENDED: str = "intel syntax spells push of a sign-extended 8-bit immediate the same at 16- and 32-bit operand size, as llvm-objdump prints it, so the 32-bit form in 16-bit code prints as the default one";

