# the agreement run: every row of a set at every variant, assembled by masc and by each tool, decoded by both
#
# each row is checked under a selection of its own: the variant's base and
# the first alternative of the row's requirement that closes with it, or with
# `full`, that selection widened by every extension of the catalog, in order,
# that keeps it closed. rows whose selections spell the same are one group,
# and a group's vectors are one source file every external assembler reads,
# each vector in its own section.
#
# beside each row's own form, every alias of the row the syntax reads is
# vectored over the alias's own operands and written by the alias, a verdict
# of its own, and each source line the agreement states is a vector of a
# verdict of its own, assembled under its variant's base and what the
# statements require, and held to the bytes check alone.
#
# a vector agrees when it passes the checks it is held to, `agreement.Checks`,
# or when masc refuses it and so does every assembler that runs, as a register
# the e base lacks, which the set's hook offers through `vectors.refusal`:
#   - bytes: masc assembles its printing, by its row's own form, and every
#     assembler run gives the same bytes and the same relocations, and for a
#     statement in a comdat group the same group, as
#     `masc.harness.agree.object` compares them
#   - decode: masc's printing of the reference assembler's bytes is the
#     disassembler's printing of them, their whitespace normalised
#     (`masc.harness.agree.listing`): by each row's own form where the
#     disassembler applies no alias, and by the alias masc prefers where it
#     applies them (`agreement.Disassembler.aliased`)
#   - trip: masc's printing of its own bytes, by the alias it prefers,
#     assembles back to those bytes
#
# a tool that refuses a vector refuses it at its line, and the file is
# assembled again without it, so one refusal never hides another vector's
# bytes. a row agrees when every vector does, and is excepted when each check
# its vectors fail, of each tool that fails it, is one its exceptions in the
# set's table excuse, an exception of a tool or a text excusing that tool's
# disagreement alone or the vectors its text names alone. a decode
# disagreement is a fact of the row masc reads the bytes as, so the exception
# of that row excuses it too, as a hint row's does for the base row whose
# vectors land in the hint's encodings, and such a row is excepted. an
# exception scoped to extensions applies only under a selection that lacks
# one of them, so it neither excuses nor goes stale where the selection holds
# them all. an exception of the row that excuses no check it fails is stale, and a
# row the generator finds no vector of is unvectored: both fail the run, as a
# disagreement does. a row with a marker operand is marked and not vectored,
# since a marker is a symbol and the vectors hold none, so the builder's
# tests and a local object comparison carry its agreement.
#
# a set whose external assemblers read a relative target only as a symbol's
# expression (`agreement.LABEL`) has each vector's section open with a label,
# and the tools read its target as that label plus the offset from the
# vector's start masc's own assembly reaches: masc's offset, and for a target
# anchored at the instruction's end, the length of masc's bytes. the listing
# reads a target back to its offset from the instruction's start, so masc's
# printing that the decode check compares states each target from there too.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.allocator.arena;
use std.allocator.page;
use std.collections.map;
use std.collections.vector;
use fs: std.filesystem;

use mink.base.fail;
use mink_arch:   mink.catalog.arch;
use mink_format: mink.catalog.format;
use mink.format.registry;
use mink_object: mink.model.object;

use masc.asm.asm;
use masc.asm.model;
use masc.codec.walk;
use masc.core.diagnostic;
use masc.core.dispatch;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.form;
use masc.core.inst;
use masc.core.mode;
use masc.core.operand;
use masc.core.register;
use masc.core.relax;
use masc.core.requirement;
use masc.core.row;
use masc.core.set;
use masc.core.state;
use masc.core.stream;
use core_syntax: masc.core.syntax;
use masc.format.dialect;
use masc.syntax.parse;
use masc.syntax.print;

use masc.harness.agree.agreement;
use masc.harness.agree.listing;
use masc.harness.agree.object;
use masc.harness.agree.tool;
use masc.harness.agree.vectors;
use masc.tool.text;

# what one assembler made of a vector
# ---
# bytes:  its section's bytes
# relocs: its section's relocations, as `object.relocations` spells them
# group:  its section's comdat group, as `object.grouping` spells it
pub rec Assembled {
    bytes:  operand.Bytes;
    relocs: str;
    group:  str;
}

# what a vector's bytes came to with one assembler
# ---
# none:    it was not run, as an assembler not installed at its pin
# bytes:   the bytes and their relocations
# refused: why it gave none
pub tag Outcome: u8 {
    none;
    bytes:   Assembled;
    refused: str;
}

# what a printing of bytes came to
# ---
# none:    there was nothing to print
# text:    the printing
# refused: why there is none
pub tag Printed: u8 {
    none;
    text:    str;
    refused: str;
}

# one vector and everything every tool made of it
# ---
# inst:    the instruction, of no row for a statement
# held:    the checks it is held to
# alias:   the alias it is written by, nil for its row's own form
# spelled: its values as the alias writes them, nil for its row's own form
# text:    masc's printing of it by its row's form or its alias, or the statement, what masc assembles, nil when masc
#          cannot print it
# tool:    what every external assembler reads: the text, or under labelled targets the text with each target the
#          label of the vector's section plus its offset, nil when there is none
# masc:    the bytes masc assembles the text to
# tools:   the bytes each external assembler assembles the text to, in the agreement's order
# decoded: masc's printing of the reference assembler's bytes, each instruction by its row's own form
# read:    the row masc reads the reference bytes as, nil unless they are one instruction
# listed:  the disassembler's printing of them, its targets read back to offsets
# agrees:  whether the two printings are the same, their whitespace normalised
# printed: masc's printing of its own bytes, by the alias it prefers
# trip:    the bytes masc assembles that printing to
# lent:    the exception of `read` that excuses this vector's decode disagreement, nil for none
# dropped: whether the disassembler refused it by its place in a file of many, so the reference assembler's file was
#          written again without it
# group:   the signature of the comdat group its section is in, nil for none, as a statement states it
pub rec Case {
    inst:    inst.Inst;
    held:    agreement.Checks;
    alias:   *core_syntax.Alias;
    spelled: *operand.Value;
    text:    str;
    tool:    str;
    masc:    Outcome;
    tools:   *Outcome;
    decoded: Printed;
    read:    *row.Row;
    listed:  Printed;
    agrees:  bool;
    printed: Printed;
    trip:    Outcome;
    lent:    *agreement.Exception;
    dropped: bool;
    group:   str;
}

# the rows of one variant whose selections spell the same, and their vectors
# ---
# number:     its place among its variant's groups, which names its files
# selection:  the selection
# available:  the register file viewed through the context
# context:    the selection's context for its variant's architecture
# spelled:    the selection in the catalog's syntax
# cases:      every vector of its rows, each row's together
# references: the reference assembler's objects of the vectors it assembled, one per batch that assembled
# needs:      what its vectors need the context's stream to hold, each provided to it once, none for a set of no stream
pub rec Group {
    number:     u32;
    selection:  extension.Selection;
    available:  register.Available;
    context:    state.Context;
    spelled:    str;
    cases:      vector.Vector[Case];
    references: vector.Vector[str];
    needs:      vector.Vector[vectors.Need];
}

# what a row came to at one variant
pub def State: u8;

pub val AGREE:       State = 0;
pub val DISAGREE:    State = 1;
pub val EXCEPTED:    State = 2;
pub val STALE:       State = 3;
pub val ABSENT:      State = 4;
pub val UNVECTORED:  State = 5;
pub val DECODE_ONLY: State = 6;
pub val MARKED:      State = 7;

# how many states there are
pub val STATE_COUNT: u32 = 8;

# each state as the report names it
pub val STATE_NAMES: [8]str = [8]str{"agree", "disagree", "excepted", "stale", "absent", "unvectored", "decode-only", "marked"};

# whether a row in `s` fails the run
pub fun failing(s: State) bool {
    ret s == DISAGREE || s == STALE || s == UNVECTORED;
}

# what a verdict is of
# ---
# own:       a row's own form
# alias:     an alias of the row
# statement: a statement of the agreement, of no row
pub tag Spelled: u8 {
    own;
    alias:     *core_syntax.Alias;
    statement: *agreement.Statement;
}

# one row, one alias of it or one statement at one variant
# ---
# row:        the row, nil for a statement
# of:         what of the row, or which statement
# group:      the group its vectors are in, nil when it has none at this variant
# first:      its first vector in the group
# count:      how many vectors it has
# state:      what it came to
# exceptions: the exceptions that name it at this variant, of each tool and text the one taken
pub rec Verdict {
    row:        *row.Row;
    of:         Spelled;
    group:      *Group;
    first:      u32;
    count:      u32;
    state:      State;
    exceptions: vector.Vector[*agreement.Exception];
}

# one variant's run in one object format
# ---
# variant:  the variant
# format:   the object format, the agreement's own or a further one
# name:     its name in the report and the tools' files: the variant's, and the format's after it for a further one
# dialect:  the assembly dialect of the format for its architecture
# written:  the file masc's object of a vector with relocations is written to and read back from
# groups:   its groups
# verdicts: one per row, then one per alias of it the selection admits, in row order, then one per statement, of the
#           statements alone in a further format
pub rec Width {
    variant:  *agreement.Variant;
    format:   *mink_format.Format;
    name:     str;
    dialect:  *dialect.Dialect;
    written:  str;
    groups:   vector.Vector[*Group];
    verdicts: vector.Vector[Verdict];
}

# what a run is asked
# ---
# work: the directory the tools' files are written in
# full: whether each selection is widened by every extension that keeps it closed
pub rec Options {
    work: str;
    full: bool;
}

# a run's result
# ---
# agreement:    the agreement run
# options:      what it was asked
# assemblers:   each external assembler as found, in the agreement's order
# disassembler: the disassembler as found
# widths:       each variant's run
# notes:        the tools' warnings, each once
# failures:     how many rows at how many variants fail the run
pub rec Result {
    agreement:    *agreement.Agreement;
    options:      Options;
    assemblers:   vector.Vector[tool.Found];
    disassembler: tool.Found;
    widths:       vector.Vector[Width];
    notes:        vector.Vector[str];
    failures:     u32;
}

# the state a run carries
# ---
# a:          the allocator of everything the result holds
# scratch:    the allocator of one step's work, reset after it
# area:       the arena behind scratch
# agreement:  the agreement
# result:     the result
# exceptions: the exception table by row key, each an index into it
# scopes:     each exception's extensions whose absence it excuses, by its index, none for every selection
# withs:      each exception's extensions it applies with, by its index, none for every selection
# needs:      each exception's extension a row it names needs, by its index, none but for an extension's
# used:       whether each exception, by its index, excused a row, so one of a pattern or an extension that excused
#             none is stale
# seen:       the notes so far, so each is kept once
# modes:      the assembler modes the rows are read under
# formats:    the format registry masc's and the tools' objects are read and written through
pub rec Run {
    a:          *A.Allocator;
    scratch:    *A.Allocator;
    area:       *arena.Arena;
    agreement:  *agreement.Agreement;
    result:     *Result;
    exceptions: map.Map[str, u32];
    scopes:     vector.Vector[requirement.Ids];
    withs:      vector.Vector[requirement.Ids];
    needs:      vector.Vector[requirement.Ids];
    used:       vector.Vector[bool];
    seen:       map.Map[str, u32];
    modes:      mode.State;
    formats:    *registry.Registry;
    widened:    vector.Vector[Widened];
}

# a selection `widen` grew, kept so a later row of the same selection and exclusions takes it without growing it again,
# since growing closes the selection once per extension of the catalog
# ---
# from:     the selection before
# excluded: what it was kept from holding
# to:       the selection after
rec Widened {
    from:     extension.Selection;
    excluded: requirement.Ids;
    to:       extension.Selection;
}

val MEMORY:   str = "out of memory";
val UNSERVED: str = "the set serves no architecture of the variant";

# the section masc assembles a statement in a comdat group in, named as the tools' source names its vector's section
val VECTOR_ZERO: str = ".text.0";

fun no_symbol(context: ptr, name: View) res[core_syntax.Resolved, str] {
    ret res[core_syntax.Resolved, str].err{"a vector names no symbol"};
}

fun no_name(context: ptr, id: u32) View {
    ret View{data: "", len: 0};
}

# the symbols of a vector read under a typed stream, which names none
val NO_SYMBOLS: core_syntax.Symbols = core_syntax.Symbols{context: nil, resolve: no_symbol, name: no_name};

# `s` copied into `a`, none when it refuses
fun copied(a: *A.Allocator, s: str) opt[str] {
    var t: text.Text = text.make(a);
    text.put(?t, s);
    ret text.copy(?t, a);
}

# the bytes of `v` copied into `a` as a terminated string, none when it refuses
fun owned(a: *A.Allocator, v: *vector.Vector[u8]) opt[str] {
    var t: text.Text = text.make(a);
    text.bytes(?t, v.data, v.len);
    ret text.copy(?t, a);
}

# whether `x` and `y` hold the same bytes
pub fun same(x: operand.Bytes, y: operand.Bytes) bool {
    if (x.len != y.len) { ret false; }
    var i: u32 = 0;
    for (i < x.len) {
        if (x.at[i] != y.at[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a refused outcome of `message` copied into the run, which is kept as the message itself when the copy is refused
fun refused(r: *Run, message: str) Outcome {
    val kept: opt[str] = copied(r.a, message);
    if (sel kept.some) { ret Outcome.refused{kept.some}; }
    ret Outcome.refused{MEMORY};
}

# `note` kept once in the result, after the name of the tool that wrote it
fun note(r: *Run, from: str, note: str) err[str] {
    var t: text.Text = text.make(r.a);
    text.put(?t, from);
    text.put(?t, ": ");
    text.put(?t, note);
    val kept: opt[str] = text.copy(?t, r.a);
    if (sel kept.none)                               { ret err[str].err{MEMORY}; }
    if (map.contains[str, u32](?r.seen, ?kept.some)) { ret err[str].ok{}; }
    val inserted: res[bool, A.Error] = map.insert[str, u32](?r.seen, kept.some, 0);
    if (sel inserted.err) { ret err[str].err{MEMORY}; }
    val pushed: res[usize, A.Error] = vector.push[str](?r.result.notes, kept.some);
    if (sel pushed.err) { ret err[str].err{MEMORY}; }
    ret err[str].ok{};
}

# the checks vector `c` fails, the one reading of a vector's agreement the verdict and the report make
pub fun failed(result: *Result, c: *Case) agreement.Checks {
    if (!sel c.masc.bytes) {
        if (sel c.masc.refused && refused_by_all(result, c)) { ret 0; }
        ret agreement.BYTES & c.held;
    }
    var out:  agreement.Checks = 0;
    val mine: Assembled        = c.masc.bytes;
    var j:    usize            = 0;
    for (j < result.assemblers.len) {
        val o: *Outcome = ?c.tools[j];
        if (sel o.refused)                        { out = out | agreement.BYTES; }
        if (sel o.bytes && !alike(o.bytes, mine)) { out = out | agreement.BYTES; }
        j = j + 1;
    }
    if (sel c.decoded.refused)                                   { out = out | agreement.DECODE; }
    if (sel c.decoded.text && (!sel c.listed.text || !c.agrees)) { out = out | agreement.DECODE; }
    if (sel c.trip.bytes) {
        if (!same(c.trip.bytes.bytes, mine.bytes)) { out = out | agreement.TRIP; }
    }
    or { out = out | agreement.TRIP; }
    ret out & c.held;
}

# whether two assemblers gave the same bytes, the same relocations and the same group
fun alike(x: Assembled, y: Assembled) bool {
    ret same(x.bytes, y.bytes) && str_equals(x.relocs, y.relocs) && str_equals(x.group, y.group);
}

# whether every assembler that ran refused vector `c`, the reference among them, so a vector masc refuses agrees
fun refused_by_all(result: *Result, c: *Case) bool {
    if (result.assemblers.len == 0 || !sel c.tools[0].refused) { ret false; }
    var j: usize = 0;
    for (j < result.assemblers.len) {
        if (sel c.tools[j].bytes) { ret false; }
        j = j + 1;
    }
    ret true;
}

# the checks vector `c` fails that no other row's exception excuses
pub fun owed(result: *Result, c: *Case) agreement.Checks {
    val out: agreement.Checks = failed(result, c);
    if (c.lent == nil) { ret out; }
    ret out & ~(c.lent.checks & agreement.DECODE);
}

# whether vector `c` fails any check
pub fun fails(result: *Result, c: *Case) bool {
    ret failed(result, c) != 0;
}

# whether `s` holds an extension of `ids`
fun holds_any(s: *extension.Selection, ids: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (extension.has(s, ids.at[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the set's convention for `variant`'s abi row admits `s`, as ilp32e admits no selection holding d, which the
# builder refuses and the external assemblers refuse too
fun conventional(r: *Run, variant: *agreement.Variant, s: *extension.Selection) bool {
    if (variant.abi == nil) { ret true; }
    val states: *state.Axes                     = ?r.agreement.set.states;
    val at:     res[state.Context, state.Error] = state.make(s, states, state.initial(states));
    if (sel at.err) { ret false; }
    var ctx:     state.Context        = at.ok;
    val refused: opt[*set.Convention] = set.unconventional(r.agreement.set, variant.abi, ?ctx);
    ret sel refused.none;
}

# the selection of `variant`'s base and what `alternative` needs, none when they conflict, state two values of one
# axis, or hold what the alternative excludes or the variant's abi row does not admit
fun attempt(r: *Run, variant: *agreement.Variant, alternative: requirement.Alternative) res[opt[extension.Selection], str] {
    val base:    requirement.Ids                         = variant.base;
    val catalog: *extension.Catalog                      = r.agreement.set.extensions;
    val made:    res[extension.Request, extension.Error] = extension.request(r.a, catalog, "", diagnostic.START);
    if (sel made.err) { ret res[opt[extension.Selection], str].err{MEMORY}; }
    var q: extension.Request = made.ok;
    var i: u32               = 0;
    for (i < base.len) {
        extension.request_add(?q, base.at[i]);
        i = i + 1;
    }
    i = 0;
    for (i < alternative.all.len) {
        extension.request_add(?q, alternative.all.at[i]);
        i = i + 1;
    }
    val closed: res[extension.Selection, extension.Error] = extension.close(q);
    if (sel closed.ok) {
        var s:  extension.Selection             = closed.ok;
        val at: res[state.Context, state.Error] = state.make(?s, ?r.agreement.set.states, state.initial(?r.agreement.set.states));
        var ok: bool                            = sel at.ok;
        if (holds_any(?s, alternative.none) || !conventional(r, variant, ?s)) { ok = false; }
        if (ok)                                                               { ret res[opt[extension.Selection], str].ok{opt[extension.Selection].some{s}}; }
        extension.release(?s);
        ret res[opt[extension.Selection], str].ok{opt[extension.Selection].none{}};
    }
    if (sel closed.err.conflict) { ret res[opt[extension.Selection], str].ok{opt[extension.Selection].none{}}; }
    ret res[opt[extension.Selection], str].err{MEMORY};
}

# `s` widened by every extension of its catalog, in order, that keeps it closed and holding none of what `excluded`
# names, as a row a later version removes is checked without that version, nor anything `variant`'s abi row does not
# admit
fun widen(r: *Run, variant: *agreement.Variant, s: *extension.Selection, excluded: requirement.Ids) err[str] {
    var c: usize = 0;
    for (c < r.widened.len) {
        val w: *Widened = ?r.widened.data[c];
        if (same_selection(?w.from, s) && same_ids(w.excluded, excluded)) {
            val got: res[extension.Selection, A.Error] = extension.copy(r.a, ?w.to);
            if (sel got.err) { ret err[str].err{MEMORY}; }
            extension.release(s);
            @s = got.ok;
            ret err[str].ok{};
        }
        c = c + 1;
    }
    val from: res[extension.Selection, A.Error] = extension.copy(r.a, s);
    if (sel from.err) { ret err[str].err{MEMORY}; }
    val grown: err[str] = grow_each(r, variant, s, excluded);
    if (sel grown.err) { ret grown; }
    val to: res[extension.Selection, A.Error] = extension.copy(r.a, s);
    if (sel to.err) { ret err[str].err{MEMORY}; }
    val kept: res[usize, A.Error] = vector.push[Widened](?r.widened, Widened{from: from.ok, excluded: excluded, to: to.ok});
    if (sel kept.err) { ret err[str].err{MEMORY}; }
    ret err[str].ok{};
}

# whether `a` and `b` hold the same members and state the same atoms
fun same_selection(a: *extension.Selection, b: *extension.Selection) bool {
    if (!extension.within(a, b) || !extension.within(b, a) || a.stated.len != b.stated.len) { ret false; }
    var i: u32 = 0;
    for (i < a.stated.len) {
        if (a.stated.at[i] != b.stated.at[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_ids(a: requirement.Ids, b: requirement.Ids) bool {
    if (a.len != b.len) { ret false; }
    var i: u32 = 0;
    for (i < a.len) {
        if (a.at[i] != b.at[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# `s` grown by each extension of its catalog in turn, as `widen` states
fun grow_each(r: *Run, variant: *agreement.Variant, s: *extension.Selection, excluded: requirement.Ids) err[str] {
    val catalog: *extension.Catalog = s.catalog;
    var x:       u32                = 0;
    for (x < catalog.count) {
        if (!extension.has(s, x)) {
            val made: res[extension.Request, extension.Error] = extension.request(r.a, catalog, "", diagnostic.START);
            if (sel made.err) { ret err[str].err{MEMORY}; }
            var q: extension.Request = made.ok;
            var y: u32               = 0;
            for (y < catalog.count) {
                if (extension.has(s, y)) { extension.request_add(?q, y); }
                y = y + 1;
            }
            y = 0;
            for (y < s.stated.len) {
                extension.request_add(?q, s.stated.at[y]);
                y = y + 1;
            }
            extension.request_add(?q, x);
            val closed: res[extension.Selection, extension.Error] = extension.close(q);
            if (sel closed.ok) {
                var grown: extension.Selection = closed.ok;
                if (holds_any(?grown, excluded) || !conventional(r, variant, ?grown)) { extension.release(?grown); }
                or {
                    extension.release(s);
                    @s = grown;
                }
            }
            if (sel closed.err) {
                if (!sel closed.err.conflict) { ret err[str].err{MEMORY}; }
            }
        }
        x = x + 1;
    }
    ret err[str].ok{};
}

# `s` widened by `ids` when it closes with them, kept as it is when they conflict
fun widen_by(r: *Run, s: *extension.Selection, ids: requirement.Ids) err[str] {
    val catalog: *extension.Catalog                      = s.catalog;
    val made:    res[extension.Request, extension.Error] = extension.request(r.a, catalog, "", diagnostic.START);
    if (sel made.err) { ret err[str].err{MEMORY}; }
    var q: extension.Request = made.ok;
    var y: u32               = 0;
    for (y < catalog.count) {
        if (extension.has(s, y)) { extension.request_add(?q, y); }
        y = y + 1;
    }
    y = 0;
    for (y < s.stated.len) {
        extension.request_add(?q, s.stated.at[y]);
        y = y + 1;
    }
    y = 0;
    for (y < ids.len) {
        extension.request_add(?q, ids.at[y]);
        y = y + 1;
    }
    val closed: res[extension.Selection, extension.Error] = extension.close(q);
    if (sel closed.ok) {
        extension.release(s);
        @s = closed.ok;
        ret err[str].ok{};
    }
    if (sel closed.err) {
        if (!sel closed.err.conflict) { ret err[str].err{MEMORY}; }
    }
    ret err[str].ok{};
}

# `s` widened by what each enumeration operand of `row_` needs where it admits none of its members: the first
# alternative of the first member's requirement, as a spir-v memory model needs a capability whichever it is
fun enumerated(r: *Run, row_: *row.Row, s: *extension.Selection) err[str] {
    var k: u32 = 0;
    for (k < row_.operands.len) {
        val shape: *operand.Shape = ?row_.operands.at[k].shape;
        if (sel shape.enumerant) {
            val e:  *operand.Enumeration            = ?shape.enumerant;
            val at: res[state.Context, state.Error] = state.make(s, ?r.agreement.set.states, state.initial(?r.agreement.set.states));
            if (sel at.err) { ret err[str].err{MEMORY}; }
            var ctx:   state.Context = at.ok;
            var any:   bool          = e.count == 0;
            var first: u32           = e.count;
            var i:     u32           = 0;
            for (i < e.count && !any) {
                val required: requirement.Requirement = e.members[i].requires;
                if (state.admits(?ctx, required))         { any = true; }
                or (first == e.count && required.len > 0) { first = i; }
                i = i + 1;
            }
            if (!any && first < e.count) {
                val grown: err[str] = widen_by(r, s, e.members[first].requires.at[0].all);
                if (sel grown.err) { ret grown; }
            }
        }
        k = k + 1;
    }
    ret err[str].ok{};
}

# the first alternative's extensions of the first register `r` admits that `v` does not hold, none when it holds one
# of them or none of those it lacks has a requirement
fun operand_needs(v: *register.Available, r: *operand.Register) opt[requirement.Ids] {
    val file: *register.File       = v.file;
    var need: opt[requirement.Ids] = opt[requirement.Ids].none{};
    var c:    u32                  = 0;
    for (c < r.classes.len) {
        val class: u16 = r.classes.at[c];
        if (class::u32 < file.class_count) {
            val span: u32 = operand.span(r, register.count_most(file, class)::u32);
            var i:    u32 = 0;
            for (i < span) {
                val n: u32 = r.first + i;
                if (!operand.excludes_number(r, n)) {
                    val held: err[register.Absent] = register.admitted(v, register.make(class, n::u16));
                    if (sel held.ok) { ret opt[requirement.Ids].none{}; }
                    if (sel held.err) {
                        val why: register.Absent = held.err;
                        if (sel why.unavailable) {
                            if (sel need.none && why.unavailable.requires.len > 0) { need = opt[requirement.Ids].some{why.unavailable.requires.at[0].all}; }
                        }
                    }
                }
                i = i + 1;
            }
        }
        c = c + 1;
    }
    ret need;
}

# the first alternative's extensions of the first register of `set` that `v` does not hold, none when it holds each
fun touched_needs(v: *register.Available, set: effect.Set) opt[requirement.Ids] {
    val file: *register.File = v.file;
    var w:    u32            = 0;
    for (w < set.len) {
        var b: u32 = 0;
        for (b < 64) {
            val at: u32 = w * 64 + b;
            if (((set.words[w] >> b::u64) & 1) != 0 && at < file.register_count) {
                val reg:  *register.Register   = ?file.registers[at];
                val held: err[register.Absent] = register.admitted(v, register.make(reg.class, reg.number));
                if (sel held.err && reg.requires.len > 0) { ret opt[requirement.Ids].some{reg.requires.at[0].all}; }
            }
            b = b + 1;
        }
        w = w + 1;
    }
    ret opt[requirement.Ids].none{};
}

# `s` widened by what the registers of `row_` need where the selection lacks them, as a user selects them: the first
# alternative of the requirement of a register operand's registers where it holds none of them, as cvtps2pi's mm needs
# mmx, and of each register the row surely touches, as fxsave's x87 control words need x87
fun registered(r: *Run, variant: *agreement.Variant, row_: *row.Row, s: *extension.Selection) err[str] {
    val set_: *set.Set = r.agreement.set;
    if (set_.codec == nil || set_.codec.registers == nil) { ret err[str].ok{}; }
    val arch: opt[*set.Arch] = set.arch_of(set_, variant.arch);
    if (sel arch.none) { ret err[str].ok{}; }
    var round: u32 = 0;
    for (round < 8) {
        var view:   register.Available;
        val opened: res[state.Context, state.Opened] = set.open(r.scratch, set_, arch.some, s, ?view);
        if (sel opened.err) { ret err[str].ok{}; }
        var need: opt[requirement.Ids] = opt[requirement.Ids].none{};
        var k:    u32                  = 0;
        for (k < row_.operands.len && sel need.none) {
            val shape: *operand.Shape = ?row_.operands.at[k].shape;
            if (sel shape.register) { need = operand_needs(?view, ?shape.register); }
            k = k + 1;
        }
        val touched: effect.Touched       = effect.must(row_.effect);
        val read:    opt[requirement.Ids] = touched_needs(?view, touched.read);
        val written: opt[requirement.Ids] = touched_needs(?view, touched.written);
        var found:   bool                 = sel need.some;
        if (!found && sel read.some) {
            need  = read;
            found = true;
        }
        if (!found && sel written.some) { need = written; }
        val released: err[A.Error] = register.release(?view);
        if (sel released.err) { ret err[str].err{MEMORY}; }
        if (sel need.none)    { ret err[str].ok{}; }
        val grown: err[str] = widen_by(r, s, need.some);
        if (sel grown.err) { ret grown; }
        var i: u32 = 0;
        for (i < need.some.len) {
            if (!extension.has(s, need.some.at[i])) { ret err[str].ok{}; }
            i = i + 1;
        }
        round = round + 1;
    }
    ret err[str].ok{};
}

# the selection `r` is checked under at `variant`, none when no alternative of its requirement closes with the base
fun choose(r: *Run, variant: *agreement.Variant, row_: *row.Row) res[opt[extension.Selection], str] {
    val none:     requirement.Alternative  = requirement.Alternative{all: requirement.NO_IDS, none: requirement.NO_IDS};
    var chosen:   opt[extension.Selection] = opt[extension.Selection].none{};
    var excluded: requirement.Ids          = requirement.NO_IDS;
    if (row_.requires.len == 0) {
        val got: res[opt[extension.Selection], str] = attempt(r, variant, none);
        if (sel got.err) { ret got; }
        chosen = got.ok;
    }
    var i: u32 = 0;
    for (i < row_.requires.len && sel chosen.none) {
        val got: res[opt[extension.Selection], str] = attempt(r, variant, row_.requires.at[i]);
        if (sel got.err) { ret got; }
        chosen   = got.ok;
        excluded = row_.requires.at[i].none;
        i        = i + 1;
    }
    if (sel chosen.none) { ret res[opt[extension.Selection], str].ok{chosen}; }
    var s:      extension.Selection = chosen.some;
    val needed: err[str]            = enumerated(r, row_, ?s);
    if (sel needed.err) { ret res[opt[extension.Selection], str].err{needed.err}; }
    val held: err[str] = registered(r, variant, row_, ?s);
    if (sel held.err)           { ret res[opt[extension.Selection], str].err{held.err}; }
    if (!r.result.options.full) { ret res[opt[extension.Selection], str].ok{opt[extension.Selection].some{s}}; }
    val widened: err[str] = widen(r, variant, ?s, excluded);
    if (sel widened.err) { ret res[opt[extension.Selection], str].err{widened.err}; }
    ret res[opt[extension.Selection], str].ok{opt[extension.Selection].some{s}};
}

# a writer over `out` in the agreement's syntax, under `g`'s selection
fun writer(r: *Run, g: *Group, out: *vector.Vector[u8]) core_syntax.Writer {
    val s: *set.Set = r.agreement.set;
    ret core_syntax.Writer{out: out, codec: s.codec, ctx: ?g.context, syntax: ?s.syntaxes.at[r.agreement.syntax], modes: ?r.modes, symbols: nil, context: nil, row: nil, dot: false, values: nil};
}

# `source`, one line of masc's syntax, assembled by masc under `g` at `w`, into the run's storage. in the comdat group
# of signature `group` it is in a vector's section of that group, as the tools' source states it, nil for none
fun assemble(r: *Run, w: *Width, g: *Group, source: str, group: str) Outcome {
    var t:    text.Text = text.make(r.scratch);
    var name: str       = ".text";
    if (group != nil) {
        val flags: str = grouped_flags(r, w.format, group);
        if (flags == nil) { ret Outcome.refused{"the framework spells no comdat group of the format"}; }
        name = VECTOR_ZERO;
        text.put(?t, "\t.section ");
        text.put(?t, name);
        text.put(?t, flags);
        text.put(?t, "\n");
    }
    text.put(?t, "\t");
    text.put(?t, source);
    text.put(?t, "\n");
    if (t.failed) { ret Outcome.refused{MEMORY}; }
    val options: model.Options                          = model.Options{arch: w.variant.arch, formats: r.formats, syntax: r.agreement.syntax, abi: w.variant.abi, dialect: w.dialect, layers: model.NO_LAYERS};
    var got:     res[mink_object.Object, model.Refusal] = asm.assemble(r.scratch, r.agreement.set, ?g.context, options, t.out.data, t.out.len, diagnostic.START);
    if (sel got.err) {
        var why:     vector.Vector[u8] = vector.init[u8](r.scratch);
        val spelled: err[A.Error]      = state.spell_refusal(got.err.message, ?got.err.unmet, ?why);
        if (sel spelled.err) { ret Outcome.refused{MEMORY}; }
        val kept: opt[str] = owned(r.a, ?why);
        if (sel kept.none) { ret Outcome.refused{MEMORY}; }
        ret Outcome.refused{kept.some};
    }
    var o:    mink_object.Object      = got.ok;
    var text: res[object.Placed, str] = res[object.Placed, str].err{MEMORY};
    # a vector with relocations is compared as its format's file holds it, read back as the tools' are, so a field
    # holding its addend and a kind the format reads back as another, as coff's REL32 reads as PC32, compare alike, and
    # one in a group so, so a signature the format signs with a symbol of its own reads back as theirs does
    if (o.relocs.count > 0 || group != nil) { text = object.written_section(r.formats, r.a, r.scratch, ?o, w.format, w.written, name); }
    or                                      { text = object.section_of(r.a, ?o, name); }
    mink_object.release(?o);
    if (sel text.err) { ret refused(r, text.err); }
    ret Outcome.bytes{Assembled{bytes: text.ok.bytes, relocs: text.ok.relocs, group: text.ok.group}};
}

# `head` and `message` as a refused outcome, in the run's storage
fun refused_by(r: *Run, head: str, message: str) Outcome {
    val joined_: res[str, str] = joined(r, head, message, "");
    if (sel joined_.err) { ret Outcome.refused{MEMORY}; }
    ret Outcome.refused{joined_.ok};
}

# `source`, one statement of masc's syntax, read and encoded by masc under the stream of `g`, as an assembler of a
# typed stream reads one line of a source whose earlier lines defined what the group's vectors need, into the run's
# storage
fun encoded(r: *Run, g: *Group, source: str) Outcome {
    val s:      *set.Set           = r.agreement.set;
    val len:    usize              = str_len(source);
    var stores: core_syntax.Stores = core_syntax.stores(r.scratch);
    fin { core_syntax.release(?stores); }
    var ex: relax.Expansion;
    # read again into stores grown to what the read found them short of, which reads the stream's ids and types alike
    for {
        var rd: core_syntax.Reader = core_syntax.Reader{text: source, start: 0, at: 0, end: len, origin: diagnostic.START, codec: s.codec, ctx: ?g.context, syntax: ?s.syntaxes.at[r.agreement.syntax], modes: ?r.modes, symbols: ?NO_SYMBOLS, context: nil, row: nil};
        core_syntax.over(?rd, ?stores);
        val read:  err[diagnostic.Diagnostic] = parse.statement(?rd, ?ex);
        val again: res[bool, A.Error]         = core_syntax.regrown(?rd, ?stores);
        if (sel again.err) { ret Outcome.refused{MEMORY}; }
        if (again.ok)      { cnt; }
        if (sel read.err)  { ret refused_by(r, "masc cannot read it: ", read.err.message); }
        brk;
    }
    var out:    vector.Vector[u8]          = vector.init[u8](r.scratch);
    var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](r.scratch);
    var i:      u32                        = 0;
    for (i < ex.count) {
        val step:  *relax.Emitted            = ?ex.steps[i];
        var ins:   inst.Inst                 = inst.Inst{row: step.row, values: ?step.values[0], count: step.row.operands.len, form: step.form};
        val wrote: res[usize, field.Refusal] = walk.encode(s.codec, ?g.context, ?ins, ?out, ?fixups);
        if (sel wrote.err) { ret refused_by(r, "masc cannot encode it: ", wrote.err.message); }
        i = i + 1;
    }
    if (fixups.len != 0) { ret Outcome.refused{"masc encodes it with a fixup, which no vector of a typed stream takes"}; }
    val bytes: opt[operand.Bytes] = object.own(r.a, out.data, out.len);
    if (sel bytes.none) { ret Outcome.refused{MEMORY}; }
    ret Outcome.bytes{Assembled{bytes: bytes.some, relocs: "", group: ""}};
}

# `source` assembled by masc under `g` at `w`: one line assembled alone, in the comdat group of signature `group` when
# it is not nil, or read under the group's stream for a set of a typed stream, which states no group
fun assembled(r: *Run, w: *Width, g: *Group, source: str, group: str) Outcome {
    if (r.agreement.stream != nil) { ret encoded(r, g, source); }
    ret assemble(r, w, g, source, group);
}

# `ins`, whose encoding is `len` bytes, with each relative target anchored at its end restated from its start and
# wrapped to an address of `bytes` bytes, its values copied into `room`, as the listing reads a target
fun from_start(ins: *inst.Inst, len: usize, bytes: u8, room: *operand.Value) inst.Inst {
    var out: inst.Inst = @ins;
    var k:   u32       = 0;
    for (k < ins.count) {
        room[k] = ins.values[k];
        val desc: *operand.Operand = ?ins.row.operands.at[k];
        val v:    *operand.Value   = ?room[k];
        if (sel v.relative) {
            if (sel desc.shape.relative && desc.shape.relative.anchor == operand.END) {
                var offset: u64 = (v.relative + len::i64):~u64;
                if (bytes < 8) {
                    val bits: u64 = bytes::u64 * 8;
                    offset = offset & ((1::u64 << bits) - 1);
                    if ((offset >> (bits - 1)) != 0) { offset = offset | ~((1::u64 << bits) - 1); }
                }
                room[k] = operand.Value.relative{offset:~i64};
            }
        }
        k = k + 1;
    }
    out.values = room;
    ret out;
}

# masc's printing of `bytes`, decoded under `g`, its instructions joined, as the disassembler lists them when `listed`:
# each by its row's own form, or by the alias masc prefers where the disassembler applies aliases, its targets stated
# from each instruction's start as the listing reads them, wrapped to addresses of `address` bytes. otherwise each by
# the alias masc prefers. a relative target is written as `.` and its distance when `dot`. into `read` the row of the
# one instruction they are, nil when they are more or none
fun decode(r: *Run, g: *Group, bytes: operand.Bytes, listed: bool, dot: bool, address: u8, read: **row.Row) Printed {
    @read = nil;
    val s:     *set.Set                               = r.agreement.set;
    var store: vector.Vector[operand.Value]           = vector.init[operand.Value](r.scratch);
    var alts:  vector.Vector[requirement.Alternative] = vector.init[requirement.Alternative](r.scratch);
    fin {
        vector.dnit[operand.Value](?store);
        vector.dnit[requirement.Alternative](?alts);
    }
    var out: vector.Vector[u8]  = vector.init[u8](r.scratch);
    var w:   core_syntax.Writer = writer(r, g, ?out);
    var at:  usize              = 0;
    w.dot = dot;
    for (at < bytes.len::usize) {
        val got: res[walk.Decoded, field.Refusal] = walk.decode_grown(s.codec, ?g.context, bytes.at, bytes.len::usize, at, ?store, ?alts);
        if (sel got.err) {
            var t: text.Text = text.make(r.a);
            text.put(?t, "masc cannot decode it: ");
            text.put(?t, got.err.message);
            val kept: opt[str] = text.copy(?t, r.a);
            if (sel kept.none) { ret Printed.refused{MEMORY}; }
            ret Printed.refused{kept.some};
        }
        var ins: inst.Inst = got.ok.inst;
        if (at == 0 && got.ok.len == bytes.len::usize) { @read = ins.row; }
        if (at > 0) {
            var k: usize = 0;
            for (k < str_len(listing.JOIN)) {
                vector.push[u8](?out, listing.JOIN[k]);
                k = k + 1;
            }
        }
        var printed: err[field.Refusal] = err[field.Refusal].ok{};
        if (listed) {
            var started: [row.MAX_OPERANDS]operand.Value;
            val shown:   inst.Inst = from_start(?ins, got.ok.len, address, ?started[0]);
            if (r.agreement.disassembler.aliased) { printed = print.instruction(?w, ?shown); }
            or                                    { printed = print.form(?w, ?shown); }
        }
        or { printed = print.instruction(?w, ?ins); }
        if (sel printed.err) {
            var t: text.Text = text.make(r.a);
            text.put(?t, "masc cannot print it: ");
            text.put(?t, printed.err.message);
            val kept: opt[str] = text.copy(?t, r.a);
            if (sel kept.none) { ret Printed.refused{MEMORY}; }
            ret Printed.refused{kept.some};
        }
        at = at + got.ok.len;
    }
    val whole: opt[str] = owned(r.a, ?out);
    if (sel whole.none) { ret Printed.refused{MEMORY}; }
    ret Printed.text{whole.some};
}

# the label each vector's section opens with under labelled targets, before its number
val LABEL: str = ".Lvector";

# whether `ins` holds a relative target
fun targeted(ins: *inst.Inst) bool {
    var k: u32 = 0;
    for (k < ins.count) {
        if (sel ins.values[k].relative) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the label of vector `n`, spelled into `buf`
rec Label {
    buf: [32]u8;
    len: usize;
}

fun label_name(context: ptr, id: u32) View {
    val l: *Label = context::*Label;
    ret View{data: ?l.buf[0], len: l.len};
}

fun label_resolve(context: ptr, name: View) res[core_syntax.Resolved, str] {
    ret res[core_syntax.Resolved, str].err{"no symbol is read"};
}

# `n`'s label spelled into `l`
fun spell_label(l: *Label, n: u32) {
    var t: usize = 0;
    var k: usize = 0;
    for (k < str_len(LABEL)) {
        l.buf[t] = LABEL[k];
        t        = t + 1;
        k        = k + 1;
    }
    var digits: [12]u8;
    var count:  usize = 0;
    var v:      u32   = n;
    for {
        digits[count] = ('0'::u32 + v % 10)::u8;
        count         = count + 1;
        v             = v / 10;
        if (v == 0) { brk; }
    }
    for (count > 0) {
        count    = count - 1;
        l.buf[t] = digits[count];
        t        = t + 1;
    }
    l.len = t;
}

# the relative target `v` of an operand `desc` describes, as the vector's label plus the offset from the vector's start
# masc's `len` bytes reach
fun labelled(desc: *operand.Operand, v: operand.Value, len: i64) operand.Value {
    if (!sel v.relative) { ret v; }
    var offset: i64 = v.relative;
    if (desc != nil) {
        if (sel desc.shape.relative && desc.shape.relative.anchor == operand.END) { offset = offset + len; }
    }
    ret operand.Value.symbol{operand.Symbol{id: 1, addend: offset, fixup: operand.NO_FIXUP}};
}

# case `c`, vector `n` of `g`, printed by its row's form or its alias with each relative target the vector's label
# plus the offset from the vector's start masc's `len` bytes reach, none when masc cannot print it so
fun labelled_text(r: *Run, g: *Group, c: *Case, n: u32, len: i64) res[opt[str], str] {
    var room: [row.MAX_OPERANDS]operand.Value;
    var own:  [row.MAX_OPERANDS]operand.Value;
    var ins:  inst.Inst = c.inst;
    var k:    u32       = 0;
    for (k < ins.count) {
        room[k] = labelled(?ins.row.operands.at[k], ins.values[k], len);
        k       = k + 1;
    }
    ins.values = ?room[0];
    if (c.alias != nil) {
        k = 0;
        for (k < c.alias.count::u32 && k < row.MAX_OPERANDS) {
            own[k] = labelled(core_syntax.alias_operand(c.alias, c.inst.row, k::u8), c.spelled[k], len);
            k      = k + 1;
        }
    }
    var l: Label;
    spell_label(?l, n);
    var symbols: core_syntax.Symbols = core_syntax.Symbols{context: ?l, resolve: label_resolve, name: label_name};
    var out:     vector.Vector[u8]   = vector.init[u8](r.a);
    var w:       core_syntax.Writer  = writer(r, g, ?out);
    w.symbols = ?symbols;
    var printed: err[field.Refusal] = err[field.Refusal].ok{};
    if (c.alias != nil)  { printed = print.respelled(?w, c.alias, ?ins, ?own[0]); }
    or                   { printed = print.form(?w, ?ins); }
    if (sel printed.err) { ret res[opt[str], str].ok{opt[str].none{}}; }
    val kept: opt[str] = owned(r.a, ?out);
    if (sel kept.none) { ret res[opt[str], str].err{MEMORY}; }
    ret res[opt[str], str].ok{opt[str].some{kept.some}};
}

# each case of `g` printed by its row's form and assembled by masc, and masc's printing of its bytes assembled back
fun by_masc(r: *Run, w: *Width, g: *Group) err[str] {
    var out: vector.Vector[u8] = vector.init[u8](r.a);
    var i:   usize             = 0;
    for (i < g.cases.len) {
        val c: *Case = ?g.cases.data[i];
        out.len = 0;
        var wr: core_syntax.Writer = writer(r, g, ?out);
        wr.dot = r.agreement.targets == agreement.DOT;
        var printed: err[field.Refusal] = err[field.Refusal].ok{};
        if (c.text != nil) {
            # a statement is its own text
            arena.reset(r.area);
            c.masc = assembled(r, w, g, c.text, c.group);
            i      = i + 1;
            cnt;
        }
        if (c.alias != nil) { printed = print.respelled(?wr, c.alias, ?c.inst, c.spelled); }
        or                  { printed = print.form(?wr, ?c.inst); }
        if (sel printed.err) {
            var t: text.Text = text.make(r.a);
            text.put(?t, "masc cannot print it: ");
            text.put(?t, printed.err.message);
            val kept: opt[str] = text.copy(?t, r.a);
            if (sel kept.none) { ret err[str].err{MEMORY}; }
            c.masc = Outcome.refused{kept.some};
            i      = i + 1;
            cnt;
        }
        val kept: opt[str] = owned(r.a, ?out);
        if (sel kept.none) { ret err[str].err{MEMORY}; }
        c.text = kept.some;
        c.tool = c.text;
        arena.reset(r.area);
        c.masc = assembled(r, w, g, c.text, nil);
        if (r.agreement.targets == agreement.LABEL && targeted(?c.inst)) {
            c.tool = nil;
            if (sel c.masc.bytes) {
                val labelled: res[opt[str], str] = labelled_text(r, g, c, i::u32, c.masc.bytes.bytes.len::i64);
                if (sel labelled.err)     { ret err[str].err{labelled.err}; }
                if (sel labelled.ok.some) { c.tool = labelled.ok.some; }
            }
        }
        if (sel c.masc.bytes) {
            arena.reset(r.area);
            var mine: *row.Row = nil;
            c.printed = decode(r, g, c.masc.bytes.bytes, false, r.agreement.targets == agreement.DOT, 8, ?mine);
            if (sel c.printed.text) {
                arena.reset(r.area);
                c.trip = assembled(r, w, g, c.printed.text, nil);
            }
        }
        i = i + 1;
    }
    arena.reset(r.area);
    ret err[str].ok{};
}

# `x`, `y` and `z` joined into the run's storage
fun joined(r: *Run, x: str, y: str, z: str) res[str, str] {
    var t: text.Text = text.make(r.a);
    text.put(?t, x);
    text.put(?t, y);
    text.put(?t, z);
    val got: opt[str] = text.copy(?t, r.a);
    if (sel got.none) { ret res[str, str].err{MEMORY}; }
    ret res[str, str].ok{got.some};
}

# the stem of the files of `g` at `w` for the tool `name`, in the work directory
fun stem(r: *Run, w: *Width, g: *Group, name: str) res[str, str] {
    var t: text.Text = text.make(r.a);
    text.put(?t, w.name);
    text.put(?t, "-");
    text.decimal(?t, g.number::i64);
    text.put(?t, "-");
    text.put(?t, name);
    val got: opt[str] = text.copy(?t, r.a);
    if (sel got.none) { ret res[str, str].err{MEMORY}; }
    ret res[str, str].ok{got.some};
}

# the source file of the cases `pending` lists for assembler `asmr`, its prelude's lines first, counted into
# `opening`, then each case in its own section, of its comdat group for a case in one, the kth pending case's
# instruction on line opening + 2k + 2
fun source_of(r: *Run, w: *Width, g: *Group, asmr: *agreement.Assembler, job: *agreement.Job, pending: *vector.Vector[u32], path: str, opening: *u32) err[str] {
    val flags: str = section_flags(w.format);
    if (flags == nil) { ret err[str].err{"the framework spells no code section of the format"}; }
    var t: text.Text = text.make(r.scratch);
    var k: usize     = 0;
    @opening = 0;
    if (asmr.prelude != nil) {
        asmr.prelude(job, ?t);
        for (k < t.out.len) {
            if (t.out.data[k] == '\n') { @opening = @opening + 1; }
            k = k + 1;
        }
        k = 0;
    }
    for (k < pending.len) {
        val n:   u32 = pending.data[k];
        var own: str = flags;
        if (g.cases.data[n].group != nil) { own = grouped_flags(r, w.format, g.cases.data[n].group); }
        if (own == nil)                   { ret err[str].err{"the framework spells no comdat group of the format"}; }
        text.put(?t, "\t.section ");
        text.put(?t, object.PREFIX);
        text.decimal(?t, n::i64);
        text.put(?t, own);
        text.put(?t, "\n");
        if (r.agreement.targets == agreement.LABEL) {
            var l: Label;
            spell_label(?l, n);
            text.bytes(?t, ?l.buf[0], l.len);
            text.put(?t, ":");
        }
        text.put(?t, "\t");
        text.put(?t, g.cases.data[n].tool);
        text.put(?t, "\n");
        k = k + 1;
    }
    if (t.failed) { ret err[str].err{MEMORY}; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, t.out.data, t.out.len, 0o644);
    if (sel wrote.err) { ret err[str].err{"a source file cannot be written"}; }
    ret err[str].ok{};
}

# every case of `pending` given the outcome `why`
fun give_all(g: *Group, pending: *vector.Vector[u32], j: usize, why: Outcome) {
    var k: usize = 0;
    for (k < pending.len) {
        g.cases.data[pending.data[k]].tools[j] = why;
        k                                      = k + 1;
    }
}

# what the vectors of `g` need, as every job of the group states it
fun needs_of(g: *Group) vectors.Needs {
    ret vectors.Needs{at: g.needs.data, len: g.needs.len::u32};
}

# the lines `t` ends after, counted on from `lines` past offset `seen`, which both advance to its end
fun lines_of(t: *text.Text, seen: *usize, lines: *u32) u32 {
    for (@seen < t.out.len) {
        if (t.out.data[@seen] == '\n') { @lines = @lines + 1; }
        @seen = @seen + 1;
    }
    ret @lines;
}

# the source of the cases `pending` lists laid out by `layout` as one file, the lines of the kth pending case's text
# from `first[k]` to `last[k]`
fun layout_of(r: *Run, g: *Group, job: *agreement.Job, layout: *agreement.Layout, pending: *vector.Vector[u32], first: *vector.Vector[u32], last: *vector.Vector[u32], path: str) err[str] {
    var t:     text.Text = text.make(r.scratch);
    var seen:  usize     = 0;
    var lines: u32       = 0;
    layout.open(job, ?t);
    var k: usize = 0;
    for (k < pending.len) {
        val c:    *Case               = ?g.cases.data[pending.data[k]];
        val from: res[usize, A.Error] = vector.push[u32](first, lines_of(?t, ?seen, ?lines) + 1);
        layout.vector(job, ?c.inst, c.tool, ?t);
        val to: res[usize, A.Error] = vector.push[u32](last, lines_of(?t, ?seen, ?lines));
        if (sel from.err || sel to.err) { ret err[str].err{MEMORY}; }
        k = k + 1;
    }
    layout.close(job, ?t);
    if (t.failed) { ret err[str].err{MEMORY}; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, t.out.data, t.out.len, 0o644);
    if (sel wrote.err) { ret err[str].err{"a source file cannot be written"}; }
    ret err[str].ok{};
}

# the cases of `g` assembler `j` assembles from one source its layout makes, its outcome given each, each vector's
# bytes found by the layout's split of the file it writes
fun by_layout(r: *Run, w: *Width, g: *Group, j: usize, pending: *vector.Vector[u32]) err[str] {
    val found:  *tool.Found          = ?r.result.assemblers.data[j];
    val asmr:   *agreement.Assembler = ?r.agreement.assemblers.at[j];
    val layout: *agreement.Layout    = asmr.layout;
    val named:  res[str, str]        = stem(r, w, g, found.tool.name);
    if (sel named.err) { ret err[str].err{named.err}; }
    val base:   str           = named.ok;
    val source: res[str, str] = joined(r, r.result.options.work, "/", base);
    if (sel source.err) { ret err[str].err{source.err}; }
    val src: res[str, str] = joined(r, source.ok, ".s", "");
    if (sel src.err) { ret err[str].err{MEMORY}; }
    val obj: res[str, str] = joined(r, source.ok, ".o", "");
    if (sel obj.err) { ret err[str].err{MEMORY}; }
    for (pending.len > 0) {
        arena.reset(r.area);
        var job:   agreement.Job      = agreement.Job{variant: w.variant, format: w.format, selection: ?g.selection, source: src.ok, object: obj.ok, needs: needs_of(g)};
        var first: vector.Vector[u32] = vector.init[u32](r.scratch);
        var last:  vector.Vector[u32] = vector.init[u32](r.scratch);
        val wrote: err[str]           = layout_of(r, g, ?job, layout, pending, ?first, ?last, src.ok);
        if (sel wrote.err) { ret wrote; }
        var args: agreement.Args = agreement.Args{a: r.scratch, list: vector.init[str](r.scratch), failed: false};
        asmr.spell(?job, ?args);
        val ran: res[tool.Ran, str] = tool.run(r.scratch, found.path, ?args, r.result.options.work, base);
        if (sel ran.err) {
            give_all(g, pending, j, refused(r, ran.err));
            brk;
        }
        val said: res[tool.Said, str] = tool.said(r.scratch, ran.ok.err, src.ok);
        if (sel said.err) { ret err[str].err{said.err}; }
        var k: usize = 0;
        for (k < said.ok.notes.len) {
            val noted: err[str] = note(r, found.tool.name, said.ok.notes.data[k]);
            if (sel noted.err) { ret noted; }
            k = k + 1;
        }
        if (ran.ok.ok) {
            val loaded: res[vector.Vector[u8], fs.FsError] = fs.read_bytes(r.scratch, obj.ok);
            if (sel loaded.err) {
                give_all(g, pending, j, Outcome.refused{"the file it wrote cannot be read"});
                brk;
            }
            val held: res[*inst.Inst, A.Error] = A.allocate[inst.Inst](r.scratch, pending.len);
            if (sel held.err) { ret err[str].err{MEMORY}; }
            k = 0;
            for (k < pending.len) {
                held.ok[k] = g.cases.data[pending.data[k]].inst;
                k          = k + 1;
            }
            var split:  agreement.Split              = agreement.Split{a: r.a, job: ?job, codec: r.agreement.set.codec, ctx: ?g.context, formats: r.formats, vectors: held.ok, count: pending.len::u32};
            var pieces: vector.Vector[operand.Bytes] = vector.init[operand.Bytes](r.a);
            val parted: err[str]                     = layout.split(?split, operand.Bytes{at: loaded.ok.data, len: loaded.ok.len::u32}, ?pieces);
            if (sel parted.err) {
                give_all(g, pending, j, refused(r, parted.err));
                brk;
            }
            if (pieces.len != pending.len) {
                give_all(g, pending, j, Outcome.refused{"the layout's split found another count of vectors than the file holds"});
                brk;
            }
            k = 0;
            for (k < pending.len) {
                g.cases.data[pending.data[k]].tools[j] = Outcome.bytes{Assembled{bytes: pieces.data[k], relocs: "", group: ""}};
                k                                      = k + 1;
            }
            if (j == 0) {
                val kept: res[usize, A.Error] = vector.push[str](?g.references, obj.ok);
                if (sel kept.err) { ret err[str].err{MEMORY}; }
            }
            brk;
        }
        var removed: vector.Vector[bool] = vector.init[bool](r.scratch);
        k = 0;
        for (k < pending.len) {
            val pushed: res[usize, A.Error] = vector.push[bool](?removed, false);
            if (sel pushed.err) { ret err[str].err{MEMORY}; }
            k = k + 1;
        }
        var any: bool = false;
        k = 0;
        for (k < said.ok.located.len) {
            val l:  tool.Located = said.ok.located.data[k];
            var at: usize        = 0;
            for (at < pending.len) {
                if (l.line >= first.data[at] && l.line <= last.data[at] && !removed.data[at]) {
                    removed.data[at]                        = true;
                    g.cases.data[pending.data[at]].tools[j] = refused(r, l.message);
                    any                                     = true;
                }
                at = at + 1;
            }
            k = k + 1;
        }
        if (!any) {
            var why: Outcome = Outcome.refused{"it exited with a failure and named no line of a vector"};
            if (said.ok.general != nil)  { why = refused(r, said.ok.general); }
            if (said.ok.located.len > 0) { why = refused(r, said.ok.located.data[0].message); }
            give_all(g, pending, j, why);
            brk;
        }
        var kept: usize = 0;
        k = 0;
        for (k < pending.len) {
            if (!removed.data[k]) {
                pending.data[kept] = pending.data[k];
                kept               = kept + 1;
            }
            k = k + 1;
        }
        pending.len = kept;
    }
    arena.reset(r.area);
    ret err[str].ok{};
}

# the cases of `g` assembler `j` assembles, its outcome given each. the cases are assembled in batches, the first of
# them all: a batch the tool refuses vectors of at their lines is run again without them, and each of those alone, as a
# refusal may come of the statement before it as llvm-mc's after a movprfx does, and one it fails naming no
# line, as a fixup no line holds, is run again as its two halves, so one vector never hides another's bytes. each
# batch the reference assembles is one of the group's reference objects. an assembler of one format is not run in
# another, its outcomes left none
fun by_tool(r: *Run, w: *Width, g: *Group, j: usize) err[str] {
    val found:   *tool.Found                       = ?r.result.assemblers.data[j];
    val asmr:    *agreement.Assembler              = ?r.agreement.assemblers.at[j];
    var batches: vector.Vector[vector.Vector[u32]] = vector.init[vector.Vector[u32]](r.a);
    var all:     vector.Vector[u32]                = vector.init[u32](r.a);
    var i:       usize                             = 0;
    for (i < g.cases.len) {
        if (g.cases.data[i].tool != nil && !g.cases.data[i].dropped) {
            val pushed: res[usize, A.Error] = vector.push[u32](?all, i::u32);
            if (sel pushed.err) { ret err[str].err{MEMORY}; }
        }
        i = i + 1;
    }
    if (all.len == 0)                              { ret err[str].ok{}; }
    if (asmr.only != nil && asmr.only != w.format) { ret err[str].ok{}; }
    if (asmr.layout != nil)                        { ret by_layout(r, w, g, j, ?all); }
    val first: res[usize, A.Error] = vector.push[vector.Vector[u32]](?batches, all);
    if (sel first.err) { ret err[str].err{MEMORY}; }
    val base: res[str, str] = stem(r, w, g, found.tool.name);
    if (sel base.err) { ret err[str].err{base.err}; }
    var number: u32 = 0;
    for (batches.len > 0) {
        var pending: vector.Vector[u32] = batches.data[batches.len - 1];
        batches.len = batches.len - 1;
        var t: text.Text = text.make(r.a);
        text.put(?t, base.ok);
        text.put(?t, "-");
        text.decimal(?t, number::i64);
        val named: opt[str] = text.copy(?t, r.a);
        if (sel named.none) { ret err[str].err{MEMORY}; }
        number = number + 1;
        val source: res[str, str] = joined(r, r.result.options.work, "/", named.some);
        if (sel source.err) { ret err[str].err{source.err}; }
        val src: res[str, str] = joined(r, source.ok, ".s", "");
        if (sel src.err) { ret err[str].err{MEMORY}; }
        val obj: res[str, str] = joined(r, source.ok, ".o", "");
        if (sel obj.err) { ret err[str].err{MEMORY}; }
        arena.reset(r.area);
        var job:     agreement.Job = agreement.Job{variant: w.variant, format: w.format, selection: ?g.selection, source: src.ok, object: obj.ok, needs: needs_of(g)};
        var opening: u32           = 0;
        val wrote:   err[str]      = source_of(r, w, g, asmr, ?job, ?pending, src.ok, ?opening);
        if (sel wrote.err) { ret wrote; }
        var args: agreement.Args = agreement.Args{a: r.scratch, list: vector.init[str](r.scratch), failed: false};
        asmr.spell(?job, ?args);
        val ran: res[tool.Ran, str] = tool.run(r.scratch, found.path, ?args, r.result.options.work, named.some);
        if (sel ran.err) {
            give_all(g, ?pending, j, refused(r, ran.err));
            cnt;
        }
        val said: res[tool.Said, str] = tool.said(r.scratch, ran.ok.err, src.ok);
        if (sel said.err) { ret err[str].err{said.err}; }
        var k: usize = 0;
        for (k < said.ok.notes.len) {
            val noted: err[str] = note(r, found.tool.name, said.ok.notes.data[k]);
            if (sel noted.err) { ret noted; }
            k = k + 1;
        }
        if (ran.ok.ok) {
            var placed: vector.Vector[object.Placed] = vector.init[object.Placed](r.a);
            val read:   err[str]                     = object.sections(r.formats, r.a, r.scratch, obj.ok, ?placed);
            if (sel read.err) {
                give_all(g, ?pending, j, refused(r, read.err));
                cnt;
            }
            give_all(g, ?pending, j, Outcome.refused{"the object holds no section of it"});
            k = 0;
            for (k < placed.len) {
                val n: u32 = placed.data[k].vector;
                if (n::usize < g.cases.len) { g.cases.data[n].tools[j] = Outcome.bytes{Assembled{bytes: placed.data[k].bytes, relocs: placed.data[k].relocs, group: placed.data[k].group}}; }
                k = k + 1;
            }
            if (j == 0) {
                val kept: res[usize, A.Error] = vector.push[str](?g.references, obj.ok);
                if (sel kept.err) { ret err[str].err{MEMORY}; }
            }
            cnt;
        }
        var removed: vector.Vector[bool] = vector.init[bool](r.scratch);
        k = 0;
        for (k < pending.len) {
            val pushed: res[usize, A.Error] = vector.push[bool](?removed, false);
            if (sel pushed.err) { ret err[str].err{MEMORY}; }
            k = k + 1;
        }
        var any: bool = false;
        k = 0;
        for (k < said.ok.located.len) {
            val l: tool.Located = said.ok.located.data[k];
            if (l.line > opening) {
                val at: usize = ((l.line - opening - 1) / 2)::usize;
                if (at < pending.len && !removed.data[at]) {
                    removed.data[at]                        = true;
                    g.cases.data[pending.data[at]].tools[j] = refused(r, l.message);
                    any                                     = true;
                    if (pending.len > 1) {
                        var alone: vector.Vector[u32]  = vector.init[u32](r.a);
                        val one:   res[usize, A.Error] = vector.push[u32](?alone, pending.data[at]);
                        if (sel one.err) { ret err[str].err{MEMORY}; }
                        val again: res[usize, A.Error] = vector.push[vector.Vector[u32]](?batches, alone);
                        if (sel again.err) { ret err[str].err{MEMORY}; }
                    }
                }
            }
            k = k + 1;
        }
        if (any) {
            var rest: vector.Vector[u32] = vector.init[u32](r.a);
            k = 0;
            for (k < pending.len) {
                if (!removed.data[k]) {
                    val pushed: res[usize, A.Error] = vector.push[u32](?rest, pending.data[k]);
                    if (sel pushed.err) { ret err[str].err{MEMORY}; }
                }
                k = k + 1;
            }
            if (rest.len > 0) {
                val again: res[usize, A.Error] = vector.push[vector.Vector[u32]](?batches, rest);
                if (sel again.err) { ret err[str].err{MEMORY}; }
            }
            cnt;
        }
        if (pending.len > 1) {
            var low:  vector.Vector[u32] = vector.init[u32](r.a);
            var high: vector.Vector[u32] = vector.init[u32](r.a);
            val half: usize              = pending.len / 2;
            k = 0;
            for (k < pending.len) {
                var into: *vector.Vector[u32] = ?high;
                if (k < half) { into = ?low; }
                val pushed: res[usize, A.Error] = vector.push[u32](into, pending.data[k]);
                if (sel pushed.err) { ret err[str].err{MEMORY}; }
                k = k + 1;
            }
            val upper: res[usize, A.Error] = vector.push[vector.Vector[u32]](?batches, high);
            if (sel upper.err) { ret err[str].err{MEMORY}; }
            val lower: res[usize, A.Error] = vector.push[vector.Vector[u32]](?batches, low);
            if (sel lower.err) { ret err[str].err{MEMORY}; }
            cnt;
        }
        var why: Outcome = Outcome.refused{"it exited with a failure and named no line"};
        if (said.ok.general != nil) { why = refused(r, said.ok.general); }
        give_all(g, ?pending, j, why);
    }
    arena.reset(r.area);
    ret err[str].ok{};
}

# whether the reference object holds case `c`
fun in_reference(c: *Case) bool {
    ret sel c.tools[0].bytes && !c.dropped;
}

# how many vectors the reference object of `g` holds
fun listed_count(g: *Group) u32 {
    var count: u32   = 0;
    var i:     usize = 0;
    for (i < g.cases.len) {
        if (in_reference(?g.cases.data[i])) { count = count + 1; }
        i = i + 1;
    }
    ret count;
}

# the case of `g` the reference object holds `k`th, nil past its end
fun referenced(g: *Group, k: u32) *Case {
    var n: u32   = 0;
    var i: usize = 0;
    for (i < g.cases.len) {
        val c: *Case = ?g.cases.data[i];
        if (in_reference(c)) {
            if (n == k) { ret c; }
            n = n + 1;
        }
        i = i + 1;
    }
    ret nil;
}

# what the disassembler's standard error `err` says first, copied into the run's storage
fun first_said(r: *Run, err: str) str {
    val said: res[tool.Said, str] = tool.said(r.scratch, err, "");
    var why:  str                 = "it exited with a failure";
    if (sel said.ok) {
        if (said.ok.general != nil)  { why = said.ok.general; }
        if (said.ok.located.len > 0) { why = said.ok.located.data[0].message; }
    }
    val kept: opt[str] = copied(r.a, why);
    if (sel kept.none) { ret MEMORY; }
    ret kept.some;
}

# the disassembler's listing `out` of the reference object of `g` read back by its own reading, each printing given its
# case into `listed`, or why it cannot be
fun listed_by(r: *Run, job: *agreement.Job, g: *Group, out: str, listed: *vector.Vector[listing.Listed]) str {
    val count: u32                = listed_count(g);
    var i:     usize              = 0;
    var texts: vector.Vector[str] = vector.init[str](r.a);
    val read:  err[str]           = r.agreement.disassembler.listed(job, out, count, ?texts);
    if (sel read.err)              { ret read.err; }
    if (texts.len != count::usize) { ret "the disassembler's reading found another count of vectors than the object holds"; }
    var k: usize = 0;
    i = 0;
    for (i < g.cases.len) {
        if (in_reference(?g.cases.data[i])) {
            val pushed: res[usize, A.Error] = vector.push[listing.Listed](listed, listing.Listed{vector: i::u32, text: texts.data[k]});
            if (sel pushed.err) { ret MEMORY; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret nil;
}

# the one reference object of `g` a layout writes listed by the disassembler, read back by its own reading. a vector the
# disassembler refuses by its place is left out, and the reference file is written and listed again without it
fun by_listing(r: *Run, w: *Width, g: *Group) err[str] {
    val found:  *tool.Found                   = ?r.result.disassembler;
    val d:      *agreement.Disassembler       = ?r.agreement.disassembler;
    var why:    str                           = nil;
    var listed: vector.Vector[listing.Listed] = vector.init[listing.Listed](r.a);
    val base:   res[str, str]                 = stem(r, w, g, found.tool.name);
    if (sel base.err) { ret err[str].err{base.err}; }
    for (g.references.len > 0) {
        arena.reset(r.area);
        var job:  agreement.Job  = agreement.Job{variant: w.variant, format: w.format, selection: ?g.selection, source: nil, object: g.references.data[0], needs: needs_of(g)};
        var args: agreement.Args = agreement.Args{a: r.scratch, list: vector.init[str](r.scratch), failed: false};
        d.spell(?job, ?args);
        val ran: res[tool.Ran, str] = tool.run(r.scratch, found.path, ?args, r.result.options.work, base.ok);
        if (sel ran.err) {
            why = ran.err;
            brk;
        }
        if (ran.ok.ok) {
            why = listed_by(r, ?job, g, ran.ok.out, ?listed);
            brk;
        }
        why = "it exited with a failure";
        if (d.named == nil) { brk; }
        val named: opt[u32] = d.named(?job, ran.ok.err, listed_count(g));
        if (sel named.none) { brk; }
        val c: *Case = referenced(g, named.some);
        if (c == nil) { brk; }
        c.listed         = Printed.refused{first_said(r, ran.ok.err)};
        c.dropped        = true;
        g.references.len = 0;
        why              = nil;
        val again: err[str] = by_tool(r, w, g, 0);
        if (sel again.err) { ret again; }
    }
    if (why != nil) {
        val kept: opt[str] = copied(r.a, why);
        if (sel kept.none) { ret err[str].err{MEMORY}; }
        why = kept.some;
    }
    ret judged(r, w, g, why, ?listed);
}

# each reference object of `g` listed by the disassembler, and masc's printing of the reference bytes beside it
fun by_disassembler(r: *Run, w: *Width, g: *Group) err[str] {
    if (g.references.len == 0)                  { ret err[str].ok{}; }
    if (r.agreement.disassembler.listed != nil) { ret by_listing(r, w, g); }
    val found:  *tool.Found                   = ?r.result.disassembler;
    var why:    str                           = nil;
    var listed: vector.Vector[listing.Listed] = vector.init[listing.Listed](r.a);
    var o:      usize                         = 0;
    for (o < g.references.len) {
        var t:    text.Text     = text.make(r.a);
        val base: res[str, str] = stem(r, w, g, found.tool.name);
        if (sel base.err) { ret err[str].err{base.err}; }
        text.put(?t, base.ok);
        text.put(?t, "-");
        text.decimal(?t, o::i64);
        val named: opt[str] = text.copy(?t, r.a);
        if (sel named.none) { ret err[str].err{MEMORY}; }
        arena.reset(r.area);
        var job:  agreement.Job  = agreement.Job{variant: w.variant, format: w.format, selection: ?g.selection, source: nil, object: g.references.data[o], needs: needs_of(g)};
        var args: agreement.Args = agreement.Args{a: r.scratch, list: vector.init[str](r.scratch), failed: false};
        r.agreement.disassembler.spell(?job, ?args);
        val ran: res[tool.Ran, str] = tool.run(r.scratch, found.path, ?args, r.result.options.work, named.some);
        if (sel ran.err) {
            if (why == nil) { why = ran.err; }
        }
        if (sel ran.ok) {
            if (!ran.ok.ok) {
                if (why == nil) { why = "it exited with a failure"; }
            }
            or {
                val pointer: opt[mink_arch.Pointer] = w.variant.arch.pointer;
                if (sel pointer.none && why == nil) { why = "the architecture states no pointer width"; }
                if (sel pointer.some) {
                    val read: err[str] = listing.read(r.a, r.scratch, ran.ok.out, pointer.some.bytes, r.agreement.disassembler.comment, r.agreement.disassembler.target, r.agreement.disassembler.immediate, r.agreement.set.syntaxes.at[r.agreement.syntax].prefixes, ?listed);
                    if (sel read.err) {
                        if (why == nil) { why = read.err; }
                    }
                }
            }
        }
        if (why != nil) {
            val kept: opt[str] = copied(r.a, why);
            if (sel kept.none) { ret err[str].err{MEMORY}; }
            why = kept.some;
        }
        o = o + 1;
    }
    ret judged(r, w, g, why, ?listed);
}

# the listing of `g`'s vectors given each, every other vector the reference holds refused with `why`, or as one the
# listing holds no section of, and masc's printing of the reference bytes beside it
fun judged(r: *Run, w: *Width, g: *Group, why: str, listed: *vector.Vector[listing.Listed]) err[str] {
    var address: u8                     = 8;
    val pointer: opt[mink_arch.Pointer] = w.variant.arch.pointer;
    if (sel pointer.some) { address = pointer.some.bytes; }
    var unlisted: str = "the listing holds no section of it";
    if (why != nil) { unlisted = why; }
    var i: usize = 0;
    for (i < g.cases.len) {
        val c: *Case = ?g.cases.data[i];
        if (in_reference(c)) { c.listed = Printed.refused{unlisted}; }
        i = i + 1;
    }
    i = 0;
    for (i < listed.len) {
        val n: u32 = listed.data[i].vector;
        if (n::usize < g.cases.len) { g.cases.data[n].listed = Printed.text{listed.data[i].text}; }
        i = i + 1;
    }
    i = 0;
    for (i < g.cases.len) {
        val c: *Case = ?g.cases.data[i];
        if ((c.held & agreement.DECODE) == 0) {
            i = i + 1;
            cnt;
        }
        if (sel c.tools[0].bytes) {
            arena.reset(r.area);
            c.decoded = decode(r, g, c.tools[0].bytes.bytes, true, false, address, ?c.read);
            if (sel c.decoded.text) {
                if (sel c.listed.text) {
                    var printed: str = c.decoded.text;
                    var listed:  str = c.listed.text;
                    if (r.agreement.disassembler.unmarked) {
                        printed = unmarked(r.agreement.set.codec, printed);
                        listed  = unmarked(r.agreement.set.codec, listed);
                    }
                    val mine:   opt[str] = listing.normal(r.scratch, printed);
                    val theirs: opt[str] = listing.normal(r.scratch, listed);
                    if (sel mine.none)   { ret err[str].err{MEMORY}; }
                    if (sel theirs.none) { ret err[str].err{MEMORY}; }
                    c.agrees = str_equals(mine.some, theirs.some);
                }
            }
        }
        i = i + 1;
    }
    arena.reset(r.area);
    ret err[str].ok{};
}

# `text` past the markers of a form it opens with, as x86's `{evex} vaddps` past its `{evex}`
fun unmarked(codec: *dispatch.Codec, text: str) str {
    var at:    usize = 0;
    var moved: bool  = true;
    for (moved) {
        moved = false;
        for (text[at] == ' ' || text[at] == '\t') { at = at + 1; }
        var i: u32 = 0;
        for (i < codec.forms.len && !moved) {
            val f: *form.FormField = ?codec.forms.at[i];
            if (f.marker != nil && !f.suffix && opens(text, at, f.marker)) {
                at    = at + str_len(f.marker);
                moved = true;
            }
            i = i + 1;
        }
    }
    ret ?text[at];
}

# whether `text` holds the word `word` at `at`, a blank after it
fun opens(text: str, at: usize, word: str) bool {
    var k: usize = 0;
    for (word[k] != 0) {
        if (text[at + k] != word[k]) { ret false; }
        k = k + 1;
    }
    ret k > 0 && (text[at + k] == ' ' || text[at + k] == '\t');
}

# the group of `w` whose selection spells as `s` does, its stated atoms after its extensions, made when there is none,
# `s` given back when there is. a set's spelling names extensions alone, so the atoms keep apart the selections that
# differ only in state, as aarch64's rows of streaming mode from those outside it
fun group_of(r: *Run, w: *Width, groups: *map.Map[str, u32], s: extension.Selection) res[*Group, str] {
    var held:    extension.Selection = s;
    var spelled: vector.Vector[u8]   = vector.init[u8](r.a);
    var wrote:   err[A.Error]        = held.catalog.syntax.spell(?held, ?spelled);
    var k:       u32                 = 0;
    for (!(sel wrote.err) && k < held.stated.len) {
        wrote = extension.append(?spelled, "+");
        if (!(sel wrote.err)) { wrote = state.spell_atom(held.catalog, ?r.agreement.set.states, held.stated.at[k], ?spelled); }
        k = k + 1;
    }
    if (sel wrote.err) { ret res[*Group, str].err{MEMORY}; }
    val key: opt[str] = owned(r.a, ?spelled);
    if (sel key.none) { ret res[*Group, str].err{MEMORY}; }
    val known: opt[*u32] = map.get[str, u32](groups, ?key.some);
    if (sel known.some) {
        extension.release(?held);
        ret res[*Group, str].ok{w.groups.data[@known.some]};
    }
    val got: res[*Group, A.Error] = A.allocate[Group](r.a, 1);
    if (sel got.err) { ret res[*Group, str].err{MEMORY}; }
    val g: *Group = got.ok;
    g.number     = w.groups.len::u32;
    g.selection  = held;
    g.spelled    = key.some;
    g.cases      = vector.init[Case](r.a);
    g.references = vector.init[str](r.a);
    g.needs      = vector.init[vectors.Need](r.a);
    val arch: opt[*set.Arch] = set.arch_of(r.agreement.set, w.variant.arch);
    if (sel arch.none) { ret res[*Group, str].err{UNSERVED}; }
    val opened: res[state.Context, state.Opened] = set.open(r.a, r.agreement.set, arch.some, ?g.selection, ?g.available);
    if (sel opened.err) { ret res[*Group, str].err{MEMORY}; }
    g.context = opened.ok;
    # the group's vectors read under one stream, which holds what they need before any of them
    val h: *stream.Hooks = r.agreement.set.codec.stream;
    if (h != nil) {
        val made: res[ptr, A.Error] = h.make(r.a);
        if (sel made.err) { ret res[*Group, str].err{MEMORY}; }
        h.begin(made.ok);
        g.context.stream = made.ok;
    }
    val pushed: res[usize, A.Error] = vector.push[*Group](?w.groups, g);
    if (sel pushed.err) { ret res[*Group, str].err{MEMORY}; }
    val inserted: res[bool, A.Error] = map.insert[str, u32](groups, key.some, g.number);
    if (sel inserted.err) { ret res[*Group, str].err{MEMORY}; }
    ret res[*Group, str].ok{g};
}

# the key the exception table indexes exception `e` by: its variant's name, its tool and its text, each after a
# vertical tab, then a row's key, a spelling's row key and template apart by a tab, or a statement's text after a
# line feed, so no two share one. none when the allocator refuses
fun subject_key(a: *A.Allocator, e: *agreement.Exception) opt[str] {
    val subject: agreement.Subject = e.subject;
    var t:       text.Text         = text.make(a);
    if (!blank(e.variant)) { text.put(?t, e.variant); }
    text.byte(?t, 0x0b);
    if (!blank(e.tool)) { text.put(?t, e.tool); }
    text.byte(?t, 0x0b);
    if (!blank(e.text)) { text.put(?t, e.text); }
    text.byte(?t, 0x0b);
    if (sel subject.row) { text.put(?t, subject.row); }
    if (sel subject.spelling) {
        text.put(?t, subject.spelling.row);
        text.byte(?t, '\t');
        text.put(?t, subject.spelling.template);
    }
    if (sel subject.statement) {
        text.byte(?t, '\n');
        text.put(?t, subject.statement);
    }
    if (sel subject.rows) {
        text.byte(?t, 0x01);
        text.put(?t, subject.rows);
    }
    if (sel subject.extension) {
        text.byte(?t, 0x02);
        text.put(?t, subject.extension);
    }
    ret text.copy(?t, a);
}

# whether `key` matches `pattern`, whose `*` matches any run of characters
fun globbed(pattern: str, key: str) bool {
    if (pattern[0] == 0) { ret key[0] == 0; }
    if (pattern[0] == '*') {
        var k: usize = 0;
        for {
            if (globbed(?pattern[1], ?key[k])) { ret true; }
            if (key[k] == 0)                   { ret false; }
            k = k + 1;
        }
    }
    if (key[0] != pattern[0]) { ret false; }
    ret globbed(?pattern[1], ?key[1]);
}

# whether exception `e` is of a pattern or an extension, a family of rows
fun broad(e: *agreement.Exception) bool {
    ret sel e.subject.rows || sel e.subject.extension;
}

# whether row `r` needs every extension of `ids`: every alternative of its requirement holds each
fun needs(r: *row.Row, ids: requirement.Ids) bool {
    if (r.requires.len == 0 || ids.len == 0) { ret false; }
    var a: u32 = 0;
    for (a < r.requires.len) {
        val all: requirement.Ids = r.requires.at[a].all;
        var i:   u32             = 0;
        for (i < ids.len) {
            var held: bool = false;
            var k:    u32  = 0;
            for (k < all.len) {
                if (all.at[k] == ids.at[i]) { held = true; }
                k = k + 1;
            }
            if (!held) { ret false; }
            i = i + 1;
        }
        a = a + 1;
    }
    ret true;
}

# the subject of verdict `v`
fun subject_of(v: *Verdict) agreement.Subject {
    if (sel v.of.alias)     { ret agreement.Subject.spelling{agreement.Spelling{row: v.row.key, template: v.of.alias.template}}; }
    if (sel v.of.statement) { ret agreement.Subject.statement{v.of.statement.text}; }
    ret agreement.Subject.row{v.row.key};
}

# whether `s` states nothing, as an exception's tool or text left out
fun blank(s: str) bool {
    ret s == nil || s[0] == 0;
}

# whether `x` and `y` state the same, each blank the same as any other
fun alike_spelled(x: str, y: str) bool {
    if (blank(x)) { ret blank(y); }
    ret !blank(y) && str_equals(x, y);
}

# whether exceptions `x` and `y` are of one tool and text, so one is taken over the other
fun scoped_alike(x: *agreement.Exception, y: *agreement.Exception) bool {
    ret alike_spelled(x.tool, y.tool) && alike_spelled(x.text, y.text);
}

# how exception `e` names `subject`, of row `row_`, at the width named `width`: 0 by its own subject at the width, 1
# at every width, 2 by a pattern at the width, 3 by an extension at the width, 4 and 5 by those at every width. none
# when it does not
fun rank_of(run: *Run, at: u32, subject: agreement.Subject, row_: *row.Row, width: str) opt[u32] {
    val e:     *agreement.Exception = ?run.agreement.exceptions.at[at];
    val every: bool                 = blank(e.variant);
    if (!every && !str_equals(e.variant, width)) { ret opt[u32].none{}; }
    var later: u32 = 0;
    if (every) { later = 1; }
    if (sel e.subject.row) {
        if (sel subject.row) {
            if (str_equals(e.subject.row, subject.row)) { ret opt[u32].some{later}; }
        }
        ret opt[u32].none{};
    }
    if (sel e.subject.spelling) {
        if (sel subject.spelling) {
            val x: agreement.Spelling = e.subject.spelling;
            val y: agreement.Spelling = subject.spelling;
            if (str_equals(x.row, y.row) && str_equals(x.template, y.template)) { ret opt[u32].some{later}; }
        }
        ret opt[u32].none{};
    }
    if (sel e.subject.statement) {
        if (sel subject.statement) {
            if (str_equals(e.subject.statement, subject.statement)) { ret opt[u32].some{later}; }
        }
        ret opt[u32].none{};
    }
    if (row_ == nil) { ret opt[u32].none{}; }
    if (sel e.subject.rows) {
        if (globbed(e.subject.rows, row_.key)) { ret opt[u32].some{2 + later * 2}; }
        ret opt[u32].none{};
    }
    if (sel e.subject.extension) {
        if (needs(row_, run.needs.data[at])) { ret opt[u32].some{3 + later * 2}; }
    }
    ret opt[u32].none{};
}

# the exceptions of the table that name `subject`, of row `row_`, nil for a statement, at the width named `width` and
# apply under `s`, put in `out`: of each tool and text, the one its rank takes. refused when the allocator refuses
fun exceptions_of(run: *Run, subject: agreement.Subject, row_: *row.Row, width: str, s: *extension.Selection, out: *vector.Vector[*agreement.Exception]) err[str] {
    out.len = 0;
    val ex:    agreement.Exceptions = run.agreement.exceptions;
    var ranks: [64]u32;
    var i:     u32                  = 0;
    for (i < ex.len) {
        val rank: opt[u32] = rank_of(run, i, subject, row_, width);
        i = i + 1;
        if (sel rank.none) { cnt; }
        val e: *agreement.Exception = applying(run, i - 1, s);
        if (e == nil) { cnt; }
        var k:     usize = 0;
        var found: bool  = false;
        for (k < out.len && !found) {
            if (scoped_alike(out.data[k], e)) {
                found = true;
                if (rank.some < ranks[k]) {
                    out.data[k] = e;
                    ranks[k]    = rank.some;
                }
            }
            k = k + 1;
        }
        if (found)         { cnt; }
        if (out.len >= 64) { ret err[str].err{"more than 64 exceptions name one subject"}; }
        ranks[out.len] = rank.some;
        val pushed: res[usize, A.Error] = vector.push[*agreement.Exception](out, e);
        if (sel pushed.err) { ret err[str].err{MEMORY}; }
    }
    ret err[str].ok{};
}

# whether exception `e` names vector `c` and excuses `check` of the tool named `name`, nil for one no tool makes
fun covers(e: *agreement.Exception, c: *Case, check: agreement.Checks, name: str) bool {
    if ((e.checks & check) == 0)                                      { ret false; }
    if (!blank(e.tool) && (name == nil || !str_equals(e.tool, name))) { ret false; }
    if (blank(e.text))                                                { ret true; }
    ret c.text != nil && globbed(e.text, c.text);
}

# the index in `list` of the first exception that covers `check` of the tool named `name` for vector `c`, none for none
fun covering(list: *vector.Vector[*agreement.Exception], c: *Case, check: agreement.Checks, name: str) opt[usize] {
    var k: usize = 0;
    for (k < list.len) {
        if (covers(list.data[k], c, check, name)) { ret opt[usize].some{k}; }
        k = k + 1;
    }
    ret opt[usize].none{};
}

# whether assembler `j` fails vector `c`'s bytes check: it gives bytes masc did not, or refuses or gives other bytes
# than masc's
fun tool_fails(c: *Case, j: usize) bool {
    val o: *Outcome = ?c.tools[j];
    if (!sel c.masc.bytes) {
        if (sel c.masc.refused) { ret sel o.bytes; }
        ret true;
    }
    if (sel o.refused) { ret true; }
    ret sel o.bytes && !alike(o.bytes, c.masc.bytes);
}

# the checks vector `c` owes that `list` does not excuse, each exception of it that excuses one set in `mask` by its
# index: bytes where one excuses it for each assembler that fails it, decode for the disassembler, trip for no tool
fun unexcused(result: *Result, c: *Case, list: *vector.Vector[*agreement.Exception], mask: *u64) agreement.Checks {
    var out: agreement.Checks = owed(result, c);
    if ((out & agreement.BYTES) != 0) {
        var marks: u64   = 0;
        var whole: bool  = true;
        var j:     usize = 0;
        for (j < result.assemblers.len) {
            if (tool_fails(c, j)) {
                val by: opt[usize] = covering(list, c, agreement.BYTES, result.assemblers.data[j].tool.name);
                if (sel by.some) { marks = marks | (1::u64 << by.some::u64); }
                or               { whole = false; }
            }
            j = j + 1;
        }
        if (whole && marks != 0) {
            out   = out & ~agreement.BYTES;
            @mask = @mask | marks;
        }
    }
    if ((out & agreement.DECODE) != 0) {
        val by: opt[usize] = covering(list, c, agreement.DECODE, result.disassembler.tool.name);
        if (sel by.some) {
            out   = out & ~agreement.DECODE;
            @mask = @mask | (1::u64 << by.some::u64);
        }
    }
    if ((out & agreement.TRIP) != 0) {
        val by: opt[usize] = covering(list, c, agreement.TRIP, nil);
        if (sel by.some) {
            out   = out & ~agreement.TRIP;
            @mask = @mask | (1::u64 << by.some::u64);
        }
    }
    ret out;
}

# exception `e` marked as having excused a row
fun used(r: *Run, e: *agreement.Exception) {
    val ex: agreement.Exceptions = r.agreement.exceptions;
    var i:  u32                  = 0;
    for (i < ex.len) {
        if (?ex.at[i] == e) { r.used.data[i] = true; }
        i = i + 1;
    }
}

# exception `at` of the table when it applies under `s`: `s` holds every extension it applies with and lacks one it
# is scoped to, when it is scoped to any. nil otherwise
fun applying(run: *Run, at: u32, s: *extension.Selection) *agreement.Exception {
    val with: requirement.Ids = run.withs.data[at];
    var w:    u32             = 0;
    for (w < with.len) {
        if (!extension.has(s, with.at[w])) { ret nil; }
        w = w + 1;
    }
    val scope: requirement.Ids = run.scopes.data[at];
    if (scope.len == 0) { ret ?run.agreement.exceptions.at[at]; }
    var i: u32 = 0;
    for (i < scope.len) {
        if (!extension.has(s, scope.at[i])) { ret ?run.agreement.exceptions.at[at]; }
        i = i + 1;
    }
    ret nil;
}

# the stream of every group of `w` given back
fun release_streams(r: *Run, w: *Width) {
    val h: *stream.Hooks = r.agreement.set.codec.stream;
    if (h == nil) { ret; }
    var k: usize = 0;
    for (k < w.groups.len) {
        val g: *Group = w.groups.data[k];
        if (g.context.stream != nil) {
            h.release(r.a, g.context.stream);
            g.context.stream = nil;
        }
        k = k + 1;
    }
}

# the cases of `found` appended to `g`, held to `held`, written by `alias` with the values `spelled` gives, at the same
# place, or by their rows' own forms when `alias` is nil
fun cases_of(r: *Run, g: *Group, found: *vector.Vector[inst.Inst], held: agreement.Checks, alias: *core_syntax.Alias, spelled: *vector.Vector[inst.Inst]) err[str] {
    var k: usize = 0;
    for (k < found.len) {
        var own: *operand.Value = nil;
        if (alias != nil) { own = spelled.data[k].values; }
        val pushed: err[str] = case_of(r, g, Case{inst: found.data[k], held: held, alias: alias, spelled: own, text: nil, tool: nil, masc: Outcome.none{}, tools: nil, decoded: Printed.none{}, read: nil, listed: Printed.none{}, agrees: false, printed: Printed.none{}, trip: Outcome.none{}, lent: nil});
        if (sel pushed.err) { ret pushed; }
        k = k + 1;
    }
    ret err[str].ok{};
}

# `c` appended to `g` with no outcome from any assembler yet
fun case_of(r: *Run, g: *Group, c: Case) err[str] {
    val tools: res[*Outcome, A.Error] = A.allocate[Outcome](r.a, r.agreement.assemblers.len::usize);
    if (sel tools.err) { ret err[str].err{MEMORY}; }
    var j: u32 = 0;
    for (j < r.agreement.assemblers.len) {
        tools.ok[j] = Outcome.none{};
        j           = j + 1;
    }
    var held: Case = c;
    held.tools = tools.ok;
    if (r.agreement.stream != nil && held.inst.row != nil) { r.agreement.stream.place(?held.inst, g.cases.len::u32); }
    val pushed: res[usize, A.Error] = vector.push[Case](?g.cases, held);
    if (sel pushed.err) { ret err[str].err{MEMORY}; }
    ret err[str].ok{};
}

# generation `gen` of group `g` given the agreement's edges, and the group's needs and the stream's provider when the
# set's vectors are read through a typed stream
fun generating(r: *Run, g: *Group, gen: *vectors.Generation) {
    gen.chooses = r.agreement.edges;
    if (r.agreement.stream != nil) {
        gen.needs   = ?g.needs;
        gen.provide = r.agreement.stream.provide;
    }
}

# a verdict of `r_` of `of` with no vectors yet
fun verdict(r_: *row.Row, of: Spelled) Verdict {
    ret Verdict{row: r_, of: of, group: nil, first: 0, count: 0, state: AGREE};
}

# a verdict's vectors placed: the cases from `first` of `g`, and the exceptions of its subject
fun placed(r: *Run, w: *Width, v: *Verdict, g: *Group, first: usize) err[str] {
    v.group      = g;
    v.first      = first::u32;
    v.count      = (g.cases.len - first)::u32;
    v.exceptions = vector.init[*agreement.Exception](r.a);
    if (v.count == 0) { v.state = UNVECTORED; }
    ret exceptions_of(r, subject_of(v), v.row, w.name, ?g.selection, ?v.exceptions);
}

# the verdicts of each alias of row `r_`, the row at `index` among the codec's rows, its group `g` admits, vectored
# over the alias's own operands, appended to `w`
fun aliases_of(r: *Run, w: *Width, g: *Group, r_: *row.Row, index: u32) err[str] {
    val codec:   *dispatch.Codec          = r.agreement.set.codec;
    val syn:     *core_syntax.Syntax      = ?r.agreement.set.syntaxes.at[r.agreement.syntax];
    var found:   vector.Vector[inst.Inst] = vector.init[inst.Inst](r.a);
    var spelled: vector.Vector[inst.Inst] = vector.init[inst.Inst](r.a);
    var a:       u32                      = print.first_alias(syn, index);
    for (a < syn.aliases.len && syn.aliases.at[a].row == index) {
        val al: *core_syntax.Alias = ?syn.aliases.at[a];
        a = a + 1;
        if (!state.admits(?g.context, al.requires)) { cnt; }
        var v: Verdict = verdict(r_, Spelled.alias{al});
        found.len   = 0;
        spelled.len = 0;
        var gen: vectors.Generation = vectors.make_alias(r.a, codec, ?g.context, r_, al, ?found, ?spelled);
        generating(r, g, ?gen);
        vectors.generate(?gen, r.agreement.hook);
        vectors.release(?gen);
        if (gen.failed && gen.why != nil) { ret err[str].err{gen.why}; }
        if (gen.failed)                   { ret err[str].err{MEMORY}; }
        val first: usize    = g.cases.len;
        val made:  err[str] = cases_of(r, g, ?found, agreement.BYTES | agreement.DECODE | agreement.TRIP, al, ?spelled);
        if (sel made.err) { ret made; }
        val put_at: err[str] = placed(r, w, ?v, g, first);
        if (sel put_at.err) { ret put_at; }
        val pushed: res[usize, A.Error] = vector.push[Verdict](?w.verdicts, v);
        if (sel pushed.err) { ret err[str].err{MEMORY}; }
    }
    ret err[str].ok{};
}

# the verdicts of the agreement's statements at `w`, each a case of its own under the variant's base and what the
# statements require, appended to `w`
fun statements_of(r: *Run, w: *Width, groups: *map.Map[str, u32]) err[str] {
    val all: agreement.Statements = r.agreement.statements;
    if (all.len == 0) { ret err[str].ok{}; }
    val chosen: res[opt[extension.Selection], str] = attempt(r, w.variant, requirement.Alternative{all: all.requires, none: requirement.NO_IDS});
    if (sel chosen.err) { ret err[str].err{chosen.err}; }
    var g: *Group = nil;
    if (sel chosen.ok.some) {
        val got: res[*Group, str] = group_of(r, w, groups, chosen.ok.some);
        if (sel got.err) { ret err[str].err{got.err}; }
        g = got.ok;
    }
    var i: u32 = 0;
    for (i < all.len) {
        val st: *agreement.Statement = ?all.at[i];
        var v:  Verdict              = verdict(nil, Spelled.statement{st});
        i = i + 1;
        # a statement in a group is absent from a format the framework spells no group of
        if (g == nil || (st.group != nil && grouped_flags(r, w.format, st.group) == nil)) { v.state = ABSENT; }
        or {
            val first: usize    = g.cases.len;
            val made:  err[str] = case_of(r, g, Case{inst: inst.Inst{row: nil, values: nil, count: 0}, held: agreement.BYTES, alias: nil, spelled: nil, text: st.text, tool: st.text, masc: Outcome.none{}, tools: nil, decoded: Printed.none{}, read: nil, listed: Printed.none{}, agrees: false, printed: Printed.none{}, trip: Outcome.none{}, lent: nil, group: st.group});
            if (sel made.err) { ret made; }
            val put_at: err[str] = placed(r, w, ?v, g, first);
            if (sel put_at.err) { ret put_at; }
        }
        val pushed: res[usize, A.Error] = vector.push[Verdict](?w.verdicts, v);
        if (sel pushed.err) { ret err[str].err{MEMORY}; }
    }
    ret err[str].ok{};
}

# the flags of a vector's code section after its name, as the assemblers of `format` read them, nil for a format the
# framework spells none of
fun section_flags(format: *mink_format.Format) str {
    if (format == ?mink_format.ELF)  { ret ",\"ax\",@progbits"; }
    if (format == ?mink_format.COFF) { ret ",\"ax\""; }
    ret nil;
}

# the flags of a vector's code section in the comdat group of signature `group` after its name, as the assemblers of
# `format` read them, in the run's storage, nil for a format the framework spells no group of. coff's comdat sections
# are signed by a symbol the section defines, which a statement's group is not
fun grouped_flags(r: *Run, format: *mink_format.Format, group: str) str {
    if (format != ?mink_format.ELF) { ret nil; }
    val got: res[str, str] = joined(r, ",\"axG\",@progbits,", group, ",comdat");
    if (sel got.err) { ret nil; }
    ret got.ok;
}

# `variant`'s name, and the name of `format` after it when it is not the agreement's own, in the run's storage
fun width_name(r: *Run, variant: *agreement.Variant, format: *mink_format.Format) res[str, str] {
    if (format == r.agreement.format) { ret res[str, str].ok{variant.name}; }
    ret joined(r, variant.name, "-", format.name);
}

# every row of the set at `variant` in `format`, with every alias of it, and every statement, generated, assembled,
# decoded and judged, or the statements alone in a further format
fun width(r: *Run, variant: *agreement.Variant, format: *mink_format.Format) err[str] {
    val spoken: opt[*dialect.Dialect] = dialect.of(format, variant.arch);
    if (sel spoken.none) { ret err[str].err{"masc states no assembly dialect of an agreement's format for a variant's architecture"}; }
    val name: res[str, str] = width_name(r, variant, format);
    if (sel name.err) { ret err[str].err{name.err}; }
    val written: res[str, str] = joined(r, r.result.options.work, "/", name.ok);
    if (sel written.err) { ret err[str].err{written.err}; }
    val file: res[str, str] = joined(r, written.ok, "-masc.o", "");
    if (sel file.err) { ret err[str].err{file.err}; }
    var w: Width = Width{variant: variant, format: format, name: name.ok, dialect: spoken.some, written: file.ok, groups: vector.init[*Group](r.a), verdicts: vector.init[Verdict](r.a)};
    fin { release_streams(r, ?w); }
    var groups: map.Map[str, u32]        = map.init[str, u32](r.a);
    var found:  vector.Vector[inst.Inst] = vector.init[inst.Inst](r.a);
    val codec:  *dispatch.Codec          = r.agreement.set.codec;
    var i:      u32                      = 0;
    # a further format's statements alone are checked, the rows' bytes being the same in every format
    if (format != r.agreement.format) { i = codec.rows.len; }
    for (i < codec.rows.len) {
        val r_: *row.Row = ?codec.rows.at[i];
        var v:  Verdict  = verdict(r_, Spelled.own{});
        var g:  *Group   = nil;
        if ((r_.flags & row.DECODE_ONLY) != 0) { v.state = DECODE_ONLY; }
        # a marker is a symbol, which a byte vector holds no spelling of
        or (row.marked(r_)) { v.state = MARKED; }
        or {
            val chosen: res[opt[extension.Selection], str] = choose(r, variant, r_);
            if (sel chosen.err) { ret err[str].err{chosen.err}; }
            val picked: opt[extension.Selection] = chosen.ok;
            if (sel picked.some) {
                val got: res[*Group, str] = group_of(r, ?w, ?groups, picked.some);
                if (sel got.err) { ret err[str].err{got.err}; }
                g         = got.ok;
                found.len = 0;
                var gen: vectors.Generation = vectors.make(r.a, codec, ?g.context, r_, ?found);
                generating(r, g, ?gen);
                vectors.generate(?gen, r.agreement.hook);
                vectors.release(?gen);
                if (gen.failed && gen.why != nil) { ret err[str].err{gen.why}; }
                if (gen.failed)                   { ret err[str].err{MEMORY}; }
                val first: usize    = g.cases.len;
                val made:  err[str] = cases_of(r, g, ?found, agreement.BYTES | agreement.DECODE | agreement.TRIP, nil, nil);
                if (sel made.err) { ret made; }
                val put_at: err[str] = placed(r, ?w, ?v, g, first);
                if (sel put_at.err) { ret put_at; }
            }
            or { v.state = ABSENT; }
        }
        val pushed: res[usize, A.Error] = vector.push[Verdict](?w.verdicts, v);
        if (sel pushed.err) { ret err[str].err{MEMORY}; }
        if (g != nil) {
            val spelled: err[str] = aliases_of(r, ?w, g, r_, i);
            if (sel spelled.err) { ret spelled; }
        }
        i = i + 1;
    }
    val stated: err[str] = statements_of(r, ?w, ?groups);
    if (sel stated.err) { ret stated; }
    var k: usize = 0;
    for (k < w.groups.len) {
        val g:      *Group   = w.groups.data[k];
        val masced: err[str] = by_masc(r, ?w, g);
        if (sel masced.err) { ret masced; }
        var j: usize = 0;
        for (j < r.result.assemblers.len) {
            if (tool.usable(?r.result.assemblers.data[j])) {
                val ran: err[str] = by_tool(r, ?w, g, j);
                if (sel ran.err) { ret ran; }
            }
            j = j + 1;
        }
        val listed: err[str] = by_disassembler(r, ?w, g);
        if (sel listed.err) { ret listed; }
        k = k + 1;
    }
    var read: vector.Vector[*agreement.Exception] = vector.init[*agreement.Exception](r.a);
    k = 0;
    for (k < w.verdicts.len) {
        val v: *Verdict = ?w.verdicts.data[k];
        if (v.group != nil && v.count > 0) {
            var left: agreement.Checks = 0;
            var mask: u64              = 0;
            var lent: bool             = false;
            var c:    u32              = 0;
            for (c < v.count) {
                val one: *Case = ?v.group.cases.data[v.first + c];
                if (one.read != nil && one.read != v.row && (failed(r.result, one) & agreement.DECODE) != 0) {
                    val of_read: err[str] = exceptions_of(r, agreement.Subject.row{one.read.key}, one.read, w.name, ?v.group.selection, ?read);
                    if (sel of_read.err) { ret of_read; }
                    val by: opt[usize] = covering(?read, one, agreement.DECODE, r.result.disassembler.tool.name);
                    if (sel by.some) {
                        one.lent = read.data[by.some];
                        lent     = true;
                        used(r, one.lent);
                    }
                }
                left = left | unexcused(r.result, one, ?v.exceptions, ?mask);
                c    = c + 1;
            }
            var stale: bool  = false;
            var e:     usize = 0;
            for (e < v.exceptions.len) {
                val ex: *agreement.Exception = v.exceptions.data[e];
                if (((mask >> e::u64) & 1) != 0) { used(r, ex); }
                or (!broad(ex))                  { stale = true; }
                e = e + 1;
            }
            if (left != 0) { v.state = DISAGREE; }
            or (stale)     { v.state = STALE; }
            or (mask != 0) { v.state = EXCEPTED; }
            or (lent)      { v.state = EXCEPTED; }
        }
        if (failing(v.state)) { r.result.failures = r.result.failures + 1; }
        k = k + 1;
    }
    val pushed: res[usize, A.Error] = vector.push[Width](?r.result.widths, w);
    if (sel pushed.err) { ret err[str].err{MEMORY}; }
    ret err[str].ok{};
}

# `tool` found, refused unless it is installed at its pin when `required`
fun locate(r: *Run, t: *agreement.Tool, required: bool) res[tool.Found, str] {
    val found: res[tool.Found, str] = tool.find(r.a, t, r.result.options.work);
    if (sel found.err)                       { ret found; }
    if (!required || tool.usable(?found.ok)) { ret found; }
    var m: text.Text = text.make(r.a);
    text.put(?m, t.name);
    if (found.ok.path == nil) { text.put(?m, " is not installed, and it is required"); }
    or {
        text.put(?m, " is ");
        text.put(?m, found.ok.version);
        text.put(?m, ", not its pin ");
        text.put(?m, t.pin);
    }
    val message: opt[str] = text.copy(?m, r.a);
    if (sel message.none) { ret res[tool.Found, str].err{MEMORY}; }
    ret res[tool.Found, str].err{message.some};
}

# the extensions of `catalog` that `unless` names, comma separated, none when it is empty
# ---
# ret: the extensions, or why not, as a name that is no extension of the catalog
fun scope_of(r: *Run, catalog: *extension.Catalog, unless: str) res[requirement.Ids, str] {
    val len: usize = str_len(unless);
    if (len == 0) { ret res[requirement.Ids, str].ok{requirement.Ids{at: nil, len: 0}}; }
    var count: u32   = 1;
    var i:     usize = 0;
    for (i < len) {
        if (unless[i] == ',') { count = count + 1; }
        i = i + 1;
    }
    val ids: res[*requirement.Id, A.Error] = A.allocate[requirement.Id](r.a, count::usize);
    if (sel ids.err) { ret res[requirement.Ids, str].err{MEMORY}; }
    var n:     u32   = 0;
    var start: usize = 0;
    i = 0;
    for (i <= len) {
        if (i == len || unless[i] == ',') {
            val id: opt[requirement.Id] = extension.lookup(catalog, unless, start, i - start);
            if (sel id.none) { ret res[requirement.Ids, str].err{"an exception's scope names no extension of the set"}; }
            ids.ok[n] = id.some;
            n         = n + 1;
            start     = i + 1;
        }
        i = i + 1;
    }
    ret res[requirement.Ids, str].ok{requirement.Ids{at: ids.ok, len: count}};
}

# whether `name` is empty, for every width, or names a width of the agreement: a variant, of its own format, or a
# variant of a further format by its name and the format's, as the report names it
fun width_named(r: *Run, name: str) res[bool, str] {
    if (str_len(name) == 0) { ret res[bool, str].ok{true}; }
    var v: u32 = 0;
    for (v < r.agreement.variants.len) {
        if (str_equals(r.agreement.variants.at[v].name, name)) { ret res[bool, str].ok{true}; }
        v = v + 1;
    }
    var f: u32 = 0;
    for (f < r.agreement.further.len) {
        val fu: *agreement.Further = ?r.agreement.further.at[f];
        v = 0;
        for (v < fu.variants.len) {
            val n: res[str, str] = width_name(r, ?fu.variants.at[v], fu.format);
            if (sel n.err)              { ret res[bool, str].err{n.err}; }
            if (str_equals(n.ok, name)) { ret res[bool, str].ok{true}; }
            v = v + 1;
        }
        f = f + 1;
    }
    ret res[bool, str].ok{false};
}

# the exception table checked and indexed by row: each names a row of the set, once, at a variant it has or every one,
# excuses one or more checks, and is scoped to extensions of the set or to none
fun index_exceptions(r: *Run) err[str] {
    var stated: map.Map[str, u32]    = map.init[str, u32](r.a);
    val all:    agreement.Statements = r.agreement.statements;
    var k:      u32                  = 0;
    for (k < all.len) {
        if (map.contains[str, u32](?stated, ?all.at[k].text)) { ret err[str].err{"the agreement states a line twice"}; }
        val put: res[bool, A.Error] = map.insert[str, u32](?stated, all.at[k].text, k);
        if (sel put.err) { ret err[str].err{MEMORY}; }
        k = k + 1;
    }
    val ex: agreement.Exceptions = r.agreement.exceptions;
    var i:  u32                  = 0;
    for (i < ex.len) {
        val e:     *agreement.Exception = ?ex.at[i];
        val known: err[str]             = subject_known(r, e.subject, ?stated);
        if (sel known.err) { ret known; }
        val named: res[bool, str] = width_named(r, e.variant);
        if (sel named.err)                                                                             { ret err[str].err{named.err}; }
        if (!named.ok)                                                                                 { ret err[str].err{"an exception names no variant of the agreement, nor one in a further format"}; }
        if (e.checks == 0 || (e.checks & ~(agreement.BYTES | agreement.DECODE | agreement.TRIP)) != 0) { ret err[str].err{"an exception excuses no check, or one there is not"}; }
        if (sel e.subject.statement && e.checks != agreement.BYTES)                                    { ret err[str].err{"an exception of a statement excuses a check other than bytes, which a statement is not held to"}; }
        val tooled: err[str] = tool_known(r, e);
        if (sel tooled.err) { ret tooled; }
        val key: opt[str] = subject_key(r.a, e);
        if (sel key.none)                                     { ret err[str].err{MEMORY}; }
        if (map.contains[str, u32](?r.exceptions, ?key.some)) { ret err[str].err{"an exception names a row, spelling or statement twice at one variant, tool and text"}; }
        val scope: res[requirement.Ids, str] = scope_of(r, r.agreement.set.extensions, e.unless);
        if (sel scope.err) { ret err[str].err{scope.err}; }
        val kept: res[usize, A.Error] = vector.push[requirement.Ids](?r.scopes, scope.ok);
        if (sel kept.err) { ret err[str].err{MEMORY}; }
        val with: res[requirement.Ids, str] = scope_of(r, r.agreement.set.extensions, e.when);
        if (sel with.err) { ret err[str].err{with.err}; }
        val held: res[usize, A.Error] = vector.push[requirement.Ids](?r.withs, with.ok);
        if (sel held.err) { ret err[str].err{MEMORY}; }
        var need: requirement.Ids = requirement.NO_IDS;
        if (sel e.subject.extension) {
            val named: res[requirement.Ids, str] = scope_of(r, r.agreement.set.extensions, e.subject.extension);
            if (sel named.err) { ret err[str].err{"an exception names no extension of the set"}; }
            need = named.ok;
        }
        val needed: res[usize, A.Error] = vector.push[requirement.Ids](?r.needs, need);
        if (sel needed.err) { ret err[str].err{MEMORY}; }
        val unused: res[usize, A.Error] = vector.push[bool](?r.used, false);
        if (sel unused.err) { ret err[str].err{MEMORY}; }
        val inserted: res[bool, A.Error] = map.insert[str, u32](?r.exceptions, key.some, i);
        if (sel inserted.err) { ret err[str].err{MEMORY}; }
        i = i + 1;
    }
    ret err[str].ok{};
}

# whether exception `e` names a tool the agreement runs, if any: an assembler, of whose bytes it excuses that check
# alone, or the disassembler, of whose printing it excuses decode alone
fun tool_known(r: *Run, e: *agreement.Exception) err[str] {
    if (blank(e.tool)) { ret err[str].ok{}; }
    var j: u32 = 0;
    for (j < r.agreement.assemblers.len) {
        if (str_equals(r.agreement.assemblers.at[j].tool.name, e.tool)) {
            if (e.checks != agreement.BYTES) { ret err[str].err{"an exception of an assembler excuses a check other than bytes"}; }
            ret err[str].ok{};
        }
        j = j + 1;
    }
    if (str_equals(r.agreement.disassembler.tool.name, e.tool)) {
        if (e.checks != agreement.DECODE) { ret err[str].err{"an exception of the disassembler excuses a check other than decode"}; }
        ret err[str].ok{};
    }
    ret err[str].err{"an exception names no tool of the agreement"};
}

# whether `subject` names what the agreement has: a row of the set, an alias of a row the syntax reads it by, or one
# of the agreement's statements, which `stated` indexes by text
fun subject_known(r: *Run, subject: agreement.Subject, stated: *map.Map[str, u32]) err[str] {
    val codec: *dispatch.Codec = r.agreement.set.codec;
    if (sel subject.row) {
        val known: opt[*row.Row] = walk.row_keyed(codec, subject.row);
        if (sel known.none) { ret err[str].err{"an exception names no row of the set"}; }
        ret err[str].ok{};
    }
    if (sel subject.spelling) {
        val known: opt[*row.Row] = walk.row_keyed(codec, subject.spelling.row);
        if (sel known.none) { ret err[str].err{"an exception names a spelling of no row of the set"}; }
        val syn:   *core_syntax.Syntax = ?r.agreement.set.syntaxes.at[r.agreement.syntax];
        val index: u32                 = known.some.index;
        var a:     u32                 = print.first_alias(syn, index);
        for (a < syn.aliases.len && syn.aliases.at[a].row == index) {
            if (str_equals(syn.aliases.at[a].template, subject.spelling.template)) { ret err[str].ok{}; }
            a = a + 1;
        }
        ret err[str].err{"an exception names a spelling its row has no alias of"};
    }
    if (sel subject.rows) {
        var i: u32 = 0;
        for (i < codec.rows.len) {
            if (globbed(subject.rows, codec.rows.at[i].key)) { ret err[str].ok{}; }
            i = i + 1;
        }
        ret err[str].err{"an exception's pattern names no row of the set"};
    }
    if (sel subject.extension) { ret err[str].ok{}; }
    if (sel subject.statement) {
        if (map.contains[str, u32](stated, ?subject.statement)) { ret err[str].ok{}; }
    }
    ret err[str].err{"an exception names no statement of the agreement"};
}

# the agreement run over every row at every variant into `out`, everything it holds allocated from `a`
# ---
# ret: ok, with the result's failures counting the rows that fail it, or why it could not run
pub fun agree(a: *A.Allocator, ag: *agreement.Agreement, options: Options, out: *Result) err[str] {
    @out = Result{agreement: ag, options: options, assemblers: vector.init[tool.Found](a), disassembler: tool.Found{tool: nil, path: nil, version: "", pinned: false}, widths: vector.init[Width](a), notes: vector.init[str](a), failures: 0};
    if (ag.assemblers.len == 0)                             { ret err[str].err{"the agreement names no reference assembler"}; }
    if ((ag.stream == nil) != (ag.set.codec.stream == nil)) { ret err[str].err{"the agreement states a stream record for a set of no typed stream, or none for a set of one"}; }
    var u: u32 = 0;
    for (u < ag.further.len) {
        val fu:   *agreement.Further = ?ag.further.at[u];
        var same: bool               = fu.format == ag.format;
        var e:    u32                = 0;
        for (e < u) {
            if (ag.further.at[e].format == fu.format) { same = true; }
            e = e + 1;
        }
        if (same) { ret err[str].err{"the agreement names its own format or one further format twice"}; }
        u = u + 1;
    }
    var back: A.Allocator;
    page.make(?back);
    var area: arena.Arena;
    val made: err[A.Error] = arena.init(?area, ?back, 1 << 22);
    if (sel made.err) { ret err[str].err{MEMORY}; }
    fin { arena.dnit(?area); }
    var scratch: A.Allocator;
    arena.make(?scratch, ?area);
    val built: res[registry.Registry, fail.Fail] = registry.builtin(a);
    if (sel built.err) { ret err[str].err{"mink's format registry cannot be built"}; }
    var formats: registry.Registry = built.ok;
    fin { registry.release(?formats); }
    var r:       Run      = Run{a: a, scratch: ?scratch, area: ?area, agreement: ag, result: out, exceptions: map.init[str, u32](a), scopes: vector.init[requirement.Ids](a), withs: vector.init[requirement.Ids](a), needs: vector.init[requirement.Ids](a), used: vector.init[bool](a), seen: map.init[str, u32](a), modes: mode.initial(?ag.set.assembly), formats: ?formats, widened: vector.init[Widened](a)};
    val indexed: err[str] = index_exceptions(?r);
    if (sel indexed.err) { ret indexed; }
    val dir: err[fs.FsError] = fs.create_dir_all(a, options.work, 0o755);
    if (sel dir.err) { ret err[str].err{"the work directory cannot be made"}; }
    var j: u32 = 0;
    for (j < ag.assemblers.len) {
        val found: res[tool.Found, str] = locate(?r, ag.assemblers.at[j].tool, j == 0);
        if (sel found.err) { ret err[str].err{found.err}; }
        val pushed: res[usize, A.Error] = vector.push[tool.Found](?out.assemblers, found.ok);
        if (sel pushed.err) { ret err[str].err{MEMORY}; }
        j = j + 1;
    }
    val listed: res[tool.Found, str] = locate(?r, ag.disassembler.tool, true);
    if (sel listed.err) { ret err[str].err{listed.err}; }
    out.disassembler = listed.ok;
    var v: u32 = 0;
    for (v < ag.variants.len) {
        val ran: err[str] = width(?r, ?ag.variants.at[v], ag.format);
        if (sel ran.err) { ret ran; }
        v = v + 1;
    }
    var f: u32 = 0;
    for (f < ag.further.len) {
        val fu: *agreement.Further = ?ag.further.at[f];
        v = 0;
        for (v < fu.variants.len) {
            val ran: err[str] = width(?r, ?fu.variants.at[v], fu.format);
            if (sel ran.err) { ret ran; }
            v = v + 1;
        }
        f = f + 1;
    }
    # an exception of a family of rows that excused none is stale, as one of a row is
    var e: u32 = 0;
    for (e < ag.exceptions.len) {
        val ex: *agreement.Exception = ?ag.exceptions.at[e];
        if (broad(ex) && !r.used.data[e]) {
            var named: str = nil;
            if (sel ex.subject.rows)      { named = ex.subject.rows; }
            if (sel ex.subject.extension) { named = ex.subject.extension; }
            val noted: err[str] = note(?r, "stale exception", named);
            if (sel noted.err) { ret noted; }
            out.failures = out.failures + 1;
        }
        e = e + 1;
    }
    ret err[str].ok{};
}
