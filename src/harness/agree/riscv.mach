# the risc-v agreement: rv32 and rv64 against llvm-mc and the gnu assembler, decoded against llvm-objdump
#
# each width's selections hold the width and the i base, and its assemblers
# are told the soft float abi, which no encoding depends on. llvm is asked
# for the selection as `-mattr`, an attribute per extension, which is the
# extension's name, and the gnu assembler as `-march`, the isa string the
# catalog spells. the tools are pinned at the versions the exception table
# was written against: llvm 23.1.1, and binutils 2.47 where a risc-v gnu
# assembler is installed.
#
# the hook offers what an operand's kind cannot say: every named csr the
# selection admits, by its number, to a csr operand, every vector type a
# field names, element width by length multiplier by tail and mask policy,
# to an immediate the syntax writes as a vector type, and every stack
# adjustment to the operand a zcmp stack field encodes, whose admitted values
# hang on the register list.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.view_eq_str;

use A: std.allocator;
use std.collections.vector;

use mink;

use masc.core.extension;
use masc.core.field;
use masc.core.operand;
use masc.core.requirement;
use masc.core.row;
use masc.core.spelling;

use riscv_csr:       masc.isa.riscv.csr;
use riscv_extension: masc.isa.riscv.extension;
use riscv_field:     masc.isa.riscv.field;
use masc.isa.riscv.gen_csr;
use riscv_set:    masc.isa.riscv.set;
use riscv_syntax: masc.isa.riscv.syntax;

use masc.harness.agree.agreement;
use masc.harness.agree.text;
use masc.harness.agree.vectors;

val RV32_BASE: [2]requirement.Id = [2]requirement.Id{riscv_extension.RV32, riscv_extension.I};
val RV64_BASE: [2]requirement.Id = [2]requirement.Id{riscv_extension.RV64, riscv_extension.I};

val RV32_OPTIONS: [1]agreement.Option = [1]agreement.Option{agreement.Option{option: "-mabi", value: "ilp32"}};
val RV64_OPTIONS: [1]agreement.Option = [1]agreement.Option{agreement.Option{option: "-mabi", value: "lp64"}};

val VARIANTS: [2]agreement.Variant = [2]agreement.Variant{
    agreement.Variant{name: "rv32", arch: ?mink.arch.RISCV32, base: requirement.Ids{at: ?RV32_BASE[0], len: 2}, options: agreement.Options{at: ?RV32_OPTIONS[0], len: 1}},
    agreement.Variant{name: "rv64", arch: ?mink.arch.RISCV64, base: requirement.Ids{at: ?RV64_BASE[0], len: 2}, options: agreement.Options{at: ?RV64_OPTIONS[0], len: 1}},
};

val LLVM_MC_PROGRAMS:      [1]str = [1]str{"llvm-mc"};
val LLVM_OBJDUMP_PROGRAMS: [1]str = [1]str{"llvm-objdump"};
val GNU_AS_PROGRAMS:       [4]str = [4]str{"riscv64-linux-gnu-as", "riscv64-unknown-linux-gnu-as", "riscv64-unknown-elf-as", "riscv64-elf-as"};

val LLVM_MC:      agreement.Tool = agreement.Tool{name: "llvm-mc", programs: agreement.Programs{at: ?LLVM_MC_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};
val LLVM_OBJDUMP: agreement.Tool = agreement.Tool{name: "llvm-objdump", programs: agreement.Programs{at: ?LLVM_OBJDUMP_PROGRAMS[0], len: 1}, pin: "LLVM version 23.1.1"};
val GNU_AS:       agreement.Tool = agreement.Tool{name: "gnu-as", programs: agreement.Programs{at: ?GNU_AS_PROGRAMS[0], len: 4}, pin: "GNU assembler (GNU Binutils) 2.47"};

# the ratified extensions llvm 23.1.1 still holds experimental, which its attributes name `experimental-` and the
# extension's name (RISCVFeatures.td, checked against llvm-mc 23.1.1, which ignores `+zicfiss`)
val EXPERIMENTAL: [2]requirement.Id = [2]requirement.Id{riscv_extension.ZICFILP, riscv_extension.ZICFISS};

fun experimental(id: requirement.Id) bool {
    var i: u32 = 0;
    for (i < 2) {
        if (EXPERIMENTAL[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the selection as llvm attributes, `+` and each extension's name, comma separated, the width left to the triple
fun attributes(s: *extension.Selection, t: *text.Text) {
    val catalog: *extension.Catalog = s.catalog;
    var first:   bool               = true;
    var i:       u32                = 0;
    for (i < catalog.count) {
        if (extension.has(s, i) && i != riscv_extension.RV32 && i != riscv_extension.RV64) {
            if (!first) { text.byte(t, ','); }
            text.byte(t, '+');
            if (experimental(i)) { text.put(t, "experimental-"); }
            text.put(t, catalog.extensions[i].name);
            first = false;
        }
        i = i + 1;
    }
}

# `head` and the selection's attributes as one argument
fun attribute_arg(job: *agreement.Job, args: *agreement.Args, head: str) {
    var t: text.Text = text.make(args.a);
    text.put(?t, head);
    attributes(job.selection, ?t);
    agreement.arg_text(args, ?t);
}

fun llvm_mc(job: *agreement.Job, args: *agreement.Args) {
    if (extension.has(job.selection, riscv_extension.RV64)) { agreement.arg(args, "-triple=riscv64"); }
    or                                                      { agreement.arg(args, "-triple=riscv32"); }
    attribute_arg(job, args, "-mattr=");
    agreement.arg(args, "-filetype=obj");
    agreement.arg(args, "-o");
    agreement.arg(args, job.object);
    agreement.arg(args, job.source);
}

fun llvm_objdump(job: *agreement.Job, args: *agreement.Args) {
    agreement.arg(args, "-d");
    agreement.arg(args, "--no-print-imm-hex");
    agreement.arg(args, "--no-show-raw-insn");
    agreement.arg(args, "-M");
    agreement.arg(args, "no-aliases");
    attribute_arg(job, args, "--mattr=");
    agreement.arg(args, job.object);
}

fun gnu_as(job: *agreement.Job, args: *agreement.Args) {
    var spelled: vector.Vector[u8] = vector.init[u8](args.a);
    val wrote:   err[A.Error]      = job.selection.catalog.syntax.spell(job.selection, ?spelled);
    if (sel wrote.err) {
        args.failed = true;
        ret;
    }
    var t: text.Text = text.make(args.a);
    text.put(?t, "-march=");
    text.bytes(?t, spelled.data, spelled.len);
    agreement.arg_text(args, ?t);
    var i: u32 = 0;
    for (i < job.variant.options.len) {
        var o: text.Text = text.make(args.a);
        text.put(?o, job.variant.options.at[i].option);
        text.byte(?o, '=');
        text.put(?o, job.variant.options.at[i].value);
        agreement.arg_text(args, ?o);
        i = i + 1;
    }
    agreement.arg(args, "-mno-relax");
    agreement.arg(args, "-o");
    agreement.arg(args, job.object);
    agreement.arg(args, job.source);
}

val ASSEMBLERS: [2]agreement.Assembler = [2]agreement.Assembler{
    agreement.Assembler{tool: ?LLVM_MC, spell: llvm_mc},
    agreement.Assembler{tool: ?GNU_AS, spell: gnu_as},
};

# every named csr the selection admits, each number once, offered to csr operand `k`
fun csrs(g: *vectors.Generation, k: u32) {
    var last: u32 = 0xFFFF_FFFF;
    var i:    u32 = 0;
    for (i < gen_csr.TABLE.len) {
        val c: *riscv_csr.Csr = ?gen_csr.TABLE.at[gen_csr.BY_NUMBER[i]];
        if (c.number != last && extension.admits(g.available.selection, c.requires)) {
            vectors.offer(g, k, operand.Value.id{c.number});
            last = c.number;
        }
        i = i + 1;
    }
}

# the length multipliers a vector type's field names, by code
val LMULS: [7]u32 = [7]u32{0, 1, 2, 3, 5, 6, 7};

# every vector type its fields name offered to immediate operand `k`
fun vtypes(g: *vectors.Generation, k: u32) {
    var sew: u32 = 0;
    for (sew < 4) {
        var m: u32 = 0;
        for (m < 7) {
            var policy: u32 = 0;
            for (policy < 4) {
                vectors.offer(g, k, operand.Value.immediate{(LMULS[m] | (sew << 3) | (policy << 6))::i64});
                policy = policy + 1;
            }
            m = m + 1;
        }
        sew = sew + 1;
    }
}

# whether the risc-v syntax writes operand `k` of `r` as a vector type
fun vtype_operand(g: *vectors.Generation, k: u32) bool {
    val index: u32   = ((g.row:~u64 - g.codec.rows.at:~u64) / $size_of(row.Row)::u64)::u32;
    val form:  str   = riscv_syntax.SYNTAX.forms.at[index];
    var at:    usize = 0;
    for {
        val p: spelling.Piece = spelling.piece(form, at);
        if (p.kind == spelling.END)                                                           { ret false; }
        if (p.kind == spelling.HOLE && p.operand::u32 == k && view_eq_str(p.format, "vtype")) { ret true; }
        at = p.at + p.len;
    }
    ret false;
}

# the largest stack adjustment zcmp encodes, the largest list's base of 112 and three steps of 16
val STACK_MOST: i64 = 160;

# every adjustment of either sign a stack field's operand `k` could take, each kept when the base vector's list takes it
fun adjustments(g: *vectors.Generation, k: u32) {
    var a: i64 = 16;
    for (a <= STACK_MOST) {
        vectors.offer(g, k, operand.Value.immediate{a});
        vectors.offer(g, k, operand.Value.immediate{0 - a});
        a = a + 16;
    }
}

fun hook(g: *vectors.Generation) {
    var k: u32 = 0;
    for (k < g.row.operands.len) {
        val shape: *operand.Shape = ?g.row.operands.at[k].shape;
        if (sel shape.id && shape.id.space == riscv_csr.SPACE) { csrs(g, k); }
        if (sel shape.immediate && vtype_operand(g, k))        { vtypes(g, k); }
        k = k + 1;
    }
    var j: u32 = 0;
    for (j < g.row.encoding.len) {
        val f: *field.Field = ?g.row.encoding.at[j];
        if (f.kind == riscv_field.STACK_KIND) { adjustments(g, f.operand::u32); }
        j = j + 1;
    }
}

# the risc-v agreement
pub val AGREEMENT: agreement.Agreement = agreement.Agreement{
    name:         "riscv",
    set:          ?riscv_set.SET,
    syntax:       0,
    variants:     agreement.Variants{at: ?VARIANTS[0], len: 2},
    assemblers:   agreement.Assemblers{at: ?ASSEMBLERS[0], len: 2},
    disassembler: agreement.Disassembler{tool: ?LLVM_OBJDUMP, spell: llvm_objdump},
    exceptions:   agreement.NO_EXCEPTIONS,
    hook:         hook,
};
