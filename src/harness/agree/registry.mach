# the registered agreements, one line each, found by name
#
# adding a set's agreement is its module and a line here.

use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_equals;

use masc.harness.agree.agreement;

use riscv_agreement: masc.harness.agree.riscv;

val ALL: [1]*agreement.Agreement = [1]*agreement.Agreement{?riscv_agreement.AGREEMENT};

# every registered agreement
pub val AGREEMENTS: agreement.Agreements = agreement.Agreements{at: ?ALL[0], len: 1};

# the agreement named `name`, none when no set registers one
pub fun find(name: str) opt[*agreement.Agreement] {
    var i: u32 = 0;
    for (i < AGREEMENTS.len) {
        if (str_equals(AGREEMENTS.at[i].name, name)) { ret opt[*agreement.Agreement].some{AGREEMENTS.at[i]}; }
        i = i + 1;
    }
    ret opt[*agreement.Agreement].none{};
}
