# the wasm testsuite sweep: every valid module of a directory's .wast scripts read by masc, written by mink, checked
#
# a script's valid modules are its `(module ...)` commands of text, `binary` and `quote` ones left out as no text, a
# `definition` read as the module it defines and an `instance` as none, and the module of an `assert_trap`, an
# `assert_unlinkable` or an `assert_uninstantiable`, which is valid and fails only when run. the modules of
# `assert_invalid` and `assert_malformed` are not valid and are left out. each module is read by masc's module reader
# (`masc.isa.wasm.module`) into mink's container and written by mink's writer, and the module's text is written to a
# file wat2wasm assembles. a module agrees when wat2wasm and masc write the same bytes and wasm-validate passes masc's,
# every tool asked for the set's features (`masc.harness.agree.wasm_tools`).
#
# a module fails when masc refuses what wat2wasm assembles, when masc's bytes are not wat2wasm's, or when
# wasm-validate refuses masc's. a module both refuse is outside the set's features, as a type of the gc proposal, and
# one only wat2wasm refuses is a gap of wabt's: both are listed with why, and neither fails the sweep.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;

use A: std.allocator;
use std.allocator.arena;
use std.collections.vector;
use fs: std.filesystem;

use mink.base.fail.Fail;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink_model: mink.format.wasm.model;
use mink_write: mink.format.wasm.write;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.register;
use masc.core.requirement;
use masc.core.state;
use masc.tool.text;

use wasm_codec:     masc.isa.wasm.codec;
use wasm_extension: masc.isa.wasm.extension;
use masc.isa.wasm.gen_extension;
use wasm_module: masc.isa.wasm.module;
use wasm_stream: masc.isa.wasm.stream;
use wasm_text:   masc.isa.wasm.text;

use masc.harness.agree.agreement;
use masc.harness.agree.tool;
use masc.harness.agree.wasm_tools;

pub val MEMORY: str = "out of memory";

# what one module came to
# ---
# AGREE:   masc and wat2wasm write the same bytes, which wasm-validate passes
# DIFFER:  masc's bytes are not wat2wasm's
# INVALID: wasm-validate refuses masc's bytes
# REFUSED: masc refuses what wat2wasm assembles
# OUTSIDE: masc and wat2wasm both refuse it
# WABT:    wat2wasm refuses what masc writes and wasm-validate passes
pub def State: u8;

pub val AGREE:   State = 0;
pub val DIFFER:  State = 1;
pub val INVALID: State = 2;
pub val REFUSED: State = 3;
pub val OUTSIDE: State = 4;
pub val WABT:    State = 5;

pub val STATES: u8 = 6;

pub val STATE_NAMES: [6]str = [6]str{"agree", "differ", "invalid", "refused", "outside", "wabt"};

# whether a module in `s` fails the sweep
pub fun failing(s: State) bool {
    ret s == DIFFER || s == INVALID || s == REFUSED;
}

# one module: its script, the line its command starts on, what it came to and why
pub rec Module {
    script: str;
    line:   u32;
    state:  State;
    why:    str;
}

# the sweep: every module, how many came to each state, and how many fail
pub rec Result {
    modules:  vector.Vector[Module];
    counts:   [6]u32;
    failures: u32;
}

# what a sweep keeps while it runs
rec Run {
    a:        *A.Allocator;
    scratch:  *A.Allocator;
    area:     *arena.Arena;
    work:     str;
    wat2wasm: tool.Found;
    validate: tool.Found;
    sel_:     extension.Selection;
    avail:    register.Available;
    result:   *Result;
    number:   u32;
    seen:     usize;
    lines:    u32;
}

fun joined(a: *A.Allocator, x: str, y: str, z: str) opt[str] {
    var t: text.Text = text.make(a);
    text.put(?t, x);
    text.put(?t, y);
    text.put(?t, z);
    ret text.copy(?t, a);
}

# the line of byte `at` of the script's `data`, counted on from the last one asked, as commands come in text order
fun line_of(r: *Run, data: *u8, at: usize) u32 {
    for (r.seen < at) {
        if (data[r.seen] == '\n') { r.lines = r.lines + 1; }
        r.seen = r.seen + 1;
    }
    ret r.lines;
}

fun noted(r: *Run, script: str, line: u32, state: State, why: str) err[str] {
    var kept: str = why;
    if (why != nil) {
        val copied: opt[str] = joined(r.a, why, "", "");
        if (sel copied.none) { ret err[str].err{MEMORY}; }
        kept = copied.some;
    }
    val pushed: res[usize, A.Error] = vector.push[Module](?r.result.modules, Module{script: script, line: line, state: state, why: kept});
    if (sel pushed.err) { ret err[str].err{MEMORY}; }
    r.result.counts[state] = r.result.counts[state] + 1;
    if (failing(state)) { r.result.failures = r.result.failures + 1; }
    ret err[str].ok{};
}

# the first line of a tool's standard error, its refusal
fun first_line(a: *A.Allocator, s: str) str {
    var t: text.Text = text.make(a);
    var i: usize     = 0;
    for (s[i] != 0 && s[i] != '\n') {
        text.byte(?t, s[i]);
        i = i + 1;
    }
    val got: opt[str] = text.copy(?t, a);
    if (sel got.none) { ret "a tool refused it"; }
    ret got.some;
}

# masc's bytes of the module text `data[at..end]`, or why masc refuses it
fun by_masc(r: *Run, data: *u8, len: usize) res[vector.Vector[u8], str] {
    val opened: res[state.Context, state.Opened] = state.open(r.scratch, nil, ?r.sel_, ?wasm_extension.AXES, state.initial(?wasm_extension.AXES), ?r.avail);
    if (sel opened.err) { ret res[vector.Vector[u8], str].err{"the selection opens no context"}; }
    var ctx:    state.Context     = opened.ok;
    val stream: res[ptr, A.Error] = wasm_stream.HOOKS.make(r.scratch);
    if (sel stream.err) { ret res[vector.Vector[u8], str].err{MEMORY}; }
    ctx.stream = stream.ok;
    var m:   mink_model.Module;
    val got: err[diagnostic.Diagnostic] = wasm_module.read(r.scratch, data, len, diagnostic.START, ?wasm_codec.CODEC, ?ctx, ?m);
    if (sel got.err) {
        var t: text.Text = text.make(r.scratch);
        text.put(?t, got.err.message);
        text.put(?t, " at ");
        text.decimal(?t, got.err.span.start.line::i64);
        text.put(?t, ":");
        text.decimal(?t, got.err.span.start.column::i64);
        val why: opt[str] = text.copy(?t, r.scratch);
        if (sel why.none) { ret res[vector.Vector[u8], str].err{MEMORY}; }
        ret res[vector.Vector[u8], str].err{why.some};
    }
    val wrote: res[Sink, Fail] = mink_write.write(r.scratch, ?m);
    if (sel wrote.err) { ret res[vector.Vector[u8], str].err{wrote.err.text}; }
    var out:  Sink              = wrote.ok;
    var kept: vector.Vector[u8] = vector.init[u8](r.scratch);
    var i:    usize             = 0;
    for (i < sink.len(?out)) {
        val pushed: res[usize, A.Error] = vector.push[u8](?kept, sink.data(?out)[i]);
        if (sel pushed.err) { ret res[vector.Vector[u8], str].err{MEMORY}; }
        i = i + 1;
    }
    ret res[vector.Vector[u8], str].ok{kept};
}

# one valid module of `script`, its text `data[at..end)`, swept
fun module(r: *Run, script: str, stem: str, data: *u8, at: usize, end: usize, line: u32) err[str] {
    arena.reset(r.area);
    r.number = r.number + 1;
    var t: text.Text = text.make(r.scratch);
    text.put(?t, stem);
    text.put(?t, ".");
    text.decimal(?t, r.number::i64);
    val rel: opt[str] = text.copy(?t, r.scratch);
    if (sel rel.none) { ret err[str].err{MEMORY}; }
    val base: opt[str] = joined(r.scratch, r.work, "/", rel.some);
    if (sel base.none) { ret err[str].err{MEMORY}; }
    val wat:  opt[str] = joined(r.scratch, base.some, ".wat", "");
    val ref:  opt[str] = joined(r.scratch, base.some, ".wasm", "");
    val mine: opt[str] = joined(r.scratch, base.some, ".masc.wasm", "");
    if (sel wat.none)  { ret err[str].err{MEMORY}; }
    if (sel ref.none)  { ret err[str].err{MEMORY}; }
    if (sel mine.none) { ret err[str].err{MEMORY}; }
    val source: err[fs.FsError] = fs.write_bytes(wat.some, ?data[at], end - at, 0o644);
    if (sel source.err) { ret err[str].err{"a module's text cannot be written"}; }
    val masc: res[vector.Vector[u8], str] = by_masc(r, ?data[at], end - at);
    var args: agreement.Args              = agreement.Args{a: r.scratch, list: vector.init[str](r.scratch), failed: false};
    wasm_tools.features(?args);
    agreement.arg(?args, wat.some);
    agreement.arg(?args, "-o");
    agreement.arg(?args, ref.some);
    val name: opt[str] = joined(r.scratch, rel.some, ".wat2wasm", "");
    if (sel name.none) { ret err[str].err{MEMORY}; }
    val ran: res[tool.Ran, str] = tool.run(r.scratch, r.wat2wasm.path, ?args, r.work, name.some);
    if (sel ran.err) { ret err[str].err{ran.err}; }
    val theirs: bool = ran.ok.ok;
    if (sel masc.err) {
        if (theirs) { ret noted(r, script, line, REFUSED, masc.err); }
        val both: opt[str] = joined(r.scratch, masc.err, "; wat2wasm: ", first_line(r.scratch, ran.ok.err));
        if (sel both.none) { ret err[str].err{MEMORY}; }
        ret noted(r, script, line, OUTSIDE, both.some);
    }
    val wrote: err[fs.FsError] = fs.write_bytes(mine.some, masc.ok.data, masc.ok.len, 0o644);
    if (sel wrote.err) { ret err[str].err{"masc's module cannot be written"}; }
    var vargs: agreement.Args = agreement.Args{a: r.scratch, list: vector.init[str](r.scratch), failed: false};
    wasm_tools.features(?vargs);
    agreement.arg(?vargs, mine.some);
    val vname: opt[str] = joined(r.scratch, rel.some, ".validate", "");
    if (sel vname.none) { ret err[str].err{MEMORY}; }
    val checked: res[tool.Ran, str] = tool.run(r.scratch, r.validate.path, ?vargs, r.work, vname.some);
    if (sel checked.err) { ret err[str].err{checked.err}; }
    if (!checked.ok.ok)  { ret noted(r, script, line, INVALID, first_line(r.scratch, checked.ok.err)); }
    if (!theirs)         { ret noted(r, script, line, WABT, first_line(r.scratch, ran.ok.err)); }
    val loaded: res[vector.Vector[u8], fs.FsError] = fs.read_bytes(r.scratch, ref.some);
    if (sel loaded.err) { ret err[str].err{"wat2wasm's module cannot be read"}; }
    val n: usize = loaded.ok.len;
    var i: usize = 0;
    for (i < n && i < masc.ok.len && loaded.ok.data[i] == masc.ok.data[i]) { i = i + 1; }
    if (i == n && i == masc.ok.len) { ret noted(r, script, line, AGREE, nil); }
    var why: text.Text = text.make(r.scratch);
    text.put(?why, "first different byte at offset ");
    text.decimal(?why, i::i64);
    text.put(?why, " of ");
    text.decimal(?why, masc.ok.len::i64);
    text.put(?why, " for ");
    text.decimal(?why, n::i64);
    val said: opt[str] = text.copy(?why, r.scratch);
    if (sel said.none) { ret err[str].err{MEMORY}; }
    ret noted(r, script, line, DIFFER, said.some);
}

# the commands that hold a module wat2wasm reads as a valid one
fun holds_valid(l: *wasm_text.Lexer, t: wasm_text.Token) bool {
    ret wasm_text.is(l, t, "assert_trap") || wasm_text.is(l, t, "assert_unlinkable") || wasm_text.is(l, t, "assert_uninstantiable");
}

# the module command whose `(` is at `open` and whose keyword `module` the lexer is past, swept unless it is no text
fun command(r: *Run, script: str, stem: str, data: *u8, l: *wasm_text.Lexer, open: usize) err[str] {
    var copy: wasm_text.Lexer = @l;
    var t:    wasm_text.Token = wasm_text.next(?copy);
    var def:  usize           = 0;
    var dlen: usize           = 0;
    if (wasm_text.is(?copy, t, "definition")) {
        def  = t.at;
        dlen = t.len;
        t    = wasm_text.next(?copy);
    }
    if (wasm_text.identifier(?copy, t)) { t = wasm_text.next(?copy); }
    if (wasm_text.is(?copy, t, "definition")) {
        def  = t.at;
        dlen = t.len;
        t    = wasm_text.next(?copy);
    }
    val skipped: bool = wasm_text.skip(l);
    if (!skipped)                                                                                                  { ret err[str].ok{}; }
    if (wasm_text.is(?copy, t, "binary") || wasm_text.is(?copy, t, "quote") || wasm_text.is(?copy, t, "instance")) { ret err[str].ok{}; }
    if (dlen == 0)                                                                                                 { ret module(r, script, stem, data, open, l.at, line_of(r, data, open)); }
    # a definition is read as the module it defines, its keyword blanked in a copy of its text
    val n:    usize             = l.at - open;
    val held: res[*u8, A.Error] = A.allocate[u8](r.a, n);
    if (sel held.err) { ret err[str].err{MEMORY}; }
    var i: usize = 0;
    for (i < n) {
        held.ok[i] = data[open + i];
        if (open + i >= def && open + i < def + dlen) { held.ok[i] = ' '; }
        i = i + 1;
    }
    ret module(r, script, stem, held.ok, 0, n, line_of(r, data, open));
}

# every valid module of the script at `path` swept
fun script(r: *Run, path: str, stem: str) err[str] {
    val loaded: res[vector.Vector[u8], fs.FsError] = fs.read_bytes(r.a, path);
    if (sel loaded.err) { ret err[str].err{"a script cannot be read"}; }
    r.seen  = 0;
    r.lines = 1;
    val data: *u8             = loaded.ok.data;
    var l:    wasm_text.Lexer = wasm_text.make(data, 0, loaded.ok.len);
    for {
        val t: wasm_text.Token = wasm_text.next(?l);
        if (t.kind == wasm_text.END || t.kind == wasm_text.BROKEN) { brk; }
        if (t.kind != wasm_text.OPEN)                              { cnt; }
        val k: wasm_text.Token = wasm_text.next(?l);
        if (wasm_text.is(?l, k, "module")) {
            val got: err[str] = command(r, path, stem, data, ?l, t.at);
            if (sel got.err) { ret got; }
            cnt;
        }
        if (holds_valid(?l, k)) {
            val inner: wasm_text.Token = wasm_text.ahead(?l);
            if (wasm_text.opens(?l, "module")) {
                val got: err[str] = command(r, path, stem, data, ?l, inner.at);
                if (sel got.err) { ret got; }
            }
        }
        if (!wasm_text.skip(?l)) { brk; }
    }
    ret err[str].ok{};
}

# the selection of every wasm extension
fun everything(a: *A.Allocator, out: *extension.Selection) bool {
    val made: res[extension.Request, extension.Error] = extension.request(a, ?wasm_extension.CATALOG, "", diagnostic.START);
    if (sel made.err) { ret false; }
    var req: extension.Request = made.ok;
    var id:  u32               = 0;
    for (id < gen_extension.COUNT) {
        extension.request_add(?req, id::requirement.Id);
        id = id + 1;
    }
    val closed: res[extension.Selection, extension.Error] = extension.close(req);
    if (sel closed.err) { ret false; }
    @out = closed.ok;
    ret true;
}

# the tool `t` found at its pin, or why it cannot run
fun pinned(a: *A.Allocator, t: *agreement.Tool, work: str) res[tool.Found, str] {
    val got: res[tool.Found, str] = tool.find(a, t, work);
    if (sel got.err) { ret got; }
    if (got.ok.path == nil) {
        val why: opt[str] = joined(a, t.name, " is not on the path", "");
        if (sel why.none) { ret res[tool.Found, str].err{MEMORY}; }
        ret res[tool.Found, str].err{why.some};
    }
    if (!got.ok.pinned) {
        val why: opt[str] = joined(a, t.name, " is not at its pin ", t.pin);
        if (sel why.none) { ret res[tool.Found, str].err{MEMORY}; }
        ret res[tool.Found, str].err{why.some};
    }
    ret got;
}

# every valid module of every .wast script in each of `dirs`, its tools' files in `work`, into `out`
# ---
# a:       the allocator of the result, which outlives the sweep
# scratch: the allocator each module's work is held in, reset between modules
# area:    the arena behind `scratch`
pub fun sweep(a: *A.Allocator, scratch: *A.Allocator, area: *arena.Arena, dirs: *str, count: usize, work: str, out: *Result) err[str] {
    out.modules  = vector.init[Module](a);
    out.failures = 0;
    var s: u8 = 0;
    for (s < STATES) {
        out.counts[s] = 0;
        s             = s + 1;
    }
    val dir: err[fs.FsError] = fs.create_dir_all(a, work, 0o755);
    if (sel dir.err) { ret err[str].err{"the work directory cannot be made"}; }
    var r: Run;
    r.a       = a;
    r.scratch = scratch;
    r.area    = area;
    r.work    = work;
    r.result  = out;
    r.number  = 0;
    val w: res[tool.Found, str] = pinned(a, ?wasm_tools.WAT2WASM, work);
    if (sel w.err) { ret err[str].err{w.err}; }
    r.wat2wasm = w.ok;
    val v: res[tool.Found, str] = pinned(a, ?wasm_tools.VALIDATE, work);
    if (sel v.err) { ret err[str].err{v.err}; }
    r.validate = v.ok;
    if (!everything(a, ?r.sel_)) { ret err[str].err{"the wasm catalog closes no selection of every extension"}; }
    var d: usize = 0;
    for (d < count) {
        val listed: res[vector.Vector[fs.Listed], fs.FsError] = fs.read_dir(a, dirs[d]);
        if (sel listed.err) { ret err[str].err{"a directory cannot be listed"}; }
        var names: vector.Vector[str] = vector.init[str](a);
        var i:     usize              = 0;
        for (i < listed.ok.len) {
            val e: fs.Listed = listed.ok.data[i];
            if (sel e.name) {
                if (str_ends_with(e.name, ".wast")) {
                    val pushed: res[usize, A.Error] = vector.push[str](?names, e.name);
                    if (sel pushed.err) { ret err[str].err{MEMORY}; }
                }
            }
            i = i + 1;
        }
        sorted(?names);
        i = 0;
        for (i < names.len) {
            val path: opt[str] = joined(a, dirs[d], "/", names.data[i]);
            if (sel path.none) { ret err[str].err{MEMORY}; }
            val got: err[str] = script(?r, path.some, names.data[i]);
            if (sel got.err) { ret got; }
            i = i + 1;
        }
        d = d + 1;
    }
    ret err[str].ok{};
}

fun before(x: str, y: str) bool {
    var i: usize = 0;
    for (x[i] != 0 && x[i] == y[i]) { i = i + 1; }
    ret x[i] < y[i];
}

# `names` in byte order, so a sweep lists its scripts the same on every file system
fun sorted(names: *vector.Vector[str]) {
    var i: usize = 1;
    for (i < names.len) {
        val n: str   = names.data[i];
        var k: usize = i;
        for (k > 0 && before(n, names.data[k - 1])) {
            names.data[k] = names.data[k - 1];
            k             = k - 1;
        }
        names.data[k] = n;
        i             = i + 1;
    }
}

# the report of `result`: each module that does not agree, by its script and line, then how many came to each state
pub fun report(a: *A.Allocator, result: *Result, path: str) err[str] {
    var t: text.Text = text.make(a);
    var i: usize     = 0;
    for (i < result.modules.len) {
        val m: *Module = ?result.modules.data[i];
        if (m.state != AGREE) {
            text.put(?t, m.script);
            text.put(?t, ":");
            text.decimal(?t, m.line::i64);
            text.put(?t, " ");
            text.put(?t, STATE_NAMES[m.state]);
            if (m.why != nil) {
                text.put(?t, " ");
                text.put(?t, m.why);
            }
            text.put(?t, "\n");
        }
        i = i + 1;
    }
    summary(?t, result);
    if (t.failed) { ret err[str].err{MEMORY}; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, t.out.data, t.out.len, 0o644);
    if (sel wrote.err) { ret err[str].err{"the report cannot be written"}; }
    ret err[str].ok{};
}

# how many modules came to each state
pub fun summary(t: *text.Text, result: *Result) {
    text.put(t, "  modules ");
    text.decimal(t, result.modules.len::i64);
    var s: u8 = 0;
    for (s < STATES) {
        text.put(t, "  ");
        text.put(t, STATE_NAMES[s]);
        text.put(t, " ");
        text.decimal(t, result.counts[s]::i64);
        s = s + 1;
    }
    text.put(t, "\n");
}
