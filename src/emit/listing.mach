# the builder's listing: source text printed from its statement record, which assembles alone to the same object
#
# the listing is the record of what the caller asked the builder for, never
# a reading of the bytes it encoded: each section's statements as they were
# written, an instruction by its row as written and its values with symbols
# as symbols, data, zero fill, alignments, data that name labels and
# differences of labels, with the labels placed between them and the
# symbols' bindings, visibilities, kinds, sizes and values declared before
# the sections. masc's assembler reads it through the same builder, so what
# the builder derives from a statement, as relaxation, folding and the
# realign markers, it derives again.
#
# every encoding choice the builder made is pinned in the text. an
# instruction is spelled so that it reads back to the row the builder wrote
# it in, with the same values, and so that the builder writes the statement
# read back in that same form under the view the statement was written
# under: its text is parsed again and given its forms by `build.forms`, the
# one owner of that choice. a statement written under another view than the
# object's is written under the dialect's directives that make it: its
# narrowings of the object's selection, as risc-v's `.option push`, `.option
# norvc` and `.option pop` keep an instruction full length that the object's
# selection would compress, or else its restatement of the whole selection,
# as `.option arch, rv64i2p1_zbb1p0`, and its state directives for the
# axes the view sets otherwise, as x86's `.code32`. every section ends under
# the object's view. the text is written in the syntax the listing is asked
# for, after the dialect's directive that reads it, when it has one.
#
# what the text cannot state is refused by a typed reason, naming the
# section and offset or the label, with the output left as it was: a writer's
# records, a frame rule no directive states, a view no directive of the
# dialect states, a section the
# assembler would read otherwise, a name it reads as another, and an
# instruction no spelling reads back to. a nameless section is written as the
# directive that enters its kind by name, as `.text`, and reads back named as
# that directive spells it, and one whose kind no directive enters is refused.
# the first section of a name is entered by it, and every later one of that
# name is opened apart by the dialect's unique number, as elf's
# `.section .text, "ax", @progbits, unique, 1`, so the text reads back to as
# many sections as the builder holds. a dialect that keeps no two sections of
# one name apart refuses the later one. the traits the source stated by the
# format's attribute tag are restated by the dialect's attribute directive as
# the source spelled them, and the sections the format holds traits in, as
# elf's `.note.gnu.property`, by their bytes, so the text reads back to the
# same traits. the traits the caller states, and its abi row, are the
# caller's to give the assembler again, as they were the caller's to give the
# builder. constant-time ranges are in memory only and are not restated.
#
# the line facts attached to the builder (`masc.emit.line`) are restated as
# the `.file` lines of their table before the sections and a `.loc` before
# each instruction a location starts at, so the text assembled with the line
# directives reads back to the same records. a location the text cannot
# state, as one with an end column, is refused.
#
# the builder's frames are restated from its frame facts, never from the
# code, in the directives the format's unwind table is stated by, as mink's
# lowering row names it: a dwarf table, or a compact one falling back to it,
# by the call frame directives. `.cfi_startproc` follows the function's
# label where the frame begins and `.cfi_endproc` stands where it ends, each
# rule is its `.cfi_` directive before the statement it takes effect at, a
# register by its name in the set's syntax, and the personality and
# language data pointers are stated in the encoding the table writes them
# in. the tables the source named are restated by `.cfi_sections`. a rule
# that scales or marks a prologue or an epilogue, which no call frame
# directive states, is refused, as is a frame on a format whose table no
# directive the listing writes states.
#
# a windows table is stated by the `.seh_` directives instead
# (`masc.emit.seh`): `.seh_proc` follows the function's label and
# `.seh_endproc` stands where the frame ends, each prologue step is the
# unwind codes that state its rules, before the statement it takes effect
# at, `.seh_endprologue` stands where the prologue ends, and the
# personality routine is its `.seh_handler`. on arm64 every prologue
# instruction whose step states no code is a `.seh_nop`. a frame no unwind
# code states is refused.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;
use std.collections.sort;
use std.collections.vector;

use mink.base.fail;
use mink.base.intern;
use mink.base.store;
use mink.base.table;
use mink_arch: mink.catalog.arch;
use mink.catalog.format;
use mink_trait: mink.catalog.trait;
use mink.format.contract;
use mink.format.registration;
use mink.format.registry;
use mink.lower;
use mink.lower.unwind.pointer;
use mink.model.frame;
use mink_group: mink.model.group;
use mink.model.reloc;
use mink_section: mink.model.section;
use mink.model.symbol;

use masc.asm.core;
use masc.build.build;
use masc.codec.narrow;
use masc.core.diagnostic;
use masc.core.extension;
use masc.core.field;
use masc.core.fixup;
use core_form: masc.core.form;
use masc.core.inst;
use masc.core.mode;
use masc.core.operand;
use rf: masc.core.register;
use masc.core.relax;
use masc.core.requirement;
use masc.core.row;
use masc.core.source;
use masc.core.state;
use masc.core.stating;
use core_syntax: masc.core.syntax;
use masc.core.trait;
use masc.emit.cfi;
use masc.emit.line;
use masc.emit.seh;
use masc.format.dialect;
use masc.syntax.expr;
use spell: masc.syntax.name;
use masc.syntax.parse;
use masc.syntax.print;
use syntax_write: masc.syntax.write;

pub val NO_SYNTAX:          str = "no syntax of the set at this index";
pub val UNFINISHED:         str = "the builder has not handed its object over, so its record is not final";
pub val RECORDS:            str = "a writer states records on the object, which no statement states";
pub val TWICE:              str = "two sections of one name, which the dialect keeps no two of apart";
pub val NAMELESS_SECTION:   str = "nameless section whose kind no directive of the dialect enters";
pub val DISPOSITION:        str = "section disposition no .section states";
pub val SECTION:            str = "section whose kind and flags no .section reads back to";
pub val GROUPED:            str = "section in a comdat group that keeps a copy by a rule no .section of the dialect states";
pub val OWNED:              str = "link-order or associative section whose owner is opened after it, or which the dialect's .section does not tie to another";
pub val QUOTED:             str = "name that cannot be written in a string";
pub val UNSPELLED:          str = "label name the text cannot spell: one holding a control byte";
pub val BINDING:            str = "symbol binding no directive states";
pub val SEARCH:             str = "weak external search no directive states";
pub val VISIBILITY:         str = "symbol visibility no directive states";
pub val TYPE:               str = "symbol kind no .type states";
pub val PRIVATE:            str = "local symbol whose name the assembler keeps out of the symbol table";
pub val NAMED_LOCAL:        str = "label the object holds as no symbol, whose name the assembler makes one";
pub val UNDEFINED:          str = "local symbol that is never defined, which the assembler refuses";
pub val DUPLICATE:          str = "two labels spelled alike";
pub val VIEW:               str = "view that no directive of the dialect states";
pub val UNNAMED_REGISTER:   str = "frame register the set's syntax names no way";
pub val MODES:              str = "assembler mode value that no directive of the dialect states";
pub val FRAMES:             str = "frame on a format whose unwind table no call frame directive the listing writes states";
pub val FRAME_RULE:         str = "frame rule no call frame directive states: an offset that scales or a prologue or epilogue mark";
pub val UNEVEN:             str = "arm64 prologue whose instructions are not four bytes each, which its unwind codes count";
pub val FRAME_FUNCTION:     str = "frame whose function's label is not placed where it begins, which .cfi_startproc names it by";
pub val FRAME_ORDER:        str = "frames out of the order of their sections and starts, in which the text begins them";
pub val ATTRIBUTE:          str = "trait stated by an attribute tag, which the dialect has no directive to state";
pub val RAW:                str = "instruction stated by its encoding, which the dialect has no directive to state";
pub val NO_BYTE:            str = "the set's source dialect has no one-byte data directive";
pub val NO_WIDTH:           str = "the set's source dialect has no data directive of this width";
pub val UNREAD:             str = "instruction whose spelling does not read back to the row and values the builder wrote";
pub val KINDED:             str = "datum of a stated relocation kind, which no data directive of the source dialect states";
pub val UNNAMED_RELOCATION: str = "relocation stated by itself of a kind the object's format names no row of";
pub val UNPINNED:           str = "instruction the assembler would write in another form under its view";
pub val UNMARKED:           str = "instruction written in a form no marker of its set's forms spells";
pub val MEMORY:             str = "out of memory";

# the syntax a set lists in by default, its established one
pub val DEFAULT: u32 = 0;

# the section of a refusal about the object as a whole or a label
pub val NO_SECTION: u32 = 0xFFFF_FFFF;

# what a listing is asked for
# ---
# syntax:  the index of the set's syntax it is written in
# dialect: the assembly dialect of the format the object is written in (`masc.format.dialect`), which states the names the
#          assembler reading the listing keeps out of the symbol table, as elf's `.L`, and how a section is kept apart
#          from another of its name
pub rec Options {
    syntax:  u32;
    dialect: *dialect.Dialect;
}

# why the builder's record was not listed
# ---
# message: what was refused, one of the wordings above
# section: the section it was found in, NO_SECTION for the object as a whole or a label
# offset:  where in that section
# label:   the label it is about, operand.NO_SYMBOL for none
# encode:  the printer's refusal, when an instruction's values have no spelling
pub rec Refusal {
    message: str;
    section: u32;
    offset:  u64;
    label:   u32;
    encode:  opt[field.Refusal];
}

# bytes of raw data on one line
val PER_LINE: usize = 16;

# the name index of a label not yet named
val UNNAMED: u32 = 0xFFFF_FFFF;

# a label at its place in the record, `order` when it was placed among the labels placed there
rec Placed {
    section:   u32;
    statement: u32;
    order:     u32;
    id:        u32;
}

# a context statements were written under, and the directives of the dialect that state it from the object's
# ---
# v:        the context
# mask:     the dialect's narrowings in force, one bit each by the directive's index
# restated: whether the dialect's restatement states its selection whole, the narrowings then none
# states:   the dialect's state directives that set the axes it holds another value on, one bit each by index
# stated:   whether the directives state it, and the text can end it
rec Scope {
    v:        *state.Context;
    mask:     u64;
    restated: bool;
    states:   u64;
    stated:   bool;
}

# the values of one instruction of a statement
rec Held {
    values: [row.MAX_OPERANDS]operand.Value;
}

# the pointer encodings a format's unwind table writes a frame's pointers in, their slot bit aside
# ---
# personality: a personality routine's, none for a table that writes none
# lsda:        language specific data's, likewise
rec Codes {
    personality: opt[u8];
    lsda:        opt[u8];
}

# how the listing writes a windows table's frames
# ---
# on:      whether the format's table is a windows one, its frames written as unwind codes
# written: the open frame's codes
# si:      the next step of them to write
# last:    the offset of the last step written, from which arm64's prologue instructions with no code are counted
rec Windows {
    on:      bool;
    written: seh.Written;
    si:      u32;
    last:    u64;
}

# the state of one listing
# ---
# names:   the spelling of every label, interned once
# spelled: per label, less one, the index of its spelling
# owners:  per spelling, the label it names
# places:  every placed label, in place order
# uses:    per label, less one, how many times the record names it: in a value, a datum, a difference, an equate or a
#          size
# pi:      the next of `places` to write
# scopes:  the views met so far and what states them
# now:     the scope where the text written so far ends
# modes:   the assembler modes where the text written so far ends, the set's initial ones at its start
# saved:   the modes the dialect's push last saved, which its pop restores
# byte:    the one-byte data directive, nil for none
# apart:   the unique numbers given so far, the last of them the latest
# anchors: per section, the number after the dialect's temporary stem of the label the listing states at its start to
#          name it to a section it owns, plus one, 0 for none
# full:    whether the output or a store failed to grow
# stores:  what a statement is read back into, grown to what the largest takes
# lines:   the line facts attached to the builder, restated, nil for none
# locs:    per label, less one, the index of the location it places, plus one, 0 for a label that places none
# spoken:  what the `.loc` lines written so far leave
# fi:      the next frame to begin
# open:    whether a frame is begun and not yet ended
# current: that frame
# ri:      the next rule of the open frame to write
# codes:   the pointer encodings the format's unwind table writes a frame's pointers in
# windows: the unwind codes of a windows table's frames
rec Lister {
    a:       *A.Allocator;
    b:       *build.Builder;
    syntax:  *core_syntax.Syntax;
    dialect: *dialect.Dialect;
    out:     *vector.Vector[u8];
    names:   intern.Interner;
    spelled: vector.Vector[u32];
    owners:  vector.Vector[u32];
    places:  vector.Vector[Placed];
    uses:    vector.Vector[u32];
    pi:      usize;
    scopes:  vector.Vector[Scope];
    now:     Scope;
    modes:   mode.State;
    saved:   mode.State;
    symbols: core_syntax.Symbols;
    byte:    str;
    apart:   u64;
    anchors: vector.Vector[u32];
    full:    bool;
    lines:   *line.Lines;
    locs:    vector.Vector[u32];
    spoken:  line.Spoken;
    fi:      usize;
    open:    bool;
    current: build.Frame;
    ri:      usize;
    codes:   Codes;
    windows: Windows;
    held:    [relax.MAX_STEPS]Held;
    steps:   [relax.MAX_STEPS]inst.Inst;
    markers: [relax.MAX_STEPS]operand.FixupKind;
    stores:  core_syntax.Stores;
    widened: opt[extension.Selection];
}

fun refusal(message: str, section: u32, offset: u64) err[Refusal] {
    ret err[Refusal].err{Refusal{message: message, section: section, offset: offset, label: operand.NO_SYMBOL}};
}

fun whole(message: str) err[Refusal] {
    ret refusal(message, NO_SECTION, 0);
}

fun about(message: str, label: u32) err[Refusal] {
    ret err[Refusal].err{Refusal{message: message, section: NO_SECTION, offset: 0, label: label}};
}

fun held(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# `n` bytes at `p` appended, noting a failure to grow
fun put_bytes(l: *Lister, p: *u8, n: usize) {
    if (!held(vector.reserve[u8](l.out, n))) {
        l.full = true;
        ret;
    }
    var i: usize = 0;
    for (i < n) {
        l.out.data[l.out.len] = p[i];
        vector.commit[u8](l.out, 1);
        i = i + 1;
    }
}

fun put(l: *Lister, s: str) {
    put_bytes(l, s, str_len(s));
}

fun put_view(l: *Lister, v: View) {
    put_bytes(l, v.data, v.len);
}

fun put_char(l: *Lister, c: u8) {
    put_bytes(l, ?c, 1);
}

fun put_unsigned(l: *Lister, value: u64) {
    var digits: [20]u8;
    var n:      u64 = value;
    var at:     u32 = 20;
    for {
        at         = at - 1;
        digits[at] = '0' + (n % 10)::u8;
        n          = n / 10;
        if (n == 0) { brk; }
    }
    put_bytes(l, ?digits[at], (20 - at)::usize);
}

fun put_signed(l: *Lister, value: i64) {
    if (value < 0) {
        put_char(l, '-');
        put_unsigned(l, ~(value:~u64) + 1);
        ret;
    }
    put_unsigned(l, value:~u64);
}

fun put_hex(l: *Lister, b: u8) {
    put(l, "0x");
    put_char(l, "0123456789abcdef"[(b >> 4)::usize]);
    put_char(l, "0123456789abcdef"[(b & 15)::usize]);
}

# a constant added, as `+4` or `-4`, nothing for zero
fun put_addend(l: *Lister, addend: i64) {
    if (addend > 0)  { put_char(l, '+'); }
    if (addend != 0) { put_signed(l, addend); }
}

# `name` written as a string, refused when it holds a quote, a backslash or a control character
fun put_string(l: *Lister, name: View) bool {
    var i: usize = 0;
    for (i < name.len) {
        val c: u8 = name.data[i];
        if (c == '"' || c == '\\' || c < 0x20) { ret false; }
        i = i + 1;
    }
    put_char(l, '"');
    put_view(l, name);
    put_char(l, '"');
    ret true;
}

# whether `c` is a byte a name is written with unquoted
fun name_byte(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '$';
}

# whether `name` is written unquoted, as a section name is
fun plain(name: View) bool {
    if (name.len == 0) { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        if (!name_byte(name.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# label `id`'s name written bare or in quotes, as `masc.syntax.write.name` spells it. the caller refuses a name with no
# spelling first (`spell.spellable`), so only the output failing to grow fails here
fun put_name(l: *Lister, id: u32) {
    var w:     core_syntax.Writer = writer(l, nil, ?l.modes);
    val wrote: err[field.Refusal] = syntax_write.name(?w, name_of(l, id), field.NO_OPERAND);
    if (sel wrote.err) { l.full = true; }
}

# whether label `id`'s name has a spelling, bare or in quotes: it holds no control byte
fun spelled(l: *Lister, id: u32) bool {
    ret spell.spellable(name_of(l, id));
}

# whether `v` starts with `prefix`, which is never empty
fun starts_with(v: View, prefix: str) bool {
    val n: usize = str_len(prefix);
    if (n == 0 || v.len < n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_view(a: View, b: View) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the spelling of label `id`
fun name_of(l: *Lister, id: u32) View {
    ret intern.bytes_of(?l.names, table.Id[intern.Name]{index: l.spelled.data[id::usize - 1]});
}

fun named(context: ptr, id: u32) View {
    ret name_of(context::*Lister, id);
}

# a name the statement being verified prints, resolved to its label. a bare `.` or numbered label's reference is no
# label's name, as the listing spells none of those
fun resolved(context: ptr, name: View, spelling: core_syntax.Spelling) res[core_syntax.Resolved, str] {
    if (sel spelling.bare && spell.reserved(name)) { ret res[core_syntax.Resolved, str].err{"unknown symbol"}; }
    val l:     *Lister                    = context::*Lister;
    val known: opt[table.Id[intern.Name]] = intern.find(?l.names, name.data::*u8, name.len);
    if (sel known.none) { ret res[core_syntax.Resolved, str].err{"unknown symbol"}; }
    ret res[core_syntax.Resolved, str].ok{core_syntax.Resolved.symbol{l.owners.data[known.some.index::usize]}};
}

# the stem followed by `number` in decimal, written to `to`, answering how long it is
fun stemmed(stem: str, number: u32, to: *u8) usize {
    var lead: usize = 0;
    for (stem[lead] != 0) {
        to[lead] = stem[lead];
        lead     = lead + 1;
    }
    var digits: [10]u8;
    var count:  usize = 0;
    var left:   u32   = number;
    for {
        digits[count] = '0' + (left % 10)::u8;
        count         = count + 1;
        left          = left / 10;
        if (left == 0) { brk; }
    }
    var k: usize = 0;
    for (k < count) {
        to[lead + k] = digits[count - 1 - k];
        k            = k + 1;
    }
    ret lead + count;
}

# label `id` given the spelling `name`, refused when another label has it
fun give(l: *Lister, id: u32, name: View) err[Refusal] {
    val before: usize                                 = intern.count(?l.names);
    val made:   res[table.Id[intern.Name], fail.Fail] = intern.intern(?l.names, name.data::*u8, name.len);
    if (sel made.err)                           { ret whole(MEMORY); }
    if (intern.count(?l.names) == before)       { ret about(DUPLICATE, id); }
    if (!held(vector.push[u32](?l.owners, id))) { ret whole(MEMORY); }
    l.spelled.data[id::usize - 1] = made.ok.index;
    ret err[Refusal].ok{};
}

# every label spelled as the object spells it: by its own name, or by the stem and number the builder gives it, the one
# owner of that numbering
fun name_all(l: *Lister) err[Refusal] {
    val count: usize = build.label_count(l.b);
    if (!held(vector.reserve[u32](?l.spelled, count))) { ret whole(MEMORY); }
    var id: usize = 1;
    for (id <= count) {
        vector.push[u32](?l.spelled, UNNAMED);
        id = id + 1;
    }
    id = 1;
    for (id <= count) {
        val own: opt[View] = build.label_name(l.b, build.Label{id: id::u32});
        if (sel own.some) {
            val given: err[Refusal] = give(l, id::u32, own.some);
            if (sel given.err) { ret given; }
        }
        id = id + 1;
    }
    var scratch: [core_syntax.MAX_ANONYMOUS + 10]u8;
    id = 1;
    for (id <= count) {
        val stem: opt[build.Stem] = build.stem_of(l.b, build.Label{id: id::u32});
        if (sel stem.some) {
            val given: err[Refusal] = give(l, id::u32, view(?scratch[0], stemmed(stem.some.stem, stem.some.number, ?scratch[0])));
            if (sel given.err) { ret given; }
        }
        id = id + 1;
    }
    ret err[Refusal].ok{};
}

fun by_place(x: *Placed, y: *Placed) i64 {
    if (x.section != y.section) {
        if (x.section < y.section) { ret -1; }
        ret 1;
    }
    if (x.statement != y.statement) {
        if (x.statement < y.statement) { ret -1; }
        ret 1;
    }
    if (x.order < y.order) { ret -1; }
    if (x.order > y.order) { ret 1; }
    ret 0;
}

# every placed label in place order, those placed alike in the order placed, which a format that splits a section into
# atoms at its symbols reads an atom's end by, made once
fun place_all(l: *Lister) err[Refusal] {
    var id: usize = 1;
    for (id <= build.label_count(l.b)) {
        val spot: opt[build.Spot] = build.spot_of(l.b, build.Label{id: id::u32});
        if (sel spot.some && !held(vector.push[Placed](?l.places, Placed{section: spot.some.section.index, statement: spot.some.statement, order: spot.some.order, id: id::u32}))) { ret whole(MEMORY); }
        id = id + 1;
    }
    sort.sort_by[Placed](l.places.data, l.places.len, by_place);
    ret err[Refusal].ok{};
}

# the directive that enters nameless section `o` by its kind, none for a named section or a kind no directive enters
fun kind_directive(l: *Lister, o: *build.Opened) opt[*dialect.Named] {
    if (sel o.name.some) { ret opt[*dialect.Named].none{}; }
    ret core.kind_directive(build.naming(l.b), l.dialect.sections, o.kind, o.flags, o.disposition, o.entsize);
}

# the name section `s` reads back with: its own, or the spelling of the directive that enters its kind, refused for a
# nameless section of a kind no directive enters
fun listed_name(l: *Lister, s: u32) res[View, Refusal] {
    val o: build.Opened = build.opened(l.b, build.Section{index: s});
    if (sel o.name.some) { ret res[View, Refusal].ok{o.name.some}; }
    val d: opt[*dialect.Named] = kind_directive(l, ?o);
    if (sel d.none) { ret res[View, Refusal].err{Refusal{message: NAMELESS_SECTION, section: s, offset: 0, label: operand.NO_SYMBOL}}; }
    ret res[View, Refusal].ok{View{data: d.some.name, len: str_len(d.some.name)}};
}

fun same_name(a: opt[View], b: opt[View]) bool {
    if (sel a.some) {
        if (sel b.some) { ret same_view(a.some, b.some); }
        ret false;
    }
    ret sel b.none;
}

fun same_section(a: opt[build.Section], b: opt[build.Section]) bool {
    if (sel a.some) {
        if (sel b.some) { ret a.some.index == b.some.index; }
        ret false;
    }
    ret sel b.none;
}

# whether section `s` is the first that reads back named `name` in the comdat group of signature `group` and ordered
# after `owner`, the one the name, the group and the owner alone enter, as the assembler keys a section apart by them
fun first_named(l: *Lister, s: u32, name: View, group: opt[View], owner: opt[build.Section]) bool {
    var k: u32 = 0;
    for (k < s) {
        val other: res[View, Refusal] = listed_name(l, k);
        val sec:   build.Section      = build.Section{index: k};
        k = k + 1;
        if (!(sel other.ok))                                                                                                          { cnt; }
        if (same_view(other.ok, name) && same_name(build.group_of(l.b, sec), group) && same_section(build.owner_of(l.b, sec), owner)) { ret false; }
    }
    ret true;
}

# whether section `s` is first of its name among the sections keyed alike, as `first_named` reads it
fun first_keyed(l: *Lister, s: u32, name: View) bool {
    val sec: build.Section = build.Section{index: s};
    ret first_named(l, s, name, build.group_of(l.b, sec), build.owner_of(l.b, sec));
}

# whether owner `o`'s own name reads back to it from a section opened after it (`model.linked`): a name the section
# alone is entered by, in no group and of no owner, a symbol spells, and that no label has
fun owner_named(l: *Lister, o: u32) bool {
    val sec:    build.Section      = build.Section{index: o};
    val listed: res[View, Refusal] = listed_name(l, o);
    if (sel listed.err) { ret false; }
    val group: opt[View]          = build.group_of(l.b, sec);
    val owner: opt[build.Section] = build.owner_of(l.b, sec);
    if (sel group.some || sel owner.some) { ret false; }
    val name: View = listed.ok;
    if (!first_named(l, o, name, opt[View].none{}, opt[build.Section].none{})) { ret false; }
    if (!spell.spellable(name) || spell.reserved(name))                        { ret false; }
    val known: opt[table.Id[intern.Name]] = intern.find(?l.names, name.data::*u8, name.len);
    ret sel known.none;
}

# every owner its own name does not single out given a label at its start, which the sections it owns name it by,
# spelled by the dialect's temporary stem and the lowest number no label's spelling has. an owner opened after a
# section it owns is refused, as the assembler reads a name back only to a section opened before
fun anchor_owners(l: *Lister) err[Refusal] {
    val count: usize = build.section_count(l.b);
    if (!held(vector.reserve[u32](?l.anchors, count))) { ret whole(MEMORY); }
    var s: usize = 0;
    for (s < count) {
        vector.push[u32](?l.anchors, 0);
        s = s + 1;
    }
    var scratch: [core_syntax.MAX_ANONYMOUS + 10]u8;
    var next:    u32 = 0;
    s = 0;
    for (s < count) {
        val owner: opt[build.Section] = build.owner_of(l.b, build.Section{index: s::u32});
        val at:    u32                = s::u32;
        s = s + 1;
        if (sel owner.none) { cnt; }
        val o: u32 = owner.some.index;
        if (o::usize >= count || o >= at)                       { ret refusal(OWNED, at, 0); }
        if (l.anchors.data[o::usize] != 0 || owner_named(l, o)) { cnt; }
        for {
            val n:     usize                      = stemmed(l.dialect.temporary, next, ?scratch[0]);
            val taken: opt[table.Id[intern.Name]] = intern.find(?l.names, ?scratch[0], n);
            next = next + 1;
            if (sel taken.none) { brk; }
        }
        l.anchors.data[o::usize] = next;
    }
    ret err[Refusal].ok{};
}

# the name a section owned by section `o` names it by: its own, or its anchor's, spelled into `scratch`, which holds
# the stem and ten digits. `sections_read` has read every section's name
fun owner_name(l: *Lister, o: u32, scratch: *u8) View {
    if (l.anchors.data[o::usize] != 0) { ret view(scratch, stemmed(l.dialect.temporary, l.anchors.data[o::usize] - 1, scratch)); }
    val listed: res[View, Refusal] = listed_name(l, o);
    if (sel listed.err) { ret View{data: nil, len: 0}; }
    ret listed.ok;
}

# `name` written as a symbol's name, bare or in quotes
fun put_spelled(l: *Lister, name: View) {
    var w:     core_syntax.Writer = writer(l, nil, ?l.modes);
    val wrote: err[field.Refusal] = syntax_write.name(?w, name, field.NO_OPERAND);
    if (sel wrote.err) { l.full = true; }
}

# whether the sections are those the assembler opens reading them in order: each section after the first of a name, a
# nameless one going by the name its directive reads back with, one the dialect keeps apart. the assembler opens its
# starting section only when something is written to it or a directive names it, and every section's header names it,
# so the first section may be any
fun sections_read(l: *Lister) err[Refusal] {
    val count: usize = build.section_count(l.b);
    var s:     usize = 0;
    for (s < count) {
        val name: res[View, Refusal] = listed_name(l, s::u32);
        if (sel name.err)                                                  { ret err[Refusal].err{name.err}; }
        if (sel l.dialect.unique.none && !first_keyed(l, s::u32, name.ok)) { ret refusal(TWICE, s::u32, 0); }
        s = s + 1;
    }
    ret err[Refusal].ok{};
}

# `.name` followed by label `id`'s spelling
fun directive(l: *Lister, name: str, id: u32) {
    put_char(l, '\t');
    put(l, name);
    put_char(l, ' ');
    put_name(l, id);
}

# the line facts' file table as its `.file` lines, and per label the location it places
fun files(l: *Lister) err[Refusal] {
    if (l.lines == nil)                                              { ret err[Refusal].ok{}; }
    if (l.lines.builder != nil && l.lines.builder != l.b)            { ret whole(RECORDS); }
    if (!held(vector.reserve[u32](?l.locs, build.label_count(l.b)))) { ret whole(MEMORY); }
    var id: usize = 0;
    for (id < build.label_count(l.b)) {
        vector.push[u32](?l.locs, 0);
        id = id + 1;
    }
    var k: usize = 0;
    for (k < line.mark_count(l.lines)) {
        val at: u32 = line.mark_at(l.lines, k).at.id;
        if (at == 0 || at::usize > l.locs.len) { ret whole(RECORDS); }
        l.locs.data[at::usize - 1] = (k + 1)::u32;
        k                          = k + 1;
    }
    var i: u32 = 0;
    for (i < line.file_count(l.lines)) {
        val start: usize    = l.out.len;
        val wrote: err[str] = line.put_file(l.out, i, line.file_at(l.lines, i));
        if (sel wrote.err) {
            vector.truncate[u8](l.out, start);
            ret whole(wrote.err);
        }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the source files the object names
fun sources(l: *Lister) err[Refusal] {
    var i: usize = 0;
    for (i < build.source_count(l.b)) {
        put(l, "\t.file ");
        if (!put_string(l, build.source_at(l.b, i))) { ret whole(QUOTED); }
        put_char(l, '\n');
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the expression `plus - minus + addend` of difference `d`
fun put_difference(l: *Lister, d: build.Difference) {
    put_name(l, d.plus.id);
    put(l, " - ");
    put_name(l, d.minus.id);
    if (d.addend > 0) { put(l, " + "); }
    if (d.addend < 0) {
        put(l, " - ");
        put_unsigned(l, ~(d.addend:~u64) + 1);
    }
    or (d.addend > 0) { put_unsigned(l, d.addend:~u64); }
}

# whether the labels a difference names read as symbols
fun spells_difference(l: *Lister, d: build.Difference) bool {
    ret spelled(l, d.plus.id) && spelled(l, d.minus.id);
}

# the declarations of label `id`: what makes it a symbol, and the value it is given in place of a place
fun declare(l: *Lister, id: u32) err[Refusal] {
    if (locates(l, id)) { ret err[Refusal].ok{}; }
    val lb:    build.Label         = build.Label{id: id};
    val shown: opt[build.Exposure] = build.exposure_of(l.b, lb);
    val value: opt[build.Value]    = build.value_of(l.b, lb);
    val spot:  opt[build.Spot]     = build.spot_of(l.b, lb);
    val own:   opt[View]           = build.label_name(l.b, lb);
    val name:  View                = name_of(l, id);
    if (sel shown.none && sel value.none && sel spot.none) { ret err[Refusal].ok{}; }
    if (!spelled(l, id))                                   { ret about(UNSPELLED, id); }
    # the assembler makes a symbol of every label it holds whose name is not private
    if (sel shown.none && !starts_with(name, l.dialect.private)) { ret about(NAMED_LOCAL, id); }
    if (sel shown.some) {
        val e: build.Exposure = shown.some;
        if (e.binding == ?symbol.LOCAL) {
            if (starts_with(name, l.dialect.private)) { ret about(PRIVATE, id); }
            if (!build.bound(l.b, lb))                { ret about(UNDEFINED, id); }
        }
        # a local binding is stated by none where the dialect binds a symbol locally by binding it no other way, and a
        # weak external with a fallback by the directive of its search
        var binding: opt[str] = core.binding_directive(e.binding);
        if (e.binding == ?symbol.LOCAL) {
            binding = opt[str].none{};
            if (l.dialect.local != nil) { binding = opt[str].some{l.dialect.local}; }
        }
        if (sel value.some) {
            if (sel value.some.fallback) {
                binding = core.search_directive(value.some.fallback.search);
                if (sel binding.none) { ret about(SEARCH, id); }
            }
        }
        if (sel binding.some) {
            directive(l, binding.some, id);
            put_char(l, '\n');
        }
        or (e.binding != ?symbol.LOCAL) { ret about(BINDING, id); }
        if (e.visibility != ?symbol.DEFAULT) {
            val v: opt[str] = core.visibility_directive(e.visibility);
            if (sel v.none) { ret about(VISIBILITY, id); }
            directive(l, v.some, id);
            put_char(l, '\n');
        }
        # common storage takes a kind of its own when none is stated
        var common: bool = false;
        if (sel value.some) { common = sel value.some.common; }
        if (e.kind != ?symbol.NOTYPE || common) {
            val t: opt[str] = core.type_spelling(e.kind);
            if (sel t.none) { ret about(TYPE, id); }
            directive(l, ".type", id);
            put(l, ", ");
            put_char(l, l.b.set.source.types[0]);
            put(l, t.some);
            put_char(l, '\n');
        }
        val size: build.Size = e.size;
        if (sel size.fixed) {
            directive(l, ".size", id);
            put(l, ", ");
            put_unsigned(l, size.fixed);
            put_char(l, '\n');
        }
        if (sel size.measured) {
            if (!spells_difference(l, size.measured)) { ret about(UNSPELLED, id); }
            directive(l, ".size", id);
            put(l, ", ");
            put_difference(l, size.measured);
            put_char(l, '\n');
        }
    }
    if (sel value.none) { ret err[Refusal].ok{}; }
    val v: build.Value = value.some;
    if (sel v.absolute) {
        directive(l, ".set", id);
        put(l, ", ");
        put_signed(l, v.absolute:~i64);
        put_char(l, '\n');
    }
    if (sel v.common) {
        directive(l, ".comm", id);
        put(l, ", ");
        put_unsigned(l, v.common.size);
        put(l, ", ");
        put_unsigned(l, v.common.align);
        put_char(l, '\n');
    }
    if (sel v.equate) {
        if (!spelled(l, v.equate.target)) { ret about(UNSPELLED, v.equate.target); }
        directive(l, ".set", id);
        put(l, ", ");
        put_name(l, v.equate.target);
        put_addend(l, v.equate.addend);
        put_char(l, '\n');
    }
    if (sel v.fallback) {
        if (!spelled(l, v.fallback.target)) { ret about(UNSPELLED, v.fallback.target); }
        directive(l, ".set", id);
        put(l, ", ");
        put_name(l, v.fallback.target);
        put_char(l, '\n');
    }
    ret err[Refusal].ok{};
}

# directive `d` of the dialect written as a statement starts, its name and its word
fun put_directive(l: *Lister, d: *source.Directive) {
    put_char(l, '\t');
    val spelled: err[A.Error] = source.spell(d, l.out);
    if (sel spelled.err) { l.full = true; }
}

# directive `d` of the dialect written as a whole statement
fun put_line(l: *Lister, d: *source.Directive) {
    put_directive(l, d);
    put_char(l, '\n');
}

# the dialect's restatement `d` written stating selection `s` whole, in the spelling its catalog reads
fun put_restate(l: *Lister, d: *source.Directive, s: *extension.Selection) {
    put_directive(l, d);
    if (d.operands.word != nil && d.operands.word[0] != 0) { put(l, ", "); }
    or                                                     { put(l, " "); }
    val spelled: err[A.Error] = extension.spell_versioned(s, l.out);
    if (sel spelled.err) { l.full = true; }
    put_char(l, '\n');
}

# the scope of the object's own context
fun object_scope(l: *Lister) Scope {
    ret Scope{v: build.object_of(l.b), mask: 0, restated: false, states: 0, stated: true};
}

# the index of the dialect's directive that ends narrowing `i` of selection `s`: a widening of what `s` holds that the
# narrowing takes away, none when the dialect has none
fun lift_of(l: *Lister, i: u32, s: *extension.Selection) opt[u32] {
    val ds: source.Directives = l.b.set.source.directives;
    var j:  u32               = 0;
    for (j < ds.len) {
        val w: source.Edit = ds.at[j].edit;
        if (sel w.widen && narrow.lifts(l.a, ds, i, s, w.widen)) { ret opt[u32].some{j}; }
        j = j + 1;
    }
    ret opt[u32].none{};
}

# the index of the dialect's directive that sets axis `axis` to `value`, none when it has none
fun state_index(ds: source.Directives, axis: u32, value: u8) opt[u32] {
    var i: u32 = 0;
    for (i < ds.len) {
        val e: source.Edit = ds.at[i].edit;
        if (sel e.state && (e.state.axis == axis && e.state.value == value)) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the dialect's state directives that move the axes from `from` to `to`, one bit each by index, and whether it has them
# all
fun states_between(ds: source.Directives, axes: *state.Axes, from: state.Settings, to: state.Settings, bits: *u64) bool {
    var all: bool = true;
    var a:   u32  = 0;
    for (a < axes.len) {
        if (from.at[a] != to.at[a]) {
            val d: opt[u32] = state_index(ds, a, to.at[a]);
            if (sel d.some) { @bits = @bits | source.bit(d.some); }
            or              { all = false; }
        }
        a = a + 1;
    }
    ret all;
}

# what states context `v` from the object's: the narrowings of the dialect that take what the object's selection holds
# and `v` lacks, when they make exactly `v`'s selection, else the dialect's restatement of `v`'s selection whole, and
# then the state directives of every axis `v` holds another value on, when the text can end them all. the scope is made
# the first time the context is met
fun scope_of(l: *Lister, v: *state.Context) res[Scope, Refusal] {
    val object: *state.Context = build.object_of(l.b);
    if (v == object) { ret res[Scope, Refusal].ok{object_scope(l)}; }
    var i: usize = 0;
    for (i < l.scopes.len) {
        if (l.scopes.data[i].v == v) { ret res[Scope, Refusal].ok{l.scopes.data[i]}; }
        i = i + 1;
    }
    val ds: source.Directives = l.b.set.source.directives;
    # the instructions the text states the object by widen the selection every statement after them is read under
    if (sel l.widened.some) {
        val wide: *extension.Selection = ?l.widened.some;
        if (extension.within(v.selection, wide) && extension.within(wide, v.selection)) {
            var plain: Scope = Scope{v: v, mask: 0, restated: false, states: 0, stated: true};
            var back:  u64   = 0;
            plain.stated = states_between(ds, v.axes, object.values, v.values, ?plain.states) && states_between(ds, v.axes, v.values, object.values, ?back);
            if (!held(vector.push[Scope](?l.scopes, plain))) { ret res[Scope, Refusal].err{Refusal{message: MEMORY, section: NO_SECTION, offset: 0, label: operand.NO_SYMBOL}}; }
            ret res[Scope, Refusal].ok{plain};
        }
    }
    val push:    opt[*source.Directive] = source.push_of(ds);
    val stacked: bool                   = sel push.some;
    var got:     Scope                  = Scope{v: v, mask: 0, restated: false, states: 0, stated: true};
    var lifted:  bool                   = true;
    var n:       u32                    = 0;
    for (n < ds.len) {
        val e: source.Edit = ds.at[n].edit;
        if (sel e.narrow && (narrow.narrows(object.selection, e.narrow) && !narrow.narrows(v.selection, e.narrow))) {
            got.mask = got.mask | source.bit(n);
            if (!stacked) {
                val lift: opt[u32] = lift_of(l, n, object.selection);
                lifted = lifted && sel lift.some;
            }
        }
        n = n + 1;
    }
    var same: bool = false;
    if (got.mask == 0) { same = extension.within(v.selection, object.selection) && extension.within(object.selection, v.selection); }
    or {
        val made: res[*narrow.Narrowed, state.Opened] = narrow.make(l.a, object, ds, got.mask);
        if (sel made.err) { ret res[Scope, Refusal].err{Refusal{message: MEMORY, section: NO_SECTION, offset: 0, label: operand.NO_SYMBOL}}; }
        val s: *extension.Selection = ?made.ok.selection;
        same = lifted && extension.within(v.selection, s) && extension.within(s, v.selection);
        narrow.release(l.a, made.ok);
    }
    var base: state.Settings = object.values;
    if (!same) {
        val re: opt[*source.Directive] = source.restate_of(ds);
        got.mask     = 0;
        got.restated = true;
        got.stated   = sel re.some;
        # a restated selection's spelling may state values of its own
        val read_: res[state.Context, state.Error] = state.make(v.selection, v.axes, object.values);
        if (sel read_.ok) { base = read_.ok.values; }
        or                { got.stated = false; }
    }
    var back: u64  = 0;
    val ends: bool = stacked || states_between(ds, v.axes, v.values, object.values, ?back);
    got.stated = got.stated && states_between(ds, v.axes, base, v.values, ?got.states) && ends;
    if (!held(vector.push[Scope](?l.scopes, got))) { ret res[Scope, Refusal].err{Refusal{message: MEMORY, section: NO_SECTION, offset: 0, label: operand.NO_SYMBOL}}; }
    ret res[Scope, Refusal].ok{got};
}

# the dialect's directives of mask `bits` written in order of index
fun put_marked(l: *Lister, bits: u64) {
    val ds: source.Directives = l.b.set.source.directives;
    var n:  u32               = 0;
    for (n < ds.len) {
        if ((bits & source.bit(n)) != 0) { put_line(l, ?ds.at[n]); }
        n = n + 1;
    }
}

# whether scope `sc` states nothing the object's context does not, as a context of the object's own selection and state
fun plain_scope(sc: *Scope) bool {
    ret sc.mask == 0 && !sc.restated && sc.states == 0;
}

# the directives that move the text from the scope in force to `to` written: the scope in force ended, by the pop or
# else by undoing each of its directives, and `to` entered after a push
fun enter(l: *Lister, to: Scope) {
    var into: Scope = to;
    if (to.v == l.now.v || (plain_scope(?into) && plain_scope(?l.now))) {
        l.now = to;
        ret;
    }
    val ds:     source.Directives      = l.b.set.source.directives;
    val object: *state.Context         = build.object_of(l.b);
    val push:   opt[*source.Directive] = source.push_of(ds);
    val pop:    opt[*source.Directive] = source.pop_of(ds);
    val re:     opt[*source.Directive] = source.restate_of(ds);
    if (!plain_scope(?l.now)) {
        if (sel pop.some) {
            put_line(l, pop.some);
            l.modes = l.saved;
        }
        or {
            if (sel re.some) {
                if (l.now.restated) { put_restate(l, re.some, object.selection); }
            }
            var n: u32 = 0;
            for (n < ds.len) {
                if ((l.now.mask & source.bit(n)) != 0) {
                    val lift: opt[u32] = lift_of(l, n, object.selection);
                    if (sel lift.some) { put_line(l, ?ds.at[lift.some]); }
                }
                n = n + 1;
            }
            var back: u64  = 0;
            val all:  bool = states_between(ds, object.axes, l.now.v.values, object.values, ?back);
            put_marked(l, back);
        }
    }
    if (!plain_scope(?into)) {
        if (sel push.some) {
            put_line(l, push.some);
            l.saved = l.modes;
        }
        if (sel re.some) {
            if (to.restated) { put_restate(l, re.some, to.v.selection); }
        }
        put_marked(l, to.mask);
        put_marked(l, to.states);
    }
    l.now = to;
}

# the text moved to the view `v` and the assembler modes `m` statement `at` of section `s` was written under, the
# modes after the view, as ending a view's scope by the dialect's pop restores the modes its push saved
fun under(l: *Lister, v: *state.Context, m: *mode.State, s: u32, at: u64) err[Refusal] {
    val got: res[Scope, Refusal] = scope_of(l, v);
    if (sel got.err)    { ret err[Refusal].err{got.err}; }
    if (!got.ok.stated) { ret refusal(VIEW, s, at); }
    enter(l, got.ok);
    ret moded(l, m, s, at);
}

# the directive of the dialect that sets mode `m` to value `v`, none when it has none
fun mode_directive(l: *Lister, m: *mode.Mode, v: *mode.Value) opt[*source.Directive] {
    val ds: source.Directives = l.b.set.source.directives;
    var i:  u32               = 0;
    for (i < ds.len) {
        val e: source.Edit = ds.at[i].edit;
        if (sel e.mode && (e.mode.mode == m && e.mode.value == v)) { ret opt[*source.Directive].some{?ds.at[i]}; }
        i = i + 1;
    }
    ret opt[*source.Directive].none{};
}

# the text moved to the assembler modes `m` statement `at` of section `s` was written under, by the dialect's directive
# of each mode that holds another value where the text ends, in the order of the set's modes
fun moded(l: *Lister, m: *mode.State, s: u32, at: u64) err[Refusal] {
    var i: u32 = 0;
    for (i < m.modes.len && i < mode.MAX_MODES) {
        if (l.modes.values[i] != m.values[i]) {
            val d: opt[*source.Directive] = mode_directive(l, m.modes.at[i], m.values[i]);
            if (sel d.none) { ret refusal(MODES, s, at); }
            put_line(l, d.some);
            l.modes.values[i] = m.values[i];
        }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the `.section` that opens section `s` in the dialect's grammar, or the directive that enters a nameless one by its
# kind. a section in a comdat group states its group, and a section after the first of its name is opened apart by the
# dialect's next unique number
fun header(l: *Lister, s: u32) err[Refusal] {
    # a typed stream's text states a module, never a section
    if (l.b.set.codec.stream != nil) { ret err[Refusal].ok{}; }
    val sec:    build.Section      = build.Section{index: s};
    val o:      build.Opened       = build.opened(l.b, sec);
    val listed: res[View, Refusal] = listed_name(l, s);
    if (sel listed.err) { ret err[Refusal].err{listed.err}; }
    val name:  View               = listed.ok;
    val first: bool               = first_keyed(l, s, name);
    val owner: opt[build.Section] = build.owner_of(l.b, sec);
    val group: opt[View]          = build.group_of(l.b, sec);
    if (sel o.name.none && first && sel owner.none && sel group.none) {
        val d: opt[*dialect.Named] = kind_directive(l, ?o);
        if (sel d.none) { ret refusal(NAMELESS_SECTION, s, 0); }
        put_char(l, '\t');
        put(l, d.some.directive);
        put_char(l, '\n');
        ret err[Refusal].ok{};
    }
    val led:    bool             = build.associated(l.b, sec);
    val rule:   *mink_group.Rule = build.group_rule(l.b, sec);
    val unique: opt[str]         = l.dialect.unique;
    if (!first && sel unique.none)            { ret refusal(TWICE, s, 0); }
    if (o.disposition != ?mink_section.WHOLE) { ret refusal(DISPOSITION, s, 0); }
    val form: dialect.Form = l.dialect.sections.form;
    if (sel form.macho || sel form.coff) {
        # coff ties a section to another only by an associative selection, and mach-o by none
        if (sel owner.some && !(led && sel form.coff)) { ret refusal(OWNED, s, 0); }
        var wrote: err[core.Unwritten] = err[core.Unwritten].ok{};
        if (sel form.macho) { wrote = core.macho_header(l.out, build.naming(l.b), l.dialect.sections, name, o.kind, o.flags, o.entsize, pointer_width(l), sel group.some); }
        or {
            var by:      opt[View] = group;
            var scratch: [core_syntax.MAX_ANONYMOUS + 10]u8;
            if (sel owner.some) {
                if (led) { by = opt[View].some{owner_name(l, owner.some.index, ?scratch[0])}; }
            }
            wrote = core.coff_header(l.out, build.naming(l.b), l.dialect.sections, name, o.kind, o.flags, o.entsize, by, rule);
        }
        if (sel wrote.err) { ret refusal(unwritten(wrote.err), s, 0); }
        ret err[Refusal].ok{};
    }
    if (led)                                       { ret refusal(OWNED, s, 0); }
    if (sel group.some && rule != ?mink_group.ANY) { ret refusal(GROUPED, s, 0); }
    val t: opt[str] = core.section_type(build.naming(l.b), name, o.kind, o.flags, o.entsize);
    if (sel t.none) { ret refusal(SECTION, s, 0); }
    var letters: [core.FLAG_LETTERS]u8;
    val n:       opt[usize] = core.flag_string(o.flags, ?letters[0]);
    if (sel n.none) { ret refusal(SECTION, s, 0); }
    put(l, "\t.section ");
    if (plain(name))          { put_view(l, name); }
    or (!put_string(l, name)) { ret refusal(QUOTED, s, 0); }
    put(l, ", \"");
    put_bytes(l, ?letters[0], n.some);
    if (sel owner.some) { put_char(l, core.ORDER_LETTER); }
    if (sel group.some) { put_char(l, core.GROUP_LETTER); }
    put(l, "\", ");
    put_char(l, l.b.set.source.types[0]);
    put(l, t.some);
    if (o.entsize != 0) {
        put(l, ", ");
        put_unsigned(l, o.entsize);
    }
    if (sel owner.some) {
        var scratch: [core_syntax.MAX_ANONYMOUS + 10]u8;
        put(l, ", ");
        put_spelled(l, owner_name(l, owner.some.index, ?scratch[0]));
    }
    if (sel group.some) {
        put(l, ", ");
        if (plain(group.some))          { put_view(l, group.some); }
        or (!put_string(l, group.some)) { ret refusal(QUOTED, s, 0); }
        put(l, ", ");
        put(l, core.COMDAT);
    }
    if (sel unique.some) {
        if (!first) {
            l.apart = l.apart + 1;
            put(l, ", ");
            put(l, unique.some);
            put(l, ", ");
            put_unsigned(l, l.apart);
        }
    }
    put_char(l, '\n');
    ret err[Refusal].ok{};
}

# the refusal of a header the dialect's writer did not write
fun unwritten(u: core.Unwritten) str {
    if (sel u.quoted)  { ret QUOTED; }
    if (sel u.grouped) { ret GROUPED; }
    if (sel u.memory)  { ret MEMORY; }
    ret SECTION;
}

# the width of a pointer of the object's architecture
fun pointer_width(l: *Lister) u64 {
    val p: opt[mink_arch.Pointer] = l.b.arch.pointer;
    if (sel p.none) { ret 0; }
    ret p.some.bytes::u64;
}

# label `id` written where it is placed, at `at` of section `s`
fun label_line(l: *Lister, id: u32, s: u32, at: u64) err[Refusal] {
    if (!spelled(l, id)) { ret err[Refusal].err{Refusal{message: UNSPELLED, section: s, offset: at, label: id}}; }
    put_name(l, id);
    put(l, ":\n");
    ret err[Refusal].ok{};
}

# whether label `id` places a location, which is written as its `.loc` and is no label of the text
fun locates(l: *Lister, id: u32) bool {
    ret id::usize <= l.locs.len && l.locs.data[id::usize - 1] != 0;
}

# the location placed by label `id` written as its `.loc`
fun loc_line(l: *Lister, k: u32, s: u32, at: u64) err[Refusal] {
    val m:     *line.Mark = line.mark_at(l.lines, k::usize);
    val start: usize      = l.out.len;
    val wrote: err[str]   = line.put_loc(l.out, m.loc, ?l.spoken);
    if (sel wrote.err) {
        vector.truncate[u8](l.out, start);
        ret refusal(wrote.err, s, at);
    }
    ret err[Refusal].ok{};
}

# the labels placed before statement `j` of section `s`, at `at`, but label `skip`, which the statement there binds
# itself, and label `last` written after the others, which a frame begun there names its function by, each
# operand.NO_SYMBOL for none. a label that places a location is written as its `.loc`, and a `last` placed elsewhere is
# refused
fun labels_at(l: *Lister, s: u32, j: u32, at: u64, skip: u32, last: u32) err[Refusal] {
    var found: bool = false;
    for (l.pi < l.places.len && l.places.data[l.pi].section == s && l.places.data[l.pi].statement == j) {
        val id: u32 = l.places.data[l.pi].id;
        l.pi = l.pi + 1;
        if (id == skip) { cnt; }
        if (id == last) {
            found = true;
            cnt;
        }
        if (locates(l, id)) {
            val located: err[Refusal] = loc_line(l, l.locs.data[id::usize - 1] - 1, s, at);
            if (sel located.err) { ret located; }
            cnt;
        }
        val wrote: err[Refusal] = label_line(l, id, s, at);
        if (sel wrote.err) { ret wrote; }
    }
    if (last == operand.NO_SYMBOL) { ret err[Refusal].ok{}; }
    if (!found)                    { ret err[Refusal].err{Refusal{message: FRAME_FUNCTION, section: s, offset: at, label: last}}; }
    ret label_line(l, last, s, at);
}

# the pointer encoding the format's unwind table writes `field` in, its slot bit left to the pointer's own, none for a
# table that writes no such field
fun field_code(field: opt[pointer.Field]) opt[u8] {
    if (sel field.none) { ret opt[u8].none{}; }
    var e: pointer.Encoding = field.some.encoding;
    e.indirect = false;
    ret opt[u8].some{pointer.code(e)};
}

# how the format's runtime unwind table writes a frame, read from mink's lowering row: as the dwarf table call frame
# directives state, its personality and language data pointers in the table's encodings, as the windows table unwind
# codes state, or by no directive the listing writes. a compact table states the dwarf table it falls back to
fun frame_spelling(l: *Lister) err[Refusal] {
    val known: res[*registration.Registration, fail.Fail] = registry.by_format(l.b.formats, l.b.format);
    if (sel known.err) { ret whole(FRAMES); }
    val lowering: opt[*lower.Lowering] = known.ok.lowering;
    if (sel lowering.none)            { ret whole(FRAMES); }
    if (sel lowering.some.frame.none) { ret whole(FRAMES); }
    val offer: opt[*lower.FrameOffer] = lower.offer(?lowering.some.frame.some, ?frame.UNWIND);
    if (sel offer.none) { ret whole(FRAMES); }
    val form: lower.FrameForm = offer.some.form;
    var row:  lower.DwarfFrame;
    if (sel form.dwarf_eh) { row = form.dwarf_eh; }
    or (sel form.compact) {
        val fallback: lower.FrameForm = @form.compact.fallback;
        if (!sel fallback.dwarf_eh) { ret whole(FRAMES); }
        row = fallback.dwarf_eh;
    }
    or (sel form.windows || sel form.win64 || sel form.arm64_xdata) {
        val machine: opt[seh.Machine] = seh.machine_of(l.b.arch);
        if (sel machine.none) { ret whole(seh.NO_UNWIND); }
        l.windows.on = true;
        ret err[Refusal].ok{};
    }
    or { ret whole(FRAMES); }
    l.codes.personality = field_code(row.personality);
    l.codes.lsda        = field_code(row.lsda);
    ret err[Refusal].ok{};
}

# the frames checked against what the text states of them: in the order of their sections and starts, as the text
# begins them, each rule one a directive states, and the encodings the format writes their pointers in
fun frames_read(l: *Lister) err[Refusal] {
    val count: usize = build.frame_count(l.b);
    if (count == 0) { ret err[Refusal].ok{}; }
    val spelled: err[Refusal] = frame_spelling(l);
    if (sel spelled.err) { ret spelled; }
    var i: usize = 0;
    for (i < count) {
        val f: build.Frame = build.frame_at(l.b, i);
        if (i > 0) {
            val p: build.Frame = build.frame_at(l.b, i - 1);
            if (p.section.index > f.section.index || (p.section.index == f.section.index && p.end > f.start)) { ret refusal(FRAME_ORDER, f.section.index, 0); }
        }
        if (l.windows.on) {
            i = i + 1;
            cnt;
        }
        if (sel f.personality.some) {
            if (sel l.codes.personality.none) { ret about(FRAMES, f.personality.some.label.id); }
        }
        if (sel f.lsda.some) {
            if (sel l.codes.lsda.none) { ret about(FRAMES, f.lsda.some.label.id); }
        }
        var k: usize = 0;
        for (k < f.count) {
            val r:    build.Rule = build.rule_at(l.b, f.rules + k);
            val rule: frame.Rule = r.rule;
            if (sel rule.def_cfa_scaled || sel rule.scaled || sel rule.prologue_end || sel rule.epilogue) { ret refusal(FRAME_RULE, f.section.index, 0); }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the tables the frames are written to, as `.cfi_sections` names them, when the source stated them
fun frame_tables(l: *Lister) {
    val to: opt[frame.Destinations] = build.frame_to(l.b);
    if (sel to.none) { ret; }
    put(l, "\t.cfi_sections");
    var first: bool  = true;
    var i:     usize = 0;
    for (i < frame.DESTINATION_COUNT) {
        val d: *frame.Destination = frame.DESTINATIONS[i];
        i = i + 1;
        if (!frame.has(to.some, d)) { cnt; }
        if (first)                  { put_char(l, ' '); }
        or                          { put(l, ", "); }
        put(l, d.name);
        first = false;
    }
    put_char(l, '\n');
}

# dwarf register `n` by its name in the set's syntax, refused when it names no register of the object's context or the
# syntax names none
fun put_register(l: *Lister, n: u16, s: u32, at: u64) err[Refusal] {
    val reg: res[rf.Id, build.Refusal] = cfi.numbered(l.b, n::u32);
    if (sel reg.err) { ret refusal(reg.err.message, s, at); }
    var w:     core_syntax.Writer = writer(l, build.object_of(l.b), ?l.modes);
    val wrote: err[field.Refusal] = syntax_write.register_name(?w, reg.ok, field.NO_OPERAND);
    if (sel wrote.err) { ret refusal(UNNAMED_REGISTER, s, at); }
    ret err[Refusal].ok{};
}

# `.name register, offset`
fun put_saved(l: *Lister, name: str, o: frame.Offset, s: u32, at: u64) err[Refusal] {
    put(l, name);
    val r: err[Refusal] = put_register(l, o.reg, s, at);
    if (sel r.err) { ret r; }
    put(l, ", ");
    put_signed(l, o.offset);
    put_char(l, '\n');
    ret err[Refusal].ok{};
}

# `.name register`
fun put_alone(l: *Lister, name: str, n: u16, s: u32, at: u64) err[Refusal] {
    put(l, name);
    val r: err[Refusal] = put_register(l, n, s, at);
    if (sel r.err) { ret r; }
    put_char(l, '\n');
    ret err[Refusal].ok{};
}

# frame rule `rule` as the `.cfi_` directive that states it, at `at` of section `s`
fun frame_rule(l: *Lister, rule: frame.Rule, s: u32, at: u64) err[Refusal] {
    if (sel rule.def_cfa)       { ret put_saved(l, "\t.cfi_def_cfa ", rule.def_cfa, s, at); }
    or (sel rule.cfa_register)  { ret put_alone(l, "\t.cfi_def_cfa_register ", rule.cfa_register, s, at); }
    or (sel rule.offset)        { ret put_saved(l, "\t.cfi_offset ", rule.offset, s, at); }
    or (sel rule.val_offset)    { ret put_saved(l, "\t.cfi_val_offset ", rule.val_offset, s, at); }
    or (sel rule.same)          { ret put_alone(l, "\t.cfi_same_value ", rule.same, s, at); }
    or (sel rule.undefined)     { ret put_alone(l, "\t.cfi_undefined ", rule.undefined, s, at); }
    or (sel rule.restore)       { ret put_alone(l, "\t.cfi_restore ", rule.restore, s, at); }
    or (sel rule.remember)      { put(l, "\t.cfi_remember_state\n"); }
    or (sel rule.restore_state) { put(l, "\t.cfi_restore_state\n"); }
    or (sel rule.cfa_offset) {
        put(l, "\t.cfi_def_cfa_offset ");
        put_signed(l, rule.cfa_offset);
        put_char(l, '\n');
    }
    or (sel rule.register) {
        put(l, "\t.cfi_register ");
        val r: err[Refusal] = put_register(l, rule.register.reg, s, at);
        if (sel r.err) { ret r; }
        put(l, ", ");
        val from: err[Refusal] = put_register(l, rule.register.from, s, at);
        if (sel from.err) { ret from; }
        put_char(l, '\n');
    }
    or (sel rule.expression) {
        val e: store.Held = rule.expression;
        if (!sel e.borrowed) { ret refusal(FRAME_RULE, s, at); }
        put(l, "\t.cfi_escape ");
        var i: usize = 0;
        for (i < e.borrowed.len) {
            if (i > 0) { put(l, ", "); }
            put_hex(l, e.borrowed.data[i]);
            i = i + 1;
        }
        put_char(l, '\n');
    }
    or { ret refusal(FRAME_RULE, s, at); }
    ret err[Refusal].ok{};
}

# a frame's pointer as `.cfi_personality` or `.cfi_lsda` states it: the table's encoding, a slot's when it is through
# one, and its label
fun frame_pointer(l: *Lister, name: str, code: u8, p: build.Pointed, s: u32, at: u64) err[Refusal] {
    if (!spelled(l, p.label.id)) { ret err[Refusal].err{Refusal{message: UNSPELLED, section: s, offset: at, label: p.label.id}}; }
    var c: u8 = code;
    if (p.indirect) { c = c | pointer.INDIRECT; }
    put(l, name);
    put_hex(l, c);
    put(l, ", ");
    put_name(l, p.label.id);
    put_char(l, '\n');
    ret err[Refusal].ok{};
}

# the rules of the open frame stated before statement `j`
fun frame_rules(l: *Lister, j: u32, s: u32, at: u64) err[Refusal] {
    if (!l.open) { ret err[Refusal].ok{}; }
    val f: build.Frame = l.current;
    for (l.ri < f.rules + f.count) {
        val r: build.Rule = build.rule_at(l.b, l.ri);
        if (r.at != j) { brk; }
        if (!l.windows.on) {
            val wrote: err[Refusal] = frame_rule(l, r.rule, s, at);
            if (sel wrote.err) { ret wrote; }
        }
        l.ri = l.ri + 1;
    }
    if (l.windows.on) { ret unwind_step(l, j, s, at); }
    ret err[Refusal].ok{};
}

# what the open frame's prologue states before statement `j`, at `at` of section `s`: on arm64 a `.seh_nop` after each
# prologue instruction since the last statement that states no code, each right after its own instruction, then the
# codes of the step there when one is, then the end of the prologue when it ends there
fun unwind_step(l: *Lister, j: u32, s: u32, at: u64) err[Refusal] {
    val w: *seh.Written = ?l.windows.written;
    if (l.windows.si >= w.count) { ret err[Refusal].ok{}; }
    val step:  *seh.Step = ?w.steps[l.windows.si::usize];
    val coded: bool      = step.at == j && step.codes.len > 0;
    if (sel w.machine.arm64) {
        val gap: u64 = at - l.windows.last;
        if (gap % 4 != 0) { ret refusal(UNEVEN, s, at); }
        var nops: u64 = gap / 4;
        if (coded && nops > 0) { nops = nops - 1; }
        for (nops > 0) {
            put(l, "\t.seh_nop\n");
            nops = nops - 1;
        }
    }
    l.windows.last = at;
    if (step.at != j) { ret err[Refusal].ok{}; }
    l.windows.si = l.windows.si + 1;
    var c: u32 = 0;
    for (c < step.codes.len) {
        val wrote: err[Refusal] = unwind_code(l, w.machine, step.codes.at[c::usize], s, at);
        if (sel wrote.err) { ret wrote; }
        c = c + 1;
    }
    if (step.end) { put(l, "\t.seh_endprologue\n"); }
    ret err[Refusal].ok{};
}

# dwarf register `n` by its name in the set's syntax, an arm64 floating point register's by its d register, the low half
# its unwind codes save
fun put_named_register(l: *Lister, m: seh.Machine, n: u16, s: u32, at: u64) err[Refusal] {
    var reg: res[rf.Id, build.Refusal] = cfi.numbered(l.b, n::u32);
    if (sel m.arm64 && n >= seh.A64_FLOAT) { reg = cfi.low_view(l.b, n, 64); }
    if (sel reg.err)                       { ret refusal(reg.err.message, s, at); }
    var w:     core_syntax.Writer = writer(l, build.object_of(l.b), ?l.modes);
    val wrote: err[field.Refusal] = syntax_write.register_name(?w, reg.ok, field.NO_OPERAND);
    if (sel wrote.err) { ret refusal(seh.UNCODED, s, at); }
    ret err[Refusal].ok{};
}

# unwind code `c` as the first `.seh_` directive of machine `m` that spells it
fun unwind_code(l: *Lister, m: seh.Machine, c: seh.Code, s: u32, at: u64) err[Refusal] {
    val spelled: opt[seh.Spelled] = seh.spelling(m, c);
    if (sel spelled.none) { ret refusal(seh.UNCODED, s, at); }
    val d: *seh.Directive = spelled.some.directive;
    put_char(l, '\t');
    put(l, d.name);
    val shape: seh.Operands = d.operands;
    if (sel shape.register || sel shape.both) {
        put_char(l, ' ');
        val r: err[Refusal] = put_named_register(l, m, spelled.some.reg, s, at);
        if (sel r.err) { ret r; }
    }
    if (sel shape.both)                    { put(l, ", "); }
    or (sel shape.bytes)                   { put_char(l, ' '); }
    if (sel shape.bytes || sel shape.both) { put_signed(l, spelled.some.bytes); }
    if (sel shape.code) {
        if (sel c.machframe) {
            if (c.machframe) { put(l, " @code"); }
        }
    }
    put_char(l, '\n');
    ret err[Refusal].ok{};
}

# the open frame ended before statement `j` of section `s` when it ends there
fun frame_end(l: *Lister, s: u32, j: u32, at: u64) err[Refusal] {
    if (!l.open) { ret err[Refusal].ok{}; }
    val f: build.Frame = l.current;
    if (f.section.index != s || f.end != j) { ret err[Refusal].ok{}; }
    val rules: err[Refusal] = frame_rules(l, j, s, at);
    if (sel rules.err)             { ret rules; }
    if (l.ri != f.rules + f.count) { ret refusal(FRAMES, s, at); }
    if (l.windows.on) {
        if (l.windows.si != l.windows.written.count) { ret refusal(FRAMES, s, at); }
        put(l, "\t.seh_endproc\n");
    }
    or { put(l, "\t.cfi_endproc\n"); }
    l.open = false;
    ret err[Refusal].ok{};
}

# the frame that begins before statement `j` of section `s`, none when none does
fun frame_begins(l: *Lister, s: u32, j: u32) opt[build.Frame] {
    if (l.fi >= build.frame_count(l.b)) { ret opt[build.Frame].none{}; }
    val f: build.Frame = build.frame_at(l.b, l.fi);
    if (f.section.index != s || f.start != j) { ret opt[build.Frame].none{}; }
    ret opt[build.Frame].some{f};
}

# frame `f` begun after its function's label, which `.cfi_startproc` names it by, with its pointers and its rules
# before statement `j`, and ended there when it ends there
fun frame_start(l: *Lister, f: build.Frame, s: u32, j: u32, at: u64) err[Refusal] {
    if (l.windows.on) { ret unwind_start(l, f, s, at); }
    put(l, "\t.cfi_startproc\n");
    if (sel f.personality.some) {
        if (sel l.codes.personality.none) { ret refusal(FRAMES, s, at); }
        val p: err[Refusal] = frame_pointer(l, "\t.cfi_personality ", l.codes.personality.some, f.personality.some, s, at);
        if (sel p.err) { ret p; }
    }
    if (sel f.lsda.some) {
        if (sel l.codes.lsda.none) { ret refusal(FRAMES, s, at); }
        val p: err[Refusal] = frame_pointer(l, "\t.cfi_lsda ", l.codes.lsda.some, f.lsda.some, s, at);
        if (sel p.err) { ret p; }
    }
    if (f.signal) { put(l, "\t.cfi_signal_frame\n"); }
    l.open    = true;
    l.current = f;
    l.ri      = f.rules;
    l.fi      = l.fi + 1;
    ret err[Refusal].ok{};
}

# frame `f` begun as `.seh_proc` names it after its function's label, with its handler, its unwind codes found
fun unwind_start(l: *Lister, f: build.Frame, s: u32, at: u64) err[Refusal] {
    val found: res[*seh.Written, seh.Uncoded] = seh.codes(l.b, f, ?l.windows.written);
    if (sel found.err) { ret refusal(found.err.message, s, at); }
    put(l, "\t.seh_proc ");
    put_name(l, f.function.id);
    put_char(l, '\n');
    if (sel f.personality.some) {
        if (!spelled(l, f.personality.some.label.id)) { ret err[Refusal].err{Refusal{message: UNSPELLED, section: s, offset: at, label: f.personality.some.label.id}}; }
        put(l, "\t.seh_handler ");
        put_name(l, f.personality.some.label.id);
        put(l, ", @unwind, @except\n");
    }
    l.windows.si   = 0;
    l.windows.last = at;
    l.open         = true;
    l.current      = f;
    l.ri           = f.rules;
    l.fi           = l.fi + 1;
    ret err[Refusal].ok{};
}

# whether a frame begins, ends or states a rule before a statement inside the `count` statements from `j` of section
# `s`, past the first, which no spelling of them as one sequence keeps
fun frames_inside(l: *Lister, s: u32, j: u32, count: u32) bool {
    if (l.open) {
        val f: build.Frame = l.current;
        if (f.section.index == s) {
            if (f.end > j && f.end < j + count) { ret true; }
            var k: usize = l.ri;
            for (k < f.rules + f.count) {
                val at: u32 = build.rule_at(l.b, k).at;
                if (at > j && at < j + count) { ret true; }
                k = k + 1;
            }
        }
    }
    if (l.fi >= build.frame_count(l.b)) { ret false; }
    val next: build.Frame = build.frame_at(l.b, l.fi);
    ret next.section.index == s && next.start > j && next.start < j + count;
}

# what comes before statement `j` of section `s`, at `at`: the end of the frame that ends there, the labels placed
# there but `skip`, the frame that begins there after its function's label, and the open frame's rules there
fun before(l: *Lister, s: u32, j: u32, at: u64, skip: u32) err[Refusal] {
    val ended: err[Refusal] = frame_end(l, s, j, at);
    if (sel ended.err) { ret ended; }
    val begins:   opt[build.Frame] = frame_begins(l, s, j);
    var function: u32              = operand.NO_SYMBOL;
    if (sel begins.some) { function = begins.some.function.id; }
    val placed: err[Refusal] = labels_at(l, s, j, at, skip, function);
    if (sel placed.err) { ret placed; }
    if (sel begins.some) {
        val begun: err[Refusal] = frame_start(l, begins.some, s, j, at);
        if (sel begun.err) { ret begun; }
    }
    val rules: err[Refusal] = frame_rules(l, j, s, at);
    if (sel rules.err)   { ret rules; }
    if (sel begins.some) { ret frame_end(l, s, j, at); }
    ret err[Refusal].ok{};
}

# one more use of label `id`, an id of another builder named by none
fun use_label(l: *Lister, id: u32) {
    if (id == 0 || id::usize > l.uses.len) { ret; }
    l.uses.data[id::usize - 1] = l.uses.data[id::usize - 1] + 1;
}

# the uses of the labels value `v` names, itself or within it, as a group's members
fun use_value(l: *Lister, v: *operand.Value) {
    val sym: opt[operand.Symbol] = operand.symbol_of(v);
    if (sel sym.some) { use_label(l, sym.some.id); }
    val inner: operand.Values = operand.inner(v);
    var i:     u32            = 0;
    for (i < inner.len) {
        use_value(l, ?inner.at[i]);
        i = i + 1;
    }
}

# the uses of the labels the values of `ins` name
fun use_inst(l: *Lister, ins: *inst.Inst) {
    var k: u32 = 0;
    for (k < ins.count) {
        use_value(l, ?ins.values[k]);
        k = k + 1;
    }
}

# the uses of the labels difference `d` names
fun use_difference(l: *Lister, d: build.Difference) {
    use_label(l, d.plus.id);
    use_label(l, d.minus.id);
}

# how many times the record names each label: every statement's values and the labels its data name, and every label's
# equate and measured size
fun count_uses(l: *Lister) err[Refusal] {
    val count: usize = build.label_count(l.b);
    if (!held(vector.reserve[u32](?l.uses, count))) { ret whole(MEMORY); }
    var id: usize = 0;
    for (id < count) {
        l.uses.data[id] = 0;
        id              = id + 1;
    }
    vector.truncate[u32](?l.uses, 0);
    vector.commit[u32](?l.uses, count);
    var s: usize = 0;
    for (s < build.section_count(l.b)) {
        val sec: build.Section = build.Section{index: s::u32};
        var j:   usize         = 0;
        for (j < build.statement_count(l.b, sec)) {
            val st: build.Statement = build.statement(l.b, sec, j, ?l.held[0].values[0]);
            j = j + 1;
            if (sel st.stated.code) {
                var ins: inst.Inst = st.stated.code.inst;
                use_inst(l, ?ins);
            }
            or (sel st.stated.format) {
                var ins: inst.Inst = st.stated.format.inst;
                use_inst(l, ?ins);
            }
            or (sel st.stated.datum)      { use_label(l, st.stated.datum.target.id); }
            or (sel st.stated.difference) { use_difference(l, st.stated.difference.of); }
        }
        s = s + 1;
    }
    var k: usize = 0;
    for (k < build.direct_count(l.b)) {
        val d: build.Direct = build.direct_at(l.b, k);
        k = k + 1;
        if (sel d.at.some)     { use_label(l, d.at.some.id); }
        if (sel d.target.some) { use_label(l, d.target.some.id); }
    }
    id = 1;
    for (id <= count) {
        val label: build.Label         = build.Label{id: id::u32};
        val value: opt[build.Value]    = build.value_of(l.b, label);
        val e:     opt[build.Exposure] = build.exposure_of(l.b, label);
        if (sel value.some) {
            if (sel value.some.equate)   { use_label(l, value.some.equate.target); }
            if (sel value.some.fallback) { use_label(l, value.some.fallback.target); }
        }
        if (sel e.some) {
            if (sel e.some.size.measured) { use_difference(l, e.some.size.measured); }
        }
        id = id + 1;
    }
    ret err[Refusal].ok{};
}

# the label placed at statement `j` of section `s` that the `count` instructions at `l.steps` from it bind as a
# sequence's own, so the sequence's spelling binds a label of its own there when read back: one with no name of its
# own, no exposure and no value, that the record names nowhere but in those instructions. operand.NO_SYMBOL for none
fun here_of(l: *Lister, s: u32, j: u32, count: u32) u32 {
    var i: usize = l.pi;
    for (i < l.places.len && l.places.data[i].section == s && l.places.data[i].statement == j) {
        val id:    u32         = l.places.data[i].id;
        val label: build.Label = build.Label{id: id};
        i = i + 1;
        val own:   opt[View]           = build.label_name(l.b, label);
        val shown: opt[build.Exposure] = build.exposure_of(l.b, label);
        val given: opt[build.Value]    = build.value_of(l.b, label);
        if (sel own.some || sel shown.some || sel given.some) { cnt; }
        var within: u32 = 0;
        var k:      u32 = 0;
        for (k < count) {
            var n: u32 = 0;
            for (n < l.steps[k].count) {
                val sym: opt[operand.Symbol] = operand.symbol_of(?l.steps[k].values[n]);
                if (sel sym.some && sym.some.id == id) { within = within + 1; }
                n = n + 1;
            }
            k = k + 1;
        }
        if (within > 0 && within == l.uses.data[id::usize - 1]) { ret id; }
    }
    ret operand.NO_SYMBOL;
}

# the sequence's own label the parser names by core_syntax.OWN, in the `count` steps of `ex`, named `here`
fun owned(ex: *relax.Expansion, count: u32, here: u32) {
    var i: u32 = 0;
    for (i < count) {
        var k: u32 = 0;
        for (k < ex.steps[i].row.operands.len) {
            val v: *operand.Value = ?ex.steps[i].values[k];
            if (sel v.symbol) {
                if (v.symbol.id == core_syntax.OWN) { v.symbol.id = here; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

# whether a label is placed inside the `count` statements from `j` of section `s`, past the first
fun inside(l: *Lister, s: u32, j: u32, count: u32) bool {
    var i: usize = l.pi;
    for (i < l.places.len && l.places.data[i].section == s && l.places.data[i].statement < j + count) {
        if (l.places.data[i].statement > j) { ret true; }
        i = i + 1;
    }
    ret false;
}

# why the statement from `start` to the output's end does not state the `count` instructions at `l.steps` under view
# `v`, none when it does: it reads back to their rows and values, the label the sequence binds of its own read as
# `here`, and the builder writes what it reads in those same forms with the same markers
fun unstated(l: *Lister, start: usize, v: *state.Context, m: *mode.State, count: u32, here: u32) opt[str] {
    var read_: relax.Expansion;
    var rd:    core_syntax.Reader         = reader(l, start, v, m);
    var got:   err[diagnostic.Diagnostic] = parse.statement(?rd, ?read_);
    for (again(l, ?rd)) {
        rd  = reader(l, start, v, m);
        got = parse.statement(?rd, ?read_);
    }
    if (sel got.err || read_.count != count) { ret opt[str].some{UNREAD}; }
    if (here != operand.NO_SYMBOL)           { owned(?read_, count, here); }
    var i: u32 = 0;
    for (i < count) {
        if (!same_step(?read_.steps[i], ?l.steps[i])) { ret opt[str].some{UNREAD}; }
        i = i + 1;
    }
    var written: relax.Expansion;
    val formed:  err[build.Refusal] = build.forms(l.b, v, m, ?read_, ?written);
    if (sel formed.err) { ret opt[str].some{UNPINNED}; }
    i = 0;
    for (i < count) {
        # exact shows in the row written, every other form bit in the form
        val chosen: u32 = (written.steps[i].form.bits ^ l.steps[i].form.bits) & ~core_form.EXACT;
        if (!same_step(?written.steps[i], ?l.steps[i]) || written.steps[i].marker != l.markers[i] || chosen != 0) {
            # a form the printed text could not state is the reason, as an exact step of a sequence no spelling covers
            if (read_.steps[i].form.bits != l.steps[i].form.bits) { ret opt[str].some{UNMARKED}; }
            ret opt[str].some{UNPINNED};
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

# a reader of the output from `start` to its end under view `v` and modes `m`, into the lister's stores
fun reader(l: *Lister, start: usize, v: *state.Context, m: *mode.State) core_syntax.Reader {
    var rd: core_syntax.Reader = core_syntax.Reader{
        text:    l.out.data,
        start:   start,
        at:      start,
        end:     l.out.len,
        origin:  diagnostic.START,
        codec:   l.b.set.codec,
        ctx:     v,
        syntax:  l.syntax,
        modes:   m,
        symbols: ?l.symbols,
        context: nil,
        row:     nil,
        format:  l.b.format,
    };
    core_syntax.over(?rd, ?l.stores);
    ret rd;
}

# whether the read through `rd` found a store short, which grew to read again, a store that failed to grow noted
fun again(l: *Lister, rd: *core_syntax.Reader) bool {
    val grown: res[bool, A.Error] = core_syntax.regrown(rd, ?l.stores);
    if (sel grown.err) {
        l.full = true;
        ret false;
    }
    ret grown.ok;
}

# the fixup kind a symbol stating `kind` stands under, `default` when it states none
fun kind_in(kind: operand.FixupKind, default: operand.FixupKind) operand.FixupKind {
    if (kind != operand.NO_FIXUP) { ret kind; }
    ret default;
}

# `v` with the fixup kind of its symbol stated as the one it stands under in operand `desc`
fun stated_kind(desc: *operand.Operand, v: *operand.Value) operand.Value {
    var out:     operand.Value     = @v;
    val default: operand.FixupKind = operand.value_fixup(desc, v);
    if (sel out.symbol) { out.symbol.fixup = kind_in(out.symbol.fixup, default); }
    if (sel out.memory) { out.memory.symbol.fixup = kind_in(out.memory.symbol.fixup, default); }
    ret out;
}

# whether `got` is `want`'s row with its values, a symbol's default fixup kind and the kind stated alike
fun same_step(got: *relax.Emitted, want: *inst.Inst) bool {
    ret got.row == want.row && same_values(want.row, ?got.values[0], want.values);
}

# whether values `got` of row `r` are `want`, a symbol's default fixup kind and the kind stated alike
fun same_values(r: *row.Row, got: *operand.Value, want: *operand.Value) bool {
    var k: u32 = 0;
    for (k < r.operands.len) {
        val desc: *operand.Operand = ?r.operands.at[k];
        var x:    operand.Value    = stated_kind(desc, ?got[k]);
        var y:    operand.Value    = stated_kind(desc, ?want[k]);
        if (!operand.equal(?x, ?y)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# statement `st` of section `s`, the instruction `f` a format of the source dialect's instruction directive states,
# written as that directive by the format's template, and refused when the text does not read back to its row and values
fun formatted(l: *Lister, s: u32, st: build.Statement, f: build.Formatted) err[Refusal] {
    val moved: err[Refusal] = under(l, st.view, st.modes, s, st.offset);
    if (sel moved.err) { ret moved; }
    val raw: opt[*source.Directive] = source.raw_of(l.b.set.source.directives);
    if (sel raw.none) { ret refusal(RAW, s, st.offset); }
    val insns:   *source.Insns      = source.insns(l.b.set.source.directives);
    var w:       core_syntax.Writer = writer(l, st.view, st.modes);
    var written: inst.Inst          = f.inst;
    put_char(l, '\t');
    val start:    usize        = l.out.len;
    val spelled_: err[A.Error] = source.spell(raw.some, l.out);
    if (sel spelled_.err) { l.full = true; }
    put_char(l, ' ');
    val from:    usize              = l.out.len;
    val spelled: err[field.Refusal] = print.templated(?w, f.format.template, ?written);
    if (sel spelled.err) {
        vector.truncate[u8](l.out, start - 1);
        ret err[Refusal].err{Refusal{message: UNREAD, section: s, offset: st.offset, label: operand.NO_SYMBOL, encode: opt[field.Refusal].some{spelled.err}}};
    }
    var rd:   core_syntax.Reader                      = reader(l, from, st.view, st.modes);
    var back: res[parse.Taken, diagnostic.Diagnostic] = parse.format(?rd, insns.formats);
    for (again(l, ?rd)) {
        rd   = reader(l, from, st.view, st.modes);
        back = parse.format(?rd, insns.formats);
    }
    if (sel back.ok) {
        if (back.ok.inst.row == f.inst.row && same_values(f.inst.row, back.ok.inst.values, f.inst.values)) {
            put_char(l, '\n');
            ret err[Refusal].ok{};
        }
    }
    vector.truncate[u8](l.out, start - 1);
    ret refusal(UNREAD, s, st.offset);
}

# the writer of an instruction's spelling under view `v` and assembler modes `m`
fun writer(l: *Lister, v: *state.Context, m: *mode.State) core_syntax.Writer {
    ret core_syntax.Writer{out: l.out, codec: l.b.set.codec, ctx: v, syntax: l.syntax, modes: m, symbols: ?l.symbols, context: nil, row: nil, dot: false, values: nil, format: l.b.format};
}

# instruction `k` of `l.steps` written alone under view `v` and modes `m`, by the first spelling that states it: its
# preferred alias, then its row's own form, in its own form and else in it with one marked choice the form leaves at
# the preference that the builder encodes the instruction alike under, so the marker pins the row the text reads back
# to, as x86's `{disp32} jmp l` reads to the rel32 row a plain `jmp l` reads past
fun one(l: *Lister, k: u32, v: *state.Context, m: *mode.State, s: u32, at: u64) err[Refusal] {
    val own:   inst.Inst    = l.steps[k];
    val first: err[Refusal] = attempt(l, k, own.form, v, m, s, at);
    if (sel first.ok) { ret first; }
    val forms: *core_form.FormFields = ?l.b.set.codec.forms;
    var i:     u32                   = 0;
    for (i < forms.len) {
        val f: *core_form.FormField = ?forms.at[i];
        i = i + 1;
        if (f.marker == nil || (f.mask & core_form.EXACT) != 0 || (own.form.bits & f.mask) != 0) { cnt; }
        val pinned: core_form.Form = core_form.with(own.form, f);
        if (!build.alike(l.b, v, ?own, pinned)) { cnt; }
        val again: err[Refusal] = attempt(l, k, pinned, v, m, s, at);
        if (sel again.ok) { ret again; }
    }
    ret first;
}

# instruction `k` of `l.steps` in form `fm` written alone under view `v` and modes `m`, by the first spelling that
# states it: its preferred alias, then its row's own form. refused with the output as it was when neither does
fun attempt(l: *Lister, k: u32, fm: core_form.Form, v: *state.Context, m: *mode.State, s: u32, at: u64) err[Refusal] {
    var w:     core_syntax.Writer = writer(l, v, m);
    var step:  inst.Inst          = l.steps[k];
    var why:   str                = UNREAD;
    var tried: u32                = 0;
    step.form = fm;
    for (tried < 2) {
        put_char(l, '\t');
        val start:   usize              = l.out.len;
        var spelled: err[field.Refusal] = err[field.Refusal].ok{};
        if (tried == 0) { spelled = print.instruction(?w, ?step); }
        or              { spelled = print.form(?w, ?step); }
        tried = tried + 1;
        if (sel spelled.err) {
            vector.truncate[u8](l.out, start - 1);
            if (tried == 2) { ret err[Refusal].err{Refusal{message: UNREAD, section: s, offset: at, label: operand.NO_SYMBOL, encode: opt[field.Refusal].some{spelled.err}}}; }
            cnt;
        }
        # a statement of one instruction is read back as one, wherever its sequence runs on
        l.steps[0]   = step;
        l.markers[0] = l.markers[k];
        val wrong: opt[str] = unstated(l, start, v, m, 1, operand.NO_SYMBOL);
        if (sel wrong.none) {
            put_char(l, '\n');
            ret err[Refusal].ok{};
        }
        why = wrong.some;
        vector.truncate[u8](l.out, start - 1);
    }
    ret refusal(why, s, at);
}

# the instructions from statement `j` of section `s` written after the labels placed there, a sequence by the syntax's
# spelling of it when one states it and else each alone, answering how many statements they are. a sequence whose
# first instruction's label only it names is spelled binding that label itself, as `lla` and `la` bind theirs
fun code(l: *Lister, s: u32, j: u32, first: build.Statement) res[u32, Refusal] {
    val sec:   build.Section  = build.Section{index: s};
    val v:     *state.Context = first.view;
    val m:     *mode.State    = first.modes;
    var count: u32            = 1;
    if (sel first.stated.code)                 { count = first.stated.code.run; }
    if (count == 0 || count > relax.MAX_STEPS) { count = 1; }
    var at: [relax.MAX_STEPS]u64;
    var k:  u32 = 0;
    for (k < count) {
        var st: build.Statement = build.statement(l.b, sec, (j + k)::usize, ?l.held[k].values[0]);
        # a sequence's statements are its instructions, every one
        if (!sel st.stated.code) {
            count = k;
            brk;
        }
        l.steps[k]   = st.stated.code.inst;
        l.markers[k] = st.stated.code.marker;
        at[k]        = st.offset;
        k            = k + 1;
    }
    var here: u32 = operand.NO_SYMBOL;
    if (count > 1) { here = here_of(l, s, j, count); }
    val placed: err[Refusal] = before(l, s, j, first.offset, here);
    if (sel placed.err) { ret res[u32, Refusal].err{placed.err}; }
    val moved: err[Refusal] = under(l, v, m, s, first.offset);
    if (sel moved.err) { ret res[u32, Refusal].err{moved.err}; }
    if (count > 1 && !inside(l, s, j, count) && !frames_inside(l, s, j, count)) {
        var w: core_syntax.Writer = writer(l, v, m);
        put_char(l, '\t');
        val start:   usize                    = l.out.len;
        val spelled: res[bool, field.Refusal] = print.sequence(?w, ?l.steps[0], count, here);
        if (sel spelled.ok && spelled.ok) {
            val wrong: opt[str] = unstated(l, start, v, m, count, here);
            if (sel wrong.none) {
                put_char(l, '\n');
                ret res[u32, Refusal].ok{count};
            }
        }
        vector.truncate[u8](l.out, start - 1);
    }
    # a label the sequence would have bound is written where it is placed, before the instructions written alone
    if (here != operand.NO_SYMBOL) {
        val wrote: err[Refusal] = label_line(l, here, s, first.offset);
        if (sel wrote.err) { ret res[u32, Refusal].err{wrote.err}; }
    }
    # each alone, each checked through the first slot, which the one before it no longer needs
    k = 0;
    for (k < count) {
        if (k > 0) {
            val placed: err[Refusal] = before(l, s, j + k, at[k], operand.NO_SYMBOL);
            if (sel placed.err) { ret res[u32, Refusal].err{placed.err}; }
        }
        val wrote: err[Refusal] = one(l, k, v, m, s, at[k]);
        if (sel wrote.err) { ret res[u32, Refusal].err{wrote.err}; }
        k = k + 1;
    }
    ret res[u32, Refusal].ok{count};
}

# the directive that writes data of `width` bytes of the width's own kind, none when the dialect has none
fun width_directive(l: *Lister, width: u8) opt[str] {
    var i: u32 = 0;
    for (i < l.b.set.source.widths.len) {
        if (l.b.set.source.widths.at[i].width == width && l.b.set.source.widths.at[i].kind == operand.NO_FIXUP) { ret opt[str].some{l.b.set.source.widths.at[i].name}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

# the directive of the dialect that states fixup kind `want` itself on data of `width` bytes, none when the dialect
# states it by a specifier on the width's own directive or not at all
fun kinded_directive(l: *Lister, width: u8, want: operand.FixupKind) opt[str] {
    val sought: *reloc.Kind = build.kind_of(l.b, want);
    var i:      u32         = 0;
    for (i < l.b.set.source.widths.len) {
        val w: *source.Width = ?l.b.set.source.widths.at[i];
        i = i + 1;
        if (w.width != width || w.kind == operand.NO_FIXUP)                            { cnt; }
        if (w.kind == want || (sought != nil && build.kind_of(l.b, w.kind) == sought)) { ret opt[str].some{w.name}; }
    }
    ret opt[str].none{};
}

# the bytes `data` written as one-byte data
fun raw(l: *Lister, data: View) {
    var i: usize = 0;
    for (i < data.len) {
        put_char(l, '\t');
        put(l, l.byte);
        put_char(l, ' ');
        var n: usize = 0;
        for (i < data.len && n < PER_LINE) {
            if (n > 0) { put(l, ", "); }
            put_hex(l, data.data[i]);
            i = i + 1;
            n = n + 1;
        }
        put_char(l, '\n');
    }
}

# the alignment `al` as `.balign`, its fill and limit when stated
fun align(l: *Lister, al: build.Align) {
    put(l, "\t.balign ");
    put_unsigned(l, al.boundary);
    if (sel al.fill.some || sel al.max.some) { put(l, ", "); }
    if (sel al.fill.some)                    { put_unsigned(l, al.fill.some::u64); }
    if (sel al.max.some) {
        put(l, ", ");
        put_unsigned(l, al.max.some);
    }
    put_char(l, '\n');
}

# statement `st` of section `s`, the datum `r` of a stated relocation kind, written as the dialect's own directive of that
# kind where it has one, else as the width's directive over the symbol under the specifier of the set's syntax that
# states the kind on a datum of the width's own, both of which the assembler reads back to the kind
fun kinded(l: *Lister, s: u32, st: build.Statement, r: build.Reference) err[Refusal] {
    if (r.basis != fixup.ABSOLUTE) { ret refusal(KINDED, s, st.offset); }
    val own:   operand.FixupKind      = build.datum_own(l.b, r.basis, r.width);
    val found: opt[operand.FixupKind] = build.datum_kind(l.b, r.basis, r.width, build.kind_of(l.b, r.kind));
    if (sel found.none) { ret refusal(KINDED, s, st.offset); }
    val own_dir: opt[str] = kinded_directive(l, r.width, found.some);
    if (sel own_dir.some) {
        put_char(l, '\t');
        put(l, own_dir.some);
        put_char(l, ' ');
        put_name(l, r.target.id);
        put_addend(l, r.addend);
        put_char(l, '\n');
        ret err[Refusal].ok{};
    }
    val plain: opt[str] = width_directive(l, r.width);
    if (sel plain.none) { ret refusal(NO_WIDTH, s, st.offset); }
    put_char(l, '\t');
    put(l, plain.some);
    put_char(l, ' ');
    var w:     core_syntax.Writer = writer(l, nil, ?l.modes);
    val wrote: err[field.Refusal] = expr.print_symbol(?w, operand.Symbol{id: r.target.id, addend: r.addend, fixup: found.some}, own, field.NO_OPERAND);
    if (sel wrote.err) { ret refusal(KINDED, s, st.offset); }
    put_char(l, '\n');
    ret err[Refusal].ok{};
}

# statement `st` of section `s` that is data, written
fun data(l: *Lister, s: u32, st: build.Statement) err[Refusal] {
    val stated: build.Stated = st.stated;
    if (sel stated.data) {
        if (l.byte == nil) { ret refusal(NO_BYTE, s, st.offset); }
        raw(l, stated.data);
        ret err[Refusal].ok{};
    }
    if (sel stated.zero) {
        put(l, "\t.zero ");
        put_unsigned(l, stated.zero);
        put_char(l, '\n');
        ret err[Refusal].ok{};
    }
    if (sel stated.datum) {
        val r: build.Reference = stated.datum;
        val d: opt[str]        = width_directive(l, r.width);
        if (!spelled(l, r.target.id))   { ret err[Refusal].err{Refusal{message: UNSPELLED, section: s, offset: st.offset, label: r.target.id}}; }
        if (r.kind != operand.NO_FIXUP) { ret kinded(l, s, st, r); }
        if (sel d.none)                 { ret refusal(NO_WIDTH, s, st.offset); }
        put_char(l, '\t');
        put(l, d.some);
        put_char(l, ' ');
        put_name(l, r.target.id);
        put_addend(l, r.addend);
        # a distance from the datum's own place is the difference from `.`, which the builder measures alike
        if (r.basis == fixup.RELATIVE) { put(l, " - ."); }
        put_char(l, '\n');
        ret err[Refusal].ok{};
    }
    if (!sel stated.difference) { ret err[Refusal].ok{}; }
    val g: build.Measure = stated.difference;
    var d: opt[str]      = width_directive(l, g.width);
    if (g.encoding == fixup.ULEB)    { d = opt[str].some{".uleb128"}; }
    if (g.encoding == fixup.SLEB)    { d = opt[str].some{".sleb128"}; }
    if (sel d.none)                  { ret refusal(NO_WIDTH, s, st.offset); }
    if (!spells_difference(l, g.of)) { ret err[Refusal].err{Refusal{message: UNSPELLED, section: s, offset: st.offset, label: g.of.plus.id}}; }
    put_char(l, '\t');
    put(l, d.some);
    put_char(l, ' ');
    put_difference(l, g.of);
    put_char(l, '\n');
    ret err[Refusal].ok{};
}

# section `s` written: its header, then its labels and statements in order, ending under the object's selection
fun section(l: *Lister, s: u32) err[Refusal] {
    val opened: err[Refusal] = header(l, s);
    if (sel opened.err) { ret opened; }
    if (l.anchors.data[s::usize] != 0) {
        var scratch: [core_syntax.MAX_ANONYMOUS + 10]u8;
        val n:       usize = stemmed(l.dialect.temporary, l.anchors.data[s::usize] - 1, ?scratch[0]);
        put_spelled(l, view(?scratch[0], n));
        put(l, ":\n");
    }
    val sec:   build.Section = build.Section{index: s};
    val code_: bool          = (build.opened(l.b, sec).flags & mink_section.EXEC) != 0;
    val count: usize         = build.statement_count(l.b, sec);
    var j:     usize         = 0;
    for (j < count) {
        val st: build.Statement = build.statement(l.b, sec, j, ?l.held[0].values[0]);
        if (sel st.stated.code) {
            val took: res[u32, Refusal] = code(l, s, j::u32, st);
            if (sel took.err) { ret err[Refusal].err{took.err}; }
            j = j + took.ok::usize;
            cnt;
        }
        val placed: err[Refusal] = before(l, s, j::u32, st.offset, operand.NO_SYMBOL);
        if (sel placed.err) { ret placed; }
        if (sel st.stated.format) {
            val wrote: err[Refusal] = formatted(l, s, st, st.stated.format);
            if (sel wrote.err) { ret wrote; }
            j = j + 1;
            cnt;
        }
        if (sel st.stated.align) {
            # code alignment pads with the fill its view admits, so it is written under that view
            var moved: err[Refusal] = err[Refusal].ok{};
            if (code_)         { moved = under(l, st.view, st.modes, s, st.offset); }
            or                 { moved = moded(l, st.modes, s, st.offset); }
            if (sel moved.err) { ret moved; }
            align(l, st.stated.align);
            j = j + 1;
            cnt;
        }
        val moved: err[Refusal] = moded(l, st.modes, s, st.offset);
        if (sel moved.err) { ret moved; }
        val wrote: err[Refusal] = data(l, s, st);
        if (sel wrote.err) { ret wrote; }
        j = j + 1;
    }
    val ended: err[Refusal] = before(l, s, count::u32, build.size_of(l.b, sec), operand.NO_SYMBOL);
    if (sel ended.err) { ret ended; }
    enter(l, object_scope(l));
    ret relocs(l, s);
}

# the relocations stated by themselves in section `s`, each its `.reloc` after the section's statements: its place by
# the label it was stated at plus its offset, or its offset from the section's start, the format's name of its kind,
# and its target plus its addend, or its addend alone
fun relocs(l: *Lister, s: u32) err[Refusal] {
    var k: usize = 0;
    for (k < build.direct_count(l.b)) {
        val d: build.Direct = build.direct_at(l.b, k);
        k = k + 1;
        if (d.section != s) { cnt; }
        val name: opt[str] = build.relocation_name(l.b, d.kind);
        if (sel name.none) { ret refusal(UNNAMED_RELOCATION, s, d.place); }
        put(l, "\t.reloc ");
        if (sel d.at.some) {
            if (!spelled(l, d.at.some.id)) { ret err[Refusal].err{Refusal{message: UNSPELLED, section: s, offset: d.place, label: d.at.some.id}}; }
            put_name(l, d.at.some.id);
            put_addend(l, d.offset:~i64);
        }
        or { put_unsigned(l, d.offset); }
        put(l, ", ");
        put(l, name.some);
        if (sel d.target.some) {
            if (!spelled(l, d.target.some.id)) { ret err[Refusal].err{Refusal{message: UNSPELLED, section: s, offset: d.place, label: d.target.some.id}}; }
            put(l, ", ");
            put_name(l, d.target.some.id);
            put_addend(l, d.addend);
        }
        or (d.addend != 0) {
            put(l, ", ");
            put_signed(l, d.addend);
        }
        put_char(l, '\n');
    }
    ret err[Refusal].ok{};
}

# the traits the source stated by the object format's attribute tag, restated by the dialect's attribute directive as
# the source spelled them
fun traits(l: *Lister) err[Refusal] {
    val count: usize = build.said_count(l.b);
    var k:     usize = 0;
    for (k < count) {
        val sp: opt[build.Spelled] = build.said_spelled(l.b, k);
        k = k + 1;
        if (sel sp.none) { cnt; }
        val d: opt[*source.Directive] = source.attribute_of(l.b.set.source.directives);
        if (sel d.none) { ret whole(ATTRIBUTE); }
        put_directive(l, d.some);
        put_char(l, ' ');
        val tag: contract.Tag = sp.some.tag;
        if (sel tag.name)   { put(l, tag.name); }
        if (sel tag.number) { put_unsigned(l, tag.number); }
        put(l, ", ");
        val written: contract.Written = sp.some.written;
        if (sel written.number) { put_unsigned(l, written.number); }
        if (sel written.text) {
            if (!put_string(l, View{data: written.text.data, len: written.text.len})) { ret whole(QUOTED); }
        }
        put_char(l, '\n');
    }
    ret err[Refusal].ok{};
}

# every section the object's format holds its traits in that the source wrote, restated by its bytes, which the
# assembler raises into the same traits
fun raised(l: *Lister) err[Refusal] {
    val count: usize = build.raised_count(l.b);
    var k:     usize = 0;
    for (k < count) {
        val h: build.TraitSection = build.raised_at(l.b, k);
        k = k + 1;
        if (l.byte == nil) { ret whole(NO_BYTE); }
        put(l, "\t.section ");
        if (plain(h.name))          { put_view(l, h.name); }
        or (!put_string(l, h.name)) { ret whole(QUOTED); }
        put(l, ", \"a\"\n");
        raw(l, h.bytes);
    }
    ret err[Refusal].ok{};
}

# the value an operand of shape `shape` holds that states the setting `said` of axis `x`, as `build.setting_of` maps an
# enumerant's value, none when no member of its enumeration states it
fun stating_value(l: *Lister, shape: *operand.Shape, x: *mink_trait.Axis, said: mink_trait.Setting) opt[operand.Value] {
    if (!sel shape.enumerant) { ret opt[operand.Value].none{}; }
    val e: *operand.Enumeration = ?shape.enumerant;
    var k: u32                  = 0;
    for (k < e.count) {
        val n:  u32                     = e.members[k].value;
        val as: opt[mink_trait.Setting] = build.setting_of(l.b, x, n::u64);
        if (sel as.some && mink_trait.same(as.some, said)) { ret opt[operand.Value].some{operand.enumerant(n)}; }
        k = k + 1;
    }
    ret opt[operand.Value].none{};
}

# instruction `r` with `count` values `values` written under the object's view, as the set reads one as what it states
# of the object, and the selection the text is read under from then on widened by what it widens it by
fun put_stated(l: *Lister, r: *row.Row, values: *operand.Value, count: u32) err[Refusal] {
    val object: *state.Context     = build.object_of(l.b);
    var w:      core_syntax.Writer = writer(l, object, ?l.modes);
    var step:   inst.Inst          = inst.Inst{row: r, values: values, count: count, form: core_form.PREFERRED};
    put_char(l, '\t');
    val spelled: err[field.Refusal] = print.instruction(?w, ?step);
    if (sel spelled.err) { ret err[Refusal].err{Refusal{message: UNREAD, section: NO_SECTION, offset: 0, label: operand.NO_SYMBOL, encode: opt[field.Refusal].some{spelled.err}}}; }
    put_char(l, '\n');
    if (l.b.set.source.widens == nil) { ret err[Refusal].ok{}; }
    val ids: requirement.Ids = l.b.set.source.widens(?step);
    if (ids.len == 0) { ret err[Refusal].ok{}; }
    var from: *extension.Selection = object.selection;
    if (sel l.widened.some) { from = ?l.widened.some; }
    val grown: res[extension.Selection, extension.Error] = extension.added(l.a, from, ids);
    if (sel grown.err)      { ret whole(MEMORY); }
    if (sel l.widened.some) { val freed: err[A.Error] = extension.release(?l.widened.some); }
    l.widened = opt[extension.Selection].some{grown.ok};
    ret err[Refusal].ok{};
}

# the instructions the set reads as what they state of the object (`stating`) written again from what the object
# holds, before every section, as spir-v's OpCapability, OpExtension and OpMemoryModel: an instruction of a row stating
# facts once for each fact of its key stated, in the order stated, and one of a row stating traits once when an
# instruction stated them all. a row stating both is written for each of its facts with its traits
fun statings(l: *Lister) err[Refusal] {
    val ss: stating.Statings = l.b.set.statings;
    var i:  u32              = 0;
    for (i < ss.len) {
        val r:     *row.Row = ss.at[i].row;
        var j:     u32      = 0;
        var first: bool     = true;
        for (j < i && first) {
            if (ss.at[j].row == r) { first = false; }
            j = j + 1;
        }
        i = i + 1;
        if (!first) { cnt; }
        var values: [operand.MAX_OPERANDS]operand.Value;
        var k:      u32 = 0;
        for (k < r.operands.len && k < operand.MAX_OPERANDS) {
            values[k] = operand.Value.none{};
            k         = k + 1;
        }
        var fact:   opt[stating.Fact] = opt[stating.Fact].none{};
        var at:     u8                = 0;
        var traits: bool              = true;
        j = 0;
        for (j < ss.len) {
            val st: *stating.Stating = ?ss.at[j];
            j = j + 1;
            if (st.row != r) { cnt; }
            val what: stating.Stated = st.stated;
            if (sel what.fact) {
                fact = opt[stating.Fact].some{what.fact};
                at   = st.operand;
                cnt;
            }
            val said: opt[mink_trait.Setting] = build.row_said(l.b, what.trait);
            if (sel said.none) {
                traits = false;
                cnt;
            }
            val v: opt[operand.Value] = stating_value(l, ?r.operands.at[st.operand].shape, what.trait, said.some);
            if (sel v.none) { ret whole(UNREAD); }
            values[st.operand] = v.some;
        }
        if (sel fact.none) {
            if (!traits) { cnt; }
            val wrote: err[Refusal] = put_stated(l, r, ?values[0], r.operands.len);
            if (sel wrote.err) { ret wrote; }
            cnt;
        }
        if (!traits) { cnt; }
        var t: usize = 0;
        for (t < build.told_count(l.b)) {
            val told: build.StatedFact = build.told_at(l.b, t);
            t = t + 1;
            if (told.fact.format != fact.some.format || told.fact.key != fact.some.key) { cnt; }
            if (sel told.data.some)                                                     { values[at] = operand.Value.literal{operand.Bytes{at: told.data.some.data, len: told.data.some.len::u32}}; }
            or                                                                          { values[at] = operand.enumerant(told.value::u32); }
            val wrote: err[Refusal] = put_stated(l, r, ?values[0], r.operands.len);
            if (sel wrote.err) { ret wrote; }
        }
    }
    ret err[Refusal].ok{};
}

# the whole listing written
fun run(l: *Lister) err[Refusal] {
    val read_: err[Refusal] = sections_read(l);
    if (sel read_.err) { ret read_; }
    val names: err[Refusal] = name_all(l);
    if (sel names.err) { ret names; }
    val anchored: err[Refusal] = anchor_owners(l);
    if (sel anchored.err) { ret anchored; }
    val places: err[Refusal] = place_all(l);
    if (sel places.err) { ret places; }
    val used: err[Refusal] = count_uses(l);
    if (sel used.err) { ret used; }
    val framed: err[Refusal] = frames_read(l);
    if (sel framed.err) { ret framed; }
    val named: err[Refusal] = sources(l);
    if (sel named.err) { ret named; }
    val tabled: err[Refusal] = files(l);
    if (sel tabled.err) { ret tabled; }
    var id: usize = 1;
    for (id <= build.label_count(l.b)) {
        val declared: err[Refusal] = declare(l, id::u32);
        if (sel declared.err) { ret declared; }
        id = id + 1;
    }
    val stated: err[Refusal] = traits(l);
    if (sel stated.err) { ret stated; }
    val instructed: err[Refusal] = statings(l);
    if (sel instructed.err) { ret instructed; }
    frame_tables(l);
    var s: usize = 0;
    for (s < build.section_count(l.b)) {
        val wrote: err[Refusal] = section(l, s::u32);
        if (sel wrote.err) { ret wrote; }
        s = s + 1;
    }
    if (l.open || l.fi != build.frame_count(l.b)) { ret whole(FRAMES); }
    val notes: err[Refusal] = raised(l);
    if (sel notes.err) { ret notes; }
    if (l.full)        { ret whole(MEMORY); }
    ret err[Refusal].ok{};
}

# the listing of the finished builder `b` appended to `out`: source text that assembles alone, through masc's assembler
# under the object's selection and the traits the builder was given, to the same sections and relocations
# ---
# ret: ok, or the first fact the text cannot state, with `out` as it was
pub fun write(b: *build.Builder, options: Options, out: *vector.Vector[u8]) err[Refusal] {
    if (options.syntax >= b.set.syntaxes.len) { ret whole(NO_SYNTAX); }
    if (!build.handed_over(b))                { ret whole(UNFINISHED); }
    val lines: *line.Lines = line.of(b);
    if (build.records(b, lines::ptr)) { ret whole(RECORDS); }
    var l: Lister = Lister{
        a:       out.a,
        b:       b,
        syntax:  ?b.set.syntaxes.at[options.syntax],
        dialect: options.dialect,
        out:     out,
        names:   intern.make(out.a),
        spelled: vector.init[u32](out.a),
        owners:  vector.init[u32](out.a),
        places:  vector.init[Placed](out.a),
        uses:    vector.init[u32](out.a),
        pi:      0,
        scopes:  vector.init[Scope](out.a),
        now:     Scope{v: build.object_of(b), mask: 0, restated: false, states: 0, stated: true},
        modes:   mode.initial(?b.set.assembly),
        saved:   mode.initial(?b.set.assembly),
        byte:    nil,
        apart:   0,
        anchors: vector.init[u32](out.a),
        full:    false,
        lines:   lines,
        locs:    vector.init[u32](out.a),
        spoken:  line.UNSPOKEN,
        fi:      0,
        open:    false,
        ri:      0,
        codes:   Codes{personality: opt[u8].none{}, lsda: opt[u8].none{}},
        windows: Windows{on: false, si: 0, last: 0},
        stores:  core_syntax.stores(out.a),
        widened: opt[extension.Selection].none{},
    };
    l.symbols = core_syntax.Symbols{context: (?l)::ptr, resolve: resolved, name: named};
    var i: u32 = 0;
    for (i < b.set.source.widths.len && l.byte == nil) {
        if (b.set.source.widths.at[i].width == 1) { l.byte = b.set.source.widths.at[i].name; }
        i = i + 1;
    }
    val start: usize                  = out.len;
    val reads: opt[*source.Directive] = source.syntax_of(b.set.source.directives, options.syntax::u8);
    if (sel reads.some) { put_line(?l, reads.some); }
    val done: err[Refusal] = run(?l);
    intern.release(?l.names);
    vector.dnit[u32](?l.spelled);
    vector.dnit[u32](?l.owners);
    vector.dnit[u32](?l.anchors);
    vector.dnit[Placed](?l.places);
    vector.dnit[u32](?l.uses);
    vector.dnit[Scope](?l.scopes);
    vector.dnit[u32](?l.locs);
    core_syntax.release(?l.stores);
    if (sel l.widened.some) { val freed: err[A.Error] = extension.release(?l.widened.some); }
    if (sel done.err)       { vector.truncate[u8](out, start); }
    ret done;
}
