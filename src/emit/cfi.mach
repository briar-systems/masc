# call frame facts as calls on the builder, by masc register and by offsets that may scale
#
# a call frame fact is a call shaped like the `.cfi_` directive of the same
# name, made on the builder at its cursor: the rule takes effect at the next
# statement of the current section, and the builder places it once the layout
# is settled. a register is named by its masc identity and numbered from its
# row's dwarf column under the object's context, never by a number the caller
# holds, and the return address column is mink's (`Arch.unwind.ra`).
#
# an offset is a byte count plus a multiple of a slot's quantity, as a vector
# length scales an rvv or sve save slot. it reaches mink as a first-class
# scaled rule over the register that measures the quantity, the gauge of its
# row (`quantity.Measure`), never as a dwarf expression masc builds.
#
# the builder owns the frame: the canonical frame address its rules leave and
# the states they remember (`build.cfa`), so `adjust_cfa_offset` and
# `rel_offset` read it there and a direct `build.cfi` caller and these calls
# agree. masc writes no frame bytes, mink owns them.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.store;
use mink_arch: mink.catalog.arch;
use mink.model.frame;

use masc.build.build;
use masc.core.operand;
use masc.core.quantity;
use rf:         masc.core.register;
use core_state: masc.core.state;

pub val NO_NUMBER:   str = "register with no dwarf number under the object's context";
pub val NO_COLUMN:   str = "dwarf number no register of the object's context has";
pub val NO_REGISTER: str = "register the object's selection does not admit";
pub val NO_SCALE:    str = "offset that scales by a slot that binds no quantity under the object's context";
pub val NO_GAUGE:    str = "offset that scales by a quantity no register measures";
pub val UNEVEN:      str = "offset that scales by a share of its quantity that is no whole count of its register";
pub val MIXED:       str = "offsets that scale by two quantities, which no one rule adds";
pub val NO_SCALED:   str = "value rule at a scaled offset, which mink's frame model has no rule for";
pub val RETURN:      str = "return address column other than the architecture's, which mink's frame model holds";
pub val NO_FRAME:    str = "rule where no frame is begun";

# bytes fixed plus a multiple of the quantity one slot of the register file binds
# ---
# fixed: the bytes no quantity changes
# per:   the bytes for each unit of the quantity's multiplier, 0 when none scales
# scale: the slot whose quantity scales it, read only when `per` is nonzero
pub rec Offset {
    fixed: i64;
    per:   i64;
    scale: u8;
}

# an offset of `n` bytes
pub fun bytes(n: i64) Offset {
    ret Offset{fixed: n, per: 0, scale: 0};
}

fun refusal(message: str) build.Refusal {
    ret build.Refusal{message: message, label: operand.NO_SYMBOL};
}

fun refused(message: str) err[build.Refusal] {
    ret err[build.Refusal].err{refusal(message)};
}

# the dwarf number of `reg` under the object's context
pub fun number(b: *build.Builder, reg: rf.Id) res[u16, build.Refusal] {
    val ctx:  *core_state.Context = build.object_of(b);
    val held: err[rf.Absent]      = rf.admitted(ctx.view, reg);
    if (sel held.err) { ret res[u16, build.Refusal].err{refusal(NO_REGISTER)}; }
    ret narrow(core_state.debug_number(ctx.view.file, reg, rf.DWARF, ctx));
}

# the register dwarf number `n` names under the object's context, as gcc names a register in a `.cfi_` directive,
# refused when no register the selection admits has it
pub fun numbered(b: *build.Builder, n: u32) res[rf.Id, build.Refusal] {
    val ctx: *core_state.Context = build.object_of(b);
    val reg: opt[rf.Id]          = core_state.from_debug_number(ctx.view.file, n, rf.DWARF, ctx);
    if (sel reg.none) { ret res[rf.Id, build.Refusal].err{refusal(NO_COLUMN)}; }
    val held: err[rf.Absent] = rf.admitted(ctx.view, reg.some);
    if (sel held.err) { ret res[rf.Id, build.Refusal].err{refusal(NO_REGISTER)}; }
    ret res[rf.Id, build.Refusal].ok{reg.some};
}

# a dwarf number as mink's frame model holds one
fun narrow(n: opt[u32]) res[u16, build.Refusal] {
    if (sel n.none)      { ret res[u16, build.Refusal].err{refusal(NO_NUMBER)}; }
    if (n.some > 0xFFFF) { ret res[u16, build.Refusal].err{refusal(NO_NUMBER)}; }
    ret res[u16, build.Refusal].ok{n.some::u16};
}

# an offset as the canonical frame address and the builder hold one: its fixed bytes, the multiple of a register's
# value it adds and that register's dwarf number, from the gauge of the quantity its slot binds
fun measured(b: *build.Builder, reg: u16, off: Offset) res[build.Cfa, build.Refusal] {
    if (off.per == 0) { ret res[build.Cfa, build.Refusal].ok{build.Cfa{reg: reg, fixed: off.fixed, scale: 0, quantity: 0}}; }
    val ctx: *core_state.Context = build.object_of(b);
    val q:   opt[u8]             = rf.bound(ctx.view, off.scale);
    if (sel q.none) { ret res[build.Cfa, build.Refusal].err{refusal(NO_SCALE)}; }
    val held: *quantity.Quantity = ?ctx.view.file.quantities.at[q.some];
    if (!sel held.measure.register) { ret res[build.Cfa, build.Refusal].err{refusal(NO_GAUGE)}; }
    val g:     quantity.Gauge = held.measure.register;
    val share: opt[i64]       = quantity.share(held, off.per);
    if (sel share.none) { ret res[build.Cfa, build.Refusal].err{refusal(UNEVEN)}; }
    val col: opt[*rf.Column] = core_state.column(ctx.view.file, rf.DWARF, ctx);
    if (sel col.none) { ret res[build.Cfa, build.Refusal].err{refusal(NO_NUMBER)}; }
    val n: res[u16, build.Refusal] = narrow(rf.numbered_in(col.some, g.row));
    if (sel n.err) { ret res[build.Cfa, build.Refusal].err{n.err}; }
    ret res[build.Cfa, build.Refusal].ok{build.Cfa{reg: reg, fixed: off.fixed, scale: share.some, quantity: n.ok}};
}

# the sum of `x` and `y`, or `x` less `y`, refused when they scale by two quantities
fun combined(x: build.Cfa, y: build.Cfa, minus: bool) res[build.Cfa, build.Refusal] {
    if (x.scale != 0 && y.scale != 0 && x.quantity != y.quantity) { ret res[build.Cfa, build.Refusal].err{refusal(MIXED)}; }
    var out: build.Cfa = x;
    if (minus) {
        out.fixed = x.fixed - y.fixed;
        out.scale = x.scale - y.scale;
    }
    or {
        out.fixed = x.fixed + y.fixed;
        out.scale = x.scale + y.scale;
    }
    if (x.scale == 0) { out.quantity = y.quantity; }
    ret res[build.Cfa, build.Refusal].ok{out};
}

# the canonical frame address the open frame's rules leave
fun current(b: *build.Builder) res[build.Cfa, build.Refusal] {
    val c: opt[build.Cfa] = build.cfa(b);
    if (sel c.none) { ret res[build.Cfa, build.Refusal].err{refusal(NO_FRAME)}; }
    ret res[build.Cfa, build.Refusal].ok{c.some};
}

# the rule that makes the canonical frame address `c`, whose offset scales, when `cfa`, else that saves register `n` at
# offset `c` from it, as mink's first-class scaled rules
fun scaled(n: u16, c: build.Cfa, cfa: bool) frame.Rule {
    if (cfa) { ret frame.Rule.def_cfa_scaled{frame.Scaled{reg: c.reg, fixed: c.fixed, scale: c.scale, quantity: c.quantity}}; }
    ret frame.Rule.scaled{frame.Scaled{reg: n, fixed: c.fixed, scale: c.scale, quantity: c.quantity}};
}

# the canonical frame address made `c`, by the rule that states the least of it that changes from what the rules left
fun set_cfa(b: *build.Builder, c: build.Cfa) err[build.Refusal] {
    if (c.scale != 0) { ret build.cfi(b, scaled(c.reg, c, true)); }
    val now: res[build.Cfa, build.Refusal] = current(b);
    if (sel now.err)                              { ret err[build.Refusal].err{now.err}; }
    if (now.ok.scale == 0 && now.ok.reg == c.reg) { ret build.cfi(b, frame.Rule.cfa_offset{c.fixed}); }
    ret build.cfi(b, frame.Rule.def_cfa{frame.Offset{reg: c.reg, offset: c.fixed}});
}

# the procedure of the function at `function` begun at the cursor, as `.cfi_startproc` begins one
pub fun start_proc(b: *build.Builder, function: build.Label) err[build.Refusal] {
    ret build.cfi_start(b, function);
}

# the open procedure ended at the cursor, as `.cfi_endproc` ends one
pub fun end_proc(b: *build.Builder) err[build.Refusal] {
    ret build.cfi_end(b);
}

# the canonical frame address made `reg` plus `off`, as `.cfi_def_cfa`
pub fun def_cfa(b: *build.Builder, reg: rf.Id, off: Offset) err[build.Refusal] {
    val n: res[u16, build.Refusal] = number(b, reg);
    if (sel n.err) { ret err[build.Refusal].err{n.err}; }
    val c: res[build.Cfa, build.Refusal] = measured(b, n.ok, off);
    if (sel c.err)       { ret err[build.Refusal].err{c.err}; }
    if (c.ok.scale != 0) { ret set_cfa(b, c.ok); }
    ret build.cfi(b, frame.Rule.def_cfa{frame.Offset{reg: n.ok, offset: off.fixed}});
}

# the canonical frame address made an offset from `reg`, its offset kept, as `.cfi_def_cfa_register`
pub fun def_cfa_register(b: *build.Builder, reg: rf.Id) err[build.Refusal] {
    val n: res[u16, build.Refusal] = number(b, reg);
    if (sel n.err) { ret err[build.Refusal].err{n.err}; }
    val now: res[build.Cfa, build.Refusal] = current(b);
    if (sel now.err) { ret err[build.Refusal].err{now.err}; }
    if (now.ok.scale != 0) {
        var c: build.Cfa = now.ok;
        c.reg = n.ok;
        ret set_cfa(b, c);
    }
    ret build.cfi(b, frame.Rule.cfa_register{n.ok});
}

# the canonical frame address made `off` from its register, as `.cfi_def_cfa_offset`
pub fun def_cfa_offset(b: *build.Builder, off: Offset) err[build.Refusal] {
    val now: res[build.Cfa, build.Refusal] = current(b);
    if (sel now.err) { ret err[build.Refusal].err{now.err}; }
    val c: res[build.Cfa, build.Refusal] = measured(b, now.ok.reg, off);
    if (sel c.err) { ret err[build.Refusal].err{c.err}; }
    ret set_cfa(b, c.ok);
}

# the canonical frame address's offset moved by `delta`, as `.cfi_adjust_cfa_offset`
pub fun adjust_cfa_offset(b: *build.Builder, delta: Offset) err[build.Refusal] {
    val now: res[build.Cfa, build.Refusal] = current(b);
    if (sel now.err) { ret err[build.Refusal].err{now.err}; }
    val d: res[build.Cfa, build.Refusal] = measured(b, now.ok.reg, delta);
    if (sel d.err) { ret err[build.Refusal].err{d.err}; }
    val c: res[build.Cfa, build.Refusal] = combined(now.ok, d.ok, false);
    if (sel c.err) { ret err[build.Refusal].err{c.err}; }
    ret set_cfa(b, c.ok);
}

# `reg` saved at `off` from the canonical frame address, or its value that address plus `off` when `value`
fun saved(b: *build.Builder, n: u16, c: build.Cfa, value: bool) err[build.Refusal] {
    if (c.scale != 0) {
        if (value) { ret refused(NO_SCALED); }
        ret build.cfi(b, scaled(n, c, false));
    }
    if (value) { ret build.cfi(b, frame.Rule.val_offset{frame.Offset{reg: n, offset: c.fixed}}); }
    ret build.cfi(b, frame.Rule.offset{frame.Offset{reg: n, offset: c.fixed}});
}

fun save(b: *build.Builder, reg: rf.Id, off: Offset, value: bool) err[build.Refusal] {
    val n: res[u16, build.Refusal] = number(b, reg);
    if (sel n.err) { ret err[build.Refusal].err{n.err}; }
    val c: res[build.Cfa, build.Refusal] = measured(b, n.ok, off);
    if (sel c.err) { ret err[build.Refusal].err{c.err}; }
    ret saved(b, n.ok, c.ok, value);
}

# `reg` saved at `off` from the canonical frame address, as `.cfi_offset`
pub fun offset(b: *build.Builder, reg: rf.Id, off: Offset) err[build.Refusal] {
    ret save(b, reg, off, false);
}

# `reg`'s value the canonical frame address plus `off`, as `.cfi_val_offset`
pub fun val_offset(b: *build.Builder, reg: rf.Id, off: Offset) err[build.Refusal] {
    ret save(b, reg, off, true);
}

# `reg` saved at `off` from the canonical frame address's register, as `.cfi_rel_offset`
pub fun rel_offset(b: *build.Builder, reg: rf.Id, off: Offset) err[build.Refusal] {
    val n: res[u16, build.Refusal] = number(b, reg);
    if (sel n.err) { ret err[build.Refusal].err{n.err}; }
    val now: res[build.Cfa, build.Refusal] = current(b);
    if (sel now.err) { ret err[build.Refusal].err{now.err}; }
    val o: res[build.Cfa, build.Refusal] = measured(b, n.ok, off);
    if (sel o.err) { ret err[build.Refusal].err{o.err}; }
    val c: res[build.Cfa, build.Refusal] = combined(o.ok, now.ok, true);
    if (sel c.err) { ret err[build.Refusal].err{c.err}; }
    ret saved(b, n.ok, c.ok, false);
}

# `reg` saved in `other`, as `.cfi_register`
pub fun register(b: *build.Builder, reg: rf.Id, other: rf.Id) err[build.Refusal] {
    val n: res[u16, build.Refusal] = number(b, reg);
    if (sel n.err) { ret err[build.Refusal].err{n.err}; }
    val m: res[u16, build.Refusal] = number(b, other);
    if (sel m.err) { ret err[build.Refusal].err{m.err}; }
    ret build.cfi(b, frame.Rule.register{frame.Moved{reg: n.ok, from: m.ok}});
}

# `reg`'s rule made the one the frame began with, as `.cfi_restore`
pub fun restore(b: *build.Builder, reg: rf.Id) err[build.Refusal] {
    val n: res[u16, build.Refusal] = number(b, reg);
    if (sel n.err) { ret err[build.Refusal].err{n.err}; }
    ret build.cfi(b, frame.Rule.restore{n.ok});
}

# `reg`'s value at the call lost, as `.cfi_undefined`
pub fun undefined(b: *build.Builder, reg: rf.Id) err[build.Refusal] {
    val n: res[u16, build.Refusal] = number(b, reg);
    if (sel n.err) { ret err[build.Refusal].err{n.err}; }
    ret build.cfi(b, frame.Rule.undefined{n.ok});
}

# `reg` holding its value at the call, as `.cfi_same_value`
pub fun same_value(b: *build.Builder, reg: rf.Id) err[build.Refusal] {
    val n: res[u16, build.Refusal] = number(b, reg);
    if (sel n.err) { ret err[build.Refusal].err{n.err}; }
    ret build.cfi(b, frame.Rule.same{n.ok});
}

# every rule remembered, to be restored by `restore_state`, as `.cfi_remember_state`
pub fun remember_state(b: *build.Builder) err[build.Refusal] {
    ret build.cfi(b, frame.Rule.remember{});
}

# the rules the last `remember_state` remembered made the rules again, refused when none is remembered, as
# `.cfi_restore_state`
pub fun restore_state(b: *build.Builder) err[build.Refusal] {
    ret build.cfi(b, frame.Rule.restore_state{});
}

# the `n` call frame instruction bytes at `p` as written, as `.cfi_escape`, which only dwarf formats encode
pub fun escape(b: *build.Builder, p: *u8, n: usize) err[build.Refusal] {
    ret build.cfi(b, frame.Rule.expression{store.Held.borrowed{store.Bytes{data: p, len: n}}});
}

# the open procedure's personality routine, the function at `target`, or with `indirect` a slot of the object at
# `target` that holds its address, as `.cfi_personality`
pub fun personality(b: *build.Builder, target: build.Label, indirect: bool) err[build.Refusal] {
    ret build.cfi_personality(b, build.Pointed{label: target, indirect: indirect});
}

# the open procedure's language specific data, at `target`, or with `indirect` a slot of the object at `target` that
# holds its address, as `.cfi_lsda`
pub fun lsda(b: *build.Builder, target: build.Label, indirect: bool) err[build.Refusal] {
    ret build.cfi_lsda(b, build.Pointed{label: target, indirect: indirect});
}

# the tables every procedure is written to, in place of the format's default, as `.cfi_sections`. a table the format
# does not offer is refused when the object is written
pub fun sections(b: *build.Builder, to: frame.Destinations) {
    build.cfi_sections(b, to);
}

# the open procedure made a signal handler's, as `.cfi_signal_frame`
pub fun signal_frame(b: *build.Builder) err[build.Refusal] {
    ret build.cfi_signal(b);
}

# the return address column stated as `reg`, as `.cfi_return_column`: the column is the architecture's in mink's frame
# model, so only that one is taken, and it states nothing more
pub fun return_column(b: *build.Builder, reg: rf.Id) err[build.Refusal] {
    val n: res[u16, build.Refusal] = number(b, reg);
    if (sel n.err) { ret err[build.Refusal].err{n.err}; }
    val open: opt[build.Cfa] = build.cfa(b);
    if (sel open.none) { ret refused(NO_FRAME); }
    val unwind: opt[mink_arch.Unwind] = b.arch.unwind;
    if (sel unwind.none)        { ret refused(RETURN); }
    if (unwind.some.ra != n.ok) { ret refused(RETURN); }
    ret err[build.Refusal].ok{};
}
