# the check of a set's extension catalog, and whether a requirement names only its atoms

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;

use masc.check.check;
use masc.core.extension;
use masc.core.requirement;
use S: masc.core.set;
use masc.core.state;

pub val IMPLIED:        str = "implied extension not in the catalog";
pub val LEVEL_MEMBER:   str = "level member not in the catalog";
pub val CONFLICT:       str = "conflict names an atom neither in the catalog nor a value of the set's axes, or one twice";
pub val COMBINATION:    str = "combination implies an atom not in the catalog, or names one neither in it nor a value of the set's axes";
pub val CONFLICT_TWICE: str = "conflict stated twice";
pub val CONFLICT_ORDER: str = "conflict not stated with its lower extension first, or conflicts not in ascending order";
pub val NO_SYNTAX:      str = "catalog has no selection syntax";
pub val CANONICAL:      str = "extension or level has no canonical name, or two, or one other than its own";
pub val ALIAS_ROWS:     str = "name index entry names no row, or a row past the catalog's";
pub val LEVEL_STATE:    str = "level sets an atom that is no value of the set's axes, or names a state value among its members";

# the own name of row `row` of the catalog's name index: an extension, then a level
fun own_name(catalog: *extension.Catalog, row: u32) str {
    if (row < catalog.count) { ret catalog.extensions[row].name; }
    ret catalog.levels[row - catalog.count].name;
}

# whether the catalog's name index ascends by key with no key twice, every entry names rows of the catalog, and every
# extension and level has exactly one canonical entry, keyed by its own name and naming it alone
fun names(s: *S.Set) err[check.Refusal] {
    val catalog: *extension.Catalog = s.extensions;
    val rows:    u32                = catalog.count + catalog.level_count;
    var i:       u32                = 0;
    for (i < catalog.names.len) {
        val e: *extension.NameEntry = ?catalog.names.at[i];
        if (e.key == nil || e.key[0] == 0) { ret check.refuse(s, check.UNNAMED, "extension name", i); }
        if (e.rows.len == 0)               { ret check.refuse(s, ALIAS_ROWS, "extension name", i); }
        var k: u32 = 0;
        for (k < e.rows.len) {
            if (e.rows.at[k] >= rows) { ret check.refuse(s, ALIAS_ROWS, "extension name", i); }
            k = k + 1;
        }
        if (e.canonical && (e.rows.len != 1 || !str_equals(e.key, own_name(catalog, e.rows.at[0])))) { ret check.refuse(s, CANONICAL, "extension name", i); }
        if (i > 0) {
            val order: i64 = str_compare(catalog.names.at[i - 1].key, e.key);
            if (order == 0) { ret check.refuse_pair(s, check.SHARED_NAME, "extension name", i - 1, i); }
            if (order > 0)  { ret check.refuse(s, check.NAME_ORDER, "extension name", i); }
        }
        i = i + 1;
    }
    # each row's canonical entry is the one keyed by its own name, which the order lets a search find
    var row: u32 = 0;
    for (row < rows) {
        val name:  str                       = own_name(catalog, row);
        val found: opt[*extension.NameEntry] = extension.entry(catalog, check.spelled(name), false);
        if (sel found.none) { ret check.refuse(s, CANONICAL, "extension", row); }
        val e: *extension.NameEntry = found.some;
        if (!e.canonical || e.rows.at[0] != row) { ret check.refuse(s, CANONICAL, "extension", row); }
        row = row + 1;
    }
    var canonical: u32 = 0;
    i = 0;
    for (i < catalog.names.len) {
        if (catalog.names.at[i].canonical) { canonical = canonical + 1; }
        i = i + 1;
    }
    if (canonical != rows) { ret check.refuse(s, CANONICAL, "extension name", canonical); }
    ret check.fine();
}

# whether every atom of every alternative of `required` is a row of the set's catalog or a value of its axes, and no
# alternative excludes an atom it needs, which no context could meet
pub fun required_known(s: *S.Set, required: requirement.Requirement) bool {
    var i: u32 = 0;
    for (i < required.len) {
        val alt: requirement.Alternative = required.at[i];
        if (!known(s, alt.all) || !known(s, alt.none)) { ret false; }
        var k: u32 = 0;
        for (k < alt.none.len) {
            var j: u32 = 0;
            for (j < alt.all.len) {
                if (alt.all.at[j] == alt.none.at[k]) { ret false; }
                j = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret true;
}

# whether every atom of `ids` is a row of the set's catalog or a value of its axes
pub fun known(s: *S.Set, ids: requirement.Ids) bool {
    val count: u32 = state.atom_count(s.extensions, ?s.states);
    var i:     u32 = 0;
    for (i < ids.len) {
        if (ids.at[i] >= count) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether every id of `ids` is a row of `catalog`
pub fun in_catalog(catalog: *extension.Catalog, ids: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (ids.at[i] >= catalog.count) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun extensions(s: *S.Set) err[check.Refusal] {
    val catalog: *extension.Catalog = s.extensions;
    if (catalog.syntax == nil) { ret check.refuse(s, NO_SYNTAX, "catalog", 0); }
    val named: err[check.Refusal] = names(s);
    if (sel named.err) { ret named; }
    var i: u32 = 0;
    for (i < catalog.count) {
        if (!in_catalog(catalog, catalog.extensions[i].implies)) { ret check.refuse(s, IMPLIED, "extension", i); }
        i = i + 1;
    }
    i = 0;
    for (i < catalog.level_count) {
        val level: *extension.Level = ?catalog.levels[i];
        if (!in_catalog(catalog, level.members)) { ret check.refuse(s, LEVEL_MEMBER, "level", i); }
        if (!known(s, level.state))              { ret check.refuse(s, LEVEL_STATE, "level", i); }
        var k: u32 = 0;
        for (k < level.state.len) {
            if (level.state.at[k] < catalog.count) { ret check.refuse(s, LEVEL_STATE, "level", i); }
            k = k + 1;
        }
        i = i + 1;
    }
    val atoms: u32 = state.atom_count(catalog, ?s.states);
    i = 0;
    for (i < catalog.conflict_count) {
        val pair: extension.Conflict = catalog.conflicts[i];
        if (pair.a >= atoms || pair.b >= atoms || pair.a == pair.b) { ret check.refuse(s, CONFLICT, "conflict", i); }
        if (pair.a > pair.b)                                        { ret check.refuse(s, CONFLICT_ORDER, "conflict", i); }
        if (i > 0) {
            val before: extension.Conflict = catalog.conflicts[i - 1];
            if (before.a == pair.a && before.b == pair.b)                       { ret check.refuse(s, CONFLICT_TWICE, "conflict", i); }
            if (before.a > pair.a || (before.a == pair.a && before.b > pair.b)) { ret check.refuse(s, CONFLICT_ORDER, "conflict", i); }
        }
        i = i + 1;
    }
    i = 0;
    for (i < catalog.combination_count) {
        val combo: extension.Combination = catalog.combinations[i];
        if (combo.by >= catalog.count || !known(s, combo.when) || !in_catalog(catalog, combo.implies)) { ret check.refuse(s, COMBINATION, "combination", i); }
        i = i + 1;
    }
    ret check.fine();
}
