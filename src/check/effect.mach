# the check of a row's effect: its registers, flags, memory, control and rules

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use masc.check.check;
use check_register: masc.check.register;
use masc.core.ct;
use masc.core.effect;
use masc.core.field;
use masc.core.operand;
use masc.core.register;
use masc.core.row;
use S: masc.core.set;

pub val NO_EFFECT:      str = "row has no effect or no constant-time class";
pub val EFFECT_OPERAND: str = "effect names an operand the row does not have";
pub val ACCESS_FORM:    str = "access through a memory operand states its own width or role, or another access states no role";
pub val RULE_TERMS:     str = "effect rule has no terms";
pub val RULE_OVERLAP:   str = "two rules of one effect field can both hold";
pub val RULE_OPERAND:   str = "effect rule tests an operand the row does not have, or of another kind than its test";
pub val RULE_BOUNDS:    str = "implicit registers' may or must set is not the union or intersection of its own and its rules' sets";
pub val OPAQUE_BOUNDS:  str = "opaque implicit registers' must set holds a register its may set lacks";
pub val ACCRUED_WRITE:  str = "write of an accrued register that is not also a read";
pub val TAIL_WRITE:     str = "row reading the vector length writes a vector register it does not also read";
pub val FIXED_OPERAND:  str = "fixed operand is not a register operand";
pub val FIXED_CLASS:    str = "fixed register outside its operand's classes or range";
pub val NO_INPUT:       str = "dependent class names no input";
pub val CONDITION:      str = "constant-time condition not in the catalog";

# whether `op` is an operand of `r` or NO_OPERAND
fun operand_or_none(r: *row.Row, op: u8) bool {
    ret op == field.NO_OPERAND || op::u32 < r.operands.len;
}

fun count_ok(s: *S.Set, r: *row.Row, c: *effect.Count) bool {
    if (sel c.register) { ret c.register < check_register.register_count(s); }
    if (sel c.operand)  { ret c.operand::u32 < r.operands.len; }
    ret true;
}

fun access(s: *S.Set, r: *row.Row, a: *effect.Access) opt[str] {
    if (!operand_or_none(r, a.operand) || !operand_or_none(r, a.governor) || (a.forming & ~field.ones(r.operands.len::u8)::u32) != 0 || !count_ok(s, r, ?a.width.count)) {
        ret opt[str].some{EFFECT_OPERAND};
    }
    if (a.base != effect.NO_ROW && a.base >= check_register.register_count(s)) { ret opt[str].some{check.EFFECT_ROW}; }
    var through: bool = false;
    if (a.operand != field.NO_OPERAND) {
        val desc: *operand.Operand = ?r.operands.at[a.operand];
        through = sel desc.shape.memory;
        if (through && (desc.width != 0 || a.role != operand.NONE)) { ret opt[str].some{ACCESS_FORM}; }
    }
    if (!through && a.role == operand.NONE) { ret opt[str].some{ACCESS_FORM}; }
    ret opt[str].none{};
}

# whether `all`, one rule's terms, are at least one and each test an operand of `r` of its kind over rows of the file
pub fun terms(s: *S.Set, r: *row.Row, all: effect.Terms) opt[str] {
    if (all.len == 0) { ret opt[str].some{RULE_TERMS}; }
    var k: u32 = 0;
    for (k < all.len) {
        val term: *effect.Term = ?all.at[k];
        if (term.operand::u32 >= r.operands.len) { ret opt[str].some{RULE_OPERAND}; }
        val sh: *operand.Shape = ?r.operands.at[term.operand].shape;
        if (sel term.test.register) {
            if (!sel sh.register) { ret opt[str].some{RULE_OPERAND}; }
            val held: opt[str] = check_register.holds(s, term.test.register, false);
            if (sel held.some) { ret held; }
        }
        if (sel term.test.immediate && !sel sh.immediate) { ret opt[str].some{RULE_OPERAND}; }
        if (sel term.test.enumerant && !sel sh.enumerant) { ret opt[str].some{RULE_OPERAND}; }
        if (sel term.test.condition && !sel sh.condition) { ret opt[str].some{RULE_OPERAND}; }
        if (sel term.test.id && !sel sh.id)               { ret opt[str].some{RULE_OPERAND}; }
        k = k + 1;
    }
    ret opt[str].none{};
}

# whether the rules of `c` each have checked terms and are pairwise exclusive, so that no order among them can matter
fun rules(s: *S.Set, r: *row.Row, c: *effect.Control) opt[str] {
    var i: u32 = 0;
    for (i < c.rules.len) {
        val rule:   *effect.Rule = ?c.rules.at[i];
        val tested: opt[str]     = terms(s, r, rule.terms);
        if (sel tested.some)                                                   { ret tested; }
        if (rule.target != effect.UNTARGETED && c.operand == field.NO_OPERAND) { ret opt[str].some{EFFECT_OPERAND}; }
        var j: u32 = 0;
        for (j < i) {
            if (!effect.exclusive(c.rules.at[j].terms, rule.terms)) { ret opt[str].some{RULE_OVERLAP}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

# whether `t` names rows of the file
fun touched(s: *S.Set, t: effect.Touched) opt[str] {
    val read: opt[str] = check_register.holds(s, t.read, false);
    if (sel read.some) { ret read; }
    ret check_register.holds(s, t.written, false);
}

# whether the implicit registers `g` name rows of the file, its rules each have checked terms and are pairwise exclusive,
# and its may and must sets bound its own and its rules'
fun register_rules(s: *S.Set, r: *row.Row, all: *effect.Registers) opt[str] {
    if (sel all.opaque) { ret opaque(s, ?all.opaque); }
    val g:    *effect.Ruled     = ?all.ruled;
    val sets: [3]effect.Touched = [3]effect.Touched{g.otherwise, g.may, g.must};
    var i:    u32               = 0;
    for (i < 3) {
        val held: opt[str] = touched(s, sets[i]);
        if (sel held.some) { ret held; }
        i = i + 1;
    }
    i = 0;
    for (i < g.rules.len) {
        val rule:   *effect.RegisterRule = ?g.rules.at[i];
        val tested: opt[str]             = terms(s, r, rule.terms);
        if (sel tested.some) { ret tested; }
        val held: opt[str] = touched(s, rule.touched);
        if (sel held.some) { ret held; }
        var j: u32 = 0;
        for (j < i) {
            if (!effect.exclusive(g.rules.at[j].terms, rule.terms)) { ret opt[str].some{RULE_OVERLAP}; }
            j = j + 1;
        }
        i = i + 1;
    }
    if (!effect.bounded(g, (check_register.register_count(s) + 63) / 64)) { ret opt[str].some{RULE_BOUNDS}; }
    ret opt[str].none{};
}

# whether the opaque implicit registers `o` name rows of the file and must is within may
fun opaque(s: *S.Set, o: *effect.Opaque) opt[str] {
    val may: opt[str] = touched(s, o.may);
    if (sel may.some) { ret may; }
    val must: opt[str] = touched(s, o.must);
    if (sel must.some)                                                              { ret must; }
    if (!subset(o.must.read, o.may.read) || !subset(o.must.written, o.may.written)) { ret opt[str].some{OPAQUE_BOUNDS}; }
    ret opt[str].none{};
}

# whether every row `a` holds `b` holds
fun subset(a: effect.Set, b: effect.Set) bool {
    var w: u32 = 0;
    for (w < a.len) {
        var other: u64 = 0;
        if (w < b.len)                  { other = b.words[w]; }
        if ((a.words[w] & ~other) != 0) { ret false; }
        w = w + 1;
    }
    ret true;
}

# whether `set` holds row `at`
fun in_set(set: effect.Set, at: u32) bool {
    val w: u32 = at / 64;
    ret w < set.len && ((set.words[w] >> (at % 64)::u64) & 1) != 0;
}

# whether register row `at` of the file has every bit of `flag`
fun flagged(s: *S.Set, at: u32, flag: register.Flags) bool {
    ret (s.codec.registers.registers[at].flags & flag) == flag;
}

# whether `set` holds a row of the file flagged `flag`
fun holds_flagged(s: *S.Set, set: effect.Set, flag: register.Flags) bool {
    val count: u32 = check_register.register_count(s);
    var at:    u32 = 0;
    for (at < count) {
        if (in_set(set, at) && flagged(s, at, flag)) { ret true; }
        at = at + 1;
    }
    ret false;
}

# whether register row `at` of the file is of a vector class
fun vector_row(s: *S.Set, at: u32) bool {
    val file: *register.File = s.codec.registers;
    ret file.classes[file.registers[at].class].kind == register.VECTOR;
}

# whether `t` writes a register it may keep some of without reading it: an accrued register, or a vector register while
# it reads the vector length, past which elements may keep their values
fun kept(s: *S.Set, t: effect.Touched) opt[str] {
    val length: bool = holds_flagged(s, t.read, register.LENGTH);
    val count:  u32  = check_register.register_count(s);
    var at:     u32  = 0;
    for (at < count) {
        if (in_set(t.written, at) && !in_set(t.read, at)) {
            if (flagged(s, at, register.ACCRUED)) { ret opt[str].some{ACCRUED_WRITE}; }
            if (length && vector_row(s, at))      { ret opt[str].some{TAIL_WRITE}; }
        }
        at = at + 1;
    }
    ret opt[str].none{};
}

# whether a register operand `reg` admits register row `at` of the file
fun admits_row(s: *S.Set, reg: *operand.Register, at: u32) bool {
    val file: *register.File     = s.codec.registers;
    val x:    *register.Register = ?file.registers[at];
    ret operand.find(reg.classes, x.class) >= 0 && operand.within(reg, x.number::u32, file.classes[x.class].count) && !operand.excludes_number(reg, x.number::u32);
}

# whether the writes of `r` that may keep some of a register's old value are reads too, wherever the file states the
# facts that decide it: no implicit set or rule writes an accrued register it does not read, or a vector register while
# it reads the vector length, and no operand that writes and does not read admits an accrued register, or a vector
# register while some values read the vector length. the contract of effect.Touched
fun merged(s: *S.Set, r: *row.Row) opt[str] {
    val all: *effect.Registers = ?r.effect.implicit;
    var may: effect.Touched    = effect.may(r.effect);
    if (sel all.opaque) {
        val own: opt[str] = kept(s, may);
        if (sel own.some) { ret own; }
    }
    or (sel all.ruled) {
        val g:   *effect.Ruled = ?all.ruled;
        val own: opt[str]      = kept(s, g.otherwise);
        if (sel own.some) { ret own; }
        var i: u32 = 0;
        for (i < g.rules.len) {
            val ruled: opt[str] = kept(s, g.rules.at[i].touched);
            if (sel ruled.some) { ret ruled; }
            i = i + 1;
        }
    }
    val length: bool = holds_flagged(s, may.read, register.LENGTH);
    val count:  u32  = check_register.register_count(s);
    var k:      u32  = 0;
    for (k < r.operands.len) {
        val op:  *operand.Operand  = ?r.operands.at[k];
        var reg: *operand.Register = nil;
        if (sel op.shape.register) { reg = ?op.shape.register; }
        or (sel op.shape.list)     { reg = ?op.shape.list.member; }
        if (reg != nil && (op.role & operand.WRITE) != 0 && (op.role & operand.READ) == 0) {
            var at: u32 = 0;
            for (at < count) {
                if (admits_row(s, reg, at)) {
                    if (flagged(s, at, register.ACCRUED)) { ret opt[str].some{ACCRUED_WRITE}; }
                    if (length && vector_row(s, at))      { ret opt[str].some{TAIL_WRITE}; }
                }
                at = at + 1;
            }
        }
        k = k + 1;
    }
    ret opt[str].none{};
}

pub fun effects(s: *S.Set, r: *row.Row) opt[str] {
    if (r.effect == nil || r.ct == nil) { ret opt[str].some{NO_EFFECT}; }
    val e:         *effect.Effect = r.effect;
    val flag_sets: [4]effect.Set  = [4]effect.Set{e.flags.read, e.flags.written, e.flags.undefined, e.flags.kept};
    val switched:  opt[str]       = register_rules(s, r, ?e.implicit);
    if (sel switched.some) { ret switched; }
    val partial: opt[str] = merged(s, r);
    if (sel partial.some) { ret partial; }
    var i: u32 = 0;
    for (i < 4) {
        val held: opt[str] = check_register.holds(s, flag_sets[i], true);
        if (sel held.some) { ret held; }
        i = i + 1;
    }
    i = 0;
    for (i < e.memory.len) {
        val checked: opt[str] = access(s, r, ?e.memory.at[i]);
        if (sel checked.some) { ret checked; }
        i = i + 1;
    }
    if (!operand_or_none(r, e.control.operand)) { ret opt[str].some{EFFECT_OPERAND}; }
    val ruled: opt[str] = rules(s, r, ?e.control);
    if (sel ruled.some) { ret ruled; }
    val stack: *effect.Stack = ?e.stack;
    if (sel stack.delta && !operand_or_none(r, stack.delta.operand)) { ret opt[str].some{EFFECT_OPERAND}; }
    i = 0;
    for (i < e.fixed.len) {
        val fx: effect.Fixed = e.fixed.at[i];
        if (fx.operand::u32 >= r.operands.len) { ret opt[str].some{FIXED_OPERAND}; }
        val sh: *operand.Shape = ?r.operands.at[fx.operand].shape;
        if (!sel sh.register)                                { ret opt[str].some{FIXED_OPERAND}; }
        if (fx.register >= check_register.register_count(s)) { ret opt[str].some{check.EFFECT_ROW}; }
        val reg: *register.Register = ?s.codec.registers.registers[fx.register];
        val r:   *operand.Register  = ?sh.register;
        if (operand.find(r.classes, reg.class) < 0 || !operand.within(r, reg.number::u32, s.codec.registers.classes[reg.class].count)) {
            ret opt[str].some{FIXED_CLASS};
        }
        i = i + 1;
    }
    val c: *ct.Class = r.ct;
    if (sel c.dependent && (c.dependent.operands == operand.NO_POSITIONS && !c.dependent.accesses)) { ret opt[str].some{NO_INPUT}; }
    if (sel c.conditional && c.conditional.condition >= s.extensions.count)                         { ret opt[str].some{CONDITION}; }
    ret opt[str].none{};
}
