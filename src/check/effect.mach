# the check of a row's effect: its registers, flags, memory, control and rules

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use masc.check.check;
use check_extension: masc.check.extension;
use check_register:  masc.check.register;
use masc.core.ct;
use masc.core.effect;
use masc.core.field;
use masc.core.operand;
use masc.core.register;
use masc.core.row;
use S: masc.core.set;
use masc.core.state;

pub val NO_EFFECT:      str = "row has no effect or no constant-time class";
pub val EFFECT_OPERAND: str = "effect names an operand the row does not have";
pub val ACCESS_FORM:    str = "access through a memory operand states its own width or role, or another access states no role";
pub val ACCESS_OFFSET:  str = "access states an offset from an address no operand or base register states";
pub val RULE_TERMS:     str = "effect rule has no terms";
pub val RULE_OVERLAP:   str = "two rules of one effect field can both hold";
pub val RULE_OPERAND:   str = "effect rule tests an operand the row does not have, or of another kind than its test";
pub val RULE_BOUNDS:    str = "implicit registers' may or must set is not the union or intersection of its own and its rules' sets";
pub val OPAQUE_BOUNDS:  str = "opaque implicit registers' must set holds a register its may set lacks";
pub val ACCRUED_WRITE:  str = "write of an accrued register that is not also a read";
pub val TAIL_WRITE:     str = "row reading the vector length writes a vector register it does not also read";
pub val FIXED_OPERAND:  str = "fixed operand is not a register operand";
pub val FIXED_CLASS:    str = "fixed register outside its operand's classes or range";
pub val NO_INPUT:       str = "dependent class names no input";
pub val REMAINING:      str = "constant-time gate keeps an input under its condition that it does not depend on without it";
pub val CONDITION:      str = "constant-time condition empty, or naming an atom neither in the catalog nor a value of the set's axes";
pub val UNTIMED:        str = "row of a set that classifies no instruction's timing, or guarantees none, states a class other than dependent";
pub val TRANSFER:       str = "control transfer or target of no kind the effect record states";
pub val UNSTREAMED:     str = "depth or structured branch, merge, stack signature, popped value, index space entry, structure or defined value in a set with no typed stream";
pub val DEPTH_OPERAND:  str = "depth branch names no operand holding its depth";
pub val SIGNATURE:      str = "stack signature names an operand the row does not have";
pub val UNRESOLVED:     str = "stack signature in a set whose stream resolves no arity";
pub val POPPED:         str = "popped value named past the values the row's signature pops";
pub val ENTRY:          str = "index space entry named by an operand that is no id, or with no role";
pub val STRUCTURE:      str = "structure of no kind the effect record states, or a structured transfer of a row that opens no block and splits none";
pub val VALUES:         str = "defined value or its type named by an operand that is no id";
pub val IMPLICIT_WRITE: str = "implicit write states a register the effect never writes, or one register twice";
pub val TUPLE_SET:      str = "set of registers names a tuple without each of its members a read or write reaches";
pub val RELATION_TO:    str = "relation writes a register that is no register operand the row writes and no row the effect surely writes, or one register twice";
pub val RELATION_FROM:  str = "relation starts from a register that is no register operand the row reads, no row the effect surely reads and no memory operand's base";
pub val RELATION_BY:    str = "relation adds what is no immediate operand of the row and no displacement of the address it starts from";
pub val RELATION_SHIFT: str = "relation shifts by what is no immediate or enumerant operand of the row, or states a step with no shift";

# whether `op` is an operand of `r` or NO_OPERAND
fun operand_or_none(r: *row.Row, op: u8) bool {
    ret op == field.NO_OPERAND || op::u32 < r.operands.len;
}

fun count_ok(s: *S.Set, r: *row.Row, c: *effect.Count) bool {
    if (sel c.register) { ret c.register < check_register.register_count(s); }
    if (sel c.operand)  { ret c.operand::u32 < r.operands.len; }
    ret true;
}

fun access(s: *S.Set, r: *row.Row, a: *effect.Access) opt[str] {
    if (!operand_or_none(r, a.operand) || !operand_or_none(r, a.governor) || (a.forming & ~field.ones(r.operands.len::u8)::u32) != 0 || !count_ok(s, r, ?a.width.count)) {
        ret opt[str].some{EFFECT_OPERAND};
    }
    if (a.base != effect.NO_ROW && a.base >= check_register.register_count(s)) { ret opt[str].some{check.EFFECT_ROW}; }
    var through: bool = false;
    if (a.operand != field.NO_OPERAND) {
        val desc: *operand.Operand = ?r.operands.at[a.operand];
        through = sel desc.shape.memory;
        if (through && (desc.width != 0 || a.role != operand.NONE)) { ret opt[str].some{ACCESS_FORM}; }
    }
    if (!through && a.role == operand.NONE)                                        { ret opt[str].some{ACCESS_FORM}; }
    if (a.offset != 0 && a.operand == field.NO_OPERAND && a.base == effect.NO_ROW) { ret opt[str].some{ACCESS_OFFSET}; }
    ret opt[str].none{};
}

# whether `all`, one rule's terms, are at least one and each test an operand of `r` of its kind over rows of the file
pub fun terms(s: *S.Set, r: *row.Row, all: effect.Terms) opt[str] {
    if (all.len == 0) { ret opt[str].some{RULE_TERMS}; }
    var k: u32 = 0;
    for (k < all.len) {
        val term: *effect.Term = ?all.at[k];
        if (term.operand::u32 >= r.operands.len) { ret opt[str].some{RULE_OPERAND}; }
        val sh: *operand.Shape = ?r.operands.at[term.operand].shape;
        if (sel term.test.register) {
            if (!sel sh.register) { ret opt[str].some{RULE_OPERAND}; }
            val held: opt[str] = check_register.holds(s, term.test.register, false);
            if (sel held.some) { ret held; }
        }
        if (sel term.test.immediate && !sel sh.immediate) { ret opt[str].some{RULE_OPERAND}; }
        if (sel term.test.enumerant && !sel sh.enumerant) { ret opt[str].some{RULE_OPERAND}; }
        if (sel term.test.condition && !sel sh.condition) { ret opt[str].some{RULE_OPERAND}; }
        if (sel term.test.id && !sel sh.id)               { ret opt[str].some{RULE_OPERAND}; }
        k = k + 1;
    }
    ret opt[str].none{};
}

# whether the rules of `c` each have checked terms and are pairwise exclusive, so that no order among them can matter
# whether a transfer and a target are of the kinds the record states, and one only a typed stream has is of a set with one
fun transfer(s: *S.Set, kind: effect.Transfer, target: effect.Target) opt[str] {
    if (kind > effect.FAULT || target > effect.STRUCTURED)                                                        { ret opt[str].some{TRANSFER}; }
    if ((kind == effect.MERGE || target == effect.DEPTH || target == effect.STRUCTURED) && s.codec.stream == nil) { ret opt[str].some{UNSTREAMED}; }
    ret opt[str].none{};
}

fun rules(s: *S.Set, r: *row.Row, c: *effect.Control) opt[str] {
    var i: u32 = 0;
    for (i < c.rules.len) {
        val rule:   *effect.Rule = ?c.rules.at[i];
        val tested: opt[str]     = terms(s, r, rule.terms);
        if (sel tested.some)                                                   { ret tested; }
        if (rule.target != effect.UNTARGETED && c.operand == field.NO_OPERAND) { ret opt[str].some{EFFECT_OPERAND}; }
        val kind: opt[str] = transfer(s, rule.transfer, rule.target);
        if (sel kind.some) { ret kind; }
        var j: u32 = 0;
        for (j < i) {
            if (!effect.exclusive(c.rules.at[j].terms, rule.terms)) { ret opt[str].some{RULE_OVERLAP}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

# whether `t` names rows of the file, and with each tuple each of its members, as an operand's tuple is read and written
fun touched(s: *S.Set, t: effect.Touched) opt[str] {
    val read: opt[str] = check_register.holds(s, t.read, false);
    if (sel read.some) { ret read; }
    val written: opt[str] = check_register.holds(s, t.written, false);
    if (sel written.some)                                         { ret written; }
    if (!closed(s, t.read, false) || !closed(s, t.written, true)) { ret opt[str].some{TUPLE_SET}; }
    ret opt[str].none{};
}

# whether `set` holds each member of every tuple it holds, a written set each member whose write is not discarded
fun closed(s: *S.Set, set: effect.Set, written: bool) bool {
    val count: u32 = check_register.register_count(s);
    var w:     u32 = 0;
    for (w < set.len) {
        var bits: u64 = set.words[w];
        var at:   u32 = w * 64;
        for (bits != 0 && at < count) {
            if ((bits & 1) != 0 && register.tuple(?s.codec.registers.registers[at])) {
                val r: *register.Register = ?s.codec.registers.registers[at];
                var k: u32                = 0;
                for (k < r.members.len) {
                    val m: u32 = r.members.at[k];
                    if (!in_set(set, m) && !(written && flagged(s, m, register.ZERO))) { ret false; }
                    k = k + 1;
                }
            }
            bits = bits >> 1;
            at   = at + 1;
        }
        w = w + 1;
    }
    ret true;
}

# whether the implicit registers `g` name rows of the file, its rules each have checked terms and are pairwise exclusive,
# and its may and must sets bound its own and its rules'
fun register_rules(s: *S.Set, r: *row.Row, all: *effect.Registers) opt[str] {
    if (sel all.opaque) { ret opaque(s, ?all.opaque); }
    val g:    *effect.Ruled     = ?all.ruled;
    val sets: [3]effect.Touched = [3]effect.Touched{g.otherwise, g.may, g.must};
    var i:    u32               = 0;
    for (i < 3) {
        val held: opt[str] = touched(s, sets[i]);
        if (sel held.some) { ret held; }
        i = i + 1;
    }
    i = 0;
    for (i < g.rules.len) {
        val rule:   *effect.RegisterRule = ?g.rules.at[i];
        val tested: opt[str]             = terms(s, r, rule.terms);
        if (sel tested.some) { ret tested; }
        val held: opt[str] = touched(s, rule.touched);
        if (sel held.some) { ret held; }
        var j: u32 = 0;
        for (j < i) {
            if (!effect.exclusive(g.rules.at[j].terms, rule.terms)) { ret opt[str].some{RULE_OVERLAP}; }
            j = j + 1;
        }
        i = i + 1;
    }
    if (!effect.bounded(g, (check_register.register_count(s) + 63) / 64)) { ret opt[str].some{RULE_BOUNDS}; }
    ret opt[str].none{};
}

# whether the opaque implicit registers `o` name rows of the file and must is within may
fun opaque(s: *S.Set, o: *effect.Opaque) opt[str] {
    val may: opt[str] = touched(s, o.may);
    if (sel may.some) { ret may; }
    val must: opt[str] = touched(s, o.must);
    if (sel must.some)                                                              { ret must; }
    if (!subset(o.must.read, o.may.read) || !subset(o.must.written, o.may.written)) { ret opt[str].some{OPAQUE_BOUNDS}; }
    ret opt[str].none{};
}

# whether every row `a` holds `b` holds
fun subset(a: effect.Set, b: effect.Set) bool {
    var w: u32 = 0;
    for (w < a.len) {
        var other: u64 = 0;
        if (w < b.len)                  { other = b.words[w]; }
        if ((a.words[w] & ~other) != 0) { ret false; }
        w = w + 1;
    }
    ret true;
}

# whether `set` holds row `at`
fun in_set(set: effect.Set, at: u32) bool {
    val w: u32 = at / 64;
    ret w < set.len && ((set.words[w] >> (at % 64)::u64) & 1) != 0;
}

# whether register row `at` of the file has every bit of `flag`
fun flagged(s: *S.Set, at: u32, flag: register.Flags) bool {
    ret (s.codec.registers.registers[at].flags & flag) == flag;
}

# whether `set` holds a row of the file flagged `flag`
fun holds_flagged(s: *S.Set, set: effect.Set, flag: register.Flags) bool {
    val count: u32 = check_register.register_count(s);
    var at:    u32 = 0;
    for (at < count) {
        if (in_set(set, at) && flagged(s, at, flag)) { ret true; }
        at = at + 1;
    }
    ret false;
}

# whether register row `at` of the file is of a vector class
fun vector_row(s: *S.Set, at: u32) bool {
    val file: *register.File = s.codec.registers;
    ret file.classes[file.registers[at].class].kind == register.VECTOR;
}

# whether `t` writes a register it may keep some of without reading it: an accrued register, or a vector register while
# it reads the vector length, past which elements may keep their values
fun kept(s: *S.Set, t: effect.Touched) opt[str] {
    val length: bool = holds_flagged(s, t.read, register.LENGTH);
    val count:  u32  = check_register.register_count(s);
    var at:     u32  = 0;
    for (at < count) {
        if (in_set(t.written, at) && !in_set(t.read, at)) {
            if (flagged(s, at, register.ACCRUED)) { ret opt[str].some{ACCRUED_WRITE}; }
            if (length && vector_row(s, at))      { ret opt[str].some{TAIL_WRITE}; }
        }
        at = at + 1;
    }
    ret opt[str].none{};
}

# whether a register operand `reg` admits register row `at` of the file
fun admits_row(s: *S.Set, reg: *operand.Register, at: u32) bool {
    val file: *register.File     = s.codec.registers;
    val x:    *register.Register = ?file.registers[at];
    ret operand.find(reg.classes, x.class) >= 0 && operand.within(reg, x.number::u32, register.count_most(file, x.class)::u32) && !operand.excludes_number(reg, x.number::u32);
}

# whether the writes of `r` that may keep some of a register's old value are reads too, wherever the file states the
# facts that decide it: no implicit set or rule writes an accrued register it does not read, or a vector register while
# it reads the vector length, and no operand that writes and does not read admits an accrued register, or a vector
# register while some values read the vector length. the contract of effect.Touched
fun merged(s: *S.Set, r: *row.Row) opt[str] {
    val all: *effect.Registers = ?r.effect.implicit;
    var may: effect.Touched    = effect.may(r.effect);
    if (sel all.opaque) {
        val own: opt[str] = kept(s, may);
        if (sel own.some) { ret own; }
    }
    or (sel all.ruled) {
        val g:   *effect.Ruled = ?all.ruled;
        val own: opt[str]      = kept(s, g.otherwise);
        if (sel own.some) { ret own; }
        var i: u32 = 0;
        for (i < g.rules.len) {
            val ruled: opt[str] = kept(s, g.rules.at[i].touched);
            if (sel ruled.some) { ret ruled; }
            i = i + 1;
        }
    }
    val length: bool = holds_flagged(s, may.read, register.LENGTH);
    val count:  u32  = check_register.register_count(s);
    var k:      u32  = 0;
    for (k < r.operands.len) {
        val op:  *operand.Operand  = ?r.operands.at[k];
        var reg: *operand.Register = nil;
        if (sel op.shape.register) { reg = ?op.shape.register; }
        or (sel op.shape.list)     { reg = ?op.shape.list.member; }
        if (reg != nil && (op.role & operand.WRITE) != 0 && (op.role & operand.READ) == 0) {
            var at: u32 = 0;
            for (at < count) {
                if (admits_row(s, reg, at)) {
                    if (flagged(s, at, register.ACCRUED)) { ret opt[str].some{ACCRUED_WRITE}; }
                    if (length && vector_row(s, at))      { ret opt[str].some{TAIL_WRITE}; }
                }
                at = at + 1;
            }
        }
        k = k + 1;
    }
    ret opt[str].none{};
}

# whether each implicit write of `e` names a row of the file that some values of the effect write, once, and states a
# write a reader can read
fun writes(s: *S.Set, e: *effect.Effect) opt[str] {
    val may: effect.Touched = effect.may(e);
    var i:   u32            = 0;
    for (i < e.writes.len) {
        val w: *effect.ImplicitWrite = ?e.writes.at[i];
        if (w.row >= check_register.register_count(s) || !in_set(may.written, w.row)) { ret opt[str].some{IMPLICIT_WRITE}; }
        var j: u32 = 0;
        for (j < i) {
            if (e.writes.at[j].row == w.row) { ret opt[str].some{IMPLICIT_WRITE}; }
            j = j + 1;
        }
        val file:   *register.File = s.codec.registers;
        val defect: opt[str]       = check_register.write_defect(file, ?w.write, register.width_most(file, file.registers[w.row].class));
        if (sel defect.some) { ret defect; }
        i = i + 1;
    }
    ret opt[str].none{};
}

# the shape of operand `op` of `r`, nil past its operands
fun shape_of(r: *row.Row, op: u8) *operand.Shape {
    if (op::u32 >= r.operands.len) { ret nil; }
    ret ?r.operands.at[op].shape;
}

# whether operand `op` of `r` is a register operand whose role holds `role`
fun register_operand(r: *row.Row, op: u8, role: operand.Role) bool {
    val sh: *operand.Shape = shape_of(r, op);
    if (sh == nil || !sel sh.register) { ret false; }
    ret (r.operands.at[op].role & role) != 0;
}

# whether operand `op` of `r` is a memory operand
fun memory_operand(r: *row.Row, op: u8) bool {
    val sh: *operand.Shape = shape_of(r, op);
    ret sh != nil && sel sh.memory;
}

# whether places `a` and `b` name one register the same way
fun same_place(a: *effect.Place, b: *effect.Place) bool {
    if (sel a.operand) {
        if (sel b.operand) { ret a.operand == b.operand; }
        ret false;
    }
    if (sel a.row) {
        if (sel b.row) { ret a.row == b.row; }
    }
    ret false;
}

# whether offset `o` starts from a register `r` reads or the base of one of its memory operands, adds an immediate of
# the row or that address's displacement, and shifts by a number operand of the row
fun offset(r: *row.Row, must: effect.Touched, count: u32, o: *effect.Offset) opt[str] {
    var base: u8 = field.NO_OPERAND;
    if (sel o.from.operand) {
        if (!register_operand(r, o.from.operand, operand.READ)) { ret opt[str].some{RELATION_FROM}; }
    }
    or (sel o.from.row) {
        if (o.from.row >= count || !in_set(must.read, o.from.row)) { ret opt[str].some{RELATION_FROM}; }
    }
    or (sel o.from.base) {
        if (!memory_operand(r, o.from.base)) { ret opt[str].some{RELATION_FROM}; }
        base = o.from.base;
    }
    if (sel o.by.immediate) {
        val sh: *operand.Shape = shape_of(r, o.by.immediate);
        if (sh == nil || !sel sh.immediate) { ret opt[str].some{RELATION_BY}; }
    }
    or (sel o.by.displacement) {
        if (base == field.NO_OPERAND || o.by.displacement != base) { ret opt[str].some{RELATION_BY}; }
    }
    if (o.shift == field.NO_OPERAND) {
        if (o.step != 0) { ret opt[str].some{RELATION_SHIFT}; }
    }
    or {
        val sh: *operand.Shape = shape_of(r, o.shift);
        if (sh == nil || o.step == 0 || (!sel sh.immediate && !sel sh.enumerant)) { ret opt[str].some{RELATION_SHIFT}; }
    }
    ret opt[str].none{};
}

# whether the relations of `e` each write a register `r` writes, once, start from one it reads, add an immediate of the
# row or the displacement of the address they start from, and shift by a number operand of the row. the contract of
# effect.Relation
fun relations(s: *S.Set, r: *row.Row, e: *effect.Effect) opt[str] {
    val must:  effect.Touched = effect.must(e);
    val count: u32            = check_register.register_count(s);
    var i:     u32            = 0;
    for (i < e.relations.len) {
        val rel: *effect.Relation = ?e.relations.at[i];
        if (sel rel.to.operand) {
            if (!register_operand(r, rel.to.operand, operand.WRITE)) { ret opt[str].some{RELATION_TO}; }
        }
        or (sel rel.to.row) {
            if (rel.to.row >= count || !in_set(must.written, rel.to.row)) { ret opt[str].some{RELATION_TO}; }
        }
        var j: u32 = 0;
        for (j < i) {
            if (same_place(?e.relations.at[j].to, ?rel.to)) { ret opt[str].some{RELATION_TO}; }
            j = j + 1;
        }
        if (sel rel.holds.offset) {
            val checked: opt[str] = offset(r, must, count, ?rel.holds.offset);
            if (sel checked.some) { ret checked; }
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

# whether the types of `types` name operands of `r`
fun typed(r: *row.Row, types: effect.Types) bool {
    var i: u32 = 0;
    for (i < types.len) {
        val t: effect.TypeRef = types.at[i];
        if (sel t.operand && t.operand::u32 >= r.operands.len) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether operand `op`, by its index plus one, is none or an id operand of `r`
fun id_or_none(r: *row.Row, op: u8) bool {
    if (op == 0)                  { ret true; }
    if (op::u32 > r.operands.len) { ret false; }
    val at: u8 = op - 1;
    ret sel r.operands.at[at].shape.id;
}

# whether `pop`, a popped value by its depth plus one, is none or one of the values the signature `sig` pops above its
# polymorphic stack
fun pop_or_none(sig: *effect.Signature, pop: u8) bool {
    if (pop == 0) { ret true; }
    var counted: u32 = 0;
    var i:       u32 = sig.pops.len;
    for (i > 0) {
        i = i - 1;
        if (sel sig.pops.at[i].polymorphic) { brk; }
        counted = counted + 1;
    }
    ret (pop - 1)::u32 < counted;
}

# whether every value `e` names by its depth among its pops is one it pops
fun pops_named(e: *effect.Effect) bool {
    val sig: *effect.Signature = ?e.signature;
    if (!pop_or_none(sig, e.control.condition) || !pop_or_none(sig, e.control.chooses)) { ret false; }
    var i: u32 = 0;
    for (i < e.memory.len) {
        val a: *effect.Access = ?e.memory.at[i];
        if (!pop_or_none(sig, a.pop)) { ret false; }
        val count: effect.Count = a.width.count;
        if (sel count.popped) {
            if (!pop_or_none(sig, count.popped + 1)) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

# whether every entry `e` reads or writes is named by an id operand of `r` with a role
fun entries_named(r: *row.Row, e: *effect.Effect) bool {
    var i: u32 = 0;
    for (i < e.entries.len) {
        val n: *effect.Entry = ?e.entries.at[i];
        if (n.operand::u32 >= r.operands.len || n.role == operand.NONE || n.role > operand.READ_WRITE) { ret false; }
        val desc: *operand.Operand = ?r.operands.at[n.operand];
        if (!sel desc.shape.id) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `e` states anything only a set with a typed stream has: a stack signature, a defined value, a popped value, an
# index space entry or a structure
fun streamed(e: *effect.Effect) bool {
    if (e.signature.pops.len > 0 || e.signature.pushes.len > 0 || e.values.defines != 0 || e.values.type != 0) { ret true; }
    if (e.control.condition != 0 || e.control.chooses != 0 || e.entries.len > 0 || e.structure != effect.FLAT) { ret true; }
    var i: u32 = 0;
    for (i < e.memory.len) {
        if (e.memory.at[i].pop != 0 || sel e.memory.at[i].width.count.popped) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the stack signature, the popped values, the index space entries, the structure and the defined value of `e`
# name what they must of `r`, and are of a set with a typed stream, one resolving its signatures, when they state
# anything
fun stream_facts(s: *S.Set, r: *row.Row, e: *effect.Effect) opt[str] {
    if (!streamed(e))                                                                            { ret opt[str].none{}; }
    if (s.codec.stream == nil)                                                                   { ret opt[str].some{UNSTREAMED}; }
    if (!typed(r, e.signature.pops) || !typed(r, e.signature.pushes))                            { ret opt[str].some{SIGNATURE}; }
    if ((e.signature.pops.len > 0 || e.signature.pushes.len > 0) && s.codec.stream.arity == nil) { ret opt[str].some{UNRESOLVED}; }
    if (!pops_named(e))                                                                          { ret opt[str].some{POPPED}; }
    if (!entries_named(r, e))                                                                    { ret opt[str].some{ENTRY}; }
    val split: bool = e.structure == effect.SPLITS;
    if (e.structure > effect.CLOSES || (e.control.target == effect.STRUCTURED && !effect.opens(e.structure) && !split)) { ret opt[str].some{STRUCTURE}; }
    if (!id_or_none(r, e.values.defines) || !id_or_none(r, e.values.type))                                              { ret opt[str].some{VALUES}; }
    ret opt[str].none{};
}

pub fun effects(s: *S.Set, r: *row.Row) opt[str] {
    if (r.effect == nil || r.ct == nil) { ret opt[str].some{NO_EFFECT}; }
    val e:         *effect.Effect = r.effect;
    val flag_sets: [4]effect.Set  = [4]effect.Set{e.flags.read, e.flags.written, e.flags.undefined, e.flags.kept};
    val switched:  opt[str]       = register_rules(s, r, ?e.implicit);
    if (sel switched.some) { ret switched; }
    val partial: opt[str] = merged(s, r);
    if (sel partial.some) { ret partial; }
    var i: u32 = 0;
    for (i < 4) {
        val held: opt[str] = check_register.holds(s, flag_sets[i], true);
        if (sel held.some) { ret held; }
        i = i + 1;
    }
    i = 0;
    for (i < e.memory.len) {
        val checked: opt[str] = access(s, r, ?e.memory.at[i]);
        if (sel checked.some) { ret checked; }
        i = i + 1;
    }
    if (!operand_or_none(r, e.control.operand)) { ret opt[str].some{EFFECT_OPERAND}; }
    val kind: opt[str] = transfer(s, e.control.transfer, e.control.target);
    if (sel kind.some)                                                             { ret kind; }
    if (e.control.target == effect.DEPTH && e.control.operand == field.NO_OPERAND) { ret opt[str].some{DEPTH_OPERAND}; }
    val ruled: opt[str] = rules(s, r, ?e.control);
    if (sel ruled.some) { ret ruled; }
    val typed: opt[str] = stream_facts(s, r, e);
    if (sel typed.some) { ret typed; }
    val stack: *effect.Stack = ?e.stack;
    if (sel stack.delta && !operand_or_none(r, stack.delta.operand)) { ret opt[str].some{EFFECT_OPERAND}; }
    i = 0;
    for (i < e.fixed.len) {
        val fx: effect.Fixed = e.fixed.at[i];
        if (fx.operand::u32 >= r.operands.len) { ret opt[str].some{FIXED_OPERAND}; }
        val sh: *operand.Shape = ?r.operands.at[fx.operand].shape;
        if (!sel sh.register)                                { ret opt[str].some{FIXED_OPERAND}; }
        if (fx.register >= check_register.register_count(s)) { ret opt[str].some{check.EFFECT_ROW}; }
        val reg: *register.Register = ?s.codec.registers.registers[fx.register];
        val r:   *operand.Register  = ?sh.register;
        if (operand.find(r.classes, reg.class) < 0 || !operand.within(r, reg.number::u32, register.count_most(s.codec.registers, reg.class)::u32)) {
            ret opt[str].some{FIXED_CLASS};
        }
        i = i + 1;
    }
    val written: opt[str] = writes(s, e);
    if (sel written.some) { ret written; }
    val related: opt[str] = relations(s, r, e);
    if (sel related.some) { ret related; }
    val c: *ct.Class = r.ct;
    if (sel c.dependent) {
        if (ct.empty(?c.dependent)) { ret opt[str].some{NO_INPUT}; }
        val held: opt[str] = implicit_inputs(s, ?c.dependent);
        if (sel held.some) { ret held; }
    }
    if (sel c.conditional) {
        val g: *ct.Gate = ?c.conditional;
        if (g.condition.len == 0 || !check_extension.required_known(s, g.condition)) { ret opt[str].some{CONDITION}; }
        if (!ct.within(?g.remaining, ?g.inputs))                                     { ret opt[str].some{REMAINING}; }
        val unmet: opt[str] = implicit_inputs(s, ?g.inputs);
        if (sel unmet.some) { ret unmet; }
        val left: opt[str] = implicit_inputs(s, ?g.remaining);
        if (sel left.some) { ret left; }
    }
    if (!ct.classified(s.ct) && !sel c.dependent) { ret opt[str].some{UNTIMED}; }
    ret opt[str].none{};
}

# whether the registers no operand names that `in` holds are rows of the file
fun implicit_inputs(s: *S.Set, in: *ct.Inputs) opt[str] {
    val regs: *ct.Registers = ?in.implicit;
    if (sel regs.every) { ret opt[str].none{}; }
    ret check_register.holds(s, regs.only, false);
}
