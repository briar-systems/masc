# the refusal every check of a registered instruction set returns, and what the checks share
#
# every table a set registers is checked once, against the invariants the
# walks, the selection and the builder assume, so no reader checks them
# again. a defect is one refusal naming the set, the table and the row. each
# axis's check is its own module beside this one, and `masc.check.set` runs
# them all.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;

use mink;

use masc.core.index;
use S: masc.core.set;

# what the checks of a set's format facts read: the format registry, and the allocator of what they ask of it, given
# back before each returns
pub rec Formats {
    registry: *mink.registry.Registry;
    alloc:    *A.Allocator;
}

# why a set was refused
# ---
# set:     the set refused
# message: the diagnostic, one of the wordings below
# table:   the table the defect is in
# index:   the defective row of that table
# other:   the row it clashes with when the defect is two rows sharing a name or key, else NO_OTHER
pub rec Refusal {
    set:     *S.Set;
    message: str;
    table:   str;
    index:   u32;
    other:   u32;
}

pub val NO_OTHER: u32 = 0xFFFF_FFFF;

pub val UNNAMED:           str = "class name or row key empty";
pub val NAME_ENTRY:        str = "name index entry names no row, or a key other than its row's";
pub val NAME_ORDER:        str = "name index not in ascending order of key";
pub val NAME_MISSING:      str = "name index does not hold each row once";
pub val SHARED_NAME:       str = "name spelled twice";
pub val CASED_NAME:        str = "name has an ascii capital while a syntax of the set reads names without regard to case";
pub val UNKNOWN_EXTENSION: str = "requires an atom neither in the catalog nor a value of the set's axes, or excludes one it needs";
pub val EFFECT_ROW:        str = "effect names a register row not in the register file";
pub val UNBOUND_FIXUP:     str = "fixup kind with no mink relocation kind";

pub fun refuse(s: *S.Set, message: str, table: str, index: u32) err[Refusal] {
    ret err[Refusal].err{Refusal{set: s, message: message, table: table, index: index, other: NO_OTHER}};
}

pub fun refuse_pair(s: *S.Set, message: str, table: str, index: u32, other: u32) err[Refusal] {
    ret err[Refusal].err{Refusal{set: s, message: message, table: table, index: index, other: other}};
}

# the name of row `row` of a table, a class name, a row key, a register's identity or the like, made in `scratch` when it is not stored.
# `of` says which table of its kind, such as the column of a file, and the name is empty when the row has none
def Namer: fun(*S.Set, u32, u32, *u8) View;

pub fun spelled(text: str) View {
    ret view(text, str_len(text));
}

# the name index `by` of a table whose rows are named by `name` (table `of`): each entry holds its row's own name, the entries ascend
# by name, none repeats, and there are `expected` of them, so every named row has exactly one. a name given to two rows is two adjacent equal
# entries, so uniqueness is read off the index and never scanned for
pub fun indexed(s: *S.Set, by: *index.Index, rows: u32, expected: u32, name: Namer, of: u32, table: str, twice: str) err[Refusal] {
    var scratch: [8]u8;
    var i:       u32 = 0;
    for (i < by.len) {
        val e: *index.Entry = ?by.at[i];
        if (e.row >= rows) { ret refuse(s, NAME_ENTRY, table, e.row); }
        val own: View = name(s, of, e.row, ?scratch[0]);
        if (own.len == 0 || e.key == nil || e.key[0] == 0) { ret refuse(s, UNNAMED, table, e.row); }
        if (index.compare(e.key, own, false) != 0)         { ret refuse(s, NAME_ENTRY, table, e.row); }
        if (i > 0) {
            val order: i64 = str_compare(by.at[i - 1].key, e.key);
            if (order == 0) { ret refuse_pair(s, twice, table, by.at[i - 1].row, e.row); }
            if (order > 0)  { ret refuse(s, NAME_ORDER, table, e.row); }
        }
        i = i + 1;
    }
    if (by.len != expected) { ret refuse(s, NAME_MISSING, table, expected); }
    ret fine();
}

pub fun fine() err[Refusal] {
    ret err[Refusal].ok{};
}

# whether a syntax of the set reads names without regard to ascii case
pub fun folds(s: *S.Set) bool {
    var i: u32 = 0;
    for (i < s.syntaxes.len) {
        if (s.syntaxes.at[i].fold) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a byte of `name` is an ascii capital
pub fun capitalized(name: View) bool {
    var i: usize = 0;
    for (i < name.len) {
        if (index.lower(name.data[i]) != name.data[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `text` is nil or empty
pub fun empty(text: str) bool {
    ret text == nil || text[0] == 0;
}
