#[testing]
val T_REMOVES: [1]requirement.Id = [1]requirement.Id{0};

#[testing]
val T_NARROWINGS: [1]core_source.Narrowing = [1]core_source.Narrowing{core_source.Narrowing{narrow: "norvc", lift: "rvc", removes: requirement.Ids{at: ?T_REMOVES[0], len: 1}, lifted: 0}};

#[testing]
val T_OFF: mode.Value = mode.Value{name: "nopic", flag: nil, doc: "off"};

#[testing]
val T_ON: mode.Value = mode.Value{name: "pic", flag: nil, doc: "on"};

#[testing]
val T_OTHER: mode.Value = mode.Value{name: "rvc", flag: nil, doc: "other"};

#[testing]
val T_PIC_VALUES: [2]*mode.Value = [2]*mode.Value{?T_OFF, ?T_ON};

#[testing]
val T_LIKE_VALUES: [2]*mode.Value = [2]*mode.Value{?T_ON, ?T_OTHER};

#[testing]
val T_PIC: mode.Mode = mode.Mode{name: "pic", values: mode.Values{at: ?T_PIC_VALUES[0], len: 2}, initial: ?T_OFF};

#[testing]
val T_LIKE: mode.Mode = mode.Mode{name: "like", values: mode.Values{at: ?T_LIKE_VALUES[0], len: 2}, initial: ?T_ON};

test one__a_mode_value_spelled_as_another_operand_of_the_form_directive_is_refused {
    var s: S.Set = T_SET;
    s.source.forms = core_source.Forms{directive: ".option", push: "push", pop: "pop", narrowings: core_source.Narrowings{at: ?T_NARROWINGS[0], len: 1}, restates: "arch"};
    val one_mode: [1]*mode.Mode = [1]*mode.Mode{?T_PIC};
    s.assembly = mode.Modes{at: ?one_mode[0], len: 1};
    val fine_forms: err[check.Refusal] = check_source.forms(?s);
    if (sel fine_forms.err) { ret 1; }
    # a value spelled as a narrowing's lift
    var like:     mode.Value     = mode.Value{name: "rvc", flag: nil, doc: "x"};
    val clash:    [2]*mode.Value = [2]*mode.Value{?T_OFF, ?like};
    var m:        mode.Mode      = mode.Mode{name: "pic", values: mode.Values{at: ?clash[0], len: 2}, initial: ?T_OFF};
    val clashing: [1]*mode.Mode  = [1]*mode.Mode{?m};
    s.assembly = mode.Modes{at: ?clashing[0], len: 1};
    if (!t_refused(check_source.forms(?s), check_source.VALUE_OPERAND, "assembler mode", 0)) { ret 2; }
    # a value spelled as the push
    like.name = "push";
    if (!t_refused(check_source.forms(?s), check_source.VALUE_OPERAND, "assembler mode", 0)) { ret 3; }
    # a value spelled as a value of another mode
    val two: [2]*mode.Mode = [2]*mode.Mode{?T_PIC, ?T_LIKE};
    s.assembly = mode.Modes{at: ?two[0], len: 2};
    if (!t_refused(check_source.forms(?s), check_source.VALUE_OPERAND, "assembler mode", 1)) { ret 4; }
    ret 0;
}

