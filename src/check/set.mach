val T_RAW_OPERANDS: [1]operand.Operand = [1]operand.Operand{
    operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 16, sign: operand.UNSIGNED, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 0, quantity: operand.ONE},
};

