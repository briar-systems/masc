};

#[testing]
val T_EXTENSION_IDS: [2]requirement.Id = [2]requirement.Id{0, 1};

#[testing]
val T_EXTENSION_NAMES: [1]extension.NameEntry = [1]extension.NameEntry{extension.NameEntry{key: "i", rows: requirement.Ids{at: ?T_EXTENSION_IDS[0], len: 1}, canonical: true}};

#[testing]
val T_CATALOG: extension.Catalog = extension.Catalog{extensions: ?T_EXTENSIONS[0], count: 1, levels: nil, level_count: 0, names: extension.Names{at: ?T_EXTENSION_NAMES[0], len: 1}, conflicts: nil, conflict_count: 0, combinations: nil, combination_count: 0, syntax: ?extension.LIST};

#[testing]
val T_BINDINGS: [1]core_fixup.Binding = [1]core_fixup.Binding{core_fixup.Binding{fixup: 1, kind: ?mink.reloc.JAL20}};

#[testing]
val T_ENTERS_ID: [1]requirement.Id = [1]requirement.Id{0};

#[testing]
val T_ENTERS: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?T_ENTERS_ID[0], len: 1}, none: requirement.NO_IDS}};

#[testing]
val T_ARCHES: [1]S.Arch = [1]S.Arch{S.Arch{arch: ?mink.arch.RISCV64, enters: requirement.Requirement{at: ?T_ENTERS[0], len: 1}, initial: state.Settings{at: [state.MAX_AXES]u8{0, 0, 0, 0, 0, 0, 0, 0}}}};

