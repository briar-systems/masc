test one__an_unstated_anchor_is_refused_where_a_distance_is_measured {
    var operands: [2]operand.Operand = T_OPERANDS;
    operands[1].shape = operand.Shape.relative{operand.Relative{offset: operand.Immediate{bits: 21, sign: operand.SIGNED, scale: 1, bias: 0, fixup: 1, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, anchor: operand.UNSTATED}};
    var r: row.Row = T_ROWS[0];
    r.operands = row.Operands{at: ?operands[0], len: 2};
    var rows:  row.Row;
    var codec: core_dispatch.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), check_row.NO_ANCHOR, "row", 0)) { ret 1; }
    # a memory operand states its anchor only when it admits a pc-relative form
    val none: operand.Register = operand.Register{classes: operand.Classes{at: nil, len: 0}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}};
    var m:    operand.Memory   = operand.Memory{base: none, index: none, segment: none, scales: 0, disp: operand.Immediate{bits: 20, sign: operand.SIGNED, scale: 0, bias: 0, fixup: 1, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, forms: operand.PCREL, anchor: operand.UNSTATED};
    operands[1].shape = operand.Shape.memory{m};
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), check_row.NO_ANCHOR, "row", 0)) { ret 2; }
    m.forms           = operand.ABSOLUTE;
    operands[1].shape = operand.Shape.memory{m};
    t_with_row(r, ?rows, ?codec, ?s);
    if (t_refused(one(?s), check_row.NO_ANCHOR, "row", 0)) { ret 3; }
    ret 0;
}

