# the one check of a registered instruction set
#
# `one` checks a set's own record, its architectures and the state they enter,
# its state axes, assembler modes and code fill, then each axis by its module
# beside this one, and `every` checks a registry, no architecture served twice.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.collections.bitset;

use arch_list: mink.catalog.arch.list;

use masc.check.check;
use check_extension: masc.check.extension;
use check_fixup:     masc.check.fixup;
use check_register:  masc.check.register;
use check_row:       masc.check.row;
use check_source:    masc.check.source;
use check_syntax:    masc.check.syntax;
use check_trait:     masc.check.trait;
use masc.core.config;
use masc.core.extension;
use masc.core.field;
use core_fill: masc.core.fill;
use core_form: masc.core.form;
use masc.core.mode;
use masc.core.requirement;
use masc.core.row;
use S: masc.core.set;
use masc.core.state;
use masc.core.stream;

pub val NO_ARCH:         str = "set serves no architecture";
pub val UNKNOWN_ARCH:    str = "architecture not in mink's catalog";
pub val SHARED_ARCH:     str = "architecture served twice";
pub val ENTERS:          str = "architecture enters a requirement naming an unknown atom, or one no selection it starts can meet";
pub val ARCH_STATE:      str = "architecture starts an axis at a value it does not take, or one past the set's axes";
pub val AXIS:            str = "state axis unnamed or named twice, of fewer than two values, a value unnamed or named twice, or starting at a value it does not take";
pub val AXIS_COUNT:      str = "set declares more state axes than a context holds";
pub val CLOSED_SIZE:     str = "catalog has more extensions than the check of what an architecture enters closes";
pub val PATTERN:         str = "fill pattern empty or not shorter than the one before it";
pub val FILL_UNIT:       str = "fill unit not a power of two, or not dividing a fill pattern";
pub val MODE_COUNT:      str = "set declares more assembler modes than a state holds";
pub val MODE_NAME:       str = "assembler mode or value unnamed, or a mode's name or a value's name within it given twice";
pub val MODE_VALUES:     str = "assembler mode of fewer than two values, or one starting at a value it does not take";
pub val MODE_FLAG:       str = "flag chooses two values of the set's assembler modes";
pub val FORM:            str = "form choice unnamed, of no bits, setting bits outside its field or its field's zero, or sharing bits of the core's exact one";
pub val FORM_FIELDS:     str = "form choices of two fields share bits, or one is named, valued or marked twice";
pub val STREAM:          str = "typed stream hooks missing a hook, or naming a value type empty, by a reserved spelling or two types by one code";
pub val STREAM_SEQUENCE: str = "syntax of a set with a typed stream states a sequence of instructions";
pub val CONFIG:          str = "configuration hooks missing a hook or a name";
pub val CONVENTION:      str = "convention of an abi row of no architecture the set serves, or of one stated twice, admitting a requirement naming an unknown atom, or not admitting what its architecture enters";

# the most extensions the check of an architecture's entry closes over, in 64-bit words, so the check needs no allocator
val CLOSED_WORDS: u32 = 64;

# whether the axes are named once each, each of at least two values named once each, starting at one it takes
fun axes(s: *S.Set) err[check.Refusal] {
    val all: *state.Axes = ?s.states;
    if (all.len > state.MAX_AXES) { ret check.refuse(s, AXIS_COUNT, "axis", state.MAX_AXES); }
    var i: u32 = 0;
    for (i < all.len) {
        val x: *state.Axis = ?all.at[i];
        if (x.name == nil || x.name[0] == 0 || x.values.len < 2 || x.initial::u32 >= x.values.len) { ret check.refuse(s, AXIS, "axis", i); }
        var j: u32 = 0;
        for (j < i) {
            if (str_equals(all.at[j].name, x.name)) { ret check.refuse_pair(s, AXIS, "axis", i, j); }
            j = j + 1;
        }
        j = 0;
        for (j < x.values.len) {
            val v: *state.Value = ?x.values.at[j];
            if (v.name == nil || v.name[0] == 0) { ret check.refuse(s, AXIS, "axis", i); }
            var k: u32 = 0;
            for (k < j) {
                if (str_equals(x.values.at[k].name, v.name)) { ret check.refuse(s, AXIS, "axis", i); }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret check.fine();
}

# whether some selection meets `alt` on entering an architecture that starts its axes at `start`: the closure of its
# extensions under its state atoms, at `start` for each axis it states no value of, holds no atom of its `none` and no
# conflicting pair, and it states at most one value of each axis
fun enterable(s: *S.Set, alt: requirement.Alternative, start: state.Settings, words: *u64, entered: *extension.Selection, at: *state.Settings) bool {
    val catalog: *extension.Catalog = s.extensions;
    var stated:  extension.Stated;
    stated.len = 0;
    var i: u32 = 0;
    for (i < CLOSED_WORDS) {
        words[i] = 0;
        i        = i + 1;
    }
    var members: bitset.Bitset  = bitset.Bitset{alloc: nil, words: words, nbits: catalog.count::usize, nwords: ((catalog.count + 63) / 64)::usize};
    var values:  state.Settings = start;
    var seen:    u32            = 0;
    i = 0;
    for (i < alt.all.len) {
        val id: requirement.Id = alt.all.at[i];
        if (id < catalog.count) { bitset.set(?members, id::usize); }
        or {
            val at: opt[state.Placed] = state.place(catalog, ?s.states, id);
            if (sel at.none) { ret false; }
            val bit: u32 = 1::u32 << at.some.axis;
            if ((seen & bit) != 0 && values.at[at.some.axis] != at.some.value) { ret false; }
            seen                    = seen | bit;
            values.at[at.some.axis] = at.some.value;
            if (stated.len < extension.MAX_STATED) {
                stated.at[stated.len] = id;
                stated.len            = stated.len + 1;
            }
        }
        i = i + 1;
    }
    extension.grow(catalog, ?members, ?stated);
    @entered = extension.Selection{catalog: catalog, members: members, stated: stated};
    @at      = values;
    var ctx: state.Context = state.Context{selection: entered, axes: ?s.states, values: values, view: nil, stream: nil};
    i = 0;
    for (i < alt.none.len) {
        if (state.holds(?ctx, alt.none.at[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < catalog.conflict_count) {
        val pair: extension.Conflict = catalog.conflicts[i];
        if (state.holds(?ctx, pair.a) && state.holds(?ctx, pair.b)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the set serves an architecture, each one mink knows and once, starting its axes at values they take, and
# entering a requirement over known atoms that some selection meets
fun arches(s: *S.Set) err[check.Refusal] {
    if (s.arches.len == 0)                      { ret check.refuse(s, NO_ARCH, "architecture", 0); }
    if (s.extensions.count > CLOSED_WORDS * 64) { ret check.refuse(s, CLOSED_SIZE, "catalog", 0); }
    var words: [CLOSED_WORDS]u64;
    var i:     u32 = 0;
    for (i < s.arches.len) {
        val a: *S.Arch = ?s.arches.at[i];
        if (!arch_list.member(a.arch)) { ret check.refuse(s, UNKNOWN_ARCH, "architecture", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.arches.at[j].arch == a.arch) { ret check.refuse(s, SHARED_ARCH, "architecture", i); }
            j = j + 1;
        }
        j = 0;
        for (j < state.MAX_AXES) {
            val v: u8 = a.initial.at[j];
            if ((j < s.states.len && v::u32 >= s.states.at[j].values.len) || (j >= s.states.len && v != 0)) { ret check.refuse(s, ARCH_STATE, "architecture", i); }
            j = j + 1;
        }
        if (!check_extension.required_known(s, a.enters)) { ret check.refuse(s, ENTERS, "architecture", i); }
        var entered: extension.Selection;
        var values:  state.Settings;
        if (!entry(s, a, ?words[0], ?entered, ?values)) { ret check.refuse(s, ENTERS, "architecture", i); }
        i = i + 1;
    }
    ret check.fine();
}

# whether each convention is of an abi row of an architecture the set serves, stated once, over known atoms, and admits
# the selection its architecture enters, so no object of the architecture is refused by its abi row alone
fun conventions(s: *S.Set) err[check.Refusal] {
    var words: [CLOSED_WORDS]u64;
    var i:     u32 = 0;
    for (i < s.conventions.len) {
        val c:   *S.Convention = ?s.conventions.at[i];
        val row: opt[*S.Arch]  = S.arch_of(s, c.abi.arch);
        if (sel row.none) { ret check.refuse(s, CONVENTION, "convention", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.conventions.at[j].abi == c.abi) { ret check.refuse(s, CONVENTION, "convention", i); }
            j = j + 1;
        }
        if (!check_extension.required_known(s, c.admits)) { ret check.refuse(s, CONVENTION, "convention", i); }
        var entered: extension.Selection;
        var values:  state.Settings;
        if (!entry(s, row.some, ?words[0], ?entered, ?values)) { ret check.refuse(s, CONVENTION, "convention", i); }
        var ctx: state.Context = state.Context{selection: ?entered, axes: ?s.states, values: values, view: nil, stream: nil};
        if (!state.admits(?ctx, c.admits)) { ret check.refuse(s, CONVENTION, "convention", i); }
        i = i + 1;
    }
    ret check.fine();
}

# the selection architecture row `a` enters into `entered` and the values it starts its axes at into `values`: the
# closure of the first alternative of its entry some selection meets, the empty one when it states none, over `words`.
# false when no selection meets it
fun entry(s: *S.Set, a: *S.Arch, words: *u64, entered: *extension.Selection, values: *state.Settings) bool {
    val none: requirement.Alternative = requirement.Alternative{all: requirement.NO_IDS, none: requirement.NO_IDS};
    if (a.enters.len == 0) { ret enterable(s, none, a.initial, words, entered, values); }
    var j: u32 = 0;
    for (j < a.enters.len) {
        if (enterable(s, a.enters.at[j], a.initial, words, entered, values)) { ret true; }
        j = j + 1;
    }
    ret false;
}

# whether the dwarf column of each architecture's entry numbers the set's stack pointer and return address register as
# mink states them, once the file is whole
fun unwound(s: *S.Set) err[check.Refusal] {
    var words: [CLOSED_WORDS]u64;
    var i:     u32 = 0;
    for (i < s.arches.len) {
        val a:       *S.Arch = ?s.arches.at[i];
        var entered: extension.Selection;
        var values:  state.Settings;
        if (!entry(s, a, ?words[0], ?entered, ?values)) { ret check.refuse(s, ENTERS, "architecture", i); }
        var ctx:  state.Context      = state.Context{selection: ?entered, axes: ?s.states, values: values, view: nil, stream: nil};
        val done: err[check.Refusal] = check_register.unwinds(s, a, i, ?ctx);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    ret check.fine();
}

# whether the set's assembler modes are named once each, with their values, and each flag chooses one value
fun assembly(s: *S.Set) err[check.Refusal] {
    val all: *mode.Modes = ?s.assembly;
    if (all.len > mode.MAX_MODES) { ret check.refuse(s, MODE_COUNT, "assembler mode", mode.MAX_MODES); }
    var i: u32 = 0;
    for (i < all.len) {
        val m: *mode.Mode = all.at[i];
        if (m.name == nil || m.name[0] == 0)               { ret check.refuse(s, MODE_NAME, "assembler mode", i); }
        if (m.values.len < 2 || !mode.takes(m, m.initial)) { ret check.refuse(s, MODE_VALUES, "assembler mode", i); }
        var j: u32 = 0;
        for (j < i) {
            if (all.at[j] == m || str_equals(all.at[j].name, m.name)) { ret check.refuse_pair(s, MODE_NAME, "assembler mode", i, j); }
            j = j + 1;
        }
        j = 0;
        for (j < m.values.len) {
            val v: *mode.Value = m.values.at[j];
            if (v.name == nil || v.name[0] == 0) { ret check.refuse(s, MODE_NAME, "assembler mode", i); }
            var k: u32 = 0;
            for (k < j) {
                if (m.values.at[k] == v || str_equals(m.values.at[k].name, v.name)) { ret check.refuse(s, MODE_NAME, "assembler mode", i); }
                k = k + 1;
            }
            if (v.flag != nil) {
                val chosen: opt[mode.Setting] = mode.flagged(all, v.flag);
                if (sel chosen.none)        { ret check.refuse(s, MODE_FLAG, "assembler mode", i); }
                if (chosen.some.value != v) { ret check.refuse(s, MODE_FLAG, "assembler mode", i); }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret check.fine();
}

fun fill(s: *S.Set) err[check.Refusal] {
    if (s.fill == nil)                            { ret check.fine(); }
    if (s.fill.count == 0)                        { ret check.refuse(s, PATTERN, "pattern", 0); }
    if (s.fill.order > core_fill.REMAINDER_FIRST) { ret check.refuse(s, PATTERN, "order", 0); }
    val unit: u32 = s.fill.unit;
    if (unit == 0 || (unit & (unit - 1)) != 0) { ret check.refuse(s, FILL_UNIT, "unit", 0); }
    var i: u32 = 0;
    for (i < s.fill.count) {
        val p: *core_fill.Pattern = ?s.fill.patterns[i];
        if (p.len == 0 || p.bytes == nil || (i > 0 && p.len >= s.fill.patterns[i - 1].len)) { ret check.refuse(s, PATTERN, "pattern", i); }
        if (!check_extension.required_known(s, p.requires))                                 { ret check.refuse(s, check.UNKNOWN_EXTENSION, "pattern", i); }
        if (p.len % unit != 0)                                                              { ret check.refuse(s, FILL_UNIT, "pattern", i); }
        i = i + 1;
    }
    ret check.fine();
}

# whether the form choices `a` and `b` are two choices of overlapping fields, one choice twice, or share a name or a marker
fun clashes(a: *core_form.FormField, b: *core_form.FormField) bool {
    if (a.mask != b.mask && (a.mask & b.mask) != 0) { ret true; }
    if (a.mask == b.mask && a.value == b.value)     { ret true; }
    if (str_equals(a.name, b.name))                 { ret true; }
    ret a.marker != nil && b.marker != nil && a.suffix == b.suffix && str_equals(a.marker, b.marker);
}

# every form choice of the codec named and within its field, a field clear of the core's exact bit unless it is that bit,
# no two fields sharing bits and no choice named, valued or marked twice
fun forms(s: *S.Set) err[check.Refusal] {
    val all: *core_form.FormFields = ?s.codec.forms;
    var i:   u32                   = 0;
    for (i < all.len) {
        val f:     *core_form.FormField = ?all.at[i];
        val exact: bool                 = f.mask == core_form.EXACT;
        if (f.name == nil || f.name[0] == 0 || f.mask == 0 || f.value == 0 || (f.value & ~f.mask) != 0) { ret check.refuse(s, FORM, "form", i); }
        if (!exact && (f.mask & core_form.EXACT) != 0)                                                  { ret check.refuse(s, FORM, "form", i); }
        if (f.marker != nil && f.marker[0] == 0)                                                        { ret check.refuse(s, FORM, "form", i); }
        var j: u32 = 0;
        for (j < i) {
            if (clashes(?all.at[j], f)) { ret check.refuse(s, FORM_FIELDS, "form", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret check.fine();
}

# the set's typed stream hooks, when it has a typed stream, and its configuration hooks, when it has configuration state:
# every hook present but a stream's optional record, every name stated and none a spelling the stack types reserve, and
# no two value types of one code
fun hooks(s: *S.Set) err[check.Refusal] {
    val h: *stream.Hooks = s.codec.stream;
    if (h != nil) {
        if (h.make == nil || h.release == nil || h.begin == nil || h.observe == nil || h.width == nil || h.space == nil) { ret check.refuse(s, STREAM, "stream", 0); }
        # the builder observes an instruction once it is admitted, so a sequence's instructions would reach the stream
        # one by one, and one refused after the first would leave the others observed
        var y: u32 = 0;
        for (y < s.syntaxes.len) {
            if (s.syntaxes.at[y].sequences.len > 0) { ret check.refuse(s, STREAM_SEQUENCE, "syntax", y); }
            y = y + 1;
        }
        var i: u32 = 0;
        for (i < h.types.len) {
            if (check.empty(h.types.at[i].name) || stream.reserved(h.types.at[i].name)) { ret check.refuse(s, STREAM, "stream type", i); }
            var j: u32 = 0;
            for (j < i) {
                if (h.types.at[j].code == h.types.at[i].code) { ret check.refuse_pair(s, STREAM, "stream type", i, j); }
                j = j + 1;
            }
            i = i + 1;
        }
    }
    val c: *config.Hooks = s.config;
    if (c != nil && (check.empty(c.name) || c.parse == nil || c.print == nil || c.grouping == nil || c.establish == nil)) { ret check.refuse(s, CONFIG, "config", 0); }
    ret check.fine();
}

# the set `s` checked against every invariant its tables carry
# ---
# f:   the format registry the relocation and trait checks read
# ret: ok, or the first defect found
pub fun one(s: *S.Set, f: *check.Formats) err[check.Refusal] {
    val before: [7]fun(*S.Set) err[check.Refusal] = [7]fun(*S.Set) err[check.Refusal]{axes, arches, check_register.registers, unwound, check_extension.extensions, conventions, assembly};
    val after:  [8]fun(*S.Set) err[check.Refusal] = [8]fun(*S.Set) err[check.Refusal]{forms, hooks, check_row.rows, check_row.dispatch, check_row.relaxations, fill, check_syntax.syntaxes, check_source.source};
    var i:      u32                               = 0;
    for (i < 7) {
        val done: err[check.Refusal] = before[i](s);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    val bound: err[check.Refusal] = check_fixup.bindings(s, f);
    if (sel bound.err) { ret bound; }
    i = 0;
    for (i < 8) {
        val done: err[check.Refusal] = after[i](s);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    val stated: err[check.Refusal] = check_trait.statings(s);
    if (sel stated.err) { ret stated; }
    ret check_trait.traits(s, f);
}

# every set of `registry` checked, and no architecture served by two of them
pub fun every(registry: *S.Registry, f: *check.Formats) err[check.Refusal] {
    var i: u32 = 0;
    for (i < registry.count) {
        val s:    *S.Set             = registry.sets[i];
        val done: err[check.Refusal] = one(s, f);
        if (sel done.err) { ret done; }
        var earlier: S.Registry = S.Registry{sets: registry.sets, count: i};
        var k:       u32        = 0;
        for (k < s.arches.len) {
            val other: opt[*S.Set] = S.find(?earlier, s.arches.at[k].arch);
            if (sel other.some) { ret check.refuse(s, SHARED_ARCH, "architecture", k); }
            k = k + 1;
        }
        i = i + 1;
    }
    ret check.fine();
}
