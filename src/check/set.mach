    val checked: err[check.Refusal] = one(?s);
    if (!t_refused(checked, check_register.SHARED_CLASS, "class", 0)) { ret 1; }
    if (!(sel checked.err && checked.err.other == 1))                 { ret 2; }
    ret 0;
}

test one__an_identity_given_to_two_registers_or_out_of_order_is_refused {
    var regs:  [2]register.Register = [2]register.Register{T_REGISTERS[0], T_REGISTERS[0]};
    var file:  register.File        = T_FILE;
    var codec: core_dispatch.Codec  = T_CODEC;
    var s:     S.Set                = T_SET;
    val names: [2]index.Entry       = [2]index.Entry{index.Entry{key: "x0", row: 0}, index.Entry{key: "x1", row: 1}};
    regs[1].name        = "x1";
    file.registers      = ?regs[0];
    file.register_count = 2;
    file.column_count   = 0;
    file.names          = index.Index{at: ?names[0], len: 2};
    codec.registers     = ?file;
    s.codec             = ?codec;
    val identity: err[check.Refusal] = one(?s);
    if (!t_refused(identity, check_register.SHARED_ID, "register", 0)) { ret 1; }
    if (!(sel identity.err && identity.err.other == 1))                { ret 2; }
    regs[0].number = 1;
    if (!t_refused(one(?s), check_register.REGISTER_ORDER, "register", 1)) { ret 3; }
    ret 0;
}

# whether `checked` is no refusal of `message`
#[testing]
fun t_spared(checked: err[check.Refusal], message: str) bool {
    ret !(sel checked.err && checked.err.message == message);
}

test one__a_write_extension_unstated_extending_into_nothing_reaching_its_own_storage_or_stated_by_what_writes_no_register_is_refused {
    var regs:  [2]register.Register = [2]register.Register{T_REGISTERS[0], T_REGISTERS[0]};
    val names: [2]index.Entry       = [2]index.Entry{index.Entry{key: "x0", row: 0}, index.Entry{key: "x1", row: 1}};
    var file:  register.File        = T_FILE;
    var codec: core_dispatch.Codec  = T_CODEC;
    var s:     S.Set                = T_SET;
    regs[0].extend      = register.ZEROES;
    regs[1].name        = "x1";
    regs[1].number      = 1;
    regs[1].bank        = 1;
    file.registers      = ?regs[0];
    file.register_count = 2;
    file.column_count   = 0;
    file.names          = index.Index{at: ?names[0], len: 2};
    codec.registers     = ?file;
    s.codec             = ?codec;
    if (!t_refused(one(?s), check_register.LONE_EXTEND, "register", 0)) { ret 1; }
    # x1 now lies in x0's bank past it, so a write of x0 has a rest to clear
    regs[1].bank   = 0;
    regs[1].offset = quantity.Scaled{fixed: 64, per: 0, scale: 0};
    if (!t_spared(one(?s), check_register.LONE_EXTEND)) { ret 2; }
    # a reach of x1's storage alone still has a rest to clear, one past every row has none, and one holding nothing or
    # reaching x0's own storage is refused
    val apart:     quantity.Scaled = quantity.Scaled{fixed: 0, per: 0, scale: 0};
    val one_piece: quantity.Scaled = quantity.Scaled{fixed: 1, per: 0, scale: 0};
    val bits:      quantity.Scaled = quantity.Scaled{fixed: 64, per: 0, scale: 0};
    regs[0].reach = register.Reach.part{register.Part{offset: bits, stride: apart, count: one_piece, width: bits}};
    if (!t_spared(one(?s), check_register.LONE_EXTEND) || !t_spared(one(?s), check_register.REACH)) { ret 8; }
    regs[0].reach = register.Reach.part{register.Part{offset: quantity.Scaled{fixed: 128, per: 0, scale: 0}, stride: apart, count: one_piece, width: bits}};
    if (!t_refused(one(?s), check_register.LONE_EXTEND, "register", 0)) { ret 9; }
    regs[0].reach = register.Reach.part{register.Part{offset: quantity.Scaled{fixed: 32, per: 0, scale: 0}, stride: apart, count: one_piece, width: bits}};
    if (!t_refused(one(?s), check_register.REACH, "register", 0)) { ret 10; }
    regs[0].reach = register.Reach.part{register.Part{offset: bits, stride: apart, count: one_piece, width: apart}};
    if (!t_refused(one(?s), check_register.REACH, "register", 0)) { ret 11; }
    regs[0].reach = register.Reach.bank{};
    # a register with no place, or two places at one offset, is refused
    regs[0].places = register.Places{count: quantity.Scaled{fixed: 2, per: 0, scale: 0}, step: apart};
    if (!t_refused(one(?s), check_register.PLACES, "register", 0)) { ret 12; }
    regs[0].places = register.Places{count: apart, step: bits};
    if (!t_refused(one(?s), check_register.PLACES, "register", 0)) { ret 13; }
    regs[0].places = register.ONE_PLACE;
    # two pieces of 64 bits 32 apart share storage, which no storage rule answers (#241)
    regs[0].count  = quantity.Scaled{fixed: 2, per: 0, scale: 0};
    regs[0].stride = quantity.Scaled{fixed: 32, per: 0, scale: 0};
    if (!t_refused(one(?s), check_register.OVERLAPPING, "register", 0)) { ret 14; }
    regs[0].stride = bits;
    if (!t_spared(one(?s), check_register.OVERLAPPING)) { ret 15; }
    regs[0].count  = one_piece;
    regs[0].stride = apart;
    regs[0].extend = 4;
    if (!t_refused(one(?s), check_register.NO_EXTEND, "register", 0)) { ret 3; }
    regs[0].extend = register.UNSTATED;
    if (!t_refused(one(?s), check_register.NO_EXTEND, "register", 0)) { ret 7; }
    var operands: [2]operand.Operand = T_OPERANDS;
    var r:        row.Row            = T_ROWS[0];
    var rows:     row.Row;
    r.operands = row.Operands{at: ?operands[0], len: 2};
    t_with_row(r, ?rows, ?codec, ?s);
    operands[0].write = operand.Write{extend: opt[register.Extend].some{register.ZEROES}, result: 0, above: register.UNSTATED};
    if (!t_spared(one(?s), check_row.OWN_WRITE)) { ret 4; }
    operands[0].write.extend = opt[register.Extend].some{register.UNSTATED};
    if (!t_refused(one(?s), check_register.WRITE_EXTEND, "row", 0)) { ret 16; }
    operands[0].write = operand.Write{extend: opt[register.Extend].none{}, result: 32, above: register.ONES};
    if (!t_spared(one(?s), check_register.WRITE_RESULT)) { ret 17; }
    # a result wider than its register, or one stating nothing above it, is refused (#267)
    operands[0].write.result = 128;
    if (!t_refused(one(?s), check_register.WRITE_RESULT, "row", 0)) { ret 18; }
    operands[0].write = operand.Write{extend: opt[register.Extend].none{}, result: 32, above: register.UNSTATED};
    if (!t_refused(one(?s), check_register.WRITE_RESULT, "row", 0)) { ret 19; }
    operands[0].write = operand.Write{extend: opt[register.Extend].some{register.ZEROES}, result: 0, above: register.UNSTATED};
    operands[0].role  = operand.READ;
    if (!t_refused(one(?s), check_row.OWN_WRITE, "row", 0)) { ret 5; }
    operands[0]       = T_OPERANDS[0];
    operands[1].write = operand.Write{extend: opt[register.Extend].some{register.KEEP}, result: 0, above: register.UNSTATED};
    if (!t_refused(one(?s), check_row.OWN_WRITE, "row", 0)) { ret 6; }
    ret 0;
}

test one__a_spelling_given_to_two_registers_or_a_name_index_out_of_order_or_short_is_refused {
    var regs:  [2]register.Register = [2]register.Register{T_REGISTERS[0], T_REGISTERS[0]};
    val dup:   [2]index.Entry       = [2]index.Entry{index.Entry{key: "x0", row: 0}, index.Entry{key: "x0", row: 1}};
    val order: [2]index.Entry       = [2]index.Entry{index.Entry{key: "x0", row: 0}, index.Entry{key: "a", row: 1}};
    var file:  register.File        = T_FILE;
    var codec: core_dispatch.Codec  = T_CODEC;
    var s:     S.Set                = T_SET;
    regs[1].number      = 1;
    file.registers      = ?regs[0];
    file.register_count = 2;
    file.column_count   = 0;
    file.names          = index.Index{at: ?dup[0], len: 2};
    codec.registers     = ?file;
    s.codec             = ?codec;
    val spelling: err[check.Refusal] = one(?s);
    if (!t_refused(spelling, check.SHARED_NAME, "register name", 0)) { ret 1; }
    if (!(sel spelling.err && spelling.err.other == 1))              { ret 2; }
    regs[1].name = "a";
    file.names   = index.Index{at: ?order[0], len: 2};
    if (!t_refused(one(?s), check.NAME_ORDER, "register name", 1)) { ret 3; }
    file.names = index.Index{at: ?T_REGISTER_NAMES[0], len: 1};
    if (!t_refused(one(?s), check.NAME_MISSING, "register name", 2)) { ret 4; }
    ret 0;
}

test one__a_number_index_that_disagrees_with_its_column_is_refused {
    val numbers: [2]u32               = [2]u32{5, 5};
    val dup:     [2]index.Number      = [2]index.Number{index.Number{key: 5, row: 0}, index.Number{key: 5, row: 1}};
    val one_row: [1]index.Number      = [1]index.Number{index.Number{key: 5, row: 0}};
    var regs:    [2]register.Register = [2]register.Register{T_REGISTERS[0], T_REGISTERS[0]};
    var names:   [2]index.Entry       = [2]index.Entry{index.Entry{key: "x0", row: 0}, index.Entry{key: "x1", row: 1}};
    var col:     [1]register.Column   = [1]register.Column{register.Column{format: register.DWARF, numbers: ?numbers[0], len: 2, numbered: index.Numbers{at: ?dup[0], len: 2}}};
    var file:    register.File        = T_FILE;
    var codec:   core_dispatch.Codec  = T_CODEC;
    var s:       S.Set                = T_SET;
    regs[1].name        = "x1";
    regs[1].number      = 1;
    file.registers      = ?regs[0];
    file.register_count = 2;
    file.names          = index.Index{at: ?names[0], len: 2};
    file.columns        = ?col[0];
    file.column_count   = 1;
    codec.registers     = ?file;
    s.codec             = ?codec;
    val shared: err[check.Refusal] = one(?s);
    if (!t_refused(shared, check_register.SHARED_NUMBER, "column", 0)) { ret 1; }
    if (!(sel shared.err && shared.err.other == 1))                    { ret 2; }
    col[0].numbered = index.Numbers{at: ?one_row[0], len: 1};
    if (!t_refused(one(?s), check.NAME_MISSING, "column", 0)) { ret 3; }
    ret 0;
}

# a row no syntax spells is left out of the name index, so one the index holds is refused and the index holds every
# other row (#279)
test one__an_unspelled_register_in_the_name_index_is_refused {
    var regs:  [2]register.Register = [2]register.Register{T_REGISTERS[0], T_REGISTERS[0]};
    val both:  [2]index.Entry       = [2]index.Entry{index.Entry{key: "x0", row: 0}, index.Entry{key: "x1", row: 1}};
    var file:  register.File        = T_FILE;
    var codec: core_dispatch.Codec  = T_CODEC;
    var s:     S.Set                = T_SET;
    regs[1].name        = "x1";
    regs[1].number      = 1;
    regs[1].flags       = register.UNSPELLED;
    file.registers      = ?regs[0];
    file.register_count = 2;
    file.column_count   = 0;
    file.names          = index.Index{at: ?both[0], len: 2};
    codec.registers     = ?file;
    s.codec             = ?codec;
    if (!t_refused(one(?s), check_register.UNSPELLED_NAME, "register name", 1)) { ret 1; }
    file.names = index.Index{at: ?T_REGISTER_NAMES[0], len: 1};
    val spared: err[check.Refusal] = check_register.registers(?s);
    if (sel spared.err) { ret 2; }
    ret 0;
}

# the dwarf column of a set serving risc-v numbers its stack pointer 2 and its link register 1, as mink's call frame facts
# state them
test one__a_dwarf_column_that_disagrees_with_minks_unwind_facts_or_is_missing_is_refused {
    var regs:  [3]register.Register = T_REGISTERS;
    var file:  register.File        = T_FILE;
    var codec: core_dispatch.Codec  = T_CODEC;
    var s:     S.Set                = T_SET;
    file.registers  = ?regs[0];
    codec.registers = ?file;
    s.codec         = ?codec;
    val agreed: err[check.Refusal] = unwound(?s);
    if (sel agreed.err) { ret 1; }
    regs[1].flags = 0;
    regs[0].flags = register.LINK;
    if (!t_refused(unwound(?s), check_register.UNWIND_RA, "architecture", 0)) { ret 2; }
    regs[0].flags = 0;
    if (!t_refused(unwound(?s), check_register.UNWIND_RA, "architecture", 0)) { ret 3; }
    regs[1].flags = register.LINK;
    regs[2].flags = 0;
    if (!t_refused(unwound(?s), check_register.UNWIND_SP, "architecture", 0)) { ret 4; }
    file.column_count = 0;
    if (!t_refused(unwound(?s), check_register.UNWIND_COLUMN, "architecture", 0)) { ret 5; }
    ret 0;
}

# form choices are within their fields, the fields apart, and the core's exact bit its own field
test forms__a_choice_outside_its_field_or_sharing_another_fields_bits_is_refused {
    var rows: [3]core_form.FormField = [3]core_form.FormField{
        core_form.FormField{name: "disp8", mask: 0x3, value: 0x1, marker: "{disp8}", suffix: false},
        core_form.FormField{name: "disp32", mask: 0x3, value: 0x2, marker: "{disp32}", suffix: false},
        core_form.FormField{name: "exact", mask: core_form.EXACT, value: core_form.EXACT, marker: nil, suffix: false},
    };
    var codec: core_dispatch.Codec = T_CODEC;
    var s:     S.Set               = T_SET;
    codec.forms = core_form.FormFields{at: ?rows[0], len: 3};
    s.codec     = ?codec;
    val fine: err[check.Refusal] = forms(?s);
    if (sel fine.err) { ret 1; }
    rows[1].value = 0x4;
    if (!t_refused(forms(?s), FORM, "form", 1)) { ret 2; }
    rows[1].value = 0x2;
    rows[1].mask  = 0x6;
    if (!t_refused(forms(?s), FORM_FIELDS, "form", 1)) { ret 3; }
    rows[1].mask  = 0x3;
    rows[2].mask  = core_form.EXACT | 0x8;
    rows[2].value = 0x8;
    if (!t_refused(forms(?s), FORM, "form", 2)) { ret 4; }
    ret 0;
}

test alias_defect__an_exclusion_its_operand_cannot_hold_is_refused {
    val held:    [1]u32                   = [1]u32{5};
    val outside: [1]u32                   = [1]u32{40};
    val values:  [1]i64                   = [1]i64{0};
    val sources: [2]core_syntax.Source    = [2]core_syntax.Source{core_syntax.Source.operand{0}, core_syntax.Source.value{operand.Value.relative{0}}};
    var ex:      [1]core_syntax.Exclusion = [1]core_syntax.Exclusion{core_syntax.Exclusion{operand: 0, excluded: core_syntax.Excluded.register{operand.Numbers{at: ?held[0], len: 1}}}};
    val syntax:  core_syntax.Syntax       = core_syntax.Syntax{
        name:       "t",
        forms:      core_syntax.NO_FORMS,
        aliases:    core_syntax.NO_ALIASES,
        index:      core_syntax.NO_ENTRIES,
        specifiers: core_syntax.NO_SPECIFIERS,
        sequences:  core_syntax.NO_SEQUENCES,
        hooks:      core_syntax.Hooks{immediate: nil, memory: nil, list: nil, id: nil, literal: nil},
        register:   "",
        aliased:    false,
        join:       "",
        variadic:   "",
        fold:       false,
        anonymous:  ".",
    };
    var a:    core_syntax.Alias = core_syntax.Alias{row: 0, template: "j <0>", count: 1, sources: core_syntax.Sources{at: ?sources[0], len: 2}, derive: nil, exclusions: core_syntax.Exclusions{at: ?ex[0], len: 1}, requires: requirement.NO_ALTERNATIVES, preference: 0};
    var s:    S.Set             = T_SET;
    val fine: opt[str]          = check_syntax.alias_defect(?s, ?syntax, ?a, nil);
    if (sel fine.some) { ret 1; }
    ex[0].excluded = core_syntax.Excluded.register{operand.Numbers{at: ?outside[0], len: 1}};
    val past: opt[str] = check_syntax.alias_defect(?s, ?syntax, ?a, nil);
    if (!(sel past.some && past.some == check_syntax.ALIAS_EXCLUSION)) { ret 2; }
    ex[0].excluded = core_syntax.Excluded.immediate{operand.Integers{at: ?values[0], len: 1}};
    val shaped: opt[str] = check_syntax.alias_defect(?s, ?syntax, ?a, nil);
    if (!(sel shaped.some && shaped.some == check_syntax.ALIAS_EXCLUSION)) { ret 3; }
    ret 0;
}

#[testing]
val T_ENUMERANTS: [3]operand.Enumerant = [3]operand.Enumerant{operand.Enumerant{name: "eq", value: 0}, operand.Enumerant{name: "al", value: 14}, operand.Enumerant{name: "nv", value: 15}};

#[testing]
val T_VALUES: [2]u32 = [2]u32{14, 15};

#[testing]
val T_OUTSIDE: [2]u32 = [2]u32{14, 3};

test excludable__each_shape_holds_the_values_its_operand_admits_and_refuses_the_rest {
    val e:    operand.Enumeration  = operand.Enumeration{members: ?T_ENUMERANTS[0], count: 3, mask: false, names: index.Index{at: nil, len: 0}};
    val near: [1]i64               = [1]i64{4};
    val far:  [1]i64               = [1]i64{2};
    val rel:  operand.Immediate    = operand.Immediate{bits: 8, sign: operand.SIGNED, scale: 1, bias: 0, fixup: 0, format: operand.INTEGER, excluded: operand.Integers{at: ?far[0], len: 1}};
    val cond: operand.Operand      = operand.Operand{shape: operand.Shape.condition{e}, role: operand.NONE, width: 0, quantity: operand.ONE};
    val en:   operand.Operand      = operand.Operand{shape: operand.Shape.enumerant{e}, role: operand.NONE, width: 0, quantity: operand.ONE};
    val rl:   operand.Operand      = operand.Operand{shape: operand.Shape.relative{operand.Relative{offset: rel, anchor: operand.START}}, role: operand.NONE, width: 0, quantity: operand.ONE};
    var ex:   core_syntax.Excluded = core_syntax.Excluded.condition{operand.Numbers{at: ?T_VALUES[0], len: 2}};
    var s:    S.Set                = T_SET;
    if (!check_syntax.excludable(?s, ?cond, ?ex)) { ret 1; }
    if (check_syntax.excludable(?s, ?en, ?ex))    { ret 2; }
    ex = core_syntax.Excluded.condition{operand.Numbers{at: ?T_OUTSIDE[0], len: 2}};
    if (check_syntax.excludable(?s, ?cond, ?ex)) { ret 3; }
    ex = core_syntax.Excluded.condition{operand.NO_NUMBERS};
    if (check_syntax.excludable(?s, ?cond, ?ex)) { ret 4; }
    ex = core_syntax.Excluded.enumerant{operand.Numbers{at: ?T_VALUES[0], len: 2}};
    if (!check_syntax.excludable(?s, ?en, ?ex)) { ret 5; }
    ex = core_syntax.Excluded.relative{operand.Integers{at: ?near[0], len: 1}};
    if (!check_syntax.excludable(?s, ?rl, ?ex)) { ret 6; }
    ex = core_syntax.Excluded.relative{operand.Integers{at: ?far[0], len: 1}};
    if (check_syntax.excludable(?s, ?rl, ?ex)) { ret 7; }
    ex = core_syntax.Excluded.immediate{operand.Integers{at: ?near[0], len: 1}};
    if (check_syntax.excludable(?s, ?rl, ?ex)) { ret 8; }
    ret 0;
}
