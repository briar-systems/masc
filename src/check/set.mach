val T_RAW_FIELDS: [1]field.Field = [1]field.Field{field.Field{kind: 0, width: 16, fixed: 0, mask: 0, slices: field.Slices{at: ?T_RAW_SLICES[0], len: 1}, operand: field.NO_OPERAND, param: 0}};

#[testing]
val T_RAW_EFFECT: effect.Effect = effect.Effect{
    implicit: effect.Registers.ruled{effect.Ruled{otherwise: effect.NO_TOUCHED, rules: effect.NO_REGISTER_RULES, may: effect.NO_TOUCHED, must: effect.NO_TOUCHED}},
    flags:    effect.Flags{read: effect.NO_WORDS, written: effect.NO_WORDS, undefined: effect.NO_WORDS, kept: effect.NO_WORDS},
    memory:   effect.NO_ACCESSES,
    control:  effect.Control{transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, operand: field.NO_OPERAND, rules: effect.NO_RULES},
    stack:    effect.Stack.none{},
    latency:  effect.ONE,
    fixed:    effect.NO_FIXEDS,
};

#[testing]
val T_RAW: row.Row = row.Row{key: "raw", mnemonic: ".insn", operands: row.Operands{at: ?T_RAW_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?T_RAW_FIELDS[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?T_RAW_EFFECT, ct: ?ct.DEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0};

#[testing]
fun t_length(data: *u8, len: usize) usize {
    ret 2;
}

test insns__a_format_of_a_catalog_row_or_a_raw_form_its_row_or_set_cannot_hold_is_refused {
    var s:       S.Set                 = T_SET;
    var formats: [1]core_source.Format = [1]core_source.Format{core_source.Format{template: "2, <0>", row: ?T_RAW, length: 2}};
    s.source.insns = core_source.Insns{directive: ".insn", formats: core_source.Formats{at: ?formats[0], len: 1}, length: t_length};
    val fine_: err[check.Refusal] = check_source.insns(?s);
    if (sel fine_.err) { ret 1; }
    # a row of the catalog, which what indexes the catalog would take for its own
    formats[0].row = ?T_ROWS[0];
    if (!t_refused(check_source.insns(?s), check_source.FORMAT_ROW, "format", 0)) { ret 2; }
    # a raw form of a length its operand and unit do not have
    formats[0].row    = ?T_RAW;
    formats[0].length = 4;
    if (!t_refused(check_source.insns(?s), check_source.FORMAT_ROW, "format", 0)) { ret 3; }
    # raw forms with no length encoding to check them by
    formats[0].length     = 2;
    s.source.insns.length = nil;
    if (!t_refused(check_source.insns(?s), check_source.INSNS_ROW, "insns", 0)) { ret 4; }
    ret 0;
}

# an architecture enters a requirement some selection meets: one excluding what it needs, or what its own extension
# conflicts with, no selection meets (#275)
test arches__an_architecture_entering_a_requirement_no_selection_meets_is_refused {
    val conflicts: [1]extension.Conflict      = [1]extension.Conflict{extension.Conflict{a: 0, b: 1}};
    val names:     [2]extension.NameEntry     = [2]extension.NameEntry{extension.NameEntry{key: "i", rows: requirement.Ids{at: ?T_EXTENSION_IDS[0], len: 1}, canonical: true}, extension.NameEntry{key: "j", rows: requirement.Ids{at: ?T_EXTENSION_IDS[1], len: 1}, canonical: true}};
    val rows:      [2]extension.Extension     = [2]extension.Extension{T_EXTENSIONS[0], extension.Extension{name: "j", implies: requirement.NO_IDS, revision: nil}};
    val ids:       [2]requirement.Id          = [2]requirement.Id{0, 1};
    val excluding: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?ids[0], len: 1}, none: requirement.Ids{at: ?ids[0], len: 1}}};
    val both:      [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?ids[0], len: 2}, none: requirement.NO_IDS}};
    var catalog:   extension.Catalog          = T_CATALOG;
    catalog.extensions     = ?rows[0];
    catalog.count          = 2;
    catalog.names          = extension.Names{at: ?names[0], len: 2};
    catalog.conflicts      = ?conflicts[0];
    catalog.conflict_count = 1;
    var arch: S.Arch = T_ARCHES[0];
    var s:    S.Set  = T_SET;
    s.extensions = ?catalog;
    s.arches     = S.Arches{at: ?arch, len: 1};
    val fine: err[check.Refusal] = arches(?s);
    if (sel fine.err) { ret 1; }
    arch.enters = requirement.Requirement{at: ?excluding[0], len: 1};
    if (!t_refused(arches(?s), ENTERS, "architecture", 0)) { ret 2; }
    arch.enters = requirement.Requirement{at: ?both[0], len: 1};
    if (!t_refused(arches(?s), ENTERS, "architecture", 0)) { ret 3; }
    ret 0;
}

test one__an_architecture_mink_does_not_know_is_refused {
    val foreign: mink.arch.Arch = mink.arch.Arch{name: "riscv64", pointer_bytes: 8, page_size: 0x1000, caps: mink.arch.ADDRESSED};
    val arches:  [1]S.Arch      = [1]S.Arch{S.Arch{arch: ?foreign, enters: requirement.NO_ALTERNATIVES, initial: state.Settings{at: [state.MAX_AXES]u8{0, 0, 0, 0, 0, 0, 0, 0}}}};
    var s:       S.Set          = T_SET;
    s.arches = S.Arches{at: ?arches[0], len: 1};
    if (!t_refused(one(?s), UNKNOWN_ARCH, "architecture", 0)) { ret 1; }
    ret 0;
}

# the test row with its control holding `rules` of the terms given
#[testing]
fun t_with_rules(rules: *effect.Rule, count: u32, e: *effect.Effect, rows: *row.Row, codec: *core_dispatch.Codec, s: *S.Set) {
    @e              = T_EFFECT;
    e.control.rules = effect.Rules{at: rules, len: count};
    var r: row.Row = T_ROWS[0];
    r.effect = e;
    t_with_row(r, rows, codec, s);
}

test one__effect_rules_that_can_both_hold_or_test_what_the_row_lacks_are_refused {
    val zero:  [1]u64         = [1]u64{0x1};
    val wide:  [1]u64         = [1]u64{0x20};
    val set:   effect.Test    = effect.Test.register{effect.Set{words: ?zero[0], len: 1}};
    val tests: [4]effect.Term = [4]effect.Term{
        effect.Term{operand: 0, test: set},
        effect.Term{operand: 0, test: effect.Test.register{effect.Set{words: ?wide[0], len: 1}}},
        effect.Term{operand: 2, test: set},
        effect.Term{operand: 1, test: effect.Test.immediate{1}},
    };
    var rules: [2]effect.Rule = [2]effect.Rule{
        effect.Rule{terms: effect.Terms{at: ?tests[0], len: 1}, transfer: effect.CALL, target: effect.DIRECT, conditional: false},
        effect.Rule{terms: effect.Terms{at: ?tests[0], len: 1}, transfer: effect.RETURN, target: effect.UNTARGETED, conditional: false},
    };
    var e:     effect.Effect;
    var rows:  row.Row;
    var codec: core_dispatch.Codec;
    var s:     S.Set;
    # two rules testing the same registers of one operand overlap, in either order
    t_with_rules(?rules[0], 2, ?e, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), check_effect.RULE_OVERLAP, "row", 0)) { ret 1; }
    # a register set reaching past the file
    rules[1].terms = effect.Terms{at: ?tests[1], len: 1};
    t_with_rules(?rules[0], 2, ?e, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), check.EFFECT_ROW, "row", 0)) { ret 2; }
    # a rule with no terms always holds
    rules[1].terms = effect.NO_TERMS;
    t_with_rules(?rules[0], 2, ?e, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), check_effect.RULE_TERMS, "row", 0)) { ret 3; }
    # an operand the row lacks, a kind the operand is not
    rules[1].terms = effect.Terms{at: ?tests[2], len: 1};
    t_with_rules(?rules[0], 2, ?e, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), check_effect.RULE_OPERAND, "row", 0)) { ret 4; }
    rules[1].terms = effect.Terms{at: ?tests[3], len: 1};
    t_with_rules(?rules[0], 2, ?e, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), check_effect.RULE_OPERAND, "row", 0)) { ret 5; }
    # register rules take the same checks as control rules
    val dyn:      [1]effect.Term         = [1]effect.Term{effect.Term{operand: 0, test: effect.Test.enumerant{7}}};
    var switches: [2]effect.RegisterRule = [2]effect.RegisterRule{
        effect.RegisterRule{terms: effect.Terms{at: ?tests[0], len: 1}, touched: effect.Touched{read: effect.Set{words: ?zero[0], len: 1}, written: effect.NO_WORDS}},
        effect.RegisterRule{terms: effect.Terms{at: ?tests[0], len: 1}, touched: effect.NO_TOUCHED},
    };
    t_with_rules(nil, 0, ?e, ?rows, ?codec, ?s);
    var g: effect.Ruled = effect.Ruled{otherwise: effect.NO_TOUCHED, rules: effect.RegisterRules{at: ?switches[0], len: 2}, may: effect.NO_TOUCHED, must: effect.NO_TOUCHED};
    e.implicit = effect.Registers.ruled{g};
    if (!t_refused(one(?s), check_effect.RULE_OVERLAP, "row", 0)) { ret 6; }
    # the rule reads a row the effect's may set lacks, then holds it
    g.rules    = effect.RegisterRules{at: ?switches[0], len: 1};
    e.implicit = effect.Registers.ruled{g};
    if (!t_refused(one(?s), check_effect.RULE_BOUNDS, "row", 0)) { ret 7; }
    g.may.read = effect.Set{words: ?zero[0], len: 1};
    e.implicit = effect.Registers.ruled{g};
    val alone: opt[str] = check_effect.effects(?s, ?rows);
    if (sel alone.some) { ret 10; }
    # a must set holding the row the rule reads and the effect's own sets lack
    g.must.read = effect.Set{words: ?zero[0], len: 1};
    e.implicit  = effect.Registers.ruled{g};
    if (!t_refused(one(?s), check_effect.RULE_BOUNDS, "row", 0)) { ret 11; }
    # opaque registers are held only to must within may
    e.implicit = effect.Registers.opaque{effect.Opaque{may: effect.NO_TOUCHED, must: g.must}};
    if (!t_refused(one(?s), check_effect.OPAQUE_BOUNDS, "row", 0)) { ret 12; }
    e.implicit = effect.Registers.opaque{effect.Opaque{may: g.must, must: effect.NO_TOUCHED}};
    val open: opt[str] = check_effect.effects(?s, ?rows);
    if (sel open.some) { ret 13; }
    g.must.read              = effect.NO_WORDS;
    e.implicit               = effect.Registers.ruled{g};
    switches[0].touched.read = effect.Set{words: ?wide[0], len: 1};
    if (!t_refused(one(?s), check.EFFECT_ROW, "row", 0)) { ret 8; }
    # an enumerant test of a register operand
    switches[0].terms        = effect.Terms{at: ?dyn[0], len: 1};
    switches[0].touched.read = effect.NO_WORDS;
    if (!t_refused(one(?s), check_effect.RULE_OPERAND, "row", 0)) { ret 9; }
    ret 0;
}

# a file of x0, v1, an accrued csr and a vector length csr, for the tests of writes that may keep their old values
#[testing]
val T_KEEP_CLASSES: [3]register.Class = [3]register.Class{
    register.Class{name: "x", kind: register.GENERAL, width: quantity.Scaled{fixed: 64, per: 0, scale: 0}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    register.Class{name: "v", kind: register.VECTOR, width: quantity.Scaled{fixed: 128, per: 0, scale: 0}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    register.Class{name: "csr", kind: register.SYSTEM, width: quantity.Scaled{fixed: 64, per: 0, scale: 0}, count: quantity.Scaled{fixed: 4096, per: 0, scale: 0}},
};

#[testing]
val T_KEEP_REGISTERS: [4]register.Register = [4]register.Register{
    register.Register{name: "x0", class: 0, number: 0, bank: 0, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: register.ZERO, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "v1", class: 1, number: 1, bank: 1, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "fflags", class: 2, number: 1, bank: 2, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: register.ACCRUED, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "vl", class: 2, number: 0xC20, bank: 3, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: register.LENGTH, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
};

#[testing]
val T_KEEP_FILE: register.File = register.File{
    quantities:     quantity.NO_QUANTITIES,
    bindings:       quantity.NO_BINDINGS,
    slot_count:     0,
    classes:        ?T_KEEP_CLASSES[0],
    class_count:    3,
    class_names:    index.NO_ENTRIES,
    registers:      ?T_KEEP_REGISTERS[0],
    register_count: 4,
    aliases:        nil,
    alias_count:    0,
    names:          index.NO_ENTRIES,
    columns:        nil,
    column_count:   0,
};

# what check finds of the test row with its destination of class `class` and role `role`, reading `read` and writing
# `written` of T_KEEP_FILE implicitly
#[testing]
fun t_kept(class: *u16, role: operand.Role, read: effect.Set, written: effect.Set) opt[str] {
    var operands: [2]operand.Operand = T_OPERANDS;
    operands[0].shape = operand.Shape.register{operand.Register{classes: operand.Classes{at: class, len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}};
    operands[0].role  = role;
    var e:  effect.Effect  = T_EFFECT;
    val on: effect.Touched = effect.Touched{read: read, written: written};
    e.implicit = effect.Registers.ruled{effect.Ruled{otherwise: on, rules: effect.NO_REGISTER_RULES, may: on, must: on}};
    var r: row.Row = T_ROWS[0];
    r.operands = row.Operands{at: ?operands[0], len: 2};
    r.effect   = ?e;
    var rows:  row.Row;
    var codec: core_dispatch.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    codec.registers = ?T_KEEP_FILE;
    ret check_effect.effects(?s, ?rows);
}

# whether `got` is the refusal `message`, or clear when `message` is nil
#[testing]
fun t_found(got: opt[str], message: str) bool {
    if (message == nil) { ret sel got.none; }
    ret sel got.some && got.some == message;
}

test effects__a_write_that_may_keep_its_old_value_and_is_not_a_read_is_refused {
    val x:       [1]u16     = [1]u16{0};
    val v:       [1]u16     = [1]u16{1};
    val csr:     [1]u16     = [1]u16{2};
    val vector:  [1]u64     = [1]u64{0x2};
    val accrued: [1]u64     = [1]u64{0x4};
    val length:  [1]u64     = [1]u64{0x8};
    val both:    [1]u64     = [1]u64{0xA};
    val none:    effect.Set = effect.NO_WORDS;
    # an accrued register written and not read, implicitly or by an operand that admits it
    if (!t_found(t_kept(?x[0], operand.WRITE, none, effect.Set{words: ?accrued[0], len: 1}), check_effect.ACCRUED_WRITE))            { ret 1; }
    if (!t_found(t_kept(?x[0], operand.WRITE, effect.Set{words: ?accrued[0], len: 1}, effect.Set{words: ?accrued[0], len: 1}), nil)) { ret 2; }
    if (!t_found(t_kept(?csr[0], operand.WRITE, none, none), check_effect.ACCRUED_WRITE))                                            { ret 3; }
    if (!t_found(t_kept(?csr[0], operand.READ_WRITE, none, none), nil))                                                              { ret 4; }
    # a vector register written and not read while the vector length is read, by an operand or implicitly
    if (!t_found(t_kept(?v[0], operand.WRITE, effect.Set{words: ?length[0], len: 1}, none), check_effect.TAIL_WRITE))                                  { ret 5; }
    if (!t_found(t_kept(?v[0], operand.READ_WRITE, effect.Set{words: ?length[0], len: 1}, none), nil))                                                 { ret 6; }
    if (!t_found(t_kept(?v[0], operand.WRITE, none, none), nil))                                                                                       { ret 7; }
    if (!t_found(t_kept(?x[0], operand.WRITE, effect.Set{words: ?length[0], len: 1}, effect.Set{words: ?vector[0], len: 1}), check_effect.TAIL_WRITE)) { ret 8; }
    if (!t_found(t_kept(?x[0], operand.WRITE, effect.Set{words: ?both[0], len: 1}, effect.Set{words: ?vector[0], len: 1}), nil))                       { ret 9; }
    ret 0;
}

test one__a_condition_test_of_an_enumerant_operand_and_an_id_test_of_a_register_operand_are_refused {
    val members:  [2]operand.Enumerant = [2]operand.Enumerant{operand.Enumerant{name: "", value: 0}, operand.Enumerant{name: ".aq", value: 1}};
    val names:    [2]index.Entry       = [2]index.Entry{index.Entry{key: "", row: 0}, index.Entry{key: ".aq", row: 1}};
    var operands: [2]operand.Operand   = T_OPERANDS;
    operands[1].shape = operand.Shape.enumerant{operand.Enumeration{members: ?members[0], count: 2, mask: false, names: index.Index{at: ?names[0], len: 2}}};
    val tests: [2]effect.Term = [2]effect.Term{
        effect.Term{operand: 1, test: effect.Test.condition{0}},
        effect.Term{operand: 0, test: effect.Test.id{0}},
    };
    var rules: [1]effect.Rule = [1]effect.Rule{
        effect.Rule{terms: effect.Terms{at: ?tests[0], len: 1}, transfer: effect.CALL, target: effect.UNTARGETED, conditional: false},
    };
    var e:     effect.Effect;
    var rows:  row.Row;
    var codec: core_dispatch.Codec;
    var s:     S.Set;
    var r:     row.Row = T_ROWS[0];
    r.operands      = row.Operands{at: ?operands[0], len: 2};
    e               = T_EFFECT;
    e.control.rules = effect.Rules{at: ?rules[0], len: 1};
    r.effect        = ?e;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), check_effect.RULE_OPERAND, "row", 0)) { ret 1; }
    rules[0].terms = effect.Terms{at: ?tests[1], len: 1};
    if (!t_refused(one(?s), check_effect.RULE_OPERAND, "row", 0)) { ret 2; }
    ret 0;
}

test one__a_register_constraint_on_an_operand_the_row_lacks_is_refused {
    val sides: [1]constraint.Side       = [1]constraint.Side{constraint.Side{operand: 0, part: constraint.WHOLE}};
    var kept:  [1]constraint.Constraint = [1]constraint.Constraint{
        constraint.Constraint{side: constraint.Side{operand: 2, part: constraint.WHOLE}, against: constraint.Against.sides{constraint.Sides{at: ?sides[0], len: 1}}, permit: constraint.DISJOINT, when: effect.NO_TERMS},
    };
    var r: row.Row = T_ROWS[0];
    r.constraints = constraint.Constraints{at: ?kept[0], len: 1};
    var rows:  row.Row;
    var codec: core_dispatch.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), check_row.KEPT_OPERAND, "row", 0)) { ret 1; }
    # the relative target holds no register to keep apart
    kept[0].side.operand = 1;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), check_row.KEPT_OPERAND, "row", 0)) { ret 2; }
    ret 0;
}

test one__a_row_key_given_to_two_rows_is_refused_naming_both {
    var rows:  [2]row.Row          = [2]row.Row{T_ROWS[0], T_ROWS[0]};
    val keys:  [2]index.Entry      = [2]index.Entry{index.Entry{key: "jal", row: 0}, index.Entry{key: "jal", row: 1}};
    var codec: core_dispatch.Codec = T_CODEC;
    var s:     S.Set               = T_SET;
    codec.rows = row.Rows{at: ?rows[0], len: 2};
    codec.keys = index.Index{at: ?keys[0], len: 2};
    s.codec    = ?codec;
    val checked: err[check.Refusal] = one(?s);
    if (!t_refused(checked, check_row.SHARED_KEY, "row", 0)) { ret 1; }
    if (!(sel checked.err && checked.err.other == 1))        { ret 2; }
    ret 0;
}

test one__a_class_name_given_to_two_classes_is_refused_naming_both {
    val classes: [2]register.Class   = [2]register.Class{T_CLASSES[0], T_CLASSES[0]};
    val names:   [2]index.Entry      = [2]index.Entry{index.Entry{key: "x", row: 0}, index.Entry{key: "x", row: 1}};
    var file:    register.File       = T_FILE;
