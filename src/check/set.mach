    arches:     S.Arches{at: ?T_ARCHES[0], len: 1},
    states:     state.NO_AXES,
    codec:      ?T_CODEC,
    extensions: ?T_CATALOG,
    bindings:   core_fixup.Bindings{at: ?T_BINDINGS[0], len: 1},
    relax:      relax.NO_RELAXATIONS,
    compress:   compress.NO_COMPRESSIONS,
    fill:       nil,
    realign:    operand.NO_FIXUP,
