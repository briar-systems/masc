};

#[testing]
val T_ROW_KEYS: [1]index.Entry = [1]index.Entry{index.Entry{key: "jal", row: 0}};

#[testing]
val T_KINDS: [1]*field.Kind = [1]*field.Kind{?field.UNIT};

#[testing]
val T_TABLE: field.Table = field.Table{kinds: ?T_KINDS[0], count: 1, order: field.LITTLE};

#[testing]
fun t_opcode(ctx: *state.Context, s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val word: res[u64, field.Refusal] = field.read(s, at, 4);
    if (sel word.err) { ret word; }
    ret res[u64, field.Refusal].ok{word.ok & 0x7F};
}

#[testing]
val T_KEYS: [1]core_dispatch.Key = [1]core_dispatch.Key{core_dispatch.Key{name: "opcode", extract: t_opcode}};

#[testing]
val T_NODES: [1]core_dispatch.Node = [1]core_dispatch.Node{core_dispatch.Node{key: 0, first: 0, count: 1}};

#[testing]
val T_ENTRIES: [1]core_dispatch.Entry = [1]core_dispatch.Entry{core_dispatch.Entry{value: 0x6F, node: 0, first: 0, count: 1}};

#[testing]
val T_CANDIDATES: [1]u32 = [1]u32{0};

#[testing]
val T_DISPATCH: core_dispatch.Dispatch = core_dispatch.Dispatch{keys: ?T_KEYS[0], key_count: 1, nodes: ?T_NODES[0], node_count: 1, entries: ?T_ENTRIES[0], entry_count: 1, candidates: ?T_CANDIDATES[0], candidate_count: 1};

#[testing]
val T_CODEC: core_dispatch.Codec = core_dispatch.Codec{fields: ?T_TABLE, registers: ?T_FILE, rows: row.Rows{at: ?T_ROWS[0], len: 1}, keys: index.Index{at: ?T_ROW_KEYS[0], len: 1}, dispatch: ?T_DISPATCH};

