    column_count:   1,
};

#[testing]
val T_GPR: [1]u16 = [1]u16{0};

#[testing]
val T_OPERANDS: [2]operand.Operand = [2]operand.Operand{
    operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?T_GPR[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}}, role: operand.WRITE, width: 64, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.relative{operand.Relative{offset: operand.Immediate{bits: 21, sign: operand.SIGNED, scale: 1, bias: 0, fixup: 1, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, anchor: operand.START}}, role: operand.NONE, width: 0, quantity: operand.ONE},
};

