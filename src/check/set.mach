};

# whether `checked` is the refusal of `message` at row `index` of `table`
#[testing]
fun t_refused(checked: err[check.Refusal], message: str, table: str, index: u32) bool {
    ret sel checked.err && (checked.err.message == message && str_equals(checked.err.table, table) && checked.err.index == index);
}

# the test set with its one row replaced by `r`, held in `rows`, `codec` and `s`
#[testing]
fun t_with_row(r: row.Row, rows: *row.Row, codec: *core_dispatch.Codec, s: *S.Set) {
    @rows      = r;
    @codec     = T_CODEC;
    codec.rows = row.Rows{at: rows, len: 1};
    @s         = T_SET;
    s.codec    = codec;
}

test one__a_row_naming_an_unknown_register_class_is_refused {
    val classes:  [1]u16             = [1]u16{1};
    var operands: [2]operand.Operand = T_OPERANDS;
    operands[0].shape = operand.Shape.register{operand.Register{classes: operand.Classes{at: ?classes[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}};
    var r: row.Row = T_ROWS[0];
    r.operands = row.Operands{at: ?operands[0], len: 2};
    var rows:  row.Row;
    var codec: core_dispatch.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), check_row.UNKNOWN_CLASS, "row", 0)) { ret 1; }
    ret 0;
}

# a group holds members of one value each and no group, and a literal's width names an id operand
test one__a_group_of_a_group_or_a_literal_width_of_no_id_is_refused {
    var inner:    [1]operand.Operand = [1]operand.Operand{T_OPERANDS[0]};
    var members:  [1]operand.Operand = [1]operand.Operand{T_OPERANDS[0]};
    var operands: [2]operand.Operand = T_OPERANDS;
    members[0].shape  = operand.Shape.group{operand.Group{at: ?inner[0], len: 1}};
    operands[1].shape = operand.Shape.group{operand.Group{at: ?members[0], len: 1}};
    var r: row.Row = T_ROWS[0];
    r.operands = row.Operands{at: ?operands[0], len: 2};
    var rows:  row.Row;
    var codec: core_dispatch.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(check_row.rows(?s), check_row.GROUP, "row", 0)) { ret 1; }
    operands[1].shape = operand.Shape.literal{operand.Literal{max: 4, content: operand.NUMBER, width_of: 1}};
    rows              = r;
    if (!t_refused(check_row.rows(?s), check_row.WIDTH_OF, "row", 0)) { ret 2; }
    ret 0;
}

test one__an_unsorted_enumeration_name_index_is_refused {
