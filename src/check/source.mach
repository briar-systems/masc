# the check of a set's assembly source dialect: its directives, attributes, instruction formats and forms

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_equals;

use mink;

use masc.check.check;
use check_extension: masc.check.extension;
use check_row:       masc.check.row;
use check_syntax:    masc.check.syntax;
use core_fixup:      masc.core.fixup;
use masc.core.mode;
use masc.core.operand;
use masc.core.row;
use S:           masc.core.set;
use core_source: masc.core.source;
use core_syntax: masc.core.syntax;
use masc.core.trait;

pub val SOURCE:         str = "assembly source dialect without a comment or separator, or reading .align neither way";
pub val WIDTH_ROW:      str = "data directive not spelled with a leading dot, of a width past the widest, or named twice";
pub val FORMS_ROW:      str = "form directive not spelled with a leading dot, stating no narrowing or more than the most, or a push without a pop";
pub val VALUE_OPERAND:  str = "mode value spelled as another mode's value, the push, the pop or a narrowing of the form directive";
pub val NARROWING_ROW:  str = "narrowing that removes nothing or an extension the catalog lacks, lifts to one it lacks, or spells an operand empty or twice";
pub val ATTRIBUTES_ROW: str = "attribute directive not spelled with a leading dot, or stating no tag";
pub val INSNS_ROW:      str = "instruction directive not spelled with a leading dot or stating no format, or a raw form with no length encoding";
pub val FORMAT_ROW:     str = "instruction format of no name, a row of the catalog, a malformed row or a template that does not write it, or a raw form of a length its one operand and unit do not have";
pub val TAG_ROW:        str = "attribute tag unnamed, named or numbered twice, of an axis an architecture of the set lacks or the set names an owner of, or a selection tag of no text axis";

# the set's assembly source dialect: a comment and a separator, a reading of .align, and each data directive once
pub fun source(s: *S.Set) err[check.Refusal] {
    val src: *core_source.Source = ?s.source;
    if (src.comment == nil || src.comment[0] == 0 || src.separator == 0 || src.align > core_source.ALIGN_POWER) { ret check.refuse(s, SOURCE, "source", 0); }
    var i: u32 = 0;
    for (i < src.widths.len) {
        val w: *core_source.Width = ?src.widths.at[i];
        if (w.name == nil || w.name[0] != '.' || w.width == 0 || w.width > core_fixup.MAX_WIDTH) { ret check.refuse(s, WIDTH_ROW, "width", i); }
        var j: u32 = 0;
        for (j < i) {
            if (str_equals(src.widths.at[j].name, w.name)) { ret check.refuse_pair(s, WIDTH_ROW, "width", i, j); }
            j = j + 1;
        }
        i = i + 1;
    }
    val formed: err[check.Refusal] = forms(s);
    if (sel formed.err) { ret formed; }
    val tagged: err[check.Refusal] = attributes(s);
    if (sel tagged.err) { ret tagged; }
    ret insns(s);
}

# the dialect's attribute tags: each named and numbered once, its axis one every architecture of the set has and the set
# names no owner of, so each trait has one owner, and a selection tag's axis a text
fun attributes(s: *S.Set) err[check.Refusal] {
    val at: *core_source.Attributes = ?s.source.attributes;
    if (check.empty(at.directive)) {
        if (at.tags.len != 0) { ret check.refuse(s, ATTRIBUTES_ROW, "attributes", 0); }
        ret check.fine();
    }
    if (at.directive[0] != '.' || at.tags.len == 0) { ret check.refuse(s, ATTRIBUTES_ROW, "attributes", 0); }
    var i: u32 = 0;
    for (i < at.tags.len) {
        val t: *core_source.Tag = ?at.tags.at[i];
        if (check.empty(t.name)) { ret check.refuse(s, TAG_ROW, "tag", i); }
        if (t.axis == nil) {
            if (t.selection) { ret check.refuse(s, TAG_ROW, "tag", i); }
        }
        or {
            val owned: opt[*trait.Owned] = S.owner_of(s, t.axis);
            if (sel owned.some)                        { ret check.refuse(s, TAG_ROW, "tag", i); }
            if (t.selection && !sel t.axis.value.text) { ret check.refuse(s, TAG_ROW, "tag", i); }
            var k: u32 = 0;
            for (k < s.arches.len) {
                if (!mink.arch.has_axis(s.arches.at[k].arch, t.axis)) { ret check.refuse(s, TAG_ROW, "tag", i); }
                k = k + 1;
            }
        }
        var j: u32 = 0;
        for (j < i) {
            val u: *core_source.Tag = ?at.tags.at[j];
            if (str_equals(u.name, t.name) || u.number == t.number) { ret check.refuse_pair(s, TAG_ROW, "tag", i, j); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret check.fine();
}

# whether `r` is a row of the set's catalog, the row its index names
fun catalog_row(s: *S.Set, r: *row.Row) bool {
    ret row.of(s.codec.rows, r);
}

# whether format `f` of the instruction directive is unsound, where a sound one is named, its row is no row of
# the catalog, so nothing that indexes the catalog reaches it, the row is sound and every syntax reads its template, and
# a raw form's one operand is an unsigned immediate of its length in one unit of that length
fun format_defect(s: *S.Set, f: *core_source.Format) bool {
    if (f.row == nil || check.empty(f.template) || catalog_row(s, f.row)) { ret true; }
    if (core_syntax.piece(f.template, 0).kind != core_syntax.TEXT)        { ret true; }
    val defect: opt[str] = check_row.row_defect(s, f.row);
    if (sel defect.some) { ret true; }
    val r:     *row.Row = f.row;
    var descs: [row.MAX_OPERANDS]*operand.Operand;
    var k:     u32      = 0;
    for (k < r.operands.len) {
        descs[k] = ?r.operands.at[k];
        k        = k + 1;
    }
    k = 0;
    for (k < s.syntaxes.len) {
        val read: opt[str] = check_syntax.template_defect(?s.syntaxes.at[k], f.template, ?descs[0], r.operands.len, 0);
        if (sel read.some) { ret true; }
        k = k + 1;
    }
    if (f.length == 0)                                                                                  { ret false; }
    if (r.operands.len != 1 || r.encoding.len != 1 || r.encoding.at[0].width::u32 != f.length::u32 * 8) { ret true; }
    val sh: *operand.Shape = ?r.operands.at[0].shape;
    if (!sel sh.immediate) { ret true; }
    ret sh.immediate.sign != operand.UNSIGNED || sh.immediate.bits::u32 != f.length::u32 * 8;
}

# the dialect's instruction directive: a directive exactly when it states a format, each format sound, and a length
# encoding when a raw form needs one
pub fun insns(s: *S.Set) err[check.Refusal] {
    val at: *core_source.Insns = ?s.source.insns;
    if (check.empty(at.directive)) {
        if (at.formats.len != 0 || at.length != nil) { ret check.refuse(s, INSNS_ROW, "insns", 0); }
        ret check.fine();
    }
    if (at.directive[0] != '.' || at.formats.len == 0) { ret check.refuse(s, INSNS_ROW, "insns", 0); }
    var raw: bool = false;
    var i:   u32  = 0;
    for (i < at.formats.len) {
        val f: *core_source.Format = ?at.formats.at[i];
        if (format_defect(s, f)) { ret check.refuse(s, FORMAT_ROW, "format", i); }
        raw = raw || f.length > 0;
        i   = i + 1;
    }
    if (raw && at.length == nil) { ret check.refuse(s, INSNS_ROW, "insns", 0); }
    ret check.fine();
}

# whether operand `name` of the form directive is spelled by the stack, the restating operand or by a narrowing before
# row `before`
fun spelled_before(f: *core_source.Forms, name: str, before: u32) bool {
    if ((!check.empty(f.push) && str_equals(f.push, name)) || (!check.empty(f.pop) && str_equals(f.pop, name))) { ret true; }
    if (!check.empty(f.restates) && str_equals(f.restates, name))                                               { ret true; }
    var j: u32 = 0;
    for (j < before) {
        val n: *core_source.Narrowing = ?f.narrowings.at[j];
        if (str_equals(n.narrow, name) || str_equals(n.lift, name)) { ret true; }
        j = j + 1;
    }
    ret false;
}

# whether some value of a mode of the set before value `before` of mode `at` is spelled `name`, every mode's values being
# operands of the form directive
fun value_before(all: *mode.Modes, name: str, at: u32, before: u32) bool {
    var i: u32 = 0;
    for (i <= at && i < all.len) {
        val m: *mode.Mode = all.at[i];
        var j: u32        = 0;
        for (j < m.values.len && (i < at || j < before)) {
            if (str_equals(m.values.at[j].name, name)) { ret true; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret false;
}

# the dialect's forms: a directive exactly when it states a narrowing, a pop exactly with a push, and each operand once,
# the value of every mode among them, so no operand is read two ways
pub fun forms(s: *S.Set) err[check.Refusal] {
    val f: *core_source.Forms = ?s.source.forms;
    if (check.empty(f.directive)) {
        if (f.narrowings.len != 0 || !check.empty(f.push) || !check.empty(f.pop) || !check.empty(f.restates)) { ret check.refuse(s, FORMS_ROW, "forms", 0); }
        ret check.fine();
    }
    if (f.directive[0] != '.' || f.narrowings.len == 0 || f.narrowings.len > core_source.MAX_NARROWINGS)  { ret check.refuse(s, FORMS_ROW, "forms", 0); }
    if (check.empty(f.push) != check.empty(f.pop) || (!check.empty(f.push) && str_equals(f.push, f.pop))) { ret check.refuse(s, FORMS_ROW, "forms", 0); }
    if (!check.empty(f.restates) && (str_equals(f.restates, f.push) || str_equals(f.restates, f.pop)))    { ret check.refuse(s, FORMS_ROW, "forms", 0); }
    var i: u32 = 0;
    for (i < f.narrowings.len) {
        val n: *core_source.Narrowing = ?f.narrowings.at[i];
        if (check.empty(n.narrow) || check.empty(n.lift) || str_equals(n.narrow, n.lift))                                 { ret check.refuse(s, NARROWING_ROW, "narrowing", i); }
        if (spelled_before(f, n.narrow, i) || spelled_before(f, n.lift, i))                                               { ret check.refuse(s, NARROWING_ROW, "narrowing", i); }
        if (n.removes.len == 0 || !check_extension.in_catalog(s.extensions, n.removes) || n.lifted >= s.extensions.count) { ret check.refuse(s, NARROWING_ROW, "narrowing", i); }
        i = i + 1;
    }
    val all: *mode.Modes = ?s.assembly;
    i = 0;
    for (i < all.len) {
        val m: *mode.Mode = all.at[i];
        var j: u32        = 0;
        for (j < m.values.len) {
            val name: str = m.values.at[j].name;
            if (spelled_before(f, name, f.narrowings.len) || value_before(all, name, i, j)) { ret check.refuse(s, VALUE_OPERAND, "assembler mode", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret check.fine();
}
