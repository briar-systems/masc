# the check of a set's assembly source dialect: its data directives, its directives and their edits, the formats its
# raw directive reads and its mapping symbols

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_equals;

use masc.check.check;
use check_extension: masc.check.extension;
use check_row:       masc.check.row;
use check_syntax:    masc.check.syntax;
use core_fixup:      masc.core.fixup;
use masc.core.mode;
use masc.core.operand;
use masc.core.row;
use S:           masc.core.set;
use core_source: masc.core.source;
use core_syntax: masc.core.syntax;

pub val SOURCE:        str = "assembly source dialect without a comment or separator, or reading .align neither way";
pub val WIDTH_ROW:     str = "data directive not spelled with a leading dot, of a width past the widest, or named twice";
pub val DIRECTIVE_ROW: str = "directive not spelled with a leading dot, reading other operands than its edit takes, or past the most a dialect states";
pub val NAME_ROWS:     str = "rows of one directive name not told apart by a word each, or a name a data directive has";
pub val EDIT_ROW:      str = "directive editing by no extension or one the catalog lacks, to an axis value the set does not switch to, or to a mode value or syntax the set does not have";
pub val STACK_ROW:     str = "push without a pop, or a push, pop, restatement, attribute or raw directive stated twice";
pub val MAPPING_ROW:   str = "mapping symbols with a stem for code and none for data, or the other way";
pub val INSNS_ROW:     str = "raw directive stating no format, or a raw form with no length encoding";
pub val FORMAT_ROW:    str = "instruction format of no name, a row of the catalog, a malformed row or a template that does not write it, or a raw form of a length its one operand and unit do not have";

# the set's assembly source dialect: a comment and a separator, a reading of .align, each data directive once, its
# directives and its mapping symbols
pub fun source(s: *S.Set) err[check.Refusal] {
    val src: *core_source.Source = ?s.source;
    if (src.comment == nil || src.comment[0] == 0 || src.separator == 0 || src.align > core_source.ALIGN_POWER) { ret check.refuse(s, SOURCE, "source", 0); }
    var i: u32 = 0;
    for (i < src.widths.len) {
        val w: *core_source.Width = ?src.widths.at[i];
        if (w.name == nil || w.name[0] != '.' || w.width == 0 || w.width > core_fixup.MAX_WIDTH) { ret check.refuse(s, WIDTH_ROW, "width", i); }
        var j: u32 = 0;
        for (j < i) {
            if (str_equals(src.widths.at[j].name, w.name)) { ret check.refuse_pair(s, WIDTH_ROW, "width", i, j); }
            j = j + 1;
        }
        i = i + 1;
    }
    if (check.empty(src.mapping.code) != check.empty(src.mapping.data)) { ret check.refuse(s, MAPPING_ROW, "mapping", 0); }
    ret directives(s);
}

# whether `r` is a row of the set's catalog, the row its index names
fun catalog_row(s: *S.Set, r: *row.Row) bool {
    ret row.of(s.codec.rows, r);
}

# whether format `f` of the raw directive is unsound, where a sound one is named, its row is no row of the catalog, so
# nothing that indexes the catalog reaches it, the row is sound and every syntax reads its template, and a raw form's
# one operand is an unsigned immediate of its length or a literal number of it, in one unit of that length
fun format_defect(s: *S.Set, f: *core_source.Format) bool {
    if (f.row == nil || check.empty(f.template) || catalog_row(s, f.row)) { ret true; }
    if (core_syntax.piece(f.template, 0).kind != core_syntax.TEXT)        { ret true; }
    val defect: opt[str] = check_row.row_defect(s, f.row);
    if (sel defect.some) { ret true; }
    val r:     *row.Row = f.row;
    var descs: [row.MAX_OPERANDS]*operand.Operand;
    var k:     u32      = 0;
    for (k < r.operands.len) {
        descs[k] = ?r.operands.at[k];
        k        = k + 1;
    }
    k = 0;
    for (k < s.syntaxes.len) {
        val read: opt[str] = check_syntax.template_defect(?s.syntaxes.at[k], f.template, ?descs[0], r.operands.len, 0);
        if (sel read.some) { ret true; }
        k = k + 1;
    }
    if (f.length == 0)                                                                                  { ret false; }
    if (r.operands.len != 1 || r.encoding.len != 1 || r.encoding.at[0].width::u32 != f.length::u32 * 8) { ret true; }
    val sh: *operand.Shape = ?r.operands.at[0].shape;
    # an encoding no i64 holds is a literal number of the form's length
    if (sel sh.literal)    { ret sh.literal.content != operand.NUMBER || sh.literal.width_of != 0 || sh.literal.max != f.length::u32; }
    if (!sel sh.immediate) { ret true; }
    ret sh.immediate.sign != operand.UNSIGNED || sh.immediate.bits::u32 != f.length::u32 * 8;
}

# what the raw directive `at` reads: a format at least, each sound, and a length encoding when a raw form needs one
pub fun insns(s: *S.Set, at: *core_source.Insns, index: u32) err[check.Refusal] {
    if (at.formats.len == 0) { ret check.refuse(s, INSNS_ROW, "directive", index); }
    var raw: bool = false;
    var i:   u32  = 0;
    for (i < at.formats.len) {
        val f: *core_source.Format = ?at.formats.at[i];
        if (format_defect(s, f)) { ret check.refuse(s, FORMAT_ROW, "format", i); }
        raw = raw || f.length > 0;
        i   = i + 1;
    }
    if (raw && at.length == nil) { ret check.refuse(s, INSNS_ROW, "directive", index); }
    ret check.fine();
}

# what an edit reads after its word
fun takes_of(e: core_source.Edit) core_source.Takes {
    if (sel e.restate)   { ret core_source.TAKES_SELECTION; }
    if (sel e.attribute) { ret core_source.TAKES_ATTRIBUTE; }
    if (sel e.raw)       { ret core_source.TAKES_ENCODING; }
    ret core_source.TAKES_NOTHING;
}

# the kind of an edit a dialect states at most once, 0 for one it may state again
fun once_of(e: core_source.Edit) u8 {
    if (sel e.push)      { ret 1; }
    if (sel e.pop)       { ret 2; }
    if (sel e.restate)   { ret 3; }
    if (sel e.attribute) { ret 4; }
    if (sel e.raw)       { ret 5; }
    ret 0;
}

# whether the edit of directive `d` names only what the set has: extensions of its catalog, a value of an axis it
# switches, a value of one of its modes and one of its syntaxes
fun edit_sound(s: *S.Set, d: *core_source.Directive) bool {
    val e: core_source.Edit = d.edit;
    if (sel e.narrow) { ret e.narrow.len > 0 && check_extension.in_catalog(s.extensions, e.narrow); }
    if (sel e.widen)  { ret e.widen.len > 0 && check_extension.in_catalog(s.extensions, e.widen); }
    if (sel e.syntax) { ret e.syntax::u32 < s.syntaxes.len; }
    if (sel e.state) {
        if (e.state.axis >= s.states.len) { ret false; }
        val axis_: u32 = e.state.axis;
        ret s.states.at[axis_].switchable && e.state.value::u32 < s.states.at[axis_].values.len;
    }
    if (sel e.mode) {
        val all: *mode.Modes = ?s.assembly;
        var i:   u32         = 0;
        for (i < all.len) {
            if (all.at[i] == e.mode.mode) {
                var j: u32 = 0;
                for (j < e.mode.mode.values.len) {
                    if (e.mode.mode.values.at[j] == e.mode.value) { ret true; }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        ret false;
    }
    ret true;
}

# the dialect's directives: at most MAX_DIRECTIVES, each spelled with a leading dot and reading what its edit takes, the
# rows of a name told apart by a word each or one row alone, no name a data directive has, every edit naming what the
# set has, a pop exactly with a push, and the stack, restatement, attribute and raw directives each once
pub fun directives(s: *S.Set) err[check.Refusal] {
    val ds: core_source.Directives = s.source.directives;
    if (ds.len > core_source.MAX_DIRECTIVES) { ret check.refuse(s, DIRECTIVE_ROW, "directive", core_source.MAX_DIRECTIVES); }
    var pushes: u32 = 0;
    var pops:   u32 = 0;
    var i:      u32 = 0;
    for (i < ds.len) {
        val d: *core_source.Directive = ?ds.at[i];
        if (check.empty(d.name) || d.name[0] != '.' || d.operands.takes != takes_of(d.edit)) { ret check.refuse(s, DIRECTIVE_ROW, "directive", i); }
        if (!edit_sound(s, d))                                                               { ret check.refuse(s, EDIT_ROW, "directive", i); }
        var w: u32 = 0;
        for (w < s.source.widths.len) {
            if (str_equals(s.source.widths.at[w].name, d.name)) { ret check.refuse(s, NAME_ROWS, "directive", i); }
            w = w + 1;
        }
        var j: u32 = 0;
        for (j < i) {
            val o: *core_source.Directive = ?ds.at[j];
            if (str_equals(o.name, d.name) && (check.empty(o.operands.word) || check.empty(d.operands.word) || str_equals(o.operands.word, d.operands.word))) { ret check.refuse_pair(s, NAME_ROWS, "directive", i, j); }
            if (once_of(d.edit) != 0 && once_of(o.edit) == once_of(d.edit))                                                                                   { ret check.refuse_pair(s, STACK_ROW, "directive", i, j); }
            j = j + 1;
        }
        if (sel d.edit.push) { pushes = pushes + 1; }
        if (sel d.edit.pop)  { pops = pops + 1; }
        if (sel d.edit.raw) {
            val read: err[check.Refusal] = insns(s, ?d.edit.raw, i);
            if (sel read.err) { ret read; }
        }
        i = i + 1;
    }
    if (pushes != pops) { ret check.refuse(s, STACK_ROW, "directive", 0); }
    ret check.fine();
}
