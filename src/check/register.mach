# the check of a set's register file, and what other checks ask of it

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;
use std.types.view.View;

use masc.check.check;
use check_extension: masc.check.extension;
use masc.core.effect;
use masc.core.index;
use masc.core.operand;
use masc.core.quantity;
use masc.core.register;
use S: masc.core.set;
use masc.core.state;

use masc.core.requirement;

#[testing]
use masc.core.dispatch;

pub val UNKNOWN_SLOT:    str = "slot not in the register file";
pub val QUANTITY_DOMAIN: str = "quantity of no unit, or of a domain holding no multiplier";
pub val QUANTITY_BOUND:  str = "quantity bound under an unknown atom, or to a range of no multiplier of its domain";
pub val QUANTITY_ROW:    str = "quantity measured by a row not in the register file";
pub val BINDING:         str = "binding of a slot not in the file, to a quantity not in it, or under an unknown atom";
pub val BINDING_UNIT:    str = "slot bound to quantities of different units, or bound by none";
pub val MIXED_SCALES:    str = "register and its class width scale with different slots";
pub val REGISTER_CLASS:  str = "register's class not in the register file";
pub val REGISTER_NUMBER: str = "register number outside its class's count";
pub val NO_EXTEND:       str = "register states no write extension, or an unknown one";
pub val LONE_EXTEND:     str = "register's write extends into a bank holding nothing past it";
pub val PLACES:          str = "register has no place, or states one place twice";
pub val OVERLAPPING:     str = "register's pieces, or its reach's, start closer than their width, so two of them share storage";
pub val REACH:           str = "register's write extension reaches no storage, or its own";
pub val SHARED_CLASS:    str = "class name given to two classes";
pub val SHARED_ID:       str = "two registers share one identity";
pub val REGISTER_ORDER:  str = "registers not in ascending order of identity";
pub val ALIAS_TARGET:    str = "alias names no register";
pub val ALIAS_ORDER:     str = "register aliases not in ascending order of register";
pub val COLUMN_LENGTH:   str = "debug column length differs from the register count";
pub val SHARED_COLUMN:   str = "two debug columns for one format and flavour, or an unflavoured column before another of its format";
pub val COLUMN_FLAVOUR:  str = "debug column flavoured by an unknown atom";
pub val UNSPELLED_NAME:  str = "register no syntax spells is in the name index";
pub val UNWIND_SP:       str = "architecture's dwarf stack pointer, as mink states it, numbers no view of the register flagged STACK";
pub val UNWIND_RA:       str = "architecture's dwarf return address column, as mink states it, numbers no view of the register flagged LINK, or a register where none is";
pub val UNWIND_COLUMN:   str = "architecture mink states dwarf frames for reads no dwarf column in the set's register file";
pub val COLUMN_ORDER:    str = "debug columns not in ascending order of format";
pub val SHARED_NUMBER:   str = "debug number given to two registers";
pub val FLAG_ROW:        str = "flag set holds a register outside a flags class";
pub val WRITE_EXTEND:    str = "write states an unknown extension of its register's bank";
pub val WRITE_RESULT:    str = "write states a result wider than its register, or what lies above a result it does not narrow";

fun class_name(s: *S.Set, of: u32, row: u32, scratch: *u8) View {
    ret check.spelled(s.codec.registers.classes[row].name);
}

# bearer `row` of the name index: a register, then an alias
fun register_name(s: *S.Set, of: u32, row: u32, scratch: *u8) View {
    val file: *register.File = s.codec.registers;
    if (row < file.register_count) { ret check.spelled(file.registers[row].name); }
    ret check.spelled(file.aliases[row - file.register_count].name);
}

# the numeric index `by` of the register rows' column `numbers`: each entry holds its row's own number, the entries ascend strictly by
# number, so a number given to two registers is two adjacent equal entries, and every numbered register has exactly one
fun numbered(s: *S.Set, by: *index.Numbers, numbers: *u32, rows: u32, table: u32) err[check.Refusal] {
    var expected: u32 = 0;
    var i:        u32 = 0;
    for (i < rows) {
        if (numbers[i] != register.UNNUMBERED) { expected = expected + 1; }
        i = i + 1;
    }
    i = 0;
    for (i < by.len) {
        val e: *index.Number = ?by.at[i];
        if (e.row >= rows || numbers[e.row]::u64 != e.key) { ret check.refuse(s, check.NAME_ENTRY, "column", table); }
        if (i > 0) {
            if (by.at[i - 1].key == e.key) { ret check.refuse_pair(s, SHARED_NUMBER, "column", table, e.row); }
            if (by.at[i - 1].key > e.key)  { ret check.refuse(s, check.NAME_ORDER, "column", table); }
        }
        i = i + 1;
    }
    if (by.len != expected) { ret check.refuse(s, check.NAME_MISSING, "column", table); }
    ret check.fine();
}

# the register rows of the set's file, 0 for a set with none
pub fun register_count(s: *S.Set) u32 {
    if (s.codec.registers == nil) { ret 0; }
    ret s.codec.registers.register_count;
}

# whether `q` names a slot other than `scale`, which is none until a part names one
fun rescales(q: quantity.Scaled, scale: *opt[u8]) bool {
    if (q.per == 0)     { ret false; }
    if (sel scale.some) { ret scale.some != q.scale; }
    @scale = opt[u8].some{q.scale};
    ret false;
}

# whether register `r`'s class width, footprint, places and reach name more than one slot, the one they name in `scale`
fun mixed(file: *register.File, r: *register.Register, scale: *opt[u8]) bool {
    if (rescales(file.classes[r.class].width, scale) || rescales(r.offset, scale) || rescales(r.stride, scale) || rescales(r.count, scale)) { ret true; }
    if (rescales(r.places.count, scale) || rescales(r.places.step, scale))                                                                  { ret true; }
    if (sel r.reach.part) {
        val p: register.Part = r.reach.part;
        if (rescales(p.offset, scale) || rescales(p.stride, scale) || rescales(p.count, scale) || rescales(p.width, scale)) { ret true; }
    }
    ret false;
}

# the quantities and bindings of the file: each quantity of a unit and a domain holding a multiplier, its bounds under
# known atoms and each leaving some multiplier of the domain, its measuring row in the file. each binding of a known
# slot to a known quantity under known atoms, and every slot bound, all its quantities of one unit, as a scaled amount's
# part per multiplier is in that unit's bits
fun quantities(s: *S.Set, file: *register.File) err[check.Refusal] {
    var i: u32 = 0;
    for (i < file.quantities.len) {
        val q: *quantity.Quantity = ?file.quantities.at[i];
        if (q.unit == 0 || !quantity.inhabited(q.domain)) { ret check.refuse(s, QUANTITY_DOMAIN, "quantity", i); }
        var j: u32 = 0;
        for (j < q.bounds.len) {
            val b: *quantity.Bound = ?q.bounds.at[j];
            if (!check_extension.required_known(s, b.when) || !quantity.meets(q.domain, quantity.clip(quantity.span(q.domain), b))) { ret check.refuse(s, QUANTITY_BOUND, "quantity", i); }
            j = j + 1;
        }
        if (q.register != quantity.NO_ROW && q.register >= file.register_count) { ret check.refuse(s, QUANTITY_ROW, "quantity", i); }
        i = i + 1;
    }
    i = 0;
    for (i < file.bindings.len) {
        val b: *quantity.Binding = ?file.bindings.at[i];
        if (b.slot::u32 >= file.slot_count || b.quantity::u32 >= file.quantities.len || !check_extension.required_known(s, b.when)) { ret check.refuse(s, BINDING, "binding", i); }
        i = i + 1;
    }
    var slot: u32 = 0;
    for (slot < file.slot_count) {
        var unit: u32 = 0;
        var k:    u32 = 0;
        for (k < file.bindings.len) {
            val b: *quantity.Binding = ?file.bindings.at[k];
            if (b.slot::u32 == slot) {
                val u: u32 = file.quantities.at[b.quantity].unit;
                if (unit != 0 && u != unit) { ret check.refuse(s, BINDING_UNIT, "slot", slot); }
                unit = u;
            }
            k = k + 1;
        }
        if (unit == 0) { ret check.refuse(s, BINDING_UNIT, "slot", slot); }
        slot = slot + 1;
    }
    ret check.fine();
}

# whether `a` and `b` state the same alternatives over the same atoms, in the same order
fun same(a: requirement.Requirement, b: requirement.Requirement) bool {
    if (a.len != b.len) { ret false; }
    var i: u32 = 0;
    for (i < a.len) {
        if (!same_ids(a.at[i].all, b.at[i].all) || !same_ids(a.at[i].none, b.at[i].none)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_ids(a: requirement.Ids, b: requirement.Ids) bool {
    if (a.len != b.len) { ret false; }
    var i: u32 = 0;
    for (i < a.len) {
        if (a.at[i] != b.at[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the register file of the set checked alone, which a file's own tests ask before its set is registered
pub fun registers(s: *S.Set) err[check.Refusal] {
    val file: *register.File = s.codec.registers;
    if (file == nil) { ret check.fine(); }
    val measured: err[check.Refusal] = quantities(s, file);
    if (sel measured.err) { ret measured; }
    var c: u32 = 0;
    for (c < file.class_count) {
        val width: quantity.Scaled = file.classes[c].width;
        val count: quantity.Scaled = file.classes[c].count;
        if (width.per != 0 && width.scale::u32 >= file.slot_count) { ret check.refuse(s, UNKNOWN_SLOT, "class", c); }
        if (count.per != 0 && count.scale::u32 >= file.slot_count) { ret check.refuse(s, UNKNOWN_SLOT, "class", c); }
        c = c + 1;
    }
    val named: err[check.Refusal] = check.indexed(s, ?file.class_names, file.class_count, file.class_count, class_name, 0, "class", SHARED_CLASS);
    if (sel named.err) { ret named; }
    var unspelled: u32 = 0;
    var u:         u32 = 0;
    for (u < file.register_count) {
        if ((file.registers[u].flags & register.UNSPELLED) != 0) { unspelled = unspelled + 1; }
        u = u + 1;
    }
    u = 0;
    for (u < file.names.len) {
        val bearer: u32 = file.names.at[u].row;
        if (bearer < file.register_count && (file.registers[bearer].flags & register.UNSPELLED) != 0) { ret check.refuse(s, UNSPELLED_NAME, "register name", bearer); }
        u = u + 1;
    }
    val spellings: err[check.Refusal] = check.indexed(s, ?file.names, file.register_count + file.alias_count, file.register_count + file.alias_count - unspelled, register_name, 0, "register name", check.SHARED_NAME);
    if (sel spellings.err) { ret spellings; }
    var i: u32 = 0;
    for (i < file.register_count) {
        val r: *register.Register = ?file.registers[i];
        if (r.class::u32 >= file.class_count)                         { ret check.refuse(s, REGISTER_CLASS, "register", i); }
        if (r.number::u32 >= register.count_most(file, r.class)::u32) { ret check.refuse(s, REGISTER_NUMBER, "register", i); }
        var scale: opt[u8] = opt[u8].none{};
        if (mixed(file, r, ?scale))                               { ret check.refuse(s, MIXED_SCALES, "register", i); }
        if (sel scale.some && scale.some::u32 >= file.slot_count) { ret check.refuse(s, UNKNOWN_SLOT, "register", i); }
        if (!check_extension.required_known(s, r.requires))       { ret check.refuse(s, check.UNKNOWN_EXTENSION, "register", i); }
        if (i > 0) {
            val before: register.Id = register.id_of(?file.registers[i - 1]);
            if (before == register.id_of(r)) { ret check.refuse_pair(s, SHARED_ID, "register", i - 1, i); }
            if (before > register.id_of(r))  { ret check.refuse(s, REGISTER_ORDER, "register", i); }
        }
        i = i + 1;
    }
    # every row is whole by now, so the scan of its bank reads only rows of known classes
    i = 0;
    for (i < file.register_count) {
        val r: *register.Register = ?file.registers[i];
        if (r.extend == register.UNSTATED || r.extend > register.ONES) { ret check.refuse(s, NO_EXTEND, "register", i); }
        if (!register.placed_apart(file, r))                           { ret check.refuse(s, PLACES, "register", i); }
        if (!register.pieces_apart(file, r))                           { ret check.refuse(s, OVERLAPPING, "register", i); }
        if (!register.reach_clear(file, r))                            { ret check.refuse(s, REACH, "register", i); }
        if (r.extend != register.KEEP && !register.contained(file, r)) { ret check.refuse(s, LONE_EXTEND, "register", i); }
        i = i + 1;
    }
    i = 0;
    for (i < file.alias_count) {
        val a: *register.Alias = ?file.aliases[i];
        if (a.register >= file.register_count)                  { ret check.refuse(s, ALIAS_TARGET, "alias", i); }
        if (i > 0 && file.aliases[i - 1].register > a.register) { ret check.refuse(s, ALIAS_ORDER, "alias", i); }
        i = i + 1;
    }
    # a syntax that folds case lowers what it reads, which finds a name only if the name is lower case already
    if (check.folds(s)) {
        i = 0;
        for (i < file.names.len) {
            val spelling: View = register_name(s, 0, file.names.at[i].row, nil);
            if (check.capitalized(spelling)) { ret check.refuse(s, check.CASED_NAME, "register name", file.names.at[i].row); }
            i = i + 1;
        }
    }
    i = 0;
    for (i < file.column_count) {
        val col: *register.Column = ?file.columns[i];
        if (col.len != file.register_count)                  { ret check.refuse(s, COLUMN_LENGTH, "column", i); }
        if (!check_extension.required_known(s, col.flavour)) { ret check.refuse(s, COLUMN_FLAVOUR, "column", i); }
        if (i > 0) {
            val before: *register.Column = ?file.columns[i - 1];
            if (before.format > col.format)                                                                    { ret check.refuse(s, COLUMN_ORDER, "column", i); }
            if (before.format == col.format && (before.flavour.len == 0 || same(before.flavour, col.flavour))) { ret check.refuse_pair(s, SHARED_COLUMN, "column", i - 1, i); }
        }
        val keyed: err[check.Refusal] = numbered(s, ?col.numbered, col.numbers, file.register_count, i);
        if (sel keyed.err) { ret keyed; }
        i = i + 1;
    }
    ret check.fine();
}

# the most bits a register of any of `classes` of `file` holds, at the largest legal multiplier of its width's slot
pub fun widest(file: *register.File, classes: operand.Classes) u64 {
    var most: u64 = 0;
    var i:    u32 = 0;
    for (i < classes.len) {
        val w: u64 = register.width_most(file, classes.at[i]);
        if (w > most) { most = w; }
        i = i + 1;
    }
    ret most;
}

# why `w`, a write of a register of `file` at most `widest` bits wide, is no write a reader can read, none when it is: an
# extension it states is one of KEEP, ZEROES and ONES, and a result it states lies within the register with one of them
# above it, and a write stating no result states nothing above it
pub fun write_defect(file: *register.File, w: *operand.Write, widest: u64) opt[str] {
    if (sel w.extend.some) {
        if (w.extend.some == register.UNSTATED || w.extend.some > register.ONES) { ret opt[str].some{WRITE_EXTEND}; }
    }
    if (w.result == 0) {
        if (w.above != register.UNSTATED) { ret opt[str].some{WRITE_RESULT}; }
        ret opt[str].none{};
    }
    if (w.result::u64 > widest || w.above == register.UNSTATED || w.above > register.ONES) { ret opt[str].some{WRITE_RESULT}; }
    ret opt[str].none{};
}

# whether every class of `r` is in the set's register file
pub fun in_file(s: *S.Set, r: *operand.Register) bool {
    var count: u32 = 0;
    if (s.codec.registers != nil) { count = s.codec.registers.class_count; }
    var i: u32 = 0;
    for (i < r.classes.len) {
        if (r.classes.at[i]::u32 >= count) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether every row `set` holds is in the file and, for flags, in a flags class
pub fun holds(s: *S.Set, set: effect.Set, flags: bool) opt[str] {
    val count: u32 = register_count(s);
    var w:     u32 = 0;
    for (w < set.len) {
        var b: u32 = 0;
        for (b < 64) {
            if (((set.words[w] >> b::u64) & 1) != 0) {
                val at: u32 = w * 64 + b;
                if (at >= count) { ret opt[str].some{check.EFFECT_ROW}; }
                val file: *register.File = s.codec.registers;
                if (flags && file.classes[file.registers[at].class].kind != register.FLAGS) { ret opt[str].some{FLAG_ROW}; }
            }
            b = b + 1;
        }
        w = w + 1;
    }
    ret opt[str].none{};
}

# a quantity of every step of a range is taken, and a domain holding no multiplier, of either kind, is refused (#290)
test quantities__a_domain_of_no_multiplier_is_refused {
    var qs:    [1]quantity.Quantity = [1]quantity.Quantity{quantity.Quantity{name: "windows", unit: 16, domain: quantity.Domain.range{quantity.Steps{least: 2, most: 32, step: 1}}, bounds: quantity.NO_BOUNDS, register: quantity.NO_ROW}};
    val binds: [1]quantity.Binding  = [1]quantity.Binding{quantity.Binding{slot: 0, when: requirement.NO_ALTERNATIVES, quantity: 0}};
    var file:  register.File        = register.File{quantities: quantity.Quantities{at: ?qs[0], len: 1}, bindings: quantity.Bindings{at: ?binds[0], len: 1}, slot_count: 1};
    var codec: dispatch.Codec       = dispatch.Codec{registers: ?file};
    var s:     S.Set                = S.Set{codec: ?codec};
    val fine:  err[check.Refusal]   = quantities(?s, ?file);
    if (sel fine.err) { ret 1; }
    qs[0].domain = quantity.Domain.range{quantity.Steps{least: 33, most: 32, step: 1}};
    val steps: err[check.Refusal] = quantities(?s, ?file);
    if (!(sel steps.err && steps.err.message == QUANTITY_DOMAIN)) { ret 2; }
    qs[0].domain = quantity.Domain.powers{quantity.Range{least: 3, most: 3}};
    val powers: err[check.Refusal] = quantities(?s, ?file);
    if (!(sel powers.err && powers.err.message == QUANTITY_DOMAIN)) { ret 3; }
    ret 0;
}

# whether the register `format` gives `number` under `ctx` is a row flagged `flag`, or a view of one starting at its first
# bit, as i386's esp is of rsp
fun numbers_flagged(file: *register.File, ctx: *state.Context, number: u32, flag: register.Flags) bool {
    val got: opt[register.Id] = state.from_debug_number(file, number, register.DWARF, ctx);
    if (sel got.none) { ret false; }
    val row: opt[*register.Register] = register.row_of(file, got.some);
    if (sel row.none) { ret false; }
    val r: *register.Register = row.some;
    if ((r.flags & flag) != 0)                    { ret true; }
    if (r.offset.fixed != 0 || r.offset.per != 0) { ret false; }
    var i: u32 = 0;
    for (i < file.register_count) {
        val f: *register.Register = ?file.registers[i];
        if ((f.flags & flag) != 0 && f.bank == r.bank && f.offset.fixed == 0 && f.offset.per == 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `file` flags a link register, which a set whose calls leave the return address in memory has none of
fun linked(file: *register.File) bool {
    var i: u32 = 0;
    for (i < file.register_count) {
        if ((file.registers[i].flags & register.LINK) != 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the dwarf column of architecture row `a`, number `at` of the set, read under `ctx`, numbers the set's stack
# pointer and return address register as mink's call frame facts for the architecture state them. a set with no link
# register, whose calls leave the return address in memory, numbers no register at the return address column. an
# architecture where dwarf frames do not apply, or a set with no register file, states nothing to agree on, while one
# stating dwarf frames over a register file with no dwarf column the context reads contradicts itself
pub fun unwinds(s: *S.Set, a: *S.Arch, at: u32, ctx: *state.Context) err[check.Refusal] {
    val file: *register.File = s.codec.registers;
    if (file == nil || sel a.arch.unwind.none) { ret check.fine(); }
    val col: opt[*register.Column] = state.column(file, register.DWARF, ctx);
    if (sel col.none) { ret check.refuse(s, UNWIND_COLUMN, "architecture", at); }
    if (sel a.arch.unwind.some) {
        if (!numbers_flagged(file, ctx, a.arch.unwind.some.sp::u32, register.STACK)) { ret check.refuse(s, UNWIND_SP, "architecture", at); }
        val ra:   u32              = a.arch.unwind.some.ra::u32;
        val held: opt[register.Id] = state.from_debug_number(file, ra, register.DWARF, ctx);
        if (linked(file) && !numbers_flagged(file, ctx, ra, register.LINK)) { ret check.refuse(s, UNWIND_RA, "architecture", at); }
        if (!linked(file) && sel held.some)                                 { ret check.refuse(s, UNWIND_RA, "architecture", at); }
    }
    ret check.fine();
}
