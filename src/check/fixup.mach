# the check of a set's fixup bindings, data, spans and difference pairs

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink;

use masc.check.check;
use core_fixup: masc.core.fixup;
use masc.core.operand;
use masc.core.relax;
use S: masc.core.set;

pub val NO_FIXUP:      str = "binding names no fixup kind";
pub val BOUND_TWICE:   str = "fixup kind bound twice";
pub val BOUND_ORDER:   str = "fixup bindings not in ascending order of kind";
pub val UNKNOWN_RELOC: str = "relocation kind no relocation of a served architecture's format maps";
pub val DATUM:         str = "datum of no basis, a width past the widest, or a basis and width stated twice";
pub val SPAN:          str = "span of an unbound fixup kind or marker, covering fewer than two or more than an expansion holds, or out of ascending order";
pub val PAIR:          str = "difference pair of an unbound fixup kind, a width past the widest, or a width stated twice";

# whether every format each architecture of `s` is written in maps `kind` to a relocation, in `f`'s registry. a format
# with no relocations for the architecture writes no relocated object of it, and is refused where the object is written
fun mapped(s: *S.Set, f: *check.Formats, kind: *mink.reloc.Kind) bool {
    var i: u32 = 0;
    for (i < s.arches.len) {
        val a: *mink.arch.Arch = s.arches.at[i].arch;
        var c: usize           = 0;
        for (c < a.code_count) {
            val rs: res[mink.registry.Relocations, mink.fail.Fail] = mink.registry.relocations(f.registry, a.code[c].format, a);
            if (sel rs.ok) {
                var held: mink.registry.Relocations               = rs.ok;
                val row:  res[*mink.registry.Row, mink.fail.Fail] = mink.registry.relocation_by_kind(?held, kind);
                if (sel row.err) { ret false; }
            }
            c = c + 1;
        }
        i = i + 1;
    }
    ret true;
}

pub fun bindings(s: *S.Set, f: *check.Formats) err[check.Refusal] {
    var i: u32 = 0;
    for (i < s.bindings.len) {
        val b: *core_fixup.Binding = ?s.bindings.at[i];
        if (b.fixup == operand.NO_FIXUP) { ret check.refuse(s, NO_FIXUP, "binding", i); }
        if (!mapped(s, f, b.kind))       { ret check.refuse(s, UNKNOWN_RELOC, "binding", i); }
        if (i > 0) {
            if (s.bindings.at[i - 1].fixup == b.fixup) { ret check.refuse(s, BOUND_TWICE, "binding", i); }
            if (s.bindings.at[i - 1].fixup > b.fixup)  { ret check.refuse(s, BOUND_ORDER, "binding", i); }
        }
        i = i + 1;
    }
    if (!bound(s, s.realign)) { ret check.refuse(s, check.UNBOUND_FIXUP, "realign", 0); }
    i = 0;
    for (i < s.data.len) {
        val d: *core_fixup.Datum = ?s.data.at[i];
        if (d.fixup == operand.NO_FIXUP || !bound(s, d.fixup))                               { ret check.refuse(s, check.UNBOUND_FIXUP, "datum", i); }
        if (d.width == 0 || d.width > core_fixup.MAX_WIDTH || d.basis > core_fixup.RELATIVE) { ret check.refuse(s, DATUM, "datum", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.data.at[j].basis == d.basis && s.data.at[j].width == d.width) { ret check.refuse(s, DATUM, "datum", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < s.spans.len) {
        val sp: *core_fixup.Span = ?s.spans.at[i];
        if (sp.fixup == operand.NO_FIXUP || !bound(s, sp.fixup) || !bound(s, sp.marker)) { ret check.refuse(s, SPAN, "span", i); }
        if (sp.count < 2 || sp.count > relax.MAX_STEPS)                                  { ret check.refuse(s, SPAN, "span", i); }
        if (i > 0 && s.spans.at[i - 1].fixup >= sp.fixup)                                { ret check.refuse(s, SPAN, "span", i); }
        i = i + 1;
    }
    i = 0;
    for (i < s.pairs.len) {
        val q: *core_fixup.Pair = ?s.pairs.at[i];
        if (q.add == operand.NO_FIXUP || q.sub == operand.NO_FIXUP || !bound(s, q.add) || !bound(s, q.sub)) { ret check.refuse(s, PAIR, "pair", i); }
        if (q.width == 0 || q.width > core_fixup.MAX_WIDTH)                                                 { ret check.refuse(s, PAIR, "pair", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.pairs.at[j].width == q.width) { ret check.refuse(s, PAIR, "pair", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret check.fine();
}

# whether `fixup` is NO_FIXUP or bound by the set, by binary search of the bindings the set keeps in ascending order of kind
pub fun bound(s: *S.Set, fixup: operand.FixupKind) bool {
    if (fixup == operand.NO_FIXUP) { ret true; }
    var lo: u32 = 0;
    var hi: u32 = s.bindings.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (s.bindings.at[mid].fixup < fixup) { lo = mid + 1; }
        or                                    { hi = mid; }
    }
    ret lo < s.bindings.len && s.bindings.at[lo].fixup == fixup;
}
