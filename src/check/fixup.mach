# the check of a set's fixup bindings, data, spans, difference pairs and folds

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink;

use masc.check.check;
use core_fixup: masc.core.fixup;
use masc.core.mode;
use masc.core.operand;
use masc.core.relax;
use S: masc.core.set;

pub val NO_FIXUP:      str = "binding names no fixup kind";
pub val BOUND_TWICE:   str = "fixup kind bound twice";
pub val BOUND_ORDER:   str = "fixup bindings not in ascending order of kind";
pub val UNKNOWN_RELOC: str = "relocation kind no relocation of a served architecture's format maps";
pub val FOREIGN_ARCH:  str = "binding names an architecture the set does not serve, or names one twice";
pub val DATUM:         str = "datum of no basis, a width past the widest, or a basis and width stated twice";
pub val SPAN:          str = "span of an unbound fixup kind or marker, covering none, one with no marker or more than an expansion holds, or out of ascending order";
pub val SPAN_WHEN:     str = "span whose marker rides under a mode the set does not declare, or a value its mode does not take";
pub val PAIR:          str = "difference pair of an unbound fixup kind, a width past the widest, or a width stated twice";
pub val FOLD:          str = "fold of an unbound or not plainly pc-relative fixup kind, no value, no anchor, a partner with no self fold in the set, or out of ascending order";

# whether every format each architecture of `s` that `b` is bound on is written in maps its kind to a relocation, in
# `f`'s registry. a format with no relocations for the architecture writes no relocated object of it, and is refused
# where the object is written
fun mapped(s: *S.Set, f: *check.Formats, b: *core_fixup.Binding) bool {
    val kind: *mink.reloc.Kind = b.kind;
    var i:    u32              = 0;
    for (i < s.arches.len) {
        val a: *mink.arch.Arch = s.arches.at[i].arch;
        if (!core_fixup.binds(b, a)) {
            i = i + 1;
            cnt;
        }
        var c: usize = 0;
        for (c < a.code_count) {
            val rs: res[mink.registry.Relocations, mink.fail.Fail] = mink.registry.relocations(f.registry, a.code[c].format, a);
            if (sel rs.ok) {
                var held: mink.registry.Relocations               = rs.ok;
                val row:  res[*mink.registry.Row, mink.fail.Fail] = mink.registry.relocation_by_kind(?held, kind);
                if (sel row.err) { ret false; }
            }
            c = c + 1;
        }
        i = i + 1;
    }
    ret true;
}

# whether every architecture `b` names is one the set serves, each named once
fun served(s: *S.Set, b: *core_fixup.Binding) bool {
    var i: u32 = 0;
    for (i < b.arches.len) {
        val row: opt[*S.Arch] = S.arch_of(s, b.arches.at[i]);
        if (sel row.none) { ret false; }
        var j: u32 = 0;
        for (j < i) {
            if (b.arches.at[j] == b.arches.at[i]) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

pub fun bindings(s: *S.Set, f: *check.Formats) err[check.Refusal] {
    var i: u32 = 0;
    for (i < s.bindings.len) {
        val b: *core_fixup.Binding = ?s.bindings.at[i];
        if (b.fixup == operand.NO_FIXUP) { ret check.refuse(s, NO_FIXUP, "binding", i); }
        if (!served(s, b))               { ret check.refuse(s, FOREIGN_ARCH, "binding", i); }
        if (!mapped(s, f, b))            { ret check.refuse(s, UNKNOWN_RELOC, "binding", i); }
        if (i > 0) {
            if (s.bindings.at[i - 1].fixup == b.fixup) { ret check.refuse(s, BOUND_TWICE, "binding", i); }
            if (s.bindings.at[i - 1].fixup > b.fixup)  { ret check.refuse(s, BOUND_ORDER, "binding", i); }
        }
        i = i + 1;
    }
    if (!bound(s, s.realign)) { ret check.refuse(s, check.UNBOUND_FIXUP, "realign", 0); }
    i = 0;
    for (i < s.data.len) {
        val d: *core_fixup.Datum = ?s.data.at[i];
        if (d.fixup == operand.NO_FIXUP || !bound(s, d.fixup))                               { ret check.refuse(s, check.UNBOUND_FIXUP, "datum", i); }
        if (d.width == 0 || d.width > core_fixup.MAX_WIDTH || d.basis > core_fixup.RELATIVE) { ret check.refuse(s, DATUM, "datum", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.data.at[j].basis == d.basis && s.data.at[j].width == d.width) { ret check.refuse(s, DATUM, "datum", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < s.spans.len) {
        val sp: *core_fixup.Span = ?s.spans.at[i];
        if (sp.fixup == operand.NO_FIXUP || !bound(s, sp.fixup) || !bound(s, sp.marker)) { ret check.refuse(s, SPAN, "span", i); }
        if (sp.count == 0 || sp.count > relax.MAX_STEPS)                                 { ret check.refuse(s, SPAN, "span", i); }
        if (sp.count == 1 && sp.marker == operand.NO_FIXUP)                              { ret check.refuse(s, SPAN, "span", i); }
        if (!declared(s, sp.when))                                                       { ret check.refuse(s, SPAN_WHEN, "span", i); }
        if (i > 0 && s.spans.at[i - 1].fixup >= sp.fixup)                                { ret check.refuse(s, SPAN, "span", i); }
        i = i + 1;
    }
    i = 0;
    for (i < s.pairs.len) {
        val q: *core_fixup.Pair = ?s.pairs.at[i];
        if (q.add == operand.NO_FIXUP || q.sub == operand.NO_FIXUP || !bound(s, q.add) || !bound(s, q.sub)) { ret check.refuse(s, PAIR, "pair", i); }
        if (q.width == 0 || q.width > core_fixup.MAX_WIDTH)                                                 { ret check.refuse(s, PAIR, "pair", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.pairs.at[j].width == q.width) { ret check.refuse(s, PAIR, "pair", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    var selves: u32 = 0;
    for (i < s.folds.len) {
        if (s.folds.at[i].measure == core_fixup.SELF) { selves = selves + 1; }
        i = i + 1;
    }
    i = 0;
    for (i < s.folds.len) {
        val fo: *core_fixup.Fold = ?s.folds.at[i];
        if (fo.fixup == operand.NO_FIXUP || !plain_pc(s, fo.fixup))                                  { ret check.refuse(s, FOLD, "fold", i); }
        if (fo.value == nil || fo.measure > core_fixup.PARTNER)                                      { ret check.refuse(s, FOLD, "fold", i); }
        if (fo.measure == core_fixup.SELF && fo.anchor != operand.START && fo.anchor != operand.END) { ret check.refuse(s, FOLD, "fold", i); }
        if (fo.measure == core_fixup.PARTNER && selves == 0)                                         { ret check.refuse(s, FOLD, "fold", i); }
        if (i > 0 && s.folds.at[i - 1].fixup >= fo.fixup)                                            { ret check.refuse(s, FOLD, "fold", i); }
        i = i + 1;
    }
    ret check.fine();
}

# whether every setting of `when` is of a mode the set declares, at a value the mode takes
fun declared(s: *S.Set, when: mode.Settings) bool {
    var i: u32 = 0;
    for (i < when.len) {
        val st:    *mode.Setting = ?when.at[i];
        var found: bool          = false;
        var j:     u32           = 0;
        for (j < s.assembly.len) {
            if (s.assembly.at[j] == st.mode) { found = true; }
            j = j + 1;
        }
        if (!found || !mode.takes(st.mode, st.value)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `fixup` is bound by the set to a relocation kind that is plainly pc-relative: no got entry, page or tls
# offset, which only the link places
fun plain_pc(s: *S.Set, fixup: operand.FixupKind) bool {
    val at: opt[u32] = binding_at(s, fixup);
    if (sel at.none) { ret false; }
    val kind: *mink.reloc.Kind = s.bindings.at[at.some].kind;
    ret mink.reloc.has(kind, mink.reloc.PC) && (kind.caps & (mink.reloc.GOT | mink.reloc.PAGE | mink.reloc.TLS)) == 0;
}

# where the set binds `fixup` among its bindings, by binary search of the bindings it keeps in ascending order of kind
fun binding_at(s: *S.Set, fixup: operand.FixupKind) opt[u32] {
    var lo: u32 = 0;
    var hi: u32 = s.bindings.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (s.bindings.at[mid].fixup < fixup) { lo = mid + 1; }
        or                                    { hi = mid; }
    }
    if (lo < s.bindings.len && s.bindings.at[lo].fixup == fixup) { ret opt[u32].some{lo}; }
    ret opt[u32].none{};
}

# whether `fixup` is NO_FIXUP or bound by the set
pub fun bound(s: *S.Set, fixup: operand.FixupKind) bool {
    if (fixup == operand.NO_FIXUP) { ret true; }
    val at: opt[u32] = binding_at(s, fixup);
    ret sel at.some;
}
