# the check of how a set derives the trait axes of its objects

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink;

use masc.check.check;
use check_extension: masc.check.extension;
use S:               masc.core.set;
use masc.core.trait;

pub val TRAIT_ROW:    str = "trait row of an axis no architecture of the set has, or of a class no set derives, or twice, a selection's flag by no requirement or one the catalog lacks, a spelled selection of no text, or a default the axis lacks or with no reference";
pub val NO_ENCODING:  str = "trait axis whose encoding the format registry cannot answer";
pub val UNOWNED_AXIS: str = "trait axis of a class the set derives that a format requires and no row of the set derives";

# whether an architecture the set serves has the axis `x`
fun served_axis(s: *S.Set, x: *mink.trait.Axis) bool {
    var i: u32 = 0;
    for (i < s.arches.len) {
        if (mink.arch.has_axis(s.arches.at[i].arch, x)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `x` is of an owner class a set derives, never the caller's abi row's or the architecture row's
fun derivable(x: *mink.trait.Axis) bool {
    ret !sel x.owner.convention && !sel x.owner.fixed;
}

# whether row `row` derives its axis by a value it can hold
fun derives(s: *S.Set, row: *trait.Owned) bool {
    val owner: trait.Owner = row.owner;
    if (sel owner.selection) {
        val by: trait.Selected = owner.selection;
        if (sel by.flag) { ret sel row.axis.value.flag && by.flag.len > 0 && check_extension.required_known(s, by.flag); }
        ret sel row.axis.value.text;
    }
    if (sel owner.derived) { ret sel row.axis.value.flag && owner.derived.len > 0 && check_extension.required_known(s, owner.derived); }
    if (sel owner.source)  { ret mink.trait.fits(row.axis, owner.source.setting) && !check.empty(owner.source.cites); }
    ret false;
}

# whether some format `a` is written in requires `x`, read from the rows of every format that encodes traits for it. a
# format that encodes none is refused at the builder's construction, so no object of it is checked here
fun required(f: *check.Formats, a: *mink.arch.Arch, x: *mink.trait.Axis) res[bool, mink.fail.Fail] {
    var rows:  mink.table.Table[mink.contract.Encoded] = mink.table.make[mink.contract.Encoded](f.alloc);
    var needs: bool                                    = false;
    var c:     usize                                   = 0;
    for (!needs && c < a.code_count) {
        mink.table.clear[mink.contract.Encoded](?rows);
        val listed: err[mink.fail.Fail] = trait.encodes(f.registry, a.code[c].format, a, ?rows);
        needs = !sel listed.err && trait.required(?rows, x);
        c     = c + 1;
    }
    val released: err[mink.fail.Fail] = mink.table.release[mink.contract.Encoded](?rows);
    if (sel released.err) { ret res[bool, mink.fail.Fail].err{released.err}; }
    ret res[bool, mink.fail.Fail].ok{needs};
}

# each trait row of an axis an architecture of the set has, of a class a set derives, once, by a value it can hold, and
# every axis of such a class a format of each architecture requires derived by a row. the index of an unowned axis is
# its place among its architecture's axes
pub fun traits(s: *S.Set, f: *check.Formats) err[check.Refusal] {
    var i: u32 = 0;
    for (i < s.traits.len) {
        val row: *trait.Owned = ?s.traits.at[i];
        if (!served_axis(s, row.axis) || !derivable(row.axis) || !derives(s, row)) { ret check.refuse(s, TRAIT_ROW, "trait", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.traits.at[j].axis == row.axis) { ret check.refuse_pair(s, TRAIT_ROW, "trait", i, j); }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < s.arches.len) {
        val a: *mink.arch.Arch = s.arches.at[i].arch;
        var k: usize           = 0;
        for (k < a.axis_count) {
            val x:     *mink.trait.Axis  = a.axes[k];
            val owner: opt[*trait.Owned] = S.owner_of(s, x);
            if (derivable(x) && sel owner.none) {
                val needs: res[bool, mink.fail.Fail] = required(f, a, x);
                if (sel needs.err) { ret check.refuse(s, NO_ENCODING, "trait axis", k::u32); }
                if (needs.ok)      { ret check.refuse(s, UNOWNED_AXIS, "trait axis", k::u32); }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret check.fine();
}
