# the check of how a set derives the trait axes of its objects

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.table;
use mink.catalog.arch;
use mink_format: mink.catalog.format;
use mink_trait:  mink.catalog.trait;
use mink.format.contract;
use mink.format.registry;

use masc.check.check;
use check_extension: masc.check.extension;
use masc.core.requirement;
use S: masc.core.set;
use masc.core.stating;
use masc.core.trait;

pub val TRAIT_ROW:     str = "trait row of an axis no architecture of the set has, or of another owner class than mink's of the axis, or twice, a selection's flag by no requirement or one the catalog lacks, a spelled selection of no text, a default the axis lacks, or a default or an unwritten axis with no reason";
pub val CHOSEN:        str = "chosen trait row of no choice axis, of no atoms, of an atom the catalog lacks, or of a value a format encoding the axis maps to no choice";
pub val STATING:       str = "stating row of no row, of an operand past its row's, twice on one operand, of a trait axis no architecture of the set has or not of mink's source class, or of a fact of no format an architecture of the set is written in";
pub val NO_ENCODING:   str = "trait axis whose encoding the format registry cannot answer";
pub val UNOWNED_AXIS:  str = "trait axis of a class the set derives that a format requires and no row of the set derives or states";
pub val UNSTATED_AXIS: str = "trait axis a format requires that the set's row leaves unstated";

# whether an architecture the set serves has the axis `x`
fun served_axis(s: *S.Set, x: *mink_trait.Axis) bool {
    var i: u32 = 0;
    for (i < s.arches.len) {
        if (arch.has_axis(s.arches.at[i].arch, x)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `x` is of an owner class a set derives, never the caller's abi row's or the architecture row's
fun derivable(x: *mink_trait.Axis) bool {
    ret !sel x.owner.convention && !sel x.owner.fixed;
}

# whether row `row` derives its axis by a value it can hold
fun derives(s: *S.Set, row: *trait.Owned) bool {
    val owner: trait.Owner = row.owner;
    if (sel owner.selection) {
        val by: trait.Selected = owner.selection;
        if (sel by.flag) { ret sel row.axis.value.flag && by.flag.len > 0 && check_extension.required_known(s, by.flag); }
        ret sel row.axis.value.text;
    }
    if (sel owner.derived)   { ret sel row.axis.value.flag && owner.derived.len > 0 && check_extension.required_known(s, owner.derived); }
    if (sel owner.source)    { ret mink_trait.fits(row.axis, owner.source.setting) && !check.empty(owner.source.cites); }
    if (sel owner.chosen)    { ret true; }
    if (sel owner.unwritten) { ret !check.empty(owner.unwritten); }
    ret false;
}

# whether each atom of `atoms` is a row of the set's catalog whose value every format an architecture of the set with
# `x` is written in maps to a choice of `x`, where that format encodes `x`
fun chooses(s: *S.Set, f: *check.Formats, x: *mink_trait.Axis, atoms: requirement.Atoms) res[bool, fail.Fail] {
    if (!sel x.value.choice || atoms.len == 0) { ret res[bool, fail.Fail].ok{false}; }
    var k: u32 = 0;
    for (k < atoms.len) {
        if (atoms.at[k].id >= s.extensions.count) { ret res[bool, fail.Fail].ok{false}; }
        k = k + 1;
    }
    var rows: table.Table[contract.Encoded] = table.make[contract.Encoded](f.alloc);
    var maps: bool                          = true;
    var i:    u32                           = 0;
    for (maps && i < s.arches.len) {
        val a: *arch.Arch = s.arches.at[i].arch;
        var c: usize      = 0;
        for (maps && arch.has_axis(a, x) && c < a.code_count) {
            table.clear[contract.Encoded](?rows);
            val listed:  err[fail.Fail] = trait.encodes(f.registry, a.code[c].format, a, ?rows);
            var encodes: bool           = false;
            var e:       usize          = 0;
            for (!sel listed.err && e < table.count[contract.Encoded](?rows)) {
                if (table.at[contract.Encoded](?rows, table.nth[contract.Encoded](e)).axis == x) { encodes = true; }
                e = e + 1;
            }
            k = 0;
            for (maps && encodes && k < atoms.len) {
                val got: res[mink_trait.Setting, fail.Fail] = registry.setting(f.registry, a.code[c].format, x, contract.Written.number{atoms.at[k].value});
                if (sel got.err) { maps = false; }
                or (sel got.ok) {
                    val v: mink_trait.Setting = got.ok;
                    maps = sel v.choice;
                }
                k = k + 1;
            }
            c = c + 1;
        }
        i = i + 1;
    }
    val released: err[fail.Fail] = table.release[contract.Encoded](?rows);
    if (sel released.err) { ret res[bool, fail.Fail].err{released.err}; }
    ret res[bool, fail.Fail].ok{maps};
}

# whether an architecture the set serves is written in `format`
fun written_in(s: *S.Set, format: *mink_format.Format) bool {
    var i: u32 = 0;
    for (i < s.arches.len) {
        val a: *arch.Arch = s.arches.at[i].arch;
        var c: usize      = 0;
        for (c < a.code_count) {
            if (a.code[c].format == format) { ret true; }
            c = c + 1;
        }
        i = i + 1;
    }
    ret false;
}

# each stating row of a row, on an operand the row has, once per operand, stating a source axis an architecture of the
# set has or a fact of a format one is written in
pub fun statings(s: *S.Set) err[check.Refusal] {
    var i: u32 = 0;
    for (i < s.statings.len) {
        val st: *stating.Stating = ?s.statings.at[i];
        if (st.row == nil)                          { ret check.refuse(s, STATING, "stating", i); }
        if (st.operand::u32 >= st.row.operands.len) { ret check.refuse(s, STATING, "stating", i); }
        val what: stating.Stated = st.stated;
        if (sel what.trait) {
            if (!served_axis(s, what.trait) || !sel what.trait.owner.source) { ret check.refuse(s, STATING, "stating", i); }
        }
        or (sel what.fact) {
            if (!written_in(s, what.fact.format)) { ret check.refuse(s, STATING, "stating", i); }
        }
        var j: u32 = 0;
        for (j < i) {
            if (s.statings.at[j].row == st.row && s.statings.at[j].operand == st.operand) { ret check.refuse_pair(s, STATING, "stating", i, j); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret check.fine();
}

# whether some format `a` is written in requires `x`, read from the rows of every format that encodes traits for it. a
# format that encodes none is refused at the builder's construction, so no object of it is checked here
fun required(f: *check.Formats, a: *arch.Arch, x: *mink_trait.Axis) res[bool, fail.Fail] {
    var rows:  table.Table[contract.Encoded] = table.make[contract.Encoded](f.alloc);
    var needs: bool                          = false;
    var c:     usize                         = 0;
    for (!needs && c < a.code_count) {
        table.clear[contract.Encoded](?rows);
        val listed: err[fail.Fail] = trait.encodes(f.registry, a.code[c].format, a, ?rows);
        needs = !sel listed.err && trait.required(?rows, x);
        c     = c + 1;
    }
    val released: err[fail.Fail] = table.release[contract.Encoded](?rows);
    if (sel released.err) { ret res[bool, fail.Fail].err{released.err}; }
    ret res[bool, fail.Fail].ok{needs};
}

# each trait row of an axis an architecture of the set has, of the axis's owner class in mink's catalog, once, by a value it can hold, and
# every axis of such a class a format of each architecture requires derived by a row or stated by a stating row. the index of an unowned axis is
# its place among its architecture's axes
pub fun traits(s: *S.Set, f: *check.Formats) err[check.Refusal] {
    var i: u32 = 0;
    for (i < s.traits.len) {
        val row: *trait.Owned = ?s.traits.at[i];
        if (!served_axis(s, row.axis) || !trait.of_class(row.owner, row.axis.owner) || !derives(s, row)) { ret check.refuse(s, TRAIT_ROW, "trait", i); }
        val owner: trait.Owner = row.owner;
        if (sel owner.chosen) {
            val chose: res[bool, fail.Fail] = chooses(s, f, row.axis, owner.chosen);
            if (sel chose.err) { ret check.refuse(s, CHOSEN, "trait", i); }
            if (!chose.ok)     { ret check.refuse(s, CHOSEN, "trait", i); }
        }
        var j: u32 = 0;
        for (j < i) {
            if (s.traits.at[j].axis == row.axis) { ret check.refuse_pair(s, TRAIT_ROW, "trait", i, j); }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < s.arches.len) {
        val a: *arch.Arch = s.arches.at[i].arch;
        var k: usize      = 0;
        for (k < a.axis_count) {
            val x:         *mink_trait.Axis  = a.axes[k];
            val owner:     opt[*trait.Owned] = S.owner_of(s, x);
            var unwritten: bool              = false;
            if (sel owner.some) { unwritten = sel owner.some.owner.unwritten; }
            if (derivable(x) && (sel owner.none || unwritten) && !stating.states_axis(s.statings, x)) {
                val needs: res[bool, fail.Fail] = required(f, a, x);
                if (sel needs.err)         { ret check.refuse(s, NO_ENCODING, "trait axis", k::u32); }
                if (needs.ok && unwritten) { ret check.refuse(s, UNSTATED_AXIS, "trait axis", k::u32); }
                if (needs.ok)              { ret check.refuse(s, UNOWNED_AXIS, "trait axis", k::u32); }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret check.fine();
}
