# the check of who states each trait axis of a set's objects, and of its option spellings

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink;

use masc.check.check;
use check_extension: masc.check.extension;
use S:               masc.core.set;
use masc.core.trait;

pub val TRAIT_ROW:    str = "trait owner of an axis no architecture of the set has, owned twice, a selection's of a flag by no requirement or one the catalog lacks, or a fixed value the axis lacks or with no reference";
pub val UNOWNED_AXIS: str = "trait axis a format encodes that no owner of the set states";
pub val NO_ENCODING:  str = "trait axis whose encoding the format registry cannot answer";

# whether an architecture the set serves has the axis `x`
fun served_axis(s: *S.Set, x: *mink.trait.Axis) bool {
    var i: u32 = 0;
    for (i < s.arches.len) {
        if (mink.arch.has_axis(s.arches.at[i].arch, x)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# each trait owner of an axis an architecture of the set has, once, by a value it can state, and every axis a format
# of each architecture encodes owned. the index of an unowned axis is its place among its architecture's axes
pub fun traits(s: *S.Set, f: *check.Formats) err[check.Refusal] {
    var i: u32 = 0;
    for (i < s.traits.len) {
        val row: *trait.Owned = ?s.traits.at[i];
        if (!served_axis(s, row.axis)) { ret check.refuse(s, TRAIT_ROW, "trait", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.traits.at[j].axis == row.axis) { ret check.refuse_pair(s, TRAIT_ROW, "trait", i, j); }
            j = j + 1;
        }
        val owner: trait.Owner = row.owner;
        if (sel owner.selection) {
            val flag: bool = sel row.axis.value.flag;
            if (!flag || owner.selection.len == 0 || !check_extension.required_known(s, owner.selection)) { ret check.refuse(s, TRAIT_ROW, "trait", i); }
        }
        or (sel owner.derived) {
            val flag: bool = sel row.axis.value.flag;
            if (!flag || owner.derived.len == 0 || !check_extension.required_known(s, owner.derived)) { ret check.refuse(s, TRAIT_ROW, "trait", i); }
        }
        or (sel owner.fixed) {
            if (!mink.trait.fits(row.axis, owner.fixed.setting) || check.empty(owner.fixed.cites)) { ret check.refuse(s, TRAIT_ROW, "trait", i); }
        }
        i = i + 1;
    }
    i = 0;
    for (i < s.arches.len) {
        val a: *mink.arch.Arch = s.arches.at[i].arch;
        var k: usize           = 0;
        for (k < a.axis_count) {
            val x:     *mink.trait.Axis  = a.axes[k];
            val owner: opt[*trait.Owned] = S.owner_of(s, x);
            if (sel owner.none) {
                val encoded: res[bool, mink.fail.Fail] = trait.encoded(f.registry, f.alloc, a, x);
                if (sel encoded.err) { ret check.refuse(s, NO_ENCODING, "trait axis", k::u32); }
                if (encoded.ok)      { ret check.refuse(s, UNOWNED_AXIS, "trait axis", k::u32); }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret check.fine();
}
