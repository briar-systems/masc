# a view a source dialect scopes for the statements after it: a selection narrowed from another, its context and its
# view of the register file
#
# a narrowing is a selection less the extensions the dialect's narrowings in
# force remove, each with every member that implies it, so the narrowed
# selection stays closed. the selection narrowed is the object's, or one the
# source restates, which may hold what the object's does not, as risc-v's
# `.option arch, +zbb` widens the selection for a stretch of code. the context
# keeps the state values of the one it is made from, but for those the
# selection's spelling states.
# it is held on the heap: its context points at its selection and its view,
# and the builder and the disassembler keep the context by pointer for as long
# as what they write under it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;

use A: std.allocator;

use masc.core.extension;
use masc.core.register;
use masc.core.source;
use masc.core.state;

# a narrowed selection, its view and its context
pub rec Narrowed {
    selection: extension.Selection;
    available: register.Available;
    context:   state.Context;
}

# the bit of narrowing `i` in a mask of the narrowings in force
pub fun bit(i: u32) u64 {
    ret 1::u64 << i::u64;
}

# whether narrowing `n` removes anything `s` holds
pub fun narrows(s: *extension.Selection, n: *source.Narrowing) bool {
    var i: u32 = 0;
    for (i < n.removes.len) {
        if (extension.has(s, n.removes.at[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the context `base` narrowed by each narrowing of `all` that `active` marks, which `release` gives back
pub fun make(a: *A.Allocator, base: *state.Context, all: source.Narrowings, active: u64) res[*Narrowed, state.Opened] {
    ret from(a, base.view.file, base.selection, base, all, active);
}

# the view of `file` under `selection` at the state of `at`, but for the values the selection's spelling states, narrowed
# by each narrowing of `all` that `active` marks, as a selection a source restates is narrowed, which `release` gives
# back
pub fun from(a: *A.Allocator, file: *register.File, selection: *extension.Selection, at: *state.Context, all: source.Narrowings, active: u64) res[*Narrowed, state.Opened] {
    val kept: res[*Narrowed, A.Error] = A.allocate[Narrowed](a, 1);
    if (sel kept.err) { ret res[*Narrowed, state.Opened].err{state.Opened.view{register.Error.memory{kept.err}}}; }
    val n:      *Narrowed                         = kept.ok;
    val copied: res[extension.Selection, A.Error] = extension.copy(a, selection);
    if (sel copied.err) {
        A.deallocate[Narrowed](a, n, 1);
        ret res[*Narrowed, state.Opened].err{state.Opened.view{register.Error.memory{copied.err}}};
    }
    n.selection = copied.ok;
    var i: u32 = 0;
    for (i < all.len) {
        if ((active & bit(i)) != 0) {
            val removes: *source.Narrowing = ?all.at[i];
            var k:       u32               = 0;
            for (k < removes.removes.len) {
                extension.without(?n.selection, removes.removes.at[k]);
                k = k + 1;
            }
        }
        i = i + 1;
    }
    val made: res[state.Context, state.Error] = state.make(?n.selection, at.axes, at.values);
    if (sel made.err) {
        extension.release(?n.selection);
        A.deallocate[Narrowed](a, n, 1);
        ret res[*Narrowed, state.Opened].err{state.Opened.state{made.err}};
    }
    n.context        = made.ok;
    n.context.stream = at.stream;
    val viewed: res[register.Available, register.Error] = state.select(a, file, ?n.context);
    if (sel viewed.err) {
        extension.release(?n.selection);
        A.deallocate[Narrowed](a, n, 1);
        ret res[*Narrowed, state.Opened].err{state.Opened.view{viewed.err}};
    }
    n.available    = viewed.ok;
    n.context.view = ?n.available;
    ret res[*Narrowed, state.Opened].ok{n};
}

# everything `n` holds given back
pub fun release(a: *A.Allocator, n: *Narrowed) {
    register.release(?n.available);
    extension.release(?n.selection);
    A.deallocate[Narrowed](a, n, 1);
}
