# a view a source dialect scopes for the statements after it: a selection narrowed from another, its context and its
# view of the register file
#
# a narrowing is a selection less the extensions the dialect's narrowing
# directives in force remove, each with every member that implies it, so the
# narrowed selection stays closed. the selection narrowed is the object's, or one the
# source restates, which may hold what the object's does not, as risc-v's
# `.option arch, +zbb` widens the selection for a stretch of code. the context
# holds the state values it is made at, as a dialect's state directives set
# them, but for those the selection's spelling states.
# it is held on the heap: its context points at its selection and its view,
# and the builder and the disassembler keep the context by pointer for as long
# as what they write under it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;

use A: std.allocator;

use masc.core.extension;
use masc.core.register;
use masc.core.requirement;
use masc.core.source;
use masc.core.state;

# a narrowed selection, its view and its context
pub rec Narrowed {
    selection: extension.Selection;
    available: register.Available;
    context:   state.Context;
}

# whether removing `ids` takes anything from `s`
pub fun narrows(s: *extension.Selection, ids: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (extension.has(s, ids.at[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether narrowing directive `i` of `all` takes from selection `s`, which holds every extension of `ids`, one of them,
# so a widening of `ids` lifts it, as `.option rvc` lifts `.option norvc`
pub fun lifts(a: *A.Allocator, all: source.Directives, i: u32, s: *extension.Selection, ids: requirement.Ids) bool {
    val e: source.Edit = all.at[i].edit;
    if (!sel e.narrow) { ret false; }
    var k: u32 = 0;
    for (k < ids.len) {
        if (!extension.has(s, ids.at[k])) { ret false; }
        k = k + 1;
    }
    val copied: res[extension.Selection, A.Error] = extension.copy(a, s);
    if (sel copied.err) { ret false; }
    var c: extension.Selection = copied.ok;
    k = 0;
    for (k < e.narrow.len) {
        extension.without(?c, e.narrow.at[k]);
        k = k + 1;
    }
    var takes: bool = false;
    k = 0;
    for (k < ids.len) {
        takes = takes || !extension.has(?c, ids.at[k]);
        k     = k + 1;
    }
    extension.release(?c);
    ret takes;
}

# the narrowings of `all` that `active` marks by their index, over `s`, which holds every extension of `ids`, less each
# one that would take one of them away, as a widening of `ids` lifts them
pub fun lifted(a: *A.Allocator, all: source.Directives, active: u64, s: *extension.Selection, ids: requirement.Ids) u64 {
    var left: u64 = active;
    var i:    u32 = 0;
    for (i < all.len) {
        if ((active & source.bit(i)) != 0 && lifts(a, all, i, s, ids)) { left = left & ~source.bit(i); }
        i = i + 1;
    }
    ret left;
}

# the context `base` narrowed by each narrowing directive of `all` that `active` marks by its index, which `release`
# gives back
pub fun make(a: *A.Allocator, base: *state.Context, all: source.Directives, active: u64) res[*Narrowed, state.Opened] {
    ret from(a, base.view.file, base.selection, base, base.values, all, active);
}

# the view of `file` under `selection` at state `values` over the axes and stream of `at`, but for the values the
# selection's spelling states, narrowed by each narrowing directive of `all` that `active` marks by its index, as a
# selection a source restates is narrowed, which `release` gives back
pub fun from(a: *A.Allocator, file: *register.File, selection: *extension.Selection, at: *state.Context, values: state.Settings, all: source.Directives, active: u64) res[*Narrowed, state.Opened] {
    val kept: res[*Narrowed, A.Error] = A.allocate[Narrowed](a, 1);
    if (sel kept.err) { ret res[*Narrowed, state.Opened].err{state.Opened.view{register.Error.memory{kept.err}}}; }
    val n:      *Narrowed                         = kept.ok;
    val copied: res[extension.Selection, A.Error] = extension.copy(a, selection);
    if (sel copied.err) {
        A.deallocate[Narrowed](a, n, 1);
        ret res[*Narrowed, state.Opened].err{state.Opened.view{register.Error.memory{copied.err}}};
    }
    n.selection = copied.ok;
    var i: u32 = 0;
    for (i < all.len) {
        val e: source.Edit = all.at[i].edit;
        if (sel e.narrow) {
            var k: u32 = 0;
            for ((active & source.bit(i)) != 0 && k < e.narrow.len) {
                extension.without(?n.selection, e.narrow.at[k]);
                k = k + 1;
            }
        }
        i = i + 1;
    }
    val made: res[state.Context, state.Error] = state.make(?n.selection, at.axes, values);
    if (sel made.err) {
        extension.release(?n.selection);
        A.deallocate[Narrowed](a, n, 1);
        ret res[*Narrowed, state.Opened].err{state.Opened.state{made.err}};
    }
    n.context        = made.ok;
    n.context.stream = at.stream;
    val viewed: res[register.Available, register.Error] = state.select(a, file, ?n.context);
    if (sel viewed.err) {
        extension.release(?n.selection);
        A.deallocate[Narrowed](a, n, 1);
        ret res[*Narrowed, state.Opened].err{state.Opened.view{viewed.err}};
    }
    n.available    = viewed.ok;
    n.context.view = ?n.available;
    ret res[*Narrowed, state.Opened].ok{n};
}

# everything `n` holds given back
pub fun release(a: *A.Allocator, n: *Narrowed) {
    register.release(?n.available);
    extension.release(?n.selection);
    A.deallocate[Narrowed](a, n, 1);
}
