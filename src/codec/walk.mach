# the encode and decode walks over a row's fields, and decode dispatch
#
# encoding admits each operand value into its encoded parts, refusing what
# the row does not admit, then walks the fields in order and lets each kind
# write its piece. decoding walks the same fields reading, then turns the
# deposited parts back into values. both read one description, so they agree
# by construction, and both refuse the forms a row's register constraints
# reserve. a refused encode leaves the stream and the fixups as they
# were, so a builder can try a mnemonic's rows in preference order.
# decode finds its row through the codec's dispatch.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.allocator.testing;
use std.collections.bitset;
use std.collections.vector;
use std.math.bits;

use masc.core.constraint;
use masc.core.ct;
use masc.core.diagnostic;
use masc.core.dispatch;
use masc.core.effect;
use masc.core.field;
use masc.core.form;
use masc.core.index;
use masc.core.inst;
use masc.core.operand;
use masc.core.quantity;
use masc.core.register;
use masc.core.requirement;
use masc.core.row;
use masc.core.state;

# a decoded instruction and the bytes it took
pub rec Decoded {
    inst: inst.Inst;
    len:  usize;
}

# the row of `codec` keyed `key`
pub fun row_keyed(codec: *dispatch.Codec, key: str) opt[*row.Row] {
    val at: opt[u32] = index.find(?codec.keys, key);
    if (sel at.none) { ret opt[*row.Row].none{}; }
    ret opt[*row.Row].some{?codec.rows.at[at.some]};
}

fun refuse(message: str, op: u8) err[field.Refusal] {
    ret err[field.Refusal].err{field.refusal(message, op, 0)};
}

fun mark(p: *field.Parts, part: field.Part, bits: u64) {
    p.bits[part] = bits;
    p.present    = p.present | (1::u16 << part);
}

# why `imm` cannot hold the operand value `v` whatever it excludes, none when it can
pub fun unrepresentable(imm: *operand.Immediate, v: i64) opt[str] {
    # a float is admitted when it is a bit pattern of its width, and its encoding kind refuses what it cannot represent
    if (imm.format == operand.FLOAT) {
        if (imm.bits < 64 && (v:~u64 & ~field.ones(imm.bits)) != 0) { ret opt[str].some{field.OUT_OF_RANGE}; }
        ret opt[str].none{};
    }
    val d: i64 = v - imm.bias;
    if (imm.scale > 0 && (d & field.ones(imm.scale)::i64) != 0) { ret opt[str].some{field.MISALIGNED}; }
    if (imm.bits > 0 && imm.bits < 64) {
        val half: i64 = 1::i64 << (imm.bits - 1)::i64;
        if (imm.sign == operand.SIGNED) {
            if (d < -half || d >= half) { ret opt[str].some{field.OUT_OF_RANGE}; }
        }
        or (imm.sign == operand.EITHER) {
            if (d < -half || (d >= 0 && d::u64 > field.ones(imm.bits))) { ret opt[str].some{field.OUT_OF_RANGE}; }
        }
        or (d < 0 || d::u64 > field.ones(imm.bits)) {
            ret opt[str].some{field.OUT_OF_RANGE};
        }
    }
    ret opt[str].none{};
}

# `v` admitted as `imm` into `part`
fun admit_immediate(imm: *operand.Immediate, v: i64, p: *field.Parts, part: field.Part, op: u8) err[field.Refusal] {
    val bad: opt[str] = unrepresentable(imm, v);
    if (sel bad.some)                   { ret refuse(bad.some, op); }
    if (operand.excludes_value(imm, v)) { ret refuse(field.EXCLUDED, op); }
    if (imm.format == operand.FLOAT) {
        mark(p, part, v:~u64);
        ret err[field.Refusal].ok{};
    }
    mark(p, part, (v - imm.bias):~u64 & field.ones(imm.bits));
    ret err[field.Refusal].ok{};
}

# symbol `sym` admitted into `part` of an operand whose default fixup kind is `fixup`
fun admit_symbol(fixup: operand.FixupKind, sym: operand.Symbol, p: *field.Parts, part: field.Part, op: u8) err[field.Refusal] {
    if (fixup == operand.NO_FIXUP)   { ret refuse(field.NO_SYMBOL, op); }
    if (sym.id == operand.NO_SYMBOL) { ret refuse(field.WRONG_KIND, op); }
    p.symbolic = true;
    p.symbol   = sym;
    p.fixup    = fixup;
    if (sym.fixup != operand.NO_FIXUP) { p.fixup = sym.fixup; }
    mark(p, part, 0);
    ret err[field.Refusal].ok{};
}

# whether the view holds `id`, refused at operand `op` and stream offset `at` when it does not
fun available(v: *register.Available, id: register.Id, op: u8, at: usize) err[field.Refusal] {
    val held: err[register.Absent] = register.admitted(v, id);
    if (sel held.ok)              { ret err[field.Refusal].ok{}; }
    if (sel held.err.unavailable) { ret err[field.Refusal].err{field.unavailable(held.err.unavailable.requires, op, at)}; }
    ret err[field.Refusal].err{field.refusal(field.NO_REGISTER, op, at)};
}

# register `id` admitted as one of `r`, its number less the range's first into `number` and its class's position into `class`
fun admit_register(codec: *dispatch.Codec, v: *register.Available, r: *operand.Register, id: register.Id, p: *field.Parts, number: field.Part, class: field.Part, op: u8) err[field.Refusal] {
    if (id == register.NONE)    { ret refuse(field.WRONG_KIND, op); }
    if (codec.registers == nil) { ret refuse(field.NO_REGISTER, op); }
    val c: u16 = register.class_of(id);
    if (c::u32 >= codec.registers.class_count) { ret refuse(field.NO_REGISTER, op); }
    val at: i64 = operand.find(r.classes, c);
    if (at < 0) { ret refuse(field.WRONG_CLASS, op); }
    val n:     u32 = register.number_of(id)::u32;
    val count: u32 = register.count_most(codec.registers, c)::u32;
    if (n >= count)                    { ret refuse(field.NO_REGISTER, op); }
    if (!operand.within(r, n, count))  { ret refuse(field.OUTSIDE_RANGE, op); }
    if (operand.excludes_number(r, n)) { ret refuse(field.EXCLUDED, op); }
    if (!r.unviewed) {
        val held: err[field.Refusal] = available(v, id, op, 0);
        if (sel held.err) { ret held; }
    }
    mark(p, number, (n - r.first)::u64);
    mark(p, class, at::u64);
    ret err[field.Refusal].ok{};
}

fun admit_memory(codec: *dispatch.Codec, v: *register.Available, m: *operand.Memory, a: *operand.Address, p: *field.Parts, op: u8) err[field.Refusal] {
    if ((a.mode == operand.RELATIVE_PC && (m.forms & operand.PCREL) == 0) || (a.mode == operand.PREINDEX && (m.forms & operand.PRE) == 0) || (a.mode == operand.POSTINDEX && (m.forms & operand.POST) == 0) || a.mode > operand.POSTINDEX_REGISTER) {
        ret refuse(field.FORM, op);
    }
    if (a.mode == operand.POSTINDEX_REGISTER && ((m.forms & operand.POST_REGISTER) == 0 || a.index == register.NONE)) { ret refuse(field.FORM, op); }
    if (a.broadcast != 0 && (a.broadcast >= 8 || ((m.broadcasts >> a.broadcast) & 1) == 0))                           { ret refuse(field.FORM, op); }
    if (m.extends.count == 0) {
        if (a.extend != 0) { ret refuse(field.FORM, op); }
    }
    or {
        if (a.index == register.NONE || !operand.member(?m.extends, a.extend)) { ret refuse(field.FORM, op); }
        mark(p, field.EXTEND, a.extend::u64);
    }
    if (a.broadcast != 0) { mark(p, field.BROADCAST, a.broadcast::u64); }
    if (a.base == register.NONE) {
        if (!(a.mode == operand.RELATIVE_PC || (a.mode == operand.OFFSET && (m.forms & operand.ABSOLUTE) != 0))) { ret refuse(field.FORM, op); }
    }
    or {
        if (a.mode == operand.RELATIVE_PC) { ret refuse(field.FORM, op); }
        val based: err[field.Refusal] = admit_register(codec, v, ?m.base, a.base, p, field.NUMBER, field.CLASS, op);
        if (sel based.err) { ret based; }
    }
    if (a.index == register.NONE) {
        if (a.scale != 0) { ret refuse(field.FORM, op); }
    }
    or {
        if (a.scale >= 8 || ((m.scales >> a.scale) & 1) == 0) { ret refuse(field.FORM, op); }
        val indexed: err[field.Refusal] = admit_register(codec, v, ?m.index, a.index, p, field.INDEX, field.INDEX_CLASS, op);
        if (sel indexed.err) { ret indexed; }
        mark(p, field.SCALE, a.scale::u64);
    }
    if (a.segment != register.NONE) {
        var scratch:   field.Parts;
        val segmented: err[field.Refusal] = admit_register(codec, v, ?m.segment, a.segment, ?scratch, field.SEGMENT, field.CLASS, op);
        if (sel segmented.err) { ret segmented; }
        mark(p, field.SEGMENT, scratch.bits[field.SEGMENT]);
    }
    if (a.symbol.id != operand.NO_SYMBOL) {
        # a symbolic displacement carries its addend in the symbol
        if (a.disp != 0) { ret refuse(field.FORM, op); }
        val placed: err[field.Refusal] = admit_symbol(m.disp.fixup, a.symbol, p, field.DISP, op);
        if (sel placed.err) { ret placed; }
    }
    or {
        val placed: err[field.Refusal] = admit_immediate(?m.disp, a.disp, p, field.DISP, op);
        if (sel placed.err) { ret placed; }
    }
    mark(p, field.MODE, a.mode::u64);
    ret err[field.Refusal].ok{};
}

fun admit_list(codec: *dispatch.Codec, v: *register.Available, l: *operand.List, members: operand.Values, p: *field.Parts, op: u8) err[field.Refusal] {
    if (members.len < l.min::u32 || members.len > l.max::u32) { ret refuse(field.LIST_LENGTH, op); }
    var first: register.Id = register.NONE;
    var i:     u32         = 0;
    for (i < members.len) {
        val member: *operand.Value = ?members.at[i];
        if (!sel member.register) { ret refuse(field.WRONG_KIND, op); }
        var scratch:  field.Parts;
        val admitted: err[field.Refusal] = admit_register(codec, v, ?l.member, member.register, ?scratch, field.NUMBER, field.CLASS, op);
        if (sel admitted.err) { ret admitted; }
        if (i == 0) {
            mark(p, field.NUMBER, scratch.bits[field.NUMBER]);
            mark(p, field.CLASS, scratch.bits[field.CLASS]);
            first = member.register;
        }
        or (l.consecutive) {
            val span: u64 = operand.span(?l.member, register.count_most(codec.registers, register.class_of(first))::u32)::u64;
            if (register.class_of(member.register) != register.class_of(first) || scratch.bits[field.NUMBER] != (p.bits[field.NUMBER] + i::u64) % span) {
                ret refuse(field.NOT_ADJACENT, op);
            }
        }
        i = i + 1;
    }
    mark(p, field.COUNT, members.len::u64);
    ret err[field.Refusal].ok{};
}

# one value admitted against `shape` into its parts
fun admit_one(codec: *dispatch.Codec, ctx: *state.Context, shape: *operand.Shape, value: *operand.Value, p: *field.Parts, op: u8) err[field.Refusal] {
    val v: *register.Available = ctx.view;
    if (sel shape.register) {
        if (!sel value.register) { ret refuse(field.WRONG_KIND, op); }
        ret admit_register(codec, v, ?shape.register, value.register, p, field.NUMBER, field.CLASS, op);
    }
    if (sel shape.immediate) {
        if (sel value.symbol)     { ret admit_symbol(shape.immediate.fixup, value.symbol, p, field.NUMBER, op); }
        if (!sel value.immediate) { ret refuse(field.WRONG_KIND, op); }
        ret admit_immediate(?shape.immediate, value.immediate, p, field.NUMBER, op);
    }
    if (sel shape.relative) {
        if (sel value.symbol)    { ret admit_symbol(shape.relative.offset.fixup, value.symbol, p, field.NUMBER, op); }
        if (!sel value.relative) { ret refuse(field.WRONG_KIND, op); }
        ret admit_immediate(?shape.relative.offset, value.relative, p, field.NUMBER, op);
    }
    if (sel shape.memory) {
        if (!sel value.memory) { ret refuse(field.WRONG_KIND, op); }
        ret admit_memory(codec, v, ?shape.memory, ?value.memory, p, op);
    }
    if (sel shape.enumerant) {
        if (!sel value.enumerant)                               { ret refuse(field.WRONG_KIND, op); }
        if (!operand.member(?shape.enumerant, value.enumerant)) { ret refuse(field.NOT_A_MEMBER, op); }
        val needed: err[field.Refusal] = enumerant_admitted(ctx, ?shape.enumerant, value.enumerant, op);
        if (sel needed.err) { ret needed; }
        mark(p, field.NUMBER, value.enumerant::u64);
        ret err[field.Refusal].ok{};
    }
    if (sel shape.condition) {
        if (!sel value.condition)                               { ret refuse(field.WRONG_KIND, op); }
        if (!operand.member(?shape.condition, value.condition)) { ret refuse(field.NOT_A_MEMBER, op); }
        mark(p, field.NUMBER, value.condition::u64);
        ret err[field.Refusal].ok{};
    }
    if (sel shape.list) {
        if (!sel value.list) { ret refuse(field.WRONG_KIND, op); }
        ret admit_list(codec, v, ?shape.list, value.list, p, op);
    }
    if (sel shape.id) {
        if (sel value.symbol)                          { ret admit_symbol(shape.id.fixup, value.symbol, p, field.NUMBER, op); }
        if (!sel value.id)                             { ret refuse(field.WRONG_KIND, op); }
        if (value.id::u64 > field.ones(shape.id.bits)) { ret refuse(field.OUT_OF_RANGE, op); }
        mark(p, field.NUMBER, value.id::u64);
        ret err[field.Refusal].ok{};
    }
    if (sel shape.marker) {
        if (!sel value.symbol)                  { ret refuse(field.WRONG_KIND, op); }
        if (value.symbol.fixup != shape.marker) { ret refuse(field.UNMARKED, op); }
        ret admit_symbol(shape.marker, value.symbol, p, field.NUMBER, op);
    }
    if (sel shape.literal) {
        if (!sel value.literal) { ret refuse(field.WRONG_KIND, op); }
        val bytes: operand.Bytes = value.literal;
        if (bytes.len > shape.literal.max || (shape.literal.content == operand.NUMBER && bytes.len == 0)) { ret refuse(field.LITERAL_LENGTH, op); }
        if (shape.literal.content == operand.STRING) {
            var i: u32 = 0;
            for (i < bytes.len) {
                if (bytes.at[i] == 0) { ret refuse(field.NUL_IN_STRING, op); }
                i = i + 1;
            }
        }
        mark(p, field.COUNT, bytes.len::u64);
        ret err[field.Refusal].ok{};
    }
    if (sel shape.group) {
        # a group's members are admitted by their own shapes, and the set's kinds place them
        if (!sel value.group) { ret refuse(field.WRONG_KIND, op); }
        val members: operand.Values = value.group;
        if (members.len != shape.group.len) { ret refuse(field.WRONG_KIND, op); }
        var i: u32 = 0;
        for (i < shape.group.len) {
            var scratch:  field.Parts;
            val admitted: err[field.Refusal] = admit(codec, ctx, ?shape.group.at[i], ?members.at[i], ?scratch, op);
            if (sel admitted.err) { ret admitted; }
            i = i + 1;
        }
        mark(p, field.COUNT, members.len::u64);
        ret err[field.Refusal].ok{};
    }
    ret refuse(field.WRONG_KIND, op);
}

# the enumerant `value` of `e` admitted under `ctx`: a member's requirement, or every set bit's of a mask, held
fun enumerant_admitted(ctx: *state.Context, e: *operand.Enumeration, value: u32, op: u8) err[field.Refusal] {
    var i: u32 = 0;
    for (i < e.count) {
        val m:     *operand.Enumerant = ?e.members[i];
        val named: bool               = m.value == value || (e.mask && m.value != 0 && (value & m.value) == m.value);
        if (named && !state.admits(ctx, m.requires)) { ret err[field.Refusal].err{field.unadmitted(m.requires, 0)}; }
        i = i + 1;
    }
    ret err[field.Refusal].ok{};
}

# operand `op`'s value admitted against its row operand into its parts
fun admit(codec: *dispatch.Codec, ctx: *state.Context, desc: *operand.Operand, value: *operand.Value, p: *field.Parts, op: u8) err[field.Refusal] {
    if (sel value.none) {
        if (desc.quantity == operand.OPTIONAL) { ret err[field.Refusal].ok{}; }
        ret refuse(field.WRONG_KIND, op);
    }
    if (desc.quantity != operand.VARIADIC) { ret admit_one(codec, ctx, ?desc.shape, value, p, op); }
    if (!sel value.list)                   { ret refuse(field.WRONG_KIND, op); }
    val members: operand.Values = value.list;
    var i:       u32            = 0;
    for (i < members.len) {
        var scratch:  field.Parts;
        val admitted: err[field.Refusal] = admit_one(codec, ctx, ?desc.shape, ?members.at[i], ?scratch, op);
        if (sel admitted.err) { ret admitted; }
        i = i + 1;
    }
    mark(p, field.COUNT, members.len::u64);
    ret err[field.Refusal].ok{};
}

# the register operand `op` of `r` must be, none when the row does not fix it
pub fun fixed(codec: *dispatch.Codec, r: *row.Row, op: u8) opt[register.Id] {
    ret effect.fixed(codec.registers, r.effect, op);
}

# operand `op` of `r` holding `value`, admitted as encode admits it into `parts`: the row's fixed register and the operand's shape
fun admit_at(codec: *dispatch.Codec, ctx: *state.Context, r: *row.Row, op: u8, value: *operand.Value, parts: *field.Parts) err[field.Refusal] {
    val held: opt[register.Id] = fixed(codec, r, op);
    if (sel held.some) {
        val given: operand.Value = @value;
        if (sel given.register && given.register != held.some) { ret err[field.Refusal].err{field.refusal(field.NOT_FIXED, op, 0)}; }
    }
    ret admit(codec, ctx, ?r.operands.at[op], value, parts, op);
}

# whether operand `op` of `r` admits `value` under the context `ctx` as encode admits it, on its own, which is how an
# instruction is refused an operand of the wrong kind as it is built
pub fun admits_operand(codec: *dispatch.Codec, ctx: *state.Context, r: *row.Row, op: u8, value: *operand.Value) err[field.Refusal] {
    var parts: field.Parts;
    ret admit_at(codec, ctx, r, op, value, ?parts);
}

# the row's own checks and every operand's admission of `ins` under `ctx`, the encoded parts into `parts`
fun admit_all(codec: *dispatch.Codec, ctx: *state.Context, ins: *inst.Inst, parts: *field.Parts) err[field.Refusal] {
    val r: *row.Row            = ins.row;
    val v: *register.Available = ctx.view;
    if ((r.flags & row.DECODE_ONLY) != 0) { ret err[field.Refusal].err{field.refusal(field.DECODE_ONLY, field.NO_OPERAND, 0)}; }
    if (!state.admits(ctx, r.requires))   { ret err[field.Refusal].err{field.unadmitted(r.requires, 0)}; }
    if (ins.count != r.operands.len)      { ret err[field.Refusal].err{field.refusal(field.OPERAND_COUNT, field.NO_OPERAND, 0)}; }
    var i: u32 = 0;
    for (i < r.operands.len) {
        val admitted: err[field.Refusal] = admit_at(codec, ctx, r, i::u8, ?ins.values[i], ?parts[i]);
        if (sel admitted.err) { ret admitted; }
        i = i + 1;
    }
    val held: err[field.Refusal] = kept(codec, ctx, r, ins.values, 0);
    if (sel held.err) { ret held; }
    val touched: err[field.Refusal] = touches_held(codec, v, r, ins.values, 0);
    if (sel touched.err) { ret touched; }
    ret kinds_admit(codec, ctx, ins, parts);
}

# what each field's kind refuses of the values of `ins` beyond their shapes, encoded into `parts`, without writing
fun kinds_admit(codec: *dispatch.Codec, ctx: *state.Context, ins: *inst.Inst, parts: *field.Parts) err[field.Refusal] {
    val r:   *row.Row      = ins.row;
    var enc: field.Encoder = field.Encoder{ctx: ctx, table: codec.fields, operands: r.operands.at, values: ins.values, parts: parts, count: r.operands.len, form: ?ins.form, out: nil, fixups: nil, start: 0, field: 0};
    var j:   u32           = 0;
    for (j < r.encoding.len) {
        val f:    *field.Field = ?r.encoding.at[j];
        val kind: *field.Kind  = codec.fields.kinds[f.kind];
        if (kind.admit != nil) {
            enc.field = j;
            val done: err[field.Refusal] = kind.admit(?enc, f);
            if (sel done.err) { ret done; }
        }
        j = j + 1;
    }
    ret err[field.Refusal].ok{};
}

# the first row of `set` the view does not hold, none when it holds every one
fun absent(v: *register.Available, set: effect.Set) opt[u32] {
    var w: u32 = 0;
    for (w < set.len) {
        var left: u64 = set.words[w];
        for (left != 0) {
            val at: u32 = w * 64 + bits.ctz(left)::u32;
            if (!bitset.get(?v.rows, at::usize)) { ret opt[u32].some{at}; }
            left = left & (left - 1);
        }
        w = w + 1;
    }
    ret opt[u32].none{};
}

# whether every register `r` holding `values` touches beyond its operands is one the view holds, refused at stream offset
# `at` naming the first it does not, as an operand naming it is. a rule decides them by the values, so a value whose
# registers the selection lacks, as a zcmp register list past x15 under the e base, is refused. the walks run it once
# every operand is admitted or settled, so each has a value, an absent optional operand's being none, and the answer is
# decided. one left open names an operand with no value, refused as one. registers no value decides are held to those
# the row surely touches, since what it may touch beyond them is a reader's bound, not a fact of the encoding
fun touches_held(codec: *dispatch.Codec, v: *register.Available, r: *row.Row, values: *operand.Value, at: usize) err[field.Refusal] {
    if (codec.registers == nil) { ret err[field.Refusal].ok{}; }
    val given:   operand.Values                = operand.Values{at: values, len: r.operands.len};
    val found:   effect.Answer[effect.Touched] = effect.implicit(codec.registers, r.operands.at, r.effect, given);
    var touched: effect.Touched                = effect.must(r.effect);
    if (sel found.decided) { touched = found.decided; }
    or (sel found.undecided) {
        val why: effect.Undecided = found.undecided;
        if (sel why.open) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, why.open.operand, at)}; }
    }
    val lacking: opt[u32] = absent(v, touched.read);
    if (sel lacking.none) {
        val written: opt[u32] = absent(v, touched.written);
        if (sel written.none) { ret err[field.Refusal].ok{}; }
        ret err[field.Refusal].err{field.unavailable(codec.registers.registers[written.some].requires, deciding(codec.registers, r, given), at)};
    }
    ret err[field.Refusal].err{field.unavailable(codec.registers.registers[lacking.some].requires, deciding(codec.registers, r, given), at)};
}

# the operand whose value chose the register rule of `r` that `values` meet, the first its terms test, field.NO_OPERAND
# when no rule holds and the row's own registers are touched. rules are exclusive, so at most one is met
fun deciding(file: *register.File, r: *row.Row, values: operand.Values) u8 {
    val g: *effect.Registers = ?r.effect.implicit;
    if (!sel g.ruled) { ret field.NO_OPERAND; }
    val rules: effect.RegisterRules = g.ruled.rules;
    var i:     u32                  = 0;
    for (i < rules.len) {
        val terms: effect.Terms = rules.at[i].terms;
        if (terms.len > 0 && effect.meets(file, terms, values)) { ret terms.at[0].operand; }
        i = i + 1;
    }
    ret field.NO_OPERAND;
}

# whether the operand values `values` of `r` keep its register constraints under `ctx`, refused at stream offset `at`
# when they break one. the walks know no grouping, so no stated group runs outside its class, and a form whose rule turns
# on state the operands do not hold is admitted, as some state allows it. the narrowest element width the context's
# state may set, the codec's element quantity, decides the rules between a width below it and the state's
fun kept(codec: *dispatch.Codec, ctx: *state.Context, r: *row.Row, values: *operand.Value, at: usize) err[field.Refusal] {
    val found: constraint.Verdict = constraint.violated(codec.registers, r.constraints, r.operands.at, r.effect, operand.Values{at: values, len: r.operands.len}, unit_of(codec, ctx));
    if (sel found.broken) { ret err[field.Refusal].err{field.refusal(field.SHARED, found.broken.side.operand, at)}; }
    ret err[field.Refusal].ok{};
}

# the grouping the walks test at under `ctx`: no group's length and no element width stated, and the least element
# width the codec's element quantity resolves to under the context
pub fun unit_of(codec: *dispatch.Codec, ctx: *state.Context) constraint.Grouping {
    var g:    constraint.Grouping = constraint.UNIT;
    val file: *register.File      = codec.registers;
    if (codec.element == 0 || file == nil || ctx.view == nil || codec.element::u32 > file.quantities.len) { ret g; }
    val q:     u8             = codec.element - 1;
    val least: quantity.Range = register.range(ctx.view, q);
    g.least = (file.quantities.at[q].unit * least.least)::u16;
    ret g;
}

# whether `ins` is admitted under the context `ctx` as encode admits it, without encoding it, which is how the parser
# chooses among rows in the encoder's order of preference
pub fun admits(codec: *dispatch.Codec, ctx: *state.Context, ins: *inst.Inst) err[field.Refusal] {
    var parts: [row.MAX_OPERANDS]field.Parts;
    ret admit_all(codec, ctx, ins, ?parts[0]);
}

# `inst` encoded onto `out`, its symbolic operands appended to `fixups`, a marker's after those fields hold
# ---
# ctx: the context it is encoded under, which must admit the row, and whose view of the codec's register file admits
#      its registers
# ret: the instruction's length, or the refusal with out and fixups left as they were
pub fun encode(codec: *dispatch.Codec, ctx: *state.Context, ins: *inst.Inst, out: *vector.Vector[u8], fixups: *vector.Vector[field.Fixup]) res[usize, field.Refusal] {
    val r:        *row.Row           = ins.row;
    var parts:    [row.MAX_OPERANDS]field.Parts;
    val admitted: err[field.Refusal] = admit_all(codec, ctx, ins, ?parts[0]);
    if (sel admitted.err) { ret res[usize, field.Refusal].err{admitted.err}; }
    var enc: field.Encoder = field.Encoder{
        ctx:      ctx,
        table:    codec.fields,
        operands: r.operands.at,
        values:   ins.values,
        parts:    ?parts[0],
        count:    r.operands.len,
        form:     ?ins.form,
        out:      out,
        fixups:   fixups,
        start:    out.len,
        field:    0,
    };
    val marked:  usize              = fixups.len;
    var offsets: [row.MAX_FIELDS]usize;
    var failed:  opt[field.Refusal] = opt[field.Refusal].none{};
    var j:       u32                = 0;
    for (j < r.encoding.len && sel failed.none) {
        val f:    *field.Field = ?r.encoding.at[j];
        val kind: *field.Kind  = codec.fields.kinds[f.kind];
        enc.field  = j;
        offsets[j] = out.len;
        val done: err[field.Refusal] = kind.encode(?enc, f);
        if (sel done.err) { failed = opt[field.Refusal].some{done.err}; }
        j = j + 1;
    }
    j = 0;
    for (j < r.encoding.len && sel failed.none) {
        val f:    *field.Field = ?r.encoding.at[j];
        val kind: *field.Kind  = codec.fields.kinds[f.kind];
        if (kind.finish != nil) {
            enc.field = j;
            val done: err[field.Refusal] = kind.finish(?enc, f, offsets[j]);
            if (sel done.err) { failed = opt[field.Refusal].some{done.err}; }
        }
        j = j + 1;
    }
    # no field holds a marker, so its fixup marks the instruction's start
    var k: u32 = 0;
    for (k < r.operands.len && sel failed.none) {
        if (sel r.operands.at[k].shape.marker) {
            enc.field = field.NO_FIELD;
            val done: err[field.Refusal] = field.fixup(?enc, k::u8, 0);
            if (sel done.err) { failed = opt[field.Refusal].some{done.err}; }
        }
        k = k + 1;
    }
    if (sel failed.some) {
        out.len    = enc.start;
        fixups.len = marked;
        ret res[usize, field.Refusal].err{failed.some};
    }
    ret res[usize, field.Refusal].ok{out.len - enc.start};
}

# the register of `r` encoded as `number` from its range's first, in the class at position `at` of its classes
fun settle_register(codec: *dispatch.Codec, v: *register.Available, r: *operand.Register, at: u64, number: u64, op: u8, offset: usize) res[register.Id, field.Refusal] {
    if (at >= r.classes.len::u64) { ret res[register.Id, field.Refusal].err{field.refusal(field.NO_REGISTER, op, offset)}; }
    val c:     u16 = r.classes.at[at];
    val count: u32 = register.count_most(codec.registers, c)::u32;
    val n:     u64 = r.first::u64 + number;
    if (n >= count::u64)                       { ret res[register.Id, field.Refusal].err{field.refusal(field.NO_REGISTER, op, offset)}; }
    if (number >= operand.span(r, count)::u64) { ret res[register.Id, field.Refusal].err{field.refusal(field.OUTSIDE_RANGE, op, offset)}; }
    if (operand.excludes_number(r, n::u32))    { ret res[register.Id, field.Refusal].err{field.refusal(field.EXCLUDED, op, offset)}; }
    val id: register.Id = register.make(c, n::u16);
    if (!r.unviewed) {
        val held: err[field.Refusal] = available(v, id, op, offset);
        if (sel held.err) { ret res[register.Id, field.Refusal].err{held.err}; }
    }
    ret res[register.Id, field.Refusal].ok{id};
}

# the value of the encoded bits `bits` of `imm`, refused at operand `op` and stream offset `offset` when the operand excludes it
fun settle_immediate(imm: *operand.Immediate, bits: u64, op: u8, offset: usize) res[i64, field.Refusal] {
    var raw: u64 = bits & field.ones(imm.bits);
    var v:   i64 = raw:~i64;
    if (imm.format != operand.FLOAT) {
        if (imm.sign == operand.SIGNED && imm.bits > 0 && imm.bits < 64 && ((raw >> (imm.bits - 1)::u64) & 1) != 0) { raw = raw | ~field.ones(imm.bits); }
        v = raw:~i64 + imm.bias;
    }
    if (operand.excludes_value(imm, v)) { ret res[i64, field.Refusal].err{field.refusal(field.EXCLUDED, op, offset)}; }
    ret res[i64, field.Refusal].ok{v};
}

# operand `op`'s decoded parts turned into its value
fun settle(codec: *dispatch.Codec, v: *register.Available, dec: *field.Decoder, op: u8) err[field.Refusal] {
    val p:    *field.Parts     = ?dec.parts[op];
    val desc: *operand.Operand = ?dec.operands[op];
    val at:   usize            = dec.start;
    # an operand no field holds is implicit, an absent optional one is none, and kinds place literals and variadic operands themselves
    if (p.direct || p.present == 0 || desc.quantity == operand.VARIADIC || sel desc.shape.literal || sel desc.shape.group) { ret err[field.Refusal].ok{}; }
    val shape: *operand.Shape = ?desc.shape;
    if (sel shape.register) {
        val reg: res[register.Id, field.Refusal] = settle_register(codec, v, ?shape.register, p.bits[field.CLASS], p.bits[field.NUMBER], op, at);
        if (sel reg.err) { ret err[field.Refusal].err{reg.err}; }
        dec.values[op] = operand.Value.register{reg.ok};
    }
    or (sel shape.immediate) {
        val imm: res[i64, field.Refusal] = settle_immediate(?shape.immediate, p.bits[field.NUMBER], op, at);
        if (sel imm.err) { ret err[field.Refusal].err{imm.err}; }
        dec.values[op] = operand.Value.immediate{imm.ok};
    }
    or (sel shape.relative) {
        val rel: res[i64, field.Refusal] = settle_immediate(?shape.relative.offset, p.bits[field.NUMBER], op, at);
        if (sel rel.err) { ret err[field.Refusal].err{rel.err}; }
        dec.values[op] = operand.Value.relative{rel.ok};
    }
    or (sel shape.memory) {
        var a: operand.Address;
        if (field.has(p, field.NUMBER)) {
            val base: res[register.Id, field.Refusal] = settle_register(codec, v, ?shape.memory.base, p.bits[field.CLASS], p.bits[field.NUMBER], op, at);
            if (sel base.err) { ret err[field.Refusal].err{base.err}; }
            a.base = base.ok;
        }
        if (field.has(p, field.INDEX)) {
            val index: res[register.Id, field.Refusal] = settle_register(codec, v, ?shape.memory.index, p.bits[field.INDEX_CLASS], p.bits[field.INDEX], op, at);
            if (sel index.err) { ret err[field.Refusal].err{index.err}; }
            a.index = index.ok;
            a.scale = p.bits[field.SCALE]::u8;
        }
        if (field.has(p, field.SEGMENT)) {
            val segment: res[register.Id, field.Refusal] = settle_register(codec, v, ?shape.memory.segment, 0, p.bits[field.SEGMENT], op, at);
            if (sel segment.err) { ret err[field.Refusal].err{segment.err}; }
            a.segment = segment.ok;
        }
        val disp: res[i64, field.Refusal] = settle_immediate(?shape.memory.disp, p.bits[field.DISP], op, at);
        if (sel disp.err) { ret err[field.Refusal].err{disp.err}; }
        a.disp = disp.ok;
        a.mode = p.bits[field.MODE]::u8;
        if (field.has(p, field.EXTEND)) {
            if (!operand.member(?shape.memory.extends, p.bits[field.EXTEND]::u32)) { ret err[field.Refusal].err{field.refusal(field.NOT_A_MEMBER, op, at)}; }
            a.extend = p.bits[field.EXTEND]::u32;
        }
        if (field.has(p, field.BROADCAST)) { a.broadcast = p.bits[field.BROADCAST]::u8; }
        dec.values[op] = operand.Value.memory{a};
    }
    or (sel shape.enumerant) {
        if (!operand.member(?shape.enumerant, p.bits[field.NUMBER]::u32)) { ret err[field.Refusal].err{field.refusal(field.NOT_A_MEMBER, op, at)}; }
        val needed: err[field.Refusal] = enumerant_admitted(dec.ctx, ?shape.enumerant, p.bits[field.NUMBER]::u32, op);
        if (sel needed.err) {
            var refused: field.Refusal = needed.err;
            refused.at = at;
            ret err[field.Refusal].err{refused};
        }
        dec.values[op] = operand.Value.enumerant{p.bits[field.NUMBER]::u32};
    }
    or (sel shape.condition) {
        if (!operand.member(?shape.condition, p.bits[field.NUMBER]::u32)) { ret err[field.Refusal].err{field.refusal(field.NOT_A_MEMBER, op, at)}; }
        dec.values[op] = operand.Value.condition{p.bits[field.NUMBER]::u32};
    }
    or (sel shape.list) {
        # a list held by slices is consecutive from its first member
        val first: res[register.Id, field.Refusal] = settle_register(codec, v, ?shape.list.member, p.bits[field.CLASS], p.bits[field.NUMBER], op, at);
        if (sel first.err) { ret err[field.Refusal].err{first.err}; }
        val class: u16 = register.class_of(first.ok);
        val span:  u64 = operand.span(?shape.list.member, register.count_most(codec.registers, class)::u32)::u64;
        val len:   u32 = p.bits[field.COUNT]::u32;
        if (len < shape.list.min::u32 || len > shape.list.max::u32) { ret err[field.Refusal].err{field.refusal(field.LIST_LENGTH, op, at)}; }
        var members: *operand.Value = nil;
        var i:       u32            = 0;
        for (i < len) {
            val number: u64 = shape.list.member.first::u64 + (p.bits[field.NUMBER] + i::u64) % span;
            if (operand.excludes_number(?shape.list.member, number::u32)) { ret err[field.Refusal].err{field.refusal(field.EXCLUDED, op, at)}; }
            val member: register.Id        = register.make(class, number::u16);
            val held:   err[field.Refusal] = available(v, member, op, at);
            if (sel held.err) { ret held; }
            val slot: res[*operand.Value, field.Refusal] = field.push(dec, operand.Value.register{member});
            if (sel slot.err) { ret err[field.Refusal].err{slot.err}; }
            if (i == 0)       { members = slot.ok; }
            i = i + 1;
        }
        dec.values[op] = operand.Value.list{operand.Values{at: members, len: len}};
    }
    or (sel shape.id) {
        dec.values[op] = operand.Value.id{p.bits[field.NUMBER]::u32};
    }
    ret err[field.Refusal].ok{};
}

# one instruction of row `r` decoded from `data[at..len]`
# ---
# ctx:   the context it is decoded under, which must admit the row, and whose view admits its registers
# store: storage for the operand values, then for list members
# cap:   how many values store holds
# ret:   the instruction, its values in store, and its length, or the refusal
pub fun decode_row(codec: *dispatch.Codec, ctx: *state.Context, r: *row.Row, data: *u8, len: usize, at: usize, store: *operand.Value, cap: u32) res[Decoded, field.Refusal] {
    if (!state.admits(ctx, r.requires)) { ret res[Decoded, field.Refusal].err{field.unadmitted(r.requires, at)}; }
    val v:     *register.Available = ctx.view;
    val count: u32                 = r.operands.len;
    if (cap < count) { ret res[Decoded, field.Refusal].err{field.refusal(field.STORAGE, field.NO_OPERAND, at)}; }
    var parts: [row.MAX_OPERANDS]field.Parts;
    var i:     u32 = 0;
    for (i < count) {
        store[i] = operand.Value.none{};
        i        = i + 1;
    }
    var read: form.Form     = form.PREFERRED;
    var dec:  field.Decoder = field.Decoder{
        ctx:      ctx,
        table:    codec.fields,
        operands: r.operands.at,
        values:   store,
        parts:    ?parts[0],
        count:    count,
        form:     ?read,
        in:       field.Stream{data: data, len: len, order: codec.fields.order},
        start:    at,
        at:       at,
        end:      len,
        declared: false,
        pool:     ?store[count],
        used:     0,
        cap:      cap - count,
    };
    var offsets: [row.MAX_FIELDS]usize;
    var j:       u32 = 0;
    for (j < r.encoding.len) {
        val f: *field.Field = ?r.encoding.at[j];
        offsets[j] = dec.at;
        val done: err[field.Refusal] = codec.fields.kinds[f.kind].decode(?dec, f);
        if (sel done.err) { ret res[Decoded, field.Refusal].err{done.err}; }
        j = j + 1;
    }
    # a kind completes the parts it decides once every field is read
    j = 0;
    for (j < r.encoding.len) {
        val f:    *field.Field = ?r.encoding.at[j];
        val kind: *field.Kind  = codec.fields.kinds[f.kind];
        if (kind.complete != nil) {
            val done: err[field.Refusal] = kind.complete(?dec, f, offsets[j]);
            if (sel done.err) { ret res[Decoded, field.Refusal].err{done.err}; }
        }
        j = j + 1;
    }
    if (dec.declared && dec.at != dec.end) { ret res[Decoded, field.Refusal].err{field.refusal(field.LENGTH, field.NO_OPERAND, dec.at)}; }
    i = 0;
    for (i < count) {
        val settled: err[field.Refusal] = settle(codec, v, ?dec, i::u8);
        if (sel settled.err) { ret res[Decoded, field.Refusal].err{settled.err}; }
        # an implicit fixed operand is its register, and an encoded one must be it
        val pinned: opt[register.Id] = fixed(codec, r, i::u8);
        if (sel pinned.some) {
            val given: operand.Value = store[i];
            if (sel given.none) { store[i] = operand.Value.register{pinned.some}; }
            or (!(sel given.register && given.register == pinned.some)) {
                ret res[Decoded, field.Refusal].err{field.refusal(field.NOT_FIXED, i::u8, at)};
            }
        }
        i = i + 1;
    }
    val keeps: err[field.Refusal] = kept(codec, ctx, r, store, at);
    if (sel keeps.err) { ret res[Decoded, field.Refusal].err{keeps.err}; }
    val touched: err[field.Refusal] = touches_held(codec, v, r, store, at);
    if (sel touched.err) { ret res[Decoded, field.Refusal].err{touched.err}; }
    ret res[Decoded, field.Refusal].ok{Decoded{inst: inst.Inst{row: r, values: store, count: count, form: read}, len: dec.at - at}};
}

# the entry of `node` whose value is `key`
fun search(d: *dispatch.Dispatch, node: *dispatch.Node, key: u64) opt[*dispatch.Entry] {
    var lo: u32 = node.first;
    var hi: u32 = node.first + node.count;
    for (lo < hi) {
        val mid: u32             = lo + (hi - lo) / 2;
        val e:   *dispatch.Entry = ?d.entries[mid];
        if (e.value == key) { ret opt[*dispatch.Entry].some{e}; }
        if (e.value < key)  { lo = mid + 1; }
        or                  { hi = mid; }
    }
    ret opt[*dispatch.Entry].none{};
}

# one instruction decoded from `data[at..len]`, its row found by the codec's dispatch
# ---
# ctx:   the context it is decoded under, whose admitted rows are candidates and which the dispatch keys read
# store: storage for the operand values, then for list members
# cap:   how many values store holds
# alts:  storage for the alternatives of the candidates the context does not admit, one slot per distinct alternative
# ret:   the first admitted candidate that decodes, or the first admitted candidate's refusal, or the requirements of every candidate when none is admitted
pub fun decode(codec: *dispatch.Codec, ctx: *state.Context, data: *u8, len: usize, at: usize, store: *operand.Value, cap: u32, alts: *field.Admissions) res[Decoded, field.Refusal] {
    alts.used = 0;
    val d:      *dispatch.Dispatch = codec.dispatch;
    var stream: field.Stream       = field.Stream{data: data, len: len, order: codec.fields.order};
    var node:   *dispatch.Node     = ?d.nodes[0];
    for {
        val key: res[u64, field.Refusal] = d.keys[node.key].extract(ctx, ?stream, at);
        if (sel key.err) { ret res[Decoded, field.Refusal].err{key.err}; }
        val found: opt[*dispatch.Entry] = search(d, node, key.ok);
        if (sel found.none) { ret res[Decoded, field.Refusal].err{field.refusal(field.NO_ROW, field.NO_OPERAND, at)}; }
        val e: *dispatch.Entry = found.some;
        if (e.node != 0) {
            node = ?d.nodes[e.node - 1];
            cnt;
        }
        var first: opt[field.Refusal] = opt[field.Refusal].none{};
        var full:  bool               = false;
        var i:     u32                = 0;
        for (i < e.count) {
            val r: *row.Row = ?codec.rows.at[d.candidates[e.first + i]];
            if (state.admits(ctx, r.requires)) {
                val got: res[Decoded, field.Refusal] = decode_row(codec, ctx, r, data, len, at, store, cap);
                if (sel got.ok)                    { ret got; }
                if (sel first.none && sel got.err) { first = opt[field.Refusal].some{got.err}; }
            }
            or {
                if (!field.note(alts, r.requires)) { full = true; }
            }
            i = i + 1;
        }
        if (sel first.some) { ret res[Decoded, field.Refusal].err{first.some}; }
        if (full)           { ret res[Decoded, field.Refusal].err{field.refusal(field.STORAGE, field.NO_OPERAND, at)}; }
        val unmet: requirement.Requirement = field.noted(alts);
        if (unmet.len == 0) { ret res[Decoded, field.Refusal].err{field.refusal(field.NO_ROW, field.NO_OPERAND, at)}; }
        ret res[Decoded, field.Refusal].err{field.unadmitted(unmet, at)};
    }
}
