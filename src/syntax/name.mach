# how a symbol's name is spelled in source text, bare or in quotes
#
# a name is written bare when it reads as one name token: a letter, `_`, `.`
# or `$`, then letters, digits, `_`, `.` and `$`, other than `.` alone. any
# other name is written in double quotes, as llvm-mc 23.1.1 and the gnu
# assembler 2.47 read one, with `\` before each `"` and `\` it holds. both
# read those two escapes alike and keep any other backslash as it is, which
# the gnu assembler warns may change, so a quoted name that holds another
# escape is refused. a name holding a line break or another control byte has
# no spelling, as a statement ends at a line break.
#
# an operand reads a bare `.` as the place and bare digits then `b` or `f` as
# a numbered label's reference, and a quoted name as the symbol of exactly
# its bytes, so `"."` and `"1b"` name symbols.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.view.View;

# whether `c` may start a bare name
pub fun starts(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '.' || c == '$';
}

# whether `c` may continue a bare name
pub fun continues(c: u8) bool {
    ret starts(c) || (c >= '0' && c <= '9');
}

# whether `name` is written bare: it reads as one name token, and not `.`, which bare is the place
pub fun plain(name: View) bool {
    if (name.len == 0 || !starts(name.data[0])) { ret false; }
    if (reserved(name))                         { ret false; }
    var i: usize = 1;
    for (i < name.len) {
        if (!continues(name.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `name` can be written at all: it holds no control byte
pub fun spellable(name: View) bool {
    var i: usize = 0;
    for (i < name.len) {
        if (name.data[i] < 0x20 || name.data[i] == 0x7F) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `name`, written bare, is one an operand reads as no symbol's name: `.`, the place, or digits and `b` or `f`,
# a numbered label's reference. written in quotes it is the symbol of its name
pub fun reserved(name: View) bool {
    if (name.len == 1 && name.data[0] == '.') { ret true; }
    if (name.len < 2)                         { ret false; }
    val last: u8 = name.data[name.len - 1];
    if (last != 'b' && last != 'f') { ret false; }
    var i: usize = 0;
    for (i < name.len - 1) {
        if (name.data[i] < '0' || name.data[i] > '9') { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `c` takes a backslash before it in a quoted name
pub fun escaped(c: u8) bool {
    ret c == '"' || c == '\\';
}

# the length of the quoted name at `at` of `text`, which ends at `end`, its quotes with it. 0 when no quote opens one
# there or none closes it before the end or a line break
pub fun quoted(text: *u8, at: usize, end: usize) usize {
    if (at >= end || text[at] != '"') { ret 0; }
    var i: usize = at + 1;
    for (i < end && text[i] != '"') {
        if (text[i] == '\n') { ret 0; }
        if (text[i] == '\\') { i = i + 1; }
        i = i + 1;
    }
    if (i >= end) { ret 0; }
    ret i + 1 - at;
}

# whether the `len` bytes of a quoted name between its quotes, at `text`, hold an escape
pub fun escapes(text: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (text[i] == '\\') { ret true; }
        i = i + 1;
    }
    ret false;
}

# the name the `len` bytes between a quoted name's quotes, at `text`, spell, written to `out`, which holds `len`
# bytes. its length, none for an escape of a byte other than `"` and `\`
pub fun unquote(text: *u8, len: usize, out: *u8) opt[usize] {
    var i: usize = 0;
    var n: usize = 0;
    for (i < len) {
        var c: u8 = text[i];
        if (c == '\\') {
            if (i + 1 >= len || !escaped(text[i + 1])) { ret opt[usize].none{}; }
            i = i + 1;
            c = text[i];
        }
        out[n] = c;
        n      = n + 1;
        i      = i + 1;
    }
    ret opt[usize].some{n};
}

#[testing]
use std.types.string.str;
#[testing]
use std.types.string.str_len;
#[testing]
use std.types.view.view;

#[testing]
fun t_view(s: str) View {
    ret view(s, str_len(s));
}

# a name is bare when it reads as one token, and is spellable unless it holds a control byte
test name__a_token_is_plain_and_a_control_byte_unspellable {
    if (!plain(t_view("f")) || !plain(t_view(".L0")) || !plain(t_view("$x_1.y")))    { ret 1; }
    if (plain(t_view("")) || plain(t_view("0z")) || plain(t_view("a b")))            { ret 2; }
    if (plain(t_view("f@V1")) || plain(t_view("a-b")))                               { ret 3; }
    if (!spellable(t_view("a \"b\\")) || spellable(t_view("a\nb")))                  { ret 4; }
    if (!reserved(t_view(".")) || !reserved(t_view("12b")) || reserved(t_view("b"))) { ret 5; }
    ret 0;
}

# a quoted name runs to its closing quote past escaped ones, and its escapes of `"` and `\` read back to them
test name__a_quoted_name_reads_its_two_escapes_back {
    val text: str   = "\"a\\\"b\\\\c\" x";
    val len:  usize = quoted(text, 0, str_len(text));
    if (len != 9)                                              { ret 1; }
    if (quoted("\"open", 0, 5) != 0 || quoted("x", 0, 1) != 0) { ret 2; }
    var out: [16]u8;
    val n:   opt[usize] = unquote(?text[1], len - 2, ?out[0]);
    if (sel n.none)                                                                         { ret 3; }
    if (n.some != 5)                                                                        { ret 3; }
    if (out[0] != 'a' || out[1] != '"' || out[2] != 'b' || out[3] != '\\' || out[4] != 'c') { ret 4; }
    val bad: opt[usize] = unquote("a\\nb", 4, ?out[0]);
    if (sel bad.some)                                    { ret 5; }
    if (!escapes(?text[1], len - 2) || escapes("ab", 2)) { ret 6; }
    ret 0;
}
