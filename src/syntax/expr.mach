# operand expressions: the gnu assembler's expressions over constants and symbols, under the syntax's specifiers
#
# an expression is terms joined by the gnu assembler's operators at its
# precedences, with unary `-`, `+`, `~` and `!` and parentheses. a term is a
# number, a character, a name, a numbered label's reference as `1b` or `1f`,
# or a specifier. a name resolves through the caller's symbols to a constant,
# a symbol, or what a name equated to symbols stands for. every operator
# folds constants, and only `+` and `-` take a symbol: a symbol plus or less
# a constant, or the difference of two symbols, which the caller measures,
# since only its layout knows it. a specifier gives the symbol its fixup kind,
# by the specifier row for the fixup kind the operand takes by default, and
# folds a constant when its row says how. comparisons are -1 when they hold,
# as the gnu assembler's are.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use masc.core.diagnostic;
use masc.core.field;
use masc.core.operand;
use core_syntax: masc.core.syntax;
use masc.syntax.read;
use masc.syntax.write;

pub val TWO_SYMBOLS:    str = "expression names two symbols";
pub val NEGATED:        str = "a symbol cannot be subtracted";
pub val NOT_ADMITTED:   str = "specifier not admitted by the operand";
pub val CONSTANT:       str = "specifier takes no constant";
pub val TWO_SPECIFIERS: str = "symbol given two specifiers";
pub val NO_SYMBOLS:     str = "no symbols are known here";
pub val NOT_CONSTANT:   str = "operator applies only to constants";
pub val SPECIFIED:      str = "a symbol under a specifier takes no other symbol";
pub val DIVIDE:         str = "division by zero";
pub val SHIFT:          str = "shift count out of range";
pub val UNCLOSED:       str = "parenthesis not closed";
pub val CHARACTER:      str = "malformed character";
pub val DIFFERENCE:     str = "a difference of symbols is not an instruction operand";

# the difference of two symbols plus a constant, which only the caller's layout measures
# ---
# plus:   the symbol added
# minus:  the symbol subtracted, never `plus`
# addend: the constant added
pub rec Difference {
    plus:   u32;
    minus:  u32;
    addend: i64;
}

# an operand expression, evaluated
# ---
# constant:   an absolute value
# symbol:     a symbol plus an addend, its fixup kind operand.NO_FIXUP for the operand's default
# difference: two symbols' difference plus an addend
pub tag Expr: u8 {
    constant:   i64;
    symbol:     operand.Symbol;
    difference: Difference;
}

# the offset of the hole in a specifier's template
fun hole(template: str) usize {
    var i: usize = 0;
    for (template[i] != 0) {
        if (template[i] == '<' && template[i + 1] == '0' && template[i + 2] == '>') { ret i; }
        i = i + 1;
    }
    ret i;
}

# the specifier row spelled `template` for an operand of default kind `fixup`
fun row_for(syntax: *core_syntax.Syntax, template: str, fixup: operand.FixupKind) opt[*core_syntax.Specifier] {
    var i: u32 = 0;
    for (i < syntax.specifiers.len) {
        val s: *core_syntax.Specifier = ?syntax.specifiers.at[i];
        if (s.operand == fixup && str_equals(s.template, template)) { ret opt[*core_syntax.Specifier].some{s}; }
        i = i + 1;
    }
    ret opt[*core_syntax.Specifier].none{};
}

# the template of the longest specifier text at the position, wrapping ones when `wraps`, else binding ones
fun longest(r: *core_syntax.Reader, wraps: bool) opt[str] {
    var best: usize    = 0;
    var got:  opt[str] = opt[str].none{};
    var i:    u32      = 0;
    for (i < r.syntax.specifiers.len) {
        val t:  str   = r.syntax.specifiers.at[i].template;
        val at: usize = hole(t);
        if (wraps && at > best && read.starts(r, r.at, t, at)) {
            best = at;
            got  = opt[str].some{t};
        }
        if (!wraps && at == 0) {
            val len: usize = str_len(t) - 3;
            if (len > best && read.starts(r, r.at, ?t[3], len)) {
                best = len;
                got  = opt[str].some{t};
            }
        }
        i = i + 1;
    }
    ret got;
}

fun refused(r: *core_syntax.Reader, message: str, at: usize) res[Expr, diagnostic.Diagnostic] {
    var len: usize = 0;
    if (r.at > at) { len = r.at - at; }
    ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, message, at, len)};
}

# `e` under the specifier spelled `template`, read from `at`
fun specify(r: *core_syntax.Reader, e: Expr, template: str, fixup: operand.FixupKind, at: usize) res[Expr, diagnostic.Diagnostic] {
    val spec: opt[*core_syntax.Specifier] = row_for(r.syntax, template, fixup);
    if (sel spec.none) { ret refused(r, NOT_ADMITTED, at); }
    if (sel e.constant) {
        if (spec.some.fold == nil) { ret refused(r, CONSTANT, at); }
        ret res[Expr, diagnostic.Diagnostic].ok{Expr.constant{spec.some.fold(e.constant)}};
    }
    if (!sel e.symbol) { ret refused(r, SPECIFIED, at); }
    var s: operand.Symbol = e.symbol;
    if (s.fixup != operand.NO_FIXUP) { ret refused(r, TWO_SPECIFIERS, at); }
    # a specifier that gives the kind the operand takes anyway states nothing, so the value is the one without it
    if (spec.some.fixup != fixup) { s.fixup = spec.some.fixup; }
    ret res[Expr, diagnostic.Diagnostic].ok{Expr.symbol{s}};
}

# whether the `len` bytes at `at` are a numbered label's reference, decimal digits and then `b` or `f`
fun numbered(r: *core_syntax.Reader, at: usize, len: usize) bool {
    if (len < 2) { ret false; }
    val last: u8 = r.text[at + len - 1];
    if (last != 'b' && last != 'f') { ret false; }
    var i: usize = at;
    for (i < at + len - 1) {
        if (r.text[i] < '0' || r.text[i] > '9') { ret false; }
        i = i + 1;
    }
    ret true;
}

# the name of `len` bytes at `at` resolved through the caller's symbols, with any binding specifier after it
fun named(r: *core_syntax.Reader, fixup: operand.FixupKind, at: usize, len: usize) res[Expr, diagnostic.Diagnostic] {
    if (r.symbols == nil) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, NO_SYMBOLS, at, len)}; }
    val resolved: res[core_syntax.Resolved, str] = r.symbols.resolve(r.symbols.context, read.span(r, at, len));
    if (sel resolved.err) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, resolved.err, at, len)}; }
    r.at = at + len;
    var e:   Expr                 = Expr.constant{0};
    val got: core_syntax.Resolved = resolved.ok;
    if (sel got.constant) { e = Expr.constant{got.constant}; }
    if (sel got.symbol)   { e = Expr.symbol{operand.Symbol{id: got.symbol, addend: 0, fixup: operand.NO_FIXUP}}; }
    if (sel got.equated) {
        if (got.equated.minus == operand.NO_SYMBOL) { e = Expr.symbol{operand.Symbol{id: got.equated.plus, addend: got.equated.addend, fixup: operand.NO_FIXUP}}; }
        or                                          { e = Expr.difference{Difference{plus: got.equated.plus, minus: got.equated.minus, addend: got.equated.addend}}; }
    }
    val binds: opt[str] = longest(r, false);
    if (sel binds.none) { ret res[Expr, diagnostic.Diagnostic].ok{e}; }
    r.at = r.at + str_len(binds.some) - 3;
    ret specify(r, e, binds.some, fixup, at);
}

# the value of one escaped or plain character at the position, read
fun escaped(r: *core_syntax.Reader) opt[u8] {
    val c: u8 = read.peek(r);
    if (c == 0) { ret opt[u8].none{}; }
    r.at = r.at + 1;
    if (c != '\\') { ret opt[u8].some{c}; }
    val e: u8 = read.peek(r);
    if (e == 0) { ret opt[u8].none{}; }
    r.at = r.at + 1;
    if (e == 'n') { ret opt[u8].some{'\n'}; }
    if (e == 't') { ret opt[u8].some{'\t'}; }
    if (e == 'r') { ret opt[u8].some{'\r'}; }
    if (e == 'b') { ret opt[u8].some{8}; }
    if (e == 'f') { ret opt[u8].some{12}; }
    if (e >= '0' && e <= '7') {
        var v: u32 = (e - '0')::u32;
        var k: u32 = 1;
        for (k < 3 && read.peek(r) >= '0' && read.peek(r) <= '7') {
            v    = v * 8 + (read.peek(r) - '0')::u32;
            r.at = r.at + 1;
            k    = k + 1;
        }
        ret opt[u8].some{(v & 0xFF)::u8};
    }
    ret opt[u8].some{e};
}

# a character constant, `'c` as the gnu assembler writes it or `'c'`
fun character(r: *core_syntax.Reader) res[Expr, diagnostic.Diagnostic] {
    val at: usize = r.at;
    r.at = r.at + 1;
    val c: opt[u8] = escaped(r);
    if (sel c.none) { ret refused(r, CHARACTER, at); }
    read.take(r, "'");
    ret res[Expr, diagnostic.Diagnostic].ok{Expr.constant{c.some::i64}};
}

# one term: a wrapping specifier, a parenthesized expression, a number, a character, a numbered label's
# reference, or a name with any binding specifier after it
fun term(r: *core_syntax.Reader, fixup: operand.FixupKind) res[Expr, diagnostic.Diagnostic] {
    val at:    usize    = r.at;
    val wraps: opt[str] = longest(r, true);
    if (sel wraps.some) {
        val t:     str   = wraps.some;
        val split: usize = hole(t);
        r.at = r.at + split;
        val inner: res[Expr, diagnostic.Diagnostic] = parse(r, fixup);
        if (sel inner.err)                { ret inner; }
        if (!read.take(r, ?t[split + 3])) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, read.UNEXPECTED, r.at, read.token(r, r.at))}; }
        ret specify(r, inner.ok, t, fixup, at);
    }
    val c: u8 = read.peek(r);
    if (c == '(') {
        r.at = r.at + 1;
        read.skip(r);
        val inner: res[Expr, diagnostic.Diagnostic] = parse(r, fixup);
        if (sel inner.err) { ret inner; }
        read.skip(r);
        if (!read.take(r, ")")) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, UNCLOSED, at, 1)}; }
        ret inner;
    }
    if (c == '\'') { ret character(r); }
    if (c >= '0' && c <= '9') {
        val len: usize = read.token(r, at);
        if (numbered(r, at, len)) { ret named(r, fixup, at, len); }
        val n: res[i64, diagnostic.Diagnostic] = read.number(r);
        if (sel n.err) { ret res[Expr, diagnostic.Diagnostic].err{n.err}; }
        ret res[Expr, diagnostic.Diagnostic].ok{Expr.constant{n.ok}};
    }
    val len: usize = read.name(r);
    if (len == 0) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, at, read.token(r, at))}; }
    ret named(r, fixup, at, len);
}

# `a` and `b` added or subtracted, wrapping as the gnu assembler's 64-bit values do
fun wrap_add(a: i64, b: i64) i64 {
    ret (a:~u64 + b:~u64):~i64;
}

fun wrap_sub(a: i64, b: i64) i64 {
    ret (a:~u64 - b:~u64):~i64;
}

fun truth(holds: bool) i64 {
    if (holds) { ret -1; }
    ret 0;
}

fun flag(holds: bool) i64 {
    if (holds) { ret 1; }
    ret 0;
}

fun op_mul(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{(a:~u64 * b:~u64):~i64};
}

fun op_div(a: i64, b: i64) opt[i64] {
    if (b == 0)  { ret opt[i64].none{}; }
    if (b == -1) { ret opt[i64].some{wrap_sub(0, a)}; }
    ret opt[i64].some{a / b};
}

fun op_mod(a: i64, b: i64) opt[i64] {
    if (b == 0)  { ret opt[i64].none{}; }
    if (b == -1) { ret opt[i64].some{0}; }
    ret opt[i64].some{a % b};
}

fun op_shl(a: i64, b: i64) opt[i64] {
    if (b < 0 || b >= 64) { ret opt[i64].none{}; }
    ret opt[i64].some{(a:~u64 << b::u64):~i64};
}

fun op_shr(a: i64, b: i64) opt[i64] {
    if (b < 0 || b >= 64) { ret opt[i64].none{}; }
    ret opt[i64].some{(a:~u64 >> b::u64):~i64};
}

fun op_or(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{a | b};
}

fun op_and(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{a & b};
}

fun op_xor(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{a ^ b};
}

fun op_or_not(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{a | ~b};
}

fun op_add(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{wrap_add(a, b)};
}

fun op_sub(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{wrap_sub(a, b)};
}

fun op_eq(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{truth(a == b)};
}

fun op_ne(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{truth(a != b)};
}

fun op_lt(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{truth(a < b)};
}

fun op_gt(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{truth(a > b)};
}

fun op_le(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{truth(a <= b)};
}

fun op_ge(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{truth(a >= b)};
}

fun op_land(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{flag(a != 0 && b != 0)};
}

fun op_lor(a: i64, b: i64) opt[i64] {
    ret opt[i64].some{flag(a != 0 || b != 0)};
}

# how an operator takes a symbol
# ---
# NONE:  it takes constants only
# PLUS:  it adds a constant to a symbol or a difference
# MINUS: it subtracts a constant from one, or a symbol from a symbol
def Sign: u8;

val NONE:  Sign = 0;
val PLUS:  Sign = 1;
val MINUS: Sign = 2;

# a binary operator
# ---
# text:    its spelling
# rank:    its precedence, the gnu assembler's, 4 binding tightest
# sign:    how it takes a symbol
# apply:   its value over two constants, none when it has none
# refusal: why it has none
rec Operator {
    text:    str;
    rank:    u8;
    sign:    Sign;
    apply:   fun(i64, i64) opt[i64];
    refusal: str;
}

# the gnu assembler's binary operators (gas manual, "Infix Operators"), every longer spelling before a shorter one it starts with
val OPERATORS: [20]Operator = [20]Operator{
    Operator{text: "<<", rank: 4, sign: NONE, apply: op_shl, refusal: SHIFT},
    Operator{text: ">>", rank: 4, sign: NONE, apply: op_shr, refusal: SHIFT},
    Operator{text: "<=", rank: 2, sign: NONE, apply: op_le, refusal: NOT_CONSTANT},
    Operator{text: ">=", rank: 2, sign: NONE, apply: op_ge, refusal: NOT_CONSTANT},
    Operator{text: "<>", rank: 2, sign: NONE, apply: op_ne, refusal: NOT_CONSTANT},
    Operator{text: "==", rank: 2, sign: NONE, apply: op_eq, refusal: NOT_CONSTANT},
    Operator{text: "!=", rank: 2, sign: NONE, apply: op_ne, refusal: NOT_CONSTANT},
    Operator{text: "&&", rank: 1, sign: NONE, apply: op_land, refusal: NOT_CONSTANT},
    Operator{text: "||", rank: 1, sign: NONE, apply: op_lor, refusal: NOT_CONSTANT},
    Operator{text: "*", rank: 4, sign: NONE, apply: op_mul, refusal: NOT_CONSTANT},
    Operator{text: "/", rank: 4, sign: NONE, apply: op_div, refusal: DIVIDE},
    Operator{text: "%", rank: 4, sign: NONE, apply: op_mod, refusal: DIVIDE},
    Operator{text: "|", rank: 3, sign: NONE, apply: op_or, refusal: NOT_CONSTANT},
    Operator{text: "&", rank: 3, sign: NONE, apply: op_and, refusal: NOT_CONSTANT},
    Operator{text: "^", rank: 3, sign: NONE, apply: op_xor, refusal: NOT_CONSTANT},
    Operator{text: "!", rank: 3, sign: NONE, apply: op_or_not, refusal: NOT_CONSTANT},
    Operator{text: "+", rank: 2, sign: PLUS, apply: op_add, refusal: NOT_CONSTANT},
    Operator{text: "-", rank: 2, sign: MINUS, apply: op_sub, refusal: NOT_CONSTANT},
    Operator{text: "<", rank: 2, sign: NONE, apply: op_lt, refusal: NOT_CONSTANT},
    Operator{text: ">", rank: 2, sign: NONE, apply: op_gt, refusal: NOT_CONSTANT},
};

# the operator spelled at the position, the first of the table that matches, nil when none does or it binds looser than `rank`
fun operator(r: *core_syntax.Reader, rank: u8) *Operator {
    var i: usize = 0;
    for (i < 20) {
        val op: *Operator = ?OPERATORS[i];
        if (read.starts(r, r.at, op.text, str_len(op.text))) {
            if (op.rank < rank) { ret nil; }
            ret op;
        }
        i = i + 1;
    }
    ret nil;
}

# whether a term or a unary operator starts at the position, so an operator before it joins two operands
fun opens(r: *core_syntax.Reader) bool {
    val c: u8 = read.peek(r);
    if (read.word(c) || c == '.' || c == '$' || c == '(' || c == '\'' || c == '-' || c == '+' || c == '~' || c == '!') { ret true; }
    val wraps: opt[str] = longest(r, true);
    ret sel wraps.some;
}

# `e` negated, a difference by swapping its symbols
fun negate(r: *core_syntax.Reader, e: Expr, at: usize) res[Expr, diagnostic.Diagnostic] {
    if (sel e.constant)   { ret res[Expr, diagnostic.Diagnostic].ok{Expr.constant{wrap_sub(0, e.constant)}}; }
    if (sel e.difference) { ret res[Expr, diagnostic.Diagnostic].ok{Expr.difference{Difference{plus: e.difference.minus, minus: e.difference.plus, addend: wrap_sub(0, e.difference.addend)}}}; }
    ret refused(r, NEGATED, at);
}

# `s` plus `n`
fun moved(s: operand.Symbol, n: i64) Expr {
    var t: operand.Symbol = s;
    t.addend = wrap_add(t.addend, n);
    ret Expr.symbol{t};
}

# `d` plus `n`
fun shifted(d: Difference, n: i64) Expr {
    var e: Difference = d;
    e.addend = wrap_add(e.addend, n);
    ret Expr.difference{e};
}

# `a` and `b` joined by `op`, `at` where `b` starts
fun combine(r: *core_syntax.Reader, op: *Operator, a: Expr, b: Expr, at: usize) res[Expr, diagnostic.Diagnostic] {
    if (sel a.constant) {
        if (sel b.constant) {
            val v: opt[i64] = op.apply(a.constant, b.constant);
            if (sel v.none) { ret refused(r, op.refusal, at); }
            ret res[Expr, diagnostic.Diagnostic].ok{Expr.constant{v.some}};
        }
        if (op.sign == NONE) { ret refused(r, NOT_CONSTANT, at); }
        if (op.sign == MINUS) {
            if (sel b.difference) { ret res[Expr, diagnostic.Diagnostic].ok{shifted(Difference{plus: b.difference.minus, minus: b.difference.plus, addend: wrap_sub(0, b.difference.addend)}, a.constant)}; }
            ret refused(r, NEGATED, at);
        }
        if (sel b.symbol)     { ret res[Expr, diagnostic.Diagnostic].ok{moved(b.symbol, a.constant)}; }
        if (sel b.difference) { ret res[Expr, diagnostic.Diagnostic].ok{shifted(b.difference, a.constant)}; }
    }
    if (op.sign == NONE) { ret refused(r, NOT_CONSTANT, at); }
    if (sel b.constant) {
        var n: i64 = b.constant;
        if (op.sign == MINUS) { n = wrap_sub(0, n); }
        if (sel a.symbol)     { ret res[Expr, diagnostic.Diagnostic].ok{moved(a.symbol, n)}; }
        if (sel a.difference) { ret res[Expr, diagnostic.Diagnostic].ok{shifted(a.difference, n)}; }
    }
    if (op.sign == PLUS) { ret refused(r, TWO_SYMBOLS, at); }
    if (sel a.symbol) {
        if (sel b.symbol) {
            val x: operand.Symbol = a.symbol;
            val y: operand.Symbol = b.symbol;
            if (x.fixup != operand.NO_FIXUP || y.fixup != operand.NO_FIXUP) { ret refused(r, SPECIFIED, at); }
            val n: i64 = wrap_sub(x.addend, y.addend);
            if (x.id == y.id) { ret res[Expr, diagnostic.Diagnostic].ok{Expr.constant{n}}; }
            ret res[Expr, diagnostic.Diagnostic].ok{Expr.difference{Difference{plus: x.id, minus: y.id, addend: n}}};
        }
    }
    ret refused(r, TWO_SYMBOLS, at);
}

# a unary operator and its operand, or a term
fun unary(r: *core_syntax.Reader, fixup: operand.FixupKind) res[Expr, diagnostic.Diagnostic] {
    val at: usize = r.at;
    if (read.take(r, "-")) {
        read.skip(r);
        val e: res[Expr, diagnostic.Diagnostic] = unary(r, fixup);
        if (sel e.err) { ret e; }
        ret negate(r, e.ok, at);
    }
    if (read.take(r, "+")) {
        read.skip(r);
        ret unary(r, fixup);
    }
    val inverts: bool = read.take(r, "~");
    val nots:    bool = !inverts && read.take(r, "!");
    if (inverts || nots) {
        read.skip(r);
        val e: res[Expr, diagnostic.Diagnostic] = unary(r, fixup);
        if (sel e.err)          { ret e; }
        if (!sel e.ok.constant) { ret refused(r, NOT_CONSTANT, at); }
        if (inverts)            { ret res[Expr, diagnostic.Diagnostic].ok{Expr.constant{~e.ok.constant}}; }
        ret res[Expr, diagnostic.Diagnostic].ok{Expr.constant{flag(e.ok.constant == 0)}};
    }
    ret term(r, fixup);
}

# operands joined by operators of `rank` or tighter. an operator with no operand after it is left unread, for
# the text that follows the expression
fun binary(r: *core_syntax.Reader, fixup: operand.FixupKind, rank: u8) res[Expr, diagnostic.Diagnostic] {
    val first: res[Expr, diagnostic.Diagnostic] = unary(r, fixup);
    if (sel first.err) { ret first; }
    var e: Expr = first.ok;
    for {
        val back: usize = r.at;
        read.skip(r);
        val op: *Operator = operator(r, rank);
        if (op == nil) {
            r.at = back;
            brk;
        }
        r.at = r.at + str_len(op.text);
        read.skip(r);
        if (!opens(r)) {
            r.at = back;
            brk;
        }
        val at:    usize                            = r.at;
        val right: res[Expr, diagnostic.Diagnostic] = binary(r, fixup, op.rank + 1);
        if (sel right.err) { ret right; }
        val joined: res[Expr, diagnostic.Diagnostic] = combine(r, op, e, right.ok, at);
        if (sel joined.err) { ret joined; }
        e = joined.ok;
    }
    ret res[Expr, diagnostic.Diagnostic].ok{e};
}

# an expression read at the position, for an operand whose default fixup kind is `fixup`
pub fun parse(r: *core_syntax.Reader, fixup: operand.FixupKind) res[Expr, diagnostic.Diagnostic] {
    ret binary(r, fixup, 1);
}

fun addend(w: *core_syntax.Writer, value: i64) err[field.Refusal] {
    if (value > 0) {
        val plus: err[field.Refusal] = write.text(w, "+");
        if (sel plus.err) { ret plus; }
    }
    if (value == 0) { ret err[field.Refusal].ok{}; }
    ret write.decimal(w, value);
}

# the symbol `s` written for operand `op`, whose default fixup kind is `fixup`, under the specifier spelling its kind.
# a symbol of the operand's own kind is written bare unless its kind was given, so a specifier names it there too
pub fun print_symbol(w: *core_syntax.Writer, s: operand.Symbol, fixup: operand.FixupKind, op: u8) err[field.Refusal] {
    if (w.symbols == nil) { ret write.refuse(w, write.NO_SPELLING, op); }
    val name: View                   = w.symbols.name(w.symbols.context, s.id);
    var spec: *core_syntax.Specifier = nil;
    var i:    u32                    = 0;
    for (i < w.syntax.specifiers.len && spec == nil && s.fixup != operand.NO_FIXUP) {
        val candidate: *core_syntax.Specifier = ?w.syntax.specifiers.at[i];
        if (candidate.operand == fixup && candidate.fixup == s.fixup) { spec = candidate; }
        i = i + 1;
    }
    if (spec == nil && (s.fixup == operand.NO_FIXUP || s.fixup == fixup)) {
        val named: err[field.Refusal] = write.view(w, name);
        if (sel named.err) { ret named; }
        ret addend(w, s.addend);
    }
    if (spec == nil) { ret write.refuse(w, write.NO_SPELLING, op); }
    val t:     str                = spec.template;
    val split: usize              = hole(t);
    val pre:   err[field.Refusal] = write.bytes(w, t, split);
    if (sel pre.err) { ret pre; }
    val named: err[field.Refusal] = write.view(w, name);
    if (sel named.err) { ret named; }
    # a binding specifier follows its symbol, and the addend follows it
    if (split == 0) {
        val post: err[field.Refusal] = write.text(w, ?t[3]);
        if (sel post.err) { ret post; }
        ret addend(w, s.addend);
    }
    val added: err[field.Refusal] = addend(w, s.addend);
    if (sel added.err) { ret added; }
    ret write.text(w, ?t[split + 3]);
}

# the default fixup kind of an immediate or relative operand
fun default_fixup(desc: *operand.Operand) operand.FixupKind {
    if (sel desc.shape.immediate) { ret desc.shape.immediate.fixup; }
    if (sel desc.shape.relative)  { ret desc.shape.relative.offset.fixup; }
    ret operand.NO_FIXUP;
}

fun immediate_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val at: usize                            = r.at;
    val e:  res[Expr, diagnostic.Diagnostic] = parse(r, default_fixup(desc));
    if (sel e.err) { ret err[diagnostic.Diagnostic].err{e.err}; }
    val got: Expr = e.ok;
    if (sel got.difference) { ret err[diagnostic.Diagnostic].err{read.refuse(r, DIFFERENCE, at, r.at - at)}; }
    if (sel got.symbol) {
        @out = operand.Value.symbol{got.symbol};
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (sel got.constant) {
        if (sel desc.shape.relative) { @out = operand.Value.relative{got.constant}; }
        or                           { @out = operand.Value.immediate{got.constant}; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

fun immediate_print(w: *core_syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    val op: u8 = field.NO_OPERAND;
    if (sel value.symbol)                                                         { ret print_symbol(w, value.symbol, default_fixup(desc), op); }
    if (sel value.relative)                                                       { ret write.decimal(w, value.relative); }
    if (!sel value.immediate)                                                     { ret write.refuse(w, write.NO_SPELLING, op); }
    if (sel desc.shape.immediate && desc.shape.immediate.format == operand.FLOAT) { ret write.hexadecimal(w, value.immediate:~u64); }
    ret write.decimal(w, value.immediate);
}

# immediates and relative targets as expressions: integers in decimal, a
# float as its bit pattern in hexadecimal, and symbols under the syntax's specifiers.
# a difference of symbols is the caller's to measure, never an instruction's
pub val IMMEDIATE: core_syntax.Hook = core_syntax.Hook{parse: immediate_parse, print: immediate_print};
