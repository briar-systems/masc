# operand expressions: constants and symbols with an addend, under the syntax's specifiers
#
# an expression is a sum of terms, each a number, a name or a specifier.
# a name resolves through the caller's symbols to a constant or a symbol,
# and at most one symbol is added, never subtracted. a specifier gives the
# symbol its fixup kind, by the specifier row for the fixup kind the operand
# takes by default, and folds a constant when its row says how. the full
# assembler expressions of the source model extend these terms.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use masc.core.diagnostic;
use masc.core.field;
use masc.core.operand;
use masc.core.spelling;
use masc.syntax.read;
use masc.syntax.write;

pub val TWO_SYMBOLS:    str = "expression names two symbols";
pub val NEGATED:        str = "a symbol cannot be subtracted";
pub val NOT_ADMITTED:   str = "specifier not admitted by the operand";
pub val CONSTANT:       str = "specifier takes no constant";
pub val TWO_SPECIFIERS: str = "symbol given two specifiers";
pub val NO_SYMBOLS:     str = "no symbols are known here";

# an operand expression, evaluated
# ---
# constant: an absolute value
# symbol:   a symbol plus an addend, its fixup kind operand.NO_FIXUP for the operand's default
pub tag Expr: u8 {
    constant: i64;
    symbol:   operand.Symbol;
}

# the offset of the hole in a specifier's template
fun hole(template: str) usize {
    var i: usize = 0;
    for (template[i] != 0) {
        if (template[i] == '<' && template[i + 1] == '0' && template[i + 2] == '>') { ret i; }
        i = i + 1;
    }
    ret i;
}

# the specifier row spelled `template` for an operand of default kind `fixup`
fun row_for(syntax: *spelling.Syntax, template: str, fixup: operand.FixupKind) opt[*spelling.Specifier] {
    var i: u32 = 0;
    for (i < syntax.specifiers.len) {
        val s: *spelling.Specifier = ?syntax.specifiers.at[i];
        if (s.operand == fixup && str_equals(s.template, template)) { ret opt[*spelling.Specifier].some{s}; }
        i = i + 1;
    }
    ret opt[*spelling.Specifier].none{};
}

# the template of the longest specifier text at the position, wrapping ones when `wraps`, else binding ones
fun longest(r: *spelling.Reader, wraps: bool) opt[str] {
    var best: usize    = 0;
    var got:  opt[str] = opt[str].none{};
    var i:    u32      = 0;
    for (i < r.syntax.specifiers.len) {
        val t:  str   = r.syntax.specifiers.at[i].template;
        val at: usize = hole(t);
        if (wraps && at > best && read.starts(r, r.at, t, at)) {
            best = at;
            got  = opt[str].some{t};
        }
        if (!wraps && at == 0) {
            val len: usize = str_len(t) - 3;
            if (len > best && read.starts(r, r.at, ?t[3], len)) {
                best = len;
                got  = opt[str].some{t};
            }
        }
        i = i + 1;
    }
    ret got;
}

# `e` under the specifier spelled `template`, read from `at`
fun specify(r: *spelling.Reader, e: Expr, template: str, fixup: operand.FixupKind, at: usize) res[Expr, diagnostic.Diagnostic] {
    val spec: opt[*spelling.Specifier] = row_for(r.syntax, template, fixup);
    if (sel spec.none) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, NOT_ADMITTED, at, r.at - at)}; }
    if (sel e.constant) {
        if (spec.some.fold == nil) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, CONSTANT, at, r.at - at)}; }
        ret res[Expr, diagnostic.Diagnostic].ok{Expr.constant{spec.some.fold(e.constant)}};
    }
    var s: operand.Symbol = e.symbol;
    if (s.fixup != operand.NO_FIXUP) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, TWO_SPECIFIERS, at, r.at - at)}; }
    # a specifier that gives the kind the operand takes anyway states nothing, so the value is the one without it
    if (spec.some.fixup != fixup) { s.fixup = spec.some.fixup; }
    ret res[Expr, diagnostic.Diagnostic].ok{Expr.symbol{s}};
}

# one term: a wrapping specifier, a number, or a name with any binding specifier after it
fun term(r: *spelling.Reader, fixup: operand.FixupKind) res[Expr, diagnostic.Diagnostic] {
    val at:    usize    = r.at;
    val wraps: opt[str] = longest(r, true);
    if (sel wraps.some) {
        val t:     str   = wraps.some;
        val split: usize = hole(t);
        r.at = r.at + split;
        val inner: res[Expr, diagnostic.Diagnostic] = parse(r, fixup);
        if (sel inner.err)                { ret inner; }
        if (!read.take(r, ?t[split + 3])) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, read.UNEXPECTED, r.at, read.token(r, r.at))}; }
        ret specify(r, inner.ok, t, fixup, at);
    }
    val c: u8 = read.peek(r);
    if (c >= '0' && c <= '9') {
        val n: res[i64, diagnostic.Diagnostic] = read.number(r);
        if (sel n.err) { ret res[Expr, diagnostic.Diagnostic].err{n.err}; }
        ret res[Expr, diagnostic.Diagnostic].ok{Expr.constant{n.ok}};
    }
    val len: usize = read.name(r);
    if (len == 0)         { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, at, read.token(r, at))}; }
    if (r.symbols == nil) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, NO_SYMBOLS, at, len)}; }
    val resolved: res[spelling.Resolved, str] = r.symbols.resolve(r.symbols.context, read.span(r, at, len));
    if (sel resolved.err) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, resolved.err, at, len)}; }
    r.at = at + len;
    var e:   Expr              = Expr.constant{0};
    val got: spelling.Resolved = resolved.ok;
    if (sel got.constant) { e = Expr.constant{got.constant}; }
    if (sel got.symbol)   { e = Expr.symbol{operand.Symbol{id: got.symbol, addend: 0, fixup: operand.NO_FIXUP}}; }
    val binds: opt[str] = longest(r, false);
    if (sel binds.none) { ret res[Expr, diagnostic.Diagnostic].ok{e}; }
    r.at = r.at + str_len(binds.some) - 3;
    ret specify(r, e, binds.some, fixup, at);
}

# an expression read at the position, for an operand whose default fixup kind is `fixup`
pub fun parse(r: *spelling.Reader, fixup: operand.FixupKind) res[Expr, diagnostic.Diagnostic] {
    var sum:    i64            = 0;
    var symbol: operand.Symbol = operand.Symbol{id: operand.NO_SYMBOL, addend: 0, fixup: operand.NO_FIXUP};
    var first:  bool           = true;
    for {
        var minus: bool  = false;
        val back:  usize = r.at;
        if (!first) { read.skip(r); }
        if (read.take(r, "-")) {
            minus = true;
        }
        or (!first && !read.take(r, "+")) {
            r.at = back;
            brk;
        }
        if (!first) { read.skip(r); }
        val at: usize                            = r.at;
        val t:  res[Expr, diagnostic.Diagnostic] = term(r, fixup);
        if (sel t.err) { ret t; }
        val got: Expr = t.ok;
        if (sel got.constant) {
            if (minus) { sum = sum - got.constant; }
            or         { sum = sum + got.constant; }
        }
        if (sel got.symbol) {
            if (minus)                          { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, NEGATED, at, r.at - at)}; }
            if (symbol.id != operand.NO_SYMBOL) { ret res[Expr, diagnostic.Diagnostic].err{read.refuse(r, TWO_SYMBOLS, at, r.at - at)}; }
            symbol = got.symbol;
        }
        first = false;
    }
    if (symbol.id == operand.NO_SYMBOL) { ret res[Expr, diagnostic.Diagnostic].ok{Expr.constant{sum}}; }
    symbol.addend = symbol.addend + sum;
    ret res[Expr, diagnostic.Diagnostic].ok{Expr.symbol{symbol}};
}

fun addend(w: *spelling.Writer, value: i64) err[field.Refusal] {
    if (value > 0) {
        val plus: err[field.Refusal] = write.text(w, "+");
        if (sel plus.err) { ret plus; }
    }
    if (value == 0) { ret err[field.Refusal].ok{}; }
    ret write.decimal(w, value);
}

# the symbol `s` written for operand `op`, whose default fixup kind is `fixup`, under the specifier spelling its kind
pub fun print_symbol(w: *spelling.Writer, s: operand.Symbol, fixup: operand.FixupKind, op: u8) err[field.Refusal] {
    if (w.symbols == nil) { ret write.refuse(w, write.NO_SPELLING, op); }
    val name: View = w.symbols.name(w.symbols.context, s.id);
    if (s.fixup == operand.NO_FIXUP || s.fixup == fixup) {
        val named: err[field.Refusal] = write.view(w, name);
        if (sel named.err) { ret named; }
        ret addend(w, s.addend);
    }
    var spec: *spelling.Specifier = nil;
    var i:    u32                 = 0;
    for (i < w.syntax.specifiers.len && spec == nil) {
        val candidate: *spelling.Specifier = ?w.syntax.specifiers.at[i];
        if (candidate.operand == fixup && candidate.fixup == s.fixup) { spec = candidate; }
        i = i + 1;
    }
    if (spec == nil) { ret write.refuse(w, write.NO_SPELLING, op); }
    val t:     str                = spec.template;
    val split: usize              = hole(t);
    val pre:   err[field.Refusal] = write.bytes(w, t, split);
    if (sel pre.err) { ret pre; }
    val named: err[field.Refusal] = write.view(w, name);
    if (sel named.err) { ret named; }
    # a binding specifier follows its symbol, and the addend follows it
    if (split == 0) {
        val post: err[field.Refusal] = write.text(w, ?t[3]);
        if (sel post.err) { ret post; }
        ret addend(w, s.addend);
    }
    val added: err[field.Refusal] = addend(w, s.addend);
    if (sel added.err) { ret added; }
    ret write.text(w, ?t[split + 3]);
}

# the default fixup kind of an immediate or relative operand
fun default_fixup(desc: *operand.Operand) operand.FixupKind {
    if (sel desc.shape.immediate) { ret desc.shape.immediate.fixup; }
    if (sel desc.shape.relative)  { ret desc.shape.relative.offset.fixup; }
    ret operand.NO_FIXUP;
}

fun immediate_parse(r: *spelling.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val e: res[Expr, diagnostic.Diagnostic] = parse(r, default_fixup(desc));
    if (sel e.err) { ret err[diagnostic.Diagnostic].err{e.err}; }
    val got: Expr = e.ok;
    if (sel got.symbol) {
        @out = operand.Value.symbol{got.symbol};
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (sel got.constant) {
        if (sel desc.shape.relative) { @out = operand.Value.relative{got.constant}; }
        or                           { @out = operand.Value.immediate{got.constant}; }
    }
    ret err[diagnostic.Diagnostic].ok{};
}

fun immediate_print(w: *spelling.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    val op: u8 = field.NO_OPERAND;
    if (sel value.symbol)                                                         { ret print_symbol(w, value.symbol, default_fixup(desc), op); }
    if (sel value.relative)                                                       { ret write.decimal(w, value.relative); }
    if (!sel value.immediate)                                                     { ret write.refuse(w, write.NO_SPELLING, op); }
    if (sel desc.shape.immediate && desc.shape.immediate.format == operand.FLOAT) { ret write.hexadecimal(w, value.immediate:~u64); }
    ret write.decimal(w, value.immediate);
}

# immediates and relative targets as expressions: integers in decimal, a
# float as its bit pattern in hexadecimal, and symbols under the syntax's specifiers
pub val IMMEDIATE: spelling.Hook = spelling.Hook{parse: immediate_parse, print: immediate_print};
