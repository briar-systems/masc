# the instruction printer: an encoded instruction value written in a syntax
#
# the printer writes a value by the preferred alias of its row that applies
# to it, or by its row's template when none does, so `masc.syntax.parse`
# reads the text back to the same value.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.codec.walk;
use masc.core.ct;
use masc.core.effect;
use masc.core.field;
use core_form: masc.core.form;
use masc.core.inst;
use masc.core.mode;
use masc.core.operand;
use masc.core.register;
use masc.core.requirement;
use masc.core.row;
use masc.core.state;
use masc.core.syntax;
use masc.syntax.alias;
use masc.syntax.expr;
use seq: masc.syntax.sequence;
use masc.syntax.write;

# the index of `r` among the codec's rows, the row count for a row that is not one of them
pub fun row_index(w: *syntax.Writer, r: *row.Row) u32 {
    if (!row.of(w.codec.rows, r)) { ret w.codec.rows.len; }
    ret r.index;
}

# one value of `desc`, a member of a variadic operand or the whole of any other
fun one(w: *syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value, op: u8) err[field.Refusal] {
    val shape: *operand.Shape = ?desc.shape;
    if (sel shape.register) {
        if (!sel value.register) { ret write.refuse(w, write.NO_SPELLING, op); }
        ret write.register_name(w, value.register, op);
    }
    if (sel shape.enumerant) {
        if (!sel value.enumerant) { ret write.refuse(w, write.NO_SPELLING, op); }
        ret write.enumeration(w, ?shape.enumerant, value.enumerant, op);
    }
    if (sel shape.condition) {
        if (!sel value.condition) { ret write.refuse(w, write.NO_SPELLING, op); }
        ret write.enumeration(w, ?shape.condition, value.condition, op);
    }
    if (sel shape.group) {
        if (!sel value.group) { ret write.refuse(w, write.NO_SPELLING, op); }
        val members: operand.Values = value.group;
        if (members.len != shape.group.len) { ret write.refuse(w, write.NO_SPELLING, op); }
        var i: u32 = 0;
        for (i < members.len) {
            if (i > 0) {
                val joined: err[field.Refusal] = write.text(w, w.syntax.variadic);
                if (sel joined.err) { ret joined; }
            }
            val spelled: err[field.Refusal] = one(w, ?shape.group.at[i], format, ?members.at[i], op);
            if (sel spelled.err) { ret spelled; }
            i = i + 1;
        }
        ret err[field.Refusal].ok{};
    }
    val h: *syntax.Hook = syntax.hook(w.syntax, shape);
    if (h == nil) { ret write.refuse(w, write.NO_SPELLING, op); }
    val done: err[field.Refusal] = h.print(w, desc, format, value);
    if (sel done.err) {
        var refused: field.Refusal = done.err;
        if (refused.operand == field.NO_OPERAND) { refused.operand = op; }
        ret err[field.Refusal].err{refused};
    }
    ret done;
}

# operand `op`'s value written by its hole
fun hole(w: *syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value, op: u8) err[field.Refusal] {
    if (desc.quantity != operand.VARIADIC) { ret one(w, desc, format, value, op); }
    if (!sel value.list)                   { ret write.refuse(w, write.NO_SPELLING, op); }
    val members: operand.Values = value.list;
    var i:       u32            = 0;
    for (i < members.len) {
        if (i > 0) {
            val joined: err[field.Refusal] = write.text(w, w.syntax.variadic);
            if (sel joined.err) { ret joined; }
        }
        val spelled: err[field.Refusal] = one(w, desc, format, ?members.at[i], op);
        if (sel spelled.err) { ret spelled; }
        i = i + 1;
    }
    ret err[field.Refusal].ok{};
}

# whether every operand of the group opening at `at` is present
fun present(template: str, at: usize, values: *operand.Value) bool {
    var p: syntax.Piece = syntax.piece(template, at);
    for (p.kind != syntax.CLOSE && p.kind != syntax.END) {
        if (p.kind == syntax.HOLE) {
            val v: *operand.Value = ?values[p.operand];
            if (sel v.none) { ret false; }
        }
        p = syntax.piece(template, p.at + p.len);
    }
    ret true;
}

# the offset just past the group opening at `at`
fun past(template: str, at: usize) usize {
    var p: syntax.Piece = syntax.piece(template, at);
    for (p.kind != syntax.CLOSE && p.kind != syntax.END) {
        p = syntax.piece(template, p.at + p.len);
    }
    ret p.at + p.len;
}

# `template` written over `values`, hole n read by `descs[n]`
fun spell(w: *syntax.Writer, template: str, descs: **operand.Operand, values: *operand.Value) err[field.Refusal] {
    var at: usize = 0;
    for {
        val p: syntax.Piece = syntax.piece(template, at);
        if (p.kind == syntax.END) { brk; }
        at = p.at + p.len;
        if (p.kind == syntax.OPEN && !present(template, p.at + p.len, values)) {
            at = past(template, p.at + p.len);
        }
        or (p.kind == syntax.TEXT || p.kind == syntax.SPACE) {
            val wrote: err[field.Refusal] = write.bytes(w, ?template[p.at], 1);
            if (sel wrote.err) { ret wrote; }
        }
        or (p.kind == syntax.HOLE) {
            val spelled: err[field.Refusal] = hole(w, descs[p.operand], p.format, ?values[p.operand], p.operand);
            if (sel spelled.err) { ret spelled; }
        }
    }
    ret err[field.Refusal].ok{};
}

# the text from `start` on without the spaces a template's last optional group leaves
fun trimmed(w: *syntax.Writer, start: usize) {
    for (w.out.len > start && w.out.data[w.out.len - 1] == ' ') {
        w.out.len = w.out.len - 1;
    }
}

# whether the writer's context admits `required`, as an alias or a sequence needs, which none does when there is no
# context
fun admitted(w: *syntax.Writer, required: requirement.Requirement) bool {
    if (required.len == 0) { ret true; }
    if (w.ctx == nil)      { ret false; }
    ret state.admits(w.ctx, required);
}

# `ins`, a value of the base row of alias `a`, appended as that alias
# ---
# ret: ok, or the refusal of an alias that does not apply or a value nothing spells, with the output left as it was
pub fun as_alias(w: *syntax.Writer, a: *syntax.Alias, ins: *inst.Inst) err[field.Refusal] {
    val r:      *row.Row = ins.row;
    val start:  usize    = w.out.len;
    var values: [row.MAX_OPERANDS]operand.Value;
    if (row_index(w, r) != a.row || !admitted(w, a.requires) || !alias.applies(w.codec, a, ins.values, ?values[0])) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    var descs: [row.MAX_OPERANDS]*operand.Operand;
    var k:     u32 = 0;
    for (k < row.MAX_OPERANDS) {
        descs[k] = syntax.alias_operand(a, r, k::u8);
        k        = k + 1;
    }
    w.row = r;
    val spelled: err[field.Refusal] = spell(w, a.template, ?descs[0], ?values[0]);
    if (sel spelled.err) {
        w.out.len = start;
        ret spelled;
    }
    trimmed(w, start);
    ret err[field.Refusal].ok{};
}

# `text` appended to the writer's output
fun put(w: *syntax.Writer, text: str) err[field.Refusal] {
    var i: usize = 0;
    for (text[i] != 0) {
        val pushed: res[usize, A.Error] = vector.push[u8](w.out, text[i]);
        if (sel pushed.err) { ret write.refuse(w, field.MEMORY, field.NO_OPERAND); }
        i = i + 1;
    }
    ret err[field.Refusal].ok{};
}

# the markers of the choices of `ins`'s form that precede the mnemonic, each followed by a space. a decoded
# instruction's form holds only what its encoding states beyond the preference, so every choice it holds is printed
fun leading(w: *syntax.Writer, ins: *inst.Inst) err[field.Refusal] {
    val forms: *core_form.FormFields = ?w.codec.forms;
    var i:     u32                   = 0;
    for (i < forms.len) {
        val f: *core_form.FormField = ?forms.at[i];
        if (f.marker != nil && !f.suffix && core_form.holds(ins.form, f)) {
            val marker: err[field.Refusal] = put(w, f.marker);
            if (sel marker.err) { ret marker; }
            val gap: err[field.Refusal] = put(w, " ");
            if (sel gap.err) { ret gap; }
        }
        i = i + 1;
    }
    ret err[field.Refusal].ok{};
}

# the marker of the choice of `ins`'s form that follows the mnemonic, written from `from`, inserted where it ends
fun trailing(w: *syntax.Writer, ins: *inst.Inst, from: usize) err[field.Refusal] {
    val forms: *core_form.FormFields = ?w.codec.forms;
    var i:     u32                   = 0;
    for (i < forms.len) {
        val f: *core_form.FormField = ?forms.at[i];
        if (f.marker != nil && f.suffix && core_form.holds(ins.form, f)) {
            var end: usize = from;
            for (end < w.out.len && w.out.data[end] != ' ' && w.out.data[end] != '\t') { end = end + 1; }
            val tail:   usize              = w.out.len;
            val marker: err[field.Refusal] = put(w, f.marker);
            if (sel marker.err) { ret marker; }
            # the text after the mnemonic moves past the marker
            val len: usize = w.out.len - tail;
            var k:   usize = tail;
            for (k > end) {
                k = k - 1;
                val c: u8 = w.out.data[k];
                w.out.data[k + len] = c;
            }
            var j: usize = 0;
            for (j < len) {
                w.out.data[end + j] = f.marker[j];
                j                   = j + 1;
            }
            ret err[field.Refusal].ok{};
        }
        i = i + 1;
    }
    ret err[field.Refusal].ok{};
}

# `ins` appended to the writer's output in its syntax, by the preferred alias that applies or by its row, with the
# markers of its form
# ---
# ret: ok, or the refusal of a value nothing spells, with the output left as it was
pub fun instruction(w: *syntax.Writer, ins: *inst.Inst) err[field.Refusal] {
    val start: usize              = w.out.len;
    val led:   err[field.Refusal] = leading(w, ins);
    if (sel led.err) {
        w.out.len = start;
        ret led;
    }
    val from:  usize              = w.out.len;
    val body:  err[field.Refusal] = unmarked(w, ins);
    var trail: err[field.Refusal] = body;
    if (!(sel body.err)) { trail = trailing(w, ins, from); }
    if (sel trail.err)   { w.out.len = start; }
    ret trail;
}

# `ins` appended by the preferred alias that applies or by its row, without its form's markers
fun unmarked(w: *syntax.Writer, ins: *inst.Inst) err[field.Refusal] {
    val r:     *row.Row = ins.row;
    val index: u32      = row_index(w, r);
    if (index >= w.codec.rows.len) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    var chosen: *syntax.Alias = nil;
    # the aliases are in row order, so those of this row start at a binary search's lower bound
    var lo: u32 = 0;
    var hi: u32 = w.syntax.aliases.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (w.syntax.aliases.at[mid].row < index) { lo = mid + 1; }
        or                                        { hi = mid; }
    }
    var i: u32 = lo;
    for (i < w.syntax.aliases.len && w.syntax.aliases.at[i].row == index) {
        val a: *syntax.Alias = ?w.syntax.aliases.at[i];
        if (a.preference > 0 && admitted(w, a.requires) && (chosen == nil || a.preference > chosen.preference)) {
            var held: [row.MAX_OPERANDS]operand.Value;
            if (alias.applies(w.codec, a, ins.values, ?held[0])) { chosen = a; }
        }
        i = i + 1;
    }
    if (chosen != nil) { ret as_alias(w, chosen, ins); }
    ret templated(w, w.syntax.forms.at[index], ins);
}

# `ins` appended to the writer's output by its row's own template, whatever alias would apply, with the markers of its
# form
# ---
# ret: ok, or the refusal of a value nothing spells, with the output left as it was
pub fun form(w: *syntax.Writer, ins: *inst.Inst) err[field.Refusal] {
    val start: usize              = w.out.len;
    val led:   err[field.Refusal] = leading(w, ins);
    if (sel led.err) {
        w.out.len = start;
        ret led;
    }
    val index: u32 = row_index(w, ins.row);
    if (index >= w.codec.rows.len) {
        w.out.len = start;
        ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND);
    }
    val from:  usize              = w.out.len;
    val body:  err[field.Refusal] = templated(w, w.syntax.forms.at[index], ins);
    var trail: err[field.Refusal] = body;
    if (!(sel body.err)) { trail = trailing(w, ins, from); }
    if (sel trail.err)   { w.out.len = start; }
    ret trail;
}

# `ins` appended to the writer's output by `template`, as a format of a source dialect's instruction directive spells
# its operands after the directive
# ---
# ret: ok, or the refusal of a value nothing spells, with the output left as it was
pub fun templated(w: *syntax.Writer, template: str, ins: *inst.Inst) err[field.Refusal] {
    val r:     *row.Row = ins.row;
    val start: usize    = w.out.len;
    var descs: [row.MAX_OPERANDS]*operand.Operand;
    var k:     u32      = 0;
    for (k < r.operands.len) {
        descs[k] = ?r.operands.at[k];
        k        = k + 1;
    }
    w.row = r;
    val spelled: err[field.Refusal] = spell(w, template, ?descs[0], ins.values);
    if (sel spelled.err) {
        w.out.len = start;
        ret spelled;
    }
    trimmed(w, start);
    ret err[field.Refusal].ok{};
}

# the `count` instructions at `steps` appended as one statement, by the first sequence spelling of the syntax that spells
# them and holds under the writer's modes
# ---
# here: the handle of the label at the first instruction, operand.NO_SYMBOL when the caller knows none
# ret:  whether one does, with the output as it was when none does or its spelling is refused
pub fun sequence(w: *syntax.Writer, steps: *inst.Inst, count: u32, here: u32) res[bool, field.Refusal] {
    if (count == 0) { ret res[bool, field.Refusal].ok{false}; }
    val first: *row.Row = steps[0].row;
    var i:     u32      = seq.first_of(w.syntax, w.codec.rows, first);
    for (i < w.syntax.sequences.len && w.syntax.sequences.at[i].steps.at[0].row == first) {
        val q: *syntax.Sequence = ?w.syntax.sequences.at[i];
        i = i + 1;
        var values: [row.MAX_OPERANDS]operand.Value;
        if (!mode.holds(w.modes, q.when))                   { cnt; }
        if (!admitted(w, q.requires))                       { cnt; }
        if (!seq.spells(q, steps, count, here, ?values[0])) { cnt; }
        var descs: [row.MAX_OPERANDS]*operand.Operand;
        var k:     u32 = 0;
        for (k < q.operands.len) {
            descs[k] = ?q.operands.at[k];
            k        = k + 1;
        }
        val start: usize = w.out.len;
        w.row = first;
        val spelled: err[field.Refusal] = spell(w, q.template, ?descs[0], ?values[0]);
        if (sel spelled.err) {
            w.out.len = start;
            ret res[bool, field.Refusal].err{spelled.err};
        }
        trimmed(w, start);
        ret res[bool, field.Refusal].ok{true};
    }
    ret res[bool, field.Refusal].ok{false};
}
