# the one symbol of the tests, `far`, is handle 1
#[testing]
fun t_resolve(context: ptr, name: View) res[spelling.Resolved, str] {
    if (view_eq_str(name, "far")) { ret res[spelling.Resolved, str].ok{spelling.Resolved.symbol{1}}; }
    ret res[spelling.Resolved, str].err{"unknown symbol"};
}

#[testing]
fun t_name(context: ptr, id: u32) View {
    ret view("far", 3);
}

#[testing]
pub val T_SYMBOLS: spelling.Symbols = spelling.Symbols{context: nil, resolve: t_resolve, name: t_name};

# whether `ins` prints as exactly `want`
#[testing]
pub fun t_prints(out: *vector.Vector[u8], ins: *inst.Inst, want: str) bool {
    out.len = 0;
    var w:       spelling.Writer    = spelling.Writer{out: out, codec: ?T_CODEC, syntax: ?T_SYNTAX, symbols: ?T_SYMBOLS, context: nil, row: nil};
    val printed: err[field.Refusal] = instruction(?w, ins);
    if (sel printed.err) { ret false; }
    ret view_eq_str(view(out.data, out.len), want);
}

test instruction__an_alias_prints_only_when_its_condition_holds {
    var t: testing.Testing;
    testing.make(?t);
    var out:  vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t));
    val rd:   [5]u16            = [5]u16{5, 5, 0, 5, 5};
    val rs:   [5]u16            = [5]u16{5, 5, 0, 0, 0};
    val imm:  [5]i64            = [5]i64{0, 1, 0, 3, 0};
    val want: [5]str            = [5]str{"mv x5, x5", "addi x5, x5, 1", "nop", "li x5, 3", "mv x5, x0"};
    var i:    u32               = 0;
    for (i < 5) {
        var values: [3]operand.Value = [3]operand.Value{operand.Value.register{register.make(0, rd[i])}, operand.Value.register{register.make(0, rs[i])}, operand.Value.immediate{imm[i]}};
        var ins:    inst.Inst        = inst.Inst{row: ?T_CODEC.rows.at[0], values: ?values[0], count: 3};
        if (!t_prints(?out, ?ins, want[i])) { ret 1 + i::i32; }
        i = i + 1;
    }
    vector.dnit[u8](?out);
    ret 0;
}
