# reading instruction text: the cursor, the refusals, and the operands spelled from their one table
#
# every function here reads at a `spelling.Reader`'s position and moves it
# only past what it accepts. registers are read from the register file's
# names and aliases through the selection's view, and enumerants and
# conditions from their enumeration's members, so the parser and the printer
# read one table.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.field;
use masc.core.index;
use masc.core.operand;
use masc.core.register;
use masc.core.requirement;
use masc.core.spelling;

pub val UNEXPECTED:       str = "unexpected text";
pub val UNKNOWN_MNEMONIC: str = "unknown mnemonic";
pub val OTHER_MODE:       str = "spelling not read under the assembler's modes";
pub val UNKNOWN_REGISTER: str = "not a register name";
pub val NOT_A_MEMBER:     str = "not a name the operand admits";
pub val MALFORMED:        str = "malformed number";
pub val EXPECTED:         str = "expected an operand";

# whether `c` continues a word, so a name may not end before it
pub fun word(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

# whether `c` is white space between tokens
pub fun blank(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\r' || c == '\n';
}

# the byte at the reader's position, 0 at the end of the instruction
pub fun peek(r: *spelling.Reader) u8 {
    if (r.at >= r.end) { ret 0; }
    ret r.text[r.at];
}

# the reader moved past white space
pub fun skip(r: *spelling.Reader) {
    for (r.at < r.end && blank(r.text[r.at])) {
        r.at = r.at + 1;
    }
}

# a refusal of `message` at the text from `at` for `len` bytes
pub fun refuse(r: *spelling.Reader, message: str, at: usize, len: usize) diagnostic.Diagnostic {
    ret diagnostic.refusal(message, r.origin, ?r.text[r.start], at - r.start, len);
}

# a refusal at the text from `at` for `len` bytes of what the selection does not admit, which it would have admitted holding `required`
pub fun refuse_unmet(r: *spelling.Reader, required: requirement.Requirement, at: usize, len: usize) diagnostic.Diagnostic {
    ret diagnostic.unmet(field.NOT_ADMITTED, required, r.origin, ?r.text[r.start], at - r.start, len);
}

# the length of the word at `at`, at least one byte when the instruction has one left
pub fun token(r: *spelling.Reader, at: usize) usize {
    var i: usize = at;
    for (i < r.end && (word(r.text[i]) || r.text[i] == '.' || r.text[i] == '$')) {
        i = i + 1;
    }
    if (i == at && at < r.end) { ret 1; }
    ret i - at;
}

# whether bytes `a` and `b` read as one under the syntax's case rule
pub fun same(r: *spelling.Reader, a: u8, b: u8) bool {
    if (r.syntax.fold) { ret spelling.lower(a) == spelling.lower(b); }
    ret a == b;
}

# whether the text at `at` begins with `len` bytes of `text`
pub fun starts(r: *spelling.Reader, at: usize, text: *u8, len: usize) bool {
    if (at > r.end || r.end - at < len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (!same(r, r.text[at + i], text[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether a name of `len` bytes read at `at`, ending in `last`, ends at a word boundary
pub fun bounded(r: *spelling.Reader, at: usize, len: usize, last: u8) bool {
    val next: usize = at + len;
    ret !word(last) || next >= r.end || !word(r.text[next]);
}

# `text` read and passed when the reader's text begins with it
pub fun take(r: *spelling.Reader, text: str) bool {
    val len: usize = str_len(text);
    if (!starts(r, r.at, text, len)) { ret false; }
    r.at = r.at + len;
    ret true;
}

# a register the operand admits read through the selection's view: the
# longest name or alias at the position, after the syntax's register prefix
pub fun register_value(r: *spelling.Reader) res[register.Id, diagnostic.Diagnostic] {
    val at:   usize          = r.at;
    val file: *register.File = r.codec.registers;
    if (file == nil || !take(r, r.syntax.register)) { ret res[register.Id, diagnostic.Diagnostic].err{refuse(r, UNKNOWN_REGISTER, at, token(r, at))}; }
    val from: usize       = r.at;
    var best: usize       = 0;
    var id:   register.Id = register.NONE;
    # the longest name that ends at a word boundary is the longest prefix of the token the name index holds
    var len: usize = token(r, from);
    for (len > 0 && best == 0) {
        if (bounded(r, from, len, r.text[from + len - 1])) {
            val found: opt[register.Id] = register.named(file, span(r, from, len), r.syntax.fold);
            if (sel found.some) {
                best = len;
                id   = found.some;
            }
        }
        len = len - 1;
    }
    if (best == 0) {
        r.at = at;
        ret res[register.Id, diagnostic.Diagnostic].err{refuse(r, UNKNOWN_REGISTER, at, token(r, from) + from - at)};
    }
    val held: err[register.Absent] = register.admitted(r.available, id);
    if (sel held.err) {
        r.at = at;
        ret res[register.Id, diagnostic.Diagnostic].err{refuse(r, field.UNAVAILABLE, at, best + from - at)};
    }
    r.at = from + best;
    ret res[register.Id, diagnostic.Diagnostic].ok{id};
}

# the member of `e` whose name is longest at the position and ends at a word boundary, read through its name index. a prefix of the
# text no name begins with ends the search, so it reads no further than the longest name. a member with an empty name is the value of
# text that names no other member, as risc-v's unmasked `vm`, and reads nothing
fun member(r: *spelling.Reader, e: *operand.Enumeration) opt[u32] {
    val names: *index.Index = ?e.names;
    var best:  usize        = 0;
    var row:   u32          = 0;
    var len:   usize        = 1;
    for (r.at + len <= r.end) {
        val text: View = span(r, r.at, len);
        val at:   u32  = index.lower_bound(names, text, r.syntax.fold);
        if (at >= names.len || !index.begins(names.at[at].key, text, r.syntax.fold)) { brk; }
        if (index.compare(names.at[at].key, text, r.syntax.fold) == 0 && bounded(r, r.at, len, r.text[r.at + len - 1])) {
            best = len;
            row  = names.at[at].row;
        }
        len = len + 1;
    }
    if (best == 0) {
        val blank: opt[u32] = index.find(names, "");
        if (sel blank.none) { ret blank; }
        ret opt[u32].some{e.members[blank.some].value};
    }
    r.at = r.at + best;
    ret opt[u32].some{e.members[row].value};
}

# a value of `e` read by its members' names, a mask as members joined by the syntax's join
pub fun enumeration(r: *spelling.Reader, e: *operand.Enumeration) res[u32, diagnostic.Diagnostic] {
    val at:    usize    = r.at;
    val first: opt[u32] = member(r, e);
    if (sel first.none) { ret res[u32, diagnostic.Diagnostic].err{refuse(r, NOT_A_MEMBER, at, token(r, at))}; }
    var value: u32 = first.some;
    for (e.mask) {
        val back: usize = r.at;
        if (!take(r, r.syntax.join)) { brk; }
        val next: opt[u32] = member(r, e);
        if (sel next.none) {
            r.at = back;
            brk;
        }
        # a member that reads nothing ends the mask
        if (r.at == back + str_len(r.syntax.join)) {
            r.at = back;
            brk;
        }
        value = value | next.some;
    }
    ret res[u32, diagnostic.Diagnostic].ok{value};
}

# a pool slot holding `value`, for a member of a list or a variadic operand
pub fun push(r: *spelling.Reader, value: operand.Value) res[*operand.Value, diagnostic.Diagnostic] {
    if (r.used >= r.cap) { ret res[*operand.Value, diagnostic.Diagnostic].err{refuse(r, field.STORAGE, r.at, 0)}; }
    val slot: *operand.Value = ?r.pool[r.used];
    @slot  = value;
    r.used = r.used + 1;
    ret res[*operand.Value, diagnostic.Diagnostic].ok{slot};
}

# `len` bytes of literal storage, for a literal whose bytes the text does not hold as they are
pub fun reserve(r: *spelling.Reader, len: u32) res[*u8, diagnostic.Diagnostic] {
    if (len > r.room - r.taken) { ret res[*u8, diagnostic.Diagnostic].err{refuse(r, field.STORAGE, r.at, 0)}; }
    val bytes: *u8 = ?r.bytes[r.taken];
    r.taken = r.taken + len;
    ret res[*u8, diagnostic.Diagnostic].ok{bytes};
}

fun digit(c: u8, base: u64) opt[u64] {
    var d: u64 = 99;
    if (c >= '0' && c <= '9') { d = (c - '0')::u64; }
    or (c >= 'a' && c <= 'f') { d = (c - 'a')::u64 + 10; }
    or (c >= 'A' && c <= 'F') { d = (c - 'A')::u64 + 10; }
    if (d >= base)            { ret opt[u64].none{}; }
    ret opt[u64].some{d};
}

# an unsigned number: decimal, or hexadecimal, binary or octal after 0x, 0b or 0o, or octal after a
# leading 0 as the gnu assembler reads `010`, of up to 64 bits, read as its bit pattern
pub fun number(r: *spelling.Reader) res[i64, diagnostic.Diagnostic] {
    val at:   usize = r.at;
    val len:  usize = token(r, at);
    var i:    usize = at;
    var base: u64   = 10;
    if (len > 2 && r.text[at] == '0') {
        val p: u8 = spelling.lower(r.text[at + 1]);
        if (p == 'x')   { base = 16; }
        or (p == 'b')   { base = 2; }
        or (p == 'o')   { base = 8; }
        if (base != 10) { i = at + 2; }
    }
    if (base == 10 && len > 1 && r.text[at] == '0' && r.text[at + 1] >= '0' && r.text[at + 1] <= '9') {
        base = 8;
        i    = at + 1;
    }
    var value: u64 = 0;
    if (i == at + len || !(r.text[at] >= '0' && r.text[at] <= '9')) { ret res[i64, diagnostic.Diagnostic].err{refuse(r, MALFORMED, at, len)}; }
    for (i < at + len) {
        val d: opt[u64] = digit(r.text[i], base);
        if (sel d.none) { ret res[i64, diagnostic.Diagnostic].err{refuse(r, MALFORMED, at, len)}; }
        val n: u64 = d.some;
        if (value > (~0::u64 - n) / base) { ret res[i64, diagnostic.Diagnostic].err{refuse(r, MALFORMED, at, len)}; }
        value = value * base + n;
        i     = i + 1;
    }
    r.at = at + len;
    ret res[i64, diagnostic.Diagnostic].ok{value:~i64};
}

# the length of the symbol name at the position, 0 when none starts there
pub fun name(r: *spelling.Reader) usize {
    val c: u8 = peek(r);
    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '.' || c == '$')) { ret 0; }
    ret token(r, r.at);
}

# the text at `at` for `len` bytes
pub fun span(r: *spelling.Reader, at: usize, len: usize) View {
    ret View{data: ?r.text[at], len: len};
}
