# reading instruction text: the cursor, the refusals, and the operands spelled from their one table
#
# every function here reads at a `syntax.Reader`'s position and moves it
# only past what it accepts. registers are read from the register file's
# names and aliases through the context's view, and enumerants and
# conditions from their enumeration's members, so the parser and the printer
# read one table.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.field;
use masc.core.index;
use masc.core.operand;
use masc.core.register;
use masc.core.requirement;
use masc.core.syntax;

pub val UNEXPECTED:       str = "unexpected text";
pub val UNKNOWN_MNEMONIC: str = "unknown mnemonic";
pub val OTHER_MODE:       str = "spelling not read under the assembler's modes";
pub val UNKNOWN_REGISTER: str = "not a register name";
pub val NOT_A_MEMBER:     str = "not a name the operand admits";
pub val MALFORMED:        str = "malformed number";
pub val TOO_WIDE:         str = "number wider than the operand's bytes";
pub val EXPECTED:         str = "expected an operand";

# whether `c` continues a word, so a name may not end before it
pub fun word(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

# whether `c` is white space between tokens
pub fun blank(c: u8) bool {
    ret syntax.blank(c);
}

# the byte at the reader's position, 0 at the end of the instruction
pub fun peek(r: *syntax.Reader) u8 {
    if (r.at >= r.end) { ret 0; }
    ret r.text[r.at];
}

# the reader moved past white space
pub fun skip(r: *syntax.Reader) {
    for (r.at < r.end && blank(r.text[r.at])) {
        r.at = r.at + 1;
    }
}

# a refusal of `message` at the text from `at` for `len` bytes
pub fun refuse(r: *syntax.Reader, message: str, at: usize, len: usize) diagnostic.Diagnostic {
    ret diagnostic.refusal(message, r.origin, ?r.text[r.start], at - r.start, len);
}

# a refusal at the text from `at` for `len` bytes of what the selection does not admit, which it would have admitted holding `required`
pub fun refuse_unmet(r: *syntax.Reader, required: requirement.Requirement, at: usize, len: usize) diagnostic.Diagnostic {
    ret diagnostic.unmet(field.NOT_ADMITTED, required, r.origin, ?r.text[r.start], at - r.start, len);
}

# the length of the word at `at`, at least one byte when the instruction has one left
pub fun token(r: *syntax.Reader, at: usize) usize {
    var i: usize = at;
    for (i < r.end && (word(r.text[i]) || r.text[i] == '.' || r.text[i] == '$')) {
        i = i + 1;
    }
    if (i == at && at < r.end) { ret 1; }
    ret i - at;
}

# the length of a parenthesized decimal number at `at`, as the `(1)` of `st(1)`, 0 for none
fun parenthesized(r: *syntax.Reader, at: usize) usize {
    if (at >= r.end || r.text[at] != '(') { ret 0; }
    var i: usize = at + 1;
    for (i < r.end && r.text[i] >= '0' && r.text[i] <= '9') {
        i = i + 1;
    }
    if (i == at + 1 || i >= r.end || r.text[i] != ')') { ret 0; }
    ret i + 1 - at;
}

# the end of the mnemonic the text spells from `at`: each of the syntax's prefixes spelled there with the white space
# after it, then the token that follows, as `lock add` of `lock add eax, 1`
pub fun mnemonic_end(r: *syntax.Reader, at: usize) usize {
    val prefixes: syntax.Prefixes = r.syntax.prefixes;
    var i:        usize           = at;
    var joined:   bool            = true;
    for (joined) {
        joined = false;
        var k: u32 = 0;
        for (k < prefixes.len && !joined) {
            val p:   str   = prefixes.at[k];
            val len: usize = str_len(p);
            if (len > 0 && starts(r, i, p, len) && i + len < r.end && blank(r.text[i + len])) {
                i = i + len;
                for (i < r.end && blank(r.text[i])) {
                    i = i + 1;
                }
                joined = true;
            }
            k = k + 1;
        }
    }
    ret i + token(r, i);
}

# whether bytes `a` and `b` read as one under the syntax's case rule
pub fun same(r: *syntax.Reader, a: u8, b: u8) bool {
    if (r.syntax.fold) { ret syntax.lower(a) == syntax.lower(b); }
    ret a == b;
}

# whether the text at `at` begins with `len` bytes of `text`
pub fun starts(r: *syntax.Reader, at: usize, text: *u8, len: usize) bool {
    if (at > r.end || r.end - at < len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (!same(r, r.text[at + i], text[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether a name of `len` bytes read at `at`, ending in `last`, ends at a word boundary
pub fun bounded(r: *syntax.Reader, at: usize, len: usize, last: u8) bool {
    val next: usize = at + len;
    ret !word(last) || next >= r.end || !word(r.text[next]);
}

# the syntax's variadic text read and passed when the reader's text begins with it, a text of white space alone as
# any run of white space
pub fun joined(r: *syntax.Reader) bool {
    val v: str = r.syntax.variadic;
    if (!spacing(v)) { ret take(r, v); }
    val from: usize = r.at;
    skip(r);
    ret r.at > from;
}

# whether `text` is white space alone, and some
fun spacing(text: str) bool {
    if (text == nil || text[0] == 0) { ret false; }
    var i: usize = 0;
    for (text[i] != 0) {
        if (!blank(text[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# `text` read and passed when the reader's text begins with it
pub fun take(r: *syntax.Reader, text: str) bool {
    val len: usize = str_len(text);
    if (!starts(r, r.at, text, len)) { ret false; }
    r.at = r.at + len;
    ret true;
}

# a register read at the position: the longest name or alias there, after the
# syntax's register prefix, refused when `viewed` and the context's view does
# not admit it. an operand whose registers exist whatever the view, as risc-v's
# `.insn` operands, reads it with `viewed` false
pub fun register_value(r: *syntax.Reader, viewed: bool) res[register.Id, diagnostic.Diagnostic] {
    val at:   usize          = r.at;
    val file: *register.File = r.codec.registers;
    if (file == nil || !take(r, r.syntax.register)) { ret res[register.Id, diagnostic.Diagnostic].err{refuse(r, UNKNOWN_REGISTER, at, token(r, at))}; }
    val from: usize       = r.at;
    var best: usize       = 0;
    var id:   register.Id = register.NONE;
    # a name ending in a parenthesized number, as x87's st(1), is the token and the number, and otherwise the longest
    # name that ends at a word boundary is the longest prefix of the token the name index holds
    var len:      usize = token(r, from);
    val numbered: usize = parenthesized(r, from + len);
    if (numbered > 0) {
        val found: opt[register.Id] = register.named(file, span(r, from, len + numbered), r.syntax.fold);
        if (sel found.some) {
            best = len + numbered;
            id   = found.some;
        }
    }
    for (len > 0 && best == 0) {
        if (bounded(r, from, len, r.text[from + len - 1])) {
            val found: opt[register.Id] = register.named(file, span(r, from, len), r.syntax.fold);
            if (sel found.some) {
                best = len;
                id   = found.some;
            }
        }
        len = len - 1;
    }
    if (best == 0 && r.syntax.hooks.register != nil) {
        val hooked: opt[register.Id] = r.syntax.hooks.register.read(r);
        if (sel hooked.some) { ret res[register.Id, diagnostic.Diagnostic].ok{hooked.some}; }
        r.at = from;
    }
    if (best == 0) {
        r.at = at;
        ret res[register.Id, diagnostic.Diagnostic].err{refuse(r, UNKNOWN_REGISTER, at, token(r, from) + from - at)};
    }
    var held: err[register.Absent] = err[register.Absent].ok{};
    if (viewed) { held = register.admitted(r.ctx.view, id); }
    if (sel held.err) {
        r.at = at;
        var refused: diagnostic.Diagnostic = refuse(r, field.UNAVAILABLE, at, best + from - at);
        if (sel held.err.unavailable) { refused.requires = held.err.unavailable.requires; }
        ret res[register.Id, diagnostic.Diagnostic].err{refused};
    }
    r.at = from + best;
    ret res[register.Id, diagnostic.Diagnostic].ok{id};
}

# a register of operand `reg`'s one class read at the position as its number within the class, the decimal digits
# there, refused when the class holds no register of that number or the context's view does not admit it, as a
# template hole formatted `number` spells it
pub fun register_number(r: *syntax.Reader, reg: *operand.Register) res[register.Id, diagnostic.Diagnostic] {
    val at: usize = r.at;
    if (r.codec.registers == nil || reg.classes.len != 1) { ret res[register.Id, diagnostic.Diagnostic].err{refuse(r, UNKNOWN_REGISTER, at, token(r, at))}; }
    var n: u64   = 0;
    var i: usize = at;
    for (i < r.end && r.text[i] >= '0' && r.text[i] <= '9' && n < 0x1_0000) {
        n = n * 10 + (r.text[i] - '0')::u64;
        i = i + 1;
    }
    if (i == at || n >= 0x1_0000) { ret res[register.Id, diagnostic.Diagnostic].err{refuse(r, UNKNOWN_REGISTER, at, token(r, at))}; }
    val id:  register.Id             = register.make(reg.classes.at[0], n::u16);
    val row: opt[*register.Register] = register.row_of(r.codec.registers, id);
    if (sel row.none) { ret res[register.Id, diagnostic.Diagnostic].err{refuse(r, UNKNOWN_REGISTER, at, i - at)}; }
    if (!reg.unviewed) {
        val held: err[register.Absent] = register.admitted(r.ctx.view, id);
        if (sel held.err) {
            var refused: diagnostic.Diagnostic = refuse(r, field.UNAVAILABLE, at, i - at);
            if (sel held.err.unavailable) { refused.requires = held.err.unavailable.requires; }
            ret res[register.Id, diagnostic.Diagnostic].err{refused};
        }
    }
    r.at = i;
    ret res[register.Id, diagnostic.Diagnostic].ok{id};
}

# the member of `e` whose name is longest at the position and ends at a word boundary, read through its name index. a prefix of the
# text no name begins with ends the search, so it reads no further than the longest name. a member with an empty name is the value of
# text that names no other member, as risc-v's unmasked `vm`, and reads nothing
fun member(r: *syntax.Reader, e: *operand.Enumeration) opt[u32] {
    val names: *index.Index = ?e.names;
    var best:  usize        = 0;
    var row:   u32          = 0;
    var len:   usize        = 1;
    for (r.at + len <= r.end) {
        val text: View = span(r, r.at, len);
        val at:   u32  = index.lower_bound(names, text, r.syntax.fold);
        if (at >= names.len || !index.begins(names.at[at].key, text, r.syntax.fold)) { brk; }
        if (index.compare(names.at[at].key, text, r.syntax.fold) == 0 && bounded(r, r.at, len, r.text[r.at + len - 1])) {
            best = len;
            row  = names.at[at].row;
        }
        len = len + 1;
    }
    if (best == 0) {
        val blank: opt[u32] = index.find(names, "");
        if (sel blank.none) { ret blank; }
        ret opt[u32].some{e.members[blank.some].value};
    }
    r.at = r.at + best;
    ret opt[u32].some{e.members[row].value};
}

# a value of `e` read by its members' names, a mask as members joined by the syntax's join
pub fun enumeration(r: *syntax.Reader, e: *operand.Enumeration) res[u32, diagnostic.Diagnostic] {
    val at:    usize    = r.at;
    val first: opt[u32] = member(r, e);
    if (sel first.none) { ret res[u32, diagnostic.Diagnostic].err{refuse(r, NOT_A_MEMBER, at, token(r, at))}; }
    var value: u32 = first.some;
    for (e.mask) {
        val back: usize = r.at;
        if (!take(r, r.syntax.join)) { brk; }
        val next: opt[u32] = member(r, e);
        if (sel next.none) {
            r.at = back;
            brk;
        }
        # a member that reads nothing ends the mask
        if (r.at == back + str_len(r.syntax.join)) {
            r.at = back;
            brk;
        }
        value = value | next.some;
    }
    ret res[u32, diagnostic.Diagnostic].ok{value};
}

# a run of `n` pool slots, refused with the pool's need noted when it has fewer left
pub fun run(r: *syntax.Reader, n: u32) res[*operand.Value, diagnostic.Diagnostic] {
    if (n > r.cap - r.used) {
        pool_short(r, r.used::u64 + n::u64);
        ret res[*operand.Value, diagnostic.Diagnostic].err{refuse(r, field.STORAGE, r.at, 0)};
    }
    val first: *operand.Value = ?r.pool[r.used];
    r.used = r.used + n;
    ret res[*operand.Value, diagnostic.Diagnostic].ok{first};
}

# the pool noted short of `need` slots
pub fun pool_short(r: *syntax.Reader, need: u64) {
    r.short.pool = most(r.short.pool, need);
}

# the larger of `held` and `need`, held to a u32 as the reader's counts are
fun most(held: u32, need: u64) u32 {
    var n: u64 = need;
    if (n > 0xFFFF_FFFF) { n = 0xFFFF_FFFF; }
    if (n::u32 > held)   { ret n::u32; }
    ret held;
}

# a pool slot holding `value`, for a member of a list or a variadic operand
pub fun push(r: *syntax.Reader, value: operand.Value) res[*operand.Value, diagnostic.Diagnostic] {
    val slot: res[*operand.Value, diagnostic.Diagnostic] = run(r, 1);
    if (sel slot.ok) { @slot.ok = value; }
    ret slot;
}

# whether `len` bytes of literal storage are free past what is taken, the bytes noted short when they are not
pub fun spare(r: *syntax.Reader, len: usize) bool {
    if (len <= (r.room - r.taken)::usize) { ret true; }
    r.short.bytes = most(r.short.bytes, r.taken::u64 + len::u64);
    ret false;
}

# `len` bytes of literal storage, for a literal whose bytes the text does not hold as they are
pub fun reserve(r: *syntax.Reader, len: u32) res[*u8, diagnostic.Diagnostic] {
    if (!spare(r, len::usize)) { ret res[*u8, diagnostic.Diagnostic].err{refuse(r, field.STORAGE, r.at, 0)}; }
    val bytes: *u8 = ?r.bytes[r.taken];
    r.taken = r.taken + len;
    ret res[*u8, diagnostic.Diagnostic].ok{bytes};
}

fun digit(c: u8, base: u64) opt[u64] {
    var d: u64 = 99;
    if (c >= '0' && c <= '9') { d = (c - '0')::u64; }
    or (c >= 'a' && c <= 'f') { d = (c - 'a')::u64 + 10; }
    or (c >= 'A' && c <= 'F') { d = (c - 'A')::u64 + 10; }
    if (d >= base)            { ret opt[u64].none{}; }
    ret opt[u64].some{d};
}

# an unsigned number: decimal, or hexadecimal, binary or octal after 0x, 0b or 0o, or octal after a
# leading 0 as the gnu assembler reads `010`, of up to 64 bits, read as its bit pattern
pub fun number(r: *syntax.Reader) res[i64, diagnostic.Diagnostic] {
    val at:   usize = r.at;
    val len:  usize = token(r, at);
    var i:    usize = at;
    var base: u64   = 10;
    if (len > 2 && r.text[at] == '0') {
        val p: u8 = syntax.lower(r.text[at + 1]);
        if (p == 'x')   { base = 16; }
        or (p == 'b')   { base = 2; }
        or (p == 'o')   { base = 8; }
        if (base != 10) { i = at + 2; }
    }
    if (base == 10 && len > 1 && r.text[at] == '0' && r.text[at + 1] >= '0' && r.text[at + 1] <= '9') {
        base = 8;
        i    = at + 1;
    }
    var value: u64 = 0;
    if (i == at + len || !(r.text[at] >= '0' && r.text[at] <= '9')) { ret res[i64, diagnostic.Diagnostic].err{refuse(r, MALFORMED, at, len)}; }
    for (i < at + len) {
        val d: opt[u64] = digit(r.text[i], base);
        if (sel d.none) { ret res[i64, diagnostic.Diagnostic].err{refuse(r, MALFORMED, at, len)}; }
        val n: u64 = d.some;
        if (value > (~0::u64 - n) / base) { ret res[i64, diagnostic.Diagnostic].err{refuse(r, MALFORMED, at, len)}; }
        value = value * base + n;
        i     = i + 1;
    }
    r.at = at + len;
    ret res[i64, diagnostic.Diagnostic].ok{value:~i64};
}

# an unsigned number as `number` reads its spelling, of any width, into the `len` bytes at `out`, least significant
# first and zero above it, refused when it is malformed or needs more bytes
pub fun wide(r: *syntax.Reader, out: *u8, len: u32) err[diagnostic.Diagnostic] {
    val at:   usize = r.at;
    val n:    usize = token(r, at);
    var i:    usize = at;
    var base: u64   = 10;
    if (n > 2 && r.text[at] == '0') {
        val p: u8 = syntax.lower(r.text[at + 1]);
        if (p == 'x')   { base = 16; }
        or (p == 'b')   { base = 2; }
        or (p == 'o')   { base = 8; }
        if (base != 10) { i = at + 2; }
    }
    if (base == 10 && n > 1 && r.text[at] == '0' && r.text[at + 1] >= '0' && r.text[at + 1] <= '9') {
        base = 8;
        i    = at + 1;
    }
    if (i == at + n || !(r.text[at] >= '0' && r.text[at] <= '9')) { ret err[diagnostic.Diagnostic].err{refuse(r, MALFORMED, at, n)}; }
    var k: u32 = 0;
    for (k < len) {
        out[k] = 0;
        k      = k + 1;
    }
    for (i < at + n) {
        val d: opt[u64] = digit(r.text[i], base);
        if (sel d.none) { ret err[diagnostic.Diagnostic].err{refuse(r, MALFORMED, at, n)}; }
        var carry: u64 = d.some;
        k = 0;
        for (k < len) {
            val v: u64 = out[k]::u64 * base + carry;
            out[k] = (v & 0xFF)::u8;
            carry  = v >> 8;
            k      = k + 1;
        }
        if (carry != 0) { ret err[diagnostic.Diagnostic].err{refuse(r, TOO_WIDE, at, n)}; }
        i = i + 1;
    }
    r.at = at + n;
    ret err[diagnostic.Diagnostic].ok{};
}

# the length of the symbol name at the position, 0 when none starts there
pub fun name(r: *syntax.Reader) usize {
    val c: u8 = peek(r);
    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '.' || c == '$')) { ret 0; }
    ret token(r, r.at);
}

# the text at `at` for `len` bytes
pub fun span(r: *syntax.Reader, at: usize, len: usize) View {
    ret View{data: ?r.text[at], len: len};
}
