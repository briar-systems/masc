# alias rows in both directions: the alias values of a base value, and the base value of alias values
#
# both directions read the alias's sources and its derivation, so an alias
# prints exactly the values it parses back to.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use masc.core.operand;
use masc.core.register;
use masc.core.row;
use masc.core.spelling;
use masc.core.walk;

# `v` with the bits of `mask` flipped, none for a value with no bits to flip
fun flip(v: *operand.Value, mask: u32) operand.Value {
    if (sel v.enumerant) { ret operand.Value.enumerant{v.enumerant ^ mask}; }
    if (sel v.condition) { ret operand.Value.condition{v.condition ^ mask}; }
    if (sel v.immediate) { ret operand.Value.immediate{v.immediate ^ mask::i64}; }
    ret operand.Value.none{};
}

# the register at row `at` of the codec's file, none when there is no such row
fun fixed(codec: *walk.Codec, at: u32) register.Id {
    if (codec.registers == nil || at >= codec.registers.register_count) { ret register.NONE; }
    ret register.id_of(?codec.registers.registers[at]);
}

# `v` taken as alias value `k`, which must agree with what an earlier source gave it
fun give(alias: *operand.Value, given: *bool, k: u8, v: operand.Value) bool {
    if (sel v.none) { ret false; }
    if (given[k])   { ret operand.equal(?alias[k], ?v); }
    alias[k] = v;
    given[k] = true;
    ret true;
}

# whether alias `a` applies to the base values `base`, and its values into `alias` when it does
pub fun applies(codec: *walk.Codec, a: *spelling.Alias, base: *operand.Value, alias: *operand.Value) bool {
    var given: [row.MAX_OPERANDS]bool;
    var j:     u32 = 0;
    for (j < a.sources.len) {
        val src: spelling.Source = a.sources.at[j];
        val v:   *operand.Value  = ?base[j];
        if (sel src.operand) {
            if (!give(alias, ?given[0], src.operand, @v)) { ret false; }
        }
        or (sel src.flipped) {
            if (!give(alias, ?given[0], src.flipped.operand, flip(v, src.flipped.mask))) { ret false; }
        }
        or (sel src.register) {
            if (!(sel v.register && v.register == fixed(codec, src.register))) { ret false; }
        }
        or (sel src.value) {
            var want: operand.Value = src.value;
            if (!operand.equal(v, ?want)) { ret false; }
        }
        j = j + 1;
    }
    if (a.derive != nil) { ret a.derive.alias(base, alias); }
    var k: u8 = 0;
    for (k < a.count) {
        if (!given[k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

# the base values of alias `a`'s values `alias` into `base`, false when they have no base form
pub fun resolve(codec: *walk.Codec, a: *spelling.Alias, alias: *operand.Value, base: *operand.Value) bool {
    var j: u32 = 0;
    for (j < a.sources.len) {
        val src: spelling.Source = a.sources.at[j];
        base[j] = operand.Value.none{};
        if (sel src.operand)  { base[j] = alias[src.operand]; }
        if (sel src.flipped)  { base[j] = flip(?alias[src.flipped.operand], src.flipped.mask); }
        if (sel src.register) { base[j] = operand.Value.register{fixed(codec, src.register)}; }
        if (sel src.value)    { base[j] = src.value; }
        j = j + 1;
    }
    if (a.derive != nil) { ret a.derive.base(alias, base); }
    ret true;
}
