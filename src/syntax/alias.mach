# alias rows in both directions: the alias values of a base value, and the base value of alias values
#
# both directions read the alias's sources, its derivation and its
# exclusions, so an alias prints exactly the values it parses back to.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use masc.core.dispatch;
use masc.core.field;
use masc.core.operand;
use masc.core.register;
use masc.core.requirement;
use masc.core.row;
use masc.core.syntax;

# `v` with the bits of `mask` flipped, none for a value with no bits to flip, as an enumerant whose params its bits name
fun flip(v: *operand.Value, mask: u32) operand.Value {
    if (sel v.enumerant) {
        if (v.enumerant.params.len == 0) { ret operand.enumerant(v.enumerant.value ^ mask); }
        ret operand.Value.none{};
    }
    if (sel v.condition) { ret operand.Value.condition{v.condition ^ mask}; }
    if (sel v.immediate) { ret operand.Value.immediate{v.immediate ^ mask::i64}; }
    ret operand.Value.none{};
}

# the register at row `at` of the codec's file, none when there is no such row
fun fixed(codec: *dispatch.Codec, at: u32) register.Id {
    if (codec.registers == nil || at >= codec.registers.register_count) { ret register.NONE; }
    ret register.id_of(?codec.registers.registers[at]);
}

# `v` taken as alias value `k`, which must agree with what an earlier source gave it
fun give(alias: *operand.Value, given: *bool, k: u8, v: operand.Value) bool {
    if (sel v.none) { ret false; }
    if (given[k])   { ret operand.equal(?alias[k], ?v); }
    alias[k] = v;
    given[k] = true;
    ret true;
}

# whether base operand `j` of alias `a`'s row is optional, as evex's opmask
fun optional(codec: *dispatch.Codec, a: *syntax.Alias, j: u32) bool {
    if (codec == nil || a.row >= codec.rows.len) { ret false; }
    val r: *row.Row = ?codec.rows.at[a.row];
    ret j < r.operands.len && r.operands.at[j].quantity == operand.OPTIONAL;
}

# whether `list` holds the number `n`
fun holds(list: operand.Numbers, n: u32) bool {
    var i: u32 = 0;
    for (i < list.len) {
        if (list.at[i] == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `list` holds the integer `n`
fun holds_integer(list: operand.Integers, n: i64) bool {
    var i: u32 = 0;
    for (i < list.len) {
        if (list.at[i] == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether exclusion `x` names the value `v`
fun names(x: *syntax.Exclusion, v: *operand.Value) bool {
    val ex: *syntax.Excluded = ?x.excluded;
    if (sel ex.register)  { ret sel v.register && holds(ex.register, register.number_of(v.register)::u32); }
    if (sel ex.immediate) { ret sel v.immediate && holds_integer(ex.immediate, v.immediate); }
    if (sel ex.relative)  { ret sel v.relative && holds_integer(ex.relative, v.relative); }
    if (sel ex.enumerant) { ret sel v.enumerant && holds(ex.enumerant, v.enumerant.value); }
    if (sel ex.condition) { ret sel v.condition && holds(ex.condition, v.condition); }
    ret false;
}

# whether alias `a` excludes the value `v` of its operand `k`
pub fun excludes(a: *syntax.Alias, k: u8, v: *operand.Value) bool {
    var i: u32 = 0;
    for (i < a.exclusions.len) {
        val x: *syntax.Exclusion = ?a.exclusions.at[i];
        if (x.operand == k && names(x, v)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the first operand of alias `a` whose value in `alias` it excludes, field.NO_OPERAND when it excludes none
pub fun excluded(a: *syntax.Alias, alias: *operand.Value) u8 {
    var i: u32 = 0;
    for (i < a.exclusions.len) {
        val x: *syntax.Exclusion = ?a.exclusions.at[i];
        if (x.operand < a.count && names(x, ?alias[x.operand])) { ret x.operand; }
        i = i + 1;
    }
    ret field.NO_OPERAND;
}

# the number an immediate or an enumerant without params holds, none for any other value
fun number(v: *operand.Value) opt[u64] {
    if (sel v.immediate) { ret opt[u64].some{v.immediate:~u64}; }
    if (sel v.enumerant) {
        if (v.enumerant.params.len == 0) { ret opt[u64].some{v.enumerant.value::u64}; }
    }
    ret opt[u64].none{};
}

# the value of alias operand `desc` that the bits `n` hold: an enumerant's when it is one and names a member, none when
# it names none, an immediate's otherwise
fun assembled(desc: *operand.Operand, n: u64) operand.Value {
    if (desc == nil) { ret operand.Value.immediate{n:~i64}; }
    if (sel desc.shape.enumerant) {
        if (n > 0xFFFF_FFFF || !operand.member(?desc.shape.enumerant, n::u32)) { ret operand.Value.none{}; }
        ret operand.enumerant(n::u32);
    }
    ret operand.Value.immediate{n:~i64};
}

# whether alias `a` applies to the base values `base`, and its values into `alias` when it does
pub fun applies(codec: *dispatch.Codec, a: *syntax.Alias, base: *operand.Value, alias: *operand.Value) bool {
    var given: [row.MAX_OPERANDS]bool;
    var parts: [row.MAX_OPERANDS]u64;
    var held:  [row.MAX_OPERANDS]bool;
    var k:     u8 = 0;
    for (k::u32 < row.MAX_OPERANDS) {
        given[k] = false;
        held[k]  = false;
        parts[k] = 0;
        k        = k + 1;
    }
    var j: u32 = 0;
    for (j < a.sources.len) {
        val src: syntax.Source  = a.sources.at[j];
        val v:   *operand.Value = ?base[j];
        if (sel src.operand) {
            # an optional base operand that is absent is absent in the alias operand that reads as it
            if (sel v.none && optional(codec, a, j)) {
                if (!given[src.operand]) {
                    alias[src.operand] = operand.Value.none{};
                    given[src.operand] = true;
                }
            }
            or (!give(alias, ?given[0], src.operand, @v)) { ret false; }
        }
        or (sel src.flipped) {
            if (!give(alias, ?given[0], src.flipped.operand, flip(v, src.flipped.mask))) { ret false; }
        }
        or (sel src.masked) {
            if (!sel v.immediate) { ret false; }
            val m: syntax.Mask = src.masked;
            if ((v.immediate:~u64 & m.mask) != m.value)                                                         { ret false; }
            if (!give(alias, ?given[0], m.operand, operand.Value.immediate{(v.immediate:~u64 & ~m.mask):~i64})) { ret false; }
        }
        or (sel src.bits) {
            val b: syntax.Bits = src.bits;
            val n: opt[u64]    = number(v);
            if (sel n.none)                                { ret false; }
            if (b.len < 64 && (n.some >> b.len::u64) != 0) { ret false; }
            parts[b.operand] = parts[b.operand] | (n.some << b.lo::u64);
            held[b.operand]  = true;
        }
        or (sel src.register) {
            if (!(sel v.register && v.register == fixed(codec, src.register))) { ret false; }
        }
        or (sel src.value) {
            var want: operand.Value = src.value;
            if (!operand.equal(v, ?want)) { ret false; }
        }
        or (sel src.fixed) {
            var want: operand.Value = syntax.fixed_value(codec, ?codec.rows.at[a.row], j);
            if (sel want.none || !operand.equal(v, ?want)) { ret false; }
        }
        j = j + 1;
    }
    k = 0;
    for (k < a.count) {
        if (held[k]) {
            var desc: *operand.Operand = nil;
            if (a.derive != nil && k::u32 < a.derive.operands.len)     { desc = ?a.derive.operands.at[k]; }
            if (!give(alias, ?given[0], k, assembled(desc, parts[k]))) { ret false; }
        }
        k = k + 1;
    }
    if (a.derive != nil && a.derive.alias != nil) {
        if (!a.derive.alias(base, alias)) { ret false; }
    }
    or {
        k = 0;
        for (k < a.count) {
            if (!given[k]) { ret false; }
            k = k + 1;
        }
    }
    ret excluded(a, alias) == field.NO_OPERAND;
}

# the base values of alias `a`'s values `alias` into `base`, false when they have no base form
pub fun resolve(codec: *dispatch.Codec, a: *syntax.Alias, alias: *operand.Value, base: *operand.Value) bool {
    var j: u32 = 0;
    for (j < a.sources.len) {
        val src: syntax.Source = a.sources.at[j];
        base[j] = operand.Value.none{};
        if (sel src.operand) { base[j] = alias[src.operand]; }
        if (sel src.flipped) { base[j] = flip(?alias[src.flipped.operand], src.flipped.mask); }
        if (sel src.masked) {
            val m:    syntax.Mask    = src.masked;
            val held: *operand.Value = ?alias[m.operand];
            if (!sel held.immediate)                 { ret false; }
            if ((held.immediate:~u64 & m.mask) != 0) { ret false; }
            base[j] = operand.Value.immediate{(held.immediate:~u64 | m.value):~i64};
        }
        if (sel src.bits) {
            val b: syntax.Bits = src.bits;
            val n: opt[u64]    = number(?alias[b.operand]);
            if (sel n.none) { ret false; }
            var v: u64 = n.some >> b.lo::u64;
            if (b.len < 64) { v = v & field.ones(b.len); }
            base[j] = operand.Value.immediate{v:~i64};
        }
        if (sel src.register) { base[j] = operand.Value.register{fixed(codec, src.register)}; }
        if (sel src.value)    { base[j] = src.value; }
        if (sel src.fixed) {
            base[j] = syntax.fixed_value(codec, ?codec.rows.at[a.row], j);
            if (sel base[j].none) { ret false; }
        }
        j = j + 1;
    }
    if (a.derive != nil && a.derive.base != nil) { ret a.derive.base(alias, base); }
    ret true;
}

#[testing]
val T_CONDITIONS: [3]operand.Enumerant = [3]operand.Enumerant{operand.Enumerant{name: "eq", value: 0}, operand.Enumerant{name: "al", value: 14}, operand.Enumerant{name: "nv", value: 15}};

#[testing]
val T_REFUSED: [2]u32 = [2]u32{14, 15};

#[testing]
val T_FAR: [1]i64 = [1]i64{0};

#[testing]
val T_THREE: [3]syntax.Source = [3]syntax.Source{syntax.Source.operand{0}, syntax.Source.operand{1}, syntax.Source.operand{2}};

# an alias of three values that excludes one per shape: conditions 14 and 15, enumerant 14 and relative 0
test alias__an_alias_refuses_a_condition_enumerant_or_relative_value_it_excludes {
    var ex: [3]syntax.Exclusion = [3]syntax.Exclusion{
        syntax.Exclusion{operand: 0, excluded: syntax.Excluded.condition{operand.Numbers{at: ?T_REFUSED[0], len: 2}}},
        syntax.Exclusion{operand: 1, excluded: syntax.Excluded.enumerant{operand.Numbers{at: ?T_REFUSED[0], len: 1}}},
        syntax.Exclusion{operand: 2, excluded: syntax.Excluded.relative{operand.Integers{at: ?T_FAR[0], len: 1}}},
    };
    val a:     syntax.Alias     = syntax.Alias{row: 0, template: "t", count: 3, sources: syntax.Sources{at: ?T_THREE[0], len: 3}, derive: nil, exclusions: syntax.Exclusions{at: ?ex[0], len: 3}, requires: requirement.NO_ALTERNATIVES, preference: 0};
    var base:  [3]operand.Value = [3]operand.Value{operand.Value.condition{0}, operand.enumerant(0), operand.Value.relative{8}};
    var alias: [3]operand.Value;
    if (!applies(nil, ?a, ?base[0], ?alias[0])) { ret 1; }
    base[0] = operand.Value.condition{14};
    if (applies(nil, ?a, ?base[0], ?alias[0])) { ret 2; }
    if (excluded(?a, ?base[0]) != 0)           { ret 3; }
    base[0] = operand.Value.condition{15};
    if (excluded(?a, ?base[0]) != 0) { ret 4; }
    base[0] = operand.Value.condition{1};
    base[1] = operand.enumerant(14);
    if (excluded(?a, ?base[0]) != 1) { ret 5; }
    base[1] = operand.enumerant(15);
    base[2] = operand.Value.relative{0};
    if (excluded(?a, ?base[0]) != 2) { ret 6; }
    # a value of another shape is never named
    if (excludes(?a, 0, ?base[1])) { ret 7; }
    base[2] = operand.Value.immediate{0};
    if (excludes(?a, 2, ?base[2])) { ret 8; }
    ret 0;
}
