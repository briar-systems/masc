# the refusal of an instruction directive's text that starts with the name of none of its formats
pub val UNKNOWN_FORMAT: str = "instruction format the directive states none of";

# the refusals of a row whose result the statement does not bind, and of a bound result no operand of the row takes
pub val UNBOUND: str = "result the instruction defines that the statement binds to no name";
pub val UNTAKEN: str = "result bound to an instruction that takes it as no operand";

# the refusal of an operand the template writes again, spelled with another value than where it was first written
pub val REPEATED: str = "operand written again with another value";

# the refusal of a derived spelling, as casp's `<X(s+1)>`, that reads other than the value its derivation gives
pub val DERIVED: str = "operand spelled as other than the value its derivation gives";

# an operand written with no size that rows of more than one size read the text by
pub val AMBIGUOUS_SIZE: str = "operand of no size that more than one size reads";

# the refusal kept while candidates are tried
# ---
# held:     whether one is kept
# complete: whether its candidate read the whole text, so it outranks any that did not
# refusal:  the refusal
# unmet:    whether the refusal is a candidate refused for admission, whose requirement becomes that of every such candidate
# full:     whether the reader had no room for the requirement of a candidate refused for admission
rec Best {
    held:     bool;
    complete: bool;
    refusal:  diagnostic.Diagnostic;
    unmet:    bool;
    full:     bool;
}

# whether `d` was kept
fun keep(best: *Best, d: diagnostic.Diagnostic, complete: bool) bool {
    if (best.held) {
        if (best.complete && !complete)                                                         { ret false; }
        if (best.complete == complete && d.span.start.offset <= best.refusal.span.start.offset) { ret false; }
    }
    best.held     = true;
    best.complete = complete;
    best.refusal  = d;
    best.unmet    = false;
    ret true;
}

# the candidate starting at the instruction refused for want of `required`, whose alternatives join those of every other
fun keep_unmet(rd: *core_syntax.Reader, best: *Best, required: requirement.Requirement, at: usize, len: usize) {
    if (!field.note(?rd.refused, required)) {
        best.full = true;
        read.refused_short(rd, rd.refused.used::u64 + required.len::u64);
    }
    if (keep(best, read.refuse_unmet(rd, required, at, len), true)) { best.unmet = true; }
}

# the candidate refused by walk at `at`: for want of its row's requirement, which joins those of every other candidate so
# refused, or for what it names, as a register the selection lacks, whose requirement is that register's alone
fun keep_refused(rd: *core_syntax.Reader, best: *Best, refusal: field.Refusal, at: usize) {
    if (sel refusal.cause.admission) {
        keep_unmet(rd, best, refusal.requires, at, read.token(rd, at));
        ret;
    }
    var d: diagnostic.Diagnostic = read.refuse(rd, refusal.message, at, read.token(rd, at));
    d.requires = refusal.requires;
    keep(best, d, true);
}

# one value of `desc` read at the position
fun one(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val shape: *operand.Shape = ?desc.shape;
    if (sel shape.register) {
        if (view_eq_str(format, core_syntax.NUMBER)) {
            val numbered: res[register.Id, diagnostic.Diagnostic] = read.register_number(r, ?shape.register);
            if (sel numbered.err) { ret err[diagnostic.Diagnostic].err{numbered.err}; }
            @out = operand.Value.register{numbered.ok};
            ret err[diagnostic.Diagnostic].ok{};
        }
        val reg: res[register.Id, diagnostic.Diagnostic] = read.register_value(r, !shape.register.unviewed);
        if (sel reg.err) { ret err[diagnostic.Diagnostic].err{reg.err}; }
        @out = operand.Value.register{reg.ok};
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (sel shape.enumerant) {
        val e: res[u32, diagnostic.Diagnostic] = read.enumeration(r, ?shape.enumerant);
        if (sel e.err) { ret err[diagnostic.Diagnostic].err{e.err}; }
        ret params(r, ?shape.enumerant, e.ok, format, out);
    }
    if (sel shape.condition) {
        val c: res[u32, diagnostic.Diagnostic] = read.enumeration(r, ?shape.condition);
        if (sel c.err) { ret err[diagnostic.Diagnostic].err{c.err}; }
        @out = operand.Value.condition{c.ok};
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (sel shape.group) {
        if (r.syntax.hooks.group == nil) { ret group(r, ?shape.group, format, out); }
    }
    val h: *core_syntax.Hook = core_syntax.hook(r.syntax, shape);
    if (h == nil) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))}; }
    ret h.parse(r, desc, format, out);
}

# one value of `desc` read at the reader's position by the syntax's tables and hooks, as a raw encoding of a directive
# is read alone, the reader advanced past it
pub fun value(r: *core_syntax.Reader, desc: *operand.Operand, out: *operand.Value) err[diagnostic.Diagnostic] {
    read.skip(r);
    ret one(r, desc, View{data: "", len: 0}, out);
}

# the most members a group holds, and the most params an enumerant takes
val GROUP_MEMBERS: u32 = 16;

# the enumerant `value` of `e` with the params it takes read after it, each after the syntax's variadic text, into the
# pool as one run
fun params(r: *core_syntax.Reader, e: *operand.Enumeration, value: u32, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val count: u32 = operand.param_count(e, value);
    if (count > GROUP_MEMBERS) { ret err[diagnostic.Diagnostic].err{read.refuse(r, field.STORAGE, r.at, 0)}; }
    var held: [GROUP_MEMBERS]operand.Value;
    var i:    u32 = 0;
    for (i < count) {
        if (!read.joined(r)) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))}; }
        read.skip(r);
        val got: err[diagnostic.Diagnostic] = one(r, operand.param(e, value, i), format, ?held[i]);
        if (sel got.err) { ret got; }
        i = i + 1;
    }
    var first: *operand.Value = nil;
    i = 0;
    for (i < count) {
        val slot: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, held[i]);
        if (sel slot.err) { ret err[diagnostic.Diagnostic].err{slot.err}; }
        if (i == 0)       { first = slot.ok; }
        i = i + 1;
    }
    @out = operand.Value.enumerant{operand.Chosen{value: value, params: operand.Values{at: first, len: count}}};
    ret err[diagnostic.Diagnostic].ok{};
}

# a group's members read in order, joined by the syntax's variadic text, into the pool as one run
fun group(r: *core_syntax.Reader, g: *operand.Group, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (g.len > GROUP_MEMBERS) { ret err[diagnostic.Diagnostic].err{read.refuse(r, field.STORAGE, r.at, 0)}; }
    var held: [GROUP_MEMBERS]operand.Value;
    var i:    u32 = 0;
    for (i < g.len) {
        if (i > 0) {
            if (!read.joined(r)) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))}; }
            read.skip(r);
        }
        val got: err[diagnostic.Diagnostic] = one(r, ?g.at[i], format, ?held[i]);
        if (sel got.err) { ret got; }
        i = i + 1;
    }
    var first: *operand.Value = nil;
    i = 0;
    for (i < g.len) {
        val slot: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, held[i]);
        if (sel slot.err) { ret err[diagnostic.Diagnostic].err{slot.err}; }
        if (i == 0)       { first = slot.ok; }
        i = i + 1;
    }
    @out = operand.Value.group{operand.Values{at: first, len: g.len}};
    ret err[diagnostic.Diagnostic].ok{};
}

# operand `desc`'s value read by its hole, a variadic operand as members joined by the syntax's text, or whole by the
# syntax's variadic hook where the hole states a format. the members are counted first, so their run is reserved in the pool before what each holds within it, a group's members or an
# enumerant's params, and the list's members are one run
fun hole(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (desc.quantity != operand.VARIADIC)                { ret one(r, desc, format, out); }
    if (format.len > 0 && r.syntax.hooks.variadic != nil) { ret r.syntax.hooks.variadic.parse(r, desc, format, out); }
    val from:  usize = r.at;
    val used:  u32   = r.used;
    val taken: u32   = r.taken;
    var count: u32   = 0;
    for {
        val back: usize = r.at;
        if (count > 0) {
            if (!read.joined(r)) { brk; }
            read.skip(r);
        }
        var member: operand.Value;
        val got:    err[diagnostic.Diagnostic] = one(r, desc, format, ?member);
        if (sel got.err) {
            r.at = back;
            brk;
        }
        count = count + 1;
    }
    r.at    = from;
    r.used  = used;
    r.taken = taken;
    if (count == 0) {
        @out = operand.Value.list{operand.Values{at: nil, len: 0}};
        ret err[diagnostic.Diagnostic].ok{};
    }
    val first: res[*operand.Value, diagnostic.Diagnostic] = read.run(r, count);
    if (sel first.err) { ret err[diagnostic.Diagnostic].err{first.err}; }
    var k: u32 = 0;
    for (k < count) {
        if (k > 0) {
            val joined: bool = read.joined(r);
            read.skip(r);
        }
        val got: err[diagnostic.Diagnostic] = one(r, desc, format, ?first.ok[k]);
        if (sel got.err) { ret got; }
        k = k + 1;
    }
    @out = operand.Value.list{operand.Values{at: first.ok, len: count}};
    ret err[diagnostic.Diagnostic].ok{};
}

# whether the piece after the one at `at` ends a word, so the text must too
fun ends_word(template: str, at: usize) bool {
    val next: core_syntax.Piece = core_syntax.piece(template, at);
    ret next.kind == core_syntax.SPACE || next.kind == core_syntax.END || next.kind == core_syntax.OPEN || next.kind == core_syntax.CLOSE;
}

# whether the text starts with the template's mnemonic, a space of it read as any run of white space between a prefix
# and its word, and ends a word there where the template's mnemonic does
fun keyed(r: *core_syntax.Reader, template: str, from: usize) bool {
    val key: View  = core_syntax.mnemonic(r.syntax.prefixes, template);
    var i:   usize = from;
    var k:   usize = 0;
    for (k < key.len) {
        val c: u8 = key.data[k];
        if (c == ' ') {
            if (i >= r.end || !read.blank(r.text[i])) { ret false; }
            for (i < r.end && read.blank(r.text[i])) {
                i = i + 1;
            }
        }
        or {
            if (i >= r.end || !read.same(r, r.text[i], c)) { ret false; }
            i = i + 1;
        }
        k = k + 1;
    }
    if (key.len == 0) { ret true; }
    ret !(read.word(key.data[key.len - 1]) && ends_word(template, key.len) && i < r.end && read.word(r.text[i]));
}

# `template` read over the whole text, hole n into `values[n]` by `descs[n]` at `spans[n]`
# ---
# ret: ok, or the refusal at the column the text stops matching
fun match(r: *core_syntax.Reader, template: str, descs: **operand.Operand, values: *operand.Value, spans: *usize, best: *Best) err[diagnostic.Diagnostic] {
    var at:    usize = 0;
    var after: bool  = false;
    var group: usize = 0;
    var back:  usize = 0;
    var used:  u32   = 0;
    var open:  bool  = false;
    # the operands a hole has read, so a later hole of one reads it again and must read the same value
    var seen: u32 = 0;
    var kept: u32 = 0;
    read.skip(r);
    if (r.at < r.lead) { r.at = r.lead; }
    for {
        val p: core_syntax.Piece = core_syntax.piece(template, at);
        at = p.at + p.len;
        # the marker after the mnemonic is the form's, read before any template was tried
        if (r.at == r.marked) { r.at = r.at + r.skipped; }
        var failed: opt[diagnostic.Diagnostic] = opt[diagnostic.Diagnostic].none{};
        if (p.kind == core_syntax.END) {
            read.skip(r);
            if (r.at == r.end) { ret err[diagnostic.Diagnostic].ok{}; }
            failed = opt[diagnostic.Diagnostic].some{read.refuse(r, read.UNEXPECTED, r.at, read.token(r, r.at))};
        }
        or (p.kind == core_syntax.SPACE) {
            read.skip(r);
            after = false;
        }
        or (p.kind == core_syntax.OPEN) {
            open  = true;
            group = at;
            back  = r.at;
            used  = r.used;
            kept  = seen;
        }
        or (p.kind == core_syntax.CLOSE) {
            open = false;
        }
        or (p.kind == core_syntax.TEXT) {
            if (after) { read.skip(r); }
            after = false;
            val c: u8 = template[p.at];
            if (read.peek(r) == 0 || !read.same(r, read.peek(r), c)) {
                failed = opt[diagnostic.Diagnostic].some{read.refuse(r, read.UNEXPECTED, r.at, read.token(r, r.at))};
            }
            or {
                r.at = r.at + 1;
                if (read.word(c) && ends_word(template, at) && read.word(read.peek(r))) {
                    failed = opt[diagnostic.Diagnostic].some{read.refuse(r, read.UNEXPECTED, r.at, read.token(r, r.at))};
                }
            }
        }
        or (p.kind == core_syntax.HOLE) {
            val bit:     u32                    = 1::u32 << p.operand::u32;
            val derived: core_syntax.Derivation = core_syntax.derivation(p.format);
            if (!sel derived.none) {
                # a derived spelling, as casp's `<X(s+1)>`, reads the value its derivation gives from the one read before
                val at:    usize                      = r.at;
                var again: operand.Value              = operand.Value.none{};
                val got:   err[diagnostic.Diagnostic] = hole(r, descs[p.operand], View{data: nil, len: 0}, ?again);
                if (sel got.err) { failed = opt[diagnostic.Diagnostic].some{got.err}; }
                or {
                    var given: opt[operand.Value] = opt[operand.Value].none{};
                    if ((seen & bit) != 0) { given = core_syntax.derive(r.codec.registers, descs[p.operand], derived, ?values[p.operand]); }
                    var same: bool = false;
                    if (sel given.some) { same = operand.equal(?again, ?given.some); }
                    if (!same)          { failed = opt[diagnostic.Diagnostic].some{read.refuse(r, DERIVED, at, r.at - at)}; }
                }
            }
            or ((seen & bit) == 0) {
                spans[p.operand] = r.at;
                val got: err[diagnostic.Diagnostic] = hole(r, descs[p.operand], p.format, ?values[p.operand]);
                if (sel got.err) { failed = opt[diagnostic.Diagnostic].some{got.err}; }
                seen = seen | bit;
            }
            or {
                # an operand the template writes again, as sve's destructive `<Zdn>`, reads the value it read before
                val at:    usize                      = r.at;
                var again: operand.Value              = operand.Value.none{};
                val got:   err[diagnostic.Diagnostic] = hole(r, descs[p.operand], p.format, ?again);
                if (sel got.err) { failed = opt[diagnostic.Diagnostic].some{got.err}; }
                or (!operand.equal(?again, ?values[p.operand])) {
                    failed = opt[diagnostic.Diagnostic].some{read.refuse(r, REPEATED, at, r.at - at)};
                }
            }
            after = true;
        }
        if (sel failed.some) {
            if (!open) { ret err[diagnostic.Diagnostic].err{failed.some}; }
            # an optional group that does not match is absent, its operands none
            keep(best, failed.some, false);
            r.at   = back;
            r.used = used;
            seen   = kept;
            var q: core_syntax.Piece = core_syntax.piece(template, group);
            for (q.kind != core_syntax.CLOSE && q.kind != core_syntax.END) {
                if (q.kind == core_syntax.HOLE) { values[q.operand] = operand.Value.none{}; }
                q = core_syntax.piece(template, q.at + q.len);
            }
            at   = q.at + q.len;
            open = false;
        }
    }
}

# whether operand `op` has a hole in `template`
fun written(template: str, op: u8) bool {
    var p: core_syntax.Piece = core_syntax.piece(template, 0);
    for (p.kind != core_syntax.END) {
        if (p.kind == core_syntax.HOLE && p.operand == op) { ret true; }
        p = core_syntax.piece(template, p.at + p.len);
    }
    ret false;
}

# the candidate `r`'s base row and values admitted, into the reader's pool
# ---
# spans: the offset each base operand was read at, the instruction's start for one the text does not hold
fun admit(rd: *core_syntax.Reader, r: *row.Row, values: *operand.Value, spans: *usize, best: *Best) opt[inst.Inst] {
    if (!state.admits(rd.ctx, r.requires)) {
        keep_unmet(rd, best, r.requires, rd.start, read.token(rd, rd.start));
        ret opt[inst.Inst].none{};
    }
    var ins:      inst.Inst          = inst.Inst{row: r, values: values, count: r.operands.len, form: rd.form};
    val admitted: err[field.Refusal] = walk.admits(rd.codec, rd.ctx, ?ins);
    if (sel admitted.err) {
        var at: usize = rd.start;
        if (admitted.err.operand::u32 < r.operands.len) { at = spans[admitted.err.operand]; }
        keep_refused(rd, best, admitted.err, at);
        ret opt[inst.Inst].none{};
    }
    var i: u32 = 0;
    for (i < r.operands.len) {
        rd.pool[i] = values[i];
        i          = i + 1;
    }
    ret opt[inst.Inst].some{inst.Inst{row: r, values: rd.pool, count: r.operands.len, form: rd.form}};
}

# the row `index` read by its own template
fun by_row(rd: *core_syntax.Reader, index: u32, best: *Best) opt[inst.Inst] {
    ret templated(rd, ?rd.codec.rows.at[index], rd.syntax.forms.at[index], best);
}

# row `r` read by `template`
fun templated(rd: *core_syntax.Reader, r: *row.Row, template: str, best: *Best) opt[inst.Inst] {
    var descs:  [row.MAX_OPERANDS]*operand.Operand;
    var values: [row.MAX_OPERANDS]operand.Value;
    var spans:  [row.MAX_OPERANDS]usize;
    var i:      u32 = 0;
    for (i < r.operands.len) {
        descs[i]  = ?r.operands.at[i];
        spans[i]  = rd.start;
        values[i] = operand.Value.none{};
        i         = i + 1;
    }
    rd.at     = rd.start;
    rd.used   = r.operands.len;
    rd.values = ?values[0];
    rd.row    = r;
    val matched: err[diagnostic.Diagnostic] = match(rd, template, ?descs[0], ?values[0], ?spans[0], best);
    rd.values = nil;
    if (sel matched.err) {
        keep(best, matched.err, false);
        ret opt[inst.Inst].none{};
    }
    # an operand the template does not write is the register the row fixes it to, or the result the statement binds
    var taken: bool = false;
    i = 0;
    for (i < r.operands.len) {
        if (!written(template, i::u8)) {
            val at: opt[register.Id] = effect.fixed(rd.codec.registers, r.effect, i::u8);
            if (sel at.some) { values[i] = operand.Value.register{at.some}; }
            if (r.effect.values.defines::u32 == i + 1) {
                if (sel rd.bound.none) {
                    keep(best, read.refuse(rd, UNBOUND, rd.start, read.token(rd, rd.start)), true);
                    ret opt[inst.Inst].none{};
                }
                values[i] = rd.bound;
                taken     = true;
            }
        }
        i = i + 1;
    }
    if (!taken && !refuse_bound(rd, best)) { ret opt[inst.Inst].none{}; }
    ret admit(rd, r, ?values[0], ?spans[0], best);
}

# whether the statement binds no result, the refusal kept when it binds one that nothing takes
fun refuse_bound(rd: *core_syntax.Reader, best: *Best) bool {
    if (sel rd.bound.none) { ret true; }
    keep(best, read.refuse(rd, UNTAKEN, rd.start, read.token(rd, rd.start)), true);
    ret false;
}

# the alias `a` read and resolved to its base row
fun by_alias(rd: *core_syntax.Reader, a: *core_syntax.Alias, best: *Best) opt[inst.Inst] {
    val r:      *row.Row = ?rd.codec.rows.at[a.row];
    var descs:  [row.MAX_OPERANDS]*operand.Operand;
    var values: [row.MAX_OPERANDS]operand.Value;
    var spans:  [row.MAX_OPERANDS]usize;
    var k:      u8       = 0;
    for (k < a.count) {
        descs[k] = core_syntax.alias_operand(a, r, k);
        spans[k] = rd.start;
        k        = k + 1;
    }
    rd.at     = rd.start;
    rd.used   = r.operands.len;
    rd.values = nil;
    rd.row    = r;
    val matched: err[diagnostic.Diagnostic] = match(rd, a.template, ?descs[0], ?values[0], ?spans[0], best);
    if (sel matched.err) {
        keep(best, matched.err, false);
        ret opt[inst.Inst].none{};
    }
    # an alias takes no bound result, which only a row's own spelling places
    if (!refuse_bound(rd, best)) { ret opt[inst.Inst].none{}; }
    # an alias the selection does not hold the extensions of is refused, and the next candidate is tried
    if (!state.admits(rd.ctx, a.requires)) {
        keep_unmet(rd, best, a.requires, rd.start, read.token(rd, rd.start));
        ret opt[inst.Inst].none{};
    }
    # a value the alias excludes though its operand admits it is refused at that operand, and the next candidate is tried
    val excluded: u8 = alias.excluded(a, ?values[0]);
    if (excluded != field.NO_OPERAND) {
        keep(best, read.refuse(rd, field.EXCLUDED, spans[excluded], read.token(rd, spans[excluded])), true);
        ret opt[inst.Inst].none{};
    }
    var base:  [row.MAX_OPERANDS]operand.Value;
    var where: [row.MAX_OPERANDS]usize;
    if (!alias.resolve(rd.codec, a, ?values[0], ?base[0])) {
        keep(best, read.refuse(rd, read.UNEXPECTED, rd.start, read.token(rd, rd.start)), true);
        ret opt[inst.Inst].none{};
    }
    var j: u32 = 0;
    for (j < r.operands.len) {
        val src: core_syntax.Source = a.sources.at[j];
        where[j] = rd.start;
        if (sel src.operand) { where[j] = spans[src.operand]; }
        if (sel src.flipped) { where[j] = spans[src.flipped.operand]; }
        if (sel src.masked)  { where[j] = spans[src.masked.operand]; }
        j = j + 1;
    }
    ret admit(rd, r, ?base[0], ?where[0], best);
}

# whether candidate `a` is tried after candidate `b`
fun later(a: core_syntax.Candidate, b: core_syntax.Candidate) bool {
    ret a.row > b.row || (a.row == b.row && a.alias > b.alias);
}

# byte `depth` of the key of entry `i`, in lower case when the syntax folds
fun key_byte(rd: *core_syntax.Reader, i: u32, depth: usize) u8 {
    val c: u8 = rd.syntax.index.at[i].key[depth];
    if (rd.syntax.fold) { ret core_syntax.lower(c); }
    ret c;
}

# the first entry of `lo` up to `hi` whose key byte `depth` is `c` or above, or above when `above`
fun narrow(rd: *core_syntax.Reader, lo: u32, hi: u32, depth: usize, c: u8, above: bool) u32 {
    var l: u32 = lo;
    var h: u32 = hi;
    for (l < h) {
        val mid: u32 = l + (h - l) / 2;
        val k:   u8  = key_byte(rd, mid, depth);
        if (k < c || (above && k == c)) { l = mid + 1; }
        or                              { h = mid; }
    }
    ret l;
}

# the first candidate of entry `e` after `last`, or its first when none has been tried
fun within(ix: *core_syntax.Index, e: *core_syntax.Entry, started: bool, last: core_syntax.Candidate, out: *core_syntax.Candidate) bool {
    var lo: u32 = 0;
    var hi: u32 = e.len;
    for (started && lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (later(ix.candidates[e.first + mid], last)) { hi = mid; }
        or                                             { lo = mid + 1; }
    }
    if (lo >= e.len) { ret false; }
    @out = ix.candidates[e.first + lo];
    ret true;
}

# the next candidate to try for the text at `head`, the earliest after `last` of every entry whose key starts the text
# ---
# started: whether `last` is set, false for the first candidate
# ret:     whether there is one, then in `out`
fun next(rd: *core_syntax.Reader, head: usize, started: bool, last: core_syntax.Candidate, out: *core_syntax.Candidate) bool {
    val ix:    *core_syntax.Index = ?rd.syntax.index;
    var lo:    u32                = 0;
    var hi:    u32                = ix.len;
    var depth: usize              = 0;
    var at:    usize              = head;
    var found: bool               = false;
    for (lo < hi) {
        # the entry whose key ends here sorts before every longer key
        if (ix.at[lo].key[depth] == 0) {
            var c: core_syntax.Candidate;
            if (within(ix, ?ix.at[lo], started, last, ?c) && (!found || later(@out, c))) {
                @out  = c;
                found = true;
            }
            lo = lo + 1;
        }
        if (lo >= hi || at >= rd.end) { brk; }
        var b: u8 = rd.text[at];
        # a run of white space reads as the one space of a key joining a prefix to its word
        if (read.blank(b))  { b = ' '; }
        if (rd.syntax.fold) { b = core_syntax.lower(b); }
        val first: u32 = narrow(rd, lo, hi, depth, b, false);
        hi    = narrow(rd, first, hi, depth, b, true);
        lo    = first;
        depth = depth + 1;
        at    = at + 1;
        if (b == ' ') {
            for (at < rd.end && read.blank(rd.text[at])) {
                at = at + 1;
            }
        }
    }
    ret found;
}

# whether the text at `at` is `marker`, a whole token
fun spells(rd: *core_syntax.Reader, at: usize, marker: str) bool {
    val len: usize = str_len(marker);
    if (len == 0 || at + len > rd.end) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (!read.same(rd, rd.text[at + i], marker[i])) { ret false; }
        i = i + 1;
    }
    ret !(read.word(marker[len - 1]) && at + len < rd.end && read.word(rd.text[at + len]));
}

# the reader with no form markers read, as a statement that spells none starts
fun unmarked(rd: *core_syntax.Reader) {
    rd.form    = core_form.PREFERRED;
    rd.lead    = rd.start;
    rd.marked  = rd.end;
    rd.skipped = 0;
}

# the form markers at the reader's position read into its form: those before the mnemonic, the reader left past them at
# `lead`, then the one its mnemonic ends with, which `marked` and `skipped` hop
fun markers(rd: *core_syntax.Reader) {
    val forms: *core_form.FormFields = ?rd.codec.forms;
    unmarked(rd);
    var moved: bool = true;
    for (moved) {
        moved = false;
        var i: u32 = 0;
        for (i < forms.len && !moved) {
            val f: *core_form.FormField = ?forms.at[i];
            if (f.marker != nil && !f.suffix && spells(rd, rd.at, f.marker)) {
                rd.form = core_form.with(rd.form, f);
                rd.at   = rd.at + str_len(f.marker);
                read.skip(rd);
                moved = true;
            }
            i = i + 1;
        }
    }
    rd.lead = rd.at;
    val end: usize = read.mnemonic_end(rd, rd.at);
    var i:   u32   = 0;
    for (i < forms.len) {
        val f:   *core_form.FormField = ?forms.at[i];
        val len: usize                = str_len(f.marker);
        if (f.marker != nil && f.suffix && len > 0 && end >= rd.at + len + 1 && spells(rd, end - len, f.marker)) {
            rd.form    = core_form.with(rd.form, f);
            rd.marked  = end - len;
            rd.skipped = len;
            ret;
        }
        i = i + 1;
    }
}

# the instruction at the reader's text, read in its syntax
# ---
# rd:  the reader over the instruction's text, its pool holding the values first and then list members
# ret: the instruction, its values in the pool, or the refusal at its column
pub fun instruction(rd: *core_syntax.Reader) res[inst.Inst, diagnostic.Diagnostic] {
    var best:      Best = Best{held: false, complete: false, refusal: diagnostic.Diagnostic{message: read.UNKNOWN_MNEMONIC, span: diagnostic.Span{start: rd.origin, len: 0}, requires: requirement.NO_ALTERNATIVES}, unmet: false, full: false};
    var keyed_any: bool = false;
    rd.at           = rd.start;
    rd.refused.used = 0;
    read.skip(rd);
    markers(rd);
    val head:    usize = rd.at;
    var last:    core_syntax.Candidate;
    var current: core_syntax.Candidate;
    var started: bool  = false;
    # the first instruction read with an operand of no size, held while the candidates after it are tried for one of
    # another size
    var held: opt[inst.Inst] = opt[inst.Inst].none{};
    var kept: [row.MAX_OPERANDS]operand.Value;
    for (next(rd, head, started, last, ?current)) {
        started = true;
        last    = current;
        val r: *row.Row = ?rd.codec.rows.at[current.row];
        if (rd.cap < r.operands.len) {
            read.pool_short(rd, r.operands.len::u64);
            ret res[inst.Inst, diagnostic.Diagnostic].err{read.refuse(rd, field.STORAGE, head, 0)};
        }
        var got: opt[inst.Inst] = opt[inst.Inst].none{};
        rd.unsized = false;
        if (current.alias == 0) {
            if ((r.flags & row.DECODE_ONLY) != 0 || !keyed(rd, rd.syntax.forms.at[current.row], head)) { cnt; }
            keyed_any = true;
            got       = by_row(rd, current.row, ?best);
        }
        or {
            val a: *core_syntax.Alias = ?rd.syntax.aliases.at[current.alias - 1];
            if (!keyed(rd, a.template, head)) { cnt; }
            keyed_any = true;
            got       = by_alias(rd, a, ?best);
        }
        if (sel got.some) {
            if (sel held.some) {
                if (!same_sizes(held.some.row, got.some.row)) { ret res[inst.Inst, diagnostic.Diagnostic].err{read.refuse(rd, AMBIGUOUS_SIZE, head, read.mnemonic_end(rd, head) - head)}; }
            }
            or (!rd.unsized) { ret res[inst.Inst, diagnostic.Diagnostic].ok{got.some}; }
            or {
                var k: u32 = 0;
                for (k < got.some.count) {
                    kept[k] = got.some.values[k];
                    k       = k + 1;
                }
                held = got;
            }
        }
    }
    if (sel held.some) {
        var k: u32 = 0;
        for (k < held.some.count) {
            rd.pool[k] = kept[k];
            k          = k + 1;
        }
        ret res[inst.Inst, diagnostic.Diagnostic].ok{inst.Inst{row: held.some.row, values: rd.pool, count: held.some.count, form: held.some.form}};
    }
    if (!keyed_any) { ret res[inst.Inst, diagnostic.Diagnostic].err{read.refuse(rd, read.UNKNOWN_MNEMONIC, head, read.mnemonic_end(rd, head) - head)}; }
    if (best.full)  { ret res[inst.Inst, diagnostic.Diagnostic].err{read.refuse(rd, field.STORAGE, head, 0)}; }
    if (best.unmet) { best.refusal.requires = field.noted(?rd.refused); }
    ret res[inst.Inst, diagnostic.Diagnostic].err{best.refusal};
}

# whether rows `a` and `b` access memory of the same sizes, so text of no size that both read reads as either alike
fun same_sizes(a: *row.Row, b: *row.Row) bool {
    if (a.operands.len != b.operands.len) { ret false; }
    var k: u32 = 0;
    for (k < a.operands.len) {
        val x: *operand.Operand = ?a.operands.at[k];
        val y: *operand.Operand = ?b.operands.at[k];
        if ((sel x.shape.memory || sel y.shape.memory) && x.width != y.width) { ret false; }
        k = k + 1;
    }
    ret true;
}

# a format of a source dialect's instruction directive that took a text, and the instruction it states
# ---
# format: the format
# inst:   its row and values, the values in the reader's pool
pub rec Taken {
    format: *source.Format;
    inst:   inst.Inst;
}

# the text at the reader read by whichever one of `formats` takes it whole, as risc-v's `.insn` reads what follows it,
# the formats tried in order and those whose name the text does not start with passed over
# ---
# rd:  the reader over the directive's operands, its pool holding the values first and then list members
# ret: the format and the instruction it states, or the refusal of the format that read furthest
pub fun format(rd: *core_syntax.Reader, formats: source.Formats) res[Taken, diagnostic.Diagnostic] {
    var best:      Best = Best{held: false, complete: false, refusal: diagnostic.Diagnostic{message: UNKNOWN_FORMAT, span: diagnostic.Span{start: rd.origin, len: 0}, requires: requirement.NO_ALTERNATIVES}, unmet: false, full: false};
    var keyed_any: bool = false;
    rd.at           = rd.start;
    rd.refused.used = 0;
    unmarked(rd);
    read.skip(rd);
    val head: usize = rd.at;
    var i:    u32   = 0;
    for (i < formats.len) {
        val f: *source.Format = ?formats.at[i];
        i = i + 1;
        if (!keyed(rd, f.template, head)) { cnt; }
        if (rd.cap < f.row.operands.len) {
            read.pool_short(rd, f.row.operands.len::u64);
            ret res[Taken, diagnostic.Diagnostic].err{read.refuse(rd, field.STORAGE, head, 0)};
        }
        keyed_any = true;
        val got: opt[inst.Inst] = templated(rd, f.row, f.template, ?best);
        if (sel got.some) { ret res[Taken, diagnostic.Diagnostic].ok{Taken{format: f, inst: got.some}}; }
    }
    if (!keyed_any) { ret res[Taken, diagnostic.Diagnostic].err{read.refuse(rd, UNKNOWN_FORMAT, head, read.token(rd, head))}; }
    if (best.full)  { ret res[Taken, diagnostic.Diagnostic].err{read.refuse(rd, field.STORAGE, head, 0)}; }
    if (best.unmet) { best.refusal.requires = field.noted(?rd.refused); }
    ret res[Taken, diagnostic.Diagnostic].err{best.refusal};
}

# the first of the syntax's sequence spellings in mnemonic order whose mnemonic is `word`, a binary search, len when none is
fun named_first(rd: *core_syntax.Reader, word: View) u32 {
    val qs: *core_syntax.Sequences = ?rd.syntax.sequences;
    var lo: u32                    = 0;
    var hi: u32                    = qs.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (core_syntax.compare(rd.syntax, core_syntax.mnemonic(rd.syntax.prefixes, qs.at[qs.named[mid]].template), word) < 0) { lo = mid + 1; }
        or                                                                                                                     { hi = mid; }
    }
    ret lo;
}

# the sequence spelling `q` read and its instructions admitted, into `out`
fun by_sequence(rd: *core_syntax.Reader, q: *core_syntax.Sequence, best: *Best, out: *relax.Expansion) bool {
    if (!state.admits(rd.ctx, q.requires)) {
        keep_unmet(rd, best, q.requires, rd.start, read.token(rd, rd.start));
        ret false;
    }
    var descs:  [row.MAX_OPERANDS]*operand.Operand;
    var values: [row.MAX_OPERANDS]operand.Value;
    var spans:  [row.MAX_OPERANDS]usize;
    var k:      u32 = 0;
    for (k < q.operands.len) {
        descs[k] = ?q.operands.at[k];
        spans[k] = rd.start;
        k        = k + 1;
    }
    rd.at   = rd.start;
    rd.used = q.operands.len;
    val matched: err[diagnostic.Diagnostic] = match(rd, q.template, ?descs[0], ?values[0], ?spans[0], best);
    if (sel matched.err) {
        keep(best, matched.err, false);
        ret false;
    }
    if (!refuse_bound(rd, best)) { ret false; }
    if (!seq.expand(q, ?values[0], core_syntax.OWN, out)) {
        keep(best, read.refuse(rd, read.UNEXPECTED, rd.start, read.token(rd, rd.start)), true);
        ret false;
    }
    var i: u32 = 0;
    for (i < out.count) {
        var ins:      inst.Inst          = inst.Inst{row: out.steps[i].row, values: ?out.steps[i].values[0], count: out.steps[i].row.operands.len};
        val admitted: err[field.Refusal] = walk.admits(rd.codec, rd.ctx, ?ins);
        if (sel admitted.err) {
            keep_refused(rd, best, admitted.err, rd.start);
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

# the statement at the reader's text, read in its syntax: what the syntax's statement hook reads around it, then the
# instructions of a sequence spelling, or one instruction
# ---
# rd:  the reader over the statement's text, its pool holding list members. the hook's text is passed, so the
#      instruction starts after it, and the result it binds is left in `bound`
# out: the instructions read, in order
# ret: ok, or the refusal at its column
pub fun statement(rd: *core_syntax.Reader, out: *relax.Expansion) err[diagnostic.Diagnostic] {
    rd.at    = rd.start;
    rd.bound = operand.Value.none{};
    if (rd.syntax.statement != nil) {
        read.skip(rd);
        val around: err[diagnostic.Diagnostic] = rd.syntax.statement(rd);
        if (sel around.err) { ret around; }
        rd.origin = diagnostic.advance(rd.origin, ?rd.text[rd.start], rd.at - rd.start);
        rd.start  = rd.at;
    }
    var best:      Best = Best{held: false, complete: false, refusal: diagnostic.Diagnostic{message: read.UNKNOWN_MNEMONIC, span: diagnostic.Span{start: rd.origin, len: 0}, requires: requirement.NO_ALTERNATIVES}, unmet: false, full: false};
    var keyed_any: bool = false;
    var moded:     bool = false;
    rd.at           = rd.start;
    rd.refused.used = 0;
    unmarked(rd);
    read.skip(rd);
    val head: usize                  = rd.at;
    val word: View                   = read.span(rd, head, read.mnemonic_end(rd, head) - head);
    val qs:   *core_syntax.Sequences = ?rd.syntax.sequences;
    var i:    u32                    = named_first(rd, word);
    for (i < qs.len && core_syntax.compare(rd.syntax, core_syntax.mnemonic(rd.syntax.prefixes, qs.at[qs.named[i]].template), word) == 0) {
        val q: *core_syntax.Sequence = ?qs.at[qs.named[i]];
        i = i + 1;
        if (!keyed(rd, q.template, head)) { cnt; }
        if (!mode.holds(rd.modes, q.when)) {
            moded = true;
            cnt;
        }
        keyed_any = true;
        if (by_sequence(rd, q, ?best, out)) { ret err[diagnostic.Diagnostic].ok{}; }
    }
    if (keyed_any) {
        if (best.unmet) { best.refusal.requires = field.noted(?rd.refused); }
        ret err[diagnostic.Diagnostic].err{best.refusal};
    }
    if (moded) { ret err[diagnostic.Diagnostic].err{read.refuse(rd, read.OTHER_MODE, head, word.len)}; }
    val one: res[inst.Inst, diagnostic.Diagnostic] = instruction(rd);
    if (sel one.err) { ret err[diagnostic.Diagnostic].err{one.err}; }
    out.count           = 1;
    out.steps[0].row    = one.ok.row;
    out.steps[0].marker = operand.NO_FIXUP;
    out.steps[0].form   = one.ok.form;
    var k: u32 = 0;
    for (k < one.ok.count) {
        out.steps[0].values[k] = one.ok.values[k];
        k                      = k + 1;
    }
    ret err[diagnostic.Diagnostic].ok{};
}

# a test's selection, its register view, the syntax it reads and writes, the parser's storage and its output
#[testing]
rec T {
    t:          testing.Testing;
    syntax:     *core_syntax.Syntax;
    s:          extension.Selection;
    v:          register.Available;
    ctx:        state.Context;
    modes:      mode.State;
    store:      [16]operand.Value;
    admissions: [8]requirement.Alternative;
    out:        vector.Vector[u8];
    codec:      *dispatch.Codec;
}

# a test over the selection the risc-v `isa` string spells
#[testing]
fun t_make(t: *T, isa: str) bool {
    testing.make(?t.t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t.t), ?riscv_extension.CATALOG, isa, diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    ret t_view(t);
}

# the test's context over its selection, at the axes' initial values unless the selection states others
#[testing]
fun t_view(t: *T) bool {
    val opened: res[state.Context, state.Opened] = state.open(testing.allocator_of(?t.t), ?riscv_register.FILE, ?t.s, ?riscv_extension.AXES, state.initial(?riscv_extension.AXES), ?t.v);
    if (sel opened.err) { ret false; }
    t.ctx    = opened.ok;
    t.modes  = mode.initial(?riscv_mode.MODES);
    t.out    = vector.init[u8](testing.allocator_of(?t.t));
    t.syntax = ?riscv_syntax.SYNTAX;
    t.codec  = ?riscv_catalog.CODEC;
    ret true;
}

# a test over the first alternative of row `r`'s requirement, the i base and a width: xlen=32 when the alternative names
# it, else xlen=64
#[testing]
fun t_make_for(t: *T, r: *row.Row, extra: requirement.Requirement) bool {
    testing.make(?t.t);
    val made: res[extension.Request, extension.Error] = extension.request(testing.allocator_of(?t.t), ?riscv_extension.CATALOG, "", diagnostic.START);
    if (sel made.err) { ret false; }
    var req:   extension.Request = made.ok;
    var width: requirement.Id    = riscv_extension.id.XLEN_64;
    if (r.requires.len > 0) {
        val alt: requirement.Ids = r.requires.at[0].all;
        var i:   u32             = 0;
        for (i < alt.len) {
            extension.request_add(?req, alt.at[i]);
            if (alt.at[i] == riscv_extension.id.XLEN_32) { width = riscv_extension.id.XLEN_32; }
            i = i + 1;
        }
    }
    # the alias's own requirement as well
    if (extra.len > 0) {
        val alt: requirement.Ids = extra.at[0].all;
        var i:   u32             = 0;
        for (i < alt.len) {
            extension.request_add(?req, alt.at[i]);
            if (alt.at[i] == riscv_extension.id.XLEN_32) { width = riscv_extension.id.XLEN_32; }
            i = i + 1;
        }
    }
    extension.request_add(?req, width);
    extension.request_add(?req, riscv_extension.id.BASE_I);
    extension.request_add(?req, riscv_extension.id.I);
    val closed: res[extension.Selection, extension.Error] = extension.close(req);
    if (sel closed.err) { ret false; }
    t.s = closed.ok;
    ret t_view(t);
}

# the symbols of the tests: `far` is handle 1 and `hi` handle 2, the label of a `%pcrel_hi` instruction
#[testing]
fun t_resolve(context: ptr, name: View) res[core_syntax.Resolved, str] {
    if (view_eq_str(name, "far")) { ret res[core_syntax.Resolved, str].ok{core_syntax.Resolved.symbol{1}}; }
    if (view_eq_str(name, "hi"))  { ret res[core_syntax.Resolved, str].ok{core_syntax.Resolved.symbol{2}}; }
    ret res[core_syntax.Resolved, str].err{"unknown symbol"};
}

#[testing]
fun t_name(context: ptr, id: u32) View {
    if (id == 2) { ret view("hi", 2); }
    ret view("far", 3);
}

#[testing]
val T_SYMBOLS: core_syntax.Symbols = core_syntax.Symbols{context: nil, resolve: t_resolve, name: t_name};

# a reader over `text`, starting at `origin`
#[testing]
fun t_reader(t: *T, text: str, origin: diagnostic.Position) core_syntax.Reader {
    ret core_syntax.Reader{
        text:    text,
        start:   0,
        at:      0,
        end:     str_len(text),
        origin:  origin,
        codec:   t.codec,
        ctx:     ?t.ctx,
        syntax:  t.syntax,
        modes:   ?t.modes,
        symbols: ?T_SYMBOLS,
        context: nil,
        row:     nil,
        pool:    ?t.store[0],
        cap:     16,
        used:    0,
        bytes:   nil,
        room:    0,
        taken:   0,
        refused: field.Admissions{at: ?t.admissions[0], cap: 8, used: 0},
    };
}

# `text` read in the risc-v syntax, starting at `origin`
#[testing]
fun t_parse(t: *T, text: str, origin: diagnostic.Position) res[inst.Inst, diagnostic.Diagnostic] {
    var rd: core_syntax.Reader = t_reader(t, text, origin);
    ret instruction(?rd);
}

# `ins` written in the risc-v syntax into the test's output, ending in a nul
#[testing]
fun t_print(t: *T, ins: *inst.Inst) bool {
    t.out.len = 0;
    var w:       core_syntax.Writer = core_syntax.Writer{out: ?t.out, codec: t.codec, ctx: ?t.ctx, syntax: t.syntax, modes: ?t.modes, symbols: ?T_SYMBOLS, context: nil, row: nil, dot: false, values: nil};
    val printed: err[field.Refusal] = print.instruction(?w, ins);
    if (sel printed.err) { ret false; }
    val pushed: res[usize, A.Error] = vector.push[u8](?t.out, 0);
    ret sel pushed.ok;
}

# whether `text` reads and writes back as exactly `want`
#[testing]
fun t_prints_as(t: *T, text: str, want: str) bool {
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(t, text, diagnostic.START);
    if (sel got.err) { ret false; }
    var ins: inst.Inst = got.ok;
    if (!t_print(t, ?ins)) { ret false; }
    ret str_equals(t.out.data, want);
}

test instruction__an_alias_prints_only_when_its_condition_holds {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val from: [8]str = [8]str{"addi t0, t1, 0", "addi t0, t1, 1", "addi zero, zero, 0", "addi t0, zero, 3", "addi t0, zero, 0", "jalr zero, 0(ra)", "beq t0, zero, 8", "sub t0, zero, t1"};
    val want: [8]str = [8]str{"mv t0, t1", "addi t0, t1, 1", "nop", "li t0, 3", "li t0, 0", "ret", "beqz t0, 8", "neg t0, t1"};
    var i:    u32    = 0;
    for (i < 8) {
        if (!t_prints_as(?t, from[i], want[i])) { ret 2 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

# an alias of the risc-v rows that reads `addi rd, zero, imm` as `li.nz rd, imm` for every immediate but zero
#[testing]
val T_NZ_EXCLUDED: [1]i64 = [1]i64{0};

#[testing]
val T_NZ_EXCLUSIONS: [1]core_syntax.Exclusion = [1]core_syntax.Exclusion{core_syntax.Exclusion{operand: 1, excluded: core_syntax.Excluded.immediate{operand.Integers{at: ?T_NZ_EXCLUDED[0], len: 1}}}};

#[testing]
val T_NZ_SOURCES: [3]core_syntax.Source = [3]core_syntax.Source{core_syntax.Source.operand{0}, core_syntax.Source.register{0}, core_syntax.Source.operand{1}};

#[testing]
val T_NZ_ALIASES: [1]core_syntax.Alias = [1]core_syntax.Alias{core_syntax.Alias{row: 3, template: "li.nz <0>, <1>", count: 2, sources: core_syntax.Sources{at: ?T_NZ_SOURCES[0], len: 3}, derive: nil, exclusions: core_syntax.Exclusions{at: ?T_NZ_EXCLUSIONS[0], len: 1}, requires: requirement.NO_ALTERNATIVES, preference: 1}};

#[testing]
val T_NZ_CANDIDATES: [2]core_syntax.Candidate = [2]core_syntax.Candidate{core_syntax.Candidate{row: 3, alias: 0}, core_syntax.Candidate{row: 3, alias: 1}};

#[testing]
val T_NZ_ENTRIES: [2]core_syntax.Entry = [2]core_syntax.Entry{core_syntax.Entry{key: "addi", first: 0, len: 1}, core_syntax.Entry{key: "li.nz", first: 1, len: 1}};

test instruction__an_alias_refuses_a_value_it_excludes_and_the_base_row_spells_it {
    var t: T;
    if (!t_make(?t, "rv64i"))                                         { ret 1; }
    if (!str_equals(riscv_catalog.CODEC.rows.at[3].mnemonic, "addi")) { ret 2; }
    var syntax: core_syntax.Syntax = riscv_syntax.SYNTAX;
    syntax.aliases = core_syntax.Aliases{at: ?T_NZ_ALIASES[0], len: 1};
    syntax.index   = core_syntax.Index{at: ?T_NZ_ENTRIES[0], len: 2, candidates: ?T_NZ_CANDIDATES[0], count: 2};
    t.syntax       = ?syntax;
    val refused: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "li.nz a0, 0", diagnostic.START);
    if (!sel refused.err)                                         { ret 3; }
    if (refused.err.message != field.EXCLUDED)                    { ret 4; }
    if (refused.err.span.start.column != 11)                      { ret 5; }
    if (!t_prints_as(?t, "li.nz a0, 3", "li.nz a0, 3"))           { ret 6; }
    if (!t_prints_as(?t, "addi a0, zero, 3", "li.nz a0, 3"))      { ret 7; }
    if (!t_prints_as(?t, "addi a0, zero, 0", "addi a0, zero, 0")) { ret 8; }
    ret 0;
}

test instruction__every_alias_form_parses_to_its_base_row {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "mv a0, a1", diagnostic.START);
    if (sel got.err)                              { ret 2; }
    if (!str_equals(got.ok.row.mnemonic, "addi")) { ret 3; }
    val v: operand.Value = got.ok.values[2];
    if (!(sel v.immediate && v.immediate == 0)) { ret 4; }
    ret 0;
}

test index__a_shared_mnemonic_yields_every_candidate_in_order {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var rd:      core_syntax.Reader = t_reader(?t, "fence", diagnostic.START);
    var last:    core_syntax.Candidate;
    var got:     core_syntax.Candidate;
    var started: bool               = false;
    var count:   u32                = 0;
    for (next(?rd, 0, started, last, ?got)) {
        val m: View = core_syntax.mnemonic(riscv_syntax.SYNTAX.prefixes, core_syntax.template(?riscv_syntax.SYNTAX, got));
        if (!view_eq_str(m, "fence"))     { ret 3; }
        if (started && !later(got, last)) { ret 4; }
        started = true;
        last    = got;
        count   = count + 1;
    }
    # the row, and the alias of its sets at iorw
    if (count != 2) { ret 5; }
    ret 0;
}

test instruction__a_pcrel_lo_operand_names_the_label_of_its_pcrel_hi_instruction {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val hi: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "auipc a0, %pcrel_hi(far+8)", diagnostic.START);
    if (sel hi.err) { ret 2; }
    val high: operand.Value = hi.ok.values[1];
    if (!(sel high.symbol && (high.symbol.id == 1 && high.symbol.addend == 8 && high.symbol.fixup == operand.NO_FIXUP))) { ret 3; }
    # the second instruction names the first one's label, not the symbol
    var t2: T;
    if (!t_make(?t2, "rv64i")) { ret 4; }
    val lo: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t2, "addi a0, a0, %pcrel_lo(hi)", diagnostic.START);
    if (sel lo.err) { ret 5; }
    val low: operand.Value = lo.ok.values[2];
    if (!(sel low.symbol && (low.symbol.id == 2 && low.symbol.addend == 0 && low.symbol.fixup == riscv_fixup.PCREL_LO12_I))) { ret 6; }
    ret 0;
}

test instruction__the_row_the_selection_admits_is_the_one_read {
    var narrow: T;
    var wide:   T;
    if (!t_make(?narrow, "rv32i")) { ret 1; }
    if (!t_make(?wide, "rv64i"))   { ret 2; }
    val a: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?narrow, "slli a0, a0, 3", diagnostic.START);
    val b: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?wide, "slli a0, a0, 3", diagnostic.START);
    if (sel a.err)                                                                                    { ret 3; }
    if (sel b.err)                                                                                    { ret 3; }
    if (a.ok.row == b.ok.row)                                                                         { ret 4; }
    if (!state.admits(?narrow.ctx, a.ok.row.requires) || !state.admits(?wide.ctx, b.ok.row.requires)) { ret 5; }
    # a shift past rv32's five bits is refused there and read by rv64's row
    val far: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?narrow, "slli a0, a0, 40", diagnostic.START);
    if (!sel far.err) { ret 6; }
    ret 0;
}

# a hook reading `r<n>` as x register n, and writing a register no row names as `r<class>.<number>`
#[testing]
fun t_hook_read(r: *core_syntax.Reader) opt[register.Id] {
    if (r.at + 1 >= r.end || r.text[r.at] != 'r') { ret opt[register.Id].none{}; }
    var at: usize = r.at + 1;
    var n:  u16   = 0;
    for (at < r.end && r.text[at] >= '0' && r.text[at] <= '9') {
        n  = n * 10 + (r.text[at] - '0')::u16;
        at = at + 1;
    }
    if (at == r.at + 1 || n >= 32) { ret opt[register.Id].none{}; }
    r.at = at;
    ret opt[register.Id].some{register.make(0, n)};
}

#[testing]
fun t_hook_write(w: *core_syntax.Writer, reg: register.Id, op: u8) err[field.Refusal] {
    var digits: [3]u8              = [3]u8{'r', '0' + (register.class_of(reg) % 10)::u8, 0};
    val head:   err[field.Refusal] = write.text(w, ?digits[0]);
    if (sel head.err) { ret head; }
    var tail: [3]u8 = [3]u8{'.', '0' + (register.number_of(reg) % 10)::u8, 0};
    ret write.text(w, ?tail[0]);
}

#[testing]
val T_REGISTER_HOOK: core_syntax.RegisterHook = core_syntax.RegisterHook{read: t_hook_read, write: t_hook_write};

# a syntax's register hook reads what no name spells and writes what no row names, after the name table
test instruction__a_register_hook_spells_what_no_row_name_does {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var hooked: core_syntax.Syntax = riscv_syntax.SYNTAX;
    hooked.hooks.register = ?T_REGISTER_HOOK;
    t.syntax              = ?hooked;
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "add r5, a0, r31", diagnostic.START);
    if (sel got.err) { ret 2; }
    val ins: inst.Inst = got.ok;
    if (!(sel ins.values[0].register && ins.values[0].register == register.make(0, 5)))  { ret 3; }
    if (!(sel ins.values[1].register && ins.values[1].register == register.make(0, 10))) { ret 4; }
    if (!(sel ins.values[2].register && ins.values[2].register == register.make(0, 31))) { ret 5; }
    val unknown: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "add r40, a0, a1", diagnostic.START);
    if (!sel unknown.err) { ret 6; }
    t.out.len = 0;
    var w:     core_syntax.Writer = core_syntax.Writer{out: ?t.out, codec: ?riscv_catalog.CODEC, ctx: ?t.ctx, syntax: t.syntax, modes: ?t.modes, symbols: ?T_SYMBOLS, context: nil, row: nil, dot: false, values: nil};
    val named: err[field.Refusal] = write.register_name(?w, register.make(0, 5), 0);
    val raw:   err[field.Refusal] = write.register_name(?w, register.make(9, 3), 0);
    if (sel named.err || sel raw.err) { ret 7; }
    val ended: res[usize, A.Error] = vector.push[u8](?t.out, 0);
    if (sel ended.err)                     { ret 10; }
    if (!str_equals(t.out.data, "t0r9.3")) { ret 8; }
    t.syntax = ?riscv_syntax.SYNTAX;
    w.syntax = t.syntax;
    val bare: err[field.Refusal] = write.register_name(?w, register.make(9, 3), 0);
    if (!sel bare.err) { ret 9; }
    ret 0;
}

#[testing]
fun t_fits(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# the riscv syntax with the form of row `at`, as 0 for add's, replaced by `form`, its forms held in `forms`, the test
# reading it
#[testing]
fun t_reformed(t: *T, at: u32, form: str, forms: *vector.Vector[str], out: *core_syntax.Syntax) bool {
    @forms = vector.init[str](testing.allocator_of(?t.t));
    var i: u32 = 0;
    for (i < riscv_syntax.SYNTAX.forms.len) {
        if (!t_fits(vector.push[str](forms, riscv_syntax.SYNTAX.forms.at[i]))) { ret false; }
        i = i + 1;
    }
    forms.data[at] = form;
    @out           = riscv_syntax.SYNTAX;
    out.forms      = core_syntax.Forms{at: forms.data, len: riscv_syntax.SYNTAX.forms.len};
    t.syntax       = out;
    ret true;
}

# a register hole formatted `number` reads the register by its number within the operand's one class and prints it so
test instruction__a_numbered_register_hole_reads_and_prints_the_number {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var forms:    vector.Vector[str];
    var numbered: core_syntax.Syntax;
    if (!t_reformed(?t, 0, "add x<0:number>, <1>, <2>", ?forms, ?numbered)) { ret 2; }
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "add x5, a0, a1", diagnostic.START);
    if (sel got.err) { ret 3; }
    val ins: inst.Inst = got.ok;
    if (ins.row != ?gen_row.ROWS[gen_row_index.ADD])                                    { ret 4; }
    if (!(sel ins.values[0].register && ins.values[0].register == register.make(0, 5))) { ret 5; }
    if (!t_prints_as(?t, "add x31, a0, a1", "add x31, a0, a1"))                         { ret 6; }
    val beyond: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "add x32, a0, a1", diagnostic.START);
    if (!sel beyond.err) { ret 7; }
    val named: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "add xt0, a0, a1", diagnostic.START);
    if (!sel named.err) { ret 8; }
    ret 0;
}

# an operand the template writes again prints at each hole and reads only where every spelling reads one value, as
# aarch64 sve's destructive `add z0.s, p0/m, z0.s, z1.s` writes its first source and destination twice
test instruction__an_operand_written_again_reads_one_value_and_prints_at_each_hole {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var forms: vector.Vector[str];
    var tied:  core_syntax.Syntax;
    if (!t_reformed(?t, 0, "add <0>, <1>, <2>, <0>", ?forms, ?tied)) { ret 2; }
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "add t0, a0, a1, t0", diagnostic.START);
    if (sel got.err) { ret 3; }
    val ins: inst.Inst = got.ok;
    if (ins.row != ?gen_row.ROWS[gen_row_index.ADD] || !(sel ins.values[0].register && ins.values[0].register == register.make(0, 5))) { ret 4; }
    if (!t_prints_as(?t, "add x5, a0, a1, x5", "add t0, a0, a1, t0"))                                                                  { ret 5; }
    val other: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "add t0, a0, a1, t1", diagnostic.START);
    if (!sel other.err) { ret 6; }
    val d: diagnostic.Diagnostic = other.err;
    if (d.message != REPEATED || d.span.start.column != 17) { ret 7; }
    ret 0;
}

# a derived hole spells the value its operand's gives, a register a number past or of the number in the first of other
# classes that holds it, as csr 10 is vxrm and no csr is numbered 11, or an immediate more, and reads only that value
# back
test instruction__a_derived_hole_reads_and_prints_the_value_its_derivation_gives {
    var t: T;
    if (!t_make(?t, "rv64imafdcv_zba")) { ret 1; }
    var forms:   vector.Vector[str];
    var derived: core_syntax.Syntax;
    if (!t_reformed(?t, 0, "add <0>, <1>, <2>, <1:+1>, <1:=csr,f>, <2:=csr,f>", ?forms, ?derived)) { ret 2; }
    if (!t_prints_as(?t, "add t0, a0, a1, a1, vxrm, fa1", "add t0, a0, a1, a1, vxrm, fa1"))        { ret 3; }
    val past: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "add t0, a0, a1, a2, vxrm, fa1", diagnostic.START);
    if (!sel past.err)                                                   { ret 4; }
    if (past.err.message != DERIVED || past.err.span.start.column != 17) { ret 5; }
    val class: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "add t0, a0, a1, a1, vxrm, fa0", diagnostic.START);
    if (!(sel class.err && class.err.message == DERIVED)) { ret 6; }
    # no x register lies past x31
    val beyond: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "add t0, t6, a1, zero, ft11, fa1", diagnostic.START);
    if (!(sel beyond.err && beyond.err.message == DERIVED)) { ret 7; }
    var immediates: vector.Vector[str];
    var more:       core_syntax.Syntax;
    if (!t_reformed(?t, gen_row_index.ADDI, "addi <0>, <1>, <2>, <2:+1>", ?immediates, ?more)) { ret 8; }
    if (!t_prints_as(?t, "addi t0, t1, 5, 6", "addi t0, t1, 5, 6"))                            { ret 9; }
    val other: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "addi t0, t1, 5, 7", diagnostic.START);
    if (!(sel other.err && other.err.message == DERIVED)) { ret 10; }
    ret 0;
}

# form markers of a test codec: thumb-like `.w` after the mnemonic, and the exact form's `{exact}` before it
#[testing]
val T_MARKERS: [2]core_form.FormField = [2]core_form.FormField{
    core_form.FormField{name: "wide", mask: 0x1, value: 0x1, marker: ".w", suffix: true},
    core_form.FormField{name: "exact", mask: core_form.EXACT, value: core_form.EXACT, marker: "{exact}", suffix: false},
};

# a form marker before or after the mnemonic reads into the instruction's form, and prints back where it was read
test instruction__form_markers_read_into_the_form_and_print_back {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var codec: dispatch.Codec = riscv_catalog.CODEC;
    codec.forms = core_form.FormFields{at: ?T_MARKERS[0], len: 2};
    t.codec     = ?codec;
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "{exact}  addi.w a0, a0, 1", diagnostic.START);
    if (sel got.err) { ret 2; }
    var ins: inst.Inst = got.ok;
    if (ins.form.bits != (core_form.EXACT | 0x1) || ins.row != ?gen_row.ROWS[gen_row_index.ADDI]) { ret 3; }
    if (!t_print(?t, ?ins) || !str_equals(t.out.data, "{exact} addi.w a0, a0, 1"))                { ret 4; }
    if (!t_prints_as(?t, "addi a0, a0, 1", "addi a0, a0, 1"))                                     { ret 5; }
    if (!t_prints_as(?t, "addi.w a0, a0, 1", "addi.w a0, a0, 1"))                                 { ret 6; }
    ret 0;
}

test instruction__a_malformed_operand_is_refused_at_its_column {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val origin: diagnostic.Position                   = diagnostic.Position{offset: 40, line: 3, column: 5};
    val got:    res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "addi a0, a0, 12q", origin);
    if (!sel got.err) { ret 2; }
    val d: diagnostic.Diagnostic = got.err;
    if (d.message != read.MALFORMED)                                                                         { ret 3; }
    if (d.span.start.line != 3 || d.span.start.column != 18 || d.span.start.offset != 53 || d.span.len != 3) { ret 4; }
    ret 0;
}

test instruction__printing_then_parsing_returns_the_same_value {
    var t: T;
    if (!t_make(?t, "rv64imafdcv_zba")) { ret 1; }
    val texts: [23]str = [23]str{
        "lw a0, 8(sp)",
        "sw a1, -4(sp)",
        "beq a0, a1, 16",
        "jal ra, 2048",
        "lui a0, 74565",
        "csrrw a0, mstatus, a1",
        "fadd.d ft1, ft2, ft3, rtz",
        "fadd.s ft0, ft1, ft2",
        "amoadd.w.aqrl a0, a1, (a2)",
        "vadd.vv v1, v2, v3, v0.t",
        "vle32.v v4, (a0)",
        "vsetvli a0, a1, e32, m2, ta, ma",
        "vmacc.vv v1, v2, v3",
        "fence r, w",
        "c.addi4spn a0, sp, 16",
        "addi a0, a0, %lo(far)",
        "lui a0, %hi(far+4)",
        "sh1add a0, a1, a2",
        "vmerge.vvm v1, v2, v3, v0",
        "c.lwsp a0, 8(sp)",
        "ld a0, %lo(far)(a1)",
        "csrrsi a0, 0xc00, 5",
        "vluxei32.v v1, (a0), v2, v0.t",
    };
    var held: [16]operand.Value;
    var i:    u32 = 0;
    for (i < 23) {
        val first: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, texts[i], diagnostic.START);
        if (sel first.err) { ret 10 + i::i32; }
        var ins: inst.Inst = first.ok;
        var k:   u32       = 0;
        for (k < ins.row.operands.len) {
            held[k] = ins.values[k];
            k       = k + 1;
        }
        ins.values = ?held[0];
        if (!t_print(?t, ?ins)) { ret 40 + i::i32; }
        val again: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, t.out.data, diagnostic.START);
        if (sel again.err)           { ret 70 + i::i32; }
        if (again.ok.row != ins.row) { ret 100 + i::i32; }
        k = 0;
        for (k < ins.row.operands.len) {
            if (!operand.equal(?again.ok.values[k], ?held[k])) { ret 130 + i::i32; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test instruction__a_marker_reads_prints_and_emits_its_fixup_at_the_instruction_start {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val texts: [2]str               = [2]str{"add a0, a0, tp, %tprel_add(far+4)", "jalr t0, 0(a1), %tlsdesc_call(hi)"};
    val kinds: [2]operand.FixupKind = [2]operand.FixupKind{riscv_fixup.TPREL_ADD, riscv_fixup.TLSDESC_PCREL_CALL};
    # the bytes are the base row's, as llvm-mc writes them
    val words: [2]u32 = [2]u32{0x00450533, 0x000582e7};
    var i:     u32    = 0;
    for (i < 2) {
        if (!t_prints_as(?t, texts[i], texts[i])) { ret 2; }
        val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, texts[i], diagnostic.START);
        if (sel got.err) { ret 3; }
        var ins:    inst.Inst                  = got.ok;
        var bytes:  vector.Vector[u8]          = vector.init[u8](testing.allocator_of(?t.t));
        var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](testing.allocator_of(?t.t));
        val done:   res[usize, field.Refusal]  = walk.encode(?riscv_catalog.CODEC, ?t.ctx, ?ins, ?bytes, ?fixups);
        if (sel done.err) { ret 4; }
        if (done.ok != 4) { ret 4; }
        val word: u32 = bytes.data[0]::u32 | (bytes.data[1]::u32 << 8) | (bytes.data[2]::u32 << 16) | (bytes.data[3]::u32 << 24);
        if (word != words[i]) { ret 5; }
        if (fixups.len != 1)  { ret 6; }
        val fx: field.Fixup = fixups.data[0];
        if (fx.kind != kinds[i] || fx.offset != 0 || fx.field != field.NO_FIELD || fx.symbol != i + 1 || fx.addend != 4 - 4 * i::i64) { ret 7; }
        vector.dnit[u8](?bytes);
        vector.dnit[field.Fixup](?fixups);
        i = i + 1;
    }
    # a marker takes its own specifier, and the register its sequence names
    val refused: [4]str = [4]str{"add a0, a0, tp, far", "add a0, a0, tp, %tlsdesc_call(far)", "add a0, a0, a1, %tprel_add(far)", "jalr ra, 0(a1), %tlsdesc_call(hi)"};
    i = 0;
    for (i < 4) {
        val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, refused[i], diagnostic.START);
        if (!sel got.err) { ret 8; }
        i = i + 1;
    }
    ret 0;
}

# the `nth` number `imm` admits that operand `k` of alias `a` does not exclude, of a short search outward from the bias,
# above it first, into `out` as a relative target or an immediate
#[testing]
fun t_sample_number(imm: operand.Immediate, relative: bool, a: *core_syntax.Alias, k: u8, nth: u32, out: *operand.Value) bool {
    var skip: u32 = nth;
    var n:    i64 = 0;
    for (n < 8192) {
        var i: i64 = (n + 1) / 2;
        if (n % 2 == 0) { i = 0 - i; }
        val v:   i64      = imm.bias + i * (1::i64 << imm.scale::i64);
        val bad: opt[str] = walk.unrepresentable(?imm, v);
        if (sel bad.none && !operand.excludes_value(?imm, v)) {
            var held: operand.Value = operand.Value.immediate{v};
            if (relative) { held = operand.Value.relative{v}; }
            if (!alias.excludes(a, k, ?held)) {
                if (skip == 0) {
                    @out = held;
                    ret true;
                }
                skip = skip - 1;
            }
        }
        n = n + 1;
    }
    ret false;
}

# a value `d` admits that operand `k` of alias `a` does not exclude, the first of a short search, into `out`. a register
# search starts `k` registers into its range, so operands of one class sample apart and no register constraint joins them
#[testing]
fun t_sample(t: *T, d: *operand.Operand, a: *core_syntax.Alias, k: u8, nth: u32, out: *operand.Value) bool {
    val shape: *operand.Shape = ?d.shape;
    if (sel shape.register) {
        val r: *operand.Register = ?shape.register;
        var n: u32               = r.first + k::u32;
        for (n < r.first + 64) {
            if (!operand.excludes_number(r, n)) {
                val id:   register.Id          = register.make(r.classes.at[0], n::u16);
                val held: err[register.Absent] = register.admitted(?t.v, id);
                var v:    operand.Value        = operand.Value.register{id};
                if (!sel held.err && !alias.excludes(a, k, ?v)) {
                    @out = v;
                    ret true;
                }
            }
            n = n + 1;
        }
        ret false;
    }
    if (sel shape.immediate) { ret t_sample_number(shape.immediate, false, a, k, nth, out); }
    if (sel shape.relative)  { ret t_sample_number(shape.relative.offset, true, a, k, nth, out); }
    if (sel shape.enumerant) {
        @out = operand.enumerant(shape.enumerant.members[0].value);
        ret true;
    }
    if (sel shape.id) {
        @out = operand.Value.id{0x300};
        ret true;
    }
    ret false;
}

# the failure of alias `i` of the table, named on the error stream
#[testing]
fun t_failed(i: u32, why: str) i32 {
    stdprint.eprintlnf("alias {} {}: {}", i, riscv_syntax.SYNTAX.aliases.at[i].template, why);
    ret 1 + i::i32;
}

test instruction__a_register_list_and_its_adjustment_read_back_and_mvsa01_keeps_its_registers_apart {
    var t: T;
    if (!t_make(?t, "rv64i_zcmp"))                                                { ret 1; }
    if (!t_prints_as(?t, "cm.push {ra, s0-s2}, -64", "cm.push {ra, s0-s2}, -64")) { ret 2; }
    if (!t_prints_as(?t, "cm.mva01s s0, s1", "cm.mva01s s0, s1"))                 { ret 3; }
    # cm.mvsa01 writes both s registers, which must differ, where cm.mva01s only reads them (src/unpriv/zcmp.adoc)
    if (!t_prints_as(?t, "cm.mva01s s1, s1", "cm.mva01s s1, s1")) { ret 4; }
    val same: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "cm.mvsa01 s1, s1", diagnostic.START);
    if (!sel same.err) { ret 5; }
    ret 0;
}

test instruction__a_mnemonic_refused_for_admission_names_every_alternative {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    val refused: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "andn a0, a1, a2", diagnostic.START);
    if (!sel refused.err) { ret 2; }
    var d:      diagnostic.Diagnostic = refused.err;
    val worded: err[A.Error]          = state.spell_diagnostic(?t.ctx, ?d, ?t.out);
    if (sel worded.err || !extension.t_spelled(?t.out, "instruction not admitted by the selection: needs zbb, or zbkb")) { ret 3; }
    ret 0;
}

test instruction__an_alias_is_admitted_only_when_the_selection_holds_its_extensions {
    var narrow: T;
    var wide:   T;
    if (!t_make(?narrow, "rv64i_zicsr")) { ret 1; }
    if (!t_make(?wide, "rv64if"))        { ret 2; }
    # fscsr is a floating point alias of a csr write, which Zicsr alone admits
    val refused: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?narrow, "fscsr a0", diagnostic.START);
    if (!sel refused.err)                                               { ret 3; }
    if (refused.err.message != field.NOT_ADMITTED)                      { ret 4; }
    if (!t_prints_as(?narrow, "csrrw zero, fcsr, a0", "csrw fcsr, a0")) { ret 5; }
    if (!t_prints_as(?wide, "csrrw zero, fcsr, a0", "fscsr a0"))        { ret 6; }
    val read: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?wide, "fscsr a0", diagnostic.START);
    if (sel read.err)                               { ret 7; }
    if (!str_equals(read.ok.row.mnemonic, "csrrw")) { ret 8; }
    # the refused alias left nothing in the narrow reader
    val plain: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?narrow, "csrw fcsr, a0", diagnostic.START);
    if (sel plain.err) { ret 9; }
    ret 0;
}

test instruction__a_restated_row_is_respelled_on_x_registers_and_an_rv32_double_on_an_even_pair {
    var single: T;
    var pair:   T;
    var narrow: T;
    if (!t_make(?single, "rv64i_zfinx"))                               { ret 1; }
    if (!t_make(?pair, "rv32i_zdinx"))                                 { ret 2; }
    if (!t_make(?narrow, "rv32i_zhinxmin"))                            { ret 3; }
    if (!t_prints_as(?single, "fsgnjx.s a0, a1, a1", "fabs.s a0, a1")) { ret 4; }
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?single, "fneg.s a0, a1", diagnostic.START);
    if (sel got.err)                                               { ret 5; }
    if (!str_equals(got.ok.row.key, "fsgnjn.s.zfinx"))             { ret 6; }
    if (!t_prints_as(?pair, "fsgnj.d a0, a2, a2", "fmv.d a0, a2")) { ret 7; }
    val odd: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?pair, "fmv.d a0, a1", diagnostic.START);
    if (!sel odd.err) { ret 8; }
    # zhinxmin holds no fsgnj.h, so it has no respelling of it
    val none: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?narrow, "fabs.h a0, a1", diagnostic.START);
    if (!sel none.err) { ret 9; }
    ret 0;
}

test alias__a_walk_over_the_alias_table_parses_and_prints_each {
    var i: u32 = 0;
    for (i < riscv_syntax.SYNTAX.aliases.len) {
        val a: *core_syntax.Alias = ?riscv_syntax.SYNTAX.aliases.at[i];
        val r: *row.Row           = ?riscv_catalog.CODEC.rows.at[a.row];
        var t: T;
        if (!t_make_for(?t, r, a.requires)) { ret t_failed(i, "selection"); }
        var sample: [16]operand.Value;
        var base:   [16]operand.Value;
        var k:      u8   = 0;
        var nth:    u32  = 0;
        var formed: bool = false;
        # a derivation may take only some of its operands' values, as vmsltu.vi's 0 alone, so later samples are tried
        for (!formed && nth < 4) {
            k = 0;
            for (k < a.count) {
                val d: *operand.Operand = core_syntax.alias_operand(a, r, k);
                if (d == nil || !t_sample(?t, d, a, k, nth, ?sample[k])) { ret t_failed(i, "no sample value"); }
                k = k + 1;
            }
            formed = alias.resolve(?riscv_catalog.CODEC, a, ?sample[0], ?base[0]);
            nth    = nth + 1;
        }
        if (!formed) { ret t_failed(i, "no base form"); }
        var ins:      inst.Inst          = inst.Inst{row: r, values: ?base[0], count: r.operands.len};
        val admitted: err[field.Refusal] = walk.admits(?riscv_catalog.CODEC, ?t.ctx, ?ins);
        if (sel admitted.err) { ret t_failed(i, admitted.err.message); }
        t.out.len = 0;
        var w: core_syntax.Writer = core_syntax.Writer{out: ?t.out, codec: ?riscv_catalog.CODEC, ctx: ?t.ctx, syntax: ?riscv_syntax.SYNTAX, modes: ?t.modes, symbols: ?T_SYMBOLS, context: nil, row: nil, dot: false, values: nil};
        # an alias only read whose values are derived has no inverse, so it is written by its own values
        var printed: err[field.Refusal] = err[field.Refusal].ok{};
        if (a.derive != nil && a.preference == 0) { printed = print.respelled(?w, a, ?ins, ?sample[0]); }
        or                                        { printed = print.as_alias(?w, a, ?ins); }
        if (sel printed.err)                      { ret t_failed(i, "does not print"); }
        vector.push[u8](?t.out, 0);
        val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, t.out.data, diagnostic.START);
        if (sel got.err) {
            stdprint.eprintlnf("  text {}: {}", t.out.data, got.err.message);
            ret t_failed(i, "does not parse");
        }
        if (got.ok.row != r) { ret t_failed(i, "reads another row"); }
        k = 0;
        for (k::u32 < r.operands.len) {
            if (!operand.equal(?got.ok.values[k], ?base[k])) { ret t_failed(i, "reads another value"); }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}

# the got load `la a0, far` reads to under pic at `isa` in `syntax`, nil when it is refused
#[testing]
fun t_got_load(isa: str, syntax: *core_syntax.Syntax) *row.Row {
    var t: T;
    if (!t_make(?t, isa)) { ret nil; }
    t.syntax = syntax;
    if (!mode.change(?t.modes, mode.Setting{mode: ?riscv_mode.POSITION, value: ?riscv_mode.PIC})) { ret nil; }
    var rd:  core_syntax.Reader         = t_reader(?t, "la a0, far", diagnostic.START);
    var ex:  relax.Expansion;
    val got: err[diagnostic.Diagnostic] = statement(?rd, ?ex);
    if (sel got.err || ex.count != 2) { ret nil; }
    ret ex.steps[1].row;
}

test statement__la_under_pic_loads_by_the_width_whatever_the_order_of_its_spellings {
    # the two got loads swapped, every other spelling where it was
    var swapped: [7]core_syntax.Sequence = [7]core_syntax.Sequence{
        riscv_syntax.SEQUENCES[0], riscv_syntax.SEQUENCES[1], riscv_syntax.SEQUENCES[2], riscv_syntax.SEQUENCES[3],
        riscv_syntax.SEQUENCES[4], riscv_syntax.SEQUENCES[6], riscv_syntax.SEQUENCES[5],
    };
    var named: [7]u32             = [7]u32{0, 1, 4, 5, 6, 3, 2};
    var other: core_syntax.Syntax = riscv_syntax.SYNTAX;
    other.sequences = core_syntax.Sequences{at: ?swapped[0], len: 7, named: ?named[0]};
    if (t_got_load("rv64i", ?riscv_syntax.SYNTAX) != ?gen_row.ROWS[gen_row_index.LD]) { ret 1; }
    if (t_got_load("rv64i", ?other) != ?gen_row.ROWS[gen_row_index.LD])               { ret 2; }
    if (t_got_load("rv32i", ?riscv_syntax.SYNTAX) != ?gen_row.ROWS[gen_row_index.LW]) { ret 3; }
    if (t_got_load("rv32i", ?other) != ?gen_row.ROWS[gen_row_index.LW])               { ret 4; }
    ret 0;
}

