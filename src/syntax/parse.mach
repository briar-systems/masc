# the instruction parser: instruction text read into an encoded instruction value
#
# the parser tries each row's template and then each alias of that row, in
# row order, the order of the encoder's preference, and takes the first whose
# text matches and whose values the row admits under the selection. an alias
# resolves to its base row's value. when no candidate takes the text, the
# refusal is the one of the candidate that read it whole, or else of the one
# that read furthest, at its column.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use masc.core.diagnostic;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.inst;
use masc.core.operand;
use masc.core.register;
use masc.core.row;
use masc.core.spelling;
use masc.core.walk;
use masc.syntax.alias;
use masc.syntax.read;

# the refusal kept while candidates are tried
# ---
# held:     whether one is kept
# complete: whether its candidate read the whole text, so it outranks any that did not
# refusal:  the refusal
rec Best {
    held:     bool;
    complete: bool;
    refusal:  diagnostic.Diagnostic;
}

fun keep(best: *Best, d: diagnostic.Diagnostic, complete: bool) {
    if (best.held) {
        if (best.complete && !complete)                                                         { ret; }
        if (best.complete == complete && d.span.start.offset <= best.refusal.span.start.offset) { ret; }
    }
    best.held     = true;
    best.complete = complete;
    best.refusal  = d;
}

# one value of `desc` read at the position
fun one(r: *spelling.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val shape: *operand.Shape = ?desc.shape;
    if (sel shape.register) {
        val reg: res[register.Id, diagnostic.Diagnostic] = read.register_value(r);
        if (sel reg.err) { ret err[diagnostic.Diagnostic].err{reg.err}; }
        @out = operand.Value.register{reg.ok};
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (sel shape.enumerant) {
        val e: res[u32, diagnostic.Diagnostic] = read.enumeration(r, ?shape.enumerant);
        if (sel e.err) { ret err[diagnostic.Diagnostic].err{e.err}; }
        @out = operand.Value.enumerant{e.ok};
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (sel shape.condition) {
        val c: res[u32, diagnostic.Diagnostic] = read.enumeration(r, ?shape.condition);
        if (sel c.err) { ret err[diagnostic.Diagnostic].err{c.err}; }
        @out = operand.Value.condition{c.ok};
        ret err[diagnostic.Diagnostic].ok{};
    }
    val h: *spelling.Hook = spelling.hook(r.syntax, shape);
    if (h == nil) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))}; }
    ret h.parse(r, desc, format, out);
}

# operand `desc`'s value read by its hole, a variadic operand as members joined by the syntax's text
fun hole(r: *spelling.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (desc.quantity != operand.VARIADIC) { ret one(r, desc, format, out); }
    var first: *operand.Value = nil;
    var count: u32            = 0;
    for {
        val back: usize = r.at;
        if (count > 0) {
            if (!read.take(r, r.syntax.variadic)) { brk; }
            read.skip(r);
        }
        var member: operand.Value;
        val got:    err[diagnostic.Diagnostic] = one(r, desc, format, ?member);
        if (sel got.err) {
            r.at = back;
            brk;
        }
        val slot: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, member);
        if (sel slot.err) { ret err[diagnostic.Diagnostic].err{slot.err}; }
        if (count == 0)   { first = slot.ok; }
        count = count + 1;
    }
    @out = operand.Value.list{operand.Values{at: first, len: count}};
    ret err[diagnostic.Diagnostic].ok{};
}

# whether the piece after the one at `at` ends a word, so the text must too
fun ends_word(template: str, at: usize) bool {
    val next: spelling.Piece = spelling.piece(template, at);
    ret next.kind == spelling.SPACE || next.kind == spelling.END || next.kind == spelling.OPEN || next.kind == spelling.CLOSE;
}

# whether the text starts with the template's mnemonic, the text before its first space, hole or group
fun keyed(r: *spelling.Reader, template: str, from: usize) bool {
    var at: usize = 0;
    var i:  usize = from;
    for {
        val p: spelling.Piece = spelling.piece(template, at);
        if (p.kind != spelling.TEXT)                                { ret true; }
        if (i >= r.end || !read.same(r, r.text[i], template[p.at])) { ret false; }
        i  = i + 1;
        at = p.at + p.len;
        if (read.word(template[p.at]) && ends_word(template, at) && i < r.end && read.word(r.text[i])) { ret false; }
    }
}

# `template` read over the whole text, hole n into `values[n]` by `descs[n]` at `spans[n]`
# ---
# ret: ok, or the refusal at the column the text stops matching
fun match(r: *spelling.Reader, template: str, descs: **operand.Operand, values: *operand.Value, spans: *usize, best: *Best) err[diagnostic.Diagnostic] {
    var at:    usize = 0;
    var after: bool  = false;
    var group: usize = 0;
    var back:  usize = 0;
    var used:  u32   = 0;
    var open:  bool  = false;
    read.skip(r);
    for {
        val p: spelling.Piece = spelling.piece(template, at);
        at = p.at + p.len;
        var failed: opt[diagnostic.Diagnostic] = opt[diagnostic.Diagnostic].none{};
        if (p.kind == spelling.END) {
            read.skip(r);
            if (r.at == r.end) { ret err[diagnostic.Diagnostic].ok{}; }
            failed = opt[diagnostic.Diagnostic].some{read.refuse(r, read.UNEXPECTED, r.at, read.token(r, r.at))};
        }
        or (p.kind == spelling.SPACE) {
            read.skip(r);
            after = false;
        }
        or (p.kind == spelling.OPEN) {
            open  = true;
            group = at;
            back  = r.at;
            used  = r.used;
        }
        or (p.kind == spelling.CLOSE) {
            open = false;
        }
        or (p.kind == spelling.TEXT) {
            if (after) { read.skip(r); }
            after = false;
            val c: u8 = template[p.at];
            if (read.peek(r) == 0 || !read.same(r, read.peek(r), c)) {
                failed = opt[diagnostic.Diagnostic].some{read.refuse(r, read.UNEXPECTED, r.at, read.token(r, r.at))};
            }
            or {
                r.at = r.at + 1;
                if (read.word(c) && ends_word(template, at) && read.word(read.peek(r))) {
                    failed = opt[diagnostic.Diagnostic].some{read.refuse(r, read.UNEXPECTED, r.at, read.token(r, r.at))};
                }
            }
        }
        or (p.kind == spelling.HOLE) {
            spans[p.operand] = r.at;
            val got: err[diagnostic.Diagnostic] = hole(r, descs[p.operand], p.format, ?values[p.operand]);
            if (sel got.err) { failed = opt[diagnostic.Diagnostic].some{got.err}; }
            after = true;
        }
        if (sel failed.some) {
            if (!open) { ret err[diagnostic.Diagnostic].err{failed.some}; }
            # an optional group that does not match is absent, its operands none
            keep(best, failed.some, false);
            r.at   = back;
            r.used = used;
            var q: spelling.Piece = spelling.piece(template, group);
            for (q.kind != spelling.CLOSE && q.kind != spelling.END) {
                if (q.kind == spelling.HOLE) { values[q.operand] = operand.Value.none{}; }
                q = spelling.piece(template, q.at + q.len);
            }
            at   = q.at + q.len;
            open = false;
        }
    }
}

# whether operand `op` has a hole in `template`
fun written(template: str, op: u8) bool {
    var p: spelling.Piece = spelling.piece(template, 0);
    for (p.kind != spelling.END) {
        if (p.kind == spelling.HOLE && p.operand == op) { ret true; }
        p = spelling.piece(template, p.at + p.len);
    }
    ret false;
}

# the candidate `r`'s base row and values admitted, into the reader's pool
# ---
# spans: the offset each base operand was read at, the instruction's start for one the text does not hold
fun admit(rd: *spelling.Reader, r: *row.Row, values: *operand.Value, spans: *usize, best: *Best) opt[inst.Inst] {
    if (!extension.admits(rd.available.selection, r.requires)) {
        keep(best, read.refuse(rd, field.NOT_ADMITTED, rd.start, read.token(rd, rd.start)), true);
        ret opt[inst.Inst].none{};
    }
    var ins:      inst.Inst          = inst.Inst{row: r, values: values, count: r.operands.len};
    val admitted: err[field.Refusal] = walk.admits(rd.codec, rd.available, ?ins);
    if (sel admitted.err) {
        var at: usize = rd.start;
        if (admitted.err.operand::u32 < r.operands.len) { at = spans[admitted.err.operand]; }
        keep(best, read.refuse(rd, admitted.err.message, at, read.token(rd, at)), true);
        ret opt[inst.Inst].none{};
    }
    var i: u32 = 0;
    for (i < r.operands.len) {
        rd.pool[i] = values[i];
        i          = i + 1;
    }
    ret opt[inst.Inst].some{inst.Inst{row: r, values: rd.pool, count: r.operands.len}};
}

# the row `index` read by its own template
fun by_row(rd: *spelling.Reader, index: u32, best: *Best) opt[inst.Inst] {
    val r:        *row.Row = ?rd.codec.rows.at[index];
    val template: str      = rd.syntax.forms.at[index];
    var descs:    [row.MAX_OPERANDS]*operand.Operand;
    var values:   [row.MAX_OPERANDS]operand.Value;
    var spans:    [row.MAX_OPERANDS]usize;
    var i:        u32      = 0;
    for (i < r.operands.len) {
        descs[i] = ?r.operands.at[i];
        spans[i] = rd.start;
        i        = i + 1;
    }
    rd.at   = rd.start;
    rd.used = r.operands.len;
    val matched: err[diagnostic.Diagnostic] = match(rd, template, ?descs[0], ?values[0], ?spans[0], best);
    if (sel matched.err) {
        keep(best, matched.err, false);
        ret opt[inst.Inst].none{};
    }
    # an operand the template does not write is the register the row fixes it to
    i = 0;
    for (i < r.operands.len) {
        if (!written(template, i::u8)) {
            val at: opt[u32] = effect.fixed(r.effect, i::u8);
            if (sel at.some) { values[i] = operand.Value.register{register.id_of(?rd.codec.registers.registers[at.some])}; }
        }
        i = i + 1;
    }
    ret admit(rd, r, ?values[0], ?spans[0], best);
}

# the alias `a` read and resolved to its base row
fun by_alias(rd: *spelling.Reader, a: *spelling.Alias, best: *Best) opt[inst.Inst] {
    val r:      *row.Row = ?rd.codec.rows.at[a.row];
    var descs:  [row.MAX_OPERANDS]*operand.Operand;
    var values: [row.MAX_OPERANDS]operand.Value;
    var spans:  [row.MAX_OPERANDS]usize;
    var k:      u8       = 0;
    for (k < a.count) {
        descs[k] = spelling.alias_operand(a, r, k);
        spans[k] = rd.start;
        k        = k + 1;
    }
    rd.at   = rd.start;
    rd.used = r.operands.len;
    val matched: err[diagnostic.Diagnostic] = match(rd, a.template, ?descs[0], ?values[0], ?spans[0], best);
    if (sel matched.err) {
        keep(best, matched.err, false);
        ret opt[inst.Inst].none{};
    }
    var base:  [row.MAX_OPERANDS]operand.Value;
    var where: [row.MAX_OPERANDS]usize;
    if (!alias.resolve(rd.codec, a, ?values[0], ?base[0])) {
        keep(best, read.refuse(rd, read.UNEXPECTED, rd.start, read.token(rd, rd.start)), true);
        ret opt[inst.Inst].none{};
    }
    var j: u32 = 0;
    for (j < r.operands.len) {
        val src: spelling.Source = a.sources.at[j];
        where[j] = rd.start;
        if (sel src.operand) { where[j] = spans[src.operand]; }
        if (sel src.flipped) { where[j] = spans[src.flipped.operand]; }
        j = j + 1;
    }
    ret admit(rd, r, ?base[0], ?where[0], best);
}

# the instruction at the reader's text, read in its syntax
# ---
# rd:  the reader over the instruction's text, its pool holding the values first and then list members
# ret: the instruction, its values in the pool, or the refusal at its column
pub fun instruction(rd: *spelling.Reader) res[inst.Inst, diagnostic.Diagnostic] {
    var best:      Best = Best{held: false, complete: false, refusal: diagnostic.Diagnostic{message: read.UNKNOWN_MNEMONIC, span: diagnostic.Span{start: rd.origin, len: 0}}};
    var keyed_any: bool = false;
    rd.at = rd.start;
    read.skip(rd);
    val head: usize = rd.at;
    var next: u32   = 0;
    var i:    u32   = 0;
    for (i < rd.codec.rows.len) {
        val r: *row.Row = ?rd.codec.rows.at[i];
        if (rd.cap < r.operands.len) { ret res[inst.Inst, diagnostic.Diagnostic].err{read.refuse(rd, field.STORAGE, head, 0)}; }
        if ((r.flags & row.DECODE_ONLY) == 0 && keyed(rd, rd.syntax.forms.at[i], head)) {
            keyed_any = true;
            val got: opt[inst.Inst] = by_row(rd, i, ?best);
            if (sel got.some) { ret res[inst.Inst, diagnostic.Diagnostic].ok{got.some}; }
        }
        for (next < rd.syntax.aliases.len && rd.syntax.aliases.at[next].row == i) {
            val a: *spelling.Alias = ?rd.syntax.aliases.at[next];
            if (keyed(rd, a.template, head)) {
                keyed_any = true;
                val got: opt[inst.Inst] = by_alias(rd, a, ?best);
                if (sel got.some) { ret res[inst.Inst, diagnostic.Diagnostic].ok{got.some}; }
            }
            next = next + 1;
        }
        i = i + 1;
    }
    if (!keyed_any) { ret res[inst.Inst, diagnostic.Diagnostic].err{read.refuse(rd, read.UNKNOWN_MNEMONIC, head, read.token(rd, head))}; }
    ret res[inst.Inst, diagnostic.Diagnostic].err{best.refusal};
}
