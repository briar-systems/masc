    row.Row{key: "mode", mnemonic: "OpExecutionMode", operands: row.Operands{at: ?T_MODE_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?T_WORD_FIELDS[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?T_PLAIN, ct: ?ct.INDEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0, index: 0},
    row.Row{key: "sample", mnemonic: "OpSample", operands: row.Operands{at: ?T_IMAGE_OPERANDS[0], len: 1}, encoding: field.Fields{at: ?T_WORD_FIELDS[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?T_PLAIN, ct: ?ct.INDEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0, index: 1},
    row.Row{key: "iadd", mnemonic: "OpIAdd", operands: row.Operands{at: ?T_THREE_IDS[0], len: 3}, encoding: field.Fields{at: ?T_WORD_FIELDS[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?T_DEFINES, ct: ?ct.INDEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0, index: 2},
    row.Row{key: "store", mnemonic: "OpStore", operands: row.Operands{at: ?T_TWO_IDS[0], len: 2}, encoding: field.Fields{at: ?T_WORD_FIELDS[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?T_PLAIN, ct: ?ct.INDEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0, index: 3},
    row.Row{key: "sum", mnemonic: "OpSum", operands: row.Operands{at: ?T_SUM_OPERANDS[0], len: 2}, encoding: field.Fields{at: ?T_WORD_FIELDS[0], len: 1}, requires: requirement.NO_ALTERNATIVES, effect: ?T_PLAIN, ct: ?ct.INDEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0, index: 4},
};

# every operand of the instruction one word, an enumerant's params after it in order
#[testing]
fun t_words_encode(enc: *field.Encoder, f: *field.Field) err[field.Refusal] {
    var k: u32 = 0;
    for (k < enc.count) {
        val v: operand.Value = enc.values[k];
        if (sel v.enumerant) {
            val c:    operand.Chosen     = v.enumerant;
            val word: err[field.Refusal] = field.put(enc, c.value::u64, 4);
            if (sel word.err) { ret word; }
            var i: u32 = 0;
            for (i < c.params.len) {
                val p: operand.Value = c.params.at[i];
                if (!sel p.immediate) { ret err[field.Refusal].err{field.refusal(field.WRONG_KIND, k::u8, 0)}; }
                val param: err[field.Refusal] = field.put(enc, p.immediate:~u64, 4);
                if (sel param.err) { ret param; }
                i = i + 1;
            }
        }
        or (sel v.id) {
            val word: err[field.Refusal] = field.put(enc, v.id::u64, 4);
            if (sel word.err) { ret word; }
        }
        k = k + 1;
    }
    ret err[field.Refusal].ok{};
}

# each operand read back as `t_words_encode` wrote it, an enumerant with the params its value takes
#[testing]
fun t_words_decode(dec: *field.Decoder, f: *field.Field) err[field.Refusal] {
    var k: u32 = 0;
    for (k < dec.count) {
        val desc: *operand.Operand        = ?dec.operands[k];
        val word: res[u64, field.Refusal] = field.get(dec, 4);
        if (sel word.err) { ret err[field.Refusal].err{word.err}; }
        if (sel desc.shape.enumerant) {
            val value: u32            = word.ok::u32;
            val count: u32            = operand.param_count(?desc.shape.enumerant, value);
            var first: *operand.Value = nil;
            var i:     u32            = 0;
            for (i < count) {
                val param: res[u64, field.Refusal] = field.get(dec, 4);
                if (sel param.err) { ret err[field.Refusal].err{param.err}; }
                val slot: res[*operand.Value, field.Refusal] = field.push(dec, operand.Value.immediate{param.ok::i64});
                if (sel slot.err) { ret err[field.Refusal].err{slot.err}; }
                if (i == 0)       { first = slot.ok; }
                i = i + 1;
            }
            field.place(dec, k::u8, operand.Value.enumerant{operand.Chosen{value: value, params: operand.Values{at: first, len: count}}});
        }
        or { field.place(dec, k::u8, operand.Value.id{word.ok::u32}); }
        k = k + 1;
    }
    ret err[field.Refusal].ok{};
}

#[testing]
val T_WORDS: field.Kind = field.Kind{name: "words", admit: nil, encode: t_words_encode, decode: t_words_decode, finish: nil, complete: nil};

#[testing]
val T_WORD_KINDS: [1]*field.Kind = [1]*field.Kind{?T_WORDS};

#[testing]
val T_WORD_TABLE: field.Table = field.Table{kinds: ?T_WORD_KINDS[0], count: 1, order: field.LITTLE};

#[testing]
val T_WORD_CODEC: dispatch.Codec = dispatch.Codec{fields: ?T_WORD_TABLE, registers: nil, rows: row.Rows{at: ?T_WORD_ROWS[0], len: 5}, keys: index.NO_ENTRIES, dispatch: nil};

#[testing]
val T_WORD_FORMS: [5]str = [5]str{"OpExecutionMode <0>", "OpSample <0>", "OpIAdd <1> <2>", "OpStore <0> <1>", "OpSum <0> <1>"};

#[testing]
val T_WORD_ENTRIES: [5]core_syntax.Entry = [5]core_syntax.Entry{
    core_syntax.Entry{key: "OpExecutionMode", first: 0, len: 1},
    core_syntax.Entry{key: "OpIAdd", first: 1, len: 1},
    core_syntax.Entry{key: "OpSample", first: 2, len: 1},
    core_syntax.Entry{key: "OpStore", first: 3, len: 1},
    core_syntax.Entry{key: "OpSum", first: 4, len: 1},
};

#[testing]
val T_WORD_CANDIDATES: [5]core_syntax.Candidate = [5]core_syntax.Candidate{
    core_syntax.Candidate{row: 0, alias: 0},
    core_syntax.Candidate{row: 2, alias: 0},
    core_syntax.Candidate{row: 1, alias: 0},
    core_syntax.Candidate{row: 3, alias: 0},
    core_syntax.Candidate{row: 4, alias: 0},
};

# a number or an id `%n` read at the reader's position
#[testing]
fun t_word_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val id: bool = sel desc.shape.id;
    if (id && !read.take(r, "%")) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))}; }
    val n: res[i64, diagnostic.Diagnostic] = read.number(r);
    if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
    if (id)        { @out = operand.Value.id{n.ok::u32}; }
    or (desc == ?T_SUM_OPERANDS[1]) {
        if (r.values == nil) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, 0)}; }
        val of: operand.Value = r.values[0];
        if (!sel of.id) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, 0)}; }
        @out = operand.Value.immediate{n.ok + of.id::i64};
    }
    or { @out = operand.Value.immediate{n.ok}; }
    ret err[diagnostic.Diagnostic].ok{};
}

#[testing]
fun t_word_print(w: *core_syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (sel value.immediate) {
        if (desc != ?T_SUM_OPERANDS[1]) { ret write.decimal(w, value.immediate); }
        if (w.values == nil)            { ret write.refuse(w, write.NO_SPELLING, 1); }
        val of: operand.Value = w.values[0];
        if (!sel of.id) { ret write.refuse(w, write.NO_SPELLING, 1); }
        ret write.decimal(w, value.immediate - of.id::i64);
    }
    if (!sel value.id) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    val sigil: err[field.Refusal] = write.text(w, "%");
    if (sel sigil.err) { ret sigil; }
    ret write.decimal(w, value.id::i64);
}

#[testing]
val T_WORD_HOOK: core_syntax.Hook = core_syntax.Hook{parse: t_word_parse, print: t_word_print};

# the `%r =` a statement may start with, its id bound
#[testing]
fun t_bind(r: *core_syntax.Reader) err[diagnostic.Diagnostic] {
    if (read.peek(r) != '%') { ret err[diagnostic.Diagnostic].ok{}; }
    var id:  operand.Value;
    val got: err[diagnostic.Diagnostic] = t_word_parse(r, ?T_ID, View{data: nil, len: 0}, ?id);
    if (sel got.err) { ret got; }
    read.skip(r);
    if (!read.take(r, "=")) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))}; }
    read.skip(r);
    r.bound = id;
    ret err[diagnostic.Diagnostic].ok{};
}

# the `%r = ` of the result `ins` defines, nothing for one that defines none
#[testing]
fun t_lead(w: *core_syntax.Writer, ins: *inst.Inst) err[field.Refusal] {
    val defines: u8 = ins.row.effect.values.defines;
    if (defines == 0) { ret err[field.Refusal].ok{}; }
    val id: err[field.Refusal] = t_word_print(w, ?T_ID, View{data: nil, len: 0}, ?ins.values[defines - 1]);
    if (sel id.err) { ret id; }
    ret write.text(w, " = ");
}

#[testing]
val T_WORD_SYNTAX: core_syntax.Syntax = core_syntax.Syntax{
    name:      "words",
    forms:     core_syntax.Forms{at: ?T_WORD_FORMS[0], len: 5},
    index:     core_syntax.Index{at: ?T_WORD_ENTRIES[0], len: 5, candidates: ?T_WORD_CANDIDATES[0], count: 5},
    hooks:     core_syntax.Hooks{immediate: ?T_WORD_HOOK, memory: nil, list: nil, id: ?T_WORD_HOOK, literal: nil, register: nil},
    register:  "",
    join:      "|",
    variadic:  " ",
    anonymous: ".Lw",
    statement: t_bind,
    lead:      t_lead,
};

# the test made over the word set
#[testing]
fun t_words(t: *T) bool {
    if (!t_make(t, "rv64i")) { ret false; }
    t.codec  = ?T_WORD_CODEC;
    t.syntax = ?T_WORD_SYNTAX;
    ret true;
}

# `text` read as a statement of the word set, its one instruction into `out`
#[testing]
fun t_word_statement(t: *T, text: str, ex: *relax.Expansion) err[diagnostic.Diagnostic] {
    var rd: core_syntax.Reader = t_reader(t, text, diagnostic.START);
    ret statement(?rd, ex);
}

# whether `text` reads, encodes to `words`, decodes back to the same values and prints as `want`
#[testing]
fun t_word_trip(t: *T, text: str, words: *u32, count: u32, want: str) bool {
    var ex:    relax.Expansion;
    val read_: err[diagnostic.Diagnostic] = t_word_statement(t, text, ?ex);
    if (sel read_.err || ex.count != 1) { ret false; }
    var ins:    inst.Inst                  = inst.Inst{row: ex.steps[0].row, values: ?ex.steps[0].values[0], count: ex.steps[0].row.operands.len, form: ex.steps[0].form};
    var bytes:  vector.Vector[u8]          = vector.init[u8](testing.allocator_of(?t.t));
    var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](testing.allocator_of(?t.t));
    val coded:  res[usize, field.Refusal]  = walk.encode(t.codec, ?t.ctx, ?ins, ?bytes, ?fixups);
    if (sel coded.err)                  { ret false; }
    if (coded.ok != (count * 4)::usize) { ret false; }
    var k: u32 = 0;
    for (k < count) {
        val got: u32 = bytes.data[k * 4]::u32 | (bytes.data[k * 4 + 1]::u32 << 8) | (bytes.data[k * 4 + 2]::u32 << 16) | (bytes.data[k * 4 + 3]::u32 << 24);
        if (got != words[k]) { ret false; }
        k = k + 1;
    }
    var store: [8]operand.Value;
    val back:  res[walk.Decoded, field.Refusal] = walk.decode_row(t.codec, ?t.ctx, ins.row, bytes.data, bytes.len, 0, ?store[0], 8);
    if (sel back.err)             { ret false; }
    if (back.ok.len != bytes.len) { ret false; }
    var decoded: inst.Inst = back.ok.inst;
    k = 0;
    for (k < ins.count) {
        if (!operand.equal(?ins.values[k], ?decoded.values[k])) { ret false; }
        k = k + 1;
    }
    vector.dnit[u8](?bytes);
    vector.dnit[field.Fixup](?fixups);
    if (!t_print(t, ?decoded)) { ret false; }
    ret str_equals(t.out.data, want);
}

# an enumerant's params follow it through the reader, the encoder, the decoder and the printer, a mask's in the order of
# its bits whatever the order its members are written in: LocalSize is 17 and its three words, Bias|Lod is 3 then
# Bias's word, bit 0, and Lod's, bit 1
test statement__an_enumerant_reads_encodes_decodes_and_prints_with_its_params {
    var t: T;
    if (!t_words(?t)) { ret 1; }
    val local: [4]u32 = [4]u32{17, 8, 4, 1};
    if (!t_word_trip(?t, "OpExecutionMode LocalSize 8 4 1", ?local[0], 4, "OpExecutionMode LocalSize 8 4 1")) { ret 2; }
    val flat: [1]u32 = [1]u32{14};
    if (!t_word_trip(?t, "OpExecutionMode Flat", ?flat[0], 1, "OpExecutionMode Flat")) { ret 3; }
    val sampled: [3]u32 = [3]u32{3, 5, 6};
    if (!t_word_trip(?t, "OpSample Bias|Lod 5 6", ?sampled[0], 3, "OpSample Bias|Lod 5 6")) { ret 4; }
    if (!t_word_trip(?t, "OpSample Lod|Bias 5 6", ?sampled[0], 3, "OpSample Bias|Lod 5 6")) { ret 5; }
    val plain: [2]u32 = [2]u32{6, 7};
    if (!t_word_trip(?t, "OpSample Lod|Plain 7", ?plain[0], 2, "OpSample Lod|Plain 7")) { ret 6; }
    # a member short of its params is refused as it reads, and encoding refuses params its value does not take
    var ex:    relax.Expansion;
    val short: err[diagnostic.Diagnostic] = t_word_statement(?t, "OpExecutionMode LocalSize 8 4", ?ex);
    if (!sel short.err)                     { ret 7; }
    if (short.err.message != read.EXPECTED) { ret 8; }
    var none:     [1]operand.Value   = [1]operand.Value{operand.enumerant(17)};
    var bare:     inst.Inst          = inst.Inst{row: ?T_WORD_ROWS[0], values: ?none[0], count: 1};
    val unfilled: err[field.Refusal] = walk.admits(t.codec, ?t.ctx, ?bare);
    if (!sel unfilled.err)                    { ret 9; }
    if (unfilled.err.message != field.PARAMS) { ret 10; }
    ret 0;
}

# a statement binds the result its row defines by `%r =`, which prints back before it, and a row whose result nothing
# binds, or a binding no row takes, is refused
test statement__a_bound_result_reads_into_the_defined_operand_and_prints_before_the_instruction {
    var t: T;
    if (!t_words(?t)) { ret 1; }
    var ex:  relax.Expansion;
    val got: err[diagnostic.Diagnostic] = t_word_statement(?t, "%3 = OpIAdd %1 %2", ?ex);
    if (sel got.err || ex.count != 1 || ex.steps[0].row != ?T_WORD_ROWS[2]) { ret 2; }
    val result: operand.Value = ex.steps[0].values[0];
    if (!sel result.id) { ret 3; }
    if (result.id != 3) { ret 4; }
    var ins: inst.Inst = inst.Inst{row: ex.steps[0].row, values: ?ex.steps[0].values[0], count: 3, form: ex.steps[0].form};
    if (!t_print(?t, ?ins) || !str_equals(t.out.data, "%3 = OpIAdd %1 %2")) { ret 5; }
    val unbound: err[diagnostic.Diagnostic] = t_word_statement(?t, "OpIAdd %1 %2", ?ex);
    if (!sel unbound.err)               { ret 6; }
    if (unbound.err.message != UNBOUND) { ret 7; }
    val untaken: err[diagnostic.Diagnostic] = t_word_statement(?t, "%4 = OpStore %1 %2", ?ex);
    if (!sel untaken.err)                                                     { ret 8; }
    if (untaken.err.message != UNTAKEN || untaken.err.span.start.column != 6) { ret 9; }
    ret 0;
}

# a group of two bytes, the members of the test's `pair` row
#[testing]
val T_PAIR_MEMBERS: [2]operand.Operand = [2]operand.Operand{
    operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 8, sign: operand.UNSIGNED, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 8, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 8, sign: operand.UNSIGNED, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.NO_INTEGERS}}, role: operand.READ, width: 8, quantity: operand.ONE},
};

#[testing]
val T_PAIR_OPERANDS: [1]operand.Operand = [1]operand.Operand{
    operand.Operand{shape: operand.Shape.group{operand.Group{at: ?T_PAIR_MEMBERS[0], len: 2}}, role: operand.READ, width: 0, quantity: operand.ONE},
};

# the effect of a row that touches nothing beyond its operands
#[testing]
val T_PAIR_EFFECT: effect.Effect = effect.Effect{
    implicit: effect.Registers.ruled{effect.Ruled{otherwise: effect.NO_TOUCHED, rules: effect.NO_REGISTER_RULES, may: effect.NO_TOUCHED, must: effect.NO_TOUCHED}},
    flags:    effect.Flags{read: effect.NO_WORDS, written: effect.NO_WORDS, undefined: effect.NO_WORDS, kept: effect.NO_WORDS},
    memory:   effect.NO_ACCESSES,
    control:  effect.Control{transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, operand: field.NO_OPERAND, rules: effect.NO_RULES},
    stack:    effect.Stack.none{},
    latency:  effect.ONE,
    fixed:    effect.NO_FIXEDS,
};

# a row of one group operand and no fields, read and written by its template alone
#[testing]
val T_PAIR: row.Row = row.Row{key: "pair", mnemonic: "pair", operands: row.Operands{at: ?T_PAIR_OPERANDS[0], len: 1}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.NO_ALTERNATIVES, effect: ?T_PAIR_EFFECT, ct: ?ct.INDEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0};

#[testing]
val T_PAIR_FORMATS: [1]source.Format = [1]source.Format{source.Format{template: "pair <0>", row: ?T_PAIR, length: 0}};

# a group spelled whole as `(<a> <b>)`
#[testing]
fun t_group_parse(r: *core_syntax.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (!read.take(r, "(")) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, 1)}; }
    var held: [2]operand.Value;
    var i:    u32 = 0;
    for (i < 2) {
        read.skip(r);
        val n: res[i64, diagnostic.Diagnostic] = read.number(r);
        if (sel n.err) { ret err[diagnostic.Diagnostic].err{n.err}; }
        held[i] = operand.Value.immediate{n.ok};
        i       = i + 1;
    }
    if (!read.take(r, ")")) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, 1)}; }
    val first: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, held[0]);
    if (sel first.err) { ret err[diagnostic.Diagnostic].err{first.err}; }
    val second: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, held[1]);
    if (sel second.err) { ret err[diagnostic.Diagnostic].err{second.err}; }
    @out = operand.Value.group{operand.Values{at: first.ok, len: 2}};
    ret err[diagnostic.Diagnostic].ok{};
}

#[testing]
fun t_group_print(w: *core_syntax.Writer, desc: *operand.Operand, format: View, value: *operand.Value) err[field.Refusal] {
    if (!sel value.group) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    val pair: operand.Values = value.group;
    if (pair.len != 2) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
    var text: [12]u8;
    var at:   u32 = 0;
    text[at] = '(';
    at       = at + 1;
    var i: u32 = 0;
    for (i < 2) {
        val v: *operand.Value = ?pair.at[i];
        if (!sel v.immediate) { ret write.refuse(w, write.NO_SPELLING, field.NO_OPERAND); }
        if (i > 0) {
            text[at] = ' ';
            at       = at + 1;
        }
        text[at] = '0' + (v.immediate % 10)::u8;
        at       = at + 1;
        i        = i + 1;
    }
    text[at]     = ')';
    text[at + 1] = 0;
    ret write.text(w, ?text[0]);
}

#[testing]
val T_GROUP_HOOK: core_syntax.Hook = core_syntax.Hook{parse: t_group_parse, print: t_group_print};

# a syntax's group hook reads and writes a group whole, and a syntax without one reads the members joined by its
# variadic text
test format__a_group_hook_spells_the_group_whole {
    var t: T;
    if (!t_make(?t, "rv64i")) { ret 1; }
    var hooked: core_syntax.Syntax = riscv_syntax.SYNTAX;
    hooked.hooks.group = ?T_GROUP_HOOK;
    t.syntax           = ?hooked;
    val formats: source.Formats                    = source.Formats{at: ?T_PAIR_FORMATS[0], len: 1};
    var rd:      core_syntax.Reader                = t_reader(?t, "pair (3 4)", diagnostic.START);
    val got:     res[Taken, diagnostic.Diagnostic] = format(?rd, formats);
    if (sel got.err) { ret 2; }
    var ins:  inst.Inst     = got.ok.inst;
    val held: operand.Value = ins.values[0];
    if (!sel held.group) { ret 3; }
    val pair: operand.Values = held.group;
    if (pair.len != 2) { ret 3; }
    val second: *operand.Value = ?pair.at[1];
    if (!(sel second.immediate && second.immediate == 4)) { ret 4; }
    t.out.len = 0;
    var w:       core_syntax.Writer = core_syntax.Writer{out: ?t.out, codec: t.codec, ctx: ?t.ctx, syntax: t.syntax, modes: ?t.modes, symbols: ?T_SYMBOLS, context: nil, row: nil, dot: false, values: nil};
    val printed: err[field.Refusal] = print.templated(?w, "pair <0>", ?ins);
    if (sel printed.err) { ret 5; }
    val ended: res[usize, A.Error] = vector.push[u8](?t.out, 0);
    if (sel ended.err)                         { ret 6; }
    if (!str_equals(t.out.data, "pair (3 4)")) { ret 7; }
    t.syntax = ?riscv_syntax.SYNTAX;
    var plain:  core_syntax.Reader                = t_reader(?t, "pair (3 4)", diagnostic.START);
    val joined: res[Taken, diagnostic.Diagnostic] = format(?plain, formats);
    if (!sel joined.err) { ret 8; }
    var members: core_syntax.Reader                = t_reader(?t, "pair 3, 4", diagnostic.START);
    val member:  res[Taken, diagnostic.Diagnostic] = format(?members, formats);
    if (sel member.err) { ret 9; }
    ret 0;
}

# a hook reads the values of the operands its row's template read before it, and writes with those of the instruction
# printed: OpSum's word is its offset from the id before it
test statement__a_hook_reads_the_values_read_before_it {
    var t: T;
    if (!t_words(?t)) { ret 1; }
    var ex:  relax.Expansion;
    val got: err[diagnostic.Diagnostic] = t_word_statement(?t, "OpSum %3 4", ?ex);
    if (sel got.err || ex.count != 1 || ex.steps[0].row != ?T_WORD_ROWS[4]) { ret 2; }
    val sum: operand.Value = ex.steps[0].values[1];
    if (!sel sum.immediate) { ret 3; }
    if (sum.immediate != 7) { ret 4; }
    var ins: inst.Inst = inst.Inst{row: ex.steps[0].row, values: ?ex.steps[0].values[0], count: 2, form: ex.steps[0].form};
    if (!t_print(?t, ?ins) || !str_equals(t.out.data, "OpSum %3 4")) { ret 5; }
    ret 0;
}

#[testing]
val T_LOCK: [1]str = [1]str{"lock"};

#[testing]
val T_PREFIXED_FORMS: [5]str = [5]str{"OpExecutionMode <0>", "OpSample <0>", "OpIAdd <1> <2>", "lock OpStore <0> <1>", "lock OpSum <0> <1>"};

#[testing]
val T_PREFIXED_ENTRIES: [5]core_syntax.Entry = [5]core_syntax.Entry{
    core_syntax.Entry{key: "OpExecutionMode", first: 0, len: 1},
    core_syntax.Entry{key: "OpIAdd", first: 1, len: 1},
    core_syntax.Entry{key: "OpSample", first: 2, len: 1},
    core_syntax.Entry{key: "lock OpStore", first: 3, len: 1},
    core_syntax.Entry{key: "lock OpSum", first: 4, len: 1},
};

# the word set with two rows spelled behind the prefix `lock`, each keyed by its joined mnemonic
#[testing]
val T_PREFIXED_SYNTAX: core_syntax.Syntax = core_syntax.Syntax{
    name:      "prefixed",
    forms:     core_syntax.Forms{at: ?T_PREFIXED_FORMS[0], len: 5},
    index:     core_syntax.Index{at: ?T_PREFIXED_ENTRIES[0], len: 5, candidates: ?T_WORD_CANDIDATES[0], count: 5},
    hooks:     core_syntax.Hooks{immediate: ?T_WORD_HOOK, memory: nil, list: nil, id: ?T_WORD_HOOK, literal: nil, register: nil},
    register:  "",
    join:      "|",
    variadic:  " ",
    anonymous: ".Lw",
    statement: t_bind,
    lead:      t_lead,
    prefixes:  core_syntax.Prefixes{at: ?T_LOCK[0], len: 1},
};

# a prefix joins the word after it into one mnemonic: its rows are reached by the joined key whatever white space the
# text puts between them, print with one space, and the prefix or its word alone names no mnemonic
test statement__a_prefix_joins_the_word_after_it_into_one_mnemonic {
    var t: T;
    if (!t_words(?t)) { ret 1; }
    t.syntax = ?T_PREFIXED_SYNTAX;
    if (core_syntax.mnemonic(T_PREFIXED_SYNTAX.prefixes, T_PREFIXED_FORMS[4]).len != 10) { ret 2; }
    val texts: [2]str = [2]str{"lock OpStore %1 %2", "lock \t OpStore %1 %2"};
    var k:     u32    = 0;
    for (k < 2) {
        var ex:  relax.Expansion;
        val got: err[diagnostic.Diagnostic] = t_word_statement(?t, texts[k], ?ex);
        if (sel got.err || ex.count != 1 || ex.steps[0].row != ?T_WORD_ROWS[3]) { ret 3 + k::i32; }
        var ins: inst.Inst = inst.Inst{row: ex.steps[0].row, values: ?ex.steps[0].values[0], count: 2, form: ex.steps[0].form};
        if (!t_print(?t, ?ins) || !str_equals(t.out.data, "lock OpStore %1 %2")) { ret 5 + k::i32; }
        k = k + 1;
    }
    var ex:  relax.Expansion;
    val sum: err[diagnostic.Diagnostic] = t_word_statement(?t, "lock OpSum %3 4", ?ex);
    if (sel sum.err || ex.steps[0].row != ?T_WORD_ROWS[4]) { ret 7; }
    val bare: err[diagnostic.Diagnostic] = t_word_statement(?t, "OpStore %1 %2", ?ex);
    if (!sel bare.err)                             { ret 8; }
    if (bare.err.message != read.UNKNOWN_MNEMONIC) { ret 9; }
    val other: err[diagnostic.Diagnostic] = t_word_statement(?t, "lock OpStores %1 %2", ?ex);
    if (!sel other.err)                                                         { ret 10; }
    if (other.err.message != read.UNKNOWN_MNEMONIC || other.err.span.len != 13) { ret 11; }
    ret 0;
}
