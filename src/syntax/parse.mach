# the instruction parser: instruction text read into an encoded instruction value
#
# the parser finds the candidates for the text's mnemonic in the syntax's
# index and tries them in row order, a row's template and then each alias of
# that row, the order of the encoder's preference, and takes the first whose
# text matches and whose values the row admits under the selection. an alias
# resolves to its base row's value. when no candidate takes the text, the
# refusal is the one of the candidate that read it whole, or else of the one
# that read furthest, at its column.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.inst;
use masc.core.operand;
use masc.core.register;
use masc.core.row;
use masc.core.spelling;
use masc.core.walk;
use masc.syntax.alias;
use masc.syntax.print;
use masc.syntax.read;

# the refusal kept while candidates are tried
# ---
# held:     whether one is kept
# complete: whether its candidate read the whole text, so it outranks any that did not
# refusal:  the refusal
rec Best {
    held:     bool;
    complete: bool;
    refusal:  diagnostic.Diagnostic;
}

fun keep(best: *Best, d: diagnostic.Diagnostic, complete: bool) {
    if (best.held) {
        if (best.complete && !complete)                                                         { ret; }
        if (best.complete == complete && d.span.start.offset <= best.refusal.span.start.offset) { ret; }
    }
    best.held     = true;
    best.complete = complete;
    best.refusal  = d;
}

# one value of `desc` read at the position
fun one(r: *spelling.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    val shape: *operand.Shape = ?desc.shape;
    if (sel shape.register) {
        val reg: res[register.Id, diagnostic.Diagnostic] = read.register_value(r);
        if (sel reg.err) { ret err[diagnostic.Diagnostic].err{reg.err}; }
        @out = operand.Value.register{reg.ok};
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (sel shape.enumerant) {
        val e: res[u32, diagnostic.Diagnostic] = read.enumeration(r, ?shape.enumerant);
        if (sel e.err) { ret err[diagnostic.Diagnostic].err{e.err}; }
        @out = operand.Value.enumerant{e.ok};
        ret err[diagnostic.Diagnostic].ok{};
    }
    if (sel shape.condition) {
        val c: res[u32, diagnostic.Diagnostic] = read.enumeration(r, ?shape.condition);
        if (sel c.err) { ret err[diagnostic.Diagnostic].err{c.err}; }
        @out = operand.Value.condition{c.ok};
        ret err[diagnostic.Diagnostic].ok{};
    }
    val h: *spelling.Hook = spelling.hook(r.syntax, shape);
    if (h == nil) { ret err[diagnostic.Diagnostic].err{read.refuse(r, read.EXPECTED, r.at, read.token(r, r.at))}; }
    ret h.parse(r, desc, format, out);
}

# operand `desc`'s value read by its hole, a variadic operand as members joined by the syntax's text
fun hole(r: *spelling.Reader, desc: *operand.Operand, format: View, out: *operand.Value) err[diagnostic.Diagnostic] {
    if (desc.quantity != operand.VARIADIC) { ret one(r, desc, format, out); }
    var first: *operand.Value = nil;
    var count: u32            = 0;
    for {
        val back: usize = r.at;
        if (count > 0) {
            if (!read.take(r, r.syntax.variadic)) { brk; }
            read.skip(r);
        }
        var member: operand.Value;
        val got:    err[diagnostic.Diagnostic] = one(r, desc, format, ?member);
        if (sel got.err) {
            r.at = back;
            brk;
        }
        val slot: res[*operand.Value, diagnostic.Diagnostic] = read.push(r, member);
        if (sel slot.err) { ret err[diagnostic.Diagnostic].err{slot.err}; }
        if (count == 0)   { first = slot.ok; }
        count = count + 1;
    }
    @out = operand.Value.list{operand.Values{at: first, len: count}};
    ret err[diagnostic.Diagnostic].ok{};
}

# whether the piece after the one at `at` ends a word, so the text must too
fun ends_word(template: str, at: usize) bool {
    val next: spelling.Piece = spelling.piece(template, at);
    ret next.kind == spelling.SPACE || next.kind == spelling.END || next.kind == spelling.OPEN || next.kind == spelling.CLOSE;
}

# whether the text starts with the template's mnemonic, the text before its first space, hole or group
fun keyed(r: *spelling.Reader, template: str, from: usize) bool {
    var at: usize = 0;
    var i:  usize = from;
    for {
        val p: spelling.Piece = spelling.piece(template, at);
        if (p.kind != spelling.TEXT)                                { ret true; }
        if (i >= r.end || !read.same(r, r.text[i], template[p.at])) { ret false; }
        i  = i + 1;
        at = p.at + p.len;
        if (read.word(template[p.at]) && ends_word(template, at) && i < r.end && read.word(r.text[i])) { ret false; }
    }
}

# `template` read over the whole text, hole n into `values[n]` by `descs[n]` at `spans[n]`
# ---
# ret: ok, or the refusal at the column the text stops matching
fun match(r: *spelling.Reader, template: str, descs: **operand.Operand, values: *operand.Value, spans: *usize, best: *Best) err[diagnostic.Diagnostic] {
    var at:    usize = 0;
    var after: bool  = false;
    var group: usize = 0;
    var back:  usize = 0;
    var used:  u32   = 0;
    var open:  bool  = false;
    read.skip(r);
    for {
        val p: spelling.Piece = spelling.piece(template, at);
        at = p.at + p.len;
        var failed: opt[diagnostic.Diagnostic] = opt[diagnostic.Diagnostic].none{};
        if (p.kind == spelling.END) {
            read.skip(r);
            if (r.at == r.end) { ret err[diagnostic.Diagnostic].ok{}; }
            failed = opt[diagnostic.Diagnostic].some{read.refuse(r, read.UNEXPECTED, r.at, read.token(r, r.at))};
        }
        or (p.kind == spelling.SPACE) {
            read.skip(r);
            after = false;
        }
        or (p.kind == spelling.OPEN) {
            open  = true;
            group = at;
            back  = r.at;
            used  = r.used;
        }
        or (p.kind == spelling.CLOSE) {
            open = false;
        }
        or (p.kind == spelling.TEXT) {
            if (after) { read.skip(r); }
            after = false;
            val c: u8 = template[p.at];
            if (read.peek(r) == 0 || !read.same(r, read.peek(r), c)) {
                failed = opt[diagnostic.Diagnostic].some{read.refuse(r, read.UNEXPECTED, r.at, read.token(r, r.at))};
            }
            or {
                r.at = r.at + 1;
                if (read.word(c) && ends_word(template, at) && read.word(read.peek(r))) {
                    failed = opt[diagnostic.Diagnostic].some{read.refuse(r, read.UNEXPECTED, r.at, read.token(r, r.at))};
                }
            }
        }
        or (p.kind == spelling.HOLE) {
            spans[p.operand] = r.at;
            val got: err[diagnostic.Diagnostic] = hole(r, descs[p.operand], p.format, ?values[p.operand]);
            if (sel got.err) { failed = opt[diagnostic.Diagnostic].some{got.err}; }
            after = true;
        }
        if (sel failed.some) {
            if (!open) { ret err[diagnostic.Diagnostic].err{failed.some}; }
            # an optional group that does not match is absent, its operands none
            keep(best, failed.some, false);
            r.at   = back;
            r.used = used;
            var q: spelling.Piece = spelling.piece(template, group);
            for (q.kind != spelling.CLOSE && q.kind != spelling.END) {
                if (q.kind == spelling.HOLE) { values[q.operand] = operand.Value.none{}; }
                q = spelling.piece(template, q.at + q.len);
            }
            at   = q.at + q.len;
            open = false;
        }
    }
}

# whether operand `op` has a hole in `template`
fun written(template: str, op: u8) bool {
    var p: spelling.Piece = spelling.piece(template, 0);
    for (p.kind != spelling.END) {
        if (p.kind == spelling.HOLE && p.operand == op) { ret true; }
        p = spelling.piece(template, p.at + p.len);
    }
    ret false;
}

# the candidate `r`'s base row and values admitted, into the reader's pool
# ---
# spans: the offset each base operand was read at, the instruction's start for one the text does not hold
fun admit(rd: *spelling.Reader, r: *row.Row, values: *operand.Value, spans: *usize, best: *Best) opt[inst.Inst] {
    if (!extension.admits(rd.available.selection, r.requires)) {
        keep(best, read.refuse(rd, field.NOT_ADMITTED, rd.start, read.token(rd, rd.start)), true);
        ret opt[inst.Inst].none{};
    }
    var ins:      inst.Inst          = inst.Inst{row: r, values: values, count: r.operands.len};
    val admitted: err[field.Refusal] = walk.admits(rd.codec, rd.available, ?ins);
    if (sel admitted.err) {
        var at: usize = rd.start;
        if (admitted.err.operand::u32 < r.operands.len) { at = spans[admitted.err.operand]; }
        keep(best, read.refuse(rd, admitted.err.message, at, read.token(rd, at)), true);
        ret opt[inst.Inst].none{};
    }
    var i: u32 = 0;
    for (i < r.operands.len) {
        rd.pool[i] = values[i];
        i          = i + 1;
    }
    ret opt[inst.Inst].some{inst.Inst{row: r, values: rd.pool, count: r.operands.len}};
}

# the row `index` read by its own template
fun by_row(rd: *spelling.Reader, index: u32, best: *Best) opt[inst.Inst] {
    val r:        *row.Row = ?rd.codec.rows.at[index];
    val template: str      = rd.syntax.forms.at[index];
    var descs:    [row.MAX_OPERANDS]*operand.Operand;
    var values:   [row.MAX_OPERANDS]operand.Value;
    var spans:    [row.MAX_OPERANDS]usize;
    var i:        u32      = 0;
    for (i < r.operands.len) {
        descs[i] = ?r.operands.at[i];
        spans[i] = rd.start;
        i        = i + 1;
    }
    rd.at   = rd.start;
    rd.used = r.operands.len;
    val matched: err[diagnostic.Diagnostic] = match(rd, template, ?descs[0], ?values[0], ?spans[0], best);
    if (sel matched.err) {
        keep(best, matched.err, false);
        ret opt[inst.Inst].none{};
    }
    # an operand the template does not write is the register the row fixes it to
    i = 0;
    for (i < r.operands.len) {
        if (!written(template, i::u8)) {
            val at: opt[u32] = effect.fixed(r.effect, i::u8);
            if (sel at.some) { values[i] = operand.Value.register{register.id_of(?rd.codec.registers.registers[at.some])}; }
        }
        i = i + 1;
    }
    ret admit(rd, r, ?values[0], ?spans[0], best);
}

# the alias `a` read and resolved to its base row
fun by_alias(rd: *spelling.Reader, a: *spelling.Alias, best: *Best) opt[inst.Inst] {
    val r:      *row.Row = ?rd.codec.rows.at[a.row];
    var descs:  [row.MAX_OPERANDS]*operand.Operand;
    var values: [row.MAX_OPERANDS]operand.Value;
    var spans:  [row.MAX_OPERANDS]usize;
    var k:      u8       = 0;
    for (k < a.count) {
        descs[k] = spelling.alias_operand(a, r, k);
        spans[k] = rd.start;
        k        = k + 1;
    }
    rd.at   = rd.start;
    rd.used = r.operands.len;
    val matched: err[diagnostic.Diagnostic] = match(rd, a.template, ?descs[0], ?values[0], ?spans[0], best);
    if (sel matched.err) {
        keep(best, matched.err, false);
        ret opt[inst.Inst].none{};
    }
    var base:  [row.MAX_OPERANDS]operand.Value;
    var where: [row.MAX_OPERANDS]usize;
    if (!alias.resolve(rd.codec, a, ?values[0], ?base[0])) {
        keep(best, read.refuse(rd, read.UNEXPECTED, rd.start, read.token(rd, rd.start)), true);
        ret opt[inst.Inst].none{};
    }
    var j: u32 = 0;
    for (j < r.operands.len) {
        val src: spelling.Source = a.sources.at[j];
        where[j] = rd.start;
        if (sel src.operand) { where[j] = spans[src.operand]; }
        if (sel src.flipped) { where[j] = spans[src.flipped.operand]; }
        j = j + 1;
    }
    ret admit(rd, r, ?base[0], ?where[0], best);
}

# whether candidate `a` is tried after candidate `b`
fun later(a: spelling.Candidate, b: spelling.Candidate) bool {
    ret a.row > b.row || (a.row == b.row && a.alias > b.alias);
}

# byte `depth` of the key of entry `i`, in lower case when the syntax folds
fun key_byte(rd: *spelling.Reader, i: u32, depth: usize) u8 {
    val c: u8 = rd.syntax.index.at[i].key[depth];
    if (rd.syntax.fold) { ret spelling.lower(c); }
    ret c;
}

# the first entry of `lo` up to `hi` whose key byte `depth` is `c` or above, or above when `above`
fun narrow(rd: *spelling.Reader, lo: u32, hi: u32, depth: usize, c: u8, above: bool) u32 {
    var l: u32 = lo;
    var h: u32 = hi;
    for (l < h) {
        val mid: u32 = l + (h - l) / 2;
        val k:   u8  = key_byte(rd, mid, depth);
        if (k < c || (above && k == c)) { l = mid + 1; }
        or                              { h = mid; }
    }
    ret l;
}

# the first candidate of entry `e` after `last`, or its first when none has been tried
fun within(ix: *spelling.Index, e: *spelling.Entry, started: bool, last: spelling.Candidate, out: *spelling.Candidate) bool {
    var lo: u32 = 0;
    var hi: u32 = e.len;
    for (started && lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (later(ix.candidates[e.first + mid], last)) { hi = mid; }
        or                                             { lo = mid + 1; }
    }
    if (lo >= e.len) { ret false; }
    @out = ix.candidates[e.first + lo];
    ret true;
}

# the next candidate to try for the text at `head`, the earliest after `last` of every entry whose key starts the text
# ---
# started: whether `last` is set, false for the first candidate
# ret:     whether there is one, then in `out`
fun next(rd: *spelling.Reader, head: usize, started: bool, last: spelling.Candidate, out: *spelling.Candidate) bool {
    val ix:    *spelling.Index = ?rd.syntax.index;
    var lo:    u32             = 0;
    var hi:    u32             = ix.len;
    var depth: usize           = 0;
    var found: bool            = false;
    for (lo < hi) {
        # the entry whose key ends here sorts before every longer key
        if (ix.at[lo].key[depth] == 0) {
            var c: spelling.Candidate;
            if (within(ix, ?ix.at[lo], started, last, ?c) && (!found || later(@out, c))) {
                @out  = c;
                found = true;
            }
            lo = lo + 1;
        }
        if (lo >= hi || head + depth >= rd.end) { brk; }
        var b: u8 = rd.text[head + depth];
        if (rd.syntax.fold) { b = spelling.lower(b); }
        val first: u32 = narrow(rd, lo, hi, depth, b, false);
        hi    = narrow(rd, first, hi, depth, b, true);
        lo    = first;
        depth = depth + 1;
    }
    ret found;
}

# the instruction at the reader's text, read in its syntax
# ---
# rd:  the reader over the instruction's text, its pool holding the values first and then list members
# ret: the instruction, its values in the pool, or the refusal at its column
pub fun instruction(rd: *spelling.Reader) res[inst.Inst, diagnostic.Diagnostic] {
    var best:      Best = Best{held: false, complete: false, refusal: diagnostic.Diagnostic{message: read.UNKNOWN_MNEMONIC, span: diagnostic.Span{start: rd.origin, len: 0}}};
    var keyed_any: bool = false;
    rd.at = rd.start;
    read.skip(rd);
    val head:    usize = rd.at;
    var last:    spelling.Candidate;
    var current: spelling.Candidate;
    var started: bool  = false;
    for (next(rd, head, started, last, ?current)) {
        started = true;
        last    = current;
        val r: *row.Row = ?rd.codec.rows.at[current.row];
        if (rd.cap < r.operands.len) { ret res[inst.Inst, diagnostic.Diagnostic].err{read.refuse(rd, field.STORAGE, head, 0)}; }
        if (current.alias == 0) {
            if ((r.flags & row.DECODE_ONLY) != 0 || !keyed(rd, rd.syntax.forms.at[current.row], head)) { cnt; }
            keyed_any = true;
            val got: opt[inst.Inst] = by_row(rd, current.row, ?best);
            if (sel got.some) { ret res[inst.Inst, diagnostic.Diagnostic].ok{got.some}; }
        }
        or {
            val a: *spelling.Alias = ?rd.syntax.aliases.at[current.alias - 1];
            if (!keyed(rd, a.template, head)) { cnt; }
            keyed_any = true;
            val got: opt[inst.Inst] = by_alias(rd, a, ?best);
            if (sel got.some) { ret res[inst.Inst, diagnostic.Diagnostic].ok{got.some}; }
        }
    }
    if (!keyed_any) { ret res[inst.Inst, diagnostic.Diagnostic].err{read.refuse(rd, read.UNKNOWN_MNEMONIC, head, read.token(rd, head))}; }
    ret res[inst.Inst, diagnostic.Diagnostic].err{best.refusal};
}

# a test's selection, its register view and the parser's storage
#[testing]
rec T {
    t:     testing.Testing;
    s:     extension.Selection;
    v:     register.Available;
    store: [8]operand.Value;
}

#[testing]
fun t_make(t: *T) bool {
    testing.make(?t.t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t.t), ?print.T_CATALOG, "i,c", diagnostic.START);
    if (sel made.err) { ret false; }
    t.s = made.ok;
    val viewed: res[register.Available, register.Error] = register.select(testing.allocator_of(?t.t), print.T_CODEC.registers, ?t.s);
    if (sel viewed.err) { ret false; }
    t.v = viewed.ok;
    ret true;
}

# `text` read in the test syntax, starting at `origin`
#[testing]
fun t_parse(t: *T, text: str, origin: diagnostic.Position) res[inst.Inst, diagnostic.Diagnostic] {
    var rd: spelling.Reader = spelling.Reader{
        text:      text,
        start:     0,
        at:        0,
        end:       str_len(text),
        origin:    origin,
        codec:     ?print.T_CODEC,
        available: ?t.v,
        syntax:    ?print.T_SYNTAX,
        symbols:   ?print.T_SYMBOLS,
        context:   nil,
        row:       nil,
        pool:      ?t.store[0],
        cap:       8,
        used:      0,
        bytes:     nil,
        room:      0,
        taken:     0,
    };
    ret instruction(?rd);
}

test instruction__every_alias_form_parses_to_its_base_row {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val texts: [5]str = [5]str{"nop", "mv x5, x6", "li x5, 3", "set 3", "set 300"};
    var i:     u32    = 0;
    for (i < print.T_SYNTAX.aliases.len) {
        val a:   *spelling.Alias                       = ?print.T_SYNTAX.aliases.at[i];
        val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, texts[i], diagnostic.START);
        if (sel got.err)                                 { ret 2; }
        if (got.ok.row != ?print.T_CODEC.rows.at[a.row]) { ret 3; }
        var held: [row.MAX_OPERANDS]operand.Value;
        if (!alias.applies(?print.T_CODEC, a, got.ok.values, ?held[0])) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

test index__a_shared_mnemonic_yields_every_candidate_in_order {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val text: str             = "set 3";
    var rd:   spelling.Reader = spelling.Reader{
        text:      text,
        start:     0,
        at:        0,
        end:       str_len(text),
        origin:    diagnostic.START,
        codec:     ?print.T_CODEC,
        available: ?t.v,
        syntax:    ?print.T_SYNTAX,
        symbols:   ?print.T_SYMBOLS,
        context:   nil,
        row:       nil,
        pool:      ?t.store[0],
        cap:       8,
        used:      0,
        bytes:     nil,
        room:      0,
        taken:     0,
    };
    # alias set of c.li, then the const row spelled set, then alias set of const
    val rows:    [3]u32 = [3]u32{2, 3, 3};
    val aliases: [3]u32 = [3]u32{4, 0, 5};
    var last:    spelling.Candidate;
    var got:     spelling.Candidate;
    var started: bool   = false;
    var i:       u32    = 0;
    for (i < 3) {
        if (!next(?rd, 0, started, last, ?got))            { ret 2; }
        if (got.row != rows[i] || got.alias != aliases[i]) { ret 3; }
        started = true;
        last    = got;
        i       = i + 1;
    }
    if (next(?rd, 0, started, last, ?got)) { ret 4; }
    ret 0;
}

test instruction__a_specifier_parses_into_a_symbolic_operand {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "beq x5, x0, %plt(far+8)", diagnostic.START);
    if (sel got.err) { ret 2; }
    val target: operand.Value = got.ok.values[2];
    if (!(sel target.symbol && (target.symbol.id == 1 && target.symbol.addend == 8 && target.symbol.fixup == 2))) { ret 3; }
    ret 0;
}

test instruction__an_ambiguous_operand_resolves_to_the_preferred_row {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    # the const row admits 3 as well, but c.li comes first in the encoder's order
    var three:    [1]operand.Value   = [1]operand.Value{operand.Value.immediate{3}};
    var later:    inst.Inst          = inst.Inst{row: ?print.T_CODEC.rows.at[3], values: ?three[0], count: 1};
    val admitted: err[field.Refusal] = walk.admits(?print.T_CODEC, ?t.v, ?later);
    if (sel admitted.err) { ret 2; }
    val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "set 3", diagnostic.START);
    if (sel got.err)                             { ret 3; }
    if (got.ok.row != ?print.T_CODEC.rows.at[2]) { ret 4; }
    ret 0;
}

test instruction__a_malformed_operand_is_refused_at_its_column {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val origin: diagnostic.Position                   = diagnostic.Position{offset: 40, line: 3, column: 5};
    val got:    res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, "addi x5, x5, 12q", origin);
    if (!sel got.err) { ret 2; }
    val d: diagnostic.Diagnostic = got.err;
    if (d.message != read.MALFORMED)                                                                         { ret 3; }
    if (d.span.start.line != 3 || d.span.start.column != 18 || d.span.start.offset != 53 || d.span.len != 3) { ret 4; }
    ret 0;
}

test instruction__printing_then_parsing_returns_the_same_value {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var out: vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t.t));
    val x0:  operand.Value     = operand.Value.register{register.make(0, 0)};
    val x5:  operand.Value     = operand.Value.register{register.make(0, 5)};
    val x6:  operand.Value     = operand.Value.register{register.make(0, 6)};
    val far: operand.Symbol    = operand.Symbol{id: 1, addend: 8, fixup: operand.NO_FIXUP};
    val plt: operand.Symbol    = operand.Symbol{id: 1, addend: -4, fixup: 2};
    # one instruction per row, and one per alias that prints
    val rows:   [12]u32              = [12]u32{0, 0, 0, 0, 1, 1, 2, 3, 4, 5, 6, 7};
    var values: [12][3]operand.Value = [12][3]operand.Value{
        [3]operand.Value{x5, x6, operand.Value.immediate{-2048}},
        [3]operand.Value{x5, x5, operand.Value.immediate{0}},
        [3]operand.Value{x0, x0, operand.Value.immediate{0}},
        [3]operand.Value{x5, x0, operand.Value.immediate{3}},
        [3]operand.Value{x5, x6, operand.Value.symbol{far}},
        [3]operand.Value{x5, x0, operand.Value.symbol{plt}},
        [3]operand.Value{x5, operand.Value.immediate{-32}, operand.Value.none{}},
        [3]operand.Value{operand.Value.immediate{300}, operand.Value.none{}, operand.Value.none{}},
        [3]operand.Value{operand.Value.register{register.make(0, 7)}, x5, operand.Value.none{}},
        [3]operand.Value{operand.Value.register{register.make(0, 9)}, operand.Value.none{}, operand.Value.none{}},
        [3]operand.Value{x5, operand.Value.immediate{-1}, operand.Value.none{}},
        [3]operand.Value{operand.Value.immediate{16}, operand.Value.none{}, operand.Value.none{}},
    };
    var i: u32 = 0;
    for (i < 12) {
        val r:   *row.Row  = ?print.T_CODEC.rows.at[rows[i]];
        var ins: inst.Inst = inst.Inst{row: r, values: ?values[i][0], count: r.operands.len};
        out.len = 0;
        var w:       spelling.Writer    = spelling.Writer{out: ?out, codec: ?print.T_CODEC, syntax: ?print.T_SYNTAX, symbols: ?print.T_SYMBOLS, context: nil, row: nil};
        val printed: err[field.Refusal] = print.instruction(?w, ?ins);
        if (sel printed.err) { ret 2; }
        val pushed: res[usize, A.Error] = vector.push[u8](?out, 0);
        if (sel pushed.err) { ret 3; }
        val got: res[inst.Inst, diagnostic.Diagnostic] = t_parse(?t, out.data, diagnostic.START);
        if (sel got.err)     { ret 4; }
        if (got.ok.row != r) { ret 5; }
        var k: u32 = 0;
        for (k < r.operands.len) {
            if (!operand.equal(?got.ok.values[k], ?values[i][k])) { ret 6; }
            k = k + 1;
        }
        i = i + 1;
    }
    vector.dnit[u8](?out);
    ret 0;
}
