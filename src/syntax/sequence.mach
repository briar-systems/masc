# sequence spellings: several instructions read and written as one statement
#
# a sequence spelling states its instructions as steps, each operand taken
# from an operand of the spelling, a symbol of it given a fixup kind, a fixed
# register or a fixed value. `spells` reads the spelling's operands back out
# of instructions, which is how the printer chooses one, and `expand` writes
# the instructions from its operands, which is how the parser and a set's
# pseudo instructions build them. both read the one table. a step's part
# may name the label at the sequence's first instruction, which the caller
# knows by its handle: the parser's is core_syntax.OWN, which the assembler
# binds to a label there spelled by the syntax's own stem, and a printer
# that knows no label there spells no such sequence.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use masc.core.inst;
use masc.core.operand;
use masc.core.relax;
use masc.core.row;
use core_syntax: masc.core.syntax;

# the fixup kind a symbol of `kind` takes in operand `k` of `r`, its default when it states none
fun stated(r: *row.Row, k: u32, kind: operand.FixupKind) operand.FixupKind {
    if (kind == operand.NO_FIXUP) { ret operand.default_fixup(?r.operands.at[k]); }
    ret kind;
}

# `kind` as a symbol in operand `k` of `r` holds it, NO_FIXUP for the operand's default, as the parser reads a specifier
# of the default kind
fun held(r: *row.Row, k: u32, kind: operand.FixupKind) operand.FixupKind {
    if (kind == operand.default_fixup(?r.operands.at[k])) { ret operand.NO_FIXUP; }
    ret kind;
}

# `v` as operand `op` of the spelling, agreeing with any value it was already given
fun take(values: *operand.Value, given: *u32, op: u8, v: operand.Value) bool {
    val bit: u32 = 1::u32 << op::u32;
    if ((@given & bit) != 0) {
        var held: operand.Value = v;
        ret operand.equal(?values[op], ?held);
    }
    values[op] = v;
    @given     = @given | bit;
    ret true;
}

# whether the `count` instructions at `steps` are what `q` spells, its operands into `values`
# ---
# here: the handle of the label at the first instruction, operand.NO_SYMBOL when the caller knows none
pub fun spells(q: *core_syntax.Sequence, steps: *inst.Inst, count: u32, here: u32, values: *operand.Value) bool {
    if (count != q.steps.len) { ret false; }
    var given: u32 = 0;
    var i:     u32 = 0;
    for (i < count) {
        val step: *core_syntax.Step = ?q.steps.at[i];
        if (steps[i].row != step.row || steps[i].count != step.parts.len) { ret false; }
        var k: u32 = 0;
        for (k < step.parts.len) {
            val part: core_syntax.Part = step.parts.at[k];
            val v:    operand.Value    = steps[i].values[k];
            if (sel part.operand) {
                if (!take(values, ?given, part.operand, v)) { ret false; }
            }
            if (sel part.symbol) {
                if (!sel v.symbol)                                            { ret false; }
                if (stated(step.row, k, v.symbol.fixup) != part.symbol.fixup) { ret false; }
                val bare: operand.Value = operand.Value.symbol{operand.Symbol{id: v.symbol.id, addend: v.symbol.addend, fixup: operand.NO_FIXUP}};
                if (!take(values, ?given, part.symbol.operand, bare)) { ret false; }
            }
            if (sel part.register) {
                if (!sel v.register)             { ret false; }
                if (v.register != part.register) { ret false; }
            }
            if (sel part.value) {
                var want: operand.Value = part.value;
                var got:  operand.Value = v;
                if (!operand.equal(?got, ?want)) { ret false; }
            }
            if (sel part.here) {
                if (here == operand.NO_SYMBOL)                        { ret false; }
                if (!sel v.symbol)                                    { ret false; }
                if (v.symbol.id != here || v.symbol.addend != 0)      { ret false; }
                if (stated(step.row, k, v.symbol.fixup) != part.here) { ret false; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret given == (1::u32 << q.operands.len) - 1;
}

# the instructions `q` spells with its operands `values`, into `out`
# ---
# here: the handle of the label at the first instruction, which a part naming it takes
# ret:  whether every symbol operand a step gives a fixup kind holds a symbol of no specifier, and `here` is a handle
#       when a part names it
pub fun expand(q: *core_syntax.Sequence, values: *operand.Value, here: u32, out: *relax.Expansion) bool {
    if (q.steps.len > relax.MAX_STEPS) { ret false; }
    var i: u32 = 0;
    for (i < q.steps.len) {
        val step: *core_syntax.Step = ?q.steps.at[i];
        val e:    *relax.Emitted    = ?out.steps[i];
        e.row    = step.row;
        e.marker = operand.NO_FIXUP;
        var k: u32 = 0;
        for (k < step.parts.len) {
            val part: core_syntax.Part = step.parts.at[k];
            if (sel part.operand)  { e.values[k] = values[part.operand]; }
            if (sel part.register) { e.values[k] = operand.Value.register{part.register}; }
            if (sel part.value)    { e.values[k] = part.value; }
            if (sel part.symbol) {
                val v: operand.Value = values[part.symbol.operand];
                if (!sel v.symbol)                      { ret false; }
                if (v.symbol.fixup != operand.NO_FIXUP) { ret false; }
                e.values[k] = operand.Value.symbol{operand.Symbol{id: v.symbol.id, addend: v.symbol.addend, fixup: held(step.row, k, part.symbol.fixup)}};
            }
            if (sel part.here) {
                if (here == operand.NO_SYMBOL) { ret false; }
                e.values[k] = operand.Value.symbol{operand.Symbol{id: here, addend: 0, fixup: held(step.row, k, part.here)}};
            }
            k = k + 1;
        }
        i = i + 1;
    }
    out.count = q.steps.len;
    ret true;
}

# the index of `r` among the codec's rows
fun row_index(rows: row.Rows, r: *row.Row) u32 {
    ret ((r:~u64 - rows.at:~u64) / $size_of(row.Row)::u64)::u32;
}

# the first spelling of `syntax` whose first step is row `r`, a binary search of the spellings, in their order, len when none is
pub fun first_of(syntax: *core_syntax.Syntax, rows: row.Rows, r: *row.Row) u32 {
    val want: u32 = row_index(rows, r);
    var lo:   u32 = 0;
    var hi:   u32 = syntax.sequences.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (row_index(rows, syntax.sequences.at[mid].steps.at[0].row) < want) { lo = mid + 1; }
        or                                                                    { hi = mid; }
    }
    ret lo;
}
