# writing instruction text: the output, the refusals, and the operands spelled from their one table
#
# registers are written by their register row's name and enumerants and
# conditions by their members' names, the same tables `masc.syntax.read`
# reads them from.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use masc.core.field;
use masc.core.operand;
use masc.core.register;
use masc.core.spelling;

# the refusal of a value no table or hook spells
pub val NO_SPELLING: str = "value has no spelling";

# a refusal of `message` about operand `op`, at the output's end
pub fun refuse(w: *spelling.Writer, message: str, op: u8) err[field.Refusal] {
    ret err[field.Refusal].err{field.refusal(message, op, w.out.len)};
}

# `len` bytes of `text` appended
pub fun bytes(w: *spelling.Writer, text: *u8, len: usize) err[field.Refusal] {
    var i: usize = 0;
    for (i < len) {
        val pushed: res[usize, A.Error] = vector.push[u8](w.out, text[i]);
        if (sel pushed.err) { ret refuse(w, field.MEMORY, field.NO_OPERAND); }
        i = i + 1;
    }
    ret err[field.Refusal].ok{};
}

# `text` appended
pub fun text(w: *spelling.Writer, text: str) err[field.Refusal] {
    ret bytes(w, text, str_len(text));
}

# the view `v` appended
pub fun view(w: *spelling.Writer, v: View) err[field.Refusal] {
    ret bytes(w, v.data, v.len);
}

# `value` appended in decimal, signed
pub fun decimal(w: *spelling.Writer, value: i64) err[field.Refusal] {
    var digits: [20]u8;
    var n:      u64 = value:~u64;
    var at:     u32 = 20;
    if (value < 0) {
        val minus: err[field.Refusal] = bytes(w, "-", 1);
        if (sel minus.err) { ret minus; }
        n = ~n + 1;
    }
    for {
        at         = at - 1;
        digits[at] = '0' + (n % 10)::u8;
        n          = n / 10;
        if (n == 0) { brk; }
    }
    ret bytes(w, ?digits[at], (20 - at)::usize);
}

# `value` appended in hexadecimal after 0x
pub fun hexadecimal(w: *spelling.Writer, value: u64) err[field.Refusal] {
    var digits: [18]u8;
    var n:      u64 = value;
    var at:     u32 = 18;
    for {
        at         = at - 1;
        digits[at] = "0123456789abcdef"[(n & 15)::usize];
        n          = n >> 4;
        if (n == 0) { brk; }
    }
    at         = at - 1;
    digits[at] = 'x';
    at         = at - 1;
    digits[at] = '0';
    ret bytes(w, ?digits[at], (18 - at)::usize);
}

# the register `reg` appended after the syntax's register prefix, by its first alias when the syntax writes aliases and the register has one, else by its row's name
pub fun register_name(w: *spelling.Writer, reg: register.Id, op: u8) err[field.Refusal] {
    if (w.codec.registers == nil) { ret refuse(w, NO_SPELLING, op); }
    val row: opt[*register.Register] = register.row_of(w.codec.registers, reg);
    if (sel row.none) { ret refuse(w, NO_SPELLING, op); }
    val prefix: err[field.Refusal] = text(w, w.syntax.register);
    if (sel prefix.err) { ret prefix; }
    if (w.syntax.aliased) {
        val named: opt[*register.Alias] = register.first_alias(w.codec.registers, reg);
        if (sel named.some) { ret text(w, named.some.name); }
    }
    ret text(w, row.some.name);
}

# the value `value` of `e` appended by its members' names, a mask's members joined by the syntax's join in member order
pub fun enumeration(w: *spelling.Writer, e: *operand.Enumeration, value: u32, op: u8) err[field.Refusal] {
    var i: u32 = 0;
    for (i < e.count) {
        if (e.members[i].value == value) { ret text(w, e.members[i].name); }
        i = i + 1;
    }
    if (!e.mask || value == 0) { ret refuse(w, NO_SPELLING, op); }
    var covered: u32   = 0;
    var first:   bool  = true;
    val start:   usize = w.out.len;
    i = 0;
    for (i < e.count) {
        val bits: u32 = e.members[i].value;
        if (bits != 0 && (value & bits) == bits && (covered & bits) != bits) {
            if (!first) {
                val joined: err[field.Refusal] = text(w, w.syntax.join);
                if (sel joined.err) { ret joined; }
            }
            val named: err[field.Refusal] = text(w, e.members[i].name);
            if (sel named.err) { ret named; }
            covered = covered | bits;
            first   = false;
        }
        i = i + 1;
    }
    if (covered != value) {
        w.out.len = start;
        ret refuse(w, NO_SPELLING, op);
    }
    ret err[field.Refusal].ok{};
}
