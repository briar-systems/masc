use masc.syntax.parse;
use masc.syntax.print;
use seq:          masc.syntax.sequence;
use syntax_write: masc.syntax.write;

pub val ARCH:      str = "the set does not serve the object's architecture";
pub val NO_SYNTAX: str = "no syntax of the set at this index";
pub val NO_PARCEL: str = "the set states no parcel of its code";
pub val NO_BYTE:   str = "bytes no statement reads back to, which the set's source dialect has no one-byte data directive for";
pub val STREAMED:  str = "the object's context is already in a typed stream";
pub val DEFINED:   str = "instruction that breaks what the stream before it defined";
pub val MEMORY:    str = "out of memory";
pub val REREAD:    str = "text that reads back to another module than the format builds from the object";
# the facts no directive the assembler reads states, each refused for its reason (#181), the source dialect's directives
# being those `masc.asm.core` reads:
# - line tables the line directives do not state (`masc.asm.line`): a section's rows run from a sequence's first row to
#   its section's end, one sequence per section, each row's `.loc` before the instruction it starts at, so a sequence
#   of another extent, a row where no instruction starts and a row with an end column are refused
# - link-order owners written after the sections they order: a link-order section is stated by its `.section` order
#   flag `o` and a name of the section it orders after, the section's own where its name alone enters it and no symbol
#   of another section has it, else an anchor the disassembler states at the section's start, which the assembler reads
#   back to the section only once it is placed. a coff section kept with a leader by an associative selection names its
#   leader alike. a comdat group is stated by its sections' `.section` group flag `G`, signature and `comdat`, and a
#   group no section is in by none, as no `.group` is read
# - note records: a `.note` section is a section of bytes, which prints as its `.section` with `@note` and its data and
#   reads back to the same note. a note mink holds as a record of the object rather than a section, which no mink format
#   reads or writes for an object, has no section the text could write it in
# - index entries: the source dialect states none, and a module's text states the entries the format numbers into the
#   module, so only an object written as sections is refused them
# - version records: a version a symbol's name carries is part of its name, and no record the model holds apart from
#   the name is stated
# - a relocation that subtracts a symbol of its own, as a Mach-O subtractor pair, anywhere but as a datum of its width,
#   which is written as the difference it states, as `.long a - b`: `.reloc` names no minus
# - a binding no binding directive states, as the unique binding
# comdat groups and marker relocations are not among them: `.section` with `G` and `.reloc` state them, and link-order
# sections are stated by `.section` with `o`
pub val SEQUENCE:       str = "line sequence no .loc states: a second in its section, one with no row at its start, or one that ends before its section";
pub val ROW:            str = "line row at a place no instruction starts at";
pub val NOTES:          str = "the object states note records apart from any section, which no section the text writes holds";
pub val ENTRIES:        str = "the object states index entries, which disassembly does not write";
pub val LIBRARY:        str = "the object describes a shared library, which has no source";
pub val GROUPED:        str = "section in a group no .section states: one that keeps copies by another rule than any one, or a nameless section's";
pub val OWNED:          str = "link-order or associative section whose owner is written after it, which no name reads back to before it is placed";
pub val EMPTY:          str = "section group no section is in, which no .section states";
pub val SECTION:        str = "section whose kind and flags no .section reads back to";
pub val KINDLESS:       str = "nameless section whose kind no directive of the dialect enters";
pub val TWICE:          str = "two sections of one name, which the dialect keeps no two of apart";
pub val NAMELESS:       str = "symbol with no name that no label stands for";
pub val QUOTED:         str = "name that cannot be written in a string";
pub val UNSPELLED:      str = "symbol name the text cannot spell: one holding a control byte";
pub val VERSIONED:      str = "symbol version record, which the text states only as part of the name";
pub val BINDING:        str = "symbol binding no directive states";
pub val SEARCH:         str = "weak external search no directive states";
pub val VISIBILITY:     str = "symbol visibility no directive states";
pub val TYPE:           str = "symbol kind no .type states";
pub val ENTRY:          str = "symbol that names an index entry";
pub val MARKER:         str = "marker relocation that nothing printed rides beside";
pub val UNTAKEN:        str = "relocation no instruction operand or datum of the set takes";
pub val DIFFERENCE:     str = "relocation that subtracts a symbol of its own";
pub val UNPAIRED:       str = "relocation of one half of a difference without the other";
pub val HELD:           str = "relocated field that holds bits of its own";
pub val NO_WIDTH:       str = "the set's source dialect has no data directive of this width";
pub val ZEROS:          str = "relocation in a section of zero fill";
pub val PAST:           str = "label or relocation past its section's end";
pub val FOLDED:         str = "relocation to a place of its own section that the assembler resolves, which the text cannot keep";
pub val MAPPED:         str = "relocation against a mapping symbol, which marks a place and is no label the text can name";
pub val WIDENED:        str = "instruction that widens the selection to one the set cannot make, which the assembler refuses after it";
pub val MARK_SELECTION: str = "code mark naming a selection the set does not read, or one the object's register file and state do not hold";
pub val UNROWED:        str = "relocation the object's format names no row of, which no .reloc states";
pub val RAISED:         str = "label or relocation in a section the object's format holds its traits in, which the text states as traits";

# how an instruction is spelled
# ---
# ALIASES: by the preferred alias of its row that applies, else its row's own form
# FORMS:   by its row's own form, whatever alias applies
pub def Spelling: u8;

pub val ALIASES: Spelling = 0;
pub val FORMS:   Spelling = 1;

# what a disassembly is asked for
# ---
# syntax:   the index of the set's syntax it is written in
# spelling: how each instruction is spelled. a sequence its relocation covers, as risc-v's `call`, is spelled by its
#           sequence either way, since its instructions do not reassemble alone
# dialect:  the assembly dialect the text is read back in (`masc.format.dialect`), which states how a section is kept apart
#           from another of its name
# formats:  the registry of the object's format, which names the sections the text enters, by whose conventions they are
#           read back, states the sections it holds the traits in and the relocation rows a `.reloc` names its kind by, and
#           builds the module a dialect whose text states one writes
pub rec Options {
    syntax:   u32;
    spelling: Spelling;
    dialect:  *dialect.Dialect;
    formats:  *registry.Registry;
}

# the section of a refusal about the object as a whole
pub val NO_SECTION: u32 = 0xFFFFFFFF;

# the section of a refusal at a place of the module the format builds from the object, its offset one in the bytes the
# format writes of the module
pub val IN_MODULE: u32 = 0xFFFFFFFE;

# why an object was not disassembled
# ---
# message: what was refused
# section: the section it was found in, NO_SECTION for the object as a whole
# offset:  where in that section
pub rec Refusal {
    message: str;
    section: u32;
    offset:  u64;
}

# bytes of raw data on one line
val PER_LINE: usize = 16;

# the handle a probe gives the operand it tries
val PROBE: u32 = 1;

# a place a label is printed at
# ---
# section: the section's index
# offset:  the offset within it
# handle:  the symbol handle the label spells, or for an anchor its number after the stem
rec Label {
    section: u32;
    offset:  u64;
    handle:  u32;
}

# a relocation at its place
rec Site {
    section: u32;
    offset:  u64;
    reloc:   u32;
}

# a mapping symbol at its place
# ---
# code:  whether it marks where code starts, else where data does
# basis: for a code mark, the basis the code after it is read under, by its index among the disassembly's bases
# name:  its symbol's name
rec Mapped {
    section: u32;
    offset:  u64;
    code:    bool;
    basis:   usize;
    name:    View;
}

# a relocation kind and a set-local fixup kind bound to it on the object's architecture
# ---
# kind:    the relocation kind an object read holds where the fixup was written: the bound one, or the one the format
#          reads its record back as where it writes the bound one by a record of another kind, as coff writes a branch
#          by IMAGE_REL_AMD64_REL32 and reads that back as a place-relative 32-bit relocation
# written: the relocation kind it is bound to
# fixup:   the fixup kind
# refines: the kind a symbol states that the encoder writes as this one, NO_FIXUP for none (`core_fixup.Binding`)
rec Bound {
    kind:    *mink_reloc.Kind;
    written: *mink_reloc.Kind;
    fixup:   operand.FixupKind;
    refines: operand.FixupKind;
}

# what a relocation refers to, as the text names it
rec Aimed {
    handle: u32;
    addend: i64;
}

# one instruction of a statement as decoded
# ---
# at:     its offset in the section
# len:    its length
# values: its operand values, then its list members, grown to what the instruction holds
rec Step {
    at:     u64;
    len:    usize;
    ins:    inst.Inst;
    values: vector.Vector[operand.Value];
}

# the most scopes a disassembly tries, the object's included, and the most of the dialect's narrowings it combines
val MAX_SCOPES:   usize = 64;
val MAX_COMBINED: u32   = 6;

# a selection statements are read back under: the object's, or a combination of the dialect's narrowings of it
# ---
# v:     its context
# fills: the code fill patterns it admits, longest first
# mask:  its narrowings, one bit each by the directive's index, none for the object's own selection
# kept:  the narrowed context it owns, nil for the object's
# basis: the selection it narrows, by its index among the disassembly's bases
# slot:  its place among its basis's scopes
rec Scope {
    v:     *state.Context;
    fills: vector.Vector[*fill.Pattern];
    mask:  u64;
    kept:  *narrow.Narrowed;
    basis: usize;
    slot:  usize;
}

# a selection the scopes of a stretch of code narrow: the object's, or one a code mark names, as risc-v's
# `$xrv64i2p1_c2p0` names the selection the code after it was written under, which the text restates by the dialect's
# restatement, `.option arch, rv64i2p1_c2p0`, written in the mark's own spelling
# ---
# first:   its first scope, its own selection unnarrowed
# members: its scopes by their index among the disassembly's, the first first, then those narrowing it that `scopes_of`
#          makes, then those a widening makes the first time the code needs their narrowings
# text:    the spelling the restatement writes, the mark's, empty for a basis no mark names, which the restatement
#          spells by its own selection
# kept:    the context it owns, nil for the object's
rec Basis {
    first:   usize;
    members: vector.Vector[usize];
    text:    View;
    kept:    *narrow.Narrowed;
}

# what a scoped attempt writes
# ---
# STATEMENT: an instruction statement
# REALIGN:   the alignment a realign marker states
# PAIR:      a sequence binding the label at its first instruction itself, as `lla`, under `Disasm.here`
def Attempt: u8;

val STATEMENT: Attempt = 0;
val REALIGN:   Attempt = 1;
val PAIR:      Attempt = 2;

# the state of one disassembly
# ---
# v:       the view of the scope being tried
# fills:   the code fill patterns of the scope being tried
# scopes:  the object's scope first, then each combination of the narrowings the object's selection is narrowed by
# now:     the scope in force, which the text written so far ends under
# under:   the basis the push of the scope in force saved, which its pop puts back
# bases:   the selections scopes narrow, the object's first, then each another code mark names or a statement widens the
#          selection to, once each
# basis:   the basis of the code being read, as the code mark before it names it or a statement since widened it
# read:    how many instructions the statement that last read back holds
# labels:  every label, in place order
# sites:   every relocation, in place order
# folded:  per symbol, the weak external whose default definition it is, plus one, 0 for a symbol that is none
# anchors: the labels the disassembler states, in place order, each numbered after the stem
# bound:   the set's bindings in order of relocation kind
# count:   how many symbols the object has, the handles past it naming anchors
# byte:    the one-byte data directive, none for a set whose dialect has none, as spir-v's, whose bytes print only as
#          statements
# li, ri:   the next label and the next relocation to print
# apart:      the unique numbers given so far, the last of them the latest
# full:       whether the output failed to grow
# forms:      whether instructions are spelled by their rows' own forms
# named:      the handles the statement being verified names, which its parse resolves
# refs:       per handle, less one, how many relocations name it
# here:       the label a PAIR attempt's sequence binds at its first instruction
# marked:     the set's rows that take a marker operand, which a decoded instruction a marker relocation lies at is tried as
# expansions: the set's compressions indexed by shorter row, which a compressed instruction is printed by the alias
#             of the row it expands to through
# mapping:    the mapping symbols the text's assembler writes, none where the pair of its format states none
# marks:      the object's mapping symbols, in place order
# mi:         the next mapping symbol to read
# modes:      the assembler modes the text written so far ends under
# pushed:     the modes the push of the scope in force saved, which its pop restores
# headed:     whether a section's text opens with the directive that enters it, which a module's stream has none of
# stating:    what the statement being tried may leave to `.reloc`: NONE_STATED, the relocations no operand of it takes
#             (UNTAKEN_STATED), or every relocation (ALL_STATED)
# stated:     the relocations, by their index among the sites, the statement that last read back leaves to `.reloc`
# traits:     how the object's format holds its traits, which names the sections the text never states
# relocs:     the object's format's relocation rows for its architecture, the registry's refusal for a format with none
# cleared:    every section's bytes as the builder encodes them, each field its format holds a relocation's addend in
#             cleared, as the format writes the addend there from the relocation
# starts:     per section, where its bytes start in `cleared`, empty until they are made
rec Disasm {
    a:          *A.Allocator;
    s:          *set.Set;
    v:          *state.Context;
    syntax:     *core_syntax.Syntax;
    dialect:    *dialect.Dialect;
    naming:     *contract.Naming;
    modes:      mode.State;
    pushed:     mode.State;
    o:          *mink_object.Object;
    out:        *vector.Vector[u8];
    labels:     vector.Vector[Label];
    sites:      vector.Vector[Site];
    anchors:    vector.Vector[Label];
    folded:     vector.Vector[u32];
    marks:      vector.Vector[Mapped];
    marked:     vector.Vector[*row.Row];
    expansions: cmp.Expansions;
    refs:       vector.Vector[u32];
    here:       u32;
    mapping:    opt[*mink_pair.Mapping];
    mi:         usize;
    headed:     bool;
    stating:    u8;
    stated:     vector.Vector[usize];
    traits:     *contract.TraitCodec;
    relocs:     res[registry.Relocations, fail.Fail];
    bound:      vector.Vector[Bound];
    fills:      *vector.Vector[*fill.Pattern];
    scopes:     vector.Vector[Scope];
    now:        usize;
    under:      usize;
    bases:      vector.Vector[Basis];
    basis:      usize;
    read:       u32;
    bytes:      vector.Vector[u8];
    cleared:    vector.Vector[u8];
    starts:     vector.Vector[usize];
    fixups:     vector.Vector[field.Fixup];
    symbols:    core_syntax.Symbols;
    count:      u32;
    byte:       opt[str];
    li:         usize;
    ri:         usize;
    apart:      u64;
    full:       bool;
    forms:      bool;
    named:      [relax.MAX_STEPS]u32;
    names:      u32;
    scratch:    [core_syntax.MAX_ANONYMOUS + 10]u8;
    steps:      [relax.MAX_STEPS]Step;
    stores:     core_syntax.Stores;
    rows:       vector.Vector[Located];
    xi:         usize;
    spoken:     lines.Spoken;
    pending:    bool;
}

# a line row at its place, `order` its place among the object's rows, which keeps rows at one offset in their order
rec Located {
    section: u32;
    offset:  u64;
    order:   usize;
    loc:     lines.Location;
}

fun refusal(message: str, section: u32, offset: u64) err[Refusal] {
    ret err[Refusal].err{Refusal{message: message, section: section, offset: offset}};
}

fun whole(message: str) err[Refusal] {
    ret refusal(message, NO_SECTION, 0);
}

fun held(r: res[usize, A.Error]) bool {
    ret sel r.ok;
}

# `n` bytes at `p` appended, noting a failure to grow
fun put_bytes(d: *Disasm, p: *u8, n: usize) {
    if (!held(vector.reserve[u8](d.out, n))) {
        d.full = true;
        ret;
    }
    var i: usize = 0;
    for (i < n) {
        d.out.data[d.out.len] = p[i];
        vector.commit[u8](d.out, 1);
        i = i + 1;
    }
}

fun put(d: *Disasm, s: str) {
    put_bytes(d, s, str_len(s));
}

fun put_view(d: *Disasm, v: View) {
    put_bytes(d, v.data, v.len);
}

fun put_char(d: *Disasm, c: u8) {
    put_bytes(d, ?c, 1);
}

fun put_unsigned(d: *Disasm, value: u64) {
    var digits: [20]u8;
    var n:      u64 = value;
    var at:     u32 = 20;
    for {
        at         = at - 1;
        digits[at] = '0' + (n % 10)::u8;
        n          = n / 10;
        if (n == 0) { brk; }
    }
    put_bytes(d, ?digits[at], (20 - at)::usize);
}

fun put_signed(d: *Disasm, value: i64) {
    if (value < 0) {
        put_char(d, '-');
        put_unsigned(d, ~(value:~u64) + 1);
        ret;
    }
    put_unsigned(d, value:~u64);
}

fun put_hex(d: *Disasm, b: u8) {
    put(d, "0x");
    put_char(d, "0123456789abcdef"[(b >> 4)::usize]);
    put_char(d, "0123456789abcdef"[(b & 15)::usize]);
}

# `name` written as a string, refused when it holds a quote, a backslash or a control character
fun put_string(d: *Disasm, name: View) bool {
    var i: usize = 0;
    for (i < name.len) {
        val c: u8 = name.data[i];
        if (c == '"' || c == '\\' || c < 0x20) { ret false; }
        i = i + 1;
    }
    put_char(d, '"');
    put_view(d, name);
    put_char(d, '"');
    ret true;
}

# symbol name `name` written bare or in quotes, as `masc.syntax.write.name` spells it. `declare` refused every name the
# text spells that has no spelling, so only the output failing to grow fails here
fun put_symbol(d: *Disasm, name: View) {
    var w:     core_syntax.Writer = writer(d);
    val wrote: err[field.Refusal] = syntax_write.name(?w, name, field.NO_OPERAND);
    if (sel wrote.err) { d.full = true; }
}

# the bytes of `v` written as a quoted name holds them (`masc.syntax.write.escaped`)
fun put_escaped(d: *Disasm, v: View) {
    var w:     core_syntax.Writer = writer(d);
    val wrote: err[field.Refusal] = syntax_write.escaped(?w, v);
    if (sel wrote.err) { d.full = true; }
}

# a writer onto the output, under the view and modes of the text at the cursor
fun writer(d: *Disasm) core_syntax.Writer {
    ret core_syntax.Writer{out: d.out, codec: d.s.codec, ctx: d.v, syntax: d.syntax, modes: ?d.modes, symbols: ?d.symbols, context: nil, row: nil, dot: false, values: nil, format: d.dialect.format};
}

fun by_place(x: *Label, y: *Label) i64 {
    if (x.section != y.section) {
        if (x.section < y.section) { ret -1; }
        ret 1;
    }
    if (x.offset != y.offset) {
        if (x.offset < y.offset) { ret -1; }
        ret 1;
    }
    if (x.handle < y.handle) { ret -1; }
    if (x.handle > y.handle) { ret 1; }
    ret 0;
}

fun by_mark(x: *Mapped, y: *Mapped) i64 {
    if (x.section != y.section) {
        if (x.section < y.section) { ret -1; }
        ret 1;
    }
    if (x.offset < y.offset) { ret -1; }
    if (x.offset > y.offset) { ret 1; }
    ret 0;
}

# whether `name` starts with `stem`, and with `exact` is it
fun stems(name: View, stem: str, exact: bool) bool {
    val n: usize = str_len(stem);
    if (n == 0 || name.len < n || (exact && name.len != n)) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (name.data[i] != stem[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether symbol `sym` is a mapping symbol the text's assembler writes: a placed local of no type named by the code stem,
# followed by anything when the code mark names the view, or by the data stem
fun mapping_symbol(d: *Disasm, sym: *mink_object.Symbol) bool {
    if (sel d.mapping.none)                                                                { ret false; }
    if (sym.binding != ?symbol.LOCAL || sym.kind != ?symbol.NOTYPE || !sel sym.def.placed) { ret false; }
    val name: View = name_of(d, sym.name);
    ret marks_code(d, name) || stems(name, d.mapping.some.data, true);
}

# whether `name` is spelled as a code mark: the code stem, followed by anything when the code mark names the view
fun marks_code(d: *Disasm, name: View) bool {
    if (sel d.mapping.none) { ret false; }
    ret stems(name, d.mapping.some.code, !d.mapping.some.per_view);
}

fun by_site(x: *Site, y: *Site) i64 {
    if (x.section != y.section) {
        if (x.section < y.section) { ret -1; }
        ret 1;
    }
    if (x.offset != y.offset) {
        if (x.offset < y.offset) { ret -1; }
        ret 1;
    }
    if (x.reloc < y.reloc) { ret -1; }
    if (x.reloc > y.reloc) { ret 1; }
    ret 0;
}

fun by_kind(x: *Bound, y: *Bound) i64 {
    val p: u64 = x.kind:~u64;
    val q: u64 = y.kind:~u64;
    if (p < q)             { ret -1; }
    if (p > q)             { ret 1; }
    if (x.fixup < y.fixup) { ret -1; }
    if (x.fixup > y.fixup) { ret 1; }
    ret 0;
}

fun section_of(d: *Disasm, i: u32) *mink_object.Section {
    ret table.at[mink_object.Section](?d.o.sections, table.nth[mink_object.Section](i::usize));
}

fun symbol_of(d: *Disasm, i: u32) *mink_object.Symbol {
    ret table.at[mink_object.Symbol](?d.o.symbols, table.nth[mink_object.Symbol](i::usize));
}

fun reloc_of(d: *Disasm, site: *Site) *mink_object.Reloc {
    ret table.at[mink_object.Reloc](?d.o.relocs, table.nth[mink_object.Reloc](site.reloc::usize));
}

fun name_of(d: *Disasm, id: table.Id[intern.Name]) View {
    ret mink_object.name_of(d.o, id);
}

# the bytes section `i` holds, as the builder encodes them once `clear_fields` has made them
fun contents(d: *Disasm, i: u32) store.Bytes {
    val own: store.Bytes = mink_object.bytes(d.o, ?section_of(d, i).contents);
    if (i::usize >= d.starts.len || own.len == 0) { ret own; }
    ret store.Bytes{data: ?d.cleared.data[d.starts.data[i::usize]], len: own.len};
}

# every section's bytes copied with the field of each relocation whose row holds its addend in the bytes cleared, as
# the builder encodes a relocated field before the format writes the addend into it, so a field reads back as the
# builder writes it whatever addend the relocation states. a relocation of no row leaves its bytes as they are
fun clear_fields(d: *Disasm) err[Refusal] {
    val count: usize = table.count[mink_object.Section](?d.o.sections)::usize;
    var total: usize = 0;
    var i:     usize = 0;
    for (i < count) {
        total = total + mink_object.bytes(d.o, ?table.at[mink_object.Section](?d.o.sections, table.nth[mink_object.Section](i)).contents).len;
        i     = i + 1;
    }
    if (!held(vector.reserve[u8](?d.cleared, total + 1)) || !held(vector.reserve[usize](?d.starts, count))) { ret whole(MEMORY); }
    i = 0;
    for (i < count) {
        val own: store.Bytes = mink_object.bytes(d.o, ?table.at[mink_object.Section](?d.o.sections, table.nth[mink_object.Section](i)).contents);
        vector.push[usize](?d.starts, d.cleared.len);
        var k: usize = 0;
        for (k < own.len) {
            vector.push[u8](?d.cleared, own.data[k]);
            k = k + 1;
        }
        i = i + 1;
    }
    if (sel d.relocs.err) { ret err[Refusal].ok{}; }
    var rows: registry.Relocations = d.relocs.ok;
    var j:    usize                = 0;
    for (j < d.sites.len) {
        val site: *Site              = ?d.sites.data[j];
        val r:    *mink_object.Reloc = reloc_of(d, site);
        j = j + 1;
        val own: store.Bytes = mink_object.bytes(d.o, ?section_of(d, site.section).contents);
        if (own.len == 0) { cnt; }
        val rw: res[*mink_row.Row, fail.Fail] = mink_row.targeting(rows.rows, r.kind, sel r.minus.some);
        if (sel rw.err)                                            { cnt; }
        if (!(sel rw.ok.addend.field) && !(sel rw.ok.addend.held)) { cnt; }
        var at: engine.Site = engine.Site{section: "section", data: ?d.cleared.data[d.starts.data[site.section::usize]], size: own.len::u64, offset: site.offset, order: d.o.target.arch.order};
        # a field that holds nothing is the builder's zero, which is the addend the row's bias stands for
        val put_: err[fail.Fail] = engine.put_addend(rw.ok, ?at, rw.ok.bias);
    }
    ret err[Refusal].ok{};
}

# the size of section `i`, its zero fill or its bytes
fun size_of(d: *Disasm, i: u32) u64 {
    val sec: *mink_object.Section = section_of(d, i);
    if (sel sec.contents.zero) { ret sec.contents.zero; }
    ret mink_object.bytes(d.o, ?sec.contents).len::u64;
}

fun is_kind(k: *symbol.Kind, caps: symbol.Caps) bool {
    ret (k.caps & caps) != 0;
}

# the stem followed by `number` in decimal, written to `to`, answering how long it is
fun stemmed(stem: str, number: u32, to: *u8) usize {
    var lead: usize = 0;
    for (stem[lead] != 0) {
        to[lead] = stem[lead];
        lead     = lead + 1;
    }
    var digits: [10]u8;
    var count:  usize = 0;
    var left:   u32   = number;
    for {
        digits[count] = '0' + (left % 10)::u8;
        count         = count + 1;
        left          = left / 10;
        if (left == 0) { brk; }
    }
    var k: usize = 0;
    for (k < count) {
        to[lead + k] = digits[count - 1 - k];
        k            = k + 1;
    }
    ret lead + count;
}

# the spelling of handle `id`: an object symbol's name, or an anchor's stem and number
fun named(context: ptr, id: u32) View {
    val d: *Disasm = context::*Disasm;
    if (id <= d.count) {
        if (d.folded.len >= id::usize && d.folded.data[id::usize - 1] != 0) { ret name_of(d, symbol_of(d, d.folded.data[id::usize - 1] - 1).name); }
        ret name_of(d, symbol_of(d, id - 1).name);
    }
    val number: u32 = d.anchors.data[(id - d.count - 1)::usize].handle;
    ret view(?d.scratch[0], stemmed(d.dialect.temporary, number, ?d.scratch[0]));
}

fun same_view(a: View, b: View) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a name the statement being verified prints, resolved to its handle. a bare `.` or numbered label's reference is no
# name it prints, which spells such a name in quotes
fun resolved(context: ptr, name: View, spelling: core_syntax.Spelling) res[core_syntax.Resolved, str] {
    val d: *Disasm = context::*Disasm;
    if (sel spelling.bare && spell.reserved(name)) { ret res[core_syntax.Resolved, str].err{UNTAKEN}; }
    var i: u32 = 0;
    for (i < d.names) {
        if (same_view(named(context, d.named[i]), name)) { ret res[core_syntax.Resolved, str].ok{core_syntax.Resolved.symbol{d.named[i]}}; }
        i = i + 1;
    }
    ret res[core_syntax.Resolved, str].err{UNTAKEN};
}

# the anchor at `offset` of section `section`, a binary search of the anchors
fun anchor_at(d: *Disasm, section: u32, offset: u64) opt[u32] {
    var want: Label = Label{section: section, offset: offset, handle: 0};
    var lo:   usize = 0;
    var hi:   usize = d.anchors.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        var at:  Label = d.anchors.data[mid];
        at.handle = 0;
        if (by_place(?at, ?want) < 0) { lo = mid + 1; }
        or                            { hi = mid; }
    }
    if (lo >= d.anchors.len || d.anchors.data[lo].section != section || d.anchors.data[lo].offset != offset) { ret opt[u32].none{}; }
    ret opt[u32].some{d.count + 1 + lo::u32};
}

# the place a reference to a section symbol plus `addend` is anchored at: the addend's own offset when it lies in the
# section, else the section's start
fun anchored(d: *Disasm, section: u32, addend: i64) u64 {
    if (addend >= 0 && addend:~u64 <= size_of(d, section)) { ret addend:~u64; }
    ret 0;
}

# what relocation `r` refers to as the text names it, none for a marker
fun aim(d: *Disasm, r: *mink_object.Reloc, site: *Site) res[opt[Aimed], Refusal] {
    if (sel r.target.entry)   { ret res[opt[Aimed], Refusal].err{Refusal{message: ENTRY, section: site.section, offset: site.offset}}; }
    if (!sel r.target.symbol) { ret res[opt[Aimed], Refusal].ok{opt[Aimed].none{}}; }
    val index: u32                 = r.target.symbol.index;
    val sym:   *mink_object.Symbol = symbol_of(d, index);
    if (mapping_symbol(d, sym)) { ret res[opt[Aimed], Refusal].err{Refusal{message: MAPPED, section: site.section, offset: site.offset}}; }
    if (sel sym.def.placed) {
        val p: mink_object.Place = sym.def.placed;
        if (is_kind(sym.kind, symbol.SECTION)) {
            val at:  u64      = anchored(d, p.section.index, r.addend);
            val got: opt[u32] = anchor_at(d, p.section.index, at);
            if (sel got.some) { ret res[opt[Aimed], Refusal].ok{opt[Aimed].some{Aimed{handle: got.some, addend: r.addend - at:~i64}}}; }
        }
        if (name_of(d, sym.name).len == 0) {
            val got: opt[u32] = anchor_at(d, p.section.index, p.offset);
            if (sel got.some) { ret res[opt[Aimed], Refusal].ok{opt[Aimed].some{Aimed{handle: got.some, addend: r.addend}}}; }
        }
    }
    if (name_of(d, sym.name).len == 0) { ret res[opt[Aimed], Refusal].err{Refusal{message: NAMELESS, section: site.section, offset: site.offset}}; }
    ret res[opt[Aimed], Refusal].ok{opt[Aimed].some{Aimed{handle: index + 1, addend: r.addend}}};
}

# the first of the bindings of relocation kind `kind`, a binary search of the bound kinds, len when none
fun first_bound(d: *Disasm, kind: *mink_reloc.Kind) usize {
    val want: u64   = kind:~u64;
    var lo:   usize = 0;
    var hi:   usize = d.bound.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (d.bound.data[mid].kind:~u64 < want) { lo = mid + 1; }
        or                                      { hi = mid; }
    }
    ret lo;
}

# the relocation kind an object read holds where fixup kind `fixup` was written on the object's architecture, nil for
# none
fun kind_of(d: *Disasm, fixup: operand.FixupKind) *mink_reloc.Kind {
    var i: usize = 0;
    for (i < d.bound.len) {
        if (d.bound.data[i].fixup == fixup) { ret d.bound.data[i].kind; }
        i = i + 1;
    }
    ret nil;
}

# the relocation kind fixup kind `fixup` is bound to on the object's architecture, which the builder writes, nil for
# none
fun written_kind(d: *Disasm, fixup: operand.FixupKind) *mink_reloc.Kind {
    var i: usize = 0;
    for (i < d.bound.len) {
        if (d.bound.data[i].fixup == fixup) { ret d.bound.data[i].written; }
        i = i + 1;
    }
    ret nil;
}

# the kind the object's format reads back the record it writes relocation kind `kind` by: `kind` itself, else the kind
# of the one row that reads that record's key, as a key several kinds are written by reads back as one of them
fun read_back(d: *Disasm, kind: *mink_reloc.Kind) *mink_reloc.Kind {
    if (sel d.relocs.err) { ret kind; }
    var rows:  registry.Relocations          = d.relocs.ok;
    val wrote: res[*mink_row.Row, fail.Fail] = registry.relocation_by_kind(?rows, kind);
    if (sel wrote.err) { ret kind; }
    val read_: res[*mink_row.Row, fail.Fail] = mink_row.by_key(rows.rows, wrote.ok.key);
    if (sel read_.err) { ret kind; }
    ret read_.ok.kind;
}

# whether a specifier of the syntax spells fixup kind `f` on an operand of default fixup kind `default` under the
# dialect's format
fun spelled(d: *Disasm, f: operand.FixupKind, default: operand.FixupKind) bool {
    var k: u32 = 0;
    for (k < d.syntax.specifiers.len) {
        val sp: *core_syntax.Specifier = ?d.syntax.specifiers.at[k];
        if (sp.operand == default && sp.fixup == f && core_syntax.reads(sp, d.dialect.format)) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the fixup kind relocation kind `kind` takes on an operand of default fixup kind `default`: the default itself, else
# one a specifier of the syntax spells there under the dialect's format, or the kind such a one refines into it, else
# the first bound to it, as the kind it refines when it refines one, NO_FIXUP for none
fun fixup_for(d: *Disasm, kind: *mink_reloc.Kind, default: operand.FixupKind) operand.FixupKind {
    val first: usize             = first_bound(d, kind);
    var found: operand.FixupKind = operand.NO_FIXUP;
    if (binds(d, kind, default)) { ret default; }
    var i: usize = first;
    for (i < d.bound.len && d.bound.data[i].kind == kind) {
        val b: *Bound = ?d.bound.data[i];
        if (spelled(d, b.fixup, default))                                    { ret b.fixup; }
        if (b.refines != operand.NO_FIXUP && spelled(d, b.refines, default)) { ret b.refines; }
        if (found == operand.NO_FIXUP && b.refines != operand.NO_FIXUP)      { found = b.refines; }
        or (found == operand.NO_FIXUP)                                       { found = b.fixup; }
        i = i + 1;
    }
    ret found;
}

# the fixup kind `kind` is written as where its symbol states `addend`, as the builder writes it: its binding's added
# kind on the object's architecture and the dialect's format where the addend is not zero
# (`core_fixup.Binding.added`), else itself
fun written_as(d: *Disasm, kind: operand.FixupKind, addend: i64) operand.FixupKind {
    if (addend == 0 || kind == operand.NO_FIXUP) { ret kind; }
    var i: u32 = 0;
    for (i < d.s.bindings.len) {
        val b: *core_fixup.Binding = ?d.s.bindings.at[i];
        i = i + 1;
        if (b.fixup != kind || !core_fixup.binds(b, d.o.target.arch)) { cnt; }
        val added: operand.FixupKind = core_fixup.added(b, d.dialect.format);
        if (added != operand.NO_FIXUP) { ret added; }
    }
    ret kind;
}

# the kind a symbol states with `addend` in an operand of default `default`, whose bare symbol the encoder gives `own`,
# so the builder writes relocation kind `kind`, from `f`, the kind found for it: none when a bare symbol is written so,
# as elf's pc32 of a branch to `foo+8`, else `f` when it is written so, else another kind of `kind` a specifier spells
# there that is written as itself under the addend, as `@PLT` of a branch to `foo@PLT+4`, else `f`
fun stated_as(d: *Disasm, kind: *mink_reloc.Kind, default: operand.FixupKind, own: operand.FixupKind, f: operand.FixupKind, addend: i64) operand.FixupKind {
    if (own != operand.NO_FIXUP && kind_of(d, written_as(d, own, addend)) == kind) { ret operand.NO_FIXUP; }
    if (f != operand.NO_FIXUP && kind_of(d, written_as(d, f, addend)) == kind)     { ret f; }
    var i: usize = first_bound(d, kind);
    for (i < d.bound.len && d.bound.data[i].kind == kind) {
        val b: operand.FixupKind = d.bound.data[i].fixup;
        if (spelled(d, b, default) && written_as(d, b, addend) == b) { ret b; }
        i = i + 1;
    }
    ret f;
}

# whether relocation kind `kind` is bound to fixup kind `fixup`
fun binds(d: *Disasm, kind: *mink_reloc.Kind, fixup: operand.FixupKind) bool {
    if (fixup == operand.NO_FIXUP) { ret false; }
    var i: usize = first_bound(d, kind);
    for (i < d.bound.len && d.bound.data[i].kind == kind) {
        if (d.bound.data[i].fixup == fixup) { ret true; }
        i = i + 1;
    }
    ret false;
}

# `v` holding symbol `sym` in place of its number: a memory value's displacement, any other value whole
fun symbolic(v: operand.Value, sym: operand.Symbol) operand.Value {
    if (sel v.memory) {
        var a: operand.Address = v.memory;
        a.disp   = 0;
        a.symbol = sym;
        ret operand.Value.memory{a};
    }
    ret operand.Value.symbol{sym};
}

# whether `v` names a symbol
fun holds_symbol(v: *operand.Value) bool {
    if (sel v.symbol) { ret true; }
    if (sel v.memory) { ret v.memory.symbol.id != operand.NO_SYMBOL; }
    ret false;
}

# where a field operand is relocated when it holds a symbol that states no fixup kind
# ---
# offset: the field's offset from the instruction's start
# kind:   the fixup kind the encoder gives the symbol there, as x86's pc-relative kind for a rip-relative address
rec Probed {
    offset: usize;
    kind:   operand.FixupKind;
}

# where the field operand `k` of `ins` is relocated when its symbol states fixup kind `stated`, NO_FIXUP for none,
# none when it holds no symbol there. a stated kind may move it, as x86's `@TLSCALL` marks the instruction's start
fun probe(d: *Disasm, ins: *inst.Inst, k: u32, stated: operand.FixupKind) opt[Probed] {
    val desc: *operand.Operand = ?ins.row.operands.at[k];
    if (operand.default_fixup(desc) == operand.NO_FIXUP) { ret opt[Probed].none{}; }
    var values: [row.MAX_OPERANDS]operand.Value;
    var i:      u32 = 0;
    for (i < ins.count) {
        values[i] = ins.values[i];
        i         = i + 1;
    }
    values[k] = symbolic(values[k], operand.Symbol{id: PROBE, addend: 0, fixup: stated});
    var tried: inst.Inst = inst.Inst{row: ins.row, values: ?values[0], count: ins.count, form: ins.form};
    vector.truncate[u8](?d.bytes, 0);
    vector.truncate[field.Fixup](?d.fixups, 0);
    val done: res[usize, field.Refusal] = walk.encode(d.s.codec, d.v, ?tried, ?d.bytes, ?d.fixups);
    if (sel done.err) { ret opt[Probed].none{}; }
    var hits: u32    = 0;
    var got:  Probed = Probed{offset: 0, kind: operand.NO_FIXUP};
    var f:    usize  = 0;
    for (f < d.fixups.len) {
        if (d.fixups.data[f].operand == k::u8) {
            hits = hits + 1;
            got  = Probed{offset: d.fixups.data[f].offset, kind: d.fixups.data[f].kind};
        }
        f = f + 1;
    }
    if (hits != 1) { ret opt[Probed].none{}; }
    ret opt[Probed].some{got};
}

# the most bytes and fixups of one instruction `implied_by` compares
val IMPLIED_BYTES:  usize = 32;
val IMPLIED_FIXUPS: usize = 8;

# whether `ins` encodes to `bytes` and `fixups`, which hold `n` and `m`
fun encodes_as(d: *Disasm, ins: *inst.Inst, bytes: *u8, n: usize, fixups: *field.Fixup, m: usize) bool {
    d.bytes.len  = 0;
    d.fixups.len = 0;
    val done: res[usize, field.Refusal] = walk.encode(d.s.codec, d.v, ins, ?d.bytes, ?d.fixups);
    if (sel done.err || d.bytes.len != n || d.fixups.len != m) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (d.bytes.data[i] != bytes[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < m) {
        val x: *field.Fixup = ?d.fixups.data[i];
        val y: *field.Fixup = ?fixups[i];
        if (x.kind != y.kind || x.operand != y.operand || x.offset != y.offset || x.symbol != y.symbol || x.addend != y.addend) { ret false; }
        i = i + 1;
    }
    ret true;
}

# each immediate of `st` the symbol of its operand `k` implies, set to zero where that encodes the same bytes and
# fixups, so the text leaves it to the symbol's specifier: a move wide's shift under a group, whose kind fixes hw
# (aaelf64, "Group relocations"), as `movn x0, #:tprel_g1:v` and not `movn x0, #:tprel_g1:v, lsl #16`
fun implied_by(d: *Disasm, st: *Step, k: u32) {
    d.bytes.len  = 0;
    d.fixups.len = 0;
    val done: res[usize, field.Refusal] = walk.encode(d.s.codec, d.v, ?st.ins, ?d.bytes, ?d.fixups);
    if (sel done.err || d.bytes.len > IMPLIED_BYTES || d.fixups.len > IMPLIED_FIXUPS) { ret; }
    var bytes:  [IMPLIED_BYTES]u8;
    var fixups: [IMPLIED_FIXUPS]field.Fixup;
    val n:      usize = d.bytes.len;
    val m:      usize = d.fixups.len;
    var i:      usize = 0;
    for (i < n) {
        bytes[i] = d.bytes.data[i];
        i        = i + 1;
    }
    i = 0;
    for (i < m) {
        fixups[i] = d.fixups.data[i];
        i         = i + 1;
    }
    var j: u32 = 0;
    for (j < st.ins.count) {
        val v: operand.Value = st.values.data[j];
        if (sel v.immediate) {
            if (j != k && v.immediate != 0) {
                st.values.data[j] = operand.Value.immediate{0};
                if (!encodes_as(d, ?st.ins, ?bytes[0], n, ?fixups[0], m)) { st.values.data[j] = v; }
            }
        }
        j = j + 1;
    }
}

# the handle `h` noted as one the statement names
fun note(d: *Disasm, h: u32) bool {
    var i: u32 = 0;
    for (i < d.names) {
        if (d.named[i] == h) { ret true; }
        i = i + 1;
    }
    if (d.names >= relax.MAX_STEPS) { ret false; }
    d.named[d.names] = h;
    d.names          = d.names + 1;
    ret true;
}

# the place relocation `r` names in section `section`, none when it names a place of another section or, unless
# `preempted`, a symbol other objects may preempt
fun own_place(d: *Disasm, r: *mink_object.Reloc, section: u32, preempted: bool) opt[u64] {
    if (!sel r.target.symbol) { ret opt[u64].none{}; }
    val sym: *mink_object.Symbol = symbol_of(d, r.target.symbol.index);
    if (!sel sym.def.placed)                                      { ret opt[u64].none{}; }
    if (!preempted && symbol.binds(sym.binding, symbol.EXTERNAL)) { ret opt[u64].none{}; }
    val p: mink_object.Place = sym.def.placed;
    if (p.section.index != section) { ret opt[u64].none{}; }
    val to: i64 = p.offset:~i64 + r.addend;
    if (to < 0) { ret opt[u64].none{}; }
    ret opt[u64].some{to:~u64};
}

# whether a marker the linker resizes an instruction by, a relocation naming nothing other than the set's realign
# marker, lies at an offset from `lo` up to `hi` of section `section`
fun resized(d: *Disasm, section: u32, lo: u64, hi: u64) bool {
    var want: Site  = Site{section: section, offset: lo, reloc: 0};
    var a:    usize = 0;
    var b:    usize = d.sites.len;
    for (a < b) {
        val mid: usize = a + (b - a) / 2;
        if (by_site(?d.sites.data[mid], ?want) < 0) { a = mid + 1; }
        or                                          { b = mid; }
    }
    for (a < d.sites.len && d.sites.data[a].section == section && d.sites.data[a].offset < hi) {
        val r: *mink_object.Reloc = reloc_of(d, ?d.sites.data[a]);
        if (sel r.target.none && !binds(d, r.kind, d.s.realign)) { ret true; }
        a = a + 1;
    }
    ret false;
}

# refused when the reassembly would resolve relocation `r` at `site`, which the object keeps: the builder folds its kind
# held as value `v` of operand `desc`, nil for a datum, it names a place of its own section other objects cannot preempt,
# and no instruction the linker may resize lies between that place and the statement at `at`, as the builder measures
# it. a text that kept it would need the relocation stated by itself, which the dialect has no directive for
fun unfolded(d: *Disasm, site: *Site, r: *mink_object.Reloc, desc: *operand.Operand, v: *operand.Value, at: u64) err[Refusal] {
    if (!build.folds(desc, v, r.kind)) { ret err[Refusal].ok{}; }
    val to: opt[u64] = own_place(d, r, site.section, false);
    if (sel to.none) { ret err[Refusal].ok{}; }
    var lo: u64 = at;
    var hi: u64 = at + 1;
    if (to.some < lo)                     { lo = to.some; }
    if (to.some > hi)                     { hi = to.some; }
    if (resized(d, site.section, lo, hi)) { ret err[Refusal].ok{}; }
    ret refusal(FOLDED, site.section, site.offset);
}

# the section relocation `r` names a place of, none when it names no placed symbol
fun section_named(d: *Disasm, r: *mink_object.Reloc) opt[u32] {
    if (!sel r.target.symbol) { ret opt[u32].none{}; }
    val sym: *mink_object.Symbol = symbol_of(d, r.target.symbol.index);
    if (!sel sym.def.placed) { ret opt[u32].none{}; }
    ret opt[u32].some{sym.def.placed.section.index};
}

# refused when the reassembly would resolve the difference relocations `add` and `sub` at `site`, which the object
# keeps: both name places of one section, and no instruction the linker may resize lies between them, as the builder
# folds `a - b`, but for a symbol other objects may preempt less the datum's own place
fun pair_unfolded(d: *Disasm, site: *Site, add: *mink_object.Reloc, sub: *mink_object.Reloc) err[Refusal] {
    val home: opt[u32] = section_named(d, add);
    if (sel home.none) { ret err[Refusal].ok{}; }
    val p: opt[u64] = own_place(d, add, home.some, true);
    val q: opt[u64] = own_place(d, sub, home.some, true);
    if (sel p.none) { ret err[Refusal].ok{}; }
    if (sel q.none) { ret err[Refusal].ok{}; }
    val here:  bool     = home.some == site.section && q.some == site.offset;
    val fixed: opt[u64] = own_place(d, add, home.some, false);
    if (here && sel fixed.none) { ret err[Refusal].ok{}; }
    var lo: u64 = p.some;
    var hi: u64 = q.some;
    if (hi < lo) {
        lo = q.some;
        hi = p.some;
    }
    if (resized(d, home.some, lo, hi)) { ret err[Refusal].ok{}; }
    ret refusal(FOLDED, site.section, site.offset);
}

# what a statement may leave to `.reloc`: nothing, the relocations no operand of it takes, or all of them
val NONE_STATED:    u8 = 0;
val UNTAKEN_STATED: u8 = 1;
val ALL_STATED:     u8 = 2;

# each relocation of the decoded step `st` among `first` to `end` given to the operand whose field it patches, those
# the statement may leave to `.reloc` left
fun take(d: *Disasm, st: *Step, first: usize, end: usize) res[bool, Refusal] {
    if (d.stating == ALL_STATED) { ret res[bool, Refusal].ok{true}; }
    var i: usize = first;
    for (i < end) {
        val site: *Site = ?d.sites.data[i];
        i = i + 1;
        if (site.offset < st.at || site.offset >= st.at + st.len::u64) { cnt; }
        val r:     *mink_object.Reloc       = reloc_of(d, site);
        val aimed: res[opt[Aimed], Refusal] = aim(d, r, site);
        if (sel aimed.err)     { ret res[bool, Refusal].err{aimed.err}; }
        if (sel aimed.ok.none) { cnt; }
        if (sel r.minus.some)  { ret res[bool, Refusal].ok{false}; }
        val off:   usize = (site.offset - st.at)::usize;
        var given: bool  = false;
        var k:     u32   = 0;
        for (k < st.ins.count && !given) {
            # a marker operand takes the relocation of its kind at the instruction's start, as a marked row's does
            val desc: *operand.Operand = ?st.ins.row.operands.at[k];
            if (sel desc.shape.marker) {
                if (off == 0 && sel st.values.data[k].none && binds(d, r.kind, desc.shape.marker)) {
                    if (!note(d, aimed.ok.some.handle)) { ret res[bool, Refusal].ok{false}; }
                    st.values.data[k] = operand.Value.symbol{operand.Symbol{id: aimed.ok.some.handle, addend: aimed.ok.some.addend, fixup: desc.shape.marker}};
                    given             = true;
                }
                k = k + 1;
                cnt;
            }
            val at:     opt[Probed]       = probe(d, ?st.ins, k, operand.NO_FIXUP);
            var placed: Probed            = Probed{offset: 0, kind: operand.NO_FIXUP};
            var hit:    bool              = false;
            var f:      operand.FixupKind = fixup_for(d, r.kind, operand.default_fixup(?st.ins.row.operands.at[k]));
            if (sel at.some) {
                placed = at.some;
                hit    = placed.offset == off;
            }
            # a kind that places its relocation elsewhere than the field is found where it places it, and a kind that fixes
            # bits the default kind refuses, as a move wide's group under its hw, is found by its own kind alone
            if (!hit && f != operand.NO_FIXUP && operand.default_fixup(?st.ins.row.operands.at[k]) != operand.NO_FIXUP) {
                val moved: opt[Probed] = probe(d, ?st.ins, k, f);
                if (sel moved.some && moved.some.offset == off) {
                    placed = Probed{offset: off, kind: operand.NO_FIXUP};
                    hit    = true;
                }
            }
            if (hit) {
                if (f == operand.NO_FIXUP || holds_symbol(?st.values.data[k])) {
                    # the operand takes no relocation of the kind, which a statement that may leaves to `.reloc`
                    if (d.stating == NONE_STATED) { ret res[bool, Refusal].ok{false}; }
                    k = k + 1;
                    cnt;
                }
                if (!note(d, aimed.ok.some.handle)) { ret res[bool, Refusal].ok{false}; }
                # the text states the symbol's addend, which the reassembly biases as the builder does
                val addend: i64 = aimed.ok.some.addend - build.bias(st.ins.row, st.len, k::usize, off, r.kind);
                # a symbol of the kind the encoder gives it states none, as a rip-relative address its pc-relative kind
                f = stated_as(d, r.kind, operand.default_fixup(?st.ins.row.operands.at[k]), placed.kind, f, addend);
                var named: operand.Value = symbolic(st.values.data[k], operand.Symbol{id: aimed.ok.some.handle, addend: addend, fixup: f});
                val kept_: err[Refusal]  = unfolded(d, site, r, ?st.ins.row.operands.at[k], ?named, st.at);
                # a relocation the reassembly would fold is kept only by a `.reloc`, the operand left its number
                if (sel kept_.err) {
                    if (d.stating == NONE_STATED) { ret res[bool, Refusal].ok{false}; }
                }
                or {
                    st.values.data[k] = named;
                    implied_by(d, st, k);
                }
                given = true;
            }
            k = k + 1;
        }
        if (!given && d.stating == NONE_STATED) { ret res[bool, Refusal].ok{false}; }
    }
    ret res[bool, Refusal].ok{true};
}

# the distance from `at` of section `section` to what handle `handle` plus `addend` names, as the assembler measures
# it reading the text back: none when it names a symbol other objects may preempt or a place in another section
fun reach_of(d: *Disasm, section: u32, at: u64, handle: u32, addend: i64) opt[i64] {
    var place: u64 = 0;
    if (handle <= d.count) {
        val sym: *mink_object.Symbol = symbol_of(d, handle - 1);
        if (!sel sym.def.placed)                        { ret opt[i64].none{}; }
        if (symbol.binds(sym.binding, symbol.EXTERNAL)) { ret opt[i64].none{}; }
        val p: mink_object.Place = sym.def.placed;
        if (p.section.index != section) { ret opt[i64].none{}; }
        place = p.offset;
    }
    or {
        val anchor: *Label = ?d.anchors.data[(handle - d.count - 1)::usize];
        if (anchor.section != section) { ret opt[i64].none{}; }
        place = anchor.offset;
    }
    ret opt[i64].some{place:~i64 + addend - at:~i64};
}

# the form instruction `chosen` at `at` of section `section` takes as the builder lays it out, into `out`: grown
# through the set's relaxations while its relaxed operand's target, measured in the object, is out of reach or only
# the linker knows it
fun laid_out(d: *Disasm, section: u32, at: u64, chosen: *relax.Emitted, out: *relax.Expansion) bool {
    var ins:   inst.Inst              = inst.Inst{row: chosen.row, values: ?chosen.values[0], count: chosen.row.operands.len, form: chosen.form};
    var reach: opt[i64]               = opt[i64].none{};
    val rx:    opt[*relax.Relaxation] = relax.find(d.s.relax, chosen.row);
    if (sel rx.some) {
        val v: *operand.Value = ?chosen.values[rx.some.operand];
        if (sel v.symbol) { reach = reach_of(d, section, at, v.symbol.id, v.symbol.addend); }
    }
    var shortening: cmp.Shortening = cmp.Shortening{codec: d.s.codec, all: d.s.compress, ctx: d.v};
    var levels:     u32            = 0;
    for (levels <= d.s.relax.len) {
        var target: u32      = 0;
        val why:    opt[str] = relax.grown(d.s.codec, d.v, d.s.relax, ?ins, levels, opt[i64].none{}, cmp.shorten(?shortening), out, ?target, ?d.bytes, ?d.fixups);
        if (sel why.some) { ret false; }
        out.steps[0].marker = chosen.marker;
        val reached: opt[bool] = relax.reaches(d.s.codec, d.v, d.s.relax, out, target, reach, ?d.bytes, ?d.fixups);
        if (sel reached.none) { ret false; }
        if (reached.some)     { ret true; }
        levels = levels + 1;
    }
    ret false;
}

# step `ins` at `offset` of section `section` encoded into the disassembler's bytes and fixups as the builder writes it:
# a value naming by its distance from the program counter a place of the section the builder folds it to
# (`build.folds`), with no instruction the linker may resize between, encoded as that distance from the step's anchor,
# answering its length, none when it does not encode
fun encoded(d: *Disasm, section: u32, offset: u64, ins: *inst.Inst) opt[usize] {
    vector.truncate[u8](?d.bytes, 0);
    vector.truncate[field.Fixup](?d.fixups, 0);
    val done: res[usize, field.Refusal] = walk.encode(d.s.codec, d.v, ins, ?d.bytes, ?d.fixups);
    if (sel done.err) { ret opt[usize].none{}; }
    var values: [row.MAX_OPERANDS]operand.Value;
    var any:    bool = false;
    var k:      u32  = 0;
    for (k < ins.count) {
        values[k] = ins.values[k];
        val desc: *operand.Operand    = ?ins.row.operands.at[k];
        val sym:  opt[operand.Symbol] = operand.pc_symbol(desc, ?values[k]);
        if (sel sym.some) {
            var fx: operand.FixupKind = operand.value_fixup(desc, ?values[k]);
            if (sym.some.fixup != operand.NO_FIXUP) { fx = sym.some.fixup; }
            val reach: opt[i64] = reach_of(d, section, offset, sym.some.id, sym.some.addend);
            var by:    i64      = 0;
            var near:  bool     = false;
            if (sel reach.some) {
                by   = reach.some;
                near = true;
            }
            if (near && build.folds(desc, ?values[k], written_kind(d, fx))) {
                val to: i64 = offset:~i64 + by;
                var lo: u64 = offset;
                var hi: u64 = offset + 1;
                if (to >= 0 && to:~u64 < lo) { lo = to:~u64; }
                if (to >= 0 && to:~u64 > hi) { hi = to:~u64; }
                if (!resized(d, section, lo, hi)) {
                    var dist: i64 = by;
                    if (operand.anchor_of(desc) == operand.END) { dist = dist - done.ok::i64; }
                    values[k] = operand.resolved(?values[k], dist);
                    any       = true;
                }
            }
        }
        k = k + 1;
    }
    if (!any) { ret opt[usize].some{done.ok}; }
    var again: inst.Inst = inst.Inst{row: ins.row, values: ?values[0], count: ins.count, form: ins.form};
    vector.truncate[u8](?d.bytes, 0);
    vector.truncate[field.Fixup](?d.fixups, 0);
    val redone: res[usize, field.Refusal] = walk.encode(d.s.codec, d.v, ?again, ?d.bytes, ?d.fixups);
    if (sel redone.err) { ret opt[usize].none{}; }
    ret opt[usize].some{redone.ok};
}

# whether the expansion `ex` encoded at `at` of section `section` as the builder writes it is the bytes of `data` up to
# `stop` and makes exactly the relocations among `first` to `end`
fun matches(d: *Disasm, section: u32, ex: *relax.Expansion, data: *u8, len: usize, at: u64, stop: u64, first: usize, end: usize) bool {
    var used:  [relax.MAX_STEPS * row.MAX_OPERANDS + relax.MAX_STEPS]bool;
    var total: usize = end - first;
    if (total > relax.MAX_STEPS::usize * (row.MAX_OPERANDS::usize + 1)) { ret false; }
    var u: usize = 0;
    for (u < total) {
        used[u] = false;
        u       = u + 1;
    }
    var fixed: bool = false;
    var i:     u32  = 0;
    for (i < ex.count && ex.count > 1) {
        var k: u32 = 0;
        for (k < ex.steps[i].row.operands.len) {
            fixed = fixed || holds_symbol(?ex.steps[i].values[k]);
            k     = k + 1;
        }
        i = i + 1;
    }
    var offset: u64 = at;
    var laid:   relax.Expansion;
    var l:      u32 = 0;
    i = 0;
    for (i < ex.count) {
        var chosen: relax.Emitted = ex.steps[i];
        var given:  inst.Inst     = inst.Inst{row: chosen.row, values: ?chosen.values[0], count: chosen.row.operands.len, form: chosen.form};
        var packed: relax.Emitted;
        if (!fixed && cmp.compress(d.s.codec, d.s.compress, d.s.relax, d.v, ?given, ?packed)) {
            packed.marker = chosen.marker;
            chosen        = packed;
        }
        # a sequence holding a symbol keeps the form its relocations fix, and anything else is laid out as the builder lays it
        laid.count    = 1;
        laid.steps[0] = chosen;
        if (!fixed && !laid_out(d, section, offset, ?chosen, ?laid)) { ret false; }
        i = i + 1;
        l = 0;
        for (l < laid.count) {
            val step: *relax.Emitted = ?laid.steps[l];
            l = l + 1;
            var ins:  inst.Inst  = inst.Inst{row: step.row, values: ?step.values[0], count: step.row.operands.len, form: step.form};
            val done: opt[usize] = encoded(d, section, offset, ?ins);
            if (sel done.none)                      { ret false; }
            if (offset + done.some::u64 > len::u64) { ret false; }
            var b: usize = 0;
            for (b < done.some) {
                if (d.bytes.data[b] != data[offset::usize + b]) { ret false; }
                b = b + 1;
            }
            var marker: operand.FixupKind = step.marker;
            var f:      usize             = 0;
            for (f < d.fixups.len) {
                val fx: *field.Fixup          = ?d.fixups.data[f];
                val sp: opt[*core_fixup.Span] = core_fixup.span_of(d.s.spans, fx.kind);
                if (sel sp.some) {
                    if (mode.holds(?d.modes, sp.some.when)) { marker = sp.some.marker; }
                }
                var hit: bool  = false;
                var j:   usize = 0;
                for (j < total && !hit) {
                    if (!used[j]) {
                        val site: *Site              = ?d.sites.data[first + j];
                        val r:    *mink_object.Reloc = reloc_of(d, site);
                        if (site.offset == offset + fx.offset::u64 && r.kind == kind_of(d, written_as(d, fx.kind, fx.addend)) && sel r.minus.none) {
                            val a: res[opt[Aimed], Refusal] = aim(d, r, site);
                            if (sel a.ok) {
                                val o: opt[Aimed] = a.ok;
                                if (sel o.some) {
                                    if (o.some.handle == fx.symbol && o.some.addend == fx.addend + build.bias(step.row, done.some, fx.operand::usize, fx.offset, r.kind)) {
                                        used[j] = true;
                                        hit     = true;
                                    }
                                }
                            }
                        }
                    }
                    j = j + 1;
                }
                if (!hit) { ret false; }
                f = f + 1;
            }
            if (marker != operand.NO_FIXUP) {
                var hit: bool  = false;
                var j:   usize = 0;
                for (j < total && !hit) {
                    if (!used[j]) {
                        val site: *Site              = ?d.sites.data[first + j];
                        val r:    *mink_object.Reloc = reloc_of(d, site);
                        if (site.offset == offset && sel r.target.none && r.kind == kind_of(d, marker)) {
                            used[j] = true;
                            hit     = true;
                        }
                    }
                    j = j + 1;
                }
                if (!hit) { ret false; }
            }
            offset = offset + done.some::u64;
        }
    }
    # what no step made is left to `.reloc` when the statement may leave it
    vector.truncate[usize](?d.stated, 0);
    u = 0;
    for (u < total) {
        if (!used[u]) {
            if (d.stating == NONE_STATED || !held(vector.push[usize](?d.stated, first + u))) { ret false; }
        }
        u = u + 1;
    }
    ret offset == stop;
}

# relocation `j` of the sites stated by itself, `.reloc offset, name[, target]`, its kind named by the object's format's
# row for it, refused when it subtracts a symbol of its own or the format names no row of its kind
fun state_reloc(d: *Disasm, j: usize) err[Refusal] {
    val site: *Site              = ?d.sites.data[j];
    val r:    *mink_object.Reloc = reloc_of(d, site);
    if (sel r.minus.some) { ret refusal(DIFFERENCE, site.section, site.offset); }
    if (sel d.relocs.err) { ret refusal(UNROWED, site.section, site.offset); }
    val row_: res[*mink_row.Row, fail.Fail] = registry.relocation_by_kind(?d.relocs.ok, r.kind);
    if (sel row_.err) { ret refusal(UNROWED, site.section, site.offset); }
    val aimed: res[opt[Aimed], Refusal] = aim(d, r, site);
    if (sel aimed.err) { ret err[Refusal].err{aimed.err}; }
    put(d, "\t.reloc ");
    put_unsigned(d, site.offset);
    put(d, ", ");
    put(d, row_.ok.name);
    if (sel aimed.ok.some) {
        put(d, ", ");
        put_aimed(d, aimed.ok.some);
    }
    or (r.addend != 0) {
        put(d, ", ");
        put_signed(d, r.addend);
    }
    put_char(d, '\n');
    ret err[Refusal].ok{};
}

# the relocations the statement that read back leaves to `.reloc` written after it
fun put_stated(d: *Disasm) err[Refusal] {
    var i: usize = 0;
    for (i < d.stated.len) {
        val done: err[Refusal] = state_reloc(d, d.stated.data[i]);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    vector.truncate[usize](?d.stated, 0);
    ret err[Refusal].ok{};
}

# the relocation at the cursor, which no datum takes for `why`, stated by itself when the object's format names its
# kind, taking no bytes, else refused for `why`
fun stated_datum(d: *Disasm, why: Refusal) res[u64, Refusal] {
    if (sel d.relocs.err) { ret res[u64, Refusal].err{why}; }
    val done: err[Refusal] = state_reloc(d, d.ri);
    if (sel done.err) { ret res[u64, Refusal].err{done.err}; }
    d.ri = d.ri + 1;
    ret res[u64, Refusal].ok{0};
}

# the text from `start` to the output's end parsed as the assembler parses a statement, into `ex`, its stores grown
# and the parse retried while they hold less than the statement takes, a store that failed to grow noted
fun reparse(d: *Disasm, start: usize, ex: *relax.Expansion) bool {
    for {
        var rd: core_syntax.Reader = core_syntax.Reader{
            text:    d.out.data,
            start:   start,
            at:      start,
            end:     d.out.len,
            origin:  diagnostic.START,
            codec:   d.s.codec,
            ctx:     d.v,
            syntax:  d.syntax,
            modes:   ?d.modes,
            symbols: ?d.symbols,
            context: nil,
            row:     nil,
            format:  d.dialect.format,
        };
        core_syntax.over(?rd, ?d.stores);
        val got:   err[diagnostic.Diagnostic] = parse.statement(?rd, ex);
        val again: res[bool, A.Error]         = core_syntax.regrown(?rd, ?d.stores);
        if (sel again.err) {
            d.full = true;
            ret false;
        }
        if (!again.ok) { ret sel got.ok; }
    }
}

# step `i` decoded at `at` of the `len` bytes at `data`, ending by `limit`, a store that failed to grow noted
fun decode_step(d: *Disasm, i: u32, data: *u8, len: usize, at: u64, limit: u64) bool {
    val st:  *Step                            = ?d.steps[i];
    val got: res[walk.Decoded, field.Refusal] = walk.decode_grown(d.s.codec, d.v, data, len, at::usize, ?st.values, ?d.stores.refused);
    if (sel got.err) {
        if (sel got.err.cause.memory) { d.full = true; }
        ret false;
    }
    if (at + got.ok.len::u64 > limit) { ret false; }
    st.at  = at;
    st.len = got.ok.len;
    st.ins = inst.Inst{row: got.ok.inst.row, values: st.values.data, count: got.ok.inst.count, form: got.ok.inst.form};
    ret true;
}

# the end of the relocations from the cursor that lie before `end`
fun sites_before(d: *Disasm, section: u32, end: u64) usize {
    var j: usize = d.ri;
    for (j < d.sites.len && d.sites.data[j].section == section && d.sites.data[j].offset < end) {
        j = j + 1;
    }
    ret j;
}

# the span the relocations among `first` to `end` at `at` state, none when none of them covers more than its own
fun span_at(d: *Disasm, at: u64, first: usize, end: usize) opt[*core_fixup.Span] {
    var j: usize = first;
    for (j < end) {
        val site: *Site              = ?d.sites.data[j];
        val r:    *mink_object.Reloc = reloc_of(d, site);
        j = j + 1;
        if (site.offset != at || sel r.target.none) { cnt; }
        var i: usize = first_bound(d, r.kind);
        for (i < d.bound.len && d.bound.data[i].kind == r.kind) {
            val sp: opt[*core_fixup.Span] = core_fixup.span_of(d.s.spans, d.bound.data[i].fixup);
            if (sel sp.some) {
                if (sp.some.count > 1) { ret sp; }
            }
            i = i + 1;
        }
    }
    ret opt[*core_fixup.Span].none{};
}

# the steps of a span's statement given the symbol of its relocation where sequence `q` places it
fun spanned(d: *Disasm, q: *core_syntax.Sequence, sp: *core_fixup.Span, aimed: Aimed, count: u32, out: *inst.Inst, values: *operand.Value) bool {
    if (q.steps.len != count) { ret false; }
    var i: u32 = 0;
    for (i < count) {
        val st:   *Step             = ?d.steps[i];
        val step: *core_syntax.Step = ?q.steps.at[i];
        if (step.row != st.ins.row) { ret false; }
        val held_: *operand.Value = ?values[i * row.MAX_OPERANDS::u32];
        var k:     u32            = 0;
        for (k < st.ins.count) {
            held_[k] = st.values.data[k];
            k        = k + 1;
        }
        k = 0;
        for (k < step.parts.len && k < st.ins.count) {
            val part: core_syntax.Part = step.parts.at[k];
            if (sel part.symbol && part.symbol.fixup == sp.fixup) {
                held_[k] = operand.Value.symbol{operand.Symbol{id: aimed.handle, addend: aimed.addend, fixup: sp.fixup}};
            }
            k = k + 1;
        }
        out[i] = inst.Inst{row: st.ins.row, values: held_, count: st.ins.count, form: st.ins.form};
        i      = i + 1;
    }
    ret true;
}

# the statement at `at` printed, answering how many bytes it takes, 0 when none reads back to them
fun statement(d: *Disasm, section: u32, data: *u8, len: usize, at: u64, limit: u64) res[u64, Refusal] {
    if (!decode_step(d, 0, data, len, at, limit)) { ret res[u64, Refusal].ok{0}; }
    d.names = 0;
    var count: u32                   = 1;
    var end:   usize                 = sites_before(d, section, at + d.steps[0].len::u64);
    val sp:    opt[*core_fixup.Span] = span_at(d, at, d.ri, end);
    if (sel sp.some) {
        if (sp.some.count > relax.MAX_STEPS) { ret res[u64, Refusal].ok{0}; }
        for (count < sp.some.count) {
            val prior: *Step = ?d.steps[count - 1];
            if (!decode_step(d, count, data, len, prior.at + prior.len::u64, limit)) { ret res[u64, Refusal].ok{0}; }
            count = count + 1;
        }
    }
    val last: *Step = ?d.steps[count - 1];
    val stop: u64   = last.at + last.len::u64;
    end = sites_before(d, section, stop);
    val start: usize = d.out.len;
    put_char(d, '\t');
    val text:    usize              = d.out.len;
    var w:       core_syntax.Writer = writer(d);
    var printed: bool               = false;
    if (sel sp.some) {
        var aimed: opt[Aimed] = opt[Aimed].none{};
        var j:     usize      = d.ri;
        for (j < end && sel aimed.none) {
            val site: *Site              = ?d.sites.data[j];
            val r:    *mink_object.Reloc = reloc_of(d, site);
            if (site.offset == at && binds(d, r.kind, sp.some.fixup)) {
                val a: res[opt[Aimed], Refusal] = aim(d, r, site);
                if (sel a.err) { ret res[u64, Refusal].err{a.err}; }
                aimed = a.ok;
            }
            j = j + 1;
        }
        if (sel aimed.some) {
            var steps:  [relax.MAX_STEPS]inst.Inst;
            var values: [relax.MAX_STEPS * row.MAX_OPERANDS]operand.Value;
            var i:      u32 = seq.first_of(d.syntax, d.s.codec.rows, d.steps[0].ins.row);
            for (i < d.syntax.sequences.len && !printed) {
                val q: *core_syntax.Sequence = ?d.syntax.sequences.at[i];
                i = i + 1;
                if (q.steps.at[0].row != d.steps[0].ins.row)                                                          { brk; }
                if (!note(d, aimed.some.handle) || !spanned(d, q, sp.some, aimed.some, count, ?steps[0], ?values[0])) { cnt; }
                val got: res[bool, field.Refusal] = print.sequence(?w, ?steps[0], count, operand.NO_SYMBOL);
                printed = sel got.ok && got.ok;
            }
        }
    }
    var read: bool = false;
    if (sel sp.some) {
        var ex: relax.Expansion;
        read = printed && !d.full && reparse(d, text, ?ex) && matches(d, section, ?ex, data, len, at, stop, d.ri, end);
    }
    or {
        val one_: res[bool, Refusal] = single(d, section, data, len, at, stop, end, text, ?w);
        if (sel one_.err) { ret res[u64, Refusal].err{one_.err}; }
        read = one_.ok;
    }
    if (!read) {
        vector.truncate[u8](d.out, start);
        ret res[u64, Refusal].ok{0};
    }
    val seen: err[Refusal] = observe(d, section, count);
    if (sel seen.err) {
        vector.truncate[u8](d.out, start);
        ret res[u64, Refusal].err{seen.err};
    }
    put_char(d, '\n');
    val left: err[Refusal] = put_stated(d);
    if (sel left.err) {
        vector.truncate[u8](d.out, start);
        ret res[u64, Refusal].err{left.err};
    }
    d.ri   = end;
    d.read = count;
    ret res[u64, Refusal].ok{stop - at};
}

# what the `count` steps of the statement read back define added to the set's typed stream, in order, refused at the
# step that breaks what the stream holds. a set with a stream states no sequences, so a refusal after the first step
# leaves nothing behind
fun observe(d: *Disasm, section: u32, count: u32) err[Refusal] {
    val h: *stream.Hooks = d.s.codec.stream;
    if (h == nil) { ret err[Refusal].ok{}; }
    var i: u32 = 0;
    for (i < count) {
        val seen: err[field.Refusal] = h.observe(d.v.stream, ?d.steps[i].ins);
        if (sel seen.err) { ret refusal(DEFINED, section, d.steps[i].at); }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the most marked rows a decoded instruction is tried as
val MARKED_TRIED: u32 = 4;

# the rows the instruction decoded at `at` is tried as, into `rows`: its own, then each marked row whose marker the
# relocations among the cursor's to `end` at `at` are of, which takes its operands in order around its marker, found
# through the set's marked rows and held to the bytes by encoding, as `add.tprel_add` for an add a TPREL_ADD marks
fun rows_of(d: *Disasm, at: u64, end: usize, rows: **row.Row) u32 {
    val decoded: *row.Row = d.steps[0].ins.row;
    rows[0] = decoded;
    var n: u32   = 1;
    var j: usize = d.ri;
    for (j < end) {
        val site: *Site              = ?d.sites.data[j];
        val r:    *mink_object.Reloc = reloc_of(d, site);
        j = j + 1;
        if (site.offset != at || sel r.target.none) { cnt; }
        var m: usize = 0;
        for (m < d.marked.len && n < MARKED_TRIED + 1) {
            val mr: *row.Row = d.marked.data[m];
            m = m + 1;
            var takes: bool = false;
            var plain: u32  = 0;
            var k:     u32  = 0;
            for (k < mr.operands.len) {
                val desc: *operand.Operand = ?mr.operands.at[k];
                if (sel desc.shape.marker) { takes = takes || binds(d, r.kind, desc.shape.marker); }
                or                         { plain = plain + 1; }
                k = k + 1;
            }
            if (takes && plain == decoded.operands.len) {
                rows[n] = mr;
                n       = n + 1;
            }
        }
    }
    ret n;
}

# the step at the cursor made an instruction of row `r` from the operand values `held` that `base` decoded, its markers
# none and its other operands taking the decoded values in order. the step shares its store with `base`, whose list
# members stay as decoded
fun as_row(d: *Disasm, base: *Step, held: *operand.Value, r: *row.Row) {
    d.steps[0] = @base;
    val values: *operand.Value = d.steps[0].values.data;
    var k:      u32            = 0;
    if (r == base.ins.row) {
        for (k < base.ins.count) {
            values[k] = held[k];
            k         = k + 1;
        }
        ret;
    }
    var p: u32 = 0;
    for (k < r.operands.len) {
        if (sel r.operands.at[k].shape.marker) { values[k] = operand.Value.none{}; }
        or {
            values[k] = held[p];
            p         = p + 1;
        }
        k = k + 1;
    }
    d.steps[0].ins.row   = r;
    d.steps[0].ins.count = r.operands.len;
}

# each resolved target of a relative operand of the step at the cursor in `section` that a label no other object may
# preempt is at, given as that label, answering whether any was
fun labelled(d: *Disasm, section: u32) bool {
    val st:  *Step = ?d.steps[0];
    var any: bool  = false;
    var k:   u32   = 0;
    for (k < st.ins.count) {
        val desc: *operand.Operand = ?st.ins.row.operands.at[k];
        val v:    operand.Value    = st.values.data[k];
        var to:   opt[u64]         = opt[u64].none{};
        if (sel desc.shape.relative) {
            if (sel v.relative) { to = target_of(st.at, st.len, desc, v.relative); }
        }
        if (sel to.some) {
            val got: opt[u32] = local_label_at(d, section, to.some);
            if (sel got.some) {
                if (note(d, got.some)) {
                    st.values.data[k] = operand.Value.symbol{operand.Symbol{id: got.some, addend: 0, fixup: operand.NO_FIXUP}};
                    any               = true;
                }
            }
        }
        k = k + 1;
    }
    ret any;
}

# the first label at `offset` of section `section` that names a place no other object may preempt, an object's local
# symbol or an anchor, a binary search of the labels in place order
fun local_label_at(d: *Disasm, section: u32, offset: u64) opt[u32] {
    var want: Label = Label{section: section, offset: offset, handle: 0};
    var lo:   usize = 0;
    var hi:   usize = d.labels.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (by_place(?d.labels.data[mid], ?want) < 0) { lo = mid + 1; }
        or                                            { hi = mid; }
    }
    for (lo < d.labels.len && d.labels.data[lo].section == section && d.labels.data[lo].offset == offset) {
        val h: u32 = d.labels.data[lo].handle;
        if (h > d.count)                                                 { ret opt[u32].some{h}; }
        if (!symbol.binds(symbol_of(d, h - 1).binding, symbol.EXTERNAL)) { ret opt[u32].some{h}; }
        lo = lo + 1;
    }
    ret opt[u32].none{};
}

# the place a relative operand `desc` of an instruction of `len` bytes at `at` reaches by `offset`, from its start or
# its end as the operand measures it, none before the section's start
fun target_of(at: u64, len: usize, desc: *operand.Operand, offset: i64) opt[u64] {
    var from: i64 = at:~i64;
    if (operand.anchor_of(desc) == operand.END) { from = from + len::i64; }
    val to: i64 = from + offset;
    if (to < 0) { ret opt[u64].none{}; }
    ret opt[u64].some{to:~u64};
}

# the instruction at the cursor, decoded at `at` up to `stop`, written alone from `text` by the first spelling that
# reads back to its bytes and the relocations from the cursor to `end`: as each row it is tried as, its resolved targets
# as the labels at them before as numbers, and under ALIASES a compressed instruction by the instruction it is
# shortened from before as itself, which then reads back only by compressing to it again, and last in its exact form
# where a marker spells one. answering whether one does, with the output from `text` taken back when none does
fun single(d: *Disasm, section: u32, data: *u8, len: usize, at: u64, stop: u64, end: usize, text: usize, w: *core_syntax.Writer) res[bool, Refusal] {
    var base: Step = d.steps[0];
    var held: [row.MAX_OPERANDS]operand.Value;
    var h:    u32  = 0;
    for (h < base.ins.count) {
        held[h] = base.values.data[h];
        h       = h + 1;
    }
    var rows: [MARKED_TRIED + 1]*row.Row;
    val n:    u32 = rows_of(d, at, end, ?rows[0]);
    var r:    u32 = 0;
    for (r < n) {
        var labels: u32 = 0;
        for (labels < 2) {
            as_row(d, ?base, ?held[0], rows[r]);
            d.names = 0;
            val tried: u32 = labels;
            labels = labels + 1;
            if (tried == 0 && !labelled(d, section)) { cnt; }
            val given: res[bool, Refusal] = take(d, ?d.steps[0], d.ri, end);
            if (sel given.err) { ret given; }
            if (!given.ok)     { cnt; }
            var spelling: u32 = 0;
            for (spelling < 3) {
                val way: u32 = spelling;
                spelling = spelling + 1;
                vector.truncate[u8](d.out, text);
                var printed: bool = false;
                if (way == 0 && !d.forms) {
                    var wide: relax.Emitted;
                    if (cmp.expand(d.s.codec, d.s.compress, ?d.expansions, d.s.relax, d.v, ?d.steps[0].ins, ?wide)) {
                        var ins: inst.Inst          = inst.Inst{row: wide.row, values: ?wide.values[0], count: wide.row.operands.len, form: wide.form};
                        val got: err[field.Refusal] = print.instruction(w, ?ins);
                        printed = sel got.ok;
                    }
                }
                if (way == 1) { printed = alone(d, w); }
                if (way == 2 && exact_marked(d) && !core_form.exact(d.steps[0].ins.form)) {
                    d.steps[0].ins.form.bits = d.steps[0].ins.form.bits | core_form.EXACT;
                    printed                  = alone(d, w);
                }
                var ex: relax.Expansion;
                if (printed && !d.full && reparse(d, text, ?ex) && matches(d, section, ?ex, data, len, at, stop, d.ri, end)) { ret res[bool, Refusal].ok{true}; }
            }
        }
        r = r + 1;
    }
    vector.truncate[u8](d.out, text);
    ret res[bool, Refusal].ok{false};
}

# the instruction decoded at the cursor printed alone, by its row's own form when the disassembler spells forms
fun alone(d: *Disasm, w: *core_syntax.Writer) bool {
    var got: err[field.Refusal] = err[field.Refusal].ok{};
    if (d.forms) { got = print.form(w, ?d.steps[0].ins); }
    or           { got = print.instruction(w, ?d.steps[0].ins); }
    ret sel got.ok;
}

# whether a marker of the codec spells the core's exact form
fun exact_marked(d: *Disasm) bool {
    val forms: *core_form.FormFields = ?d.s.codec.forms;
    var i:     u32                   = 0;
    for (i < forms.len) {
        if (forms.at[i].mask == core_form.EXACT && forms.at[i].marker != nil) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the directive that writes data of `width` bytes, none when the dialect has none
fun width_directive(d: *Disasm, width: u8) opt[str] {
    var i: u32 = 0;
    for (i < d.s.source.widths.len) {
        if (d.s.source.widths.at[i].width == width) { ret opt[str].some{d.s.source.widths.at[i].name}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

# the expression naming `aimed`
fun put_aimed(d: *Disasm, aimed: Aimed) {
    put_symbol(d, named(d::ptr, aimed.handle));
    if (aimed.addend > 0)  { put_char(d, '+'); }
    if (aimed.addend != 0) { put_signed(d, aimed.addend); }
}

# the length of the leb128 at `at` of `data`, its last byte the first with no continuation bit, none when none ends it
# by `limit` within a leb128's longest
fun leb_length(data: *u8, at: u64, limit: u64) opt[u64] {
    var n: u64 = 0;
    for (at + n < limit && n < leb128.MAX_BYTES::u64) {
        val b: u8 = data[(at + n)::usize];
        n = n + 1;
        if ((b & 0x80) == 0) { ret opt[u64].some{n}; }
    }
    ret opt[u64].none{};
}

# the relocated datum at the cursor, at `at` of the `len` bytes at `data`, written by `limit`, answering its width. a
# pair of the set's that adds one label and subtracts another is a difference of them, which a leb128 pair writes over
# the leb128 the layout measured, the linker setting it
fun datum(d: *Disasm, section: u32, data: *u8, len: usize, at: u64, limit: u64) res[u64, Refusal] {
    val site:  *Site                    = ?d.sites.data[d.ri];
    val r:     *mink_object.Reloc       = reloc_of(d, site);
    val aimed: res[opt[Aimed], Refusal] = aim(d, r, site);
    if (sel aimed.err)     { ret res[u64, Refusal].err{aimed.err}; }
    if (sel aimed.ok.none) { ret stated_datum(d, Refusal{message: MARKER, section: section, offset: at}); }
    if (sel r.minus.some)  { ret subtracted(d, section, data, at, limit, r, aimed.ok.some); }
    var width: u8                  = 0;
    var basis: core_fixup.Basis    = core_fixup.ABSOLUTE;
    var minus: opt[Aimed]          = opt[Aimed].none{};
    var taken: usize               = 1;
    var how:   core_fixup.Encoding = core_fixup.FIXED;
    var i:     u32                 = 0;
    for (i < d.s.data.len && width == 0) {
        val row_: *core_fixup.Datum = ?d.s.data.at[i];
        if (binds(d, r.kind, row_.fixup)) {
            width = row_.width;
            basis = row_.basis;
        }
        i = i + 1;
    }
    i = 0;
    for (i < d.s.pairs.len && width == 0) {
        val p: *core_fixup.Pair = ?d.s.pairs.at[i];
        if (binds(d, r.kind, p.add)) {
            if (d.ri + 1 >= d.sites.len) { ret stated_datum(d, Refusal{message: UNPAIRED, section: section, offset: at}); }
            val other: *Site              = ?d.sites.data[d.ri + 1];
            val sub:   *mink_object.Reloc = reloc_of(d, other);
            if (other.section != section || other.offset != at || !binds(d, sub.kind, p.sub) || sel sub.minus.some) { ret stated_datum(d, Refusal{message: UNPAIRED, section: section, offset: at}); }
            val m: res[opt[Aimed], Refusal] = aim(d, sub, other);
            if (sel m.err)     { ret res[u64, Refusal].err{m.err}; }
            if (sel m.ok.none) { ret stated_datum(d, Refusal{message: UNPAIRED, section: section, offset: at}); }
            val kept_: err[Refusal] = pair_unfolded(d, site, r, sub);
            if (sel kept_.err) { ret stated_datum(d, kept_.err); }
            width = p.width;
            minus = m.ok;
            taken = 2;
            how   = p.encoding;
            if (how != core_fixup.FIXED) {
                val n: opt[u64] = leb_length(data, at, limit);
                if (sel n.none) { ret stated_datum(d, Refusal{message: UNTAKEN, section: section, offset: at}); }
                width = n.some::u8;
            }
        }
        i = i + 1;
    }
    if (width == 0) { ret stated_datum(d, Refusal{message: UNTAKEN, section: section, offset: at}); }
    if (sel minus.none) {
        val kept_: err[Refusal] = unfolded(d, site, r, nil, nil, at);
        if (sel kept_.err) { ret stated_datum(d, kept_.err); }
    }
    if (at + width::u64 > limit) { ret stated_datum(d, Refusal{message: UNTAKEN, section: section, offset: at}); }
    var b: u64 = 0;
    for (b < width::u64 && how == core_fixup.FIXED) {
        if (data[(at + b)::usize] != 0) { ret stated_datum(d, Refusal{message: HELD, section: section, offset: at}); }
        b = b + 1;
    }
    var directive: opt[str] = width_directive(d, width);
    if (how == core_fixup.ULEB) { directive = opt[str].some{".uleb128"}; }
    if (how == core_fixup.SLEB) { directive = opt[str].some{".sleb128"}; }
    if (sel directive.none)     { ret res[u64, Refusal].err{Refusal{message: NO_WIDTH, section: section, offset: at}}; }
    put_char(d, '\t');
    put(d, directive.some);
    put_char(d, ' ');
    var plus: Aimed = aimed.ok.some;
    if (sel minus.some) { plus.addend = plus.addend - minus.some.addend; }
    put_aimed(d, plus);
    if (sel minus.some) {
        put(d, " - ");
        put_symbol(d, named(d::ptr, minus.some.handle));
    }
    or (basis == core_fixup.RELATIVE) { put(d, " - ."); }
    put_char(d, '\n');
    d.ri = d.ri + taken;
    ret res[u64, Refusal].ok{width::u64};
}

# the width of difference kind `k`, which subtracts a symbol of its own, 0 for another kind
fun difference_width(k: *mink_reloc.Kind) u8 {
    if (k == ?mink_reloc.DIFF8)  { ret 1; }
    if (k == ?mink_reloc.DIFF16) { ret 2; }
    if (k == ?mink_reloc.DIFF32) { ret 4; }
    if (k == ?mink_reloc.DIFF64) { ret 8; }
    ret 0;
}

# the datum at `at` of `data` of relocation `r`, which subtracts a symbol of its own from `plus`, as a mach-o subtractor
# pair does, written by `limit` as the difference of the two, answering its width
fun subtracted(d: *Disasm, section: u32, data: *u8, at: u64, limit: u64, r: *mink_object.Reloc, plus: Aimed) res[u64, Refusal] {
    val site:  *Site = ?d.sites.data[d.ri];
    val width: u8    = difference_width(r.kind);
    if (width == 0 || at + width::u64 > limit) { ret res[u64, Refusal].err{Refusal{message: DIFFERENCE, section: section, offset: at}}; }
    var less: mink_object.Reloc = @r;
    if (sel r.minus.some) { less.target = mink_object.Target.symbol{r.minus.some}; }
    less.addend = 0;
    less.minus  = opt[table.Id[mink_object.Symbol]].none{};
    val m: res[opt[Aimed], Refusal] = aim(d, ?less, site);
    if (sel m.err)     { ret res[u64, Refusal].err{m.err}; }
    if (sel m.ok.none) { ret res[u64, Refusal].err{Refusal{message: DIFFERENCE, section: section, offset: at}}; }
    var b: u64 = 0;
    for (b < width::u64) {
        if (data[(at + b)::usize] != 0) { ret res[u64, Refusal].err{Refusal{message: DIFFERENCE, section: section, offset: at}}; }
        b = b + 1;
    }
    val directive: opt[str] = width_directive(d, width);
    if (sel directive.none) { ret res[u64, Refusal].err{Refusal{message: NO_WIDTH, section: section, offset: at}}; }
    var to: Aimed = plus;
    to.addend = to.addend - m.ok.some.addend;
    put_char(d, '\t');
    put(d, directive.some);
    put_char(d, ' ');
    put_aimed(d, to);
    put(d, " - ");
    put_symbol(d, named(d::ptr, m.ok.some.handle));
    put_char(d, '\n');
    d.ri = d.ri + 1;
    ret res[u64, Refusal].ok{width::u64};
}

# the bytes from `at` to `end` of `data` written as one-byte data
fun raw(d: *Disasm, section: u32, data: *u8, at: u64, end: u64) err[Refusal] {
    if (sel d.byte.none) { ret refusal(NO_BYTE, section, at); }
    var i: u64 = at;
    for (i < end) {
        put_char(d, '\t');
        put(d, d.byte.some);
        put_char(d, ' ');
        var n: usize = 0;
        for (i < end && n < PER_LINE) {
            if (n > 0) { put(d, ", "); }
            put_hex(d, data[i::usize]);
            i = i + 1;
            n = n + 1;
        }
        put_char(d, '\n');
    }
    ret err[Refusal].ok{};
}

# the offset of the relocation at the cursor in `section`, `none` when it has no more
fun next_site(d: *Disasm, section: u32, none: u64) u64 {
    if (d.ri < d.sites.len && d.sites.data[d.ri].section == section) { ret d.sites.data[d.ri].offset; }
    ret none;
}

# data from `at` up to `end`, a datum at each relocation, which may run on to `limit`, answering how many bytes it took
fun data_run(d: *Disasm, section: u32, data: *u8, len: usize, at: u64, end: u64, limit: u64) res[u64, Refusal] {
    var i: u64 = at;
    for (i < end) {
        val next: u64 = next_site(d, section, limit);
        if (next == i) {
            val put_: res[u64, Refusal] = datum(d, section, data, len, i, limit);
            if (sel put_.err) { ret put_; }
            i = i + put_.ok;
            cnt;
        }
        var stop: u64 = end;
        if (next < stop) { stop = next; }
        val wrote: err[Refusal] = raw(d, section, data, i, stop);
        if (sel wrote.err) { ret res[u64, Refusal].err{wrote.err}; }
        i = stop;
    }
    ret res[u64, Refusal].ok{i - at};
}

# the shortest fill pattern the selection admits, 0 for none
fun shortest(d: *Disasm) u64 {
    if (d.fills.len == 0) { ret 0; }
    ret d.fills.data[d.fills.len - 1].len::u64;
}

# whether the `size` bytes at `at` of `data` are the code fill the builder pads with, in the set's order
fun is_fill(d: *Disasm, data: *u8, at: u64, size: u64) bool {
    var left: u64 = size;
    var o:    u64 = at;
    for (d.s.fill != nil && left > 0) {
        val pattern: *fill.Pattern = fill.next(d.s.fill, d.v, left);
        if (pattern == nil) { brk; }
        var i: u32 = 0;
        for (i < pattern.len) {
            if (data[(o + i::u64)::usize] != pattern.bytes[i]) { ret false; }
            i = i + 1;
        }
        o    = o + pattern.len::u64;
        left = left - pattern.len::u64;
    }
    ret left == 0;
}

# the realigned padding the marker at the cursor states, as the alignment that writes it under the scope being tried,
# answering its size, 0 when it is not that scope's fill
fun realign(d: *Disasm, section: u32, data: *u8, at: u64, limit: u64) res[u64, Refusal] {
    val r:     *mink_object.Reloc = reloc_of(d, ?d.sites.data[d.ri]);
    val least: u64                = shortest(d);
    if (r.addend <= 0 || least == 0) { ret res[u64, Refusal].ok{0}; }
    val size:     u64 = r.addend:~u64;
    val boundary: u64 = size + least;
    if ((boundary & (boundary - 1)) != 0 || at + size > limit || !is_fill(d, data, at, size)) { ret res[u64, Refusal].ok{0}; }
    put(d, "\t.balign ");
    put_unsigned(d, boundary);
    put_char(d, '\n');
    d.ri = d.ri + 1;
    ret res[u64, Refusal].ok{size};
}

# whether the relocation at the cursor is the set's realign marker at `at`
fun realigns(d: *Disasm, section: u32, at: u64) bool {
    if (d.s.realign == operand.NO_FIXUP || next_site(d, section, at + 1) != at) { ret false; }
    val r: *mink_object.Reloc = reloc_of(d, ?d.sites.data[d.ri]);
    ret sel r.target.none && binds(d, r.kind, d.s.realign);
}

# the labels at `at` of `section` written, but `skip`, operand.NO_SYMBOL for none
fun labels_at(d: *Disasm, section: u32, at: u64, skip: u32) {
    for (d.li < d.labels.len && d.labels.data[d.li].section == section && d.labels.data[d.li].offset == at) {
        val h: u32 = d.labels.data[d.li].handle;
        d.li = d.li + 1;
        if (h == skip) { cnt; }
        label_line(d, h);
    }
}

# the label of handle `h` written where it is placed
fun label_line(d: *Disasm, h: u32) {
    put_symbol(d, named(d::ptr, h));
    put(d, ":\n");
}

fun by_row(x: *Located, y: *Located) i64 {
    if (x.section != y.section) {
        if (x.section < y.section) { ret -1; }
        ret 1;
    }
    if (x.offset != y.offset) {
        if (x.offset < y.offset) { ret -1; }
        ret 1;
    }
    if (x.order < y.order) { ret -1; }
    if (x.order > y.order) { ret 1; }
    ret 0;
}

# the rows of sequence `i` taken, refused when it is a second of its section, has no row at its start or ends before
# its section. `seen` marks the sections taken, and `n` counts the rows taken so far
fun take_sequence(d: *Disasm, i: usize, seen: *vector.Vector[bool], n: *usize) err[Refusal] {
    val q:    *mink_object.Sequence = table.at[mink_object.Sequence](?d.o.sequences, table.nth[mink_object.Sequence](i));
    val sec:  u32                   = q.start.section.index;
    val rows: usize                 = table.count[mink_line.Row](?q.rows);
    for (seen.len <= sec::usize) {
        if (!held(vector.push[bool](seen, false))) { ret whole(MEMORY); }
    }
    if (seen.data[sec::usize] || rows == 0 || q.end != size_of(d, sec))                     { ret refusal(SEQUENCE, sec, q.start.offset); }
    if (table.at[mink_line.Row](?q.rows, table.nth[mink_line.Row](0)).at != q.start.offset) { ret refusal(SEQUENCE, sec, q.start.offset); }
    seen.data[sec::usize] = true;
    if (!held(vector.reserve[Located](?d.rows, rows))) { ret whole(MEMORY); }
    var k: usize = 0;
    for (k < rows) {
        val r: *mink_line.Row = table.at[mink_line.Row](?q.rows, table.nth[mink_line.Row](k));
        vector.push[Located](?d.rows, Located{
            section: sec,
            offset:  r.at,
            order:   @n,
            loc:     lines.Location{file: r.file.index, line: r.line, column: r.column, end_column: r.end_column, flags: r.flags, isa: r.isa, discriminator: r.discriminator},
        });
        @n = @n + 1;
        k  = k + 1;
    }
    ret err[Refusal].ok{};
}

# every row of the object's line sequences in place order, refused for a sequence the line directives do not state
fun line_rows(d: *Disasm) err[Refusal] {
    var seen: vector.Vector[bool] = vector.init[bool](d.a);
    var n:    usize               = 0;
    var i:    usize               = 0;
    for (i < table.count[mink_object.Sequence](?d.o.sequences)) {
        val took: err[Refusal] = take_sequence(d, i, ?seen, ?n);
        if (sel took.err) {
            vector.dnit[bool](?seen);
            ret took;
        }
        i = i + 1;
    }
    vector.dnit[bool](?seen);
    sort.sort_by[Located](d.rows.data, d.rows.len, by_row);
    ret err[Refusal].ok{};
}

# the object's file table as the `.file` lines of the line directives
fun files(d: *Disasm) err[Refusal] {
    var i: usize = 0;
    for (i < table.count[mink_line.File](?d.o.files)) {
        val f:   *mink_line.File = table.at[mink_line.File](?d.o.files, table.nth[mink_line.File](i));
        var dir: View            = View{data: "", len: 0};
        if (sel f.directory.some) { dir = name_of(d, f.directory.some); }
        val wrote: err[str] = lines.put_file(d.out, i::u32, lines.Source{directory: dir, name: name_of(d, f.name), md5: f.md5});
        if (sel wrote.err) { ret whole(wrote.err); }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the rows of `section` at `at` written as their `.loc` lines, which the instruction at `at` must follow
fun rows_at(d: *Disasm, section: u32, at: u64) err[Refusal] {
    for (d.xi < d.rows.len && d.rows.data[d.xi].section == section && d.rows.data[d.xi].offset == at) {
        val wrote: err[str] = lines.put_loc(d.out, d.rows.data[d.xi].loc, ?d.spoken);
        if (sel wrote.err) { ret refusal(wrote.err, section, at); }
        d.xi      = d.xi + 1;
        d.pending = true;
    }
    if (d.xi < d.rows.len && d.rows.data[d.xi].section == section && d.rows.data[d.xi].offset < at) { ret refusal(ROW, section, d.rows.data[d.xi].offset); }
    ret err[Refusal].ok{};
}

# the offset of the next row of `section`, `none` when it has no more before it
fun next_row(d: *Disasm, section: u32, none: u64) u64 {
    if (d.xi < d.rows.len && d.rows.data[d.xi].section == section && d.rows.data[d.xi].offset < none) { ret d.rows.data[d.xi].offset; }
    ret none;
}

# what is written at `at` of `section` is no instruction, refused when a row written there awaits one
fun unrowed(d: *Disasm, section: u32, at: u64) err[Refusal] {
    if (d.pending) { ret refusal(ROW, section, at); }
    ret err[Refusal].ok{};
}

# the offset of the next label of `section`, `none` when it has no more
fun next_label(d: *Disasm, section: u32, none: u64) u64 {
    if (d.li < d.labels.len && d.labels.data[d.li].section == section && d.labels.data[d.li].offset < none) { ret d.labels.data[d.li].offset; }
    ret none;
}

# directive `dir` of the dialect written as a whole statement, its name and its word
fun put_line(d: *Disasm, dir: *source.Directive) {
    put_char(d, '\t');
    val spelled: err[A.Error] = source.spell(dir, d.out);
    if (sel spelled.err) { d.full = true; }
    put_char(d, '\n');
}

# the index of the dialect's directive that ends narrowing `i` of the object's selection: a widening of what it holds
# that the narrowing takes away, none when the dialect has none
fun lift_of(d: *Disasm, i: u32, s: *extension.Selection) opt[u32] {
    val ds: source.Directives = d.s.source.directives;
    var j:  u32               = 0;
    for (j < ds.len) {
        val w: source.Edit = ds.at[j].edit;
        if (sel w.widen && narrow.lifts(d.a, ds, i, s, w.widen)) { ret opt[u32].some{j}; }
        j = j + 1;
    }
    ret opt[u32].none{};
}

# the directives that move from the scope in force to scope `to` written, and `to` made the scope tried: the scope in
# force ended by the dialect's pop or else by the lift of each of its narrowings, `to`'s basis restated where the text
# is then under another, and `to` entered after a push
fun enter(d: *Disasm, to: usize) {
    val ds:   source.Directives      = d.s.source.directives;
    val from: *Scope                 = ?d.scopes.data[d.now];
    val into: *Scope                 = ?d.scopes.data[to];
    val push: opt[*source.Directive] = source.push_of(ds);
    val pop:  opt[*source.Directive] = source.pop_of(ds);
    if (to != d.now) {
        val ended_: usize = ended(d);
        if (from.mask != 0) {
            if (sel pop.some) {
                put_line(d, pop.some);
                d.modes = d.pushed;
            }
            or {
                var n: u32 = 0;
                for (n < ds.len) {
                    if ((from.mask & source.bit(n)) != 0) {
                        val lift: opt[u32] = lift_of(d, n, d.scopes.data[d.bases.data[from.basis].first].v.selection);
                        if (sel lift.some) { put_line(d, ?ds.at[lift.some]); }
                    }
                    n = n + 1;
                }
            }
        }
        if (into.basis != ended_) { restated(d, into.basis); }
        if (into.mask != 0) {
            if (sel push.some) {
                put_line(d, push.some);
                d.pushed = d.modes;
                d.under  = into.basis;
            }
            var n: u32 = 0;
            for (n < ds.len) {
                if ((into.mask & source.bit(n)) != 0) { put_line(d, ?ds.at[n]); }
                n = n + 1;
            }
        }
    }
    d.v     = into.v;
    d.fills = ?into.fills;
}

# the dialect's restatement of basis `b`'s selection written, in the spelling of the mark that names it, or in the
# selection's own for a basis no mark names
fun restated(d: *Disasm, b: usize) {
    val dir: opt[*source.Directive] = source.restate_of(d.s.source.directives);
    if (sel dir.none) { ret; }
    put_char(d, '\t');
    val spelled: err[A.Error] = source.spell(dir.some, d.out);
    if (sel spelled.err) { d.full = true; }
    put(d, ", ");
    if (d.bases.data[b].text.len > 0) { put_view(d, d.bases.data[b].text); }
    or {
        var own:     vector.Vector[u8] = vector.init[u8](d.a);
        val written: err[A.Error]      = extension.spell_versioned(d.scopes.data[d.bases.data[b].first].v.selection, ?own);
        if (sel written.err) { d.full = true; }
        put_bytes(d, own.data, own.len);
        vector.dnit[u8](?own);
    }
    put_char(d, '\n');
}

# the basis the text is under once the scope in force ends: the one its push saved where the dialect pops it, else its
# own, whose narrowings its lifts end
fun ended(d: *Disasm) usize {
    val from: *Scope                 = ?d.scopes.data[d.now];
    val pop:  opt[*source.Directive] = source.pop_of(d.s.source.directives);
    if (from.mask != 0 && sel pop.some) { ret d.under; }
    ret from.basis;
}

# the text moved back under the object's selection, or under the basis it is under once the scope in force ends in a
# dialect with no restatement, which nothing then takes back what a statement widened the selection by
fun leave(d: *Disasm) {
    val restate: opt[*source.Directive] = source.restate_of(d.s.source.directives);
    var home:    usize                  = 0;
    if (sel restate.none) { home = ended(d); }
    val to: usize = d.bases.data[home].first;
    enter(d, to);
    d.now   = to;
    d.basis = home;
}

# the scope tried `k`-th of the basis being read: the one in force first when it narrows that basis, then the others
# in order
fun tried(d: *Disasm, k: usize) usize {
    val members: *vector.Vector[usize] = ?d.bases.data[d.basis].members;
    val now:     *Scope                = ?d.scopes.data[d.now];
    if (now.basis != d.basis) { ret members.data[k]; }
    if (k == 0)               { ret d.now; }
    if (k - 1 < now.slot)     { ret members.data[k - 1]; }
    ret members.data[k];
}

# scope `scope` added to basis `b`'s
fun member(d: *Disasm, b: usize, scope: Scope) err[Refusal] {
    var sc: Scope = scope;
    sc.slot = d.bases.data[b].members.len;
    if (!held(vector.push[Scope](?d.scopes, sc)))                              { ret whole(MEMORY); }
    if (!held(vector.push[usize](?d.bases.data[b].members, d.scopes.len - 1))) { ret whole(MEMORY); }
    ret err[Refusal].ok{};
}

# the basis of basis `b`'s selection widened by `ids`: `b` when it holds them, else the basis of the selection with
# them added, found among the bases or made the first time, refused at `at` when the set cannot make it
fun basis_with(d: *Disasm, b: usize, ids: requirement.Ids, section: u32, at: u64) res[usize, Refusal] {
    val own:  *state.Context = d.scopes.data[d.bases.data[b].first].v;
    var lack: bool           = false;
    var k:    u32            = 0;
    for (k < ids.len) {
        lack = lack || !extension.has(own.selection, ids.at[k]);
        k    = k + 1;
    }
    if (!lack) { ret res[usize, Refusal].ok{b}; }
    val grown: res[extension.Selection, extension.Error] = extension.added(d.a, own.selection, ids);
    if (sel grown.err) {
        if (sel grown.err.memory) { ret res[usize, Refusal].err{Refusal{message: MEMORY, section: NO_SECTION, offset: 0}}; }
        ret res[usize, Refusal].err{Refusal{message: WIDENED, section: section, offset: at}};
    }
    var picked: extension.Selection = grown.ok;
    var j:      usize               = 0;
    for (j < d.bases.len) {
        val sv: *extension.Selection = d.scopes.data[d.bases.data[j].first].v.selection;
        if (extension.within(sv, ?picked) && extension.within(?picked, sv)) {
            val freed: err[A.Error] = extension.release(?picked);
            ret res[usize, Refusal].ok{j};
        }
        j = j + 1;
    }
    val object: *state.Context                      = d.scopes.data[0].v;
    val made:   res[*narrow.Narrowed, state.Opened] = narrow.from(d.a, object.view.file, ?picked, object, own.values, d.s.source.directives, 0);
    val freed:  err[A.Error]                        = extension.release(?picked);
    if (sel made.err) { ret res[usize, Refusal].err{Refusal{message: WIDENED, section: section, offset: at}}; }
    if (!held(vector.push[Basis](?d.bases, Basis{first: 0, members: vector.init[usize](d.a), text: View{data: nil, len: 0}, kept: made.ok}))) {
        narrow.release(d.a, made.ok);
        ret res[usize, Refusal].err{Refusal{message: MEMORY, section: NO_SECTION, offset: 0}};
    }
    val nb:      usize        = d.bases.len - 1;
    val scoped_: err[Refusal] = scopes_of(d, nb, ?made.ok.context);
    if (sel scoped_.err) { ret res[usize, Refusal].err{scoped_.err}; }
    ret res[usize, Refusal].ok{nb};
}

# the scope in force widened by what each instruction of the statement at `at`, just read back, widens the selection
# by, as the assembler widens it: its basis by what it adds and its narrowings but those a widening lifts, so the code
# after it is read back under what the assembler reads it under. a scope of exactly those narrowings that the basis's
# combinations left out is made the first time, as the narrowings were in force and so are stated. refused at `at` when
# the set cannot make the selection
fun widened(d: *Disasm, section: u32, at: u64) err[Refusal] {
    if (d.s.source.widens == nil) { ret err[Refusal].ok{}; }
    val was:  *Scope = ?d.scopes.data[d.now];
    var b:    usize  = was.basis;
    var mask: u64    = was.mask;
    var i:    u32    = 0;
    for (i < d.read) {
        val ids: requirement.Ids = d.s.source.widens(?d.steps[i].ins);
        i = i + 1;
        if (ids.len == 0) { cnt; }
        val grown: res[usize, Refusal] = basis_with(d, b, ids, section, at);
        if (sel grown.err) { ret err[Refusal].err{grown.err}; }
        b    = grown.ok;
        mask = narrow.lifted(d.a, d.s.source.directives, mask, d.scopes.data[d.bases.data[b].first].v.selection, ids);
    }
    val now:   *Scope = ?d.scopes.data[d.now];
    var found: usize  = d.now;
    if (b != now.basis || mask != now.mask) {
        val members: *vector.Vector[usize] = ?d.bases.data[b].members;
        found = d.scopes.len;
        var j: usize = 0;
        for (j < members.len && found == d.scopes.len) {
            if (d.scopes.data[members.data[j]].mask == mask) { found = members.data[j]; }
            j = j + 1;
        }
        if (found == d.scopes.len) {
            val own:  *state.Context                      = d.scopes.data[d.bases.data[b].first].v;
            val made: res[*narrow.Narrowed, state.Opened] = narrow.make(d.a, own, d.s.source.directives, mask);
            if (sel made.err) { ret whole(MEMORY); }
            val added: err[Refusal] = member(d, b, Scope{v: ?made.ok.context, fills: vector.init[*fill.Pattern](d.a), mask: mask, kept: made.ok, basis: b});
            if (sel added.err) {
                narrow.release(d.a, made.ok);
                ret added;
            }
            found = d.scopes.len - 1;
            val filled: err[Refusal] = admitted_fills(d, ?made.ok.context, ?d.scopes.data[found].fills);
            if (sel filled.err) { ret filled; }
        }
    }
    d.now   = found;
    d.basis = b;
    d.v     = d.scopes.data[found].v;
    d.fills = ?d.scopes.data[found].fills;
    ret err[Refusal].ok{};
}

# the directive of the dialect that sets mode `m` to value `v`, none when it has none
fun mode_directive(d: *Disasm, m: *mode.Mode, v: *mode.Value) opt[*source.Directive] {
    val ds: source.Directives = d.s.source.directives;
    var i:  u32               = 0;
    for (i < ds.len) {
        val e: source.Edit = ds.at[i].edit;
        if (sel e.mode && (e.mode.mode == m && e.mode.value == v)) { ret opt[*source.Directive].some{?ds.at[i]}; }
        i = i + 1;
    }
    ret opt[*source.Directive].none{};
}

# `what` at `at` written under the first scope it reads back under, after the directives that move to it and, when
# `dir` is some, the dialect's directive `dir` of the mode setting `to`, answering how many bytes it takes, 0 when it
# reads back under none, with the output and the modes as they were. a statement that reads back widens the scope in
# force for the code after it
fun under_scopes(d: *Disasm, what: Attempt, section: u32, data: *u8, len: usize, at: u64, limit: u64, dir: opt[*source.Directive], to: mode.Setting) res[u64, Refusal] {
    val start:  usize             = d.out.len;
    val modes:  mode.State        = d.modes;
    val pushed: mode.State        = d.pushed;
    val under:  usize             = d.under;
    var took:   res[u64, Refusal] = res[u64, Refusal].ok{0};
    var k:      usize             = 0;
    for (k < d.bases.data[d.basis].members.len) {
        val into: usize = tried(d, k);
        k = k + 1;
        enter(d, into);
        if (sel dir.some) {
            put_line(d, dir.some);
            mode.change(?d.modes, to);
        }
        if (what == REALIGN) { took = realign(d, section, data, at, limit); }
        or (what == PAIR)    { took = pair(d, section, data, len, at, limit); }
        or                   { took = statement(d, section, data, len, at, limit); }
        if (sel took.err)    { brk; }
        if (took.ok > 0) {
            d.now = into;
            if (what == REALIGN) { brk; }
            val grown: err[Refusal] = widened(d, section, at);
            if (sel grown.err) { ret res[u64, Refusal].err{grown.err}; }
            brk;
        }
        vector.truncate[u8](d.out, start);
        d.modes  = modes;
        d.pushed = pushed;
        d.under  = under;
    }
    ret took;
}

# whether an attempt took nothing and refused nothing
fun unread(took: *res[u64, Refusal]) bool {
    if (sel took.ok) { ret took.ok == 0; }
    ret false;
}

# `what` at `at` written under the first scope it reads back under, answering how many bytes it takes, 0 when it reads
# back under none, with the output as it was: under the modes in force, or else with one mode at another value set by
# the dialect's directive of it, as a relaxed object's call reads back only after `.option relax`
fun scoped(d: *Disasm, what: Attempt, section: u32, data: *u8, len: usize, at: u64, limit: u64) res[u64, Refusal] {
    var took: res[u64, Refusal] = moded(d, what, section, data, len, at, limit);
    # a statement that leaves none of its relocations to `.reloc` comes first, then one that leaves to it what no operand
    # takes, then one that leaves it every one
    var level: u8 = UNTAKEN_STATED;
    for (level <= ALL_STATED && unread(?took) && what != REALIGN && sel d.relocs.ok && next_site(d, section, limit) < limit) {
        d.stating = level;
        took      = moded(d, what, section, data, len, at, limit);
        d.stating = NONE_STATED;
        level     = level + 1;
    }
    ret took;
}

# `what` at `at` written as `scoped` writes it, under the modes in force or one mode moved
fun moded(d: *Disasm, what: Attempt, section: u32, data: *u8, len: usize, at: u64, limit: u64) res[u64, Refusal] {
    val none: mode.Setting      = mode.Setting{mode: nil, value: nil};
    var took: res[u64, Refusal] = under_scopes(d, what, section, data, len, at, limit, opt[*source.Directive].none{}, none);
    val held: mode.State        = d.modes;
    var i:    u32               = 0;
    for (i < held.modes.len && i < mode.MAX_MODES && unread(?took)) {
        val m: *mode.Mode = held.modes.at[i];
        var v: u32        = 0;
        for (v < m.values.len && unread(?took)) {
            val value: *mode.Value = m.values.at[v];
            v = v + 1;
            if (value == held.values[i]) { cnt; }
            val dir: opt[*source.Directive] = mode_directive(d, m, value);
            if (sel dir.some) { took = under_scopes(d, what, section, data, len, at, limit, dir, mode.Setting{mode: m, value: value}); }
        }
        i = i + 1;
    }
    d.v     = d.scopes.data[d.now].v;
    d.fills = ?d.scopes.data[d.now].fills;
    ret took;
}

# the code fill patterns `v` admits appended to `fills`, longest first
fun admitted_fills(d: *Disasm, v: *state.Context, fills: *vector.Vector[*fill.Pattern]) err[Refusal] {
    if (d.s.fill == nil) { ret err[Refusal].ok{}; }
    var i: u32 = 0;
    for (i < d.s.fill.count) {
        val p: *fill.Pattern = ?d.s.fill.patterns[i];
        if (state.admits(v, p.requires) && !held(vector.push[*fill.Pattern](fills, p))) { ret whole(MEMORY); }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# how many bits of `mask` are set
fun bits_of(mask: u64) u32 {
    var n: u32 = 0;
    var m: u64 = mask;
    for (m != 0) {
        m = m & (m - 1);
        n = n + 1;
    }
    ret n;
}

# the scopes made: the object's, then each combination of the dialect's narrowings that take something from the object's
# selection and whose end the text can state, by the stack or by a lift the object's selection holds, one narrowing
# alone before two together, of the first MAX_COMBINED of them and up to MAX_SCOPES, a combination that makes the
# selection another one made already left out
fun scopes(d: *Disasm, available: *state.Context) err[Refusal] {
    if (!held(vector.push[Basis](?d.bases, Basis{first: 0, members: vector.init[usize](d.a), text: View{data: nil, len: 0}, kept: nil}))) { ret whole(MEMORY); }
    val made: err[Refusal] = scopes_of(d, 0, available);
    d.v     = available;
    d.fills = ?d.scopes.data[0].fills;
    ret made;
}

# the scopes of basis `b`, whose selection is `available`'s, made as `scopes` makes the object's
fun scopes_of(d: *Disasm, b: usize, available: *state.Context) err[Refusal] {
    val first: usize = d.scopes.len;
    d.bases.data[b].first = first;
    val opened: err[Refusal] = member(d, b, Scope{v: available, fills: vector.init[*fill.Pattern](d.a), mask: 0, kept: nil, basis: b});
    if (sel opened.err) { ret opened; }
    val own: err[Refusal] = admitted_fills(d, available, ?d.scopes.data[first].fills);
    if (sel own.err) { ret own; }
    val ds:     source.Directives      = d.s.source.directives;
    val push:   opt[*source.Directive] = source.push_of(ds);
    var useful: [MAX_COMBINED]u32;
    var n:      u32                    = 0;
    var i:      u32                    = 0;
    for (i < ds.len && n < MAX_COMBINED) {
        val e: source.Edit = ds.at[i].edit;
        if (sel e.narrow && narrow.narrows(available.selection, e.narrow)) {
            val lift: opt[u32] = lift_of(d, i, available.selection);
            if (sel push.some || sel lift.some) {
                useful[n] = i;
                n         = n + 1;
            }
        }
        i = i + 1;
    }
    val all:  u64 = (1::u64 << n::u64) - 1;
    var size: u32 = 1;
    for (size <= n && d.scopes.len - first < MAX_SCOPES) {
        var pick: u64 = 1;
        for (pick <= all && d.scopes.len - first < MAX_SCOPES) {
            if (bits_of(pick) == size) {
                var mask: u64 = 0;
                var k:    u32 = 0;
                for (k < n) {
                    if ((pick & (1::u64 << k::u64)) != 0) { mask = mask | source.bit(useful[k]); }
                    k = k + 1;
                }
                val made: res[*narrow.Narrowed, state.Opened] = narrow.make(d.a, available, ds, mask);
                if (sel made.err) { ret whole(MEMORY); }
                var seen: bool  = false;
                var j:    usize = first;
                for (j < d.scopes.len && !seen) {
                    val sv: *extension.Selection = d.scopes.data[j].v.selection;
                    seen = extension.within(sv, ?made.ok.selection) && extension.within(?made.ok.selection, sv);
                    j    = j + 1;
                }
                if (seen) { narrow.release(d.a, made.ok); }
                or {
                    val added: err[Refusal] = member(d, b, Scope{v: ?made.ok.context, fills: vector.init[*fill.Pattern](d.a), mask: mask, kept: made.ok, basis: b});
                    if (sel added.err) {
                        narrow.release(d.a, made.ok);
                        ret added;
                    }
                    val filled: err[Refusal] = admitted_fills(d, ?made.ok.context, ?d.scopes.data[d.scopes.len - 1].fills);
                    if (sel filled.err) { ret filled; }
                }
            }
            pick = pick + 1;
        }
        size = size + 1;
    }
    ret err[Refusal].ok{};
}

# the longest selection spelling a code mark is read with
val MARK_SPELLING: usize = 512;

# the basis of each code mark: the object's when the mark names no selection, the object's own or one of its
# narrowings, the basis whose scope makes the selection it names, else a basis of that selection, made the first time
# one names it, refused when the set's selection syntax does not read it or
# the object's register file and state do not hold it
fun mark_bases(d: *Disasm) err[Refusal] {
    if (sel d.mapping.none)       { ret err[Refusal].ok{}; }
    if (!d.mapping.some.per_view) { ret err[Refusal].ok{}; }
    val stem: usize = str_len(d.mapping.some.code);
    var text: [MARK_SPELLING + 1]u8;
    var k:    usize = 0;
    for (k < d.marks.len) {
        val m: *Mapped = ?d.marks.data[k];
        k = k + 1;
        if (!m.code) { cnt; }
        val name: View = m.name;
        if (name.len <= stem) { cnt; }
        val n: usize = name.len - stem;
        if (n > MARK_SPELLING) { ret refusal(MARK_SELECTION, m.section, m.offset); }
        var c: usize = 0;
        for (c < n) {
            text[c] = name.data[stem + c];
            c       = c + 1;
        }
        text[n] = 0;
        var picked: extension.Selection;
        val got:    res[extension.Selection, extension.Error] = extension.select(d.a, d.scopes.data[0].v.selection.catalog, ?text[0], diagnostic.START);
        if (sel got.err) { ret refusal(MARK_SELECTION, m.section, m.offset); }
        picked = got.ok;
        # a selection one of a basis's narrowings makes is read under that basis, as the narrowing states it
        var found: usize = d.bases.len;
        var j:     usize = 0;
        for (j < d.scopes.len && found == d.bases.len) {
            val sv: *extension.Selection = d.scopes.data[j].v.selection;
            if (extension.within(sv, ?picked) && extension.within(?picked, sv)) { found = d.scopes.data[j].basis; }
            j = j + 1;
        }
        if (found < d.bases.len) {
            val freed: err[A.Error] = extension.release(?picked);
            m.basis = found;
            cnt;
        }
        val object: *state.Context                      = d.scopes.data[0].v;
        val made:   res[*narrow.Narrowed, state.Opened] = narrow.from(d.a, object.view.file, ?picked, object, object.values, d.s.source.directives, 0);
        val freed:  err[A.Error]                        = extension.release(?picked);
        if (sel made.err) { ret refusal(MARK_SELECTION, m.section, m.offset); }
        if (!held(vector.push[Basis](?d.bases, Basis{first: 0, members: vector.init[usize](d.a), text: View{data: ?name.data[stem], len: n}, kept: made.ok}))) {
            narrow.release(d.a, made.ok);
            ret whole(MEMORY);
        }
        m.basis = d.bases.len - 1;
        val scoped_: err[Refusal] = scopes_of(d, m.basis, ?made.ok.context);
        if (sel scoped_.err) { ret scoped_; }
    }
    ret err[Refusal].ok{};
}

# whether every byte of `name` is one a section name is written with unquoted
fun plain(name: View) bool {
    if (name.len == 0) { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        val c: u8 = name.data[i];
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '$')) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the directive that enters nameless section `sec` by its kind, none for a named section or a kind no directive enters
fun kind_directive(d: *Disasm, sec: *mink_object.Section) opt[*dialect.Named] {
    if (sel sec.name.some) { ret opt[*dialect.Named].none{}; }
    ret core.kind_directive(d.naming, d.dialect.sections, sec.kind, sec.flags, sec.disposition, sec.entsize);
}

# the name section `i` reads back with: its own, or the spelling of the directive that enters a nameless one by its
# kind, none for a nameless section of a kind no directive enters
fun listed_name(d: *Disasm, i: u32) opt[View] {
    val sec: *mink_object.Section = section_of(d, i);
    if (sel sec.name.some) { ret opt[View].some{name_of(d, sec.name.some)}; }
    val e: opt[*dialect.Named] = kind_directive(d, sec);
    if (sel e.none) { ret opt[View].none{}; }
    ret opt[View].some{View{data: e.some.name, len: str_len(e.some.name)}};
}

fun same_name(a: opt[View], b: opt[View]) bool {
    if (sel a.some) {
        if (sel b.some) { ret same_view(a.some, b.some); }
        ret false;
    }
    ret sel b.none;
}

# the signature of the comdat group section `i` is in, none for a section in none or kept with a leader, as a coff
# associative selection keeps it, which states its leader in place of a signature
fun group_of(d: *Disasm, i: u32) opt[View] {
    val g: opt[table.Id[mink_object.Group]] = section_of(d, i).group;
    if (sel g.none) { ret opt[View].none{}; }
    val grp: *mink_object.Group = mink_object.group_at(d.o, g.some);
    if (mink_group.has(grp.rule, mink_group.ASSOCIATIVE)) { ret opt[View].none{}; }
    ret opt[View].some{name_of(d, grp.signature)};
}

# whether section `i` is kept with the section it is ordered after, its group's leader, as a coff associative selection
# keeps it
fun associated(d: *Disasm, i: u32) bool {
    val sec: *mink_object.Section             = section_of(d, i);
    val g:   opt[table.Id[mink_object.Group]] = sec.group;
    if (sel g.none)         { ret false; }
    if (sel sec.owner.none) { ret false; }
    val grp: *mink_object.Group = mink_object.group_at(d.o, g.some);
    if (!mink_group.has(grp.rule, mink_group.ASSOCIATIVE)) { ret false; }
    if (sel grp.leader.none)                               { ret false; }
    ret grp.leader.some.index == sec.owner.some.index;
}

# the index of the section section `i` is ordered after, none for a section of no link order
fun owner_of(d: *Disasm, i: u32) opt[u32] {
    val o: opt[table.Id[mink_object.Section]] = section_of(d, i).owner;
    if (sel o.none) { ret opt[u32].none{}; }
    ret opt[u32].some{o.some.index};
}

fun same_owner(a: opt[u32], b: opt[u32]) bool {
    if (sel a.some) {
        if (sel b.some) { ret a.some == b.some; }
        ret false;
    }
    ret sel b.none;
}

# whether section `i` is the first that reads back named `name` in the group of signature `group` and ordered after
# `owner`, the one the name, the group and the owner alone enter
fun first_named(d: *Disasm, i: u32, name: View, group: opt[View], owner: opt[u32]) bool {
    var k: u32 = 0;
    for (k < i) {
        val other: opt[View] = listed_name(d, k);
        val in:    opt[View] = group_of(d, k);
        val after: opt[u32]  = owner_of(d, k);
        k = k + 1;
        if (same_name(other, opt[View].some{name}) && same_name(in, group) && same_owner(after, owner)) { ret false; }
    }
    ret true;
}

# the name a link-order section's `.section` names section `o` by, which the assembler reads back to it
# (`model.linked`): its own, when it is a named section written before section `i` that its name alone enters, and no
# symbol of its name is placed in another section. none when it has no such name
fun linked_name(d: *Disasm, i: u32, o: u32) opt[View] {
    val sec: *mink_object.Section = section_of(d, o);
    if (o >= i || raised(d, o))                   { ret opt[View].none{}; }
    if (sel sec.group.some || sel sec.owner.some) { ret opt[View].none{}; }
    if (sel sec.name.none)                        { ret opt[View].none{}; }
    val name: View = name_of(d, sec.name.some);
    if (!first_named(d, o, name, opt[View].none{}, opt[u32].none{})) { ret opt[View].none{}; }
    if (!spell.spellable(name) || spell.reserved(name))              { ret opt[View].none{}; }
    var k: u32 = 0;
    for (k < d.count) {
        val sym: *mink_object.Symbol = symbol_of(d, k);
        k = k + 1;
        if (sym.name.index != sec.name.some.index) { cnt; }
        if (!sel sym.def.placed)                   { cnt; }
        val p: mink_object.Place = sym.def.placed;
        if (p.section.index != o) { ret opt[View].none{}; }
    }
    ret opt[View].some{name};
}

# the handle of the anchor that names section `o` to a section after it: the anchor at its start, which `index` states
# for an owner its name does not single out. none when it has none
fun owner_anchor(d: *Disasm, o: u32) opt[u32] {
    if (raised(d, o)) { ret opt[u32].none{}; }
    ret anchor_at(d, o, 0);
}

# whether section `i` names its owner, the section it is ordered after, by an anchor at the owner's start
fun anchors_owner(d: *Disasm, i: u32) bool {
    val owner: opt[u32] = owner_of(d, i);
    if (sel owner.none)                           { ret false; }
    if (owner.some >= i || raised(d, owner.some)) { ret false; }
    val own: opt[View] = linked_name(d, i, owner.some);
    ret sel own.none;
}

# the `.section` that opens section `i`, or the directive that enters a nameless one by its kind, and its alignment. a
# section in a comdat group states the group's signature after its type, a section ordered after another names that
# one, its owner, after its type by the owner's own name or the anchor at its start, and a section after the first of
# its name in its group and of its owner is opened apart by the dialect's next unique number
fun header(d: *Disasm, i: u32) err[Refusal] {
    val sec:    *mink_object.Section = section_of(d, i);
    val owner:  opt[u32]             = owner_of(d, i);
    var link:   opt[View]            = opt[View].none{};
    var anchor: opt[u32]             = opt[u32].none{};
    if (sel owner.some) {
        link = linked_name(d, i, owner.some);
        if (sel link.none && owner.some < i)                         { anchor = owner_anchor(d, owner.some); }
        if ((sel link.none && sel anchor.none) || sel sec.name.none) { ret refusal(OWNED, i, 0); }
    }
    val linked: bool             = sel owner.some;
    val led:    bool             = associated(d, i);
    val group:  opt[View]        = group_of(d, i);
    var rule:   *mink_group.Rule = ?mink_group.ANY;
    val form:   dialect.Form     = d.dialect.sections.form;
    if (sel sec.group.some) {
        val g: *mink_object.Group = mink_object.group_at(d.o, sec.group.some);
        rule = g.rule;
        val kept: bool = mink_group.has(g.rule, mink_group.ASSOCIATIVE) || sel g.leader.some;
        if ((g.rule != ?mink_group.ANY && !sel form.coff) || (kept && !(led && sel form.coff)) || sel sec.name.none) { ret refusal(GROUPED, i, 0); }
    }
    val listed: opt[View] = listed_name(d, i);
    if (sel listed.none) { ret refusal(KINDLESS, i, 0); }
    val name:  View = listed.some;
    val first: bool = first_named(d, i, name, group, owner);
    if (sel sec.name.none && first) {
        val e: opt[*dialect.Named] = kind_directive(d, sec);
        if (sel e.none) { ret refusal(KINDLESS, i, 0); }
        put_char(d, '\t');
        put(d, e.some.directive);
        put_char(d, '\n');
        aligned(d, sec);
        ret err[Refusal].ok{};
    }
    val unique: opt[str] = d.dialect.unique;
    if (!first && sel unique.none) { ret refusal(TWICE, i, 0); }
    if (sel form.macho || sel form.coff) {
        # coff ties a section to another only by an associative selection, and mach-o by none
        if (linked && !(led && sel form.coff)) { ret refusal(OWNED, i, 0); }
        var wrote: err[core.Unwritten] = err[core.Unwritten].ok{};
        if (sel form.macho) {
            var width: u64                    = 0;
            val p:     opt[mink_arch.Pointer] = d.o.target.arch.pointer;
            if (sel p.some) { width = p.some.bytes::u64; }
            wrote = core.macho_header(d.out, d.naming, d.dialect.sections, name, sec.kind, sec.flags, sec.entsize, width, sel group.some);
        }
        or {
            var by: opt[View] = group;
            if (led) {
                by = link;
                if (sel anchor.some) { by = opt[View].some{named(d::ptr, anchor.some)}; }
            }
            wrote = core.coff_header(d.out, d.naming, d.dialect.sections, name, sec.kind, sec.flags, sec.entsize, by, rule);
        }
        if (sel wrote.err) {
            val u: core.Unwritten = wrote.err;
            if (sel u.quoted)  { ret refusal(QUOTED, i, 0); }
            if (sel u.grouped) { ret refusal(GROUPED, i, 0); }
            ret refusal(SECTION, i, 0);
        }
        aligned(d, sec);
        ret err[Refusal].ok{};
    }
    val t: opt[str] = core.section_type(d.naming, name, sec.kind, sec.flags, sec.entsize);
    if (sel t.none) { ret refusal(SECTION, i, 0); }
    var letters: [core.FLAG_LETTERS]u8;
    val n:       opt[usize] = core.flag_string(sec.flags, ?letters[0]);
    if (sel n.none) { ret refusal(SECTION, i, 0); }
    put(d, "\t.section ");
    if (plain(name))          { put_view(d, name); }
    or (!put_string(d, name)) { ret refusal(QUOTED, i, 0); }
    put(d, ", \"");
    put_bytes(d, ?letters[0], n.some);
    if (linked)         { put_char(d, core.ORDER_LETTER); }
    if (sel group.some) { put_char(d, core.GROUP_LETTER); }
    put(d, "\", ");
    put_char(d, d.s.source.types[0]);
    put(d, t.some);
    if (sec.entsize != 0) {
        put(d, ", ");
        put_unsigned(d, sec.entsize);
    }
    if (sel link.some) {
        put(d, ", ");
        put_symbol(d, link.some);
    }
    or (sel anchor.some) {
        put(d, ", ");
        put_symbol(d, named(d::ptr, anchor.some));
    }
    if (sel group.some) {
        put(d, ", ");
        if (plain(group.some))          { put_view(d, group.some); }
        or (!put_string(d, group.some)) { ret refusal(QUOTED, i, 0); }
        put(d, ", ");
        put(d, core.COMDAT);
    }
    if (sel unique.some) {
        if (!first) {
            d.apart = d.apart + 1;
            put(d, ", ");
            put(d, unique.some);
            put(d, ", ");
            put_unsigned(d, d.apart);
        }
    }
    put_char(d, '\n');
    aligned(d, sec);
    ret err[Refusal].ok{};
}

# the alignment of section `sec`, stated when it has one
fun aligned(d: *Disasm, sec: *mink_object.Section) {
    if (sec.align > 1) {
        put(d, "\t.balign ");
        put_unsigned(d, sec.align);
        put_char(d, '\n');
    }
}

# whether section `i` holds code at `at`: as the mapping symbol at or before it marks it, the mapping symbols at `at`
# read, else `code` as it stands
fun marked_at(d: *Disasm, i: u32, at: u64, code: bool) bool {
    var now: bool = code;
    for (d.mi < d.marks.len && d.marks.data[d.mi].section == i && d.marks.data[d.mi].offset <= at) {
        now = d.marks.data[d.mi].code;
        # the code after a code mark is read under the basis it names
        if (now) { d.basis = d.marks.data[d.mi].basis; }
        d.mi = d.mi + 1;
    }
    ret now;
}

# the offset of the next mapping symbol of `section` before `none`, `none` when it has no more
fun next_mark(d: *Disasm, section: u32, none: u64) u64 {
    if (d.mi < d.marks.len && d.marks.data[d.mi].section == section && d.marks.data[d.mi].offset < none) { ret d.marks.data[d.mi].offset; }
    ret none;
}

# section `i` written: its header, then its labels, statements and data in offset order. it holds code where its
# mapping symbols mark code, and in a section with none where its flags say it executes
fun section(d: *Disasm, i: u32) err[Refusal] {
    if (d.headed) {
        val opened: err[Refusal] = header(d, i);
        if (sel opened.err) { ret opened; }
    }
    val sec:  *mink_object.Section = section_of(d, i);
    val size: u64                  = size_of(d, i);
    var code: bool                 = (sec.flags & mink_section.EXEC) != 0;
    var data: *u8                  = nil;
    var len:  usize                = 0;
    d.basis = d.scopes.data[d.now].basis;
    if (sel sec.contents.held) {
        val b: store.Bytes = contents(d, i);
        data = b.data;
        len  = b.len;
    }
    var at: u64 = 0;
    for (at < size) {
        code = marked_at(d, i, at, code);
        var here: u32 = operand.NO_SYMBOL;
        if (code && sel sec.contents.held) { here = pair_label(d, i, at); }
        labels_at(d, i, at, here);
        val located: err[Refusal] = rows_at(d, i, at);
        if (sel located.err) { ret located; }
        val limit: u64 = next_row(d, i, next_mark(d, i, next_label(d, i, size)));
        if (here != operand.NO_SYMBOL) {
            d.here = here;
            val bound: res[u64, Refusal] = scoped(d, PAIR, i, data, len, at, limit);
            if (sel bound.err) { ret err[Refusal].err{bound.err}; }
            if (bound.ok > 0) {
                d.pending = false;
                at        = at + bound.ok;
                cnt;
            }
            # no sequence binds it, so it is written where it is placed
            label_line(d, here);
        }
        if (sel sec.contents.zero) {
            val zeroed: err[Refusal] = unrowed(d, i, at);
            if (sel zeroed.err)                 { ret zeroed; }
            if (next_site(d, i, limit) < limit) { ret refusal(ZEROS, i, next_site(d, i, limit)); }
            put(d, "\t.zero ");
            put_unsigned(d, limit - at);
            put_char(d, '\n');
            at = limit;
            cnt;
        }
        if (code && realigns(d, i, at)) {
            val padded: res[u64, Refusal] = scoped(d, REALIGN, i, data, len, at, limit);
            if (sel padded.err) { ret err[Refusal].err{padded.err}; }
            # a marker no alignment writes is a relocation the statement there leaves to `.reloc`
            if (padded.ok > 0) {
                val aligned: err[Refusal] = unrowed(d, i, at);
                if (sel aligned.err) { ret aligned; }
                at = at + padded.ok;
                cnt;
            }
        }
        if (code) {
            val took: res[u64, Refusal] = scoped(d, STATEMENT, i, data, len, at, limit);
            if (sel took.err) { ret err[Refusal].err{took.err}; }
            if (took.ok > 0) {
                d.pending = false;
                at        = at + took.ok;
                cnt;
            }
            val raw_: err[Refusal] = unrowed(d, i, at);
            if (sel raw_.err) { ret raw_; }
            var unit: u64 = d.s.parcel(data, len, at::usize)::u64;
            if (at + unit > limit) { unit = limit - at; }
            val next: u64 = next_site(d, i, limit);
            if (next > at && next < at + unit) { unit = next - at; }
            val run: res[u64, Refusal] = data_run(d, i, data, len, at, at + unit, limit);
            if (sel run.err) { ret err[Refusal].err{run.err}; }
            at = at + run.ok;
            cnt;
        }
        val unrun: err[Refusal] = unrowed(d, i, at);
        if (sel unrun.err) { ret unrun; }
        val run: res[u64, Refusal] = data_run(d, i, data, len, at, limit, limit);
        if (sel run.err) { ret err[Refusal].err{run.err}; }
        at = at + run.ok;
    }
    labels_at(d, i, size, operand.NO_SYMBOL);
    if (d.xi < d.rows.len && d.rows.data[d.xi].section == i) { ret refusal(ROW, i, d.rows.data[d.xi].offset); }
    code = marked_at(d, i, size, code);
    leave(d);
    if (d.li < d.labels.len && d.labels.data[d.li].section == i) { ret refusal(PAST, i, d.labels.data[d.li].offset); }
    if (d.mi < d.marks.len && d.marks.data[d.mi].section == i)   { ret refusal(PAST, i, d.marks.data[d.mi].offset); }
    if (d.ri < d.sites.len && d.sites.data[d.ri].section == i)   { ret refusal(PAST, i, d.sites.data[d.ri].offset); }
    ret err[Refusal].ok{};
}

# whether section `i` is one the object's format holds its traits in with no bytes of its own, as elf's build attributes
# once read into the object's traits: what it held is the traits', which `unwritten` reports and the assembler raises
# a section of its name into, so the text never states it
fun raised(d: *Disasm, i: u32) bool {
    val sec: *mink_object.Section = section_of(d, i);
    if (size_of(d, i) != 0) { ret false; }
    if (sel sec.name.some) {
        val name: View = name_of(d, sec.name.some);
        ret d.traits.holds(d.o.target.arch, store.Bytes{data: name.data, len: name.len});
    }
    ret false;
}

# section `i` of the traits left out of the text, refused when a label or a relocation is in it. a mapping symbol in it,
# as the `$d` over the data of `.riscv.attributes`, is the assembler's to write, as every mark is, so
# the text leaves it as it leaves the section
fun unstated(d: *Disasm, i: u32) err[Refusal] {
    if (d.li < d.labels.len && d.labels.data[d.li].section == i) { ret refusal(RAISED, i, d.labels.data[d.li].offset); }
    if (d.ri < d.sites.len && d.sites.data[d.ri].section == i)   { ret refusal(RAISED, i, d.sites.data[d.ri].offset); }
    for (d.mi < d.marks.len && d.marks.data[d.mi].section == i) { d.mi = d.mi + 1; }
    ret err[Refusal].ok{};
}

# `.name` followed by the symbol's name
fun directive(d: *Disasm, name: str, sym: View) {
    put_char(d, '\t');
    put(d, name);
    put_char(d, ' ');
    put_symbol(d, sym);
}

# the declarations of symbol `i`: its source file, binding, visibility, type, size, and a value it is given
fun declare(d: *Disasm, i: u32) err[Refusal] {
    val sym:  *mink_object.Symbol = symbol_of(d, i);
    val name: View                = name_of(d, sym.name);
    if (is_kind(sym.kind, symbol.FILE)) {
        put(d, "\t.file ");
        if (!put_string(d, name)) { ret whole(QUOTED); }
        put_char(d, '\n');
        ret err[Refusal].ok{};
    }
    if (is_kind(sym.kind, symbol.SECTION) || mapping_symbol(d, sym)) { ret err[Refusal].ok{}; }
    if (sel sym.version.some)                                        { ret whole(VERSIONED); }
    if (!spell.spellable(name))                                      { ret whole(UNSPELLED); }
    # a default definition is stated under the name of the weak external it stands behind
    if (d.folded.data[i::usize] != 0) { ret err[Refusal].ok{}; }
    ret declared(d, i, name);
}

# the declarations of symbol `i` the text spells `name`: its binding, visibility, type, size, and a value it is given
fun declared(d: *Disasm, i: u32, name: View) err[Refusal] {
    val sym: *mink_object.Symbol = symbol_of(d, i);
    if (name.len == 0) {
        # an anchor stands for a placed local, and a size is a fact it cannot carry
        if (sym.binding != ?symbol.LOCAL || sym.kind != ?symbol.NOTYPE) { ret whole(NAMELESS); }
        if (!sel sym.def.placed || sel sym.size.some)                   { ret whole(NAMELESS); }
        ret err[Refusal].ok{};
    }
    # a weak external with a fallback is bound by the directive of its search, and `.set` names its fallback
    var fallback: View     = View{data: "", len: 0};
    val home:     opt[u32] = defaulted(d, sym);
    if (sel sym.fallback.some) {
        if (sel home.none) {
            fallback = name_of(d, symbol_of(d, sym.fallback.some.symbol.index).name);
            if (fallback.len == 0 || !spell.spellable(fallback)) { ret whole(UNSPELLED); }
        }
    }
    if (sym.binding != ?symbol.LOCAL) {
        var b: opt[str] = core.binding_directive(sym.binding);
        if (sel sym.fallback.some) {
            if (sel home.none) {
                b = core.search_directive(sym.fallback.some.search);
                if (sel b.none) { ret whole(SEARCH); }
            }
        }
        if (sel b.none) { ret whole(BINDING); }
        directive(d, b.some, name);
        put_char(d, '\n');
    }
    if (sym.visibility != ?symbol.DEFAULT) {
        val v: opt[str] = core.visibility_directive(sym.visibility);
        if (sel v.none) { ret whole(VISIBILITY); }
        directive(d, v.some, name);
        put_char(d, '\n');
    }
    if (sym.kind != ?symbol.NOTYPE) {
        val t: opt[str] = core.type_spelling(sym.kind);
        if (sel t.none) { ret whole(TYPE); }
        directive(d, ".type", name);
        put(d, ", ");
        put_char(d, d.s.source.types[0]);
        put(d, t.some);
        put_char(d, '\n');
    }
    if (sel sym.def.entry) { ret whole(ENTRY); }
    if (sel sym.fallback.some) {
        if (sel home.none) {
            directive(d, ".set", name);
            put(d, ", ");
            put_symbol(d, fallback);
            put_char(d, '\n');
        }
    }
    if (sel sym.def.absolute) {
        directive(d, ".set", name);
        put(d, ", ");
        put_unsigned(d, sym.def.absolute);
        put_char(d, '\n');
    }
    if (sel sym.def.common) {
        directive(d, ".comm", name);
        put(d, ", ");
        put_unsigned(d, sym.def.common.size);
        put(d, ", ");
        put_unsigned(d, sym.def.common.align);
        put_char(d, '\n');
        ret err[Refusal].ok{};
    }
    # an undefined symbol's size is the definition's to state
    var sized: opt[u64] = sym.size;
    if (sel sym.def.undefined) { sized = opt[u64].none{}; }
    if (sel home.some)         { sized = symbol_of(d, home.some).size; }
    if (sel sized.some) {
        directive(d, ".size", name);
        put(d, ", ");
        put_unsigned(d, sized.some);
        put_char(d, '\n');
    }
    ret err[Refusal].ok{};
}

# the traits of object `o` that its text in set `s` does not state, which the caller gives the assembler again, as the
# abi row and the trait rows `build.traits` and `build.state` take. the row is the first of the object's architecture
# whose every setting the object holds, none when no row's are, and every trait the object states that is neither that
# row's nor of an axis the text states is appended to `out`: the text states a derived axis by the code it writes, an
# axis an instruction of the set states by that instruction (`stating`), as spir-v's OpMemoryModel its addressing and
# memory models, and the architecture row a fixed one. a text the object holds is borrowed from its store
# ---
# ret: the abi row, or MEMORY with `out` as it was
pub fun unwritten(s: *set.Set, o: *mink_object.Object, out: *vector.Vector[mink_trait.Trait]) res[opt[*mink_arch.Abi], Refusal] {
    val abi:   opt[*mink_arch.Abi] = conventions_of(o);
    val start: usize               = out.len;
    var i:     usize               = 0;
    for (i < table.count[mink_trait.Trait](?o.traits)) {
        val t: *mink_trait.Trait = table.at[mink_trait.Trait](?o.traits, table.nth[mink_trait.Trait](i));
        i = i + 1;
        if (sel t.axis.owner.derived || sel t.axis.owner.fixed) { cnt; }
        if (stating.states_axis(s.statings, t.axis))            { cnt; }
        if (sel abi.some) {
            val stated: opt[mink_trait.Setting] = trait.convention(abi.some, t.axis);
            if (sel stated.some) { cnt; }
        }
        if (!held(vector.push[mink_trait.Trait](out, mink_trait.Trait{axis: t.axis, setting: borrowed_setting(o, t.setting)}))) {
            vector.truncate[mink_trait.Trait](out, start);
            ret res[opt[*mink_arch.Abi], Refusal].err{Refusal{message: MEMORY, section: NO_SECTION, offset: 0}};
        }
    }
    ret res[opt[*mink_arch.Abi], Refusal].ok{abi};
}

# the first abi row of the object's architecture whose every setting the object holds, none when no row's are
fun conventions_of(o: *mink_object.Object) opt[*mink_arch.Abi] {
    val f: *mink_arch.Family = o.target.arch.family;
    var i: usize             = 0;
    for (i < f.abi_count) {
        val row: *mink_arch.Abi = f.abis[i];
        i = i + 1;
        if (row.arch != o.target.arch) { cnt; }
        var k:     usize = 0;
        var holds: bool  = true;
        for (k < row.count && holds) {
            val held: opt[mink_trait.Setting] = mink_object.effective(o, row.settings[k].axis);
            holds = sel held.some && mink_trait.same(held.some, row.settings[k].setting);
            k     = k + 1;
        }
        if (holds) { ret opt[*mink_arch.Abi].some{row}; }
    }
    ret opt[*mink_arch.Abi].none{};
}

# setting `s` of object `o` with the bytes it holds in the object's store borrowed
fun borrowed_setting(o: *mink_object.Object, s: mink_trait.Setting) mink_trait.Setting {
    if (sel s.text) { ret mink_trait.Setting.text{store.Held.borrowed{store.bytes(?o.store, ?s.text)}}; }
    if (sel s.set)  { ret mink_trait.Setting.set{store.Held.borrowed{store.bytes(?o.store, ?s.set)}}; }
    if (sel s.pair) {
        val text: store.Held = store.Held.borrowed{store.bytes(?o.store, ?s.pair.text)};
        ret mink_trait.Setting.pair{mink_trait.Paired{number: s.pair.number, text: text}};
    }
    ret s;
}

# the facts of the object no text of its sections states, refused
fun stated(o: *mink_object.Object) err[Refusal] {
    if (table.count[mink_object.Note](?o.notes) > 0)    { ret whole(NOTES); }
    if (table.count[mink_object.Entry](?o.entries) > 0) { ret whole(ENTRIES); }
    if (sel o.library.some)                             { ret whole(LIBRARY); }
    ret err[Refusal].ok{};
}

# whether the set serves `arch`
fun serves(s: *set.Set, arch: *mink_arch.Arch) bool {
    var i: u32 = 0;
    for (i < s.arches.len) {
        if (s.arches.at[i].arch == arch) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `n` spells `.weak.<w>.default`, the label llvm moves the definition of a bare weak symbol `w` to
fun default_named(w: View, n: View) bool {
    val head: str   = ".weak.";
    val tail: str   = ".default";
    val hn:   usize = str_len(head);
    val tn:   usize = str_len(tail);
    if (n.len != hn + w.len + tn) { ret false; }
    var i: usize = 0;
    for (i < hn) {
        if (n.data[i] != head[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < w.len) {
        if (n.data[hn + i] != w.data[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < tn) {
        if (n.data[hn + w.len + i] != tail[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the default definition of weak external `sym`, written as its own definition, none for a symbol with no such
fun defaulted(d: *Disasm, sym: *mink_object.Symbol) opt[u32] {
    if (sel sym.fallback.none) { ret opt[u32].none{}; }
    val k: u32 = sym.fallback.some.symbol.index;
    if (d.folded.data[k::usize] == 0 || symbol_of(d, d.folded.data[k::usize] - 1) != sym) { ret opt[u32].none{}; }
    ret opt[u32].some{k};
}

# weak external `w`, symbol `n` less one, whose fallback is symbol `at`, folded with its fallback when that is a default definition of its own, no
# relocation naming it (`named_by` counts each symbol's)
fun folded_by(d: *Disasm, w: *mink_object.Symbol, at: u32, n: u32, named_by: *vector.Vector[u32]) {
    if (at >= d.count || named_by.data[at::usize] != 0 || d.folded.data[at::usize] != 0) { ret; }
    val t: *mink_object.Symbol = symbol_of(d, at);
    if (t.binding != ?symbol.LOCAL || t.kind != w.kind)         { ret; }
    if (sel t.fallback.some)                                    { ret; }
    if (!default_named(name_of(d, w.name), name_of(d, t.name))) { ret; }
    if (sel t.def.absolute) {
        if (t.def.absolute != 0) { ret; }
    }
    or (!sel t.def.placed) { ret; }
    d.folded.data[at::usize] = n;
}

# each weak external whose fallback is the dialect's weak search to a local `.weak.<name>.default` of its own kind, that
# no relocation names, which a bare `.weak <name>` states: the default is then written as the name's own definition, or
# not at all when it is the absolute zero of a name never defined
fun fold_defaults(d: *Disasm) err[Refusal] {
    var i: u32 = 0;
    for (i < d.count) {
        if (!held(vector.push[u32](?d.folded, 0))) { ret whole(MEMORY); }
        i = i + 1;
    }
    if (d.dialect.weak == nil) { ret err[Refusal].ok{}; }
    var named_by: vector.Vector[u32] = vector.init[u32](d.a);
    i = 0;
    for (i < d.count) {
        if (!held(vector.push[u32](?named_by, 0))) {
            vector.dnit[u32](?named_by);
            ret whole(MEMORY);
        }
        i = i + 1;
    }
    var k: u32 = 0;
    for (k < table.count[mink_object.Reloc](?d.o.relocs)::u32) {
        val r: *mink_object.Reloc = table.at[mink_object.Reloc](?d.o.relocs, table.nth[mink_object.Reloc](k::usize));
        k = k + 1;
        if (sel r.target.symbol) { named_by.data[r.target.symbol.index::usize] = named_by.data[r.target.symbol.index::usize] + 1; }
        if (sel r.minus.some)    { named_by.data[r.minus.some.index::usize] = named_by.data[r.minus.some.index::usize] + 1; }
    }
    i = 0;
    for (i < d.count) {
        val w: *mink_object.Symbol = symbol_of(d, i);
        i = i + 1;
        if (w.binding != ?symbol.WEAKLY || !sel w.def.undefined) { cnt; }
        if (sel w.fallback.some) {
            if (w.fallback.some.search == d.dialect.weak) { folded_by(d, w, w.fallback.some.symbol.index, i, ?named_by); }
        }
    }
    vector.dnit[u32](?named_by);
    ret err[Refusal].ok{};
}

# the anchors, labels, relocations and bindings indexed in place order
fun index(d: *Disasm) err[Refusal] {
    val folded: err[Refusal] = fold_defaults(d);
    if (sel folded.err) { ret folded; }
    var i: u32 = 0;
    for (i < d.s.bindings.len) {
        val b: *core_fixup.Binding = ?d.s.bindings.at[i];
        i = i + 1;
        if (!core_fixup.binds(b, d.o.target.arch))                                                                                       { cnt; }
        if (!held(vector.push[Bound](?d.bound, Bound{kind: read_back(d, b.kind), written: b.kind, fixup: b.fixup, refines: b.refines}))) { ret whole(MEMORY); }
    }
    sort.sort_by[Bound](d.bound.data, d.bound.len, by_kind);
    val sections: u32 = table.count[mink_object.Section](?d.o.sections)::u32;
    i = 0;
    for (i < table.count[mink_object.Reloc](?d.o.relocs)::u32) {
        val r: *mink_object.Reloc = table.at[mink_object.Reloc](?d.o.relocs, table.nth[mink_object.Reloc](i::usize));
        if (r.section.index >= sections)                                                                    { ret whole(PAST); }
        if (!held(vector.push[Site](?d.sites, Site{section: r.section.index, offset: r.offset, reloc: i}))) { ret whole(MEMORY); }
        if (sel r.target.symbol) {
            val sym: *mink_object.Symbol = symbol_of(d, r.target.symbol.index);
            if (sel sym.def.placed) {
                val sec: u32 = sym.def.placed.section.index;
                if (sec >= sections)                                                                                                                                { ret whole(PAST); }
                if (is_kind(sym.kind, symbol.SECTION) && !held(vector.push[Label](?d.anchors, Label{section: sec, offset: anchored(d, sec, r.addend), handle: 0}))) { ret whole(MEMORY); }
            }
        }
        # the section a difference subtracts is named by the anchor at its start
        if (sel r.minus.some) {
            val sym: *mink_object.Symbol = symbol_of(d, r.minus.some.index);
            if (sel sym.def.placed) {
                val sec: u32 = sym.def.placed.section.index;
                if (sec >= sections)                                                                                                       { ret whole(PAST); }
                if (is_kind(sym.kind, symbol.SECTION) && !held(vector.push[Label](?d.anchors, Label{section: sec, offset: 0, handle: 0}))) { ret whole(MEMORY); }
            }
        }
        i = i + 1;
    }
    # an owner its name does not single out is named by an anchor at its start
    i = 0;
    for (i < sections) {
        val owner: opt[u32] = owner_of(d, i);
        if (sel owner.some) {
            if (anchors_owner(d, i) && !held(vector.push[Label](?d.anchors, Label{section: owner.some, offset: 0, handle: 0}))) { ret whole(MEMORY); }
        }
        i = i + 1;
    }
    sort.sort_by[Site](d.sites.data, d.sites.len, by_site);
    val cleared: err[Refusal] = clear_fields(d);
    if (sel cleared.err) { ret cleared; }
    i = 0;
    # the mapping symbols are read before the labels, so a section's marks are in place order when it is written
    for (i < d.count) {
        val sym:    *mink_object.Symbol = symbol_of(d, i);
        var p:      mink_object.Place   = mink_object.Place{section: table.Id[mink_object.Section]{index: 0}, offset: 0};
        var placed: bool                = false;
        if (sel sym.def.placed) {
            p      = sym.def.placed;
            placed = true;
        }
        if (placed && !is_kind(sym.kind, symbol.SECTION) && !is_kind(sym.kind, symbol.FILE)) {
            if (p.section.index >= sections) { ret whole(PAST); }
            if (mapping_symbol(d, sym)) {
                val code: bool = marks_code(d, name_of(d, sym.name));
                if (!held(vector.push[Mapped](?d.marks, Mapped{section: p.section.index, offset: p.offset, code: code, basis: 0, name: name_of(d, sym.name)}))) { ret whole(MEMORY); }
            }
            or (name_of(d, sym.name).len == 0) {
                if (!held(vector.push[Label](?d.anchors, Label{section: p.section.index, offset: p.offset, handle: 0}))) { ret whole(MEMORY); }
            }
            or {
                if (!held(vector.push[Label](?d.labels, Label{section: p.section.index, offset: p.offset, handle: i + 1}))) { ret whole(MEMORY); }
            }
        }
        i = i + 1;
    }
    sort.sort_by[Mapped](d.marks.data, d.marks.len, by_mark);
    val based: err[Refusal] = mark_bases(d);
    if (sel based.err) { ret based; }
    val rows: err[Refusal] = marked_rows(d);
    if (sel rows.err) { ret rows; }
    sort.sort_by[Label](d.labels.data, d.labels.len, by_place);
    val targets: err[Refusal] = branch_targets(d);
    if (sel targets.err) { ret targets; }
    # the anchors kept once per place, each numbered by the lowest number no name of the object spells with the stem
    sort.sort_by[Label](d.anchors.data, d.anchors.len, by_place);
    var kept: usize = 0;
    var k:    usize = 0;
    for (k < d.anchors.len) {
        val a: Label = d.anchors.data[k];
        if (kept == 0 || d.anchors.data[kept - 1].section != a.section || d.anchors.data[kept - 1].offset != a.offset) {
            d.anchors.data[kept] = a;
            kept                 = kept + 1;
        }
        k = k + 1;
    }
    vector.truncate[Label](?d.anchors, kept);
    var next: u32 = 0;
    k = 0;
    for (k < d.anchors.len) {
        for {
            val n: usize = stemmed(d.dialect.temporary, next, ?d.scratch[0]);
            next = next + 1;
            val spelled: opt[table.Id[intern.Name]] = intern.find(?d.o.names, ?d.scratch[0], n);
            if (sel spelled.none) { brk; }
        }
        d.anchors.data[k].handle = next - 1;
        val a: Label = d.anchors.data[k];
        if (!held(vector.push[Label](?d.labels, Label{section: a.section, offset: a.offset, handle: d.count + 1 + k::u32}))) { ret whole(MEMORY); }
        k = k + 1;
    }
    sort.sort_by[Label](d.labels.data, d.labels.len, by_place);
    val filled: err[Refusal] = groups_filled(d);
    if (sel filled.err) { ret filled; }
    ret counted(d);
}

# refused when a group of the object holds no section, which the text states only by the sections in it
fun groups_filled(d: *Disasm) err[Refusal] {
    val n: usize = table.count[mink_object.Group](?d.o.groups)::usize;
    if (n == 0) { ret err[Refusal].ok{}; }
    var held_: vector.Vector[bool] = vector.init[bool](d.a);
    if (!held(vector.reserve[bool](?held_, n))) { ret whole(MEMORY); }
    var k: usize = 0;
    for (k < n) {
        held_.data[k] = false;
        k             = k + 1;
    }
    var i: usize = 0;
    for (i < table.count[mink_object.Section](?d.o.sections)::usize) {
        val g: opt[table.Id[mink_object.Group]] = table.at[mink_object.Section](?d.o.sections, table.nth[mink_object.Section](i)).group;
        if (sel g.some) {
            if (g.some.index::usize < n) { held_.data[g.some.index::usize] = true; }
        }
        i = i + 1;
    }
    var all: bool = true;
    k = 0;
    for (k < n) {
        all = all && held_.data[k];
        k   = k + 1;
    }
    vector.dnit[bool](?held_);
    if (!all) { ret whole(EMPTY); }
    ret err[Refusal].ok{};
}

# how many relocations name each handle, those whose target the text cannot name left out
fun counted(d: *Disasm) err[Refusal] {
    val handles: usize = d.count::usize + d.anchors.len;
    if (!held(vector.reserve[u32](?d.refs, handles))) { ret whole(MEMORY); }
    var h: usize = 0;
    for (h < handles) {
        d.refs.data[h] = 0;
        h              = h + 1;
    }
    vector.truncate[u32](?d.refs, handles);
    var j: usize = 0;
    for (j < d.sites.len) {
        val site:  *Site                    = ?d.sites.data[j];
        val aimed: res[opt[Aimed], Refusal] = aim(d, reloc_of(d, site), site);
        j = j + 1;
        if (sel aimed.ok) {
            val got: opt[Aimed] = aimed.ok;
            if (sel got.some) { d.refs.data[got.some.handle::usize - 1] = d.refs.data[got.some.handle::usize - 1] + 1; }
        }
    }
    ret err[Refusal].ok{};
}

# the label at `at` of section `section` a sequence there may bind itself, as `lla` binds the label its `%pcrel_lo`
# names, operand.NO_SYMBOL for none: an anchor, or a local symbol of no type or size the syntax's own stem spells, as
# the assembler made it, that one relocation alone names, so the text read back binds a label of its own there
fun pair_label(d: *Disasm, section: u32, at: u64) u32 {
    if (str_len(d.syntax.own) == 0) { ret operand.NO_SYMBOL; }
    var i: usize = d.li;
    for (i < d.labels.len && d.labels.data[i].section == section && d.labels.data[i].offset == at) {
        val h: u32 = d.labels.data[i].handle;
        i = i + 1;
        if (d.refs.data[h::usize - 1] != 1) { cnt; }
        if (h > d.count)                    { ret h; }
        val sym: *mink_object.Symbol = symbol_of(d, h - 1);
        if (sym.binding != ?symbol.LOCAL || sym.kind != ?symbol.NOTYPE || sel sym.size.some) { cnt; }
        if (stems(name_of(d, sym.name), d.syntax.own, false))                                { ret h; }
    }
    ret operand.NO_SYMBOL;
}

# the label a sequence the parser read binds of its own, core_syntax.OWN, in the `count` steps of `ex`, named `here`
fun owned(ex: *relax.Expansion, here: u32) {
    var i: u32 = 0;
    for (i < ex.count) {
        var k: u32 = 0;
        for (k < ex.steps[i].row.operands.len) {
            val v: *operand.Value = ?ex.steps[i].values[k];
            if (sel v.symbol) {
                if (v.symbol.id == core_syntax.OWN) { v.symbol.id = here; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

# the directive of the dialect that sets a mode to a value other than the one `modes` hold it at, the `n`-th such, none
# past the last
fun mode_change(d: *Disasm, modes: *mode.State, n: u32) opt[*source.Directive] {
    val ds:   source.Directives = d.s.source.directives;
    var seen: u32               = 0;
    var i:    u32               = 0;
    for (i < ds.len) {
        val e: source.Edit = ds.at[i].edit;
        if (sel e.mode) {
            var one: mode.Settings = mode.Settings{at: ?e.mode, len: 1};
            if (!mode.holds(modes, one)) {
                if (seen == n) { ret opt[*source.Directive].some{?ds.at[i]}; }
                seen = seen + 1;
            }
        }
        i = i + 1;
    }
    ret opt[*source.Directive].none{};
}

# the sequence at `at` that binds the label `d.here` at its first instruction itself, as `lla a0, x` binds the label
# its `%pcrel_lo` names, written by the first spelling of the syntax that reads back to its bytes and relocations under
# the modes in force or, after the dialect's directive that sets it, under another value of one mode, as `la` loads
# from the global offset table under pic. answering how many bytes it takes, 0 when none reads back
fun pair(d: *Disasm, section: u32, data: *u8, len: usize, at: u64, limit: u64) res[u64, Refusal] {
    if (!decode_step(d, 0, data, len, at, limit)) { ret res[u64, Refusal].ok{0}; }
    val start: usize      = d.out.len;
    val first: *row.Row   = d.steps[0].ins.row;
    var q_at:  u32        = seq.first_of(d.syntax, d.s.codec.rows, first);
    val saved: mode.State = d.modes;
    for (q_at < d.syntax.sequences.len && d.syntax.sequences.at[q_at].steps.at[0].row == first) {
        val q: *core_syntax.Sequence = ?d.syntax.sequences.at[q_at];
        q_at = q_at + 1;
        val n: u32 = q.steps.len;
        if (n < 2 || n > relax.MAX_STEPS) { cnt; }
        var k:  u32  = 1;
        var ok: bool = true;
        for (k < n && ok) {
            val prior: *Step = ?d.steps[k - 1];
            ok = decode_step(d, k, data, len, prior.at + prior.len::u64, limit);
            k  = k + 1;
        }
        if (!ok) { cnt; }
        val last: *Step = ?d.steps[n - 1];
        val stop: u64   = last.at + last.len::u64;
        val end:  usize = sites_before(d, section, stop);
        d.names = 0;
        if (!note(d, d.here)) { cnt; }
        k = 0;
        for (k < n && ok) {
            val given: res[bool, Refusal] = take(d, ?d.steps[k], d.ri, end);
            if (sel given.err) { ret res[u64, Refusal].err{given.err}; }
            ok = given.ok;
            k  = k + 1;
        }
        if (!ok) { cnt; }
        var steps: [relax.MAX_STEPS]inst.Inst;
        k = 0;
        for (k < n) {
            steps[k] = d.steps[k].ins;
            k        = k + 1;
        }
        # the modes in force, then each value of a mode the dialect sets another than it holds
        var tried: u32 = 0;
        for {
            vector.truncate[u8](d.out, start);
            d.modes = saved;
            if (tried > 0) {
                val dir: opt[*source.Directive] = mode_change(d, ?saved, tried - 1);
                if (sel dir.none) { brk; }
                val e:     source.Edit = dir.some.edit;
                var moved: bool        = false;
                if (sel e.mode) { moved = mode.change(?d.modes, e.mode); }
                if (!moved)     { brk; }
                put_line(d, dir.some);
            }
            tried = tried + 1;
            put_char(d, '\t');
            val text:    usize                    = d.out.len;
            var w:       core_syntax.Writer       = writer(d);
            val got:     res[bool, field.Refusal] = print.sequence(?w, ?steps[0], n, d.here);
            var spelled: bool                     = false;
            if (sel got.ok) { spelled = got.ok; }
            if (!spelled)   { cnt; }
            var ex: relax.Expansion;
            if (d.full || !reparse(d, text, ?ex)) { cnt; }
            owned(?ex, d.here);
            if (!matches(d, section, ?ex, data, len, at, stop, d.ri, end)) { cnt; }
            put_char(d, '\n');
            val left: err[Refusal] = put_stated(d);
            if (sel left.err) {
                vector.truncate[u8](d.out, start);
                d.modes = saved;
                ret res[u64, Refusal].err{left.err};
            }
            d.ri   = end;
            d.read = n;
            ret res[u64, Refusal].ok{stop - at};
        }
    }
    vector.truncate[u8](d.out, start);
    d.modes = saved;
    ret res[u64, Refusal].ok{0};
}

# the set's rows that take a marker operand
fun marked_rows(d: *Disasm) err[Refusal] {
    val rows: row.Rows = d.s.codec.rows;
    var i:    u32      = 0;
    for (i < rows.len) {
        val r: *row.Row = ?rows.at[i];
        var k: u32      = 0;
        for (k < r.operands.len) {
            if (sel r.operands.at[k].shape.marker) {
                if (!held(vector.push[*row.Row](?d.marked, r))) { ret whole(MEMORY); }
                brk;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# an instruction decoded where the code of a section is read for its targets
rec Decoded {
    at:  u64;
    len: u64;
}

fun by_start(x: *Decoded, y: *Decoded) i64 {
    if (x.at < y.at) { ret -1; }
    if (x.at > y.at) { ret 1; }
    ret 0;
}

# whether `to` lies strictly inside one of the instructions `spans` holds, in start order
fun splits(spans: *vector.Vector[Decoded], to: u64) bool {
    var lo: usize = 0;
    var hi: usize = spans.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (spans.data[mid].at <= to) { lo = mid + 1; }
        or                            { hi = mid; }
    }
    if (lo == 0) { ret false; }
    val before: *Decoded = ?spans.data[lo - 1];
    ret to > before.at && to < before.at + before.len;
}

# the length of the sequence a relocation at `at` of section `section` covers, its instructions decoded up to `limit`, 0
# when none covers more than its own instruction or they do not decode. it decodes into the steps past the first
fun sequence_len(d: *Disasm, section: u32, data: *u8, len: usize, at: u64, limit: u64) u64 {
    var want: Site  = Site{section: section, offset: at, reloc: 0};
    var lo:   usize = 0;
    var hi:   usize = d.sites.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (by_site(?d.sites.data[mid], ?want) < 0) { lo = mid + 1; }
        or                                          { hi = mid; }
    }
    var end: usize = lo;
    for (end < d.sites.len && d.sites.data[end].section == section && d.sites.data[end].offset == at) {
        end = end + 1;
    }
    val sp: opt[*core_fixup.Span] = span_at(d, at, lo, end);
    if (sel sp.none)                     { ret 0; }
    if (sp.some.count > relax.MAX_STEPS) { ret 0; }
    var to: u64 = at + d.steps[0].len::u64;
    var k:  u32 = 1;
    for (k < sp.some.count) {
        if (!decode_step(d, k, data, len, to, limit)) { ret 0; }
        to = to + d.steps[k].len::u64;
        k  = k + 1;
    }
    ret to - at;
}

# an anchor at the target of every relative operand of an instruction the code of a section holds whose value the
# assembler resolved, with no relocation left: one inside its section that splits no instruction decoded there, read
# under the object's selection as its mapping symbols or else its flags mark code. a target outside its section, or one
# that splits an instruction, has no label to name it, and its instruction keeps its number
fun branch_targets(d: *Disasm) err[Refusal] {
    var spans:   vector.Vector[Decoded] = vector.init[Decoded](d.a);
    var targets: vector.Vector[u64]     = vector.init[u64](d.a);
    var done:    err[Refusal]           = err[Refusal].ok{};
    var m:       usize                  = 0;
    var i:       u32                    = 0;
    for (i < table.count[mink_object.Section](?d.o.sections)::u32 && sel done.ok) {
        val sec:  *mink_object.Section = section_of(d, i);
        val size: u64                  = size_of(d, i);
        var code: bool                 = (sec.flags & mink_section.EXEC) != 0;
        vector.truncate[Decoded](?spans, 0);
        vector.truncate[u64](?targets, 0);
        d.v = d.scopes.data[0].v;
        if (sel sec.contents.held) {
            val bytes: store.Bytes = contents(d, i);
            var at:    u64         = 0;
            for (at < size && sel done.ok) {
                for (m < d.marks.len && d.marks.data[m].section == i && d.marks.data[m].offset <= at) {
                    code = d.marks.data[m].code;
                    if (code) { d.v = d.scopes.data[d.bases.data[d.marks.data[m].basis].first].v; }
                    m = m + 1;
                }
                var next: u64 = size;
                if (m < d.marks.len && d.marks.data[m].section == i) { next = d.marks.data[m].offset; }
                if (!code) {
                    at = next;
                    cnt;
                }
                if (!decode_step(d, 0, bytes.data, bytes.len, at, next)) {
                    var unit: u64 = d.s.parcel(bytes.data, bytes.len, at::usize)::u64;
                    if (unit == 0 || at + unit > next) { unit = next - at; }
                    at = at + unit;
                    cnt;
                }
                val st:   *Step = ?d.steps[0];
                val step: u64   = st.len::u64;
                # a sequence a relocation covers, as a call pair, is one statement, which a label inside would split
                var whole_: u64 = sequence_len(d, i, bytes.data, bytes.len, at, next);
                if (whole_ < step)                                                     { whole_ = step; }
                if (!held(vector.push[Decoded](?spans, Decoded{at: at, len: whole_}))) { done = whole(MEMORY); }
                var k: u32 = 0;
                for (k < st.ins.count) {
                    val desc: *operand.Operand = ?st.ins.row.operands.at[k];
                    if (sel desc.shape.relative) {
                        if (sel st.values.data[k].relative) {
                            val to: opt[u64] = target_of(at, st.len, desc, st.values.data[k].relative);
                            if (sel to.some) {
                                if (to.some <= size && !held(vector.push[u64](?targets, to.some))) { done = whole(MEMORY); }
                            }
                        }
                    }
                    k = k + 1;
                }
                at = at + whole_;
            }
        }
        for (m < d.marks.len && d.marks.data[m].section == i) {
            m = m + 1;
        }
        sort.sort_by[Decoded](spans.data, spans.len, by_start);
        var t: usize = 0;
        for (t < targets.len && sel done.ok) {
            val to:    u64      = targets.data[t];
            val named: opt[u32] = local_label_at(d, i, to);
            if (!splits(?spans, to) && sel named.none && !held(vector.push[Label](?d.anchors, Label{section: i, offset: to, handle: 0}))) { done = whole(MEMORY); }
            t = t + 1;
        }
        i = i + 1;
    }
    vector.dnit[Decoded](?spans);
    vector.dnit[u64](?targets);
    d.v = d.scopes.data[0].v;
    ret done;
}

fun released(d: *Disasm) {
    vector.dnit[Located](?d.rows);
    vector.dnit[Label](?d.labels);
    vector.dnit[Site](?d.sites);
    vector.dnit[Label](?d.anchors);
    vector.dnit[u32](?d.folded);
    vector.dnit[Mapped](?d.marks);
    vector.dnit[*row.Row](?d.marked);
    cmp.release(?d.expansions);
    vector.dnit[u32](?d.refs);
    vector.dnit[Bound](?d.bound);
    vector.dnit[usize](?d.stated);
    var i: usize = 0;
    for (i < d.scopes.len) {
        val sc: *Scope = ?d.scopes.data[i];
        vector.dnit[*fill.Pattern](?sc.fills);
        if (sc.kept != nil) { narrow.release(d.a, sc.kept); }
        i = i + 1;
    }
    vector.dnit[Scope](?d.scopes);
    i = 0;
    for (i < d.bases.len) {
        if (d.bases.data[i].kept != nil) { narrow.release(d.a, d.bases.data[i].kept); }
        vector.dnit[usize](?d.bases.data[i].members);
        i = i + 1;
    }
    vector.dnit[Basis](?d.bases);
    vector.dnit[u8](?d.bytes);
    vector.dnit[u8](?d.cleared);
    vector.dnit[usize](?d.starts);
    vector.dnit[field.Fixup](?d.fixups);
    core_syntax.release(?d.stores);
    var k: u32 = 0;
    for (k < relax.MAX_STEPS) {
        vector.dnit[operand.Value](?d.steps[k].values);
        k = k + 1;
    }
}

fun written(d: *Disasm) err[Refusal] {
    val scoped_: err[Refusal] = scopes(d, d.v);
    if (sel scoped_.err) { ret scoped_; }
    val indexed: err[Refusal] = index(d);
    if (sel indexed.err) { ret indexed; }
    # the scopes the code marks name are made since, so the scope in force is taken from where they now are
    d.v     = d.scopes.data[0].v;
    d.fills = ?d.scopes.data[0].fills;
    val rowed: err[Refusal] = line_rows(d);
    if (sel rowed.err) { ret rowed; }
    var i: u32 = 0;
    for (i < d.count) {
        val declared: err[Refusal] = declare(d, i);
        if (sel declared.err) { ret declared; }
        i = i + 1;
    }
    val filed: err[Refusal] = files(d);
    if (sel filed.err) { ret filed; }
    i = 0;
    for (i < table.count[mink_object.Section](?d.o.sections)::u32) {
        var done: err[Refusal] = err[Refusal].ok{};
        if (raised(d, i)) { done = unstated(d, i); }
        or                { done = section(d, i); }
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    if (d.full) { ret whole(MEMORY); }
    ret err[Refusal].ok{};
}

# the object file `bytes` holds, read into mink's neutral model through the format of `formats` its magic names, which
# the caller releases. the bytes outlive it, as a format may borrow them
pub fun read(formats: *registry.Registry, a: *A.Allocator, bytes: *contract.Input) res[mink_object.Object, fail.Fail] {
    val got: res[contract.Model, fail.Fail] = registry.read(formats, a, bytes);
    if (sel got.err) { ret res[mink_object.Object, fail.Fail].err{got.err}; }
    var m:         contract.Model     = got.ok;
    var o:         mink_object.Object = mink_object.make(a, nil, nil);
    val converted: err[fail.Fail]     = contract.to_neutral(?m, ?formats.relocs, ?o);
    val released:  err[fail.Fail]     = contract.release(?m);
    if (sel converted.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, fail.Fail].err{fail.in_file(converted.err, bytes.file)};
    }
    if (sel released.err) {
        mink_object.release(?o);
        ret res[mink_object.Object, fail.Fail].err{released.err};
    }
    ret res[mink_object.Object, fail.Fail].ok{o};
}

# an object file loaded whole through the format registry and read into mink's neutral model, which may borrow from
# the loaded file
# ---
# format: the format its magic names, whose assembly dialect the text it disassembles to is read back in
pub rec File {
    loaded: registry.Loaded;
    object: mink_object.Object;
    format: *mink_format.Format;
}

# the object file at `path` loaded through `formats` and read, which `close` gives back
pub fun open(formats: *registry.Registry, a: *A.Allocator, path: str) res[File, fail.Fail] {
    val loaded: res[registry.Loaded, fail.Fail] = registry.load(formats, a, path);
    if (sel loaded.err) { ret res[File, fail.Fail].err{loaded.err}; }
    var f:         File           = File{loaded: loaded.ok, object: mink_object.make(a, nil, nil), format: loaded.ok.model.reader.format};
    val converted: err[fail.Fail] = contract.to_neutral(?f.loaded.model, ?formats.relocs, ?f.object);
    if (sel converted.err) {
        val released: err[fail.Fail] = mink_object.release(?f.object);
        val unloaded: err[fail.Fail] = registry.unload(?f.loaded);
        ret res[File, fail.Fail].err{fail.in_file(converted.err, path)};
    }
    ret res[File, fail.Fail].ok{f};
}

# everything `f` holds given back, reporting the first refusal
pub fun close(f: *File) err[fail.Fail] {
    val released: err[fail.Fail] = mink_object.release(?f.object);
    val unloaded: err[fail.Fail] = registry.unload(?f.loaded);
    if (sel released.err) { ret released; }
    ret unloaded;
}

# how the format the options read back in holds an object's traits, none for a format that encodes none
fun traits_of(options: Options) *contract.TraitCodec {
    val c: res[*contract.TraitCodec, fail.Fail] = registry.traits(options.formats, options.dialect.format);
    if (sel c.err) { ret ?contract.NO_TRAITS; }
    ret c.ok;
}

# the sections of `o` appended to `out` as statements and data of the set `s`, decoded under `v`, whose stream the
# caller has begun, each opened by the directive that enters it when `headed`
fun sectioned(a: *A.Allocator, s: *set.Set, v: *state.Context, options: Options, o: *mink_object.Object, out: *vector.Vector[u8], headed: bool) err[Refusal] {
    if (s.parcel == nil) { ret whole(NO_PARCEL); }
    val naming: res[*contract.Naming, fail.Fail] = registry.naming(options.formats, options.dialect.format);
    if (sel naming.err) { ret whole(naming.err.text); }
    val facts: err[Refusal] = stated(o);
    if (sel facts.err) { ret facts; }
    var i:   u32      = 0;
    var one: opt[str] = opt[str].none{};
    for (i < s.source.widths.len && sel one.none) {
        if (s.source.widths.at[i].width == 1) { one = opt[str].some{s.source.widths.at[i].name}; }
        i = i + 1;
    }
    var index: cmp.Expansions;
    if (!cmp.expansions(a, s.codec, s.compress, ?index)) { ret whole(MEMORY); }
    var d: Disasm = Disasm{
        a:          a,
        s:          s,
        v:          v,
        syntax:     ?s.syntaxes.at[options.syntax],
        dialect:    options.dialect,
        naming:     naming.ok,
        modes:      mode.initial(?s.assembly),
        pushed:     mode.initial(?s.assembly),
        o:          o,
        out:        out,
        labels:     vector.init[Label](a),
        sites:      vector.init[Site](a),
        anchors:    vector.init[Label](a),
        folded:     vector.init[u32](a),
        marks:      vector.init[Mapped](a),
        marked:     vector.init[*row.Row](a),
        expansions: index,
        refs:       vector.init[u32](a),
        here:       operand.NO_SYMBOL,
        mapping:    build.mapping_of(options.formats, o.target.arch, options.dialect.format),
        mi:         0,
        headed:     headed,
        stating:    NONE_STATED,
        stated:     vector.init[usize](a),
        traits:     traits_of(options),
        relocs:     registry.relocations(options.formats, options.dialect.format, o.target.arch),
        bound:      vector.init[Bound](a),
        fills:      nil,
        scopes:     vector.init[Scope](a),
        now:        0,
        under:      0,
        bases:      vector.init[Basis](a),
        basis:      0,
        read:       0,
        bytes:      vector.init[u8](a),
        cleared:    vector.init[u8](a),
        starts:     vector.init[usize](a),
        fixups:     vector.init[field.Fixup](a),
        count:      table.count[mink_object.Symbol](?o.symbols)::u32,
        byte:       one,
        li:         0,
        ri:         0,
        apart:      0,
        full:       false,
        forms:      options.spelling == FORMS,
        names:      0,
        stores:     core_syntax.stores(a),
        rows:       vector.init[Located](a),
        xi:         0,
        spoken:     lines.UNSPOKEN,
        pending:    false,
    };
    var k: u32 = 0;
    for (k < relax.MAX_STEPS) {
        d.steps[k].values = vector.init[operand.Value](a);
        k                 = k + 1;
    }
    d.symbols = core_syntax.Symbols{context: (?d)::ptr, resolve: resolved, name: named};
    val done: err[Refusal] = written(?d);
    released(?d);
    ret done;
}

# the module `model` appended to `out` as the statements of the one section `stream_` makes of its instruction
# stream, with no directive entering it, a refusal at a place of it named at its offset in the module's bytes
fun streamed(a: *A.Allocator, s: *set.Set, v: *state.Context, options: Options, model: *contract.Model, stream_: fun(ptr, *mink_object.Object) res[u64, fail.Fail], out: *vector.Vector[u8]) err[Refusal] {
    var one:  mink_object.Object  = mink_object.make(a, nil, nil);
    val at:   res[u64, fail.Fail] = stream_(model.data, ?one);
    var done: err[Refusal]        = err[Refusal].ok{};
    if (sel at.err) { done = whole(at.err.text); }
    or (sel at.ok) {
        val wrote: err[Refusal] = sectioned(a, s, v, options, ?one, out, false);
        done = wrote;
        if (sel wrote.err) {
            if (wrote.err.section != NO_SECTION) { done = refusal(wrote.err.message, IN_MODULE, at.ok + wrote.err.offset); }
        }
    }
    val released_: err[fail.Fail] = mink_object.release(?one);
    ret done;
}

# the offset of the first byte `x` and `y` differ at, none for the same bytes
fun differs(x: *sink.Sink, y: *sink.Sink) opt[u64] {
    val p: *u8   = sink.data(x);
    val q: *u8   = sink.data(y);
    var n: usize = sink.len(x);
    if (sink.len(y) < n) { n = sink.len(y); }
    var i: usize = 0;
    for (i < n) {
        if (p[i] != q[i]) { ret opt[u64].some{i::u64}; }
        i = i + 1;
    }
    if (sink.len(x) != sink.len(y)) { ret opt[u64].some{n::u64}; }
    ret opt[u64].none{};
}

# the module `model` appended to `out` as the text `p` prints of it, refused when the bytes the format writes of the
# module the text reads back to are not the ones it writes of `model`, at the first that differs
fun printed(a: *A.Allocator, v: *state.Context, model: *contract.Model, p: stream.Printed, out: *vector.Vector[u8]) err[Refusal] {
    val start: usize    = out.len;
    val wrote: err[str] = p.print(model.data, v, out);
    if (sel wrote.err) { ret whole(wrote.err); }
    val want: res[sink.Sink, fail.Fail] = contract.write(model);
    if (sel want.err) { ret whole(want.err.text); }
    var w:    sink.Sink                     = want.ok;
    val back: res[sink.Sink, stream.Unread] = p.read(a, ?out.data[start], out.len - start, diagnostic.START, v);
    var done: err[Refusal]                  = err[Refusal].ok{};
    if (sel back.err) {
        if (sel back.err.text)    { done = whole(back.err.text.message); }
        or (sel back.err.written) { done = whole(back.err.written.text); }
    }
    or (sel back.ok) {
        var b:    sink.Sink = back.ok;
        val diff: opt[u64]  = differs(?w, ?b);
        if (sel diff.some) { done = refusal(REREAD, IN_MODULE, diff.some); }
        val dropped: err[fail.Fail] = sink.release(?b);
    }
    val dropped: err[fail.Fail] = sink.release(?w);
    ret done;
}

# the object `o` appended to `out` as the text of the module the format of the dialect `options` names builds from
# it, as `m` states the module, decoded under `v`, whose stream the caller has begun
fun module_text(a: *A.Allocator, s: *set.Set, v: *state.Context, options: Options, o: *mink_object.Object, m: *stream.Module, out: *vector.Vector[u8]) err[Refusal] {
    val built: res[contract.Model, fail.Fail] = registry.from_neutral(options.formats, options.dialect.format, a, o);
    if (sel built.err) { ret whole(built.err.text); }
    var model: contract.Model = built.ok;
    var done:  err[Refusal]   = err[Refusal].ok{};
    if (sel m.stream)  { done = streamed(a, s, v, options, ?model, m.stream, out); }
    or (sel m.printed) { done = printed(a, v, ?model, m.printed, out); }
    val released_: err[fail.Fail] = contract.release(?model);
    ret done;
}

# the object `o` appended to `out` as assembly text of the set `s` as `options` asks, decoded under the object's context
# `object`, which the caller makes with `set.open` for the object's architecture: as its sections, or as the module its
# format builds where the dialect's text states one
# ---
# a:   the allocator of the disassembler's own indices, given back before it returns
# ret: ok, or the first refusal with `out` as it was
pub fun disassemble(a: *A.Allocator, s: *set.Set, object: *state.Context, options: Options, o: *mink_object.Object, out: *vector.Vector[u8]) err[Refusal] {
    if (!serves(s, o.target.arch))        { ret whole(ARCH); }
    if (options.syntax >= s.syntaxes.len) { ret whole(NO_SYNTAX); }
    # a typed stream's state is the disassembly's, begun with it, which every scope of the object reads
    var v: state.Context = @object;
    val h: *stream.Hooks = s.codec.stream;
    if (h != nil) {
        if (object.stream != nil) { ret whole(STREAMED); }
        val made: res[ptr, A.Error] = h.make(a);
        if (sel made.err) { ret whole(MEMORY); }
        h.begin(made.ok);
        v.stream = made.ok;
    }
    fin {
        if (h != nil) { h.release(a, v.stream); }
    }
    val start: usize        = out.len;
    var done:  err[Refusal] = err[Refusal].ok{};
    if (options.dialect.module == nil) { done = sectioned(a, s, ?v, options, o, out, true); }
    or                                 { done = module_text(a, s, ?v, options, o, options.dialect.module, out); }
    if (sel done.err)                  { vector.truncate[u8](out, start); }
    ret done;
}
