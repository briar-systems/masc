fwd masc.core.register;
fwd masc.core.relax;
fwd masc.core.requirement;
fwd masc.core.row;
fwd masc.core.set;
fwd masc.core.spelling;
fwd masc.core.walk;
fwd masc.isa.isa;
fwd riscv_catalog:   masc.isa.riscv.catalog;
fwd riscv_compress:  masc.isa.riscv.compress;
fwd riscv_csr:       masc.isa.riscv.csr;
fwd riscv_extension: masc.isa.riscv.extension;
