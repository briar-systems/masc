# the assembler of the mach toolchain, as a library
#
# each module forwarded here is the public surface, and every other module of
# src is internal to masc and may change without notice: the assembler, the
# checks, the codec, the syntaxes and the tools. the generated tables of each
# set are public, as a consumer names their rows, registers and extensions in
# static tables, while the modules that build on them are not. the registry
# is the route to a set by architecture, and the format dialects to a
# listing. a dependent imports only through this list by practice and review
# holds the line, as nothing in the build marks or enforces it. a change to a
# module on the list carries a Consumer changes section naming its downstream
# port.

# the startup a test dispatcher of this library links
use std.runtime;
# modules no forwarded module reaches, whose tests run with the library's
use masc.asm.asm;
use asm_line: masc.asm.line;
use masc.disasm.disasm;
use emit_line:        masc.emit.line;
use aarch64_field:    masc.isa.aarch64.field;
use aarch64_register: masc.isa.aarch64.register;
use x86_encoding:     masc.isa.x86.encoding;
use x86_register:     masc.isa.x86.register;
use masc.tool.help;
use masc.tool.info;
use masc.tool.object;
use masc.tool.render;
use masc.tool.target;
use masc.tool.text;

fwd masc.core.requirement;
fwd masc.core.state;
fwd masc.core.extension;
fwd masc.core.quantity;
fwd masc.core.register;
fwd masc.core.operand;
fwd masc.core.row;
fwd masc.core.inst;
fwd masc.core.effect;
fwd masc.core.footprint;
fwd masc.core.ct;
fwd masc.core.config;
fwd masc.core.set;
fwd masc.core.relax;
fwd masc.build.build;
fwd masc.emit.emit;
fwd masc.emit.listing;
fwd masc.inline.inline;
fwd masc.walk.walk;
fwd masc.isa.isa;
fwd masc.format.dialect;
fwd aarch64_gen_extension: masc.isa.aarch64.gen_extension;
fwd aarch64_gen_register:  masc.isa.aarch64.gen_register;
fwd riscv_gen_extension:   masc.isa.riscv.gen_extension;
fwd riscv_gen_register:    masc.isa.riscv.gen_register;
fwd riscv_gen_row:         masc.isa.riscv.gen_row;
fwd riscv_gen_row_index:   masc.isa.riscv.gen_row_index;
fwd x86_gen_extension:     masc.isa.x86.gen_extension;
fwd x86_gen_register:      masc.isa.x86.gen_register;
fwd x86_gen_row_index:     masc.isa.x86.gen_row_index;
fwd x86_isa_set:           masc.isa.x86.isa_set;
