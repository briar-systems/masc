# the assembler of the mach toolchain, as a library
#
# the public surface of masc, so consumers write `use masc;` and reach its
# parts through it.

# the startup a test dispatcher of this library links
use std.runtime;

fwd masc.asm.asm;
fwd masc.asm.line;
fwd masc.asm.model;
fwd masc.asm.source;
fwd masc.build.build;
fwd masc.emit.emit;
fwd lines: masc.emit.line;
