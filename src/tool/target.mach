# a target resolved from its spellings
#
# mink's catalog resolves the target a caller names, its system, environment,
# architecture, abi and instruction set, every default applied there, and
# masc's `masc.isa.check` finds the set serving the architecture and closes
# the selection of its instruction set and extensions once. what is left is
# the set's syntax rows naming its syntaxes, its mode rows reading each mode
# flag and the context the selection opens. nothing here reads a spelling or
# selects again, so a set whose selection is an ISA string, a level or a
# feature list needs nothing of this module.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;

use mink.base.fail;
use mink_arch:     mink.catalog.arch;
use mink_registry: mink.format.registry;

use masc.asm.model;
use masc.core.diagnostic;
use masc.core.extension;
use masc.core.mode;
use masc.core.register;
use masc.core.set;
use masc.core.state;
use masc.format.dialect;
use masc.isa;

# a mode's switch as a caller gives it: its flag, as `pic`, and whether it is turned on
pub rec Switched {
    flag: str;
    on:   bool;
}

# switches a caller gives, as a pointer to rows and a count
pub rec Flags {
    at:  *Switched;
    len: u32;
}

# the mode flags of a caller that states none
pub val NO_FLAGS: Flags = Flags{at: nil, len: 0};

# what a caller names beside the target's checked instruction set
# ---
# abi:    the abi row as mink's catalog resolved it, nil where the architecture's family names none
# isa:    the instruction set as mink's catalog spells it, which a refusal of the selection names, empty for none
# syntax: the syntax by name, nil for the set's established one
# modes:  the switches that start the set's assembler modes at a value, each mode at most once
pub rec Request {
    abi:    *mink_arch.Abi;
    isa:    str;
    syntax: str;
    modes:  Flags;
}

# the parts of a request a refusal names: a syntax, a mode flag, and the selection the instruction set spells
pub val SYNTAX:    str = "syntax";
pub val MODE:      str = "mode";
pub val SELECTION: str = "selection";

# the refusal of the request's `part`, given as `given`, for the static reason `why`
fun refusal(part: str, given: str, why: str) fail.Fail {
    var shown: View = View{data: nil, len: 0};
    if (given != nil) { shown = View{data: given::*u8, len: str_len(given)}; }
    ret fail.refusing(fail.malformed(why), fail.Refused{part: part, given: shown, accepts: opt[fail.Accepts].none{}});
}

# the refusal of the selection `isa` spells, whose context or register view `e` says was not made
fun unopened(e: state.Error, isa: str) fail.Fail {
    if (sel e.memory) { ret fail.refused(e.memory); }
    if (sel e.empty)  { ret refusal(SELECTION, isa, "the selection bounds a quantity of the register file to no value"); }
    ret refusal(SELECTION, isa, "the selection states two values of one state axis, or one no axis takes");
}

# a resolved target. it holds the selection and the view its context points at, so it lives where `open` made it
# ---
# arch:      the architecture
# set:       the set serving it
# selection: the closed selection
# available: the register file viewed through the context
# context:   the object's context: the selection at the state the architecture starts it at
# syntax:    the index of the syntax among the set's
# abi:       the abi row, nil where the architecture's family names none
# modes:     the assembler modes the flags start at a value, the first `moded` of them
# moded:     how many modes the flags set
pub rec Target {
    arch:      *mink_arch.Arch;
    set:       *set.Set;
    selection: extension.Selection;
    available: register.Available;
    context:   state.Context;
    syntax:    u32;
    abi:       *mink_arch.Abi;
    modes:     [mode.MAX_MODES]mode.Setting;
    moded:     u32;
}

# the settings the flags `flags` choose among the modes of `s`, into `out`, how many
fun moded(s: *set.Set, flags: Flags, out: *mode.Setting) res[u32, fail.Fail] {
    var n: u32 = 0;
    for (n < flags.len) {
        val chosen: opt[mode.Setting] = mode.flagged(?s.assembly, flags.at[n].flag, flags.at[n].on);
        if (sel chosen.none) { ret res[u32, fail.Fail].err{refusal(MODE, flags.at[n].flag, "the set has no assembler mode the flag switches")}; }
        var j: u32 = 0;
        for (j < n) {
            if (out[j].mode == chosen.some.mode) { ret res[u32, fail.Fail].err{refusal(MODE, flags.at[n].flag, "another flag switches the same mode as")}; }
            j = j + 1;
        }
        out[n] = chosen.some;
        n      = n + 1;
    }
    ret res[u32, fail.Fail].ok{n};
}

# the index among `s`'s syntaxes of the one named `name`, its established one for nil
fun syntax_of(s: *set.Set, name: str) opt[u32] {
    if (name == nil) { ret opt[u32].some{0}; }
    var i: u32 = 0;
    for (i < s.syntaxes.len) {
        if (str_equals(s.syntaxes.at[i].name, name)) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# `request` opened into `out` over `checked`, the set and closed selection `masc.isa.check` gave, which `out` takes
# and the caller releases with it. a refusal leaves `checked` with the caller and nothing in `out` to release
pub fun open(a: *A.Allocator, checked: *isa.Checked, request: Request, out: *Target) err[fail.Fail] {
    val s:      *set.Set = checked.set;
    val syntax: opt[u32] = syntax_of(s, request.syntax);
    if (sel syntax.none) { ret err[fail.Fail].err{refusal(SYNTAX, request.syntax, "the set has no syntax")}; }
    val started: res[u32, fail.Fail] = moded(s, request.modes, ?out.modes[0]);
    if (sel started.err) { ret err[fail.Fail].err{started.err}; }
    out.arch      = checked.arch.arch;
    out.set       = s;
    out.selection = checked.selection;
    out.syntax    = syntax.some;
    out.abi       = request.abi;
    out.moded     = started.ok;
    val opened: res[state.Context, state.Error] = set.open(a, s, checked.arch, ?out.selection, ?out.available);
    if (sel opened.err) { ret err[fail.Fail].err{unopened(opened.err, request.isa)}; }
    out.context = opened.ok;
    ret err[fail.Fail].ok{};
}

# the assembler options of `t`, reading the assembly dialect `d`, its format facts from `formats`, with the directive
# layers `layers` over the assembler's own
pub fun assembler(t: *Target, formats: *mink_registry.Registry, d: *dialect.Dialect, layers: model.Layers) model.Options {
    ret model.Options{
        arch:    t.arch,
        formats: formats,
        syntax:  t.syntax,
        abi:     t.abi,
        dialect: d,
        layers:  layers,
        modes:   mode.Settings{at: ?t.modes[0], len: t.moded},
    };
}

# give back what `t` owns
pub fun release(t: *Target) {
    register.release(?t.available);
    extension.release(?t.selection);
}
