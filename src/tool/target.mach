# a target resolved from its spellings
#
# mink's catalog resolves the target a caller names, its system, environment,
# architecture, abi and instruction set, every default applied there. what is
# left is masc's: the registry finds the set that serves the architecture, the
# set's selection hook reads the instruction set, the extensions named are
# added through the set's name index, the set's syntax rows name its syntaxes
# and its mode rows read each mode flag. nothing here reads a spelling itself,
# so a set whose selection is an ISA string, a level or a feature list needs
# nothing of this module.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;

use mink_arch:     mink.catalog.arch;
use mink_registry: mink.format.registry;

use masc.asm.model;
use masc.core.diagnostic;
use masc.core.extension;
use masc.core.mode;
use masc.core.register;
use masc.core.set;
use masc.core.state;
use masc.format.dialect;

# command line flags that choose assembler modes, as `--pic`, as a pointer to their spellings and a count
pub rec Flags {
    at:  *str;
    len: u32;
}

# the mode flags of a caller that states none
pub val NO_FLAGS: Flags = Flags{at: nil, len: 0};

# names of the set's extension catalog, as a pointer to their spellings and a count
pub rec Names {
    at:  *str;
    len: u32;
}

# what a caller names, the architecture, abi and instruction set as mink's catalog resolved them
# ---
# arch:   the architecture
# abi:    the abi row, nil where the architecture's family names none
# isa:    the instruction set, in the set's own selection syntax, handed to its hook whole, empty for its baseline
# added:  the extensions added over it, each by a name of the set's catalog
# syntax: the syntax by name, nil for the set's established one
# modes:  the flags that start the set's assembler modes at a value, each mode at most once
pub rec Request {
    arch:   *mink_arch.Arch;
    abi:    *mink_arch.Abi;
    isa:    str;
    added:  Names;
    syntax: str;
    modes:  Flags;
}

# why a request was not resolved
# ---
# unserved:  no registered set serves the architecture
# selection: the set's hook refused the instruction set, or the extensions added conflict
# extension: the set's catalog has no extension of the name
# syntax:    the set has no syntax of the name
# mode:      no assembler mode of the set has a value the flag chooses
# twice:     the flag chooses a value of a mode another flag of the request chooses one of
# context:   the selection's context for the architecture, or its register view, could not be made
pub tag Refusal: u8 {
    unserved:  *mink_arch.Arch;
    selection: extension.Error;
    extension: str;
    syntax:    str;
    mode:      str;
    twice:     str;
    context:   state.Opened;
}

# a resolved target. it holds the selection and the view its context points at, so it lives where `open` made it
# ---
# arch:      the architecture
# set:       the set serving it
# selection: the closed selection
# available: the register file viewed through the context
# context:   the object's context: the selection at the state the architecture starts it at
# syntax:    the index of the syntax among the set's
# abi:       the abi row, nil where the architecture's family names none
# modes:     the assembler modes the flags start at a value, the first `moded` of them
# moded:     how many modes the flags set
pub rec Target {
    arch:      *mink_arch.Arch;
    set:       *set.Set;
    selection: extension.Selection;
    available: register.Available;
    context:   state.Context;
    syntax:    u32;
    abi:       *mink_arch.Abi;
    modes:     [mode.MAX_MODES]mode.Setting;
    moded:     u32;
}

# the settings the flags `flags` choose among the modes of `s`, into `out`, how many
fun moded(s: *set.Set, flags: Flags, out: *mode.Setting) res[u32, Refusal] {
    var n: u32 = 0;
    for (n < flags.len) {
        val chosen: opt[mode.Setting] = mode.flagged(?s.assembly, flags.at[n]);
        if (sel chosen.none) { ret res[u32, Refusal].err{Refusal.mode{flags.at[n]}}; }
        var j: u32 = 0;
        for (j < n) {
            if (out[j].mode == chosen.some.mode) { ret res[u32, Refusal].err{Refusal.twice{flags.at[n]}}; }
            j = j + 1;
        }
        out[n] = chosen.some;
        n      = n + 1;
    }
    ret res[u32, Refusal].ok{n};
}

# the index among `s`'s syntaxes of the one named `name`, its established one for nil
fun syntax_of(s: *set.Set, name: str) opt[u32] {
    if (name == nil) { ret opt[u32].some{0}; }
    var i: u32 = 0;
    for (i < s.syntaxes.len) {
        if (str_equals(s.syntaxes.at[i].name, name)) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# `request` resolved against `registry` into `out`, which the caller releases. a refusal leaves nothing to release
pub fun open(a: *A.Allocator, registry: *set.Registry, request: Request, out: *Target) err[Refusal] {
    val found: opt[*set.Set] = set.find(registry, request.arch);
    if (sel found.none) { ret err[Refusal].err{Refusal.unserved{request.arch}}; }
    val s:   *set.Set     = found.some;
    val row: opt[*set.Arch] = set.arch_of(s, request.arch);
    if (sel row.none) { ret err[Refusal].err{Refusal.unserved{request.arch}}; }
    val syntax: opt[u32] = syntax_of(s, request.syntax);
    if (sel syntax.none) { ret err[Refusal].err{Refusal.syntax{request.syntax}}; }
    val started: res[u32, Refusal] = moded(s, request.modes, ?out.modes[0]);
    if (sel started.err) { ret err[Refusal].err{started.err}; }
    var isa: str = request.isa;
    if (isa == nil) { isa = ""; }
    val chosen: res[extension.Selection, extension.Added] = extension.select_adding(a, s.extensions, isa, request.added.at, request.added.len);
    if (sel chosen.err) {
        val why: extension.Added = chosen.err;
        if (sel why.name) { ret err[Refusal].err{Refusal.extension{request.added.at[why.name]}}; }
        ret err[Refusal].err{Refusal.selection{why.selection}};
    }
    out.arch      = request.arch;
    out.set       = s;
    out.selection = chosen.ok;
    out.syntax    = syntax.some;
    out.abi       = request.abi;
    out.moded     = started.ok;
    val opened: res[state.Context, state.Opened] = set.open(a, s, row.some, ?out.selection, ?out.available);
    if (sel opened.err) {
        val dropped: err[A.Error] = extension.release(?out.selection);
        ret err[Refusal].err{Refusal.context{opened.err}};
    }
    out.context = opened.ok;
    ret err[Refusal].ok{};
}

# the assembler options of `t`, reading the assembly dialect `d`, its format facts from `formats`, with the directive
# layers `layers` over the assembler's own
pub fun assembler(t: *Target, formats: *mink_registry.Registry, d: *dialect.Dialect, layers: model.Layers) model.Options {
    ret model.Options{
        arch:    t.arch,
        formats: formats,
        syntax:  t.syntax,
        abi:     t.abi,
        dialect: d,
        layers:  layers,
        modes:   mode.Settings{at: ?t.modes[0], len: t.moded},
    };
}

# give back what `t` owns
pub fun release(t: *Target) {
    register.release(?t.available);
    extension.release(?t.selection);
}
