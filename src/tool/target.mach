# a target resolved from its spellings
#
# a caller names an architecture, a selection, a syntax and the assembler
# options it states, each as text, and every spelling goes to its owner:
# mink's catalog names the architecture, the registry finds the set that
# serves it, the set's selection hook reads the selection, the set's syntax
# rows name its syntaxes, its option rows read each option and its mode rows
# read each mode flag. nothing here reads a spelling itself, so a set whose
# selection is an ISA string, a level or a feature list needs nothing of this
# module.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.testing;

use mink;

use masc.asm.model;
use masc.core.diagnostic;
use masc.core.extension;
use masc.core.mode;
use masc.core.register;
use masc.core.set;
use masc.core.state;
use masc.format.dialect;
use masc.isa.isa;

#[testing]
use riscv_extension: masc.isa.riscv.extension;
#[testing]
use riscv_mode:      masc.isa.riscv.mode;

# command line flags that choose assembler modes, as `--pic`, as a pointer to their spellings and a count
pub rec Flags {
    at:  *str;
    len: u32;
}

# the mode flags of a caller that states none
pub val NO_FLAGS: Flags = Flags{at: nil, len: 0};

# what a caller names
# ---
# arch:      the architecture, by its name in mink's catalog
# selection: the extensions, in the set's own selection syntax, handed to its hook whole
# syntax:    the syntax by name, nil for the set's established one
# abi:       the name of the architecture's abi row, as `lp64d`, nil for none
# modes:     the flags that start the set's assembler modes at a value, each mode at most once
pub rec Request {
    arch:      str;
    selection: str;
    syntax:    str;
    abi:       str;
    modes:     Flags;
}

# why a request was not resolved
# ---
# arch:      no architecture of mink's catalog has the name
# unserved:  no registered set serves the architecture
# selection: the set's hook refused the selection
# syntax:    the set has no syntax of the name
# abi:       the architecture has no abi row of the name, as `ilp32e` for riscv32, whose abi row it is not
# mode:      no assembler mode of the set has a value the flag chooses
# twice:     the flag chooses a value of a mode another flag of the request chooses one of
# context:   the selection's context for the architecture, or its register view, could not be made
pub tag Refusal: u8 {
    arch:      str;
    unserved:  *mink.arch.Arch;
    selection: extension.Error;
    syntax:    str;
    abi:       str;
    mode:      str;
    twice:     str;
    context:   state.Opened;
    memory:    A.Error;
}

# a resolved target. it holds the selection and the view its context points at, so it lives where `open` made it
# ---
# arch:      the architecture
# set:       the set serving it
# selection: the closed selection
# available: the register file viewed through the context
# context:   the object's context: the selection at the state the architecture starts it at
# syntax:    the index of the syntax among the set's
# abi:       the abi row the request names, nil for none
# modes:     the assembler modes the flags start at a value, the first `moded` of them
# moded:     how many modes the flags set
pub rec Target {
    arch:      *mink.arch.Arch;
    set:       *set.Set;
    selection: extension.Selection;
    available: register.Available;
    context:   state.Context;
    syntax:    u32;
    abi:       *mink.arch.Abi;
    modes:     [mode.MAX_MODES]mode.Setting;
    moded:     u32;
}

# the settings the flags `flags` choose among the modes of `s`, into `out`, how many
fun moded(s: *set.Set, flags: Flags, out: *mode.Setting) res[u32, Refusal] {
    var n: u32 = 0;
    for (n < flags.len) {
        val chosen: opt[mode.Setting] = mode.flagged(?s.assembly, flags.at[n]);
        if (sel chosen.none) { ret res[u32, Refusal].err{Refusal.mode{flags.at[n]}}; }
        var j: u32 = 0;
        for (j < n) {
            if (out[j].mode == chosen.some.mode) { ret res[u32, Refusal].err{Refusal.twice{flags.at[n]}}; }
            j = j + 1;
        }
        out[n] = chosen.some;
        n      = n + 1;
    }
    ret res[u32, Refusal].ok{n};
}

# the index among `s`'s syntaxes of the one named `name`, its established one for nil
fun syntax_of(s: *set.Set, name: str) opt[u32] {
    if (name == nil) { ret opt[u32].some{0}; }
    var i: u32 = 0;
    for (i < s.syntaxes.len) {
        if (str_equals(s.syntaxes.at[i].name, name)) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# an architecture and the set serving it
pub rec Served {
    arch: *mink.arch.Arch;
    set:  *set.Set;
}

# the architecture of mink's catalog named `name` and the set of `registry` serving it
pub fun served(registry: *set.Registry, name: str) res[Served, Refusal] {
    val arch: res[*mink.arch.Arch, mink.fail.Fail] = mink.arch_list.by_name(name);
    if (sel arch.err) { ret res[Served, Refusal].err{Refusal.arch{name}}; }
    val s: opt[*set.Set] = set.find(registry, arch.ok);
    if (sel s.none) { ret res[Served, Refusal].err{Refusal.unserved{arch.ok}}; }
    ret res[Served, Refusal].ok{Served{arch: arch.ok, set: s.some}};
}

# `request` resolved against `registry` into `out`, which the caller releases. a refusal leaves nothing to release
pub fun open(a: *A.Allocator, registry: *set.Registry, request: Request, out: *Target) err[Refusal] {
    val found: res[Served, Refusal] = served(registry, request.arch);
    if (sel found.err) { ret err[Refusal].err{found.err}; }
    val s:      *set.Set = found.ok.set;
    val syntax: opt[u32] = syntax_of(s, request.syntax);
    if (sel syntax.none) { ret err[Refusal].err{Refusal.syntax{request.syntax}}; }
    val started: res[u32, Refusal] = moded(s, request.modes, ?out.modes[0]);
    if (sel started.err) { ret err[Refusal].err{started.err}; }
    var abi: *mink.arch.Abi = nil;
    if (request.abi != nil) {
        val named: opt[*mink.arch.Abi] = mink.arch.abi(found.ok.arch, request.abi);
        if (sel named.none) { ret err[Refusal].err{Refusal.abi{request.abi}}; }
        abi = named.some;
    }
    val selected: res[extension.Selection, extension.Error] = extension.select(a, s.extensions, request.selection, diagnostic.START);
    if (sel selected.err) { ret err[Refusal].err{Refusal.selection{selected.err}}; }
    out.arch      = found.ok.arch;
    out.set       = s;
    out.selection = selected.ok;
    out.syntax    = syntax.some;
    out.abi       = abi;
    out.moded     = started.ok;
    val row: opt[*set.Arch] = set.arch_of(s, found.ok.arch);
    if (sel row.none) {
        extension.release(?out.selection);
        ret err[Refusal].err{Refusal.unserved{found.ok.arch}};
    }
    val opened: res[state.Context, state.Opened] = set.open(a, s, row.some, ?out.selection, ?out.available);
    if (sel opened.err) {
        extension.release(?out.selection);
        ret err[Refusal].err{Refusal.context{opened.err}};
    }
    out.context = opened.ok;
    ret err[Refusal].ok{};
}

# the assembler options of `t`, reading the assembly dialect `d`, its format facts from `formats`
pub fun assembler(t: *Target, formats: *mink.registry.Registry, d: *dialect.Dialect) model.Options {
    ret model.Options{
        arch:    t.arch,
        formats: formats,
        syntax:  t.syntax,
        abi:     t.abi,
        dialect: d,
        layers:  model.NO_LAYERS,
        modes:   mode.Settings{at: ?t.modes[0], len: t.moded},
    };
}

# give back what `t` owns
pub fun release(t: *Target) {
    register.release(?t.available);
    extension.release(?t.selection);
}

#[testing]
fun t_request(arch: str, selection: str) Request {
    ret Request{arch: arch, selection: selection, syntax: nil, abi: nil, modes: NO_FLAGS};
}

test open__an_architecture_mink_does_not_name_is_refused {
    var tt: testing.Testing;
    testing.make(?tt);
    var t:      Target;
    val opened: err[Refusal] = open(testing.allocator_of(?tt), ?isa.REGISTRY, t_request("pdp11", "rv64i"), ?t);
    if (!sel opened.err)                       { ret 1; }
    if (!sel opened.err.arch)                  { ret 2; }
    if (!str_equals(opened.err.arch, "pdp11")) { ret 3; }
    if (testing.live_count(?tt) != 0)          { ret 4; }
    ret 0;
}

test open__the_selection_reaches_the_set_hook_whole {
    var tt: testing.Testing;
    testing.make(?tt);
    var t:      Target;
    val opened: err[Refusal] = open(testing.allocator_of(?tt), ?isa.REGISTRY, t_request("riscv64", "rv64imac_zba"), ?t);
    if (sel opened.err) { ret 1; }
    val zba: bool = extension.has(?t.selection, riscv_extension.id.ZBA);
    release(?t);
    if (!zba) { ret 2; }
    val refused: err[Refusal] = open(testing.allocator_of(?tt), ?isa.REGISTRY, t_request("riscv64", "rv64imac_zqq"), ?t);
    if (!sel refused.err)                                      { ret 3; }
    if (!sel refused.err.selection)                            { ret 4; }
    if (!sel refused.err.selection.refused)                    { ret 5; }
    if (refused.err.selection.refused.span.start.column != 10) { ret 6; }
    if (testing.live_count(?tt) != 0)                          { ret 7; }
    ret 0;
}

test open__a_mode_flag_starts_its_mode_and_another_set_or_twice_is_refused {
    var tt: testing.Testing;
    testing.make(?tt);
    val a:   *A.Allocator = testing.allocator_of(?tt);
    var t:   Target;
    var pic: [1]str       = [1]str{"--pic"};
    var q:   Request      = t_request("riscv64", "rv64i");
    q.modes = Flags{at: ?pic[0], len: 1};
    val opened: err[Refusal] = open(a, ?isa.REGISTRY, q, ?t);
    if (sel opened.err) { ret 1; }
    val chosen: model.Options = assembler(?t, nil, ?dialect.ELF);
    val ok:     bool          = chosen.modes.len == 1 && chosen.modes.at[0].mode == ?riscv_mode.POSITION && chosen.modes.at[0].value == ?riscv_mode.PIC;
    release(?t);
    if (!ok) { ret 2; }
    var both: [2]str = [2]str{"--pic", "--no-pic"};
    q.modes = Flags{at: ?both[0], len: 2};
    val twice: err[Refusal] = open(a, ?isa.REGISTRY, q, ?t);
    if (!sel twice.err)                           { ret 3; }
    if (!sel twice.err.twice)                     { ret 4; }
    if (!str_equals(twice.err.twice, "--no-pic")) { ret 5; }
    var other: [1]str = [1]str{"--thumb"};
    q.modes = Flags{at: ?other[0], len: 1};
    val unknown: err[Refusal] = open(a, ?isa.REGISTRY, q, ?t);
    if (!sel unknown.err)             { ret 6; }
    if (!sel unknown.err.mode)        { ret 7; }
    if (testing.live_count(?tt) != 0) { ret 8; }
    ret 0;
}

# an abi row is the architecture's: ilp32e and lp64e are riscv32e's and riscv64e's alone, as lp64d is riscv64's
test open__an_abi_is_named_by_a_row_of_the_architecture {
    var tt: testing.Testing;
    testing.make(?tt);
    val a: *A.Allocator = testing.allocator_of(?tt);
    var t: Target;
    var q: Request      = t_request("riscv32e", "rv32e");
    q.abi = "ilp32e";
    val opened: err[Refusal] = open(a, ?isa.REGISTRY, q, ?t);
    if (sel opened.err) { ret 1; }
    val e: bool = t.abi != nil && str_equals(t.abi.name, "ilp32e") && t.abi.arch == ?mink.arch_riscv.RISCV32E;
    release(?t);
    if (!e) { ret 2; }
    q     = t_request("riscv64", "rv64i");
    q.abi = "lp64e";
    val refused: err[Refusal] = open(a, ?isa.REGISTRY, q, ?t);
    if (!sel refused.err)                      { ret 3; }
    if (!sel refused.err.abi)                  { ret 4; }
    if (!str_equals(refused.err.abi, "lp64e")) { ret 5; }
    q     = t_request("riscv32e", "rv32e");
    q.abi = "ilp32";
    val other: err[Refusal] = open(a, ?isa.REGISTRY, q, ?t);
    if (!sel other.err)               { ret 6; }
    if (testing.live_count(?tt) != 0) { ret 7; }
    ret 0;
}
