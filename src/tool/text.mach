# text built piece by piece: a growing buffer whose first refused growth sticks
#
# diagnostics, help pages, listings and tool arguments are written piece by
# piece. a piece the allocator refuses marks the text failed and every later
# piece is dropped, so a writer checks `failed` once, when the text is done,
# rather than after every piece.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

# a text being built
# ---
# out:    the bytes so far, never holding a terminator, which only `copy` adds to its copy
# failed: whether a growth was refused, after which nothing more is written
pub rec Text {
    out:    vector.Vector[u8];
    failed: bool;
}

# an empty text over `a`
pub fun init(a: *A.Allocator) Text {
    ret Text{out: vector.init[u8](a), failed: false};
}

# the text emptied for reuse, its failure kept
pub fun clear(t: *Text) {
    vector.truncate[u8](?t.out, 0);
}

# one byte appended
pub fun byte(t: *Text, c: u8) {
    if (t.failed) { ret; }
    val res_pushed: res[usize, A.Error] = vector.push[u8](?t.out, c);
    if (sel res_pushed.err) { t.failed = true; }
}

# `len` bytes at `p` appended
pub fun bytes(t: *Text, p: *u8, len: usize) {
    var i: usize = 0;
    for (i < len && !t.failed) {
        byte(t, p[i]);
        i = i + 1;
    }
}

# `s` appended
pub fun put(t: *Text, s: str) {
    bytes(t, s, str_len(s));
}

# the view `v` appended
pub fun view(t: *Text, v: View) {
    bytes(t, v.data, v.len);
}

# `n` appended in decimal, signed
pub fun decimal(t: *Text, n: i64) {
    var digits: [20]u8;
    var m:      u64 = n:~u64;
    var at:     u32 = 20;
    if (n < 0) {
        byte(t, '-');
        m = ~m + 1;
    }
    for {
        at         = at - 1;
        digits[at] = '0' + (m % 10)::u8;
        m          = m / 10;
        if (m == 0) { brk; }
    }
    bytes(t, ?digits[at], (20 - at)::usize);
}

# give back what the text holds
pub fun dnit(t: *Text) {
    vector.dnit[u8](?t.out);
}
