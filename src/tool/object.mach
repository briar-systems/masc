# objects written as files, through mink's format registry
#
# masc builds mink's neutral object and never a format of its own: an
# object becomes a file through the format registry's `from_neutral` and
# `save`, and a module a dialect's text states whole is the bytes the
# format writes of it, saved as they are. reading a file back is the disassembler's, `masc.disasm.disasm`'s
# `open`. the format facts masc owns, those of the format's assembly dialect,
# are `masc.format.dialect`'s.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail;
use mink.bytes.sink.Sink;
use mink_arch:    mink.catalog.arch;
use mink_format:  mink.catalog.format;
use mink_os:      mink.catalog.os;
use mink.format.contract;
use mink.format.file;
use mink.format.registry;
use mink.model.object;

use masc.format.dialect;

# an architecture and a format, whose dialect masc does not state for it
pub rec Unnamed {
    arch:   *mink_arch.Arch;
    format: *mink_format.Format;
}

# a system and an architecture, none of whose system's formats names code for it
pub rec Unwritten {
    sys:  *mink_os.System;
    arch: *mink_arch.Arch;
}

# why no format was chosen
# ---
# unwritten: no format of the system names code for the architecture
# dialect:   masc states no assembly dialect of the format for the architecture
pub tag Refusal: u8 {
    unwritten: Unwritten;
    dialect:   Unnamed;
}

# the format an object for `arch` is written in on the system `sys`: the first of the system's formats, its default
# first, that names `arch`
pub fun format_for(sys: *mink_os.System, arch: *mink_arch.Arch) res[*mink_format.Format, Refusal] {
    var i: usize = 0;
    for (i < sys.format_count) {
        val code: opt[*mink_arch.Code] = mink_arch.code(arch, sys.formats[i]);
        if (sel code.some) { ret res[*mink_format.Format, Refusal].ok{sys.formats[i]}; }
        i = i + 1;
    }
    ret res[*mink_format.Format, Refusal].err{Refusal.unwritten{Unwritten{sys: sys, arch: arch}}};
}

# the assembly dialect of `f` for `arch`
pub fun dialect_of(f: *mink_format.Format, arch: *mink_arch.Arch) res[*dialect.Dialect, Refusal] {
    val known: opt[*dialect.Dialect] = dialect.of(f, arch);
    if (sel known.none) { ret res[*dialect.Dialect, Refusal].err{Refusal.dialect{Unnamed{arch: arch, format: f}}}; }
    ret res[*dialect.Dialect, Refusal].ok{known.some};
}

# `o` written as a file of format `f` of `formats` at `path`
pub fun save(formats: *registry.Registry, a: *A.Allocator, o: *object.Object, f: *mink_format.Format, path: str) err[fail.Fail] {
    val built: res[contract.Model, fail.Fail] = registry.from_neutral(formats, f, a, o);
    if (sel built.err) { ret err[fail.Fail].err{fail.in_file(built.err, path)}; }
    var m:        contract.Model = built.ok;
    val saved:    err[fail.Fail] = registry.save(?m, path);
    val released: err[fail.Fail] = contract.release(?m);
    if (sel saved.err) { ret saved; }
    ret released;
}

# the bytes `module` the format writes of a module, written as a file at `path`
pub fun save_module(module: *Sink, path: str) err[fail.Fail] {
    ret file.save(path, module);
}
