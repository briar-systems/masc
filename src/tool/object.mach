# objects written as files, through mink's format registry
#
# masc builds mink's neutral object and never a format of its own: an
# object becomes a file through the format registry's `from_neutral` and
# `save`. reading a file back is the disassembler's, `masc.disasm.disasm`'s
# `open`. the format facts masc owns, those of the format's assembly dialect,
# are `masc.format.dialect`'s.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;

use mink;

use masc.format.dialect;

# an architecture and a format, which names no code for it or whose dialect masc does not state for it
pub rec Unnamed {
    arch:   *mink.arch.Arch;
    format: *mink.format.Format;
}

# why no format was chosen
# ---
# format:    no format of mink's catalog has the name
# unnamed:   the format has no code for the architecture
# ambiguous: several formats name the architecture and none was asked for
# dialect:   masc states no assembly dialect of the format for the architecture
pub tag Refusal: u8 {
    format:    str;
    unnamed:   Unnamed;
    ambiguous: *mink.arch.Arch;
    dialect:   Unnamed;
}

# the format an object for `arch` is written in: the one of `formats` named `name`, or for nil the only format that
# names `arch`
pub fun format_for(formats: *mink.registry.Registry, arch: *mink.arch.Arch, name: str) res[*mink.format.Format, Refusal] {
    if (name == nil) {
        if (arch.code_count != 1) { ret res[*mink.format.Format, Refusal].err{Refusal.ambiguous{arch}}; }
        ret res[*mink.format.Format, Refusal].ok{arch.code[0].format};
    }
    val r: res[*mink.registry.Registration, mink.fail.Fail] = mink.registry.by_name(formats, name);
    if (sel r.err) { ret res[*mink.format.Format, Refusal].err{Refusal.format{name}}; }
    val f:    *mink.format.Format  = r.ok.format;
    val code: opt[*mink.arch.Code] = mink.arch.code(arch, f);
    if (sel code.none) { ret res[*mink.format.Format, Refusal].err{Refusal.unnamed{Unnamed{arch: arch, format: f}}}; }
    ret res[*mink.format.Format, Refusal].ok{f};
}

# the assembly dialect of `f` for `arch`
pub fun dialect_of(f: *mink.format.Format, arch: *mink.arch.Arch) res[*dialect.Dialect, Refusal] {
    val known: opt[*dialect.Dialect] = dialect.of(f, arch);
    if (sel known.none) { ret res[*dialect.Dialect, Refusal].err{Refusal.dialect{Unnamed{arch: arch, format: f}}}; }
    ret res[*dialect.Dialect, Refusal].ok{known.some};
}

# `o` written as a file of format `f` of `formats` at `path`
pub fun save(formats: *mink.registry.Registry, a: *A.Allocator, o: *mink.object.Object, f: *mink.format.Format, path: str) err[mink.fail.Fail] {
    val built: res[mink.contract.Model, mink.fail.Fail] = mink.registry.from_neutral(formats, f, a, o);
    if (sel built.err) { ret err[mink.fail.Fail].err{mink.fail.in_file(built.err, path)}; }
    var m:        mink.contract.Model = built.ok;
    val saved:    err[mink.fail.Fail] = mink.registry.save(?m, path);
    val released: err[mink.fail.Fail] = mink.contract.release(?m);
    if (sel saved.err) { ret saved; }
    ret released;
}
