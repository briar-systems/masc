# objects written as files, through mink's format registry
#
# masc builds mink's neutral object and never a format of its own: an
# object becomes a file through the format registry's `from_neutral` and
# `save`, and a module a dialect's text states whole is the bytes the
# format writes of it, saved as they are. reading a file back is the disassembler's, `masc.disasm`'s
# `open`. the format facts masc owns, those of the format's assembly dialect,
# are `masc.format.dialect`'s.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;

use mink.base.fail;
use mink_arch:   mink.catalog.arch;
use mink_format: mink.catalog.format;
use mink.format.contract;
use mink.format.registry;
use mink.model.object;

use masc.format.dialect;

# the part a refusal of a format names
pub val FORMAT: str = "format";

# the assembly dialect of `f` for `arch`, refused naming the format where masc states none
pub fun dialect_of(f: *mink_format.Format, arch: *mink_arch.Arch) res[*dialect.Dialect, fail.Fail] {
    val known: opt[*dialect.Dialect] = dialect.of(f, arch);
    if (sel known.some) { ret res[*dialect.Dialect, fail.Fail].ok{known.some}; }
    val r: fail.Refused = fail.Refused{part: FORMAT, given: View{data: f.name::*u8, len: str_len(f.name)}, accepts: opt[fail.Accepts].none{}};
    ret res[*dialect.Dialect, fail.Fail].err{fail.refusing(fail.unsupported("masc states no assembly dialect of the format for the architecture"), r)};
}

# `o` written as a file of format `f` of `formats` at `path`
pub fun save(formats: *registry.Registry, a: *A.Allocator, o: *object.Object, f: *mink_format.Format, path: str) err[fail.Fail] {
    val built: res[contract.Model, fail.Fail] = registry.from_neutral(formats, a, f, o);
    if (sel built.err) { ret err[fail.Fail].err{fail.in_file(built.err, path)}; }
    var m:        contract.Model = built.ok;
    val saved:    err[fail.Fail] = registry.save(?m, path);
    val released: err[fail.Fail] = contract.release(?m);
    if (sel saved.err) { ret saved; }
    ret released;
}
