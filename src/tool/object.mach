# objects written as files, through mink's format registry
#
# masc builds mink's neutral object and never a format of its own: an
# object becomes a file through the format registry's `from_neutral` and
# `save`, and a module a dialect's text states whole is the bytes the
# format writes of it, saved as they are. reading a file back is the disassembler's, `masc.disasm.disasm`'s
# `open`. the format facts masc owns, those of the format's assembly dialect,
# are `masc.format.dialect`'s.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail;
use mink.bytes.sink.Sink;
use mink_arch:    mink.catalog.arch;
use mink_format:  mink.catalog.format;
use mink_os:      mink.catalog.os;
use mink_darwin:  mink.catalog.os.darwin;
use mink_linux:   mink.catalog.os.linux;
use mink_windows: mink.catalog.os.windows;
use mink.format.contract;
use mink.format.file;
use mink.format.registry;
use mink.model.object;

use masc.format.dialect;

# an architecture and a format, which names no code for it or whose dialect masc does not state for it
pub rec Unnamed {
    arch:   *mink_arch.Arch;
    format: *mink_format.Format;
}

# why no format was chosen
# ---
# format:   no format of mink's catalog has the name
# unnamed:  the format has no code for the architecture
# hostless: none was asked for, the host system's formats name no code for the architecture and several formats do
# dialect:  masc states no assembly dialect of the format for the architecture
pub tag Refusal: u8 {
    format:   str;
    unnamed:  Unnamed;
    hostless: *mink_arch.Arch;
    dialect:  Unnamed;
}

# the system masc runs on, whose row of mink's system catalog states the formats it accepts, none for a host the
# catalog has no row for
pub fun host() opt[*mink_os.System] {
    $if ($mach.build.sys == $mach.sys.linux) {
        ret opt[*mink_os.System].some{?mink_linux.LINUX};
    }
    $or ($mach.build.sys == $mach.sys.darwin) {
        ret opt[*mink_os.System].some{?mink_darwin.DARWIN};
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        ret opt[*mink_os.System].some{?mink_windows.WINDOWS};
    }
    $or {
        ret opt[*mink_os.System].none{};
    }
}

# the format an object for `arch` is written in: the one of `formats` named `name`, or for nil the first format of the
# host system, its default first, that names `arch`, else the only format that does
pub fun format_for(formats: *registry.Registry, arch: *mink_arch.Arch, name: str) res[*mink_format.Format, Refusal] {
    if (name == nil) {
        val sys: opt[*mink_os.System] = host();
        var i:   usize                = 0;
        if (sel sys.some) {
            for (i < sys.some.format_count) {
                val code: opt[*mink_arch.Code] = mink_arch.code(arch, sys.some.formats[i]);
                if (sel code.some) { ret res[*mink_format.Format, Refusal].ok{sys.some.formats[i]}; }
                i = i + 1;
            }
        }
        if (arch.code_count != 1) { ret res[*mink_format.Format, Refusal].err{Refusal.hostless{arch}}; }
        ret res[*mink_format.Format, Refusal].ok{arch.code[0].format};
    }
    val r: res[*registry.Registration, fail.Fail] = registry.by_name(formats, name);
    if (sel r.err) { ret res[*mink_format.Format, Refusal].err{Refusal.format{name}}; }
    val f:    *mink_format.Format  = r.ok.format;
    val code: opt[*mink_arch.Code] = mink_arch.code(arch, f);
    if (sel code.none) { ret res[*mink_format.Format, Refusal].err{Refusal.unnamed{Unnamed{arch: arch, format: f}}}; }
    ret res[*mink_format.Format, Refusal].ok{f};
}

# the assembly dialect of `f` for `arch`
pub fun dialect_of(f: *mink_format.Format, arch: *mink_arch.Arch) res[*dialect.Dialect, Refusal] {
    val known: opt[*dialect.Dialect] = dialect.of(f, arch);
    if (sel known.none) { ret res[*dialect.Dialect, Refusal].err{Refusal.dialect{Unnamed{arch: arch, format: f}}}; }
    ret res[*dialect.Dialect, Refusal].ok{known.some};
}

# `o` written as a file of format `f` of `formats` at `path`
pub fun save(formats: *registry.Registry, a: *A.Allocator, o: *object.Object, f: *mink_format.Format, path: str) err[fail.Fail] {
    val built: res[contract.Model, fail.Fail] = registry.from_neutral(formats, f, a, o);
    if (sel built.err) { ret err[fail.Fail].err{fail.in_file(built.err, path)}; }
    var m:        contract.Model = built.ok;
    val saved:    err[fail.Fail] = registry.save(?m, path);
    val released: err[fail.Fail] = contract.release(?m);
    if (sel saved.err) { ret saved; }
    ret released;
}

# the bytes `module` the format writes of a module, written as a file at `path`
pub fun save_module(module: *Sink, path: str) err[fail.Fail] {
    ret file.save(path, module);
}
