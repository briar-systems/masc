# objects as files, through mink's format registry
#
# masc builds and reads mink's neutral object and never a format of its own:
# an object becomes a file through the registered format's `from_neutral`
# and `write`, and a file becomes an object through the format its magic
# names and its `to_neutral`. the one format fact masc owns is the assembly
# dialect's, the spelling of names the format keeps out of its symbol table.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink;

# an architecture and a format that names no code for it
pub rec Unnamed {
    arch:   *mink.arch.Arch;
    format: *mink.format.Format;
}

# why no format was chosen
# ---
# format:    no format of mink's catalog has the name
# unnamed:   the format has no code for the architecture
# ambiguous: several formats name the architecture and none was asked for
# private:   masc knows no private spelling of names for the format
pub tag Refusal: u8 {
    format:    str;
    unnamed:   Unnamed;
    ambiguous: *mink.arch.Arch;
    private:   *mink.format.Format;
}

# the assembly dialect of a format
# ---
# format:  the format
# private: the spelling that starts the names an assembler keeps out of its symbol table
pub rec Dialect {
    format:  *mink.format.Format;
    private: str;
}

# the gnu assembler's local symbol names (as manual, "Symbol Names"): `.L` on elf
val DIALECT_COUNT: usize                  = 1;
val DIALECTS:      [DIALECT_COUNT]Dialect = [DIALECT_COUNT]Dialect{
    Dialect{format: ?mink.format.ELF, private: ".L"},
};

# whether `arch` names a code in `f`
fun names(arch: *mink.arch.Arch, f: *mink.format.Format) bool {
    var i: usize = 0;
    for (i < arch.code_count) {
        if (arch.codes[i].format == f) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the format an object for `arch` is written in: the one named `name`, or for nil the only format that names `arch`
pub fun format_for(arch: *mink.arch.Arch, name: str) res[*mink.format.Format, Refusal] {
    if (name == nil) {
        if (arch.code_count != 1) { ret res[*mink.format.Format, Refusal].err{Refusal.ambiguous{arch}}; }
        ret res[*mink.format.Format, Refusal].ok{arch.codes[0].format};
    }
    val f: res[*mink.format.Format, mink.fail.Fail] = mink.format.by_name(name);
    if (sel f.err)          { ret res[*mink.format.Format, Refusal].err{Refusal.format{name}}; }
    if (!names(arch, f.ok)) { ret res[*mink.format.Format, Refusal].err{Refusal.unnamed{Unnamed{arch: arch, format: f.ok}}}; }
    ret res[*mink.format.Format, Refusal].ok{f.ok};
}

# the private spelling of names in `f`
pub fun private_of(f: *mink.format.Format) res[str, Refusal] {
    var i: usize = 0;
    for (i < DIALECT_COUNT) {
        if (DIALECTS[i].format == f) { ret res[str, Refusal].ok{DIALECTS[i].private}; }
        i = i + 1;
    }
    ret res[str, Refusal].err{Refusal.private{f}};
}

# `o` written as a file of format `f` at `path`
pub fun save(a: *A.Allocator, o: *mink.object.Object, f: *mink.format.Format, path: str) err[mink.fail.Fail] {
    val made: res[mink.registry.Registry, mink.fail.Fail] = mink.registry.builtin();
    if (sel made.err) { ret err[mink.fail.Fail].err{made.err}; }
    var reg:   mink.registry.Registry                           = made.ok;
    val found: res[*mink.contract.Registration, mink.fail.Fail] = mink.registry.by_format(?reg, f);
    if (sel found.err) { ret err[mink.fail.Fail].err{mink.fail.about(found.err, f.name)}; }
    val built: res[mink.contract.Model, mink.fail.Fail] = mink.contract.from_neutral(found.ok, a, o);
    if (sel built.err) { ret err[mink.fail.Fail].err{mink.fail.in_file(built.err, path)}; }
    var m:       mink.contract.Model                 = built.ok;
    val written: res[mink.sink.Sink, mink.fail.Fail] = mink.contract.write(?m);
    if (sel written.err) {
        mink.contract.release(?m);
        ret err[mink.fail.Fail].err{mink.fail.in_file(written.err, path)};
    }
    var s:     mink.sink.Sink      = written.ok;
    val saved: err[mink.fail.Fail] = mink.file.save(path, ?s);
    mink.sink.release(?s);
    val released: err[mink.fail.Fail] = mink.contract.release(?m);
    if (sel saved.err) { ret saved; }
    ret released;
}

# a file read into a neutral object, with the bytes and the model it may borrow from
# ---
# file:   the file's bytes
# model:  the model its format read
# object: the neutral object
pub rec Loaded {
    file:   mink.file.Loaded;
    model:  mink.contract.Model;
    object: mink.object.Object;
}

# the file at `path`, an object for `arch`, read into `out`, which the caller unloads. a refusal leaves nothing to unload
pub fun load(a: *A.Allocator, arch: *mink.arch.Arch, path: str, out: *Loaded) err[mink.fail.Fail] {
    val made: res[mink.registry.Registry, mink.fail.Fail] = mink.registry.builtin();
    if (sel made.err) { ret err[mink.fail.Fail].err{made.err}; }
    var reg:  mink.registry.Registry                = made.ok;
    val read: res[mink.file.Loaded, mink.fail.Fail] = mink.file.load(a, path);
    if (sel read.err) { ret err[mink.fail.Fail].err{read.err}; }
    out.file = read.ok;
    val model: res[mink.contract.Model, mink.fail.Fail] = mink.registry.read(?reg, a, ?out.file.input);
    if (sel model.err) {
        mink.file.unload(?out.file);
        ret err[mink.fail.Fail].err{model.err};
    }
    out.model  = model.ok;
    out.object = mink.object.make(a, arch);
    val converted: err[mink.fail.Fail] = mink.contract.to_neutral(?out.model, ?out.object);
    if (sel converted.err) {
        unload(out);
        ret err[mink.fail.Fail].err{mink.fail.in_file(converted.err, path)};
    }
    if (out.object.arch != arch) {
        val other: str = out.object.arch.name;
        unload(out);
        ret err[mink.fail.Fail].err{mink.fail.in_file(mink.fail.about(mink.fail.malformed("the object is for another architecture"), other), path)};
    }
    ret converted;
}

# give back what `l` holds
pub fun unload(l: *Loaded) {
    mink.object.release(?l.object);
    mink.contract.release(?l.model);
    mink.file.unload(?l.file);
}
