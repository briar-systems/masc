# help pages in the layout of mach's
#
# a page is a command's usage, its effect and its flag rows, the same rows
# std.args reads the command line against, so a flag's help is never written
# apart from the flag. the overview lists every page by name and summary.
#
#     usage: masc assemble <input> [options]
#
#     effect: assemble a source file into an object file
#
#     options:
#       --output <path>       write the output here
#       -o <path>             write the output here
#         alias of: --output
#
#     exit:
#       0    success

use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.args;

use masc.tool.render;
use masc.tool.text;

# a command's help
# ---
# name:    the command word
# summary: one line for the overview
# usage:   what follows the program name in its usage line, the command word first
# effect:  what the command does
# flags:   the flag rows it reads
# count:   how many
pub rec Page {
    name:    str;
    summary: str;
    usage:   str;
    effect:  str;
    flags:   **args.Flag;
    count:   usize;
}

# the widest spelling a row's help stays beside, a wider one taking a line of its own
val SPEC_WIDTH: usize = 20;

fun spaces(t: *text.Text, n: usize) {
    var i: usize = 0;
    for (i < n) {
        text.byte(t, ' ');
        i = i + 1;
    }
}

# one row: `spelling`, the placeholder of `f`, and its doc in the column, or no doc for nil
fun row(t: *text.Text, f: *args.Flag, spelling: str, doc: str) {
    text.put(t, "  ");
    text.put(t, spelling);
    var len: usize = str_len(spelling);
    if (f.kind == args.VALUE) {
        text.put(t, " <");
        text.put(t, f.value);
        text.byte(t, '>');
        len = len + 3 + str_len(f.value);
    }
    if (f.kind == args.ATTACHED) {
        text.put(t, "[=");
        text.put(t, f.value);
        text.byte(t, ']');
        len = len + 3 + str_len(f.value);
    }
    if (doc != nil) {
        if (len > SPEC_WIDTH) {
            text.byte(t, '\n');
            spaces(t, SPEC_WIDTH + 4);
        }
        or {
            spaces(t, SPEC_WIDTH + 2 - len);
        }
        text.put(t, doc);
    }
    text.byte(t, '\n');
}

# a note under a row, as `alias of: --output`
fun note(t: *text.Text, label: str, about: str) {
    text.put(t, "    ");
    text.put(t, label);
    text.put(t, about);
    text.byte(t, '\n');
}

# the rows of `f`: its long spelling, its short alias and its negation
fun flag(t: *text.Text, f: *args.Flag) {
    row(t, f, f.name, f.doc);
    if (f.repeat) { note(t, "", "repeatable"); }
    if (f.short != nil) {
        row(t, f, f.short, f.doc);
        note(t, "alias of: ", f.name);
    }
    if (f.kind == args.SWITCH && f.negatable) {
        text.put(t, "  --no-");
        text.put(t, ?f.name[2]);
        text.byte(t, '\n');
        note(t, "negates: ", f.name);
    }
}

# the page of `p`, its usage line led by `program`
pub fun page(t: *text.Text, program: str, p: *Page) {
    text.put(t, "usage: ");
    text.put(t, program);
    text.byte(t, ' ');
    text.put(t, p.usage);
    text.put(t, "\n\neffect: ");
    text.put(t, p.effect);
    text.put(t, "\n\noptions:\n");
    var i: usize = 0;
    for (i < p.count) {
        flag(t, p.flags[i]);
        i = i + 1;
    }
    text.put(t, "\nexit:\n");
    i = 0;
    for (i < render.MEANING_COUNT) {
        text.put(t, "  ");
        text.decimal(t, render.MEANINGS[i].exit);
        text.put(t, "    ");
        text.put(t, render.MEANINGS[i].meaning);
        text.byte(t, '\n');
        i = i + 1;
    }
}

# the overview: `title`, the usage line led by `program`, every page by summary and the flags read before a command
pub fun overview(t: *text.Text, title: str, program: str, pages: **Page, count: usize, flags: **args.Flag, flag_count: usize) {
    var width: usize = 0;
    var i:     usize = 0;
    for (i < count) {
        val n: usize = str_len(pages[i].name);
        if (n > width) { width = n; }
        i = i + 1;
    }
    text.put(t, title);
    text.put(t, "\n\nusage: ");
    text.put(t, program);
    text.put(t, " <command> [options]\n\ncommands:\n");
    i = 0;
    for (i < count) {
        text.put(t, "  ");
        text.put(t, pages[i].name);
        spaces(t, width + 2 - str_len(pages[i].name));
        text.put(t, pages[i].summary);
        text.byte(t, '\n');
        i = i + 1;
    }
    text.put(t, "\noptions:\n");
    i = 0;
    for (i < flag_count) {
        flag(t, flags[i]);
        i = i + 1;
    }
    text.put(t, "\nuse '");
    text.put(t, program);
    text.put(t, " help <command>' or '");
    text.put(t, program);
    text.put(t, " <command> -h' for detailed usage.\n");
}
