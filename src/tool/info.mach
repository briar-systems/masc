# the listing of the registered instruction sets
#
# one block per set: the architectures it serves by their names in mink's
# catalog, its syntaxes with the established one first, and its levels, each
# read from the set's own rows.
#
#     riscv64 riscv32
#       syntaxes: riscv
#       levels:   rv32i rv64i rv64gc ...

use masc.core.set;
use masc.tool.text;

# every set of `registry` described onto `t`
pub fun describe(registry: *set.Registry, t: *text.Text) {
    var i: u32 = 0;
    for (i < registry.count) {
        val s: *set.Set = registry.sets[i];
        var k: u32      = 0;
        for (k < s.arches.len) {
            if (k > 0) { text.byte(t, ' '); }
            text.put(t, s.arches.at[k].arch.name);
            k = k + 1;
        }
        text.put(t, "\n  syntaxes:");
        k = 0;
        for (k < s.syntaxes.len) {
            text.byte(t, ' ');
            text.put(t, s.syntaxes.at[k].name);
            k = k + 1;
        }
        text.put(t, "\n  levels:  ");
        k = 0;
        for (k < s.extensions.level_count) {
            text.byte(t, ' ');
            text.put(t, s.extensions.levels[k].name);
            k = k + 1;
        }
        text.byte(t, '\n');
        i = i + 1;
    }
}
