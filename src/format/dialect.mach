# the assembly dialect of each object format, the format facts masc owns
#
# masc builds mink's neutral object and never a format of its own, and a
# format's facts are mink's, but for the ones its assembly dialect states and
# not the format: the spelling that starts the names an assembler keeps out
# of the format's symbol table, as elf's `.L`, and the way `.section` opens a
# section apart from another of the same name, as elf's `unique`. the
# assembler is given the dialect, the builder listing and the disassembler
# write text it reads back alike, and the command line takes it from the
# format it writes or reads.

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink;

# the assembly dialect of a format
# ---
# format:  the format
# private: the spelling that starts the names an assembler keeps out of its symbol table
# unique:  the word `.section` takes after its attributes, followed by a number, to open a section apart from every other
#          of its name, re-entered only by that name and number, none for a dialect that keeps no two sections of one
#          name apart
pub rec Dialect {
    format:  *mink.format.Format;
    private: str;
    unique:  opt[str];
}

# the gnu assembler on elf: `.L` local symbol names (as manual, "Symbol Names") and `unique, N` sections (as manual,
# ".section", elf version)
pub val ELF: Dialect = Dialect{format: ?mink.format.ELF, private: ".L", unique: opt[str].some{"unique"}};

val DIALECT_COUNT: usize                   = 1;
val DIALECTS:      [DIALECT_COUNT]*Dialect = [DIALECT_COUNT]*Dialect{?ELF};

# the dialect of `f`, none for a format whose dialect masc does not state
pub fun of(f: *mink.format.Format) opt[*Dialect] {
    var i: usize = 0;
    for (i < DIALECT_COUNT) {
        if (DIALECTS[i].format == f) { ret opt[*Dialect].some{DIALECTS[i]}; }
        i = i + 1;
    }
    ret opt[*Dialect].none{};
}
