# the assembly dialect of each object format and architecture, the format facts masc owns
#
# masc builds mink's neutral object and never a format of its own, and a
# format's facts are mink's, but for the ones its assembly dialect states and
# not the format: the spelling that starts the names an assembler keeps out
# of the format's symbol table, as elf's `.L`, and the way `.section` opens a
# section apart from another of the same name, as elf's `unique`, and whether
# its text states sections at all or the one module the format builds, as
# spir-v and wasm text do (`masc.core.stream.Module`), and how its text
# states a section: the grammar of its `.section`, the words and letters that
# grammar spells a section's type and flags by, the directives that enter a
# section by its own name and the section an assembly starts in, and the
# section its text states an object's bridges in, as arm64ec's `.hybmp$x`,
# with the type words that spell their roles. a dialect is
# a format's, or one architecture's of it where it is spelled apart, as
# coff's `.L` on x86-64 and `L` on i386. the
# assembler is given the dialect, the builder listing and the disassembler
# write text it reads back alike, and the command line takes it from the
# format it writes or reads.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink_arch:    mink.catalog.arch;
use arch_aarch64: mink.catalog.arch.aarch64;
use arch_x86:     mink.catalog.arch.x86;
use mink.catalog.format;
use coff_tables: mink.format.coff.model.tables;
use coff_naming: mink.format.coff.neutral.naming;
use mink.model.bridge;
use mink_group:   mink.model.group;
use mink_section: mink.model.section;

use masc.core.stream;

use spirv_whole: masc.isa.spirv.whole;
use wasm_whole:  masc.isa.wasm.whole;

# the grammar of a dialect's `.section`, after the section's name
# ---
# elf:   `"flags", @type, entsize, linked, signature, comdat, unique, number`
# macho: the name as `segment,section`, then `type, attribute+attribute`
# coff:  `"flags", selection, symbol`
pub tag Form: u8 {
    elf;
    macho;
    coff;
}

# a directive that enters a section by its own name, which then takes the format's convention for that name
# ---
# directive: the directive, its dot included
# name:      the section's name, as the object holds it
pub rec Named {
    directive: str;
    name:      str;
}

# named directives as a pointer to rows and a count
pub rec Nameds {
    at:  *Named;
    len: u32;
}

# a letter of a coff `.section` flag string and what it states: a content
# word of the format's naming, flags it sets and flags it clears of a section's neutral flags, which start allocated
# ---
# letter: the letter
# type:   the content word it states, as mink's coff naming reads it, nil for none
# sets:   the neutral flags it sets
# clears: the neutral flags it clears
pub rec Letter {
    letter: u8;
    type:   str;
    sets:   mink_section.Flags;
    clears: mink_section.Flags;
}

# letters as a pointer to rows and a count
pub rec Letters {
    at:  *Letter;
    len: u32;
}

# a comdat selection word of a coff `.section` and the group rule it keeps
pub rec Selection {
    word: str;
    rule: *mink_group.Rule;
}

# selections as a pointer to rows and a count
pub rec Selections {
    at:  *Selection;
    len: u32;
}

# an attribute word of a mach-o `.section` and the neutral flags it sets and clears of a section's, which start
# allocated, and which classify it with its type word
pub rec Attribute {
    word:   str;
    sets:   mink_section.Flags;
    clears: mink_section.Flags;
}

# attributes as a pointer to rows and a count
pub rec Attributes {
    at:  *Attribute;
    len: u32;
}

# type words as a pointer to words and a count
pub rec Words {
    at:  *str;
    len: u32;
}

# how a dialect's text states a section
# ---
# form:       the grammar of its `.section`
# start:      the name of the section an assembly starts in
# named:      the directives that enter a section by its own name
# types:      the type words its `.section` spells, as the format's naming reads them, for a form that spells one by a
#             word. elf's are the set's, after its type prefix
# letters:    the letters of its flag string, for a form whose letters are the dialect's
# selections: its comdat selection words, for a form that states one
# attributes: the attribute words its `.section` reads after the type, each stating only flags that classify the
#             section with its type word
pub rec Sections {
    form:       Form;
    start:      str;
    named:      Nameds;
    types:      Words;
    letters:    Letters;
    selections: Selections;
    attributes: Attributes;
}

val ELF_NAMED_COUNT: u32                    = 3;
val ELF_NAMED:       [ELF_NAMED_COUNT]Named = [ELF_NAMED_COUNT]Named{
    Named{directive: ".text", name: ".text"},
    Named{directive: ".data", name: ".data"},
    Named{directive: ".bss", name: ".bss"},
};

# the sections on elf, the type words and flag letters the set's and `masc.asm.core`'s
pub val ELF_SECTIONS: Sections = Sections{form: Form.elf{}, start: ".text", named: Nameds{at: ?ELF_NAMED[0], len: ELF_NAMED_COUNT}};

# the section directives on mach-o, each a shorthand that names a section mink's mach-o naming holds
val MACHO_NAMED_COUNT: u32                      = 13;
val MACHO_NAMED:       [MACHO_NAMED_COUNT]Named = [MACHO_NAMED_COUNT]Named{
    Named{directive: ".text", name: "__TEXT,__text"},
    Named{directive: ".const", name: "__TEXT,__const"},
    Named{directive: ".cstring", name: "__TEXT,__cstring"},
    Named{directive: ".literal4", name: "__TEXT,__literal4"},
    Named{directive: ".literal8", name: "__TEXT,__literal8"},
    Named{directive: ".literal16", name: "__TEXT,__literal16"},
    Named{directive: ".data", name: "__DATA,__data"},
    Named{directive: ".const_data", name: "__DATA,__const"},
    Named{directive: ".static_data", name: "__DATA,__static_data"},
    Named{directive: ".mod_init_func", name: "__DATA,__mod_init_func"},
    Named{directive: ".mod_term_func", name: "__DATA,__mod_term_func"},
    Named{directive: ".bss", name: "__DATA,__bss"},
    Named{directive: ".tdata", name: "__DATA,__thread_data"},
};

# the mach-o section type words (mach-o loader.h, the S_ section types)
val MACHO_TYPE_COUNT: u32                   = 17;
val MACHO_TYPES:      [MACHO_TYPE_COUNT]str = [MACHO_TYPE_COUNT]str{
    "regular", "zerofill", "cstring_literals", "4byte_literals", "8byte_literals", "16byte_literals",
    "literal_pointers", "non_lazy_symbol_pointers", "lazy_symbol_pointers", "mod_init_funcs", "mod_term_funcs",
    "coalesced", "interposing", "thread_local_regular", "thread_local_zerofill", "thread_local_variables",
    "thread_local_variable_pointers",
};

# the mach-o attribute words whose meaning a section's kind holds: code is pure instructions, and debugging information
# is debug, which no image loads
val MACHO_ATTRIBUTE_COUNT: u32                              = 2;
val MACHO_ATTRIBUTES:      [MACHO_ATTRIBUTE_COUNT]Attribute = [MACHO_ATTRIBUTE_COUNT]Attribute{
    Attribute{word: "pure_instructions", sets: mink_section.EXEC, clears: 0},
    Attribute{word: "debug", sets: 0, clears: mink_section.ALLOC},
};

pub val MACHO_SECTIONS: Sections = Sections{
    form:       Form.macho{},
    start:      "__TEXT,__text",
    named:      Nameds{at: ?MACHO_NAMED[0], len: MACHO_NAMED_COUNT},
    types:      Words{at: ?MACHO_TYPES[0], len: MACHO_TYPE_COUNT},
    attributes: Attributes{at: ?MACHO_ATTRIBUTES[0], len: MACHO_ATTRIBUTE_COUNT},
};

# the coff flag letters, the content words those of mink's coff naming: a content letter, then `w` or `r`, and `D` for
# a section the link drops
val COFF_LETTER_COUNT: u32                       = 7;
val COFF_LETTERS:      [COFF_LETTER_COUNT]Letter = [COFF_LETTER_COUNT]Letter{
    Letter{letter: 'x', type: "cnt_code", sets: mink_section.EXEC, clears: 0},
    Letter{letter: 'd', type: "cnt_initialized_data", sets: 0, clears: 0},
    Letter{letter: 'b', type: "cnt_uninitialized_data", sets: 0, clears: 0},
    Letter{letter: 'i', type: "lnk_info", sets: 0, clears: mink_section.ALLOC},
    Letter{letter: 'w', type: nil, sets: mink_section.WRITE, clears: 0},
    Letter{letter: 'r', type: nil, sets: 0, clears: mink_section.WRITE},
    Letter{letter: 'D', type: nil, sets: 0, clears: mink_section.ALLOC},
};

# the coff selection words whose rule mink's groups hold. `associative` names, in place of a signature, a symbol or
# section that locates the leader section the section is kept with, and `newest`, which no rule is, is not among them
val COFF_SELECTION_COUNT: u32                             = 6;
val COFF_SELECTIONS:      [COFF_SELECTION_COUNT]Selection = [COFF_SELECTION_COUNT]Selection{
    Selection{word: "discard", rule: ?mink_group.ANY},
    Selection{word: "one_only", rule: ?mink_group.NODUPLICATE},
    Selection{word: "same_size", rule: ?mink_group.SAMESIZE},
    Selection{word: "same_contents", rule: ?mink_group.EXACT},
    Selection{word: "largest", rule: ?mink_group.LARGEST_ONE},
    Selection{word: "associative", rule: ?mink_group.ASSOCIATE},
};

pub val COFF_SECTIONS: Sections = Sections{
    form:       Form.coff{},
    start:      ".text",
    named:      Nameds{at: ?ELF_NAMED[0], len: ELF_NAMED_COUNT},
    letters:    Letters{at: ?COFF_LETTERS[0], len: COFF_LETTER_COUNT},
    selections: Selections{at: ?COFF_SELECTIONS[0], len: COFF_SELECTION_COUNT},
};

# the named directive `directive` of `s`, none when it has none
pub fun named_of(s: *Sections, directive: str) opt[*Named] {
    var i: u32 = 0;
    for (i < s.named.len) {
        if (str_equals(s.named.at[i].directive, directive)) { ret opt[*Named].some{?s.named.at[i]}; }
        i = i + 1;
    }
    ret opt[*Named].none{};
}

# a type word the text states a bridge's role by and the role, a row of mink's bridge roles
# ---
# word: the word, mink's constant for it
# role: the role
pub rec Bridging {
    word: *coff_tables.Constant;
    role: *bridge.Role;
}

# how a dialect's text states an object's bridges: under `.section` of the section's name, each a `.symidx` of the
# symbol served, a `.symidx` of its thunk and the four-byte type word of its role. the section is no section of the
# object, as the format lays it out of the bridges itself
# ---
# section: the section's name
# at:      the type words
# len:     how many
pub rec Bridges {
    section: str;
    at:      *Bridging;
    len:     u32;
}

# the arm64ec thunk map, its name and type words llvm's (mink's coff naming and tables, Arm64ECThunkType)
val ARM64EC_BRIDGING_COUNT: u32                              = 3;
val ARM64EC_BRIDGINGS:      [ARM64EC_BRIDGING_COUNT]Bridging = [ARM64EC_BRIDGING_COUNT]Bridging{
    Bridging{word: ?coff_tables.ARM64EC_THUNK_GUEST_EXIT, role: ?bridge.GUEST_EXIT},
    Bridging{word: ?coff_tables.ARM64EC_THUNK_ENTRY, role: ?bridge.ENTRY},
    Bridging{word: ?coff_tables.ARM64EC_THUNK_EXIT, role: ?bridge.EXIT},
};

val ARM64EC_BRIDGES: Bridges = Bridges{section: coff_naming.BRIDGES, at: ?ARM64EC_BRIDGINGS[0], len: ARM64EC_BRIDGING_COUNT};

# the role type word `word` states in `b`, none when none does
pub fun role_of(b: *Bridges, word: u64) opt[*bridge.Role] {
    var i: u32 = 0;
    for (i < b.len) {
        if (b.at[i].word.value == word) { ret opt[*bridge.Role].some{b.at[i].role}; }
        i = i + 1;
    }
    ret opt[*bridge.Role].none{};
}

# the type word `b` states role `r` by, none when none does
pub fun word_of(b: *Bridges, r: *bridge.Role) opt[u64] {
    var i: u32 = 0;
    for (i < b.len) {
        if (b.at[i].role == r) { ret opt[u64].some{b.at[i].word.value}; }
        i = i + 1;
    }
    ret opt[u64].none{};
}

# how a relocation names a label the object holds as no symbol, for a format whose assembler names an atom's symbol
# rather than the label's section: the nearest symbol placed at or before the label in its section, the
# label's offset from it in the addend, else the label's section, and always the section in a debugging section, as
# the linker splits a section into atoms at its symbols and a temporary label starts none
# ---
# within: whether a place-relative distance to a label of its own section is left to the linker unless the place and
#         the label lie in one atom, a place before every symbol of the section counting as in a temporary label's
#         atom. the places before every symbol are one atom, a distance into it from another relocated
#         against the section. without it a distance to a temporary label of its own section is always folded
pub rec Atoms {
    within: bool;
}

# mach-o on x86-64, whose distances fold only within an atom
pub val X86_64_ATOMS: Atoms = Atoms{within: true};

# mach-o on every other architecture, whose distances to a temporary label of its own section always fold
pub val ATOMS: Atoms = Atoms{within: false};

# the assembly dialect of a format, for one architecture or every one
# ---
# format:    the format
# arch:      the architecture whose dialect it is, nil for every architecture of the format no row names
# private:   the spelling that starts the names an assembler keeps out of its symbol table
# temporary: the stem of the labels the assembler makes with no name, their number following, which starts with
#            `private`, as `.Ltmp`
# local:     the directive that binds a symbol locally, nil for a dialect whose text binds a symbol locally by binding
#            it no other way, as coff's and mach-o's
# atoms:     how a relocation names a label the object holds as no symbol, nil for a dialect that names its section
# unique:    the word `.section` takes after its attributes, followed by a number, to open a section apart from every other
#            of its name, re-entered only by that name and number, none for a dialect that keeps no two sections of one
#            name apart
# module:    how the text states an object of the format as the one module the format builds from it, where the text
#            states no section, nil for a dialect whose text states sections
# sections:  how its text states a section
# bridges:   how its text states the object's bridges, nil for a dialect whose objects carry none
pub rec Dialect {
    format:    *format.Format;
    arch:      *mink_arch.Arch;
    private:   str;
    temporary: str;
    local:     str;
    atoms:     *Atoms;
    unique:    opt[str];
    module:    *stream.Module;
    sections:  *Sections;
    bridges:   *Bridges;
}

# elf: `.L` local symbol names and `unique, N` sections
pub val ELF: Dialect = Dialect{format: ?format.ELF, arch: nil, private: ".L", temporary: ".Ltmp", local: ".local", atoms: nil, unique: opt[str].some{"unique"}, module: nil, sections: ?ELF_SECTIONS, bridges: nil};

# coff for x86-64, aarch64 and arm64ec: `.L` private names and no unique sections. arm64ec is written as arm64 is
# ("Arm64EC uses the same procedure declaration and prolog/epilog macros as Arm64", Microsoft, "Understanding Arm64EC
# ABI and assembly code"), its objects stating mink's machine for it, IMAGE_FILE_MACHINE_ARM64EC, and its bridges in the
# thunk map
pub val COFF_X86_64:  Dialect = Dialect{format: ?format.COFF, arch: ?arch_x86.X86_64, private: ".L", temporary: ".Ltmp", local: nil, atoms: nil, unique: opt[str].none{}, module: nil, sections: ?COFF_SECTIONS, bridges: nil};
pub val COFF_AARCH64: Dialect = Dialect{format: ?format.COFF, arch: ?arch_aarch64.AARCH64, private: ".L", temporary: ".Ltmp", local: nil, atoms: nil, unique: opt[str].none{}, module: nil, sections: ?COFF_SECTIONS, bridges: nil};
pub val COFF_ARM64EC: Dialect = Dialect{format: ?format.COFF, arch: ?arch_aarch64.ARM64EC, private: ".L", temporary: ".Ltmp", local: nil, atoms: nil, unique: opt[str].none{}, module: nil, sections: ?COFF_SECTIONS, bridges: ?ARM64EC_BRIDGES};

# coff for i386: `L` private names and no unique sections
pub val COFF_X86: Dialect = Dialect{format: ?format.COFF, arch: ?arch_x86.X86, private: "L", temporary: "Ltmp", local: nil, atoms: nil, unique: opt[str].none{}, module: nil, sections: ?COFF_SECTIONS, bridges: nil};

# mach-o: `L` private names, no unique sections, and relocations that name an atom's symbol, whose distances on x86-64
# fold only within an atom
pub val MACHO_X86_64: Dialect = Dialect{format: ?format.MACHO, arch: ?arch_x86.X86_64, private: "L", temporary: "Ltmp", local: nil, atoms: ?X86_64_ATOMS, unique: opt[str].none{}, module: nil, sections: ?MACHO_SECTIONS, bridges: nil};
pub val MACHO:        Dialect = Dialect{format: ?format.MACHO, arch: nil, private: "L", temporary: "Ltmp", local: nil, atoms: ?ATOMS, unique: opt[str].none{}, module: nil, sections: ?MACHO_SECTIONS, bridges: nil};

# a spir-v module: no labels or sections a source names, so the `.L` of the syntax's anonymous labels and
# no unique sections, and the text a module's instruction stream
pub val SPIRV: Dialect = Dialect{format: ?format.SPIRV, arch: nil, private: ".L", temporary: ".Ltmp", local: ".local", atoms: nil, unique: opt[str].none{}, module: ?spirv_whole.MODULE, sections: ?ELF_SECTIONS, bridges: nil};

# a wasm module: no labels or sections a module's text names, so the `.L` of the syntax's anonymous labels
# and no unique sections, and the text a module's fields
pub val WASM: Dialect = Dialect{format: ?format.WASM, arch: nil, private: ".L", temporary: ".Ltmp", local: ".local", atoms: nil, unique: opt[str].none{}, module: ?wasm_whole.MODULE, sections: ?ELF_SECTIONS, bridges: nil};

# the dialects, a row for one architecture before the one for every architecture of its format
val DIALECT_COUNT: usize                   = 9;
val DIALECTS:      [DIALECT_COUNT]*Dialect = [DIALECT_COUNT]*Dialect{?ELF, ?COFF_X86_64, ?COFF_AARCH64, ?COFF_ARM64EC, ?COFF_X86, ?MACHO_X86_64, ?MACHO, ?SPIRV, ?WASM};

# the dialect of `f` for `a`, none for a format and architecture whose dialect masc does not state
pub fun of(f: *format.Format, a: *mink_arch.Arch) opt[*Dialect] {
    var i: usize = 0;
    for (i < DIALECT_COUNT) {
        val d: *Dialect = DIALECTS[i];
        if (d.format == f && (d.arch == a || d.arch == nil)) { ret opt[*Dialect].some{d}; }
        i = i + 1;
    }
    ret opt[*Dialect].none{};
}
