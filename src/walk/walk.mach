# walks over encoded code driven by instruction effects, such as the constant-time check
#
# the constant-time walk reads an encoded function through the set's decode
# dispatch and follows secrecy from the seeds the caller gives through
# registers and memory extents by each row's effect, refusing a secret that
# reaches a control transfer, an address or an input a row's timing depends
# on (`masc.core.ct`). it reads under the context the function runs under,
# since that is what decides a conditional row: the selection and state the
# caller compiled for, as aarch64 code that sets dit in its prologue or an
# `__arm_streaming` function. a set whose timing is `none` refuses before any
# walk (`ct.required`). the types land before the walk, so consumers build
# against its shape.

use std.types.size.usize;
use std.types.string.str;

use masc.core.ct;
use masc.core.register;
use masc.core.set;
use masc.core.state;

# a memory extent from a register's value plus an offset
# ---
# base:   the register holding the address
# offset: added to it
# length: the bytes it covers
pub rec Extent {
    base:   register.Id;
    offset: i64;
    length: u64;
}

# where a secret is when the code starts
# ---
# register: a register's value
# memory:   the bytes of an extent
pub tag Seed: u8 {
    register: register.Id;
    memory:   Extent;
}

# seeds as a pointer to the caller's rows and a count
pub rec Secrets {
    at:  *Seed;
    len: u32;
}

# encoded code of one function, the bytes the caller encoded
# ---
# set:  the instruction set it is encoded in
# data: its bytes
# len:  how many
pub rec Code {
    set:  *set.Set;
    data: *u8;
    len:  usize;
}

# a secret the walk found where constant-time code may hold none
# ---
# offset:  where the instruction that refuses it starts
# refusal: the one refusal record, worded once
pub rec Finding {
    offset:  u64;
    refusal: ct.Refusal;
}

# code the walk could not follow
# ---
# message: why, as bytes no row decodes or a transfer to where no code is
# offset:  where
pub rec Unread {
    message: str;
    offset:  u64;
}

# what the walk finds of a function
# ---
# clear:   no secret reaches what it may not
# refused: the first secret that does
# unread:  the code cannot be followed, so nothing is decided
pub tag Verdict: u8 {
    clear;
    refused: Finding;
    unread:  Unread;
}

# the constant-time walk of `code` under the context the function runs under, from the secrets the caller seeds
pub def Check: fun(*Code, *state.Context, *Secrets) Verdict;
