# assembling source text into objects through the builder
#
# the file-level assembler: a .s file read through the source model of
# `masc.asm.model` with the core directives of `masc.asm.core`, the set's
# integer data directives, and any layers the caller adds, into mink's
# neutral object in memory.
#
# a dialect whose text states the one module its format builds
# (`dialect.Dialect.module`) is read as the disassembler writes it. a module
# that is one instruction stream (`stream.Module.stream`), as spir-v's, is
# the builder's one section of that stream, so it is assembled as any other
# source. a module with text of its own (`stream.Module.printed`), as wasm's
# fields, is read whole by its set's reader into the neutral object of the
# module, which the format writes as every other object.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;

use mink_arch:   mink.catalog.arch;
use mink_object: mink.model.object;

use masc.asm.core;
use masc.asm.model;
use masc.asm.source;
use masc.build;
use build_refusal: masc.build.refusal;
use build_trait:   masc.build.trait;
use masc.core.diagnostic;
use masc.core.field;
use masc.core.mode;
use masc.core.set;
use core_source: masc.core.source;
use masc.core.state;
use masc.core.stream;
use masc.core.trait;

# an assembler over `s` with the core directives, the set's integer data directives and `options.layers`, its
# current section `.text`, writing under the object's context `object`, which the caller makes with `set.make` for
# `options.arch` and keeps until the assembler is released
pub fun init(a: *A.Allocator, s: *set.Set, object: *state.Context, options: model.Options) res[model.Assembler, model.Refusal] {
    val res_made: res[model.Assembler, model.Refusal] = model.init(a, s, object, options, ?core.LAYER, core.symbols(options.dialect), core.integers, core.named_section);
    if (sel res_made.err) { ret res_made; }
    var m:         model.Assembler = res_made.ok;
    val err_begun: err[str]        = core.begin(?m);
    if (sel err_begun.err) {
        model.dnit(?m);
        ret res[model.Assembler, model.Refusal].err{model.nowhere(err_begun.err)};
    }
    ret res[model.Assembler, model.Refusal].ok{m};
}

# the `len` bytes of `text`, whose first byte is at `origin`, assembled under the object's context `object` into mink's
# neutral object, which the caller releases
pub fun assemble(a: *A.Allocator, s: *set.Set, object: *state.Context, options: model.Options, text: *u8, len: usize, origin: diagnostic.Position) res[mink_object.Object, model.Refusal] {
    val res_made: res[model.Assembler, model.Refusal] = init(a, s, object, options);
    if (sel res_made.err) { ret res[mink_object.Object, model.Refusal].err{res_made.err}; }
    var m:       model.Assembler    = res_made.ok;
    val err_ran: err[model.Refusal] = read(?m, s, text, len, origin);
    if (sel err_ran.err) {
        model.dnit(?m);
        ret res[mink_object.Object, model.Refusal].err{err_ran.err};
    }
    val res_finish: res[*mink_object.Object, model.Refusal] = model.finish(?m);
    if (sel res_finish.err) {
        model.dnit(?m);
        ret res[mink_object.Object, model.Refusal].err{res_finish.err};
    }
    val res_taken: res[mink_object.Object, build_refusal.Refusal] = build.take(model.builder(?m));
    model.dnit(?m);
    if (sel res_taken.err) { ret res[mink_object.Object, model.Refusal].err{model.refused_build(res_taken.err)}; }
    ret res[mink_object.Object, model.Refusal].ok{res_taken.ok};
}

# the `len` bytes of `text`, whose first byte is at `origin`, read by the assembler `m` over `s` into its builder, which
# the caller finishes, so a caller that reads the builder's record after the object is made, as a listing does, keeps it
pub fun read(m: *model.Assembler, s: *set.Set, text: *u8, len: usize, origin: diagnostic.Position) err[model.Refusal] {
    val err_seen: err[model.Refusal] = foreseen(m, s, text, len, origin);
    if (sel err_seen.err) { ret err_seen; }
    var lexer: source.Lexer = source.lexer(text, len, origin, ?s.source);
    var feed:  source.Feed  = source.feed(?lexer);
    ret model.run(m, ?feed);
}

# every instruction statement of the `len` bytes of `text`, whose first byte is at `origin`, handed to the stream's
# `ahead` before the assembler reads any, refused where the text is malformed as reading it would refuse it
fun foreseen(m: *model.Assembler, s: *set.Set, text: *u8, len: usize, origin: diagnostic.Position) err[model.Refusal] {
    if (s.codec == nil) { ret err[model.Refusal].ok{}; }
    val h: *stream.Hooks = s.codec.stream;
    if (h == nil || h.ahead == nil) { ret err[model.Refusal].ok{}; }
    val v:     *state.Context = build_trait.view(model.builder(m));
    var lexer: source.Lexer   = source.lexer(text, len, origin, ?s.source);
    var feed:  source.Feed    = source.feed(?lexer);
    var st:    source.Statement;
    for {
        val res_more: res[bool, diagnostic.Diagnostic] = feed.next(feed.context, ?st);
        if (sel res_more.err)              { ret err[model.Refusal].err{model.diagnosed(res_more.err, res_more.err.span.start, v)}; }
        if (!res_more.ok)                  { brk; }
        if (st.kind != source.INSTRUCTION) { cnt; }
        val whole:    View     = View{data: ?st.text[st.head.at], len: st.body.at + st.body.len - st.head.at};
        val err_held: err[str] = h.ahead(v.stream, whole);
        if (sel err_held.err) { ret err[model.Refusal].err{model.nowhere(err_held.err)}; }
    }
    ret err[model.Refusal].ok{};
}

# the `len` bytes of `text`, whose first byte is at `origin`, assembled under the object's context `object` into mink's
# neutral object as the dialect `options.dialect` states an object: the module of a dialect whose text prints one, read
# whole by its reader (`printed`), and every other text through the builder (`assemble`), which the caller releases
pub fun assembled(a: *A.Allocator, s: *set.Set, object: *state.Context, options: model.Options, text: *u8, len: usize, origin: diagnostic.Position) res[mink_object.Object, model.Refusal] {
    val m: *stream.Module = options.dialect.module;
    if (m != nil) {
        if (sel m.printed) { ret printed(a, s, object, options.arch, m.printed, text, len, origin); }
    }
    ret assemble(a, s, object, options, text, len, origin);
}

# the neutral object of the module the `len` bytes of `text`, whose first byte is at `origin`, read through `p` under
# the object's context `object` and a stream of its own, refused, as every object is, for a context that does not
# enter `arch`
fun printed(a: *A.Allocator, s: *set.Set, object: *state.Context, arch: *mink_arch.Arch, p: stream.Printed, text: *u8, len: usize, origin: diagnostic.Position) res[mink_object.Object, model.Refusal] {
    val err_entered: err[build_refusal.Refusal] = build.enters(s, arch, object);
    if (sel err_entered.err) { ret res[mink_object.Object, model.Refusal].err{model.refused_build(err_entered.err)}; }
    # a typed stream's state is the module's, begun by its reader, as the builder begins an object's
    var v: state.Context = @object;
    val h: *stream.Hooks = s.codec.stream;
    if (h != nil) {
        if (object.stream != nil) { ret res[mink_object.Object, model.Refusal].err{model.nowhere(build_refusal.STREAMED)}; }
        val res_made: res[ptr, A.Error] = h.make(a);
        if (sel res_made.err) { ret res[mink_object.Object, model.Refusal].err{model.nowhere(field.MEMORY)}; }
        v.stream = res_made.ok;
    }
    fin {
        if (h != nil) { h.release(a, v.stream); }
    }
    val res_back: res[mink_object.Object, diagnostic.Diagnostic] = p.read(a, text, len, origin, ?v, arch);
    if (sel res_back.err) { ret res[mink_object.Object, model.Refusal].err{model.diagnosed(res_back.err, res_back.err.span.start, ?v)}; }
    ret res[mink_object.Object, model.Refusal].ok{res_back.ok};
}
