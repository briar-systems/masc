# the encoding form of one instruction: the choices among encodings of one row's value that no extension decides
#
# a form is bits a set lays out in fields of its codec, as x86's `{disp32}` or `{vex3}` and thumb's `.w`. the zero form
# is the set's preference, its row order and its kinds' defaults, so an instruction that states nothing is encoded as
# the encoder prefers. decode writes the form bits an encoding read states where the zero form would encode it
# otherwise, encode reads them, and the syntax spells a field's marker on an instruction that holds it.
#
# one bit is the core's own, EXACT: the instruction is written in its own row, never compressed into a shorter one,
# as a step of a call pair whose relocations fix its length. a set may give it a marker like any field of its own.

use std.types.bool.bool;
use std.types.string.str;

# the form bits of one instruction, PREFERRED for none
pub rec Form {
    bits: u32;
}

pub val PREFERRED: Form = Form{bits: 0};

# the core's bit: written in its own row, never compressed
pub val EXACT: u32 = 0x8000_0000;

# one choice of a form field: the bits under `mask` set to `value`
# ---
# name:   the name diagnostics and generators spell
# mask:   the form bits the field holds, clear of EXACT unless it is EXACT
# value:  the bits under the mask this choice sets, never zero, which is the preference
# marker: the text the syntax spells the choice with, nil for one no marker spells, as a choice decode states that the
#         encoding's own spelling already shows
# suffix: whether the marker follows the mnemonic, as thumb's `.w`, rather than preceding it as x86's `{disp32}`
pub rec FormField {
    name:   str;
    mask:   u32;
    value:  u32;
    marker: str;
    suffix: bool;
}

# a codec's form fields as a pointer to static fields and a count
pub rec FormFields {
    at:  *FormField;
    len: u32;
}

pub val NO_FORM_FIELDS: FormFields = FormFields{at: nil, len: 0};

# whether `form` holds the choice `f`
pub fun holds(form: Form, f: *FormField) bool {
    ret (form.bits & f.mask) == f.value;
}

# `form` with the choice `f` made in place of what its field held
pub fun with(form: Form, f: *FormField) Form {
    ret Form{bits: (form.bits & ~f.mask) | f.value};
}

# whether `form` asks for the instruction's own row, never compressed
pub fun exact(form: Form) bool {
    ret (form.bits & EXACT) != 0;
}
