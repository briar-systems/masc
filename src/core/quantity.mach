# a quantity that scales with the implementation, the selection or the state code runs under, as the vector length or
# risc-v's xlen
#
# a quantity is a unit of bits times a multiplier, the multiplier one of its
# domain: the powers of two in a range, as a vector length, or every step of
# a range, as sparc's window count. its bounds narrow the multiplier where
# their requirement holds, as zvl128b states vlen is at least 128 bits or rv64
# states xlen is 64, and the multiplier a context resolves is the range every
# bound that holds leaves, refused when that is empty. a range of one value is
# the quantity fixed, and a wider one is the implementation's choice within it.
#
# a register width or footprint names a slot, not a quantity: the slot binds a
# quantity under a requirement, as aarch64's z registers are vl wide outside
# streaming mode and svl wide in it, so one file serves both and a context
# reads the quantity its state binds. a scaled amount is a fixed part plus a
# part per unit of its slot's multiplier.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.string.str;

use masc.core.requirement;

# a range of multipliers, least to most, both included
pub rec Range {
    least: u32;
    most:  u32;
}

# every step-th multiplier from least to most
# ---
# least: the first
# most:  the last that may be reached
# step:  the distance between two, at least 1
pub rec Steps {
    least: u32;
    most:  u32;
    step:  u32;
}

# the multipliers a quantity may take
# ---
# powers: the powers of two within the range, as a vector length
# range:  every step of the range, as sparc's 2 to 32 register windows
pub tag Domain: u8 {
    powers: Range;
    range:  Steps;
}

# a narrowing of a quantity's multiplier while a requirement holds
# ---
# when:  the requirement, over extensions and state values
# least: the least multiplier it admits
# most:  the most
pub rec Bound {
    when:  requirement.Requirement;
    least: u32;
    most:  u32;
}

# bounds as a pointer to static rows and a count
pub rec Bounds {
    at:  *Bound;
    len: u32;
}

pub val NO_BOUNDS: Bounds = Bounds{at: nil, len: 0};

# a register row whose value counts a quantity, which reads multiplier * unit / count
# ---
# row:   the row of the quantity's own file, as risc-v's vlenb or aarch64's vg
# count: the bits of the quantity one count of the value stands for, whole at every multiplier of the domain: 8 for
#        vlenb, which reads vlen in bytes, 64 for vg, which reads vl in 8-byte granules, and 32 for a register counting
#        the 32-bit elements of the quantity
pub rec Gauge {
    row:   u32;
    count: u32;
}

# what measures a quantity at run time
# ---
# none:     nothing reads it, as risc-v's xlen, which only the selection fixes
# register: the value of a register row, read as a count
pub tag Measure: u8 {
    none;
    register: Gauge;
}

# one quantity of a register file
# ---
# name:    the spelling diagnostics use, as `vlen`
# unit:    the bits it holds at multiplier 1
# domain:  the multipliers it may take
# bounds:  what narrows the multiplier, under which requirement
# measure: what reads it at run time, so a consumer scales by the register's value through the row alone
pub rec Quantity {
    name:    str;
    unit:    u32;
    domain:  Domain;
    bounds:  Bounds;
    measure: Measure;
}

# quantities as a pointer to static rows and a count
pub rec Quantities {
    at:  *Quantity;
    len: u32;
}

pub val NO_QUANTITIES: Quantities = Quantities{at: nil, len: 0};

# a slot bound to a quantity while a requirement holds. a slot's bindings are exclusive, so at most one holds
# ---
# slot:     the slot a scaled amount names
# when:     the requirement under which it binds
# quantity: the index of the quantity it binds in its file
pub rec Binding {
    slot:     u8;
    when:     requirement.Requirement;
    quantity: u8;
}

# bindings as a pointer to static rows and a count
pub rec Bindings {
    at:  *Binding;
    len: u32;
}

pub val NO_BINDINGS: Bindings = Bindings{at: nil, len: 0};

# the quantity index a slot binds when no binding holds
pub val UNBOUND: u8 = 0xFF;

# an amount of the fixed part plus per times the multiplier of the quantity one slot binds
# ---
# fixed: the part no quantity changes
# per:   the part added for each unit of the multiplier
# scale: the slot whose quantity's multiplier it scales with, read only when per is nonzero, and one slot for every
#        part of a register and its class
pub rec Scaled {
    fixed: u32;
    per:   u32;
    scale: u8;
}

# the amount of `q` at multiplier `m` of its slot's quantity
pub fun at(q: Scaled, m: u64) u64 {
    ret q.fixed::u64 + q.per::u64 * m;
}

# whether a register counting `count` bits of a quantity of `unit` bits over `d` reads a whole count at every
# multiplier: the least multiplier's bits, and for a range its step's, are a multiple of the count
pub fun whole(unit: u32, d: Domain, count: u32) bool {
    if (count == 0) { ret false; }
    val c: u64 = count::u64;
    if (sel d.powers) { ret (d.powers.least::u64 * unit::u64) % c == 0; }
    ret (d.range.least::u64 * unit::u64) % c == 0 && (d.range.step::u64 * unit::u64) % c == 0;
}

# the count the register measuring `q` reads at multiplier `m`, none when no register measures it
pub fun reads(q: *Quantity, m: u64) opt[u64] {
    if (!sel q.measure.register) { ret opt[u64].none{}; }
    val g: Gauge = q.measure.register;
    ret opt[u64].some{m * q.unit::u64 / g.count::u64};
}

# the multiplier of `q` a read of `value` from its register stands for, none when no register measures it or the
# value is no multiplier of its domain
pub fun multiplier(q: *Quantity, value: u64) opt[u64] {
    if (!sel q.measure.register) { ret opt[u64].none{}; }
    val g:    Gauge = q.measure.register;
    val bits: u64   = value * g.count::u64;
    if (bits % q.unit::u64 != 0 || !legal(q.domain, bits / q.unit::u64)) { ret opt[u64].none{}; }
    ret opt[u64].some{bits / q.unit::u64};
}

# the bits a scaled amount's `per` bits per multiplier of `q` come to per count its register reads, so the amount is
# its fixed part plus this times the value read. none when no register measures `q` or the share is no whole bit
pub fun per_count(q: *Quantity, per: u32) opt[u64] {
    val s: opt[i64] = share(q, per::i64);
    if (sel s.none) { ret opt[u64].none{}; }
    ret opt[u64].some{s.some::u64};
}

# `per_count` of an amount that may be negative, as a save slot below the canonical frame address, in any unit: `per`
# of it per multiplier of `q` comes to the result per count its register reads
pub fun share(q: *Quantity, per: i64) opt[i64] {
    if (!sel q.measure.register) { ret opt[i64].none{}; }
    val g:     Gauge = q.measure.register;
    val units: i64   = per * g.count::i64;
    if (units % q.unit::i64 != 0) { ret opt[i64].none{}; }
    ret opt[i64].some{units / q.unit::i64};
}

# the range a domain spans, least to most
pub fun span(d: Domain) Range {
    if (sel d.powers) { ret d.powers; }
    ret Range{least: d.range.least, most: d.range.most};
}

# whether `m` is a multiplier of the domain
pub fun legal(d: Domain, m: u64) bool {
    if (sel d.powers) {
        val r: Range = d.powers;
        ret m >= r.least::u64 && m <= r.most::u64 && (m & (m - 1)) == 0;
    }
    val s: Steps = d.range;
    ret m >= s.least::u64 && m <= s.most::u64 && s.step != 0 && (m - s.least::u64) % s.step::u64 == 0;
}

# the least multiplier of the domain past `m`, none when none is. 0 starts at the first
pub fun next(d: Domain, m: u64) opt[u64] {
    if (sel d.powers) {
        val r: Range = d.powers;
        var p: u64   = 1;
        for (p < r.least::u64 || p <= m) {
            p = p * 2;
        }
        if (p > r.most::u64) { ret opt[u64].none{}; }
        ret opt[u64].some{p};
    }
    val s: Steps = d.range;
    if (s.step == 0) { ret opt[u64].none{}; }
    var v: u64 = s.least::u64;
    if (m >= v)          { v = v + ((m - v) / s.step::u64 + 1) * s.step::u64; }
    if (v > s.most::u64) { ret opt[u64].none{}; }
    ret opt[u64].some{v};
}

# whether the domain is well formed and holds a multiplier: a range from at least 1, powers bounded by powers of two,
# and a range stepped by at least 1
pub fun inhabited(d: Domain) bool {
    if (sel d.powers) {
        val r: Range = d.powers;
        if (r.least == 0 || r.least > r.most) { ret false; }
        ret (r.least & (r.least - 1)) == 0 && (r.most & (r.most - 1)) == 0;
    }
    val s: Steps = d.range;
    ret s.least != 0 && s.least <= s.most && s.step != 0;
}

# `r` narrowed to the multipliers `b` admits, an empty range when they share none
pub fun clip(r: Range, b: *Bound) Range {
    var out: Range = r;
    if (b.least > out.least) { out.least = b.least; }
    if (b.most < out.most)   { out.most = b.most; }
    ret out;
}

# whether the range holds a multiplier of the domain
pub fun meets(d: Domain, r: Range) bool {
    if (r.least > r.most) { ret false; }
    var m: u64 = 0;
    if (r.least > 0) { m = r.least::u64 - 1; }
    val got: opt[u64] = next(d, m);
    ret sel got.some && got.some <= r.most::u64;
}

#[testing]
val T_POWERS: Domain = Domain.powers{Range{least: 1, most: 16}};
#[testing]
val T_STEPS:  Domain = Domain.range{Steps{least: 2, most: 32, step: 1}};

# how many multipliers `d` steps through, every one of them legal, 0 when one is not
#[testing]
fun t_steps(d: Domain) u32 {
    var n:  u32 = 0;
    var at: u64 = 0;
    for {
        val m: opt[u64] = next(d, at);
        if (sel m.some) {
            if (!legal(d, m.some)) { ret 0; }
            n  = n + 1;
            at = m.some;
        }
        or { ret n; }
    }
    ret n;
}

# a range domain admits every integer of it, as sparc's 2 to 32 register windows, and powers only their powers of two
test next__a_domain_steps_through_its_multipliers_and_none_past_its_range {
    if (t_steps(T_POWERS) != 5 || !legal(T_POWERS, 8) || legal(T_POWERS, 6))                                              { ret 1; }
    if (t_steps(T_STEPS) != 31 || legal(T_STEPS, 1) || !legal(T_STEPS, 7))                                                { ret 3; }
    if (!meets(T_STEPS, Range{least: 5, most: 5}) || meets(T_POWERS, Range{least: 5, most: 7}))                           { ret 4; }
    if (inhabited(Domain.range{Steps{least: 3, most: 2, step: 1}}) || inhabited(Domain.powers{Range{least: 3, most: 8}})) { ret 5; }
    ret 0;
}

# aarch64's vl of 128 bits per multiplier read by vg in 8-byte granules, as rdsvl reads svl in bytes and cntw counts
# 32-bit elements: vg reads 2 per multiplier, a read of 3 is no power of two, and a z register's 128 bits per multiplier
# come to 64 per granule while a p register's 16 do to 8. a single bit per multiplier is no whole share of a granule
test reads__a_register_counts_its_quantity_in_its_own_unit {
    val vl: Quantity = Quantity{name: "vl", unit: 128, domain: Domain.powers{Range{least: 1, most: 16}}, bounds: NO_BOUNDS, measure: Measure.register{Gauge{row: 0, count: 64}}};
    val vg: opt[u64] = reads(?vl, 4);
    if (!(sel vg.some && vg.some == 8)) { ret 1; }
    val m:    opt[u64] = multiplier(?vl, 8);
    val odd:  opt[u64] = multiplier(?vl, 3);
    val past: opt[u64] = multiplier(?vl, 64);
    if (!(sel m.some && m.some == 4) || sel odd.some || sel past.some) { ret 2; }
    val z:   opt[u64] = per_count(?vl, 128);
    val p:   opt[u64] = per_count(?vl, 16);
    val bit: opt[u64] = per_count(?vl, 1);
    if (!(sel z.some && z.some == 64) || !(sel p.some && p.some == 8) || sel bit.some)                      { ret 3; }
    if (!whole(vl.unit, vl.domain, 64) || !whole(vl.unit, vl.domain, 32) || whole(vl.unit, vl.domain, 256)) { ret 4; }
    var unread: Quantity = vl;
    unread.measure = Measure.none{};
    val none:  opt[u64] = reads(?unread, 1);
    val share: opt[u64] = per_count(?unread, 128);
    if (sel none.some || sel share.some) { ret 5; }
    ret 0;
}
