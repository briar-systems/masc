# the one diagnostic of text masc reads
#
# every refusal of source text, an assembly line, an inline block or a
# selection spelling, is a message at a span with its line and column. a
# reader knows the position its text starts at, so a span inside an inline
# block is already a span of the caller's file. refusals of binary streams
# and of registered tables have no text and are not diagnostics.

use std.types.size.usize;
use std.types.string.str;

use masc.core.requirement;

# a place in source text
# ---
# offset: the byte offset from the start of the file
# line:   the line, from 1
# column: the byte column within the line, from 1
pub rec Position {
    offset: usize;
    line:   u32;
    column: u32;
}

# the start of a file
pub val START: Position = Position{offset: 0, line: 1, column: 1};

# bytes of source text from `start`
pub rec Span {
    start: Position;
    len:   usize;
}

# why text was refused, and where
# ---
# message:  the wording
# span:     the text refused
# requires: what the selection must hold to admit what was refused, `requirement.NONE` when the refusal is not about one
pub rec Diagnostic {
    message:  str;
    span:     Span;
    requires: requirement.Requirement;
}

# the position just past `text[0..len]`, where `from` is the position of `text[0]`
pub fun advance(from: Position, text: *u8, len: usize) Position {
    var p: Position = from;
    var i: usize    = 0;
    for (i < len) {
        if (text[i] == '\n') {
            p.line   = p.line + 1;
            p.column = 1;
        }
        or {
            p.column = p.column + 1;
        }
        i = i + 1;
    }
    p.offset = from.offset + len;
    ret p;
}

# a diagnostic of `message` at `text[at..at + len]`, where `origin` is the position of `text[0]`
pub fun refusal(message: str, origin: Position, text: *u8, at: usize, len: usize) Diagnostic {
    ret Diagnostic{message: message, span: Span{start: advance(origin, text, at), len: len}, requires: requirement.NONE};
}

# a diagnostic of `message` at `text[at..at + len]` that the selection would not have refused had it held `required`
pub fun unmet(message: str, required: requirement.Requirement, origin: Position, text: *u8, at: usize, len: usize) Diagnostic {
    var d: Diagnostic = refusal(message, origin, text, at, len);
    d.requires = required;
    ret d;
}
