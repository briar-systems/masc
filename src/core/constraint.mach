# the register constraints of a row's operands
#
# some instructions reserve the forms whose operands share registers: an
# output written before every input is read (an early clobber, as aarch64's
# writeback pair loads, where rt must not be rn), two operands that must
# differ (aarch64 ldp's rt and rt2), and register groups that must stay apart
# (the risc-v vector rules). a row states them as one list, and the walks and
# every consumer read it through `violated`, so the rule has one owner.
#
# sharing is tested with register.overlap over footprints: the run of
# consecutive registers of its class a value covers from the register it
# names. how long a run is can depend on state the instruction does not hold,
# as risc-v's vtype decides how many registers a vector group covers. a
# consumer that knows that state states it as a `Grouping`. the walks know no
# such state, so they test at `UNIT`, where every group is one register. a
# form refused there is refused under every grouping: a longer group only
# extends a run past the register its operand names, so the runs' starts, and
# with them every overlap and every permit below, stay as `UNIT` finds them.
#
# a consumer that states a grouping is told as well when a group runs past
# the last register of its class, which the walks, knowing no lengths, never
# refuse. and where a row's rule depends on state no operand states, as risc-v
# vrgatherei16's two read widths, a constraint stands in for it with a `Gap`
# naming the rule: it marks the registers the rule concerns, and `violated`
# answers inexact where the values share them, so an undecided form never
# reads as clear.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use masc.core.effect;
use masc.core.index;
use masc.core.operand;
use masc.core.register;
use masc.core.requirement;

# which registers of an operand's value a side names
# ---
# WHOLE: the register a register operand holds, or every member of a register list
# BASE:  the base of a memory operand, as aarch64's rn under writeback
# INDEX: the index of a memory operand, as the vsib index of an x86 gather
pub def Part: u8;

pub val WHOLE: Part = 0;
pub val BASE:  Part = 1;
pub val INDEX: Part = 2;

# the registers of one operand a constraint names, each value covering the fields of its operand's register shape
# ---
# operand: the operand
# part:    which of its value's registers
pub rec Side {
    operand: u8;
    part:    Part;
}

# sides as a pointer to static sides and a count
pub rec Sides {
    at:  *Side;
    len: u32;
}

pub val NO_SIDES: Sides = Sides{at: nil, len: 0};

# what a constraint keeps its side apart from
# ---
# sides:    the registers of these operands, as ldp's rt2 apart from rt
# inputs:   every register the instruction reads, but the side's own operand's: the register
#           operands it reads, the base and index of every memory operand, whose address it reads
#           whatever it does with the memory, and the registers it reads that no operand names,
#           its effect's implicit reads. an early clobber
# register: the register at this row of the file, as risc-v's v0 mask
pub tag Against: u8 {
    sides: Sides;
    inputs;
    register: u32;
}

# the overlap a constraint permits between its side and the registers it is kept from
# ---
# DISJOINT: none
# HIGHEST:  the side's group is the wider, and the other group may lie in its highest-numbered
#           registers, ending where it ends, when the other covers at least one whole register,
#           as a risc-v widening destination over a single-width source
# LOWEST:   the side's group is the narrower, and it may start where the other starts, as a
#           risc-v narrowing destination over its double-width source
#
# a permit is read only between two groups of one class, each of one field
pub def Permit: u8;

pub val DISJOINT: Permit = 0;
pub val HIGHEST:  Permit = 1;
pub val LOWEST:   Permit = 2;

# a rule a constraint stands in for without stating it, decided by state no operand states
# ---
# NO_GAP:        none, the constraint states its rule
# SEW_INDEX:     two sources may share registers only when the element width the state sets equals the fixed width
#                one of them is read at, as risc-v vrgatherei16's vs1 at 16 against vs2 at SEW
# INDEX_OVERLAP: a data group and an index group read at a fixed width may share registers only as the state's
#                element width allows against that width, as a risc-v indexed load's vd or store's vs3 against vs2
pub def Gap: u8;

pub val NO_GAP:        Gap = 0;
pub val SEW_INDEX:     Gap = 1;
pub val INDEX_OVERLAP: Gap = 2;

pub val GAP_COUNT: u8 = 3;

# one constraint of a row
# ---
# side:    the registers kept apart
# against: what they are kept apart from
# permit:  the overlap allowed nonetheless
# when:    the operand values under which it holds, every one, effect.NO_TERMS for any values,
#          as risc-v's mask rule holding only when the mask operand is v0.t
# gap:     the rule it stands in for, NO_GAP when it states its own. one with a gap permits
#          DISJOINT and marks the registers the rule concerns, where sharing is undecided
pub rec Constraint {
    side:    Side;
    against: Against;
    permit:  Permit;
    when:    effect.Terms;
    gap:     Gap;
}

# constraints as a pointer to static constraints and a count
pub rec Constraints {
    at:  *Constraint;
    len: u32;
}

pub val NO_CONSTRAINTS: Constraints = Constraints{at: nil, len: 0};

# how many registers each operand's groups cover under state the instruction does not hold
# ---
# lengths: one per operand, the registers of one group as a power of two exponent, negative
#          for a group within one register, as a risc-v vector group under a fractional emul.
#          an operand past the list covers one register a group
# len:     how many lengths there are
pub rec Grouping {
    lengths: *i8;
    len:     u32;
}

# every group one register, the grouping the walks test at
pub val UNIT: Grouping = Grouping{lengths: nil, len: 0};

# what `violated` finds of an instruction's operand values under a grouping
# ---
# clear:   every constraint holds and every stated group lies within its class
# broken:  the first constraint without a gap the values break
# outside: the first operand one of whose groups runs past the last register of its class, where the grouping
#          states the operand's length
# inexact: the first constraint with a gap whose registers the values share, nothing being broken or outside.
#          the state no operand states decides whether the form is reserved
pub tag Verdict: u8 {
    clear;
    broken:  *Constraint;
    outside: u8;
    inexact: *Constraint;
}

# a run of consecutive registers of one class
# ---
# first: the register it starts at, register.NONE for no register, as a memory value with no index
# len:   how many registers it covers
# whole: whether it covers each of them whole, false for a group within one register
rec Run {
    first: register.Id;
    len:   u32;
    whole: bool;
}

# the groups each value of part `part` of operand `op` covers back to back: its register shape's fields, one for a memory part
fun fields_of(operands: *operand.Operand, op: u8, part: Part) u32 {
    if (part != WHOLE) { ret 1; }
    val sh: *operand.Shape = ?operands[op].shape;
    if (sel sh.register) { ret sh.register.fields::u32; }
    if (sel sh.list)     { ret sh.list.member.fields::u32; }
    ret 1;
}

# the run of `fields` groups of operand `op` from `first` under `g`
fun run_of(g: Grouping, op: u8, fields: u32, first: register.Id) Run {
    var e: i8 = 0;
    if (op::u32 < g.len) { e = g.lengths[op]; }
    var per: u32 = 1;
    if (e > 0) { per = 1::u32 << e::u32; }
    ret Run{first: first, len: per * fields, whole: e >= 0};
}

# how many runs part `part` of operand `op`'s value has: one per member of a list, one otherwise, none for an absent value
fun runs(values: operand.Values, op: u8, part: Part) u32 {
    if (op::u32 >= values.len) { ret 0; }
    val v: operand.Value = values.at[op];
    if (part == WHOLE) {
        if (sel v.list) {
            val members: operand.Values = v.list;
            ret members.len;
        }
        if (sel v.register) { ret 1; }
        ret 0;
    }
    if (sel v.memory) { ret 1; }
    ret 0;
}

# run `i` of part `part` of operand `op`'s value
fun run(g: Grouping, operands: *operand.Operand, values: operand.Values, op: u8, part: Part, i: u32) Run {
    val v:      operand.Value = values.at[op];
    val fields: u32           = fields_of(operands, op, part);
    if (sel v.register) { ret run_of(g, op, fields, v.register); }
    if (sel v.list) {
        val members: operand.Values = v.list;
        val m:       operand.Value  = members.at[i];
        if (sel m.register) { ret run_of(g, op, fields, m.register); }
        ret Run{first: register.NONE, len: 0, whole: true};
    }
    if (sel v.memory) {
        val a: operand.Address = v.memory;
        if (part == BASE) { ret Run{first: a.base, len: 1, whole: true}; }
        ret Run{first: a.index, len: 1, whole: true};
    }
    ret Run{first: register.NONE, len: 0, whole: true};
}

# whether register `n` registers past `first` exists in `file`, and its row
fun member(file: *register.File, first: register.Id, n: u32) opt[*register.Register] {
    val number: u32 = register.number_of(first)::u32 + n;
    if (number > 0xFFFF) { ret opt[*register.Register].none{}; }
    ret register.row_of(file, register.make(register.class_of(first), number::u16));
}

# whether some register of `a` shares storage with some register of `b`. a group past
# its class's last register covers only the registers there are
fun overlap(file: *register.File, a: *Run, b: *Run) bool {
    var i: u32 = 0;
    for (i < a.len) {
        val x: opt[*register.Register] = member(file, a.first, i);
        if (sel x.some) {
            var k: u32 = 0;
            for (k < b.len) {
                val y: opt[*register.Register] = member(file, b.first, k);
                if (sel y.some && register.overlap(file, x.some, y.some)) { ret true; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret false;
}

# whether `permit` allows side run `a` over run `b`, which overlap
fun permits(permit: Permit, a: *Run, b: *Run) bool {
    if (permit == DISJOINT || register.class_of(a.first) != register.class_of(b.first)) { ret false; }
    val na: u32 = register.number_of(a.first)::u32;
    val nb: u32 = register.number_of(b.first)::u32;
    if (permit == HIGHEST) { ret b.whole && nb > na && nb + b.len == na + a.len; }
    ret na == nb;
}

# whether side run `a` overlaps some run of part `part` of operand `op` where `permit` does not allow it
fun clash_part(file: *register.File, g: Grouping, operands: *operand.Operand, values: operand.Values, permit: Permit, a: *Run, op: u8, part: Part) bool {
    val count: u32 = runs(values, op, part);
    var k:     u32 = 0;
    for (k < count) {
        val b: Run = run(g, operands, values, op, part, k);
        if (b.first != register.NONE && overlap(file, a, ?b) && !permits(permit, a, ?b)) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether the value of the operand `term` tests is unknown: none for an operand that always takes one
fun unknown(operands: *operand.Operand, values: operand.Values, term: *effect.Term) bool {
    if (term.operand::u32 >= values.len) { ret true; }
    val v: operand.Value = values.at[term.operand];
    ret sel v.none && operands[term.operand].quantity == operand.ONE;
}

# whether every term of `terms` holds or tests an operand whose value is unknown, so that `terms` may hold
fun may_meet(file: *register.File, terms: effect.Terms, operands: *operand.Operand, values: operand.Values) bool {
    var k: u32 = 0;
    for (k < terms.len) {
        val term: *effect.Term = ?terms.at[k];
        if (!unknown(operands, values, term) && !effect.meets(file, effect.Terms{at: term, len: 1}, values)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# the registers no operand names that the instruction reads: by its operand values when every value its effect's
# rules test is known, else every one some values read
fun implicit_reads(file: *register.File, e: *effect.Effect, operands: *operand.Operand, values: operand.Values) effect.Set {
    var i: u32 = 0;
    for (i < e.implicit.rules.len) {
        val terms: effect.Terms = e.implicit.rules.at[i].terms;
        var k:     u32          = 0;
        for (k < terms.len) {
            if (unknown(operands, values, ?terms.at[k])) { ret effect.may(e).read; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret effect.implicit(file, e, values).read;
}

# whether side run `a` overlaps a register of `set`, rows of `file`
fun clash_set(file: *register.File, a: *Run, set: effect.Set) bool {
    var w: u32 = 0;
    for (w < set.len) {
        var bits: u64 = set.words[w];
        var b:    u32 = 0;
        for (bits != 0) {
            if ((bits & 1) != 0) {
                val at: u32 = w * 64 + b;
                if (at < file.register_count) {
                    val other: Run = Run{first: register.id_of(?file.registers[at]), len: 1, whole: true};
                    if (overlap(file, a, ?other)) { ret true; }
                }
            }
            bits = bits >> 1;
            b    = b + 1;
        }
        w = w + 1;
    }
    ret false;
}

# whether side run `a` overlaps what `c` keeps it from where its permit does not allow it, `reads` the implicit reads
fun clash(file: *register.File, c: *Constraint, operands: *operand.Operand, values: operand.Values, g: Grouping, reads: effect.Set, a: *Run) bool {
    if (sel c.against.register) {
        val reg: u32 = c.against.register;
        val b:   Run = Run{first: register.id_of(?file.registers[reg]), len: 1, whole: true};
        ret overlap(file, a, ?b) && !permits(c.permit, a, ?b);
    }
    if (sel c.against.sides) {
        val sides: Sides = c.against.sides;
        var i:     u32   = 0;
        for (i < sides.len) {
            val s: Side = sides.at[i];
            if (clash_part(file, g, operands, values, c.permit, a, s.operand, s.part)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    var i: u32 = 0;
    for (i < values.len) {
        if (i != c.side.operand::u32) {
            val op: u8 = i::u8;
            if (sel operands[i].shape.memory) {
                if (clash_part(file, g, operands, values, c.permit, a, op, BASE) || clash_part(file, g, operands, values, c.permit, a, op, INDEX)) { ret true; }
            }
            or ((operands[i].role & operand.READ) != 0 && clash_part(file, g, operands, values, c.permit, a, op, WHOLE)) {
                ret true;
            }
        }
        i = i + 1;
    }
    ret clash_set(file, a, reads);
}

# whether the instruction whose operands are `operands` and effect `e`, holding `values`, breaks `c` under `g`
fun breaks(file: *register.File, c: *Constraint, operands: *operand.Operand, e: *effect.Effect, values: operand.Values, g: Grouping) bool {
    if (!may_meet(file, c.when, operands, values)) { ret false; }
    var reads: effect.Set = effect.Set{words: nil, len: 0};
    if (sel c.against.inputs) { reads = implicit_reads(file, e, operands, values); }
    val count: u32 = runs(values, c.side.operand, c.side.part);
    var i:     u32 = 0;
    for (i < count) {
        val a: Run = run(g, operands, values, c.side.operand, c.side.part, i);
        if (a.first != register.NONE && clash(file, c, operands, values, g, reads, ?a)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a group of operand `op`'s register value runs past the last register of its class, where `g` states its length
fun outside(file: *register.File, g: Grouping, operands: *operand.Operand, values: operand.Values, op: u8) bool {
    if (op::u32 >= g.len) { ret false; }
    val count: u32 = runs(values, op, WHOLE);
    var k:     u32 = 0;
    for (k < count) {
        val a: Run = run(g, operands, values, op, WHOLE, k);
        if (a.first != register.NONE) {
            val class: u16 = register.class_of(a.first);
            if (class::u32 < file.class_count && register.number_of(a.first)::u32 + a.len > file.classes[class].count) { ret true; }
        }
        k = k + 1;
    }
    ret false;
}

# what the instruction whose operands are `operands` and effect `e`, holding `values`, finds of `cs` under `g`: the
# first constraint without a gap it breaks, else the first operand a stated group of which runs past its class, else the
# first constraint with a gap whose registers it shares, else clear. a consumer that has not chosen an operand's value
# yet leaves it none: a constraint holding under some value of it then holds, and an early clobber stays clear of every
# register some value reads implicitly. check guarantees each constraint names operands the row has, of a kind its part
# reads, and a register of the file
pub fun violated(file: *register.File, cs: Constraints, operands: *operand.Operand, e: *effect.Effect, values: operand.Values, g: Grouping) Verdict {
    var gap: *Constraint = nil;
    var i:   u32         = 0;
    for (i < cs.len) {
        val c: *Constraint = ?cs.at[i];
        if (breaks(file, c, operands, e, values, g)) {
            if (c.gap == NO_GAP) { ret Verdict.broken{c}; }
            if (gap == nil)      { gap = c; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < values.len) {
        if (outside(file, g, operands, values, i::u8)) { ret Verdict.outside{i::u8}; }
        i = i + 1;
    }
    if (gap != nil) { ret Verdict.inexact{gap}; }
    ret Verdict.clear{};
}

# a file of four registers in one class and a row of an early clobber output, a mode enumerant and an input, which
# reads x2 implicitly when its mode is 1
#[testing]
val T_CLASSES: [1]register.Class = [1]register.Class{
    register.Class{name: "x", kind: register.GENERAL, width: register.Scaled{fixed: 64, per: 0, scale: 0}, count: 4},
};

#[testing]
val T_REGISTERS: [4]register.Register = [4]register.Register{
    register.Register{name: "x0", class: 0, number: 0, bank: 0, offset: register.Scaled{fixed: 0, per: 0, scale: 0}, stride: register.Scaled{fixed: 0, per: 0, scale: 0}, count: register.Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: requirement.NONE},
    register.Register{name: "x1", class: 0, number: 1, bank: 1, offset: register.Scaled{fixed: 0, per: 0, scale: 0}, stride: register.Scaled{fixed: 0, per: 0, scale: 0}, count: register.Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: requirement.NONE},
    register.Register{name: "x2", class: 0, number: 2, bank: 2, offset: register.Scaled{fixed: 0, per: 0, scale: 0}, stride: register.Scaled{fixed: 0, per: 0, scale: 0}, count: register.Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: requirement.NONE},
    register.Register{name: "x3", class: 0, number: 3, bank: 3, offset: register.Scaled{fixed: 0, per: 0, scale: 0}, stride: register.Scaled{fixed: 0, per: 0, scale: 0}, count: register.Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: requirement.NONE},
};

#[testing]
val T_FILE: register.File = register.File{
    scales:         nil,
    scale_count:    0,
    classes:        ?T_CLASSES[0],
    class_count:    1,
    class_names:    index.EMPTY,
    registers:      ?T_REGISTERS[0],
    register_count: 4,
    aliases:        nil,
    alias_count:    0,
    names:          index.EMPTY,
    columns:        nil,
    column_count:   0,
};

#[testing]
val T_GPR: [1]u16 = [1]u16{0};

#[testing]
val T_MODES: [2]operand.Enumerant = [2]operand.Enumerant{operand.Enumerant{name: "", value: 0}, operand.Enumerant{name: ", wide", value: 1}};

#[testing]
val T_OPERANDS: [3]operand.Operand = [3]operand.Operand{
    operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?T_GPR[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1}}, role: operand.WRITE, width: 64, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.enumerant{operand.Enumeration{members: ?T_MODES[0], count: 2, mask: false, names: index.EMPTY}}, role: operand.READ, width: 0, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?T_GPR[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1}}, role: operand.READ, width: 64, quantity: operand.ONE},
};

#[testing]
val T_X2: [1]u64 = [1]u64{0x4};

#[testing]
val T_WIDE: [1]effect.Term = [1]effect.Term{effect.Term{operand: 1, test: effect.Test.enumerant{1}}};

#[testing]
val T_RULES: [1]effect.RegisterRule = [1]effect.RegisterRule{
    effect.RegisterRule{terms: effect.Terms{at: ?T_WIDE[0], len: 1}, touched: effect.Touched{read: effect.Set{words: ?T_X2[0], len: 1}, written: effect.Set{words: nil, len: 0}}},
};

#[testing]
val T_CLOBBER: [1]Constraint = [1]Constraint{
    Constraint{side: Side{operand: 0, part: WHOLE}, against: Against.inputs{}, permit: DISJOINT, when: effect.NO_TERMS, gap: NO_GAP},
};

#[testing]
fun t_breaks(e: *effect.Effect, out: u16, mode: operand.Value, input: u16) bool {
    var vals: [3]operand.Value = [3]operand.Value{operand.Value.register{register.make(0, out)}, mode, operand.Value.register{register.make(0, input)}};
    val got:  Verdict          = violated(?T_FILE, Constraints{at: ?T_CLOBBER[0], len: 1}, ?T_OPERANDS[0], e, operand.Values{at: ?vals[0], len: 3}, UNIT);
    ret sel got.broken;
}

test violated__an_early_clobber_stays_clear_of_its_inputs_and_implicit_reads {
    var e: effect.Effect;
    e.implicit = effect.Registers{otherwise: effect.NO_TOUCHED, rules: effect.RegisterRules{at: ?T_RULES[0], len: 1}, may: T_RULES[0].touched, must: effect.NO_TOUCHED};
    val wide:   operand.Value = operand.Value.enumerant{1};
    val narrow: operand.Value = operand.Value.enumerant{0};
    # the input operand, and x2 only while the mode reads it
    if (!t_breaks(?e, 3, narrow, 3)) { ret 1; }
    if (!t_breaks(?e, 2, wide, 3))   { ret 2; }
    if (t_breaks(?e, 2, narrow, 3))  { ret 3; }
    if (t_breaks(?e, 1, wide, 3))    { ret 4; }
    # a mode not chosen yet may read x2
    if (!t_breaks(?e, 2, operand.Value.none{}, 3)) { ret 5; }
    if (t_breaks(?e, 1, operand.Value.none{}, 3))  { ret 6; }
    ret 0;
}
