# processor configuration state: what an instruction sets at run time that later instructions' operands read
#
# configuration state is not execution state (`masc.core.state`). execution
# state decides which rows are legal and how bytes decode, and code switches
# it by a directive or a mode change the assembler sees. configuration state
# is set by an instruction at run time and decides only how many registers
# an operand covers, as risc-v's vsetvli sets vtype and every vector
# instruction after it covers the register groups its sew and lmul make, or
# x86's vzeroupper leaves the upper halves of the vector registers clean. so
# the allocator reads it and the codec never does.
#
# the state is opaque to everyone but the set: bits only the set's hooks read,
# which parse and print it, say what groups a row's operands form under it,
# and say which rows establish it and to what. a set whose operands never
# turn on such state, as aarch64, whose sve predicates are operands and set no
# state, registers no hooks.

use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use masc.core.constraint;
use masc.core.effect;
use masc.core.operand;
use masc.core.row;
use masc.core.state;

# a configuration state, in bits only the set's hooks read, as risc-v's vtype encoding
pub rec State {
    bits: u64;
}

# a state read from text, and how many bytes of the text it covers
pub rec Parsed {
    state: State;
    len:   usize;
}

# what an instruction does to the configuration state
# ---
# keeps:     it leaves it as it was
# sets:      it sets it to this state, as vsetvli to the vtype its immediate encodes
# undecided: it sets it to a state its operand values decide and do not yet, as vsetvl to the vtype a register holds
pub tag Established: u8 {
    keeps;
    sets:      State;
    undecided: effect.Undecided;
}

# how a set reads, writes and applies its configuration state
# ---
# name:      what the state is called, as `vtype`
# parse:     the state the text starts with in the set's syntax, none when it starts with none
# print:     the state spelled onto the output in the set's syntax, refused when the bits encode no state
# grouping:  how many registers each operand of a row covers under the state and the context, which states the
#            implementation bounds, refused as constraint.Grouped.state for bits that encode none
# establish: what an instruction of a row holding operand values does to the state
pub rec Hooks {
    name:      str;
    parse:     fun(View) opt[Parsed];
    print:     fun(State, *vector.Vector[u8]) err[A.Error];
    grouping:  fun(State, *row.Row, *state.Context) constraint.Grouped;
    establish: fun(*row.Row, operand.Values) Established;
}

# a query's configuration: the set's hooks and the state in force, none when the query is not told it
# ---
# hooks: the set's hooks, nil for a set with no configuration state
# state: the state in force where the instruction runs, none when it is not known
pub rec Configured {
    hooks: *Hooks;
    state: opt[State];
}

# the configuration of a query that knows no state, or of a set with none
pub val UNKNOWN: Configured = Configured{hooks: nil, state: opt[State].none{}};

# how many registers each operand of row `r` covers under configuration `c` and the context `ctx`: the row's own
# grouping where no operand turns on state, else the hooks' under the state in force
# ---
# ret: the grouping, or why there is none: the operand whose groups turn on a state `c` does not hold, or the operand
#      the state cannot form
pub fun grouping(c: Configured, r: *row.Row, ctx: *state.Context) effect.Answer[constraint.Grouping] {
    val own: constraint.Grouped = constraint.grouping(r.operands.at, r.operands.len, opt[constraint.State].none{});
    if (sel own.grouping) { ret effect.Answer[constraint.Grouping].decided{own.grouping}; }
    if (sel own.reserved) { ret effect.Answer[constraint.Grouping].undecided{effect.Undecided.reserved{own.reserved}}; }
    var needs: u8 = 0;
    if (sel own.needs)    { needs = own.needs; }
    if (c.hooks == nil)   { ret effect.Answer[constraint.Grouping].undecided{effect.Undecided.configured{needs}}; }
    if (sel c.state.none) { ret effect.Answer[constraint.Grouping].undecided{effect.Undecided.configured{needs}}; }
    val under: constraint.Grouped = c.hooks.grouping(c.state.some, r, ctx);
    if (sel under.grouping) { ret effect.Answer[constraint.Grouping].decided{under.grouping}; }
    if (sel under.reserved) { ret effect.Answer[constraint.Grouping].undecided{effect.Undecided.reserved{under.reserved}}; }
    ret effect.Answer[constraint.Grouping].undecided{effect.Undecided.reserved{needs}};
}
