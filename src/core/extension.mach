# the extension catalog of an instruction set and the selections closed over it
#
# a catalog is a static literal of extension rows and level rows. a selection
# names extensions and levels, closes them over their implications once, and
# holds the closed set sized from its catalog. a spelling may also state
# values of the set's state axes, as risc-v's `rv64` states xlen, which the
# selection keeps as the atoms it states beside its members, and a level's
# members may be such atoms. the catalog knows no axis: an atom past its rows
# is a state value, which `masc.core.state` reads against the set's axes, and
# `state.admits` is the one predicate over both.
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;
use std.collections.bitset;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.index;
use masc.core.requirement;

# one extension of an instruction set
# ---
# name:     the name selections and diagnostics spell
# implies:  the extensions selecting this one brings with it
# revision: the specification revision that ratified it, as the set's sources spell it
pub rec Extension {
    name:     str;
    implies:  requirement.Ids;
    revision: str;
}

# what a level names: an architecture version, as armv9.2-a and rv64gc, a profile, as rva23u64, a processor model, or
# a psabi's level, as x86-64-v3
pub def LevelKind: u8;

pub val ARCH:    LevelKind = 0;
pub val PROFILE: LevelKind = 1;
pub val CPU:     LevelKind = 2;
pub val PSABI:   LevelKind = 3;

# kinds of level, a bit each by `kind_bit`, as a directive that restates the selection takes a spelling naming a level of
# one of them
pub def LevelKinds: u8;

# every kind of level, and each kind alone
pub val EVERY_KIND:   LevelKinds = 0xff;
pub val ARCH_KIND:    LevelKinds = 1;
pub val PROFILE_KIND: LevelKinds = 2;
pub val CPU_KIND:     LevelKinds = 4;
pub val PSABI_KIND:   LevelKinds = 8;

# the bit of kind `k`
pub fun kind_bit(k: LevelKind) LevelKinds {
    ret (1::u8 << k)::LevelKinds;
}

# a published group of extensions under one name, such as x86-64-v3 or rv64gc
# ---
# name:    the name selections spell, never also an extension's
# kind:    what it names
# members: the extensions the level selects, closed with the rest of the selection
# state:   the state atoms it sets, as rv64gc sets xlen=64, each past the catalog's rows. never a value of an axis code
#          switches, as x86's width, which the selection's state would hold against the source's directives. gen refuses
#          a level record that sets one
pub rec Level {
    name:    str;
    kind:    LevelKind;
    members: requirement.Ids;
    state:   requirement.Ids;
}

# one key of the name index and the rows it names, as aarch64's sha2 names both of aarch64's FEAT_SHA256 and FEAT_SHA1.
# a selection that spells it enables every row, and a requirement it names is the one row `only` finds
# ---
# key:       the name
# rows:      the rows it names, each an extension's id, or the extension count plus a level's index
# canonical: whether it is its one row's own name, which a selection's spelling and diagnostics use. every row has
#            exactly one canonical key, and an alias names its rows by another
pub rec NameEntry {
    key:       str;
    rows:      requirement.Ids;
    canonical: bool;
}

# the name index of a catalog, in ascending order of key, no key given twice
pub rec Names {
    at:  *NameEntry;
    len: u32;
}

pub val NO_NAMES: Names = Names{at: nil, len: 0};

# two extensions no selection may hold together, in either order, such as
# riscv's zcmp and zcd, which share encodings
# ---
# a: one extension of the pair
# b: the other
pub rec Conflict {
    a: requirement.Id;
    b: requirement.Id;
}

# a conditional implication: `by` implies `implies` while every extension of `when` is held
# ---
# by:      the extension that carries the implication
# when:    the conditions, none of them the carrier
# implies: the extensions the selection then holds as well
pub rec Combination {
    by:      requirement.Id;
    when:    requirement.Ids;
    implies: requirement.Ids;
}

# why a selection was not made
# ---
# refused:  the spelling was refused, with one diagnostic at the token refused, its length zero when it is about the spelling as a whole
# conflict: the closure held a pair of extensions that cannot coexist
# memory:   the allocator refused the selection's storage
pub tag Error: u8 {
    refused:  diagnostic.Diagnostic;
    conflict: Conflict;
    memory:   A.Error;
}

# how a set's selections are spelled: the set's names may carry a selection, as
# riscv's rv64imac_zba does, and `LIST` serves a set whose names do not
# ---
# parse:     adds the extensions and levels the request's spelling names to it, or one refusal
# spell:     appends the closed selection's spelling to the buffer
# versioned: appends the closed selection's spelling with each member's revision, as an object states the selection it
#            was built for, as risc-v's Tag_RISCV_arch. `parse` reads it back to the same selection
pub rec Syntax {
    parse:     fun(*Request) err[Error];
    spell:     fun(*Selection, *vector.Vector[u8]) err[A.Error];
    versioned: fun(*Selection, *vector.Vector[u8]) err[A.Error];
}

# an instruction set's extensions and levels, and how its selections are spelled
# ---
# extensions:        the extension rows, each one's id its index
# count:             how many extension rows there are
# levels:            the level rows, nil when the set has none
# level_count:       how many level rows there are
# names:             the extensions and levels by name, a canonical entry per extension and per level and an alias entry
#                    per other name a consumer spells it by
# conflicts:         the pairs no selection may hold together, each stated once, nil when the set has none
# conflict_count:    how many conflict rows there are
# combinations:      the conditional implications, nil when the set has none
# combination_count: how many combination rows there are
# syntax:            how the set's selections are spelled
# base:              the name of the base selection, the baseline with nothing added, which a selection its syntax
#                    spells by nothing is spelled by, so no spelling is empty: a level of no members where the catalog
#                    has one, else a name its sources or its vendors' tooling give that set, which no row or other level
#                    is named and every syntax reads back to the base selection
pub rec Catalog {
    extensions:        *Extension;
    count:             u32;
    levels:            *Level;
    level_count:       u32;
    names:             Names;
    conflicts:         *Conflict;
    conflict_count:    u32;
    combinations:      *Combination;
    combination_count: u32;
    syntax:            *Syntax;
    base:              str;
}

# the most state atoms a spelling states, one per axis of a set with the most axes
pub val MAX_STATED: u32 = 8;

# the state atoms a spelling states, by value
# ---
# at:  the atoms, each past the catalog's rows, the first `len` of them
# len: how many there are
pub rec Stated {
    at:  [MAX_STATED]requirement.Id;
    len: u32;
}

# the extensions a spelling names, edited in order and closed after each edit, so a disable removes what an enable
# before it brought, as `+avx2,-avx` leaves sse4.2 where `-avx,+avx2` leaves avx2
# ---
# catalog:  the catalog the names resolve in
# named:    the extensions the edits leave, one bit per catalog row, closed over the catalog's implications
# stated:   the state atoms named so far, an atom named again stated once
# spilled:  whether more state atoms were named than a request holds, which `close` refuses
# spelling: the spelling being read
# origin:   the position of the spelling's first byte in its source
# kinds:    the kinds of the levels its edits enabled
pub rec Request {
    catalog:  *Catalog;
    named:    bitset.Bitset;
    stated:   Stated;
    spilled:  bool;
    spelling: str;
    origin:   diagnostic.Position;
    kinds:    LevelKinds;
}

# a closed selection: every member's implications are members
# ---
# catalog: the catalog the members are rows of
# members: the closed set, one bit per catalog row
# stated:  the state atoms its spelling states, which a context starts its axes at over the architecture's initial values
pub rec Selection {
    catalog: *Catalog;
    members: bitset.Bitset;
    stated:  Stated;
}

# one edit of a request, applied in order
# ---
# enable:  a row of the name index, an extension's id or the extension count plus a level's index, added with what it
#          implies, a level's members and state atoms with it
# disable: an extension removed with every member that needs it, as a selection's `without`
# state:   a state atom stated, past the catalog's rows. two values of one axis are a context's to refuse
pub tag Edit: u8 {
    enable:  u32;
    disable: requirement.Id;
    state:   requirement.Id;
}

# a refusal of the token at `r.spelling[at..at + len]`
pub fun refusal(r: *Request, message: str, at: usize, len: usize) Error {
    ret Error.refused{diagnostic.refusal(message, r.origin, r.spelling, at, len)};
}

# the entry of `catalog`'s name index keyed `key`, by binary search. a `fold` reads the capitals of `key` as lower case,
# which finds only a key that is itself lower case
pub fun entry(catalog: *Catalog, key: View, fold: bool) opt[*NameEntry] {
    var lo: u32 = 0;
    var hi: u32 = catalog.names.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        val c:   i64 = index.compare(catalog.names.at[mid].key, key, fold);
        if (c == 0) { ret opt[*NameEntry].some{?catalog.names.at[mid]}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret opt[*NameEntry].none{};
}

# the most extension rows a catalog holds, which `only` closes a row over without an allocator. the check of a set
# refuses a catalog of more
pub val MAX_ROWS: u32 = 4096;

# the rows of a catalog, one bit each, sized for `MAX_ROWS`
rec Rows {
    words: [MAX_ROWS / 64]u64;
}

fun rows_has(r: *Rows, id: requirement.Id) bool {
    ret (r.words[id / 64] & (1::u64 << (id % 64)::u64)) != 0;
}

# row `from` closed over the catalog's plain implications into `out`, which the implications may close in a cycle, as
# aarch64's FEAT_SHA1 and FEAT_SHA256 imply each other
fun implied_by(catalog: *Catalog, from: requirement.Id, out: *Rows) {
    var w: u32 = 0;
    for (w < MAX_ROWS / 64) {
        out.words[w] = 0;
        w            = w + 1;
    }
    out.words[from / 64] = out.words[from / 64] | (1::u64 << (from % 64)::u64);
    var grew: bool = true;
    for (grew) {
        grew = false;
        var i: u32 = 0;
        for (i < catalog.count) {
            if (rows_has(out, i)) {
                val implies: requirement.Ids = catalog.extensions[i].implies;
                var j:       u32             = 0;
                for (j < implies.len) {
                    val to: requirement.Id = implies.at[j];
                    if (to < catalog.count && !rows_has(out, to)) {
                        out.words[to / 64] = out.words[to / 64] | (1::u64 << (to % 64)::u64);
                        grew               = true;
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }
}

# the one extension the entry `e` stands for alone, as a requirement names it: its one row, or of several, the first
# that is or implies every other through the plain implications, as aarch64's aes names FEAT_AES and FEAT_PMULL and
# stands for FEAT_PMULL, which implies FEAT_AES. none when it names a level, or several rows no one of which implies
# the rest, or the catalog holds more than `MAX_ROWS`. an edit that enables or removes the name takes `extensions_of`
pub fun only(catalog: *Catalog, e: *NameEntry) opt[requirement.Id] {
    var i: u32 = 0;
    for (i < e.rows.len) {
        if (e.rows.at[i] >= catalog.count) { ret opt[requirement.Id].none{}; }
        i = i + 1;
    }
    if (e.rows.len == 1)          { ret opt[requirement.Id].some{e.rows.at[0]}; }
    if (catalog.count > MAX_ROWS) { ret opt[requirement.Id].none{}; }
    var closed: Rows;
    i = 0;
    for (i < e.rows.len) {
        implied_by(catalog, e.rows.at[i], ?closed);
        var covers: bool = true;
        var k:      u32  = 0;
        for (covers && k < e.rows.len) {
            covers = rows_has(?closed, e.rows.at[k]);
            k      = k + 1;
        }
        if (covers) { ret opt[requirement.Id].some{e.rows.at[i]}; }
        i = i + 1;
    }
    ret opt[requirement.Id].none{};
}

# the extensions the entry `e` enables or removes as an edit: every row it names, as aarch64's `+noaes` removes both
# FEAT_AES and FEAT_PMULL. none when it names a level
pub fun extensions_of(catalog: *Catalog, e: *NameEntry) opt[requirement.Ids] {
    var i: u32 = 0;
    for (i < e.rows.len) {
        if (e.rows.at[i] >= catalog.count) { ret opt[requirement.Ids].none{}; }
        i = i + 1;
    }
    ret opt[requirement.Ids].some{e.rows};
}

# the one level the entry `e` names, none when it names an extension or several rows
pub fun only_level(catalog: *Catalog, e: *NameEntry) opt[*Level] {
    if (e.rows.len != 1 || e.rows.at[0] < catalog.count) { ret opt[*Level].none{}; }
    ret opt[*Level].some{?catalog.levels[e.rows.at[0] - catalog.count]};
}

# the extension `catalog` names alone at `spelling[at..at + len]`, by its own name or an alias, as `only` reads it
pub fun lookup(catalog: *Catalog, spelling: str, at: usize, len: usize) opt[requirement.Id] {
    val found: opt[*NameEntry] = entry(catalog, view(?spelling[at], len), false);
    if (sel found.none) { ret opt[requirement.Id].none{}; }
    ret only(catalog, found.some);
}

# an empty request over `catalog` for `spelling`, which starts at `origin` in its source
pub fun request(a: *A.Allocator, catalog: *Catalog, spelling: str, origin: diagnostic.Position) res[Request, Error] {
    val named: res[bitset.Bitset, A.Error] = bitset.init(a, catalog.count::usize);
    if (sel named.err) { ret res[Request, Error].err{Error.memory{named.err}}; }
    var stated: Stated;
    stated.len = 0;
    ret res[Request, Error].ok{Request{catalog: catalog, named: named.ok, stated: stated, spilled: false, spelling: spelling, origin: origin, kinds: 0}};
}

# whether `stated` holds the atom `id`
fun states(stated: *Stated, id: requirement.Id) bool {
    var i: u32 = 0;
    for (i < stated.len) {
        if (stated.at[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the state atom `id` stated, once however often it is stated
fun state_of(r: *Request, id: requirement.Id) {
    if (states(?r.stated, id)) { ret; }
    if (r.stated.len == MAX_STATED) {
        r.spilled = true;
        ret;
    }
    r.stated.at[r.stated.len] = id;
    r.stated.len              = r.stated.len + 1;
}

# the edit `e` applied to the request, which it leaves closed over the catalog's implications and combinations
pub fun request_edit(r: *Request, e: Edit) {
    if (sel e.enable) {
        val bearer: u32 = e.enable;
        if (bearer < r.catalog.count) { bitset.set(?r.named, bearer::usize); }
        or (bearer - r.catalog.count < r.catalog.level_count) {
            val level: *Level = ?r.catalog.levels[bearer - r.catalog.count];
            r.kinds = r.kinds | kind_bit(level.kind);
            var i: u32 = 0;
            for (i < level.members.len) {
                if (level.members.at[i] < r.catalog.count) { bitset.set(?r.named, level.members.at[i]::usize); }
                i = i + 1;
            }
            i = 0;
            for (i < level.state.len) {
                state_of(r, level.state.at[i]);
                i = i + 1;
            }
        }
    }
    or (sel e.disable) {
        var s: Selection = Selection{catalog: r.catalog, members: r.named, stated: r.stated};
        without(?s, e.disable);
        r.named = s.members;
    }
    or (sel e.state) { state_of(r, e.state); }
    grow(r.catalog, ?r.named, ?r.stated);
}

# the atom `id` enabled: an extension of the catalog with what it implies, or a state value past its rows stated
pub fun request_add(r: *Request, id: requirement.Id) {
    if (id < r.catalog.count) { request_edit(r, Edit.enable{id}); }
    or                        { request_edit(r, Edit.state{id}); }
}

# every row the name at `r.spelling[at..at + len]` names enabled, its own name or an alias
# ---
# ret: ok, or a refusal at the name when the catalog has no such name
pub fun request_name(r: *Request, at: usize, len: usize) err[Error] {
    val found: opt[*NameEntry] = entry(r.catalog, view(?r.spelling[at], len), false);
    if (sel found.none) { ret err[Error].err{refusal(r, "unknown extension", at, len)}; }
    request_entry(r, found.some);
    ret err[Error].ok{};
}

# every row the name index's entry `e` names enabled
pub fun request_entry(r: *Request, e: *NameEntry) {
    var i: u32 = 0;
    for (i < e.rows.len) {
        request_edit(r, Edit.enable{e.rows.at[i]});
        i = i + 1;
    }
}

# the extension `id` disabled with every extension that needs it, so a name after it brings back only what it
# implies, as `+v9.2a,-lse` and `armv8.1-a+nolse` read left to right
pub fun request_remove(r: *Request, id: requirement.Id) {
    request_edit(r, Edit.disable{id});
}

# release a request that will not be closed
pub fun request_release(r: *Request) err[A.Error] {
    ret bitset.dnit(?r.named);
}

# whether `members` or `stated` holds the atom `id`: an extension by its bit, a state atom by its statement
fun holds(catalog: *Catalog, members: *bitset.Bitset, stated: *Stated, id: requirement.Id) bool {
    if (id < catalog.count) { ret bitset.get(members, id::usize); }
    ret states(stated, id);
}

# whether every atom of `ids` is held
fun held(catalog: *Catalog, members: *bitset.Bitset, stated: *Stated, ids: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (!holds(catalog, members, stated, ids.at[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `ids` lists `id`
fun lists(ids: requirement.Ids, id: requirement.Id) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (ids.at[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# `members` closed over the implications and combinations of `catalog` to a fixed point, conflicts unchecked. a
# combination's condition may be a state atom, read from `stated`, as risc-v's c brings zcf with f only at xlen=32
pub fun grow(catalog: *Catalog, members: *bitset.Bitset, stated: *Stated) {
    var grew: bool = true;
    for (grew) {
        grew = false;
        var i: u32 = 0;
        for (i < catalog.count) {
            if (bitset.get(members, i::usize)) {
                val implies: requirement.Ids = catalog.extensions[i].implies;
                var j:       u32             = 0;
                for (j < implies.len) {
                    if (!bitset.get(members, implies.at[j]::usize)) {
                        bitset.set(members, implies.at[j]::usize);
                        grew = true;
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        var c: u32 = 0;
        for (c < catalog.combination_count) {
            val combo: Combination = catalog.combinations[c];
            if (bitset.get(members, combo.by::usize) && held(catalog, members, stated, combo.when) && !held(catalog, members, stated, combo.implies)) {
                var j: u32 = 0;
                for (j < combo.implies.len) {
                    bitset.set(members, combo.implies.at[j]::usize);
                    j = j + 1;
                }
                grew = true;
            }
            c = c + 1;
        }
    }
}

# the request closed over its implications and combinations to a fixed point. the selection
# takes the request's storage, so the request is spent either way
# ---
# ret: the selection, or the first conflicting pair the closure holds, with the storage released
pub fun close(r: Request) res[Selection, Error] {
    var members: bitset.Bitset = r.named;
    if (r.spilled) {
        bitset.dnit(?members);
        ret res[Selection, Error].err{Error.refused{diagnostic.refusal("more state values than a selection holds", r.origin, r.spelling, 0, 0)}};
    }
    var stated: Stated = r.stated;
    grow(r.catalog, ?members, ?stated);
    var k: u32 = 0;
    for (k < r.catalog.conflict_count) {
        val pair: Conflict = r.catalog.conflicts[k];
        if (holds(r.catalog, ?members, ?stated, pair.a) && holds(r.catalog, ?members, ?stated, pair.b)) {
            bitset.dnit(?members);
            ret res[Selection, Error].err{Error.conflict{pair}};
        }
        k = k + 1;
    }
    ret res[Selection, Error].ok{Selection{catalog: r.catalog, members: members, stated: r.stated}};
}

# the closed selection `spelling` names in the catalog's syntax
# ---
# origin: the position of the spelling's first byte in its source, which its refusal is placed from
# ret:    the selection, or the syntax's one refusal, a conflict, or the allocator's refusal
pub fun select(a: *A.Allocator, catalog: *Catalog, spelling: str, origin: diagnostic.Position) res[Selection, Error] {
    ret select_of(a, catalog, spelling, origin, EVERY_KIND);
}

# why a spelling was refused that names a level of a kind its reader does not take
pub val OTHER_KIND: str = "names a level of a kind this does not take";

# the closed selection `spelling` names in the catalog's syntax, each level it names of one of `kinds`, as aarch64's
# `.arch` names an architecture and `.cpu` a processor
pub fun select_of(a: *A.Allocator, catalog: *Catalog, spelling: str, origin: diagnostic.Position, kinds: LevelKinds) res[Selection, Error] {
    val made: res[Request, Error] = request(a, catalog, spelling, origin);
    if (sel made.err) { ret res[Selection, Error].err{made.err}; }
    var r:      Request    = made.ok;
    var parsed: err[Error] = err[Error].ok{};
    if (!base_only(catalog, spelling)) { parsed = catalog.syntax.parse(?r); }
    if (sel parsed.err) {
        request_release(?r);
        ret res[Selection, Error].err{parsed.err};
    }
    if ((r.kinds & ~kinds) != 0) {
        val why: Error = refusal(?r, OTHER_KIND, 0, str_len(spelling));
        request_release(?r);
        ret res[Selection, Error].err{why};
    }
    ret close(r);
}

# the closure of `s` with the atoms `ids` added, the state atoms it states kept stated, in storage of its own, as a
# widening of the selection in force makes it
pub fun added(a: *A.Allocator, s: *Selection, ids: requirement.Ids) res[Selection, Error] {
    val made: res[Request, Error] = request(a, s.catalog, "", diagnostic.START);
    if (sel made.err) { ret res[Selection, Error].err{made.err}; }
    var r: Request = made.ok;
    var i: u32     = 0;
    for (i < s.catalog.count) {
        if (has(s, i)) { request_add(?r, i); }
        i = i + 1;
    }
    # the state atoms its spelling states stay stated, as a combination may hold under them
    i = 0;
    for (i < s.stated.len) {
        request_add(?r, s.stated.at[i]);
        i = i + 1;
    }
    i = 0;
    for (i < ids.len) {
        request_add(?r, ids.at[i]);
        i = i + 1;
    }
    ret close(r);
}

# release a selection's storage
pub fun release(s: *Selection) err[A.Error] {
    ret bitset.dnit(?s.members);
}

# a copy of the closed selection `s` in storage of its own, as a narrowing starts from
pub fun copy(a: *A.Allocator, s: *Selection) res[Selection, A.Error] {
    val made: res[bitset.Bitset, A.Error] = bitset.init(a, s.catalog.count::usize);
    if (sel made.err) { ret res[Selection, A.Error].err{made.err}; }
    var out: Selection = Selection{catalog: s.catalog, members: made.ok, stated: s.stated};
    var i:   u32       = 0;
    for (i < s.catalog.count) {
        if (has(s, i)) { bitset.set(?out.members, i::usize); }
        i = i + 1;
    }
    ret res[Selection, A.Error].ok{out};
}

# whether every member of `s` is a member of `of`, both of one catalog, the state atoms either states aside
pub fun within(s: *Selection, of: *Selection) bool {
    if (s.catalog != of.catalog) { ret false; }
    var i: u32 = 0;
    for (i < s.catalog.count) {
        if (has(s, i) && !has(of, i)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the closed selection holds the atom `id`: the extension of that row, or the state value its spelling states
pub fun has(s: *Selection, id: requirement.Id) bool {
    if (id < s.catalog.count) { ret bitset.get(?s.members, id::usize); }
    ret states(?s.stated, id);
}

# whether something held still implies `id`, plainly or through a combination, so removing `id` alone would leave the
# selection open
pub fun implied(s: *Selection, id: requirement.Id) bool {
    ret implied_but(s, id, requirement.NO_IDS);
}

# whether something held other than the extensions of `but` still implies `id`, so removing `but` together would leave
# the selection open, as removing aarch64's aes takes FEAT_PMULL, which implies FEAT_AES, with it
pub fun implied_but(s: *Selection, id: requirement.Id, but: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < s.catalog.count) {
        if (has(s, i) && !lists(but, i) && lists(s.catalog.extensions[i].implies, id)) { ret true; }
        i = i + 1;
    }
    var c: u32 = 0;
    for (c < s.catalog.combination_count) {
        val combo: Combination = s.catalog.combinations[c];
        if (has(s, combo.by) && !lists(but, combo.by) && held(s.catalog, ?s.members, ?s.stated, combo.when) && lists(combo.implies, id)) { ret true; }
        c = c + 1;
    }
    ret false;
}

# whether every extension of `ids` other than `id` is held
fun held_but(s: *Selection, ids: requirement.Ids, id: requirement.Id) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (ids.at[i] != id && !has(s, ids.at[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the extension `id` removed from the selection with every member that implies
# it, directly or through others, so the selection stays closed. a firing
# combination that implied it loses its carrier and keeps its conditions. a
# combination that loses its carrier or a condition takes what it implied, unless
# something held still implies that. the selection keeps no record of what was
# named, so a named member a combination also implies goes the same way
pub fun without(s: *Selection, id: requirement.Id) {
    if (id >= s.catalog.count || !has(s, id)) { ret; }
    bitset.clear(?s.members, id::usize);
    var i: u32 = 0;
    for (i < s.catalog.count) {
        if (has(s, i) && lists(s.catalog.extensions[i].implies, id)) { without(s, i); }
        i = i + 1;
    }
    var c: u32 = 0;
    for (c < s.catalog.combination_count) {
        val combo: Combination = s.catalog.combinations[c];
        if (lists(combo.implies, id) && has(s, combo.by) && held(s.catalog, ?s.members, ?s.stated, combo.when)) { without(s, combo.by); }
        val carried: bool = combo.by == id || has(s, combo.by);
        if (carried && (combo.by == id || lists(combo.when, id)) && held_but(s, combo.when, id)) {
            var j: u32 = 0;
            for (j < combo.implies.len) {
                val dropped: requirement.Id = combo.implies.at[j];
                if (has(s, dropped) && !implied(s, dropped)) { without(s, dropped); }
                j = j + 1;
            }
        }
        c = c + 1;
    }
}

# the selection's spelling in its catalog's syntax, appended to `out`, the catalog's base name where the syntax spells
# it by nothing
pub fun spell(s: *Selection, out: *vector.Vector[u8]) err[A.Error] {
    val start: usize        = out.len;
    val wrote: err[A.Error] = s.catalog.syntax.spell(s, out);
    if (sel wrote.err || out.len != start || s.catalog.base == nil) { ret wrote; }
    ret append(out, s.catalog.base);
}

# the selection's spelling in its catalog's syntax with each member's revision, appended to `out`, the catalog's base
# name where the syntax spells it by nothing
pub fun spell_versioned(s: *Selection, out: *vector.Vector[u8]) err[A.Error] {
    val start: usize        = out.len;
    val wrote: err[A.Error] = s.catalog.syntax.versioned(s, out);
    if (sel wrote.err || out.len != start || s.catalog.base == nil) { ret wrote; }
    ret append(out, s.catalog.base);
}

# whether `spelling` is the catalog's base name where no entry of its name index has it, which every syntax reads as
# the base selection, nothing added
pub fun base_only(catalog: *Catalog, spelling: str) bool {
    if (catalog.base == nil || !str_equals(spelling, catalog.base)) { ret false; }
    val found: opt[*NameEntry] = entry(catalog, view(catalog.base, str_len(catalog.base)), false);
    ret sel found.none;
}

# `text` appended to `out`
pub fun append(out: *vector.Vector[u8], text: str) err[A.Error] {
    val len: usize = str_len(text);
    var i:   usize = 0;
    for (i < len) {
        val pushed: res[usize, A.Error] = vector.push[u8](out, text[i]);
        if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# a comma-separated list of extension and level names
fun list_parse(r: *Request) err[Error] {
    val spelling: str   = r.spelling;
    val len:      usize = str_len(spelling);
    var start:    usize = 0;
    var at:       usize = 0;
    for (len > 0 && at <= len) {
        if (at == len || spelling[at] == ',') {
            if (at == start) { ret err[Error].err{refusal(r, "empty extension name", at, 0)}; }
            val named: err[Error] = request_name(r, start, at - start);
            if (sel named.err) { ret named; }
            start = at + 1;
        }
        at = at + 1;
    }
    ret err[Error].ok{};
}

# the members' names in catalog order, comma-separated
fun list_spell(s: *Selection, out: *vector.Vector[u8]) err[A.Error] {
    var first: bool = true;
    var i:     u32  = 0;
    for (i < s.catalog.count) {
        if (has(s, i)) {
            if (!first) {
                val pushed: res[usize, A.Error] = vector.push[u8](out, ',');
                if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
            }
            val named: err[A.Error] = append(out, s.catalog.extensions[i].name);
            if (sel named.err) { ret named; }
            first = false;
        }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# the syntax of a set whose names carry no selection: `name,name,...`
# names carry no revision, so the versioned spelling is the plain one
pub val LIST: Syntax = Syntax{parse: list_parse, spell: list_spell, versioned: list_spell};
