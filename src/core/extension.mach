# the extension catalog of an instruction set and the selections closed over it
#
# a catalog is a static literal of extension rows and level rows. a selection
# names extensions and levels, closes them over their implications once, and
# holds the closed set sized from its catalog. every query reads that closed
# set, and `admits` is the one predicate the parser and the encoder ask.
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;
use std.allocator.testing;
use std.collections.bitset;
use std.collections.vector;

use masc.core.diagnostic;

# an extension, by its row in its catalog
pub def Id: u32;

# extensions as a pointer to static ids and a count, so a static row can hold a list
# ---
# at:  the first id, nil when the list is empty
# len: how many ids the list holds
pub rec Ids {
    at:  *Id;
    len: u32;
}

# one extension of an instruction set
# ---
# name:     the name selections and diagnostics spell
# implies:  the extensions selecting this one brings with it
# revision: the specification revision that ratified it, as the set's sources spell it
pub rec Extension {
    name:     str;
    implies:  Ids;
    revision: str;
}

# a published group of extensions under one name, such as x86-64-v3 or rv64gc
# ---
# name:    the name selections spell, never also an extension's
# members: the extensions the level selects, closed with the rest of the selection
pub rec Level {
    name:    str;
    members: Ids;
}

# two extensions no selection may hold together, in either order, such as
# riscv's zcmp and zcd, which share encodings
# ---
# a: one extension of the pair
# b: the other
pub rec Conflict {
    a: Id;
    b: Id;
}

# why a selection was not made
# ---
# refused:  the spelling was refused, with one diagnostic at the token refused, its length zero when it is about the spelling as a whole
# conflict: the closure held a pair of extensions that cannot coexist
# memory:   the allocator refused the selection's storage
pub tag Error: u8 {
    refused:  diagnostic.Diagnostic;
    conflict: Conflict;
    memory:   A.Error;
}

# how a set's selections are spelled: the set's names may carry a selection, as
# riscv's rv64imac_zba does, and `LIST` serves a set whose names do not
# ---
# parse: adds the extensions and levels the request's spelling names to it, or one refusal
# spell: appends the closed selection's spelling to the buffer
pub rec Syntax {
    parse: fun(*Request) err[Error];
    spell: fun(*Selection, *vector.Vector[u8]) err[A.Error];
}

# an instruction set's extensions and levels, and how its selections are spelled
# ---
# extensions:     the extension rows, each one's id its index
# count:          how many extension rows there are
# levels:         the level rows, nil when the set has none
# level_count:    how many level rows there are
# conflicts:      the pairs no selection may hold together, each stated once, nil when the set has none
# conflict_count: how many conflict rows there are
# syntax:         how the set's selections are spelled
pub rec Catalog {
    extensions:     *Extension;
    count:          u32;
    levels:         *Level;
    level_count:    u32;
    conflicts:      *Conflict;
    conflict_count: u32;
    syntax:         *Syntax;
}

# the extensions a spelling names, before closure
# ---
# catalog:  the catalog the names resolve in
# named:    the extensions named so far, one bit per catalog row
# spelling: the spelling being read
# origin:   the position of the spelling's first byte in its source
pub rec Request {
    catalog:  *Catalog;
    named:    bitset.Bitset;
    spelling: str;
    origin:   diagnostic.Position;
}

# a closed selection: every member's implications are members
# ---
# catalog: the catalog the members are rows of
# members: the closed set, one bit per catalog row
pub rec Selection {
    catalog: *Catalog;
    members: bitset.Bitset;
}

# a refusal of the token at `r.spelling[at..at + len]`
pub fun refusal(r: *Request, message: str, at: usize, len: usize) Error {
    ret Error.refused{diagnostic.refusal(message, r.origin, r.spelling, at, len)};
}

# the extension `catalog` names at `spelling[at..at + len]`
pub fun lookup(catalog: *Catalog, spelling: str, at: usize, len: usize) opt[Id] {
    var i: u32 = 0;
    for (i < catalog.count) {
        if (str_region_equals(spelling, at, len, catalog.extensions[i].name)) { ret opt[Id].some{i}; }
        i = i + 1;
    }
    ret opt[Id].none{};
}

# the level `catalog` names at `spelling[at..at + len]`
fun level_lookup(catalog: *Catalog, spelling: str, at: usize, len: usize) opt[*Level] {
    var i: u32 = 0;
    for (i < catalog.level_count) {
        if (str_region_equals(spelling, at, len, catalog.levels[i].name)) { ret opt[*Level].some{?catalog.levels[i]}; }
        i = i + 1;
    }
    ret opt[*Level].none{};
}

# an empty request over `catalog` for `spelling`, which starts at `origin` in its source
pub fun request(a: *A.Allocator, catalog: *Catalog, spelling: str, origin: diagnostic.Position) res[Request, Error] {
    val named: res[bitset.Bitset, A.Error] = bitset.init(a, catalog.count::usize);
    if (sel named.err) { ret res[Request, Error].err{Error.memory{named.err}}; }
    ret res[Request, Error].ok{Request{catalog: catalog, named: named.ok, spelling: spelling, origin: origin}};
}

# the extension `id` added to the request
pub fun request_add(r: *Request, id: Id) {
    bitset.set(?r.named, id::usize);
}

# the extension or level named at `r.spelling[at..at + len]` added to the request
# ---
# ret: ok, or a refusal at the name when the catalog names neither
pub fun request_name(r: *Request, at: usize, len: usize) err[Error] {
    val id: opt[Id] = lookup(r.catalog, r.spelling, at, len);
    if (sel id.some) {
        request_add(r, id.some);
        ret err[Error].ok{};
    }
    val level: opt[*Level] = level_lookup(r.catalog, r.spelling, at, len);
    if (sel level.none) { ret err[Error].err{refusal(r, "unknown extension", at, len)}; }
    val members: Ids = level.some.members;
    var i:       u32 = 0;
    for (i < members.len) {
        request_add(r, members.at[i]);
        i = i + 1;
    }
    ret err[Error].ok{};
}

# release a request that will not be closed
pub fun request_release(r: *Request) err[A.Error] {
    ret bitset.dnit(?r.named);
}

# the request closed over its implications to a fixed point. the selection
# takes the request's storage, so the request is spent either way
# ---
# ret: the selection, or the first conflicting pair the closure holds, with the storage released
pub fun close(r: Request) res[Selection, Error] {
    var members: bitset.Bitset = r.named;
    var grew:    bool          = true;
    for (grew) {
        grew = false;
        var i: u32 = 0;
        for (i < r.catalog.count) {
            if (bitset.get(?members, i::usize)) {
                val implies: Ids = r.catalog.extensions[i].implies;
                var j:       u32 = 0;
                for (j < implies.len) {
                    if (!bitset.get(?members, implies.at[j]::usize)) {
                        bitset.set(?members, implies.at[j]::usize);
                        grew = true;
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }
    var k: u32 = 0;
    for (k < r.catalog.conflict_count) {
        val pair: Conflict = r.catalog.conflicts[k];
        if (bitset.get(?members, pair.a::usize) && bitset.get(?members, pair.b::usize)) {
            bitset.dnit(?members);
            ret res[Selection, Error].err{Error.conflict{pair}};
        }
        k = k + 1;
    }
    ret res[Selection, Error].ok{Selection{catalog: r.catalog, members: members}};
}

# the closed selection `spelling` names in the catalog's syntax
# ---
# origin: the position of the spelling's first byte in its source, which its refusal is placed from
# ret:    the selection, or the syntax's one refusal, a conflict, or the allocator's refusal
pub fun select(a: *A.Allocator, catalog: *Catalog, spelling: str, origin: diagnostic.Position) res[Selection, Error] {
    val made: res[Request, Error] = request(a, catalog, spelling, origin);
    if (sel made.err) { ret res[Selection, Error].err{made.err}; }
    var r:      Request    = made.ok;
    val parsed: err[Error] = catalog.syntax.parse(?r);
    if (sel parsed.err) {
        request_release(?r);
        ret res[Selection, Error].err{parsed.err};
    }
    ret close(r);
}

# release a selection's storage
pub fun release(s: *Selection) err[A.Error] {
    ret bitset.dnit(?s.members);
}

# whether the extension `id` is in the closed selection
pub fun has(s: *Selection, id: Id) bool {
    ret bitset.get(?s.members, id::usize);
}

# whether every extension of `required` is in the closed selection. the one
# admission predicate: the parser and the encoder both ask it of a row
pub fun admits(s: *Selection, required: Ids) bool {
    var i: u32 = 0;
    for (i < required.len) {
        if (!has(s, required.at[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the extension `id` removed from the selection with every member that implies
# it, directly or through others, so the selection stays closed
pub fun without(s: *Selection, id: Id) {
    bitset.clear(?s.members, id::usize);
    var shrank: bool = true;
    for (shrank) {
        shrank = false;
        var i: u32 = 0;
        for (i < s.catalog.count) {
            if (has(s, i) && !admits(s, s.catalog.extensions[i].implies)) {
                bitset.clear(?s.members, i::usize);
                shrank = true;
            }
            i = i + 1;
        }
    }
}

# the selection's spelling in its catalog's syntax, appended to `out`
pub fun spell(s: *Selection, out: *vector.Vector[u8]) err[A.Error] {
    ret s.catalog.syntax.spell(s, out);
}

# `text` appended to `out`
pub fun append(out: *vector.Vector[u8], text: str) err[A.Error] {
    val len: usize = str_len(text);
    var i:   usize = 0;
    for (i < len) {
        val pushed: res[usize, A.Error] = vector.push[u8](out, text[i]);
        if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# a comma-separated list of extension and level names
fun list_parse(r: *Request) err[Error] {
    val spelling: str   = r.spelling;
    val len:      usize = str_len(spelling);
    var start:    usize = 0;
    var at:       usize = 0;
    for (len > 0 && at <= len) {
        if (at == len || spelling[at] == ',') {
            if (at == start) { ret err[Error].err{refusal(r, "empty extension name", at, 0)}; }
            val named: err[Error] = request_name(r, start, at - start);
            if (sel named.err) { ret named; }
            start = at + 1;
        }
        at = at + 1;
    }
    ret err[Error].ok{};
}

# the members' names in catalog order, comma-separated
fun list_spell(s: *Selection, out: *vector.Vector[u8]) err[A.Error] {
    var first: bool = true;
    var i:     u32  = 0;
    for (i < s.catalog.count) {
        if (has(s, i)) {
            if (!first) {
                val pushed: res[usize, A.Error] = vector.push[u8](out, ',');
                if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
            }
            val named: err[A.Error] = append(out, s.catalog.extensions[i].name);
            if (sel named.err) { ret named; }
            first = false;
        }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# the syntax of a set whose names carry no selection: `name,name,...`
pub val LIST: Syntax = Syntax{parse: list_parse, spell: list_spell};

#[testing]
val T_TO_B:  [1]Id = [1]Id{1};
#[testing]
val T_TO_C:  [1]Id = [1]Id{2};
#[testing]
val T_TO_A:  [1]Id = [1]Id{0};
#[testing]
val T_TO_E:  [1]Id = [1]Id{4};
#[testing]
val T_LEVEL: [2]Id = [2]Id{3, 5};

# a, b and c imply each other in a cycle, d implies e, f stands alone, and g conflicts with e
#[testing]
val T_ROWS: [7]Extension = [7]Extension{
    Extension{name: "a", implies: Ids{at: ?T_TO_B[0], len: 1}, revision: "1.0"},
    Extension{name: "b", implies: Ids{at: ?T_TO_C[0], len: 1}, revision: "1.0"},
    Extension{name: "c", implies: Ids{at: ?T_TO_A[0], len: 1}, revision: "1.0"},
    Extension{name: "d", implies: Ids{at: ?T_TO_E[0], len: 1}, revision: "1.0"},
    Extension{name: "e", implies: Ids{at: nil, len: 0}, revision: "1.0"},
    Extension{name: "f", implies: Ids{at: nil, len: 0}, revision: "1.0"},
    Extension{name: "g", implies: Ids{at: nil, len: 0}, revision: "1.0"},
};

#[testing]
val T_LEVELS: [1]Level = [1]Level{Level{name: "lv", members: Ids{at: ?T_LEVEL[0], len: 2}}};

#[testing]
val T_CONFLICTS: [1]Conflict = [1]Conflict{Conflict{a: 4, b: 6}};

#[testing]
val T_CATALOG: Catalog = Catalog{
    extensions:     ?T_ROWS[0],
    count:          7,
    levels:         ?T_LEVELS[0],
    level_count:    1,
    conflicts:      ?T_CONFLICTS[0],
    conflict_count: 1,
    syntax:         ?LIST,
};

# whether the selection's members are exactly the bits of `mask`
#[testing]
fun t_holds(s: *Selection, mask: u32) bool {
    var i: u32 = 0;
    for (i < s.catalog.count) {
        if (has(s, i) != (((mask >> i) & 1) != 0)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the selection `spelling` makes over the test catalog, into `out`
#[testing]
fun t_select(a: *A.Allocator, spelling: str, out: *Selection) bool {
    val made: res[Selection, Error] = select(a, ?T_CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret false; }
    @out = made.ok;
    ret true;
}

test close__reaches_a_fixed_point_through_chains_and_cycles {
    var t: testing.Testing;
    testing.make(?t);
    var s: Selection;
    if (!t_select(testing.allocator_of(?t), "b", ?s) || !t_holds(?s, 0b000111)) { ret 1; }
    release(?s);
    if (!t_select(testing.allocator_of(?t), "d", ?s) || !t_holds(?s, 0b011000)) { ret 2; }
    release(?s);
    ret 0;
}

test request_name__a_level_expands_to_its_members {
    var t: testing.Testing;
    testing.make(?t);
    var s: Selection;
    if (!t_select(testing.allocator_of(?t), "lv", ?s) || !t_holds(?s, 0b111000)) { ret 1; }
    release(?s);
    ret 0;
}

test without__drops_the_extensions_that_imply_the_removed_one {
    var t: testing.Testing;
    testing.make(?t);
    var s: Selection;
    if (!t_select(testing.allocator_of(?t), "a,d,f", ?s)) { ret 1; }
    without(?s, 4);
    if (!t_holds(?s, 0b100111)) { ret 2; }
    without(?s, 1);
    if (!t_holds(?s, 0b100000)) { ret 3; }
    release(?s);
    ret 0;
}

test admits__refuses_a_requirement_outside_the_closed_set {
    var t: testing.Testing;
    testing.make(?t);
    var s: Selection;
    if (!t_select(testing.allocator_of(?t), "d", ?s)) { ret 1; }
    val inside:  [2]Id = [2]Id{3, 4};
    val outside: [2]Id = [2]Id{4, 5};
    if (!admits(?s, Ids{at: ?inside[0], len: 2}) || !admits(?s, Ids{at: nil, len: 0})) { ret 2; }
    if (admits(?s, Ids{at: ?outside[0], len: 2}))                                      { ret 3; }
    release(?s);
    ret 0;
}

test select__refuses_an_unknown_name {
    var t: testing.Testing;
    testing.make(?t);
    val made: res[Selection, Error] = select(testing.allocator_of(?t), ?T_CATALOG, "a,zz,b", diagnostic.START);
    if (sel made.ok)                                                                                            { ret 1; }
    if (!(sel made.err.refused && (made.err.refused.span.start.offset == 2 && made.err.refused.span.len == 2))) { ret 3; }
    if (testing.live_count(?t) != 0)                                                                            { ret 4; }
    ret 0;
}

# d brings e, and e and g cannot coexist, so the pair is found only after closure
test close__refuses_a_closure_holding_a_conflicting_pair {
    var t: testing.Testing;
    testing.make(?t);
    val made: res[Selection, Error] = select(testing.allocator_of(?t), ?T_CATALOG, "g,d", diagnostic.START);
    if (sel made.ok)                                                                        { ret 1; }
    if (!(sel made.err.conflict && (made.err.conflict.a == 4 && made.err.conflict.b == 6))) { ret 3; }
    if (testing.live_count(?t) != 0)                                                        { ret 4; }
    ret 0;
}

test close__a_set_past_64_members_closes_and_admits {
    var rows: [100]Extension;
    var next: [100]Id;
    var i:    u32 = 0;
    for (i < 100) {
        next[i] = i + 1;
        rows[i] = Extension{name: "x", implies: Ids{at: ?next[i], len: 1}, revision: "1.0"};
        i       = i + 1;
    }
    rows[99].implies = Ids{at: nil, len: 0};
    var catalog: Catalog = Catalog{extensions: ?rows[0], count: 100, levels: nil, level_count: 0, conflicts: nil, conflict_count: 0, syntax: ?LIST};
    var t:       testing.Testing;
    testing.make(?t);
    val made: res[Request, Error] = request(testing.allocator_of(?t), ?catalog, "", diagnostic.START);
    if (sel made.err) { ret 1; }
    var r: Request = made.ok;
    request_add(?r, 1);
    val closed: res[Selection, Error] = close(r);
    if (sel closed.err) { ret 4; }
    var s:     Selection = closed.ok;
    val far:   [3]Id     = [3]Id{1, 64, 99};
    val first: [1]Id     = [1]Id{0};
    if (!admits(?s, Ids{at: ?far[0], len: 3}))  { ret 2; }
    if (admits(?s, Ids{at: ?first[0], len: 1})) { ret 3; }
    release(?s);
    ret 0;
}

test spell__a_selection_spells_back_to_its_names {
    var t: testing.Testing;
    testing.make(?t);
    var s: Selection;
    if (!t_select(testing.allocator_of(?t), "d,c", ?s)) { ret 1; }
    var out:     vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t));
    val spelled: err[A.Error]      = spell(?s, ?out);
    if (sel spelled.err) { ret 2; }
    val want: str = "a,b,c,d,e";
    if (out.len != str_len(want)) { ret 3; }
    var i: usize = 0;
    for (i < out.len) {
        if (out.data[i] != want[i]) { ret 4; }
        i = i + 1;
    }
    vector.dnit[u8](?out);
    release(?s);
    ret 0;
}

# names `a`, then refuses whatever follows it
#[testing]
fun t_hook_parse(r: *Request) err[Error] {
    val named: err[Error] = request_name(r, 0, 1);
    if (sel named.err)           { ret named; }
    if (str_len(r.spelling) > 1) { ret err[Error].err{refusal(r, "malformed selection", 1, str_len(r.spelling) - 1)}; }
    ret err[Error].ok{};
}

#[testing]
val T_HOOK: Syntax = Syntax{parse: t_hook_parse, spell: list_spell};

test select__a_refusal_from_a_selection_hook_is_one_diagnostic {
    var catalog: Catalog = T_CATALOG;
    catalog.syntax = ?T_HOOK;
    var t: testing.Testing;
    testing.make(?t);
    val made: res[Selection, Error] = select(testing.allocator_of(?t), ?catalog, "a_q", diagnostic.START);
    if (sel made.ok)                                                                                            { ret 1; }
    if (!(sel made.err.refused && (made.err.refused.span.start.offset == 1 && made.err.refused.span.len == 2))) { ret 3; }
    if (testing.live_count(?t) != 0)                                                                            { ret 4; }
    ret 0;
}
