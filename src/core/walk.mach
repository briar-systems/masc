# the length class of a risc-v instruction, from its low two bits
#[testing]
fun t_key_length(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val half: res[u64, field.Refusal] = field.read(s, at, 2);
    if (sel half.err) { ret half; }
    ret res[u64, field.Refusal].ok{half.ok & 3};
}

#[testing]
fun t_key_opcode(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val word: res[u64, field.Refusal] = field.read(s, at, 4);
    if (sel word.err) { ret word; }
    ret res[u64, field.Refusal].ok{word.ok & 0x7F};
}

#[testing]
fun t_key_funct3(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val half: res[u64, field.Refusal] = field.read(s, at, 2);
    if (sel half.err) { ret half; }
    ret res[u64, field.Refusal].ok{(half.ok >> 13) & 7};
}

#[testing]
val T_KEYS: [3]Key = [3]Key{
    Key{name: "length", extract: t_key_length},
    Key{name: "opcode", extract: t_key_opcode},
    Key{name: "funct3", extract: t_key_funct3},
};

