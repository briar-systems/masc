# a test's selection and output buffers
#[testing]
rec T {
    t:      testing.Testing;
    s:      extension.Selection;
    out:    vector.Vector[u8];
    fixups: vector.Vector[field.Fixup];
}

#[testing]
fun t_make(t: *T) bool {
    testing.make(?t.t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t.t), ?T_CATALOG, "i,c");
    if (sel made.err) { ret false; }
    t.s      = made.ok;
    t.out    = vector.init[u8](testing.allocator_of(?t.t));
    t.fixups = vector.init[field.Fixup](testing.allocator_of(?t.t));
    ret true;
}

#[testing]
fun t_encode(t: *T, r: u32, values: *operand.Value, count: u32) res[usize, field.Refusal] {
    var ins: inst.Inst = inst.Inst{row: ?T_ROWS[r], values: values, count: count};
    ret encode(?T_CODEC, ?t.s, ?ins, ?t.out, ?t.fixups);
}

# whether the output is exactly `want`
#[testing]
fun t_wrote(t: *T, want: *u8, len: usize) bool {
    if (t.out.len != len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (t.out.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun t_refused(got: res[usize, field.Refusal], message: str, op: u8) bool {
    ret sel got.err && (got.err.message == message && got.err.operand == op);
}

test encode__an_immediate_out_of_range_is_refused {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    var values: [3]operand.Value = [3]operand.Value{operand.Value.register{register.make(0, 1)}, operand.Value.register{register.make(0, 2)}, operand.Value.immediate{2048}};
    if (!t_refused(t_encode(?t, 0, ?values[0], 3), field.OUT_OF_RANGE, 2)) { ret 2; }
    values[2] = operand.Value.immediate{-2049};
    if (!t_refused(t_encode(?t, 0, ?values[0], 3), field.OUT_OF_RANGE, 2)) { ret 3; }
    if (t.out.len != 0)                                                    { ret 4; }
    ret 0;
}

test encode__a_misaligned_scaled_immediate_is_refused {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val values: [3]operand.Value = [3]operand.Value{operand.Value.register{register.make(0, 1)}, operand.Value.register{register.make(0, 2)}, operand.Value.relative{3}};
    if (!t_refused(t_encode(?t, 1, ?values[0], 3), field.MISALIGNED, 2)) { ret 2; }
    ret 0;
}

test encode__a_register_of_the_wrong_class_is_refused {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val values: [3]operand.Value = [3]operand.Value{operand.Value.register{register.make(1, 1)}, operand.Value.register{register.make(0, 2)}, operand.Value.immediate{0}};
    if (!t_refused(t_encode(?t, 0, ?values[0], 3), field.WRONG_CLASS, 0)) { ret 2; }
    ret 0;
}

test walk__signed_boundary_values_encode_and_decode {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val bounds: [2]i64 = [2]i64{-2048, 2047};
    val want:   [8]u8  = [8]u8{0x93, 0x00, 0x01, 0x80, 0x93, 0x00, 0xF1, 0x7F};
    var i:      u32    = 0;
    for (i < 2) {
        val values: [3]operand.Value          = [3]operand.Value{operand.Value.register{register.make(0, 1)}, operand.Value.register{register.make(0, 2)}, operand.Value.immediate{bounds[i]}};
        val wrote:  res[usize, field.Refusal] = t_encode(?t, 0, ?values[0], 3);
        if (!(sel wrote.ok && wrote.ok == 4)) { ret 2; }
        i = i + 1;
    }
    if (!t_wrote(?t, ?want[0], 8)) { ret 3; }
    var store: [3]operand.Value;
    i = 0;
    for (i < 2) {
        val got: res[Decoded, field.Refusal] = decode_row(?T_CODEC, ?t.s, ?T_ROWS[0], t.out.data, t.out.len, i::usize * 4, ?store[0], 3);
        if (sel got.err)                                                          { ret 4; }
        if (!(sel store[2].immediate && store[2].immediate == bounds[i]))         { ret 5; }
        if (!(sel store[0].register && store[0].register == register.make(0, 1))) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

test walk__a_split_immediate_reassembles {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val offsets: [2]i64 = [2]i64{2730, -4096};
    val want:    [8]u8  = [8]u8{0xE3, 0x85, 0x20, 0x2A, 0x63, 0x80, 0x20, 0x80};
    var i:       u32    = 0;
    for (i < 2) {
        val values: [3]operand.Value          = [3]operand.Value{operand.Value.register{register.make(0, 1)}, operand.Value.register{register.make(0, 2)}, operand.Value.relative{offsets[i]}};
        val wrote:  res[usize, field.Refusal] = t_encode(?t, 1, ?values[0], 3);
        if (sel wrote.err) { ret 2; }
        i = i + 1;
    }
    if (!t_wrote(?t, ?want[0], 8)) { ret 3; }
    var store: [3]operand.Value;
    i = 0;
    for (i < 2) {
        val got: res[Decoded, field.Refusal] = decode_row(?T_CODEC, ?t.s, ?T_ROWS[1], t.out.data, t.out.len, i::usize * 4, ?store[0], 3);
        if (sel got.err)                                                 { ret 4; }
        if (!(sel store[2].relative && store[2].relative == offsets[i])) { ret 5; }
        i = i + 1;
    }
    ret 0;
}

test decode_row__fixed_bits_that_do_not_match_refuse {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val beq:   [4]u8                       = [4]u8{0xE3, 0x85, 0x20, 0x2A};
    var store: [3]operand.Value;
    val got:   res[Decoded, field.Refusal] = decode_row(?T_CODEC, ?t.s, ?T_ROWS[0], ?beq[0], 4, 0, ?store[0], 3);
    if (!(sel got.err && got.err.message == field.MISMATCH)) { ret 2; }
    ret 0;
}

test decode__a_truncated_stream_is_refused {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val addi:  [3]u8                       = [3]u8{0x93, 0x00, 0x01};
    var store: [3]operand.Value;
    val got:   res[Decoded, field.Refusal] = decode(?T_CODEC, ?t.s, ?addi[0], 3, 0, ?store[0], 3);
    if (!(sel got.err && got.err.message == field.TRUNCATED)) { ret 2; }
    val row: res[Decoded, field.Refusal] = decode_row(?T_CODEC, ?t.s, ?T_ROWS[0], ?addi[0], 3, 0, ?store[0], 3);
    if (!(sel row.err && row.err.message == field.TRUNCATED)) { ret 3; }
    ret 0;
}

test walk__a_variable_length_field_reports_its_length {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    val consts: [2]i64   = [2]i64{5, 300};
    val lens:   [2]usize = [2]usize{2, 3};
    var i:      u32      = 0;
    for (i < 2) {
        val values: [1]operand.Value          = [1]operand.Value{operand.Value.immediate{consts[i]}};
        val wrote:  res[usize, field.Refusal] = t_encode(?t, 3, ?values[0], 1);
        if (!(sel wrote.ok && wrote.ok == lens[i])) { ret 2; }
        i = i + 1;
    }
    val want: [5]u8 = [5]u8{0x41, 0x05, 0x41, 0xAC, 0x02};
    if (!t_wrote(?t, ?want[0], 5)) { ret 3; }
    var store: [1]operand.Value;
    val got:   res[Decoded, field.Refusal] = decode_row(?T_CODEC, ?t.s, ?T_ROWS[3], t.out.data, t.out.len, 2, ?store[0], 1);
    if (!(sel got.ok && got.ok.len == 3))                       { ret 4; }
    if (!(sel store[0].immediate && store[0].immediate == 300)) { ret 5; }
    ret 0;
}

test decode__dispatch_selects_the_row_whose_fixed_bits_match {
    var t: T;
    if (!t_make(?t)) { ret 1; }
    # c.li a0, -1, then addi x1, x2, 2047, then beq x1, x2, 2730
    val stream: [10]u8 = [10]u8{0x7D, 0x55, 0x93, 0x00, 0xF1, 0x7F, 0xE3, 0x85, 0x20, 0x2A};
    val rows:   [3]u32 = [3]u32{2, 0, 1};
    var store:  [3]operand.Value;
    var at:     usize  = 0;
    var i:      u32    = 0;
    for (i < 3) {
        val got: res[Decoded, field.Refusal] = decode(?T_CODEC, ?t.s, ?stream[0], 10, at, ?store[0], 3);
        if (sel got.err)                         { ret 2; }
        if (got.ok.inst.row != ?T_ROWS[rows[i]]) { ret 3; }
        at = at + got.ok.len;
        i  = i + 1;
    }
    if (at != 10)                                                             { ret 4; }
    if (!(sel store[0].register && store[0].register == register.make(0, 1))) { ret 5; }
    ret 0;
}
