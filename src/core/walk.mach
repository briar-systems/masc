# the b immediate: offset bits 12, 10 to 5, 4 to 1 and 11
#[testing]
val T_BEQ_SLICES: [6]field.Slice = [6]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 5, at: 15, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 0, len: 5, at: 20, invert: false},
    field.Slice{operand: 2, part: field.NUMBER, lo: 12, len: 1, at: 31, invert: false},
