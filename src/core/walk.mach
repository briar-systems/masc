    operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?T_GPR[0], len: 1}, first: 0, count: 0, excluded: operand.Numbers{at: nil, len: 0}}}, role: operand.READ, width: 64, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.immediate{operand.Immediate{bits: 12, signed: true, scale: 0, bias: 0, fixup: operand.NO_FIXUP, format: operand.INTEGER, excluded: operand.Integers{at: nil, len: 0}}}, role: operand.READ, width: 64, quantity: operand.ONE},
