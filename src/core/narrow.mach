# a selection narrowed for the statements a source dialect scopes, and its view of the register file
#
# a narrowing is a selection less the extensions the dialect's narrowings in
# force remove, each with every member that implies it, so the narrowed
# selection stays closed. the selection narrowed is the object's, or one the
# source restates within it, so a narrowing never holds what the object's
# does not.
# it is held on the heap: its view points at its selection, and the builder
# and the disassembler keep the view by pointer for as long as what they
# write under it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;

use A: std.allocator;

use masc.core.extension;
use masc.core.register;
use masc.core.set;

# a narrowed selection and its view
pub rec Narrowed {
    selection: extension.Selection;
    available: register.Available;
}

# the bit of narrowing `i` in a mask of the narrowings in force
pub fun bit(i: u32) u64 {
    ret 1::u64 << i::u64;
}

# whether narrowing `n` removes anything `s` holds
pub fun narrows(s: *extension.Selection, n: *set.Narrowing) bool {
    var i: u32 = 0;
    for (i < n.removes.len) {
        if (extension.has(s, n.removes.at[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the view `base` narrowed by each narrowing of `all` that `active` marks, which `release` gives back
pub fun make(a: *A.Allocator, base: *register.Available, all: set.Narrowings, active: u64) res[*Narrowed, register.Error] {
    ret from(a, base.file, base.selection, all, active);
}

# the view of `file` under `base` narrowed by each narrowing of `all` that `active` marks, as a selection a source
# restates is narrowed, which `release` gives back
pub fun from(a: *A.Allocator, file: *register.File, base: *extension.Selection, all: set.Narrowings, active: u64) res[*Narrowed, register.Error] {
    val kept: res[*Narrowed, A.Error] = A.allocate[Narrowed](a, 1);
    if (sel kept.err) { ret res[*Narrowed, register.Error].err{register.Error.memory{kept.err}}; }
    val n:      *Narrowed                         = kept.ok;
    val copied: res[extension.Selection, A.Error] = extension.copy(a, base);
    if (sel copied.err) {
        A.deallocate[Narrowed](a, n, 1);
        ret res[*Narrowed, register.Error].err{register.Error.memory{copied.err}};
    }
    n.selection = copied.ok;
    var i: u32 = 0;
    for (i < all.len) {
        if ((active & bit(i)) != 0) {
            val removes: *set.Narrowing = ?all.at[i];
            var k:       u32            = 0;
            for (k < removes.removes.len) {
                extension.without(?n.selection, removes.removes.at[k]);
                k = k + 1;
            }
        }
        i = i + 1;
    }
    val viewed: res[register.Available, register.Error] = register.select(a, file, ?n.selection);
    if (sel viewed.err) {
        extension.release(?n.selection);
        A.deallocate[Narrowed](a, n, 1);
        ret res[*Narrowed, register.Error].err{viewed.err};
    }
    n.available = viewed.ok;
    ret res[*Narrowed, register.Error].ok{n};
}

# everything `n` holds given back
pub fun release(a: *A.Allocator, n: *Narrowed) {
    register.release(?n.available);
    extension.release(?n.selection);
    A.deallocate[Narrowed](a, n, 1);
}
