# where an operand's bits lie in a fixed-width unit, the facts a set states once per operand layout
#
# most fields of a fixed-width set are slices of an operand's encoded number: a
# split immediate is pieces of one number, a register is a run of bits holding
# its number less a range's first, and an enumerant is bits holding a member's
# value. a layout, choice or position states those pieces and the operand shape
# once, and `slices` turns them into the core field slices of one row's operand.
# the records are every fixed-width set's, as risc-v's and aarch64's

use std.types.bool.false;
use std.types.string.str;

use masc.core.field;
use masc.core.operand;

# `len` bits of the encoded number from bit `lo` land at bit `at` of the unit
pub rec Piece {
    lo:  u8;
    len: u8;
    at:  u8;
}

# pieces as a pointer to static pieces and a count
pub rec Pieces {
    at:  *Piece;
    len: u32;
}

pub val NO_PIECES: Pieces = Pieces{at: nil, len: 0};

# an immediate operand and where its bits lie
# ---
# name:   the name diagnostics and generators spell
# unit:   the bits of the unit it lies in
# pieces: where the encoded number lands
# value:  the operand shape
pub rec Layout {
    name:   str;
    unit:   u8;
    pieces: Pieces;
    value:  operand.Immediate;
}

# an enumerant or condition operand and where its bits lie
# ---
# name:   the name diagnostics and generators spell
# unit:   the bits of the unit it lies in
# pieces: where the member's value lands
# values: the members
pub rec Choice {
    name:   str;
    unit:   u8;
    pieces: Pieces;
    values: operand.Enumeration;
}

# a register operand's position, its range and where its number lies
# ---
# name:     the name diagnostics and generators spell
# unit:     the bits of the unit it lies in
# first:    the lowest register number it admits
# count:    how many numbers it admits from first, 0 for every number
# at:       the bit of the unit the number starts at
# len:      how many bits the number takes
# excluded: the numbers it never admits
# group:    the registers its number names together, as a power of two exponent, 0 for one, as an even pair's 1.
#           the excluded numbers are the ones off the group's alignment
pub rec Position {
    name:     str;
    unit:     u8;
    first:    u32;
    count:    u32;
    at:       u8;
    len:      u8;
    excluded: operand.Numbers;
    group:    u8;
}

# the pieces as slices of operand `op`'s `part`, written to `out`
# ---
# ret: how many slices were written
pub fun slices(pieces: Pieces, op: u8, part: field.Part, out: *field.Slice) u32 {
    var i: u32 = 0;
    for (i < pieces.len) {
        val p: Piece = pieces.at[i];
        out[i] = field.Slice{operand: op, part: part, lo: p.lo, len: p.len, at: p.at, invert: false};
        i      = i + 1;
    }
    ret pieces.len;
}

# a register position as the slice of operand `op`
pub fun slice_of(p: *Position, op: u8) field.Slice {
    ret field.Slice{operand: op, part: field.NUMBER, lo: 0, len: p.len, at: p.at, invert: false};
}
