# the registration record of an instruction set, and the registry shape
#
# a set is one static record: the architectures it serves, named by mink's
# catalog, its codec, its extension catalog, the binding of its fixup kinds
# to mink's relocation kinds, its relaxation rows, its compressions, its
# code fill, its alignment marker, its data fixups, the fixups that cover a
# sequence and its assembly syntaxes.
# what a set does not have is absent, never a stand-in: spir-v has no
# register file, no fixups, no relaxations and no fill. the registry is a static list of
# records, checked once by `masc.core.check`, and read by architecture.

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink;

use masc.core.compress;
use masc.core.extension;
use masc.core.mode;
use masc.core.operand;
use masc.core.relax;
use masc.core.requirement;
use masc.core.spelling;
use masc.core.walk;

# architectures as a pointer to rows of mink's architecture catalog and a count
pub rec Arches {
    at:  **mink.arch.Arch;
    len: u32;
}

# the extension a selection holds when it is for one architecture of a set that serves several widths
# ---
# arch:      the architecture
# extension: the catalog row whose membership states that architecture's mode, as risc-v's rv64 for riscv64. a set whose
#            architectures have no mode to tell apart names the extension its selections always hold
pub rec Mode {
    arch:      *mink.arch.Arch;
    extension: requirement.Id;
}

# modes as a pointer to rows and a count
pub rec Modes {
    at:  *Mode;
    len: u32;
}

# a set-local fixup kind and the neutral relocation kind it becomes
# ---
# fixup: the set-local kind
# kind:  the row of mink's relocation kinds it maps to
pub rec Binding {
    fixup: operand.FixupKind;
    kind:  *mink.reloc.Kind;
}

# bindings as a pointer to static bindings and a count, nil and 0 for a set with no fixups
pub rec Bindings {
    at:  *Binding;
    len: u32;
}

pub val NO_BINDINGS: Bindings = Bindings{at: nil, len: 0};

# bytes that pad code to an alignment
# ---
# bytes:    the encoded instruction
# len:      how many bytes it is
# requires: the alternatives of extensions a selection must hold, any one fully, to admit it, as risc-v c.nop needs c
pub rec Pattern {
    bytes:    *u8;
    len:      u32;
    requires: requirement.Requirement;
}

# a set's code fill: its no-op patterns, longest first. the builder pads with
# the longest admitted pattern that fits the gap
pub rec Fill {
    patterns: *Pattern;
    count:    u32;
}

# what a datum's value is measured from
# ---
# ABSOLUTE: the target's address
# RELATIVE: the distance from the datum's own place, as `.4byte sym - .`
pub def Basis: u8;

pub val ABSOLUTE: Basis = 0;
pub val RELATIVE: Basis = 1;

# the widest datum, in bytes
pub val MAX_WIDTH: u8 = 8;

# the fixup kind a datum of one basis and width takes
# ---
# basis: what its value is measured from
# width: its width in bytes, 1 to MAX_WIDTH
# fixup: the set-local fixup kind, bound like an operand's
pub rec Datum {
    basis: Basis;
    width: u8;
    fixup: operand.FixupKind;
}

# data fixups as a pointer to static rows and a count
pub rec Data {
    at:  *Datum;
    len: u32;
}

# the data fixups of a set with none
pub val NO_DATA: Data = Data{at: nil, len: 0};

# the fixup kinds a difference of two labels of one width takes when the linker may resize code between them, as
# risc-v's add32 and sub32: the field holds the label added less the label subtracted once both are relocated
# ---
# width: its width in bytes, 1 to MAX_WIDTH
# add:   the set-local fixup kind that adds the label added and the addend
# sub:   the set-local fixup kind that subtracts the label subtracted
pub rec Pair {
    width: u8;
    add:   operand.FixupKind;
    sub:   operand.FixupKind;
}

# pairs as a pointer to static rows and a count
pub rec Pairs {
    at:  *Pair;
    len: u32;
}

# the pairs of a set whose linker never resizes code, so a difference within a section always folds
pub val NO_PAIRS: Pairs = Pairs{at: nil, len: 0};

# how `.align` reads its operand, which the gnu assembler reads per target
# ---
# ALIGN_BYTES: a boundary in bytes, as on x86
# ALIGN_POWER: a power of two, as on risc-v and aarch64
pub def AlignBy: u8;

pub val ALIGN_BYTES: AlignBy = 0;
pub val ALIGN_POWER: AlignBy = 1;

# an integer data directive and the width of each value it writes, as `.word`, whose width differs per target
# ---
# name:  the directive, its leading dot included
# width: its width in bytes, 1 to MAX_WIDTH
pub rec Width {
    name:  str;
    width: u8;
}

# widths as a pointer to static rows and a count
pub rec Widths {
    at:  *Width;
    len: u32;
}

# a narrowing of the selection the source dialect states for the statements after it, as risc-v's `.option norvc` keeps
# them full length
# ---
# narrow:  the operand of the form directive that narrows, as `norvc`
# lift:    the operand that lifts it again, as `rvc`
# removes: the extensions it removes, each with every member that implies it, so the selection stays closed, as zca
#          takes c and the rest of zc* with it
# lifted:  the extension `lift` states the selection holds, as `rvc` states c. a narrowing lifts back to the object's
#          selection and never widens it, so `lift` is refused when the object's selection does not hold this
pub rec Narrowing {
    narrow:  str;
    lift:    str;
    removes: requirement.Ids;
    lifted:  requirement.Id;
}

# narrowings as a pointer to static rows and a count, at most MAX_NARROWINGS
pub rec Narrowings {
    at:  *Narrowing;
    len: u32;
}

# the most narrowings a dialect states, one bit each of the narrowing in force
pub val MAX_NARROWINGS: u32 = 64;

# how the source dialect states the selection a statement is written under, which chooses its form among the encodings
# the selection admits. the selection is only ever narrowed from the object's, so what the object states as a whole,
# as its derived traits, is the object's selection's
# ---
# directive:  the directive whose one operand names what it does, as risc-v's `.option`, empty for a dialect with none
# push:       the operand that saves the narrowing in force, as `push`, empty for a dialect with no stack of them
# pop:        the operand that restores the one saved last, as `pop`, empty exactly when `push` is
# narrowings: what its other operands narrow
pub rec Forms {
    directive:  str;
    push:       str;
    pop:        str;
    narrowings: Narrowings;
}

# the forms of a dialect that states none
pub val NO_FORMS: Forms = Forms{directive: "", push: "", pop: "", narrowings: Narrowings{at: nil, len: 0}};

# the facts of the gnu assembler's source dialect of a set's targets, which every syntax of the set shares
# ---
# comment:   the text that starts a comment running to the end of its line, as `#` or `//`
# separator: the character that ends a statement within a line, as `;`
# types:     the characters that may prefix a type's spelling in `.type` and `.section`, as `@` or `%`
# align:     how `.align` reads its operand
# widths:    the integer data directives and their widths
# forms:     how it narrows the selection a statement is written under
pub rec Source {
    comment:   str;
    separator: u8;
    types:     str;
    align:     AlignBy;
    widths:    Widths;
    forms:     Forms;
}

# a fixup kind whose relocation covers instructions after the one it rides on, as risc-v's call pair, whose
# relocation patches its auipc and the jalr after it. the builder writes the instructions it covers as one
# sequence, in the form the relocation fixes, refuses it outside one, and attaches its marker whatever built it
# ---
# fixup:  the set-local kind
# count:  how many instructions it covers, the one it rides on first
# marker: the marker fixup kind that rides beside it, as risc-v's RELAX lets the linker relax a call, operand.NO_FIXUP for none
pub rec Span {
    fixup:  operand.FixupKind;
    count:  u32;
    marker: operand.FixupKind;
}

# spans as a pointer to static spans and a count, in ascending order of fixup kind
pub rec Spans {
    at:  *Span;
    len: u32;
}

# the spans of a set whose every relocation covers only its own instruction
pub val NO_SPANS: Spans = Spans{at: nil, len: 0};

# the span of fixup kind `fixup`, a binary search of `all`, none when its relocation covers only its own instruction
pub fun span_of(all: Spans, fixup: operand.FixupKind) opt[*Span] {
    var lo: u32 = 0;
    var hi: u32 = all.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (all.at[mid].fixup < fixup) { lo = mid + 1; }
        or                             { hi = mid; }
    }
    if (lo >= all.len || all.at[lo].fixup != fixup) { ret opt[*Span].none{}; }
    ret opt[*Span].some{?all.at[lo]};
}

# trait axes as a pointer to rows of mink's trait catalog and a count
pub rec Axes {
    at:  **mink.trait.Axis;
    len: u32;
}

# the axes of a set that asks a caller for none
pub val NO_AXES: Axes = Axes{at: nil, len: 0};

# the traits a caller states, as a pointer to rows and a count
pub rec Traits {
    at:  *mink.trait.Trait;
    len: u32;
}

# the traits of a caller with none to state
pub val NO_TRAITS: Traits = Traits{at: nil, len: 0};

# an assembler option's spelling of a trait the set requires of its caller, as risc-v's `-mabi=lp64d` states the double
# float abi
# ---
# option: the option, as `-mabi`
# value:  its value, as `lp64d`
# trait:  the trait it states
pub rec Stated {
    option: str;
    value:  str;
    trait:  mink.trait.Trait;
}

# option spellings as a pointer to static rows and a count
pub rec Spellings {
    at:  *Stated;
    len: u32;
}

# the option spellings of a set that requires no trait of its caller
pub val NO_SPELLINGS: Spellings = Spellings{at: nil, len: 0};

# the trait option `option` given `value` states for `s`, none when the set spells none so
pub fun stated(s: *Set, option: str, value: str) opt[mink.trait.Trait] {
    var i: u32 = 0;
    for (i < s.options.len) {
        val row: *Stated = ?s.options.at[i];
        if (str_equals(row.option, option) && str_equals(row.value, value)) { ret opt[mink.trait.Trait].some{row.trait}; }
        i = i + 1;
    }
    ret opt[mink.trait.Trait].none{};
}

# a flag axis the builder states itself: set when the selection holds the requirement, clear otherwise
# ---
# axis:     the flag axis
# requires: the alternatives of extensions that turn it on, as risc-v's rvc is on with c or zca
pub rec Derivation {
    axis:     *mink.trait.Axis;
    requires: requirement.Requirement;
}

# derivations as a pointer to static rows and a count
pub rec Derivations {
    at:  *Derivation;
    len: u32;
}

# the derivations of a set whose traits are all the caller's
pub val NO_DERIVATIONS: Derivations = Derivations{at: nil, len: 0};

# how many bytes the code at `at` of the `len` bytes at `data` takes by the set's length encoding alone, at least one
# and at most the bytes left, as risc-v reads it from the low bits of the first parcel, x86 takes one byte and aarch64
# four, so undecodable code is printed in the units the hardware steps over and decoding resumes where it would
pub def Parcel: fun(*u8, usize, usize) usize;

# the registration record of one instruction set
# ---
# arches:     the architectures it serves, as riscv64 and riscv32 share one set
# modes:      the mode extension each architecture it serves stands for, a row for every one, which a selection must
#             hold to build for it
# codec:      its field table, register file, rows and decode dispatch
# extensions: its extension catalog, levels and selection syntax
# bindings:   its fixup kinds bound to mink's relocation kinds
# relax:      its relaxation rows
# compress:   its compressions, which the builder applies to every instruction the selection admits a shorter form of
# fill:       its code fill, nil for a set that never pads code, as spir-v and wasm
# realign:    the marker fixup kind of code alignment the linker may shrink, after an instruction it may resize,
#             operand.NO_FIXUP for a set whose linker never resizes code
# data:       the fixup kind of each datum basis and width it relocates
# spans:      its fixup kinds whose relocation covers instructions after the one it rides on
# syntaxes:   its assembly syntaxes, its established one first and the default
# supplied:   the trait axes a caller must state to build an object, as risc-v's float ABI, which is a convention fact the
#             builder cannot know. none for a set that asks for none, as x86
# derived:    the flag axes the builder states from the selection
# options:    how assembler options spell the traits it requires of a caller
# assembly:   the modes it reads its source under, as risc-v's pic, which are no fact of the object
# pairs:      the fixup kinds of a difference of labels across code the linker may resize, per width
# source:     its assembly source dialect
# parcel:     how many bytes the code at an offset takes by the set's length encoding alone, which a disassembler prints
#             as data when no row decodes it. nil for a set that states none, whose code is not disassembled
pub rec Set {
    arches:     Arches;
    modes:      Modes;
    codec:      *walk.Codec;
    extensions: *extension.Catalog;
    bindings:   Bindings;
    relax:      relax.Relaxations;
    compress:   compress.Compressions;
    fill:       *Fill;
    realign:    operand.FixupKind;
    data:       Data;
    spans:      Spans;
    syntaxes:   spelling.Syntaxes;
    supplied:   Axes;
    derived:    Derivations;
    options:    Spellings;
    assembly:   mode.Modes;
    pairs:      Pairs;
    source:     Source;
    parcel:     Parcel;
}

# registered sets, each held by pointer
pub rec Registry {
    sets:  **Set;
    count: u32;
}

# the set of `registry` serving `arch`
pub fun find(registry: *Registry, arch: *mink.arch.Arch) opt[*Set] {
    var i: u32 = 0;
    for (i < registry.count) {
        val s: *Set = registry.sets[i];
        var j: u32  = 0;
        for (j < s.arches.len) {
            if (s.arches.at[j] == arch) { ret opt[*Set].some{s}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret opt[*Set].none{};
}

# two sets for the test below, read by architecture only
#[testing]
val T_RISCV: [2]*mink.arch.Arch = [2]*mink.arch.Arch{?mink.arch.RISCV64, ?mink.arch.RISCV32};

#[testing]
val T_WASM: [1]*mink.arch.Arch = [1]*mink.arch.Arch{?mink.arch.WASM32};

#[testing]
val T_SETS: [2]Set = [2]Set{
    Set{arches: Arches{at: ?T_RISCV[0], len: 2}, codec: nil, extensions: nil, bindings: NO_BINDINGS, relax: relax.NONE, compress: compress.NONE, fill: nil, realign: operand.NO_FIXUP, data: NO_DATA, spans: NO_SPANS, syntaxes: spelling.NO_SYNTAXES, supplied: NO_AXES, derived: NO_DERIVATIONS},
    Set{arches: Arches{at: ?T_WASM[0], len: 1}, codec: nil, extensions: nil, bindings: NO_BINDINGS, relax: relax.NONE, compress: compress.NONE, fill: nil, realign: operand.NO_FIXUP, data: NO_DATA, spans: NO_SPANS, syntaxes: spelling.NO_SYNTAXES, supplied: NO_AXES, derived: NO_DERIVATIONS},
};

#[testing]
val T_REGISTERED: [2]*Set = [2]*Set{?T_SETS[0], ?T_SETS[1]};

test find__lookup_by_architecture_returns_the_registered_set {
    val registry: Registry  = Registry{sets: ?T_REGISTERED[0], count: 2};
    val riscv32:  opt[*Set] = find(?registry, ?mink.arch.RISCV32);
    val wasm32:   opt[*Set] = find(?registry, ?mink.arch.WASM32);
    val x86_64:   opt[*Set] = find(?registry, ?mink.arch.X86_64);
    if (!(sel riscv32.some && riscv32.some == ?T_SETS[0])) { ret 1; }
    if (!(sel wasm32.some && wasm32.some == ?T_SETS[1]))   { ret 2; }
    if (!sel x86_64.none)                                  { ret 3; }
    ret 0;
}
