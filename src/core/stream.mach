# the state a typed stream keeps across its instructions, and the spelling of its stack types
#
# a machine set's instructions are read one at a time: what one means never
# turns on another. a typed stream's do. spir-v types a literal by the result
# type its id was defined with, so `OpConstant %int 5` writes the width
# `OpTypeInt` gave %int, and wasm numbers functions, globals, locals and
# memories in index spaces the module's earlier fields fill, and counts a
# branch's target by the structured blocks open around it. the set states how
# its stream keeps that as hooks, and a reader takes the stream's state from
# the context it reads under (`state.Context.stream`), so every reader of one
# stream sees what the instructions before it defined. a machine set states
# no hooks and its contexts no stream.
#
# a stack type is spelled by the set's type names, a type variable as `$` and
# its number, an operand's type as the template hole `<n>`, the function's
# results as `results` and the polymorphic stack as `...`, so a signature
# reads back from the text it prints. the last two are reserved, so no type
# name spells them.
#
# a typed stream's text states a module, never a section: spirv-as text has
# no section directive, and wat2wasm text is one module of fields. its object
# disassembles as the module its format builds from it (`Module`), which the
# format lays out from the object's sections in its own order and converts
# back to sections of the kinds and dispositions it gives them, so the text
# states neither the order nor the kinds, and it is held to that module.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use mink.base.fail.Fail;
use mink.bytes.sink.Sink;
use mink.model.object.Object;

use masc.core.diagnostic;
use masc.core.effect;
use masc.core.field;
use masc.core.inst;
use masc.core.state;

# a type of the set's own type language and its spelling, as wasm's i32 of code 0x7f
# ---
# code: the code `effect.TypeRef.fixed` holds
# name: its spelling
pub rec Name {
    code: u32;
    name: str;
}

# names as a pointer to static rows and a count
pub rec Names {
    at:  *Name;
    len: u32;
}

# how a set keeps the state of a typed stream. the state is the hooks' own, made by `make` and given to every other
# hook, and a reader reaches it through its context
# ---
# types:   the spellings of the set's stack types
# make:    a new state, of a stream that has not begun
# release: everything a state holds given back
# begin:   the state started on a new stream, as a spir-v module or a wasm function body, whose index spaces and labels
#          it keeps from then on
# observe: what instruction `ins` defines added to the state, after it is read or written: a spir-v id's type, a wasm
#          index space's entry or a structured block opened or closed. refused when the instruction breaks what the
#          stream holds, as a block closed that is not open
# width:   the width in bytes of a literal typed by id `id`, none for an id the stream has given no width
# space:   the entry `index` names in index space `space`, as its type's code, none for an index past the space's end
# arity:   how many values type `ref` of instruction `ins`'s signature stands for, popped when `pushed` is false, under
#          the state as the instructions before `ins` leave it: one for a fixed type or a variable, the types an
#          operand states, as a call's function type's params where popped and its results where pushed, a block
#          type's or a label's types, and the results of the function the stream is in. none for the polymorphic stack,
#          which stands for no count, and for an operand naming what the stream does not hold. nil for a stream whose
#          rows state no signature
# record:  the facts of the set's own that the object's format reads when it converts the neutral object, stated on
#          the object built from the stream, from its state and under the object's context: spir-v's id space and the
#          version its selection targets, or wasm's index spaces, whose entries name the sections and symbols the
#          object holds by then. refused when the object takes no such fact, and the object is then not handed over.
#          nil for a stream whose objects hold no facts of the set's, as a stream no builder writes
# ahead:   the text of one statement of the stream's source, every statement handed over before the first is read, so
#          the stream reads a statement by what the statements after it spell: spir-v's numbered ids, which no name
#          takes. refused when the state cannot hold what it sees. nil for a stream whose reading turns on nothing ahead
pub rec Hooks {
    types:   Names;
    make:    fun(*A.Allocator) res[ptr, A.Error];
    release: fun(*A.Allocator, ptr);
    begin:   fun(ptr);
    observe: fun(ptr, *inst.Inst) err[field.Refusal];
    width:   fun(ptr, u32) opt[u8];
    space:   fun(ptr, u16, u32) opt[u32];
    arity:   fun(ptr, *inst.Inst, effect.TypeRef, bool) opt[u32];
    record:  fun(ptr, *state.Context, *Object) err[Fail];
    ahead:   fun(ptr, View) err[str];
}

# how a dialect's text states an object of its format: as the one module the format builds from it. the format lays
# the object's sections out into the module in its own order, mink's logical layout for spir-v and the specification's
# section order for wasm, so the text follows it, and gives each section its kind and disposition again when it
# converts the module the text reads back to, so the text states neither. the object's sections are not one for one
# with the module, so the text is held to the module: the one the format builds from the object, and the one the text
# reads back to, must be the same
# ---
# stream:  the module as the one section of its whole instruction stream, the shape the set's builder makes of the
#          text: spir-v's instructions past its header. given the format's model of the module, it adds that section
#          and the target the module states to an empty object, answering where the stream starts in the bytes the
#          format writes of the module. the disassembler writes the section's statements as a machine set's and holds
#          each to the stream's bytes at its place, so the module the text reads back to is the one it was written from
# printed: the module's own text, which the set writes and reads back whole, as wasm's fields, held byte for byte to
#          the module the format writes
pub tag Module: u8 {
    stream:  fun(ptr, *Object) res[u64, Fail];
    printed: Printed;
}

# a module's own text
# ---
# print: the text of the format's model of a module onto the output, its instructions decoded under the context,
#        whose stream it begins and fills, refused with its reason
# read:  the bytes the format writes of the module the text of `len` bytes, whose first byte is at the position, reads
#        back to under the context, whose stream it begins and fills, refused where the text is or by the format
pub rec Printed {
    print: fun(ptr, *state.Context, *vector.Vector[u8]) err[str];
    read:  fun(*A.Allocator, *u8, usize, diagnostic.Position, *state.Context) res[Sink, Unread];
}

# why a module's text read back to no bytes
# ---
# text:    the text states no module of the format, refused where it does
# written: the format refused to write the module the text reads back to
pub tag Unread: u8 {
    text:    diagnostic.Diagnostic;
    written: Fail;
}

# the spelling of the polymorphic stack
pub val POLYMORPHIC: str = "...";

# the spelling of the results of the function the stream is in
pub val RESULTS: str = "results";

# whether `name` is a spelling the stack types reserve, which no type of a set's names may take
pub fun reserved(name: str) bool {
    ret str_equals(name, POLYMORPHIC) || str_equals(name, RESULTS);
}

# a type read from text, and how many bytes of it it covers
pub rec Read {
    ref: effect.TypeRef;
    len: usize;
}

# the name of code `code`, none for a code no name spells
fun name_of(names: *Names, code: u32) opt[str] {
    var i: u32 = 0;
    for (i < names.len) {
        if (names.at[i].code == code) { ret opt[str].some{names.at[i].name}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

fun put(out: *vector.Vector[u8], s: str) err[A.Error] {
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        val pushed: res[usize, A.Error] = vector.push[u8](out, s[i]);
        if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

fun put_number(out: *vector.Vector[u8], n: u8) err[A.Error] {
    var digits: [4]u8;
    var count:  usize = 0;
    var m:      u8    = n;
    for {
        digits[count] = '0' + m % 10;
        count         = count + 1;
        m             = m / 10;
        if (m == 0) { brk; }
    }
    for (count > 0) {
        count = count - 1;
        val pushed: res[usize, A.Error] = vector.push[u8](out, digits[count]);
        if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
    }
    ret err[A.Error].ok{};
}

# `ref` spelled onto `out` by `names`
# ---
# ret: false for a fixed type no name spells, `out` as it was
pub fun spell(names: *Names, ref: effect.TypeRef, out: *vector.Vector[u8]) res[bool, A.Error] {
    if (sel ref.fixed) {
        val named: opt[str] = name_of(names, ref.fixed);
        if (sel named.none) { ret res[bool, A.Error].ok{false}; }
        val put_: err[A.Error] = put(out, named.some);
        if (sel put_.err) { ret res[bool, A.Error].err{put_.err}; }
        ret res[bool, A.Error].ok{true};
    }
    if (sel ref.results) {
        val put_: err[A.Error] = put(out, RESULTS);
        if (sel put_.err) { ret res[bool, A.Error].err{put_.err}; }
        ret res[bool, A.Error].ok{true};
    }
    var lead:   str = POLYMORPHIC;
    var number: u8  = 0;
    var close:  str = "";
    if (sel ref.variable) {
        lead   = "$";
        number = ref.variable;
    }
    or (sel ref.operand) {
        lead   = "<";
        number = ref.operand;
        close  = ">";
    }
    val led: err[A.Error] = put(out, lead);
    if (sel led.err) { ret res[bool, A.Error].err{led.err}; }
    if (!sel ref.polymorphic) {
        val n: err[A.Error] = put_number(out, number);
        if (sel n.err) { ret res[bool, A.Error].err{n.err}; }
        val c: err[A.Error] = put(out, close);
        if (sel c.err) { ret res[bool, A.Error].err{c.err}; }
    }
    ret res[bool, A.Error].ok{true};
}

# `types` spelled onto `out`, a space between two, as `spell` spells each
fun spell_all(names: *Names, types: effect.Types, out: *vector.Vector[u8]) res[bool, A.Error] {
    var i: u32 = 0;
    for (i < types.len) {
        if (i > 0) {
            val gap: err[A.Error] = put(out, " ");
            if (sel gap.err) { ret res[bool, A.Error].err{gap.err}; }
        }
        val one: res[bool, A.Error] = spell(names, types.at[i], out);
        if (sel one.err) { ret one; }
        if (!one.ok)     { ret one; }
        i = i + 1;
    }
    ret res[bool, A.Error].ok{true};
}

# `sig` spelled onto `out` as `[pops] -> [pushes]`, each list as `spell_all` spells it
# ---
# ret: false for a fixed type no name spells, what was written so far left on `out`
pub fun spell_signature(names: *Names, sig: *effect.Signature, out: *vector.Vector[u8]) res[bool, A.Error] {
    val open: err[A.Error] = put(out, "[");
    if (sel open.err) { ret res[bool, A.Error].err{open.err}; }
    val pops: res[bool, A.Error] = spell_all(names, sig.pops, out);
    if (sel pops.err) { ret pops; }
    if (!pops.ok)     { ret pops; }
    val arrow: err[A.Error] = put(out, "] -> [");
    if (sel arrow.err) { ret res[bool, A.Error].err{arrow.err}; }
    val pushes: res[bool, A.Error] = spell_all(names, sig.pushes, out);
    if (sel pushes.err) { ret pushes; }
    if (!pushes.ok)     { ret pushes; }
    val close: err[A.Error] = put(out, "]");
    if (sel close.err) { ret res[bool, A.Error].err{close.err}; }
    ret res[bool, A.Error].ok{true};
}

fun digit(c: u8) bool {
    ret c >= '0' && c <= '9';
}

# a number read from text, and how many bytes of it it covers
rec Number {
    n:   u8;
    len: usize;
}

# the number of the digits at `text` from `at`, none when there are none or it passes 255
fun number_at(text: View, at: usize) opt[Number] {
    var n: u32   = 0;
    var i: usize = at;
    for (i < text.len && digit(text.data[i])) {
        n = n * 10 + (text.data[i] - '0')::u32;
        if (n > 255) { ret opt[Number].none{}; }
        i = i + 1;
    }
    if (i == at) { ret opt[Number].none{}; }
    ret opt[Number].some{Number{n: n::u8, len: i - at}};
}

# whether `text` holds `s` at `at`
fun spelled_at(text: View, at: usize, s: str) bool {
    val n: usize = str_len(s);
    if (at + n > text.len) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (text.data[at + i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `text` holds `s` at `at` as a whole type, ended by the text's end, a space or the list's `]`
fun word_at(text: View, at: usize, s: str) bool {
    val n: usize = str_len(s);
    ret spelled_at(text, at, s) && (at + n >= text.len || text.data[at + n] == ' ' || text.data[at + n] == ']');
}

# the type `text` spells from `at`, as `spell` writes it, the longest name the set's names hold where several start
# there. none when no spelling starts there
pub fun read(names: *Names, text: View, at: usize) opt[Read] {
    if (at >= text.len) { ret opt[Read].none{}; }
    val c: u8 = text.data[at];
    if (c == '$') {
        val n: opt[Number] = number_at(text, at + 1);
        if (sel n.none) { ret opt[Read].none{}; }
        ret opt[Read].some{Read{ref: effect.TypeRef.variable{n.some.n}, len: n.some.len + 1}};
    }
    if (c == '<') {
        val n: opt[Number] = number_at(text, at + 1);
        if (sel n.none) { ret opt[Read].none{}; }
        val end: usize = at + 1 + n.some.len;
        if (end >= text.len || text.data[end] != '>') { ret opt[Read].none{}; }
        ret opt[Read].some{Read{ref: effect.TypeRef.operand{n.some.n}, len: n.some.len + 2}};
    }
    if (spelled_at(text, at, POLYMORPHIC)) { ret opt[Read].some{Read{ref: effect.TypeRef.polymorphic{}, len: str_len(POLYMORPHIC)}}; }
    if (word_at(text, at, RESULTS))        { ret opt[Read].some{Read{ref: effect.TypeRef.results{}, len: str_len(RESULTS)}}; }
    var best: opt[Read] = opt[Read].none{};
    var i:    u32       = 0;
    for (i < names.len) {
        val name: str   = names.at[i].name;
        val n:    usize = str_len(name);
        if (word_at(text, at, name)) {
            var longer: bool = true;
            if (sel best.some) { longer = best.some.len < n; }
            if (longer)        { best = opt[Read].some{Read{ref: effect.TypeRef.fixed{names.at[i].code}, len: n}}; }
        }
        i = i + 1;
    }
    ret best;
}
