# assembler modes: how a set reads its source, apart from what it selects
#
# a mode is a setting the source is read under that is no fact of the
# object and no member of the selection, as risc-v's pic, rvc and relax,
# x86's code width or arm's instruction set. a set declares each as a row:
# its name, its values and the one it starts at, each value with the
# command line flag that chooses it. the builder holds the value of every
# mode of its set, which the caller's flags set before the first statement
# and a directive changes between statements, and a spelling or a row
# that holds only under some values names them as settings. a mode and a
# value are their rows, never their names or their places, so a spelling
# reads a mode by `holds` alone.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_equals;

# the most modes a set declares, so the value of every mode is held without storage of its own
pub val MAX_MODES: u32 = 8;

# one value of a mode
# ---
# name: its spelling in source, as risc-v's `pic` in `.option pic`
# flag: the command line flag that starts the source at it, as `--pic`, nil for none
# doc:  one line for the flag's help
pub rec Value {
    name: str;
    flag: str;
    doc:  str;
}

# values as a pointer to rows and a count
pub rec Values {
    at:  **Value;
    len: u32;
}

# one mode of a set
# ---
# name:    its name, as `pic`
# values:  every value it takes, at least two
# initial: the value the source starts at when no flag chooses one, one of `values`
pub rec Mode {
    name:    str;
    values:  Values;
    initial: *Value;
}

# a set's modes as a pointer to rows and a count, at most MAX_MODES
pub rec Modes {
    at:  **Mode;
    len: u32;
}

# the modes of a set that reads its source one way
pub val NO_MODES: Modes = Modes{at: nil, len: 0};

# a mode at one of its values
pub rec Setting {
    mode:  *Mode;
    value: *Value;
}

# settings as a pointer to rows and a count
pub rec Settings {
    at:  *Setting;
    len: u32;
}

# no settings: what holds under every value of every mode, and what a caller states that starts every mode at its
# initial value
pub val NONE: Settings = Settings{at: nil, len: 0};

# the value of every mode of one set
# ---
# modes:  the set's modes
# values: the value of each, in the order of `modes`
pub rec State {
    modes:  *Modes;
    values: [MAX_MODES]*Value;
}

# every mode of `modes` at its initial value
pub fun initial(modes: *Modes) State {
    var s: State;
    s.modes = modes;
    var i: u32 = 0;
    for (i < modes.len && i < MAX_MODES) {
        s.values[i] = modes.at[i].initial;
        i           = i + 1;
    }
    ret s;
}

# where `m` is among the modes of `s`, none when the set declares no such mode
fun slot(s: *State, m: *Mode) opt[u32] {
    var i: u32 = 0;
    for (i < s.modes.len) {
        if (s.modes.at[i] == m) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# whether `v` is a value of `m`
pub fun takes(m: *Mode, v: *Value) bool {
    var i: u32 = 0;
    for (i < m.values.len) {
        if (m.values.at[i] == v) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether every setting of `all` is the value `s` holds its mode at, true for NONE
pub fun holds(s: *State, all: Settings) bool {
    var i: u32 = 0;
    for (i < all.len) {
        val at: opt[u32] = slot(s, all.at[i].mode);
        if (sel at.none)                          { ret false; }
        if (s.values[at.some] != all.at[i].value) { ret false; }
        i = i + 1;
    }
    ret true;
}

# `s` with the mode of `to` at its value
# ---
# ret: whether the set declares the mode and the mode takes the value, `s` unchanged when not
pub fun change(s: *State, to: Setting) bool {
    val at: opt[u32] = slot(s, to.mode);
    if (sel at.none)               { ret false; }
    if (!takes(to.mode, to.value)) { ret false; }
    s.values[at.some] = to.value;
    ret true;
}

# the setting the flag `flag` chooses among `modes`, none when no value of theirs is chosen by it
pub fun flagged(modes: *Modes, flag: str) opt[Setting] {
    var i: u32 = 0;
    for (i < modes.len) {
        val m: *Mode = modes.at[i];
        var j: u32   = 0;
        for (j < m.values.len) {
            val v: *Value = m.values.at[j];
            if (v.flag != nil && str_equals(v.flag, flag)) { ret opt[Setting].some{Setting{mode: m, value: v}}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret opt[Setting].none{};
}

#[testing]
val T_OFF:     Value      = Value{name: "off", flag: "--no-on", doc: "off"};
#[testing]
val T_ON:      Value      = Value{name: "on", flag: "--on", doc: "on"};
#[testing]
val T_VALUES:  [2]*Value  = [2]*Value{?T_OFF, ?T_ON};
#[testing]
val T_MODE:    Mode       = Mode{name: "on", values: Values{at: ?T_VALUES[0], len: 2}, initial: ?T_OFF};
#[testing]
val T_OTHER:   Mode       = Mode{name: "other", values: Values{at: ?T_VALUES[0], len: 2}, initial: ?T_OFF};
#[testing]
val T_MODES:   [1]*Mode   = [1]*Mode{?T_MODE};
#[testing]
val T_WHEN_ON: [1]Setting = [1]Setting{Setting{mode: ?T_MODE, value: ?T_ON}};

test holds__a_setting_holds_only_at_its_value_and_a_flag_chooses_it {
    var modes: Modes    = Modes{at: ?T_MODES[0], len: 1};
    var s:     State    = initial(?modes);
    val on:    Settings = Settings{at: ?T_WHEN_ON[0], len: 1};
    if (!holds(?s, NONE)) { ret 1; }
    if (holds(?s, on))    { ret 2; }
    val chosen: opt[Setting] = flagged(?modes, "--on");
    if (sel chosen.none)          { ret 3; }
    if (!change(?s, chosen.some)) { ret 4; }
    if (!holds(?s, on))           { ret 5; }
    # a mode the set does not declare is neither changed nor held
    if (change(?s, Setting{mode: ?T_OTHER, value: ?T_OFF})) { ret 6; }
    val unknown: opt[Setting] = flagged(?modes, "--pic");
    if (sel unknown.some) { ret 7; }
    ret 0;
}
