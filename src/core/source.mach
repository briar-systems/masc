# the facts of the gnu assembler's source dialect of a set's targets, which every syntax of the set shares
#
# how `.align` reads its operand, the integer data directives and their
# widths, and the directives that edit what the statements after them are
# read under, state traits of the object or state an instruction by its
# encoding, each a row of a name, its operands and its edit. a dialect's
# directives are data: the assembler reads every row the same way, and the
# listing and the disassembler restate a statement's view, state and syntax
# by the rows that make it, so a dialect is added by its rows alone. a
# dialect that states none of a kind has its NO_ row.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;

use masc.core.inst;
use masc.core.mode;
use masc.core.requirement;
use masc.core.row;
use masc.core.state;

# how `.align` reads its operand, which the gnu assembler reads per target
# ---
# ALIGN_BYTES: a boundary in bytes, as on x86
# ALIGN_POWER: a power of two, as on risc-v and aarch64
pub def AlignBy: u8;

pub val ALIGN_BYTES: AlignBy = 0;
pub val ALIGN_POWER: AlignBy = 1;

# an integer data directive and the width of each value it writes, as `.word`, whose width differs per target
# ---
# name:  the directive, its leading dot included
# width: its width in bytes, 1 to MAX_WIDTH
pub rec Width {
    name:  str;
    width: u8;
}

# widths as a pointer to static rows and a count
pub rec Widths {
    at:  *Width;
    len: u32;
}

# a format of the source dialect's instruction directive, as risc-v's `.insn r`: an encoding the source states field by
# field, which is no row of the set's catalog, and which the builder writes as an instruction of its own kind
# ---
# template: its text after the directive in the syntax's template language, its name first, as
#           `r <0>, <1>, <2>, <3>, <4>, <5>`, or a raw form's length, as `4, <0>`
# row:      its operands and encoding over the codec's field kinds. nothing states what such an encoding does, so its
#           effect is the set's opaque one, which may read and write every register, memory and control, and its
#           constant-time class is dependent
# length:   for a raw form, whose one operand is the whole encoding, the length that encoding has by the set's length
#           encoding (`Insns.length`), and 0 for a format of fields
pub rec Format {
    template: str;
    row:      *row.Row;
    length:   u8;
}

# formats as a pointer to static rows and a count
pub rec Formats {
    at:  *Format;
    len: u32;
}

# the length in bytes the `len` bytes at `data`, the start of an encoding, state by a set's length encoding, 0 when they
# state none a raw form takes, as risc-v's reserved encodings longer than 64 bits
pub def Length: fun(*u8, usize) usize;

# what the instruction directive of a source dialect reads, as risc-v's `.insn`. a statement of it is read by whichever
# one format takes its text whole, and a lone constant by the raw form of the length the set's length encoding gives it.
# a raw form's encoding must state the length the form has
# ---
# formats: its formats
# length:  the length an encoding states, nil for a dialect with no raw form
pub rec Insns {
    formats: Formats;
    length:  Length;
}

# the instructions of a dialect that states none by its encoding
pub val NO_INSNS: Insns = Insns{formats: Formats{at: nil, len: 0}, length: nil};

# what a directive reads after its name and its word
# ---
# TAKES_NOTHING:   nothing, as `.option norvc` or `.code64`
# TAKES_SELECTION: a comma and a selection, whole in the set's selection syntax or as a list of `+name` and `-name`
#                  edits of the one in force, as `.option arch, rv64gc` or `.option arch, +zbb, -c`
# TAKES_ATTRIBUTE: a tag by name or number, a comma and its value, a string for a text axis and a number otherwise, as
#                  `.attribute stack_align, 16`
# TAKES_ENCODING:  an instruction by its encoding in one of its edit's formats, as `.insn r 0x33, 0, 0, a0, a1, a2`
pub def Takes: u8;

pub val TAKES_NOTHING:   Takes = 0;
pub val TAKES_SELECTION: Takes = 1;
pub val TAKES_ATTRIBUTE: Takes = 2;
pub val TAKES_ENCODING:  Takes = 3;

# the operands of a directive
# ---
# word:  the word that chooses this row among the rows of its name, as `norvc` of `.option`, empty when the name says it
#        whole, as `.code64` or `.attribute`
# takes: what it reads after the word
pub rec Shape {
    word:  str;
    takes: Takes;
}

# what a directive does to the statements after it, or to the object
# ---
# narrow:    removes these extensions, each with every member that implies it, from the selection in force, so it stays
#            closed, as `.option norvc` removes zca and every compressed extension with it. the narrowings in force are
#            undone together by `pop`, a `restate` or a `widen` of what they remove
# widen:     adds these extensions, with what they imply, to the selection in force, and lifts every narrowing in force
#            that would take one of them away, as `.option rvc` adds c and lifts norvc
# restate:   states the selection whole, or as edits of the one in force, with no narrowing in force over it
# state:     sets an axis the set switches within an object to a value, as x86's `.code32` sets its width
# mode:      chooses a value of an assembler mode, as `.option pic`
# syntax:    reads the statements after it in the set's syntax of this index, as x86's `.intel_syntax`
# push:      saves the selection, narrowings, state, modes and syntax in force
# pop:       restores the ones saved last
# raw:       states an instruction by its encoding, as `.insn`
# attribute: states a trait of the object by the object format's attribute tag (`mink.registry.attribute`), as
#            `.attribute`
pub tag Edit: u8 {
    narrow: requirement.Ids;
    widen:  requirement.Ids;
    restate;
    state:  state.Placed;
    mode:   mode.Setting;
    syntax: u8;
    push;
    pop;
    raw: Insns;
    attribute;
}

# a directive of the source dialect by its name, its operands and its edit, the one row a statement of it reads by. the
# rows of one name are told apart by their words
# ---
# name:     the directive, its leading dot included
# operands: what it reads
# edit:     what it does
pub rec Directive {
    name:     str;
    operands: Shape;
    edit:     Edit;
}

# directives as a pointer to static rows and a count, at most MAX_DIRECTIVES
pub rec Directives {
    at:  *Directive;
    len: u32;
}

# the directives of a dialect that states none
pub val NO_DIRECTIVES: Directives = Directives{at: nil, len: 0};

# the most directives a dialect states, so the narrowings in force are one bit each of a mask by the row's index
pub val MAX_DIRECTIVES: u32 = 64;

# the bit of directive `i` in a mask of the narrowings in force
pub fun bit(i: u32) u64 {
    ret 1::u64 << i::u64;
}

# the instructions the dialect states by their encoding: those of its raw directive, none for a dialect with none
pub fun insns(ds: Directives) *Insns {
    var i: u32 = 0;
    for (i < ds.len) {
        if (sel ds.at[i].edit.raw) { ret ?ds.at[i].edit.raw; }
        i = i + 1;
    }
    ret ?NO_INSNS;
}

# the directive of `ds` that saves what is in force, none for a dialect with no stack
pub fun push_of(ds: Directives) opt[*Directive] {
    var i: u32 = 0;
    for (i < ds.len) {
        if (sel ds.at[i].edit.push) { ret opt[*Directive].some{?ds.at[i]}; }
        i = i + 1;
    }
    ret opt[*Directive].none{};
}

# the directive of `ds` that restores what its push saved, none for a dialect with no stack
pub fun pop_of(ds: Directives) opt[*Directive] {
    var i: u32 = 0;
    for (i < ds.len) {
        if (sel ds.at[i].edit.pop) { ret opt[*Directive].some{?ds.at[i]}; }
        i = i + 1;
    }
    ret opt[*Directive].none{};
}

# the directive of `ds` that restates the selection, none for a dialect with none
pub fun restate_of(ds: Directives) opt[*Directive] {
    var i: u32 = 0;
    for (i < ds.len) {
        if (sel ds.at[i].edit.restate) { ret opt[*Directive].some{?ds.at[i]}; }
        i = i + 1;
    }
    ret opt[*Directive].none{};
}

# the directive of `ds` that states an instruction by its encoding, none for a dialect with none
pub fun raw_of(ds: Directives) opt[*Directive] {
    var i: u32 = 0;
    for (i < ds.len) {
        if (sel ds.at[i].edit.raw) { ret opt[*Directive].some{?ds.at[i]}; }
        i = i + 1;
    }
    ret opt[*Directive].none{};
}

# the directive of `ds` that states traits by attribute tag, none for a dialect with none
pub fun attribute_of(ds: Directives) opt[*Directive] {
    var i: u32 = 0;
    for (i < ds.len) {
        if (sel ds.at[i].edit.attribute) { ret opt[*Directive].some{?ds.at[i]}; }
        i = i + 1;
    }
    ret opt[*Directive].none{};
}

# the directive of `ds` that reads the statements after it in syntax `k`, none for a dialect with none
pub fun syntax_of(ds: Directives, k: u8) opt[*Directive] {
    var i: u32 = 0;
    for (i < ds.len) {
        val e: Edit = ds.at[i].edit;
        if (sel e.syntax && e.syntax == k) { ret opt[*Directive].some{?ds.at[i]}; }
        i = i + 1;
    }
    ret opt[*Directive].none{};
}

# the directive of `ds` that sets axis `axis` to value `value`, none for a dialect with none
pub fun state_of(ds: Directives, axis: u32, value: u8) opt[*Directive] {
    var i: u32 = 0;
    for (i < ds.len) {
        val e: Edit = ds.at[i].edit;
        if (sel e.state && (e.state.axis == axis && e.state.value == value)) { ret opt[*Directive].some{?ds.at[i]}; }
        i = i + 1;
    }
    ret opt[*Directive].none{};
}

# directive `d` spelled as a statement starts, its name and its word, onto `out`
pub fun spell(d: *Directive, out: *vector.Vector[u8]) err[A.Error] {
    val named: err[A.Error] = append(out, d.name);
    if (sel named.err)                                     { ret named; }
    if (d.operands.word == nil || d.operands.word[0] == 0) { ret named; }
    val gap: err[A.Error] = append(out, " ");
    if (sel gap.err) { ret gap; }
    ret append(out, d.operands.word);
}

fun append(out: *vector.Vector[u8], s: str) err[A.Error] {
    var i: usize = 0;
    for (s[i] != 0) {
        val pushed: res[usize, A.Error] = vector.push[u8](out, s[i]);
        if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# the mapping symbols of a dialect, which mark where code and data start in a section, as aarch64's `$x` and `$d`
# ---
# code:     the stem of the symbol that marks code, empty for a dialect with none
# data:     the stem of the symbol that marks data
# per_view: whether a code symbol names the selection the code is written under after its stem, as risc-v's
#           `$xrv64i2p1_c2p0` may
pub rec Mapping {
    code:     str;
    data:     str;
    per_view: bool;
}

# the mapping of a dialect that marks nothing
pub val NO_MAPPING: Mapping = Mapping{code: "", data: "", per_view: false};

# the facts of the gnu assembler's source dialect of a set's targets, which every syntax of the set shares
# ---
# comment:    the text that starts a comment running to the end of its line, as `#` or `//`
# separator:  the character that ends a statement within a line, as `;`
# types:      the characters that may prefix a type's spelling in `.type` and `.section`, as `@` or `%`
# align:      how `.align` reads its operand
# widths:     the integer data directives and their widths
# directives: its directives that edit the selection, state, modes or syntax in force, or state the object's traits or
#             an instruction by its encoding
# mapping:    its mapping symbols
# widens:     the extensions an instruction adds to the selection in force once it is written, as a `widen` edit adds
#             them, as spir-v's `OpCapability Shader` and `OpExtension` widen the view the instructions after them are
#             read under. the empty list for one that widens nothing. nil for a dialect whose instructions widen nothing,
#             as every machine set's
pub rec Source {
    comment:    str;
    separator:  u8;
    types:      str;
    align:      AlignBy;
    widths:     Widths;
    directives: Directives;
    mapping:    Mapping;
    widens:     Widens;
}

# the extensions an instruction widens the selection in force by, static, the empty list for none
pub def Widens: fun(*inst.Inst) requirement.Ids;
