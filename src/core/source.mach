# the facts of the gnu assembler's source dialect of a set's targets, which every syntax of the set shares
#
# how `.align` reads its operand, the integer data directives and their
# widths, how the dialect narrows or restates the selection a statement is
# written under, how it states traits of the object by tag and how it states
# an instruction by its encoding. a dialect that states none of a kind has
# its NO_ row.

use std.types.size.usize;
use std.types.string.str;

use mink;

use masc.core.requirement;
use masc.core.row;

# how `.align` reads its operand, which the gnu assembler reads per target
# ---
# ALIGN_BYTES: a boundary in bytes, as on x86
# ALIGN_POWER: a power of two, as on risc-v and aarch64
pub def AlignBy: u8;

pub val ALIGN_BYTES: AlignBy = 0;
pub val ALIGN_POWER: AlignBy = 1;

# an integer data directive and the width of each value it writes, as `.word`, whose width differs per target
# ---
# name:  the directive, its leading dot included
# width: its width in bytes, 1 to MAX_WIDTH
pub rec Width {
    name:  str;
    width: u8;
}

# widths as a pointer to static rows and a count
pub rec Widths {
    at:  *Width;
    len: u32;
}

# a narrowing of the selection the source dialect states for the statements after it, as risc-v's `.option norvc` keeps
# them full length
# ---
# narrow:  the operand of the form directive that narrows, as `norvc`
# lift:    the operand that lifts it again, as `rvc`
# removes: the extensions it removes, each with every member that implies it, so the selection stays closed, as zca
#          takes c and the rest of zc* with it
# lifted:  the extension `lift` states the selection holds, as `rvc` states c. a narrowing lifts back to the object's
#          selection and never widens it, so `lift` is refused when the object's selection does not hold this
pub rec Narrowing {
    narrow:  str;
    lift:    str;
    removes: requirement.Ids;
    lifted:  requirement.Id;
}

# narrowings as a pointer to static rows and a count, at most MAX_NARROWINGS
pub rec Narrowings {
    at:  *Narrowing;
    len: u32;
}

# the most narrowings a dialect states, one bit each of the narrowing in force
pub val MAX_NARROWINGS: u32 = 64;

# how the source dialect states the selection a statement is written under, which chooses its form among the encodings
# the selection admits. the selection is only ever narrowed from the object's, so what the object states as a whole,
# as its derived traits, is the object's selection's
# ---
# directive:  the directive whose one operand names what it does, as risc-v's `.option`, empty for a dialect with none
# push:       the operand that saves the narrowing in force, as `push`, empty for a dialect with no stack of them
# pop:        the operand that restores the one saved last, as `pop`, empty exactly when `push` is
# narrowings: what its other operands narrow. an operand spelled as a value of one of the set's modes, as `pic`, chooses
#             that value for the statements after it, and push and pop save and restore the modes with the narrowings
# restates:   the operand that restates the selection for the statements after it, as risc-v's `arch`, empty for a
#             dialect with none. after a comma it takes a whole selection in the set's selection syntax, or a list of
#             edits of the selection in force, `+name` adding an extension and `-name` removing one. the selection it
#             states holds nothing the object's does not, and the narrowings narrow it from then on, none in force
#             until one is stated again. push and pop save and restore it with the narrowings
pub rec Forms {
    directive:  str;
    push:       str;
    pop:        str;
    narrowings: Narrowings;
    restates:   str;
}

# the forms of a dialect that states none
pub val NO_FORMS: Forms = Forms{directive: "", push: "", pop: "", narrowings: Narrowings{at: nil, len: 0}, restates: ""};

# the directive that states traits of the object by attribute, as risc-v's `.attribute`. its tags are the object
# format's, by name or number (`mink.registry.attribute`), and a tag's value is a string when its axis is text and a
# number otherwise, a flag's 0 or 1
# ---
# directive: its name, empty for a dialect with none
pub rec Attributes {
    directive: str;
}

# the attributes of a dialect that states none
pub val NO_ATTRIBUTES: Attributes = Attributes{directive: ""};

# a format of the source dialect's instruction directive, as risc-v's `.insn r`: an encoding the source states field by
# field, which is no row of the set's catalog, and which the builder writes as an instruction of its own kind
# ---
# template: its text after the directive in the syntax's template language, its name first, as
#           `r <0>, <1>, <2>, <3>, <4>, <5>`, or a raw form's length, as `4, <0>`
# row:      its operands and encoding over the codec's field kinds. nothing states what such an encoding does, so its
#           effect is the set's opaque one, which may read and write every register, memory and control, and its
#           constant-time class is dependent
# length:   for a raw form, whose one operand is the whole encoding, the length that encoding has by the set's length
#           encoding (`Insns.length`), and 0 for a format of fields
pub rec Format {
    template: str;
    row:      *row.Row;
    length:   u8;
}

# formats as a pointer to static rows and a count
pub rec Formats {
    at:  *Format;
    len: u32;
}

# the length in bytes the `len` bytes at `data`, the start of an encoding, state by a set's length encoding, 0 when they
# state none a raw form takes, as risc-v's reserved encodings longer than 64 bits
pub def Length: fun(*u8, usize) usize;

# the instruction directive of a source dialect, as risc-v's `.insn`. a statement of it is read by whichever one format
# takes its text whole, and a lone constant by the raw form of the length the set's length encoding gives it. a raw
# form's encoding must state the length the form has
# ---
# directive: its name, empty for a dialect with none
# formats:   its formats
# length:    the length an encoding states, nil for a dialect with no raw form
pub rec Insns {
    directive: str;
    formats:   Formats;
    length:    Length;
}

# the instruction directive of a dialect that states none
pub val NO_INSNS: Insns = Insns{directive: "", formats: Formats{at: nil, len: 0}, length: nil};

# the facts of the gnu assembler's source dialect of a set's targets, which every syntax of the set shares
# ---
# comment:    the text that starts a comment running to the end of its line, as `#` or `//`
# separator:  the character that ends a statement within a line, as `;`
# types:      the characters that may prefix a type's spelling in `.type` and `.section`, as `@` or `%`
# align:      how `.align` reads its operand
# widths:     the integer data directives and their widths
# forms:      how it narrows the selection a statement is written under
# attributes: how it states traits of the object by tag
# insns:      how it states an instruction by its encoding
pub rec Source {
    comment:    str;
    separator:  u8;
    types:      str;
    align:      AlignBy;
    widths:     Widths;
    forms:      Forms;
    attributes: Attributes;
    insns:      Insns;
}
