# who states each trait of a set's objects, and the traits its caller states
#
# a set states for each trait axis of its architectures whether the builder
# derives it from the selection, the caller states it or the set fixes it,
# and how assembler options spell the traits its caller states.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mink;

use masc.core.requirement;

# the traits a caller states, as a pointer to rows and a count
pub rec Traits {
    at:  *mink.trait.Trait;
    len: u32;
}

# the traits of a caller with none to state
pub val NO_TRAITS: Traits = Traits{at: nil, len: 0};

# a value the set states on every object, and the reference whose objects state it so
# ---
# setting: the value
# cites:   the reference, as `llvm-mc 23.1.1 writes no GNU property note`
pub rec Fixed {
    setting: mink.trait.Setting;
    cites:   str;
}

# who states an axis on every object of the set
# ---
# selection: the builder, from the selection and state the caller builds the object under: a flag set when they meet
#            the requirement and clear otherwise, as risc-v's tso is set with ztso
# derived:   the builder, from every view the object's statements were written under, the caller's among them: a flag
#            set when their union meets the requirement, as risc-v's rvc is set with c or zca where an `.option arch`
#            turns either on for a stretch of code
# caller:    the caller, at the builder's construction, as a convention fact the builder cannot know, as risc-v's float
#            abi `-mabi` states
# fixed:     the set, one value on every object, as no statement of the source or the caller decides it
pub tag Owner: u8 {
    selection: requirement.Requirement;
    derived:   requirement.Requirement;
    caller;
    fixed: Fixed;
}

# a trait axis of the set's architectures and who states it
pub rec Owned {
    axis:  *mink.trait.Axis;
    owner: Owner;
}

# owned axes as a pointer to static rows and a count
pub rec Owners {
    at:  *Owned;
    len: u32;
}

# the owners of a set whose objects state no trait
pub val NO_OWNERS: Owners = Owners{at: nil, len: 0};

# whether a format an object of `arch` is written in cannot leave `x` unstated, so every object states it, as
# `formats` answers it. ELF's e_flags and GNU property flags read back clear when no bit is set, and its attributes may
# be left out. mink keeps trait rows for ELF alone
# ---
# a: allocator of the encodings listed, given back before it returns
pub fun encoded(formats: *mink.registry.Registry, a: *A.Allocator, arch: *mink.arch.Arch, x: *mink.trait.Axis) res[bool, mink.fail.Fail] {
    val code: opt[*mink.arch.Code] = mink.arch.code(arch, ?mink.format.ELF);
    if (sel code.none) { ret res[bool, mink.fail.Fail].ok{false}; }
    var rows:   mink.table.Table[mink.contract.Encoded] = mink.table.make[mink.contract.Encoded](a);
    val listed: err[mink.fail.Fail]                     = mink.registry.encodes(formats, ?mink.format.ELF, arch, ?rows);
    var found:  bool                                    = false;
    var i:      usize                                   = 0;
    for (!sel listed.err && i < mink.table.count[mink.contract.Encoded](?rows)) {
        val e: *mink.contract.Encoded = mink.table.at[mink.contract.Encoded](?rows, mink.table.nth[mink.contract.Encoded](i));
        if (e.axis == x) { found = e.required; }
        i = i + 1;
    }
    val released: err[mink.fail.Fail] = mink.table.release[mink.contract.Encoded](?rows);
    if (sel listed.err)   { ret res[bool, mink.fail.Fail].err{listed.err}; }
    if (sel released.err) { ret res[bool, mink.fail.Fail].err{released.err}; }
    ret res[bool, mink.fail.Fail].ok{found};
}

# whether a format an object of `arch` is written in holds the object's traits in the section named `name`, as
# `formats` answers it: ELF's GNU property note and its architecture's build attributes, so what it holds is the
# traits' and never the source's
pub fun holds_traits(formats: *mink.registry.Registry, arch: *mink.arch.Arch, name: str) res[bool, mink.fail.Fail] {
    val code: opt[*mink.arch.Code] = mink.arch.code(arch, ?mink.format.ELF);
    if (sel code.none) { ret res[bool, mink.fail.Fail].ok{false}; }
    ret mink.registry.holds_traits(formats, ?mink.format.ELF, arch, mink.store.Bytes{data: name, len: str_len(name)});
}

# an assembler option's spelling of a trait the set requires of its caller, as risc-v's `-mabi=lp64d` states the double
# float abi
# ---
# option: the option, as `-mabi`
# value:  its value, as `lp64d`
# trait:  the trait it states
pub rec Stated {
    option: str;
    value:  str;
    trait:  mink.trait.Trait;
}

# option spellings as a pointer to static rows and a count
pub rec Spellings {
    at:  *Stated;
    len: u32;
}

# the option spellings of a set that requires no trait of its caller
pub val NO_SPELLINGS: Spellings = Spellings{at: nil, len: 0};
