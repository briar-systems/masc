# how a set states the trait axes of its objects that it derives
#
# mink's catalog classes each trait axis by who states it (mink.trait.Owner).
# a convention axis takes its value from the abi row the caller names, as
# risc-v's float abi from `-mabi=lp64d`, and a fixed axis from the
# architecture row. a set holds the mapping of the classes it derives itself:
# the extensions that set a selection axis, the union of views that sets a
# derived one, and the value a source axis holds where the source states none.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mink.base.fail;
use mink.base.store;
use mink.base.table;
use mink_arch:   mink.catalog.arch;
use mink_format: mink.catalog.format;
use mink.catalog.trait;
use mink.format.contract;
use mink.format.registry;

use masc.core.requirement;

# how the selection sets a selection axis
# ---
# flag:    set when the selection meets the requirement and clear otherwise, as risc-v's tso is set with ztso
# spelled: the selection's own spelling in the set's syntax with each member's revision, a text, as risc-v's arch
pub tag Selected: u8 {
    flag: requirement.Requirement;
    spelled;
}

# the value a source axis holds where the source states none, and the reference whose objects hold it
# ---
# setting: the value
# cites:   the reference, as `llvm-mc 23.1.1 writes no GNU property note`
pub rec Default {
    setting: trait.Setting;
    cites:   str;
}

# how the set derives an axis of the class it is of
# ---
# selection: an axis of mink's selection class, from the selection the caller builds the object under
# derived:   an axis of mink's derived class, a flag set when the union of every view the object's statements were
#            written under meets the requirement, as risc-v's rvc is set with c or zca where an `.option arch` turns
#            either on for a stretch of code
# source:    an axis of mink's source class, its value where the source states none
# unwritten: an axis of any class the set derives that every object leaves unstated, as the reference's objects leave
#            it, the reference its citation, as x86's gnu property axes under `llvm-mc 23.1.1 writes no GNU property
#            note`. the source states none of it either
pub tag Owner: u8 {
    selection: Selected;
    derived:   requirement.Requirement;
    source:    Default;
    unwritten: str;
}

# a trait axis of the set's architectures and how the set derives it
pub rec Owned {
    axis:  *trait.Axis;
    owner: Owner;
}

# owned axes as a pointer to static rows and a count
pub rec Owners {
    at:  *Owned;
    len: u32;
}

# the owners of a set that derives no trait
pub val NO_OWNERS: Owners = Owners{at: nil, len: 0};

# whether mapping `o` maps an axis of mink's owner class `c`
pub fun of_class(o: Owner, c: trait.Owner) bool {
    if (sel o.unwritten) { ret !sel c.convention && !sel c.fixed; }
    if (sel o.selection) { ret sel c.selection; }
    if (sel o.derived)   { ret sel c.derived; }
    ret sel c.source;
}

# the axes format `format` encodes for `arch`, each with whether an object must state it, as `formats` answers it,
# appended to `out`. a format that encodes no traits is refused naming it, never read as encoding none
pub fun encodes(formats: *registry.Registry, format: *mink_format.Format, arch: *mink_arch.Arch, out: *table.Table[contract.Encoded]) err[fail.Fail] {
    ret registry.encodes(formats, format, arch, out);
}

# whether `rows`, a format's encodings, require an object to state `x`
pub fun required(rows: *table.Table[contract.Encoded], x: *trait.Axis) bool {
    var i: usize = 0;
    for (i < table.count[contract.Encoded](rows)) {
        val e: *contract.Encoded = table.at[contract.Encoded](rows, table.nth[contract.Encoded](i));
        if (e.axis == x) { ret e.required; }
        i = i + 1;
    }
    ret false;
}

# whether format `format` holds the traits of an object for `arch` in the section named `name`, as elf's GNU property
# note and its architecture's build attributes, so what it holds is the traits' and never the source's
pub fun holds_traits(formats: *registry.Registry, format: *mink_format.Format, arch: *mink_arch.Arch, name: str) res[bool, fail.Fail] {
    ret registry.holds_traits(formats, format, arch, store.Bytes{data: name, len: str_len(name)});
}

# the axis of `arch` the attribute `tag` names in format `format`, none when it names none
pub fun attribute(formats: *registry.Registry, format: *mink_format.Format, arch: *mink_arch.Arch, tag: contract.Tag) res[opt[*trait.Axis], fail.Fail] {
    ret registry.attribute(formats, format, arch, tag);
}

# the setting abi row `abi` states on `x`, none when it states none or there is no row
pub fun convention(abi: *mink_arch.Abi, x: *trait.Axis) opt[trait.Setting] {
    if (abi == nil) { ret opt[trait.Setting].none{}; }
    var i: usize = 0;
    for (i < abi.count) {
        if (abi.settings[i].axis == x) { ret opt[trait.Setting].some{abi.settings[i].setting}; }
        i = i + 1;
    }
    ret opt[trait.Setting].none{};
}

# the abi row of `arch` named `name`, nil for none
#[testing]
pub fun t_abi(arch: *mink_arch.Arch, name: str) *mink_arch.Abi {
    val row: opt[*mink_arch.Abi] = mink_arch.abi(arch, name);
    if (sel row.none) { ret nil; }
    ret row.some;
}
