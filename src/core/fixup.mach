# the fixups of an instruction set past its operands' own: how its fixup kinds bind to mink's relocation kinds, the
# kinds no format relocates, the kinds its data and its label differences take, the kinds whose relocation covers a
# sequence or carries a marker, and how an immediate's pc-relative kind folds into a number
#
# a set-local fixup kind becomes a neutral relocation kind through its
# binding, or is local, a distance the builder writes only when it knows it. a datum's kind is chosen by its basis and width, a difference of
# two labels across code the linker may resize by its encoding and width, a span names
# the instructions one relocation covers and the marker that rides beside
# it under the assembler modes it states, and a fold states the number an
# immediate holds for a distance the builder knows.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use mink_arch:   mink.catalog.arch;
use mink_format: mink.catalog.format;
use mink.model.reloc;

use masc.core.mode;
use masc.core.operand;

# a set-local fixup kind and the neutral relocation kind it becomes on some architectures. a kind is bound once, or
# once per architecture where its relocation differs by architecture, as x86's `@PLT` is R_X86_64_PLT32 on x86_64 and
# R_386_PLT32 on i386, so no two of its bindings name one architecture
# ---
# fixup:   the set-local kind
# kind:    the row of mink's relocation kinds it maps to
# arches:  the architectures of the set it is bound on, EVERY_ARCH for every one, as x86's sign-extended 32-bit field
#          is bound on x86_64 alone, the one architecture whose formats relocate it. on any other the kind is unbound,
#          so an instruction that takes it there is refused
# added:   the kind written in its place where the instruction states its symbol with an addend, NO_FIXUP in its fixup
#          for none
# refines: the kind a symbol states that the encoder writes as this one by the instruction and address it is in, as
#          x86's GOTPCREL becomes R_X86_64_REX_GOTPCRELX in a load the linker may relax, so text spells this kind by
#          the specifier of the kind it refines. NO_FIXUP for a kind stated as itself
pub rec Binding {
    fixup:   operand.FixupKind;
    kind:    *reloc.Kind;
    arches:  Arches;
    added:   Added;
    refines: operand.FixupKind;
}

# the kind a bound kind is written as where the instruction states an addend to its symbol, on some formats, as an
# elf branch to `foo` is R_X86_64_PLT32 and one to `foo+8` or `foo-4` R_X86_64_PC32, since a plt stub has no offset,
# where mach-o's X86_64_RELOC_BRANCH takes either. the addend is the one the instruction states, never one an equate
# holds, so a branch to `bar` of `.set bar, foo+8` goes through the plt
# ---
# fixup:   the set's kind written in its place, NO_FIXUP for none
# formats: the formats it is written on, EVERY_FORMAT for every one
pub rec Added {
    fixup:   operand.FixupKind;
    formats: Formats;
}

# formats as a pointer to static rows of mink's catalog and a count
pub rec Formats {
    at:  **mink_format.Format;
    len: u32;
}

# every format an object is written in
pub val EVERY_FORMAT: Formats = Formats{at: nil, len: 0};

# the kind binding `b` is written as where the instruction states an addend, in an object of format `format`, NO_FIXUP
# where it is written as itself
pub fun added(b: *Binding, format: *mink_format.Format) operand.FixupKind {
    if (b.added.fixup == operand.NO_FIXUP || b.added.formats.len == 0) { ret b.added.fixup; }
    var i: u32 = 0;
    for (i < b.added.formats.len) {
        if (b.added.formats.at[i] == format) { ret b.added.fixup; }
        i = i + 1;
    }
    ret operand.NO_FIXUP;
}

# architectures as a pointer to static rows of mink's catalog and a count
pub rec Arches {
    at:  **mink_arch.Arch;
    len: u32;
}

# every architecture the set serves
pub val EVERY_ARCH: Arches = Arches{at: nil, len: 0};

# whether binding `b` binds its kind on architecture `arch`
pub fun binds(b: *Binding, arch: *mink_arch.Arch) bool {
    if (b.arches.len == 0) { ret true; }
    var i: u32 = 0;
    for (i < b.arches.len) {
        if (b.arches.at[i] == arch) { ret true; }
        i = i + 1;
    }
    ret false;
}

# bindings as a pointer to static bindings and a count, nil and 0 for a set with no fixups
pub rec Bindings {
    at:  *Binding;
    len: u32;
}

pub val NO_BINDINGS: Bindings = Bindings{at: nil, len: 0};

# fixup kinds no format relocates, as aarch64's cb<cc> imm9 and autiasppc imm16, which aaelf64 gives no relocation. a
# local kind is plainly pc-relative: the builder writes the distance to a label it measures, a label of the
# instruction's own section that other objects cannot preempt with no instruction the linker may resize between, and
# refuses any other target, since only a relocation could reach it. a kind is local or bound,
# never both
# ---
# at:  the kinds, in ascending order
# len: how many
pub rec Locals {
    at:  *operand.FixupKind;
    len: u32;
}

# the locals of a set whose every fixup kind is bound
pub val NO_LOCALS: Locals = Locals{at: nil, len: 0};

# whether `fixup` is one of `all`, a binary search
pub fun local(all: Locals, fixup: operand.FixupKind) bool {
    var lo: u32 = 0;
    var hi: u32 = all.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (all.at[mid] < fixup) { lo = mid + 1; }
        or                       { hi = mid; }
    }
    ret lo < all.len && all.at[lo] == fixup;
}

# what a datum's value is measured from
# ---
# ABSOLUTE: the target's address
# RELATIVE: the distance from the datum's own place, as `.4byte sym - .`
pub def Basis: u8;

pub val ABSOLUTE: Basis = 0;
pub val RELATIVE: Basis = 1;

# the widest datum, in bytes
pub val MAX_WIDTH: u8 = 8;

# the fixup kind a datum of one basis and width takes
# ---
# basis: what its value is measured from
# width: its width in bytes, 1 to MAX_WIDTH
# fixup: the set-local fixup kind, bound like an operand's
pub rec Datum {
    basis: Basis;
    width: u8;
    fixup: operand.FixupKind;
}

# data fixups as a pointer to static rows and a count
pub rec Data {
    at:  *Datum;
    len: u32;
}

# the data fixups of a set with none
pub val NO_DATA: Data = Data{at: nil, len: 0};

# how a value the layout settles is written into its field
# ---
# FIXED: in its field's width of bytes, in the set's byte order
# ULEB:  as an unsigned leb128, its length its value's, never shorter than an earlier pass of the layout made it
# SLEB:  as a signed leb128, alike
pub def Encoding: u8;

pub val FIXED: Encoding = 0;
pub val ULEB:  Encoding = 1;
pub val SLEB:  Encoding = 2;

# the fixup kinds a difference of two labels of one encoding and width takes when the linker may resize code between
# them, as risc-v's add32 and sub32 or set_uleb128 and sub_uleb128: the field holds the label added less the label
# subtracted once both are relocated
# ---
# width:    its width in bytes, 1 to MAX_WIDTH, for a FIXED encoding, and 0 for a leb128
# add:      the set-local fixup kind that adds the label added and the addend
# sub:      the set-local fixup kind that subtracts the label subtracted
# encoding: how the field is written, FIXED when a row leaves it out
pub rec Pair {
    width:    u8;
    add:      operand.FixupKind;
    sub:      operand.FixupKind;
    encoding: Encoding;
}

# pairs as a pointer to static rows and a count
pub rec Pairs {
    at:  *Pair;
    len: u32;
}

# the pairs of a set whose linker never resizes code, so a difference within a section always folds
pub val NO_PAIRS: Pairs = Pairs{at: nil, len: 0};

# a fixup kind whose relocation covers instructions after the one it rides on, as risc-v's call pair, whose
# relocation patches its auipc and the jalr after it, or that carries a marker beside it, as risc-v's hi20 carries
# RELAX while the source is relaxed. the builder writes the instructions it covers as one sequence, in the form the
# relocation fixes, refuses it outside one, and attaches its marker whatever built it while the assembler modes the
# instruction is written under hold `when`
# ---
# fixup:  the set-local kind
# count:  how many instructions it covers, the one it rides on first, 1 for one that covers only its own and carries a
#         marker
# marker: the marker fixup kind that rides beside it, as risc-v's RELAX lets the linker relax a call, operand.NO_FIXUP for none
# when:   the settings of the set's assembler modes under which the marker rides beside it, as risc-v's relax=relax,
#         mode.NO_SETTINGS for every one
pub rec Span {
    fixup:  operand.FixupKind;
    count:  u32;
    marker: operand.FixupKind;
    when:   mode.Settings;
}

# spans as a pointer to static spans and a count, in ascending order of fixup kind
pub rec Spans {
    at:  *Span;
    len: u32;
}

# the spans of a set whose every relocation covers only its own instruction and carries no marker
pub val NO_SPANS: Spans = Spans{at: nil, len: 0};

# the marker that rides beside fixup kind `fixup` under the modes `modes`, operand.NO_FIXUP for none
pub fun marker_of(all: Spans, fixup: operand.FixupKind, modes: *mode.State) operand.FixupKind {
    val sp: opt[*Span] = span_of(all, fixup);
    if (sel sp.none)                      { ret operand.NO_FIXUP; }
    if (!mode.holds(modes, sp.some.when)) { ret operand.NO_FIXUP; }
    ret sp.some.marker;
}

# the span of fixup kind `fixup`, a binary search of `all`, none when its relocation covers only its own instruction and
# carries no marker
pub fun span_of(all: Spans, fixup: operand.FixupKind) opt[*Span] {
    var lo: u32 = 0;
    var hi: u32 = all.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (all.at[mid].fixup < fixup) { lo = mid + 1; }
        or                             { hi = mid; }
    }
    if (lo >= all.len || all.at[lo].fixup != fixup) { ret opt[*Span].none{}; }
    ret opt[*Span].some{?all.at[lo]};
}

# what the distance a fold takes is measured to
# ---
# SELF:    the fixup's own symbol, from the instruction's anchor, as risc-v's pcrel_hi20 to a local label
# PARTNER: the target of the SELF fold of the instruction its symbol labels, from that instruction's anchor, as
#          risc-v's pcrel_lo12 names the label of its auipc and takes the distance the auipc's pcrel_hi20 measures
pub def Measure: u8;

pub val SELF:    Measure = 0;
pub val PARTNER: Measure = 1;

# how an immediate operand whose symbol takes a pc-relative fixup kind folds into a number, as risc-v's auipc and addi
# of `lla` to a local label fold into the high and low parts of the distance. a relative operand and a pc-relative
# address, as x86's rip-relative disp32, fold by their shape and take no row. a fold applies only where the builder
# knows the distance before the layout ends: the target a label of the same section that other objects cannot
# preempt, its kind plainly pc-relative and no instruction the linker may resize between, the instruction's own
# marker included. a kind whose value needs what only the link places, as aarch64's adrp page of a section and its
# :lo12:, never folds and takes no row. a PARTNER folds exactly when the SELF it names does
# ---
# fixup:   the set-local kind
# measure: what the distance is measured to
# anchor:  where the distance is measured from, the instruction's start or end, as the row's relative operands state
#          theirs. a PARTNER takes its SELF's
# value:   the number the immediate holds for a distance
pub rec Fold {
    fixup:   operand.FixupKind;
    measure: Measure;
    anchor:  operand.Anchor;
    value:   fun(i64) i64;
}

# folds as a pointer to static rows and a count, in ascending order of fixup kind
pub rec Folds {
    at:  *Fold;
    len: u32;
}

# the folds of a set whose immediates never fold a symbol
pub val NO_FOLDS: Folds = Folds{at: nil, len: 0};

# the fold of fixup kind `fixup`, a binary search of `all`, none when an immediate of that kind never folds
pub fun fold_of(all: Folds, fixup: operand.FixupKind) opt[*Fold] {
    var lo: u32 = 0;
    var hi: u32 = all.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (all.at[mid].fixup < fixup) { lo = mid + 1; }
        or                             { hi = mid; }
    }
    if (lo >= all.len || all.at[lo].fixup != fixup) { ret opt[*Fold].none{}; }
    ret opt[*Fold].some{?all.at[lo]};
}

# what part of the address a fixup kind's relocation computes a field holds, which the constant-time walk reads to
# place an address a symbol forms
# ---
# NO_PIECE: none the walk places, the zero value, as a branch target, a tls offset or a kind the set states no part of
# WHOLE:    the address whole, as x86's rip-relative disp32 or a literal load's label
# HIGH:     its high part, which a LOW of the same address completes, as risc-v's hi20 and pcrel_hi20 and aarch64's page
# LOW:      its low part, completing a HIGH, as risc-v's lo12 and pcrel_lo12 and aarch64's :lo12:
pub def Piece: u8;

pub val NO_PIECE: Piece = 0;
pub val WHOLE:    Piece = 1;
pub val HIGH:     Piece = 2;
pub val LOW:      Piece = 3;

# the part of its symbol's address a fixup kind's field holds. whether it reaches the symbol through its got slot, and
# whether a low part names the instruction of its high part as its partner, are the bound relocation kind's
# (`reloc.GOT`, `reloc.PARTNER`), never stated here
# ---
# fixup: the set-local kind
# piece: the part
pub rec Part {
    fixup: operand.FixupKind;
    piece: Piece;
}

# parts as a pointer to static rows and a count, in ascending order of fixup kind
pub rec Parts {
    at:  *Part;
    len: u32;
}

# the parts of a set that states none, whose addresses the walk never places by a symbol
pub val NO_PARTS: Parts = Parts{at: nil, len: 0};

# the part fixup kind `fixup` holds, a binary search of `all`, NO_PIECE for a kind of no row
pub fun piece_of(all: Parts, fixup: operand.FixupKind) Piece {
    var lo: u32 = 0;
    var hi: u32 = all.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (all.at[mid].fixup < fixup) { lo = mid + 1; }
        or                             { hi = mid; }
    }
    if (lo >= all.len || all.at[lo].fixup != fixup) { ret NO_PIECE; }
    ret all.at[lo].piece;
}
