# what a context leaves unmet of a requirement, and the one wording of a requirement and of what it leaves unmet
#
# a refusal names what it needed through these: an atom by its extension's name or as its axis, `=` and its value,
# a requirement as every alternative with the atoms the context lacks, and a register or diagnostic refused under a
# context with the requirement it needed. `Unmet` holds that by value, so a refusal outlives the context it was
# refused under and is worded the same wherever it is spelled.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.register;
use masc.core.requirement;
use masc.core.state;

val BECAUSE: str = ": ";
val NEEDS:   str = "needs ";
val OR:      str = ", or ";
val AND:     str = " and ";
val NO:      str = "no ";
val IS:      str = "=";

# atom `id` named onto `out`: an extension by its name, a state value as its axis, `=` and its value, as `xlen=64`
pub fun spell_atom(catalog: *extension.Catalog, axes: *state.Axes, id: requirement.Id, out: *vector.Vector[u8]) err[A.Error] {
    if (id < catalog.count) { ret extension.append(out, catalog.extensions[id].name); }
    val at: opt[state.Placed] = state.place(catalog, axes, id);
    if (sel at.none) { ret extension.append(out, "?"); }
    val axis:  *state.Axis        = ?axes.at[at.some.axis];
    val named: err[A.Error] = extension.append(out, axis.name);
    if (sel named.err) { ret named; }
    val is: err[A.Error] = extension.append(out, IS);
    if (sel is.err) { ret is; }
    ret extension.append(out, axis.values.at[at.some.value].name);
}

# the lead of alternative `i`
fun lead(out: *vector.Vector[u8], i: u32) err[A.Error] {
    if (i == 0) { ret extension.append(out, NEEDS); }
    ret extension.append(out, OR);
}

# atom `id` named within an alternative, joined to the one before unless it is the `first`, after `no` when it is one
# the alternative's `none` names
fun name(out: *vector.Vector[u8], catalog: *extension.Catalog, axes: *state.Axes, id: requirement.Id, first: bool, without: bool) err[A.Error] {
    if (!first) {
        val joined: err[A.Error] = extension.append(out, AND);
        if (sel joined.err) { ret joined; }
    }
    if (without) {
        val no: err[A.Error] = extension.append(out, NO);
        if (sel no.err) { ret no; }
    }
    ret spell_atom(catalog, axes, id, out);
}

# the requirement `required` spelled onto `out` as every alternative with the atoms of its `all` the context does not
# hold and those of its `none` it does, as "needs zbb, or zbkb", "needs a and b, or c" or "needs c and no zcd". the one
# wording of an unmet requirement, whoever refuses, which `spell_unmet` words the same
# ---
# a requirement the context meets is not spelled: an alternative it meets adds no names, and a requirement with no
# alternative adds nothing
pub fun spell_requirement(ctx: *state.Context, required: requirement.Requirement, out: *vector.Vector[u8]) err[A.Error] {
    var u: Unmet;
    if (!unmet(ctx, required, ?u)) { ret err[A.Error].ok{}; }
    ret spell_unmet(?u, out);
}

# the diagnostic `d` spelled onto `out`: its message, and what its refusal needed when it names a requirement, worded by
# `spell_requirement` against `ctx`, the context `d` was refused under
pub fun spell_diagnostic(ctx: *state.Context, d: *diagnostic.Diagnostic, out: *vector.Vector[u8]) err[A.Error] {
    val worded: err[A.Error] = extension.append(out, d.message);
    if (sel worded.err || d.requires.len == 0) { ret worded; }
    val because: err[A.Error] = extension.append(out, BECAUSE);
    if (sel because.err) { ret because; }
    ret spell_requirement(ctx, d.requires, out);
}

# why `u` was refused spelled onto `out`: the register's name, then its requirement as the one renderer words it
pub fun spell_unavailable(ctx: *state.Context, u: *register.Unavailable, out: *vector.Vector[u8]) err[A.Error] {
    val named: err[A.Error] = extension.append(out, u.row.name);
    if (sel named.err) { ret named; }
    val gap: err[A.Error] = extension.append(out, " ");
    if (sel gap.err) { ret gap; }
    ret spell_requirement(ctx, u.requires, out);
}

# how many alternatives, and how many atoms across them, an unmet requirement holds
pub val UNMET_ALTERNATIVES: u32 = 16;
pub val UNMET_IDS:          u32 = 64;

# what a refusal needed that the context it was refused under did not hold, by value, so it outlives that context
# ---
# catalog: the catalog the extensions are rows of, nil when nothing was needed
# axes:    the axes that number the state atoms after it
# ids:     the atoms each alternative needs that the context lacked, and the atoms of its `none` the context held,
#          alternative after alternative
# without: one bit per entry of `ids`, set for an atom of a `none` the context held
# ends:    where each alternative's atoms end in `ids`
# len:     how many alternatives there are, none when the refusal needed nothing
pub rec Unmet {
    catalog: *extension.Catalog;
    axes:    *state.Axes;
    ids:     [UNMET_IDS]requirement.Id;
    without: u64;
    ends:    [UNMET_ALTERNATIVES]u32;
    len:     u32;
}

# the unmet requirement of a refusal that needed nothing
pub fun nothing_unmet() Unmet {
    var u: Unmet;
    u.catalog = nil;
    u.axes    = nil;
    u.without = 0;
    u.len     = 0;
    ret u;
}

# atom `id` kept as entry `used` of `out`, a `none` atom when `without`
fun keep(out: *Unmet, used: *u32, id: requirement.Id, without: bool) bool {
    if (@used == UNMET_IDS) { ret false; }
    out.ids[@used] = id;
    if (without) { out.without = out.without | (1::u64 << (@used)::u64); }
    @used = @used + 1;
    ret true;
}

# whether the catalog's rows bring atom `to` from atom `from`: the atom itself, or one its implications reach
fun reaches(catalog: *extension.Catalog, from: requirement.Id, to: requirement.Id, depth: u32) bool {
    if (from == to)                          { ret true; }
    if (from >= catalog.count || depth == 0) { ret false; }
    val implies: requirement.Ids = catalog.extensions[from].implies;
    var i:       u32             = 0;
    for (i < implies.len) {
        if (reaches(catalog, implies.at[i], to, depth - 1)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `ids` lists atom `id`
fun lists(ids: requirement.Ids, id: requirement.Id) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (ids.at[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether alternative `x` meets alternative `y` wherever it is met: what x needs brings all y needs, and x excludes all
# y excludes
fun stronger(catalog: *extension.Catalog, x: requirement.Alternative, y: requirement.Alternative) bool {
    var k: u32 = 0;
    for (k < y.all.len) {
        var brought: bool = false;
        var j:       u32  = 0;
        for (j < x.all.len && !brought) {
            brought = reaches(catalog, x.all.at[j], y.all.at[k], catalog.count);
            j       = j + 1;
        }
        if (!brought) { ret false; }
        k = k + 1;
    }
    k = 0;
    for (k < y.none.len) {
        if (!lists(x.none, y.none.at[k])) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether alternative `i` of `required` is redundant, as a refusal words it: another meets it wherever it is met, the
# first of two equivalent ones kept. a requirement is stored as its source states it and minimized only here
fun redundant(catalog: *extension.Catalog, required: requirement.Requirement, i: u32) bool {
    var j: u32 = 0;
    for (j < required.len) {
        if (j != i && stronger(catalog, required.at[i], required.at[j]) && (j < i || !stronger(catalog, required.at[j], required.at[i]))) { ret true; }
        j = j + 1;
    }
    ret false;
}

# `required` resolved against the context into `out`, every alternative no other makes redundant kept with the atoms of
# its `all` the context lacks and those of its `none` it holds. a requirement the context meets resolves to nothing
# ---
# ret: false when `required` is met, or has more alternatives or unmet atoms than an unmet requirement holds, with
#      `out` then holding nothing
pub fun unmet(ctx: *state.Context, required: requirement.Requirement, out: *Unmet) bool {
    @out = nothing_unmet();
    if (required.len > UNMET_ALTERNATIVES || state.admits(ctx, required)) { ret false; }
    val catalog: *extension.Catalog = ctx.selection.catalog;
    var used:    u32                = 0;
    var kept:    u32                = 0;
    var i:       u32                = 0;
    for (i < required.len) {
        if (redundant(catalog, required, i)) {
            i = i + 1;
            cnt;
        }
        val alt: requirement.Alternative = required.at[i];
        var k:   u32                     = 0;
        for (k < alt.all.len) {
            if (!state.holds(ctx, alt.all.at[k]) && !keep(out, ?used, alt.all.at[k], false)) {
                @out = nothing_unmet();
                ret false;
            }
            k = k + 1;
        }
        k = 0;
        for (k < alt.none.len) {
            if (state.holds(ctx, alt.none.at[k]) && !keep(out, ?used, alt.none.at[k], true)) {
                @out = nothing_unmet();
                ret false;
            }
            k = k + 1;
        }
        out.ends[kept] = used;
        kept           = kept + 1;
        i              = i + 1;
    }
    out.catalog = catalog;
    out.axes    = ctx.axes;
    out.len     = kept;
    ret true;
}

# the unmet requirement `u` spelled onto `out`, worded as `spell_requirement` words it against the context `u` was
# resolved against
pub fun spell_unmet(u: *Unmet, out: *vector.Vector[u8]) err[A.Error] {
    var from: u32 = 0;
    var i:    u32 = 0;
    for (i < u.len) {
        val led: err[A.Error] = lead(out, i);
        if (sel led.err) { ret led; }
        var k: u32 = from;
        for (k < u.ends[i]) {
            val named: err[A.Error] = name(out, u.catalog, u.axes, u.ids[k], k == from, ((u.without >> k::u64) & 1) != 0);
            if (sel named.err) { ret named; }
            k = k + 1;
        }
        from = u.ends[i];
        i    = i + 1;
    }
    ret err[A.Error].ok{};
}

# the refusal worded `message` that needed `u` spelled onto `out`: its message, and what it needed when it needed
# anything, worded by `spell_unmet`
pub fun spell_refusal(message: str, u: *Unmet, out: *vector.Vector[u8]) err[A.Error] {
    val worded: err[A.Error] = extension.append(out, message);
    if (sel worded.err || u.len == 0) { ret worded; }
    val because: err[A.Error] = extension.append(out, BECAUSE);
    if (sel because.err) { ret because; }
    ret spell_unmet(u, out);
}
