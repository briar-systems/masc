# the encoded instruction value: a row and its operand values
#
# the builder, the printer and the decoder share this one value, so what is
# printed is what was encoded and what decodes is what prints.

use masc.core.form;
use masc.core.operand;
use masc.core.row;

# one instruction
# ---
# row:    the row it encodes
# values: its operand values, one per operand of the row
# count:  how many values there are
# form:   its encoding form, PREFERRED for the set's preference
pub rec Inst {
    row:    *row.Row;
    values: *operand.Value;
    count:  u32;
    form:   form.Form;
}
