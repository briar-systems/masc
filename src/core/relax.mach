# the relaxation rows of an instruction set
#
# a relaxation names a row and its relative operand, and the longer form the
# builder rewrites the row as when the operand's target is out of range: one
# or more rows, each operand's value taken from the row it replaces, a fixed
# register or immediate, or the target. x86 jmp rel8 becomes jmp rel32, and a
# risc-v beq becomes bne past a jal to the target. the builder only ever
# replaces a row by its longer form, so its fixed point terminates.

# an enumerant or condition operand's value with `mask` flipped, as an inverted branch condition
# ---
# operand: the operand of the row relaxed
# mask:    the bits flipped
pub rec Flip {
    operand: u8;
    mask:    u32;
}

# where one operand of the longer form takes its value from
# ---
# operand:   the value of this operand of the row relaxed
# flipped:   an operand of the row relaxed with bits flipped
# target:    the target of the relaxed operand, measured from this instruction
# past:      a target just past the end of the longer form, as an inverted branch skips the far jump
# register:  the register at this row of the file, as x0 of a risc-v jal
# immediate: this immediate
# none:      no value, for an absent optional operand
pub tag Source: u8 {
    operand: u8;
    flipped: Flip;
    target;
    past;
    register:  u32;
    immediate: i64;
    none;
}

# sources as a pointer to static sources and a count
pub rec Sources {
    at:  *Source;
    len: u32;
}

# one instruction of a longer form
# ---
# row:    the row it encodes, by its index in the set's rows
# values: where each of its operands takes its value from, one per operand of the row
pub rec Step {
    row:    u32;
    values: Sources;
}

# steps as a pointer to static steps and a count
pub rec Steps {
    at:  *Step;
    len: u32;
}

# a row's longer form, for when its relative operand's target is out of range
# ---
# row:     the row relaxed, by its index in the set's rows
# operand: its relative operand whose range decides
# form:    the instructions it becomes, exactly one of their sources the target
pub rec Relaxation {
    row:     u32;
    operand: u8;
    form:    Steps;
}

# relaxations as a pointer to static relaxations and a count, nil and 0 for a set with none
pub rec Relaxations {
    at:  *Relaxation;
    len: u32;
}
