# the row schema every instruction set fills in
#
# a row is one encoding of one instruction: its mnemonic, its operands, its
# encoding as fields, and the extensions it requires. a mnemonic with several
# encodings, such as an x86 imm8 and imm32 form or a short and a near jump, is
# several rows in preference order, so the builder chooses and relaxes by row
# and the selection admits each by its requirement. rows are static literals,
# validated once when their set registers.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use masc.core.constraint;
use masc.core.ct;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.operand;
use masc.core.requirement;

# what a row is for, as bits
# ---
# DECODE_ONLY: an encoding decode accepts and encode never writes, such as a redundant x86 form
# HINT:        a named hint carved out of a parent row's encodings, as risc-v's pause in fence or aarch64's yield in hint.
#              it is more specific than its parent, so decode tries it first, and a selection that does not admit it
#              decodes its bits as the parent, or refuses them where the parent excludes them
#
# an alias is a spelling, and so a row of a set's syntax, never a row here
pub def Flags: u8;

pub val DECODE_ONLY: Flags = 0x1;
pub val HINT:        Flags = 0x2;

# the most operands a row has, as the operand model states it, and the most fields its encoding has
fwd masc.core.operand.MAX_OPERANDS;

pub val MAX_FIELDS: u32 = 32;

# operands as a pointer to static operands and a count
pub rec Operands {
    at:  *operand.Operand;
    len: u32;
}

pub val NO_OPERANDS: Operands = Operands{at: nil, len: 0};

# one encoding of one instruction
# ---
# key:         its name, unique within its set and stable: a saved text names the row by it, so it never depends on
#              the row's place or on any other row, and a generator derives it from its source's own identifier for the encoding
# mnemonic:    the mnemonic it spells
# operands:    its operands in order
# encoding:    its fields in stream order
# requires:    the alternatives of extensions a selection must hold, any one fully, to admit it
# effect:      what it reads and writes beyond its operands
# ct:          its constant-time class
# constraints: the register constraints on its operands, which reserve the forms whose operands share registers
# flags:       what it is for
# index:       its place among its codec's rows, which the codec assigns and the check holds to its position, so a
#              consumer reads a row's identity here and a row of another table never passes for one of the codec's
pub rec Row {
    key:         str;
    mnemonic:    str;
    operands:    Operands;
    encoding:    field.Fields;
    requires:    requirement.Requirement;
    effect:      *effect.Effect;
    ct:          *ct.Class;
    constraints: constraint.Constraints;
    flags:       Flags;
    index:       u32;
}

# rows as a pointer to static rows and a count
pub rec Rows {
    at:  *Row;
    len: u32;
}

# whether `r` is one of `rows`, the row its index names
pub fun of(rows: Rows, r: *Row) bool {
    ret r.index < rows.len && ?rows.at[r.index] == r;
}

pub val NO_ROWS: Rows = Rows{at: nil, len: 0};

# whether `r` has a marker operand, which no bits hold, so decode reads its bits as the row it marks
pub fun marked(r: *Row) bool {
    var i: u32 = 0;
    for (i < r.operands.len) {
        if (sel r.operands.at[i].shape.marker) { ret true; }
        i = i + 1;
    }
    ret false;
}
