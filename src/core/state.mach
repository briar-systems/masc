# execution state: the axes code runs under, and the context every reader takes
#
# an extension is something the processor implements, a state is something
# code runs under and may switch between, as x86's code width, risc-v's xlen
# or aarch64's streaming mode, and an assembler mode (`masc.core.mode`) is
# only how source is read. a set declares its state as axes, each with its
# values and the one it starts at, and whether code may switch it.
#
# a requirement is stated over atoms (`masc.core.requirement`): an atom below
# the catalog's row count is an extension, and the atoms after it are the
# state values, axis by axis, so `xlen=64` is one atom as `zba` is. a context
# is a closed selection, a value for every axis and the view of the register
# file they make, and `admits` is the one predicate: every row, register,
# pattern, bound and binding is admitted through it. a reader takes the
# context of the statement it reads or writes, which may be wider or narrower
# than the object's.
#
# a selection's spelling may state values of the axes, as risc-v's `rv64`
# states xlen=64, which a context takes over the architecture's initial ones.
#
# what a context leaves unmet of a requirement, and its wording, is
# `masc.core.unmet`'s.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.view;
use std.types.view.view_eq_str;

use A: std.allocator;

use masc.core.extension;
use masc.core.quantity;
use masc.core.register;
use masc.core.requirement;

# the most axes a set declares, so a context holds the value of every axis without storage of its own
pub val MAX_AXES: u32 = 8;

# one value of an axis
# ---
# name: its spelling, as `64` of xlen or `on` of streaming, which a requirement's wording writes after the axis
# flag: the command line flag that starts code at it, nil for none
# doc:  one line for the flag's help
pub rec Value {
    name: str;
    flag: str;
    doc:  str;
}

# values as a pointer to static rows and a count
pub rec Values {
    at:  *Value;
    len: u32;
}

# one axis of a set's execution state
# ---
# name:       its name, as `xlen`
# values:     the values it takes, at least two
# initial:    the value code runs under when nothing states one, an index of `values`
# switchable: whether code switches it within an object, as x86's `.code32` does its width. one that is not is fixed by
#             the architecture and the selection for the whole object, as risc-v's xlen
pub rec Axis {
    name:       str;
    values:     Values;
    initial:    u8;
    switchable: bool;
}

# a set's axes as a pointer to static rows and a count, at most MAX_AXES
pub rec Axes {
    at:  *Axis;
    len: u32;
}

# the axes of a set whose code runs under no state, as spir-v and wasm
pub val NO_AXES: Axes = Axes{at: nil, len: 0};

# the value of every axis, by axis, each an index of its axis's values
pub rec Settings {
    at: [MAX_AXES]u8;
}

# a state value by its axis and its index among the axis's values
pub rec Placed {
    axis:  u32;
    value: u8;
}

# what a reader reads or writes under: the selection, the value of every axis and the view of the register file they
# make, and the state of the stream it is in
# ---
# selection: the closed selection
# axes:      the set's axes, which number the state atoms after the selection's catalog
# values:    the value of each axis, in the order of `axes`
# view:      the register file viewed through the selection and the values, nil while it is being made
# stream:    the state a typed stream keeps across instructions, nil for a set with none
pub rec Context {
    selection: *extension.Selection;
    axes:      *Axes;
    values:    Settings;
    view:      *register.Available;
    stream:    ptr;
}

# why a context was not made
# ---
# unknown: the selection states an atom past its catalog that is no value of the set's axes
# twice:   the selection states two values of the axis of this index
pub tag Error: u8 {
    unknown: requirement.Id;
    twice:   u32;
}

# how many atoms the catalog and the axes number: the extensions, then every value of every axis
pub fun atom_count(catalog: *extension.Catalog, axes: *Axes) u32 {
    var n: u32 = catalog.count;
    var i: u32 = 0;
    for (i < axes.len) {
        n = n + axes.at[i].values.len;
        i = i + 1;
    }
    ret n;
}

# the atom of value `value` of axis `axis`
pub fun atom(catalog: *extension.Catalog, axes: *Axes, axis: u32, value: u8) requirement.Id {
    var n: u32 = catalog.count;
    var i: u32 = 0;
    for (i < axis && i < axes.len) {
        n = n + axes.at[i].values.len;
        i = i + 1;
    }
    ret n + value::u32;
}

# the axis and value of atom `id`, none for an extension or an atom past every axis
pub fun place(catalog: *extension.Catalog, axes: *Axes, id: requirement.Id) opt[Placed] {
    if (id < catalog.count) { ret opt[Placed].none{}; }
    var at: u32 = id - catalog.count;
    var i:  u32 = 0;
    for (i < axes.len) {
        val n: u32 = axes.at[i].values.len;
        if (at < n) { ret opt[Placed].some{Placed{axis: i, value: at::u8}}; }
        at = at - n;
        i  = i + 1;
    }
    ret opt[Placed].none{};
}

# the atom `text[at..at + len]` names: an extension by its name in the catalog, or a state value as its axis, `=` and
# its value, as `xlen=64`, the spelling `masc.core.unmet.spell_atom` writes. none when it names neither
pub fun lookup(catalog: *extension.Catalog, axes: *Axes, text: str, at: usize, len: usize) opt[requirement.Id] {
    val found: opt[requirement.Id] = extension.lookup(catalog, text, at, len);
    if (sel found.some) { ret found; }
    var eq: usize = at;
    for (eq < at + len && text[eq] != '=') {
        eq = eq + 1;
    }
    if (eq == at + len) { ret opt[requirement.Id].none{}; }
    var i: u32 = 0;
    for (i < axes.len) {
        val axis: *Axis = ?axes.at[i];
        if (view_eq_str(view(?text[at], eq - at), axis.name)) {
            var k: u32 = 0;
            for (k < axis.values.len) {
                if (view_eq_str(view(?text[eq + 1], at + len - eq - 1), axis.values.at[k].name)) { ret opt[requirement.Id].some{atom(catalog, axes, i, k::u8)}; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret opt[requirement.Id].none{};
}

# every axis of `axes` at its initial value
pub fun initial(axes: *Axes) Settings {
    var s: Settings;
    var i: u32 = 0;
    for (i < MAX_AXES) {
        s.at[i] = 0;
        if (i < axes.len) { s.at[i] = axes.at[i].initial; }
        i = i + 1;
    }
    ret s;
}

# a context of `selection` under `axes`, each axis at its value of `start` unless the selection's spelling states
# another. its view is nil until `select` makes one
# ---
# ret: the context, or the first atom the selection states that names no value or a second value of one axis
pub fun make(selection: *extension.Selection, axes: *Axes, start: Settings) res[Context, Error] {
    var ctx:  Context = Context{selection: selection, axes: axes, values: start, view: nil, stream: nil};
    var seen: u32     = 0;
    var i:    u32     = 0;
    for (i < selection.stated.len) {
        val id: requirement.Id = selection.stated.at[i];
        val at: opt[Placed]    = place(selection.catalog, axes, id);
        if (sel at.none) { ret res[Context, Error].err{Error.unknown{id}}; }
        val bit: u32 = 1::u32 << at.some.axis;
        if ((seen & bit) != 0 && ctx.values.at[at.some.axis] != at.some.value) { ret res[Context, Error].err{Error.twice{at.some.axis}}; }
        seen                        = seen | bit;
        ctx.values.at[at.some.axis] = at.some.value;
        i                           = i + 1;
    }
    ret res[Context, Error].ok{ctx};
}

# whether the context holds atom `id`: its selection holds the extension, or its axis is at the value
pub fun holds(ctx: *Context, id: requirement.Id) bool {
    if (id < ctx.selection.catalog.count) { ret extension.has(ctx.selection, id); }
    val at: opt[Placed] = place(ctx.selection.catalog, ctx.axes, id);
    if (sel at.none) { ret false; }
    ret ctx.values.at[at.some.axis] == at.some.value;
}

# whether the context holds every atom of `ids`
fun all_held(ctx: *Context, ids: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (!holds(ctx, ids.at[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the context holds no atom of `ids`
fun none_held(ctx: *Context, ids: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (holds(ctx, ids.at[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the context meets the alternative `alt`: every atom of its `all` held and none of its `none`
pub fun meets(ctx: *Context, alt: requirement.Alternative) bool {
    ret all_held(ctx, alt.all) && none_held(ctx, alt.none);
}

# whether the context meets any alternative of `required`, or `required` has none. the one admission predicate:
# every row, register, pattern, bound and binding is admitted by it
pub fun admits(ctx: *Context, required: requirement.Requirement) bool {
    if (required.len == 0) { ret true; }
    var i: u32 = 0;
    for (i < required.len) {
        if (meets(ctx, required.at[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the context with axis `axis` at value `value`
# ---
# ret: whether the set has the axis and the axis the value, the context unchanged when not
pub fun set(ctx: *Context, axis: u32, value: u8) bool {
    if (axis >= ctx.axes.len || value::u32 >= ctx.axes.at[axis].values.len) { ret false; }
    ctx.values.at[axis] = value;
    ret true;
}

# whether two contexts read alike: one selection's members, one value on every axis
pub fun same(a: *Context, b: *Context) bool {
    if (a.axes != b.axes || a.selection.catalog != b.selection.catalog)                             { ret false; }
    if (!extension.within(a.selection, b.selection) || !extension.within(b.selection, a.selection)) { ret false; }
    var i: u32 = 0;
    for (i < a.axes.len) {
        if (a.values.at[i] != b.values.at[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the least multiplier of `d` at or past `m`
fun least_of(d: quantity.Domain, m: u32) u32 {
    var from: u64 = 0;
    if (m > 0) { from = m::u64 - 1; }
    val got: opt[u64] = quantity.next(d, from);
    if (sel got.some) { ret got.some::u32; }
    ret m;
}

# the most multiplier of `d` at or below `m`, from `least`
fun most_of(d: quantity.Domain, least: u32, m: u32) u32 {
    var top: u32 = least;
    for {
        val at: opt[u64] = quantity.next(d, top::u64);
        if (sel at.some) {
            if (at.some > m::u64) { ret top; }
            top = at.some::u32;
        }
        or { ret top; }
    }
    ret top;
}

# the view of `file` through the context: the rows it admits, of a number its class has under it, the quantity each
# slot binds, and the range of multipliers every bound of a quantity that holds leaves. the context and the file must
# outlive it, and the caller sets it as the context's view
# ---
# ret: the view, or why it was not made: a quantity whose bounds leave no multiplier of its domain
pub fun select(a: *A.Allocator, file: *register.File, ctx: *Context) res[register.Available, register.Error] {
    val made: res[register.Available, register.Error] = register.blank(a, file);
    if (sel made.err) { ret made; }
    var v: register.Available = made.ok;
    if (file == nil) { ret res[register.Available, register.Error].ok{v}; }
    var q: u32 = 0;
    for (q < file.quantities.len) {
        val row: *quantity.Quantity = ?file.quantities.at[q];
        var r:   quantity.Range     = quantity.span(row.domain);
        var b:   u32                = 0;
        for (b < row.bounds.len) {
            if (admits(ctx, row.bounds.at[b].when)) { r = quantity.clip(r, ?row.bounds.at[b]); }
            b = b + 1;
        }
        if (!quantity.meets(row.domain, r)) {
            register.release(?v);
            ret res[register.Available, register.Error].err{register.Error.empty{q::u8}};
        }
        val least: u32 = least_of(row.domain, r.least);
        v.ranges[q] = quantity.Range{least: least, most: most_of(row.domain, least, r.most)};
        q           = q + 1;
    }
    var k: u32 = 0;
    for (k < file.bindings.len) {
        val bind: *quantity.Binding = ?file.bindings.at[k];
        if (bind.slot::u32 < file.slot_count && v.bound[bind.slot] == quantity.UNBOUND && admits(ctx, bind.when)) { v.bound[bind.slot] = bind.quantity; }
        k = k + 1;
    }
    var i: u32 = 0;
    for (i < file.register_count) {
        val row: *register.Register = ?file.registers[i];
        if (admits(ctx, row.requires) && row.number::u64 < register.members(?v, row.class)) { register.admit(?v, i); }
        i = i + 1;
    }
    ret res[register.Available, register.Error].ok{v};
}

# the gauge of `q` that measures it under the context, none when no gauge of it holds, as a quantity nothing reads at run
# time or aarch64's svl outside streaming mode. its gauges are exclusive, so the first that holds is the one
pub fun gauge(ctx: *Context, q: *quantity.Quantity) opt[*quantity.Gauge] {
    var i: u32 = 0;
    for (i < q.gauges.len) {
        if (admits(ctx, q.gauges.at[i].when)) { ret opt[*quantity.Gauge].some{?q.gauges.at[i]}; }
        i = i + 1;
    }
    ret opt[*quantity.Gauge].none{};
}

# the column of `file` for `format` the context reads: the first of the format whose flavour it holds, none when the
# file has none it holds
pub fun column(file: *register.File, format: register.Format, ctx: *Context) opt[*register.Column] {
    var i: u32 = register.first_column(file, format);
    for (i < file.column_count && file.columns[i].format == format) {
        if (admits(ctx, file.columns[i].flavour)) { ret opt[*register.Column].some{?file.columns[i]}; }
        i = i + 1;
    }
    ret opt[*register.Column].none{};
}

# the number `format` gives `reg` under the context, by the column whose flavour it holds, as 32-bit x86 code numbers
# esp 4 where 64-bit code numbers rsp 7. none when the file has no such column or the format leaves it unnumbered
pub fun debug_number(file: *register.File, reg: register.Id, format: register.Format, ctx: *Context) opt[u32] {
    val at: opt[u32] = register.index_of(file, reg);
    if (sel at.none) { ret opt[u32].none{}; }
    val col: opt[*register.Column] = column(file, format, ctx);
    if (sel col.none) { ret opt[u32].none{}; }
    ret register.numbered_in(col.some, at.some);
}

# the register `format` gives the number `number` under the context, none when the file has no such column or no
# register has the number
pub fun from_debug_number(file: *register.File, number: u32, format: register.Format, ctx: *Context) opt[register.Id] {
    val col: opt[*register.Column] = column(file, format, ctx);
    if (sel col.none) { ret opt[register.Id].none{}; }
    ret register.numbered_by(file, col.some, number);
}

# a context of `selection` under `axes` at `start` with its view of `file` made into `view`, which the caller keeps for
# as long as the context, as `select` makes it
# ---
# ret: the context, or why it or its view was not made
pub fun open(a: *A.Allocator, file: *register.File, selection: *extension.Selection, axes: *Axes, start: Settings, view: *register.Available) res[Context, Opened] {
    val made: res[Context, Error] = make(selection, axes, start);
    if (sel made.err) { ret res[Context, Opened].err{Opened.state{made.err}}; }
    var ctx:    Context                                 = made.ok;
    val viewed: res[register.Available, register.Error] = select(a, file, ?ctx);
    if (sel viewed.err) { ret res[Context, Opened].err{Opened.view{viewed.err}}; }
    @view    = viewed.ok;
    ctx.view = view;
    ret res[Context, Opened].ok{ctx};
}

# why `open` made no context
# ---
# state: the selection states its axes wrongly
# view:  the view was not made
pub tag Opened: u8 {
    state: Error;
    view:  register.Error;
}

