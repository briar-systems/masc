# the syntax rows every instruction set fills in
#
# a syntax spells each row of a set by one template: its mnemonic, its
# operands in their written order and the text between them. the printer
# and the parser in `masc.syntax` both read the template, the register
# file's names and aliases, and each enumeration's members, so no spelling
# is written twice. an alias is a further template over a base row, with
# where each base operand's value comes from, the values its operands exclude
# beyond those the operands they read as do, the condition under which it
# applies and its preference for printing. a sequence spelling is a template
# over several rows, as risc-v's `call`, each step's operands taken from its
# operands or fixed, so the printer writes such instructions as one statement
# and the parser reads it back to them. specifiers spell the fixup kinds
# a symbol takes, and hooks spell what differs per set: immediates, memory,
# register lists, ids and literals. a set carries one or more syntaxes, its
# established one first.
#
# a template is text with holes. `<n>` is operand n, and `<n:format>` hands
# `format` to the operand's hook. `<[` and `]>` enclose an optional group,
# printed when every operand in it is present and read when the text holds
# it, so a group of optional operands is absent exactly when they are none,
# and a group with no operand, as aarch64's `<[#]>`, is printed and optional
# to read. a space prints as one space and reads any run of white space,
# white space is also read before text that follows a hole, and every other
# character is itself.
#
# a template's mnemonic is its text before the first space, hole or group. a
# syntax indexes its rows and aliases by mnemonic, the keys sorted and each
# entry naming its candidates in the order the parser tries them, so the
# parser reaches a mnemonic's candidates by search rather than by scan.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view.View;

use std.collections.vector;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.field;
use masc.core.index;
use masc.core.operand;
use masc.core.register;
use masc.core.requirement;
use masc.core.row;
use masc.core.walk;

# what a piece of a template is
# ---
# END:    the end of the template
# TEXT:   a character that is itself
# SPACE:  a space
# HOLE:   an operand
# OPEN:   the start of an optional group
# CLOSE:  the end of an optional group
# BROKEN: a `<` that opens nothing well formed
pub def Kind: u8;

pub val END:    Kind = 0;
pub val TEXT:   Kind = 1;
pub val SPACE:  Kind = 2;
pub val HOLE:   Kind = 3;
pub val OPEN:   Kind = 4;
pub val CLOSE:  Kind = 5;
pub val BROKEN: Kind = 6;

# one piece of a template
# ---
# kind:    what it is
# at:      its offset in the template
# len:     its length in the template
# operand: a hole's operand
# format:  a hole's format, empty when it has none
pub rec Piece {
    kind:    Kind;
    at:      usize;
    len:     usize;
    operand: u8;
    format:  View;
}

# the piece of `template` at `at`
pub fun piece(template: str, at: usize) Piece {
    var p: Piece = Piece{kind: END, at: at, len: 0, operand: 0, format: View{data: nil, len: 0}};
    val c: u8    = template[at];
    if (c == 0) { ret p; }
    p.len = 1;
    if (c == ' ') {
        p.kind = SPACE;
        ret p;
    }
    if (c == ']' && template[at + 1] == '>') {
        p.kind = CLOSE;
        p.len  = 2;
        ret p;
    }
    if (c != '<') {
        p.kind = TEXT;
        ret p;
    }
    if (template[at + 1] == '[') {
        p.kind = OPEN;
        p.len  = 2;
        ret p;
    }
    var i: usize = at + 1;
    var n: u32   = 0;
    for (template[i] >= '0' && template[i] <= '9' && n < row.MAX_OPERANDS) {
        n = n * 10 + (template[i] - '0')::u32;
        i = i + 1;
    }
    p.kind = BROKEN;
    if (i == at + 1 || n >= row.MAX_OPERANDS) { ret p; }
    var format: usize = i;
    if (template[i] == ':') {
        format = i + 1;
        i      = format;
        for (template[i] != 0 && template[i] != '>') {
            i = i + 1;
        }
    }
    if (template[i] != '>') { ret p; }
    p.kind    = HOLE;
    p.operand = n::u8;
    p.len     = i + 1 - at;
    p.format  = View{data: ?template[format], len: i - format};
    ret p;
}

# a set's spelling of each of its rows, one template per row of its codec
pub rec Forms {
    at:  *str;
    len: u32;
}

# an enumerant, condition or immediate operand of an alias with bits flipped, as an inverted condition
# ---
# operand: the alias's operand
# mask:    the bits flipped
pub rec Flip {
    operand: u8;
    mask:    u32;
}

# an immediate operand of an alias that the base row's value holds with some bits fixed, as risc-v's `prefetch.i` over the offset of `ori`
# ---
# operand: the alias's operand, the base value with the mask's bits cleared
# mask:    the bits the alias fixes
# value:   what the base value holds in those bits
pub rec Mask {
    operand: u8;
    mask:    u64;
    value:   u64;
}

# where an alias takes one of its base row's operand values from
# ---
# operand:  the value of this operand of the alias
# flipped:  an operand of the alias with bits flipped
# masked:   an operand of the alias with the bits of a mask fixed to a value
# register: the register at this row of the file, as the x0 of risc-v's `j`
# value:    this value, which holds no register
# derived:  what the alias's derivation computes
pub tag Source: u8 {
    operand:  u8;
    flipped:  Flip;
    masked:   Mask;
    register: u32;
    value:    operand.Value;
    derived;
}

# sources as a pointer to static sources and a count, one per operand of the base row
pub rec Sources {
    at:  *Source;
    len: u32;
}

# the values an alias operand excludes, in the shape of the exclusions of the operand it reads as
# ---
# register:  register numbers within a class, whichever class holds them, as operand.Register's
# immediate: values compared as the operand's value, as operand.Immediate's
pub tag Excluded: u8 {
    register:  operand.Numbers;
    immediate: operand.Integers;
}

# values an operand of an alias never takes though the operand it reads as admits them, as risc-v's `ssrdp`, whose rd is never x0
# ---
# operand:  the alias's operand
# excluded: the values it excludes beyond those its operand excludes
pub rec Exclusion {
    operand:  u8;
    excluded: Excluded;
}

# exclusions as a pointer to static exclusions and a count, in ascending order of operand, each operand at most once
pub rec Exclusions {
    at:  *Exclusion;
    len: u32;
}

# the exclusions of an alias that excludes nothing beyond its operands
pub val NO_EXCLUSIONS: Exclusions = Exclusions{at: nil, len: 0};

# the values an alias computes rather than states, as aarch64's `lsl` over `ubfm`
# ---
# operands: the alias's operands, which its sources do not then give
# base:     fills each derived base value from the alias's values, false when they have no base form
# alias:    fills each alias value no source gives from the base's values, false when the alias does not apply
pub rec Derive {
    operands: row.Operands;
    base:     fun(*operand.Value, *operand.Value) bool;
    alias:    fun(*operand.Value, *operand.Value) bool;
}

# a further spelling of a base row, as risc-v's `mv` of `addi` or aarch64's `cmp` of `subs`
# ---
# row:        the base row, by its index in the codec's rows
# template:   its spelling over its own operands
# count:      how many operands it has
# sources:    where each base operand's value comes from, one per base operand
# derive:     what it computes, nil when its sources state everything
# exclusions: the values its operands never take though the operands they read as admit them
# requires:   the alternatives of extensions a selection must hold, any one fully, besides its base row's, as risc-v's `frflags` needs F
# preference: 0 when it is only read, or its rank among the aliases of its base that apply, the highest printed
#
# an alias is admitted when the selection holds both its base row's requirement
# and its own, the empty one adding nothing, and the reader and the printer
# both ask. an alias applies to a base value when every source agrees with it,
# its derivation, if any, accepts it, and none of its values is one it
# excludes. the reader refuses an excluded value as it refuses any other, and
# the printer writes such a value by another spelling. the operands of an alias without a
# derivation are the base operands its sources take them from
pub rec Alias {
    row:        u32;
    template:   str;
    count:      u8;
    sources:    Sources;
    derive:     *Derive;
    exclusions: Exclusions;
    requires:   requirement.Requirement;
    preference: u8;
}

# aliases as a pointer to static aliases and a count, in base row order
pub rec Aliases {
    at:  *Alias;
    len: u32;
}

# the spelling of a fixup kind on a symbol, as `%pcrel_hi(<0>)`, `:lo12:<0>` or `<0>@PLT`
# ---
# template: its spelling around one hole, the expression it applies to. a
#           template that starts with its hole binds the symbol before it, so
#           an addend follows it, and any other template wraps the whole expression
# operand:  the fixup kind an operand takes by default that it applies to
# fixup:    the fixup kind it gives the symbol there
# fold:     its value over a constant, nil when it refuses one
pub rec Specifier {
    template: str;
    operand:  operand.FixupKind;
    fixup:    operand.FixupKind;
    fold:     fun(i64) i64;
}

# specifiers as a pointer to static specifiers and a count
pub rec Specifiers {
    at:  *Specifier;
    len: u32;
}

# a sequence operand's symbol given a fixup kind, as the target of risc-v's `call` takes the call pair's
# ---
# operand: the sequence's operand, a symbol of no specifier
# fixup:   the fixup kind the step's symbol takes
pub rec Relocation {
    operand: u8;
    fixup:   operand.FixupKind;
}

# where a step of a sequence spelling takes one operand value from
# ---
# operand:  the value of this operand of the sequence
# symbol:   a symbol operand of the sequence, given a fixup kind
# register: this register, by its identity
# value:    this value, which holds no register
pub tag Part: u8 {
    operand:  u8;
    symbol:   Relocation;
    register: register.Id;
    value:    operand.Value;
}

# parts as a pointer to static parts and a count, one per operand of the step's row
pub rec Parts {
    at:  *Part;
    len: u32;
}

# one instruction of a sequence spelling
# ---
# row:   the row it writes
# parts: where each of its operands takes its value from
pub rec Step {
    row:   *row.Row;
    parts: Parts;
}

# steps as a pointer to static steps and a count
pub rec Steps {
    at:  *Step;
    len: u32;
}

# a spelling of several instructions as one statement, as risc-v's `call <0>` of an auipc and a jalr that one
# relocation covers. the printer writes such a sequence by it, and the parser reads it back to the same instructions
# ---
# template: its spelling over its own operands
# operands: what each of its operands admits, as a row's do
# steps:    the instructions it is, in order
pub rec Sequence {
    template: str;
    operands: row.Operands;
    steps:    Steps;
}

# a syntax's sequence spellings
# ---
# at:    the spellings in ascending order of their first step's row, and in the printer's preference among those
# len:   how many there are
# named: the index of each spelling in ascending order of mnemonic under the syntax's case rule, so the parser searches them
pub rec Sequences {
    at:    *Sequence;
    len:   u32;
    named: *u32;
}

# the longest spelling a syntax reserves for anonymous labels
pub val MAX_ANONYMOUS: usize = 32;

# the sequence spellings of a syntax with none
pub val NO_SEQUENCES: Sequences = Sequences{at: nil, len: 0, named: nil};

# what a name in an operand resolves to
# ---
# constant: an absolute value, as a name `.equ` defines
# symbol:   the caller's handle for a symbol, never operand.NO_SYMBOL
# equated:  a symbol plus an addend, or the difference of two, as a name `.set` equates to `a + 4` or `a - b`
pub tag Resolved: u8 {
    constant: i64;
    symbol:   u32;
    equated:  Equated;
}

# what a name equated to an expression of symbols stands for
# ---
# plus:   the symbol added, never operand.NO_SYMBOL
# minus:  the symbol subtracted, operand.NO_SYMBOL for none
# addend: the constant added
pub rec Equated {
    plus:   u32;
    minus:  u32;
    addend: i64;
}

# the caller's symbols, which the parser names and the printer spells
# ---
# context: the caller's state, handed to both functions
# resolve: what a name is, or the message it is refused with
# name:    the spelling of a symbol handle
pub rec Symbols {
    context: ptr;
    resolve: fun(ptr, View) res[Resolved, str];
    name:    fun(ptr, u32) View;
}

# the state the parser hands a hook, positioned at the operand it reads
# ---
# text:      the source text
# start:     the offset of the instruction's first byte
# at:        the offset of the next byte to read
# end:       the offset just past the instruction's text
# origin:    the position of the instruction's first byte in its source
# codec:     the set's codec
# available: the selection's view of the register file, through which names resolve
# syntax:    the syntax read
# symbols:   the caller's symbols
# context:   the state the syntax's hooks keep across instructions, the caller's
# row:       the base row whose spelling is read
# pool:      storage for list and variadic members, after the operand values
# cap:       how many pool slots there are
# used:      how many pool slots are taken
# bytes:     storage for literal bytes that cannot be borrowed from the text
# room:      how many bytes there are
# taken:     how many bytes are taken
# refused:   the alternatives of every candidate refused for admission, so a refusal names them all
pub rec Reader {
    text:      *u8;
    start:     usize;
    at:        usize;
    end:       usize;
    origin:    diagnostic.Position;
    codec:     *walk.Codec;
    available: *register.Available;
    syntax:    *Syntax;
    symbols:   *Symbols;
    context:   ptr;
    row:       *row.Row;
    pool:      *operand.Value;
    cap:       u32;
    used:      u32;
    bytes:     *u8;
    room:      u32;
    taken:     u32;
    refused:   field.Admissions;
}

# the state the printer hands a hook
# ---
# out:       the text appended to
# codec:     the set's codec
# selection: the selection the instruction is written under, whose held extensions admit an alias, nil for one that holds none
# syntax:    the syntax written
# symbols:   the caller's symbols
# context:   the state the syntax's hooks keep across instructions, the caller's
# row:       the base row whose value is printed
pub rec Writer {
    out:       *vector.Vector[u8];
    codec:     *walk.Codec;
    selection: *extension.Selection;
    syntax:    *Syntax;
    symbols:   *Symbols;
    context:   ptr;
    row:       *row.Row;
}

# how one kind of operand is spelled
# ---
# parse: reads one value of the operand at the reader's position, its format given, or refuses the text
# print: writes one value of the operand, its format given, or refuses a value it cannot spell
pub rec Hook {
    parse: fun(*Reader, *operand.Operand, View, *operand.Value) err[diagnostic.Diagnostic];
    print: fun(*Writer, *operand.Operand, View, *operand.Value) err[field.Refusal];
}

# the hooks of a syntax, each nil when no row of the set has such an operand.
# registers, enumerants and conditions are spelled from their one table and take no hook
# ---
# immediate: immediates and relative targets
# memory:    memory operands
# list:      register lists
# id:        ids
# literal:   byte literals
pub rec Hooks {
    immediate: *Hook;
    memory:    *Hook;
    list:      *Hook;
    id:        *Hook;
    literal:   *Hook;
}

# a row's own spelling or an alias, as the parser tries it
# ---
# row:   the row, by its index in the codec's rows, which an alias has as its base
# alias: 0 for the row's own spelling, or 1 and the alias's index in the syntax's aliases
#
# candidates are tried in ascending order of row and then alias, the order of
# the encoder's preference
pub rec Candidate {
    row:   u32;
    alias: u32;
}

# the candidates that share one mnemonic
# ---
# key:   the mnemonic
# first: the offset of its first candidate in the index's candidates
# len:   how many candidates it has, at least one
pub rec Entry {
    key:   str;
    first: u32;
    len:   u32;
}

# a syntax's rows and aliases by mnemonic
# ---
# at:         the entries as a pointer to static entries, strictly ascending by key under the syntax's case rule
# len:        how many entries there are
# candidates: every candidate as a pointer to static candidates, entry after entry, each row and alias once
# count:      how many candidates there are
pub rec Index {
    at:         *Entry;
    len:        u32;
    candidates: *Candidate;
    count:      u32;
}

# one assembly syntax of a set
# ---
# name:       the name it is chosen by, as `intel` or `att`
# forms:      one template per row of the codec
# aliases:    its alias rows
# index:      its rows and aliases by mnemonic
# specifiers: its specifiers
# sequences:  its spellings of several instructions as one statement
# hooks:      its operand hooks
# register:   the text before every register name, as at&t's `%`, empty for none
# aliased:    whether a register is written by its first alias, as risc-v's abi names, rather than by its row's name
# join:       the text between the members of a mask
# variadic:   the text between the values of a variadic operand
# fold:       whether mnemonics, registers, enumerants and specifiers read without regard to ascii case
# anonymous:  the spelling it reserves for a label with no name, its handle following, which no named label may start with,
#             at most MAX_ANONYMOUS bytes
pub rec Syntax {
    name:       str;
    forms:      Forms;
    aliases:    Aliases;
    index:      Index;
    specifiers: Specifiers;
    sequences:  Sequences;
    hooks:      Hooks;
    register:   str;
    aliased:    bool;
    join:       str;
    variadic:   str;
    fold:       bool;
    anonymous:  str;
}

# a set's syntaxes as a pointer to static syntaxes and a count, its established syntax first
pub rec Syntaxes {
    at:  *Syntax;
    len: u32;
}

# `c` in lower case when it is an ascii capital
pub fun lower(c: u8) u8 {
    ret index.lower(c);
}

# the mnemonic of `template`, empty when it starts with a space, hole or group
pub fun mnemonic(template: str) View {
    var at: usize = 0;
    for {
        val p: Piece = piece(template, at);
        if (p.kind != TEXT) { brk; }
        at = p.at + p.len;
    }
    ret View{data: template, len: at};
}

# how mnemonic `a` orders against `b`, bytes in order and without regard to ascii case when the syntax folds
pub fun compare(syntax: *Syntax, a: View, b: View) i64 {
    var i: usize = 0;
    for (i < a.len && i < b.len) {
        var x: u8 = a.data[i];
        var y: u8 = b.data[i];
        if (syntax.fold) {
            x = lower(x);
            y = lower(y);
        }
        if (x < y) { ret -1; }
        if (x > y) { ret 1; }
        i = i + 1;
    }
    if (a.len < b.len) { ret -1; }
    if (a.len > b.len) { ret 1; }
    ret 0;
}

# the template of candidate `c` of `syntax`
pub fun template(syntax: *Syntax, c: Candidate) str {
    if (c.alias == 0) { ret syntax.forms.at[c.row]; }
    ret syntax.aliases.at[c.alias - 1].template;
}

# the syntax of `syntaxes` named `name`, as a directive or an option chooses one
pub fun find(syntaxes: Syntaxes, name: str) opt[*Syntax] {
    var i: u32 = 0;
    for (i < syntaxes.len) {
        if (str_equals(syntaxes.at[i].name, name)) { ret opt[*Syntax].some{?syntaxes.at[i]}; }
        i = i + 1;
    }
    ret opt[*Syntax].none{};
}

# the hook of `syntax` that spells `shape`, nil for a shape spelled from its table
pub fun hook(syntax: *Syntax, shape: *operand.Shape) *Hook {
    if (sel shape.immediate || sel shape.relative) { ret syntax.hooks.immediate; }
    if (sel shape.memory)                          { ret syntax.hooks.memory; }
    if (sel shape.list)                            { ret syntax.hooks.list; }
    if (sel shape.id)                              { ret syntax.hooks.id; }
    if (sel shape.literal)                         { ret syntax.hooks.literal; }
    ret nil;
}

# the operand an alias reads as its operand `k`, nil when neither its derivation nor a source gives one
pub fun alias_operand(a: *Alias, base: *row.Row, k: u8) *operand.Operand {
    if (a.derive != nil) {
        if (k::u32 >= a.derive.operands.len) { ret nil; }
        ret ?a.derive.operands.at[k];
    }
    var j: u32 = 0;
    for (j < a.sources.len && j < base.operands.len) {
        val src: Source = a.sources.at[j];
        if ((sel src.operand && src.operand == k) || (sel src.flipped && src.flipped.operand == k) || (sel src.masked && src.masked.operand == k)) { ret ?base.operands.at[j]; }
        j = j + 1;
    }
    ret nil;
}
