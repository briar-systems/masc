# the constant-time class every row references, and the one refusal
#
# a row's class says which of its inputs its timing depends on. a row is
# dependent, independent, or independent under a condition: an atom of its
# set, an extension as risc-v's zkt or a state value as aarch64's dit=on or
# x86's doitm=on, so the condition is held through the context like any
# requirement. masc states the
# condition only, and whether a program turns it on is decided by the linker
# from the code that survives. the class covers timing alone. addresses,
# access lengths and branch conditions and targets always matter, and the walk
# reads those from the effect, never from the class. every caller that refuses
# a secret reports the one refusal record here, worded once.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.field;
use masc.core.index;
use masc.core.operand;
use masc.core.requirement;
use masc.core.state;

# the inputs an instruction's timing depends on. a position the row only
# writes holds no value before it, so only the positions it reads count
# ---
# operands: the operand positions whose values matter
# accesses: whether the data its implicit accesses read matters, as x86 repe cmps stops at the first difference
pub rec Inputs {
    operands: operand.Positions;
    accesses: bool;
}

# independence under a condition
# ---
# condition: the atom under which the timing depends on no input, an extension or a state value
# inputs:    the inputs it depends on when the context does not hold the condition
pub rec Gate {
    condition: requirement.Id;
    inputs:    Inputs;
}

# a row's constant-time class
# ---
# dependent:   its timing depends on these inputs
# independent: its timing depends on no input
# conditional: its timing depends on no input when the context holds the condition
pub tag Class: u8 {
    dependent: Inputs;
    independent;
    conditional: Gate;
}

# the class of a row no constant-time list names: dependent on every input
pub val DEPENDENT: Class = Class.dependent{Inputs{operands: operand.ALL_POSITIONS, accesses: true}};

# the class of a row whose timing depends on no input under any selection
pub val INDEPENDENT: Class = Class.independent{};

# the inputs a row of class `c` depends on under the context `ctx`
pub fun inputs(c: *Class, ctx: *state.Context) Inputs {
    if (sel c.dependent) { ret c.dependent; }
    if (sel c.conditional) {
        if (!state.holds(ctx, c.conditional.condition)) { ret c.conditional.inputs; }
    }
    ret Inputs{operands: operand.NO_POSITIONS, accesses: false};
}

# whether a row of class `c` depends on no input under the context `ctx`
pub fun independent(c: *Class, ctx: *state.Context) bool {
    val on: Inputs = inputs(c, ctx);
    ret on.operands == operand.NO_POSITIONS && !on.accesses;
}

# what a secret reached
# ---
# LATENCY: an input the instruction's timing depends on
# CONTROL: the condition or the target of a control transfer
# MEMORY:  the address or the length of a memory access
pub def Reason: u8;

pub val LATENCY: Reason = 0;
pub val CONTROL: Reason = 1;
pub val MEMORY:  Reason = 2;

pub val REASONS: u32 = 3;

val WORDINGS: [3]str = [3]str{
    "secret value in an input the instruction's timing depends on",
    "control transfer decided by a secret value",
    "memory access whose address or length is formed from a secret value",
};

# what a refusal adds when a condition would have made the row independent
val UNLESS: str = ", and the context lacks ";

# a constant-time refusal, the one record the walk, the inline assembly scan
# and mirl report. its location is the caller's
# ---
# reason:    what the secret reached
# operand:   the operand holding the secret, NO_OPERAND when a register, flag or access no operand names holds it
# condition: the atom under which a latency refusal's row would be independent, none when no condition would
pub rec Refusal {
    reason:    Reason;
    operand:   u8;
    condition: opt[requirement.Id];
}

# the refusal of a secret reaching `reason` through operand `op`
pub fun refusal(reason: Reason, op: u8) Refusal {
    ret Refusal{reason: reason, operand: op, condition: opt[requirement.Id].none{}};
}

# the refusal of a secret in an input of a row of class `c` that operand `op` holds, naming its condition
pub fun latency(c: *Class, op: u8) Refusal {
    var r: Refusal = refusal(LATENCY, op);
    if (sel c.conditional) { r.condition = opt[requirement.Id].some{c.conditional.condition}; }
    ret r;
}

# the one wording of `r`'s reason
pub fun message(r: *Refusal) str {
    ret WORDINGS[r.reason];
}

# `r` spelled onto `out`: its wording, and the condition's name in `catalog` and `axes` when it has one
pub fun spell(r: *Refusal, catalog: *extension.Catalog, axes: *state.Axes, out: *vector.Vector[u8]) err[A.Error] {
    val worded: err[A.Error] = extension.append(out, message(r));
    if (sel worded.err)       { ret worded; }
    if (sel r.condition.none) { ret worded; }
    val unless: err[A.Error] = extension.append(out, UNLESS);
    if (sel unless.err) { ret unless; }
    ret state.spell_atom(catalog, axes, r.condition.some, out);
}

#[testing]
val T_EXTENSIONS: [2]extension.Extension = [2]extension.Extension{
    extension.Extension{name: "i", implies: requirement.NO_IDS, revision: "2.1"},
    extension.Extension{name: "zkt", implies: requirement.NO_IDS, revision: "1.0"},
};

#[testing]
val T_IDS: [2]requirement.Id = [2]requirement.Id{0, 1};

#[testing]
val T_NAMES: [2]extension.NameEntry = [2]extension.NameEntry{extension.NameEntry{key: "i", rows: requirement.Ids{at: ?T_IDS[0], len: 1}, canonical: true}, extension.NameEntry{key: "zkt", rows: requirement.Ids{at: ?T_IDS[1], len: 1}, canonical: true}};

#[testing]
val T_CATALOG: extension.Catalog = extension.Catalog{extensions: ?T_EXTENSIONS[0], count: 2, levels: nil, level_count: 0, names: extension.Names{at: ?T_NAMES[0], len: 2}, conflicts: nil, conflict_count: 0, combinations: nil, combination_count: 0, syntax: ?extension.LIST};

#[testing]
val T_GATED: Class = Class.conditional{Gate{condition: 1, inputs: Inputs{operands: 0x6, accesses: false}}};

# gated by the test axes' mode=on, the catalog's two extensions then mode=off and mode=on
#[testing]
val T_STATED: Class = Class.conditional{Gate{condition: 3, inputs: Inputs{operands: 0x1, accesses: false}}};

# a condition is an atom, so an extension and a state value gate alike
test independent__a_gated_class_is_independent_only_under_its_condition {
    var t: testing.Testing;
    testing.make(?t);
    val without: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?T_CATALOG, "i", diagnostic.START);
    val with:    res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?T_CATALOG, "i,zkt", diagnostic.START);
    if (sel without.err) { ret 1; }
    if (sel with.err)    { ret 1; }
    var lacking: extension.Selection = without.ok;
    var holding: extension.Selection = with.ok;
    var off:     state.Context       = state.Context{selection: ?lacking, axes: ?state.T_AXES, values: state.initial(?state.T_AXES), view: nil, stream: nil};
    var on:      state.Context       = state.Context{selection: ?holding, axes: ?state.T_AXES, values: state.initial(?state.T_AXES), view: nil, stream: nil};
    if (independent(?T_GATED, ?off) || inputs(?T_GATED, ?off).operands != 0x6) { ret 2; }
    if (!independent(?T_GATED, ?on))                                           { ret 3; }
    if (independent(?T_STATED, ?on) || !state.set(?on, 0, 1))                  { ret 4; }
    if (!independent(?T_STATED, ?on) || independent(?T_GATED, ?off))           { ret 5; }
    extension.release(?lacking);
    extension.release(?holding);
    ret 0;
}

test spell__each_reason_is_worded_once_whoever_refuses {
    var t: testing.Testing;
    testing.make(?t);
    val wants: [5]str = [5]str{
        "secret value in an input the instruction's timing depends on",
        "control transfer decided by a secret value",
        "memory access whose address or length is formed from a secret value",
        "secret value in an input the instruction's timing depends on, and the context lacks zkt",
        "secret value in an input the instruction's timing depends on, and the context lacks mode=on",
    };
    val refusals: [5]Refusal = [5]Refusal{
        latency(?DEPENDENT, 0),
        refusal(CONTROL, field.NO_OPERAND),
        refusal(MEMORY, 2),
        latency(?T_GATED, 1),
        latency(?T_STATED, 0),
    };
    var i: u32 = 0;
    for (i < 5) {
        var out:     vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t));
        val spelled: err[A.Error]      = spell(?refusals[i], ?T_CATALOG, ?state.T_AXES, ?out);
        if (sel spelled.err)                      { ret 1; }
        if (!extension.t_spelled(?out, wants[i])) { ret 2; }
        vector.dnit[u8](?out);
        i = i + 1;
    }
    if (message(?refusals[0]) != message(?refusals[3])) { ret 3; }
    ret 0;
}
