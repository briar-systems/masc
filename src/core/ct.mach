# the constant-time class every row references, the set's timing, and the one refusal
#
# a row's class says which of its inputs its timing depends on. a row is
# dependent, independent, or independent under a condition: a requirement
# over the atoms of its set, extensions as risc-v's zkt and zvkt or state
# values as aarch64's dit=on or x86's doitm=on, held through the context like
# any requirement, but for the inputs it states remain, as zvkt leaves the
# mask and vector configuration. an input is an operand position, the data
# of the implicit accesses, or a register no operand names. masc states the
# condition only, and whether a program turns it on is decided by the linker
# from the code that survives. the class covers timing alone. addresses,
# access lengths and branch conditions and targets always matter, and the
# walk reads those from the effect, never from the class. masc's rows are the one source of these facts for every
# family: a set classifies its rows' timing, states that its timing is not
# guaranteed, as wasm, whose code a later compiler schedules, so constant-time
# code of it is walked as any other's but for its rows' latency and compiles
# with a warning, or states that it classifies none, as spir-v, so
# constant-time code of it is refused. every caller that refuses a
# secret, or a constant-time requirement a set cannot meet, reports the one
# refusal record here, worded once, and every caller that warns of a timing
# not guaranteed words it once, here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;
use std.allocator.testing;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.index;
use masc.core.operand;
use masc.core.quantity;
use masc.core.register;
use masc.core.requirement;
use masc.core.state;

# the registers no operand names whose values an instruction's timing depends on
# ---
# every: each such register it reads, whatever the set's register file holds
# only:  these rows of the set's register file, as the vector mask v0 and the vl and vtype a zvkt row keeps
pub tag Registers: u8 {
    every;
    only: effect.Set;
}

# the inputs an instruction's timing depends on. a position the row only
# writes holds no value before it, so only the positions it reads count
# ---
# operands: the operand positions whose values matter
# accesses: whether the data its implicit accesses read matters, as x86 repe cmps stops at the first difference
# implicit: the registers no operand names whose values matter
pub rec Inputs {
    operands: operand.Positions;
    accesses: bool;
    implicit: Registers;
}

# every input: each operand position, the accesses' data and each register no operand names
pub val ALL_INPUTS: Inputs = Inputs{operands: operand.ALL_POSITIONS, accesses: true, implicit: Registers.every{}};

# no input
pub val NO_INPUTS: Inputs = Inputs{operands: operand.NO_POSITIONS, accesses: false, implicit: Registers.only{effect.NO_WORDS}};

# independence under a condition, but for the inputs that remain
# ---
# condition: the requirement under which the timing depends on no input but the remaining, over extensions and state
#            values, never empty
# inputs:    the inputs it depends on when the context does not meet the condition
# remaining: the inputs it still depends on when the context meets it, each one of inputs, NO_INPUTS for none, as zvkt
#            leaves v0, vl and vtype to every row it lists and vs1 or rs1 to vrgather and vslide
pub rec Gate {
    condition: requirement.Requirement;
    inputs:    Inputs;
    remaining: Inputs;
}

# a row's constant-time class
# ---
# dependent:   its timing depends on these inputs
# independent: its timing depends on no input
# conditional: its timing depends on the gate's remaining inputs only when the context holds its condition
pub tag Class: u8 {
    dependent: Inputs;
    independent;
    conditional: Gate;
}

# whether a set classifies its rows' timing
# ---
# rows:         each row's class states it, every row no cited list names dependent
# unguaranteed: no instruction's timing is classified and none can be, as wasm, whose code a later compiler
#               schedules, so the walk refuses a secret reaching a control transfer or an address as elsewhere, asks
#               no row's latency, and a constant-time requirement it meets is met with a warning, worded UNGUARANTEED
# none:         no instruction's timing is classified, as spir-v, so a constant-time requirement on code of the set is
#               refused, worded UNCLASSIFIED
pub tag Timing: u8 {
    rows;
    unguaranteed;
    none;
}

# whether a set of timing `t` classifies its rows, so each row's class is its own to state
pub fun classified(t: Timing) bool {
    ret sel t.rows;
}

# the class of a row no constant-time list names: dependent on every input
pub val DEPENDENT: Class = Class.dependent{ALL_INPUTS};

# the class of a row whose timing depends on no input under any selection
pub val INDEPENDENT: Class = Class.independent{};

# where a secret reaching an instruction is
# ---
# operand:  the value of the operand at this position
# register: a register no operand names, which the instruction reads
# access:   the data an implicit access reads
pub tag Input: u8 {
    operand:  u8;
    register: register.Id;
    access;
}

# the inputs a row of class `c` depends on under the context `ctx`
pub fun inputs(c: *Class, ctx: *state.Context) Inputs {
    if (sel c.dependent) { ret c.dependent; }
    if (sel c.conditional) {
        if (!state.admits(ctx, c.conditional.condition)) { ret c.conditional.inputs; }
        ret c.conditional.remaining;
    }
    ret NO_INPUTS;
}

# whether `set` holds no row
fun no_rows(set: effect.Set) bool {
    var w: u32 = 0;
    for (w < set.len) {
        if (set.words[w] != 0) { ret false; }
        w = w + 1;
    }
    ret true;
}

# whether `in` names no input
pub fun empty(in: *Inputs) bool {
    if (in.operands != operand.NO_POSITIONS || in.accesses) { ret false; }
    val regs: *Registers = ?in.implicit;
    if (sel regs.every) { ret false; }
    ret no_rows(regs.only);
}

# whether every input `a` names is one `b` names
pub fun within(a: *Inputs, b: *Inputs) bool {
    if ((a.operands & ~b.operands) != 0 || (a.accesses && !b.accesses)) { ret false; }
    val outer: *Registers = ?b.implicit;
    if (sel outer.every) { ret true; }
    val inner: *Registers = ?a.implicit;
    if (sel inner.every) { ret false; }
    var w: u32 = 0;
    for (w < inner.only.len) {
        var held: u64 = 0;
        if (w < outer.only.len)                 { held = outer.only.words[w]; }
        if ((inner.only.words[w] & ~held) != 0) { ret false; }
        w = w + 1;
    }
    ret true;
}

# whether the input `at` is one `in` names, its registers rows of `file`
pub fun holds(in: *Inputs, file: *register.File, at: Input) bool {
    if (sel at.operand) { ret at.operand < 32 && ((in.operands >> at.operand::u32) & 1) != 0; }
    if (sel at.access)  { ret in.accesses; }
    val regs: *Registers = ?in.implicit;
    if (sel at.register) {
        if (sel regs.only) { ret effect.has(file, regs.only, at.register); }
        ret true;
    }
    ret false;
}

# whether a row of class `c` depends on no input under the context `ctx`
pub fun independent(c: *Class, ctx: *state.Context) bool {
    val on: Inputs = inputs(c, ctx);
    ret empty(?on);
}

# what a secret reached, or why no code of the set can run in constant time
# ---
# LATENCY:      an input the instruction's timing depends on
# CONTROL:      the condition or the target of a control transfer
# MEMORY:       the address or the length of a memory access
# UNCLASSIFIED: a constant-time requirement on code of a set whose timing is `none`
# UNCHECKED:    an argument of a call to a callee its caller's model states is not checked constant time
pub def Reason: u8;

pub val LATENCY:      Reason = 0;
pub val CONTROL:      Reason = 1;
pub val MEMORY:       Reason = 2;
pub val UNCLASSIFIED: Reason = 3;
pub val UNCHECKED:    Reason = 4;

pub val REASONS: u32 = 5;

val WORDINGS: [5]str = [5]str{
    "secret value in an input the instruction's timing depends on",
    "control transfer decided by a secret value",
    "memory access whose address or length is formed from a secret value",
    "constant time required of code whose instruction set classifies no instruction's timing",
    "secret value passed to a callee not checked constant time",
};

# a constant-time refusal, the one record the walk, the inline assembly scan
# and mirl report. its location is the caller's
# ---
# reason:  what the secret reached
# operand: the operand holding the secret, NO_OPERAND when a register, flag or access no operand names holds it
# unmet:   what of the condition under which a latency refusal's row would not depend on the refused input the context
#          it was refused under lacks, nothing when no condition would
pub rec Refusal {
    reason:  Reason;
    operand: u8;
    unmet:   state.Unmet;
}

# the refusal of a secret reaching `reason` through operand `op`
pub fun refusal(reason: Reason, op: u8) Refusal {
    ret Refusal{reason: reason, operand: op, unmet: state.nothing_unmet()};
}

# the refusal of a secret at `at`, an input a row of class `c` reads, under the context `ctx`, none when its timing
# does not depend on it there, the one decision the walk and mirl take. it names what of the row's condition the
# context lacks when meeting it would leave `at` unread by the timing, and nothing when `at` remains
pub fun latency(c: *Class, ctx: *state.Context, file: *register.File, at: Input) opt[Refusal] {
    val on: Inputs = inputs(c, ctx);
    if (!holds(?on, file, at)) { ret opt[Refusal].none{}; }
    var op: u8 = field.NO_OPERAND;
    if (sel at.operand) { op = at.operand; }
    var r: Refusal = refusal(LATENCY, op);
    if (sel c.conditional) {
        if (!holds(?c.conditional.remaining, file, at)) { val found: bool = state.unmet(ctx, c.conditional.condition, ?r.unmet); }
    }
    ret opt[Refusal].some{r};
}

# the warning of a constant-time requirement on code of a set whose timing is not guaranteed, its one wording
pub val UNGUARANTEED: str = "constant time required of code whose instruction set cannot guarantee any instruction's timing, as a later compiler schedules it";

# how a constant-time requirement on code of a set is answered
# ---
# held:         the set classifies its rows, so the walk decides the code
# unguaranteed: the set cannot guarantee its timing, so the walk decides the code but for its rows' latency, and code
#               it clears is met with a warning worded UNGUARANTEED
# refused:      the set classifies no timing, so the requirement is refused, worded UNCLASSIFIED
pub tag Required: u8 {
    held;
    unguaranteed;
    refused: Refusal;
}

# how a constant-time requirement on code of a set whose timing is `t` is answered
pub fun required(t: Timing) Required {
    if (sel t.rows)         { ret Required.held{}; }
    if (sel t.unguaranteed) { ret Required.unguaranteed{}; }
    ret Required.refused{refusal(UNCLASSIFIED, field.NO_OPERAND)};
}

# the one wording of `r`'s reason
pub fun message(r: *Refusal) str {
    ret WORDINGS[r.reason];
}

# `r` spelled onto `out`: its wording, and what of the condition the context lacked as the one renderer of an unmet
# requirement words it, when anything would have made the row independent
pub fun spell(r: *Refusal, out: *vector.Vector[u8]) err[A.Error] {
    ret state.spell_refusal(message(r), ?r.unmet, out);
}

#[testing]
val T_EXTENSIONS: [3]extension.Extension = [3]extension.Extension{
    extension.Extension{name: "i", implies: requirement.NO_IDS, revision: "2.1"},
    extension.Extension{name: "zkt", implies: requirement.NO_IDS, revision: "1.0"},
    extension.Extension{name: "zvkt", implies: requirement.NO_IDS, revision: "1.0"},
};

#[testing]
val T_IDS: [3]requirement.Id = [3]requirement.Id{0, 1, 2};

#[testing]
val T_NAMES: [3]extension.NameEntry = [3]extension.NameEntry{
    extension.NameEntry{key: "i", rows: requirement.Ids{at: ?T_IDS[0], len: 1}, canonical: true},
    extension.NameEntry{key: "zkt", rows: requirement.Ids{at: ?T_IDS[1], len: 1}, canonical: true},
    extension.NameEntry{key: "zvkt", rows: requirement.Ids{at: ?T_IDS[2], len: 1}, canonical: true},
};

#[testing]
val T_CATALOG: extension.Catalog = extension.Catalog{extensions: ?T_EXTENSIONS[0], count: 3, levels: nil, level_count: 0, names: extension.Names{at: ?T_NAMES[0], len: 3}, conflicts: nil, conflict_count: 0, combinations: nil, combination_count: 0, syntax: ?extension.LIST};

#[testing]
val T_ZKT_ALTERNATIVE: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?T_IDS[1], len: 1}, none: requirement.NO_IDS}};

#[testing]
val T_GATED: Class = Class.conditional{Gate{condition: requirement.Requirement{at: ?T_ZKT_ALTERNATIVE[0], len: 1}, inputs: Inputs{operands: 0x6, accesses: false, implicit: Registers.only{effect.NO_WORDS}}, remaining: NO_INPUTS}};

# gated by the test axes' mode=on, the catalog's three extensions then mode=off and mode=on
#[testing]
val T_MODE_ON: [1]requirement.Id = [1]requirement.Id{4};

#[testing]
val T_MODE_ALTERNATIVE: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?T_MODE_ON[0], len: 1}, none: requirement.NO_IDS}};

#[testing]
val T_STATED: Class = Class.conditional{Gate{condition: requirement.Requirement{at: ?T_MODE_ALTERNATIVE[0], len: 1}, inputs: Inputs{operands: 0x1, accesses: false, implicit: Registers.only{effect.NO_WORDS}}, remaining: NO_INPUTS}};

# v0, then vl and vtype, the vector registers and configuration a zvkt row reads that no operand names
#[testing]
val T_VECTOR_CLASSES: [2]register.Class = [2]register.Class{
    register.Class{kind: register.VECTOR, width: quantity.Scaled{fixed: 128, per: 0, scale: 0}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    register.Class{kind: register.SYSTEM, width: quantity.Scaled{fixed: 64, per: 0, scale: 0}, count: quantity.Scaled{fixed: 2, per: 0, scale: 0}},
};

#[testing]
val T_VECTOR_REGISTERS: [3]register.Register = [3]register.Register{
    register.Register{name: "v0", class: 0, number: 0, bank: 0, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "vl", class: 1, number: 0, bank: 1, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
    register.Register{name: "vtype", class: 1, number: 1, bank: 2, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: register.ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: register.KEEP, reach: register.Reach.bank{}},
};

#[testing]
val T_VECTOR_FILE: register.File = register.File{
    quantities:     quantity.NO_QUANTITIES,
    bindings:       quantity.NO_BINDINGS,
    slot_count:     0,
    classes:        ?T_VECTOR_CLASSES[0],
    class_count:    2,
    class_names:    index.NO_ENTRIES,
    registers:      ?T_VECTOR_REGISTERS[0],
    register_count: 3,
    aliases:        nil,
    alias_count:    0,
    names:          index.NO_ENTRIES,
    columns:        nil,
    column_count:   0,
};

#[testing]
val T_KEPT: [1]u64 = [1]u64{0x7};

#[testing]
val T_ZVKT_ALTERNATIVE: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?T_IDS[2], len: 1}, none: requirement.NO_IDS}};

# zvk.adoc at riscv-isa-manual 36fdac54, Zvkt_diel_def: data-independent execution latency covers no value of vl,
# vtype or the mask v0, so a row zvkt lists keeps them, and vrgather.vv vd, vs2, vs1, vm keeps its index vs1 too
#[testing]
val T_DIEL_KEPT: Inputs = Inputs{operands: operand.NO_POSITIONS, accesses: false, implicit: Registers.only{effect.Set{words: ?T_KEPT[0], len: 1}}};

#[testing]
val T_GATHER_KEPT: Inputs = Inputs{operands: 0x4, accesses: false, implicit: Registers.only{effect.Set{words: ?T_KEPT[0], len: 1}}};

#[testing]
val T_DIEL: Class = Class.conditional{Gate{condition: requirement.Requirement{at: ?T_ZVKT_ALTERNATIVE[0], len: 1}, inputs: ALL_INPUTS, remaining: T_DIEL_KEPT}};

#[testing]
val T_GATHER: Class = Class.conditional{Gate{condition: requirement.Requirement{at: ?T_ZVKT_ALTERNATIVE[0], len: 1}, inputs: ALL_INPUTS, remaining: T_GATHER_KEPT}};

# a condition is a requirement over atoms, so an extension and a state value gate alike
test independent__a_gated_class_is_independent_only_under_its_condition {
    var t: testing.Testing;
    testing.make(?t);
    val without: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?T_CATALOG, "i", diagnostic.START);
    val with:    res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?T_CATALOG, "i,zkt,zvkt", diagnostic.START);
    if (sel without.err) { ret 1; }
    if (sel with.err)    { ret 1; }
    var lacking: extension.Selection = without.ok;
    var holding: extension.Selection = with.ok;
    var off:     state.Context       = state.Context{selection: ?lacking, axes: ?state.T_AXES, values: state.initial(?state.T_AXES), view: nil, stream: nil};
    var on:      state.Context       = state.Context{selection: ?holding, axes: ?state.T_AXES, values: state.initial(?state.T_AXES), view: nil, stream: nil};
    if (independent(?T_GATED, ?off) || inputs(?T_GATED, ?off).operands != 0x6)                         { ret 2; }
    if (!independent(?T_GATED, ?on))                                                                   { ret 3; }
    if (independent(?T_STATED, ?on) || !state.set(?on, 0, 1))                                          { ret 4; }
    if (!independent(?T_STATED, ?on) || independent(?T_GATED, ?off))                                   { ret 5; }
    if (independent(?T_DIEL, ?on) || independent(?DEPENDENT, ?on) || !independent(?INDEPENDENT, ?off)) { ret 6; }
    extension.release(?lacking);
    extension.release(?holding);
    ret 0;
}

# a gate's condition frees only what does not remain: under zvkt a secret mask v0, vl or vtype on a diel row, and a
# secret index vs1 on vrgather.vv, are refused naming no condition, while a secret vs2 passes, and without zvkt a
# secret vs2 is refused naming zvkt and a secret v0 naming none
test latency__a_gate_refuses_a_secret_in_what_remains {
    var t: testing.Testing;
    testing.make(?t);
    val without: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?T_CATALOG, "i", diagnostic.START);
    val with:    res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?T_CATALOG, "i,zvkt", diagnostic.START);
    if (sel without.err) { ret 1; }
    if (sel with.err)    { ret 1; }
    var lacking: extension.Selection = without.ok;
    var holding: extension.Selection = with.ok;
    var off:     state.Context       = state.Context{selection: ?lacking, axes: ?state.T_AXES, values: state.initial(?state.T_AXES), view: nil, stream: nil};
    var on:      state.Context       = state.Context{selection: ?holding, axes: ?state.T_AXES, values: state.initial(?state.T_AXES), view: nil, stream: nil};
    val v0:      Input               = Input.register{register.make(0, 0)};
    val vtype:   Input               = Input.register{register.make(1, 1)};
    val vs2:     Input               = Input.operand{1};
    val vs1:     Input               = Input.operand{2};
    val mask:    opt[Refusal]        = latency(?T_DIEL, ?on, ?T_VECTOR_FILE, v0);
    val config:  opt[Refusal]        = latency(?T_DIEL, ?on, ?T_VECTOR_FILE, vtype);
    val index:   opt[Refusal]        = latency(?T_GATHER, ?on, ?T_VECTOR_FILE, vs1);
    if (sel mask.none)                                                                                                             { ret 2; }
    if (sel config.none)                                                                                                           { ret 2; }
    if (sel index.none)                                                                                                            { ret 2; }
    if (mask.some.operand != field.NO_OPERAND || index.some.operand != 2 || mask.some.unmet.len != 0 || index.some.unmet.len != 0) { ret 3; }
    val data:   opt[Refusal] = latency(?T_DIEL, ?on, ?T_VECTOR_FILE, vs2);
    val gather: opt[Refusal] = latency(?T_GATHER, ?on, ?T_VECTOR_FILE, vs2);
    if (sel data.some || sel gather.some) { ret 4; }
    val open: opt[Refusal] = latency(?T_DIEL, ?off, ?T_VECTOR_FILE, vs2);
    val kept: opt[Refusal] = latency(?T_DIEL, ?off, ?T_VECTOR_FILE, v0);
    if (sel open.none) { ret 5; }
    if (sel kept.none) { ret 5; }
    var out:     vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t));
    val spelled: err[A.Error]      = spell(?open.some, ?out);
    if (sel spelled.err || !extension.t_spelled(?out, "secret value in an input the instruction's timing depends on: needs zvkt")) { ret 6; }
    vector.dnit[u8](?out);
    if (kept.some.unmet.len != 0)                                                                                              { ret 7; }
    if (!within(?T_DIEL_KEPT, ?T_GATHER_KEPT) || within(?T_GATHER_KEPT, ?T_DIEL_KEPT) || !within(?T_GATHER_KEPT, ?ALL_INPUTS)) { ret 8; }
    if (within(?ALL_INPUTS, ?T_GATHER_KEPT) || !within(?NO_INPUTS, ?T_DIEL_KEPT) || empty(?T_DIEL_KEPT) || !empty(?NO_INPUTS)) { ret 9; }
    extension.release(?lacking);
    extension.release(?holding);
    ret 0;
}

# a latency refusal names what of its condition the context it was refused under lacks, through the one renderer of
# an unmet requirement, and a set that classifies no timing refuses a constant-time requirement in one wording, while
# one whose timing is not guaranteed only warns and one that classifies its rows holds it
test spell__each_reason_is_worded_once_whoever_refuses {
    var t: testing.Testing;
    testing.make(?t);
    val lacking: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?T_CATALOG, "i", diagnostic.START);
    if (sel lacking.err) { ret 1; }
    var selection: extension.Selection = lacking.ok;
    var ctx:       state.Context       = state.Context{selection: ?selection, axes: ?state.T_AXES, values: state.initial(?state.T_AXES), view: nil, stream: nil};
    val wants:     [6]str              = [6]str{
        "secret value in an input the instruction's timing depends on",
        "control transfer decided by a secret value",
        "memory access whose address or length is formed from a secret value",
        "secret value in an input the instruction's timing depends on: needs zkt",
        "secret value in an input the instruction's timing depends on: needs mode=on",
        "constant time required of code whose instruction set classifies no instruction's timing",
    };
    val none:   Required     = required(Timing.none{});
    val rows:   Required     = required(Timing.rows{});
    val warned: Required     = required(Timing.unguaranteed{});
    val any:    opt[Refusal] = latency(?DEPENDENT, ?ctx, ?T_VECTOR_FILE, Input.operand{0});
    val gated:  opt[Refusal] = latency(?T_GATED, ?ctx, ?T_VECTOR_FILE, Input.operand{1});
    val stated: opt[Refusal] = latency(?T_STATED, ?ctx, ?T_VECTOR_FILE, Input.operand{0});
    if (!sel none.refused)                                                                            { ret 2; }
    if (!sel rows.held)                                                                               { ret 3; }
    if (!sel warned.unguaranteed)                                                                     { ret 3; }
    if (classified(Timing.unguaranteed{}) || classified(Timing.none{}) || !classified(Timing.rows{})) { ret 3; }
    if (sel any.none)                                                                                 { ret 7; }
    if (sel gated.none)                                                                               { ret 7; }
    if (sel stated.none)                                                                              { ret 7; }
    val refusals: [6]Refusal = [6]Refusal{
        any.some,
        refusal(CONTROL, field.NO_OPERAND),
        refusal(MEMORY, 2),
        gated.some,
        stated.some,
        none.refused,
    };
    var i: u32 = 0;
    for (i < 6) {
        var out:     vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t));
        val spelled: err[A.Error]      = spell(?refusals[i], ?out);
        if (sel spelled.err)                      { ret 4; }
        if (!extension.t_spelled(?out, wants[i])) { ret 5; }
        vector.dnit[u8](?out);
        i = i + 1;
    }
    if (message(?refusals[0]) != message(?refusals[3])) { ret 6; }
    extension.release(?selection);
    ret 0;
}
