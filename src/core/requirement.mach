# what a selection and the state code runs under must hold for something to exist
#
# the leaf the extension catalog, the state axes and the diagnostic all build
# on, so a refusal can carry the requirement it names without depending on
# the catalog. a requirement is stated over atoms: an atom is an extension of
# the catalog, by its row, or a value of one of the set's state axes, which
# number on from the catalog's last row axis by axis, so one requirement
# names both what the processor implements and what the code runs under.

# an atom: an extension by its row in its catalog, or a state value numbered on from the catalog's extensions
pub def Id: u32;

# atoms as a pointer to static ids and a count, so a static row can hold a list
# ---
# at:  the first id, nil when the list is empty
# len: how many ids the list holds
pub rec Ids {
    at:  *Id;
    len: u32;
}

pub val NO_IDS: Ids = Ids{at: nil, len: 0};

# one way to meet a requirement: every atom of `all` held and none of `none`
# ---
# all:  the atoms that must all be held
# none: the atoms none of which may be held, as a row that exists only without an extension
pub rec Alternative {
    all:  Ids;
    none: Ids;
}

# what a selection and its state must hold for something to exist, as alternatives: admitted when any one alternative
# holds, and always admitted when there are none
# ---
# at:  the first alternative, nil when there are none
# len: how many alternatives there are
pub rec Requirement {
    at:  *Alternative;
    len: u32;
}

# the requirement of something every selection admits
pub val NO_ALTERNATIVES: Requirement = Requirement{at: nil, len: 0};
