# what a selection must hold for something to exist
#
# the leaf the extension catalog and the diagnostic both build on, so a
# refusal can carry the requirement it names without depending on the catalog.

# an extension, by its row in its catalog
pub def Id: u32;

# extensions as a pointer to static ids and a count, so a static row can hold a list
# ---
# at:  the first id, nil when the list is empty
# len: how many ids the list holds
pub rec Ids {
    at:  *Id;
    len: u32;
}

pub val NO_IDS: Ids = Ids{at: nil, len: 0};

# what a selection must hold for something to exist, as alternatives: admitted when any one
# alternative is fully held, and always admitted when there are none
# ---
# at:  the first alternative, nil when there are none
# len: how many alternatives there are
pub rec Requirement {
    at:  *Ids;
    len: u32;
}

# the requirement of something every selection admits
pub val NO_ALTERNATIVES: Requirement = Requirement{at: nil, len: 0};
