# a set's codec record and its decode dispatch, the shape every set's walks read
#
# a codec names a set's field table, register file, rows and decode dispatch.
# decode finds its row through a static dispatch: a tree of nodes, each
# reading one set-supplied key from the stream and searching its sorted
# entries for a child node or a short list of candidate rows.

use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use masc.core.field;
use masc.core.form;
use masc.core.index;
use masc.core.register;
use masc.core.row;
use masc.core.state;

# a set-supplied dispatch key: a value read from the instruction at the offset given under the context decoded in,
# without consuming it, as x86's 0x40 to 0x4f are inc and dec at width 32 and rex prefixes at 64
pub rec Key {
    name:    str;
    extract: fun(*state.Context, *field.Stream, usize) res[u64, field.Refusal];
}

# a node of a dispatch tree
# ---
# key:   the key it reads
# first: its first entry
# count: how many entries it has, sorted by value
pub rec Node {
    key:   u16;
    first: u32;
    count: u32;
}

# one key value of a node
# ---
# value: the key value
# node:  the child node's index plus one, or 0 for a leaf
# first: a leaf's first candidate
# count: how many candidates a leaf has, tried in preference order
pub rec Entry {
    value: u64;
    node:  u32;
    first: u32;
    count: u32;
}

# a set's decode dispatch, its root at node 0
# ---
# keys:            the keys nodes read
# key_count:       how many keys there are
# nodes:           the nodes
# node_count:      how many nodes there are
# entries:         every node's entries
# entry_count:     how many entries there are
# candidates:      indices of the codec's rows the leaves name
# candidate_count: how many candidates there are
pub rec Dispatch {
    keys:            *Key;
    key_count:       u32;
    nodes:           *Node;
    node_count:      u32;
    entries:         *Entry;
    entry_count:     u32;
    candidates:      *u32;
    candidate_count: u32;
}

# what a set's walks read
# ---
# fields:    the field table
# registers: the register file operands name registers of, nil for a set with none, as spir-v and wasm
# rows:      the set's rows
# keys:      the rows by key, one entry per row
# dispatch:  the decode dispatch over the rows
# element:   the quantity of the register file that is the narrowest element width the set's vector state may set, by
#            its index plus one, which the walks decide the element width rules at, as risc-v's sew_min. 0 for none
# forms:     the choices of the form fields its kinds read and write, each with the marker the syntax spells it by
pub rec Codec {
    fields:    *field.Table;
    registers: *register.File;
    rows:      row.Rows;
    keys:      index.Index;
    dispatch:  *Dispatch;
    element:   u8;
    forms:     form.FormFields;
}
