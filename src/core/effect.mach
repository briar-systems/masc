# the effect record every row references
#
# what an instruction reads and writes beyond what its operands state.
# registers by role are the row's operands and their roles, so they are not
# restated here. every register is named by its row in the set's register
# file, and register sets are bitsets over those rows, so a file of any size is
# covered. flags are rows of the file's flags class, so a set with no flags
# register states empty flag sets. a set with no register file at all, as
# spir-v and wasm, states every set empty, and its operand stack types stay in
# the set itself, since they are typed by the set's own type language. a value
# an instruction of a typed stream pops is named by its depth from the top of
# what it pops, 0 the top, plus one, so 0 names none and a machine row, which
# pops nothing, states none.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use masc.core.field;
use masc.core.operand;
use masc.core.quantity;
use masc.core.register;

# the register row that names no register
pub val NO_ROW: u32 = 0xFFFF_FFFF;

# a set of a register file's rows as a static bitset, bit n of word n / 64 for
# row n, its length at most the words the file spans and an empty set nil
# ---
# words: the words
# len:   how many words there are
pub rec Set {
    words: *u64;
    len:   u32;
}

# the set of no rows
pub val NO_WORDS: Set = Set{words: nil, len: 0};

# flag rows an instruction reads and writes, each flag a row of the file's flags class
# ---
# read:      the flags whose values it reads
# written:   the flags it leaves defined
# undefined: the flags it leaves unspecified. a flag in written and undefined is defined
#            for some operand values only, as x86 of after a shift by more than one
# kept:      the flags some operand values leave as they were, as an x86 shift by a zero count leaves every flag
pub rec Flags {
    read:      Set;
    written:   Set;
    undefined: Set;
    kept:      Set;
}

# the width of an access a typed stream's types decide, its element times its count, each read off the type an operand
# names or holds: the type an id of a type names, or the type of the value any other id names
# ---
# element:    the operand whose type is each element, its pointee for a pointer, as the pointer of spir-v OpenCL.std
#             vloadn, NO_OPERAND for the width's own element
# components: the operand whose type's components count the elements, one for a scalar, as the result type of
#             OpenCL.std vloadn, NO_OPERAND for one element
pub rec Typed {
    element:    u8;
    components: u8;
}

# how many elements an access covers. a register, an operand or a popped value decides the count, which follows from
# its value by whatever arithmetic the instruction applies and need not equal it, so a reader takes the count as
# depending on that value and sizes no access from it. a typed count follows from types alone, which are no value, so
# no value decides it, but a reader that does not resolve the stream's types sizes no access from it either
# ---
# one:      exactly one
# register: a count the value of the register at this row decides, as rcx of x86 rep movs, or vl of a risc-v vector
#           access, whose segment accesses cover nf elements for each and whose mask accesses vl bits rounded up to bytes
# operand:  a count the value of this operand decides, as the size register of aarch64 cpyp or the size id of spir-v
#           OpCopyMemorySized
# unstated: a count no operand, register or popped value decides, as the cache block a risc-v cbo.zero clears, whose
#           size the platform fixes
# popped:   a count the value the instruction pops at this depth from the top of what it pops decides, as the length
#           wasm memory.copy takes from its operand stack
# typed:    a count, and an element when the width's own is 0, the types of operands decide, as spir-v GLSL.std.450
#           Modf writes the pointee of its pointer operand
pub tag Count: u8 {
    one;
    register: u32;
    operand:  u8;
    unstated;
    popped: u8;
    typed:  Typed;
}

# the bits an access covers, element times count, where the element may scale
# with the file's vector length as an sve load's does
pub rec Width {
    element: quantity.Scaled;
    count:   Count;
}

# a memory access the operands do not state whole: an access no memory
# operand names, an access through a pointer an operand holds, or the access
# of a memory operand whose width is not constant, whose own width is then 0
# ---
# role:     read, written or both, NONE for an access through a memory operand, which takes its role
# operand:  the operand whose value is or forms the address, NO_OPERAND when none does
# base:     the register row holding the address when no operand does, as rsi of x86 movs, NO_ROW
#           when an operand does or the address comes from where no row names, as wasm's operand stack
# forming:  further operands whose values form the address, as the stride of a risc-v strided load or a wasm memarg's
#           offset
# offset:   bytes added to the address the operand or base states, as -8 for x86 push's store below rsp at 64 bits,
#           0 for an access at the address itself. it places only an access an operand or base addresses
# width:    the bits it covers
# governor: the operand whose value decides which elements it touches, as an sve governing
#           predicate or a risc-v vector mask, NO_OPERAND when none
# pop:      the popped value that is the address, by its depth plus one, as the address wasm i32.load pops or the
#           index table.get does, 0 for an address no popped value holds
pub rec Access {
    role:     operand.Role;
    operand:  u8;
    base:     u32;
    forming:  operand.Positions;
    offset:   i64;
    width:    Width;
    governor: u8;
    pop:      u8;
}

# accesses as a pointer to static accesses and a count
pub rec Accesses {
    at:  *Access;
    len: u32;
}

pub val NO_ACCESSES: Accesses = Accesses{at: nil, len: 0};

# the kinds of access an ordering orders, as bits
# ---
# READS:   memory reads
# WRITES:  memory writes
# INPUTS:  device input, as risc-v fence's i
# OUTPUTS: device output, as risc-v fence's o
pub def Kinds: u8;

pub val NO_KINDS: Kinds = 0;
pub val READS:    Kinds = 1;
pub val WRITES:   Kinds = 2;
pub val INPUTS:   Kinds = 4;
pub val OUTPUTS:  Kinds = 8;

# how an instruction orders the memory accesses around it beyond its own, as a fence, a barrier, or an atomic access's
# acquire and release. it accesses nothing itself: what it accesses is its accesses'. an order whose before and after
# are both empty orders nothing, and its operands are none. every operand is named by its index plus one, 0 for none
# ---
# before:    the kinds of access before it that it may order against those after it, as risc-v fence's predecessor set
# after:     the kinds of access after it that it may order, as risc-v fence's successor set
# semantics: the operand whose value decides which of those it orders and how strongly, as spir-v's Memory Semantics,
#            0 when before and after state the ordering whole
# failure:   the operand whose value decides the ordering instead when its access writes nothing, as the Unequal
#            semantics of spir-v OpAtomicCompareExchange
# scope:     the operand whose value decides among which agents the ordering holds, as spir-v's memory Scope, 0 for all
# execution: the operand whose value decides which agents it also waits for, as the execution Scope of spir-v
#            OpControlBarrier, 0 for an instruction that waits for none
pub rec Order {
    before:    Kinds;
    after:     Kinds;
    semantics: u8;
    failure:   u8;
    scope:     u8;
    execution: u8;
}

pub val UNORDERED: Order = Order{before: NO_KINDS, after: NO_KINDS, semantics: 0, failure: 0, scope: 0, execution: 0};

# whether `o` orders anything
pub fun ordered(o: *Order) bool {
    ret o.before != NO_KINDS || o.after != NO_KINDS;
}

# how an instruction transfers control
# ---
# NONE:   it falls through
# JUMP:   to its target
# CALL:   to its target, returning after it
# RETURN: to the address its caller left
# TRAP:   to a handler that resumes at the next instruction, so it falls through after it, as a system call (x86
#         syscall, risc-v ecall, aarch64 svc) or a breakpoint a debugger continues from. what it writes by the
#         architecture is its effect's, as rcx and r11 of x86 syscall, and what the handler's convention writes, as a
#         system call's result, is the consumer's
# MERGE:  nowhere: it falls through and names the block a structured construct merges at, as spir-v OpSelectionMerge
#         and OpLoopMerge, which a reader of structured control takes as the end of the construct the next branch opens
# FAULT:  to a handler that never resumes at the next instruction, so nothing falls through, as x86 ud2, aarch64 udf,
#         wasm unreachable and throw, and spir-v OpKill
pub def Transfer: u8;

pub val NONE:   Transfer = 0;
pub val JUMP:   Transfer = 1;
pub val CALL:   Transfer = 2;
pub val RETURN: Transfer = 3;
pub val TRAP:   Transfer = 4;
pub val MERGE:  Transfer = 5;
pub val FAULT:  Transfer = 6;

# where a jump or call goes
# ---
# UNTARGETED: it has no target, as a return, a trap or a fault
# DIRECT:     to a target the instruction encodes, a relative offset, an address or a label
# INDIRECT:   to a target an operand's value holds, a register or memory
# DEPTH:      to the label of the structured block an operand's value counts outward to, as wasm br, br_if and br_table,
#             whose label stack the set's stream keeps
# STRUCTURED: to where the block the instruction opens or splits goes on, as its structure states: wasm if to its
#             block's second arm, or the block's end when it has none, and else to its block's end
pub def Target: u8;

pub val UNTARGETED: Target = 0;
pub val DIRECT:     Target = 1;
pub val INDIRECT:   Target = 2;
pub val DEPTH:      Target = 3;
pub val STRUCTURED: Target = 4;

# a test of one operand's value, the one form every value-dependent effect states its rules in. an operand holding a
# symbol has a value fixed only once the symbol resolves, so a term testing it is never decided and the query answers
# undecided naming that operand, a reader then holding the instruction to Registers.may and Registers.must. check
# admits such a rule, since an immediate an x86 shift count rule tests may hold a symbol
# ---
# register:  the operand is a register whose row in the file is in the set, as risc-v rd being x1 or x5
# immediate: the operand is an immediate of exactly this value
# enumerant: the operand is an enumerant of exactly this value, as a risc-v rounding mode being dyn
#            or an x86 repeat prefix being rep
# condition: the operand is a condition of exactly this value, as an aarch64 condition code being eq
# id:        the operand is an id of exactly this value, as a spir-v id naming a builtin
pub tag Test: u8 {
    register:  Set;
    immediate: i64;
    enumerant: u32;
    condition: u32;
    id:        u32;
}

# one operand's test
pub rec Term {
    operand: u8;
    test:    Test;
}

# terms as a pointer to static terms and a count
pub rec Terms {
    at:  *Term;
    len: u32;
}

pub val NO_TERMS: Terms = Terms{at: nil, len: 0};

# registers an instruction reads and writes. a register in written is certainly written and given a new value, and a
# write that may keep any of a register's old value, as a vector destination's tail or inactive elements or an accrued
# register's flags, is in read as well, since the new value depends on the old. a reader takes the read of a decided
# Answer as live in and its written as a kill and a definition after it, and an undecided one, whose values do not yet
# choose the rule, as Registers.may's read live in and Registers.must's written killed. check refuses a row that breaks
# this where the register file states the facts that decide it, an ACCRUED register or a vector register written while
# the LENGTH register is read
# ---
# read:    the registers it reads, or writes keeping some of their old value
# written: the registers it writes
pub rec Touched {
    read:    Set;
    written: Set;
}

# no registers read or written
pub val NO_TOUCHED: Touched = Touched{read: NO_WORDS, written: NO_WORDS};

# the registers an instruction reads and writes when its operand values meet
# every term, the sets that replace the row's own. a rule has at least one
# term, since the row's own sets are what an instruction has when no rule holds
# ---
# terms:   every one must hold
# touched: the registers it reads and writes then
pub rec RegisterRule {
    terms:   Terms;
    touched: Touched;
}

# register rules as a pointer to static rules and a count
pub rec RegisterRules {
    at:  *RegisterRule;
    len: u32;
}

# registers with no rules, the same whatever the operand values
pub val NO_REGISTER_RULES: RegisterRules = RegisterRules{at: nil, len: 0};

# registers an instruction reads and writes that no operand names, decided by its operand values through its rules. a
# reader asks `implicit` with operand values, or `may` or `must` without them or when `implicit` is undecided, and never
# reads `otherwise` itself, which alone fails open whenever a rule holds. the generator derives `may` and `must`, and
# check proves them
# ---
# otherwise: the registers it touches when no rule holds
# rules:     the registers it touches instead for some operand values, as a risc-v rounding
#            mode of dyn reading frm, or an x86 repeat prefix reading and writing rcx. no two
#            rules can both hold, so their order means nothing
# may:       the union of otherwise and every rule's, what some operand values touch. a write some values make keeping
#            some of the old value is in may.read, as it is in that rule's read
# must:      the intersection of otherwise and every rule's, what every operand value touches. a register in may.written
#            and not in must.written is written by some values only, so a reader with no values, or with an undecided
#            answer, kills must.written alone
pub rec Ruled {
    otherwise: Touched;
    rules:     RegisterRules;
    may:       Touched;
    must:      Touched;
}

# registers an instruction reads and writes that no operand names and no operand value decides, as an encoding a source
# states by its fields with no row's facts. `implicit` is always undecided for it, so a reader takes `may` and `must`
# ---
# may:  every register it may read and write, which may name registers the selection lacks, since a reader takes it as
#       live in and clobbered, which is sound whatever the encoding does
# must: the registers it surely reads and writes, within may, which the walks hold to the selection
pub rec Opaque {
    may:  Touched;
    must: Touched;
}

# registers an instruction reads and writes that no operand names, as rsp of x86 push or the link register of aarch64
# bl. flag rows are stated under flags
# ---
# ruled:  decided by operand values through rules
# opaque: decided by no operand value
pub tag Registers: u8 {
    ruled:  Ruled;
    opaque: Opaque;
}

# a transfer an instruction has when its operand values meet every term, the
# shape that replaces the row's own. a rule has at least one term, since the
# control's own fields are what an instruction has when no rule holds. the
# operand holding the target and the value choosing it are kept unless the rule
# leaves no target, and the condition unless the rule is not conditional
# ---
# terms:       every one must hold
# transfer:    what it does then
# target:      where it goes then
# conditional: whether it may fall through then
pub rec Rule {
    terms:       Terms;
    transfer:    Transfer;
    target:      Target;
    conditional: bool;
}

# rules as a pointer to static rules and a count
pub rec Rules {
    at:  *Rule;
    len: u32;
}

# a control with no rules, a fixed kind
pub val NO_RULES: Rules = Rules{at: nil, len: 0};

# an instruction's control transfer
# ---
# transfer:    what it does
# target:      where a jump or call goes
# conditional: whether it may fall through instead, decided by the values it reads, or by its condition when it states
#              one
# operand:     the operand holding the target, NO_OPERAND when the target is implicit or structural
# rules:       the transfers it has instead for some operand values, as risc-v jalr being a return
#              when it writes x0 and reads ra, and the fields above when none holds. no two rules
#              can both hold, so their order means nothing. a fixed kind states none
# condition:   the popped value that alone decides whether a conditional transfer is taken, by its depth plus one, as
#              the i32 wasm br_if and if pop, 0 for one decided by every value it reads
# chooses:     the popped value that chooses the target, by its depth plus one, as wasm br_table's index, the table
#              index call_indirect pops and the reference call_ref pops, 0 for none
pub rec Control {
    transfer:    Transfer;
    target:      Target;
    conditional: bool;
    operand:     u8;
    rules:       Rules;
    condition:   u8;
    chooses:     u8;
}

# whether control may go on to the next instruction after one of control `c`: it transfers nowhere, merges, calls or
# traps, each coming back, or its transfer is conditional
pub fun falls(c: *Control) bool {
    ret c.transfer == NONE || c.transfer == CALL || c.transfer == TRAP || c.transfer == MERGE || c.conditional;
}

# a change to the stack pointer of bytes plus the value of an operand
# ---
# bytes:   the fixed part, negative toward a downward stack's growth
# operand: an immediate operand whose value is added, as x86 ret imm16's, NO_OPERAND when none
pub rec Delta {
    bytes:   i32;
    operand: u8;
}

# what an instruction does to the stack pointer, the register of the file
# flagged STACK, beyond what an operand naming it states, as an address
# writeback of aarch64 stp with sp as base states its own change
# ---
# none:   nothing
# delta:  it changes by a delta, as x86 push, pop, call and ret
# opaque: it changes by an amount no delta states, as x86 leave and enter
pub tag Stack: u8 {
    none;
    delta: Delta;
    opaque;
}

# the register a relation writes
# ---
# operand: the register operand at this index
# row:     the register at this row of the file, which no operand names, as rsp of x86 leave
pub tag Place: u8 {
    operand: u8;
    row:     u32;
}

# the register a relation reads the value it starts from
# ---
# operand: the register operand at this index
# row:     the register at this row of the file, which no operand names, as rbp of x86 leave
# base:    the base register of the memory operand at this index, as x86 lea's. an address of that operand with an
#          index register, a symbol or a mode other than OFFSET has no base value alone, so the relation states nothing
pub tag Source: u8 {
    operand: u8;
    row:     u32;
    base:    u8;
}

# what a relation adds to the value it starts from
# ---
# none:         nothing, as a copy
# immediate:    the value of the immediate operand at this index. one holding a symbol has no value until it resolves,
#               so the relation states nothing
# displacement: the displacement of the memory operand at this index, the one whose base the relation starts from
pub tag Addend: u8 {
    none;
    immediate:    u8;
    displacement: u8;
}

# a register's value as another's plus a number: from, plus the addend shifted left by step times the value of the
# shift operand and negated when the encoding subtracts it, plus the constant, as risc-v addi, aarch64 sub sp, sp, #1,
# lsl #12 and x86 lea rbp, [rsp + 16]
# ---
# from:     the register it starts from
# by:       the addend
# negated:  whether the addend is subtracted, as a sub's immediate
# shift:    the immediate or enumerant operand whose value times step is the addend's left shift, as aarch64's
#           `lsl #12` of value 1, NO_OPERAND for none
# step:     the bits each unit of the shift operand's value shifts by, 0 when there is no shift operand
# constant: a number added whatever the operands
pub rec Offset {
    from:     Source;
    by:       Addend;
    negated:  bool;
    shift:    u8;
    step:     u8;
    constant: i64;
}

# what a relation states the written register holds. a reader takes a member it does not know as stating nothing,
# which is sound, so a member is added without changing any reader: register plus register, a scaled index, and a
# mask, as x86 `and rsp, -16` aligning the stack, are drop-in members
# ---
# offset: another register's value plus a number
# formed: the value the instruction forms from the operand at this index and its own address alone, the value a
#         relocation of a symbol in that operand is defined against, as risc-v auipc's pc plus its immediate shifted,
#         lui's immediate shifted, aarch64 adrp's page, adr's target and x86 mov's immediate. a reader knows its number
#         only through the relocation, so `affine` states nothing of it
pub tag Holds: u8 {
    offset: Offset;
    formed: u8;
}

# a value an instruction writes, stated as a function of the values it reads, so a reader can follow a register
# through code, as the walk follows the stack and frame pointers. it holds in the low bits of the narrower of the
# registers it names, the bits the operation computes, and states nothing of a wider register's bits above them,
# which the write itself states (`operand.Write`). a change to the stack pointer no operand names is the stack
# pointer's own (`Stack`), and an address writeback its address's (`operand.Mode`)
# ---
# to:    the register written
# holds: what it holds after
pub rec Relation {
    to:    Place;
    holds: Holds;
}

# relations as a pointer to static relations and a count, each register written at most once
pub rec Relations {
    at:  *Relation;
    len: u32;
}

pub val NO_RELATIONS: Relations = Relations{at: nil, len: 0};

# a relation under operand values: the register written holds the register read plus `by`, in the low bits of the
# narrower of the two
# ---
# to:   the register written
# from: the register read
# by:   the number added, wrapping as the registers' bits do
pub rec Affine {
    to:   register.Id;
    from: register.Id;
    by:   i64;
}

# how long an instruction takes, as a scheduler weighs it
# ---
# ONE:     a single-cycle operation
# FEW:     a pipelined multi-cycle operation, as a multiply or most floating point
# MANY:    a long unpipelined operation, as a divide or a square root
# SERIAL:  microcoded or serializing, as x86 cpuid or rep movs
# UNTIMED: a typed stream's instruction a later compiler schedules, as spir-v and wasm
pub def Latency: u8;

pub val ONE:     Latency = 0;
pub val FEW:     Latency = 1;
pub val MANY:    Latency = 2;
pub val SERIAL:  Latency = 3;
pub val UNTIMED: Latency = 4;

# an operand that must be one register, as the cl count of an x86 variable
# shift or the rax and rdx of a one-operand multiply. encode refuses any other
# register, and decode fills it when no field holds it
# ---
# operand:  the operand
# register: the register's row in the file
pub rec Fixed {
    operand:  u8;
    register: u32;
}

# fixed operands as a pointer to static fixed operands and a count
pub rec Fixeds {
    at:  *Fixed;
    len: u32;
}

pub val NO_FIXEDS: Fixeds = Fixeds{at: nil, len: 0};

# a write of a register no operand names that states what it leaves, as an operand's write states it, where the
# row's encoding decides it: x86 vex vpcmpistrm writes xmm0 and zeroes the rest of its vector register, where legacy
# pcmpistrm keeps it. a register the effect writes and no entry names writes as its row states
# ---
# row:   the register's row in the file, one the effect may write
# write: what the write leaves
pub rec ImplicitWrite {
    row:   u32;
    write: operand.Write;
}

# a register an instruction writes and what the write leaves, the one shape of a write whoever states it: an operand by
# its operand's write, a register no operand names by its effect's (`ImplicitWrite`), else as its row states
# ---
# at:    the register
# write: what the write leaves
pub rec Written {
    at:    register.Id;
    write: operand.Write;
}

# implicit writes as a pointer to static entries and a count, each row at most once
pub rec Writes {
    at:  *ImplicitWrite;
    len: u32;
}

pub val NO_WRITES: Writes = Writes{at: nil, len: 0};

# a type on a typed stream's operand stack, in the set's own type language (`masc.core.stream`). a signature states
# which types it takes and leaves, and where a type turns on what the stream defined, it names what the type is read
# from: the set's stream hooks resolve it under the stream's state, so the effect holds the reference and never the
# resolution
# ---
# fixed:       the type of this code in the set's types, as wasm's i32
# variable:    the type a type variable of this number binds, the same wherever it appears in one signature, as the t of
#              wasm `select`, which pops two values of one type and pushes one
# operand:     the types the operand of this index states, which the stream hooks resolve: one type for an operand that
#              names one, as wasm `select t`, a local's or a memory's address type, and a spir-v result type operand,
#              and a sequence for an operand naming a function type, a block type or a label, its params where popped
#              and its results where pushed, a label's results being the types a branch to it carries, as wasm `call`,
#              `block` and `br_table`
# results:     the results of the function the stream is in, which no operand names, as wasm `return` pops. the stream
#              hooks resolve it from the state they keep for the function being read (`stream.Hooks.make`, `begin`)
# polymorphic: any sequence of types, as the stack after wasm `unreachable`, `br` or `br_table`, which a validator
#              takes as matching whatever follows
pub tag TypeRef: u8 {
    fixed:    u32;
    variable: u8;
    operand:  u8;
    results;
    polymorphic;
}

# types as a pointer to static types and a count
pub rec Types {
    at:  *TypeRef;
    len: u32;
}

pub val NO_TYPES: Types = Types{at: nil, len: 0};

# what an instruction of a typed stream takes from and leaves on its operand stack, deepest first, as wasm states an
# instruction's type. a set whose stream has no operand stack, a machine set or spir-v, states none
# ---
# pops:   the types it takes
# pushes: the types it leaves
pub rec Signature {
    pops:   Types;
    pushes: Types;
}

# the signature of an instruction that takes and leaves nothing
pub val NO_SIGNATURE: Signature = Signature{pops: NO_TYPES, pushes: NO_TYPES};

# the operands by which an instruction of a typed stream defines a value in static single assignment form, as spir-v's
# result id and result type, each by its index plus one, 0 for none, so a machine row states none
# ---
# defines: the id operand naming the value it defines
# type:    the id operand naming that value's type
pub rec Values {
    defines: u8;
    type:    u8;
}

# the values of an instruction that defines none
pub val NO_VALUES: Values = Values{defines: 0, type: 0};

# an entry of one of a typed stream's index spaces that an instruction reads or writes through the operand naming it,
# as wasm local.get reads the local its operand names and global.set writes the global. the space is the operand's
# (`operand.Typed.space`) and the entry its value
# ---
# operand: the id operand naming the entry
# role:    whether the instruction reads it, writes it or both
pub rec Entry {
    operand: u8;
    role:    operand.Role;
}

# entries as a pointer to static entries and a count
pub rec Entries {
    at:  *Entry;
    len: u32;
}

pub val NO_ENTRIES: Entries = Entries{at: nil, len: 0};

# what an instruction does to the structured blocks of a typed stream, whose branches name a block by how many blocks
# out from the innermost it is (DEPTH). a block's params are the values its opening instruction pops and pushes again,
# as the type its block type operand states both ways, which pass into the block as they are, and its results the
# values that instruction pushes, which the block leaves where it closes
# ---
# FLAT:    nothing
# OPENS:   it opens a block whose label is its end, so a branch to it leaves the block, as wasm block and if
# LOOPS:   it opens a block whose label is its start, so a branch to it runs the block again, as wasm loop
# CATCHES: it opens a block whose label is its end and whose catches take control to labels from any throw in it, as
#          wasm try_table
# SPLITS:  it ends the first arm of the innermost block and starts its second, as wasm else
# CLOSES:  it closes the innermost block, as wasm end, the function's body at its outermost
pub def Structure: u8;

pub val FLAT:    Structure = 0;
pub val OPENS:   Structure = 1;
pub val LOOPS:   Structure = 2;
pub val CATCHES: Structure = 3;
pub val SPLITS:  Structure = 4;
pub val CLOSES:  Structure = 5;

# whether an instruction of structure `s` opens a block
pub fun opens(s: Structure) bool {
    ret s == OPENS || s == LOOPS || s == CATCHES;
}

# the effect of a row
# ---
# implicit:  registers no operand names
# flags:     flags read and written
# memory:    accesses the operands do not state whole
# control:   the control transfer
# stack:     the change to the stack pointer
# latency:   the latency class
# fixed:     the operands that must be one register
# writes:    what the writes of registers no operand names leave, where the encoding decides it
# signature: what it takes from and leaves on a typed stream's operand stack, none for a set with no operand stack
# values:    the operands by which it defines a value of a typed stream, none for a row that defines none
# entries:   the index space entries it reads and writes through the operands naming them, none for a set with no
#            typed stream
# structure: what it does to a typed stream's structured blocks, FLAT for a set whose stream has none
# relations: the values it writes as functions of the values it reads, none where no relation is stated
# order:     how it orders the memory accesses around it, UNORDERED for none
pub rec Effect {
    implicit:  Registers;
    flags:     Flags;
    memory:    Accesses;
    control:   Control;
    stack:     Stack;
    latency:   Latency;
    fixed:     Fixeds;
    writes:    Writes;
    signature: Signature;
    values:    Values;
    entries:   Entries;
    structure: Structure;
    relations: Relations;
    order:     Order;
}

# what the effect's write of the register at row `at` leaves, operand.AS_ROW when no entry states it
pub fun write_of(e: *Effect, at: u32) operand.Write {
    var i: u32 = 0;
    for (i < e.writes.len) {
        if (e.writes.at[i].row == at) { ret e.writes.at[i].write; }
        i = i + 1;
    }
    ret operand.AS_ROW;
}

# the words a set over the rows of `file` spans
pub fun words(file: *register.File) u32 {
    ret (file.register_count + 63) / 64;
}

# whether `set`, over the rows of `file`, holds the register `reg`
pub fun has(file: *register.File, set: Set, reg: register.Id) bool {
    ret register.bit(file, set.words, set.len, reg);
}

# whether no value meets both tests, which are of one operand: register sets
# that share no row, immediates that differ, or a register against an immediate
pub fun disjoint(a: *Test, b: *Test) bool {
    if (sel a.register) {
        if (sel b.register) {
            val x: Set = a.register;
            val y: Set = b.register;
            var w: u32 = 0;
            for (w < x.len && w < y.len) {
                if ((x.words[w] & y.words[w]) != 0) { ret false; }
                w = w + 1;
            }
        }
        ret true;
    }
    if (sel a.immediate) {
        if (sel b.immediate) {
            val x: i64 = a.immediate;
            val y: i64 = b.immediate;
            ret x != y;
        }
        ret true;
    }
    if (sel a.enumerant) {
        if (sel b.enumerant) {
            val x: u32 = a.enumerant;
            val y: u32 = b.enumerant;
            ret x != y;
        }
        ret true;
    }
    if (sel a.condition) {
        if (sel b.condition) {
            val x: u32 = a.condition;
            val y: u32 = b.condition;
            ret x != y;
        }
        ret true;
    }
    if (sel a.id) {
        if (sel b.id) {
            val x: u32 = a.id;
            val y: u32 = b.id;
            ret x != y;
        }
    }
    ret true;
}

# whether no instruction meets both conjunctions of terms, which holds when
# some operand they both test has disjoint tests
pub fun exclusive(a: Terms, b: Terms) bool {
    var i: u32 = 0;
    for (i < a.len) {
        var k: u32 = 0;
        for (k < b.len) {
            if (a.at[i].operand == b.at[k].operand && disjoint(?a.at[i].test, ?b.at[k].test)) { ret true; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret false;
}

# the rule a query over operand values cannot decide, and the operand left open
# ---
# rule:    the position of the first rule no term of which is false but one tests an operand whose value is not known
# operand: the operand that term tests
pub rec Pending {
    rule:    u32;
    operand: u8;
}

# why a query gives no answer
# ---
# open:       a rule is left open, since an operand it tests has no known value yet, as a register operand before
#             allocation or an immediate holding a symbol before it resolves
# opaque:     no operand value decides it, as the registers of an encoding stated with no row's facts (`Opaque`)
# configured: the registers this operand's groups cover turn on configuration state the query was not given, as a
#             risc-v vector operand's on vtype (`masc.core.config`)
# reserved:   the configuration state the query was given cannot form this operand's groups, so no instruction of
#             those values runs under it
# scaled:     the multiplier of a quantity the context leaves to the implementation decides it, the slot that binds it
#             named, as an sve register's width under no fixed vector length
pub tag Undecided: u8 {
    open: Pending;
    opaque;
    configured: u8;
    reserved:   u8;
    scaled:     u8;
}

# what a query over operand values answers, decided only when every rule that may hold is decided
# ---
# decided:   the answer
# undecided: why it is not
pub tag Answer[T]: u8 {
    decided:   T;
    undecided: Undecided;
}

# whether the value of the operand `term` tests is known: given, not a symbol, whose value is fixed only once it
# resolves, and not none for an operand that always takes one. an optional operand whose value is none is absent,
# which is a value
pub fun known(operands: *operand.Operand, values: operand.Values, term: *Term) bool {
    if (term.operand::u32 >= values.len) { ret false; }
    val v: operand.Value = values.at[term.operand];
    if (sel v.symbol) { ret false; }
    ret !sel v.none || operands[term.operand].quantity != operand.ONE;
}

# whether `term`, whose operand's value is known, holds over the operand values of an instruction. check guarantees
# the operand is one the instruction has and of the test's kind, so the false for any other is a guard that no
# registered set reaches
fun holds(file: *register.File, term: *Term, values: operand.Values) bool {
    if (term.operand >= values.len) { ret false; }
    val v: operand.Value = values.at[term.operand];
    if (sel term.test.register) {
        if (!sel v.register) { ret false; }
        ret has(file, term.test.register, v.register);
    }
    if (sel term.test.immediate) { ret sel v.immediate && v.immediate == term.test.immediate; }
    if (sel term.test.enumerant) { ret sel v.enumerant && v.enumerant.value == term.test.enumerant; }
    if (sel term.test.condition) { ret sel v.condition && v.condition == term.test.condition; }
    ret sel term.test.id && (sel v.id && v.id == term.test.id);
}

# whether every one of `terms` holds over the operand values of an instruction, every value they test known
pub fun meets(file: *register.File, terms: Terms, values: operand.Values) bool {
    var k: u32 = 0;
    for (k < terms.len) {
        if (!holds(file, ?terms.at[k], values)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether `terms` hold over the operand values of an instruction whose operands are `operands`: false when a term
# whose operand's value is known fails, else undecided naming the first term whose operand's value is not known
fun decide(file: *register.File, operands: *operand.Operand, terms: Terms, values: operand.Values, rule: u32) Answer[bool] {
    var open: u8  = field.NO_OPERAND;
    var k:    u32 = 0;
    for (k < terms.len) {
        val term: *Term = ?terms.at[k];
        if (!known(operands, values, term)) {
            if (open == field.NO_OPERAND) { open = term.operand; }
        }
        or (!holds(file, term, values)) { ret Answer[bool].decided{false}; }
        k = k + 1;
    }
    if (open != field.NO_OPERAND) { ret Answer[bool].undecided{Undecided.open{Pending{rule: rule, operand: open}}}; }
    ret Answer[bool].decided{true};
}

# the control transfer of the instruction whose operands are `operands` and operand values `values`: the effect's one
# rule whose terms all hold, else the effect's own when every rule is false, else undecided naming the first rule an
# operand with no known value leaves open
pub fun control(file: *register.File, operands: *operand.Operand, e: *Effect, values: operand.Values) Answer[Control] {
    var open: opt[Undecided] = opt[Undecided].none{};
    var i:    u32            = 0;
    for (i < e.control.rules.len) {
        val rule:  *Rule        = ?e.control.rules.at[i];
        val met:   Answer[bool] = decide(file, operands, rule.terms, values, i);
        val first: bool         = sel open.none;
        if (sel met.undecided) {
            if (first) { open = opt[Undecided].some{met.undecided}; }
        }
        if (sel met.decided) {
            if (met.decided) {
                var at:      u8 = e.control.operand;
                var chooses: u8 = e.control.chooses;
                var decides: u8 = e.control.condition;
                if (rule.target == UNTARGETED) {
                    at      = field.NO_OPERAND;
                    chooses = 0;
                }
                if (!rule.conditional) { decides = 0; }
                ret Answer[Control].decided{Control{transfer: rule.transfer, target: rule.target, conditional: rule.conditional, operand: at, rules: NO_RULES, condition: decides, chooses: chooses}};
            }
        }
        i = i + 1;
    }
    if (sel open.some) { ret Answer[Control].undecided{open.some}; }
    ret Answer[Control].decided{e.control};
}

# the registers no operand names that the instruction whose operands are `operands` and operand values `values`
# reads and writes: the effect's one register rule whose terms all hold, else the effect's own when every rule is
# false, else undecided naming the first rule an operand with no known value leaves open, and undecided as opaque for
# registers no operand value decides
pub fun implicit(file: *register.File, operands: *operand.Operand, e: *Effect, values: operand.Values) Answer[Touched] {
    val g: *Registers = ?e.implicit;
    if (sel g.opaque) { ret Answer[Touched].undecided{Undecided.opaque{}}; }
    ret ruled(file, operands, ?g.ruled, values);
}

# the registers `g` decides for the operand values `values`
fun ruled(file: *register.File, operands: *operand.Operand, g: *Ruled, values: operand.Values) Answer[Touched] {
    var open: opt[Undecided] = opt[Undecided].none{};
    var i:    u32            = 0;
    for (i < g.rules.len) {
        val rule:  *RegisterRule = ?g.rules.at[i];
        val met:   Answer[bool]  = decide(file, operands, rule.terms, values, i);
        val first: bool          = sel open.none;
        if (sel met.undecided) {
            if (first) { open = opt[Undecided].some{met.undecided}; }
        }
        if (sel met.decided) {
            if (met.decided) { ret Answer[Touched].decided{rule.touched}; }
        }
        i = i + 1;
    }
    if (sel open.some) { ret Answer[Touched].undecided{open.some}; }
    ret Answer[Touched].decided{g.otherwise};
}

# the registers no operand names that some instruction of the effect's row
# reads and writes, for a reader with no operand values, as a constant-time walk
# or a clobber list
pub fun may(e: *Effect) Touched {
    val g: *Registers = ?e.implicit;
    if (sel g.opaque) { ret g.opaque.may; }
    ret g.ruled.may;
}

# the registers no operand names that every instruction of the effect's row
# reads and writes, for a reader that needs a definite write, as a liveness kill
pub fun must(e: *Effect) Touched {
    val g: *Registers = ?e.implicit;
    if (sel g.opaque) { ret g.opaque.must; }
    ret g.ruled.must;
}

# word `w` of `set`, zero past its words
fun word(set: Set, w: u32) u64 {
    if (w >= set.len) { ret 0; }
    ret set.words[w];
}

# whether `got`, over `count` words, is the union (else the intersection) of the read (else written) sets of `g` and its rules
fun combined(g: *Ruled, count: u32, written: bool, union: bool, got: Set) bool {
    var w: u32 = 0;
    for (w < count) {
        var acc: u64 = word(g.otherwise.read, w);
        if (written) { acc = word(g.otherwise.written, w); }
        var i: u32 = 0;
        for (i < g.rules.len) {
            var x: u64 = word(g.rules.at[i].touched.read, w);
            if (written) { x = word(g.rules.at[i].touched.written, w); }
            if (union)   { acc = acc | x; }
            or           { acc = acc & x; }
            i = i + 1;
        }
        if (acc != word(got, w)) { ret false; }
        w = w + 1;
    }
    ret true;
}

# whether `may` and `must` of `g`, over the first `count` words of every set, are the union and the intersection of its own
# sets and its rules'
pub fun bounded(g: *Ruled, count: u32) bool {
    ret combined(g, count, false, true, g.may.read) && combined(g, count, true, true, g.may.written) && combined(g, count, false, false, g.must.read) && combined(g, count, true, false, g.must.written);
}

# the register operand `op` must be, none when it is not fixed
pub fun fixed(file: *register.File, e: *Effect, op: u8) opt[register.Id] {
    var i: u32 = 0;
    for (i < e.fixed.len) {
        if (e.fixed.at[i].operand == op) { ret opt[register.Id].some{register.id_of(?file.registers[e.fixed.at[i].register])}; }
        i = i + 1;
    }
    ret opt[register.Id].none{};
}

# the register at row `at` of `file`, register.NONE past its rows
fun row_register(file: *register.File, at: u32) register.Id {
    if (at >= file.register_count) { ret register.NONE; }
    ret register.id_of(?file.registers[at]);
}

# the register operand `op` holds among `values`, register.NONE when it holds none
fun register_held(values: operand.Values, op: u8) register.Id {
    if (op::u32 >= values.len) { ret register.NONE; }
    val v: *operand.Value = ?values.at[op];
    if (sel v.register) { ret v.register; }
    ret register.NONE;
}

# the address operand `op` holds among `values` when it is a base plus a number alone: a base, no index or symbol, and
# mode OFFSET
fun plain_address(values: operand.Values, op: u8) opt[operand.Address] {
    if (op::u32 >= values.len) { ret opt[operand.Address].none{}; }
    val v: *operand.Value = ?values.at[op];
    if (!sel v.memory) { ret opt[operand.Address].none{}; }
    val a: operand.Address = v.memory;
    if (a.base == register.NONE || a.index != register.NONE || a.mode != operand.OFFSET || a.symbol.id != operand.NO_SYMBOL) { ret opt[operand.Address].none{}; }
    ret opt[operand.Address].some{a};
}

# the number operand `op` holds among `values`, an immediate's value or an enumerant's
fun number_held(values: operand.Values, op: u8) opt[i64] {
    if (op::u32 >= values.len) { ret opt[i64].none{}; }
    val v: *operand.Value = ?values.at[op];
    if (sel v.immediate) { ret opt[i64].some{v.immediate}; }
    if (sel v.enumerant) { ret opt[i64].some{v.enumerant.value::i64}; }
    ret opt[i64].none{};
}

# relation `r` of an instruction over `file` under its operand values, none where they give no number: an operand
# holding no value or a symbol, an address with an index, a symbol or a mode other than OFFSET, a shift past the
# register's bits, or a member of Holds this reads as stating nothing
pub fun affine(file: *register.File, r: *Relation, values: operand.Values) opt[Affine] {
    var to: register.Id = register.NONE;
    if (sel r.to.operand)    { to = register_held(values, r.to.operand); }
    or (sel r.to.row)        { to = row_register(file, r.to.row); }
    if (to == register.NONE) { ret opt[Affine].none{}; }
    if (sel r.holds.offset)  { ret offset(file, to, ?r.holds.offset, values); }
    ret opt[Affine].none{};
}

# offset `o` writing `to` under operand values `values`, as `affine` reads it
fun offset(file: *register.File, to: register.Id, o: *Offset, values: operand.Values) opt[Affine] {
    var from: register.Id = register.NONE;
    if (sel o.from.operand) { from = register_held(values, o.from.operand); }
    or (sel o.from.row)     { from = row_register(file, o.from.row); }
    or (sel o.from.base) {
        val a: opt[operand.Address] = plain_address(values, o.from.base);
        if (sel a.some) { from = a.some.base; }
    }
    if (from == register.NONE) { ret opt[Affine].none{}; }
    var by: u64 = 0;
    if (sel o.by.immediate) {
        val n: opt[i64] = number_held(values, o.by.immediate);
        if (sel n.none) { ret opt[Affine].none{}; }
        by = n.some::u64;
    }
    or (sel o.by.displacement) {
        val a: opt[operand.Address] = plain_address(values, o.by.displacement);
        if (sel a.none) { ret opt[Affine].none{}; }
        by = a.some.disp::u64;
    }
    if (o.shift != field.NO_OPERAND) {
        val n: opt[i64] = number_held(values, o.shift);
        if (sel n.none) { ret opt[Affine].none{}; }
        if (n.some < 0) { ret opt[Affine].none{}; }
        val bits: u64 = n.some::u64 * o.step::u64;
        if (bits >= 64) { ret opt[Affine].none{}; }
        by = by << bits;
    }
    if (o.negated) { by = 0 - by; }
    ret opt[Affine].some{Affine{to: to, from: from, by: (by + o.constant::u64)::i64}};
}
