# the effect record every row references
#
# what an instruction reads and writes beyond what its operands state.
# registers by role are the row's operands and their roles, so they are not
# restated here. every register is named by its row in the set's register
# file, and register sets are bitsets over those rows, so a file of any size is
# covered. flags are rows of the file's flags class, so a set with no flags
# register states empty flag sets. a set with no register file at all, as
# spir-v and wasm, states every set empty, and its operand stack types stay in
# the set itself, since they are typed by the set's own type language.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use masc.core.field;
use masc.core.index;
use masc.core.operand;
use masc.core.register;

# the register row that names no register
pub val NO_ROW: u32 = 0xFFFF_FFFF;

# a set of a register file's rows as a static bitset, bit n of word n / 64 for
# row n, its length at most the words the file spans and an empty set nil
# ---
# words: the words
# len:   how many words there are
pub rec Set {
    words: *u64;
    len:   u32;
}

# flag rows an instruction reads and writes, each flag a row of the file's flags class
# ---
# read:      the flags whose values it reads
# written:   the flags it leaves defined
# undefined: the flags it leaves unspecified. a flag in written and undefined is defined
#            for some operand values only, as x86 of after a shift by more than one
# kept:      the flags some operand values leave as they were, as an x86 shift by a zero count leaves every flag
pub rec Flags {
    read:      Set;
    written:   Set;
    undefined: Set;
    kept:      Set;
}

# how many elements an access covers
# ---
# one:      exactly one
# register: the value of the register at this row, as rcx of x86 rep movs or vl of a risc-v vector load
# operand:  the value of this operand, as the size register of aarch64 cpyp or the size id of spir-v OpCopyMemorySized
# unstated: a value no operand or register names, as the length wasm memory.copy takes from its operand stack
pub tag Count: u8 {
    one;
    register: u32;
    operand:  u8;
    unstated;
}

# the bits an access covers, element times count, where the element may scale
# with the file's vector length as an sve load's does
pub rec Width {
    element: register.Scaled;
    count:   Count;
}

# a memory access the operands do not state whole: an access no memory
# operand names, an access through a pointer an operand holds, or the access
# of a memory operand whose width is not constant, whose own width is then 0
# ---
# role:     read, written or both, NONE for an access through a memory operand, which takes its role
# operand:  the operand whose value is or forms the address, NO_OPERAND when none does
# base:     the register row holding the address when no operand does, as rsi of x86 movs, NO_ROW
#           when an operand does or the address comes from where no row names, as wasm's operand stack
# forming:  further operands whose values form the address, as the stride of a risc-v strided load
# width:    the bits it covers
# governor: the operand whose value decides which elements it touches, as an sve governing
#           predicate or a risc-v vector mask, NO_OPERAND when none
pub rec Access {
    role:     operand.Role;
    operand:  u8;
    base:     u32;
    forming:  operand.Positions;
    width:    Width;
    governor: u8;
}

# accesses as a pointer to static accesses and a count
pub rec Accesses {
    at:  *Access;
    len: u32;
}

pub val NO_ACCESSES: Accesses = Accesses{at: nil, len: 0};

# how an instruction transfers control
# ---
# NONE:   it falls through
# JUMP:   to its target
# CALL:   to its target, returning after it
# RETURN: to the address its caller left
# TRAP:   to a handler, as a system call, a breakpoint or wasm unreachable
pub def Transfer: u8;

pub val NONE:   Transfer = 0;
pub val JUMP:   Transfer = 1;
pub val CALL:   Transfer = 2;
pub val RETURN: Transfer = 3;
pub val TRAP:   Transfer = 4;

# where a jump or call goes
# ---
# UNTARGETED: it has no target, as a return or a trap
# DIRECT:     to a target the instruction encodes, a relative offset, an address or a label
# INDIRECT:   to a target an operand's value holds, a register or memory
pub def Target: u8;

pub val UNTARGETED: Target = 0;
pub val DIRECT:     Target = 1;
pub val INDIRECT:   Target = 2;

# a test of one operand's value, the one form every value-dependent effect states its rules in
# ---
# register:  the operand is a register whose row in the file is in the set, as risc-v rd being x1 or x5
# immediate: the operand is an immediate of exactly this value
# enumerant: the operand is an enumerant of exactly this value, as a risc-v rounding mode being dyn
#            or an x86 repeat prefix being rep
# condition: the operand is a condition of exactly this value, as an aarch64 condition code being eq
# id:        the operand is an id of exactly this value, as a spir-v id naming a builtin
pub tag Test: u8 {
    register:  Set;
    immediate: i64;
    enumerant: u32;
    condition: u32;
    id:        u32;
}

# one operand's test
pub rec Term {
    operand: u8;
    test:    Test;
}

# terms as a pointer to static terms and a count
pub rec Terms {
    at:  *Term;
    len: u32;
}

pub val NO_TERMS: Terms = Terms{at: nil, len: 0};

# registers an instruction reads and writes. a register in written is certainly written and given a new value, and a
# write that may keep any of a register's old value, as a vector destination's tail or inactive elements or an accrued
# register's flags, is in read as well, since the new value depends on the old. a reader takes the read of a decided
# Answer as live in and its written as a kill and a definition after it, and an undecided one, whose values do not yet
# choose the rule, as Registers.may's read live in and Registers.must's written killed. check refuses a row that breaks
# this where the register file states the facts that decide it, an ACCRUED register or a vector register written while
# the LENGTH register is read
# ---
# read:    the registers it reads, or writes keeping some of their old value
# written: the registers it writes
pub rec Touched {
    read:    Set;
    written: Set;
}

# no registers read or written
pub val NO_TOUCHED: Touched = Touched{read: Set{words: nil, len: 0}, written: Set{words: nil, len: 0}};

# the registers an instruction reads and writes when its operand values meet
# every term, the sets that replace the row's own. a rule has at least one
# term, since the row's own sets are what an instruction has when no rule holds
# ---
# terms:   every one must hold
# touched: the registers it reads and writes then
pub rec RegisterRule {
    terms:   Terms;
    touched: Touched;
}

# register rules as a pointer to static rules and a count
pub rec RegisterRules {
    at:  *RegisterRule;
    len: u32;
}

# registers with no rules, the same whatever the operand values
pub val NO_REGISTER_RULES: RegisterRules = RegisterRules{at: nil, len: 0};

# registers an instruction reads and writes that no operand names, as rsp of
# x86 push or the link register of aarch64 bl. flag rows are stated under flags.
# a reader asks `implicit` with operand values, or `may` or `must` without
# them or when `implicit` is undecided, and never reads `otherwise` itself,
# which alone fails open whenever a rule holds. the generator derives `may` and
# `must`, and check proves them
# ---
# otherwise: the registers it touches when no rule holds
# rules:     the registers it touches instead for some operand values, as a risc-v rounding
#            mode of dyn reading frm, or an x86 repeat prefix reading and writing rcx. no two
#            rules can both hold, so their order means nothing
# may:       the union of otherwise and every rule's, what some operand values touch. a write some values make keeping
#            some of the old value is in may.read, as it is in that rule's read
# must:      the intersection of otherwise and every rule's, what every operand value touches. a register in may.written
#            and not in must.written is written by some values only, so a reader with no values, or with an undecided
#            answer, kills must.written alone
pub rec Registers {
    otherwise: Touched;
    rules:     RegisterRules;
    may:       Touched;
    must:      Touched;
}

# a transfer an instruction has when its operand values meet every term, the
# shape that replaces the row's own. a rule has at least one term, since the
# control's own fields are what an instruction has when no rule holds. the
# operand holding the target is kept unless the rule leaves no target
# ---
# terms:       every one must hold
# transfer:    what it does then
# target:      where it goes then
# conditional: whether it may fall through then
pub rec Rule {
    terms:       Terms;
    transfer:    Transfer;
    target:      Target;
    conditional: bool;
}

# rules as a pointer to static rules and a count
pub rec Rules {
    at:  *Rule;
    len: u32;
}

# a control with no rules, a fixed kind
pub val NO_RULES: Rules = Rules{at: nil, len: 0};

# an instruction's control transfer
# ---
# transfer:    what it does
# target:      where a jump or call goes
# conditional: whether it may fall through instead, decided by the values it reads
# operand:     the operand holding the target, NO_OPERAND when the target is implicit or structural
# rules:       the transfers it has instead for some operand values, as risc-v jalr being a return
#              when it writes x0 and reads ra, and the fields above when none holds. no two rules
#              can both hold, so their order means nothing. a fixed kind states none
pub rec Control {
    transfer:    Transfer;
    target:      Target;
    conditional: bool;
    operand:     u8;
    rules:       Rules;
}

# a change to the stack pointer of bytes plus the value of an operand
# ---
# bytes:   the fixed part, negative toward a downward stack's growth
# operand: an immediate operand whose value is added, as x86 ret imm16's, NO_OPERAND when none
pub rec Delta {
    bytes:   i32;
    operand: u8;
}

# what an instruction does to the stack pointer, the register of the file
# flagged STACK, beyond what an operand naming it states, as an address
# writeback of aarch64 stp with sp as base states its own change
# ---
# none:   nothing
# delta:  it changes by a delta, as x86 push, pop, call and ret
# opaque: it changes by an amount no delta states, as x86 leave and enter
pub tag Stack: u8 {
    none;
    delta: Delta;
    opaque;
}

# how long an instruction takes, as a scheduler weighs it
# ---
# ONE:     a single-cycle operation
# FEW:     a pipelined multi-cycle operation, as a multiply or most floating point
# MANY:    a long unpipelined operation, as a divide or a square root
# SERIAL:  microcoded or serializing, as x86 cpuid or rep movs
# UNTIMED: a typed stream's instruction a later compiler schedules, as spir-v and wasm
pub def Latency: u8;

pub val ONE:     Latency = 0;
pub val FEW:     Latency = 1;
pub val MANY:    Latency = 2;
pub val SERIAL:  Latency = 3;
pub val UNTIMED: Latency = 4;

# an operand that must be one register, as the cl count of an x86 variable
# shift or the rax and rdx of a one-operand multiply. encode refuses any other
# register, and decode fills it when no field holds it
# ---
# operand:  the operand
# register: the register's row in the file
pub rec Fixed {
    operand:  u8;
    register: u32;
}

# fixed operands as a pointer to static fixed operands and a count
pub rec Fixeds {
    at:  *Fixed;
    len: u32;
}

pub val NO_FIXEDS: Fixeds = Fixeds{at: nil, len: 0};

# the effect of a row
# ---
# implicit: registers no operand names
# flags:    flags read and written
# memory:   accesses the operands do not state whole
# control:  the control transfer
# stack:    the change to the stack pointer
# latency:  the latency class
# fixed:    the operands that must be one register
pub rec Effect {
    implicit: Registers;
    flags:    Flags;
    memory:   Accesses;
    control:  Control;
    stack:    Stack;
    latency:  Latency;
    fixed:    Fixeds;
}

# the words a set over the rows of `file` spans
pub fun words(file: *register.File) u32 {
    ret (file.register_count + 63) / 64;
}

# whether `set`, over the rows of `file`, holds the register `reg`
pub fun has(file: *register.File, set: Set, reg: register.Id) bool {
    ret register.bit(file, set.words, set.len, reg);
}

# whether no value meets both tests, which are of one operand: register sets
# that share no row, immediates that differ, or a register against an immediate
pub fun disjoint(a: *Test, b: *Test) bool {
    if (sel a.register) {
        if (sel b.register) {
            val x: Set = a.register;
            val y: Set = b.register;
            var w: u32 = 0;
            for (w < x.len && w < y.len) {
                if ((x.words[w] & y.words[w]) != 0) { ret false; }
                w = w + 1;
            }
        }
        ret true;
    }
    if (sel a.immediate) {
        if (sel b.immediate) {
            val x: i64 = a.immediate;
            val y: i64 = b.immediate;
            ret x != y;
        }
        ret true;
    }
    if (sel a.enumerant) {
        if (sel b.enumerant) {
            val x: u32 = a.enumerant;
            val y: u32 = b.enumerant;
            ret x != y;
        }
        ret true;
    }
    if (sel a.condition) {
        if (sel b.condition) {
            val x: u32 = a.condition;
            val y: u32 = b.condition;
            ret x != y;
        }
        ret true;
    }
    if (sel a.id) {
        if (sel b.id) {
            val x: u32 = a.id;
            val y: u32 = b.id;
            ret x != y;
        }
    }
    ret true;
}

# whether no instruction meets both conjunctions of terms, which holds when
# some operand they both test has disjoint tests
pub fun exclusive(a: Terms, b: Terms) bool {
    var i: u32 = 0;
    for (i < a.len) {
        var k: u32 = 0;
        for (k < b.len) {
            if (a.at[i].operand == b.at[k].operand && disjoint(?a.at[i].test, ?b.at[k].test)) { ret true; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret false;
}

# the rule a query over operand values cannot decide, and the operand left open
# ---
# rule:    the position of the first rule no term of which is false but one tests an operand with no value
# operand: the operand that term tests
pub rec Pending {
    rule:    u32;
    operand: u8;
}

# what a query over operand values answers, decided only when every rule that may hold is decided
# ---
# decided:   the answer
# undecided: the rule left open, since an operand it tests has no value yet, as a register operand before allocation
pub tag Answer[T]: u8 {
    decided:   T;
    undecided: Pending;
}

# whether the value of the operand `term` tests is known: given, and not none for an operand that always takes one.
# an optional operand whose value is none is absent, which is a value
pub fun known(operands: *operand.Operand, values: operand.Values, term: *Term) bool {
    if (term.operand::u32 >= values.len) { ret false; }
    val v: operand.Value = values.at[term.operand];
    ret !sel v.none || operands[term.operand].quantity != operand.ONE;
}

# whether `term`, whose operand's value is known, holds over the operand values of an instruction. check guarantees
# the operand is one the instruction has and of the test's kind, so the false for any other is a guard that no
# registered set reaches
fun holds(file: *register.File, term: *Term, values: operand.Values) bool {
    if (term.operand >= values.len) { ret false; }
    val v: operand.Value = values.at[term.operand];
    if (sel term.test.register) {
        if (!sel v.register) { ret false; }
        ret has(file, term.test.register, v.register);
    }
    if (sel term.test.immediate) { ret sel v.immediate && v.immediate == term.test.immediate; }
    if (sel term.test.enumerant) { ret sel v.enumerant && v.enumerant == term.test.enumerant; }
    if (sel term.test.condition) { ret sel v.condition && v.condition == term.test.condition; }
    ret sel term.test.id && (sel v.id && v.id == term.test.id);
}

# whether every one of `terms` holds over the operand values of an instruction, every value they test known
pub fun meets(file: *register.File, terms: Terms, values: operand.Values) bool {
    var k: u32 = 0;
    for (k < terms.len) {
        if (!holds(file, ?terms.at[k], values)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether `terms` hold over the operand values of an instruction whose operands are `operands`: false when a term
# whose operand's value is known fails, else undecided naming the first term whose operand's value is not known
fun decide(file: *register.File, operands: *operand.Operand, terms: Terms, values: operand.Values, rule: u32) Answer[bool] {
    var open: u8  = field.NO_OPERAND;
    var k:    u32 = 0;
    for (k < terms.len) {
        val term: *Term = ?terms.at[k];
        if (!known(operands, values, term)) {
            if (open == field.NO_OPERAND) { open = term.operand; }
        }
        or (!holds(file, term, values)) { ret Answer[bool].decided{false}; }
        k = k + 1;
    }
    if (open != field.NO_OPERAND) { ret Answer[bool].undecided{Pending{rule: rule, operand: open}}; }
    ret Answer[bool].decided{true};
}

# the control transfer of the instruction whose operands are `operands` and operand values `values`: the effect's one
# rule whose terms all hold, else the effect's own when every rule is false, else undecided naming the first rule an
# operand with no value leaves open
pub fun control(file: *register.File, operands: *operand.Operand, e: *Effect, values: operand.Values) Answer[Control] {
    var open:    bool    = false;
    var pending: Pending = Pending{rule: 0, operand: field.NO_OPERAND};
    var i:       u32     = 0;
    for (i < e.control.rules.len) {
        val rule: *Rule        = ?e.control.rules.at[i];
        val met:  Answer[bool] = decide(file, operands, rule.terms, values, i);
        if (sel met.undecided) {
            if (!open) { pending = met.undecided; }
            open = true;
        }
        if (sel met.decided) {
            if (met.decided) {
                var at: u8 = e.control.operand;
                if (rule.target == UNTARGETED) { at = field.NO_OPERAND; }
                ret Answer[Control].decided{Control{transfer: rule.transfer, target: rule.target, conditional: rule.conditional, operand: at, rules: NO_RULES}};
            }
        }
        i = i + 1;
    }
    if (open) { ret Answer[Control].undecided{pending}; }
    ret Answer[Control].decided{e.control};
}

# the registers no operand names that the instruction whose operands are `operands` and operand values `values`
# reads and writes: the effect's one register rule whose terms all hold, else the effect's own when every rule is
# false, else undecided naming the first rule an operand with no value leaves open
pub fun implicit(file: *register.File, operands: *operand.Operand, e: *Effect, values: operand.Values) Answer[Touched] {
    var open:    bool    = false;
    var pending: Pending = Pending{rule: 0, operand: field.NO_OPERAND};
    var i:       u32     = 0;
    for (i < e.implicit.rules.len) {
        val rule: *RegisterRule = ?e.implicit.rules.at[i];
        val met:  Answer[bool]  = decide(file, operands, rule.terms, values, i);
        if (sel met.undecided) {
            if (!open) { pending = met.undecided; }
            open = true;
        }
        if (sel met.decided) {
            if (met.decided) { ret Answer[Touched].decided{rule.touched}; }
        }
        i = i + 1;
    }
    if (open) { ret Answer[Touched].undecided{pending}; }
    ret Answer[Touched].decided{e.implicit.otherwise};
}

# the registers no operand names that some instruction of the effect's row
# reads and writes, for a reader with no operand values, as a constant-time walk
# or a clobber list
pub fun may(e: *Effect) Touched {
    ret e.implicit.may;
}

# the registers no operand names that every instruction of the effect's row
# reads and writes, for a reader that needs a definite write, as a liveness kill
pub fun must(e: *Effect) Touched {
    ret e.implicit.must;
}

# word `w` of `set`, zero past its words
fun word(set: Set, w: u32) u64 {
    if (w >= set.len) { ret 0; }
    ret set.words[w];
}

# whether `got`, over `count` words, is the union (else the intersection) of the read (else written) sets of `g` and its rules
fun combined(g: *Registers, count: u32, written: bool, union: bool, got: Set) bool {
    var w: u32 = 0;
    for (w < count) {
        var acc: u64 = word(g.otherwise.read, w);
        if (written) { acc = word(g.otherwise.written, w); }
        var i: u32 = 0;
        for (i < g.rules.len) {
            var x: u64 = word(g.rules.at[i].touched.read, w);
            if (written) { x = word(g.rules.at[i].touched.written, w); }
            if (union)   { acc = acc | x; }
            or           { acc = acc & x; }
            i = i + 1;
        }
        if (acc != word(got, w)) { ret false; }
        w = w + 1;
    }
    ret true;
}

# whether `may` and `must` of `g`, over the first `count` words of every set, are the union and the intersection of its own
# sets and its rules'
pub fun bounded(g: *Registers, count: u32) bool {
    ret combined(g, count, false, true, g.may.read) && combined(g, count, true, true, g.may.written) && combined(g, count, false, false, g.must.read) && combined(g, count, true, false, g.must.written);
}

# the register operand `op` must be, none when it is not fixed
pub fun fixed(file: *register.File, e: *Effect, op: u8) opt[register.Id] {
    var i: u32 = 0;
    for (i < e.fixed.len) {
        if (e.fixed.at[i].operand == op) { ret opt[register.Id].some{register.id_of(?file.registers[e.fixed.at[i].register])}; }
        i = i + 1;
    }
    ret opt[register.Id].none{};
}

# the transfer `control` decides, 0xFF when it is undecided
#[testing]
fun t_transfer(file: *register.File, operands: *operand.Operand, e: *Effect, values: operand.Values) Transfer {
    val a: Answer[Control] = control(file, operands, e, values);
    if (sel a.undecided) { ret 0xFF; }
    ret a.decided.transfer;
}

# whether the registers `implicit` decides read `reg`, false when it is undecided
#[testing]
fun t_reads(file: *register.File, operands: *operand.Operand, e: *Effect, values: operand.Values, reg: register.Id) bool {
    val a: Answer[Touched] = implicit(file, operands, e, values);
    if (sel a.decided) { ret has(file, a.decided.read, reg); }
    ret false;
}

test has__a_set_covers_a_file_past_64_registers {
    var rows: [130]register.Register;
    var n:    u32 = 0;
    for (n < 130) {
        rows[n].number = n::u16;
        n              = n + 1;
    }
    var file: register.File = register.File{scales: nil, scale_count: 0, classes: nil, class_count: 0, class_names: index.EMPTY, registers: ?rows[0], register_count: 130, aliases: nil, alias_count: 0, names: index.EMPTY, columns: nil, column_count: 0};
    if (words(?file) != 3) { ret 1; }
    val bits: [3]u64 = [3]u64{0x2, 0x1, 0x2};
    val set:  Set    = Set{words: ?bits[0], len: 3};
    var row:  u32    = 0;
    for (row < 130) {
        if (has(?file, set, register.make(0, row::u16)) != (row == 1 || row == 64 || row == 129)) { ret 2; }
        row = row + 1;
    }
    val short: Set = Set{words: ?bits[0], len: 1};
    if (has(?file, Set{words: nil, len: 0}, register.make(0, 1)) || has(?file, set, register.make(0, 200)) || has(?file, short, register.make(0, 64))) { ret 3; }
    if (has(?file, set, register.NONE) || !has(?file, set, register.make(0, 1)))                                                                       { ret 4; }
    ret 0;
}

test control__the_rule_that_holds_decides_and_a_fixed_kind_keeps_its_own {
    var rows: [2]register.Register;
    rows[1].number = 1;
    var file:  register.File = register.File{scales: nil, scale_count: 0, classes: nil, class_count: 0, class_names: index.EMPTY, registers: ?rows[0], register_count: 2, aliases: nil, alias_count: 0, names: index.EMPTY, columns: nil, column_count: 0};
    val one:   [1]u64        = [1]u64{0x2};
    val zero:  [1]u64        = [1]u64{0x1};
    val tests: [3]Term       = [3]Term{
        Term{operand: 0, test: Test.register{Set{words: ?one[0], len: 1}}},
        Term{operand: 1, test: Test.immediate{7}},
        Term{operand: 0, test: Test.register{Set{words: ?zero[0], len: 1}}},
    };
    val rules: [2]Rule = [2]Rule{
        Rule{terms: Terms{at: ?tests[0], len: 2}, transfer: RETURN, target: UNTARGETED, conditional: false},
        Rule{terms: Terms{at: ?tests[2], len: 1}, transfer: CALL, target: INDIRECT, conditional: true},
    };
    # the rules test disjoint registers of one operand, so neither order decides
    if (!exclusive(rules[0].terms, rules[1].terms) || !exclusive(rules[1].terms, rules[0].terms)) { ret 1; }
    if (exclusive(rules[0].terms, rules[0].terms))                                                { ret 2; }
    # a register against an immediate, and different immediates, are disjoint
    val imm: Test = Test.immediate{8};
    if (!disjoint(?tests[0].test, ?imm) || !disjoint(?tests[1].test, ?imm) || disjoint(?tests[1].test, ?tests[1].test)) { ret 3; }
    # so are an enumerant against either other kind, and different enumerants
    val dyn: Test = Test.enumerant{7};
    val rtz: Test = Test.enumerant{1};
    if (!disjoint(?dyn, ?rtz) || !disjoint(?dyn, ?imm) || !disjoint(?imm, ?dyn) || !disjoint(?tests[0].test, ?dyn) || disjoint(?dyn, ?dyn)) { ret 9; }
    # and a condition or an id against any other kind, itself or the other new one
    val eq: Test = Test.condition{0};
    val ne: Test = Test.condition{1};
    val b0: Test = Test.id{0};
    val b1: Test = Test.id{1};
    if (!disjoint(?eq, ?ne) || disjoint(?eq, ?eq) || !disjoint(?b0, ?b1) || disjoint(?b0, ?b0))                                                               { ret 10; }
    if (!disjoint(?eq, ?b0) || !disjoint(?b0, ?eq) || !disjoint(?eq, ?dyn) || !disjoint(?dyn, ?b0) || !disjoint(?imm, ?eq) || !disjoint(?tests[0].test, ?b0)) { ret 11; }
    var e: Effect;
    e.control = Control{transfer: JUMP, target: INDIRECT, conditional: false, operand: 0, rules: Rules{at: ?rules[0], len: 2}};
    var vals:   [2]operand.Value = [2]operand.Value{operand.Value.register{register.make(0, 1)}, operand.Value.immediate{7}};
    val values: operand.Values   = operand.Values{at: ?vals[0], len: 2};
    var ops:    [2]operand.Operand;
    ops[0].quantity = operand.ONE;
    ops[1].quantity = operand.ONE;
    val a: Answer[Control] = control(?file, ?ops[0], ?e, values);
    if (!sel a.decided)                                                        { ret 4; }
    if (a.decided.transfer != RETURN || a.decided.operand != field.NO_OPERAND) { ret 4; }
    # the other register meets the other rule, which keeps the target operand
    vals[0] = operand.Value.register{register.make(0, 0)};
    val b: Answer[Control] = control(?file, ?ops[0], ?e, values);
    if (!sel b.decided)                                                                 { ret 5; }
    if (b.decided.transfer != CALL || !b.decided.conditional || b.decided.operand != 0) { ret 5; }
    # the register meets the first rule's but its immediate does not
    vals[0] = operand.Value.register{register.make(0, 1)};
    vals[1] = operand.Value.immediate{8};
    if (t_transfer(?file, ?ops[0], ?e, values) != JUMP) { ret 6; }
    # an operand of another kind than its test meets neither
    vals[0] = operand.Value.immediate{1};
    if (t_transfer(?file, ?ops[0], ?e, values) != JUMP) { ret 7; }
    # a register operand with no value leaves the first rule open, though its immediate is decided
    vals[0] = operand.Value.none{};
    vals[1] = operand.Value.immediate{7};
    val u: Answer[Control] = control(?file, ?ops[0], ?e, values);
    if (!sel u.undecided)                                  { ret 12; }
    if (u.undecided.rule != 0 || u.undecided.operand != 0) { ret 12; }
    # a term decided false skips its rule whatever the open register, and the open one names the second
    vals[1] = operand.Value.immediate{8};
    val w: Answer[Control] = control(?file, ?ops[0], ?e, values);
    if (!sel w.undecided)      { ret 13; }
    if (w.undecided.rule != 1) { ret 13; }
    # so does an operand past the values, while an optional operand with no value is absent and decided
    vals[0] = operand.Value.register{register.make(0, 1)};
    if (t_transfer(?file, ?ops[0], ?e, operand.Values{at: ?vals[0], len: 1}) != 0xFF) { ret 14; }
    vals[0]         = operand.Value.none{};
    ops[0].quantity = operand.OPTIONAL;
    if (t_transfer(?file, ?ops[0], ?e, values) != JUMP) { ret 15; }
    # a fixed kind states no rules and is returned as it stands
    e.control.rules = NO_RULES;
    ops[0].quantity = operand.ONE;
    if (t_transfer(?file, ?ops[0], ?e, values) != JUMP) { ret 8; }
    ret 0;
}

test implicit__a_repeat_rule_reads_rcx_that_may_holds_and_must_does_not {
    # an x86 movs shape: rsi at row 2 always, rcx at row 1 only under the rep enumerant of operand 0
    var rows: [3]register.Register;
    rows[1].number = 1;
    rows[2].number = 2;
    var file:  register.File   = register.File{scales: nil, scale_count: 0, classes: nil, class_count: 0, class_names: index.EMPTY, registers: ?rows[0], register_count: 3, aliases: nil, alias_count: 0, names: index.EMPTY, columns: nil, column_count: 0};
    val rsi:   [1]u64          = [1]u64{0x4};
    val both:  [1]u64          = [1]u64{0x6};
    val own:   Touched         = Touched{read: Set{words: ?rsi[0], len: 1}, written: Set{words: ?rsi[0], len: 1}};
    val rep:   Touched         = Touched{read: Set{words: ?both[0], len: 1}, written: Set{words: ?both[0], len: 1}};
    val terms: [1]Term         = [1]Term{Term{operand: 0, test: Test.enumerant{1}}};
    val rules: [1]RegisterRule = [1]RegisterRule{RegisterRule{terms: Terms{at: ?terms[0], len: 1}, touched: rep}};
    var e:     Effect;
    e.implicit = Registers{otherwise: own, rules: RegisterRules{at: ?rules[0], len: 1}, may: rep, must: own};
    if (!bounded(?e.implicit, words(?file))) { ret 1; }
    val rcx: register.Id = register.make(0, 1);
    if (!has(?file, may(?e).read, rcx) || !has(?file, may(?e).written, rcx)) { ret 2; }
    if (has(?file, must(?e).read, rcx) || has(?file, must(?e).written, rcx)) { ret 3; }
    if (!has(?file, must(?e).written, register.make(0, 2)))                  { ret 4; }
    var vals:   [1]operand.Value = [1]operand.Value{operand.Value.enumerant{1}};
    val values: operand.Values   = operand.Values{at: ?vals[0], len: 1};
    var ops:    [1]operand.Operand;
    ops[0].quantity = operand.ONE;
    if (!t_reads(?file, ?ops[0], ?e, values, rcx)) { ret 5; }
    vals[0] = operand.Value.enumerant{0};
    val off: Answer[Touched] = implicit(?file, ?ops[0], ?e, values);
    if (!sel off.decided)                                                                        { ret 6; }
    if (has(?file, off.decided.read, rcx) || !has(?file, off.decided.read, register.make(0, 2))) { ret 6; }
    # with the prefix unchosen the rule is open, and otherwise is not given in its place
    vals[0] = operand.Value.none{};
    val open: Answer[Touched] = implicit(?file, ?ops[0], ?e, values);
    if (!sel open.undecided)                                     { ret 9; }
    if (open.undecided.rule != 0 || open.undecided.operand != 0) { ret 9; }
    # a must that claims rcx, or a may that lacks it, does not bound the rule
    e.implicit.must = rep;
    if (bounded(?e.implicit, words(?file))) { ret 7; }
    e.implicit.must = own;
    e.implicit.may  = own;
    if (bounded(?e.implicit, words(?file))) { ret 8; }
    ret 0;
}

test control_and_implicit__a_condition_or_id_value_decides_two_values_are_exclusive {
    var rows: [2]register.Register;
    rows[1].number = 1;
    var file:  register.File = register.File{scales: nil, scale_count: 0, classes: nil, class_count: 0, class_names: index.EMPTY, registers: ?rows[0], register_count: 2, aliases: nil, alias_count: 0, names: index.EMPTY, columns: nil, column_count: 0};
    val other: [1]u64        = [1]u64{0x2};
    val on:    Touched       = Touched{read: Set{words: ?other[0], len: 1}, written: NO_TOUCHED.written};
    val terms: [4]Term       = [4]Term{
        Term{operand: 0, test: Test.condition{0}},
        Term{operand: 0, test: Test.condition{1}},
        Term{operand: 0, test: Test.id{3}},
        Term{operand: 0, test: Test.id{4}},
    };
    val rules: [4]Rule = [4]Rule{
        Rule{terms: Terms{at: ?terms[0], len: 1}, transfer: CALL, target: DIRECT, conditional: true},
        Rule{terms: Terms{at: ?terms[1], len: 1}, transfer: RETURN, target: UNTARGETED, conditional: false},
        Rule{terms: Terms{at: ?terms[2], len: 1}, transfer: CALL, target: DIRECT, conditional: true},
        Rule{terms: Terms{at: ?terms[3], len: 1}, transfer: RETURN, target: UNTARGETED, conditional: false},
    };
    if (!exclusive(rules[0].terms, rules[1].terms) || exclusive(rules[0].terms, rules[0].terms)) { ret 1; }
    if (!exclusive(rules[2].terms, rules[3].terms) || exclusive(rules[2].terms, rules[2].terms)) { ret 2; }
    if (!exclusive(rules[0].terms, rules[2].terms))                                              { ret 3; }
    var e: Effect;
    e.control = Control{transfer: JUMP, target: INDIRECT, conditional: false, operand: 0, rules: Rules{at: ?rules[0], len: 4}};
    var vals:   [1]operand.Value = [1]operand.Value{operand.Value.condition{1}};
    val values: operand.Values   = operand.Values{at: ?vals[0], len: 1};
    var ops:    [1]operand.Operand;
    ops[0].quantity = operand.ONE;
    if (t_transfer(?file, ?ops[0], ?e, values) != RETURN) { ret 4; }
    vals[0] = operand.Value.condition{0};
    if (t_transfer(?file, ?ops[0], ?e, values) != CALL) { ret 5; }
    vals[0] = operand.Value.condition{2};
    if (t_transfer(?file, ?ops[0], ?e, values) != JUMP) { ret 6; }
    vals[0] = operand.Value.id{4};
    if (t_transfer(?file, ?ops[0], ?e, values) != RETURN) { ret 7; }
    vals[0] = operand.Value.id{3};
    if (t_transfer(?file, ?ops[0], ?e, values) != CALL) { ret 8; }
    # a condition test is not met by an id of the same number, nor an id test by a condition
    vals[0] = operand.Value.id{0};
    if (t_transfer(?file, ?ops[0], ?e, values) != JUMP) { ret 9; }
    vals[0] = operand.Value.condition{3};
    if (t_transfer(?file, ?ops[0], ?e, values) != JUMP) { ret 10; }
    val cond: [1]RegisterRule = [1]RegisterRule{RegisterRule{terms: Terms{at: ?terms[1], len: 1}, touched: on}};
    val ids:  [1]RegisterRule = [1]RegisterRule{RegisterRule{terms: Terms{at: ?terms[3], len: 1}, touched: on}};
    e.implicit.rules = RegisterRules{at: ?cond[0], len: 1};
    vals[0]          = operand.Value.condition{1};
    if (!t_reads(?file, ?ops[0], ?e, values, register.make(0, 1))) { ret 11; }
    vals[0] = operand.Value.condition{0};
    if (t_reads(?file, ?ops[0], ?e, values, register.make(0, 1))) { ret 12; }
    e.implicit.rules = RegisterRules{at: ?ids[0], len: 1};
    vals[0]          = operand.Value.id{4};
    if (!t_reads(?file, ?ops[0], ?e, values, register.make(0, 1))) { ret 13; }
    vals[0] = operand.Value.id{3};
    if (t_reads(?file, ?ops[0], ?e, values, register.make(0, 1))) { ret 14; }
    ret 0;
}
