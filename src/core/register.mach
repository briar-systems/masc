# rv32 and rv64 fix xlen at 1 and 2, and rv128 would fix it at 4. f, d and q fix flen at 1, 2 and 4
#[testing]
val RISCV_D: [1]requirement.Id = [1]requirement.Id{5};

#[testing]
val RISCV_F: [1]requirement.Id = [1]requirement.Id{4};

#[testing]
val RISCV_BASES: [7]extension.Extension = [7]extension.Extension{
    extension.Extension{name: "i", implies: requirement.NO_IDS, revision: "2.1"},
    extension.Extension{name: "e", implies: requirement.NO_IDS, revision: "2.0"},
    extension.Extension{name: "rv32", implies: requirement.NO_IDS, revision: "2.1"},
    extension.Extension{name: "rv64", implies: requirement.NO_IDS, revision: "2.1"},
    extension.Extension{name: "f", implies: requirement.NO_IDS, revision: "2.2"},
    extension.Extension{name: "d", implies: requirement.Ids{at: ?RISCV_F[0], len: 1}, revision: "2.2"},
    extension.Extension{name: "q", implies: requirement.Ids{at: ?RISCV_D[0], len: 1}, revision: "2.2"},
};

#[testing]
val RISCV_BASE_CONFLICT: [2]extension.Conflict = [2]extension.Conflict{extension.Conflict{a: 0, b: 1}, extension.Conflict{a: 2, b: 3}};

#[testing]
val RISCV_NAMES_BY_SPELLING: [7]index.Entry = [7]index.Entry{
    index.Entry{key: "d", row: 5},
    index.Entry{key: "e", row: 1},
    index.Entry{key: "f", row: 4},
    index.Entry{key: "i", row: 0},
    index.Entry{key: "q", row: 6},
    index.Entry{key: "rv32", row: 2},
    index.Entry{key: "rv64", row: 3},
};

#[testing]
pub val RISCV_CATALOG: extension.Catalog = extension.Catalog{extensions: ?RISCV_BASES[0], count: 7, levels: nil, level_count: 0, names: index.Index{at: ?RISCV_NAMES_BY_SPELLING[0], len: 7}, conflicts: ?RISCV_BASE_CONFLICT[0], conflict_count: 2, combinations: nil, combination_count: 0, syntax: ?extension.LIST};

# xlen is 32 or 64 bits by rv32 or rv64, and flen the widest of f, d and q held, which a bound states as the range
# of one multiplier where its format is held and no wider one is
#[testing]
val RISCV_RV32: [1]requirement.Id = [1]requirement.Id{2};
#[testing]
val RISCV_RV64: [1]requirement.Id = [1]requirement.Id{3};
#[testing]
val RISCV_Q:    [1]requirement.Id = [1]requirement.Id{6};

#[testing]
val RISCV_XLEN_WHEN: [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?RISCV_RV32[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?RISCV_RV64[0], len: 1}, none: requirement.NO_IDS},
};

#[testing]
val RISCV_FLEN_WHEN: [3]requirement.Alternative = [3]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?RISCV_F[0], len: 1}, none: requirement.Ids{at: ?RISCV_D[0], len: 1}},
    requirement.Alternative{all: requirement.Ids{at: ?RISCV_D[0], len: 1}, none: requirement.Ids{at: ?RISCV_Q[0], len: 1}},
    requirement.Alternative{all: requirement.Ids{at: ?RISCV_Q[0], len: 1}, none: requirement.NO_IDS},
};

#[testing]
val RISCV_XLEN_BOUNDS: [2]quantity.Bound = [2]quantity.Bound{
    quantity.Bound{when: requirement.Requirement{at: ?RISCV_XLEN_WHEN[0], len: 1}, least: 1, most: 1},
    quantity.Bound{when: requirement.Requirement{at: ?RISCV_XLEN_WHEN[1], len: 1}, least: 2, most: 2},
};

#[testing]
val RISCV_FLEN_BOUNDS: [3]quantity.Bound = [3]quantity.Bound{
    quantity.Bound{when: requirement.Requirement{at: ?RISCV_FLEN_WHEN[0], len: 1}, least: 1, most: 1},
    quantity.Bound{when: requirement.Requirement{at: ?RISCV_FLEN_WHEN[1], len: 1}, least: 2, most: 2},
    quantity.Bound{when: requirement.Requirement{at: ?RISCV_FLEN_WHEN[2], len: 1}, least: 4, most: 4},
};

#[testing]
val RISCV_QUANTITIES: [3]quantity.Quantity = [3]quantity.Quantity{
    quantity.Quantity{name: "xlen", unit: 32, domain: quantity.Domain.powers{quantity.Range{least: 1, most: 4}}, bounds: quantity.Bounds{at: ?RISCV_XLEN_BOUNDS[0], len: 2}, register: quantity.NO_ROW},
    quantity.Quantity{name: "flen", unit: 32, domain: quantity.Domain.powers{quantity.Range{least: 1, most: 4}}, bounds: quantity.Bounds{at: ?RISCV_FLEN_BOUNDS[0], len: 3}, register: quantity.NO_ROW},
    quantity.Quantity{name: "vlen", unit: 32, domain: quantity.Domain.powers{quantity.Range{least: 1, most: 8}}, bounds: quantity.NO_BOUNDS, register: quantity.NO_ROW},
};

