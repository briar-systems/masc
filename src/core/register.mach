val X86_COLUMNS: [2]Column = [2]Column{
    Column{format: DWARF, numbers: ?X86_DWARF[0], len: 12, numbered: index.Numbers{at: ?X86_DWARF_NUMBERED[0], len: 2}},
    Column{format: CODEVIEW, numbers: ?X86_CODEVIEW[0], len: 12, numbered: index.Numbers{at: ?X86_CODEVIEW_NUMBERED[0], len: 5}},
};

