# the register model every instruction set fills in
#
# a register file is static rows: classes, registers and one debug number
# column per format. the parser, the printer, the encoder, the cfi writer and
# mirl's allocator all read these rows, so no register fact lives anywhere
# else. reserved and allocatable sets are calling-convention facts and are not
# modelled here.
#
# a register row states the extensions a selection must hold for it to exist.
# a mode is an extension of the set's catalog, as x86 long mode or risc-v's
# rv64, and an absence is the presence of its conflicting complement, as x16
# to x31 require risc-v's i base, which the e base conflicts with. a
# selection filters the file through these conditions once, and every query
# after that reads its view.
#
# registers of one bank share its storage, each a footprint within it. a write
# through one leaves the rest of its bank as its row states, kept or cleared,
# unless the write's encoding decides it, as x86 vex does for a vector register.
# `covers` derives what a write overwrites from those two facts and the
# footprints, so a reader ending the values a write kills asks it alone.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;
use std.allocator.testing;
use std.collections.bitset;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.index;
use masc.core.requirement;

# a register's identity: its class index plus one in the high half and its
# hardware number in the low half, so 0 names no register
pub def Id: u32;

pub val NONE: Id = 0;

# the kind of storage a class names
pub def Kind: u8;

pub val GENERAL:   Kind = 0;
pub val FLOAT:     Kind = 1;
pub val VECTOR:    Kind = 2;
pub val PREDICATE: Kind = 3;
pub val FLAGS:     Kind = 4;
pub val TILE:      Kind = 5;
pub val SYSTEM:    Kind = 6;

# a multiplier an extension guarantees for a scale, as riscv's rv64 fixes xlen at 2. a minimum only, as Zvl*b gives vlen, is not a fixing
# ---
# by:         the extension or mode whose presence in a selection fixes it
# multiplier: the multiplier, a power of two from 1 to the scale's max
pub rec Fixing {
    by:         requirement.Id;
    multiplier: u32;
}

# fixings as a pointer to static rows and a count, so a static row can hold a list
# ---
# at:  the first fixing, nil when the list is empty
# len: how many fixings the list holds
pub rec Fixings {
    at:  *Fixing;
    len: u32;
}

pub val NO_FIXINGS: Fixings = Fixings{at: nil, len: 0};

# a quantity that scales with the implementation or the selection, such as
# the vector length or riscv xlen, whose multiplier of its minimum is a power
# of two from 1 to max
# ---
# name:  the spelling diagnostics use
# max:   the largest multiplier
# fixes: the multipliers extensions fix, empty when none does and the implementation chooses.
#        the scale resolves to the largest guaranteed, and exclusive modes such as rv32 and rv64 stay exclusive by their conflict pair
pub rec Scale {
    name:  str;
    max:   u32;
    fixes: Fixings;
}

# a quantity of the fixed part plus per times the multiplier of one scale
# ---
# fixed: the part no scale changes
# per:   the part added for each unit of the multiplier
# scale: the index of the scale in the file, read only when per is nonzero, and one
#        scale for every part of a register and its class width
pub rec Scaled {
    fixed: u32;
    per:   u32;
    scale: u8;
}

# a class of registers an operand can name
# ---
# name:  its name, unique within the file and stable: a saved text names the class by it, so it never depends on the class's place
# kind:  what its members hold
# width: the bits of each member, or of one row of a tile
# count: the hardware numbers its encoding spans, 0 to count - 1
pub rec Class {
    name:  str;
    kind:  Kind;
    width: Scaled;
    count: u32;
}

# fixed architectural roles, as bits of a register's flags
# ---
# STACK:   the stack pointer
# ZERO:    a register that reads zero and discards what is written to it
# PC:      the program counter
# ACCRUED: a register an instruction adds to rather than replaces, as risc-v fflags and vxsat, so a write of it keeps
#          what it held and is a read as well
# LENGTH:  the count of elements a vector instruction acts on, as risc-v vl. an instruction that reads it writes a vector
#          register only up to it and may keep the elements past it, so it reads every vector register it writes
pub def Flags: u8;

pub val STACK:   Flags = 0x1;
pub val ZERO:    Flags = 0x2;
pub val PC:      Flags = 0x4;
pub val ACCRUED: Flags = 0x8;
pub val LENGTH:  Flags = 0x10;

# what a write through a register leaves in the rest of its bank, the storage past its own footprint that other
# registers of the bank hold. a bank holding nothing past the register leaves nothing to extend into, so only KEEP
# is stated there
# ---
# KEEP:   the rest keeps its value, as x86 ax, al and ah within rax, a legacy sse write of xmm0 within ymm0, or a
#         risc-v csr field within the csr that holds it
# ZEROES: the rest is cleared, as x86 eax within rax, aarch64 w0 within x0, or a vex write of xmm0 up to the widest
#         vector register
# ONES:   the rest is set, as a narrower float nan-boxed within a wider float register, or an mmx write of the x87
#         register it shares, whose exponent it sets
pub def Extend: u8;

pub val KEEP:   Extend = 0;
pub val ZEROES: Extend = 1;
pub val ONES:   Extend = 2;

# what one write leaves in the rest of its register's bank
# ---
# row:    as the register's row states
# extend: this, whatever the row states, where the instruction's encoding decides it, as a vex write of xmm0
#         zeroing the rest of ymm0 that a legacy sse write keeps
pub tag Write: u8 {
    row;
    extend: Extend;
}

# one register
# ---
# name:     the spelling the printer writes
# class:    the index of its class in the file
# number:   its hardware number within the class
# bank:     the storage it shares with every register of the same bank
# offset:   the bit within the bank where its first piece starts
# stride:   the bits from the start of one of its pieces to the next
# count:    its pieces, each its class's width, so a contiguous register has 1
# flags:    its fixed architectural roles
# requires: the alternatives of extensions and modes a selection must hold, any one fully, for it to exist, none for every selection
# extend:   what a write through it leaves in the rest of its bank, unless the write states otherwise
pub rec Register {
    name:     str;
    class:    u16;
    number:   u16;
    bank:     u16;
    offset:   Scaled;
    stride:   Scaled;
    count:    Scaled;
    flags:    Flags;
    requires: requirement.Requirement;
    extend:   Extend;
}

# a further spelling of a register the parser accepts
# ---
# name:     the spelling
# register: the index of the register it names in the file's rows
#
# a file lists its aliases in ascending order of register, and the first alias
# of a register is the one a syntax that writes aliases prefers
pub rec Alias {
    name:     str;
    register: u32;
}

# a debug format that numbers registers
pub def Format: u8;

pub val DWARF:    Format = 0;
pub val CODEVIEW: Format = 1;

# the number a column holds for a register the format does not number
pub val UNNUMBERED: u32 = 0xFFFF_FFFF;

# one debug format's numbers, parallel to the file's registers
# ---
# format:   the format
# numbers:  one number per register row
# len:      how many numbers there are, the file's register count
# numbered: the registers it numbers, by number, one entry per numbered register
pub rec Column {
    format:   Format;
    numbers:  *u32;
    len:      u32;
    numbered: index.Numbers;
}

# a register file: its scales, classes, registers, aliases and debug columns
# ---
# class_names: the classes by name, one entry per class
# registers:   the register rows in ascending order of identity, so a row is found by binary search of the rows
# names:       the registers by spelling, one entry per register row and per alias. an entry's row is the register's own row, or the
#              register count plus the alias's index
# columns:     the debug columns in ascending order of format, one per format
pub rec File {
    scales:         *Scale;
    scale_count:    u32;
    classes:        *Class;
    class_count:    u32;
    class_names:    index.Index;
    registers:      *Register;
    register_count: u32;
    aliases:        *Alias;
    alias_count:    u32;
    names:          index.Index;
    columns:        *Column;
    column_count:   u32;
}

# the identity of hardware number `number` in class `class`
pub fun make(class: u16, number: u16) Id {
    ret ((class::u32 + 1) << 16) | number::u32;
}

# the class index of `reg`, which names a register
pub fun class_of(reg: Id) u16 {
    ret ((reg >> 16) - 1)::u16;
}

# the hardware number of `reg` within its class
pub fun number_of(reg: Id) u16 {
    ret (reg & 0xFFFF)::u16;
}

# the identity of a register row
pub fun id_of(row: *Register) Id {
    ret make(row.class, row.number);
}

# the row of the register that bearer `bearer` of the name index spells
fun owner(file: *File, bearer: u32) u32 {
    if (bearer < file.register_count) { ret bearer; }
    ret file.aliases[bearer - file.register_count].register;
}

# the register spelled `name` in `file`, by its name or one of its aliases, whatever the selection. a `fold` reads the capitals of `name`
# as lower case, which the registration check makes exact for a set whose syntax folds
pub fun named(file: *File, name: View, fold: bool) opt[Id] {
    val row: opt[u32] = row_named(file, name, fold);
    if (sel row.none) { ret opt[Id].none{}; }
    ret opt[Id].some{id_of(?file.registers[row.some])};
}

# the row of `file` of the register spelled `name`, the lookup `named` reads
pub fun row_named(file: *File, name: View, fold: bool) opt[u32] {
    val bearer: opt[u32] = index.find_view(?file.names, name, fold);
    if (sel bearer.none) { ret bearer; }
    ret opt[u32].some{owner(file, bearer.some)};
}

# the row index of `reg` in `file`
pub fun index_of(file: *File, reg: Id) opt[u32] {
    if (reg == NONE) { ret opt[u32].none{}; }
    var lo: u32 = 0;
    var hi: u32 = file.register_count;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (id_of(?file.registers[mid]) < reg) { lo = mid + 1; }
        or                                     { hi = mid; }
    }
    if (lo >= file.register_count || id_of(?file.registers[lo]) != reg) { ret opt[u32].none{}; }
    ret opt[u32].some{lo};
}

# the first alias of the register `reg` of `file`, none when it has none
pub fun first_alias(file: *File, reg: Id) opt[*Alias] {
    val row: opt[u32] = index_of(file, reg);
    if (sel row.none) { ret opt[*Alias].none{}; }
    var lo: u32 = 0;
    var hi: u32 = file.alias_count;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (file.aliases[mid].register < row.some) { lo = mid + 1; }
        or                                         { hi = mid; }
    }
    if (lo >= file.alias_count || file.aliases[lo].register != row.some) { ret opt[*Alias].none{}; }
    ret opt[*Alias].some{?file.aliases[lo]};
}

# whether the bit of `reg`'s row is set in `words`, a bit set laid out over the rows of `file`, 64 rows to a word and `len` words long
pub fun bit(file: *File, words: *u64, len: u32, reg: Id) bool {
    val at: opt[u32] = index_of(file, reg);
    if (sel at.none) { ret false; }
    val row: u32 = at.some;
    if (row / 64 >= len) { ret false; }
    ret ((words[row / 64] >> (row % 64)::u64) & 1) != 0;
}

# the row of `reg` in `file`
pub fun row_of(file: *File, reg: Id) opt[*Register] {
    val at: opt[u32] = index_of(file, reg);
    if (!sel at.some) { ret opt[*Register].none{}; }
    ret opt[*Register].some{?file.registers[at.some]};
}

# the class row of `reg` in `file`
pub fun class_row(file: *File, reg: Id) opt[*Class] {
    if (reg == NONE || class_of(reg)::u32 >= file.class_count) { ret opt[*Class].none{}; }
    ret opt[*Class].some{?file.classes[class_of(reg)]};
}

# the index of the class of `file` named `name`
pub fun class_named(file: *File, name: str) opt[u16] {
    val at: opt[u32] = index.find(?file.class_names, name);
    if (sel at.none) { ret opt[u16].none{}; }
    ret opt[u16].some{at.some::u16};
}

# the column of `file` for `format`, by binary search of the columns, which a file keeps in ascending order of format
fun column_of(file: *File, format: Format) opt[*Column] {
    var lo: u32 = 0;
    var hi: u32 = file.column_count;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (file.columns[mid].format < format) { lo = mid + 1; }
        or                                     { hi = mid; }
    }
    if (lo >= file.column_count || file.columns[lo].format != format) { ret opt[*Column].none{}; }
    ret opt[*Column].some{?file.columns[lo]};
}

# the number `format` gives `reg`, none when the file has no such column or the format leaves it unnumbered
pub fun debug_number(file: *File, reg: Id, format: Format) opt[u32] {
    val at: opt[u32] = index_of(file, reg);
    if (!sel at.some) { ret opt[u32].none{}; }
    val column: opt[*Column] = column_of(file, format);
    if (sel column.none) { ret opt[u32].none{}; }
    val number: u32 = column.some.numbers[at.some];
    if (number == UNNUMBERED) { ret opt[u32].none{}; }
    ret opt[u32].some{number};
}

# the register `format` gives the number `number`, none when the file has no such column or no register has the number
pub fun from_debug_number(file: *File, number: u32, format: Format) opt[Id] {
    val column: opt[*Column] = column_of(file, format);
    if (sel column.none) { ret opt[Id].none{}; }
    val at: opt[u32] = index.find_number(?column.some.numbered, number::u64);
    if (sel at.none) { ret opt[Id].none{}; }
    ret opt[Id].some{id_of(?file.registers[at.some])};
}

# whether the selection admits the register `row`. the one availability
# predicate: a selection's view is built from it, so the parser, the encoder,
# decode and the instruction api all read its answer
pub fun admits(s: *extension.Selection, row: *Register) bool {
    ret extension.admits(s, row.requires);
}

# a selection's view of a register file: the rows it admits and the scales it fixes
# ---
# file:        the file, nil for a set with none, whose view then holds nothing
# selection:   the selection the view filters by
# allocator:   the allocator the view's storage came from
# rows:        one bit per register row, set when the selection admits it
# multipliers: one multiplier per scale of the file, 0 when no extension of the selection fixes it
pub rec Available {
    file:        *File;
    selection:   *extension.Selection;
    allocator:   *A.Allocator;
    rows:        bitset.Bitset;
    multipliers: *u32;
}

# why a view was not made
# ---
# memory: the allocator refused the view's storage
pub tag Error: u8 {
    memory: A.Error;
}

# a register named that the selection does not admit
# ---
# row:      its row
# requires: the requirement the selection leaves unmet, rendered by `extension.spell_requirement`
pub rec Unavailable {
    row:      *Register;
    requires: requirement.Requirement;
}

# why a view refused a register
# ---
# unknown:     no row of the file is it or spells it
# unavailable: its row's condition is unmet by the selection
pub tag Absent: u8 {
    unknown;
    unavailable: Unavailable;
}

# the multiplier the selection fixes for scale `i` of `file`, the largest of those its
# extensions fix, none when no extension of it does. the registration check makes the
# largest the one the others are implied by
fun resolve(file: *File, s: *extension.Selection, i: u32) opt[u32] {
    val fixes: Fixings = file.scales[i].fixes;
    var top:   u32     = 0;
    var j:     u32     = 0;
    for (j < fixes.len) {
        val f: Fixing = fixes.at[j];
        if (extension.has(s, f.by) && f.multiplier > top) { top = f.multiplier; }
        j = j + 1;
    }
    if (top != 0) { ret opt[u32].some{top}; }
    ret opt[u32].none{};
}

# the view of `file` through the selection `s`, which must outlive it
# ---
# ret: the view, or why it was not made
pub fun select(a: *A.Allocator, file: *File, s: *extension.Selection) res[Available, Error] {
    var count:  u32 = 0;
    var scales: u32 = 0;
    if (file != nil) {
        count  = file.register_count;
        scales = file.scale_count;
    }
    val made: res[bitset.Bitset, A.Error] = bitset.init(a, count::usize);
    if (sel made.err) { ret res[Available, Error].err{Error.memory{made.err}}; }
    var v: Available = Available{file: file, selection: s, allocator: a, rows: made.ok, multipliers: nil};
    if (scales != 0) {
        val kept: res[*u32, A.Error] = A.zallocate[u32](a, scales::usize);
        if (sel kept.err) {
            bitset.dnit(?v.rows);
            ret res[Available, Error].err{Error.memory{kept.err}};
        }
        v.multipliers = kept.ok;
    }
    var k: u32 = 0;
    for (k < scales) {
        val fixed: opt[u32] = resolve(file, s, k);
        if (sel fixed.some) { v.multipliers[k] = fixed.some; }
        k = k + 1;
    }
    var i: u32 = 0;
    for (i < count) {
        if (admits(s, ?file.registers[i])) { bitset.set(?v.rows, i::usize); }
        i = i + 1;
    }
    ret res[Available, Error].ok{v};
}

# release a view's storage
pub fun release(v: *Available) err[A.Error] {
    if (v.multipliers != nil) { A.deallocate[u32](v.allocator, v.multipliers, v.file.scale_count::usize); }
    ret bitset.dnit(?v.rows);
}

# the register `reg` through the view
# ---
# ret: ok when the view holds it, or why it does not
pub fun admitted(v: *Available, reg: Id) err[Absent] {
    if (v.file == nil) { ret err[Absent].err{Absent.unknown{}}; }
    val at: opt[u32] = index_of(v.file, reg);
    if (sel at.none)                         { ret err[Absent].err{Absent.unknown{}}; }
    if (bitset.get(?v.rows, at.some::usize)) { ret err[Absent].ok{}; }
    val row: *Register = ?v.file.registers[at.some];
    ret err[Absent].err{Absent.unavailable{Unavailable{row: row, requires: row.requires}}};
}

# why `u` was refused spelled onto `out`: the register's name, then its requirement as the one renderer words it
pub fun spell(v: *Available, u: *Unavailable, out: *vector.Vector[u8]) err[A.Error] {
    val named: err[A.Error] = extension.append(out, u.row.name);
    if (sel named.err) { ret named; }
    val gap: err[A.Error] = extension.append(out, " ");
    if (sel gap.err) { ret gap; }
    ret extension.spell_requirement(v.selection, u.requires, out);
}

# the register spelled exactly `name` through the view, by its name or one of its aliases
# ---
# ret: the register, or why the view refuses the name
pub fun lookup(v: *Available, name: View) res[Id, Absent] {
    if (v.file == nil) { ret res[Id, Absent].err{Absent.unknown{}}; }
    val found: opt[Id] = named(v.file, name, false);
    if (sel found.none) { ret res[Id, Absent].err{Absent.unknown{}}; }
    val held: err[Absent] = admitted(v, found.some);
    if (sel held.err) { ret res[Id, Absent].err{held.err}; }
    ret res[Id, Absent].ok{found.some};
}

# the multiplier the selection fixes for scale `scale`, none when no extension of
# it does or the file has no such scale
pub fun multiplier(v: *Available, scale: u8) opt[u32] {
    if (v.file == nil || scale::u32 >= v.file.scale_count) { ret opt[u32].none{}; }
    val m: u32 = v.multipliers[scale];
    if (m == 0) { ret opt[u32].none{}; }
    ret opt[u32].some{m};
}

# the bits of each member of the class of `reg` through the view
# ---
# ret: the width, none when its scale is unknown to the selection, or why the view refuses the register
pub fun width(v: *Available, reg: Id) res[opt[u64], Absent] {
    val held: err[Absent] = admitted(v, reg);
    if (sel held.err) { ret res[opt[u64], Absent].err{held.err}; }
    val q: Scaled = v.file.classes[class_of(reg)].width;
    if (q.per == 0) { ret res[opt[u64], Absent].ok{opt[u64].some{q.fixed::u64}}; }
    val m: opt[u32] = multiplier(v, q.scale);
    if (sel m.none) { ret res[opt[u64], Absent].ok{opt[u64].none{}}; }
    ret res[opt[u64], Absent].ok{opt[u64].some{at(q, m.some::u64)}};
}

# the value of `q` at multiplier `m` of its scale
fun at(q: Scaled, m: u64) u64 {
    ret q.fixed::u64 + q.per::u64 * m;
}

# the scale a row's footprint varies with, none when it is fixed
fun scale_of(file: *File, row: *Register) opt[u8] {
    val width: Scaled = file.classes[row.class].width;
    if (width.per != 0)      { ret opt[u8].some{width.scale}; }
    if (row.offset.per != 0) { ret opt[u8].some{row.offset.scale}; }
    if (row.stride.per != 0) { ret opt[u8].some{row.stride.scale}; }
    if (row.count.per != 0)  { ret opt[u8].some{row.count.scale}; }
    ret opt[u8].none{};
}

# the largest multiplier of a scale, 1 for a fixed footprint
fun scale_max(file: *File, scale: opt[u8]) u64 {
    if (sel scale.some) { ret file.scales[scale.some].max::u64; }
    ret 1;
}

# the pieces of a register at one multiplier, which is the one storage rule overlap and within both read
# ---
# offset: the bit within the bank where the first piece starts
# stride: the bits from the start of one piece to the next
# count:  the pieces
# width:  the bits of each piece
rec Pieces {
    offset: u64;
    stride: u64;
    count:  u64;
    width:  u64;
}

# the pieces of `row` at multiplier `m`
fun pieces(file: *File, row: *Register, m: u64) Pieces {
    ret Pieces{offset: at(row.offset, m), stride: at(row.stride, m), count: at(row.count, m), width: at(file.classes[row.class].width, m)};
}

# the first piece of `p` that ends past bit `start`, the only one that can begin before a piece starting there ends or contain it
fun reaching(p: Pieces, start: u64) opt[u64] {
    if (p.width == 0 || p.count == 0) { ret opt[u64].none{}; }
    var j: u64 = 0;
    if (p.offset + p.width <= start) {
        if (p.stride == 0) { ret opt[u64].none{}; }
        j = (start - p.offset - p.width) / p.stride + 1;
    }
    if (j >= p.count) { ret opt[u64].none{}; }
    ret opt[u64].some{j};
}

# whether the footprints of `a` at multiplier `ma` and `b` at `mb` intersect
fun intersect(file: *File, a: *Register, ma: u64, b: *Register, mb: u64) bool {
    val pa: Pieces = pieces(file, a, ma);
    val pb: Pieces = pieces(file, b, mb);
    if (pa.width == 0 || pb.width == 0) { ret false; }
    var i: u64 = 0;
    for (i < pa.count) {
        val start: u64      = pa.offset + i * pa.stride;
        val j:     opt[u64] = reaching(pb, start);
        if (sel j.some) {
            if (pb.offset + j.some * pb.stride < start + pa.width) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# whether rows `a` and `b` of `file` share storage at some legal multiplier of
# each scale, which is what an allocator must assume when the scale is unknown
pub fun overlap(file: *File, a: *Register, b: *Register) bool {
    if (a.bank != b.bank) { ret false; }
    val sa:   opt[u8] = scale_of(file, a);
    val sb:   opt[u8] = scale_of(file, b);
    var same: bool    = false;
    if (sel sa.some) {
        if (sel sb.some) { same = sa.some == sb.some; }
    }
    var ma: u64 = 1;
    for (ma <= scale_max(file, sa)) {
        var mb: u64 = 1;
        for (mb <= scale_max(file, sb)) {
            if ((!same || ma == mb) && intersect(file, a, ma, b, mb)) { ret true; }
            mb = mb * 2;
        }
        ma = ma * 2;
    }
    ret false;
}

# where the pieces of a part lie in the storage of a container
# ---
# offset: the bit of the part's first piece, counted from the container's first piece
# width:  the bits of each piece
# stride: the bits from the start of one piece to the next
# count:  the pieces, so piece i lies at offset + i * stride
pub rec Placement {
    offset: u64;
    width:  u64;
    stride: u64;
    count:  u64;
}

# where row `part` of `file` lies within row `container` when every scale has multiplier `multiplier`
# ---
# ret: the placement, none when the rows share no bank or a piece of part is not wholly inside one piece of container
pub fun within(file: *File, part: *Register, container: *Register, multiplier: u64) opt[Placement] {
    ret placed(file, part, multiplier, container, multiplier);
}

# where row `part` at multiplier `mp` lies within row `container` at `mc`, as `within` finds it
fun placed(file: *File, part: *Register, mp: u64, container: *Register, mc: u64) opt[Placement] {
    if (part.bank != container.bank) { ret opt[Placement].none{}; }
    val p: Pieces = pieces(file, part, mp);
    val c: Pieces = pieces(file, container, mc);
    if (p.width == 0 || p.count == 0) { ret opt[Placement].none{}; }
    var i: u64 = 0;
    for (i < p.count) {
        val start: u64      = p.offset + i * p.stride;
        val j:     opt[u64] = reaching(c, start);
        if (sel j.none) { ret opt[Placement].none{}; }
        val from: u64 = c.offset + j.some * c.stride;
        if (start < from || start + p.width > from + c.width) { ret opt[Placement].none{}; }
        i = i + 1;
    }
    ret opt[Placement].some{Placement{offset: p.offset - c.offset, width: p.width, stride: p.stride, count: p.count}};
}

# whether row `part` of `file` lies within row `whole` at every legal multiplier of each scale, so whatever a
# selection fixes. rows of one scale take one multiplier, as overlap pairs them
fun inside(file: *File, part: *Register, whole: *Register) bool {
    if (part.bank != whole.bank) { ret false; }
    val sp:   opt[u8] = scale_of(file, part);
    val sw:   opt[u8] = scale_of(file, whole);
    var same: bool    = false;
    if (sel sp.some) {
        if (sel sw.some) { same = sp.some == sw.some; }
    }
    var mp: u64 = 1;
    for (mp <= scale_max(file, sp)) {
        var mw: u64 = 1;
        for (mw <= scale_max(file, sw)) {
            if (!same || mp == mw) {
                val p: opt[Placement] = placed(file, part, mp, whole, mw);
                if (sel p.none) { ret false; }
            }
            mw = mw * 2;
        }
        mp = mp * 2;
    }
    ret true;
}

# what `write` through row `row` leaves in the rest of the row's bank: the write's own extension where its encoding
# states one, the row's else
pub fun extend_of(row: *Register, write: Write) Extend {
    if (sel write.extend) { ret write.extend; }
    ret row.extend;
}

# whether a write through row `written` of `file` leaves every bit of row `other` overwritten, at every legal
# multiplier of each scale: other lies within written, or the write, as `extend_of` finds it, extends through the
# rest of the bank they share. a write through a register flagged ZERO is discarded and covers nothing. the one
# rule of what a register write kills
pub fun covers(file: *File, written: *Register, other: *Register, write: Write) bool {
    if ((written.flags & ZERO) != 0 || written.bank != other.bank) { ret false; }
    if (extend_of(written, write) != KEEP)                         { ret true; }
    ret inside(file, other, written);
}

# whether the bank of row `row` of `file` holds storage past the row's footprint at some legal multiplier, a row
# of the bank not lying within it, so that a write through it has a rest to extend into. it scans the file's rows,
# and only the registration check asks it
pub fun contained(file: *File, row: *Register) bool {
    var i: u32 = 0;
    for (i < file.register_count) {
        val y: *Register = ?file.registers[i];
        if (y.bank == row.bank && !inside(file, y, row)) { ret true; }
        i = i + 1;
    }
    ret false;
}

