test named__name_and_alias_reach_one_id {
    val x8: opt[Id] = named(?RISCV, view("x8", 2), false);
    val s0: opt[Id] = named(?RISCV, view("s0", 2), false);
    val fp: opt[Id] = named(?RISCV, view("fp", 2), false);
    if (!sel x8.some)                                                      { ret 1; }
    if (!sel s0.some)                                                      { ret 2; }
    if (!sel fp.some)                                                      { ret 3; }
    if (x8.some != make(0, 8) || s0.some != x8.some || fp.some != x8.some) { ret 4; }
    ret 0;
}

test named__unknown_name_refused {
    val partial: opt[Id] = named(?RISCV, view("s", 1), false);
    val unknown: opt[Id] = named(?RISCV, view("x3", 2), false);
    val cased:   opt[Id] = named(?RISCV, view("X8", 2), false);
    val folded:  opt[Id] = named(?RISCV, view("X8", 2), true);
    if (!sel partial.none || !sel unknown.none || !sel cased.none) { ret 1; }
    if (!(sel folded.some && folded.some == make(0, 8)))           { ret 2; }
    ret 0;
}

test overlap__shared_bank_both_directions {
    val rax: *Register = ?X86_REGISTERS[0];
    val ax:  *Register = ?X86_REGISTERS[2];
    val al:  *Register = ?X86_REGISTERS[3];
    val ah:  *Register = ?X86_REGISTERS[4];
    val rsp: *Register = ?X86_REGISTERS[1];
    if (!overlap(?X86, ah, rax) || !overlap(?X86, rax, ah)) { ret 1; }
    if (!overlap(?X86, al, ax) || !overlap(?X86, ax, al))   { ret 2; }
    if (overlap(?X86, al, ah) || overlap(?X86, ah, al))     { ret 3; }
    if (overlap(?X86, rsp, rax) || overlap(?X86, rax, rsp)) { ret 4; }
    ret 0;
}

test overwrites__a_write_overwrites_its_footprint_and_what_its_row_or_encoding_extends_through {
    val rax:  *Register = ?X86_REGISTERS[0];
    val rsp:  *Register = ?X86_REGISTERS[1];
    val ax:   *Register = ?X86_REGISTERS[2];
    val al:   *Register = ?X86_REGISTERS[3];
    val ah:   *Register = ?X86_REGISTERS[4];
    val eax:  *Register = ?X86_REGISTERS[5];
    val xmm0: *Register = ?X86_REGISTERS[6];
    val ymm0: *Register = ?X86_REGISTERS[7];
    val x0:   *Register = ?AARCH64_REGISTERS[3];
    val w0:   *Register = ?AARCH64_REGISTERS[4];
    val row:  Write     = Write.row{};
    val vex:  Write     = Write.extend{ZEROES};
    if (!overwrites(?X86, eax, rax, row) || !overwrites(?X86, eax, ah, row) || overwrites(?X86, eax, rsp, row))                       { ret 1; }
    if (overwrites(?X86, ax, rax, row) || !overwrites(?X86, ax, al, row) || overwrites(?X86, al, ah, row))                            { ret 2; }
    if (overwrites(?X86, xmm0, ymm0, row) || !overwrites(?X86, xmm0, ymm0, vex) || !overwrites(?X86, ymm0, xmm0, row))                { ret 3; }
    if (!overwrites(?AARCH64, w0, x0, row) || overwrites(?AARCH64, w0, x0, Write.extend{KEEP}) || !overwrites(?AARCH64, x0, w0, row)) { ret 4; }
    # a write of risc-v x0 is discarded
    if (overwrites(?RISCV, ?RISCV_REGISTERS[0], ?RISCV_REGISTERS[0], row)) { ret 5; }
    ret 0;
}

test overwrites__an_mmx_write_sets_the_exponent_of_its_own_x87_register_and_kills_no_st_row {
    val st0: *Register = ?X86_REGISTERS[8];
    val st1: *Register = ?X86_REGISTERS[9];
    val mm0: *Register = ?X86_REGISTERS[10];
    val mm3: *Register = ?X86_REGISTERS[11];
    val row: Write     = Write.row{};
    # r3, the fourth physical x87 register, all 80 bits of it
    var r3: Register = X86_REGISTERS[8];
    r3.offset = mm3.offset;
    r3.places = ONE_PLACE;
    if (!overwrites(?X86, mm3, ?r3, row) || overwrites(?X86, mm3, ?r3, Write.extend{KEEP}))                    { ret 1; }
    if (overwrites(?X86, mm3, mm0, row) || overwrites(?X86, mm3, st0, row) || overwrites(?X86, mm0, ?r3, row)) { ret 2; }
    if (overwrites(?X86, st0, mm3, row) || overwrites(?X86, st0, st1, row) || overwrites(?X86, st0, ?r3, row)) { ret 3; }
    if (!overwrites(?X86, mm3, mm3, row) || !contained(?X86, mm3))                                             { ret 4; }
    # the same write reaching the whole bank would kill every row of it
    var wide: Register = X86_REGISTERS[11];
    wide.reach = Reach.bank{};
    if (!overwrites(?X86, ?wide, st0, row) || !overwrites(?X86, ?wide, mm0, row)) { ret 5; }
    ret 0;
}

test overlap__strided_tiles {
    val za0_b: *Register = ?AARCH64_REGISTERS[0];
    val za0_d: *Register = ?AARCH64_REGISTERS[1];
    val za1_d: *Register = ?AARCH64_REGISTERS[2];
    if (!overlap(?AARCH64, za0_d, za0_b) || !overlap(?AARCH64, za0_b, za0_d)) { ret 1; }
    if (overlap(?AARCH64, za0_d, za1_d) || overlap(?AARCH64, za1_d, za0_d))   { ret 2; }
    ret 0;
}

# a register 8 bits wide per multiplier of a quantity of every step from 1 to 3, and a 4 bit one at bit 20 of its
# bank, which the first reaches only at 3, no power of two
#[testing]
val STEPPED_QUANTITIES: [1]quantity.Quantity = [1]quantity.Quantity{
    quantity.Quantity{name: "steps", unit: 8, domain: quantity.Domain.range{quantity.Steps{least: 1, most: 3, step: 1}}, bounds: quantity.NO_BOUNDS, register: quantity.NO_ROW},
};

