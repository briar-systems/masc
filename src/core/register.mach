# the register model every instruction set fills in
#
# a register file is static rows: classes, registers and one debug number
# column per format. the parser, the printer, the encoder, the cfi writer and
# mirl's allocator all read these rows, so no register fact lives anywhere
# else. reserved and allocatable sets are calling-convention facts and are not
# modelled here.
#
# a register row states the extensions a selection must hold for it to exist.
# a mode is an extension of the set's catalog, as x86 long mode or risc-v's
# rv64, and an absence is the presence of its conflicting complement, as x16
# to x31 require risc-v's i base, which the e base conflicts with. a
# selection filters the file through these conditions once, and every query
# after that reads its view.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;
use std.types.view.view;
use std.types.view.view_eq_str;

use A: std.allocator;
use std.allocator.testing;
use std.collections.bitset;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.extension;

# a register's identity: its class index plus one in the high half and its
# hardware number in the low half, so 0 names no register
pub def Id: u32;

pub val NONE: Id = 0;

# the kind of storage a class names
pub def Kind: u8;

pub val GENERAL:   Kind = 0;
pub val FLOAT:     Kind = 1;
pub val VECTOR:    Kind = 2;
pub val PREDICATE: Kind = 3;
pub val FLAGS:     Kind = 4;
pub val TILE:      Kind = 5;
pub val SYSTEM:    Kind = 6;

# a multiplier an extension guarantees for a scale, as riscv's rv64 fixes xlen at 2. a minimum only, as Zvl*b gives vlen, is not a fixing
# ---
# by:         the extension or mode whose presence in a selection fixes it
# multiplier: the multiplier, a power of two from 1 to the scale's max
pub rec Fixing {
    by:         extension.Id;
    multiplier: u32;
}

# fixings as a pointer to static rows and a count, so a static row can hold a list
# ---
# at:  the first fixing, nil when the list is empty
# len: how many fixings the list holds
pub rec Fixings {
    at:  *Fixing;
    len: u32;
}

# a quantity that scales with the implementation or the selection, such as
# the vector length or riscv xlen, whose multiplier of its minimum is a power
# of two from 1 to max
# ---
# name:  the spelling diagnostics use
# max:   the largest multiplier
# fixes: the multipliers extensions fix, empty when none does and the implementation chooses.
#        the scale resolves to the largest guaranteed, and exclusive modes such as rv32 and rv64 stay exclusive by their conflict pair
pub rec Scale {
    name:  str;
    max:   u32;
    fixes: Fixings;
}

# a quantity of the fixed part plus per times the multiplier of one scale
# ---
# fixed: the part no scale changes
# per:   the part added for each unit of the multiplier
# scale: the index of the scale in the file, read only when per is nonzero, and one
#        scale for every part of a register and its class width
pub rec Scaled {
    fixed: u32;
    per:   u32;
    scale: u8;
}

# a class of registers an operand can name
# ---
# kind:  what its members hold
# width: the bits of each member, or of one row of a tile
# count: the hardware numbers its encoding spans, 0 to count - 1
pub rec Class {
    kind:  Kind;
    width: Scaled;
    count: u32;
}

# fixed architectural roles, as bits of a register's flags
pub def Flags: u8;

pub val STACK: Flags = 0x1;
pub val ZERO:  Flags = 0x2;
pub val PC:    Flags = 0x4;

# one register
# ---
# name:     the spelling the printer writes
# class:    the index of its class in the file
# number:   its hardware number within the class
# bank:     the storage it shares with every register of the same bank
# offset:   the bit within the bank where its first piece starts
# stride:   the bits from the start of one of its pieces to the next
# count:    its pieces, each its class's width, so a contiguous register has 1
# flags:    its fixed architectural roles
# requires: the alternatives of extensions and modes a selection must hold, any one fully, for it to exist, none for every selection
pub rec Register {
    name:     str;
    class:    u16;
    number:   u16;
    bank:     u16;
    offset:   Scaled;
    stride:   Scaled;
    count:    Scaled;
    flags:    Flags;
    requires: extension.Requirement;
}

# a further spelling of a register the parser accepts
# ---
# name:     the spelling
# register: the index of the register it names in the file's rows
#
# a file lists its aliases in ascending order of register, and the first alias
# of a register is the one a syntax that writes aliases prefers
pub rec Alias {
    name:     str;
    register: u32;
}

# a debug format that numbers registers
pub def Format: u8;

pub val DWARF:    Format = 0;
pub val CODEVIEW: Format = 1;

# the number a column holds for a register the format does not number
pub val UNNUMBERED: u32 = 0xFFFF_FFFF;

# one debug format's numbers, parallel to the file's registers
# ---
# format:  the format
# numbers: one number per register row
# len:     how many numbers there are, the file's register count
pub rec Column {
    format:  Format;
    numbers: *u32;
    len:     u32;
}

# a register file: its scales, classes, registers, aliases and debug columns
pub rec File {
    scales:         *Scale;
    scale_count:    u32;
    classes:        *Class;
    class_count:    u32;
    registers:      *Register;
    register_count: u32;
    aliases:        *Alias;
    alias_count:    u32;
    columns:        *Column;
    column_count:   u32;
}

# the identity of hardware number `number` in class `class`
pub fun make(class: u16, number: u16) Id {
    ret ((class::u32 + 1) << 16) | number::u32;
}

# the class index of `reg`, which names a register
pub fun class_of(reg: Id) u16 {
    ret ((reg >> 16) - 1)::u16;
}

# the hardware number of `reg` within its class
pub fun number_of(reg: Id) u16 {
    ret (reg & 0xFFFF)::u16;
}

# the identity of a register row
pub fun id_of(row: *Register) Id {
    ret make(row.class, row.number);
}

# the register spelled `name` in `file`, by its name or one of its aliases, whatever the selection
fun named(file: *File, name: View) opt[Id] {
    var i: u32 = 0;
    for (i < file.register_count) {
        val row: *Register = ?file.registers[i];
        if (view_eq_str(name, row.name)) { ret opt[Id].some{id_of(row)}; }
        i = i + 1;
    }
    i = 0;
    for (i < file.alias_count) {
        val alias: *Alias = ?file.aliases[i];
        if (view_eq_str(name, alias.name)) { ret opt[Id].some{id_of(?file.registers[alias.register])}; }
        i = i + 1;
    }
    ret opt[Id].none{};
}

# the row index of `reg` in `file`
fun index_of(file: *File, reg: Id) opt[u32] {
    if (reg == NONE) { ret opt[u32].none{}; }
    var i: u32 = 0;
    for (i < file.register_count) {
        if (id_of(?file.registers[i]) == reg) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the first alias of the register at row `row` of `file`, none when it has no alias
pub fun first_alias(file: *File, row: u32) opt[*Alias] {
    var lo: u32 = 0;
    var hi: u32 = file.alias_count;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (file.aliases[mid].register < row) { lo = mid + 1; }
        or                                    { hi = mid; }
    }
    if (lo >= file.alias_count || file.aliases[lo].register != row) { ret opt[*Alias].none{}; }
    ret opt[*Alias].some{?file.aliases[lo]};
}

# the row index of `reg` in `file`
pub fun row_index(file: *File, reg: Id) opt[u32] {
    ret index_of(file, reg);
}

# the row of `reg` in `file`
pub fun row_of(file: *File, reg: Id) opt[*Register] {
    val at: opt[u32] = index_of(file, reg);
    if (!sel at.some) { ret opt[*Register].none{}; }
    ret opt[*Register].some{?file.registers[at.some]};
}

# the class row of `reg` in `file`
pub fun class_row(file: *File, reg: Id) opt[*Class] {
    if (reg == NONE || class_of(reg)::u32 >= file.class_count) { ret opt[*Class].none{}; }
    ret opt[*Class].some{?file.classes[class_of(reg)]};
}

# the number `format` gives `reg`, none when the file has no such column or the format leaves it unnumbered
pub fun debug_number(file: *File, reg: Id, format: Format) opt[u32] {
    val at: opt[u32] = index_of(file, reg);
    if (!sel at.some) { ret opt[u32].none{}; }
    var i: u32 = 0;
    for (i < file.column_count) {
        val column: *Column = ?file.columns[i];
        if (column.format == format) {
            val number: u32 = column.numbers[at.some];
            if (number == UNNUMBERED) { ret opt[u32].none{}; }
            ret opt[u32].some{number};
        }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# whether the selection admits the register `row`. the one availability
# predicate: a selection's view is built from it, so the parser, the encoder,
# decode and the instruction api all read its answer
pub fun admits(s: *extension.Selection, row: *Register) bool {
    ret extension.admits(s, row.requires);
}

# a selection's view of a register file: the rows it admits and the scales it fixes
# ---
# file:        the file, nil for a set with none, whose view then holds nothing
# selection:   the selection the view filters by
# allocator:   the allocator the view's storage came from
# rows:        one bit per register row, set when the selection admits it
# multipliers: one multiplier per scale of the file, 0 when no extension of the selection fixes it
pub rec Available {
    file:        *File;
    selection:   *extension.Selection;
    allocator:   *A.Allocator;
    rows:        bitset.Bitset;
    multipliers: *u32;
}

# why a view was not made
# ---
# memory: the allocator refused the view's storage
pub tag Error: u8 {
    memory: A.Error;
}

# a register named that the selection does not admit
# ---
# row:      its row
# requires: the requirement the selection leaves unmet, rendered by `extension.spell_requirement`
pub rec Unavailable {
    row:      *Register;
    requires: extension.Requirement;
}

# why a view refused a register
# ---
# unknown:     no row of the file is it or spells it
# unavailable: its row's condition is unmet by the selection
pub tag Absent: u8 {
    unknown;
    unavailable: Unavailable;
}

# the multiplier the selection fixes for scale `i` of `file`, the largest of those its
# extensions fix, none when no extension of it does. the registration check makes the
# largest the one the others are implied by
fun resolve(file: *File, s: *extension.Selection, i: u32) opt[u32] {
    val fixes: Fixings = file.scales[i].fixes;
    var top:   u32     = 0;
    var j:     u32     = 0;
    for (j < fixes.len) {
        val f: Fixing = fixes.at[j];
        if (extension.has(s, f.by) && f.multiplier > top) { top = f.multiplier; }
        j = j + 1;
    }
    if (top != 0) { ret opt[u32].some{top}; }
    ret opt[u32].none{};
}

# the view of `file` through the selection `s`, which must outlive it
# ---
# ret: the view, or why it was not made
pub fun select(a: *A.Allocator, file: *File, s: *extension.Selection) res[Available, Error] {
    var count:  u32 = 0;
    var scales: u32 = 0;
    if (file != nil) {
        count  = file.register_count;
        scales = file.scale_count;
    }
    val made: res[bitset.Bitset, A.Error] = bitset.init(a, count::usize);
    if (sel made.err) { ret res[Available, Error].err{Error.memory{made.err}}; }
    var v: Available = Available{file: file, selection: s, allocator: a, rows: made.ok, multipliers: nil};
    if (scales != 0) {
        val kept: res[*u32, A.Error] = A.zallocate[u32](a, scales::usize);
        if (sel kept.err) {
            bitset.dnit(?v.rows);
            ret res[Available, Error].err{Error.memory{kept.err}};
        }
        v.multipliers = kept.ok;
    }
    var k: u32 = 0;
    for (k < scales) {
        val fixed: opt[u32] = resolve(file, s, k);
        if (sel fixed.some) { v.multipliers[k] = fixed.some; }
        k = k + 1;
    }
    var i: u32 = 0;
    for (i < count) {
        if (admits(s, ?file.registers[i])) { bitset.set(?v.rows, i::usize); }
        i = i + 1;
    }
    ret res[Available, Error].ok{v};
}

# release a view's storage
pub fun release(v: *Available) err[A.Error] {
    if (v.multipliers != nil) { A.deallocate[u32](v.allocator, v.multipliers, v.file.scale_count::usize); }
    ret bitset.dnit(?v.rows);
}

# the register `reg` through the view
# ---
# ret: ok when the view holds it, or why it does not
pub fun admitted(v: *Available, reg: Id) err[Absent] {
    if (v.file == nil) { ret err[Absent].err{Absent.unknown{}}; }
    val at: opt[u32] = index_of(v.file, reg);
    if (sel at.none)                         { ret err[Absent].err{Absent.unknown{}}; }
    if (bitset.get(?v.rows, at.some::usize)) { ret err[Absent].ok{}; }
    val row: *Register = ?v.file.registers[at.some];
    ret err[Absent].err{Absent.unavailable{Unavailable{row: row, requires: row.requires}}};
}

# why `u` was refused spelled onto `out`: the register's name, then its requirement as the one renderer words it
pub fun spell(v: *Available, u: *Unavailable, out: *vector.Vector[u8]) err[A.Error] {
    val named: err[A.Error] = extension.append(out, u.row.name);
    if (sel named.err) { ret named; }
    val gap: err[A.Error] = extension.append(out, " ");
    if (sel gap.err) { ret gap; }
    ret extension.spell_requirement(v.selection, u.requires, out);
}

# the register spelled `name` through the view, by its name or one of its aliases
# ---
# ret: the register, or why the view refuses the name
pub fun lookup(v: *Available, name: View) res[Id, Absent] {
    if (v.file == nil) { ret res[Id, Absent].err{Absent.unknown{}}; }
    val found: opt[Id] = named(v.file, name);
    if (sel found.none) { ret res[Id, Absent].err{Absent.unknown{}}; }
    val held: err[Absent] = admitted(v, found.some);
    if (sel held.err) { ret res[Id, Absent].err{held.err}; }
    ret res[Id, Absent].ok{found.some};
}

# the multiplier the selection fixes for scale `scale`, none when no extension of
# it does or the file has no such scale
pub fun multiplier(v: *Available, scale: u8) opt[u32] {
    if (v.file == nil || scale::u32 >= v.file.scale_count) { ret opt[u32].none{}; }
    val m: u32 = v.multipliers[scale];
    if (m == 0) { ret opt[u32].none{}; }
    ret opt[u32].some{m};
}

# the bits of each member of the class of `reg` through the view
# ---
# ret: the width, none when its scale is unknown to the selection, or why the view refuses the register
pub fun width(v: *Available, reg: Id) res[opt[u64], Absent] {
    val held: err[Absent] = admitted(v, reg);
    if (sel held.err) { ret res[opt[u64], Absent].err{held.err}; }
    val q: Scaled = v.file.classes[class_of(reg)].width;
    if (q.per == 0) { ret res[opt[u64], Absent].ok{opt[u64].some{q.fixed::u64}}; }
    val m: opt[u32] = multiplier(v, q.scale);
    if (sel m.none) { ret res[opt[u64], Absent].ok{opt[u64].none{}}; }
    ret res[opt[u64], Absent].ok{opt[u64].some{at(q, m.some::u64)}};
}

# the value of `q` at multiplier `m` of its scale
fun at(q: Scaled, m: u64) u64 {
    ret q.fixed::u64 + q.per::u64 * m;
}

# the scale a row's footprint varies with, none when it is fixed
fun scale_of(file: *File, row: *Register) opt[u8] {
    val width: Scaled = file.classes[row.class].width;
    if (width.per != 0)      { ret opt[u8].some{width.scale}; }
    if (row.offset.per != 0) { ret opt[u8].some{row.offset.scale}; }
    if (row.stride.per != 0) { ret opt[u8].some{row.stride.scale}; }
    if (row.count.per != 0)  { ret opt[u8].some{row.count.scale}; }
    ret opt[u8].none{};
}

# the largest multiplier of a scale, 1 for a fixed footprint
fun scale_max(file: *File, scale: opt[u8]) u64 {
    if (sel scale.some) { ret file.scales[scale.some].max::u64; }
    ret 1;
}

# whether the footprints of `a` at multiplier `ma` and `b` at `mb` intersect
fun intersect(file: *File, a: *Register, ma: u64, b: *Register, mb: u64) bool {
    val a_offset: u64 = at(a.offset, ma);
    val a_stride: u64 = at(a.stride, ma);
    val a_count:  u64 = at(a.count, ma);
    val a_width:  u64 = at(file.classes[a.class].width, ma);
    val b_offset: u64 = at(b.offset, mb);
    val b_stride: u64 = at(b.stride, mb);
    val b_count:  u64 = at(b.count, mb);
    val b_width:  u64 = at(file.classes[b.class].width, mb);
    if (a_width == 0 || b_width == 0 || b_count == 0) { ret false; }
    var i: u64 = 0;
    for (i < a_count) {
        val start: u64 = a_offset + i * a_stride;
        # only the first piece of b ending past start can begin before this piece ends
        var j: u64 = 0;
        if (b_offset + b_width <= start) {
            if (b_stride == 0) { ret false; }
            j = (start - b_offset - b_width) / b_stride + 1;
        }
        if (j < b_count && b_offset + j * b_stride < start + a_width) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether rows `a` and `b` of `file` share storage at some legal multiplier of
# each scale, which is what an allocator must assume when the scale is unknown
pub fun overlap(file: *File, a: *Register, b: *Register) bool {
    if (a.bank != b.bank) { ret false; }
    val sa:   opt[u8] = scale_of(file, a);
    val sb:   opt[u8] = scale_of(file, b);
    var same: bool    = false;
    if (sel sa.some) {
        if (sel sb.some) { same = sa.some == sb.some; }
    }
    var ma: u64 = 1;
    for (ma <= scale_max(file, sa)) {
        var mb: u64 = 1;
        for (mb <= scale_max(file, sb)) {
            if ((!same || ma == mb) && intersect(file, a, ma, b, mb)) { ret true; }
            mb = mb * 2;
        }
        ma = ma * 2;
    }
    ret false;
}

# slices of the x86-64, risc-v and aarch64 files for the tests below
#[testing]
val X86_CLASSES: [4]Class = [4]Class{
    Class{kind: GENERAL, width: Scaled{fixed: 64, per: 0, scale: 0}, count: 32},
    Class{kind: GENERAL, width: Scaled{fixed: 16, per: 0, scale: 0}, count: 32},
    Class{kind: GENERAL, width: Scaled{fixed: 8, per: 0, scale: 0}, count: 32},
    Class{kind: GENERAL, width: Scaled{fixed: 8, per: 0, scale: 0}, count: 8},
};

#[testing]
val X86_REGISTERS: [5]Register = [5]Register{
    Register{name: "rax", class: 0, number: 0, bank: 0, offset: Scaled{fixed: 0, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 0, scale: 0}, count: Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: extension.NONE},
    Register{name: "ax", class: 1, number: 0, bank: 0, offset: Scaled{fixed: 0, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 0, scale: 0}, count: Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: extension.NONE},
    Register{name: "al", class: 2, number: 0, bank: 0, offset: Scaled{fixed: 0, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 0, scale: 0}, count: Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: extension.NONE},
    Register{name: "ah", class: 3, number: 4, bank: 0, offset: Scaled{fixed: 8, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 0, scale: 0}, count: Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: extension.NONE},
    Register{name: "rsp", class: 0, number: 4, bank: 4, offset: Scaled{fixed: 0, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 0, scale: 0}, count: Scaled{fixed: 1, per: 0, scale: 0}, flags: STACK, requires: extension.NONE},
};

#[testing]
val X86_DWARF:    [5]u32 = [5]u32{0, UNNUMBERED, UNNUMBERED, UNNUMBERED, 7};
#[testing]
val X86_CODEVIEW: [5]u32 = [5]u32{328, 9, 1, 5, 335};

#[testing]
val X86_COLUMNS: [2]Column = [2]Column{
    Column{format: DWARF, numbers: ?X86_DWARF[0], len: 5},
    Column{format: CODEVIEW, numbers: ?X86_CODEVIEW[0], len: 5},
};

#[testing]
val X86: File = File{
    scales:         nil,
    scale_count:    0,
    classes:        ?X86_CLASSES[0],
    class_count:    4,
    registers:      ?X86_REGISTERS[0],
    register_count: 5,
    aliases:        nil,
    alias_count:    0,
    columns:        ?X86_COLUMNS[0],
    column_count:   2,
};

# rv32 and rv64 fix xlen at 1 and 2, and rv128 would fix it at 4. f, d and q fix flen at 1, 2 and 4
#[testing]
val RISCV_XLEN: [2]Fixing = [2]Fixing{
    Fixing{by: 2, multiplier: 1},
    Fixing{by: 3, multiplier: 2},
};

#[testing]
val RISCV_FLEN: [3]Fixing = [3]Fixing{
    Fixing{by: 4, multiplier: 1},
    Fixing{by: 5, multiplier: 2},
    Fixing{by: 6, multiplier: 4},
};

#[testing]
val RISCV_SCALES: [2]Scale = [2]Scale{
    Scale{name: "xlen", max: 4, fixes: Fixings{at: ?RISCV_XLEN[0], len: 2}},
    Scale{name: "flen", max: 4, fixes: Fixings{at: ?RISCV_FLEN[0], len: 3}},
};

#[testing]
val RISCV_CLASSES: [2]Class = [2]Class{
    Class{kind: GENERAL, width: Scaled{fixed: 0, per: 32, scale: 0}, count: 32},
    Class{kind: FLOAT, width: Scaled{fixed: 0, per: 32, scale: 1}, count: 32},
};

# x16 exists only with the i base, which the e base conflicts with
#[testing]
val RISCV_I:     [1]extension.Id  = [1]extension.Id{0};
#[testing]
val RISCV_I_ALT: [1]extension.Ids = [1]extension.Ids{extension.Ids{at: ?RISCV_I[0], len: 1}};

#[testing]
val RISCV_REGISTERS: [5]Register = [5]Register{
    Register{name: "x0", class: 0, number: 0, bank: 0, offset: Scaled{fixed: 0, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 0, scale: 0}, count: Scaled{fixed: 1, per: 0, scale: 0}, flags: ZERO, requires: extension.NONE},
    Register{name: "x2", class: 0, number: 2, bank: 2, offset: Scaled{fixed: 0, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 0, scale: 0}, count: Scaled{fixed: 1, per: 0, scale: 0}, flags: STACK, requires: extension.NONE},
    Register{name: "x8", class: 0, number: 8, bank: 8, offset: Scaled{fixed: 0, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 0, scale: 0}, count: Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: extension.NONE},
    Register{name: "x16", class: 0, number: 16, bank: 16, offset: Scaled{fixed: 0, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 0, scale: 0}, count: Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: extension.Requirement{at: ?RISCV_I_ALT[0], len: 1}},
    Register{name: "f0", class: 1, number: 0, bank: 32, offset: Scaled{fixed: 0, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 0, scale: 0}, count: Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: extension.NONE},
};

#[testing]
val RISCV_ALIASES: [4]Alias = [4]Alias{
    Alias{name: "zero", register: 0},
    Alias{name: "sp", register: 1},
    Alias{name: "s0", register: 2},
    Alias{name: "fp", register: 2},
};

#[testing]
val RISCV: File = File{
    scales:         ?RISCV_SCALES[0],
    scale_count:    2,
    classes:        ?RISCV_CLASSES[0],
    class_count:    2,
    registers:      ?RISCV_REGISTERS[0],
    register_count: 5,
    aliases:        ?RISCV_ALIASES[0],
    alias_count:    4,
    columns:        nil,
    column_count:   0,
};

#[testing]
val AARCH64_SCALES: [1]Scale = [1]Scale{
    Scale{name: "svl", max: 16, fixes: Fixings{at: nil, len: 0}},
};

# za has svl / 8 rows of svl bits, and zan.d takes every eighth row from row n
#[testing]
val AARCH64_CLASSES: [2]Class = [2]Class{
    Class{kind: TILE, width: Scaled{fixed: 0, per: 128, scale: 0}, count: 1},
    Class{kind: TILE, width: Scaled{fixed: 0, per: 128, scale: 0}, count: 8},
};

#[testing]
val AARCH64_REGISTERS: [3]Register = [3]Register{
    Register{name: "za0.b", class: 0, number: 0, bank: 0, offset: Scaled{fixed: 0, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 128, scale: 0}, count: Scaled{fixed: 0, per: 16, scale: 0}, flags: 0, requires: extension.NONE},
    Register{name: "za0.d", class: 1, number: 0, bank: 0, offset: Scaled{fixed: 0, per: 0, scale: 0}, stride: Scaled{fixed: 0, per: 1024, scale: 0}, count: Scaled{fixed: 0, per: 2, scale: 0}, flags: 0, requires: extension.NONE},
    Register{name: "za1.d", class: 1, number: 1, bank: 0, offset: Scaled{fixed: 0, per: 128, scale: 0}, stride: Scaled{fixed: 0, per: 1024, scale: 0}, count: Scaled{fixed: 0, per: 2, scale: 0}, flags: 0, requires: extension.NONE},
};

#[testing]
val AARCH64: File = File{
    scales:         ?AARCH64_SCALES[0],
    scale_count:    1,
    classes:        ?AARCH64_CLASSES[0],
    class_count:    2,
    registers:      ?AARCH64_REGISTERS[0],
    register_count: 3,
    aliases:        nil,
    alias_count:    0,
    columns:        nil,
    column_count:   0,
};

test named__name_and_alias_reach_one_id {
    val x8: opt[Id] = named(?RISCV, view("x8", 2));
    val s0: opt[Id] = named(?RISCV, view("s0", 2));
    val fp: opt[Id] = named(?RISCV, view("fp", 2));
    if (!sel x8.some)                                                      { ret 1; }
    if (!sel s0.some)                                                      { ret 2; }
    if (!sel fp.some)                                                      { ret 3; }
    if (x8.some != make(0, 8) || s0.some != x8.some || fp.some != x8.some) { ret 4; }
    ret 0;
}

#[testing]
val RISCV_D: [1]extension.Id = [1]extension.Id{5};

#[testing]
val RISCV_F: [1]extension.Id = [1]extension.Id{4};

#[testing]
val RISCV_BASES: [7]extension.Extension = [7]extension.Extension{
    extension.Extension{name: "i", implies: extension.Ids{at: nil, len: 0}, revision: "2.1"},
    extension.Extension{name: "e", implies: extension.Ids{at: nil, len: 0}, revision: "2.0"},
    extension.Extension{name: "rv32", implies: extension.Ids{at: nil, len: 0}, revision: "2.1"},
    extension.Extension{name: "rv64", implies: extension.Ids{at: nil, len: 0}, revision: "2.1"},
    extension.Extension{name: "f", implies: extension.Ids{at: nil, len: 0}, revision: "2.2"},
    extension.Extension{name: "d", implies: extension.Ids{at: ?RISCV_F[0], len: 1}, revision: "2.2"},
    extension.Extension{name: "q", implies: extension.Ids{at: ?RISCV_D[0], len: 1}, revision: "2.2"},
};

#[testing]
val RISCV_BASE_CONFLICT: [2]extension.Conflict = [2]extension.Conflict{extension.Conflict{a: 0, b: 1}, extension.Conflict{a: 2, b: 3}};

#[testing]
val RISCV_CATALOG: extension.Catalog = extension.Catalog{extensions: ?RISCV_BASES[0], count: 7, levels: nil, level_count: 0, conflicts: ?RISCV_BASE_CONFLICT[0], conflict_count: 2, combinations: nil, combination_count: 0, syntax: ?extension.LIST};

test lookup__an_unavailable_register_is_refused_naming_every_alternative {
    var t: testing.Testing;
    testing.make(?t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?RISCV_CATALOG, "e", diagnostic.START);
    if (sel made.err) { ret 1; }
    var s:      extension.Selection   = made.ok;
    val viewed: res[Available, Error] = select(testing.allocator_of(?t), ?RISCV, ?s);
    if (sel viewed.err) { ret 2; }
    var v:   Available       = viewed.ok;
    val x16: res[Id, Absent] = lookup(?v, view("x16", 3));
    if (sel x16.ok)                                                                     { ret 3; }
    if (!(sel x16.err.unavailable && (x16.err.unavailable.row == ?RISCV_REGISTERS[3]))) { ret 4; }
    var u: Unavailable;
    if (sel x16.err.unavailable) { u = x16.err.unavailable; }
    var out:    vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t));
    val worded: err[A.Error]      = spell(?v, ?u, ?out);
    if (sel worded.err || !extension.t_spelled(?out, "x16 needs i")) { ret 7; }
    vector.dnit[u8](?out);
    val f_q:    [2]extension.Id  = [2]extension.Id{4, 6};
    val either: [2]extension.Ids = [2]extension.Ids{extension.Ids{at: ?RISCV_I[0], len: 1}, extension.Ids{at: ?f_q[0], len: 2}};
    var two:    Unavailable      = u;
    two.requires = extension.Requirement{at: ?either[0], len: 2};
    out          = vector.init[u8](testing.allocator_of(?t));
    val both: err[A.Error] = spell(?v, ?two, ?out);
    if (sel both.err || !extension.t_spelled(?out, "x16 needs i, or f and q")) { ret 8; }
    vector.dnit[u8](?out);
    val s0: res[Id, Absent] = lookup(?v, view("s0", 2));
    if (!(sel s0.ok && s0.ok == make(0, 8))) { ret 5; }
    release(?v);
    extension.release(?s);
    if (testing.live_count(?t) != 0) { ret 6; }
    ret 0;
}

# the width of the register `reg` under the selection `spelling`, in `bits` when known
#[testing]
fun t_width(spelling: str, reg: Id, known: *bool, bits: *u64) u8 {
    var t: testing.Testing;
    testing.make(?t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?RISCV_CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret 1; }
    var s:      extension.Selection   = made.ok;
    val viewed: res[Available, Error] = select(testing.allocator_of(?t), ?RISCV, ?s);
    if (sel viewed.err) { ret 2; }
    var v:    Available             = viewed.ok;
    val read: res[opt[u64], Absent] = width(?v, reg);
    if (sel read.err) { ret 3; }
    @known = sel read.ok.some;
    if (sel read.ok.some) { @bits = read.ok.some; }
    release(?v);
    extension.release(?s);
    if (testing.live_count(?t) != 0) { ret 4; }
    ret 0;
}

test width__resolves_where_an_extension_fixes_the_scale_and_nested_fixings_take_the_largest {
    var known: bool = false;
    var bits:  u64  = 0;
    if (t_width("i,rv32", make(0, 0), ?known, ?bits) != 0 || !known || bits != 32)    { ret 1; }
    if (t_width("i,rv64", make(0, 0), ?known, ?bits) != 0 || !known || bits != 64)    { ret 2; }
    if (t_width("i", make(0, 0), ?known, ?bits) != 0 || known)                        { ret 3; }
    if (t_width("i,rv64,f", make(1, 0), ?known, ?bits) != 0 || !known || bits != 32)  { ret 4; }
    if (t_width("i,rv64,d", make(1, 0), ?known, ?bits) != 0 || !known || bits != 64)  { ret 5; }
    if (t_width("i,rv64,q", make(1, 0), ?known, ?bits) != 0 || !known || bits != 128) { ret 6; }
    ret 0;
}

test named__unknown_name_refused {
    val partial: opt[Id] = named(?RISCV, view("s", 1));
    val unknown: opt[Id] = named(?RISCV, view("x9", 2));
    if (!sel partial.none || !sel unknown.none) { ret 1; }
    ret 0;
}

test overlap__shared_bank_both_directions {
    val rax: *Register = ?X86_REGISTERS[0];
    val ax:  *Register = ?X86_REGISTERS[1];
    val al:  *Register = ?X86_REGISTERS[2];
    val ah:  *Register = ?X86_REGISTERS[3];
    val rsp: *Register = ?X86_REGISTERS[4];
    if (!overlap(?X86, ah, rax) || !overlap(?X86, rax, ah)) { ret 1; }
    if (!overlap(?X86, al, ax) || !overlap(?X86, ax, al))   { ret 2; }
    if (overlap(?X86, al, ah) || overlap(?X86, ah, al))     { ret 3; }
    if (overlap(?X86, rsp, rax) || overlap(?X86, rax, rsp)) { ret 4; }
    ret 0;
}

test overlap__strided_tiles {
    val za0_b: *Register = ?AARCH64_REGISTERS[0];
    val za0_d: *Register = ?AARCH64_REGISTERS[1];
    val za1_d: *Register = ?AARCH64_REGISTERS[2];
    if (!overlap(?AARCH64, za0_d, za0_b) || !overlap(?AARCH64, za0_b, za0_d)) { ret 1; }
    if (overlap(?AARCH64, za0_d, za1_d) || overlap(?AARCH64, za1_d, za0_d))   { ret 2; }
    ret 0;
}

test make__packs_and_unpacks {
    val reg: Id = make(0x1234, 0xABCD);
    if (class_of(reg) != 0x1234 || number_of(reg) != 0xABCD) { ret 1; }
    if (make(0, 0) == NONE)                                  { ret 2; }
    ret 0;
}

test debug_number__read_per_column {
    val rax:    opt[u32] = debug_number(?X86, make(0, 0), DWARF);
    val rax_cv: opt[u32] = debug_number(?X86, make(0, 0), CODEVIEW);
    val al:     opt[u32] = debug_number(?X86, make(2, 0), DWARF);
    val al_cv:  opt[u32] = debug_number(?X86, make(2, 0), CODEVIEW);
    if (!sel rax.some)      { ret 1; }
    if (rax.some != 0)      { ret 2; }
    if (!sel rax_cv.some)   { ret 3; }
    if (rax_cv.some != 328) { ret 4; }
    if (!sel al.none)       { ret 5; }
    if (!sel al_cv.some)    { ret 6; }
    if (al_cv.some != 1)    { ret 7; }
    ret 0;
}
