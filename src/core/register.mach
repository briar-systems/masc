# the register model every instruction set fills in
#
# a register file is static rows: classes, registers and one debug number
# column per format. the parser, the printer, the encoder, the cfi writer and
# mirl's allocator all read these rows, so no register fact lives anywhere
# else. reserved and allocatable sets are calling-convention facts and are not
# modelled here.
#
# a register row states what a selection and the state code runs under must
# hold for it to exist, over extensions and state values, as x86's r8 needs
# 64-bit width and risc-v's x16 to x31 need the i base. a context filters the
# file through these conditions once (`masc.core.state.select`), and every
# query after that reads its view.
#
# registers of one bank share its storage, each a footprint within it. a
# register whose physical storage is chosen at run time, as x87 st(i) relative
# to the stack top, a slice of a tile its index register names, or a register of
# a renaming window, states the places it may be, and is exactly one of them.
# two rows overlap when some place of each shares storage, and one lies within
# another only at every place of each, so a may-alias pair overlaps, neither
# contains the other and no write of one provably kills the other.
#
# a write through a register leaves the rest of its bank as far as its row's
# reach names it, the whole bank past its footprint or a stated part of it, as
# an mmx write sets only the exponent of its own x87 register. it keeps, clears
# or sets that rest as its row states, unless the write's encoding decides it,
# as x86 vex does for a vector register. `overwrites` derives what a write
# overwrites from those facts and the footprints, so a reader ending the values
# a write kills asks it alone.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;
use std.allocator.testing;
use std.collections.bitset;
use std.collections.vector;

#[testing]
use masc.core.extension;
use masc.core.index;
use masc.core.quantity;
use masc.core.requirement;

# a register's identity: its class index plus one in the high half and its
# hardware number in the low half, so 0 names no register
pub def Id: u32;

pub val NONE: Id = 0;

# the kind of storage a class names
pub def Kind: u8;

pub val GENERAL:   Kind = 0;
pub val FLOAT:     Kind = 1;
pub val VECTOR:    Kind = 2;
pub val PREDICATE: Kind = 3;
pub val FLAGS:     Kind = 4;
pub val TILE:      Kind = 5;
pub val SYSTEM:    Kind = 6;

# a class of registers an operand can name
# ---
# name:  its name, unique within the file and stable: a saved text names the class by it, so it never depends on the class's place
# kind:  what its members hold
# width: the bits of each member, or of one row of a tile
# count: the hardware numbers its encoding spans, 0 to count - 1, which may scale with the slot of its width, as the
#        slices of an sme tile number svl / esize. a member past the count a context resolves does not exist there
pub rec Class {
    name:  str;
    kind:  Kind;
    width: quantity.Scaled;
    count: quantity.Scaled;
}

# fixed architectural roles, as bits of a register's flags
# ---
# STACK:   the stack pointer
# ZERO:    a register that reads zero and discards what is written to it
# PC:      the program counter
# ACCRUED: a register an instruction adds to rather than replaces, as risc-v fflags and vxsat, so a write of it keeps
#          what it held and is a read as well
# LENGTH:  the count of elements a vector instruction acts on, as risc-v vl. an instruction that reads it writes a vector
#          register only up to it and may keep the elements past it, so it reads every vector register it writes
pub def Flags: u8;

pub val STACK:   Flags = 0x1;
pub val ZERO:    Flags = 0x2;
pub val PC:      Flags = 0x4;
pub val ACCRUED: Flags = 0x8;
pub val LENGTH:  Flags = 0x10;

# what a write through a register leaves in the rest of its bank, the storage past its own footprint that other
# registers of the bank hold, as far as the row's reach names it, the rest past the reach always kept. a reach holding
# nothing another register holds leaves nothing to extend into, so only KEEP is stated there. every row states one and
# check refuses UNSTATED, so a row that forgets its fact never reads as keeping
# ---
# UNSTATED: no fact, the value of a row that states none
# KEEP:     the rest keeps its value, as x86 ax, al and ah within rax, a legacy sse write of xmm0 within ymm0, or a
#           risc-v csr field within the csr that holds it
# ZEROES:   the rest is cleared, as x86 eax within rax, aarch64 w0 within x0, or a vex write of xmm0 up to the widest
#           vector register
# ONES:     the rest is set, as a narrower float nan-boxed within a wider float register, or an mmx write of the
#           exponent of the x87 register it shares, the part of the bank its row's reach names
pub def Extend: u8;

pub val UNSTATED: Extend = 0;
pub val KEEP:     Extend = 1;
pub val ZEROES:   Extend = 2;
pub val ONES:     Extend = 3;

# what one write leaves in the rest of its register's bank. row is the first case, so an operand that states
# nothing writes as its register's row does, which is the deliberate default: only an encoding that decides the
# extension states another
# ---
# row:    as the register's row states
# extend: this, whatever the row states, where the instruction's encoding decides it, as a vex write of xmm0
#         zeroing the rest of ymm0 that a legacy sse write keeps
pub tag Write: u8 {
    row;
    extend: Extend;
}

# the places a register may be, one of which it is at any moment and none of which a static fact can choose, as x87
# st(i) is one of the eight physical registers by the stack top, a tile slice is one of its tile's by the index register
# naming it, or a windowed register is one of each window's by the current window. the places are a set, so a window
# that wraps around its bank states its first place at the lowest offset
# ---
# count: how many places, 1 for a register at one place. at least 1 at every multiplier
# step:  the bits from the start of one place to the next, so place k's pieces start at the row's offset plus k times
#        step. never 0 where count exceeds 1, which would state one place twice
pub rec Places {
    count: quantity.Scaled;
    step:  quantity.Scaled;
}

pub val ONE_PLACE: Places = Places{count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, step: quantity.Scaled{fixed: 0, per: 0, scale: 0}};

# a part of a bank stated relative to a register's place, which moves with the place
# ---
# offset: the bit of the part's first piece past the start of the register's first piece at its place
# stride: the bits from the start of one piece to the next
# count:  the pieces
# width:  the bits of each piece
pub rec Part {
    offset: quantity.Scaled;
    stride: quantity.Scaled;
    count:  quantity.Scaled;
    width:  quantity.Scaled;
}

# the part of its bank past its footprint a write's extension reaches, what an extension other than KEEP clears or sets
# ---
# bank: the whole bank past the footprint, as eax within rax or xmm0 within zmm0
# part: the part only, the rest of the bank kept, as an mmx write sets bits 64 to 79 of its own x87 register (Intel SDM
#       Vol. 1 9.6.2) and keeps the others. it holds storage at every multiplier and lies clear of the register's own
pub tag Reach: u8 {
    bank;
    part: Part;
}

# one register
# ---
# name:     the spelling the printer writes
# class:    the index of its class in the file
# number:   its hardware number within the class
# bank:     the storage it shares with every register of the same bank
# offset:   the bit within the bank where its first piece starts, at its first place
# stride:   the bits from the start of one of its pieces to the next
# count:    its pieces, each its class's width, so a contiguous register has 1
# places:   the places it may be, ONE_PLACE for a register whose storage no run-time state chooses
# flags:    its fixed architectural roles
# requires: what a selection and its state must hold for it to exist, over extensions and state values, none for every one
# extend:   what a write through it leaves in the part of its bank `reach` names, unless the write states otherwise. never UNSTATED
# reach:    the part of its bank past its footprint a write's extension reaches
pub rec Register {
    name:     str;
    class:    u16;
    number:   u16;
    bank:     u16;
    offset:   quantity.Scaled;
    stride:   quantity.Scaled;
    count:    quantity.Scaled;
    places:   Places;
    flags:    Flags;
    requires: requirement.Requirement;
    extend:   Extend;
    reach:    Reach;
}

# a further spelling of a register the parser accepts
# ---
# name:     the spelling
# register: the index of the register it names in the file's rows
#
# a file lists its aliases in ascending order of register, and the first alias
# of a register is the one a syntax that writes aliases prefers
pub rec Alias {
    name:     str;
    register: u32;
}

# a debug format that numbers registers
pub def Format: u8;

pub val DWARF:    Format = 0;
pub val CODEVIEW: Format = 1;

# the number a column holds for a register the format does not number
pub val UNNUMBERED: u32 = 0xFFFF_FFFF;

# one debug format's numbers, parallel to the file's registers
# ---
# format:   the format
# numbers:  one number per register row
# len:      how many numbers there are, the file's register count
# numbered: the registers it numbers, by number, one entry per numbered register
pub rec Column {
    format:   Format;
    numbers:  *u32;
    len:      u32;
    numbered: index.Numbers;
}

# a register file: its quantities and the slots that bind them, classes, registers, aliases and debug columns
# ---
# quantities:  the quantities its widths and footprints scale with
# bindings:    which quantity each slot binds under which requirement, every slot below slot_count bound by one at least
# slot_count:  how many slots a scaled amount may name
# class_names: the classes by name, one entry per class
# registers:   the register rows in ascending order of identity, so a row is found by binary search of the rows
# names:       the registers by spelling, one entry per register row and per alias. an entry's row is the register's own row, or the
#              register count plus the alias's index
# columns:     the debug columns in ascending order of format, one per format
pub rec File {
    quantities:     quantity.Quantities;
    bindings:       quantity.Bindings;
    slot_count:     u32;
    classes:        *Class;
    class_count:    u32;
    class_names:    index.Index;
    registers:      *Register;
    register_count: u32;
    aliases:        *Alias;
    alias_count:    u32;
    names:          index.Index;
    columns:        *Column;
    column_count:   u32;
}

# the identity of hardware number `number` in class `class`
pub fun make(class: u16, number: u16) Id {
    ret ((class::u32 + 1) << 16) | number::u32;
}

# the class index of `reg`, which names a register
pub fun class_of(reg: Id) u16 {
    ret ((reg >> 16) - 1)::u16;
}

# the hardware number of `reg` within its class
pub fun number_of(reg: Id) u16 {
    ret (reg & 0xFFFF)::u16;
}

# the identity of a register row
pub fun id_of(row: *Register) Id {
    ret make(row.class, row.number);
}

# the row of the register that bearer `bearer` of the name index spells
fun owner(file: *File, bearer: u32) u32 {
    if (bearer < file.register_count) { ret bearer; }
    ret file.aliases[bearer - file.register_count].register;
}

# the register spelled `name` in `file`, by its name or one of its aliases, whatever the selection. a `fold` reads the capitals of `name`
# as lower case, which the registration check makes exact for a set whose syntax folds
pub fun named(file: *File, name: View, fold: bool) opt[Id] {
    val row: opt[u32] = row_named(file, name, fold);
    if (sel row.none) { ret opt[Id].none{}; }
    ret opt[Id].some{id_of(?file.registers[row.some])};
}

# the row of `file` of the register spelled `name`, the lookup `named` reads
pub fun row_named(file: *File, name: View, fold: bool) opt[u32] {
    val bearer: opt[u32] = index.find_view(?file.names, name, fold);
    if (sel bearer.none) { ret bearer; }
    ret opt[u32].some{owner(file, bearer.some)};
}

# the row index of `reg` in `file`
pub fun index_of(file: *File, reg: Id) opt[u32] {
    if (reg == NONE) { ret opt[u32].none{}; }
    var lo: u32 = 0;
    var hi: u32 = file.register_count;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (id_of(?file.registers[mid]) < reg) { lo = mid + 1; }
        or                                     { hi = mid; }
    }
    if (lo >= file.register_count || id_of(?file.registers[lo]) != reg) { ret opt[u32].none{}; }
    ret opt[u32].some{lo};
}

# the first alias of the register `reg` of `file`, none when it has none
pub fun first_alias(file: *File, reg: Id) opt[*Alias] {
    val row: opt[u32] = index_of(file, reg);
    if (sel row.none) { ret opt[*Alias].none{}; }
    var lo: u32 = 0;
    var hi: u32 = file.alias_count;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (file.aliases[mid].register < row.some) { lo = mid + 1; }
        or                                         { hi = mid; }
    }
    if (lo >= file.alias_count || file.aliases[lo].register != row.some) { ret opt[*Alias].none{}; }
    ret opt[*Alias].some{?file.aliases[lo]};
}

# whether the bit of `reg`'s row is set in `words`, a bit set laid out over the rows of `file`, 64 rows to a word and `len` words long
pub fun bit(file: *File, words: *u64, len: u32, reg: Id) bool {
    val at: opt[u32] = index_of(file, reg);
    if (sel at.none) { ret false; }
    val row: u32 = at.some;
    if (row / 64 >= len) { ret false; }
    ret ((words[row / 64] >> (row % 64)::u64) & 1) != 0;
}

# the row of `reg` in `file`
pub fun row_of(file: *File, reg: Id) opt[*Register] {
    val at: opt[u32] = index_of(file, reg);
    if (!sel at.some) { ret opt[*Register].none{}; }
    ret opt[*Register].some{?file.registers[at.some]};
}

# the class row of `reg` in `file`
pub fun class_row(file: *File, reg: Id) opt[*Class] {
    if (reg == NONE || class_of(reg)::u32 >= file.class_count) { ret opt[*Class].none{}; }
    ret opt[*Class].some{?file.classes[class_of(reg)]};
}

# the index of the class of `file` named `name`
pub fun class_named(file: *File, name: str) opt[u16] {
    val at: opt[u32] = index.find(?file.class_names, name);
    if (sel at.none) { ret opt[u16].none{}; }
    ret opt[u16].some{at.some::u16};
}

# the column of `file` for `format`, by binary search of the columns, which a file keeps in ascending order of format
fun column_of(file: *File, format: Format) opt[*Column] {
    var lo: u32 = 0;
    var hi: u32 = file.column_count;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (file.columns[mid].format < format) { lo = mid + 1; }
        or                                     { hi = mid; }
    }
    if (lo >= file.column_count || file.columns[lo].format != format) { ret opt[*Column].none{}; }
    ret opt[*Column].some{?file.columns[lo]};
}

# the number `format` gives `reg`, none when the file has no such column or the format leaves it unnumbered
pub fun debug_number(file: *File, reg: Id, format: Format) opt[u32] {
    val at: opt[u32] = index_of(file, reg);
    if (!sel at.some) { ret opt[u32].none{}; }
    val column: opt[*Column] = column_of(file, format);
    if (sel column.none) { ret opt[u32].none{}; }
    val number: u32 = column.some.numbers[at.some];
    if (number == UNNUMBERED) { ret opt[u32].none{}; }
    ret opt[u32].some{number};
}

# the register `format` gives the number `number`, none when the file has no such column or no register has the number
pub fun from_debug_number(file: *File, number: u32, format: Format) opt[Id] {
    val column: opt[*Column] = column_of(file, format);
    if (sel column.none) { ret opt[Id].none{}; }
    val at: opt[u32] = index.find_number(?column.some.numbered, number::u64);
    if (sel at.none) { ret opt[Id].none{}; }
    ret opt[Id].some{id_of(?file.registers[at.some])};
}

# a context's view of a register file: the rows it admits, the quantity each slot binds and the range each quantity
# resolves to, which `masc.core.state.select` makes
# ---
# file:      the file, nil for a set with none, whose view then holds nothing
# allocator: the allocator the view's storage came from
# rows:      one bit per register row, set when the context admits it
# bound:     per slot, the index of the quantity it binds, quantity.UNBOUND when no binding holds
# ranges:    per quantity, the multipliers every bound that holds leaves, never empty
pub rec Available {
    file:      *File;
    allocator: *A.Allocator;
    rows:      bitset.Bitset;
    bound:     *u8;
    ranges:    *quantity.Range;
}

# why a view was not made
# ---
# memory: the allocator refused the view's storage
# empty:  the bounds that hold leave this quantity no multiplier, as a selection whose extensions state two vector lengths
pub tag Error: u8 {
    memory: A.Error;
    empty:  u8;
}

# a register named that the context does not admit
# ---
# row:      its row
# requires: its requirement, which the context leaves unmet or whose class does not number it under the context, rendered
#           by `masc.core.state.spell_requirement`
pub rec Unavailable {
    row:      *Register;
    requires: requirement.Requirement;
}

# why a view refused a register
# ---
# unknown:     no row of the file is it or spells it
# unavailable: its row's condition is unmet by the context
pub tag Absent: u8 {
    unknown;
    unavailable: Unavailable;
}

# a view of `file` admitting no row, every slot unbound and every quantity across its domain, which the context it is
# made for fills in
pub fun blank(a: *A.Allocator, file: *File) res[Available, Error] {
    var count:      u32 = 0;
    var slots:      u32 = 0;
    var quantities: u32 = 0;
    if (file != nil) {
        count      = file.register_count;
        slots      = file.slot_count;
        quantities = file.quantities.len;
    }
    val made: res[bitset.Bitset, A.Error] = bitset.init(a, count::usize);
    if (sel made.err) { ret res[Available, Error].err{Error.memory{made.err}}; }
    var v: Available = Available{file: file, allocator: a, rows: made.ok, bound: nil, ranges: nil};
    if (slots != 0) {
        val kept: res[*u8, A.Error] = A.allocate[u8](a, slots::usize);
        if (sel kept.err) {
            bitset.dnit(?v.rows);
            ret res[Available, Error].err{Error.memory{kept.err}};
        }
        v.bound = kept.ok;
        var k: u32 = 0;
        for (k < slots) {
            v.bound[k] = quantity.UNBOUND;
            k          = k + 1;
        }
    }
    if (quantities != 0) {
        val kept: res[*quantity.Range, A.Error] = A.allocate[quantity.Range](a, quantities::usize);
        if (sel kept.err) {
            release(?v);
            ret res[Available, Error].err{Error.memory{kept.err}};
        }
        v.ranges = kept.ok;
        var q: u32 = 0;
        for (q < quantities) {
            v.ranges[q] = quantity.span(file.quantities.at[q].domain);
            q           = q + 1;
        }
    }
    ret res[Available, Error].ok{v};
}

# row `row` of the file admitted by the view, which only the context making it sets
pub fun admit(v: *Available, row: u32) {
    bitset.set(?v.rows, row::usize);
}

# release a view's storage
pub fun release(v: *Available) err[A.Error] {
    if (v.bound != nil)  { A.deallocate[u8](v.allocator, v.bound, v.file.slot_count::usize); }
    if (v.ranges != nil) { A.deallocate[quantity.Range](v.allocator, v.ranges, v.file.quantities.len::usize); }
    ret bitset.dnit(?v.rows);
}

# the register `reg` through the view
# ---
# ret: ok when the view holds it, or why it does not
pub fun admitted(v: *Available, reg: Id) err[Absent] {
    if (v.file == nil) { ret err[Absent].err{Absent.unknown{}}; }
    val at: opt[u32] = index_of(v.file, reg);
    if (sel at.none)                         { ret err[Absent].err{Absent.unknown{}}; }
    if (bitset.get(?v.rows, at.some::usize)) { ret err[Absent].ok{}; }
    val row: *Register = ?v.file.registers[at.some];
    ret err[Absent].err{Absent.unavailable{Unavailable{row: row, requires: row.requires}}};
}

# the register spelled exactly `name` through the view, by its name or one of its aliases
# ---
# ret: the register, or why the view refuses the name
pub fun lookup(v: *Available, name: View) res[Id, Absent] {
    if (v.file == nil) { ret res[Id, Absent].err{Absent.unknown{}}; }
    val found: opt[Id] = named(v.file, name, false);
    if (sel found.none) { ret res[Id, Absent].err{Absent.unknown{}}; }
    val held: err[Absent] = admitted(v, found.some);
    if (sel held.err) { ret res[Id, Absent].err{held.err}; }
    ret res[Id, Absent].ok{found.some};
}

# the quantity slot `slot` binds through the view, none when no binding of it holds or the file has no such slot
pub fun bound(v: *Available, slot: u8) opt[u8] {
    if (v.file == nil || slot::u32 >= v.file.slot_count) { ret opt[u8].none{}; }
    if (v.bound[slot] == quantity.UNBOUND)               { ret opt[u8].none{}; }
    ret opt[u8].some{v.bound[slot]};
}

# the multipliers quantity `q` of the file resolves to through the view, its whole domain for a quantity the file has not
pub fun range(v: *Available, q: u8) quantity.Range {
    if (v.file == nil || q::u32 >= v.file.quantities.len) { ret quantity.Range{least: 1, most: 1}; }
    ret v.ranges[q];
}

# the multiplier the slot `slot` resolves to through the view: its bound quantity's when the context fixes it, none when
# the context leaves a choice to the implementation, binds no quantity or the file has no such slot
pub fun multiplier(v: *Available, slot: u8) opt[u32] {
    val q: opt[u8] = bound(v, slot);
    if (sel q.none) { ret opt[u32].none{}; }
    val r: quantity.Range = v.ranges[q.some];
    if (r.least != r.most) { ret opt[u32].none{}; }
    ret opt[u32].some{r.least};
}

# the most members the class `class` of `file` has through the view: its count at the largest multiplier its slot's
# quantity resolves to, or at the slot's largest legal multiplier when no binding of it holds
pub fun members(v: *Available, class: u16) u64 {
    val count: quantity.Scaled = v.file.classes[class].count;
    if (count.per == 0) { ret count.fixed::u64; }
    val q: opt[u8] = bound(v, count.scale);
    if (sel q.some) { ret quantity.at(count, v.ranges[q.some].most::u64); }
    ret quantity.at(count, slot_most(v.file, opt[u8].some{count.scale}));
}

# the bits of each member of the class of `reg` through the view
# ---
# ret: the width, none when its scale is unknown to the selection, or why the view refuses the register
pub fun width(v: *Available, reg: Id) res[opt[u64], Absent] {
    val held: err[Absent] = admitted(v, reg);
    if (sel held.err) { ret res[opt[u64], Absent].err{held.err}; }
    val q: quantity.Scaled = v.file.classes[class_of(reg)].width;
    if (q.per == 0) { ret res[opt[u64], Absent].ok{opt[u64].some{q.fixed::u64}}; }
    val m: opt[u32] = multiplier(v, q.scale);
    if (sel m.none) { ret res[opt[u64], Absent].ok{opt[u64].none{}}; }
    ret res[opt[u64], Absent].ok{opt[u64].some{quantity.at(q, m.some::u64)}};
}

# the scale a row's footprint varies with, none when it is fixed: its class width, pieces, places and reach take one
fun scale_of(file: *File, row: *Register) opt[u8] {
    val width: quantity.Scaled = file.classes[row.class].width;
    if (width.per != 0)            { ret opt[u8].some{width.scale}; }
    if (row.offset.per != 0)       { ret opt[u8].some{row.offset.scale}; }
    if (row.stride.per != 0)       { ret opt[u8].some{row.stride.scale}; }
    if (row.count.per != 0)        { ret opt[u8].some{row.count.scale}; }
    if (row.places.count.per != 0) { ret opt[u8].some{row.places.count.scale}; }
    if (row.places.step.per != 0)  { ret opt[u8].some{row.places.step.scale}; }
    if (sel row.reach.part) {
        val p: Part = row.reach.part;
        if (p.offset.per != 0) { ret opt[u8].some{p.offset.scale}; }
        if (p.stride.per != 0) { ret opt[u8].some{p.stride.scale}; }
        if (p.count.per != 0)  { ret opt[u8].some{p.count.scale}; }
        if (p.width.per != 0)  { ret opt[u8].some{p.width.scale}; }
    }
    ret opt[u8].none{};
}

# the least legal multiplier of slot `slot` past `m` among the quantities it may bind, 0 when none is, as no multiplier
# is 0. a fixed footprint, no slot, has the one multiplier 1. 0 starts at the first
pub fun slot_next(file: *File, slot: opt[u8], m: u64) u64 {
    if (sel slot.some) {
        var best: u64 = 0;
        var i:    u32 = 0;
        for (i < file.bindings.len) {
            val b: *quantity.Binding = ?file.bindings.at[i];
            if (b.slot == slot.some && b.quantity::u32 < file.quantities.len) {
                val n: opt[u64] = quantity.next(file.quantities.at[b.quantity].domain, m);
                if (sel n.some) {
                    if (best == 0 || n.some < best) { best = n.some; }
                }
            }
            i = i + 1;
        }
        ret best;
    }
    if (m == 0) { ret 1; }
    ret 0;
}

# the largest legal multiplier of slot `slot`, 1 for a fixed footprint or a slot binding nothing
pub fun slot_most(file: *File, slot: opt[u8]) u64 {
    var most: u64 = 1;
    var m:    u64 = slot_next(file, slot, 0);
    for (m != 0) {
        most = m;
        m    = slot_next(file, slot, m);
    }
    ret most;
}

# the most members class `class` of `file` has at any legal multiplier of its count's slot
pub fun count_most(file: *File, class: u16) u64 {
    val count: quantity.Scaled = file.classes[class].count;
    if (count.per == 0) { ret count.fixed::u64; }
    ret quantity.at(count, slot_most(file, opt[u8].some{count.scale}));
}

# the pieces of a register or a part at one multiplier and place, which is the one storage rule overlap, within and
# overwrites read
# ---
# offset: the bit within the bank where the first piece starts
# stride: the bits from the start of one piece to the next
# count:  the pieces
# width:  the bits of each piece
rec Pieces {
    offset: u64;
    stride: u64;
    count:  u64;
    width:  u64;
}

val NO_PIECES: Pieces = Pieces{offset: 0, stride: 0, count: 0, width: 0};

# the places of `row` at multiplier `m`
fun places_at(row: *Register, m: u64) u64 {
    ret quantity.at(row.places.count, m);
}

# the bit where the first piece of `row` starts at multiplier `m` and place `k`
fun start_of(row: *Register, m: u64, k: u64) u64 {
    ret quantity.at(row.offset, m) + k * quantity.at(row.places.step, m);
}

# the pieces of `row` at multiplier `m` and place `k`
fun pieces(file: *File, row: *Register, m: u64, k: u64) Pieces {
    ret Pieces{offset: start_of(row, m, k), stride: quantity.at(row.stride, m), count: quantity.at(row.count, m), width: quantity.at(file.classes[row.class].width, m)};
}

# the pieces of part `p` of the bank of `row` at multiplier `m` and place `k`
fun part_pieces(row: *Register, p: Part, m: u64, k: u64) Pieces {
    ret Pieces{offset: start_of(row, m, k) + quantity.at(p.offset, m), stride: quantity.at(p.stride, m), count: quantity.at(p.count, m), width: quantity.at(p.width, m)};
}

# the pieces of `row` at multiplier `m` and place `k`, or of the part `part` of its bank where one is given
fun footprint(file: *File, row: *Register, m: u64, k: u64, part: opt[Part]) Pieces {
    if (sel part.some) { ret part_pieces(row, part.some, m, k); }
    ret pieces(file, row, m, k);
}

# the first piece of `p` that ends past bit `start`, the only one that can begin before a piece starting there ends or contain it
fun reaching(p: Pieces, start: u64) opt[u64] {
    if (p.width == 0 || p.count == 0) { ret opt[u64].none{}; }
    var j: u64 = 0;
    if (p.offset + p.width <= start) {
        if (p.stride == 0) { ret opt[u64].none{}; }
        j = (start - p.offset - p.width) / p.stride + 1;
    }
    if (j >= p.count) { ret opt[u64].none{}; }
    ret opt[u64].some{j};
}

# whether pieces `pa` and `pb` share a bit
fun meet(pa: Pieces, pb: Pieces) bool {
    if (pa.width == 0 || pb.width == 0) { ret false; }
    var i: u64 = 0;
    for (i < pa.count) {
        val start: u64      = pa.offset + i * pa.stride;
        val j:     opt[u64] = reaching(pb, start);
        if (sel j.some) {
            if (pb.offset + j.some * pb.stride < start + pa.width) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# whether some place of `a` at multiplier `ma` shares storage with some place of `b` at `mb`, or of the part `part` of
# b's bank where one is given
fun intersect(file: *File, a: *Register, ma: u64, b: *Register, mb: u64, part: opt[Part]) bool {
    var ka: u64 = 0;
    for (ka < places_at(a, ma)) {
        val pa: Pieces = pieces(file, a, ma, ka);
        var kb: u64    = 0;
        for (kb < places_at(b, mb)) {
            if (meet(pa, footprint(file, b, mb, kb, part))) { ret true; }
            kb = kb + 1;
        }
        ka = ka + 1;
    }
    ret false;
}

# whether `a` shares storage with `b`, or with the part `part` of b's bank where one is given, at some legal multiplier
# of each scale, rows of one scale taking one multiplier
fun meets(file: *File, a: *Register, b: *Register, part: opt[Part]) bool {
    val sa:   opt[u8] = scale_of(file, a);
    val sb:   opt[u8] = scale_of(file, b);
    var same: bool    = false;
    if (sel sa.some) {
        if (sel sb.some) { same = sa.some == sb.some; }
    }
    var ma: u64 = slot_next(file, sa, 0);
    for (ma != 0) {
        var mb: u64 = slot_next(file, sb, 0);
        for (mb != 0) {
            if ((!same || ma == mb) && intersect(file, a, ma, b, mb, part)) { ret true; }
            mb = slot_next(file, sb, mb);
        }
        ma = slot_next(file, sa, ma);
    }
    ret false;
}

# whether rows `a` and `b` of `file` share storage at some legal multiplier of each scale and some place of each, which
# is what an allocator must assume when the scale or the place is unknown. a may-alias pair, as x87 st0 and mm3,
# overlaps
pub fun overlap(file: *File, a: *Register, b: *Register) bool {
    if (a.bank != b.bank) { ret false; }
    ret meets(file, a, b, opt[Part].none{});
}

# where the pieces of a part lie in the storage of a container
# ---
# offset: the bit of the part's first piece, counted from the container's first piece
# width:  the bits of each piece
# stride: the bits from the start of one piece to the next
# count:  the pieces, so piece i lies at offset + i * stride
pub rec Placement {
    offset: u64;
    width:  u64;
    stride: u64;
    count:  u64;
}

# where row `part` of `file` lies within row `container` when every scale has multiplier `multiplier`
# ---
# ret: the placement, none when the rows share no bank, a piece of part is not wholly inside one piece of container at
#      some place of each, or the placement differs between places, so a register with more than one place lies within
#      none and has none within it
pub fun within(file: *File, part: *Register, container: *Register, multiplier: u64) opt[Placement] {
    if (part.bank != container.bank) { ret opt[Placement].none{}; }
    var found: opt[Placement] = opt[Placement].none{};
    var kp:    u64            = 0;
    for (kp < places_at(part, multiplier)) {
        var kc: u64 = 0;
        for (kc < places_at(container, multiplier)) {
            val p: opt[Placement] = placed(pieces(file, part, multiplier, kp), pieces(file, container, multiplier, kc));
            if (sel p.none) { ret p; }
            if (sel found.some) {
                val f: Placement = found.some;
                if (f.offset != p.some.offset || f.width != p.some.width || f.stride != p.some.stride || f.count != p.some.count) { ret opt[Placement].none{}; }
            }
            found = p;
            kc    = kc + 1;
        }
        kp = kp + 1;
    }
    ret found;
}

# where pieces `p` lie within pieces `c`, each piece of p wholly inside one piece of c
fun placed(p: Pieces, c: Pieces) opt[Placement] {
    if (p.width == 0 || p.count == 0) { ret opt[Placement].none{}; }
    var i: u64 = 0;
    for (i < p.count) {
        val start: u64      = p.offset + i * p.stride;
        val j:     opt[u64] = reaching(c, start);
        if (sel j.none) { ret opt[Placement].none{}; }
        val from: u64 = c.offset + j.some * c.stride;
        if (start < from || start + p.width > from + c.width) { ret opt[Placement].none{}; }
        i = i + 1;
    }
    ret opt[Placement].some{Placement{offset: p.offset - c.offset, width: p.width, stride: p.stride, count: p.count}};
}

# the end of the piece of `p` holding bit `bit`, none when no piece holds it
fun holding(p: Pieces, bit: u64) opt[u64] {
    val j: opt[u64] = reaching(p, bit);
    if (sel j.none) { ret j; }
    val from: u64 = p.offset + j.some * p.stride;
    if (from > bit) { ret opt[u64].none{}; }
    ret opt[u64].some{from + p.width};
}

# whether every bit from `start` up to `end` lies in a piece of `a` or of `b`
fun covered(start: u64, end: u64, a: Pieces, b: Pieces) bool {
    var bit: u64 = start;
    for (bit < end) {
        var next: u64      = bit;
        val ea:   opt[u64] = holding(a, bit);
        val eb:   opt[u64] = holding(b, bit);
        if (sel ea.some) {
            if (ea.some > next) { next = ea.some; }
        }
        if (sel eb.some) {
            if (eb.some > next) { next = eb.some; }
        }
        if (next == bit) { ret false; }
        bit = next;
    }
    ret true;
}

# whether every bit of pieces `p` lies in a piece of `a` or of `b`, false for pieces holding nothing
fun lies(p: Pieces, a: Pieces, b: Pieces) bool {
    if (p.width == 0 || p.count == 0) { ret false; }
    var i: u64 = 0;
    for (i < p.count) {
        val start: u64 = p.offset + i * p.stride;
        if (!covered(start, start + p.width, a, b)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether every place of `part` at multiplier `mp` lies in every place of `whole` at `mw`, each place of whole with the
# part `reach` of its bank where one is given
fun lies_in(file: *File, part: *Register, mp: u64, whole: *Register, mw: u64, reach: opt[Part]) bool {
    var kw: u64 = 0;
    for (kw < places_at(whole, mw)) {
        val own:  Pieces = pieces(file, whole, mw, kw);
        var rest: Pieces = NO_PIECES;
        if (sel reach.some) { rest = part_pieces(whole, reach.some, mw, kw); }
        var kp: u64 = 0;
        for (kp < places_at(part, mp)) {
            if (!lies(pieces(file, part, mp, kp), own, rest)) { ret false; }
            kp = kp + 1;
        }
        kw = kw + 1;
    }
    ret true;
}

# whether row `part` of `file` lies within row `whole`, with the part `reach` of whole's bank where one is given, at
# every legal multiplier of each scale and every place of each, so whatever a selection fixes and wherever either is.
# rows of one scale take one multiplier, as overlap pairs them
fun inside(file: *File, part: *Register, whole: *Register, reach: opt[Part]) bool {
    if (part.bank != whole.bank) { ret false; }
    val sp:   opt[u8] = scale_of(file, part);
    val sw:   opt[u8] = scale_of(file, whole);
    var same: bool    = false;
    if (sel sp.some) {
        if (sel sw.some) { same = sp.some == sw.some; }
    }
    var mp: u64 = slot_next(file, sp, 0);
    for (mp != 0) {
        var mw: u64 = slot_next(file, sw, 0);
        for (mw != 0) {
            if ((!same || mp == mw) && !lies_in(file, part, mp, whole, mw, reach)) { ret false; }
            mw = slot_next(file, sw, mw);
        }
        mp = slot_next(file, sp, mp);
    }
    ret true;
}

# what `write` through row `row` leaves in the part of its bank the row's reach names: the write's own extension where
# its encoding states one, the row's else
pub fun extend_of(row: *Register, write: Write) Extend {
    if (sel write.extend) { ret write.extend; }
    ret row.extend;
}

# whether a write through row `written` of `file` leaves every bit of row `other` overwritten, at every legal
# multiplier of each scale and every place of each: other lies within written's footprint, with the part of the bank
# written's reach names where the write, as `extend_of` finds it, zeroes or sets it. a reach of the whole bank
# overwrites every row of it. a write through a register flagged ZERO is discarded and overwrites nothing. the one rule
# of what a register write kills, so a write of a register with more than one place kills nothing it does not reach
# from every place, and nothing else with more than one place unless it reaches every one
pub fun overwrites(file: *File, written: *Register, other: *Register, write: Write) bool {
    if ((written.flags & ZERO) != 0 || written.bank != other.bank) { ret false; }
    val extend: Extend = extend_of(written, write);
    if (extend == ZEROES || extend == ONES) {
        if (sel written.reach.bank) { ret true; }
        ret inside(file, other, written, opt[Part].some{written.reach.part});
    }
    ret inside(file, other, written, opt[Part].none{});
}

# whether a write through row `row` of `file` extending past its footprint reaches storage of another row of its bank,
# a row not lying within it where the reach is the whole bank and a row sharing storage with the reach's part else, so
# that a write through it has a rest to extend into. it scans the file's rows, and only the registration check asks it
pub fun contained(file: *File, row: *Register) bool {
    var i: u32 = 0;
    for (i < file.register_count) {
        val y: *Register = ?file.registers[i];
        if (y.bank == row.bank) {
            if (sel row.reach.part) {
                if (meets(file, y, row, opt[Part].some{row.reach.part})) { ret true; }
            }
            or (!inside(file, y, row, opt[Part].none{})) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# whether row `row` of `file` has at least one place at every legal multiplier, and its places lie apart wherever it has
# more than one. only the registration check asks it
pub fun placed_apart(file: *File, row: *Register) bool {
    val slot: opt[u8] = scale_of(file, row);
    var m:    u64     = slot_next(file, slot, 0);
    for (m != 0) {
        val n: u64 = places_at(row, m);
        if (n == 0 || (n > 1 && quantity.at(row.places.step, m) == 0)) { ret false; }
        m = slot_next(file, slot, m);
    }
    ret true;
}

# whether the reach of row `row` of `file` is the whole bank, or a part holding storage at every legal multiplier that
# lies clear of the row's own footprint at every place. only the registration check asks it
pub fun reach_clear(file: *File, row: *Register) bool {
    if (sel row.reach.bank) { ret true; }
    val p:    Part    = row.reach.part;
    val slot: opt[u8] = scale_of(file, row);
    var m:    u64     = slot_next(file, slot, 0);
    for (m != 0) {
        var k: u64 = 0;
        for (k < places_at(row, m)) {
            val rest: Pieces = part_pieces(row, p, m, k);
            if (rest.width == 0 || rest.count == 0 || meet(pieces(file, row, m, k), rest)) { ret false; }
            k = k + 1;
        }
        m = slot_next(file, slot, m);
    }
    ret true;
}

# slices of the x86-64, risc-v and aarch64 files for the tests below
#[testing]
val X86_CLASSES: [9]Class = [9]Class{
    Class{kind: GENERAL, width: quantity.Scaled{fixed: 64, per: 0, scale: 0}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    Class{kind: GENERAL, width: quantity.Scaled{fixed: 16, per: 0, scale: 0}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    Class{kind: GENERAL, width: quantity.Scaled{fixed: 8, per: 0, scale: 0}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    Class{kind: GENERAL, width: quantity.Scaled{fixed: 8, per: 0, scale: 0}, count: quantity.Scaled{fixed: 8, per: 0, scale: 0}},
    Class{kind: GENERAL, width: quantity.Scaled{fixed: 32, per: 0, scale: 0}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    Class{kind: VECTOR, width: quantity.Scaled{fixed: 128, per: 0, scale: 0}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    Class{kind: VECTOR, width: quantity.Scaled{fixed: 256, per: 0, scale: 0}, count: quantity.Scaled{fixed: 32, per: 0, scale: 0}},
    Class{kind: FLOAT, width: quantity.Scaled{fixed: 80, per: 0, scale: 0}, count: quantity.Scaled{fixed: 8, per: 0, scale: 0}},
    Class{kind: VECTOR, width: quantity.Scaled{fixed: 64, per: 0, scale: 0}, count: quantity.Scaled{fixed: 8, per: 0, scale: 0}},
};

# the eight physical x87 registers lie 128 bits apart in one bank, so mm3 is bits 0 to 63 of the fourth. st(i) is named
# relative to the stack top, so it may be any of the eight (Intel SDM Vol. 1 8.1.2), and a write of mm3 sets bits 64 to
# 79 of its own x87 register and keeps the others (Intel SDM Vol. 1 9.6.2)
#[testing]
val X87_PLACES:   Places = Places{count: quantity.Scaled{fixed: 8, per: 0, scale: 0}, step: quantity.Scaled{fixed: 128, per: 0, scale: 0}};
#[testing]
val MMX_EXPONENT: Part   = Part{offset: quantity.Scaled{fixed: 64, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, width: quantity.Scaled{fixed: 16, per: 0, scale: 0}};

# eax zeroes the rest of rax and ax, al and ah keep it. xmm0 keeps the rest of ymm0 as a legacy sse write leaves it,
# and a vex write states that it zeroes it
#[testing]
val X86_REGISTERS: [12]Register = [12]Register{
    Register{name: "rax", class: 0, number: 0, bank: 0, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: KEEP, reach: Reach.bank{}},
    Register{name: "rsp", class: 0, number: 4, bank: 4, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: ONE_PLACE, flags: STACK, requires: requirement.NO_ALTERNATIVES, extend: KEEP, reach: Reach.bank{}},
    Register{name: "ax", class: 1, number: 0, bank: 0, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: KEEP, reach: Reach.bank{}},
    Register{name: "al", class: 2, number: 0, bank: 0, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: KEEP, reach: Reach.bank{}},
    Register{name: "ah", class: 3, number: 4, bank: 0, offset: quantity.Scaled{fixed: 8, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: KEEP, reach: Reach.bank{}},
    Register{name: "eax", class: 4, number: 0, bank: 0, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: ZEROES, reach: Reach.bank{}},
    Register{name: "xmm0", class: 5, number: 0, bank: 16, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: KEEP, reach: Reach.bank{}},
    Register{name: "ymm0", class: 6, number: 0, bank: 16, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: KEEP, reach: Reach.bank{}},
    Register{name: "st0", class: 7, number: 0, bank: 72, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: X87_PLACES, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: KEEP, reach: Reach.bank{}},
    Register{name: "st1", class: 7, number: 1, bank: 72, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: X87_PLACES, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: KEEP, reach: Reach.bank{}},
    Register{name: "mm0", class: 8, number: 0, bank: 72, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: ONES, reach: Reach.part{MMX_EXPONENT}},
    Register{name: "mm3", class: 8, number: 3, bank: 72, offset: quantity.Scaled{fixed: 384, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: ONE_PLACE, flags: 0, requires: requirement.NO_ALTERNATIVES, extend: ONES, reach: Reach.part{MMX_EXPONENT}},
};

#[testing]
val X86_DWARF:    [12]u32 = [12]u32{0, 7, UNNUMBERED, UNNUMBERED, UNNUMBERED, UNNUMBERED, UNNUMBERED, UNNUMBERED, UNNUMBERED, UNNUMBERED, UNNUMBERED, UNNUMBERED};
#[testing]
val X86_CODEVIEW: [12]u32 = [12]u32{328, 335, 9, 1, 5, UNNUMBERED, UNNUMBERED, UNNUMBERED, UNNUMBERED, UNNUMBERED, UNNUMBERED, UNNUMBERED};

#[testing]
val X86_DWARF_NUMBERED:    [2]index.Number = [2]index.Number{index.Number{key: 0, row: 0}, index.Number{key: 7, row: 1}};
#[testing]
val X86_CODEVIEW_NUMBERED: [5]index.Number = [5]index.Number{
    index.Number{key: 1, row: 3},
    index.Number{key: 5, row: 4},
    index.Number{key: 9, row: 2},
    index.Number{key: 328, row: 0},
    index.Number{key: 335, row: 1},
};

