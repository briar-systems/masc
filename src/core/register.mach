test lookup__an_unavailable_register_is_refused_naming_every_alternative {
    var t: testing.Testing;
    testing.make(?t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?RISCV_CATALOG, "e", diagnostic.START);
    if (sel made.err) { ret 1; }
    var s:      extension.Selection   = made.ok;
    val viewed: res[Available, Error] = select(testing.allocator_of(?t), ?RISCV, ?s);
    if (sel viewed.err) { ret 2; }
    var v:   Available       = viewed.ok;
    val x16: res[Id, Absent] = lookup(?v, view("x16", 3));
    if (sel x16.ok)                                                                     { ret 3; }
    if (!(sel x16.err.unavailable && (x16.err.unavailable.row == ?RISCV_REGISTERS[4]))) { ret 4; }
    var u: Unavailable;
    if (sel x16.err.unavailable) { u = x16.err.unavailable; }
    var out:    vector.Vector[u8] = vector.init[u8](testing.allocator_of(?t));
    val worded: err[A.Error]      = spell(?v, ?u, ?out);
    if (sel worded.err || !extension.t_spelled(?out, "x16 needs i")) { ret 7; }
    vector.dnit[u8](?out);
    val f_q:    [2]requirement.Id  = [2]requirement.Id{4, 6};
    val either: [2]requirement.Ids = [2]requirement.Ids{requirement.Ids{at: ?RISCV_I[0], len: 1}, requirement.Ids{at: ?f_q[0], len: 2}};
    var two:    Unavailable        = u;
    two.requires = requirement.Requirement{at: ?either[0], len: 2};
    out          = vector.init[u8](testing.allocator_of(?t));
    val both: err[A.Error] = spell(?v, ?two, ?out);
    if (sel both.err || !extension.t_spelled(?out, "x16 needs i, or f and q")) { ret 8; }
    vector.dnit[u8](?out);
    val s0: res[Id, Absent] = lookup(?v, view("s0", 2));
    if (!(sel s0.ok && s0.ok == make(0, 8))) { ret 5; }
    release(?v);
    extension.release(?s);
    if (testing.live_count(?t) != 0) { ret 6; }
    ret 0;
}

# the width of the register `reg` under the selection `spelling`, in `bits` when known
#[testing]
fun t_width(spelling: str, reg: Id, known: *bool, bits: *u64) u8 {
    var t: testing.Testing;
    testing.make(?t);
    val made: res[extension.Selection, extension.Error] = extension.select(testing.allocator_of(?t), ?RISCV_CATALOG, spelling, diagnostic.START);
    if (sel made.err) { ret 1; }
    var s:      extension.Selection   = made.ok;
    val viewed: res[Available, Error] = select(testing.allocator_of(?t), ?RISCV, ?s);
    if (sel viewed.err) { ret 2; }
    var v:    Available             = viewed.ok;
    val read: res[opt[u64], Absent] = width(?v, reg);
    if (sel read.err) { ret 3; }
    @known = sel read.ok.some;
    if (sel read.ok.some) { @bits = read.ok.some; }
    release(?v);
    extension.release(?s);
    if (testing.live_count(?t) != 0) { ret 4; }
    ret 0;
}

test width__resolves_where_an_extension_fixes_the_scale_and_nested_fixings_take_the_largest {
    var known: bool = false;
    var bits:  u64  = 0;
    if (t_width("i,rv32", make(0, 0), ?known, ?bits) != 0 || !known || bits != 32)    { ret 1; }
    if (t_width("i,rv64", make(0, 0), ?known, ?bits) != 0 || !known || bits != 64)    { ret 2; }
    if (t_width("i", make(0, 0), ?known, ?bits) != 0 || known)                        { ret 3; }
    if (t_width("i,rv64,f", make(1, 0), ?known, ?bits) != 0 || !known || bits != 32)  { ret 4; }
    if (t_width("i,rv64,d", make(1, 0), ?known, ?bits) != 0 || !known || bits != 64)  { ret 5; }
    if (t_width("i,rv64,q", make(1, 0), ?known, ?bits) != 0 || !known || bits != 128) { ret 6; }
    ret 0;
}

test named__unknown_name_refused {
    val partial: opt[Id] = named(?RISCV, view("s", 1), false);
    val unknown: opt[Id] = named(?RISCV, view("x3", 2), false);
    val cased:   opt[Id] = named(?RISCV, view("X8", 2), false);
    val folded:  opt[Id] = named(?RISCV, view("X8", 2), true);
    if (!sel partial.none || !sel unknown.none || !sel cased.none) { ret 1; }
    if (!(sel folded.some && folded.some == make(0, 8)))           { ret 2; }
    ret 0;
}

test overlap__shared_bank_both_directions {
    val rax: *Register = ?X86_REGISTERS[0];
    val ax:  *Register = ?X86_REGISTERS[2];
    val al:  *Register = ?X86_REGISTERS[3];
    val ah:  *Register = ?X86_REGISTERS[4];
    val rsp: *Register = ?X86_REGISTERS[1];
    if (!overlap(?X86, ah, rax) || !overlap(?X86, rax, ah)) { ret 1; }
    if (!overlap(?X86, al, ax) || !overlap(?X86, ax, al))   { ret 2; }
    if (overlap(?X86, al, ah) || overlap(?X86, ah, al))     { ret 3; }
    if (overlap(?X86, rsp, rax) || overlap(?X86, rax, rsp)) { ret 4; }
    ret 0;
}

test covers__a_write_overwrites_its_footprint_and_what_its_row_or_encoding_extends_through {
    val rax:  *Register = ?X86_REGISTERS[0];
    val rsp:  *Register = ?X86_REGISTERS[1];
    val ax:   *Register = ?X86_REGISTERS[2];
    val al:   *Register = ?X86_REGISTERS[3];
    val ah:   *Register = ?X86_REGISTERS[4];
    val eax:  *Register = ?X86_REGISTERS[5];
    val xmm0: *Register = ?X86_REGISTERS[6];
    val ymm0: *Register = ?X86_REGISTERS[7];
    val x0:   *Register = ?AARCH64_REGISTERS[3];
    val w0:   *Register = ?AARCH64_REGISTERS[4];
    val row:  Write     = Write.row{};
    val vex:  Write     = Write.extend{ZEROES};
    if (!covers(?X86, eax, rax, row) || !covers(?X86, eax, ah, row) || covers(?X86, eax, rsp, row))                       { ret 1; }
    if (covers(?X86, ax, rax, row) || !covers(?X86, ax, al, row) || covers(?X86, al, ah, row))                            { ret 2; }
    if (covers(?X86, xmm0, ymm0, row) || !covers(?X86, xmm0, ymm0, vex) || !covers(?X86, ymm0, xmm0, row))                { ret 3; }
    if (!covers(?AARCH64, w0, x0, row) || covers(?AARCH64, w0, x0, Write.extend{KEEP}) || !covers(?AARCH64, x0, w0, row)) { ret 4; }
    # a write of risc-v x0 is discarded
    if (covers(?RISCV, ?RISCV_REGISTERS[0], ?RISCV_REGISTERS[0], row)) { ret 5; }
    ret 0;
}

test overlap__strided_tiles {
    val za0_b: *Register = ?AARCH64_REGISTERS[0];
    val za0_d: *Register = ?AARCH64_REGISTERS[1];
    val za1_d: *Register = ?AARCH64_REGISTERS[2];
    if (!overlap(?AARCH64, za0_d, za0_b) || !overlap(?AARCH64, za0_b, za0_d)) { ret 1; }
    if (overlap(?AARCH64, za0_d, za1_d) || overlap(?AARCH64, za1_d, za0_d))   { ret 2; }
    ret 0;
}

# whether part lies in container at multiplier `m` as `count` pieces of `width` bits, the first at `offset` and each `stride` past the last
#[testing]
fun t_placed(file: *File, part: *Register, container: *Register, m: u64, offset: u64, width: u64, stride: u64, count: u64) bool {
    val w: opt[Placement] = within(file, part, container, m);
    if (sel w.none) { ret false; }
    ret w.some.offset == offset && w.some.width == width && w.some.stride == stride && w.some.count == count;
}

#[testing]
fun t_apart(file: *File, part: *Register, container: *Register, m: u64) bool {
    val w: opt[Placement] = within(file, part, container, m);
    ret sel w.none;
}

test within__x86_sub_registers_lie_at_their_offsets {
    val rax: *Register = ?X86_REGISTERS[0];
    val rsp: *Register = ?X86_REGISTERS[1];
    val ax:  *Register = ?X86_REGISTERS[2];
    val al:  *Register = ?X86_REGISTERS[3];
    val ah:  *Register = ?X86_REGISTERS[4];
    val eax: *Register = ?X86_REGISTERS[5];
    if (!t_placed(?X86, al, ax, 1, 0, 8, 0, 1))    { ret 1; }
    if (!t_placed(?X86, ah, ax, 1, 8, 8, 0, 1))    { ret 2; }
    if (!t_placed(?X86, ax, eax, 1, 0, 16, 0, 1))  { ret 3; }
    if (!t_apart(?X86, eax, al, 1))                { ret 4; }
    if (!t_apart(?X86, al, ah, 1))                 { ret 5; }
    if (!t_apart(?X86, al, rsp, 1))                { ret 6; }
    if (!t_placed(?X86, rax, rax, 1, 0, 64, 0, 1)) { ret 7; }
    ret 0;
}

test within__aarch64_tile_rows_lie_in_the_byte_tile {
    val za0_b: *Register = ?AARCH64_REGISTERS[0];
    val za0_d: *Register = ?AARCH64_REGISTERS[1];
    val za1_d: *Register = ?AARCH64_REGISTERS[2];
    if (!t_placed(?AARCH64, za0_d, za0_b, 2, 0, 256, 2048, 4))   { ret 1; }
    if (!t_placed(?AARCH64, za1_d, za0_b, 2, 256, 256, 2048, 4)) { ret 2; }
    if (!t_apart(?AARCH64, za0_b, za0_d, 2))                     { ret 3; }
    ret 0;
}

test within__riscv_group_member_and_pair_halves {
    val x8:   *Register = ?RISCV_REGISTERS[2];
    val x9:   *Register = ?RISCV_REGISTERS[3];
    val v8:   *Register = ?RISCV_REGISTERS[6];
    val v9:   *Register = ?RISCV_REGISTERS[7];
    val v8m4: *Register = ?RISCV_REGISTERS[8];
    val pair: *Register = ?RISCV_REGISTERS[9];
    if (!t_placed(?RISCV, v8, v8m4, 4, 0, 128, 0, 1))   { ret 1; }
    if (!t_placed(?RISCV, v9, v8m4, 4, 128, 128, 0, 1)) { ret 2; }
    if (!t_apart(?RISCV, v8m4, v9, 4))                  { ret 3; }
    if (!t_placed(?RISCV, x8, pair, 1, 0, 32, 0, 1))    { ret 4; }
    if (!t_placed(?RISCV, x9, pair, 1, 32, 32, 0, 1))   { ret 5; }
    if (!t_apart(?RISCV, pair, x8, 1))                  { ret 6; }
    ret 0;
}

test within__a_contained_part_always_overlaps {
    val rows: *Register = ?RISCV_REGISTERS[0];
    var i:    u32       = 0;
    for (i < 10) {
        var j: u32 = 0;
        for (j < 10) {
            val w: opt[Placement] = within(?RISCV, ?rows[i], ?rows[j], 2);
            if (sel w.some && !overlap(?RISCV, ?rows[i], ?rows[j])) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test make__packs_and_unpacks {
    val reg: Id = make(0x1234, 0xABCD);
    if (class_of(reg) != 0x1234 || number_of(reg) != 0xABCD) { ret 1; }
    if (make(0, 0) == NONE)                                  { ret 2; }
    ret 0;
}

test from_debug_number__finds_the_register_each_format_numbers_and_no_other {
    val rax:  opt[Id] = from_debug_number(?X86, 0, DWARF);
    val rsp:  opt[Id] = from_debug_number(?X86, 7, DWARF);
    val ah:   opt[Id] = from_debug_number(?X86, 5, CODEVIEW);
    val none: opt[Id] = from_debug_number(?X86, 1, DWARF);
    if (!(sel rax.some && rax.some == make(0, 0))) { ret 1; }
    if (!(sel rsp.some && rsp.some == make(0, 4))) { ret 2; }
    if (!(sel ah.some && ah.some == make(3, 4)))   { ret 3; }
    if (!sel none.none)                            { ret 4; }
    ret 0;
}

test row_of__sub_registers_sharing_a_bank_are_distinct_identities {
    val ah:     opt[*Register] = row_of(?X86, make(3, 4));
    val rsp:    opt[*Register] = row_of(?X86, make(0, 4));
    val absent: opt[*Register] = row_of(?X86, make(1, 4));
    if (!(sel ah.some && ah.some == ?X86_REGISTERS[4]))   { ret 1; }
    if (!(sel rsp.some && rsp.some == ?X86_REGISTERS[1])) { ret 2; }
    val zero: opt[*Register] = row_of(?X86, NONE);
    if (!sel absent.none || !sel zero.none) { ret 3; }
    ret 0;
}

test debug_number__read_per_column {
    val rax:    opt[u32] = debug_number(?X86, make(0, 0), DWARF);
    val rax_cv: opt[u32] = debug_number(?X86, make(0, 0), CODEVIEW);
    val al:     opt[u32] = debug_number(?X86, make(2, 0), DWARF);
    val al_cv:  opt[u32] = debug_number(?X86, make(2, 0), CODEVIEW);
    if (!sel rax.some)      { ret 1; }
    if (rax.some != 0)      { ret 2; }
    if (!sel rax_cv.some)   { ret 3; }
    if (rax_cv.some != 328) { ret 4; }
    if (!sel al.none)       { ret 5; }
    if (!sel al_cv.some)    { ret 6; }
    if (al_cv.some != 1)    { ret 7; }
    ret 0;
}
