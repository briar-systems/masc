# the sorted name index every table that is looked up by name shares
#
# a table of rows keeps its rows in their own order, which a saved text must
# never depend on, and answers "which row is named x" through an index of
# entries sorted by key. the index is static and generated or written beside
# its rows, and the registration check proves it sorted, complete and in
# agreement with the rows, so a lookup is a binary search that cannot
# disagree with them. a key is any non-empty byte string, ordered bytewise,
# so the spellings of any source (riscv-opcodes record names, x86 iforms, arm
# encoding ids, spir-v and wasm opcode names) fit.

use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_compare;

# one key and the row it names
# ---
# key: the key, as its row states it
# row: the row's index in its table
pub rec Entry {
    key: str;
    row: u32;
}

# entries as a pointer to static entries and a count, ascending by key
pub rec Index {
    at:  *Entry;
    len: u32;
}

# the index of a table with no rows
pub val EMPTY: Index = Index{at: nil, len: 0};

# the row of `index` keyed `key`, by binary search
pub fun find(index: *Index, key: str) opt[u32] {
    var lo: u32 = 0;
    var hi: u32 = index.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        val c:   i64 = str_compare(index.at[mid].key, key);
        if (c == 0) { ret opt[u32].some{index.at[mid].row}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret opt[u32].none{};
}

#[testing]
val T_ENTRIES: [3]Entry = [3]Entry{Entry{key: "a", row: 2}, Entry{key: "b", row: 0}, Entry{key: "ba", row: 1}};

test find__a_key_finds_its_row_and_an_absent_key_finds_none {
    val index: Index    = Index{at: ?T_ENTRIES[0], len: 3};
    val a:     opt[u32] = find(?index, "a");
    val ba:    opt[u32] = find(?index, "ba");
    val c:     opt[u32] = find(?index, "c");
    val none:  opt[u32] = find(?EMPTY, "a");
    if (!(sel a.some && a.some == 2))   { ret 1; }
    if (!(sel ba.some && ba.some == 1)) { ret 2; }
    if (!sel c.none)                    { ret 3; }
    if (!sel none.none)                 { ret 4; }
    ret 0;
}
