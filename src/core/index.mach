# the sorted indexes every table that is looked up by name or number shares
#
# a table of rows keeps its rows in their own order, which a saved text must
# never depend on, and answers "which row is named x" through an index of
# entries sorted by key. a table looked up by a number answers through the
# numeric form of the same index, entries sorted by an unsigned key. the index is static and generated or written beside
# its rows, and the registration check proves it sorted, complete and in
# agreement with the rows, so a lookup is a binary search that cannot
# disagree with them. a key is any non-empty byte string, ordered bytewise,
# save an enumeration's member names, whose empty name is the member text
# that names no other member reads as and sorts first, so the spellings of any source (riscv-opcodes record names, x86 iforms, arm
# encoding ids, spir-v and wasm opcode names) fit.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

# one key and the row it names
# ---
# key: the key, as its row states it
# row: the row's index in its table
pub rec Entry {
    key: str;
    row: u32;
}

# entries as a pointer to static entries and a count, ascending by key
pub rec Index {
    at:  *Entry;
    len: u32;
}

# the index of a table with no rows
pub val EMPTY: Index = Index{at: nil, len: 0};

# one numeric key and the row it names, for a table looked up by a number such as a debug register number
# ---
# key: the key, as its row states it
# row: the row's index in its table
pub rec Number {
    key: u64;
    row: u32;
}

# numeric entries as a pointer to static entries and a count, ascending by key
pub rec Numbers {
    at:  *Number;
    len: u32;
}

# the numeric index of a table with no rows
pub val NO_NUMBERS: Numbers = Numbers{at: nil, len: 0};

# the row of `index` keyed `key`, by binary search
pub fun find_number(index: *Numbers, key: u64) opt[u32] {
    var lo: u32 = 0;
    var hi: u32 = index.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (index.at[mid].key == key) { ret opt[u32].some{index.at[mid].row}; }
        if (index.at[mid].key < key)  { lo = mid + 1; }
        or                            { hi = mid; }
    }
    ret opt[u32].none{};
}

# `c` in lower case when it is an ascii capital
pub fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

# how the key `key` orders against the bytes of `with`, bytewise and with ascii capitals of `with` read as lower case when `fold`
pub fun compare(key: str, with: View, fold: bool) i64 {
    var i: usize = 0;
    for (i < with.len) {
        val k: u8 = key[i];
        if (k == 0) { ret -1; }
        var b: u8 = with.data[i];
        if (fold)  { b = lower(b); }
        if (k < b) { ret -1; }
        if (k > b) { ret 1; }
        i = i + 1;
    }
    if (key[with.len] == 0) { ret 0; }
    ret 1;
}

# the row of `index` keyed by the bytes of `key`, by binary search. a `fold` reads the capitals of `key` as lower case, which finds
# the row only of a key that is itself lower case
pub fun find_view(index: *Index, key: View, fold: bool) opt[u32] {
    var lo: u32 = 0;
    var hi: u32 = index.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        val c:   i64 = compare(index.at[mid].key, key, fold);
        if (c == 0) { ret opt[u32].some{index.at[mid].row}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret opt[u32].none{};
}

# the first entry of `index` whose key orders at or after the bytes of `key`, read as `find_view` reads them, `index.len` when none does
pub fun lower_bound(index: *Index, key: View, fold: bool) u32 {
    var lo: u32 = 0;
    var hi: u32 = index.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (compare(index.at[mid].key, key, fold) < 0) { lo = mid + 1; }
        or                                             { hi = mid; }
    }
    ret lo;
}

# whether the key `key` begins with the bytes of `with`, read as `compare` reads them
pub fun begins(key: str, with: View, fold: bool) bool {
    var i: usize = 0;
    for (i < with.len) {
        val k: u8 = key[i];
        if (k == 0) { ret false; }
        var b: u8 = with.data[i];
        if (fold)   { b = lower(b); }
        if (k != b) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the row of `index` keyed `key`, by binary search
pub fun find(index: *Index, key: str) opt[u32] {
    ret find_view(index, View{data: key, len: str_len(key)}, false);
}

#[testing]
val T_NUMBERS: [2]Number = [2]Number{Number{key: 3, row: 0}, Number{key: 7, row: 1}};

#[testing]
val T_ENTRIES: [3]Entry = [3]Entry{Entry{key: "a", row: 2}, Entry{key: "b", row: 0}, Entry{key: "ba", row: 1}};

test find__a_key_finds_its_row_and_an_absent_key_finds_none {
    val index: Index    = Index{at: ?T_ENTRIES[0], len: 3};
    val a:     opt[u32] = find(?index, "a");
    val ba:    opt[u32] = find(?index, "ba");
    val c:     opt[u32] = find(?index, "c");
    val none:  opt[u32] = find(?EMPTY, "a");
    if (!(sel a.some && a.some == 2))   { ret 1; }
    if (!(sel ba.some && ba.some == 1)) { ret 2; }
    if (!sel c.none)                    { ret 3; }
    if (!sel none.none)                 { ret 4; }
    val upper:     opt[u32] = find_view(?index, view("BA", 2), false);
    val folded:    opt[u32] = find_view(?index, view("BA", 2), true);
    val prefix:    opt[u32] = find_view(?index, view("bz", 2), false);
    val numbers:   Numbers  = Numbers{at: ?T_NUMBERS[0], len: 2};
    val by_number: opt[u32] = find_number(?numbers, 7);
    val no_number: opt[u32] = find_number(?numbers, 8);
    val empty:     opt[u32] = find_number(?NO_NUMBERS, 7);
    if (!(sel by_number.some && by_number.some == 1))                                                                { ret 8; }
    if (!sel no_number.none || !sel empty.none)                                                                      { ret 9; }
    if (!sel upper.none)                                                                                             { ret 5; }
    if (!(sel folded.some && folded.some == 1))                                                                      { ret 6; }
    if (!sel prefix.none)                                                                                            { ret 7; }
    if (lower_bound(?index, view("b", 1), false) != 1 || lower_bound(?index, view("bb", 2), false) != 3)             { ret 10; }
    if (!begins("ba", view("B", 1), true) || begins("ba", view("B", 1), false) || begins("b", view("ba", 2), false)) { ret 11; }
    ret 0;
}
