# the code fill of an instruction set: the no-op patterns that pad code to an alignment, and the order they fill a gap in

use masc.core.requirement;
use masc.core.state;

# bytes that pad code to an alignment
# ---
# bytes:    the encoded instruction
# len:      how many bytes it is
# requires: what the context must hold to admit it, as risc-v c.nop needs c
pub rec Pattern {
    bytes:    *u8;
    len:      u32;
    requires: requirement.Requirement;
}

# the order a gap is filled in
# ---
# LONGEST_FIRST:   the longest admitted pattern that fits, in turn
# REMAINDER_FIRST: the part of the gap the longest admitted pattern does not divide is written first, by the longest
#                  patterns that fit it whether or not the context admits them, since only data leaves code off the
#                  admitted patterns, and the longest admitted patterns fill the rest
pub def Order: u8;

pub val LONGEST_FIRST:   Order = 0;
pub val REMAINDER_FIRST: Order = 1;

# a set's code fill
# ---
# patterns: its no-op patterns, longest first
# count:    how many there are
# order:    the order they fill a gap in
# unit:     the alignment every instruction of the set keeps whatever the selection: the part of a gap it does not
#           divide is zero bytes, written first, since only data leaves code off it
pub rec Fill {
    patterns: *Pattern;
    count:    u32;
    order:    Order;
    unit:     u32;
}

val ZERO: [1]u8 = [1]u8{0};

# the zero byte that pads a gap below a fill's unit
pub val ZERO_BYTE: Pattern = Pattern{bytes: ?ZERO[0], len: 1, requires: requirement.NO_ALTERNATIVES};

# the pattern a gap of `left` bytes is filled with next under the context `ctx`, nil when none fits. the one place the
# order is read, so a builder and a disassembler agree on what a fill is
pub fun next(f: *Fill, ctx: *state.Context, left: u64) *Pattern {
    if (left % f.unit::u64 != 0) { ret ?ZERO_BYTE; }
    if (f.order == REMAINDER_FIRST) {
        var i: u32 = 0;
        for (i < f.count) {
            val p: *Pattern = ?f.patterns[i];
            if (state.admits(ctx, p.requires)) {
                if (left % p.len::u64 != 0) { ret longest(f, nil, left % p.len::u64); }
                brk;
            }
            i = i + 1;
        }
    }
    ret longest(f, ctx, left);
}

# the longest pattern of `f` no longer than `limit` that `ctx` admits, any that fits when `ctx` is nil, nil for none
fun longest(f: *Fill, ctx: *state.Context, limit: u64) *Pattern {
    var i: u32 = 0;
    for (i < f.count) {
        val p: *Pattern = ?f.patterns[i];
        if (p.len::u64 <= limit && (ctx == nil || state.admits(ctx, p.requires))) { ret p; }
        i = i + 1;
    }
    ret nil;
}
