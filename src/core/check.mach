# the one check of a registered instruction set
#
# every table a set registers is checked here, once, against the invariants
# the walks, the selection and the builder assume, so no reader checks them
# again. a defect is one refusal naming the set, the table and the row.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use mink;

use masc.core.compress;
use masc.core.constraint;
use masc.core.ct;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.index;
use masc.core.mode;
use masc.core.operand;
use masc.core.register;
use masc.core.relax;
use masc.core.requirement;
use masc.core.row;
use S: masc.core.set;
use masc.core.spelling;
use masc.core.walk;

# why a set was refused
# ---
# set:     the set refused
# message: the diagnostic, one of the wordings below
# table:   the table the defect is in
# index:   the defective row of that table
# other:   the row it clashes with when the defect is two rows sharing a name or key, else NO_OTHER
pub rec Refusal {
    set:     *S.Set;
    message: str;
    table:   str;
    index:   u32;
    other:   u32;
}

pub val NO_OTHER: u32 = 0xFFFF_FFFF;

pub val NO_ARCH:           str = "set serves no architecture";
pub val UNKNOWN_ARCH:      str = "architecture not in mink's catalog";
pub val SHARED_ARCH:       str = "architecture served twice";
pub val NO_MODE:           str = "architecture served with no mode";
pub val MODE_ARCH:         str = "mode of an architecture the set does not serve";
pub val MODE_EXTENSION:    str = "mode names an extension the catalog does not have";
pub val SHARED_MODE:       str = "architecture given two modes";
pub val UNKNOWN_SCALE:     str = "scale not in the register file";
pub val FIXING_EXTENSION:  str = "scale fixed by an extension not in the catalog";
pub val FIXING_MULTIPLIER: str = "scale fixed at a multiplier that is not a power of two within its max";
pub val MIXED_SCALES:      str = "register and its class width scale with different scales";
pub val REGISTER_CLASS:    str = "register's class not in the register file";
pub val REGISTER_NUMBER:   str = "register number outside its class's count";
pub val UNNAMED:           str = "class name or row key empty";
pub val SHARED_CLASS:      str = "class name given to two classes";
pub val SHARED_KEY:        str = "row key given to two rows";
pub val NAME_ENTRY:        str = "name index entry names no row, or a key other than its row's";
pub val NAME_ORDER:        str = "name index not in ascending order of key";
pub val NAME_MISSING:      str = "name index does not hold each row once";
pub val SHARED_ID:         str = "two registers share one identity";
pub val REGISTER_ORDER:    str = "registers not in ascending order of identity";
pub val SHARED_NAME:       str = "name spelled twice";
pub val CASED_NAME:        str = "name has an ascii capital while a syntax of the set reads names without regard to case";
pub val ALIAS_TARGET:      str = "alias names no register";
pub val ALIAS_ORDER:       str = "register aliases not in ascending order of register";
pub val COLUMN_LENGTH:     str = "debug column length differs from the register count";
pub val SHARED_COLUMN:     str = "two debug columns for one format";
pub val COLUMN_ORDER:      str = "debug columns not in ascending order of format";
pub val SHARED_NUMBER:     str = "debug number given to two registers";
pub val IMPLIED:           str = "implied extension not in the catalog";
pub val LEVEL_MEMBER:      str = "level member not in the catalog";
pub val CONFLICT:          str = "conflict names an extension not in the catalog or one twice";
pub val COMBINATION:       str = "combination names an extension not in the catalog";
pub val CONFLICT_TWICE:    str = "conflict stated twice";
pub val CONFLICT_ORDER:    str = "conflict not stated with its lower extension first, or conflicts not in ascending order";
pub val NO_SYNTAX:         str = "catalog has no selection syntax";
pub val OPERANDS:          str = "row has more operands than a row holds";
pub val FIELDS:            str = "row has more fields than a row holds";
pub val UNKNOWN_KIND:      str = "field kind not in the field table";
pub val UNIT_WIDTH:        str = "unit width not a multiple of 8 up to 64";
pub val FIELD_OPERAND:     str = "field names an operand the row does not have";
pub val SLICE:             str = "slice outside its operand, part or unit";
pub val UNCOVERED:         str = "slices leave bits of an operand unencoded";
pub val UNKNOWN_CLASS:     str = "operand names a register class not in the register file";
pub val REGISTER_RANGE:    str = "operand's register range reaches past one of its classes";
pub val EXCLUDED_RANGE:    str = "operand excludes a value it never admits";
pub val UNKNOWN_EXTENSION: str = "requires an extension not in the catalog";
pub val NO_EFFECT:         str = "row has no effect or no constant-time class";
pub val EFFECT_ROW:        str = "effect names a register row not in the register file";
pub val FLAG_ROW:          str = "flag set holds a register outside a flags class";
pub val EFFECT_OPERAND:    str = "effect names an operand the row does not have";
pub val ACCESS_FORM:       str = "access through a memory operand states its own width or role, or another access states no role";
pub val RULE_TERMS:        str = "effect rule has no terms";
pub val RULE_OVERLAP:      str = "two rules of one effect field can both hold";
pub val RULE_OPERAND:      str = "effect rule tests an operand the row does not have, or of another kind than its test";
pub val RULE_BOUNDS:       str = "implicit registers' may or must set is not the union or intersection of its own and its rules' sets";
pub val FIXED_OPERAND:     str = "fixed operand is not a register operand";
pub val FIXED_CLASS:       str = "fixed register outside its operand's classes or range";
pub val KEPT_OPERAND:      str = "register constraint names an operand the row does not have, one holding no register of its part, or nothing to keep apart";
pub val KEPT_PERMIT:       str = "register constraint permits an unknown overlap, or one by element widths other than between whole register operands stating their widths, of one field where it writes one";
pub val ELEMENT_WIDTH:     str = "register shape's element width is no power of two, names an operand that is not an enumerant, or its span scales a width it cannot";
pub val GROUP_FIELDS:      str = "register operand of no fields, or a memory part of more than one";
pub val NO_INPUT:          str = "dependent class names no input";
pub val CONDITION:         str = "constant-time condition not in the catalog";
pub val UNBOUND_FIXUP:     str = "fixup kind with no mink relocation kind";
pub val NO_FIXUP:          str = "binding names no fixup kind";
pub val BOUND_TWICE:       str = "fixup kind bound twice";
pub val BOUND_ORDER:       str = "fixup bindings not in ascending order of kind";
pub val UNKNOWN_RELOC:     str = "relocation kind not in mink's catalog";
pub val DATUM:             str = "datum of no basis, a width past the widest, or a basis and width stated twice";
pub val SPAN:              str = "span of an unbound fixup kind or marker, covering fewer than two or more than an expansion holds, or out of ascending order";
pub val PAIR:              str = "difference pair of an unbound fixup kind, a width past the widest, or a width stated twice";
pub val SOURCE:            str = "assembly source dialect without a comment or separator, or reading .align neither way";
pub val OPTION_ROW:        str = "option spelling of a trait the set does not require of a caller, or spelled twice";
pub val WIDTH_ROW:         str = "data directive not spelled with a leading dot, of a width past the widest, or named twice";
pub val NO_ROOT:           str = "dispatch has no root node";
pub val NODE:              str = "node's key or entries out of range";
pub val UNSORTED:          str = "node's entries not strictly sorted";
pub val ENTRY:             str = "entry's child node or candidates out of range";
pub val CANDIDATE:         str = "candidate names no row";
pub val RELAX_ROW:         str = "relaxation names no row";
pub val RELAX_OPERAND:     str = "relaxed operand is not a relative operand of its row";
pub val RELAX_FORM:        str = "longer form is empty or a step's sources do not match its row";
pub val RELAX_SOURCE:      str = "source names an operand or register that is not there";
pub val RELAX_TARGET:      str = "longer form does not take the target exactly once";
pub val RELAX_CYCLE:       str = "relaxation relaxes back into itself";
pub val RELAX_TWICE:       str = "two relaxations for one row";
pub val PATTERN:           str = "fill pattern empty or not shorter than the one before it";
pub val NO_ASSEMBLY:       str = "set has no assembly syntax";
pub val SHARED_SYNTAX:     str = "syntax name given twice";
pub val FORMS:             str = "syntax does not spell each row of the codec once";
pub val TEMPLATE:          str = "template malformed, or a hole names no operand";
pub val WRITTEN_TWICE:     str = "template writes an operand twice";
pub val UNWRITTEN:         str = "template leaves an operand unwritten that the row does not fix";
pub val GROUP_OPERAND:     str = "an optional operand outside a group, or a required one inside";
pub val NO_HOOK:           str = "operand kind with no hook in the syntax";
pub val ALIAS_ROW:         str = "alias names no row, or aliases out of row order";
pub val ALIAS_SOURCES:     str = "alias sources do not match its base row";
pub val ALIAS_SOURCE:      str = "source names an operand or register that is not there, or a fixed value that names one";
pub val ALIAS_OPERAND:     str = "alias operand no source or derivation gives";
pub val ALIAS_EXCLUSION:   str = "alias excludes a value its operand cannot hold, or out of operand order";
pub val PREFERENCE:        str = "two aliases of one row share a preference";
pub val NO_MNEMONIC:       str = "template has no mnemonic to index it by";
pub val INDEX_ENTRY:       str = "index entry empty, out of order with its candidates or past the candidates";
pub val INDEX_ORDER:       str = "index keys or an entry's candidates not in ascending order";
pub val INDEX_KEY:         str = "candidate indexed under a key that is not its mnemonic, or names no row or alias";
pub val INDEX_TWICE:       str = "index key or candidate given twice";
pub val INDEX_MISSING:     str = "row or alias missing from the index";
pub val SPECIFIER:         str = "specifier template does not hold exactly one hole with text around it";
pub val SPECIFIER_KIND:    str = "specifier names no fixup kind";
pub val SEQUENCE:          str = "sequence spelling of fewer than two steps or more than an expansion holds, a step whose parts do not match its row or name what is not there, an operand no step takes, or out of order of its first row";
pub val SEQUENCE_INDEX:    str = "sequence spellings not indexed once each in ascending order of mnemonic";
pub val SEQUENCE_MODE:     str = "sequence spelling holds under a value its set's modes do not take, or under two values of one mode";
pub val NO_OWN:            str = "sequence part names its own label in a syntax with no stem for it, or one longer than a stem holds";
pub val MODE_COUNT:        str = "set declares more assembler modes than a state holds";
pub val MODE_NAME:         str = "assembler mode or value unnamed, or a mode's name or a value's name within it given twice";
pub val MODE_VALUES:       str = "assembler mode of fewer than two values, or one starting at a value it does not take";
pub val MODE_FLAG:         str = "flag chooses two values of the set's assembler modes";
pub val NO_ANONYMOUS:      str = "syntax reserves no spelling for anonymous labels, or one past the longest";
pub val SPECIFIER_TWICE:   str = "specifier spelled twice for one operand, or one fixup kind spelled twice";

fun refuse(s: *S.Set, message: str, table: str, index: u32) err[Refusal] {
    ret err[Refusal].err{Refusal{set: s, message: message, table: table, index: index, other: NO_OTHER}};
}

fun refuse_pair(s: *S.Set, message: str, table: str, index: u32, other: u32) err[Refusal] {
    ret err[Refusal].err{Refusal{set: s, message: message, table: table, index: index, other: other}};
}

# the name of row `row` of a table, a class name, a row key, a register's identity or the like, made in `scratch` when it is not stored.
# `of` says which table of its kind, such as the column of a file, and the name is empty when the row has none
def Namer: fun(*S.Set, u32, u32, *u8) View;

fun spelled(text: str) View {
    ret view(text, str_len(text));
}

fun class_name(s: *S.Set, of: u32, row: u32, scratch: *u8) View {
    ret spelled(s.codec.registers.classes[row].name);
}

fun row_key(s: *S.Set, of: u32, row: u32, scratch: *u8) View {
    ret spelled(s.codec.rows.at[row].key);
}

# bearer `row` of the name index: a register, then an alias
fun register_name(s: *S.Set, of: u32, row: u32, scratch: *u8) View {
    val file: *register.File = s.codec.registers;
    if (row < file.register_count) { ret spelled(file.registers[row].name); }
    ret spelled(file.aliases[row - file.register_count].name);
}

# the numeric index `by` of the register rows' column `numbers`: each entry holds its row's own number, the entries ascend strictly by
# number, so a number given to two registers is two adjacent equal entries, and every numbered register has exactly one
fun numbered(s: *S.Set, by: *index.Numbers, numbers: *u32, rows: u32, table: u32) err[Refusal] {
    var expected: u32 = 0;
    var i:        u32 = 0;
    for (i < rows) {
        if (numbers[i] != register.UNNUMBERED) { expected = expected + 1; }
        i = i + 1;
    }
    i = 0;
    for (i < by.len) {
        val e: *index.Number = ?by.at[i];
        if (e.row >= rows || numbers[e.row]::u64 != e.key) { ret refuse(s, NAME_ENTRY, "column", table); }
        if (i > 0) {
            if (by.at[i - 1].key == e.key) { ret refuse_pair(s, SHARED_NUMBER, "column", table, e.row); }
            if (by.at[i - 1].key > e.key)  { ret refuse(s, NAME_ORDER, "column", table); }
        }
        i = i + 1;
    }
    if (by.len != expected) { ret refuse(s, NAME_MISSING, "column", table); }
    ret fine();
}

# bearer `row` of the catalog's name index: an extension, then a level
fun extension_name(s: *S.Set, of: u32, row: u32, scratch: *u8) View {
    if (row < s.extensions.count) { ret spelled(s.extensions.extensions[row].name); }
    ret spelled(s.extensions.levels[row - s.extensions.count].name);
}

# the name index `by` of a table whose rows are named by `name` (table `of`): each entry holds its row's own name, the entries ascend
# by name, none repeats, and there are `expected` of them, so every named row has exactly one. a name given to two rows is two adjacent equal
# entries, so uniqueness is read off the index and never scanned for
fun indexed(s: *S.Set, by: *index.Index, rows: u32, expected: u32, name: Namer, of: u32, table: str, twice: str) err[Refusal] {
    var scratch: [8]u8;
    var i:       u32 = 0;
    for (i < by.len) {
        val e: *index.Entry = ?by.at[i];
        if (e.row >= rows) { ret refuse(s, NAME_ENTRY, table, e.row); }
        val own: View = name(s, of, e.row, ?scratch[0]);
        if (own.len == 0 || e.key == nil || e.key[0] == 0) { ret refuse(s, UNNAMED, table, e.row); }
        if (index.compare(e.key, own, false) != 0)         { ret refuse(s, NAME_ENTRY, table, e.row); }
        if (i > 0) {
            val order: i64 = str_compare(by.at[i - 1].key, e.key);
            if (order == 0) { ret refuse_pair(s, twice, table, by.at[i - 1].row, e.row); }
            if (order > 0)  { ret refuse(s, NAME_ORDER, table, e.row); }
        }
        i = i + 1;
    }
    if (by.len != expected) { ret refuse(s, NAME_MISSING, table, expected); }
    ret fine();
}

fun fine() err[Refusal] {
    ret err[Refusal].ok{};
}

fun arches(s: *S.Set) err[Refusal] {
    if (s.arches.len == 0) { ret refuse(s, NO_ARCH, "architecture", 0); }
    var i: u32 = 0;
    for (i < s.arches.len) {
        if (!mink.arch.member(s.arches.at[i])) { ret refuse(s, UNKNOWN_ARCH, "architecture", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.arches.at[j] == s.arches.at[i]) { ret refuse(s, SHARED_ARCH, "architecture", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret fine();
}

fun modes(s: *S.Set) err[Refusal] {
    var i: u32 = 0;
    for (i < s.modes.len) {
        val m:      *S.Mode = ?s.modes.at[i];
        var served: bool    = false;
        var j:      u32     = 0;
        for (j < s.arches.len) {
            if (s.arches.at[j] == m.arch) { served = true; }
            j = j + 1;
        }
        if (!served)                           { ret refuse(s, MODE_ARCH, "mode", i); }
        if (m.extension >= s.extensions.count) { ret refuse(s, MODE_EXTENSION, "mode", i); }
        j = 0;
        for (j < i) {
            if (s.modes.at[j].arch == m.arch) { ret refuse(s, SHARED_MODE, "mode", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < s.arches.len) {
        var stated: bool = false;
        var j:      u32  = 0;
        for (j < s.modes.len) {
            if (s.modes.at[j].arch == s.arches.at[i]) { stated = true; }
            j = j + 1;
        }
        if (!stated) { ret refuse(s, NO_MODE, "architecture", i); }
        i = i + 1;
    }
    ret fine();
}

# whether the set's assembler modes are named once each, with their values, and each flag chooses one value
fun assembly(s: *S.Set) err[Refusal] {
    val all: *mode.Modes = ?s.assembly;
    if (all.len > mode.MAX_MODES) { ret refuse(s, MODE_COUNT, "assembler mode", mode.MAX_MODES); }
    var i: u32 = 0;
    for (i < all.len) {
        val m: *mode.Mode = all.at[i];
        if (m.name == nil || m.name[0] == 0)               { ret refuse(s, MODE_NAME, "assembler mode", i); }
        if (m.values.len < 2 || !mode.takes(m, m.initial)) { ret refuse(s, MODE_VALUES, "assembler mode", i); }
        var j: u32 = 0;
        for (j < i) {
            if (all.at[j] == m || str_equals(all.at[j].name, m.name)) { ret refuse_pair(s, MODE_NAME, "assembler mode", i, j); }
            j = j + 1;
        }
        j = 0;
        for (j < m.values.len) {
            val v: *mode.Value = m.values.at[j];
            if (v.name == nil || v.name[0] == 0) { ret refuse(s, MODE_NAME, "assembler mode", i); }
            var k: u32 = 0;
            for (k < j) {
                if (m.values.at[k] == v || str_equals(m.values.at[k].name, v.name)) { ret refuse(s, MODE_NAME, "assembler mode", i); }
                k = k + 1;
            }
            if (v.flag != nil) {
                val chosen: opt[mode.Setting] = mode.flagged(all, v.flag);
                if (sel chosen.none)        { ret refuse(s, MODE_FLAG, "assembler mode", i); }
                if (chosen.some.value != v) { ret refuse(s, MODE_FLAG, "assembler mode", i); }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret fine();
}

# the register rows of the set's file, 0 for a set with none
fun register_count(s: *S.Set) u32 {
    if (s.codec.registers == nil) { ret 0; }
    ret s.codec.registers.register_count;
}

# whether `q` names a scale other than `scale`, which is none until a part names one
fun rescales(q: register.Scaled, scale: *opt[u8]) bool {
    if (q.per == 0)     { ret false; }
    if (sel scale.some) { ret scale.some != q.scale; }
    @scale = opt[u8].some{q.scale};
    ret false;
}

# whether a syntax of the set reads names without regard to ascii case
fun folds(s: *S.Set) bool {
    var i: u32 = 0;
    for (i < s.syntaxes.len) {
        if (s.syntaxes.at[i].fold) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a byte of `name` is an ascii capital
fun capitalized(name: View) bool {
    var i: usize = 0;
    for (i < name.len) {
        if (index.lower(name.data[i]) != name.data[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun scales(s: *S.Set, file: *register.File) err[Refusal] {
    var i: u32 = 0;
    for (i < file.scale_count) {
        val scale: register.Scale = file.scales[i];
        var j:     u32            = 0;
        for (j < scale.fixes.len) {
            val f: register.Fixing = scale.fixes.at[j];
            if (f.by >= s.extensions.count) { ret refuse(s, FIXING_EXTENSION, "scale", i); }
            if (f.multiplier == 0 || (f.multiplier & (f.multiplier - 1)) != 0 || f.multiplier > scale.max) {
                ret refuse(s, FIXING_MULTIPLIER, "scale", i);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret fine();
}

fun registers(s: *S.Set) err[Refusal] {
    val file: *register.File = s.codec.registers;
    if (file == nil) { ret fine(); }
    val fixed: err[Refusal] = scales(s, file);
    if (sel fixed.err) { ret fixed; }
    var c: u32 = 0;
    for (c < file.class_count) {
        val width: register.Scaled = file.classes[c].width;
        if (width.per != 0 && width.scale::u32 >= file.scale_count) { ret refuse(s, UNKNOWN_SCALE, "class", c); }
        c = c + 1;
    }
    val named: err[Refusal] = indexed(s, ?file.class_names, file.class_count, file.class_count, class_name, 0, "class", SHARED_CLASS);
    if (sel named.err) { ret named; }
    val spellings: err[Refusal] = indexed(s, ?file.names, file.register_count + file.alias_count, file.register_count + file.alias_count, register_name, 0, "register name", SHARED_NAME);
    if (sel spellings.err) { ret spellings; }
    var i: u32 = 0;
    for (i < file.register_count) {
        val r: *register.Register = ?file.registers[i];
        if (r.class::u32 >= file.class_count)             { ret refuse(s, REGISTER_CLASS, "register", i); }
        if (r.number::u32 >= file.classes[r.class].count) { ret refuse(s, REGISTER_NUMBER, "register", i); }
        var scale: opt[u8] = opt[u8].none{};
        if (rescales(file.classes[r.class].width, ?scale) || rescales(r.offset, ?scale) || rescales(r.stride, ?scale) || rescales(r.count, ?scale)) {
            ret refuse(s, MIXED_SCALES, "register", i);
        }
        if (sel scale.some && scale.some::u32 >= file.scale_count) { ret refuse(s, UNKNOWN_SCALE, "register", i); }
        if (!required_in_catalog(s.extensions, r.requires))        { ret refuse(s, UNKNOWN_EXTENSION, "register", i); }
        if (i > 0) {
            val before: register.Id = register.id_of(?file.registers[i - 1]);
            if (before == register.id_of(r)) { ret refuse_pair(s, SHARED_ID, "register", i - 1, i); }
            if (before > register.id_of(r))  { ret refuse(s, REGISTER_ORDER, "register", i); }
        }
        i = i + 1;
    }
    i = 0;
    for (i < file.alias_count) {
        val a: *register.Alias = ?file.aliases[i];
        if (a.register >= file.register_count)                  { ret refuse(s, ALIAS_TARGET, "alias", i); }
        if (i > 0 && file.aliases[i - 1].register > a.register) { ret refuse(s, ALIAS_ORDER, "alias", i); }
        i = i + 1;
    }
    # a syntax that folds case lowers what it reads, which finds a name only if the name is lower case already
    if (folds(s)) {
        i = 0;
        for (i < file.names.len) {
            val spelling: View = register_name(s, 0, file.names.at[i].row, nil);
            if (capitalized(spelling)) { ret refuse(s, CASED_NAME, "register name", file.names.at[i].row); }
            i = i + 1;
        }
    }
    i = 0;
    for (i < file.column_count) {
        val col: *register.Column = ?file.columns[i];
        if (col.len != file.register_count) { ret refuse(s, COLUMN_LENGTH, "column", i); }
        if (i > 0) {
            if (file.columns[i - 1].format == col.format) { ret refuse(s, SHARED_COLUMN, "column", i); }
            if (file.columns[i - 1].format > col.format)  { ret refuse(s, COLUMN_ORDER, "column", i); }
        }
        val keyed: err[Refusal] = numbered(s, ?col.numbered, col.numbers, file.register_count, i);
        if (sel keyed.err) { ret keyed; }
        i = i + 1;
    }
    ret fine();
}

# whether every id of every alternative of `required` is a row of `catalog`
fun required_in_catalog(catalog: *extension.Catalog, required: requirement.Requirement) bool {
    var i: u32 = 0;
    for (i < required.len) {
        if (!in_catalog(catalog, required.at[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether every id of `ids` is a row of `catalog`
fun in_catalog(catalog: *extension.Catalog, ids: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (ids.at[i] >= catalog.count) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun extensions(s: *S.Set) err[Refusal] {
    val catalog: *extension.Catalog = s.extensions;
    if (catalog.syntax == nil) { ret refuse(s, NO_SYNTAX, "catalog", 0); }
    val named: err[Refusal] = indexed(s, ?catalog.names, catalog.count + catalog.level_count, catalog.count + catalog.level_count, extension_name, 0, "extension name", SHARED_NAME);
    if (sel named.err) { ret named; }
    var i: u32 = 0;
    for (i < catalog.count) {
        if (!in_catalog(catalog, catalog.extensions[i].implies)) { ret refuse(s, IMPLIED, "extension", i); }
        i = i + 1;
    }
    i = 0;
    for (i < catalog.level_count) {
        if (!in_catalog(catalog, catalog.levels[i].members)) { ret refuse(s, LEVEL_MEMBER, "level", i); }
        i = i + 1;
    }
    i = 0;
    for (i < catalog.conflict_count) {
        val pair: extension.Conflict = catalog.conflicts[i];
        if (pair.a >= catalog.count || pair.b >= catalog.count || pair.a == pair.b) { ret refuse(s, CONFLICT, "conflict", i); }
        if (pair.a > pair.b)                                                        { ret refuse(s, CONFLICT_ORDER, "conflict", i); }
        if (i > 0) {
            val before: extension.Conflict = catalog.conflicts[i - 1];
            if (before.a == pair.a && before.b == pair.b)                       { ret refuse(s, CONFLICT_TWICE, "conflict", i); }
            if (before.a > pair.a || (before.a == pair.a && before.b > pair.b)) { ret refuse(s, CONFLICT_ORDER, "conflict", i); }
        }
        i = i + 1;
    }
    i = 0;
    for (i < catalog.combination_count) {
        val combo: extension.Combination = catalog.combinations[i];
        if (combo.by >= catalog.count || !in_catalog(catalog, combo.when) || !in_catalog(catalog, combo.implies)) { ret refuse(s, COMBINATION, "combination", i); }
        i = i + 1;
    }
    ret fine();
}

fun bindings(s: *S.Set) err[Refusal] {
    var i: u32 = 0;
    for (i < s.bindings.len) {
        val b: *S.Binding = ?s.bindings.at[i];
        if (b.fixup == operand.NO_FIXUP) { ret refuse(s, NO_FIXUP, "binding", i); }
        if (!mink.reloc.member(b.kind))  { ret refuse(s, UNKNOWN_RELOC, "binding", i); }
        if (i > 0) {
            if (s.bindings.at[i - 1].fixup == b.fixup) { ret refuse(s, BOUND_TWICE, "binding", i); }
            if (s.bindings.at[i - 1].fixup > b.fixup)  { ret refuse(s, BOUND_ORDER, "binding", i); }
        }
        i = i + 1;
    }
    if (!bound(s, s.realign)) { ret refuse(s, UNBOUND_FIXUP, "realign", 0); }
    i = 0;
    for (i < s.data.len) {
        val d: *S.Datum = ?s.data.at[i];
        if (d.fixup == operand.NO_FIXUP || !bound(s, d.fixup))             { ret refuse(s, UNBOUND_FIXUP, "datum", i); }
        if (d.width == 0 || d.width > S.MAX_WIDTH || d.basis > S.RELATIVE) { ret refuse(s, DATUM, "datum", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.data.at[j].basis == d.basis && s.data.at[j].width == d.width) { ret refuse(s, DATUM, "datum", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < s.spans.len) {
        val sp: *S.Span = ?s.spans.at[i];
        if (sp.fixup == operand.NO_FIXUP || !bound(s, sp.fixup) || !bound(s, sp.marker)) { ret refuse(s, SPAN, "span", i); }
        if (sp.count < 2 || sp.count > relax.MAX_STEPS)                                  { ret refuse(s, SPAN, "span", i); }
        if (i > 0 && s.spans.at[i - 1].fixup >= sp.fixup)                                { ret refuse(s, SPAN, "span", i); }
        i = i + 1;
    }
    i = 0;
    for (i < s.pairs.len) {
        val q: *S.Pair = ?s.pairs.at[i];
        if (q.add == operand.NO_FIXUP || q.sub == operand.NO_FIXUP || !bound(s, q.add) || !bound(s, q.sub)) { ret refuse(s, PAIR, "pair", i); }
        if (q.width == 0 || q.width > S.MAX_WIDTH)                                                          { ret refuse(s, PAIR, "pair", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.pairs.at[j].width == q.width) { ret refuse(s, PAIR, "pair", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < s.options.len) {
        val o:        *S.Stated = ?s.options.at[i];
        var required: bool      = false;
        var k:        u32       = 0;
        for (k < s.supplied.len) {
            if (s.supplied.at[k] == o.trait.axis) { required = true; }
            k = k + 1;
        }
        if (!required || !mink.trait.fits(o.trait.axis, o.trait.setting)) { ret refuse(s, OPTION_ROW, "option", i); }
        var j: u32 = 0;
        for (j < i) {
            if (str_equals(s.options.at[j].option, o.option) && str_equals(s.options.at[j].value, o.value)) { ret refuse_pair(s, OPTION_ROW, "option", i, j); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret fine();
}

# the set's assembly source dialect: a comment and a separator, a reading of .align, and each data directive once
fun source(s: *S.Set) err[Refusal] {
    val src: *S.Source = ?s.source;
    if (src.comment == nil || src.comment[0] == 0 || src.separator == 0 || src.align > S.ALIGN_POWER) { ret refuse(s, SOURCE, "source", 0); }
    var i: u32 = 0;
    for (i < src.widths.len) {
        val w: *S.Width = ?src.widths.at[i];
        if (w.name == nil || w.name[0] != '.' || w.width == 0 || w.width > S.MAX_WIDTH) { ret refuse(s, WIDTH_ROW, "width", i); }
        var j: u32 = 0;
        for (j < i) {
            if (str_equals(src.widths.at[j].name, w.name)) { ret refuse_pair(s, WIDTH_ROW, "width", i, j); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret fine();
}

# whether `fixup` is NO_FIXUP or bound by the set, by binary search of the bindings the set keeps in ascending order of kind
fun bound(s: *S.Set, fixup: operand.FixupKind) bool {
    if (fixup == operand.NO_FIXUP) { ret true; }
    var lo: u32 = 0;
    var hi: u32 = s.bindings.len;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (s.bindings.at[mid].fixup < fixup) { lo = mid + 1; }
        or                                    { hi = mid; }
    }
    ret lo < s.bindings.len && s.bindings.at[lo].fixup == fixup;
}

# whether every class of `r` is in the set's register file
fun in_file(s: *S.Set, r: *operand.Register) bool {
    var count: u32 = 0;
    if (s.codec.registers != nil) { count = s.codec.registers.class_count; }
    var i: u32 = 0;
    for (i < r.classes.len) {
        if (r.classes.at[i]::u32 >= count) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the range of `r` lies inside each of its classes, which must be in the file
fun in_range(s: *S.Set, r: *operand.Register) bool {
    var i: u32 = 0;
    for (i < r.classes.len) {
        val count: u32 = s.codec.registers.classes[r.classes.at[i]].count;
        if (r.first >= count || (r.count != 0 && r.count > count - r.first)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether every number `r` excludes lies in the range of one of its classes, which must be in the file
fun excludes_in_range(s: *S.Set, r: *operand.Register) bool {
    var k: u32 = 0;
    for (k < r.excluded.len) {
        var held: bool = false;
        var i:    u32  = 0;
        for (i < r.classes.len) {
            if (operand.within(r, r.excluded.at[k], s.codec.registers.classes[r.classes.at[i]].count)) { held = true; }
            i = i + 1;
        }
        if (!held) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether every value `imm` excludes is one it could hold
fun excludes_representable(imm: *operand.Immediate) bool {
    var i: u32 = 0;
    for (i < imm.excluded.len) {
        val bad: opt[str] = walk.unrepresentable(imm, imm.excluded.at[i]);
        if (sel bad.some) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the bits that number every register of `r` from its range's first
fun number_bits(s: *S.Set, r: *operand.Register) u8 {
    var bits: u8  = 0;
    var i:    u32 = 0;
    for (i < r.classes.len) {
        var top:  u32 = operand.span(r, s.codec.registers.classes[r.classes.at[i]].count);
        var need: u8  = 0;
        if (top > 0) { top = top - 1; }
        for (top != 0) {
            need = need + 1;
            top  = top >> 1;
        }
        if (need > bits) { bits = need; }
        i = i + 1;
    }
    ret bits;
}

# whether `taken`, the bits slices take of a part, covers bits `lo` to `hi - 1` when it takes any
fun covers(taken: u64, lo: u8, hi: u8) bool {
    if (taken == 0 || hi <= lo) { ret true; }
    ret ((field.ones(hi) & ~field.ones(lo)) & ~taken) == 0;
}

fun covers_immediate(taken: u64, imm: *operand.Immediate) bool {
    ret covers(taken, imm.scale, imm.bits);
}

# the registers `r` an operand part admits, the slices taking that part `taken`
fun admits(s: *S.Set, r: *operand.Register, taken: u64) opt[str] {
    if (!in_file(s, r))                       { ret opt[str].some{UNKNOWN_CLASS}; }
    if (!in_range(s, r))                      { ret opt[str].some{REGISTER_RANGE}; }
    if (!excludes_in_range(s, r))             { ret opt[str].some{EXCLUDED_RANGE}; }
    if (!covers(taken, 0, number_bits(s, r))) { ret opt[str].some{UNCOVERED}; }
    ret opt[str].none{};
}

# whether register shape `reg` of a row of `count` operands `operands` states an element width and span its readers can
# read: a fixed width a power of two, a chosen one an enumerant operand's, and a scaled span over a fixed or state width
fun element_ok(operands: *operand.Operand, count: u32, reg: *operand.Register) bool {
    val e: operand.Element = reg.element;
    if (sel e.fixed && (e.fixed == 0 || (e.fixed & (e.fixed - 1)) != 0)) { ret false; }
    if (sel e.chosen) {
        val c: operand.Chosen = e.chosen;
        if (c.operand::u32 >= count) { ret false; }
        val named: *operand.Operand = ?operands[c.operand];
        if (!sel named.shape.enumerant) { ret false; }
        ret !sel reg.span.scaled;
    }
    ret !(sel reg.span.scaled && sel e.none);
}

# the name index of enumeration `e`: each entry holds its member's own name, the entries ascend by name with the empty name first, none
# repeats, every member has exactly one, and a set whose syntax folds case names its members in lower case
fun enumeration(s: *S.Set, e: *operand.Enumeration) opt[str] {
    val by:   *index.Index = ?e.names;
    val fold: bool         = folds(s);
    var i:    u32          = 0;
    for (i < by.len) {
        val en: *index.Entry = ?by.at[i];
        if (en.row >= e.count || en.key == nil) { ret opt[str].some{NAME_ENTRY}; }
        val own: View = spelled(e.members[en.row].name);
        if (index.compare(en.key, own, false) != 0) { ret opt[str].some{NAME_ENTRY}; }
        if (fold && capitalized(own))               { ret opt[str].some{CASED_NAME}; }
        if (i > 0) {
            val order: i64 = str_compare(by.at[i - 1].key, en.key);
            if (order == 0) { ret opt[str].some{SHARED_NAME}; }
            if (order > 0)  { ret opt[str].some{NAME_ORDER}; }
        }
        i = i + 1;
    }
    if (by.len != e.count) { ret opt[str].some{NAME_MISSING}; }
    ret opt[str].none{};
}

# the shape of an operand: its classes in the file, its fixup kinds bound, and the slices taking it covering it
fun shape(s: *S.Set, r: *row.Row, op: u8) opt[str] {
    var taken: [8]u64;
    var f:     u32 = 0;
    for (f < r.encoding.len) {
        val fl: *field.Field = ?r.encoding.at[f];
        var k:  u32          = 0;
        for (k < fl.slices.len) {
            val sl: *field.Slice = ?fl.slices.at[k];
            if (sl.operand == op) { taken[sl.part] = taken[sl.part] | (field.ones(sl.len) << sl.lo); }
            k = k + 1;
        }
        f = f + 1;
    }
    val sh: *operand.Shape = ?r.operands.at[op].shape;
    if (sel sh.register) {
        if (sh.register.fields == 0)                                  { ret opt[str].some{GROUP_FIELDS}; }
        if (!element_ok(r.operands.at, r.operands.len, ?sh.register)) { ret opt[str].some{ELEMENT_WIDTH}; }
        ret admits(s, ?sh.register, taken[field.NUMBER]);
    }
    or (sel sh.immediate) {
        if (!bound(s, sh.immediate.fixup))                         { ret opt[str].some{UNBOUND_FIXUP}; }
        if (!covers_immediate(taken[field.NUMBER], ?sh.immediate)) { ret opt[str].some{UNCOVERED}; }
        if (!excludes_representable(?sh.immediate))                { ret opt[str].some{EXCLUDED_RANGE}; }
    }
    or (sel sh.relative) {
        if (!bound(s, sh.relative.offset.fixup))                         { ret opt[str].some{UNBOUND_FIXUP}; }
        if (!covers_immediate(taken[field.NUMBER], ?sh.relative.offset)) { ret opt[str].some{UNCOVERED}; }
        if (!excludes_representable(?sh.relative.offset))                { ret opt[str].some{EXCLUDED_RANGE}; }
    }
    or (sel sh.memory) {
        val m: *operand.Memory = ?sh.memory;
        if (m.base.fields != 1 || m.index.fields != 1 || m.segment.fields != 1) { ret opt[str].some{GROUP_FIELDS}; }
        val n: u32 = r.operands.len;
        if (!element_ok(r.operands.at, n, ?m.base) || !element_ok(r.operands.at, n, ?m.index) || !element_ok(r.operands.at, n, ?m.segment)) { ret opt[str].some{ELEMENT_WIDTH}; }
        val base: opt[str] = admits(s, ?m.base, taken[field.NUMBER]);
        if (sel base.some) { ret base; }
        val index: opt[str] = admits(s, ?m.index, taken[field.INDEX]);
        if (sel index.some) { ret index; }
        val segment: opt[str] = admits(s, ?m.segment, taken[field.SEGMENT]);
        if (sel segment.some)                              { ret segment; }
        if (!bound(s, m.disp.fixup))                       { ret opt[str].some{UNBOUND_FIXUP}; }
        if (!covers_immediate(taken[field.DISP], ?m.disp)) { ret opt[str].some{UNCOVERED}; }
        if (!excludes_representable(?m.disp))              { ret opt[str].some{EXCLUDED_RANGE}; }
    }
    or (sel sh.list) {
        if (sh.list.member.fields == 0)                                  { ret opt[str].some{GROUP_FIELDS}; }
        if (!element_ok(r.operands.at, r.operands.len, ?sh.list.member)) { ret opt[str].some{ELEMENT_WIDTH}; }
        ret admits(s, ?sh.list.member, taken[field.NUMBER]);
    }
    or (sel sh.id) {
        if (!bound(s, sh.id.fixup)) { ret opt[str].some{UNBOUND_FIXUP}; }
    }
    or (sel sh.enumerant) {
        ret enumeration(s, ?sh.enumerant);
    }
    or (sel sh.condition) {
        ret enumeration(s, ?sh.condition);
    }
    ret opt[str].none{};
}

# the fields of a row: kinds in the table, units of whole bytes, and slices inside their operand, part and unit
fun fields(s: *S.Set, r: *row.Row) opt[str] {
    var f: u32 = 0;
    for (f < r.encoding.len) {
        val fl: *field.Field = ?r.encoding.at[f];
        if (fl.kind::u32 >= s.codec.fields.count)                                { ret opt[str].some{UNKNOWN_KIND}; }
        if (fl.width % 8 != 0 || fl.width > 64)                                  { ret opt[str].some{UNIT_WIDTH}; }
        if (fl.operand != field.NO_OPERAND && fl.operand::u32 >= r.operands.len) { ret opt[str].some{FIELD_OPERAND}; }
        var k: u32 = 0;
        for (k < fl.slices.len) {
            val sl: *field.Slice = ?fl.slices.at[k];
            if (sl.operand::u32 >= r.operands.len || sl.part::u32 >= field.PARTS || sl.len == 0 || sl.lo::u32 + sl.len::u32 > 64 || sl.at::u32 + sl.len::u32 > fl.width::u32) {
                ret opt[str].some{SLICE};
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret opt[str].none{};
}

# whether every row `set` holds is in the file and, for flags, in a flags class
fun holds(s: *S.Set, set: effect.Set, flags: bool) opt[str] {
    val count: u32 = register_count(s);
    var w:     u32 = 0;
    for (w < set.len) {
        var b: u32 = 0;
        for (b < 64) {
            if (((set.words[w] >> b::u64) & 1) != 0) {
                val at: u32 = w * 64 + b;
                if (at >= count) { ret opt[str].some{EFFECT_ROW}; }
                val file: *register.File = s.codec.registers;
                if (flags && file.classes[file.registers[at].class].kind != register.FLAGS) { ret opt[str].some{FLAG_ROW}; }
            }
            b = b + 1;
        }
        w = w + 1;
    }
    ret opt[str].none{};
}

# whether `op` is an operand of `r` or NO_OPERAND
fun operand_or_none(r: *row.Row, op: u8) bool {
    ret op == field.NO_OPERAND || op::u32 < r.operands.len;
}

fun count_ok(s: *S.Set, r: *row.Row, c: *effect.Count) bool {
    if (sel c.register) { ret c.register < register_count(s); }
    if (sel c.operand)  { ret c.operand::u32 < r.operands.len; }
    ret true;
}

fun access(s: *S.Set, r: *row.Row, a: *effect.Access) opt[str] {
    if (!operand_or_none(r, a.operand) || !operand_or_none(r, a.governor) || (a.forming & ~field.ones(r.operands.len::u8)::u32) != 0 || !count_ok(s, r, ?a.width.count)) {
        ret opt[str].some{EFFECT_OPERAND};
    }
    if (a.base != effect.NO_ROW && a.base >= register_count(s)) { ret opt[str].some{EFFECT_ROW}; }
    var through: bool = false;
    if (a.operand != field.NO_OPERAND) {
        val desc: *operand.Operand = ?r.operands.at[a.operand];
        through = sel desc.shape.memory;
        if (through && (desc.width != 0 || a.role != operand.NONE)) { ret opt[str].some{ACCESS_FORM}; }
    }
    if (!through && a.role == operand.NONE) { ret opt[str].some{ACCESS_FORM}; }
    ret opt[str].none{};
}

# whether `all`, one rule's terms, are at least one and each test an operand of `r` of its kind over rows of the file
fun terms(s: *S.Set, r: *row.Row, all: effect.Terms) opt[str] {
    if (all.len == 0) { ret opt[str].some{RULE_TERMS}; }
    var k: u32 = 0;
    for (k < all.len) {
        val term: *effect.Term = ?all.at[k];
        if (term.operand::u32 >= r.operands.len) { ret opt[str].some{RULE_OPERAND}; }
        val sh: *operand.Shape = ?r.operands.at[term.operand].shape;
        if (sel term.test.register) {
            if (!sel sh.register) { ret opt[str].some{RULE_OPERAND}; }
            val held: opt[str] = holds(s, term.test.register, false);
            if (sel held.some) { ret held; }
        }
        if (sel term.test.immediate && !sel sh.immediate) { ret opt[str].some{RULE_OPERAND}; }
        if (sel term.test.enumerant && !sel sh.enumerant) { ret opt[str].some{RULE_OPERAND}; }
        if (sel term.test.condition && !sel sh.condition) { ret opt[str].some{RULE_OPERAND}; }
        if (sel term.test.id && !sel sh.id)               { ret opt[str].some{RULE_OPERAND}; }
        k = k + 1;
    }
    ret opt[str].none{};
}

# whether the rules of `c` each have checked terms and are pairwise exclusive, so that no order among them can matter
fun rules(s: *S.Set, r: *row.Row, c: *effect.Control) opt[str] {
    var i: u32 = 0;
    for (i < c.rules.len) {
        val rule:   *effect.Rule = ?c.rules.at[i];
        val tested: opt[str]     = terms(s, r, rule.terms);
        if (sel tested.some)                                                   { ret tested; }
        if (rule.target != effect.UNTARGETED && c.operand == field.NO_OPERAND) { ret opt[str].some{EFFECT_OPERAND}; }
        var j: u32 = 0;
        for (j < i) {
            if (!effect.exclusive(c.rules.at[j].terms, rule.terms)) { ret opt[str].some{RULE_OVERLAP}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

# whether `t` names rows of the file
fun touched(s: *S.Set, t: effect.Touched) opt[str] {
    val read: opt[str] = holds(s, t.read, false);
    if (sel read.some) { ret read; }
    ret holds(s, t.written, false);
}

# whether the implicit registers `g` name rows of the file, its rules each have checked terms and are pairwise exclusive,
# and its may and must sets bound its own and its rules'
fun register_rules(s: *S.Set, r: *row.Row, g: *effect.Registers) opt[str] {
    val sets: [3]effect.Touched = [3]effect.Touched{g.otherwise, g.may, g.must};
    var i:    u32               = 0;
    for (i < 3) {
        val held: opt[str] = touched(s, sets[i]);
        if (sel held.some) { ret held; }
        i = i + 1;
    }
    i = 0;
    for (i < g.rules.len) {
        val rule:   *effect.RegisterRule = ?g.rules.at[i];
        val tested: opt[str]             = terms(s, r, rule.terms);
        if (sel tested.some) { ret tested; }
        val held: opt[str] = touched(s, rule.touched);
        if (sel held.some) { ret held; }
        var j: u32 = 0;
        for (j < i) {
            if (!effect.exclusive(g.rules.at[j].terms, rule.terms)) { ret opt[str].some{RULE_OVERLAP}; }
            j = j + 1;
        }
        i = i + 1;
    }
    if (!effect.bounded(g, (register_count(s) + 63) / 64)) { ret opt[str].some{RULE_BOUNDS}; }
    ret opt[str].none{};
}

fun effects(s: *S.Set, r: *row.Row) opt[str] {
    if (r.effect == nil || r.ct == nil) { ret opt[str].some{NO_EFFECT}; }
    val e:         *effect.Effect = r.effect;
    val flag_sets: [4]effect.Set  = [4]effect.Set{e.flags.read, e.flags.written, e.flags.undefined, e.flags.kept};
    val switched:  opt[str]       = register_rules(s, r, ?e.implicit);
    if (sel switched.some) { ret switched; }
    var i: u32 = 0;
    for (i < 4) {
        val held: opt[str] = holds(s, flag_sets[i], true);
        if (sel held.some) { ret held; }
        i = i + 1;
    }
    i = 0;
    for (i < e.memory.len) {
        val checked: opt[str] = access(s, r, ?e.memory.at[i]);
        if (sel checked.some) { ret checked; }
        i = i + 1;
    }
    if (!operand_or_none(r, e.control.operand)) { ret opt[str].some{EFFECT_OPERAND}; }
    val ruled: opt[str] = rules(s, r, ?e.control);
    if (sel ruled.some) { ret ruled; }
    val stack: *effect.Stack = ?e.stack;
    if (sel stack.delta && !operand_or_none(r, stack.delta.operand)) { ret opt[str].some{EFFECT_OPERAND}; }
    i = 0;
    for (i < e.fixed.len) {
        val fx: effect.Fixed = e.fixed.at[i];
        if (fx.operand::u32 >= r.operands.len) { ret opt[str].some{FIXED_OPERAND}; }
        val sh: *operand.Shape = ?r.operands.at[fx.operand].shape;
        if (!sel sh.register)                 { ret opt[str].some{FIXED_OPERAND}; }
        if (fx.register >= register_count(s)) { ret opt[str].some{EFFECT_ROW}; }
        val reg: *register.Register = ?s.codec.registers.registers[fx.register];
        val r:   *operand.Register  = ?sh.register;
        if (operand.find(r.classes, reg.class) < 0 || !operand.within(r, reg.number::u32, s.codec.registers.classes[reg.class].count)) {
            ret opt[str].some{FIXED_CLASS};
        }
        i = i + 1;
    }
    val c: *ct.Class = r.ct;
    if (sel c.dependent && (c.dependent.operands == operand.NO_POSITIONS && !c.dependent.accesses)) { ret opt[str].some{NO_INPUT}; }
    if (sel c.conditional && c.conditional.condition >= s.extensions.count)                         { ret opt[str].some{CONDITION}; }
    ret opt[str].none{};
}

# whether `side` names an operand of `r` whose value holds a register of its part
fun side_ok(r: *row.Row, side: constraint.Side) bool {
    if (side.operand::u32 >= r.operands.len) { ret false; }
    val sh: *operand.Shape = ?r.operands.at[side.operand].shape;
    if (side.part == constraint.WHOLE) { ret sel sh.register || sel sh.list; }
    if (sel sh.memory) {
        if (side.part == constraint.BASE)  { ret sh.memory.base.classes.len > 0; }
        if (side.part == constraint.INDEX) { ret sh.memory.index.classes.len > 0; }
    }
    ret false;
}

# whether `side` of `r` is a group a permit by element widths reads: a whole register operand stating its element width,
# of one field when `fields` asks it
fun grouped(r: *row.Row, side: constraint.Side, one: bool) bool {
    if (side.part != constraint.WHOLE) { ret false; }
    val op:  *operand.Operand  = ?r.operands.at[side.operand];
    var reg: *operand.Register = nil;
    if (sel op.shape.register) { reg = ?op.shape.register; }
    or (sel op.shape.list)     { reg = ?op.shape.list.member; }
    or                         { ret false; }
    if (sel reg.element.none)  { ret false; }
    ret !one || reg.fields == 1;
}

# whether each register constraint of `r` names operands it has, of a kind their parts read, and a register of the file,
# keeps its side apart from something, permits an overlap by element widths only between groups stating them, and tests
# operands of its terms' kinds, by the terms check effect rules share
fun constraints(s: *S.Set, r: *row.Row) opt[str] {
    var i: u32 = 0;
    for (i < r.constraints.len) {
        val c: *constraint.Constraint = ?r.constraints.at[i];
        if (!side_ok(r, c.side))                                                                                      { ret opt[str].some{KEPT_OPERAND}; }
        if (c.permit != constraint.DISJOINT && c.permit != constraint.BY_WIDTHS && c.permit != constraint.SAME_WIDTH) { ret opt[str].some{KEPT_PERMIT}; }
        val widths: bool = c.permit != constraint.DISJOINT;
        val one:    bool = c.permit == constraint.BY_WIDTHS;
        var group:  bool = !widths || grouped(r, c.side, one);
        if (sel c.against.sides) {
            val sides: constraint.Sides = c.against.sides;
            if (sides.len == 0) { ret opt[str].some{KEPT_OPERAND}; }
            var k: u32 = 0;
            for (k < sides.len) {
                if (!side_ok(r, sides.at[k])) { ret opt[str].some{KEPT_OPERAND}; }
                group = group && (!widths || grouped(r, sides.at[k], one));
                k     = k + 1;
            }
        }
        or {
            group = group && !widths;
        }
        if (sel c.against.register && c.against.register >= register_count(s)) { ret opt[str].some{EFFECT_ROW}; }
        if (!group)                                                            { ret opt[str].some{KEPT_PERMIT}; }
        if (c.when.len > 0) {
            val tested: opt[str] = terms(s, r, c.when);
            if (sel tested.some) { ret tested; }
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

fun rows(s: *S.Set) err[Refusal] {
    val keyed: err[Refusal] = indexed(s, ?s.codec.keys, s.codec.rows.len, s.codec.rows.len, row_key, 0, "row", SHARED_KEY);
    if (sel keyed.err) { ret keyed; }
    var i: u32 = 0;
    for (i < s.codec.rows.len) {
        val r: *row.Row = ?s.codec.rows.at[i];
        if (r.operands.len > row.MAX_OPERANDS)              { ret refuse(s, OPERANDS, "row", i); }
        if (r.encoding.len > row.MAX_FIELDS)                { ret refuse(s, FIELDS, "row", i); }
        if (!required_in_catalog(s.extensions, r.requires)) { ret refuse(s, UNKNOWN_EXTENSION, "row", i); }
        val laid: opt[str] = fields(s, r);
        if (sel laid.some) { ret refuse(s, laid.some, "row", i); }
        var op: u32 = 0;
        for (op < r.operands.len) {
            val shaped: opt[str] = shape(s, r, op::u8);
            if (sel shaped.some) { ret refuse(s, shaped.some, "row", i); }
            op = op + 1;
        }
        val affected: opt[str] = effects(s, r);
        if (sel affected.some) { ret refuse(s, affected.some, "row", i); }
        val kept: opt[str] = constraints(s, r);
        if (sel kept.some) { ret refuse(s, kept.some, "row", i); }
        i = i + 1;
    }
    ret fine();
}

fun dispatch(s: *S.Set) err[Refusal] {
    val d: *walk.Dispatch = s.codec.dispatch;
    if (d.node_count == 0) { ret refuse(s, NO_ROOT, "node", 0); }
    var n: u32 = 0;
    for (n < d.node_count) {
        val node: *walk.Node = ?d.nodes[n];
        if (node.key::u32 >= d.key_count || node.first::u64 + node.count::u64 > d.entry_count::u64) { ret refuse(s, NODE, "node", n); }
        var k: u32 = 0;
        for (k < node.count) {
            val e: *walk.Entry = ?d.entries[node.first + k];
            if (k > 0 && d.entries[node.first + k - 1].value >= e.value) { ret refuse(s, UNSORTED, "node", n); }
            if (e.node != 0) {
                if (e.node > d.node_count) { ret refuse(s, ENTRY, "entry", node.first + k); }
            }
            or (e.first::u64 + e.count::u64 > d.candidate_count::u64) {
                ret refuse(s, ENTRY, "entry", node.first + k);
            }
            k = k + 1;
        }
        n = n + 1;
    }
    var c: u32 = 0;
    for (c < d.candidate_count) {
        val at: u32 = d.candidates[c];
        if (at >= s.codec.rows.len) { ret refuse(s, CANDIDATE, "candidate", c); }
        c = c + 1;
    }
    ret fine();
}

# the row of the step that takes the target, which a relaxation has exactly once
fun target_row(rx: *relax.Relaxation) u32 {
    var i: u32 = 0;
    for (i < rx.form.len) {
        val step: *relax.Step = ?rx.form.at[i];
        var k:    u32         = 0;
        for (k < step.values.len) {
            val src: *relax.Source = ?step.values.at[k];
            if (sel src.target) { ret step.row; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret effect.NO_ROW;
}

fun form(s: *S.Set, rx: *relax.Relaxation) opt[str] {
    val from:    *row.Row = ?s.codec.rows.at[rx.row];
    var targets: u32      = 0;
    if (rx.form.len == 0) { ret opt[str].some{RELAX_FORM}; }
    var i: u32 = 0;
    for (i < rx.form.len) {
        val step: *relax.Step = ?rx.form.at[i];
        if (step.row >= s.codec.rows.len)                              { ret opt[str].some{RELAX_ROW}; }
        if (step.values.len != s.codec.rows.at[step.row].operands.len) { ret opt[str].some{RELAX_FORM}; }
        var k: u32 = 0;
        for (k < step.values.len) {
            val src: *relax.Source = ?step.values.at[k];
            if ((sel src.operand && src.operand::u32 >= from.operands.len) || (sel src.flipped && src.flipped.operand::u32 >= from.operands.len) || (sel src.register && src.register >= register_count(s))) {
                ret opt[str].some{RELAX_SOURCE};
            }
            if (sel src.target) { targets = targets + 1; }
            k = k + 1;
        }
        i = i + 1;
    }
    if (targets != 1) { ret opt[str].some{RELAX_TARGET}; }
    ret opt[str].none{};
}

# bearer `row` of the relaxation index: the row its relaxation relaxes
fun relax_key(s: *S.Set, of: u32, row: u32, scratch: *u8) View {
    ret spelled(s.codec.rows.at[s.relax.at[row].row].key);
}

fun relaxations(s: *S.Set) err[Refusal] {
    val all: relax.Relaxations = s.relax;
    var i:   u32               = 0;
    for (i < all.len) {
        val rx: *relax.Relaxation = ?all.at[i];
        if (rx.row >= s.codec.rows.len)                              { ret refuse(s, RELAX_ROW, "relaxation", i); }
        if (rx.operand::u32 >= s.codec.rows.at[rx.row].operands.len) { ret refuse(s, RELAX_OPERAND, "relaxation", i); }
        val desc: *operand.Operand = ?s.codec.rows.at[rx.row].operands.at[rx.operand];
        if (!sel desc.shape.relative) { ret refuse(s, RELAX_OPERAND, "relaxation", i); }
        val formed: opt[str] = form(s, rx);
        if (sel formed.some) { ret refuse(s, formed.some, "relaxation", i); }
        i = i + 1;
    }
    val keyed: err[Refusal] = indexed(s, ?all.keys, all.len, all.len, relax_key, 0, "relaxation", RELAX_TWICE);
    if (sel keyed.err) { ret keyed; }
    # a chain of relaxations follows the step taking the target, and must end
    i = 0;
    for (i < all.len) {
        var next:  u32 = target_row(?all.at[i]);
        var steps: u32 = 0;
        for (next != effect.NO_ROW) {
            if (steps >= all.len) { ret refuse(s, RELAX_CYCLE, "relaxation", i); }
            val at: opt[u32] = index.find(?all.keys, s.codec.rows.at[next].key);
            next = effect.NO_ROW;
            if (sel at.some) { next = target_row(?all.at[at.some]); }
            steps = steps + 1;
        }
        i = i + 1;
    }
    ret fine();
}

fun fill(s: *S.Set) err[Refusal] {
    if (s.fill == nil)     { ret fine(); }
    if (s.fill.count == 0) { ret refuse(s, PATTERN, "pattern", 0); }
    var i: u32 = 0;
    for (i < s.fill.count) {
        val p: *S.Pattern = ?s.fill.patterns[i];
        if (p.len == 0 || p.bytes == nil || (i > 0 && p.len >= s.fill.patterns[i - 1].len)) { ret refuse(s, PATTERN, "pattern", i); }
        if (!required_in_catalog(s.extensions, p.requires))                                 { ret refuse(s, UNKNOWN_EXTENSION, "pattern", i); }
        i = i + 1;
    }
    ret fine();
}

# the defect of `template` over `count` operands read by `descs`, bit n of `unwritten` set when operand n may go unwritten
fun template_defect(syntax: *spelling.Syntax, template: str, descs: **operand.Operand, count: u32, unwritten: u32) opt[str] {
    if (template == nil) { ret opt[str].some{TEMPLATE}; }
    var seen: u32   = 0;
    var open: bool  = false;
    var at:   usize = 0;
    for {
        val p: spelling.Piece = spelling.piece(template, at);
        at = p.at + p.len;
        if (p.kind == spelling.END)                                                                                { brk; }
        if (p.kind == spelling.BROKEN || (p.kind == spelling.OPEN && open) || (p.kind == spelling.CLOSE && !open)) { ret opt[str].some{TEMPLATE}; }
        if (p.kind == spelling.OPEN)                                                                               { open = true; }
        if (p.kind == spelling.CLOSE)                                                                              { open = false; }
        if (p.kind == spelling.HOLE) {
            if (p.operand::u32 >= count || descs[p.operand] == nil) { ret opt[str].some{TEMPLATE}; }
            val bit: u32 = 1::u32 << p.operand::u32;
            if ((seen & bit) != 0) { ret opt[str].some{WRITTEN_TWICE}; }
            seen = seen | bit;
            val d: *operand.Operand = descs[p.operand];
            if ((d.quantity == operand.OPTIONAL) != open) { ret opt[str].some{GROUP_OPERAND}; }
            val shape: *operand.Shape = ?d.shape;
            if (!(sel shape.register || sel shape.enumerant || sel shape.condition) && spelling.hook(syntax, shape) == nil) { ret opt[str].some{NO_HOOK}; }
        }
    }
    if (open) { ret opt[str].some{TEMPLATE}; }
    var k: u32 = 0;
    for (k < count) {
        if (((seen | unwritten) & (1::u32 << k)) == 0) { ret opt[str].some{UNWRITTEN}; }
        k = k + 1;
    }
    ret opt[str].none{};
}

# whether `imm` holds every value of `values` and excludes none of them itself
fun holds_integers(imm: *operand.Immediate, values: operand.Integers) bool {
    var k: u32 = 0;
    for (k < values.len) {
        val bad: opt[str] = walk.unrepresentable(imm, values.at[k]);
        if (sel bad.some || operand.excludes_value(imm, values.at[k])) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether `e` admits every value of `values`, and `values` names at least one
fun holds_members(e: *operand.Enumeration, values: operand.Numbers) bool {
    if (values.len == 0) { ret false; }
    var k: u32 = 0;
    for (k < values.len) {
        if (!operand.member(e, values.at[k])) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether `d`, one value per operand, holds every value of `ex` and excludes none of them itself, and `ex` names at least one
fun excludable(s: *S.Set, d: *operand.Operand, ex: *spelling.Excluded) bool {
    if (d.quantity == operand.VARIADIC) { ret false; }
    val shape: *operand.Shape = ?d.shape;
    var k:     u32            = 0;
    if (sel ex.register) {
        if (ex.register.len == 0 || !sel shape.register) { ret false; }
        if (sel shape.register) {
            val r: *operand.Register = ?shape.register;
            if (!in_file(s, r)) { ret false; }
            for (k < ex.register.len) {
                val n:    u32  = ex.register.at[k];
                var held: bool = false;
                var i:    u32  = 0;
                for (i < r.classes.len) {
                    if (operand.within(r, n, s.codec.registers.classes[r.classes.at[i]].count)) { held = true; }
                    i = i + 1;
                }
                if (!held || operand.excludes_number(r, n)) { ret false; }
                k = k + 1;
            }
        }
        ret true;
    }
    if (sel ex.immediate) {
        if (ex.immediate.len == 0) { ret false; }
        if (sel shape.immediate)   { ret holds_integers(?shape.immediate, ex.immediate); }
        ret false;
    }
    if (sel ex.relative) {
        if (ex.relative.len == 0) { ret false; }
        if (sel shape.relative)   { ret holds_integers(?shape.relative.offset, ex.relative); }
        ret false;
    }
    if (sel ex.enumerant) {
        if (sel shape.enumerant) { ret holds_members(?shape.enumerant, ex.enumerant); }
        ret false;
    }
    if (sel ex.condition) {
        if (sel shape.condition) { ret holds_members(?shape.condition, ex.condition); }
        ret false;
    }
    ret false;
}

# the defect of alias `a` of `syntax`, `before` the alias preceding it or nil
fun alias_defect(s: *S.Set, syntax: *spelling.Syntax, a: *spelling.Alias, before: *spelling.Alias) opt[str] {
    if (a.row >= s.codec.rows.len || (before != nil && before.row > a.row)) { ret opt[str].some{ALIAS_ROW}; }
    val base: *row.Row = ?s.codec.rows.at[a.row];
    if (a.sources.len != base.operands.len || a.count::u32 > row.MAX_OPERANDS) { ret opt[str].some{ALIAS_SOURCES}; }
    var j: u32 = 0;
    for (j < a.sources.len) {
        val src: spelling.Source = a.sources.at[j];
        var bad: bool            = false;
        if (sel src.operand)  { bad = src.operand >= a.count; }
        if (sel src.flipped)  { bad = src.flipped.operand >= a.count; }
        if (sel src.masked)   { bad = src.masked.operand >= a.count || (src.masked.value & ~src.masked.mask) != 0; }
        if (sel src.register) { bad = src.register >= register_count(s); }
        if (sel src.derived)  { bad = a.derive == nil; }
        if (sel src.value) {
            val v: operand.Value = src.value;
            bad = sel v.register || sel v.memory || sel v.list || sel v.symbol;
        }
        if (bad) { ret opt[str].some{ALIAS_SOURCE}; }
        j = j + 1;
    }
    if (a.derive != nil && a.derive.operands.len != a.count::u32) { ret opt[str].some{ALIAS_OPERAND}; }
    if (!required_in_catalog(s.extensions, a.requires))           { ret opt[str].some{UNKNOWN_EXTENSION}; }
    var descs: [row.MAX_OPERANDS]*operand.Operand;
    var k:     u8 = 0;
    for (k < a.count) {
        descs[k] = spelling.alias_operand(a, base, k);
        if (descs[k] == nil) { ret opt[str].some{ALIAS_OPERAND}; }
        k = k + 1;
    }
    var i: u32 = 0;
    for (i < a.exclusions.len) {
        val x: *spelling.Exclusion = ?a.exclusions.at[i];
        if (x.operand >= a.count || (i > 0 && a.exclusions.at[i - 1].operand >= x.operand) || !excludable(s, descs[x.operand], ?x.excluded)) { ret opt[str].some{ALIAS_EXCLUSION}; }
        i = i + 1;
    }
    if (a.preference != 0) {
        i = 0;
        for (?syntax.aliases.at[i] != a) {
            val other: *spelling.Alias = ?syntax.aliases.at[i];
            if (other.row == a.row && other.preference == a.preference) { ret opt[str].some{PREFERENCE}; }
            i = i + 1;
        }
    }
    ret template_defect(syntax, a.template, ?descs[0], a.count::u32, 0);
}

# the defect of specifier `spec` of `syntax`
fun specifier_defect(s: *S.Set, syntax: *spelling.Syntax, spec: *spelling.Specifier) opt[str] {
    if (spec.template == nil) { ret opt[str].some{SPECIFIER}; }
    var holes: u32   = 0;
    var first: bool  = false;
    var after: bool  = false;
    var at:    usize = 0;
    for {
        val p: spelling.Piece = spelling.piece(spec.template, at);
        at = p.at + p.len;
        if (p.kind == spelling.END) { brk; }
        if (p.kind == spelling.HOLE && p.operand == 0 && p.format.len == 0) {
            first = at == p.len;
            holes = holes + 1;
        }
        or (p.kind == spelling.TEXT) {
            if (holes > 0) { after = true; }
        }
        or {
            ret opt[str].some{SPECIFIER};
        }
    }
    if (holes != 1 || (first && !after) || (!first && spec.template[0] == 0)) { ret opt[str].some{SPECIFIER}; }
    if (spec.operand == operand.NO_FIXUP || spec.fixup == operand.NO_FIXUP)   { ret opt[str].some{SPECIFIER_KIND}; }
    if (!bound(s, spec.fixup))                                                { ret opt[str].some{UNBOUND_FIXUP}; }
    var i: u32 = 0;
    for (?syntax.specifiers.at[i] != spec) {
        val other: *spelling.Specifier = ?syntax.specifiers.at[i];
        if (other.operand == spec.operand && (other.fixup == spec.fixup || str_equals(other.template, spec.template))) { ret opt[str].some{SPECIFIER_TWICE}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

# the defect of the form of row `index` in `syntax`
fun form_defect(s: *S.Set, syntax: *spelling.Syntax, index: u32) opt[str] {
    val r:         *row.Row = ?s.codec.rows.at[index];
    var descs:     [row.MAX_OPERANDS]*operand.Operand;
    var unwritten: u32      = 0;
    var i:         u32      = 0;
    for (i < r.operands.len && i < row.MAX_OPERANDS) {
        descs[i] = ?r.operands.at[i];
        val at: opt[register.Id] = effect.fixed(s.codec.registers, r.effect, i::u8);
        if (sel at.some) { unwritten = unwritten | (1::u32 << i); }
        i = i + 1;
    }
    ret template_defect(syntax, syntax.forms.at[index], ?descs[0], r.operands.len, unwritten);
}

# the defect of candidate `c` indexed under `key`, `before` the candidate preceding it in its entry or nil
fun candidate_defect(s: *S.Set, syntax: *spelling.Syntax, key: View, c: spelling.Candidate, before: *spelling.Candidate) opt[str] {
    if (c.row >= s.codec.rows.len || c.alias > syntax.aliases.len)                           { ret opt[str].some{INDEX_KEY}; }
    if (c.alias > 0 && syntax.aliases.at[c.alias - 1].row != c.row)                          { ret opt[str].some{INDEX_KEY}; }
    if (spelling.compare(syntax, spelling.mnemonic(spelling.template(syntax, c)), key) != 0) { ret opt[str].some{INDEX_KEY}; }
    if (before != nil) {
        if (before.row == c.row && before.alias == c.alias)                        { ret opt[str].some{INDEX_TWICE}; }
        if (before.row > c.row || (before.row == c.row && before.alias > c.alias)) { ret opt[str].some{INDEX_ORDER}; }
    }
    ret opt[str].none{};
}

# the defect of entry `e` of `syntax`'s index, whose candidates start at `first` and whose preceding entry is `before` or nil
fun entry_defect(s: *S.Set, syntax: *spelling.Syntax, e: *spelling.Entry, first: u32, before: *spelling.Entry) opt[str] {
    val index: *spelling.Index = ?syntax.index;
    if (e.key == nil || e.key[0] == 0 || e.len == 0 || e.first != first || e.len > index.count - first) { ret opt[str].some{INDEX_ENTRY}; }
    val key: View = view(e.key, str_len(e.key));
    if (before != nil) {
        val order: i64 = spelling.compare(syntax, view(before.key, str_len(before.key)), key);
        if (order == 0) { ret opt[str].some{INDEX_TWICE}; }
        if (order > 0)  { ret opt[str].some{INDEX_ORDER}; }
    }
    var k: u32 = 0;
    for (k < e.len) {
        var prior: *spelling.Candidate = nil;
        if (k > 0) { prior = ?index.candidates[e.first + k - 1]; }
        val defect: opt[str] = candidate_defect(s, syntax, key, index.candidates[e.first + k], prior);
        if (sel defect.some) { ret defect; }
        k = k + 1;
    }
    ret opt[str].none{};
}

# the index of `syntax`, which holds each row and each alias once under its mnemonic, the keys and each entry's candidates in order
fun index_defect(s: *S.Set, syntax: *spelling.Syntax) err[Refusal] {
    val index: *spelling.Index = ?syntax.index;
    var i:     u32             = 0;
    for (i < syntax.forms.len) {
        if (spelling.mnemonic(syntax.forms.at[i]).len == 0) { ret refuse(s, NO_MNEMONIC, "form", i); }
        i = i + 1;
    }
    i = 0;
    for (i < syntax.aliases.len) {
        if (spelling.mnemonic(syntax.aliases.at[i].template).len == 0) { ret refuse(s, NO_MNEMONIC, "alias row", i); }
        i = i + 1;
    }
    var first: u32 = 0;
    i = 0;
    for (i < index.len) {
        var before: *spelling.Entry = nil;
        if (i > 0) { before = ?index.at[i - 1]; }
        val defect: opt[str] = entry_defect(s, syntax, ?index.at[i], first, before);
        if (sel defect.some) { ret refuse(s, defect.some, "index", i); }
        first = first + index.at[i].len;
        i     = i + 1;
    }
    if (first != index.count || index.count != syntax.forms.len + syntax.aliases.len) { ret refuse(s, INDEX_MISSING, "index", index.len); }
    ret fine();
}

# the index of `r` among the codec's rows, the row count when it is not one of them
fun row_at(s: *S.Set, r: *row.Row) u32 {
    if (r:~u64 < s.codec.rows.at:~u64) { ret s.codec.rows.len; }
    val at: u64 = (r:~u64 - s.codec.rows.at:~u64) / $size_of(row.Row)::u64;
    if (at >= s.codec.rows.len::u64) { ret s.codec.rows.len; }
    ret at::u32;
}

# the defect of sequence spelling `i` of `syntax`
fun sequence_defect(s: *S.Set, syntax: *spelling.Syntax, i: u32) opt[str] {
    val q: *spelling.Sequence = ?syntax.sequences.at[i];
    if (q.steps.len < 2 || q.steps.len > relax.MAX_STEPS || q.operands.len > row.MAX_OPERANDS) { ret opt[str].some{SEQUENCE}; }
    var taken: u32 = 0;
    var j:     u32 = 0;
    for (j < q.steps.len) {
        val step: *spelling.Step = ?q.steps.at[j];
        if (row_at(s, step.row) == s.codec.rows.len || step.parts.len != step.row.operands.len) { ret opt[str].some{SEQUENCE}; }
        var k: u32 = 0;
        for (k < step.parts.len) {
            val part: spelling.Part = step.parts.at[k];
            if (sel part.operand) {
                if (part.operand::u32 >= q.operands.len) { ret opt[str].some{SEQUENCE}; }
                taken = taken | (1::u32 << part.operand::u32);
            }
            if (sel part.symbol) {
                if (part.symbol.operand::u32 >= q.operands.len || part.symbol.fixup == operand.NO_FIXUP || !bound(s, part.symbol.fixup)) { ret opt[str].some{SEQUENCE}; }
                taken = taken | (1::u32 << part.symbol.operand::u32);
            }
            if (sel part.register) {
                if (s.codec.registers == nil) { ret opt[str].some{SEQUENCE}; }
                val held: opt[*register.Register] = register.row_of(s.codec.registers, part.register);
                if (sel held.none) { ret opt[str].some{SEQUENCE}; }
            }
            if (sel part.here) {
                if (part.here == operand.NO_FIXUP || !bound(s, part.here)) { ret opt[str].some{SEQUENCE}; }
                if (syntax.own == nil || syntax.own[0] == 0)               { ret opt[str].some{NO_OWN}; }
                if (str_len(syntax.own) > spelling.MAX_ANONYMOUS)          { ret opt[str].some{NO_OWN}; }
            }
            k = k + 1;
        }
        j = j + 1;
    }
    if (!required_in_catalog(s.extensions, q.requires)) { ret opt[str].some{UNKNOWN_EXTENSION}; }
    var state: mode.State = mode.initial(?s.assembly);
    j = 0;
    for (j < q.when.len) {
        if (!mode.change(?state, q.when.at[j])) { ret opt[str].some{SEQUENCE_MODE}; }
        var k: u32 = 0;
        for (k < j) {
            if (q.when.at[k].mode == q.when.at[j].mode) { ret opt[str].some{SEQUENCE_MODE}; }
            k = k + 1;
        }
        j = j + 1;
    }
    if (taken != (1::u32 << q.operands.len) - 1)                                                       { ret opt[str].some{SEQUENCE}; }
    if (i > 0 && row_at(s, syntax.sequences.at[i - 1].steps.at[0].row) > row_at(s, q.steps.at[0].row)) { ret opt[str].some{SEQUENCE}; }
    var descs: [row.MAX_OPERANDS]*operand.Operand;
    j = 0;
    for (j < q.operands.len) {
        descs[j] = ?q.operands.at[j];
        j        = j + 1;
    }
    ret template_defect(syntax, q.template, ?descs[0], q.operands.len, 0);
}

# whether the syntax's sequence spellings are indexed once each in ascending order of mnemonic
fun sequences_named(syntax: *spelling.Syntax) bool {
    val qs: *spelling.Sequences = ?syntax.sequences;
    var i:  u32                 = 0;
    for (i < qs.len) {
        if (qs.named[i] >= qs.len) { ret false; }
        var j: u32 = 0;
        for (j < i) {
            if (qs.named[j] == qs.named[i]) { ret false; }
            j = j + 1;
        }
        if (i > 0 && spelling.compare(syntax, spelling.mnemonic(qs.at[qs.named[i - 1]].template), spelling.mnemonic(qs.at[qs.named[i]].template)) > 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun syntaxes(s: *S.Set) err[Refusal] {
    if (s.syntaxes.len == 0) { ret refuse(s, NO_ASSEMBLY, "syntax", 0); }
    var n: u32 = 0;
    for (n < s.syntaxes.len) {
        val syntax: *spelling.Syntax = ?s.syntaxes.at[n];
        var m:      u32              = 0;
        for (m < n) {
            if (str_equals(s.syntaxes.at[m].name, syntax.name)) { ret refuse(s, SHARED_SYNTAX, "syntax", n); }
            m = m + 1;
        }
        if (syntax.forms.len != s.codec.rows.len)                                                                      { ret refuse(s, FORMS, "syntax", n); }
        if (syntax.anonymous == nil || syntax.anonymous[0] == 0 || str_len(syntax.anonymous) > spelling.MAX_ANONYMOUS) { ret refuse(s, NO_ANONYMOUS, "syntax", n); }
        var i: u32 = 0;
        for (i < syntax.forms.len) {
            val formed: opt[str] = form_defect(s, syntax, i);
            if (sel formed.some) { ret refuse(s, formed.some, "form", i); }
            i = i + 1;
        }
        i = 0;
        for (i < syntax.aliases.len) {
            var before: *spelling.Alias = nil;
            if (i > 0) { before = ?syntax.aliases.at[i - 1]; }
            val aliased: opt[str] = alias_defect(s, syntax, ?syntax.aliases.at[i], before);
            if (sel aliased.some) { ret refuse(s, aliased.some, "alias row", i); }
            i = i + 1;
        }
        val indexed: err[Refusal] = index_defect(s, syntax);
        if (sel indexed.err) { ret indexed; }
        i = 0;
        for (i < syntax.specifiers.len) {
            val specified: opt[str] = specifier_defect(s, syntax, ?syntax.specifiers.at[i]);
            if (sel specified.some) { ret refuse(s, specified.some, "specifier", i); }
            i = i + 1;
        }
        i = 0;
        for (i < syntax.sequences.len) {
            val sequenced: opt[str] = sequence_defect(s, syntax, i);
            if (sel sequenced.some) { ret refuse(s, sequenced.some, "sequence", i); }
            i = i + 1;
        }
        if (!sequences_named(syntax)) { ret refuse(s, SEQUENCE_INDEX, "sequence", 0); }
        n = n + 1;
    }
    ret fine();
}

# the set `s` checked against every invariant its tables carry
# ---
# ret: ok, or the first defect found
pub fun one(s: *S.Set) err[Refusal] {
    val checks: [12]fun(*S.Set) err[Refusal] = [12]fun(*S.Set) err[Refusal]{arches, registers, extensions, modes, assembly, bindings, rows, dispatch, relaxations, fill, syntaxes, source};
    var i:      u32                          = 0;
    for (i < 12) {
        val done: err[Refusal] = checks[i](s);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    ret fine();
}

# every set of `registry` checked, and no architecture served by two of them
pub fun every(registry: *S.Registry) err[Refusal] {
    var i: u32 = 0;
    for (i < registry.count) {
        val s:    *S.Set       = registry.sets[i];
        val done: err[Refusal] = one(s);
        if (sel done.err) { ret done; }
        var earlier: S.Registry = S.Registry{sets: registry.sets, count: i};
        var k:       u32        = 0;
        for (k < s.arches.len) {
            val other: opt[*S.Set] = S.find(?earlier, s.arches.at[k]);
            if (sel other.some) { ret refuse(s, SHARED_ARCH, "architecture", k); }
            k = k + 1;
        }
        i = i + 1;
    }
    ret fine();
}

# a minimal set for the tests below: one risc-v-like jump row over one register class
#[testing]
val T_CLASS_NAMES: [1]index.Entry = [1]index.Entry{index.Entry{key: "x", row: 0}};

#[testing]
val T_CLASSES: [1]register.Class = [1]register.Class{
    register.Class{name: "x", kind: register.GENERAL, width: register.Scaled{fixed: 64, per: 0, scale: 0}, count: 32},
};

#[testing]
val T_REGISTERS: [1]register.Register = [1]register.Register{
    register.Register{name: "x0", class: 0, number: 0, bank: 0, offset: register.Scaled{fixed: 0, per: 0, scale: 0}, stride: register.Scaled{fixed: 0, per: 0, scale: 0}, count: register.Scaled{fixed: 1, per: 0, scale: 0}, flags: register.ZERO, requires: requirement.NONE},
};

#[testing]
val T_REGISTER_NAMES: [1]index.Entry = [1]index.Entry{index.Entry{key: "x0", row: 0}};

#[testing]
val T_FILE: register.File = register.File{
    scales:         nil,
    scale_count:    0,
    classes:        ?T_CLASSES[0],
    class_count:    1,
    class_names:    index.Index{at: ?T_CLASS_NAMES[0], len: 1},
    registers:      ?T_REGISTERS[0],
    register_count: 1,
    aliases:        nil,
    alias_count:    0,
    names:          index.Index{at: ?T_REGISTER_NAMES[0], len: 1},
    columns:        nil,
    column_count:   0,
};

#[testing]
val T_GPR: [1]u16 = [1]u16{0};

#[testing]
val T_OPERANDS: [2]operand.Operand = [2]operand.Operand{
    operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?T_GPR[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}}, role: operand.WRITE, width: 64, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.relative{operand.Relative{offset: operand.Immediate{bits: 21, signed: true, scale: 1, bias: 0, fixup: 1, format: operand.INTEGER, excluded: operand.NO_INTEGERS}, anchor: operand.START}}, role: operand.NONE, width: 0, quantity: operand.ONE},
};

#[testing]
val T_SLICES: [2]field.Slice = [2]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 5, at: 7, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 1, len: 20, at: 12, invert: false},
};

#[testing]
val T_FIELDS: [1]field.Field = [1]field.Field{
    field.Field{kind: 0, width: 32, fixed: 0x6F, mask: 0x7F, slices: field.Slices{at: ?T_SLICES[0], len: 2}, operand: field.NO_OPERAND, param: 0},
};

#[testing]
val T_EFFECT: effect.Effect = effect.Effect{
    implicit: effect.Registers{otherwise: effect.NO_TOUCHED, rules: effect.NO_REGISTER_RULES, may: effect.NO_TOUCHED, must: effect.NO_TOUCHED},
    flags:    effect.Flags{read: effect.Set{words: nil, len: 0}, written: effect.Set{words: nil, len: 0}, undefined: effect.Set{words: nil, len: 0}, kept: effect.Set{words: nil, len: 0}},
    memory:   effect.NO_ACCESSES,
    control:  effect.Control{transfer: effect.JUMP, target: effect.DIRECT, conditional: false, operand: 1, rules: effect.NO_RULES},
    stack:    effect.Stack.none{},
    latency:  effect.ONE,
    fixed:    effect.NO_FIXEDS,
};

#[testing]
val T_ROWS: [1]row.Row = [1]row.Row{
    row.Row{key: "jal", mnemonic: "jal", operands: row.Operands{at: ?T_OPERANDS[0], len: 2}, encoding: field.Fields{at: ?T_FIELDS[0], len: 1}, requires: requirement.NONE, effect: ?T_EFFECT, ct: ?ct.INDEPENDENT, constraints: constraint.NO_CONSTRAINTS, flags: 0},
};

#[testing]
val T_ROW_KEYS: [1]index.Entry = [1]index.Entry{index.Entry{key: "jal", row: 0}};

#[testing]
val T_KINDS: [1]*field.Kind = [1]*field.Kind{?field.UNIT};

#[testing]
val T_TABLE: field.Table = field.Table{kinds: ?T_KINDS[0], count: 1, order: field.LITTLE};

#[testing]
fun t_opcode(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val word: res[u64, field.Refusal] = field.read(s, at, 4);
    if (sel word.err) { ret word; }
    ret res[u64, field.Refusal].ok{word.ok & 0x7F};
}

#[testing]
val T_KEYS: [1]walk.Key = [1]walk.Key{walk.Key{name: "opcode", extract: t_opcode}};

#[testing]
val T_NODES: [1]walk.Node = [1]walk.Node{walk.Node{key: 0, first: 0, count: 1}};

#[testing]
val T_ENTRIES: [1]walk.Entry = [1]walk.Entry{walk.Entry{value: 0x6F, node: 0, first: 0, count: 1}};

#[testing]
val T_CANDIDATES: [1]u32 = [1]u32{0};

#[testing]
val T_DISPATCH: walk.Dispatch = walk.Dispatch{keys: ?T_KEYS[0], key_count: 1, nodes: ?T_NODES[0], node_count: 1, entries: ?T_ENTRIES[0], entry_count: 1, candidates: ?T_CANDIDATES[0], candidate_count: 1};

#[testing]
val T_CODEC: walk.Codec = walk.Codec{fields: ?T_TABLE, registers: ?T_FILE, rows: row.Rows{at: ?T_ROWS[0], len: 1}, keys: index.Index{at: ?T_ROW_KEYS[0], len: 1}, dispatch: ?T_DISPATCH};

#[testing]
val T_EXTENSIONS: [1]extension.Extension = [1]extension.Extension{
    extension.Extension{name: "i", implies: requirement.NO_IDS, revision: "2.1"},
};

#[testing]
val T_EXTENSION_NAMES: [1]index.Entry = [1]index.Entry{index.Entry{key: "i", row: 0}};

#[testing]
val T_CATALOG: extension.Catalog = extension.Catalog{extensions: ?T_EXTENSIONS[0], count: 1, levels: nil, level_count: 0, names: index.Index{at: ?T_EXTENSION_NAMES[0], len: 1}, conflicts: nil, conflict_count: 0, combinations: nil, combination_count: 0, syntax: ?extension.LIST};

#[testing]
val T_BINDINGS: [1]S.Binding = [1]S.Binding{S.Binding{fixup: 1, kind: ?mink.reloc.JAL20}};

#[testing]
val T_ARCHES: [1]*mink.arch.Arch = [1]*mink.arch.Arch{?mink.arch.RISCV64};

#[testing]
val T_MODES: [1]S.Mode = [1]S.Mode{S.Mode{arch: ?mink.arch.RISCV64, extension: 0}};

#[testing]
val T_SET: S.Set = S.Set{
    arches:     S.Arches{at: ?T_ARCHES[0], len: 1},
    modes:      S.Modes{at: ?T_MODES[0], len: 1},
    codec:      ?T_CODEC,
    extensions: ?T_CATALOG,
    bindings:   S.Bindings{at: ?T_BINDINGS[0], len: 1},
    relax:      relax.NONE,
    compress:   compress.NONE,
    fill:       nil,
    realign:    operand.NO_FIXUP,
    data:       S.NO_DATA,
    spans:      S.NO_SPANS,
    syntaxes:   spelling.NO_SYNTAXES,
    supplied:   S.NO_AXES,
    derived:    S.NO_DERIVATIONS,
};

# whether `checked` is the refusal of `message` at row `index` of `table`
#[testing]
fun t_refused(checked: err[Refusal], message: str, table: str, index: u32) bool {
    ret sel checked.err && (checked.err.message == message && str_equals(checked.err.table, table) && checked.err.index == index);
}

# the test set with its one row replaced by `r`, held in `rows`, `codec` and `s`
#[testing]
fun t_with_row(r: row.Row, rows: *row.Row, codec: *walk.Codec, s: *S.Set) {
    @rows      = r;
    @codec     = T_CODEC;
    codec.rows = row.Rows{at: rows, len: 1};
    @s         = T_SET;
    s.codec    = codec;
}

test one__a_row_naming_an_unknown_register_class_is_refused {
    val classes:  [1]u16             = [1]u16{1};
    var operands: [2]operand.Operand = T_OPERANDS;
    operands[0].shape = operand.Shape.register{operand.Register{classes: operand.Classes{at: ?classes[0], len: 1}, first: 0, count: 0, excluded: operand.NO_NUMBERS, fields: 1, element: operand.Element.none{}, span: operand.Span.fixed{0}}};
    var r: row.Row = T_ROWS[0];
    r.operands = row.Operands{at: ?operands[0], len: 2};
    var rows:  row.Row;
    var codec: walk.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), UNKNOWN_CLASS, "row", 0)) { ret 1; }
    ret 0;
}

test one__an_unsorted_enumeration_name_index_is_refused {
    val members:  [2]operand.Enumerant = [2]operand.Enumerant{operand.Enumerant{name: "", value: 0}, operand.Enumerant{name: ".aq", value: 1}};
    val unsorted: [2]index.Entry       = [2]index.Entry{index.Entry{key: ".aq", row: 1}, index.Entry{key: "", row: 0}};
    var operands: [2]operand.Operand   = T_OPERANDS;
    operands[0].shape = operand.Shape.enumerant{operand.Enumeration{members: ?members[0], count: 2, mask: false, names: index.Index{at: ?unsorted[0], len: 2}}};
    var r: row.Row = T_ROWS[0];
    r.operands = row.Operands{at: ?operands[0], len: 2};
    var rows:  row.Row;
    var codec: walk.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), NAME_ORDER, "row", 0)) { ret 1; }
    ret 0;
}

test one__a_second_entry_under_the_empty_name_is_refused {
    val members:  [2]operand.Enumerant = [2]operand.Enumerant{operand.Enumerant{name: "", value: 0}, operand.Enumerant{name: "", value: 1}};
    val twice:    [2]index.Entry       = [2]index.Entry{index.Entry{key: "", row: 0}, index.Entry{key: "", row: 1}};
    var operands: [2]operand.Operand   = T_OPERANDS;
    operands[0].shape = operand.Shape.enumerant{operand.Enumeration{members: ?members[0], count: 2, mask: false, names: index.Index{at: ?twice[0], len: 2}}};
    var r: row.Row = T_ROWS[0];
    r.operands = row.Operands{at: ?operands[0], len: 2};
    var rows:  row.Row;
    var codec: walk.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), SHARED_NAME, "row", 0)) { ret 1; }
    ret 0;
}

test one__a_named_member_under_the_empty_key_is_refused {
    val members:  [2]operand.Enumerant = [2]operand.Enumerant{operand.Enumerant{name: ".aq", value: 0}, operand.Enumerant{name: ".rl", value: 1}};
    val blanked:  [2]index.Entry       = [2]index.Entry{index.Entry{key: "", row: 0}, index.Entry{key: ".rl", row: 1}};
    var operands: [2]operand.Operand   = T_OPERANDS;
    operands[0].shape = operand.Shape.enumerant{operand.Enumeration{members: ?members[0], count: 2, mask: false, names: index.Index{at: ?blanked[0], len: 2}}};
    var r: row.Row = T_ROWS[0];
    r.operands = row.Operands{at: ?operands[0], len: 2};
    var rows:  row.Row;
    var codec: walk.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), NAME_ENTRY, "row", 0)) { ret 1; }
    ret 0;
}

test one__a_row_requiring_an_unknown_extension_is_refused {
    val ids:  [1]requirement.Id  = [1]requirement.Id{1};
    val alts: [2]requirement.Ids = [2]requirement.Ids{requirement.NO_IDS, requirement.Ids{at: ?ids[0], len: 1}};
    var r:    row.Row            = T_ROWS[0];
    r.requires = requirement.Requirement{at: ?alts[0], len: 2};
    var rows:  row.Row;
    var codec: walk.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), UNKNOWN_EXTENSION, "row", 0)) { ret 1; }
    ret 0;
}

test one__a_fixup_kind_with_no_mink_mapping_is_refused {
    var s: S.Set = T_SET;
    s.bindings = S.NO_BINDINGS;
    if (!t_refused(one(?s), UNBOUND_FIXUP, "row", 0)) { ret 1; }
    ret 0;
}

test one__an_architecture_with_no_mode_is_refused {
    var s: S.Set = T_SET;
    s.modes = S.Modes{at: nil, len: 0};
    if (!t_refused(one(?s), NO_MODE, "architecture", 0)) { ret 1; }
    ret 0;
}

test one__an_architecture_mink_does_not_know_is_refused {
    val foreign: mink.arch.Arch     = mink.arch.Arch{name: "riscv64", pointer_bytes: 8, page_size: 0x1000, caps: mink.arch.ADDRESSED};
    val arches:  [1]*mink.arch.Arch = [1]*mink.arch.Arch{?foreign};
    var s:       S.Set              = T_SET;
    s.arches = S.Arches{at: ?arches[0], len: 1};
    if (!t_refused(one(?s), UNKNOWN_ARCH, "architecture", 0)) { ret 1; }
    ret 0;
}

# the test row with its control holding `rules` of the terms given
#[testing]
fun t_with_rules(rules: *effect.Rule, count: u32, e: *effect.Effect, rows: *row.Row, codec: *walk.Codec, s: *S.Set) {
    @e              = T_EFFECT;
    e.control.rules = effect.Rules{at: rules, len: count};
    var r: row.Row = T_ROWS[0];
    r.effect = e;
    t_with_row(r, rows, codec, s);
}

test one__effect_rules_that_can_both_hold_or_test_what_the_row_lacks_are_refused {
    val zero:  [1]u64         = [1]u64{0x1};
    val wide:  [1]u64         = [1]u64{0x20};
    val set:   effect.Test    = effect.Test.register{effect.Set{words: ?zero[0], len: 1}};
    val tests: [4]effect.Term = [4]effect.Term{
        effect.Term{operand: 0, test: set},
        effect.Term{operand: 0, test: effect.Test.register{effect.Set{words: ?wide[0], len: 1}}},
        effect.Term{operand: 2, test: set},
        effect.Term{operand: 1, test: effect.Test.immediate{1}},
    };
    var rules: [2]effect.Rule = [2]effect.Rule{
        effect.Rule{terms: effect.Terms{at: ?tests[0], len: 1}, transfer: effect.CALL, target: effect.DIRECT, conditional: false},
        effect.Rule{terms: effect.Terms{at: ?tests[0], len: 1}, transfer: effect.RETURN, target: effect.UNTARGETED, conditional: false},
    };
    var e:     effect.Effect;
    var rows:  row.Row;
    var codec: walk.Codec;
    var s:     S.Set;
    # two rules testing the same registers of one operand overlap, in either order
    t_with_rules(?rules[0], 2, ?e, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), RULE_OVERLAP, "row", 0)) { ret 1; }
    # a register set reaching past the file
    rules[1].terms = effect.Terms{at: ?tests[1], len: 1};
    t_with_rules(?rules[0], 2, ?e, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), EFFECT_ROW, "row", 0)) { ret 2; }
    # a rule with no terms always holds
    rules[1].terms = effect.NO_TERMS;
    t_with_rules(?rules[0], 2, ?e, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), RULE_TERMS, "row", 0)) { ret 3; }
    # an operand the row lacks, a kind the operand is not
    rules[1].terms = effect.Terms{at: ?tests[2], len: 1};
    t_with_rules(?rules[0], 2, ?e, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), RULE_OPERAND, "row", 0)) { ret 4; }
    rules[1].terms = effect.Terms{at: ?tests[3], len: 1};
    t_with_rules(?rules[0], 2, ?e, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), RULE_OPERAND, "row", 0)) { ret 5; }
    # register rules take the same checks as control rules
    val dyn:      [1]effect.Term         = [1]effect.Term{effect.Term{operand: 0, test: effect.Test.enumerant{7}}};
    var switches: [2]effect.RegisterRule = [2]effect.RegisterRule{
        effect.RegisterRule{terms: effect.Terms{at: ?tests[0], len: 1}, touched: effect.Touched{read: effect.Set{words: ?zero[0], len: 1}, written: effect.Set{words: nil, len: 0}}},
        effect.RegisterRule{terms: effect.Terms{at: ?tests[0], len: 1}, touched: effect.NO_TOUCHED},
    };
    t_with_rules(nil, 0, ?e, ?rows, ?codec, ?s);
    e.implicit.rules = effect.RegisterRules{at: ?switches[0], len: 2};
    if (!t_refused(one(?s), RULE_OVERLAP, "row", 0)) { ret 6; }
    # the rule reads a row the effect's may set lacks, then holds it
    e.implicit.rules = effect.RegisterRules{at: ?switches[0], len: 1};
    if (!t_refused(one(?s), RULE_BOUNDS, "row", 0)) { ret 7; }
    e.implicit.may.read = effect.Set{words: ?zero[0], len: 1};
    val alone: opt[str] = effects(?s, ?rows);
    if (sel alone.some) { ret 10; }
    # a must set holding the row the rule reads and the effect's own sets lack
    e.implicit.must.read = effect.Set{words: ?zero[0], len: 1};
    if (!t_refused(one(?s), RULE_BOUNDS, "row", 0)) { ret 11; }
    e.implicit.must.read     = effect.Set{words: nil, len: 0};
    switches[0].touched.read = effect.Set{words: ?wide[0], len: 1};
    if (!t_refused(one(?s), EFFECT_ROW, "row", 0)) { ret 8; }
    # an enumerant test of a register operand
    switches[0].terms        = effect.Terms{at: ?dyn[0], len: 1};
    switches[0].touched.read = effect.Set{words: nil, len: 0};
    if (!t_refused(one(?s), RULE_OPERAND, "row", 0)) { ret 9; }
    ret 0;
}

test one__a_condition_test_of_an_enumerant_operand_and_an_id_test_of_a_register_operand_are_refused {
    val members:  [2]operand.Enumerant = [2]operand.Enumerant{operand.Enumerant{name: "", value: 0}, operand.Enumerant{name: ".aq", value: 1}};
    val names:    [2]index.Entry       = [2]index.Entry{index.Entry{key: "", row: 0}, index.Entry{key: ".aq", row: 1}};
    var operands: [2]operand.Operand   = T_OPERANDS;
    operands[1].shape = operand.Shape.enumerant{operand.Enumeration{members: ?members[0], count: 2, mask: false, names: index.Index{at: ?names[0], len: 2}}};
    val tests: [2]effect.Term = [2]effect.Term{
        effect.Term{operand: 1, test: effect.Test.condition{0}},
        effect.Term{operand: 0, test: effect.Test.id{0}},
    };
    var rules: [1]effect.Rule = [1]effect.Rule{
        effect.Rule{terms: effect.Terms{at: ?tests[0], len: 1}, transfer: effect.CALL, target: effect.UNTARGETED, conditional: false},
    };
    var e:     effect.Effect;
    var rows:  row.Row;
    var codec: walk.Codec;
    var s:     S.Set;
    var r:     row.Row = T_ROWS[0];
    r.operands      = row.Operands{at: ?operands[0], len: 2};
    e               = T_EFFECT;
    e.control.rules = effect.Rules{at: ?rules[0], len: 1};
    r.effect        = ?e;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), RULE_OPERAND, "row", 0)) { ret 1; }
    rules[0].terms = effect.Terms{at: ?tests[1], len: 1};
    if (!t_refused(one(?s), RULE_OPERAND, "row", 0)) { ret 2; }
    ret 0;
}

test one__a_register_constraint_on_an_operand_the_row_lacks_is_refused {
    val sides: [1]constraint.Side       = [1]constraint.Side{constraint.Side{operand: 0, part: constraint.WHOLE}};
    var kept:  [1]constraint.Constraint = [1]constraint.Constraint{
        constraint.Constraint{side: constraint.Side{operand: 2, part: constraint.WHOLE}, against: constraint.Against.sides{constraint.Sides{at: ?sides[0], len: 1}}, permit: constraint.DISJOINT, when: effect.NO_TERMS},
    };
    var r: row.Row = T_ROWS[0];
    r.constraints = constraint.Constraints{at: ?kept[0], len: 1};
    var rows:  row.Row;
    var codec: walk.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), KEPT_OPERAND, "row", 0)) { ret 1; }
    # the relative target holds no register to keep apart
    kept[0].side.operand = 1;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), KEPT_OPERAND, "row", 0)) { ret 2; }
    ret 0;
}

test one__a_row_key_given_to_two_rows_is_refused_naming_both {
    var rows:  [2]row.Row     = [2]row.Row{T_ROWS[0], T_ROWS[0]};
    val keys:  [2]index.Entry = [2]index.Entry{index.Entry{key: "jal", row: 0}, index.Entry{key: "jal", row: 1}};
    var codec: walk.Codec     = T_CODEC;
    var s:     S.Set          = T_SET;
    codec.rows = row.Rows{at: ?rows[0], len: 2};
    codec.keys = index.Index{at: ?keys[0], len: 2};
    s.codec    = ?codec;
    val checked: err[Refusal] = one(?s);
    if (!t_refused(checked, SHARED_KEY, "row", 0))    { ret 1; }
    if (!(sel checked.err && checked.err.other == 1)) { ret 2; }
    ret 0;
}

test one__a_class_name_given_to_two_classes_is_refused_naming_both {
    val classes: [2]register.Class = [2]register.Class{T_CLASSES[0], T_CLASSES[0]};
    val names:   [2]index.Entry    = [2]index.Entry{index.Entry{key: "x", row: 0}, index.Entry{key: "x", row: 1}};
    var file:    register.File     = T_FILE;
    var codec:   walk.Codec        = T_CODEC;
    var s:       S.Set             = T_SET;
    file.classes     = ?classes[0];
    file.class_count = 2;
    file.class_names = index.Index{at: ?names[0], len: 2};
    codec.registers  = ?file;
    s.codec          = ?codec;
    val checked: err[Refusal] = one(?s);
    if (!t_refused(checked, SHARED_CLASS, "class", 0)) { ret 1; }
    if (!(sel checked.err && checked.err.other == 1))  { ret 2; }
    ret 0;
}

test one__an_identity_given_to_two_registers_or_out_of_order_is_refused {
    var regs:  [2]register.Register = [2]register.Register{T_REGISTERS[0], T_REGISTERS[0]};
    var file:  register.File        = T_FILE;
    var codec: walk.Codec           = T_CODEC;
    var s:     S.Set                = T_SET;
    val names: [2]index.Entry       = [2]index.Entry{index.Entry{key: "x0", row: 0}, index.Entry{key: "x1", row: 1}};
    regs[1].name        = "x1";
    file.registers      = ?regs[0];
    file.register_count = 2;
    file.names          = index.Index{at: ?names[0], len: 2};
    codec.registers     = ?file;
    s.codec             = ?codec;
    val identity: err[Refusal] = one(?s);
    if (!t_refused(identity, SHARED_ID, "register", 0)) { ret 1; }
    if (!(sel identity.err && identity.err.other == 1)) { ret 2; }
    regs[0].number = 1;
    if (!t_refused(one(?s), REGISTER_ORDER, "register", 1)) { ret 3; }
    ret 0;
}

test one__a_spelling_given_to_two_registers_or_a_name_index_out_of_order_or_short_is_refused {
    var regs:  [2]register.Register = [2]register.Register{T_REGISTERS[0], T_REGISTERS[0]};
    val dup:   [2]index.Entry       = [2]index.Entry{index.Entry{key: "x0", row: 0}, index.Entry{key: "x0", row: 1}};
    val order: [2]index.Entry       = [2]index.Entry{index.Entry{key: "x0", row: 0}, index.Entry{key: "a", row: 1}};
    var file:  register.File        = T_FILE;
    var codec: walk.Codec           = T_CODEC;
    var s:     S.Set                = T_SET;
    regs[1].number      = 1;
    file.registers      = ?regs[0];
    file.register_count = 2;
    file.names          = index.Index{at: ?dup[0], len: 2};
    codec.registers     = ?file;
    s.codec             = ?codec;
    val spelling: err[Refusal] = one(?s);
    if (!t_refused(spelling, SHARED_NAME, "register name", 0)) { ret 1; }
    if (!(sel spelling.err && spelling.err.other == 1))        { ret 2; }
    regs[1].name = "a";
    file.names   = index.Index{at: ?order[0], len: 2};
    if (!t_refused(one(?s), NAME_ORDER, "register name", 1)) { ret 3; }
    file.names = index.Index{at: ?T_REGISTER_NAMES[0], len: 1};
    if (!t_refused(one(?s), NAME_MISSING, "register name", 2)) { ret 4; }
    ret 0;
}

test one__a_number_index_that_disagrees_with_its_column_is_refused {
    val numbers: [2]u32               = [2]u32{5, 5};
    val dup:     [2]index.Number      = [2]index.Number{index.Number{key: 5, row: 0}, index.Number{key: 5, row: 1}};
    val one_row: [1]index.Number      = [1]index.Number{index.Number{key: 5, row: 0}};
    var regs:    [2]register.Register = [2]register.Register{T_REGISTERS[0], T_REGISTERS[0]};
    var names:   [2]index.Entry       = [2]index.Entry{index.Entry{key: "x0", row: 0}, index.Entry{key: "x1", row: 1}};
    var col:     [1]register.Column   = [1]register.Column{register.Column{format: register.DWARF, numbers: ?numbers[0], len: 2, numbered: index.Numbers{at: ?dup[0], len: 2}}};
    var file:    register.File        = T_FILE;
    var codec:   walk.Codec           = T_CODEC;
    var s:       S.Set                = T_SET;
    regs[1].name        = "x1";
    regs[1].number      = 1;
    file.registers      = ?regs[0];
    file.register_count = 2;
    file.names          = index.Index{at: ?names[0], len: 2};
    file.columns        = ?col[0];
    file.column_count   = 1;
    codec.registers     = ?file;
    s.codec             = ?codec;
    val shared: err[Refusal] = one(?s);
    if (!t_refused(shared, SHARED_NUMBER, "column", 0)) { ret 1; }
    if (!(sel shared.err && shared.err.other == 1))     { ret 2; }
    col[0].numbered = index.Numbers{at: ?one_row[0], len: 1};
    if (!t_refused(one(?s), NAME_MISSING, "column", 0)) { ret 3; }
    ret 0;
}

test alias_defect__an_exclusion_its_operand_cannot_hold_is_refused {
    val held:    [1]u32                = [1]u32{5};
    val outside: [1]u32                = [1]u32{40};
    val values:  [1]i64                = [1]i64{0};
    val sources: [2]spelling.Source    = [2]spelling.Source{spelling.Source.operand{0}, spelling.Source.value{operand.Value.relative{0}}};
    var ex:      [1]spelling.Exclusion = [1]spelling.Exclusion{spelling.Exclusion{operand: 0, excluded: spelling.Excluded.register{operand.Numbers{at: ?held[0], len: 1}}}};
    val syntax:  spelling.Syntax       = spelling.Syntax{
        name:       "t",
        forms:      spelling.NO_FORMS,
        aliases:    spelling.NO_ALIASES,
        index:      spelling.NO_INDEX,
        specifiers: spelling.NO_SPECIFIERS,
        sequences:  spelling.NO_SEQUENCES,
        hooks:      spelling.Hooks{immediate: nil, memory: nil, list: nil, id: nil, literal: nil},
        register:   "",
        aliased:    false,
        join:       "",
        variadic:   "",
        fold:       false,
        anonymous:  ".",
    };
    var a:    spelling.Alias = spelling.Alias{row: 0, template: "j <0>", count: 1, sources: spelling.Sources{at: ?sources[0], len: 2}, derive: nil, exclusions: spelling.Exclusions{at: ?ex[0], len: 1}, requires: requirement.NONE, preference: 0};
    var s:    S.Set          = T_SET;
    val fine: opt[str]       = alias_defect(?s, ?syntax, ?a, nil);
    if (sel fine.some) { ret 1; }
    ex[0].excluded = spelling.Excluded.register{operand.Numbers{at: ?outside[0], len: 1}};
    val past: opt[str] = alias_defect(?s, ?syntax, ?a, nil);
    if (!(sel past.some && past.some == ALIAS_EXCLUSION)) { ret 2; }
    ex[0].excluded = spelling.Excluded.immediate{operand.Integers{at: ?values[0], len: 1}};
    val shaped: opt[str] = alias_defect(?s, ?syntax, ?a, nil);
    if (!(sel shaped.some && shaped.some == ALIAS_EXCLUSION)) { ret 3; }
    ret 0;
}

#[testing]
val T_ENUMERANTS: [3]operand.Enumerant = [3]operand.Enumerant{operand.Enumerant{name: "eq", value: 0}, operand.Enumerant{name: "al", value: 14}, operand.Enumerant{name: "nv", value: 15}};

#[testing]
val T_VALUES: [2]u32 = [2]u32{14, 15};

#[testing]
val T_OUTSIDE: [2]u32 = [2]u32{14, 3};

test excludable__each_shape_holds_the_values_its_operand_admits_and_refuses_the_rest {
    val e:    operand.Enumeration = operand.Enumeration{members: ?T_ENUMERANTS[0], count: 3, mask: false, names: index.Index{at: nil, len: 0}};
    val near: [1]i64              = [1]i64{4};
    val far:  [1]i64              = [1]i64{2};
    val rel:  operand.Immediate   = operand.Immediate{bits: 8, signed: true, scale: 1, bias: 0, fixup: 0, format: operand.INTEGER, excluded: operand.Integers{at: ?far[0], len: 1}};
    val cond: operand.Operand     = operand.Operand{shape: operand.Shape.condition{e}, role: operand.NONE, width: 0, quantity: operand.ONE};
    val en:   operand.Operand     = operand.Operand{shape: operand.Shape.enumerant{e}, role: operand.NONE, width: 0, quantity: operand.ONE};
    val rl:   operand.Operand     = operand.Operand{shape: operand.Shape.relative{operand.Relative{offset: rel, anchor: operand.START}}, role: operand.NONE, width: 0, quantity: operand.ONE};
    var ex:   spelling.Excluded   = spelling.Excluded.condition{operand.Numbers{at: ?T_VALUES[0], len: 2}};
    var s:    S.Set               = T_SET;
    if (!excludable(?s, ?cond, ?ex)) { ret 1; }
    if (excludable(?s, ?en, ?ex))    { ret 2; }
    ex = spelling.Excluded.condition{operand.Numbers{at: ?T_OUTSIDE[0], len: 2}};
    if (excludable(?s, ?cond, ?ex)) { ret 3; }
    ex = spelling.Excluded.condition{operand.NO_NUMBERS};
    if (excludable(?s, ?cond, ?ex)) { ret 4; }
    ex = spelling.Excluded.enumerant{operand.Numbers{at: ?T_VALUES[0], len: 2}};
    if (!excludable(?s, ?en, ?ex)) { ret 5; }
    ex = spelling.Excluded.relative{operand.Integers{at: ?near[0], len: 1}};
    if (!excludable(?s, ?rl, ?ex)) { ret 6; }
    ex = spelling.Excluded.relative{operand.Integers{at: ?far[0], len: 1}};
    if (excludable(?s, ?rl, ?ex)) { ret 7; }
    ex = spelling.Excluded.immediate{operand.Integers{at: ?near[0], len: 1}};
    if (excludable(?s, ?rl, ?ex)) { ret 8; }
    ret 0;
}
