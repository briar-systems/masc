# the one check of a registered instruction set
#
# every table a set registers is checked here, once, against the invariants
# the walks, the selection and the builder assume, so no reader checks them
# again. a defect is one refusal naming the set, the table and the row.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink;

use masc.core.ct;
use masc.core.effect;
use masc.core.extension;
use masc.core.field;
use masc.core.operand;
use masc.core.register;
use masc.core.relax;
use masc.core.row;
use S: masc.core.set;
use masc.core.walk;

# why a set was refused
# ---
# set:     the set refused
# message: the diagnostic, one of the wordings below
# table:   the table the defect is in
# index:   the defective row of that table
pub rec Refusal {
    set:     *S.Set;
    message: str;
    table:   str;
    index:   u32;
}

pub val NO_ARCH:           str = "set serves no architecture";
pub val UNKNOWN_ARCH:      str = "architecture not in mink's catalog";
pub val SHARED_ARCH:       str = "architecture served twice";
pub val UNKNOWN_SCALE:     str = "scale not in the register file";
pub val FIXING_EXTENSION:  str = "scale fixed by an extension not in the catalog";
pub val FIXING_MULTIPLIER: str = "scale fixed at a multiplier that is not a power of two within its max";
pub val FIXING_CONFLICT:   str = "scale fixed at two multipliers by extensions that do not conflict";
pub val MIXED_SCALES:      str = "register and its class width scale with different scales";
pub val REGISTER_CLASS:    str = "register's class not in the register file";
pub val REGISTER_NUMBER:   str = "register number outside its class's count";
pub val SHARED_ID:         str = "two registers share one identity";
pub val SHARED_NAME:       str = "name spelled twice";
pub val ALIAS_TARGET:      str = "alias names no register";
pub val COLUMN_LENGTH:     str = "debug column length differs from the register count";
pub val SHARED_COLUMN:     str = "two debug columns for one format";
pub val SHARED_NUMBER:     str = "debug number given to two registers";
pub val IMPLIED:           str = "implied extension not in the catalog";
pub val LEVEL_MEMBER:      str = "level member not in the catalog";
pub val CONFLICT:          str = "conflict names an extension not in the catalog or one twice";
pub val CONFLICT_TWICE:    str = "conflict stated twice";
pub val NO_SYNTAX:         str = "catalog has no selection syntax";
pub val OPERANDS:          str = "row has more operands than a row holds";
pub val FIELDS:            str = "row has more fields than a row holds";
pub val UNKNOWN_KIND:      str = "field kind not in the field table";
pub val UNIT_WIDTH:        str = "unit width not a multiple of 8 up to 64";
pub val FIELD_OPERAND:     str = "field names an operand the row does not have";
pub val SLICE:             str = "slice outside its operand, part or unit";
pub val UNCOVERED:         str = "slices leave bits of an operand unencoded";
pub val UNKNOWN_CLASS:     str = "operand names a register class not in the register file";
pub val REGISTER_RANGE:    str = "operand's register range reaches past one of its classes";
pub val EXCLUDED_RANGE:    str = "operand excludes a value it never admits";
pub val UNKNOWN_EXTENSION: str = "requires an extension not in the catalog";
pub val NO_EFFECT:         str = "row has no effect or no constant-time class";
pub val EFFECT_ROW:        str = "effect names a register row not in the register file";
pub val FLAG_ROW:          str = "flag set holds a register outside a flags class";
pub val EFFECT_OPERAND:    str = "effect names an operand the row does not have";
pub val ACCESS_FORM:       str = "access through a memory operand states its own width or role, or another access states no role";
pub val FIXED_OPERAND:     str = "fixed operand is not a register operand";
pub val FIXED_CLASS:       str = "fixed register outside its operand's classes or range";
pub val NO_INPUT:          str = "dependent class names no input";
pub val CONDITION:         str = "constant-time condition not in the catalog";
pub val UNBOUND_FIXUP:     str = "fixup kind with no mink relocation kind";
pub val NO_FIXUP:          str = "binding names no fixup kind";
pub val BOUND_TWICE:       str = "fixup kind bound twice";
pub val UNKNOWN_RELOC:     str = "relocation kind not in mink's catalog";
pub val NO_ROOT:           str = "dispatch has no root node";
pub val NODE:              str = "node's key or entries out of range";
pub val UNSORTED:          str = "node's entries not strictly sorted";
pub val ENTRY:             str = "entry's child node or candidates out of range";
pub val CANDIDATE:         str = "candidate names no row or an alias row";
pub val RELAX_ROW:         str = "relaxation names no row";
pub val RELAX_OPERAND:     str = "relaxed operand is not a relative operand of its row";
pub val RELAX_FORM:        str = "longer form is empty or a step's sources do not match its row";
pub val RELAX_SOURCE:      str = "source names an operand or register that is not there";
pub val RELAX_TARGET:      str = "longer form does not take the target exactly once";
pub val RELAX_CYCLE:       str = "relaxation relaxes back into itself";
pub val PATTERN:           str = "fill pattern empty or not shorter than the one before it";

fun refuse(s: *S.Set, message: str, table: str, index: u32) err[Refusal] {
    ret err[Refusal].err{Refusal{set: s, message: message, table: table, index: index}};
}

fun fine() err[Refusal] {
    ret err[Refusal].ok{};
}

# whether `a` is a row of mink's architecture catalog
fun known_arch(a: *mink.arch.Arch) bool {
    var i: usize = 0;
    for (i < mink.arch.count()) {
        if (mink.arch.at(i) == a) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `k` is a row of mink's relocation kinds
fun known_reloc(k: *mink.reloc.Kind) bool {
    var i: usize = 0;
    for (i < mink.reloc.count()) {
        if (mink.reloc.at(i) == k) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun arches(s: *S.Set) err[Refusal] {
    if (s.arches.len == 0) { ret refuse(s, NO_ARCH, "architecture", 0); }
    var i: u32 = 0;
    for (i < s.arches.len) {
        if (!known_arch(s.arches.at[i])) { ret refuse(s, UNKNOWN_ARCH, "architecture", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.arches.at[j] == s.arches.at[i]) { ret refuse(s, SHARED_ARCH, "architecture", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret fine();
}

# the register rows of the set's file, 0 for a set with none
fun register_count(s: *S.Set) u32 {
    if (s.codec.registers == nil) { ret 0; }
    ret s.codec.registers.register_count;
}

# whether `q` names a scale other than `scale`, which is none until a part names one
fun rescales(q: register.Scaled, scale: *opt[u8]) bool {
    if (q.per == 0)     { ret false; }
    if (sel scale.some) { ret scale.some != q.scale; }
    @scale = opt[u8].some{q.scale};
    ret false;
}

# whether `name` is spelled by a register before row `before` or an alias before alias `aliases`
fun spelled(file: *register.File, name: str, before: u32, aliases: u32) bool {
    var i: u32 = 0;
    for (i < before) {
        if (str_equals(file.registers[i].name, name)) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < aliases) {
        if (str_equals(file.aliases[i].name, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the catalog states that `a` and `b` conflict, in either order
fun conflicts(catalog: *extension.Catalog, a: extension.Id, b: extension.Id) bool {
    var i: u32 = 0;
    for (i < catalog.conflict_count) {
        val pair: extension.Conflict = catalog.conflicts[i];
        if ((pair.a == a && pair.b == b) || (pair.a == b && pair.b == a)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun scales(s: *S.Set, file: *register.File) err[Refusal] {
    var i: u32 = 0;
    for (i < file.scale_count) {
        val scale: register.Scale = file.scales[i];
        var j:     u32            = 0;
        for (j < scale.fixes.len) {
            val f: register.Fixing = scale.fixes.at[j];
            if (f.by >= s.extensions.count) { ret refuse(s, FIXING_EXTENSION, "scale", i); }
            if (f.multiplier == 0 || (f.multiplier & (f.multiplier - 1)) != 0 || f.multiplier > scale.max) {
                ret refuse(s, FIXING_MULTIPLIER, "scale", i);
            }
            var k: u32 = 0;
            for (k < j) {
                val other: register.Fixing = scale.fixes.at[k];
                if (other.multiplier != f.multiplier && !conflicts(s.extensions, other.by, f.by)) { ret refuse(s, FIXING_CONFLICT, "scale", i); }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret fine();
}

fun registers(s: *S.Set) err[Refusal] {
    val file: *register.File = s.codec.registers;
    if (file == nil) { ret fine(); }
    val fixed: err[Refusal] = scales(s, file);
    if (sel fixed.err) { ret fixed; }
    var c: u32 = 0;
    for (c < file.class_count) {
        val width: register.Scaled = file.classes[c].width;
        if (width.per != 0 && width.scale::u32 >= file.scale_count) { ret refuse(s, UNKNOWN_SCALE, "class", c); }
        c = c + 1;
    }
    var i: u32 = 0;
    for (i < file.register_count) {
        val r: *register.Register = ?file.registers[i];
        if (r.class::u32 >= file.class_count)             { ret refuse(s, REGISTER_CLASS, "register", i); }
        if (r.number::u32 >= file.classes[r.class].count) { ret refuse(s, REGISTER_NUMBER, "register", i); }
        var scale: opt[u8] = opt[u8].none{};
        if (rescales(file.classes[r.class].width, ?scale) || rescales(r.offset, ?scale) || rescales(r.stride, ?scale) || rescales(r.count, ?scale)) {
            ret refuse(s, MIXED_SCALES, "register", i);
        }
        if (sel scale.some && scale.some::u32 >= file.scale_count) { ret refuse(s, UNKNOWN_SCALE, "register", i); }
        if (spelled(file, r.name, i, 0))                           { ret refuse(s, SHARED_NAME, "register", i); }
        if (!in_catalog(s.extensions, r.requires))                 { ret refuse(s, UNKNOWN_EXTENSION, "register", i); }
        var j: u32 = 0;
        for (j < i) {
            if (register.id_of(?file.registers[j]) == register.id_of(r)) { ret refuse(s, SHARED_ID, "register", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < file.alias_count) {
        val a: *register.Alias = ?file.aliases[i];
        if (a.register >= file.register_count)             { ret refuse(s, ALIAS_TARGET, "alias", i); }
        if (spelled(file, a.name, file.register_count, i)) { ret refuse(s, SHARED_NAME, "alias", i); }
        i = i + 1;
    }
    i = 0;
    for (i < file.column_count) {
        val col: *register.Column = ?file.columns[i];
        if (col.len != file.register_count) { ret refuse(s, COLUMN_LENGTH, "column", i); }
        var j: u32 = 0;
        for (j < i) {
            if (file.columns[j].format == col.format) { ret refuse(s, SHARED_COLUMN, "column", i); }
            j = j + 1;
        }
        var k: u32 = 0;
        for (k < col.len) {
            if (col.numbers[k] != register.UNNUMBERED) {
                var m: u32 = 0;
                for (m < k) {
                    if (col.numbers[m] == col.numbers[k]) { ret refuse(s, SHARED_NUMBER, "column", i); }
                    m = m + 1;
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret fine();
}

# whether every id of `ids` is a row of `catalog`
fun in_catalog(catalog: *extension.Catalog, ids: extension.Ids) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (ids.at[i] >= catalog.count) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `name` is spelled by an extension before `extensions` or a level before `levels`
fun named(catalog: *extension.Catalog, name: str, extensions: u32, levels: u32) bool {
    var i: u32 = 0;
    for (i < extensions) {
        if (str_equals(catalog.extensions[i].name, name)) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < levels) {
        if (str_equals(catalog.levels[i].name, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun extensions(s: *S.Set) err[Refusal] {
    val catalog: *extension.Catalog = s.extensions;
    if (catalog.syntax == nil) { ret refuse(s, NO_SYNTAX, "catalog", 0); }
    var i: u32 = 0;
    for (i < catalog.count) {
        if (!in_catalog(catalog, catalog.extensions[i].implies)) { ret refuse(s, IMPLIED, "extension", i); }
        if (named(catalog, catalog.extensions[i].name, i, 0))    { ret refuse(s, SHARED_NAME, "extension", i); }
        i = i + 1;
    }
    i = 0;
    for (i < catalog.level_count) {
        if (!in_catalog(catalog, catalog.levels[i].members))          { ret refuse(s, LEVEL_MEMBER, "level", i); }
        if (named(catalog, catalog.levels[i].name, catalog.count, i)) { ret refuse(s, SHARED_NAME, "level", i); }
        i = i + 1;
    }
    i = 0;
    for (i < catalog.conflict_count) {
        val pair: extension.Conflict = catalog.conflicts[i];
        if (pair.a >= catalog.count || pair.b >= catalog.count || pair.a == pair.b) { ret refuse(s, CONFLICT, "conflict", i); }
        var j: u32 = 0;
        for (j < i) {
            val other: extension.Conflict = catalog.conflicts[j];
            if ((other.a == pair.a && other.b == pair.b) || (other.a == pair.b && other.b == pair.a)) { ret refuse(s, CONFLICT_TWICE, "conflict", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret fine();
}

fun bindings(s: *S.Set) err[Refusal] {
    var i: u32 = 0;
    for (i < s.bindings.len) {
        val b: *S.Binding = ?s.bindings.at[i];
        if (b.fixup == operand.NO_FIXUP) { ret refuse(s, NO_FIXUP, "binding", i); }
        if (!known_reloc(b.kind))        { ret refuse(s, UNKNOWN_RELOC, "binding", i); }
        var j: u32 = 0;
        for (j < i) {
            if (s.bindings.at[j].fixup == b.fixup) { ret refuse(s, BOUND_TWICE, "binding", i); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret fine();
}

# whether `fixup` is NO_FIXUP or bound by the set
fun bound(s: *S.Set, fixup: operand.FixupKind) bool {
    if (fixup == operand.NO_FIXUP) { ret true; }
    var i: u32 = 0;
    for (i < s.bindings.len) {
        if (s.bindings.at[i].fixup == fixup) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether every class of `r` is in the set's register file
fun in_file(s: *S.Set, r: *operand.Register) bool {
    var count: u32 = 0;
    if (s.codec.registers != nil) { count = s.codec.registers.class_count; }
    var i: u32 = 0;
    for (i < r.classes.len) {
        if (r.classes.at[i]::u32 >= count) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the range of `r` lies inside each of its classes, which must be in the file
fun in_range(s: *S.Set, r: *operand.Register) bool {
    var i: u32 = 0;
    for (i < r.classes.len) {
        val count: u32 = s.codec.registers.classes[r.classes.at[i]].count;
        if (r.first >= count || (r.count != 0 && r.count > count - r.first)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether every number `r` excludes lies in the range of one of its classes, which must be in the file
fun excludes_in_range(s: *S.Set, r: *operand.Register) bool {
    var k: u32 = 0;
    for (k < r.excluded.len) {
        var held: bool = false;
        var i:    u32  = 0;
        for (i < r.classes.len) {
            if (operand.within(r, r.excluded.at[k], s.codec.registers.classes[r.classes.at[i]].count)) { held = true; }
            i = i + 1;
        }
        if (!held) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether every value `imm` excludes is one it could hold
fun excludes_representable(imm: *operand.Immediate) bool {
    var i: u32 = 0;
    for (i < imm.excluded.len) {
        val bad: opt[str] = walk.unrepresentable(imm, imm.excluded.at[i]);
        if (sel bad.some) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the bits that number every register of `r` from its range's first
fun number_bits(s: *S.Set, r: *operand.Register) u8 {
    var bits: u8  = 0;
    var i:    u32 = 0;
    for (i < r.classes.len) {
        var top:  u32 = operand.span(r, s.codec.registers.classes[r.classes.at[i]].count);
        var need: u8  = 0;
        if (top > 0) { top = top - 1; }
        for (top != 0) {
            need = need + 1;
            top  = top >> 1;
        }
        if (need > bits) { bits = need; }
        i = i + 1;
    }
    ret bits;
}

# whether `taken`, the bits slices take of a part, covers bits `lo` to `hi - 1` when it takes any
fun covers(taken: u64, lo: u8, hi: u8) bool {
    if (taken == 0 || hi <= lo) { ret true; }
    ret ((field.ones(hi) & ~field.ones(lo)) & ~taken) == 0;
}

fun covers_immediate(taken: u64, imm: *operand.Immediate) bool {
    ret covers(taken, imm.scale, imm.bits);
}

# the registers `r` an operand part admits, the slices taking that part `taken`
fun admits(s: *S.Set, r: *operand.Register, taken: u64) opt[str] {
    if (!in_file(s, r))                       { ret opt[str].some{UNKNOWN_CLASS}; }
    if (!in_range(s, r))                      { ret opt[str].some{REGISTER_RANGE}; }
    if (!excludes_in_range(s, r))             { ret opt[str].some{EXCLUDED_RANGE}; }
    if (!covers(taken, 0, number_bits(s, r))) { ret opt[str].some{UNCOVERED}; }
    ret opt[str].none{};
}

# the shape of an operand: its classes in the file, its fixup kinds bound, and the slices taking it covering it
fun shape(s: *S.Set, r: *row.Row, op: u8) opt[str] {
    var taken: [8]u64;
    var f:     u32 = 0;
    for (f < r.encoding.len) {
        val fl: *field.Field = ?r.encoding.at[f];
        var k:  u32          = 0;
        for (k < fl.slices.len) {
            val sl: *field.Slice = ?fl.slices.at[k];
            if (sl.operand == op) { taken[sl.part] = taken[sl.part] | (field.ones(sl.len) << sl.lo); }
            k = k + 1;
        }
        f = f + 1;
    }
    val sh: *operand.Shape = ?r.operands.at[op].shape;
    if (sel sh.register) {
        ret admits(s, ?sh.register, taken[field.NUMBER]);
    }
    or (sel sh.immediate) {
        if (!bound(s, sh.immediate.fixup))                         { ret opt[str].some{UNBOUND_FIXUP}; }
        if (!covers_immediate(taken[field.NUMBER], ?sh.immediate)) { ret opt[str].some{UNCOVERED}; }
        if (!excludes_representable(?sh.immediate))                { ret opt[str].some{EXCLUDED_RANGE}; }
    }
    or (sel sh.relative) {
        if (!bound(s, sh.relative.offset.fixup))                         { ret opt[str].some{UNBOUND_FIXUP}; }
        if (!covers_immediate(taken[field.NUMBER], ?sh.relative.offset)) { ret opt[str].some{UNCOVERED}; }
        if (!excludes_representable(?sh.relative.offset))                { ret opt[str].some{EXCLUDED_RANGE}; }
    }
    or (sel sh.memory) {
        val m:    *operand.Memory = ?sh.memory;
        val base: opt[str]        = admits(s, ?m.base, taken[field.NUMBER]);
        if (sel base.some) { ret base; }
        val index: opt[str] = admits(s, ?m.index, taken[field.INDEX]);
        if (sel index.some) { ret index; }
        val segment: opt[str] = admits(s, ?m.segment, taken[field.SEGMENT]);
        if (sel segment.some)                              { ret segment; }
        if (!bound(s, m.disp.fixup))                       { ret opt[str].some{UNBOUND_FIXUP}; }
        if (!covers_immediate(taken[field.DISP], ?m.disp)) { ret opt[str].some{UNCOVERED}; }
        if (!excludes_representable(?m.disp))              { ret opt[str].some{EXCLUDED_RANGE}; }
    }
    or (sel sh.list) {
        ret admits(s, ?sh.list.member, taken[field.NUMBER]);
    }
    or (sel sh.id) {
        if (!bound(s, sh.id.fixup)) { ret opt[str].some{UNBOUND_FIXUP}; }
    }
    ret opt[str].none{};
}

# the fields of a row: kinds in the table, units of whole bytes, and slices inside their operand, part and unit
fun fields(s: *S.Set, r: *row.Row) opt[str] {
    var f: u32 = 0;
    for (f < r.encoding.len) {
        val fl: *field.Field = ?r.encoding.at[f];
        if (fl.kind::u32 >= s.codec.fields.count)                                { ret opt[str].some{UNKNOWN_KIND}; }
        if (fl.width % 8 != 0 || fl.width > 64)                                  { ret opt[str].some{UNIT_WIDTH}; }
        if (fl.operand != field.NO_OPERAND && fl.operand::u32 >= r.operands.len) { ret opt[str].some{FIELD_OPERAND}; }
        var k: u32 = 0;
        for (k < fl.slices.len) {
            val sl: *field.Slice = ?fl.slices.at[k];
            if (sl.operand::u32 >= r.operands.len || sl.part::u32 >= field.PARTS || sl.len == 0 || sl.lo::u32 + sl.len::u32 > 64 || sl.at::u32 + sl.len::u32 > fl.width::u32) {
                ret opt[str].some{SLICE};
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret opt[str].none{};
}

# whether every row `set` holds is in the file and, for flags, in a flags class
fun holds(s: *S.Set, set: effect.Set, flags: bool) opt[str] {
    val count: u32 = register_count(s);
    var w:     u32 = 0;
    for (w < set.len) {
        var b: u32 = 0;
        for (b < 64) {
            if (((set.words[w] >> b::u64) & 1) != 0) {
                val at: u32 = w * 64 + b;
                if (at >= count) { ret opt[str].some{EFFECT_ROW}; }
                val file: *register.File = s.codec.registers;
                if (flags && file.classes[file.registers[at].class].kind != register.FLAGS) { ret opt[str].some{FLAG_ROW}; }
            }
            b = b + 1;
        }
        w = w + 1;
    }
    ret opt[str].none{};
}

# whether `op` is an operand of `r` or NO_OPERAND
fun operand_or_none(r: *row.Row, op: u8) bool {
    ret op == field.NO_OPERAND || op::u32 < r.operands.len;
}

fun count_ok(s: *S.Set, r: *row.Row, c: *effect.Count) bool {
    if (sel c.register) { ret c.register < register_count(s); }
    if (sel c.operand)  { ret c.operand::u32 < r.operands.len; }
    ret true;
}

fun access(s: *S.Set, r: *row.Row, a: *effect.Access) opt[str] {
    if (!operand_or_none(r, a.operand) || !operand_or_none(r, a.governor) || (a.forming & ~field.ones(r.operands.len::u8)::u32) != 0 || !count_ok(s, r, ?a.width.count)) {
        ret opt[str].some{EFFECT_OPERAND};
    }
    if (a.base != effect.NO_ROW && a.base >= register_count(s)) { ret opt[str].some{EFFECT_ROW}; }
    var through: bool = false;
    if (a.operand != field.NO_OPERAND) {
        val desc: *operand.Operand = ?r.operands.at[a.operand];
        through = sel desc.shape.memory;
        if (through && (desc.width != 0 || a.role != operand.NONE)) { ret opt[str].some{ACCESS_FORM}; }
    }
    if (!through && a.role == operand.NONE) { ret opt[str].some{ACCESS_FORM}; }
    ret opt[str].none{};
}

fun effects(s: *S.Set, r: *row.Row) opt[str] {
    if (r.effect == nil || r.ct == nil) { ret opt[str].some{NO_EFFECT}; }
    val e:         *effect.Effect = r.effect;
    val sets:      [2]effect.Set  = [2]effect.Set{e.implicit.read, e.implicit.written};
    val flag_sets: [4]effect.Set  = [4]effect.Set{e.flags.read, e.flags.written, e.flags.undefined, e.flags.kept};
    var i:         u32            = 0;
    for (i < 2) {
        val held: opt[str] = holds(s, sets[i], false);
        if (sel held.some) { ret held; }
        i = i + 1;
    }
    i = 0;
    for (i < 4) {
        val held: opt[str] = holds(s, flag_sets[i], true);
        if (sel held.some) { ret held; }
        i = i + 1;
    }
    i = 0;
    for (i < e.memory.len) {
        val checked: opt[str] = access(s, r, ?e.memory.at[i]);
        if (sel checked.some) { ret checked; }
        i = i + 1;
    }
    if (!operand_or_none(r, e.control.operand)) { ret opt[str].some{EFFECT_OPERAND}; }
    val stack: *effect.Stack = ?e.stack;
    if (sel stack.delta && !operand_or_none(r, stack.delta.operand)) { ret opt[str].some{EFFECT_OPERAND}; }
    i = 0;
    for (i < e.fixed.len) {
        val fx: effect.Fixed = e.fixed.at[i];
        if (fx.operand::u32 >= r.operands.len) { ret opt[str].some{FIXED_OPERAND}; }
        val sh: *operand.Shape = ?r.operands.at[fx.operand].shape;
        if (!sel sh.register)                 { ret opt[str].some{FIXED_OPERAND}; }
        if (fx.register >= register_count(s)) { ret opt[str].some{EFFECT_ROW}; }
        val reg: *register.Register = ?s.codec.registers.registers[fx.register];
        val r:   *operand.Register  = ?sh.register;
        if (operand.find(r.classes, reg.class) < 0 || !operand.within(r, reg.number::u32, s.codec.registers.classes[reg.class].count)) {
            ret opt[str].some{FIXED_CLASS};
        }
        i = i + 1;
    }
    val c: *ct.Class = r.ct;
    if (sel c.dependent && (c.dependent.operands == operand.NO_POSITIONS && !c.dependent.accesses)) { ret opt[str].some{NO_INPUT}; }
    if (sel c.conditional && c.conditional.condition >= s.extensions.count)                         { ret opt[str].some{CONDITION}; }
    ret opt[str].none{};
}

fun rows(s: *S.Set) err[Refusal] {
    var i: u32 = 0;
    for (i < s.codec.rows.len) {
        val r: *row.Row = ?s.codec.rows.at[i];
        if (r.operands.len > row.MAX_OPERANDS)     { ret refuse(s, OPERANDS, "row", i); }
        if (r.encoding.len > row.MAX_FIELDS)       { ret refuse(s, FIELDS, "row", i); }
        if (!in_catalog(s.extensions, r.requires)) { ret refuse(s, UNKNOWN_EXTENSION, "row", i); }
        val laid: opt[str] = fields(s, r);
        if (sel laid.some) { ret refuse(s, laid.some, "row", i); }
        var op: u32 = 0;
        for (op < r.operands.len) {
            val shaped: opt[str] = shape(s, r, op::u8);
            if (sel shaped.some) { ret refuse(s, shaped.some, "row", i); }
            op = op + 1;
        }
        val affected: opt[str] = effects(s, r);
        if (sel affected.some) { ret refuse(s, affected.some, "row", i); }
        i = i + 1;
    }
    ret fine();
}

fun dispatch(s: *S.Set) err[Refusal] {
    val d: *walk.Dispatch = s.codec.dispatch;
    if (d.node_count == 0) { ret refuse(s, NO_ROOT, "node", 0); }
    var n: u32 = 0;
    for (n < d.node_count) {
        val node: *walk.Node = ?d.nodes[n];
        if (node.key::u32 >= d.key_count || node.first::u64 + node.count::u64 > d.entry_count::u64) { ret refuse(s, NODE, "node", n); }
        var k: u32 = 0;
        for (k < node.count) {
            val e: *walk.Entry = ?d.entries[node.first + k];
            if (k > 0 && d.entries[node.first + k - 1].value >= e.value) { ret refuse(s, UNSORTED, "node", n); }
            if (e.node != 0) {
                if (e.node > d.node_count) { ret refuse(s, ENTRY, "entry", node.first + k); }
            }
            or (e.first::u64 + e.count::u64 > d.candidate_count::u64) {
                ret refuse(s, ENTRY, "entry", node.first + k);
            }
            k = k + 1;
        }
        n = n + 1;
    }
    var c: u32 = 0;
    for (c < d.candidate_count) {
        val at: u32 = d.candidates[c];
        if (at >= s.codec.rows.len || (s.codec.rows.at[at].flags & row.ALIAS) != 0) { ret refuse(s, CANDIDATE, "candidate", c); }
        c = c + 1;
    }
    ret fine();
}

# the row of the step that takes the target, which a relaxation has exactly once
fun target_row(rx: *relax.Relaxation) u32 {
    var i: u32 = 0;
    for (i < rx.form.len) {
        val step: *relax.Step = ?rx.form.at[i];
        var k:    u32         = 0;
        for (k < step.values.len) {
            val src: *relax.Source = ?step.values.at[k];
            if (sel src.target) { ret step.row; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret effect.NO_ROW;
}

fun form(s: *S.Set, rx: *relax.Relaxation) opt[str] {
    val from:    *row.Row = ?s.codec.rows.at[rx.row];
    var targets: u32      = 0;
    if (rx.form.len == 0) { ret opt[str].some{RELAX_FORM}; }
    var i: u32 = 0;
    for (i < rx.form.len) {
        val step: *relax.Step = ?rx.form.at[i];
        if (step.row >= s.codec.rows.len)                              { ret opt[str].some{RELAX_ROW}; }
        if (step.values.len != s.codec.rows.at[step.row].operands.len) { ret opt[str].some{RELAX_FORM}; }
        var k: u32 = 0;
        for (k < step.values.len) {
            val src: *relax.Source = ?step.values.at[k];
            if ((sel src.operand && src.operand::u32 >= from.operands.len) || (sel src.flipped && src.flipped.operand::u32 >= from.operands.len) || (sel src.register && src.register >= register_count(s))) {
                ret opt[str].some{RELAX_SOURCE};
            }
            if (sel src.target) { targets = targets + 1; }
            k = k + 1;
        }
        i = i + 1;
    }
    if (targets != 1) { ret opt[str].some{RELAX_TARGET}; }
    ret opt[str].none{};
}

fun relaxations(s: *S.Set) err[Refusal] {
    val all: relax.Relaxations = s.relax;
    var i:   u32               = 0;
    for (i < all.len) {
        val rx: *relax.Relaxation = ?all.at[i];
        if (rx.row >= s.codec.rows.len)                              { ret refuse(s, RELAX_ROW, "relaxation", i); }
        if (rx.operand::u32 >= s.codec.rows.at[rx.row].operands.len) { ret refuse(s, RELAX_OPERAND, "relaxation", i); }
        val desc: *operand.Operand = ?s.codec.rows.at[rx.row].operands.at[rx.operand];
        if (!sel desc.shape.relative) { ret refuse(s, RELAX_OPERAND, "relaxation", i); }
        val formed: opt[str] = form(s, rx);
        if (sel formed.some) { ret refuse(s, formed.some, "relaxation", i); }
        i = i + 1;
    }
    # a chain of relaxations follows the step taking the target, and must end
    i = 0;
    for (i < all.len) {
        var next:  u32 = target_row(?all.at[i]);
        var steps: u32 = 0;
        for (next != effect.NO_ROW) {
            if (steps >= all.len) { ret refuse(s, RELAX_CYCLE, "relaxation", i); }
            var found: u32 = effect.NO_ROW;
            var j:     u32 = 0;
            for (j < all.len && found == effect.NO_ROW) {
                if (all.at[j].row == next) { found = target_row(?all.at[j]); }
                j = j + 1;
            }
            next  = found;
            steps = steps + 1;
        }
        i = i + 1;
    }
    ret fine();
}

fun fill(s: *S.Set) err[Refusal] {
    if (s.fill == nil)     { ret fine(); }
    if (s.fill.count == 0) { ret refuse(s, PATTERN, "pattern", 0); }
    var i: u32 = 0;
    for (i < s.fill.count) {
        val p: *S.Pattern = ?s.fill.patterns[i];
        if (p.len == 0 || p.bytes == nil || (i > 0 && p.len >= s.fill.patterns[i - 1].len)) { ret refuse(s, PATTERN, "pattern", i); }
        if (!in_catalog(s.extensions, p.requires))                                          { ret refuse(s, UNKNOWN_EXTENSION, "pattern", i); }
        i = i + 1;
    }
    ret fine();
}

# the set `s` checked against every invariant its tables carry
# ---
# ret: ok, or the first defect found
pub fun one(s: *S.Set) err[Refusal] {
    val checks: [8]fun(*S.Set) err[Refusal] = [8]fun(*S.Set) err[Refusal]{arches, registers, extensions, bindings, rows, dispatch, relaxations, fill};
    var i:      u32                         = 0;
    for (i < 8) {
        val done: err[Refusal] = checks[i](s);
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    ret fine();
}

# every set of `registry` checked, and no architecture served by two of them
pub fun every(registry: *S.Registry) err[Refusal] {
    var i: u32 = 0;
    for (i < registry.count) {
        val s:    *S.Set       = registry.sets[i];
        val done: err[Refusal] = one(s);
        if (sel done.err) { ret done; }
        var earlier: S.Registry = S.Registry{sets: registry.sets, count: i};
        var k:       u32        = 0;
        for (k < s.arches.len) {
            val other: opt[*S.Set] = S.find(?earlier, s.arches.at[k]);
            if (sel other.some) { ret refuse(s, SHARED_ARCH, "architecture", k); }
            k = k + 1;
        }
        i = i + 1;
    }
    ret fine();
}

# a minimal set for the tests below: one risc-v-like jump row over one register class
#[testing]
val T_CLASSES: [1]register.Class = [1]register.Class{
    register.Class{kind: register.GENERAL, width: register.Scaled{fixed: 64, per: 0, scale: 0}, count: 32},
};

#[testing]
val T_REGISTERS: [1]register.Register = [1]register.Register{
    register.Register{name: "x0", class: 0, number: 0, bank: 0, offset: register.Scaled{fixed: 0, per: 0, scale: 0}, stride: register.Scaled{fixed: 0, per: 0, scale: 0}, count: register.Scaled{fixed: 1, per: 0, scale: 0}, flags: register.ZERO, requires: extension.Ids{at: nil, len: 0}},
};

#[testing]
val T_FILE: register.File = register.File{
    scales:         nil,
    scale_count:    0,
    classes:        ?T_CLASSES[0],
    class_count:    1,
    registers:      ?T_REGISTERS[0],
    register_count: 1,
    aliases:        nil,
    alias_count:    0,
    columns:        nil,
    column_count:   0,
};

#[testing]
val T_GPR: [1]u16 = [1]u16{0};

#[testing]
val T_OPERANDS: [2]operand.Operand = [2]operand.Operand{
    operand.Operand{shape: operand.Shape.register{operand.Register{classes: operand.Classes{at: ?T_GPR[0], len: 1}, first: 0, count: 0, excluded: operand.Numbers{at: nil, len: 0}}}, role: operand.WRITE, width: 64, quantity: operand.ONE},
    operand.Operand{shape: operand.Shape.relative{operand.Relative{offset: operand.Immediate{bits: 21, signed: true, scale: 1, bias: 0, fixup: 1, format: operand.INTEGER, excluded: operand.Integers{at: nil, len: 0}}, anchor: operand.START}}, role: operand.NONE, width: 0, quantity: operand.ONE},
};

#[testing]
val T_SLICES: [2]field.Slice = [2]field.Slice{
    field.Slice{operand: 0, part: field.NUMBER, lo: 0, len: 5, at: 7, invert: false},
    field.Slice{operand: 1, part: field.NUMBER, lo: 1, len: 20, at: 12, invert: false},
};

#[testing]
val T_FIELDS: [1]field.Field = [1]field.Field{
    field.Field{kind: 0, width: 32, fixed: 0x6F, mask: 0x7F, slices: field.Slices{at: ?T_SLICES[0], len: 2}, operand: field.NO_OPERAND, param: 0},
};

#[testing]
val T_EFFECT: effect.Effect = effect.Effect{
    implicit: effect.Registers{read: effect.Set{words: nil, len: 0}, written: effect.Set{words: nil, len: 0}},
    flags:    effect.Flags{read: effect.Set{words: nil, len: 0}, written: effect.Set{words: nil, len: 0}, undefined: effect.Set{words: nil, len: 0}, kept: effect.Set{words: nil, len: 0}},
    memory:   effect.Accesses{at: nil, len: 0},
    control:  effect.Control{transfer: effect.JUMP, target: effect.DIRECT, conditional: false, operand: 1},
    stack:    effect.Stack.none{},
    latency:  effect.ONE,
    fixed:    effect.Fixeds{at: nil, len: 0},
};

#[testing]
val T_ROWS: [1]row.Row = [1]row.Row{
    row.Row{mnemonic: "jal", operands: row.Operands{at: ?T_OPERANDS[0], len: 2}, encoding: field.Fields{at: ?T_FIELDS[0], len: 1}, requires: extension.Ids{at: nil, len: 0}, effect: ?T_EFFECT, ct: ?ct.INDEPENDENT, flags: 0},
};

#[testing]
val T_KINDS: [1]*field.Kind = [1]*field.Kind{?field.UNIT};

#[testing]
val T_TABLE: field.Table = field.Table{kinds: ?T_KINDS[0], count: 1, order: field.LITTLE};

#[testing]
fun t_opcode(s: *field.Stream, at: usize) res[u64, field.Refusal] {
    val word: res[u64, field.Refusal] = field.read(s, at, 4);
    if (sel word.err) { ret word; }
    ret res[u64, field.Refusal].ok{word.ok & 0x7F};
}

#[testing]
val T_KEYS: [1]walk.Key = [1]walk.Key{walk.Key{name: "opcode", extract: t_opcode}};

#[testing]
val T_NODES: [1]walk.Node = [1]walk.Node{walk.Node{key: 0, first: 0, count: 1}};

#[testing]
val T_ENTRIES: [1]walk.Entry = [1]walk.Entry{walk.Entry{value: 0x6F, node: 0, first: 0, count: 1}};

#[testing]
val T_CANDIDATES: [1]u32 = [1]u32{0};

#[testing]
val T_DISPATCH: walk.Dispatch = walk.Dispatch{keys: ?T_KEYS[0], key_count: 1, nodes: ?T_NODES[0], node_count: 1, entries: ?T_ENTRIES[0], entry_count: 1, candidates: ?T_CANDIDATES[0], candidate_count: 1};

#[testing]
val T_CODEC: walk.Codec = walk.Codec{fields: ?T_TABLE, registers: ?T_FILE, rows: row.Rows{at: ?T_ROWS[0], len: 1}, dispatch: ?T_DISPATCH};

#[testing]
val T_EXTENSIONS: [1]extension.Extension = [1]extension.Extension{
    extension.Extension{name: "i", implies: extension.Ids{at: nil, len: 0}, revision: "2.1"},
};

#[testing]
val T_CATALOG: extension.Catalog = extension.Catalog{extensions: ?T_EXTENSIONS[0], count: 1, levels: nil, level_count: 0, conflicts: nil, conflict_count: 0, syntax: ?extension.LIST};

#[testing]
val T_BINDINGS: [1]S.Binding = [1]S.Binding{S.Binding{fixup: 1, kind: ?mink.reloc.JAL20}};

#[testing]
val T_ARCHES: [1]*mink.arch.Arch = [1]*mink.arch.Arch{?mink.arch.RISCV64};

#[testing]
val T_SET: S.Set = S.Set{
    arches:     S.Arches{at: ?T_ARCHES[0], len: 1},
    codec:      ?T_CODEC,
    extensions: ?T_CATALOG,
    bindings:   S.Bindings{at: ?T_BINDINGS[0], len: 1},
    relax:      relax.Relaxations{at: nil, len: 0},
    fill:       nil,
};

# whether `checked` is the refusal of `message` at row `index` of `table`
#[testing]
fun t_refused(checked: err[Refusal], message: str, table: str, index: u32) bool {
    ret sel checked.err && (checked.err.message == message && str_equals(checked.err.table, table) && checked.err.index == index);
}

# the test set with its one row replaced by `r`, held in `rows`, `codec` and `s`
#[testing]
fun t_with_row(r: row.Row, rows: *row.Row, codec: *walk.Codec, s: *S.Set) {
    @rows      = r;
    @codec     = T_CODEC;
    codec.rows = row.Rows{at: rows, len: 1};
    @s         = T_SET;
    s.codec    = codec;
}

test one__a_row_naming_an_unknown_register_class_is_refused {
    val classes:  [1]u16             = [1]u16{1};
    var operands: [2]operand.Operand = T_OPERANDS;
    operands[0].shape = operand.Shape.register{operand.Register{classes: operand.Classes{at: ?classes[0], len: 1}, first: 0, count: 0, excluded: operand.Numbers{at: nil, len: 0}}};
    var r: row.Row = T_ROWS[0];
    r.operands = row.Operands{at: ?operands[0], len: 2};
    var rows:  row.Row;
    var codec: walk.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), UNKNOWN_CLASS, "row", 0)) { ret 1; }
    ret 0;
}

test one__a_row_requiring_an_unknown_extension_is_refused {
    val ids: [1]extension.Id = [1]extension.Id{1};
    var r:   row.Row         = T_ROWS[0];
    r.requires = extension.Ids{at: ?ids[0], len: 1};
    var rows:  row.Row;
    var codec: walk.Codec;
    var s:     S.Set;
    t_with_row(r, ?rows, ?codec, ?s);
    if (!t_refused(one(?s), UNKNOWN_EXTENSION, "row", 0)) { ret 1; }
    ret 0;
}

test one__a_fixup_kind_with_no_mink_mapping_is_refused {
    var s: S.Set = T_SET;
    s.bindings = S.Bindings{at: nil, len: 0};
    if (!t_refused(one(?s), UNBOUND_FIXUP, "row", 0)) { ret 1; }
    ret 0;
}

test one__an_architecture_mink_does_not_know_is_refused {
    val foreign: mink.arch.Arch     = mink.arch.Arch{name: "riscv64", pointer_bytes: 8, page_size: 0x1000, caps: mink.arch.ADDRESSED};
    val arches:  [1]*mink.arch.Arch = [1]*mink.arch.Arch{?foreign};
    var s:       S.Set              = T_SET;
    s.arches = S.Arches{at: ?arches[0], len: 1};
    if (!t_refused(one(?s), UNKNOWN_ARCH, "architecture", 0)) { ret 1; }
    ret 0;
}
