# how code switches a state value itself, as data of each set
#
# a row's timing may depend on no input only under a state value
# (`masc.core.ct`), as aarch64's dit=on, and a compiler that needs the value
# around the code it emits switches it there. it reads the state into a
# register it keeps, sets the value, and on every exit restores the state from
# that register, so code entered under the value leaves it so and code entered
# outside it leaves it as it found it. each of the three is a sequence of rows,
# each operand of which takes a fixed value, the register the read saved the
# state into, or a scratch register the caller chooses for that sequence
# alone, so a switch of more than one instruction or one that needs a register
# of its own is a table of the same shape. a set states a switch only for a
# value code switches at the privilege a program runs at: aarch64's PSTATE.DIT
# is read and written with mrs and msr at el0. x86's doitm is set through an
# msr only the kernel writes, risc-v's zkt is an extension the processor
# implements and no state, and wasm and spir-v have no state, so they state
# none.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use masc.core.dispatch;
use masc.core.operand;
use masc.core.register;
use masc.core.requirement;
use masc.core.row;

# where one operand of a step takes its value from
# ---
# value:   this value, the same wherever the switch is placed, as the system register dit or the immediate 1
# saved:   the register the read saves the state into, which the restore reads back
# scratch: the scratch register of this index the caller chooses, live within the one sequence of the step
pub tag Source: u8 {
    value: operand.Value;
    saved;
    scratch: u8;
}

# sources as a pointer to static sources and a count
pub rec Sources {
    at:  *Source;
    len: u32;
}

pub val NO_SOURCES: Sources = Sources{at: nil, len: 0};

# one instruction of a switch
# ---
# row:    the row it encodes, by its index in the set's rows
# values: where each operand of the row takes its value from, one per operand
pub rec Step {
    row:    u32;
    values: Sources;
}

# a sequence of steps as a pointer to static steps and a count, in the order they run
pub rec Steps {
    at:  *Step;
    len: u32;
}

pub val NO_STEPS: Steps = Steps{at: nil, len: 0};

# the class of each scratch register a switch's sequences name, by its index in the set's register file, in the order
# of the scratch index
pub rec Scratch {
    at:  *u16;
    len: u32;
}

pub val NO_SCRATCH: Scratch = Scratch{at: nil, len: 0};

# how code switches one state value itself
# ---
# state:   the atom of the state value, as aarch64's dit=on, the one a constant-time condition names
# saved:   the class of the register the read saves the state into, by its index in the set's register file
# mask:    the bits of the saved register that hold the state
# held:    those bits while the state is at the value, so a caller that tests whether the state was already at it
#          before setting it reads `saved & mask == held`
# scratch: the class of each scratch register its sequences name, NO_SCRATCH for none
# read:    the sequence that saves the state into the saved register
# set:     the sequence that sets the state to the value
# restore: the sequence that sets the state back from the saved register
pub rec Switch {
    state:   requirement.Id;
    saved:   u16;
    mask:    u64;
    held:    u64;
    scratch: Scratch;
    read:    Steps;
    set:     Steps;
    restore: Steps;
}

# switches as a pointer to static switches and a count, at most one per state value
pub rec Switches {
    at:  *Switch;
    len: u32;
}

# the switches of a set whose code switches no state value itself
pub val NO_SWITCHES: Switches = Switches{at: nil, len: 0};

# the switch of state value `state`, the atom a constant-time condition names, none for an extension or a value code
# cannot switch itself
pub fun switching(all: Switches, state: requirement.Id) opt[*Switch] {
    var i: u32 = 0;
    for (i < all.len) {
        if (all.at[i].state == state) { ret opt[*Switch].some{?all.at[i]}; }
        i = i + 1;
    }
    ret opt[*Switch].none{};
}

# one instruction of a switch as placed
# ---
# row:    the row it encodes
# values: its operand values, one per operand of the row
pub rec Instruction {
    row:    *row.Row;
    values: [operand.MAX_OPERANDS]operand.Value;
}

# step `s` of switch `sw` placed into `out`, its saved register `saved` and its scratch registers `scratch`
# ---
# codec:   the set's codec, whose rows the step indexes
# scratch: one register per class of the switch's scratch, in order, nil for a switch with none
# ret:     whether every operand took a value, false for a row past the codec's, a register of another class than the
#          switch names, or sources that are not one per operand of the row
pub fun instruction(codec: *dispatch.Codec, sw: *Switch, s: *Step, saved: register.Id, scratch: *register.Id, out: *Instruction) bool {
    if (s.row >= codec.rows.len) { ret false; }
    val to: *row.Row = ?codec.rows.at[s.row];
    if (s.values.len != to.operands.len || to.operands.len > operand.MAX_OPERANDS) { ret false; }
    out.row = to;
    var k: u32 = 0;
    for (k < s.values.len) {
        val src: Source = s.values.at[k];
        if (sel src.value) { out.values[k] = src.value; }
        or (sel src.saved) {
            if (register.class_of(saved) != sw.saved) { ret false; }
            out.values[k] = operand.Value.register{saved};
        }
        or {
            if (src.scratch::u32 >= sw.scratch.len)                                    { ret false; }
            if (register.class_of(scratch[src.scratch]) != sw.scratch.at[src.scratch]) { ret false; }
            out.values[k] = operand.Value.register{scratch[src.scratch]};
        }
        k = k + 1;
    }
    ret true;
}
