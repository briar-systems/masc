# the instructions a set's builder reads as what they state of the object, never as code
#
# a format may write some instructions of a module from what the object states rather than from its sections: mink
# writes spir-v's OpCapability and OpExtension from the object's facts and OpMemoryModel from its addressing and memory
# model traits, where the module's logical layout puts them, and refuses a section holding one. a set names each
# operand of such an instruction and what its value states: a trait axis, at the choice the object's format maps the
# value to, or a fact of a format's own key, holding the value or a literal's bytes. the builder states each on the
# object in place of writing the instruction to a section, so a consumer emitting the instruction and a source spelling
# it state the object alike, and the instruction is still read and observed as any other. a source axis a row states is
# the source's to state by that instruction, so no default stands in for one the source leaves out.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use mink_format: mink.catalog.format;
use mink_trait:  mink.catalog.trait;

use masc.core.row;

# a fact of a format's own, by its key in that format's rules, as spir-v's capability is key 2 of mink's spir-v rules
pub rec Fact {
    format: *mink_format.Format;
    key:    u32;
}

# what an operand's value states
# ---
# trait: the axis, at the choice the object's format maps the value, an enumerant's or an immediate's, to
# fact:  the fact, holding an enumerant's or an immediate's value, or a literal's bytes as its data
pub tag Stated: u8 {
    trait: *mink_trait.Axis;
    fact:  Fact;
}

# one operand of a row the builder reads as what it states
# ---
# row:     the row
# operand: the operand's index among the row's
# stated:  what its value states
pub rec Stating {
    row:     *row.Row;
    operand: u8;
    stated:  Stated;
}

# statings as a pointer to static rows and a count
pub rec Statings {
    at:  *Stating;
    len: u32;
}

# the statings of a set whose instructions are all code
pub val NO_STATINGS: Statings = Statings{at: nil, len: 0};

# whether `s` reads an instruction of `r` as what it states
pub fun states(s: Statings, r: *row.Row) bool {
    var i: u32 = 0;
    for (i < s.len) {
        if (s.at[i].row == r) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a row of `s` states `x`
pub fun states_axis(s: Statings, x: *mink_trait.Axis) bool {
    var i: u32 = 0;
    for (i < s.len) {
        val st: Stated = s.at[i].stated;
        if (sel st.trait) {
            if (st.trait == x) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}
