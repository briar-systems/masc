# the operand model every instruction set fills in
#
# a row states what each of its operands admits as an `Operand`, and an
# instruction holds one `Value` per operand. the shapes are the kinds of
# operand any set has: registers, immediates with scale and range, memory with
# its addressing forms, relative targets, enumerants, conditions, register
# lists, typed ids, byte literals and markers. a symbolic value with its fixup kind stands where an
# immediate, a relative target, a displacement or an id admits one, and is the whole of a marker.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use masc.core.index;
use masc.core.register;

# the most operands a row has
pub val MAX_OPERANDS: u32 = 16;

# how an instruction uses an operand, as bits
pub def Role: u8;

pub val NONE:       Role = 0;
pub val READ:       Role = 1;
pub val WRITE:      Role = 2;
pub val READ_WRITE: Role = 3;

# operand positions of a row as bits, bit n for operand n, spanning every operand a row can have
pub def Positions: u32;

pub val NO_POSITIONS:  Positions = 0;
pub val ALL_POSITIONS: Positions = 0xFFFF_FFFF;

# how many values an operand takes
# ---
# ONE:      exactly one
# OPTIONAL: one or none, as spir-v's `?` operands
# VARIADIC: a list of values of the shape, as spir-v's `*` operands and wasm's br_table labels
pub def Quantity: u8;

pub val ONE:      Quantity = 0;
pub val OPTIONAL: Quantity = 1;
pub val VARIADIC: Quantity = 2;

# a fixup kind, local to its instruction set, which the set's registration maps to the object model's relocations
pub def FixupKind: u16;

pub val NO_FIXUP: FixupKind = 0;

# the symbol handle that names no symbol
pub val NO_SYMBOL: u32 = 0;

# register classes as a pointer to static class indices and a count
# ---
# at:  the first class index, nil when the list is empty
# len: how many classes the list holds
pub rec Classes {
    at:  *u16;
    len: u32;
}

# register numbers within a class as a pointer to static numbers and a count
pub rec Numbers {
    at:  *u32;
    len: u32;
}

# immediate values as a pointer to static values and a count
pub rec Integers {
    at:  *i64;
    len: u32;
}

# the empty lists of numbers and values, which exclude nothing
pub val NO_NUMBERS:  Numbers  = Numbers{at: nil, len: 0};
pub val NO_INTEGERS: Integers = Integers{at: nil, len: 0};

# what an immediate's number is, the one fact the printer and the parser read
# ---
# INTEGER: an integer
# FLOAT:   an ieee 754 binary float of `bits` bits, its value the bit pattern,
#          with no sign, scale or bias. a kind that encodes it narrower, as
#          aarch64 fmov's 8 bits, refuses what it cannot represent
pub def Format: u8;

pub val INTEGER: Format = 0;
pub val FLOAT:   Format = 1;

# a number encoded as `bits` bits of `value - bias`
# ---
# bits:     the bits of the encoded number, its zero low `scale` bits included
# signed:   whether the encoded number is two's complement
# scale:    the low bits that must be zero, which no field encodes
# bias:     subtracted before encoding and added back after decoding
# fixup:    the fixup kind a symbolic value takes by default, NO_FIXUP when the operand admits no symbol
# format:   whether the number is an integer or a float
# excluded: the values the operand never admits, compared as the operand's value, after the bias is
#           added back and the sign extended. the empty list excludes nothing
pub rec Immediate {
    bits:     u8;
    signed:   bool;
    scale:    u8;
    bias:     i64;
    fixup:    FixupKind;
    format:   Format;
    excluded: Integers;
}

# what a byte literal holds
# ---
# STRING: text, its terminator and padding the set's kind adds, so it holds no nul byte
# NUMBER: a number of any width in the field table's byte order, as a spir-v
#         context-dependent literal or a wasm v128
pub def Content: u8;

pub val STRING: Content = 0;
pub val NUMBER: Content = 1;

# bytes a set's kind writes and reads whole, never through slices
# ---
# max:     the most bytes it admits
# content: what the bytes hold
pub rec Literal {
    max:     u32;
    content: Content;
}

# a width an element width is scaled from, with the power of two that scales it
# ---
# operand: the enumerant operand whose value names the width, the width's exponent in bytes, as
#          an sve size field: 0 for bytes, 3 for doublewords
# scale:   the power of two the named width is multiplied by
pub rec Chosen {
    operand: u8;
    scale:   i8;
}

# how wide each element a register value holds is, which the rules over element widths read, as
# the risc-v vector overlap rules
# ---
# none:   no width any rule reads: a scalar register, or a register holding no elements
# fixed:  this many bits, a power of two, as an x86 packed single's 32, a risc-v index's encoded
#         width or a risc-v mask's 1
# state:  2^n times the element width state the instruction does not hold sets, as risc-v's SEW
#         in vtype: 0 for most vector operands, 1 for a widening destination, -1 for the source of
#         vzext.vf2
# chosen: as an operand's value names it, as an sve register's element size
pub tag Element: u8 {
    none;
    fixed:  u16;
    state:  i8;
    chosen: Chosen;
}

# how many registers one group of a register value covers
# ---
# fixed:  2^n whatever the state, 0 for one, as an x86 or sve vector register, a risc-v
#         reduction's scalar or vmv2r's group of two
# scaled: as many as the state's register multiplier gives elements of the value's width:
#         2^(m + log2 w - log2 s) for multiplier m, element width w and the state's width s, a
#         fraction of one register when the exponent is negative, as a risc-v group under EMUL.
#         its element width is fixed or the state's
# packed: the state's elements one bit each, 2^(m - log2 s) and never past one register, as a
#         risc-v mask
pub tag Span: u8 {
    fixed: u8;
    scaled;
    packed;
}

# the registers an operand part admits: a member of any listed class whose
# number lies in the range from `first`, encoded as its number minus `first`.
# the zero range is every number of each class
# ---
# classes:  the classes a member may be in
# first:    the lowest number admitted
# count:    how many numbers are admitted from first, 0 for every number to the class's end
# excluded: the numbers within a class the range never admits, whichever class holds them. the empty list excludes nothing
# fields:   the groups a value covers back to back from the register it names, as the fields of a
#           risc-v segment load or store, 1 for one. a group is one register but where a consumer's
#           constraint.Grouping states its length. a memory part's register is always 1
# element:  the width of each element the value holds
# span:     how many registers a group covers under a state, which constraint.grouping reads
pub rec Register {
    classes:  Classes;
    first:    u32;
    count:    u32;
    excluded: Numbers;
    fields:   u8;
    element:  Element;
    span:     Span;
}

# the addressing forms a memory operand admits beyond base plus displacement, as bits
pub def Forms: u8;

pub val ABSOLUTE: Forms = 0x1;
pub val PCREL:    Forms = 0x2;
pub val PRE:      Forms = 0x4;
pub val POST:     Forms = 0x8;

# where a distance from the program counter is measured from, as a relative target or a RELATIVE_PC address
# ---
# UNSTATED: no anchor, the zero value, which the set's check refuses on a relative operand and on a memory operand
#           admitting PCREL, so a row that forgets its anchor never measures from a default
# START:    the instruction's start
# END:      the instruction's end
pub def Anchor: u8;

pub val UNSTATED: Anchor = 0;
pub val START:    Anchor = 1;
pub val END:      Anchor = 2;

# how a memory value forms its address
# ---
# OFFSET:      base plus scaled index plus displacement, any of them absent
# RELATIVE_PC: the displacement from the program counter the set defines
# PREINDEX:    as OFFSET, writing the address back to the base first
# POSTINDEX:   the base alone, writing base plus displacement back after
pub def Mode: u8;

pub val OFFSET:      Mode = 0;
pub val RELATIVE_PC: Mode = 1;
pub val PREINDEX:    Mode = 2;
pub val POSTINDEX:   Mode = 3;

# a memory operand
# ---
# base:    the registers a base may be
# index:   the registers an index may be, no classes when no index is admitted
# segment: the registers a segment override may be, no classes when none is admitted
# scales:  the index scales admitted, bit n for a scale of 1 << n
# disp:    the displacement
# forms:   the forms admitted beyond base plus displacement
# anchor:  where a RELATIVE_PC displacement is measured from, as x86's rip is the instruction's end and an aarch64
#          literal load's pc its start. UNSTATED when the operand does not admit PCREL
pub rec Memory {
    base:    Register;
    index:   Register;
    segment: Register;
    scales:  u8;
    disp:    Immediate;
    forms:   Forms;
    anchor:  Anchor;
}

# a target as an offset from the instruction's start or end
pub rec Relative {
    offset: Immediate;
    anchor: Anchor;
}

# one named value of an enumeration
pub rec Enumerant {
    name:  str;
    value: u32;
}

# the values an enumerant or condition operand admits, the one table the printer and the parser read
# ---
# members: the named values
# count:   how many members there are
# mask:    whether a value is any union of members' bits rather than one member
# names:   every member by its name, the empty name first when a member has it
pub rec Enumeration {
    members: *Enumerant;
    count:   u32;
    mask:    bool;
    names:   index.Index;
}

# a list of registers
# ---
# member:      the registers every member may be
# min:         the fewest members
# max:         the most members
# consecutive: whether members must follow each other in number, wrapping within the member range
pub rec List {
    member:      Register;
    min:         u8;
    max:         u8;
    consecutive: bool;
}

# an id or index into one of a set's id spaces, such as a spir-v result id or a wasm function index
# ---
# space: the set-local id space
# bits:  the bits of the id
# fixup: the fixup kind a symbolic value takes by default, NO_FIXUP when the operand admits no symbol
pub rec Typed {
    space: u16;
    bits:  u8;
    fixup: FixupKind;
}

# what an operand admits
# ---
# marker: a symbol no bits hold, which only marks the instruction for the linker, as risc-v's
#         `%tprel_add(sym)` on an add or `%tlsdesc_call(sym)` on a jalr. it admits only a symbol
#         given exactly this fixup kind, which is recorded at the instruction's start
pub tag Shape: u8 {
    register:  Register;
    immediate: Immediate;
    memory:    Memory;
    relative:  Relative;
    enumerant: Enumeration;
    condition: Enumeration;
    list:      List;
    id:        Typed;
    literal:   Literal;
    marker:    FixupKind;
}

# one operand of a row
# ---
# shape:    what it admits
# role:     how the instruction uses it
# width:    the bits of data it names, such as a memory access or a register's view
# quantity: how many values it takes
# write:    what its write of a register leaves in the rest of the register's bank, register.Write.row for what the
#           register's row states. only an operand that writes a register states another, where its encoding
#           decides it, as an x86 vex destination zeroing the rest of its vector register
pub rec Operand {
    shape:    Shape;
    role:     Role;
    width:    u16;
    quantity: Quantity;
    write:    register.Write;
}

# a symbol a value refers to
# ---
# id:     the caller's handle for the symbol, never NO_SYMBOL
# addend: added to the symbol's value
# fixup:  the fixup kind, NO_FIXUP for the operand's default
pub rec Symbol {
    id:     u32;
    addend: i64;
    fixup:  FixupKind;
}

# a memory value
# ---
# base:    the base register, register.NONE for none
# index:   the index register, register.NONE for none
# scale:   the index scale as a power of two
# disp:    the displacement, zero when symbol names a symbol
# segment: the segment override, register.NONE for none
# mode:    how the address forms
# symbol:  the symbol the displacement refers to, id NO_SYMBOL for none
pub rec Address {
    base:    register.Id;
    index:   register.Id;
    scale:   u8;
    disp:    i64;
    segment: register.Id;
    mode:    Mode;
    symbol:  Symbol;
}

# bytes as a pointer and a count. a decoded literal borrows the stream it was read from
pub rec Bytes {
    at:  *u8;
    len: u32;
}

# values as a pointer and a count, for register lists and variadic operands
pub rec Values {
    at:  *Value;
    len: u32;
}

# the value an instruction holds for one operand
pub tag Value: u8 {
    none;
    register:  register.Id;
    immediate: i64;
    memory:    Address;
    relative:  i64;
    symbol:    Symbol;
    enumerant: u32;
    condition: u32;
    list:      Values;
    id:        u32;
    literal:   Bytes;
}

# the position of `class` in `classes`, -1 when it is not there
pub fun find(classes: Classes, class: u16) i64 {
    var i: u32 = 0;
    for (i < classes.len) {
        if (classes.at[i] == class) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

# how many numbers `r` admits of a class of `count` registers, 0 when its range starts past the class
pub fun span(r: *Register, count: u32) u32 {
    if (r.first >= count) { ret 0; }
    if (r.count == 0)     { ret count - r.first; }
    ret r.count;
}

# whether number `n` of a class of `count` registers lies in the range of `r`
pub fun within(r: *Register, n: u32, count: u32) bool {
    ret n >= r.first && n - r.first < span(r, count);
}

# whether `r` excludes number `n` of its range
pub fun excludes_number(r: *Register, n: u32) bool {
    var i: u32 = 0;
    for (i < r.excluded.len) {
        if (r.excluded.at[i] == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `imm` excludes the operand value `v`
pub fun excludes_value(imm: *Immediate, v: i64) bool {
    var i: u32 = 0;
    for (i < imm.excluded.len) {
        if (imm.excluded.at[i] == v) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `e` admits `value`
pub fun member(e: *Enumeration, value: u32) bool {
    var all: u32 = 0;
    var i:   u32 = 0;
    for (i < e.count) {
        if (e.members[i].value == value) { ret true; }
        all = all | e.members[i].value;
        i   = i + 1;
    }
    ret e.mask && (value & ~all) == 0;
}

fun same_symbol(a: Symbol, b: Symbol) bool {
    ret a.id == b.id && a.addend == b.addend && a.fixup == b.fixup;
}

# the fixup kind a symbol in the operand `desc` takes when it states none, NO_FIXUP for an operand that holds no symbol
pub fun default_fixup(desc: *Operand) FixupKind {
    if (desc.quantity == VARIADIC) { ret NO_FIXUP; }
    if (sel desc.shape.immediate)  { ret desc.shape.immediate.fixup; }
    if (sel desc.shape.relative)   { ret desc.shape.relative.offset.fixup; }
    if (sel desc.shape.memory)     { ret desc.shape.memory.disp.fixup; }
    if (sel desc.shape.id)         { ret desc.shape.id.fixup; }
    ret NO_FIXUP;
}

# the symbol `v` names as a distance from the program counter in the operand `desc`: a relative target's, or a
# RELATIVE_PC address's displacement. none for a value that names none
pub fun pc_symbol(desc: *Operand, v: *Value) opt[Symbol] {
    if (desc.quantity == VARIADIC) { ret opt[Symbol].none{}; }
    if (sel v.symbol) {
        if (sel desc.shape.relative) { ret opt[Symbol].some{v.symbol}; }
    }
    if (sel v.memory) {
        if (sel desc.shape.memory && v.memory.mode == RELATIVE_PC && v.memory.symbol.id != NO_SYMBOL) { ret opt[Symbol].some{v.memory.symbol}; }
    }
    ret opt[Symbol].none{};
}

# where the operand `desc` measures a distance from the program counter from, UNSTATED for an operand that measures none
pub fun anchor_of(desc: *Operand) Anchor {
    if (sel desc.shape.relative) { ret desc.shape.relative.anchor; }
    if (sel desc.shape.memory)   { ret desc.shape.memory.anchor; }
    ret UNSTATED;
}

# `v`, a value `pc_symbol` names a symbol of, with that symbol replaced by the distance `offset` from its anchor
pub fun resolved(v: *Value, offset: i64) Value {
    if (sel v.memory) {
        var a: Address = v.memory;
        a.disp   = offset;
        a.symbol = Symbol{id: NO_SYMBOL, addend: 0, fixup: NO_FIXUP};
        ret Value.memory{a};
    }
    ret Value.relative{offset};
}

# whether `a` and `b` are the same value, list members and literal bytes compared by content
pub fun equal(a: *Value, b: *Value) bool {
    if (sel a.none)      { ret sel b.none; }
    if (sel a.register)  { ret sel b.register && b.register == a.register; }
    if (sel a.immediate) { ret sel b.immediate && b.immediate == a.immediate; }
    if (sel a.relative)  { ret sel b.relative && b.relative == a.relative; }
    if (sel a.enumerant) { ret sel b.enumerant && b.enumerant == a.enumerant; }
    if (sel a.condition) { ret sel b.condition && b.condition == a.condition; }
    if (sel a.id)        { ret sel b.id && b.id == a.id; }
    if (sel a.symbol)    { ret sel b.symbol && same_symbol(a.symbol, b.symbol); }
    if (sel a.memory) {
        if (!sel b.memory) { ret false; }
        val x: Address = a.memory;
        val y: Address = b.memory;
        ret x.base == y.base && x.index == y.index && x.scale == y.scale && x.disp == y.disp && x.segment == y.segment && x.mode == y.mode && same_symbol(x.symbol, y.symbol);
    }
    if (sel a.list) {
        if (!sel b.list) { ret false; }
        val x: Values = a.list;
        val y: Values = b.list;
        if (x.len != y.len) { ret false; }
        var i: u32 = 0;
        for (i < x.len) {
            if (!equal(?x.at[i], ?y.at[i])) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (sel a.literal) {
        if (!sel b.literal) { ret false; }
        val p: Bytes = a.literal;
        val q: Bytes = b.literal;
        if (p.len != q.len) { ret false; }
        var k: u32 = 0;
        for (k < p.len) {
            if (p.at[k] != q.at[k]) { ret false; }
            k = k + 1;
        }
        ret true;
    }
    ret false;
}
